// ---------------------------------------------------------------------------
// The handler: the callbacks (addresses of functions, 0 for none) and
// the address they are all given first. The callbacks are SAX2's, with
// strings as C's (their addresses, 0 for none), lengths and counts as
// i64:
//
//   setDocumentLocator(user), startDocument(user), endDocument(user)
//   internalSubset(user, name, externalID, systemID), externalSubset(...)
//   entityDecl(user, name, type, publicId, systemId, content)
//   notationDecl(user, name, publicId, systemId)
//   unparsedEntityDecl(user, name, publicId, systemId, notationName)
//   getEntity(user, name, view: *EntityView, mode) -> bool
//   getParameterEntity(user, name, view: *EntityView) -> bool
//   startElementNs(user, localname, prefix, URI, nbNamespaces,
//       namespaces, nbAttributes, nbDefaulted, attributes)
//   endElementNs(user, localname, prefix, URI)
//   characters(user, ch, len), ignorableWhitespace(...), cdataBlock(...)
//   comment(user, value), processingInstruction(user, target, data)
//   reference(user, name)
//   reportError(user, record: *ErrorRecord)
//
// and five of the parser's own: whitespaceDiffers(user) -> bool, whether
// the ignorableWhitespace callback is not the characters one (libxml2
// compares the two to decide whether to tell blanks apart);
// nestedBegin(user, parser) -> user, nestedEnd(user, nested), around the
// parse of an entity's content by a parser of its own (libxml2's
// xmlParseBalancedChunkMemoryInternal), whose callbacks get the user
// nestedBegin answers (without it, the same user); and
// entityDeclared(user, name, type, publicId, systemId, content), where
// libxml2 records a general entity's declaration for SAX handlers that
// keep no document of their own (whatever the SAX callbacks); and
// keepString(user, place, string), the handler's copy of a string of the
// parser's (an entity's value as written) stored at PLACE in an entity
// of the handler's (without it, the parser's own string is stored there).
//
// getEntity's last argument says which of libxml2's lookups asks: 0 a
// reference in content or an attribute (xmlParseEntityRef), 1 the others
// (they fall back to SAX2's own lookup differently). Without getEntity
// the parser keeps the entities declared itself (and so for
// getParameterEntity); entityDecl is called either way.

pub const Handler = struct {
    user: usize
    setDocumentLocator: usize
    startDocument: usize
    endDocument: usize
    internalSubset: usize
    externalSubset: usize
    entityDecl: usize
    notationDecl: usize
    unparsedEntityDecl: usize
    getEntity: usize
    getParameterEntity: usize
    startElementNs: usize
    endElementNs: usize
    characters: usize
    ignorableWhitespace: usize
    whitespaceDiffers: usize
    cdataBlock: usize
    comment: usize
    processingInstruction: usize
    reference: usize
    reportError: usize
    nestedBegin: usize
    nestedEnd: usize
    entityDeclared: usize
    keepString: usize
}

pub fn emptyHandler() -> Handler {
    var h: Handler = undefined
    text.zero(@intFromPtr(&h), @sizeOf(Handler))
    return h
}

// An entity as the handler shows it to the parser: its kind, name and
// content (the parser may write a 0 at the content's start, as libxml2
// does to an entity that failed to parse), the address of its `checked`
// count (an i32 the parser keeps there, 0 for none), whether it has a
// node list (libxml2's ent->children; never, without a tree), and the
// address of its `orig` (where the parser keeps the value as written,
// when it is 0; 0 for none).
pub const EntityView = struct {
    address: usize
    etype: i64
    name: usize
    content: usize
    length: i64
    checked: usize
    children: usize
    uri: usize
    externalId: usize
    orig: usize
    expandedSize: usize
}

// An error: libxml2's xmlError fields as __xmlRaiseError fills them,
// MESSAGE the text formatted. CHANNEL is 2 for the validity errors
// (sent to libxml2's validity context, not to the SAX error callback);
// NOCONTEXT when libxml2 raises it without a parser (the decoders').
pub const ErrorRecord = struct {
    domain: i64
    code: i64
    level: i64
    message: usize
    str1: usize
    str2: usize
    str3: usize
    int1: i64
    line: i64
    col: i64
    file: usize
    channel: i64
    noContext: bool
}

// The callbacks' types.
const Call0Fn = fn(usize) -> void
const Call1Fn = fn(usize, usize) -> void
const Call2Fn = fn(usize, usize, usize) -> void
const Call3Fn = fn(usize, usize, usize, usize) -> void
const Call4Fn = fn(usize, usize, usize, usize, usize) -> void
const EntityDeclFn = fn(usize, usize, i64, usize, usize, usize) -> void
const EntityFn = fn(usize, usize, *EntityView, i64) -> bool
const ErrorFn = fn(usize, *ErrorRecord) -> void
const NestedFn = fn(usize, usize) -> usize
const ParameterEntityFn = fn(usize, usize, *EntityView) -> bool
const QueryFn = fn(usize) -> bool
const StartElementFn = fn(usize, usize, usize, usize, i64, usize, i64, i64, usize) -> void
const TextFn = fn(usize, usize, i64) -> void

// ---------------------------------------------------------------------------
// Inputs: the document's (whose bytes are the parser's buffer, decoded
// to UTF-8) and the parameter entities pushed on it in the DTD.

pub const Input = struct {
    base: usize
    cur: usize
    end: usize
    line: i64
    col: i64
    consumed: u64
    id: i64
    filename: usize
    encoding: usize
    version: usize
    standalone: i64
    length: i64
    owned: usize
    document: bool
    parentConsumed: u64
}

pub inline fn inputAt(address: usize) -> *Input { return unsafe { @ptrFromInt(*Input, address) } }

// ---------------------------------------------------------------------------
// The parser (libxml2's xmlParserCtxt, what of it the parse uses).

pub const Parser = struct {
    allocator: Allocator
    handler: Handler
    dict: usize
    parent: usize
    nested: bool
    // The inputs.
    inputs: usize
    inputNr: i64
    inputMax: i64
    input: usize
    inputId: i64
    // The document's bytes: decoded, and the raw ones awaiting decoding.
    content: Buffer
    raw: Buffer
    hasEncoder: bool
    encoder: encoding.Handler
    rawConsumed: u64
    ioError: i64
    // The state.
    instate: i64
    wellFormed: bool
    nsWellFormed: bool
    valid: bool
    disableSAX: i64
    errNo: i64
    recovery: bool
    replaceEntities: bool
    pedantic: bool
    keepBlanks: bool
    validate: bool
    options: u64
    charset: i64
    progressive: i64
    checkIndex: i64
    standalone: i64
    hasExternalSubset: bool
    hasPErefs: bool
    inSubset: i64
    depth: i64
    nbentities: u64
    sizeentities: u64
    sizeentcopy: u64
    version: usize
    encodingName: usize
    intSubName: usize
    extSubURI: usize
    extSubSystem: usize
    // The open elements: their names, and for each its prefix, URI, line
    // and how many namespaces it declared (libxml2's xmlStartTag).
    nameTab: usize
    pushTab: usize
    nameNr: i64
    nameMax: i64
    name: usize
    nsTab: usize
    nsNr: i64
    nsMax: i64
    spaceTab: usize
    spaceNr: i64
    spaceMax: i64
    atts: usize
    attallocs: usize
    maxatts: i64
    attsDefault: usize
    attsSpecial: usize
    strXml: usize
    strXmlns: usize
    strXmlNs: usize
    entities: usize
    empty: usize
    message: Buffer
    halted: bool
    hasDict: bool
    // What the handler is handed by address (in the parser's memory, not
    // the stack: what a callback is given leaves the parse's frames).
    record: ErrorRecord
    view: EntityView
    scratch: usize
    // A reference in content while its entity's content is parsed (by a
    // parser of its own: this one's state stays as it is), the step of
    // content being parsed, the code of a nested parse that did not start.
    refView: EntityView
    refWasChecked: i64
    refOldNbent: u64
    refOldSizeentcopy: u64
    stepCur: usize
    stepConsumed: u64
    nestedCode: i64
    // Where the parse's stack began (the frame of the parse's entry, the
    // document's parser's for a nested one): entities expand by recursion,
    // whose depth the stack left bounds before libxml2's limits do.
    stackBase: usize
}

pub inline fn parserAt(address: usize) -> *Parser { return unsafe { @ptrFromInt(*Parser, address) } }

// The current input's bytes.
inline fn inp(p: *Parser) -> *Input { return inputAt(p.*.input) }
inline fn RAW(p: *Parser) -> u64 { return text.get8(inp(p).*.cur) }
inline fn NXT(p: *Parser, n: usize) -> u64 { return text.get8(inp(p).*.cur + n) }
inline fn CUR_PTR(p: *Parser) -> usize { return inp(p).*.cur }

fn cmpText(at: usize, s: []const u8) -> bool {
    var index: usize = 0
    while index < s.length {
        if text.get8(at + index) != @intCast(u64, s[index]) { return false }
        index += 1
    }
    return true
}

inline fn CMP(p: *Parser, s: []const u8) -> bool { return cmpText(inp(p).*.cur, s) }

// SKIP: N bytes without a line end.
fn SKIP(p: *Parser, n: usize) -> void {
    const i = inp(p)
    i.*.cur += n
    i.*.col += @intCast(i64, n)
}

// NEXT1.
fn NEXT1(p: *Parser) -> void {
    const i = inp(p)
    i.*.col += 1
    i.*.cur += 1
}

// NEXTL: the current character, L bytes, a line end counted.
fn NEXTL(p: *Parser, l: usize) -> void {
    const i = inp(p)
    if text.get8(i.*.cur) == 10 {
        i.*.line += 1
        i.*.col = 1
    } else {
        i.*.col += 1
    }
    i.*.cur += l
}

// SKIPL.
fn SKIPL(p: *Parser, n: usize) -> void {
    const i = inp(p)
    var k: usize = 0
    while k < n {
        if text.get8(i.*.cur) == 10 {
            i.*.line += 1
            i.*.col = 1
        } else {
            i.*.col += 1
        }
        i.*.cur += 1
        k += 1
    }
}

// ---------------------------------------------------------------------------
// Memory

fn alloc(p: *Parser, size: usize) -> usize { return text.allocate(p.*.allocator, size) }
fn dealloc(p: *Parser, address: usize) -> void { text.release(p.*.allocator, address) }

inline fn word(table: usize, index: i64) -> usize { return text.getWord(table + @intCast(usize, index) * 8) }
inline fn setWord(table: usize, index: i64, value: usize) -> void { text.putWord(table + @intCast(usize, index) * 8, value) }

// A table of words grown to hold COUNT.
fn growWords(p: *Parser, table: usize, count: i64) -> usize {
    return text.reallocate(p.*.allocator, table, @intCast(usize, count) * 8)
}

inline fn lookup(p: *Parser, s: usize, count: usize) -> usize { return text.dictLookup(p.*.dict, s, count) }

// ---------------------------------------------------------------------------
// Errors (libxml2's xmlFatalErr and its kin, __xmlRaiseError's position)

// The message of xmlFatalErr's codes.
fn errorText(code: i64) -> []const u8 {
    if code == ERR_INVALID_HEX_CHARREF { return "CharRef: invalid hexadecimal value" }
    if code == ERR_INVALID_DEC_CHARREF { return "CharRef: invalid decimal value" }
    if code == ERR_INVALID_CHARREF { return "CharRef: invalid value" }
    if code == ERR_INTERNAL_ERROR { return "internal error" }
    if code == ERR_PEREF_AT_EOF { return "PEReference at end of document" }
    if code == ERR_PEREF_IN_PROLOG { return "PEReference in prolog" }
    if code == ERR_PEREF_IN_EPILOG { return "PEReference in epilog" }
    if code == ERR_PEREF_NO_NAME { return "PEReference: no name" }
    if code == ERR_PEREF_SEMICOL_MISSING { return "PEReference: expecting ';'" }
    if code == ERR_ENTITY_LOOP { return "Detected an entity reference loop" }
    if code == ERR_ENTITY_NOT_STARTED { return "EntityValue: \" or ' expected" }
    if code == ERR_ENTITY_PE_INTERNAL { return "PEReferences forbidden in internal subset" }
    if code == ERR_ENTITY_NOT_FINISHED { return "EntityValue: \" or ' expected" }
    if code == ERR_ATTRIBUTE_NOT_STARTED { return "AttValue: \" or ' expected" }
    if code == ERR_LT_IN_ATTRIBUTE { return "Unescaped '<' not allowed in attributes values" }
    if code == ERR_LITERAL_NOT_STARTED { return "SystemLiteral \" or ' expected" }
    if code == ERR_LITERAL_NOT_FINISHED { return "Unfinished System or Public ID \" or ' expected" }
    if code == ERR_MISPLACED_CDATA_END { return "Sequence ']]>' not allowed in content" }
    if code == ERR_URI_REQUIRED { return "SYSTEM or PUBLIC, the URI is missing" }
    if code == ERR_PUBID_REQUIRED { return "PUBLIC, the Public Identifier is missing" }
    if code == ERR_HYPHEN_IN_COMMENT { return "Comment must not contain '--' (double-hyphen)" }
    if code == ERR_PI_NOT_STARTED { return "xmlParsePI : no target name" }
    if code == ERR_RESERVED_XML_NAME { return "Invalid PI name" }
    if code == ERR_NOTATION_NOT_STARTED { return "NOTATION: Name expected here" }
    if code == ERR_NOTATION_NOT_FINISHED { return "'>' required to close NOTATION declaration" }
    if code == ERR_VALUE_REQUIRED { return "Entity value required" }
    if code == ERR_URI_FRAGMENT { return "Fragment not allowed" }
    if code == ERR_ATTLIST_NOT_STARTED { return "'(' required to start ATTLIST enumeration" }
    if code == ERR_NMTOKEN_REQUIRED { return "NmToken expected in ATTLIST enumeration" }
    if code == ERR_ATTLIST_NOT_FINISHED { return "')' required to finish ATTLIST enumeration" }
    if code == ERR_MIXED_NOT_STARTED { return "MixedContentDecl : '|' or ')*' expected" }
    if code == ERR_PCDATA_REQUIRED { return "MixedContentDecl : '#PCDATA' expected" }
    if code == ERR_ELEMCONTENT_NOT_STARTED { return "ContentDecl : Name or '(' expected" }
    if code == ERR_ELEMCONTENT_NOT_FINISHED { return "ContentDecl : ',' '|' or ')' expected" }
    if code == ERR_PEREF_IN_INT_SUBSET { return "PEReference: forbidden within markup decl in internal subset" }
    if code == ERR_GT_REQUIRED { return "expected '>'" }
    if code == ERR_CONDSEC_INVALID { return "XML conditional section '[' expected" }
    if code == ERR_EXT_SUBSET_NOT_FINISHED { return "Content error in the external subset" }
    if code == ERR_CONDSEC_INVALID_KEYWORD { return "conditional section INCLUDE or IGNORE keyword expected" }
    if code == ERR_CONDSEC_NOT_FINISHED { return "XML conditional section not closed" }
    if code == ERR_XMLDECL_NOT_STARTED { return "Text declaration '<?xml' required" }
    if code == ERR_XMLDECL_NOT_FINISHED { return "parsing XML declaration: '?>' expected" }
    if code == ERR_EXT_ENTITY_STANDALONE { return "external parsed entities cannot be standalone" }
    if code == ERR_ENTITYREF_SEMICOL_MISSING { return "EntityRef: expecting ';'" }
    if code == ERR_DOCTYPE_NOT_FINISHED { return "DOCTYPE improperly terminated" }
    if code == ERR_LTSLASH_REQUIRED { return "EndTag: '</' not found" }
    if code == ERR_EQUAL_REQUIRED { return "expected '='" }
    if code == ERR_STRING_NOT_CLOSED { return "String not closed expecting \" or '" }
    if code == ERR_STRING_NOT_STARTED { return "String not started expecting ' or \"" }
    if code == ERR_ENCODING_NAME { return "Invalid XML encoding name" }
    if code == ERR_STANDALONE_VALUE { return "standalone accepts only 'yes' or 'no'" }
    if code == ERR_DOCUMENT_EMPTY { return "Document is empty" }
    if code == ERR_DOCUMENT_END { return "Extra content at the end of the document" }
    if code == ERR_NOT_WELL_BALANCED { return "chunk is not well balanced" }
    if code == ERR_EXTRA_CONTENT { return "extra content at the end of well balanced chunk" }
    if code == ERR_VERSION_MISSING { return "Malformed declaration expecting version" }
    if code == ERR_NAME_TOO_LONG { return "Name too long" }
    return "Unregistered error message"
}

inline fn stopped(p: *Parser) -> bool { return p.*.disableSAX != 0 && p.*.instate == STATE_EOF }

// __xmlRaiseError for a parser: the message formatted, the position
// that of the current input (of the one under it when the current one
// is an entity's without a file name), handed to the handler.
fn raise(p: *Parser, domain: i64, code: i64, level: i64, str1: usize, str2: usize, str3: usize, int1: i64, fmt: []const u8, a1: u64, a2: u64, a3: u64, channel: i64) -> void {
    p.*.message.length = 0
    text.format(&p.*.message, fmt, a1, a2, a3)
    const record = &p.*.record
    record.*.domain = domain
    record.*.code = code
    record.*.level = level
    record.*.message = p.*.message.address
    record.*.str1 = str1
    record.*.str2 = str2
    record.*.str3 = str3
    record.*.int1 = int1
    record.*.channel = channel
    record.*.noContext = false
    record.*.file = 0
    record.*.line = 0
    record.*.col = 0
    if p.*.input != 0 {
        var i = inp(p)
        if i.*.filename == 0 && p.*.inputNr > 1 { i = inputAt(word(p.*.inputs, p.*.inputNr - 2)) }
        record.*.file = i.*.filename
        record.*.line = i.*.line
        record.*.col = i.*.col
    }
    if p.*.handler.reportError != 0 {
        const call: ErrorFn = unsafe { @ptrFromInt(ErrorFn, p.*.handler.reportError) }
        call(p.*.handler.user, record)
    }
}

// An error raised without the parser's context (libxml2's
// xmlEncodingErr and xmlIOErr: they reach the generic error handler).
fn raiseNoContext(p: *Parser, domain: i64, code: i64, level: i64, fmt: []const u8, a1: u64) -> void {
    p.*.message.length = 0
    text.format(&p.*.message, fmt, a1, 0, 0)
    const record = &p.*.record
    text.zero(@intFromPtr(record), @sizeOf(ErrorRecord))
    record.*.domain = domain
    record.*.code = code
    record.*.level = level
    record.*.message = p.*.message.address
    record.*.str1 = a1
    record.*.noContext = true
    if p.*.handler.reportError != 0 {
        const call: ErrorFn = unsafe { @ptrFromInt(ErrorFn, p.*.handler.reportError) }
        call(p.*.handler.user, record)
    }
}

fn fatalDone(p: *Parser) -> void {
    p.*.wellFormed = false
    if !p.*.recovery { p.*.disableSAX = 1 }
}

// xmlErrMemory.
fn errMemory(p: *Parser) -> void {
    if stopped(p) { return }
    p.*.errNo = ERR_NO_MEMORY
    p.*.instate = STATE_EOF
    p.*.disableSAX = 1
    raise(p, FROM_PARSER, ERR_NO_MEMORY, LEVEL_FATAL, 0, 0, 0, 0, "Memory allocation failed\n", 0, 0, 0, 0)
}

// xmlErrAttributeDup.
fn errAttributeDup(p: *Parser, prefix: usize, localname: usize) -> void {
    if stopped(p) { return }
    p.*.errNo = ERR_ATTRIBUTE_REDEFINED
    if prefix == 0 {
        raise(p, FROM_PARSER, ERR_ATTRIBUTE_REDEFINED, LEVEL_FATAL, localname, 0, 0, 0, "Attribute %s redefined\n", localname, 0, 0, 0)
    } else {
        raise(p, FROM_PARSER, ERR_ATTRIBUTE_REDEFINED, LEVEL_FATAL, prefix, localname, 0, 0, "Attribute %s:%s redefined\n", prefix, localname, 0, 0)
    }
    fatalDone(p)
}

// xmlFatalErr, INFO 0 or a C string.
fn fatalErr(p: *Parser, code: i64, info: usize) -> void {
    if stopped(p) { return }
    p.*.errNo = code
    // (The table's texts are literals: C strings as they are.)
    const msg = @intFromPtr(errorText(code).pointer)
    if info == 0 {
        raise(p, FROM_PARSER, code, LEVEL_FATAL, 0, 0, 0, 0, "%s\n", msg, 0, 0, 0)
    } else {
        raise(p, FROM_PARSER, code, LEVEL_FATAL, info, 0, 0, 0, "%s: %s\n", msg, info, 0, 0)
    }
    fatalDone(p)
}

// (INFO a literal: a C string as it is.)
fn fatalErrInfo(p: *Parser, code: i64, info: []const u8) -> void { fatalErr(p, code, @intFromPtr(info.pointer)) }

// xmlFatalErrMsg.
fn fatalErrMsg(p: *Parser, code: i64, msg: []const u8) -> void {
    if stopped(p) { return }
    p.*.errNo = code
    raise(p, FROM_PARSER, code, LEVEL_FATAL, 0, 0, 0, 0, msg, 0, 0, 0, 0)
    fatalDone(p)
}

// xmlWarningMsg.
fn warningMsg(p: *Parser, code: i64, fmt: []const u8, str1: usize, str2: usize) -> void {
    if stopped(p) { return }
    raise(p, FROM_PARSER, code, LEVEL_WARNING, str1, str2, 0, 0, fmt, str1, str2, 0, 0)
}

// xmlValidityError.
fn validityError(p: *Parser, code: i64, fmt: []const u8, str1: usize, str2: usize) -> void {
    if stopped(p) { return }
    p.*.errNo = code
    raise(p, FROM_DTD, code, LEVEL_ERROR, str1, str2, 0, 0, fmt, str1, str2, 0, 2)
    p.*.valid = false
}

// xmlFatalErrMsgInt.
fn fatalErrMsgInt(p: *Parser, code: i64, fmt: []const u8, val: i64) -> void {
    if stopped(p) { return }
    p.*.errNo = code
    raise(p, FROM_PARSER, code, LEVEL_FATAL, 0, 0, 0, val, fmt, @bitCast(u64, val), 0, 0, 0)
    fatalDone(p)
}

// xmlFatalErrMsgStrIntStr.
fn fatalErrMsgStrIntStr(p: *Parser, code: i64, fmt: []const u8, str1: usize, val: i64, str2: usize) -> void {
    if stopped(p) { return }
    p.*.errNo = code
    raise(p, FROM_PARSER, code, LEVEL_FATAL, str1, str2, 0, val, fmt, str1, @bitCast(u64, val), str2, 0)
    fatalDone(p)
}

// xmlFatalErrMsgStr.
fn fatalErrMsgStr(p: *Parser, code: i64, fmt: []const u8, val: usize) -> void {
    if stopped(p) { return }
    p.*.errNo = code
    raise(p, FROM_PARSER, code, LEVEL_FATAL, val, 0, 0, 0, fmt, val, 0, 0, 0)
    fatalDone(p)
}

// xmlErrMsgStr: an error, not fatal.
fn errMsgStr(p: *Parser, code: i64, fmt: []const u8, val: usize) -> void {
    if stopped(p) { return }
    p.*.errNo = code
    raise(p, FROM_PARSER, code, LEVEL_ERROR, val, 0, 0, 0, fmt, val, 0, 0, 0)
}

// xmlNsErr.
fn nsErr(p: *Parser, code: i64, fmt: []const u8, info1: usize, info2: usize, info3: usize) -> void {
    if stopped(p) { return }
    p.*.errNo = code
    raise(p, FROM_NAMESPACE, code, LEVEL_ERROR, info1, info2, info3, 0, fmt, info1, info2, info3, 0)
    p.*.nsWellFormed = false
}

// xmlNsWarn.
fn nsWarn(p: *Parser, code: i64, fmt: []const u8, info1: usize, info2: usize, info3: usize) -> void {
    if stopped(p) { return }
    raise(p, FROM_NAMESPACE, code, LEVEL_WARNING, info1, info2, info3, 0, fmt, info1, info2, info3, 0)
}

// __xmlErrEncoding.
fn errEncoding(p: *Parser, code: i64, fmt: []const u8, str1: usize, str2: usize) -> void {
    if stopped(p) { return }
    p.*.errNo = code
    raise(p, FROM_PARSER, code, LEVEL_FATAL, str1, str2, 0, 0, fmt, str1, str2, 0, 0)
    fatalDone(p)
}

// xmlErrEncodingInt.
fn errEncodingInt(p: *Parser, code: i64, fmt: []const u8, val: i64) -> void {
    if stopped(p) { return }
    p.*.errNo = code
    raise(p, FROM_PARSER, code, LEVEL_FATAL, 0, 0, 0, val, fmt, @bitCast(u64, val), 0, 0, 0)
    fatalDone(p)
}

// xmlErrInternal.
fn errInternal(p: *Parser, fmt: []const u8, str: usize) -> void {
    if stopped(p) { return }
    p.*.errNo = ERR_INTERNAL_ERROR
    raise(p, FROM_PARSER, ERR_INTERNAL_ERROR, LEVEL_FATAL, str, 0, 0, 0, fmt, str, 0, 0, 0)
    fatalDone(p)
}

// "Input is not proper UTF-8, indicate encoding !" with the four bytes
// at the current input's cursor.
fn errNotUTF8(p: *Parser) -> void {
    var b: Buffer = undefined
    if !text.bufferInit(&b, p.*.allocator, 64) { return }
    const at = CUR_PTR(p)
    text.format(&b, "Bytes: 0x%02X 0x%02X 0x%02X ", text.get8(at), text.get8(at + 1), text.get8(at + 2))
    text.format(&b, "0x%02X\n", text.get8(at + 3), 0, 0)
    errEncoding(p, ERR_INVALID_CHAR, "Input is not proper UTF-8, indicate encoding !\n%s", b.address, 0)
    text.bufferFree(&b)
}

// ---------------------------------------------------------------------------
// Halting

// xmlHaltParser: no more parsing, no more callbacks, the inputs gone.
pub fn halt(p: *Parser) -> void {
    p.*.instate = STATE_EOF
    p.*.disableSAX = 1
    while p.*.inputNr > 1 { freeInput(p, inputPop(p)) }
    if p.*.input != 0 {
        const i = inp(p)
        i.*.cur = p.*.empty
        i.*.base = p.*.empty
        i.*.end = p.*.empty
        i.*.length = 0
    }
    p.*.halted = true
}

// xmlStopParser.
pub fn stop(p: *Parser) -> void {
    halt(p)
    p.*.errNo = ERR_USER_STOP
}

// ---------------------------------------------------------------------------
// Characters (xmlCurrentChar, xmlNextChar, xmlStringCurrentChar)

// The character at the cursor and its length in bytes (LEN); a carriage
// return before a line feed is skipped and a lone one read as a line
// feed, as libxml2 does.
fn currentChar(p: *Parser, len: *usize) -> u64 {
    if p.*.instate == STATE_EOF { return 0 }
    const i = inp(p)
    const c = text.get8(i.*.cur)
    if c >= 0x20 && c <= 0x7F {
        len.* = 1
        return c
    }
    if p.*.charset == encoding.ENC_UTF8 {
        const cur = i.*.cur
        if (c & 0x80) != 0 {
            var bad = false
            var val: u64 = 0
            if (c & 0x40) == 0 || c == 0xC0 {
                bad = true
            } else if (text.get8(cur + 1) & 0xC0) != 0x80 {
                bad = true
            } else if (c & 0xE0) == 0xE0 {
                if (text.get8(cur + 2) & 0xC0) != 0x80 {
                    bad = true
                } else if (c & 0xF0) == 0xF0 {
                    if (c & 0xF8) != 0xF0 || (text.get8(cur + 3) & 0xC0) != 0x80 {
                        bad = true
                    } else {
                        len.* = 4
                        val = ((c & 0x7) << 18) | ((text.get8(cur + 1) & 0x3F) << 12) | ((text.get8(cur + 2) & 0x3F) << 6) | (text.get8(cur + 3) & 0x3F)
                        if val < 0x10000 { bad = true }
                    }
                } else {
                    len.* = 3
                    val = ((c & 0xF) << 12) | ((text.get8(cur + 1) & 0x3F) << 6) | (text.get8(cur + 2) & 0x3F)
                    if val < 0x800 { bad = true }
                }
            } else {
                len.* = 2
                val = ((c & 0x1F) << 6) | (text.get8(cur + 1) & 0x3F)
                if val < 0x80 { bad = true }
            }
            if bad {
                if i.*.end - i.*.cur < 4 {
                    len.* = 0
                    return 0
                }
                errNotUTF8(p)
                p.*.charset = encoding.ENC_8859_1
                len.* = 1
                return text.get8(inp(p).*.cur)
            }
            if !text.isChar(val) {
                errEncodingInt(p, ERR_INVALID_CHAR, "Char 0x%X out of allowed range\n", @intCast(i64, val))
            }
            return val
        }
        len.* = 1
        if c == 0 && i.*.end > i.*.cur {
            errEncodingInt(p, ERR_INVALID_CHAR, "Char 0x0 out of allowed range\n", 0)
        }
        if c == 0xD {
            if text.get8(i.*.cur + 1) == 0xA { i.*.cur += 1 }
            return 0xA
        }
        return c
    }
    len.* = 1
    if c == 0xD {
        if text.get8(i.*.cur + 1) == 0xA { i.*.cur += 1 }
        return 0xA
    }
    return c
}

// xmlNextChar: past the current character, a line end counted.
fn nextChar(p: *Parser) -> void {
    if p.*.instate == STATE_EOF || p.*.input == 0 { return }
    const i = inp(p)
    if text.get8(i.*.cur) == 0 { return }
    if p.*.charset == encoding.ENC_UTF8 {
        if text.get8(i.*.cur) == 10 {
            i.*.line += 1
            i.*.col = 1
        } else {
            i.*.col += 1
        }
        const cur = i.*.cur
        const c = text.get8(cur)
        if (c & 0x80) != 0 {
            var bad = false
            if c == 0xC0 {
                bad = true
            } else if (text.get8(cur + 1) & 0xC0) != 0x80 {
                bad = true
            } else if (c & 0xE0) == 0xE0 {
                if (text.get8(cur + 2) & 0xC0) != 0x80 {
                    bad = true
                } else {
                    var val: u64 = 0
                    if (c & 0xF0) == 0xF0 {
                        if (c & 0xF8) != 0xF0 || (text.get8(cur + 3) & 0xC0) != 0x80 {
                            bad = true
                        } else {
                            i.*.cur += 4
                            val = ((c & 0x7) << 18) | ((text.get8(cur + 1) & 0x3F) << 12) | ((text.get8(cur + 2) & 0x3F) << 6) | (text.get8(cur + 3) & 0x3F)
                        }
                    } else {
                        i.*.cur += 3
                        val = ((c & 0xF) << 12) | ((text.get8(cur + 1) & 0x3F) << 6) | (text.get8(cur + 2) & 0x3F)
                    }
                    if !bad && ((val > 0xD7FF && val < 0xE000) || (val > 0xFFFD && val < 0x10000) || val >= 0x110000) {
                        errEncodingInt(p, ERR_INVALID_CHAR, "Char 0x%X out of allowed range\n", @intCast(i64, val))
                    }
                }
            } else {
                i.*.cur += 2
            }
            if bad {
                if i.*.end - i.*.cur < 4 {
                    errEncoding(p, ERR_INVALID_CHAR, "Input is not proper UTF-8, indicate encoding !\n", 0, 0)
                } else {
                    errNotUTF8(p)
                }
                p.*.charset = encoding.ENC_8859_1
                inp(p).*.cur += 1
            }
        } else {
            i.*.cur += 1
        }
    } else {
        if text.get8(i.*.cur) == 10 {
            i.*.line += 1
            i.*.col = 1
        } else {
            i.*.col += 1
        }
        i.*.cur += 1
    }
}

// xmlStringCurrentChar: the character at CUR of a string.
fn stringCurrentChar(p: *Parser, cur: usize, len: *usize) -> u64 {
    if p.*.charset == encoding.ENC_UTF8 {
        const c = text.get8(cur)
        if (c & 0x80) != 0 {
            var bad = false
            var val: u64 = 0
            if (text.get8(cur + 1) & 0xC0) != 0x80 {
                bad = true
            } else if (c & 0xE0) == 0xE0 {
                if (text.get8(cur + 2) & 0xC0) != 0x80 {
                    bad = true
                } else if (c & 0xF0) == 0xF0 {
                    if (c & 0xF8) != 0xF0 || (text.get8(cur + 3) & 0xC0) != 0x80 {
                        bad = true
                    } else {
                        len.* = 4
                        val = ((c & 0x7) << 18) | ((text.get8(cur + 1) & 0x3F) << 12) | ((text.get8(cur + 2) & 0x3F) << 6) | (text.get8(cur + 3) & 0x3F)
                    }
                } else {
                    len.* = 3
                    val = ((c & 0xF) << 12) | ((text.get8(cur + 1) & 0x3F) << 6) | (text.get8(cur + 2) & 0x3F)
                }
            } else {
                len.* = 2
                val = ((c & 0x1F) << 6) | (text.get8(cur + 1) & 0x3F)
            }
            if bad {
                if p.*.input == 0 || inp(p).*.end - inp(p).*.cur < 4 {
                    len.* = 0
                    return 0
                }
                errNotUTF8(p)
                len.* = 1
                return text.get8(cur)
            }
            if !text.isChar(val) {
                errEncodingInt(p, ERR_INVALID_CHAR, "Char 0x%X out of allowed range\n", @intCast(i64, val))
            }
            return val
        }
        len.* = 1
        return c
    }
    len.* = 1
    return text.get8(cur)
}

// COPY_BUF: a character read with length L (1: its byte as it is).
fn copyBuf(b: *Buffer, l: usize, v: u64) -> void {
    if l == 1 {
        text.bufferAddByte(b, v)
    } else {
        text.bufferAddChar(b, v)
    }
}

// ---------------------------------------------------------------------------
// The input stack

fn newInput(p: *Parser) -> usize {
    const address = alloc(p, @sizeOf(Input))
    if address == 0 { return 0 }
    const i = inputAt(address)
    i.*.line = 1
    i.*.col = 1
    i.*.standalone = -1
    i.*.id = p.*.inputId
    p.*.inputId += 1
    return address
}

fn freeInput(p: *Parser, address: usize) -> void {
    if address == 0 { return }
    const i = inputAt(address)
    dealloc(p, i.*.filename)
    dealloc(p, i.*.encoding)
    dealloc(p, i.*.version)
    dealloc(p, i.*.owned)
    dealloc(p, address)
}

fn inputPush(p: *Parser, address: usize) -> i64 {
    if p.*.inputNr >= p.*.inputMax {
        const grown = growWords(p, p.*.inputs, p.*.inputMax * 2)
        if grown == 0 { return -1 }
        p.*.inputs = grown
        p.*.inputMax = p.*.inputMax * 2
    }
    setWord(p.*.inputs, p.*.inputNr, address)
    p.*.input = address
    p.*.inputNr += 1
    return p.*.inputNr - 1
}

fn inputPop(p: *Parser) -> usize {
    if p.*.inputNr <= 0 { return 0 }
    p.*.inputNr -= 1
    if p.*.inputNr > 0 {
        p.*.input = word(p.*.inputs, p.*.inputNr - 1)
    } else {
        p.*.input = 0
    }
    const ret = word(p.*.inputs, p.*.inputNr)
    setWord(p.*.inputs, p.*.inputNr, 0)
    return ret
}

// xmlPopInput.
fn popInput(p: *Parser) -> u64 {
    if p.*.inputNr <= 1 { return 0 }
    if p.*.inputNr > 1 && p.*.inSubset == 0 && p.*.instate != STATE_EOF {
        fatalErrInfo(p, ERR_INTERNAL_ERROR, "Unfinished entity outside the DTD")
    }
    freeInput(p, inputPop(p))
    return RAW(p)
}

// xmlPushInput.
fn pushInput(p: *Parser, address: usize) -> i64 {
    if address == 0 { return -1 }
    if (p.*.inputNr > 40 && (p.*.options & PARSE_HUGE) == 0) || p.*.inputNr > 1024 {
        fatalErr(p, ERR_ENTITY_LOOP, 0)
        while p.*.inputNr > 1 { freeInput(p, inputPop(p)) }
        return -1
    }
    const ret = inputPush(p, address)
    if p.*.instate == STATE_EOF { return -1 }
    return ret
}

// xmlSkipBlankChars: past the blanks, how many; in the DTD, parameter
// entity references expanded and finished entities popped.
fn skipBlanks(p: *Parser) -> i64 {
    var res: i64 = 0
    if (p.*.inputNr == 1 && p.*.instate != STATE_DTD) || p.*.instate == STATE_START {
        const i = inp(p)
        var cur = i.*.cur
        while text.isBlank(text.get8(cur)) {
            if text.get8(cur) == 10 {
                i.*.line += 1
                i.*.col = 1
            } else {
                i.*.col += 1
            }
            cur += 1
            if res < 2147483647 { res += 1 }
        }
        i.*.cur = cur
    } else {
        const expandPE = p.*.inputNr != 1
        while true {
            const c = RAW(p)
            if text.isBlank(c) {
                nextChar(p)
            } else if c == 37 {
                if !expandPE || text.isBlank(NXT(p, 1)) || NXT(p, 1) == 0 { break }
                parsePEReference(p)
            } else if c == 0 {
                if p.*.inputNr <= 1 { break }
                const consumed = inp(p).*.consumed + @intCast(u64, inp(p).*.cur - inp(p).*.base)
                const ignoredCheck = entityCheck(p, consumed)
                const ignored = popInput(p)
            } else {
                break
            }
            if res < 2147483647 { res += 1 }
        }
    }
    return res
}

// ---------------------------------------------------------------------------
// Entities: the predefined five, the handler's, or the parser's own

// A declared entity of the parser's own table (when the handler keeps
// none): the C strings it owns and its `checked` count.
const OwnEntity = struct {
    next: usize
    etype: i64
    name: usize
    content: usize
    length: i64
    checked: u64
    uri: usize
    externalId: usize
    expanded: u64
}

inline fn ownEntityAt(address: usize) -> *OwnEntity { return unsafe { @ptrFromInt(*OwnEntity, address) } }

fn viewOfOwn(address: usize, view: *EntityView) -> void {
    const e = ownEntityAt(address)
    view.*.address = address
    view.*.etype = e.*.etype
    view.*.name = e.*.name
    view.*.content = e.*.content
    view.*.length = e.*.length
    view.*.checked = address + 40
    view.*.children = 0
    view.*.uri = e.*.uri
    view.*.externalId = e.*.externalId
    view.*.orig = 0
    view.*.expandedSize = address + 64
}

fn findOwn(p: *Parser, name: usize, parameter: bool, view: *EntityView) -> bool {
    var at = p.*.entities
    while at != 0 {
        const e = ownEntityAt(at)
        const isParameter = e.*.etype == INTERNAL_PARAMETER_ENTITY || e.*.etype == EXTERNAL_PARAMETER_ENTITY
        if isParameter == parameter && text.equal(e.*.name, name) {
            viewOfOwn(at, view)
            return true
        }
        at = e.*.next
    }
    return false
}

// The parser's own record of a declaration (the first one of a name
// wins, as in libxml2's tables).
fn addOwn(p: *Parser, name: usize, etype: i64, publicId: usize, systemId: usize, content: usize) -> void {
    if p.*.handler.getEntity != 0 { return }
    var view: EntityView = undefined
    const parameter = etype == INTERNAL_PARAMETER_ENTITY || etype == EXTERNAL_PARAMETER_ENTITY
    if findOwn(p, name, parameter, &view) { return }
    if !parameter && predefined(p, name, &view) {
        // xmlAddEntity: only a redeclaration of the same character.
        var valid = false
        const c = text.get8(view.content)
        if etype == INTERNAL_GENERAL_ENTITY && content != 0 {
            if text.get8(content) == c && text.get8(content + 1) == 0 && (c == 62 || c == 39 || c == 34) { valid = true }
        }
        if !valid { return }
    }
    const address = alloc(p, @sizeOf(OwnEntity))
    if address == 0 { return }
    const e = ownEntityAt(address)
    e.*.etype = etype
    e.*.name = text.duplicateString(p.*.allocator, name)
    e.*.content = text.duplicateString(p.*.allocator, content)
    e.*.length = @intCast(i64, text.length(content))
    e.*.uri = text.duplicateString(p.*.allocator, systemId)
    e.*.externalId = text.duplicateString(p.*.allocator, publicId)
    e.*.next = p.*.entities
    p.*.entities = address
}

fn freeOwn(p: *Parser) -> void {
    var at = p.*.entities
    while at != 0 {
        const e = ownEntityAt(at)
        const next = e.*.next
        dealloc(p, e.*.name)
        dealloc(p, e.*.content)
        dealloc(p, e.*.uri)
        dealloc(p, e.*.externalId)
        dealloc(p, at)
        at = next
    }
    p.*.entities = 0
}

// The five predefined entities: their names and contents are the
// parser's dictionary's (one record each, kept in the dictionary's
// strings: name, then content).
fn predefined(p: *Parser, name: usize, view: *EntityView) -> bool {
    if name == 0 { return false }
    var content: []const u8 = ""
    if text.equalText(name, "lt") {
        content = "<"
    } else if text.equalText(name, "gt") {
        content = ">"
    } else if text.equalText(name, "amp") {
        content = "&"
    } else if text.equalText(name, "apos") {
        content = "'"
    } else if text.equalText(name, "quot") {
        content = "\""
    } else {
        return false
    }
    view.*.address = 0
    view.*.etype = INTERNAL_PREDEFINED_ENTITY
    view.*.name = text.dictLookupString(p.*.dict, name)
    view.*.content = text.dictLookupText(p.*.dict, content)
    view.*.length = 1
    view.*.checked = 0
    view.*.children = 0
    view.*.uri = 0
    view.*.externalId = 0
    view.*.orig = 0
    view.*.expandedSize = 0
    return true
}

// xmlGetPredefinedEntity for C: the content of a predefined entity's
// name, 0 for another name.
pub fn predefinedContent(name: usize) -> []const u8 {
    if text.equalText(name, "lt") { return "<" }
    if text.equalText(name, "gt") { return ">" }
    if text.equalText(name, "amp") { return "&" }
    if text.equalText(name, "apos") { return "'" }
    if text.equalText(name, "quot") { return "\"" }
    return ""
}

// The parser's own table (when the handler has no getEntity): this
// parser's declarations, then those of the parsers it is nested in.
fn ownGetEntity(p: *Parser, name: usize, view: *EntityView) -> bool {
    if findOwn(p, name, false, view) { return true }
    var at = p.*.parent
    while at != 0 {
        if findOwn(parserAt(at), name, false, view) { return true }
        at = parserAt(at).*.parent
    }
    return false
}

fn getParameterEntity(p: *Parser, name: usize, view: *EntityView) -> bool {
    view.*.orig = 0
    if p.*.handler.getParameterEntity != 0 {
        const call: ParameterEntityFn = unsafe { @ptrFromInt(ParameterEntityFn, p.*.handler.getParameterEntity) }
        p.*.view.orig = 0
        const found = call(p.*.handler.user, name, &p.*.view)
        view.* = p.*.view
        return found
    }
    if p.*.handler.getEntity != 0 { return false }
    return findOwn(p, name, true, view)
}

inline fn checkedOf(view: *EntityView) -> i64 {
    if view.*.checked == 0 { return 0 }
    return text.getInt(view.*.checked)
}

inline fn setChecked(view: *EntityView, value: i64) -> void {
    if view.*.checked != 0 { text.putInt(view.*.checked, value) }
}

// The size of the entity's expansion (its expandedSize, an unsigned long).
inline fn expandedOf(view: *EntityView) -> u64 {
    if view.*.expandedSize == 0 { return 0 }
    return text.get64(view.*.expandedSize)
}

inline fn setExpanded(view: *EntityView, value: u64) -> void {
    if view.*.expandedSize != 0 { text.put64(view.*.expandedSize, value) }
}

// ---------------------------------------------------------------------------
// The callbacks

inline fn user(p: *Parser) -> usize { return p.*.handler.user }

fn call0(f: usize, u: usize) -> void {
    const call: Call0Fn = unsafe { @ptrFromInt(Call0Fn, f) }
    call(u)
}

fn call1(f: usize, u: usize, a: usize) -> void {
    const call: Call1Fn = unsafe { @ptrFromInt(Call1Fn, f) }
    call(u, a)
}

fn call2(f: usize, u: usize, a: usize, b: usize) -> void {
    const call: Call2Fn = unsafe { @ptrFromInt(Call2Fn, f) }
    call(u, a, b)
}

fn call3(f: usize, u: usize, a: usize, b: usize, c: usize) -> void {
    const call: Call3Fn = unsafe { @ptrFromInt(Call3Fn, f) }
    call(u, a, b, c)
}

fn call4(f: usize, u: usize, a: usize, b: usize, c: usize, d: usize) -> void {
    const call: Call4Fn = unsafe { @ptrFromInt(Call4Fn, f) }
    call(u, a, b, c, d)
}

// characters, ignorableWhitespace, cdataBlock.
fn callText(f: usize, u: usize, s: usize, len: i64) -> void {
    const call: TextFn = unsafe { @ptrFromInt(TextFn, f) }
    call(u, s, len)
}

fn characters(p: *Parser, s: usize, len: usize) -> void {
    if p.*.handler.characters != 0 { callText(p.*.handler.characters, user(p), s, @intCast(i64, len)) }
}

fn ignorable(p: *Parser, s: usize, len: usize) -> void {
    if p.*.handler.ignorableWhitespace != 0 { callText(p.*.handler.ignorableWhitespace, user(p), s, @intCast(i64, len)) }
}

fn cdataBlock(p: *Parser, s: usize, len: usize) -> void {
    if p.*.handler.cdataBlock != 0 {
        callText(p.*.handler.cdataBlock, user(p), s, @intCast(i64, len))
    } else if p.*.handler.characters != 0 {
        callText(p.*.handler.characters, user(p), s, @intCast(i64, len))
    }
}

// Whether the handler's ignorableWhitespace is not its characters.
fn whitespaceDiffers(p: *Parser) -> bool {
    if p.*.handler.whitespaceDiffers != 0 {
        const call: QueryFn = unsafe { @ptrFromInt(QueryFn, p.*.handler.whitespaceDiffers) }
        return call(user(p))
    }
    return p.*.handler.ignorableWhitespace != p.*.handler.characters
}

fn reference(p: *Parser, name: usize) -> void {
    if p.*.handler.reference != 0 { call1(p.*.handler.reference, user(p), name) }
}

// ---------------------------------------------------------------------------
// The xml:space stack

fn spacePush(p: *Parser, val: i64) -> void {
    if p.*.spaceNr >= p.*.spaceMax {
        const grown = growWords(p, p.*.spaceTab, p.*.spaceMax * 2)
        if grown == 0 { return }
        p.*.spaceTab = grown
        p.*.spaceMax = p.*.spaceMax * 2
    }
    setWord(p.*.spaceTab, p.*.spaceNr, @bitCast(usize, val))
    p.*.spaceNr += 1
}

fn spacePop(p: *Parser) -> void {
    if p.*.spaceNr <= 0 { return }
    p.*.spaceNr -= 1
    setWord(p.*.spaceTab, p.*.spaceNr, @bitCast(usize, @intCast(i64, -1)))
}

// *ctxt->space.
fn space(p: *Parser) -> i64 {
    const index = if p.*.spaceNr > 0 { p.*.spaceNr - 1 } else { 0 }
    return @bitCast(i64, word(p.*.spaceTab, index))
}

fn setSpace(p: *Parser, val: i64) -> void {
    const index = if p.*.spaceNr > 0 { p.*.spaceNr - 1 } else { 0 }
    setWord(p.*.spaceTab, index, @bitCast(usize, val))
}

// areBlanks: whether blanks are ignorable whitespace. Without a tree
// (ctxt->node), never; in an entity's content (whose parser has the
// pseudo root as its node) when they are followed by a tag, as libxml2
// decides for an element without declaration or children.
fn areBlanks(p: *Parser, s: usize, len: usize, blankChars: bool) -> bool {
    if !whitespaceDiffers(p) { return false }
    const sp = space(p)
    if sp == 1 || sp == -2 { return false }
    if !blankChars {
        var index: usize = 0
        while index < len {
            if !text.isBlank(text.get8(s + index)) { return false }
            index += 1
        }
    }
    if !p.*.nested { return false }
    if RAW(p) != 60 && RAW(p) != 0xD { return false }
    if RAW(p) == 60 && NXT(p, 1) == 47 { return false }
    return true
}

// The characters callback or the ignorableWhitespace one for text that
// may be blanks (and the xml:space state libxml2 keeps).
fn textCallback(p: *Parser, s: usize, len: usize, blankChars: bool) -> void {
    if areBlanks(p, s, len, blankChars) {
        ignorable(p, s, len)
    } else {
        characters(p, s, len)
        if space(p) == -1 { setSpace(p, -2) }
    }
}

// ---------------------------------------------------------------------------
// Character references (xmlParseCharRef, xmlParseStringCharRef)

fn parseCharRef(p: *Parser) -> u64 {
    var val: u64 = 0
    var count: i64 = 0
    if RAW(p) == 38 && NXT(p, 1) == 35 && NXT(p, 2) == 120 {
        SKIP(p, 3)
        while RAW(p) != 59 {
            const old = count
            count += 1
            if old > 20 {
                count = 0
                if p.*.instate == STATE_EOF { return 0 }
            }
            const c = RAW(p)
            if c >= 48 && c <= 57 {
                val = val * 16 + (c - 48)
            } else if c >= 97 && c <= 102 && count < 20 {
                val = val * 16 + (c - 97) + 10
            } else if c >= 65 && c <= 70 && count < 20 {
                val = val * 16 + (c - 65) + 10
            } else {
                fatalErr(p, ERR_INVALID_HEX_CHARREF, 0)
                val = 0
                break
            }
            if val > 0x110000 { val = 0x110000 }
            nextChar(p)
            count += 1
        }
        if RAW(p) == 59 {
            inp(p).*.col += 1
            inp(p).*.cur += 1
        }
    } else if RAW(p) == 38 && NXT(p, 1) == 35 {
        SKIP(p, 2)
        while RAW(p) != 59 {
            const old = count
            count += 1
            if old > 20 {
                count = 0
                if p.*.instate == STATE_EOF { return 0 }
            }
            const c = RAW(p)
            if c >= 48 && c <= 57 {
                val = val * 10 + (c - 48)
            } else {
                fatalErr(p, ERR_INVALID_DEC_CHARREF, 0)
                val = 0
                break
            }
            if val > 0x110000 { val = 0x110000 }
            nextChar(p)
            count += 1
        }
        if RAW(p) == 59 {
            inp(p).*.col += 1
            inp(p).*.cur += 1
        }
    } else {
        fatalErr(p, ERR_INVALID_CHARREF, 0)
    }
    if val >= 0x110000 {
        fatalErrMsgInt(p, ERR_INVALID_CHAR, "xmlParseCharRef: character reference out of bounds\n", @intCast(i64, val))
    } else if text.isChar(val) {
        return val
    } else {
        fatalErrMsgInt(p, ERR_INVALID_CHAR, "xmlParseCharRef: invalid xmlChar value %d\n", @intCast(i64, val))
    }
    return 0
}

fn parseStringCharRef(p: *Parser, str: *usize) -> u64 {
    var ptr = str.*
    var cur = text.get8(ptr)
    var val: u64 = 0
    if cur == 38 && text.get8(ptr + 1) == 35 && text.get8(ptr + 2) == 120 {
        ptr += 3
        cur = text.get8(ptr)
        while cur != 59 {
            if cur >= 48 && cur <= 57 {
                val = val * 16 + (cur - 48)
            } else if cur >= 97 && cur <= 102 {
                val = val * 16 + (cur - 97) + 10
            } else if cur >= 65 && cur <= 70 {
                val = val * 16 + (cur - 65) + 10
            } else {
                fatalErr(p, ERR_INVALID_HEX_CHARREF, 0)
                val = 0
                break
            }
            if val > 0x110000 { val = 0x110000 }
            ptr += 1
            cur = text.get8(ptr)
        }
        if cur == 59 { ptr += 1 }
    } else if cur == 38 && text.get8(ptr + 1) == 35 {
        ptr += 2
        cur = text.get8(ptr)
        while cur != 59 {
            if cur >= 48 && cur <= 57 {
                val = val * 10 + (cur - 48)
            } else {
                fatalErr(p, ERR_INVALID_DEC_CHARREF, 0)
                val = 0
                break
            }
            if val > 0x110000 { val = 0x110000 }
            ptr += 1
            cur = text.get8(ptr)
        }
        if cur == 59 { ptr += 1 }
    } else {
        fatalErr(p, ERR_INVALID_CHARREF, 0)
        return 0
    }
    str.* = ptr
    if val >= 0x110000 {
        fatalErrMsgInt(p, ERR_INVALID_CHAR, "xmlParseStringCharRef: character reference out of bounds\n", @intCast(i64, val))
    } else if text.isChar(val) {
        return val
    } else {
        fatalErrMsgInt(p, ERR_INVALID_CHAR, "xmlParseStringCharRef: invalid xmlChar value %d\n", @intCast(i64, val))
    }
    return 0
}

// ---------------------------------------------------------------------------
// Entities in strings (xmlStringDecodeEntities): references replaced in
// a copy of STR (0 on an error). WHAT: 1 general entities, 2 parameter
// entities.

const SUBSTITUTE_REF: u64 = 1
const SUBSTITUTE_PEREF: u64 = 2

// xmlParserEntityCheck (as Ubuntu's libxml2 2.9.14 has it, from libxml2
// 2.11): EXTRA bytes of entities' text (and a fixed cost) counted as
// copied; when the copies pass ten million bytes and ten times what was
// read, the document is taken for an attack (a "billion laughs") and the
// parse stopped. True when it is.
fn entityCheck(p: *Parser, extra: u64) -> bool {
    var consumed: u64 = 0
    if p.*.input != 0 {
        const i = inp(p)
        consumed = i.*.parentConsumed + i.*.consumed + @intCast(u64, i.*.cur - i.*.base)
    }
    consumed += p.*.sizeentities
    p.*.sizeentcopy += extra + ENT_FIXED_COST
    if p.*.sizeentcopy > @intCast(u64, MAX_TEXT_LENGTH) && p.*.sizeentcopy / 10 > consumed {
        fatalErrMsg(p, ERR_ENTITY_LOOP, "Maximum entity amplification factor exceeded")
        halt(p)
        return true
    }
    return false
}

// The entity's length as its record has it.
inline fn lengthOf(view: *EntityView) -> u64 { return if view.*.length < 0 { 0 } else { @intCast(u64, view.*.length) } }

fn stringDecodeEntities(p: *Parser, str: usize, what: u64) -> usize {
    if str == 0 { return 0 }
    return stringDecodeEntitiesInt(p, str, text.length(str), what, false)
}

// The stack the parse may take for the recursion of entities in
// entities: libxml2's limit of 1024 nested entities (with
// XML_PARSE_HUGE) takes more of it here than a thread's stack has to
// spare, so that the parser reports the loop when its recursion has
// taken this much.
const STACK_BUDGET: usize = 3145728

noinline fn stackExhausted(p: *Parser) -> bool {
    if p.*.stackBase == 0 { return false }
    const here = @frameAddress()
    return here < p.*.stackBase && p.*.stackBase - here > STACK_BUDGET
}

// The state of a decoding of a string's references (on the heap: the
// decodings of entities in entities nest, each frame of the recursion
// kept small).
const Decode = struct {
    s: usize
    last: usize
    b: Buffer
    l: usize
    c: u64
    what: u64
    check: bool
    view: EntityView
}

inline fn decodeAt(address: usize) -> *Decode { return unsafe { @ptrFromInt(*Decode, address) } }

fn decodeNext(p: *Parser, d: *Decode) -> void {
    if d.*.s < d.*.last {
        d.*.c = stringCurrentChar(p, d.*.s, &d.*.l)
    } else {
        d.*.c = 0
    }
}

noinline fn decodeBegin(p: *Parser, str: usize, len: usize, what: u64, check: bool) -> usize {
    const address = alloc(p, @sizeOf(Decode))
    if address == 0 { return 0 }
    const d = decodeAt(address)
    if !text.bufferInit(&d.*.b, p.*.allocator, BIG_BUFFER_SIZE) {
        dealloc(p, address)
        return 0
    }
    d.*.s = str
    d.*.last = str + len
    d.*.what = what
    d.*.check = check
    d.*.l = 0
    d.*.c = 0
    decodeNext(p, d)
    return address
}

noinline fn decodeFree(p: *Parser, address: usize) -> void {
    text.bufferFree(&decodeAt(address).*.b)
    dealloc(p, address)
}

noinline fn decodeEnd(p: *Parser, address: usize) -> usize {
    const d = decodeAt(address)
    const result = text.bufferTake(&d.*.b)
    decodeFree(p, address)
    return result
}

// One step of a decoding: 0 go on, 1 done, 2 failed, 3 the content of
// the entity d.view to decode (a general entity's), 4 a parameter
// entity's.
noinline fn decodeStep(p: *Parser, d: *Decode) -> i64 {
    const c = d.*.c
    if c == 0 || p.*.instate == STATE_EOF { return 1 }
    if c == 38 && text.get8(d.*.s + 1) == 35 {
        const val = parseStringCharRef(p, &d.*.s)
        if val == 0 { return 2 }
        text.bufferAddChar(&d.*.b, val)
    } else if c == 38 && (d.*.what & SUBSTITUTE_REF) != 0 {
        const view = &d.*.view
        const found = parseStringEntityRef(p, &d.*.s, view)
        if found && view.*.etype == INTERNAL_PREDEFINED_ENTITY {
            if view.*.content != 0 {
                text.bufferAddChar(&d.*.b, text.get8(view.*.content))
            } else {
                fatalErrMsg(p, ERR_INTERNAL_ERROR, "predefined entity has no content\n")
                return 2
            }
        } else if found && view.*.content != 0 {
            if d.*.check && entityCheck(p, lengthOf(view)) { return 2 }
            return 3
        } else if found {
            text.bufferAddByte(&d.*.b, 38)
            text.bufferAddString(&d.*.b, view.*.name)
            text.bufferAddByte(&d.*.b, 59)
        }
    } else if c == 37 && (d.*.what & SUBSTITUTE_PEREF) != 0 {
        const view = &d.*.view
        if parseStringPEReference(p, &d.*.s, view) {
            if view.*.content == 0 {
                if (p.*.options & PARSE_NOENT) == 0 && (p.*.options & PARSE_DTDVALID) == 0 && !p.*.validate {
                    warningMsg(p, ERR_ENTITY_PROCESSING, "not validating will not read content for PE entity %s\n", view.*.name, 0)
                }
            }
            if d.*.check && entityCheck(p, lengthOf(view)) { return 2 }
            return 4
        }
    } else {
        copyBuf(&d.*.b, d.*.l, c)
        d.*.s += d.*.l
    }
    decodeNext(p, d)
    return 0
}

// The decoding of an entity's content REP added (0: it failed, and so
// this one).
noinline fn decodeNested(p: *Parser, address: usize, rep: usize) -> bool {
    const d = decodeAt(address)
    if rep == 0 {
        if d.*.view.content != 0 { text.put8(d.*.view.content, 0) }
        decodeFree(p, address)
        return false
    }
    text.bufferAddString(&d.*.b, rep)
    dealloc(p, rep)
    decodeNext(p, d)
    return true
}

// xmlStringDecodeEntitiesInt: LEN bytes of STR; CHECK: the expansion
// counted against the amplification limit.
fn stringDecodeEntitiesInt(p: *Parser, str: usize, len: usize, what: u64, check: bool) -> usize {
    if str == 0 { return 0 }
    if (p.*.depth > 40 && (p.*.options & PARSE_HUGE) == 0) || p.*.depth > 1024 || stackExhausted(p) {
        fatalErr(p, ERR_ENTITY_LOOP, 0)
        return 0
    }
    const address = decodeBegin(p, str, len, what, check)
    if address == 0 { return 0 }
    while true {
        const step = decodeStep(p, decodeAt(address))
        if step == 1 { return decodeEnd(p, address) }
        if step == 2 {
            decodeFree(p, address)
            return 0
        }
        if step >= 3 {
            p.*.depth += 1
            const rep = stringDecodeEntitiesInt(p, decodeAt(address).*.view.content, @intCast(usize, lengthOf(&decodeAt(address).*.view)), what, check)
            p.*.depth -= 1
            if !decodeNested(p, address, rep) { return 0 }
        }
    }
    return 0
}

// ---------------------------------------------------------------------------
// Names

// The longest name (and literal) the parser takes, the longest text.
fn maxName(p: *Parser) -> usize { return if (p.*.options & PARSE_HUGE) != 0 { MAX_TEXT_LENGTH } else { MAX_NAME_LENGTH } }
fn maxText(p: *Parser) -> usize { return if (p.*.options & PARSE_HUGE) != 0 { MAX_HUGE_LENGTH } else { MAX_TEXT_LENGTH } }

fn nameError(p: *Parser, what: []const u8) -> usize {
    fatalErrInfo(p, ERR_NAME_TOO_LONG, what)
    return 0
}

// xmlParseNameComplex.
fn parseNameComplex(p: *Parser) -> usize {
    if p.*.instate == STATE_EOF { return 0 }
    var len: usize = 0
    var l: usize = 0
    var c = currentChar(p, &l)
    if !text.isNameStartChar(c) { return 0 }
    len += l
    NEXTL(p, l)
    c = currentChar(p, &l)
    while text.isNameChar(c) {
        len += l
        NEXTL(p, l)
        c = currentChar(p, &l)
    }
    if len > maxName(p) { return nameError(p, "Name") }
    const i = inp(p)
    if i.*.cur - i.*.base < len {
        fatalErrInfo(p, ERR_INTERNAL_ERROR, "unexpected change of input buffer")
        return 0
    }
    if text.get8(i.*.cur) == 10 && text.get8(i.*.cur - 1) == 13 { return lookup(p, i.*.cur - (len + 1), len) }
    return lookup(p, i.*.cur - len, len)
}

inline fn asciiNameStart(c: u64) -> bool { return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 || c == 58 }
inline fn asciiNameChar(c: u64) -> bool { return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 || c == 45 || c == 58 || c == 46 }

// xmlParseName: a name of the dictionary, 0 when there is none.
fn parseName(p: *Parser) -> usize {
    const i = inp(p)
    var at = i.*.cur
    if asciiNameStart(text.get8(at)) {
        at += 1
        while asciiNameChar(text.get8(at)) { at += 1 }
        const c = text.get8(at)
        if c > 0 && c < 0x80 {
            const count = at - i.*.cur
            if count > maxName(p) { return nameError(p, "Name") }
            const ret = lookup(p, i.*.cur, count)
            i.*.cur = at
            i.*.col += @intCast(i64, count)
            return ret
        }
    }
    return parseNameComplex(p)
}

// xmlParseNCNameComplex.
fn parseNCNameComplex(p: *Parser) -> usize {
    var len: usize = 0
    var l: usize = 0
    var count: i64 = 0
    const startPosition = CUR_PTR(p) - inp(p).*.base
    var c = currentChar(p, &l)
    if !text.isNameStartChar(c) || c == 58 { return 0 }
    while text.isNameChar(c) && c != 58 {
        const old = count
        count += 1
        if old > 100 {
            count = 0
            if p.*.instate == STATE_EOF { return 0 }
        }
        len += l
        NEXTL(p, l)
        c = currentChar(p, &l)
        if c == 0 {
            count = 0
            if p.*.instate == STATE_EOF { return 0 }
            c = currentChar(p, &l)
        }
    }
    if len > maxName(p) { return nameError(p, "NCName") }
    return lookup(p, inp(p).*.base + startPosition, len)
}

// xmlParseNCName.
fn parseNCName(p: *Parser) -> usize {
    const i = inp(p)
    var at = i.*.cur
    const e = i.*.end
    var c = text.get8(at)
    if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95) && at < e {
        at += 1
        c = text.get8(at)
        while ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 || c == 45 || c == 46) && at < e {
            at += 1
            c = text.get8(at)
        }
        if at < e && c > 0 && c < 0x80 {
            const count = at - i.*.cur
            if count > maxName(p) { return nameError(p, "NCName") }
            const ret = lookup(p, i.*.cur, count)
            i.*.cur = at
            i.*.col += @intCast(i64, count)
            return ret
        }
    }
    return parseNCNameComplex(p)
}

// The answer of xmlParseNameAndCompare and xmlParseQNameAndCompare when
// the name is the one expected ((const xmlChar*) 1).
const NAME_MATCHES: usize = 1

// xmlParseNameAndCompare.
fn parseNameAndCompare(p: *Parser, other: usize) -> usize {
    if p.*.instate == STATE_EOF { return 0 }
    const i = inp(p)
    var at = i.*.cur
    var cmp = other
    while text.get8(at) != 0 && text.get8(at) == text.get8(cmp) {
        at += 1
        cmp += 1
    }
    if text.get8(cmp) == 0 && (text.get8(at) == 62 || text.isBlank(text.get8(at))) {
        i.*.col += @intCast(i64, at - i.*.cur)
        i.*.cur = at
        return NAME_MATCHES
    }
    const ret = parseName(p)
    if ret == other { return NAME_MATCHES }
    return ret
}

// xmlParseStringName: a copy of the name at STR (moved past it).
fn parseStringName(p: *Parser, str: *usize) -> usize {
    var cur = str.*
    var l: usize = 0
    var c = stringCurrentChar(p, cur, &l)
    if !text.isNameStartChar(c) { return 0 }
    var b: Buffer = undefined
    if !text.bufferInit(&b, p.*.allocator, 64) { return 0 }
    copyBuf(&b, l, c)
    cur += l
    c = stringCurrentChar(p, cur, &l)
    while text.isNameChar(c) {
        copyBuf(&b, l, c)
        cur += l
        c = stringCurrentChar(p, cur, &l)
    }
    if b.length > maxName(p) {
        text.bufferFree(&b)
        return nameError(p, "NCName")
    }
    str.* = cur
    const result = text.bufferTake(&b)
    text.bufferFree(&b)
    return result
}

// xmlParseNmtoken: a copy, 0 when there is none.
fn parseNmtoken(p: *Parser) -> usize {
    if p.*.instate == STATE_EOF { return 0 }
    var l: usize = 0
    var c = currentChar(p, &l)
    var b: Buffer = undefined
    if !text.bufferInit(&b, p.*.allocator, 64) { return 0 }
    while text.isNameChar(c) {
        copyBuf(&b, l, c)
        NEXTL(p, l)
        c = currentChar(p, &l)
        if c == 0 {
            if p.*.instate == STATE_EOF {
                text.bufferFree(&b)
                return 0
            }
            c = currentChar(p, &l)
        }
    }
    if b.length == 0 {
        text.bufferFree(&b)
        return 0
    }
    if b.length > maxName(p) {
        text.bufferFree(&b)
        return nameError(p, "NmToken")
    }
    const result = text.bufferTake(&b)
    text.bufferFree(&b)
    return result
}

// ---------------------------------------------------------------------------
// Literals

// xmlParseEntityValue: the value with its parameter entities replaced
// (a block of its own, 0 on an error); ORIG the value as written.
fn parseEntityValue(p: *Parser, orig: *usize) -> usize {
    orig.* = 0
    var stop: u64 = 0
    if RAW(p) == 34 {
        stop = 34
    } else if RAW(p) == 39 {
        stop = 39
    } else {
        fatalErr(p, ERR_ENTITY_NOT_STARTED, 0)
        return 0
    }
    var b: Buffer = undefined
    if !text.bufferInit(&b, p.*.allocator, 100) { return 0 }
    p.*.instate = STATE_ENTITY_VALUE
    const input = p.*.input
    if p.*.instate == STATE_EOF {
        text.bufferFree(&b)
        return 0
    }
    nextChar(p)
    var l: usize = 0
    var c = currentChar(p, &l)
    while text.isChar(c) && (c != stop || p.*.input != input) && p.*.instate != STATE_EOF {
        copyBuf(&b, l, c)
        NEXTL(p, l)
        c = currentChar(p, &l)
        if c == 0 { c = currentChar(p, &l) }
        if b.length > maxText(p) {
            fatalErrMsg(p, ERR_ENTITY_NOT_FINISHED, "entity value too long\n")
            text.bufferFree(&b)
            return 0
        }
    }
    if p.*.instate == STATE_EOF {
        text.bufferFree(&b)
        return 0
    }
    if c != stop {
        fatalErr(p, ERR_ENTITY_NOT_FINISHED, 0)
        text.bufferFree(&b)
        return 0
    }
    nextChar(p)
    // The references in the value: names, and no parameter entity in
    // the internal subset's declarations.
    var cur = b.address
    while text.get8(cur) != 0 {
        if text.get8(cur) == 37 || (text.get8(cur) == 38 && text.get8(cur + 1) != 35) {
            const tmp = text.get8(cur)
            cur += 1
            const name = parseStringName(p, &cur)
            var nameOk = false
            if name != 0 {
                nameOk = true
                dealloc(p, name)
            }
            if !nameOk || text.get8(cur) != 59 {
                fatalErrMsgInt(p, ERR_ENTITY_CHAR_ERROR, "EntityValue: '%c' forbidden except for entities references\n", @intCast(i64, tmp))
                text.bufferFree(&b)
                return 0
            }
            if tmp == 37 && p.*.inSubset == 1 && p.*.inputNr == 1 {
                fatalErr(p, ERR_ENTITY_PE_INTERNAL, 0)
                text.bufferFree(&b)
                return 0
            }
            if text.get8(cur) == 0 { break }
        }
        cur += 1
    }
    p.*.depth += 1
    const ret = stringDecodeEntitiesInt(p, b.address, b.length, SUBSTITUTE_PEREF, true)
    p.*.depth -= 1
    orig.* = text.bufferTake(&b)
    text.bufferFree(&b)
    return ret
}

// xmlParseAttValueComplex: the value (a block of its own; LEN its
// length), 0 on an error.
fn parseAttValueComplex(p: *Parser, attlen: *i64, normalize: bool) -> usize {
    var limit: u64 = 0
    if NXT(p, 0) == 34 {
        p.*.instate = STATE_ATTRIBUTE_VALUE
        limit = 34
        nextChar(p)
    } else if NXT(p, 0) == 39 {
        limit = 39
        p.*.instate = STATE_ATTRIBUTE_VALUE
        nextChar(p)
    } else {
        fatalErr(p, ERR_ATTRIBUTE_NOT_STARTED, 0)
        return 0
    }
    var b: Buffer = undefined
    if !text.bufferInit(&b, p.*.allocator, 100) { return 0 }
    var inSpace = false
    var l: usize = 0
    var c = currentChar(p, &l)
    while NXT(p, 0) != limit && text.isChar(c) && c != 60 && p.*.instate != STATE_EOF {
        if c == 38 {
            inSpace = false
            if NXT(p, 1) == 35 {
                const val = parseCharRef(p)
                if val == 38 {
                    if p.*.replaceEntities {
                        text.bufferAddByte(&b, 38)
                    } else {
                        text.bufferAddText(&b, "&#38;")
                    }
                } else if val != 0 {
                    text.bufferAddChar(&b, val)
                }
            } else {
                var view: EntityView = undefined
                const found = parseEntityRef(p, &view)
                p.*.nbentities += 1
                if found && view.etype == INTERNAL_PREDEFINED_ENTITY {
                    if !p.*.replaceEntities && text.get8(view.content) == 38 {
                        text.bufferAddText(&b, "&#38;")
                    } else {
                        text.bufferAddByte(&b, text.get8(view.content))
                    }
                } else if found && p.*.replaceEntities {
                    if entityCheck(p, lengthOf(&view)) {
                        text.bufferFree(&b)
                        return 0
                    }
                    p.*.depth += 1
                    const rep = stringDecodeEntitiesInt(p, view.content, @intCast(usize, lengthOf(&view)), SUBSTITUTE_REF, true)
                    p.*.depth -= 1
                    if rep != 0 {
                        var at = rep
                        while text.get8(at) != 0 {
                            const d = text.get8(at)
                            if d == 0xD || d == 0xA || d == 0x9 {
                                text.bufferAddByte(&b, 0x20)
                            } else {
                                text.bufferAddByte(&b, d)
                            }
                            at += 1
                        }
                        dealloc(p, rep)
                    }
                } else if found {
                    // The entity checked once (its expansion counted
                    // against the amplification limit), kept as written.
                    if view.etype != INTERNAL_PREDEFINED_ENTITY && view.content != 0 {
                        if checkedOf(&view) == 0 {
                            const oldnbent = p.*.nbentities
                            const oldCopy = p.*.sizeentcopy
                            p.*.sizeentcopy = lengthOf(&view)
                            p.*.depth += 1
                            const rep = stringDecodeEntitiesInt(p, view.content, @intCast(usize, lengthOf(&view)), SUBSTITUTE_REF, true)
                            p.*.depth -= 1
                            setChecked(&view, @intCast(i64, (p.*.nbentities - oldnbent + 1) & 0x7fffffff))
                            setExpanded(&view, p.*.sizeentcopy)
                            if rep != 0 {
                                dealloc(p, rep)
                            } else {
                                text.put8(view.content, 0)
                            }
                            if entityCheck(p, oldCopy) {
                                text.bufferFree(&b)
                                return 0
                            }
                        } else {
                            if entityCheck(p, expandedOf(&view)) {
                                text.bufferFree(&b)
                                return 0
                            }
                        }
                    }
                    text.bufferAddByte(&b, 38)
                    text.bufferAddString(&b, view.name)
                    text.bufferAddByte(&b, 59)
                }
            }
        } else {
            if c == 0x20 || c == 0xD || c == 0xA || c == 0x9 {
                if b.length != 0 || !normalize {
                    if !normalize || !inSpace { copyBuf(&b, l, 0x20) }
                    inSpace = true
                }
            } else {
                inSpace = false
                copyBuf(&b, l, c)
            }
            NEXTL(p, l)
        }
        c = currentChar(p, &l)
        if b.length > maxText(p) {
            fatalErrMsg(p, ERR_ATTRIBUTE_NOT_FINISHED, "AttValue length too long\n")
            errMemory(p)
            text.bufferFree(&b)
            return 0
        }
    }
    if p.*.instate == STATE_EOF {
        text.bufferFree(&b)
        return 0
    }
    if inSpace && normalize {
        while b.length > 0 && text.get8(b.address + b.length - 1) == 0x20 { b.length -= 1 }
        text.put8(b.address + b.length, 0)
    }
    if RAW(p) == 60 {
        fatalErr(p, ERR_LT_IN_ATTRIBUTE, 0)
    } else if RAW(p) != limit {
        if c != 0 && !text.isChar(c) {
            fatalErrMsg(p, ERR_INVALID_CHAR, "invalid character in attribute value\n")
        } else {
            fatalErrMsg(p, ERR_ATTRIBUTE_NOT_FINISHED, "AttValue: ' expected\n")
        }
    } else {
        nextChar(p)
    }
    attlen.* = @intCast(i64, b.length)
    const result = text.bufferTake(&b)
    text.bufferFree(&b)
    return result
}

// xmlParseSystemLiteral.
fn parseSystemLiteral(p: *Parser) -> usize {
    var stop: u64 = 0
    const state = p.*.instate
    if RAW(p) == 34 {
        nextChar(p)
        stop = 34
    } else if RAW(p) == 39 {
        nextChar(p)
        stop = 39
    } else {
        fatalErr(p, ERR_LITERAL_NOT_STARTED, 0)
        return 0
    }
    var b: Buffer = undefined
    if !text.bufferInit(&b, p.*.allocator, 100) { return 0 }
    p.*.instate = STATE_SYSTEM_LITERAL
    var l: usize = 0
    var cur = currentChar(p, &l)
    while text.isChar(cur) && cur != stop {
        copyBuf(&b, l, cur)
        NEXTL(p, l)
        cur = currentChar(p, &l)
        if cur == 0 { cur = currentChar(p, &l) }
        if b.length > maxName(p) {
            fatalErrInfo(p, ERR_NAME_TOO_LONG, "SystemLiteral")
            text.bufferFree(&b)
            p.*.instate = state
            return 0
        }
    }
    p.*.instate = state
    if !text.isChar(cur) {
        fatalErr(p, ERR_LITERAL_NOT_FINISHED, 0)
    } else {
        nextChar(p)
    }
    const result = text.bufferTake(&b)
    text.bufferFree(&b)
    return result
}

// xmlParsePubidLiteral.
fn parsePubidLiteral(p: *Parser) -> usize {
    var stop: u64 = 0
    const oldstate = p.*.instate
    if RAW(p) == 34 {
        nextChar(p)
        stop = 34
    } else if RAW(p) == 39 {
        nextChar(p)
        stop = 39
    } else {
        fatalErr(p, ERR_LITERAL_NOT_STARTED, 0)
        return 0
    }
    var b: Buffer = undefined
    if !text.bufferInit(&b, p.*.allocator, 100) { return 0 }
    p.*.instate = STATE_PUBLIC_LITERAL
    var cur = RAW(p)
    while text.isPubidChar(cur) && cur != stop {
        text.bufferAddByte(&b, cur)
        nextChar(p)
        cur = RAW(p)
        if b.length > maxName(p) {
            fatalErrInfo(p, ERR_NAME_TOO_LONG, "Public ID")
            text.bufferFree(&b)
            return 0
        }
    }
    if cur != stop {
        fatalErr(p, ERR_LITERAL_NOT_FINISHED, 0)
    } else {
        nextChar(p)
    }
    p.*.instate = oldstate
    const result = text.bufferTake(&b)
    text.bufferFree(&b)
    return result
}

// ---------------------------------------------------------------------------
// Character data (xmlParseCharData, xmlParseCharDataComplex)

// test_char_data: the bytes the fast path copies as they are.
fn plainCharData(c: u64) -> bool {
    if c == 0x9 { return true }
    if c < 0x20 || c > 0x7F { return false }
    return c != 38 && c != 60 && c != 93
}

fn parseCharData(p: *Parser, cdata: bool) -> void {
    var line = inp(p).*.line
    var col = inp(p).*.col
    if !cdata {
        var at = inp(p).*.cur
        var first = true
        while first || (text.get8(at) >= 0x20 && text.get8(at) <= 0x7F) || text.get8(at) == 0x09 || text.get8(at) == 0x0A {
            first = false
            const i = inp(p)
            // get_more_space
            var moreSpace = true
            while moreSpace {
                moreSpace = false
                while text.get8(at) == 0x20 {
                    at += 1
                    i.*.col += 1
                }
                if text.get8(at) == 0xA {
                    while text.get8(at) == 0xA {
                        i.*.line += 1
                        i.*.col = 1
                        at += 1
                    }
                    moreSpace = true
                }
            }
            if text.get8(at) == 60 {
                const nbchar = at - i.*.cur
                if nbchar > 0 {
                    const tmp = i.*.cur
                    i.*.cur = at
                    if whitespaceDiffers(p) {
                        textCallback(p, tmp, nbchar, true)
                    } else {
                        characters(p, tmp, nbchar)
                    }
                }
                return
            }
            // get_more
            var more = true
            while more {
                more = false
                var ccol = i.*.col
                while plainCharData(text.get8(at)) {
                    at += 1
                    ccol += 1
                }
                i.*.col = ccol
                if text.get8(at) == 0xA {
                    while text.get8(at) == 0xA {
                        i.*.line += 1
                        i.*.col = 1
                        at += 1
                    }
                    more = true
                } else if text.get8(at) == 93 {
                    if text.get8(at + 1) == 93 && text.get8(at + 2) == 62 {
                        fatalErr(p, ERR_MISPLACED_CDATA_END, 0)
                        inp(p).*.cur = at + 1
                        return
                    }
                    at += 1
                    i.*.col += 1
                    more = true
                }
            }
            const nbchar = at - i.*.cur
            if nbchar > 0 {
                if whitespaceDiffers(p) && text.isBlank(text.get8(i.*.cur)) {
                    const tmp = i.*.cur
                    i.*.cur = at
                    textCallback(p, tmp, nbchar, false)
                    line = inp(p).*.line
                    col = inp(p).*.col
                } else {
                    characters(p, i.*.cur, nbchar)
                    line = inp(p).*.line
                    col = inp(p).*.col
                }
                if p.*.instate != STATE_CONTENT { return }
            }
            inp(p).*.cur = at
            if text.get8(at) == 0xD {
                at += 1
                if text.get8(at) == 0xA {
                    inp(p).*.cur = at
                    at += 1
                    inp(p).*.line += 1
                    inp(p).*.col = 1
                    // continue: the loop's test with the byte after.
                    continue
                }
                at -= 1
            }
            if text.get8(at) == 60 { return }
            if text.get8(at) == 38 { return }
            if p.*.instate == STATE_EOF { return }
            at = inp(p).*.cur
        }
    }
    inp(p).*.line = line
    inp(p).*.col = col
    parseCharDataComplex(p, cdata)
}

fn parseCharDataComplex(p: *Parser, cdata: bool) -> void {
    var b: Buffer = undefined
    if !text.bufferInit(&b, p.*.allocator, BIG_BUFFER_SIZE + 8) { return }
    var l: usize = 0
    var cur = currentChar(p, &l)
    while cur != 60 && cur != 38 && text.isChar(cur) {
        if cur == 93 && NXT(p, 1) == 93 && NXT(p, 2) == 62 {
            if cdata { break }
            fatalErr(p, ERR_MISPLACED_CDATA_END, 0)
        }
        copyBuf(&b, l, cur)
        NEXTL(p, l)
        cur = currentChar(p, &l)
        if b.length >= BIG_BUFFER_SIZE {
            if p.*.disableSAX == 0 { textCallback(p, b.address, b.length, false) }
            b.length = 0
            text.put8(b.address, 0)
            if p.*.instate != STATE_CONTENT {
                text.bufferFree(&b)
                return
            }
        }
    }
    if b.length != 0 {
        if p.*.disableSAX == 0 { textCallback(p, b.address, b.length, false) }
    }
    text.bufferFree(&b)
    if cur != 0 && !text.isChar(cur) {
        fatalErrMsgInt(p, ERR_INVALID_CHAR, "PCDATA invalid Char value %d\n", @intCast(i64, cur))
        NEXTL(p, l)
    }
}

// xmlParseExternalID: the system literal (a block, or 0); PUBLICID the
// public one.
fn parseExternalID(p: *Parser, publicID: *usize, strict: bool) -> usize {
    var uriValue: usize = 0
    publicID.* = 0
    if CMP(p, "SYSTEM") {
        SKIP(p, 6)
        if skipBlanks(p) == 0 { fatalErrMsg(p, ERR_SPACE_REQUIRED, "Space required after 'SYSTEM'\n") }
        uriValue = parseSystemLiteral(p)
        if uriValue == 0 { fatalErr(p, ERR_URI_REQUIRED, 0) }
    } else if CMP(p, "PUBLIC") {
        SKIP(p, 6)
        if skipBlanks(p) == 0 { fatalErrMsg(p, ERR_SPACE_REQUIRED, "Space required after 'PUBLIC'\n") }
        publicID.* = parsePubidLiteral(p)
        if publicID.* == 0 { fatalErr(p, ERR_PUBID_REQUIRED, 0) }
        if strict {
            if skipBlanks(p) == 0 { fatalErrMsg(p, ERR_SPACE_REQUIRED, "Space required after the Public Identifier\n") }
        } else {
            if skipBlanks(p) == 0 { return 0 }
            if RAW(p) != 39 && RAW(p) != 34 { return 0 }
        }
        uriValue = parseSystemLiteral(p)
        if uriValue == 0 { fatalErr(p, ERR_URI_REQUIRED, 0) }
    }
    return uriValue
}

// ---------------------------------------------------------------------------
// Comments

fn comment(p: *Parser, value: usize) -> void {
    if p.*.handler.comment != 0 && p.*.disableSAX == 0 { call1(p.*.handler.comment, user(p), value) }
}

// xmlParseCommentComplex: BUF (a buffer begun by the fast path, or
// empty) continued.
fn parseCommentComplex(p: *Parser, b: *Buffer) -> void {
    const inputid = inp(p).*.id
    var ql: usize = 0
    var rl: usize = 0
    var l: usize = 0
    var q = currentChar(p, &ql)
    if q == 0 {
        fatalErrMsgStr(p, ERR_COMMENT_NOT_FINISHED, "Comment not terminated\n", 0)
        return
    }
    if !text.isChar(q) {
        fatalErrMsgInt(p, ERR_INVALID_CHAR, "xmlParseComment: invalid xmlChar value %d\n", @intCast(i64, q))
        return
    }
    NEXTL(p, ql)
    var r = currentChar(p, &rl)
    if r == 0 {
        fatalErrMsgStr(p, ERR_COMMENT_NOT_FINISHED, "Comment not terminated\n", 0)
        return
    }
    if !text.isChar(r) {
        fatalErrMsgInt(p, ERR_INVALID_CHAR, "xmlParseComment: invalid xmlChar value %d\n", @intCast(i64, q))
        return
    }
    NEXTL(p, rl)
    var cur = currentChar(p, &l)
    if cur == 0 {
        fatalErrMsgStr(p, ERR_COMMENT_NOT_FINISHED, "Comment not terminated\n", 0)
        return
    }
    while text.isChar(cur) && (cur != 62 || r != 45 || q != 45) {
        if r == 45 && q == 45 { fatalErr(p, ERR_HYPHEN_IN_COMMENT, 0) }
        copyBuf(b, ql, q)
        q = r
        ql = rl
        r = cur
        rl = l
        NEXTL(p, l)
        cur = currentChar(p, &l)
        if b.*.length > maxText(p) {
            fatalErrMsgStr(p, ERR_COMMENT_NOT_FINISHED, "Comment too big found", 0)
            return
        }
    }
    if cur == 0 {
        fatalErrMsgStr(p, ERR_COMMENT_NOT_FINISHED, "Comment not terminated \n<!--%.50s\n", b.*.address)
    } else if !text.isChar(cur) {
        fatalErrMsgInt(p, ERR_INVALID_CHAR, "xmlParseComment: invalid xmlChar value %d\n", @intCast(i64, cur))
    } else {
        if inputid != inp(p).*.id {
            fatalErrMsg(p, ERR_ENTITY_BOUNDARY, "Comment doesn't start and stop in the same entity\n")
        }
        nextChar(p)
        comment(p, b.*.address)
    }
}

// xmlParseComment.
fn parseComment(p: *Parser) -> void {
    if RAW(p) != 60 || NXT(p, 1) != 33 || NXT(p, 2) != 45 || NXT(p, 3) != 45 { return }
    const state = p.*.instate
    p.*.instate = STATE_COMMENT
    const inputid = inp(p).*.id
    SKIP(p, 4)
    var b: Buffer = undefined
    if !text.bufferInit(&b, p.*.allocator, 100) { return }
    // Whether the fast path has a buffer yet (libxml2 gives the comment
    // callback "" for an empty comment either way).
    var at = inp(p).*.cur
    var first = true
    while first || (text.get8(at) >= 0x20 && text.get8(at) <= 0x7F) || text.get8(at) == 0x09 || text.get8(at) == 0x0A {
        first = false
        const i = inp(p)
        if text.get8(at) == 0xA {
            while text.get8(at) == 0xA {
                i.*.line += 1
                i.*.col = 1
                at += 1
            }
        }
        var more = true
        var again = false
        while more {
            more = false
            var ccol = inp(p).*.col
            var c = text.get8(at)
            while (c > 45 && c <= 0x7F) || (c >= 0x20 && c < 45) || c == 0x09 {
                at += 1
                ccol += 1
                c = text.get8(at)
            }
            inp(p).*.col = ccol
            if c == 0xA {
                while text.get8(at) == 0xA {
                    inp(p).*.line += 1
                    inp(p).*.col = 1
                    at += 1
                }
                more = true
                continue
            }
            const nbchar = at - inp(p).*.cur
            if nbchar > 0 && p.*.handler.comment != 0 {
                text.bufferAdd(&b, inp(p).*.cur, nbchar)
            }
            if b.length > maxText(p) {
                fatalErrMsgStr(p, ERR_COMMENT_NOT_FINISHED, "Comment too big found", 0)
                text.bufferFree(&b)
                return
            }
            inp(p).*.cur = at
            if text.get8(at) == 0xA {
                at += 1
                inp(p).*.line += 1
                inp(p).*.col = 1
            }
            if text.get8(at) == 0xD {
                at += 1
                if text.get8(at) == 0xA {
                    inp(p).*.cur = at
                    at += 1
                    inp(p).*.line += 1
                    inp(p).*.col = 1
                    more = true
                    continue
                }
                at -= 1
            }
            if p.*.instate == STATE_EOF {
                text.bufferFree(&b)
                return
            }
            at = inp(p).*.cur
            if text.get8(at) == 45 {
                if text.get8(at + 1) == 45 {
                    if text.get8(at + 2) == 62 {
                        if inp(p).*.id != inputid {
                            fatalErrMsg(p, ERR_ENTITY_BOUNDARY, "comment doesn't start and stop in the same entity\n")
                        }
                        SKIP(p, 3)
                        comment(p, b.address)
                        text.bufferFree(&b)
                        if p.*.instate != STATE_EOF { p.*.instate = state }
                        return
                    }
                    if b.length > 0 {
                        fatalErrMsgStr(p, ERR_HYPHEN_IN_COMMENT, "Double hyphen within comment: <!--%.50s\n", b.address)
                    } else {
                        fatalErrMsgStr(p, ERR_HYPHEN_IN_COMMENT, "Double hyphen within comment\n", 0)
                    }
                    if p.*.instate == STATE_EOF {
                        text.bufferFree(&b)
                        return
                    }
                    at += 1
                    inp(p).*.col += 1
                }
                at += 1
                inp(p).*.col += 1
                more = true
                continue
            }
            again = true
        }
        if !again { break }
    }
    parseCommentComplex(p, &b)
    text.bufferFree(&b)
    p.*.instate = state
}

// ---------------------------------------------------------------------------
// Processing instructions

// xmlParsePITarget.
fn parsePITarget(p: *Parser) -> usize {
    const name = parseName(p)
    if name != 0 && (text.get8(name) == 120 || text.get8(name) == 88) && (text.get8(name + 1) == 109 || text.get8(name + 1) == 77) && (text.get8(name + 2) == 108 || text.get8(name + 2) == 76) {
        if text.get8(name) == 120 && text.get8(name + 1) == 109 && text.get8(name + 2) == 108 && text.get8(name + 3) == 0 {
            fatalErrMsg(p, ERR_RESERVED_XML_NAME, "XML declaration allowed only at the start of the document\n")
            return name
        } else if text.get8(name + 3) == 0 {
            fatalErr(p, ERR_RESERVED_XML_NAME, 0)
            return name
        }
        if text.equalText(name, "xml-stylesheet") || text.equalText(name, "xml-model") { return name }
        warningMsg(p, ERR_RESERVED_XML_NAME, "xmlParsePITarget: invalid name prefix 'xml'\n", 0, 0)
    }
    if name != 0 && text.contains(name, 58) {
        nsErr(p, NS_ERR_COLON, "colons are forbidden from PI names '%s'\n", name, 0, 0)
    }
    return name
}

fn processingInstruction(p: *Parser, target: usize, data: usize) -> void {
    if p.*.disableSAX == 0 && p.*.handler.processingInstruction != 0 { call2(p.*.handler.processingInstruction, user(p), target, data) }
}

// xmlParsePI.
fn parsePI(p: *Parser) -> void {
    if RAW(p) != 60 || NXT(p, 1) != 63 { return }
    const inputid = inp(p).*.id
    const state = p.*.instate
    p.*.instate = STATE_PI
    SKIP(p, 2)
    const target = parsePITarget(p)
    if target != 0 {
        if RAW(p) == 63 && NXT(p, 1) == 62 {
            if inputid != inp(p).*.id {
                fatalErrMsg(p, ERR_ENTITY_BOUNDARY, "PI declaration doesn't start and stop in the same entity\n")
            }
            SKIP(p, 2)
            processingInstruction(p, target, 0)
            if p.*.instate != STATE_EOF { p.*.instate = state }
            return
        }
        var b: Buffer = undefined
        if !text.bufferInit(&b, p.*.allocator, 100) {
            p.*.instate = state
            return
        }
        if skipBlanks(p) == 0 {
            fatalErrMsgStr(p, ERR_SPACE_REQUIRED, "ParsePI: PI %s space expected\n", target)
        }
        var l: usize = 0
        var cur = currentChar(p, &l)
        var count: i64 = 0
        while text.isChar(cur) && (cur != 63 || NXT(p, 1) != 62) {
            count += 1
            if count > 50 {
                if p.*.instate == STATE_EOF {
                    text.bufferFree(&b)
                    return
                }
                count = 0
            }
            copyBuf(&b, l, cur)
            NEXTL(p, l)
            cur = currentChar(p, &l)
            if cur == 0 { cur = currentChar(p, &l) }
            if b.length > maxText(p) {
                fatalErrMsgStr(p, ERR_PI_NOT_FINISHED, "PI %s too big found", target)
                text.bufferFree(&b)
                p.*.instate = state
                return
            }
        }
        if cur != 63 {
            fatalErrMsgStr(p, ERR_PI_NOT_FINISHED, "ParsePI: PI %s never end ...\n", target)
        } else {
            if inputid != inp(p).*.id {
                fatalErrMsg(p, ERR_ENTITY_BOUNDARY, "PI declaration doesn't start and stop in the same entity\n")
            }
            SKIP(p, 2)
            processingInstruction(p, target, b.address)
        }
        text.bufferFree(&b)
    } else {
        fatalErr(p, ERR_PI_NOT_STARTED, 0)
    }
    if p.*.instate != STATE_EOF { p.*.instate = state }
}

// ---------------------------------------------------------------------------
// The DTD's declarations

// xmlParseNotationDecl.
fn parseNotationDecl(p: *Parser) -> void {
    if !CMP(p, "<!NOTATION") { return }
    const inputid = inp(p).*.id
    SKIP(p, 10)
    if skipBlanks(p) == 0 {
        fatalErrMsg(p, ERR_SPACE_REQUIRED, "Space required after '<!NOTATION'\n")
        return
    }
    const name = parseName(p)
    if name == 0 {
        fatalErr(p, ERR_NOTATION_NOT_STARTED, 0)
        return
    }
    if text.contains(name, 58) {
        nsErr(p, NS_ERR_COLON, "colons are forbidden from notation names '%s'\n", name, 0, 0)
    }
    if skipBlanks(p) == 0 {
        fatalErrMsg(p, ERR_SPACE_REQUIRED, "Space required after the NOTATION name'\n")
        return
    }
    var pubid: usize = 0
    const systemid = parseExternalID(p, &pubid, false)
    const ignored = skipBlanks(p)
    if RAW(p) == 62 {
        if inputid != inp(p).*.id {
            fatalErrMsg(p, ERR_ENTITY_BOUNDARY, "Notation declaration doesn't start and stop in the same entity\n")
        }
        nextChar(p)
        if p.*.disableSAX == 0 && p.*.handler.notationDecl != 0 { call3(p.*.handler.notationDecl, user(p), name, pubid, systemid) }
    } else {
        fatalErr(p, ERR_NOTATION_NOT_FINISHED, 0)
    }
    dealloc(p, systemid)
    dealloc(p, pubid)
}

fn entityDecl(p: *Parser, name: usize, etype: i64, publicId: usize, systemId: usize, content: usize) -> void {
    if p.*.disableSAX == 0 {
        if p.*.handler.entityDecl != 0 {
            const call: EntityDeclFn = unsafe { @ptrFromInt(EntityDeclFn, p.*.handler.entityDecl) }
            call(user(p), name, etype, publicId, systemId, content)
        }
        addOwn(p, name, etype, publicId, systemId, content)
    }
}

// What libxml2 does after a general entity's declaration for SAX
// handlers that keep no document ("for expat compatibility in SAX
// mode": the declaration recorded in a document of its own), the
// handler's entityDeclared callback.
fn entityDeclared(p: *Parser, name: usize, etype: i64, publicId: usize, systemId: usize, content: usize) -> void {
    if p.*.handler.entityDeclared != 0 {
        const call: EntityDeclFn = unsafe { @ptrFromInt(EntityDeclFn, p.*.handler.entityDeclared) }
        call(user(p), name, etype, publicId, systemId, content)
    }
}

// xmlParseEntityDecl.
fn parseEntityDecl(p: *Parser) -> void {
    if !CMP(p, "<!ENTITY") { return }
    const inputid = inp(p).*.id
    SKIP(p, 8)
    if skipBlanks(p) == 0 { fatalErrMsg(p, ERR_SPACE_REQUIRED, "Space required after '<!ENTITY'\n") }
    var isParameter = false
    if RAW(p) == 37 {
        nextChar(p)
        if skipBlanks(p) == 0 { fatalErrMsg(p, ERR_SPACE_REQUIRED, "Space required after '%%'\n") }
        isParameter = true
    }
    const name = parseName(p)
    if name == 0 {
        fatalErrMsg(p, ERR_NAME_REQUIRED, "xmlParseEntityDecl: no name\n")
        return
    }
    if text.contains(name, 58) {
        nsErr(p, NS_ERR_COLON, "colons are forbidden from entities names '%s'\n", name, 0, 0)
    }
    if skipBlanks(p) == 0 { fatalErrMsg(p, ERR_SPACE_REQUIRED, "Space required after the entity name\n") }
    p.*.instate = STATE_ENTITY_DECL
    var value: usize = 0
    var uriValue: usize = 0
    var literal: usize = 0
    var orig: usize = 0
    if isParameter {
        if RAW(p) == 34 || RAW(p) == 39 {
            value = parseEntityValue(p, &orig)
            if value != 0 { entityDecl(p, name, INTERNAL_PARAMETER_ENTITY, 0, 0, value) }
        } else {
            uriValue = parseExternalID(p, &literal, true)
            if uriValue == 0 && literal == 0 { fatalErr(p, ERR_VALUE_REQUIRED, 0) }
            if uriValue != 0 {
                const parsed = uri.parse(uriValue)
                if !parsed.valid {
                    errMsgStr(p, ERR_INVALID_URI, "Invalid URI: %s\n", uriValue)
                } else if parsed.hasFragment {
                    fatalErr(p, ERR_URI_FRAGMENT, 0)
                } else {
                    entityDecl(p, name, EXTERNAL_PARAMETER_ENTITY, literal, uriValue, 0)
                }
            }
        }
    } else {
        if RAW(p) == 34 || RAW(p) == 39 {
            value = parseEntityValue(p, &orig)
            entityDecl(p, name, INTERNAL_GENERAL_ENTITY, 0, 0, value)
            entityDeclared(p, name, INTERNAL_GENERAL_ENTITY, 0, 0, value)
        } else {
            uriValue = parseExternalID(p, &literal, true)
            if uriValue == 0 && literal == 0 { fatalErr(p, ERR_VALUE_REQUIRED, 0) }
            if uriValue != 0 {
                const parsed = uri.parse(uriValue)
                if !parsed.valid {
                    errMsgStr(p, ERR_INVALID_URI, "Invalid URI: %s\n", uriValue)
                } else if parsed.hasFragment {
                    fatalErr(p, ERR_URI_FRAGMENT, 0)
                }
            }
            if RAW(p) != 62 && skipBlanks(p) == 0 {
                fatalErrMsg(p, ERR_SPACE_REQUIRED, "Space required before 'NDATA'\n")
            }
            if CMP(p, "NDATA") {
                SKIP(p, 5)
                if skipBlanks(p) == 0 { fatalErrMsg(p, ERR_SPACE_REQUIRED, "Space required after 'NDATA'\n") }
                const ndata = parseName(p)
                if p.*.disableSAX == 0 && p.*.handler.unparsedEntityDecl != 0 {
                    call4(p.*.handler.unparsedEntityDecl, user(p), name, literal, uriValue, ndata)
                }
                if p.*.disableSAX == 0 { addOwn(p, name, EXTERNAL_GENERAL_UNPARSED_ENTITY, literal, uriValue, 0) }
            } else {
                entityDecl(p, name, EXTERNAL_GENERAL_PARSED_ENTITY, literal, uriValue, 0)
                if p.*.replaceEntities { entityDeclared(p, name, EXTERNAL_GENERAL_PARSED_ENTITY, literal, uriValue, 0) }
            }
        }
    }
    if p.*.instate != STATE_EOF {
        const ignored = skipBlanks(p)
        if RAW(p) != 62 {
            fatalErrMsgStr(p, ERR_ENTITY_NOT_FINISHED, "xmlParseEntityDecl: entity %s not terminated\n", name)
            halt(p)
        } else {
            if inputid != inp(p).*.id {
                fatalErrMsg(p, ERR_ENTITY_BOUNDARY, "Entity declaration doesn't start and stop in the same entity\n")
            }
            nextChar(p)
        }
        if orig != 0 {
            // The value as written, kept with the entity (ent->orig).
            var view: EntityView = undefined
            var found = false
            if isParameter {
                if p.*.handler.getParameterEntity != 0 { found = getParameterEntity(p, name, &view) }
            } else {
                found = getEntityFor(p, name, &view, 1)
            }
            if found && view.orig != 0 && text.getWord(view.orig) == 0 {
                if p.*.handler.keepString != 0 {
                    call2(p.*.handler.keepString, user(p), view.orig, orig)
                } else {
                    text.putWord(view.orig, orig)
                    orig = 0
                }
            }
        }
    }
    dealloc(p, value)
    dealloc(p, uriValue)
    dealloc(p, literal)
    dealloc(p, orig)
}

// xmlParseDefaultDecl: the default's kind; VALUE its value.
fn parseDefaultDecl(p: *Parser, value: *usize) -> i64 {
    value.* = 0
    if CMP(p, "#REQUIRED") {
        SKIP(p, 9)
        return ATTRIBUTE_REQUIRED
    }
    if CMP(p, "#IMPLIED") {
        SKIP(p, 8)
        return ATTRIBUTE_IMPLIED
    }
    var val = ATTRIBUTE_NONE
    if CMP(p, "#FIXED") {
        SKIP(p, 6)
        val = ATTRIBUTE_FIXED
        if skipBlanks(p) == 0 { fatalErrMsg(p, ERR_SPACE_REQUIRED, "Space required after '#FIXED'\n") }
    }
    var len: i64 = 0
    var allocated = true
    const ret = parseAttValueInternal(p, &len, &allocated, false, true)
    p.*.instate = STATE_DTD
    if ret == 0 {
        fatalErrMsg(p, p.*.errNo, "Attribute default value declaration error\n")
    } else {
        value.* = ret
    }
    return val
}

// xmlParseNotationType: whether there is one (the names are not kept).
fn parseNotationType(p: *Parser) -> bool {
    if RAW(p) != 40 {
        fatalErr(p, ERR_NOTATION_NOT_STARTED, 0)
        return false
    }
    var names: Buffer = undefined
    if !text.bufferInit(&names, p.*.allocator, 64) { return false }
    var first = true
    while first || RAW(p) == 124 {
        first = false
        nextChar(p)
        const ignored = skipBlanks(p)
        const name = parseName(p)
        if name == 0 {
            fatalErrMsg(p, ERR_NAME_REQUIRED, "Name expected in NOTATION declaration\n")
            text.bufferFree(&names)
            return false
        }
        if seenName(&names, name) {
            validityError(p, DTD_DUP_TOKEN, "standalone: attribute notation value token %s duplicated\n", name, 0)
        } else {
            addName(&names, name)
        }
        const ignored2 = skipBlanks(p)
    }
    if RAW(p) != 41 {
        fatalErr(p, ERR_NOTATION_NOT_FINISHED, 0)
        text.bufferFree(&names)
        return false
    }
    nextChar(p)
    text.bufferFree(&names)
    return true
}

// A list of names: their addresses (copies the list owns, or the
// dictionary's).
fn seenName(names: *Buffer, name: usize) -> bool {
    var at: usize = 0
    while at < names.*.length {
        if text.equal(text.getWord(names.*.address + at), name) { return true }
        at += 8
    }
    return false
}

fn addName(names: *Buffer, name: usize) -> void {
    if !text.bufferReserve(names, 8) { return }
    text.putWord(names.*.address + names.*.length, name)
    names.*.length += 8
}

// xmlParseEnumerationType: whether there is one.
fn parseEnumerationType(p: *Parser) -> bool {
    if RAW(p) != 40 {
        fatalErr(p, ERR_ATTLIST_NOT_STARTED, 0)
        return false
    }
    var names: Buffer = undefined
    if !text.bufferInit(&names, p.*.allocator, 64) { return false }
    var any = false
    var first = true
    while first || RAW(p) == 124 {
        first = false
        nextChar(p)
        const ignored = skipBlanks(p)
        const name = parseNmtoken(p)
        if name == 0 {
            fatalErr(p, ERR_NMTOKEN_REQUIRED, 0)
            freeNames(p, &names)
            return any
        }
        if seenName(&names, name) {
            validityError(p, DTD_DUP_TOKEN, "standalone: attribute enumeration value token %s duplicated\n", name, 0)
            dealloc(p, name)
        } else {
            addName(&names, name)
            any = true
        }
        const ignored2 = skipBlanks(p)
    }
    if RAW(p) != 41 {
        fatalErr(p, ERR_ATTLIST_NOT_FINISHED, 0)
        freeNames(p, &names)
        return any
    }
    nextChar(p)
    freeNames(p, &names)
    return any
}

fn freeNames(p: *Parser, names: *Buffer) -> void {
    var at: usize = 0
    while at < names.*.length {
        dealloc(p, text.getWord(names.*.address + at))
        at += 8
    }
    text.bufferFree(names)
}

// xmlParseEnumeratedType.
fn parseEnumeratedType(p: *Parser) -> i64 {
    if CMP(p, "NOTATION") {
        SKIP(p, 8)
        if skipBlanks(p) == 0 {
            fatalErrMsg(p, ERR_SPACE_REQUIRED, "Space required after 'NOTATION'\n")
            return 0
        }
        if !parseNotationType(p) { return 0 }
        return ATTRIBUTE_NOTATION
    }
    if !parseEnumerationType(p) { return 0 }
    return ATTRIBUTE_ENUMERATION
}

// xmlParseAttributeType.
fn parseAttributeType(p: *Parser) -> i64 {
    if CMP(p, "CDATA") {
        SKIP(p, 5)
        return ATTRIBUTE_CDATA
    } else if CMP(p, "IDREFS") {
        SKIP(p, 6)
        return ATTRIBUTE_IDREFS
    } else if CMP(p, "IDREF") {
        SKIP(p, 5)
        return ATTRIBUTE_IDREF
    } else if RAW(p) == 73 && NXT(p, 1) == 68 {
        SKIP(p, 2)
        return ATTRIBUTE_ID
    } else if CMP(p, "ENTITY") {
        SKIP(p, 6)
        return ATTRIBUTE_ENTITY
    } else if CMP(p, "ENTITIES") {
        SKIP(p, 8)
        return ATTRIBUTE_ENTITIES
    } else if CMP(p, "NMTOKENS") {
        SKIP(p, 8)
        return ATTRIBUTE_NMTOKENS
    } else if CMP(p, "NMTOKEN") {
        SKIP(p, 7)
        return ATTRIBUTE_NMTOKEN
    }
    return parseEnumeratedType(p)
}

// xmlAttrNormalizeSpace in place: blanks at the ends dropped, runs of
// them made one.
fn normalizeSpaceInPlace(s: usize) -> void {
    var src = s
    var dst = s
    while text.get8(src) == 0x20 { src += 1 }
    while text.get8(src) != 0 {
        if text.get8(src) == 0x20 {
            while text.get8(src) == 0x20 { src += 1 }
            if text.get8(src) != 0 {
                text.put8(dst, 0x20)
                dst += 1
            }
        } else {
            text.put8(dst, text.get8(src))
            dst += 1
            src += 1
        }
    }
    text.put8(dst, 0)
}

// The attribute tables of the DTD: the non-CDATA attributes (whose
// values are normalized) and the defaults, as lists of records.
const SpecialAttr = struct {
    next: usize
    fullname: usize
    fullattr: usize
    atype: i64
}

const DefaultAttrs = struct {
    next: usize
    name: usize
    prefix: usize
    values: Buffer
}

inline fn specialAt(address: usize) -> *SpecialAttr { return unsafe { @ptrFromInt(*SpecialAttr, address) } }
inline fn defaultsAt(address: usize) -> *DefaultAttrs { return unsafe { @ptrFromInt(*DefaultAttrs, address) } }

fn findSpecial(p: *Parser, fullname: usize, fullattr: usize) -> usize {
    var at = p.*.attsSpecial
    while at != 0 {
        if text.equal(specialAt(at).*.fullname, fullname) && text.equal(specialAt(at).*.fullattr, fullattr) { return at }
        at = specialAt(at).*.next
    }
    return 0
}

// xmlStrQEqual: whether S is PREFIX:NAME (NAME without a prefix).
fn qnameEqual(prefix: usize, name: usize, s: usize) -> bool {
    if prefix == 0 { return text.equal(name, s) }
    var at = s
    var q = prefix
    while text.get8(q) != 0 {
        if text.get8(at) != text.get8(q) { return false }
        at += 1
        q += 1
    }
    if text.get8(at) != 58 { return false }
    return text.equal(name, at + 1)
}

// xmlHashQLookup2 on the special attributes: the type, 0 for none.
fn specialType(p: *Parser, prefix: usize, elem: usize, aprefix: usize, aname: usize) -> i64 {
    var at = p.*.attsSpecial
    while at != 0 {
        const s = specialAt(at)
        if qnameEqual(prefix, elem, s.*.fullname) && qnameEqual(aprefix, aname, s.*.fullattr) { return s.*.atype }
        at = s.*.next
    }
    return 0
}

// xmlAddSpecialAttr.
fn addSpecialAttr(p: *Parser, fullname: usize, fullattr: usize, atype: i64) -> void {
    if findSpecial(p, fullname, fullattr) != 0 { return }
    const address = alloc(p, @sizeOf(SpecialAttr))
    if address == 0 { return }
    const s = specialAt(address)
    s.*.fullname = fullname
    s.*.fullattr = fullattr
    s.*.atype = atype
    // (Appended: the table's order is not observable.)
    s.*.next = p.*.attsSpecial
    p.*.attsSpecial = address
}

// xmlCleanSpecialAttr: the CDATA ones dropped.
fn cleanSpecialAttr(p: *Parser) -> void {
    var at = p.*.attsSpecial
    var kept: usize = 0
    while at != 0 {
        const next = specialAt(at).*.next
        if specialAt(at).*.atype == ATTRIBUTE_CDATA {
            dealloc(p, at)
        } else {
            specialAt(at).*.next = kept
            kept = at
        }
        at = next
    }
    p.*.attsSpecial = kept
}

// xmlSplitQName3: the local part of a prefixed name (LEN the prefix's
// length), 0 for a name without a prefix.
fn splitQName3(name: usize, len: *usize) -> usize {
    if name == 0 || text.get8(name) == 58 { return 0 }
    var l: usize = 0
    while text.get8(name + l) != 0 && text.get8(name + l) != 58 { l += 1 }
    if text.get8(name + l) == 0 { return 0 }
    len.* = l
    return name + l + 1
}

fn findDefaults(p: *Parser, name: usize, prefix: usize) -> usize {
    var at = p.*.attsDefault
    while at != 0 {
        if defaultsAt(at).*.name == name && defaultsAt(at).*.prefix == prefix { return at }
        at = defaultsAt(at).*.next
    }
    return 0
}

// xmlAddDefAttrs: the default of FULLATTR on FULLNAME (unless declared
// before), as (name, prefix, value, value end, external) of the
// dictionary.
fn addDefAttrs(p: *Parser, fullname: usize, fullattr: usize, value: usize) -> void {
    if findSpecial(p, fullname, fullattr) != 0 { return }
    var len: usize = 0
    var name = splitQName3(fullname, &len)
    var prefix: usize = 0
    if name == 0 {
        name = text.dictLookupString(p.*.dict, fullname)
    } else {
        name = text.dictLookupString(p.*.dict, name)
        prefix = lookup(p, fullname, len)
    }
    var defaults = findDefaults(p, name, prefix)
    if defaults == 0 {
        defaults = alloc(p, @sizeOf(DefaultAttrs))
        if defaults == 0 { return }
        defaultsAt(defaults).*.name = name
        defaultsAt(defaults).*.prefix = prefix
        if !text.bufferInit(&defaultsAt(defaults).*.values, p.*.allocator, 5 * 8 * 4) { return }
        defaultsAt(defaults).*.next = p.*.attsDefault
        p.*.attsDefault = defaults
    }
    var aname = splitQName3(fullattr, &len)
    var aprefix: usize = 0
    if aname == 0 {
        aname = text.dictLookupString(p.*.dict, fullattr)
    } else {
        aname = text.dictLookupString(p.*.dict, aname)
        aprefix = lookup(p, fullattr, len)
    }
    const vlen = text.length(value)
    const v = lookup(p, value, vlen)
    const values = &defaultsAt(defaults).*.values
    addName(values, aname)
    addName(values, aprefix)
    addName(values, v)
    addName(values, v + vlen)
    addName(values, 0)
}

fn freeAttributeTables(p: *Parser) -> void {
    var at = p.*.attsSpecial
    while at != 0 {
        const next = specialAt(at).*.next
        dealloc(p, at)
        at = next
    }
    p.*.attsSpecial = 0
    at = p.*.attsDefault
    while at != 0 {
        const next = defaultsAt(at).*.next
        text.bufferFree(&defaultsAt(at).*.values)
        dealloc(p, at)
        at = next
    }
    p.*.attsDefault = 0
}

// xmlParseAttributeListDecl.
fn parseAttributeListDecl(p: *Parser) -> void {
    if !CMP(p, "<!ATTLIST") { return }
    const inputid = inp(p).*.id
    SKIP(p, 9)
    if skipBlanks(p) == 0 { fatalErrMsg(p, ERR_SPACE_REQUIRED, "Space required after '<!ATTLIST'\n") }
    const elemName = parseName(p)
    if elemName == 0 {
        fatalErrMsg(p, ERR_NAME_REQUIRED, "ATTLIST: no name for Element\n")
        return
    }
    const ignored = skipBlanks(p)
    while RAW(p) != 62 && p.*.instate != STATE_EOF {
        const attrName = parseName(p)
        if attrName == 0 {
            fatalErrMsg(p, ERR_NAME_REQUIRED, "ATTLIST: no name for Attribute\n")
            break
        }
        if skipBlanks(p) == 0 {
            fatalErrMsg(p, ERR_SPACE_REQUIRED, "Space required after the attribute name\n")
            break
        }
        const atype = parseAttributeType(p)
        if atype <= 0 { break }
        if skipBlanks(p) == 0 {
            fatalErrMsg(p, ERR_SPACE_REQUIRED, "Space required after the attribute type\n")
            break
        }
        var defaultValue: usize = 0
        const def = parseDefaultDecl(p, &defaultValue)
        if def <= 0 {
            dealloc(p, defaultValue)
            break
        }
        if atype != ATTRIBUTE_CDATA && defaultValue != 0 { normalizeSpaceInPlace(defaultValue) }
        if RAW(p) != 62 {
            if skipBlanks(p) == 0 {
                fatalErrMsg(p, ERR_SPACE_REQUIRED, "Space required after the attribute default value\n")
                dealloc(p, defaultValue)
                break
            }
        }
        if defaultValue != 0 && def != ATTRIBUTE_IMPLIED && def != ATTRIBUTE_REQUIRED {
            addDefAttrs(p, elemName, attrName, defaultValue)
        }
        addSpecialAttr(p, elemName, attrName, atype)
        dealloc(p, defaultValue)
    }
    if RAW(p) == 62 {
        if inputid != inp(p).*.id {
            fatalErrMsg(p, ERR_ENTITY_BOUNDARY, "Attribute list declaration doesn't start and stop in the same entity\n")
        }
        nextChar(p)
    }
}

// xmlParseElementMixedContentDecl: whether there is a content model.
fn parseElementMixedContentDecl(p: *Parser, inputchk: i64) -> bool {
    var ret = false
    var elem: usize = 0
    if CMP(p, "#PCDATA") {
        SKIP(p, 7)
        var ignored = skipBlanks(p)
        if RAW(p) == 41 {
            if inp(p).*.id != inputchk {
                fatalErrMsg(p, ERR_ENTITY_BOUNDARY, "Element content declaration doesn't start and stop in the same entity\n")
            }
            nextChar(p)
            if RAW(p) == 42 { nextChar(p) }
            return true
        }
        if RAW(p) == 40 || RAW(p) == 124 { ret = true }
        while RAW(p) == 124 && p.*.instate != STATE_EOF {
            nextChar(p)
            ret = true
            ignored = skipBlanks(p)
            elem = parseName(p)
            if elem == 0 {
                fatalErrMsg(p, ERR_NAME_REQUIRED, "xmlParseElementMixedContentDecl : Name expected\n")
                return false
            }
            ignored = skipBlanks(p)
        }
        if RAW(p) == 41 && NXT(p, 1) == 42 {
            if inp(p).*.id != inputchk {
                fatalErrMsg(p, ERR_ENTITY_BOUNDARY, "Element content declaration doesn't start and stop in the same entity\n")
            }
            SKIP(p, 2)
        } else {
            fatalErr(p, ERR_MIXED_NOT_STARTED, 0)
            return false
        }
    } else {
        fatalErr(p, ERR_PCDATA_REQUIRED, 0)
    }
    return ret
}

// xmlParseElementChildrenContentDeclPriv: whether there is a content
// model.
fn parseElementChildrenContentDecl(p: *Parser, inputchk: i64, depth: i64) -> bool {
    if (depth > 128 && (p.*.options & PARSE_HUGE) == 0) || depth > 2048 {
        fatalErrMsgInt(p, ERR_ELEMCONTENT_NOT_FINISHED, "xmlParseElementChildrenContentDecl : depth %d too deep, use XML_PARSE_HUGE\n", depth)
        return false
    }
    var type_: u64 = 0
    var ignored = skipBlanks(p)
    if RAW(p) == 40 {
        const inputid = inp(p).*.id
        nextChar(p)
        ignored = skipBlanks(p)
        if !parseElementChildrenContentDecl(p, inputid, depth + 1) { return false }
        ignored = skipBlanks(p)
    } else {
        const elem = parseName(p)
        if elem == 0 {
            fatalErr(p, ERR_ELEMCONTENT_NOT_STARTED, 0)
            return false
        }
        if RAW(p) == 63 || RAW(p) == 42 || RAW(p) == 43 { nextChar(p) }
    }
    ignored = skipBlanks(p)
    while RAW(p) != 41 && p.*.instate != STATE_EOF {
        if RAW(p) == 44 || RAW(p) == 124 {
            if type_ == 0 {
                type_ = RAW(p)
            } else if type_ != RAW(p) {
                fatalErrMsgInt(p, ERR_SEPARATOR_REQUIRED, "xmlParseElementChildrenContentDecl : '%c' expected\n", @intCast(i64, type_))
                return false
            }
            nextChar(p)
        } else {
            fatalErr(p, ERR_ELEMCONTENT_NOT_FINISHED, 0)
            return false
        }
        ignored = skipBlanks(p)
        if RAW(p) == 40 {
            const inputid = inp(p).*.id
            nextChar(p)
            ignored = skipBlanks(p)
            if !parseElementChildrenContentDecl(p, inputid, depth + 1) { return false }
            ignored = skipBlanks(p)
        } else {
            const elem = parseName(p)
            if elem == 0 {
                fatalErr(p, ERR_ELEMCONTENT_NOT_STARTED, 0)
                return false
            }
            if RAW(p) == 63 || RAW(p) == 42 || RAW(p) == 43 { nextChar(p) }
        }
        ignored = skipBlanks(p)
    }
    if inp(p).*.id != inputchk {
        fatalErrMsg(p, ERR_ENTITY_BOUNDARY, "Element content declaration doesn't start and stop in the same entity\n")
    }
    nextChar(p)
    if RAW(p) == 63 || RAW(p) == 42 || RAW(p) == 43 { nextChar(p) }
    return true
}

// xmlParseElementDecl.
fn parseElementDecl(p: *Parser) -> i64 {
    if !CMP(p, "<!ELEMENT") { return -1 }
    const inputid = inp(p).*.id
    SKIP(p, 9)
    if skipBlanks(p) == 0 {
        fatalErrMsg(p, ERR_SPACE_REQUIRED, "Space required after 'ELEMENT'\n")
        return -1
    }
    const name = parseName(p)
    if name == 0 {
        fatalErrMsg(p, ERR_NAME_REQUIRED, "xmlParseElementDecl: no name for Element\n")
        return -1
    }
    if skipBlanks(p) == 0 { fatalErrMsg(p, ERR_SPACE_REQUIRED, "Space required after the element name\n") }
    var ret: i64 = -1
    if CMP(p, "EMPTY") {
        SKIP(p, 5)
        ret = 1
    } else if RAW(p) == 65 && NXT(p, 1) == 78 && NXT(p, 2) == 89 {
        SKIP(p, 3)
        ret = 2
    } else if RAW(p) == 40 {
        // xmlParseElementContentDecl.
        const contentInput = inp(p).*.id
        nextChar(p)
        if p.*.instate == STATE_EOF { return -1 }
        var ignored = skipBlanks(p)
        if CMP(p, "#PCDATA") {
            const tree = parseElementMixedContentDecl(p, contentInput)
            ret = 3
        } else {
            const tree = parseElementChildrenContentDecl(p, contentInput, 1)
            ret = 4
        }
        ignored = skipBlanks(p)
    } else {
        if RAW(p) == 37 && p.*.inputNr == 1 {
            fatalErrMsg(p, ERR_PEREF_IN_INT_SUBSET, "PEReference: forbidden within markup decl in internal subset\n")
        } else {
            fatalErrMsg(p, ERR_ELEMCONTENT_NOT_STARTED, "xmlParseElementDecl: 'EMPTY', 'ANY' or '(' expected\n")
        }
        return -1
    }
    const ignored = skipBlanks(p)
    if RAW(p) != 62 {
        fatalErr(p, ERR_GT_REQUIRED, 0)
    } else {
        if inputid != inp(p).*.id {
            fatalErrMsg(p, ERR_ENTITY_BOUNDARY, "Element declaration doesn't start and stop in the same entity\n")
        }
        nextChar(p)
    }
    return ret
}

// xmlParseMarkupDecl.
fn parseMarkupDecl(p: *Parser) -> void {
    if RAW(p) == 60 {
        if NXT(p, 1) == 33 {
            const c = NXT(p, 2)
            if c == 69 {
                if NXT(p, 3) == 76 {
                    const ignored = parseElementDecl(p)
                } else if NXT(p, 3) == 78 {
                    parseEntityDecl(p)
                }
            } else if c == 65 {
                parseAttributeListDecl(p)
            } else if c == 78 {
                parseNotationDecl(p)
            } else if c == 45 {
                parseComment(p)
            }
        } else if NXT(p, 1) == 63 {
            parsePI(p)
        }
    }
    if p.*.instate == STATE_EOF { return }
    p.*.instate = STATE_DTD
}

// ---------------------------------------------------------------------------
// References

// The handler's getEntity with libxml2's fallbacks: MODE 0 as
// xmlParseEntityRef asks (SAX2's own lookup only while the document is
// well-formed), 1 as the others do.
fn getEntityFor(p: *Parser, name: usize, view: *EntityView, mode: i64) -> bool {
    view.*.orig = 0
    if p.*.handler.getEntity != 0 {
        const call: EntityFn = unsafe { @ptrFromInt(EntityFn, p.*.handler.getEntity) }
        p.*.view.orig = 0
        const found = call(p.*.handler.user, name, &p.*.view, mode)
        view.* = p.*.view
        return found
    }
    return ownGetEntity(p, name, view)
}

// xmlParseEntityRef: the entity a reference names (VIEW), false when
// there is none.
fn parseEntityRef(p: *Parser, view: *EntityView) -> bool {
    if p.*.instate == STATE_EOF { return false }
    if RAW(p) != 38 { return false }
    nextChar(p)
    const name = parseName(p)
    if name == 0 {
        fatalErrMsg(p, ERR_NAME_REQUIRED, "xmlParseEntityRef: no name\n")
        return false
    }
    if RAW(p) != 59 {
        fatalErr(p, ERR_ENTITYREF_SEMICOL_MISSING, 0)
        return false
    }
    nextChar(p)
    if (p.*.options & PARSE_OLDSAX) == 0 {
        if predefined(p, name, view) { return true }
    }
    p.*.nbentities += 1
    var found = getEntityFor(p, name, view, 0)
    if !found && p.*.wellFormed && (p.*.options & PARSE_OLDSAX) != 0 { found = predefined(p, name, view) }
    if p.*.instate == STATE_EOF { return false }
    if !found {
        if p.*.standalone == 1 || (!p.*.hasExternalSubset && !p.*.hasPErefs) {
            fatalErrMsgStr(p, ERR_UNDECLARED_ENTITY, "Entity '%s' not defined\n", name)
        } else {
            errMsgStr(p, WAR_UNDECLARED_ENTITY, "Entity '%s' not defined\n", name)
            if p.*.inSubset == 0 { reference(p, name) }
        }
        p.*.valid = false
    } else if view.*.etype == EXTERNAL_GENERAL_UNPARSED_ENTITY {
        fatalErrMsgStr(p, ERR_UNPARSED_ENTITY, "Entity reference to unparsed entity %s\n", name)
    } else if p.*.instate == STATE_ATTRIBUTE_VALUE && view.*.etype == EXTERNAL_GENERAL_PARSED_ENTITY {
        fatalErrMsgStr(p, ERR_ENTITY_IS_EXTERNAL, "Attribute references external entity '%s'\n", name)
    } else if p.*.instate == STATE_ATTRIBUTE_VALUE && view.*.etype != INTERNAL_PREDEFINED_ENTITY {
        const checked = checkedOf(view)
        if ((checked & 1) != 0 || checked == 0) && view.*.content != 0 && text.contains(view.*.content, 60) {
            fatalErrMsgStr(p, ERR_LT_IN_ATTRIBUTE, "'<' in entity '%s' is not allowed in attributes values\n", name)
        }
    } else if view.*.etype == INTERNAL_PARAMETER_ENTITY || view.*.etype == EXTERNAL_PARAMETER_ENTITY {
        fatalErrMsgStr(p, ERR_ENTITY_IS_PARAMETER, "Attempt to reference the parameter entity '%s'\n", name)
    }
    return found
}

// xmlParseStringEntityRef.
fn parseStringEntityRef(p: *Parser, str: *usize, view: *EntityView) -> bool {
    var ptr = str.*
    if text.get8(ptr) != 38 { return false }
    ptr += 1
    const name = parseStringName(p, &ptr)
    if name == 0 {
        fatalErrMsg(p, ERR_NAME_REQUIRED, "xmlParseStringEntityRef: no name\n")
        str.* = ptr
        return false
    }
    if text.get8(ptr) != 59 {
        fatalErr(p, ERR_ENTITYREF_SEMICOL_MISSING, 0)
        dealloc(p, name)
        str.* = ptr
        return false
    }
    ptr += 1
    if (p.*.options & PARSE_OLDSAX) == 0 {
        if predefined(p, name, view) {
            dealloc(p, name)
            str.* = ptr
            return true
        }
    }
    p.*.nbentities += 1
    var found = getEntityFor(p, name, view, 1)
    if !found && (p.*.options & PARSE_OLDSAX) != 0 { found = predefined(p, name, view) }
    if p.*.instate == STATE_EOF {
        dealloc(p, name)
        return false
    }
    if !found {
        if p.*.standalone == 1 || (!p.*.hasExternalSubset && !p.*.hasPErefs) {
            fatalErrMsgStr(p, ERR_UNDECLARED_ENTITY, "Entity '%s' not defined\n", name)
        } else {
            errMsgStr(p, WAR_UNDECLARED_ENTITY, "Entity '%s' not defined\n", name)
        }
    } else if view.*.etype == EXTERNAL_GENERAL_UNPARSED_ENTITY {
        fatalErrMsgStr(p, ERR_UNPARSED_ENTITY, "Entity reference to unparsed entity %s\n", name)
    } else if p.*.instate == STATE_ATTRIBUTE_VALUE && view.*.etype == EXTERNAL_GENERAL_PARSED_ENTITY {
        fatalErrMsgStr(p, ERR_ENTITY_IS_EXTERNAL, "Attribute references external entity '%s'\n", name)
    } else if p.*.instate == STATE_ATTRIBUTE_VALUE && view.*.content != 0 && view.*.etype != INTERNAL_PREDEFINED_ENTITY && text.contains(view.*.content, 60) {
        fatalErrMsgStr(p, ERR_LT_IN_ATTRIBUTE, "'<' in entity '%s' is not allowed in attributes values\n", name)
    } else if view.*.etype == INTERNAL_PARAMETER_ENTITY || view.*.etype == EXTERNAL_PARAMETER_ENTITY {
        fatalErrMsgStr(p, ERR_ENTITY_IS_PARAMETER, "Attempt to reference the parameter entity '%s'\n", name)
    }
    dealloc(p, name)
    str.* = ptr
    return found
}

// An entity's content as an input of its own (xmlNewEntityInputStream),
// 0 when it has none.
fn entityInput(p: *Parser, view: *EntityView) -> usize {
    if view.*.content == 0 {
        if view.*.etype == EXTERNAL_GENERAL_UNPARSED_ENTITY {
            errInternal(p, "Cannot parse entity %s\n", view.*.name)
        } else if view.*.etype == INTERNAL_GENERAL_ENTITY {
            errInternal(p, "Internal entity %s without content !\n", view.*.name)
        } else if view.*.etype == INTERNAL_PARAMETER_ENTITY {
            errInternal(p, "Internal parameter entity %s without content !\n", view.*.name)
        } else if view.*.etype == INTERNAL_PREDEFINED_ENTITY {
            errInternal(p, "Predefined entity %s without content !\n", view.*.name)
        } else {
            loadExternalFailed(p, view.*.uri, view.*.externalId)
        }
        return 0
    }
    const address = newInput(p)
    if address == 0 { return 0 }
    const i = inputAt(address)
    if view.*.uri != 0 { i.*.filename = text.duplicateString(p.*.allocator, view.*.uri) }
    const len = text.length(view.*.content)
    i.*.base = view.*.content
    i.*.cur = view.*.content
    i.*.length = @intCast(i64, len)
    i.*.end = view.*.content + len
    return address
}

// An external entity that is not loaded: what libxml2 says when its
// loader finds nothing at the URI (xmlLoadExternalEntity).
fn loadExternalFailed(p: *Parser, systemId: usize, publicId: usize) -> void {
    if systemId == 0 { return }
    if p.*.validate {
        raise(p, FROM_IO, 1549, LEVEL_ERROR, systemId, 0, 0, 0, "failed to load external entity \"%s\"\n", systemId, 0, 0, 0)
    } else {
        raise(p, FROM_IO, 1549, LEVEL_WARNING, systemId, 0, 0, 0, "failed to load external entity \"%s\"\n", systemId, 0, 0, 0)
    }
}

// xmlParsePEReference.
fn parsePEReference(p: *Parser) -> void {
    if RAW(p) != 37 { return }
    nextChar(p)
    const name = parseName(p)
    if name == 0 {
        fatalErrMsg(p, ERR_PEREF_NO_NAME, "PEReference: no name\n")
        return
    }
    if RAW(p) != 59 {
        fatalErr(p, ERR_PEREF_SEMICOL_MISSING, 0)
        return
    }
    nextChar(p)
    p.*.nbentities += 1
    var view: EntityView = undefined
    view.orig = 0
    const found = getParameterEntity(p, name, &view)
    if p.*.instate == STATE_EOF { return }
    if !found {
        if p.*.standalone == 1 || (!p.*.hasExternalSubset && !p.*.hasPErefs) {
            fatalErrMsgStr(p, ERR_UNDECLARED_ENTITY, "PEReference: %%%s; not found\n", name)
        } else {
            warningMsg(p, WAR_UNDECLARED_ENTITY, "PEReference: %%%s; not found\n", name, 0)
            p.*.valid = false
        }
    } else {
        if view.etype != INTERNAL_PARAMETER_ENTITY && view.etype != EXTERNAL_PARAMETER_ENTITY {
            warningMsg(p, WAR_UNDECLARED_ENTITY, "Internal: %%%s; is not a parameter entity\n", name, 0)
        } else {
            if view.etype == EXTERNAL_PARAMETER_ENTITY && (p.*.options & (PARSE_NOENT | PARSE_DTDVALID | PARSE_DTDLOAD | PARSE_DTDATTR)) == 0 && !p.*.replaceEntities && !p.*.validate {
                return
            }
            const parentConsumed = inp(p).*.parentConsumed + inp(p).*.consumed + @intCast(u64, inp(p).*.cur - inp(p).*.base)
            const input = entityInput(p, &view)
            if pushInput(p, input) < 0 {
                freeInput(p, input)
                return
            }
            inputAt(input).*.parentConsumed = parentConsumed
        }
    }
    p.*.hasPErefs = true
}

// xmlParseStringPEReference.
fn parseStringPEReference(p: *Parser, str: *usize, view: *EntityView) -> bool {
    var ptr = str.*
    if text.get8(ptr) != 37 { return false }
    ptr += 1
    const name = parseStringName(p, &ptr)
    if name == 0 {
        fatalErrMsg(p, ERR_NAME_REQUIRED, "xmlParseStringPEReference: no name\n")
        str.* = ptr
        return false
    }
    if text.get8(ptr) != 59 {
        fatalErr(p, ERR_ENTITYREF_SEMICOL_MISSING, 0)
        dealloc(p, name)
        str.* = ptr
        return false
    }
    ptr += 1
    p.*.nbentities += 1
    view.*.orig = 0
    const found = getParameterEntity(p, name, view)
    if p.*.instate == STATE_EOF {
        dealloc(p, name)
        str.* = ptr
        return false
    }
    if !found {
        if p.*.standalone == 1 || (!p.*.hasExternalSubset && !p.*.hasPErefs) {
            fatalErrMsgStr(p, ERR_UNDECLARED_ENTITY, "PEReference: %%%s; not found\n", name)
        } else {
            warningMsg(p, WAR_UNDECLARED_ENTITY, "PEReference: %%%s; not found\n", name, 0)
            p.*.valid = false
        }
    } else if view.*.etype != INTERNAL_PARAMETER_ENTITY && view.*.etype != EXTERNAL_PARAMETER_ENTITY {
        warningMsg(p, WAR_UNDECLARED_ENTITY, "%%%s; is not a parameter entity\n", name, 0)
    }
    p.*.hasPErefs = true
    dealloc(p, name)
    str.* = ptr
    return found
}

// ---------------------------------------------------------------------------
// The DOCTYPE

// xmlParseDocTypeDecl.
fn parseDocTypeDecl(p: *Parser) -> void {
    SKIP(p, 9)
    var ignored = skipBlanks(p)
    const name = parseName(p)
    if name == 0 { fatalErrMsg(p, ERR_NAME_REQUIRED, "xmlParseDocTypeDecl : no DOCTYPE name !\n") }
    p.*.intSubName = name
    ignored = skipBlanks(p)
    var externalID: usize = 0
    const uriValue = parseExternalID(p, &externalID, true)
    if uriValue != 0 || externalID != 0 { p.*.hasExternalSubset = true }
    dealloc(p, p.*.extSubURI)
    dealloc(p, p.*.extSubSystem)
    p.*.extSubURI = uriValue
    p.*.extSubSystem = externalID
    ignored = skipBlanks(p)
    if p.*.handler.internalSubset != 0 && p.*.disableSAX == 0 { call3(p.*.handler.internalSubset, user(p), name, externalID, uriValue) }
    if p.*.instate == STATE_EOF { return }
    if RAW(p) == 91 { return }
    if RAW(p) != 62 { fatalErr(p, ERR_DOCTYPE_NOT_FINISHED, 0) }
    nextChar(p)
}

// xmlParseInternalSubset.
fn parseInternalSubset(p: *Parser) -> void {
    if RAW(p) == 91 {
        const baseInputNr = p.*.inputNr
        p.*.instate = STATE_DTD
        nextChar(p)
        while (RAW(p) != 93 || p.*.inputNr > baseInputNr) && p.*.instate != STATE_EOF {
            const check = CUR_PTR(p)
            const cons = inp(p).*.consumed
            const ignored = skipBlanks(p)
            parseMarkupDecl(p)
            parsePEReference(p)
            if CUR_PTR(p) == check && cons == inp(p).*.consumed {
                fatalErrInfo(p, ERR_INTERNAL_ERROR, "xmlParseInternalSubset: error detected in Markup declaration\n")
                if p.*.inputNr > baseInputNr {
                    const ignored2 = popInput(p)
                } else {
                    break
                }
            }
        }
        if RAW(p) == 93 {
            nextChar(p)
            const ignored3 = skipBlanks(p)
        }
    }
    if RAW(p) != 62 {
        fatalErr(p, ERR_DOCTYPE_NOT_FINISHED, 0)
        return
    }
    nextChar(p)
}

fn externalSubset(p: *Parser) -> void {
    if p.*.disableSAX == 0 && p.*.handler.externalSubset != 0 { call3(p.*.handler.externalSubset, user(p), p.*.intSubName, p.*.extSubSystem, p.*.extSubURI) }
}

// ---------------------------------------------------------------------------
// Namespaces and the element stack

// nsPush: PREFIX bound to URL; the count of the table, or -2 when the
// binding is already there (XML_PARSE_NSCLEAN).
fn nsPush(p: *Parser, prefix: usize, url: usize) -> i64 {
    if (p.*.options & PARSE_NSCLEAN) != 0 {
        var i = p.*.nsNr - 2
        while i >= 0 {
            if word(p.*.nsTab, i) == prefix {
                if word(p.*.nsTab, i + 1) == url { return -2 }
                break
            }
            i -= 2
        }
    }
    if p.*.nsNr + 2 > p.*.nsMax {
        const max = if p.*.nsMax == 0 { 10 } else { p.*.nsMax * 2 }
        const grown = growWords(p, p.*.nsTab, max)
        if grown == 0 { return -1 }
        p.*.nsTab = grown
        p.*.nsMax = max
    }
    setWord(p.*.nsTab, p.*.nsNr, prefix)
    setWord(p.*.nsTab, p.*.nsNr + 1, url)
    p.*.nsNr += 2
    return p.*.nsNr
}

fn nsPop(p: *Parser, count: i64) -> void {
    var nr = count
    if p.*.nsNr < nr { nr = p.*.nsNr }
    var k: i64 = 0
    while k < nr {
        p.*.nsNr -= 1
        setWord(p.*.nsTab, p.*.nsNr, 0)
        k += 1
    }
}

// xmlGetNamespace: the URI bound to PREFIX (a dictionary string).
fn getNamespace(p: *Parser, prefix: usize) -> usize {
    if prefix == p.*.strXml { return p.*.strXmlNs }
    var i = p.*.nsNr - 2
    while i >= 0 {
        if word(p.*.nsTab, i) == prefix {
            if prefix == 0 && text.get8(word(p.*.nsTab, i + 1)) == 0 { return 0 }
            return word(p.*.nsTab, i + 1)
        }
        i -= 2
    }
    return 0
}

// nameNsPush: an open element (its name, prefix, URI, line and the
// count of namespaces it declared).
fn nameNsPush(p: *Parser, value: usize, prefix: usize, uriValue: usize, line: i64, nsNr: i64) -> void {
    if p.*.nameNr >= p.*.nameMax {
        const max = p.*.nameMax * 2
        const names = growWords(p, p.*.nameTab, max)
        const tags = growWords(p, p.*.pushTab, max * 4)
        if names == 0 || tags == 0 { return }
        p.*.nameTab = names
        p.*.pushTab = tags
        p.*.nameMax = max
    }
    setWord(p.*.nameTab, p.*.nameNr, value)
    p.*.name = value
    const tag = p.*.nameNr * 4
    setWord(p.*.pushTab, tag, prefix)
    setWord(p.*.pushTab, tag + 1, uriValue)
    setWord(p.*.pushTab, tag + 2, @bitCast(usize, line))
    setWord(p.*.pushTab, tag + 3, @bitCast(usize, nsNr))
    p.*.nameNr += 1
}

fn namePop(p: *Parser) -> void {
    if p.*.nameNr <= 0 { return }
    p.*.nameNr -= 1
    if p.*.nameNr > 0 {
        p.*.name = word(p.*.nameTab, p.*.nameNr - 1)
    } else {
        p.*.name = 0
    }
    setWord(p.*.nameTab, p.*.nameNr, 0)
}

inline fn tagPrefix(p: *Parser, index: i64) -> usize { return word(p.*.pushTab, index * 4) }
inline fn tagURI(p: *Parser, index: i64) -> usize { return word(p.*.pushTab, index * 4 + 1) }
inline fn tagLine(p: *Parser, index: i64) -> i64 { return @bitCast(i64, word(p.*.pushTab, index * 4 + 2)) }
inline fn tagNsNr(p: *Parser, index: i64) -> i64 { return @bitCast(i64, word(p.*.pushTab, index * 4 + 3)) }

// ---------------------------------------------------------------------------
// Qualified names

// xmlBuildQName of NCNAME and PREFIX, in the dictionary.
fn buildQName(p: *Parser, ncname: usize, prefix: usize) -> usize {
    var b: Buffer = undefined
    if !text.bufferInit(&b, p.*.allocator, 64) { return 0 }
    text.bufferAddString(&b, prefix)
    text.bufferAddByte(&b, 58)
    text.bufferAddString(&b, ncname)
    const ret = lookup(p, b.address, b.length)
    text.bufferFree(&b)
    return ret
}

// xmlParseQName: the local name, PREFIX the prefix (0 for none).
fn parseQName(p: *Parser, prefix: *usize) -> usize {
    var l = parseNCName(p)
    if l == 0 {
        if RAW(p) == 58 {
            l = parseName(p)
            if l != 0 {
                nsErr(p, NS_ERR_QNAME, "Failed to parse QName '%s'\n", l, 0, 0)
                prefix.* = 0
                return l
            }
        }
        return 0
    }
    if RAW(p) == 58 {
        nextChar(p)
        const pfx = l
        l = parseNCName(p)
        if l == 0 {
            if p.*.instate == STATE_EOF { return 0 }
            nsErr(p, NS_ERR_QNAME, "Failed to parse QName '%s:'\n", pfx, 0, 0)
            const tok = parseNmtoken(p)
            var tmp: usize = 0
            if tok == 0 {
                if p.*.instate == STATE_EOF { return 0 }
                tmp = buildQName(p, p.*.empty, pfx)
            } else {
                tmp = buildQName(p, tok, pfx)
                dealloc(p, tok)
            }
            prefix.* = 0
            return tmp
        }
        if RAW(p) == 58 {
            nsErr(p, NS_ERR_QNAME, "Failed to parse QName '%s:%s:'\n", pfx, l, 0)
            nextChar(p)
            const tmp = parseName(p)
            if tmp != 0 {
                l = buildQName(p, tmp, l)
                prefix.* = pfx
                return l
            }
            if p.*.instate == STATE_EOF { return 0 }
            l = buildQName(p, p.*.empty, l)
            prefix.* = pfx
            return l
        }
        prefix.* = pfx
    } else {
        prefix.* = 0
    }
    return l
}

// xmlParseQNameAndCompare.
fn parseQNameAndCompare(p: *Parser, name: usize, prefix: usize) -> usize {
    if prefix == 0 { return parseNameAndCompare(p, name) }
    const i = inp(p)
    var at = i.*.cur
    var cmp = prefix
    while text.get8(at) != 0 && text.get8(at) == text.get8(cmp) {
        at += 1
        cmp += 1
    }
    if text.get8(cmp) == 0 && text.get8(at) == 58 {
        at += 1
        cmp = name
        while text.get8(at) != 0 && text.get8(at) == text.get8(cmp) {
            at += 1
            cmp += 1
        }
        if text.get8(cmp) == 0 && (text.get8(at) == 62 || text.isBlank(text.get8(at))) {
            i.*.col += @intCast(i64, at - i.*.cur)
            i.*.cur = at
            return NAME_MATCHES
        }
    }
    var prefix2: usize = 0
    const ret = parseQName(p, &prefix2)
    if ret == name && prefix == prefix2 { return NAME_MATCHES }
    return ret
}

// ---------------------------------------------------------------------------
// Attributes

// xmlParseAttValueInternal: the value, in the input when it needs no
// change (ALLOCATED false), else a block of its own; LEN its length.
// COPY: always a block of its own (xmlParseAttValue).
fn parseAttValueInternal(p: *Parser, len: *i64, allocated: *bool, normalize: bool, copy: bool) -> usize {
    var at = CUR_PTR(p)
    var line = inp(p).*.line
    var col = inp(p).*.col
    if text.get8(at) != 34 && text.get8(at) != 39 {
        fatalErr(p, ERR_ATTRIBUTE_NOT_STARTED, 0)
        return 0
    }
    p.*.instate = STATE_ATTRIBUTE_VALUE
    const limit = text.get8(at)
    at += 1
    col += 1
    const end = inp(p).*.end
    var start = at
    var last = at
    var complex = false
    if normalize {
        while at < end && text.get8(at) != limit && (text.get8(at) == 0x20 || text.get8(at) == 0x9 || text.get8(at) == 0xA || text.get8(at) == 0xD) {
            if text.get8(at) == 0xA {
                line += 1
                col = 1
            } else {
                col += 1
            }
            at += 1
            start = at
        }
        while at < end && text.get8(at) != limit && text.get8(at) >= 0x20 && text.get8(at) <= 0x7F && text.get8(at) != 38 && text.get8(at) != 60 {
            col += 1
            const c = text.get8(at)
            at += 1
            if c == 0x20 && text.get8(at) == 0x20 { break }
        }
        last = at
        while last > start && text.get8(last - 1) == 0x20 { last -= 1 }
        while at < end && text.get8(at) != limit && (text.get8(at) == 0x20 || text.get8(at) == 0x9 || text.get8(at) == 0xA || text.get8(at) == 0xD) {
            if text.get8(at) == 0xA {
                line += 1
                col = 1
            } else {
                col += 1
            }
            at += 1
        }
        if at - start > maxText(p) {
            fatalErrMsg(p, ERR_ATTRIBUTE_NOT_FINISHED, "AttValue length too long\n")
            return 0
        }
        if text.get8(at) != limit { complex = true }
    } else {
        while at < end && text.get8(at) != limit && text.get8(at) >= 0x20 && text.get8(at) <= 0x7F && text.get8(at) != 38 && text.get8(at) != 60 {
            at += 1
            col += 1
        }
        last = at
        if at - start > maxText(p) {
            fatalErrMsg(p, ERR_ATTRIBUTE_NOT_FINISHED, "AttValue length too long\n")
            return 0
        }
        if text.get8(at) != limit { complex = true }
    }
    if complex {
        allocated.* = true
        return parseAttValueComplex(p, len, normalize)
    }
    at += 1
    col += 1
    len.* = @intCast(i64, last - start)
    var ret = start
    allocated.* = false
    if copy {
        ret = text.duplicate(p.*.allocator, start, last - start)
        allocated.* = true
    }
    inp(p).*.cur = at
    inp(p).*.line = line
    inp(p).*.col = col
    return ret
}

// xmlAttrNormalizeSpace2 on an allocated value: the value to use (SRC
// changed in place, or a new block), 0 when it is as it was.
fn attrNormalizeSpace2(p: *Parser, src: usize, len: *i64) -> usize {
    const i = len.*
    if i <= 0 { return 0 }
    var cur = src
    var removeHead: usize = 0
    var needRealloc = false
    while text.get8(cur) == 0x20 {
        cur += 1
        removeHead += 1
    }
    while text.get8(cur) != 0 {
        if text.get8(cur) == 0x20 {
            cur += 1
            if text.get8(cur) == 0x20 || text.get8(cur) == 0 {
                needRealloc = true
                break
            }
        } else {
            cur += 1
        }
    }
    if needRealloc {
        const ret = text.duplicate(p.*.allocator, src + removeHead, @intCast(usize, i) - removeHead + 1)
        if ret == 0 { return 0 }
        normalizeSpaceInPlace(ret)
        len.* = @intCast(i64, text.length(ret))
        return ret
    } else if removeHead > 0 {
        len.* = len.* - @intCast(i64, removeHead)
        text.move(src, src + removeHead, @intCast(usize, len.*) + 1)
        return src
    }
    return 0
}

// xmlParseAttribute2: an attribute's name (PREFIX its prefix) and value.
fn parseAttribute2(p: *Parser, pref: usize, elem: usize, prefix: *usize, value: *usize, len: *i64, allocated: *bool) -> usize {
    value.* = 0
    const name = parseQName(p, prefix)
    if name == 0 {
        fatalErrMsg(p, ERR_NAME_REQUIRED, "error parsing attribute name\n")
        return 0
    }
    var normalize = false
    if p.*.attsSpecial != 0 {
        if specialType(p, pref, elem, prefix.*, name) != 0 { normalize = true }
    }
    var ignored = skipBlanks(p)
    var val: usize = 0
    if RAW(p) == 61 {
        nextChar(p)
        ignored = skipBlanks(p)
        val = parseAttValueInternal(p, len, allocated, normalize, false)
        if val == 0 { return 0 }
        if normalize && allocated.* {
            const val2 = attrNormalizeSpace2(p, val, len)
            if val2 != 0 && val2 != val {
                dealloc(p, val)
                val = val2
            }
        }
        p.*.instate = STATE_CONTENT
    } else {
        fatalErrMsgStr(p, ERR_ATTRIBUTE_WITHOUT_VALUE, "Specification mandates value for attribute %s\n", name)
        return 0
    }
    if prefix.* == p.*.strXml && val != 0 {
        if text.equalText(name, "space") {
            const internal = text.duplicate(p.*.allocator, val, @intCast(usize, len.*))
            if text.equalText(internal, "default") {
                setSpace(p, 0)
            } else if text.equalText(internal, "preserve") {
                setSpace(p, 1)
            } else {
                warningMsg(p, WAR_SPACE_VALUE, "Invalid value \"%s\" for xml:space : \"default\" or \"preserve\" expected\n", internal, 0)
            }
            dealloc(p, internal)
        }
    }
    value.* = val
    return name
}

fn growAttrs(p: *Parser, nr: i64) -> bool {
    if p.*.atts == 0 {
        p.*.atts = alloc(p, 55 * 8)
        p.*.attallocs = alloc(p, 11 * 8)
        p.*.maxatts = 55
        if p.*.atts == 0 || p.*.attallocs == 0 { return false }
    } else if nr + 5 > p.*.maxatts {
        const max = (nr + 5) * 2
        const atts = growWords(p, p.*.atts, max)
        const allocs = growWords(p, p.*.attallocs, max / 5)
        if atts == 0 || allocs == 0 { return false }
        p.*.atts = atts
        p.*.attallocs = allocs
        p.*.maxatts = max
    }
    return true
}

// xmlParseStartTag2: a start tag; its local name (0 on an error), PREF
// and URI its prefix and namespace.
fn parseStartTag2(p: *Parser, pref: *usize, uriOut: *usize) -> usize {
    if RAW(p) != 60 { return 0 }
    NEXT1(p)
    const inputid = inp(p).*.id
    var nbatts: i64 = 0
    var nratts: i64 = 0
    var nbdef: i64 = 0
    var nbNs: i64 = 0
    var attval = false
    const nsNr = p.*.nsNr
    var prefix: usize = 0
    var localname = parseQName(p, &prefix)
    if localname == 0 {
        fatalErrMsg(p, ERR_NAME_REQUIRED, "StartTag: invalid element name\n")
        return 0
    }
    var ignored = skipBlanks(p)
    while RAW(p) != 62 && (RAW(p) != 47 || NXT(p, 1) != 62) && text.isByteChar(RAW(p)) && p.*.instate != STATE_EOF {
        const q = CUR_PTR(p)
        const cons = inp(p).*.consumed
        var len: i64 = -1
        var allocated = false
        var aprefix: usize = 0
        var attvalue: usize = 0
        const attname = parseAttribute2(p, prefix, localname, &aprefix, &attvalue, &len, &allocated)
        if attname != 0 && attvalue != 0 {
            if len < 0 { len = @intCast(i64, text.length(attvalue)) }
            if attname == p.*.strXmlns && aprefix == 0 {
                const url = lookup(p, attvalue, @intCast(usize, len))
                var skip = false
                if text.get8(url) != 0 {
                    const parsed = uri.parse(url)
                    if !parsed.valid {
                        nsErr(p, WAR_NS_URI, "xmlns: '%s' is not a valid URI\n", url, 0, 0)
                    } else if !parsed.hasScheme {
                        nsWarn(p, WAR_NS_URI_RELATIVE, "xmlns: URI %s is not absolute\n", url, 0, 0)
                    }
                    if url == p.*.strXmlNs {
                        if attname != p.*.strXml {
                            nsErr(p, NS_ERR_XML_NAMESPACE, "xml namespace URI cannot be the default namespace\n", 0, 0, 0)
                        }
                        skip = true
                    } else if len == 29 && text.equalText(url, "http://www.w3.org/2000/xmlns/") {
                        nsErr(p, NS_ERR_XML_NAMESPACE, "reuse of the xmlns namespace name is forbidden\n", 0, 0, 0)
                        skip = true
                    }
                }
                if !skip {
                    var j: i64 = 1
                    while j <= nbNs {
                        if word(p.*.nsTab, p.*.nsNr - 2 * j) == 0 { break }
                        j += 1
                    }
                    if j <= nbNs {
                        errAttributeDup(p, 0, attname)
                    } else if nsPush(p, 0, url) > 0 {
                        nbNs += 1
                    }
                }
            } else if aprefix == p.*.strXmlns {
                const url = lookup(p, attvalue, @intCast(usize, len))
                var skip = false
                if attname == p.*.strXml {
                    if url != p.*.strXmlNs {
                        nsErr(p, NS_ERR_XML_NAMESPACE, "xml namespace prefix mapped to wrong URI\n", 0, 0, 0)
                    }
                    skip = true
                } else if url == p.*.strXmlNs {
                    if attname != p.*.strXml {
                        nsErr(p, NS_ERR_XML_NAMESPACE, "xml namespace URI mapped to wrong prefix\n", 0, 0, 0)
                    }
                    skip = true
                } else if attname == p.*.strXmlns {
                    nsErr(p, NS_ERR_XML_NAMESPACE, "redefinition of the xmlns prefix is forbidden\n", 0, 0, 0)
                    skip = true
                } else if len == 29 && text.equalText(url, "http://www.w3.org/2000/xmlns/") {
                    nsErr(p, NS_ERR_XML_NAMESPACE, "reuse of the xmlns namespace name is forbidden\n", 0, 0, 0)
                    skip = true
                } else if url == 0 || text.get8(url) == 0 {
                    nsErr(p, NS_ERR_XML_NAMESPACE, "xmlns:%s: Empty XML namespace is not allowed\n", attname, 0, 0)
                    skip = true
                } else {
                    const parsed = uri.parse(url)
                    if !parsed.valid {
                        nsErr(p, WAR_NS_URI, "xmlns:%s: '%s' is not a valid URI\n", attname, url, 0)
                    } else if p.*.pedantic && !parsed.hasScheme {
                        nsWarn(p, WAR_NS_URI_RELATIVE, "xmlns:%s: URI %s is not absolute\n", attname, url, 0)
                    }
                }
                if !skip {
                    var j: i64 = 1
                    while j <= nbNs {
                        if word(p.*.nsTab, p.*.nsNr - 2 * j) == attname { break }
                        j += 1
                    }
                    if j <= nbNs {
                        errAttributeDup(p, aprefix, attname)
                    } else if nsPush(p, attname, url) > 0 {
                        nbNs += 1
                    }
                }
            } else {
                if p.*.atts == 0 || nbatts + 5 > p.*.maxatts {
                    if !growAttrs(p, nbatts + 5) {
                        if allocated { dealloc(p, attvalue) }
                        attvalue = 0
                    }
                }
                if attvalue != 0 {
                    setWord(p.*.attallocs, nratts, if allocated { 1 } else { 0 })
                    nratts += 1
                    setWord(p.*.atts, nbatts, attname)
                    setWord(p.*.atts, nbatts + 1, aprefix)
                    setWord(p.*.atts, nbatts + 2, 0)
                    setWord(p.*.atts, nbatts + 3, attvalue)
                    setWord(p.*.atts, nbatts + 4, attvalue + @intCast(usize, len))
                    nbatts += 5
                    if allocated { attval = true }
                    attvalue = 0
                }
            }
        }
        if attvalue != 0 && allocated { dealloc(p, attvalue) }
        if p.*.instate == STATE_EOF { break }
        if RAW(p) == 62 || (RAW(p) == 47 && NXT(p, 1) == 62) { break }
        if skipBlanks(p) == 0 {
            fatalErrMsg(p, ERR_SPACE_REQUIRED, "attributes construct error\n")
            break
        }
        if cons == inp(p).*.consumed && q == CUR_PTR(p) && attname == 0 && attvalue == 0 {
            fatalErrInfo(p, ERR_INTERNAL_ERROR, "xmlParseStartTag: problem parsing attributes\n")
            break
        }
    }
    if inp(p).*.id != inputid {
        fatalErrInfo(p, ERR_INTERNAL_ERROR, "Unexpected change of input\n")
        localname = 0
    } else {
        // The defaults of the DTD.
        if p.*.attsDefault != 0 {
            const defaults = findDefaults(p, localname, prefix)
            if defaults != 0 {
                const values = defaultsAt(defaults).*.values.address
                const count = @intCast(i64, defaultsAt(defaults).*.values.length / 40)
                var i: i64 = 0
                while i < count {
                    const attname = word(values, 5 * i)
                    const aprefix = word(values, 5 * i + 1)
                    if attname == p.*.strXmlns && aprefix == 0 {
                        var j: i64 = 1
                        while j <= nbNs {
                            if word(p.*.nsTab, p.*.nsNr - 2 * j) == 0 { break }
                            j += 1
                        }
                        if j > nbNs {
                            const nsname = getNamespace(p, 0)
                            if nsname != word(values, 5 * i + 2) {
                                if nsPush(p, 0, word(values, 5 * i + 2)) > 0 { nbNs += 1 }
                            }
                        }
                    } else if aprefix == p.*.strXmlns {
                        var j: i64 = 1
                        while j <= nbNs {
                            if word(p.*.nsTab, p.*.nsNr - 2 * j) == attname { break }
                            j += 1
                        }
                        if j > nbNs {
                            const nsname = getNamespace(p, attname)
                            // (libxml2 compares with the first default's value.)
                            if nsname != word(values, 2) {
                                if nsPush(p, attname, word(values, 5 * i + 2)) > 0 { nbNs += 1 }
                            }
                        }
                    } else {
                        var j: i64 = 0
                        while j < nbatts {
                            if attname == word(p.*.atts, j) && aprefix == word(p.*.atts, j + 1) { break }
                            j += 5
                        }
                        if j >= nbatts {
                            var ok = true
                            if p.*.atts == 0 || nbatts + 5 > p.*.maxatts {
                                if !growAttrs(p, nbatts + 5) {
                                    localname = 0
                                    ok = false
                                }
                            }
                            if !ok { break }
                            setWord(p.*.atts, nbatts, attname)
                            setWord(p.*.atts, nbatts + 1, aprefix)
                            if aprefix == 0 {
                                setWord(p.*.atts, nbatts + 2, 0)
                            } else {
                                setWord(p.*.atts, nbatts + 2, getNamespace(p, aprefix))
                            }
                            setWord(p.*.atts, nbatts + 3, word(values, 5 * i + 2))
                            setWord(p.*.atts, nbatts + 4, word(values, 5 * i + 3))
                            nbatts += 5
                            if p.*.standalone == 1 && word(values, 5 * i + 4) != 0 {
                                validityError(p, DTD_STANDALONE_DEFAULTED, "standalone: attribute %s on %s defaulted from external subset\n", attname, localname)
                            }
                            nbdef += 1
                        }
                    }
                    i += 1
                }
            }
        }
        if localname != 0 {
            // The attributes' namespaces, and no attribute twice.
            var i: i64 = 0
            while i < nbatts {
                var nsname: usize = 0
                if word(p.*.atts, i + 1) != 0 {
                    nsname = getNamespace(p, word(p.*.atts, i + 1))
                    if nsname == 0 {
                        nsErr(p, NS_ERR_UNDEFINED_NAMESPACE, "Namespace prefix %s for %s on %s is not defined\n", word(p.*.atts, i + 1), word(p.*.atts, i), localname)
                    }
                    setWord(p.*.atts, i + 2, nsname)
                }
                var j: i64 = 0
                while j < i {
                    if word(p.*.atts, i) == word(p.*.atts, j) {
                        if word(p.*.atts, i + 1) == word(p.*.atts, j + 1) {
                            errAttributeDup(p, word(p.*.atts, i + 1), word(p.*.atts, i))
                            break
                        }
                        if nsname != 0 && word(p.*.atts, j + 2) == nsname {
                            nsErr(p, NS_ERR_ATTRIBUTE_REDEFINED, "Namespaced Attribute %s in '%s' redefined\n", word(p.*.atts, i), nsname, 0)
                            break
                        }
                    }
                    j += 5
                }
                i += 5
            }
            const nsname = getNamespace(p, prefix)
            if prefix != 0 && nsname == 0 {
                nsErr(p, NS_ERR_UNDEFINED_NAMESPACE, "Namespace prefix %s on %s is not defined\n", prefix, localname, 0)
            }
            pref.* = prefix
            uriOut.* = nsname
            if p.*.handler.startElementNs != 0 && p.*.disableSAX == 0 {
                const call: StartElementFn = unsafe { @ptrFromInt(StartElementFn, p.*.handler.startElementNs) }
                if nbNs > 0 {
                    call(user(p), localname, prefix, nsname, nbNs, p.*.nsTab + @intCast(usize, p.*.nsNr - 2 * nbNs) * 8, nbatts / 5, nbdef, p.*.atts)
                } else {
                    call(user(p), localname, prefix, nsname, 0, 0, nbatts / 5, nbdef, p.*.atts)
                }
            }
        }
    }
    if attval {
        var i: i64 = 3
        var j: i64 = 0
        while j < nratts {
            if word(p.*.attallocs, j) != 0 && word(p.*.atts, i) != 0 { dealloc(p, word(p.*.atts, i)) }
            i += 5
            j += 1
        }
    }
    return localname
}

fn endElementNs(p: *Parser, name: usize, prefix: usize, uriValue: usize) -> void {
    if p.*.handler.endElementNs != 0 && p.*.disableSAX == 0 { call3(p.*.handler.endElementNs, user(p), name, prefix, uriValue) }
}

// xmlParseEndTag2 for the open element at INDEX.
fn parseEndTag2(p: *Parser, index: i64) -> void {
    if RAW(p) != 60 || NXT(p, 1) != 47 {
        fatalErr(p, ERR_LTSLASH_REQUIRED, 0)
        return
    }
    SKIP(p, 2)
    const prefix = tagPrefix(p, index)
    var name: usize = 0
    if prefix == 0 {
        name = parseNameAndCompare(p, p.*.name)
    } else {
        name = parseQNameAndCompare(p, p.*.name, prefix)
    }
    if p.*.instate == STATE_EOF { return }
    const ignored = skipBlanks(p)
    if !text.isByteChar(RAW(p)) || RAW(p) != 62 {
        fatalErr(p, ERR_GT_REQUIRED, 0)
    } else {
        NEXT1(p)
    }
    if name != NAME_MATCHES {
        var shown = name
        if shown == 0 { shown = text.dictLookupText(p.*.dict, "unparsable") }
        fatalErrMsgStrIntStr(p, ERR_TAG_NAME_MISMATCH, "Opening and ending tag mismatch: %s line %d and %s\n", p.*.name, tagLine(p, index), shown)
    }
    endElementNs(p, p.*.name, prefix, tagURI(p, index))
    spacePop(p)
    if tagNsNr(p, index) != 0 { nsPop(p, tagNsNr(p, index)) }
}

// xmlParseCDSect.
fn parseCDSect(p: *Parser) -> void {
    if !CMP(p, "<![CDATA[") { return }
    SKIP(p, 9)
    p.*.instate = STATE_CDATA_SECTION
    var rl: usize = 0
    var sl: usize = 0
    var l: usize = 0
    var r = currentChar(p, &rl)
    if !text.isChar(r) {
        fatalErr(p, ERR_CDATA_NOT_FINISHED, 0)
        p.*.instate = STATE_CONTENT
        return
    }
    NEXTL(p, rl)
    var s = currentChar(p, &sl)
    if !text.isChar(s) {
        fatalErr(p, ERR_CDATA_NOT_FINISHED, 0)
        p.*.instate = STATE_CONTENT
        return
    }
    NEXTL(p, sl)
    var cur = currentChar(p, &l)
    var b: Buffer = undefined
    if !text.bufferInit(&b, p.*.allocator, 100) { return }
    while text.isChar(cur) && (r != 93 || s != 93 || cur != 62) {
        copyBuf(&b, rl, r)
        r = s
        rl = sl
        s = cur
        sl = l
        NEXTL(p, l)
        cur = currentChar(p, &l)
        if b.length > maxText(p) {
            fatalErrMsg(p, ERR_CDATA_NOT_FINISHED, "CData section too big found\n")
            text.bufferFree(&b)
            return
        }
    }
    p.*.instate = STATE_CONTENT
    if cur != 62 {
        fatalErrMsgStr(p, ERR_CDATA_NOT_FINISHED, "CData section not finished\n%.50s\n", b.address)
        text.bufferFree(&b)
        return
    }
    NEXTL(p, l)
    if p.*.disableSAX == 0 { cdataBlock(p, b.address, b.length) }
    text.bufferFree(&b)
}

// ---------------------------------------------------------------------------
// References in content (xmlParseReference) and an entity's content
// parsed by a parser of its own (xmlParseBalancedChunkMemoryInternal)

// A character reference in content.
noinline fn parseReferenceCharRef(p: *Parser) -> void {
    const hex = NXT(p, 2)
    const value = parseCharRef(p)
    if value == 0 { return }
    const at = p.*.scratch
    if p.*.charset != encoding.ENC_UTF8 {
        if value <= 0xFF {
            text.put8(at, value)
            text.put8(at + 1, 0)
            if p.*.disableSAX == 0 { characters(p, at, 1) }
        } else {
            var b: Buffer = undefined
            if text.bufferInit(&b, p.*.allocator, 16) {
                if hex == 120 || hex == 88 {
                    text.format(&b, "#x%X", value, 0, 0)
                } else {
                    text.format(&b, "#%d", value, 0, 0)
                }
                if p.*.disableSAX == 0 { reference(p, b.address) }
                text.bufferFree(&b)
            }
        }
    } else {
        const n = text.copyChar(at, value)
        text.put8(at + n, 0)
        if p.*.disableSAX == 0 { characters(p, at, n) }
    }
}

// An entity reference in content, to the parse of its content: 0 nothing
// more to do, 1 its content to parse (the first time), 2 the rest.
noinline fn referenceBegin(p: *Parser) -> i64 {
    const view = &p.*.refView
    if !parseEntityRef(p, view) { return 0 }
    if !p.*.wellFormed { return 0 }
    p.*.refWasChecked = checkedOf(view)
    if view.*.name == 0 || view.*.etype == INTERNAL_PREDEFINED_ENTITY {
        if view.*.content == 0 { return 0 }
        if p.*.disableSAX == 0 { characters(p, view.*.content, text.length(view.*.content)) }
        return 0
    }
    const checked = checkedOf(view)
    if (checked == 0 || (view.*.children == 0 && (p.*.options & PARSE_NOENT) != 0)) && (view.*.etype != EXTERNAL_GENERAL_PARSED_ENTITY || (p.*.options & (PARSE_NOENT | PARSE_DTDVALID)) != 0) {
        p.*.refOldNbent = p.*.nbentities
        p.*.refOldSizeentcopy = p.*.sizeentcopy
        p.*.sizeentcopy = 0
        return 1
    }
    if checked != 1 { p.*.nbentities += @intCast(u64, checked / 2) }
    return 2
}

// The content of the referenced entity parsed (SECOND: again, its
// checks done).
fn referenceExpand(p: *Parser, second: bool) -> i64 {
    const view = &p.*.refView
    if view.*.etype == INTERNAL_GENERAL_ENTITY {
        p.*.depth += 1
        const ret = parseBalancedChunk(p, view.*.content)
        p.*.depth -= 1
        return ret
    }
    if view.*.etype == EXTERNAL_GENERAL_PARSED_ENTITY {
        const oldsizeentities = p.*.sizeentities
        p.*.depth += 1
        const ret = parseExternalEntity(p, view)
        p.*.depth -= 1
        if second { p.*.sizeentities = oldsizeentities }
        return ret
    }
    errMsgStr(p, ERR_INTERNAL_ERROR, "invalid entity type found\n", 0)
    return ERR_ENTITY_PE_INTERNAL
}

// After the first parse of the entity's content: its counts kept, its
// errors reported; false when the parse goes no further.
noinline fn referenceExpanded(p: *Parser, ret: i64) -> bool {
    const view = &p.*.refView
    setExpanded(view, p.*.sizeentcopy)
    var diff = p.*.nbentities - p.*.refOldNbent + 1
    if diff > 1073741823 { diff = 1073741823 }
    var newChecked = @intCast(i64, diff * 2)
    if view.*.content != 0 && text.contains(view.*.content, 60) { newChecked = newChecked | 1 }
    setChecked(view, newChecked)
    if ret == ERR_ENTITY_LOOP {
        fatalErr(p, ERR_ENTITY_LOOP, 0)
        halt(p)
        return false
    }
    if entityCheck(p, p.*.refOldSizeentcopy) { return false }
    if ret != ERR_OK && ret != WAR_UNDECLARED_ENTITY {
        fatalErrMsgStr(p, ERR_UNDECLARED_ENTITY, "Entity '%s' failed to parse\n", view.*.name)
        if view.*.content != 0 { text.put8(view.*.content, 0) }
    }
    if checkedOf(view) == 0 { setChecked(view, 2) }
    p.*.refWasChecked = 0
    return true
}

// Whether the entity's content is parsed again (an entity parsed before,
// without a node list).
noinline fn referenceAgain(p: *Parser) -> bool { return p.*.refView.children == 0 && p.*.refWasChecked != 0 }

noinline fn referenceAgainDone(p: *Parser, ret: i64) -> bool {
    if ret == ERR_ENTITY_LOOP {
        fatalErr(p, ERR_ENTITY_LOOP, 0)
        return false
    }
    return !entityCheck(p, 0)
}

noinline fn referenceEnd(p: *Parser) -> void {
    const view = &p.*.refView
    if view.*.children != 0 && p.*.refWasChecked != 0 && entityCheck(p, expandedOf(view)) { return }
    if !p.*.replaceEntities && p.*.disableSAX == 0 { reference(p, view.*.name) }
}

// xmlParseReference. (Its steps are functions of their own, the state
// in the parser: the parse of an entity's content recurses here, and so
// little of the stack is taken by each entity in an entity.)
fn parseReference(p: *Parser) -> void {
    if RAW(p) != 38 { return }
    if NXT(p, 1) == 35 {
        parseReferenceCharRef(p)
        return
    }
    const step = referenceBegin(p)
    if step == 0 { return }
    if step == 1 {
        if !referenceExpanded(p, referenceExpand(p, false)) { return }
    }
    if referenceAgain(p) {
        if !referenceAgainDone(p, referenceExpand(p, true)) { return }
    }
    referenceEnd(p)
}

// An external parsed entity's content: never loaded here, as libxml2
// when its loader finds nothing (the warning goes where a parser of
// libxml2's defaults sends it, not to the handler).
fn parseExternalEntity(p: *Parser, view: *EntityView) -> i64 {
    if ((p.*.depth > 40) && (p.*.options & PARSE_HUGE) == 0) || p.*.depth > 1024 { return ERR_ENTITY_LOOP }
    if view.*.uri != 0 {
        raiseNoContext(p, FROM_IO, 1549, LEVEL_WARNING, "failed to load external entity \"%s\"\n", view.*.uri)
    }
    return WAR_UNDECLARED_ENTITY
}

// xmlParseBalancedChunkMemoryInternal: STRING parsed as content by a
// parser of its own sharing this one's dictionary, namespaces, attribute
// tables and handler; libxml2's error code.
// The parser of the content STRING of an entity, ready to parse; 0 when
// there is none (p.nestedCode says why).
noinline fn nestedStart(p: *Parser, string: usize) -> usize {
    if (p.*.depth > 40 && (p.*.options & PARSE_HUGE) == 0) || p.*.depth > 1024 || stackExhausted(p) {
        p.*.nestedCode = ERR_ENTITY_LOOP
        return 0
    }
    if string == 0 {
        p.*.nestedCode = ERR_INTERNAL_ERROR
        return 0
    }
    p.*.nestedCode = WAR_UNDECLARED_ENTITY
    const size = text.length(string)
    if size == 0 { return 0 }
    const address = createNested(p, string, size)
    if address == 0 { return 0 }
    const n = parserAt(address)
    var i: i64 = 0
    while i < p.*.nsNr {
        const ignored = nsPush(n, word(p.*.nsTab, i), word(p.*.nsTab, i + 1))
        i += 2
    }
    n.*.replaceEntities = p.*.replaceEntities
    n.*.options = p.*.options
    n.*.instate = STATE_CONTENT
    n.*.depth = p.*.depth + 1
    n.*.validate = false
    n.*.attsDefault = p.*.attsDefault
    n.*.attsSpecial = p.*.attsSpecial
    n.*.stackBase = p.*.stackBase
    if p.*.handler.nestedBegin != 0 {
        const call: NestedFn = unsafe { @ptrFromInt(NestedFn, p.*.handler.nestedBegin) }
        n.*.handler.user = call(p.*.handler.user, address)
    }
    return address
}

// After the parse of the nested parser at ADDRESS: its errors, counts,
// and the parser freed; libxml2's error code.
noinline fn nestedFinish(p: *Parser, address: usize) -> i64 {
    const n = parserAt(address)
    if RAW(n) == 60 && NXT(n, 1) == 47 {
        fatalErr(n, ERR_NOT_WELL_BALANCED, 0)
    } else if RAW(n) != 0 {
        fatalErr(n, ERR_EXTRA_CONTENT, 0)
    }
    var ret: i64 = ERR_OK
    if !n.*.wellFormed {
        ret = if n.*.errNo == 0 { ERR_INTERNAL_ERROR } else { n.*.errNo }
    }
    p.*.nbentities += n.*.nbentities
    if n.*.input != 0 {
        const consumed = inp(n).*.consumed + @intCast(u64, inp(n).*.cur - inp(n).*.base)
        p.*.sizeentcopy += consumed + n.*.sizeentcopy
    }
    if p.*.handler.nestedEnd != 0 { call1(p.*.handler.nestedEnd, p.*.handler.user, n.*.handler.user) }
    n.*.attsDefault = 0
    n.*.attsSpecial = 0
    free(address)
    return ret
}

// xmlParseBalancedChunkMemoryInternal: STRING parsed as content by a
// parser of its own sharing this one's dictionary, namespaces, attribute
// tables and handler; libxml2's error code.
fn parseBalancedChunk(p: *Parser, string: usize) -> i64 {
    const address = nestedStart(p, string)
    if address == 0 { return p.*.nestedCode }
    parseContent(parserAt(address))
    return nestedFinish(p, address)
}

// ---------------------------------------------------------------------------
// Content (the parse of an entity's or a fragment's content)

// xmlParseElementStart: 0 an element begun, 1 an empty one done, -1 on
// an error.
fn parseElementStart(p: *Parser) -> i64 {
    if p.*.nameNr > MAX_DEPTH && (p.*.options & PARSE_HUGE) == 0 {
        fatalErrMsgInt(p, ERR_INTERNAL_ERROR, "Excessive depth in document: %d use XML_PARSE_HUGE option\n", MAX_DEPTH)
        halt(p)
        return -1
    }
    if p.*.spaceNr == 0 {
        spacePush(p, -1)
    } else if space(p) == -2 {
        spacePush(p, -1)
    } else {
        spacePush(p, space(p))
    }
    const line = inp(p).*.line
    const nsNr = p.*.nsNr
    var prefix: usize = 0
    var uriValue: usize = 0
    const name = parseStartTag2(p, &prefix, &uriValue)
    if p.*.instate == STATE_EOF { return -1 }
    if name == 0 {
        spacePop(p)
        return -1
    }
    nameNsPush(p, name, prefix, uriValue, line, p.*.nsNr - nsNr)
    if RAW(p) == 47 && NXT(p, 1) == 62 {
        SKIP(p, 2)
        endElementNs(p, name, prefix, uriValue)
        namePop(p)
        spacePop(p)
        if nsNr != p.*.nsNr { nsPop(p, p.*.nsNr - nsNr) }
        return 1
    }
    if RAW(p) == 62 {
        NEXT1(p)
    } else {
        fatalErrMsgStrIntStr(p, ERR_GT_REQUIRED, "Couldn't find end of Start Tag %s line %d\n", name, line, 0)
        namePop(p)
        spacePop(p)
        if nsNr != p.*.nsNr { nsPop(p, p.*.nsNr - nsNr) }
        return -1
    }
    return 0
}

// xmlParseElementEnd.
fn parseElementEnd(p: *Parser) -> void {
    if p.*.nameNr <= 0 { return }
    parseEndTag2(p, p.*.nameNr - 1)
    namePop(p)
}

// What the content goes on with: 0 its end (or an end tag of an
// element it did not open, NAMENR deep), 1 a processing instruction, 2 a
// CDATA section, 3 a comment, 4 an end tag, 5 a start tag, 6 a
// reference, 7 text.
noinline fn contentKind(p: *Parser, nameNr: i64) -> i64 {
    const c = RAW(p)
    if c == 0 || p.*.instate == STATE_EOF { return 0 }
    if c == 60 && NXT(p, 1) == 63 { return 1 }
    if CMP(p, "<![CDATA[") { return 2 }
    if c == 60 && NXT(p, 1) == 33 && NXT(p, 2) == 45 && NXT(p, 3) == 45 { return 3 }
    if c == 60 {
        if NXT(p, 1) == 47 {
            if p.*.nameNr <= nameNr { return 0 }
            return 4
        }
        return 5
    }
    if c == 38 { return 6 }
    return 7
}

noinline fn contentOther(p: *Parser, kind: i64) -> void {
    if kind == 1 {
        parsePI(p)
    } else if kind == 2 {
        parseCDSect(p)
    } else if kind == 3 {
        parseComment(p)
        p.*.instate = STATE_CONTENT
    } else if kind == 4 {
        parseElementEnd(p)
    } else if kind == 5 {
        const ignored = parseElementStart(p)
    } else {
        parseCharData(p, false)
    }
}

noinline fn contentMark(p: *Parser) -> void {
    p.*.stepCur = CUR_PTR(p)
    p.*.stepConsumed = inp(p).*.consumed
}

// Whether the step moved on (else libxml2's internal error, and the
// parse halted).
noinline fn contentMoved(p: *Parser) -> bool {
    if p.*.stepConsumed == inp(p).*.consumed && p.*.stepCur == CUR_PTR(p) {
        fatalErrInfo(p, ERR_INTERNAL_ERROR, "detected an error in element content\n")
        halt(p)
        return false
    }
    return true
}

fn contentStep(p: *Parser, nameNr: i64) -> bool {
    const kind = contentKind(p, nameNr)
    if kind == 0 { return false }
    contentMark(p)
    if kind == 6 {
        parseReference(p)
    } else {
        contentOther(p, kind)
    }
    return contentMoved(p)
}

// xmlParseContentInternal. (A step at a time: the parse of an entity's
// content recurses here.)
fn parseContentInternal(p: *Parser) -> void {
    const nameNr = p.*.nameNr
    while contentStep(p, nameNr) {}
}

noinline fn contentNotFinished(p: *Parser) -> void {
    const name = word(p.*.nameTab, p.*.nameNr - 1)
    const line = tagLine(p, p.*.nameNr - 1)
    fatalErrMsgStrIntStr(p, ERR_TAG_NOT_FINISHED, "Premature end of data in tag %s line %d\n", name, line, 0)
}

// xmlParseContent: content up to its end or an end tag it did not open.
pub fn parseContent(p: *Parser) -> void {
    const root = p.*.stackBase == 0
    if root { p.*.stackBase = @frameAddress() }
    const nameNr = p.*.nameNr
    parseContentInternal(p)
    if p.*.instate != STATE_EOF && p.*.nameNr > nameNr { contentNotFinished(p) }
    if root { p.*.stackBase = 0 }
}

// ---------------------------------------------------------------------------
// The XML declaration

// xmlParseVersionNum: a copy, 0 for none.
fn parseVersionNum(p: *Parser) -> usize {
    var cur = RAW(p)
    if !(cur >= 48 && cur <= 57) { return 0 }
    var b: Buffer = undefined
    if !text.bufferInit(&b, p.*.allocator, 16) { return 0 }
    text.bufferAddByte(&b, cur)
    nextChar(p)
    cur = RAW(p)
    if cur != 46 {
        text.bufferFree(&b)
        return 0
    }
    text.bufferAddByte(&b, cur)
    nextChar(p)
    cur = RAW(p)
    while cur >= 48 && cur <= 57 {
        text.bufferAddByte(&b, cur)
        nextChar(p)
        cur = RAW(p)
    }
    const result = text.bufferTake(&b)
    text.bufferFree(&b)
    return result
}

// xmlParseVersionInfo.
fn parseVersionInfo(p: *Parser) -> usize {
    var version: usize = 0
    if CMP(p, "version") {
        SKIP(p, 7)
        var ignored = skipBlanks(p)
        if RAW(p) != 61 {
            fatalErr(p, ERR_EQUAL_REQUIRED, 0)
            return 0
        }
        nextChar(p)
        ignored = skipBlanks(p)
        if RAW(p) == 34 || RAW(p) == 39 {
            const quote = RAW(p)
            nextChar(p)
            version = parseVersionNum(p)
            if RAW(p) != quote {
                fatalErr(p, ERR_STRING_NOT_CLOSED, 0)
            } else {
                nextChar(p)
            }
        } else {
            fatalErr(p, ERR_STRING_NOT_STARTED, 0)
        }
    }
    return version
}

// xmlParseEncName: a copy, 0 for none.
fn parseEncName(p: *Parser) -> usize {
    var cur = RAW(p)
    if (cur >= 97 && cur <= 122) || (cur >= 65 && cur <= 90) {
        var b: Buffer = undefined
        if !text.bufferInit(&b, p.*.allocator, 16) { return 0 }
        text.bufferAddByte(&b, cur)
        nextChar(p)
        cur = RAW(p)
        while (cur >= 97 && cur <= 122) || (cur >= 65 && cur <= 90) || (cur >= 48 && cur <= 57) || cur == 46 || cur == 95 || cur == 45 {
            text.bufferAddByte(&b, cur)
            nextChar(p)
            cur = RAW(p)
        }
        const result = text.bufferTake(&b)
        text.bufferFree(&b)
        return result
    }
    fatalErr(p, ERR_ENCODING_NAME, 0)
    return 0
}

// xmlParseEncodingDecl: the declared encoding (kept by the parser), the
// decoder switched to it where libxml2 switches.
fn parseEncodingDecl(p: *Parser) -> usize {
    var ignored = skipBlanks(p)
    if !CMP(p, "encoding") { return 0 }
    SKIP(p, 8)
    ignored = skipBlanks(p)
    if RAW(p) != 61 {
        fatalErr(p, ERR_EQUAL_REQUIRED, 0)
        return 0
    }
    nextChar(p)
    ignored = skipBlanks(p)
    var name: usize = 0
    if RAW(p) == 34 || RAW(p) == 39 {
        const quote = RAW(p)
        nextChar(p)
        name = parseEncName(p)
        if RAW(p) != quote {
            fatalErr(p, ERR_STRING_NOT_CLOSED, 0)
            dealloc(p, name)
            return 0
        }
        nextChar(p)
    } else {
        fatalErr(p, ERR_STRING_NOT_STARTED, 0)
    }
    if (p.*.options & PARSE_IGNORE_ENC) != 0 {
        dealloc(p, name)
        return 0
    }
    if name != 0 && (text.equalTextNoCase(name, "UTF-16") || text.equalTextNoCase(name, "UTF16")) {
        if p.*.encodingName == 0 && inp(p).*.document && !p.*.hasEncoder {
            fatalErrMsg(p, ERR_INVALID_ENCODING, "Document labelled UTF-16 but has UTF-8 content\n")
        }
        dealloc(p, p.*.encodingName)
        p.*.encodingName = name
    } else if name != 0 && (text.equalTextNoCase(name, "UTF-8") || text.equalTextNoCase(name, "UTF8")) {
        dealloc(p, p.*.encodingName)
        p.*.encodingName = name
    } else if name != 0 {
        dealloc(p, inp(p).*.encoding)
        inp(p).*.encoding = name
        var h: encoding.Handler = undefined
        if encoding.handlerForName(name, &h) {
            if switchToEncoding(p, h, -1) < 0 {
                p.*.errNo = ERR_UNSUPPORTED_ENCODING
                return 0
            }
        } else {
            fatalErrMsgStr(p, ERR_UNSUPPORTED_ENCODING, "Unsupported encoding %s\n", name)
            return 0
        }
    }
    return name
}

// xmlParseSDDecl.
fn parseSDDecl(p: *Parser) -> i64 {
    var standalone: i64 = -2
    var ignored = skipBlanks(p)
    if CMP(p, "standalone") {
        SKIP(p, 10)
        ignored = skipBlanks(p)
        if RAW(p) != 61 {
            fatalErr(p, ERR_EQUAL_REQUIRED, 0)
            return standalone
        }
        nextChar(p)
        ignored = skipBlanks(p)
        if RAW(p) == 39 || RAW(p) == 34 {
            const quote = RAW(p)
            nextChar(p)
            if RAW(p) == 110 && NXT(p, 1) == 111 {
                standalone = 0
                SKIP(p, 2)
            } else if RAW(p) == 121 && NXT(p, 1) == 101 && NXT(p, 2) == 115 {
                standalone = 1
                SKIP(p, 3)
            } else {
                fatalErr(p, ERR_STANDALONE_VALUE, 0)
            }
            if RAW(p) != quote {
                fatalErr(p, ERR_STRING_NOT_CLOSED, 0)
            } else {
                nextChar(p)
            }
        } else {
            fatalErr(p, ERR_STRING_NOT_STARTED, 0)
        }
    }
    return standalone
}

// xmlParseXMLDecl.
fn parseXMLDecl(p: *Parser) -> void {
    inp(p).*.standalone = -2
    SKIP(p, 5)
    if !text.isBlank(RAW(p)) { fatalErrMsg(p, ERR_SPACE_REQUIRED, "Blank needed after '<?xml'\n") }
    var ignored = skipBlanks(p)
    const version = parseVersionInfo(p)
    if version == 0 {
        fatalErr(p, ERR_VERSION_MISSING, 0)
    } else {
        if !text.equalText(version, "1.0") {
            if text.get8(version) == 49 && text.get8(version + 1) == 46 {
                warningMsg(p, WAR_UNKNOWN_VERSION, "Unsupported version '%s'\n", version, 0)
            } else {
                fatalErrMsgStr(p, ERR_UNKNOWN_VERSION, "Unsupported version '%s'\n", version)
            }
        }
        dealloc(p, p.*.version)
        p.*.version = version
    }
    if !text.isBlank(RAW(p)) {
        if RAW(p) == 63 && NXT(p, 1) == 62 {
            SKIP(p, 2)
            return
        }
        fatalErrMsg(p, ERR_SPACE_REQUIRED, "Blank needed here\n")
    }
    const ignoredName = parseEncodingDecl(p)
    if p.*.errNo == ERR_UNSUPPORTED_ENCODING || p.*.instate == STATE_EOF { return }
    if inp(p).*.encoding != 0 && !text.isBlank(RAW(p)) {
        if RAW(p) == 63 && NXT(p, 1) == 62 {
            SKIP(p, 2)
            return
        }
        fatalErrMsg(p, ERR_SPACE_REQUIRED, "Blank needed here\n")
    }
    ignored = skipBlanks(p)
    inp(p).*.standalone = parseSDDecl(p)
    ignored = skipBlanks(p)
    if RAW(p) == 63 && NXT(p, 1) == 62 {
        SKIP(p, 2)
    } else if RAW(p) == 62 {
        fatalErr(p, ERR_XMLDECL_NOT_FINISHED, 0)
        nextChar(p)
    } else {
        fatalErr(p, ERR_XMLDECL_NOT_FINISHED, 0)
        // MOVETO_ENDTAG: to the next '>' (the column not counted).
        var at = CUR_PTR(p)
        while text.get8(at) != 0 && text.get8(at) != 62 { at += 1 }
        inp(p).*.cur = at
        nextChar(p)
    }
}

// ---------------------------------------------------------------------------
// The document's bytes (libxml2's xmlParserInputBuffer): pushed raw,
// decoded onto the buffer the document's input reads.

// The document input's pointers set again after the buffer moved
// (xmlBufSetInputBaseCur).
fn resetDocumentInput(p: *Parser) -> void {
    if p.*.halted || p.*.inputNr == 0 { return }
    const i = inputAt(word(p.*.inputs, 0))
    const offset = i.*.cur - i.*.base
    i.*.base = p.*.content.address
    i.*.cur = i.*.base + offset
    i.*.end = i.*.base + p.*.content.length
    i.*.length = @intCast(i64, p.*.content.length)
}

// The four bytes of a decoding error, as libxml2 shows them.
fn conversionFailed(p: *Parser, at: usize) -> void {
    var b: Buffer = undefined
    if !text.bufferInit(&b, p.*.allocator, 64) { return }
    text.format(&b, "0x%02X 0x%02X 0x%02X ", text.get8(at), text.get8(at + 1), text.get8(at + 2))
    text.format(&b, "0x%02X", text.get8(at + 3), 0, 0)
    raiseNoContext(p, FROM_I18N, I18N_CONV_FAILED, LEVEL_FATAL, "input conversion failed due to input error, bytes %s\n", b.address)
    text.bufferFree(&b)
}

// xmlCharEncInput and xmlCharEncFirstLineInput: the raw bytes decoded
// (at most LIMIT of them, unless LIMIT is 0); the bytes made, -2 when
// none could be.
fn decodeRaw(p: *Parser, limit: usize) -> i64 {
    var toconv = p.*.raw.length
    if toconv == 0 { return 0 }
    if limit != 0 && toconv > limit { toconv = limit }
    const before = p.*.content.length
    const r = encoding.decode(p.*.encoder, p.*.raw.address, toconv, &p.*.content)
    text.bufferShrink(&p.*.raw, r.used)
    const written = p.*.content.length - before
    if r.status == -2 {
        conversionFailed(p, p.*.raw.address)
        if written > 0 { return @intCast(i64, written) }
        return -2
    }
    return @intCast(i64, written)
}

// xmlParserInputBufferPush.
fn bufferPush(p: *Parser, chunk: usize, size: usize) -> i64 {
    if p.*.ioError != 0 { return -1 }
    var nbchars: i64 = 0
    if p.*.hasEncoder {
        text.bufferAdd(&p.*.raw, chunk, size)
        const used = p.*.raw.length
        nbchars = decodeRaw(p, 0)
        if nbchars < 0 {
            raiseNoContext(p, FROM_IO, IO_ENCODER, LEVEL_ERROR, "encoder error", 0)
            p.*.ioError = IO_ENCODER
            resetDocumentInput(p)
            return -1
        }
        p.*.rawConsumed += @intCast(u64, used - p.*.raw.length)
    } else {
        text.bufferAdd(&p.*.content, chunk, size)
        nbchars = @intCast(i64, size)
    }
    resetDocumentInput(p)
    return nbchars
}

// xmlSwitchInputEncodingInt for the document's input: the bytes not
// yet parsed become raw bytes of the new encoding, of which the first
// line (LEN bytes, or 180) is decoded at once.
fn switchInputEncoding(p: *Parser, h: encoding.Handler, len: i64) -> i64 {
    const i = inp(p)
    // (A halted parser's document has no buffer left, nor bytes.)
    if !i.*.document || p.*.halted {
        if i.*.length == 0 {
            errInternal(p, "switching encoding : no input\n", 0)
            return -1
        }
        return 0
    }
    if p.*.hasEncoder {
        if encoding.sameHandler(p.*.encoder, h) { return 0 }
        p.*.encoder = h
        return 0
    }
    p.*.hasEncoder = true
    p.*.encoder = h
    if p.*.content.length > 0 && !p.*.halted {
        if encoding.isUTF16LEName(h) && text.get8(i.*.cur) == 0xFF && text.get8(i.*.cur + 1) == 0xFE { i.*.cur += 2 }
        if encoding.isUTF16BEName(h) && text.get8(i.*.cur) == 0xFE && text.get8(i.*.cur + 1) == 0xFF { i.*.cur += 2 }
        if encoding.isUTF8Name(h) && text.get8(i.*.cur) == 0xEF && text.get8(i.*.cur + 1) == 0xBB && text.get8(i.*.cur + 2) == 0xBF { i.*.cur += 3 }
        const processed = i.*.cur - i.*.base
        text.bufferShrink(&p.*.content, processed)
        p.*.raw.length = 0
        text.bufferAdd(&p.*.raw, p.*.content.address, p.*.content.length)
        p.*.content.length = 0
        text.put8(p.*.content.address, 0)
        p.*.rawConsumed = @intCast(u64, processed)
        const used = p.*.raw.length
        const nbchars = decodeRaw(p, if len >= 0 { @intCast(usize, len) } else { 180 })
        i.*.base = p.*.content.address
        i.*.cur = i.*.base
        i.*.end = i.*.base + p.*.content.length
        if nbchars < 0 {
            errInternal(p, "switching encoding: encoder error\n", 0)
            return -1
        }
        p.*.rawConsumed += @intCast(u64, used - p.*.raw.length)
    }
    return 0
}

// xmlSwitchToEncodingInt.
fn switchToEncoding(p: *Parser, h: encoding.Handler, len: i64) -> i64 {
    if p.*.input == 0 {
        errInternal(p, "xmlSwitchToEncoding : no input\n", 0)
        return -1
    }
    const ret = switchInputEncoding(p, h, len)
    p.*.charset = encoding.ENC_UTF8
    return ret
}

// xmlSwitchEncoding: the document's encoding from now on.
pub fn switchEncoding(p: *Parser, enc: i64) -> i64 {
    var len: i64 = -1
    if enc == encoding.ENC_ERROR {
        errEncoding(p, ERR_UNKNOWN_ENCODING, "encoding unknown\n", 0, 0)
        return -1
    }
    if enc == encoding.ENC_NONE {
        p.*.charset = encoding.ENC_UTF8
        return 0
    }
    if enc == encoding.ENC_UTF8 {
        p.*.charset = encoding.ENC_UTF8
        if p.*.input != 0 && RAW(p) == 0xEF && NXT(p, 1) == 0xBB && NXT(p, 2) == 0xBF { inp(p).*.cur += 3 }
        return 0
    }
    if enc == encoding.ENC_UTF16LE || enc == encoding.ENC_UTF16BE {
        if p.*.input != 0 && RAW(p) == 0xEF && NXT(p, 1) == 0xBB && NXT(p, 2) == 0xBF { inp(p).*.cur += 3 }
        len = 90
    } else if enc == encoding.ENC_UCS2 {
        len = 90
    } else if enc == encoding.ENC_UCS4BE || enc == encoding.ENC_UCS4LE || enc == encoding.ENC_UCS4_2143 || enc == encoding.ENC_UCS4_3412 {
        len = 180
    } else {
        len = 45
    }
    var h: encoding.Handler = undefined
    if !encoding.handlerForEncoding(enc, &h) {
        if enc == encoding.ENC_ASCII {
            p.*.charset = encoding.ENC_UTF8
            return 0
        }
        var what: []const u8 = ""
        if enc == encoding.ENC_EBCDIC {
            what = "EBCDIC"
        } else if enc == encoding.ENC_UCS4_2143 {
            what = "UCS4 2143"
        } else if enc == encoding.ENC_UCS4_3412 {
            what = "UCS4 3412"
        } else if enc == encoding.ENC_UCS2 {
            what = "UCS2"
        } else if enc == encoding.ENC_2022_JP {
            what = "ISO-2022-JP"
        } else if enc == encoding.ENC_SHIFT_JIS {
            what = "Shift_JIS"
        } else if enc == encoding.ENC_EUC_JP {
            what = "EUC-JP"
        } else if enc >= encoding.ENC_8859_1 && enc <= encoding.ENC_8859_9 {
            if p.*.inputNr == 1 && p.*.encodingName == 0 && p.*.input != 0 && inp(p).*.encoding != 0 {
                p.*.encodingName = text.duplicateString(p.*.allocator, inp(p).*.encoding)
            }
            p.*.charset = enc
            return 0
        }
        if what.length > 0 {
            const s = text.duplicateText(p.*.allocator, what)
            errEncoding(p, ERR_UNSUPPORTED_ENCODING, "encoding not supported %s\n", s, 0)
            dealloc(p, s)
        }
        stop(p)
        return -1
    }
    p.*.charset = encoding.ENC_UTF8
    const ret = switchToEncoding(p, h, len)
    if ret < 0 || p.*.errNo == I18N_CONV_FAILED {
        stop(p)
        p.*.errNo = I18N_CONV_FAILED
    }
    return ret
}

// xmlByteConsumed: the bytes of the document parsed so far (in its
// encoding), -1 when there is no telling.
pub fn byteConsumed(p: *Parser) -> i64 {
    if p.*.input == 0 { return -1 }
    const i = inp(p)
    // (A halted parser has no decoder: libxml2 frees the input's buffer.)
    if i.*.document && p.*.hasEncoder && !p.*.halted {
        // The bytes not parsed yet, encoded back.
        var unused: u64 = 0
        var at = i.*.cur
        const kind = p.*.encoder.kind
        while at < i.*.end {
            const c = text.get8(at)
            var n: usize = 1
            var cp = c
            if c >= 0xF0 {
                n = 4
                cp = 0x10000
            } else if c >= 0xE0 {
                n = 3
            } else if c >= 0xC0 {
                n = 2
            }
            if kind == encoding.KIND_UTF16LE || kind == encoding.KIND_UTF16BE || kind == encoding.KIND_UTF16 {
                unused += if cp >= 0x10000 { 4 } else { 2 }
            } else if kind == encoding.KIND_UCS4BE || kind == encoding.KIND_UCS4LE {
                unused += 4
            } else if kind == encoding.KIND_UTF8 {
                unused += @intCast(u64, n)
            } else {
                unused += 1
            }
            at += n
        }
        return @intCast(i64, p.*.rawConsumed + @intCast(u64, p.*.raw.length)) - @intCast(i64, unused) - @intCast(i64, p.*.raw.length)
    }
    return @intCast(i64, i.*.consumed + @intCast(u64, i.*.cur - i.*.base))
}

// ---------------------------------------------------------------------------
// The push parser (xmlParseTryOrFinish, xmlParseChunk)

// xmlParseLookupSequence: the offset from the cursor of FIRST (NEXT,
// THIRD after it when not 0), -1 when it is not there yet (the place
// searched to kept in checkIndex).
fn lookupSequence(p: *Parser, first: u64, next: u64, third: u64) -> i64 {
    const i = inp(p)
    var base = @intCast(i64, i.*.cur - i.*.base)
    if base < 0 { return -1 }
    if p.*.checkIndex > base { base = p.*.checkIndex }
    const buf = i.*.base
    var len = @intCast(i64, i.*.end - i.*.base)
    if third != 0 {
        len -= 2
    } else if next != 0 {
        len -= 1
    }
    while base < len {
        const at = buf + @intCast(usize, base)
        if text.get8(at) == first {
            var ok = true
            if third != 0 {
                if text.get8(at + 1) != next || text.get8(at + 2) != third { ok = false }
            } else if next != 0 {
                if text.get8(at + 1) != next { ok = false }
            }
            if ok {
                p.*.checkIndex = 0
                return base - @intCast(i64, i.*.cur - i.*.base)
            }
        }
        base += 1
    }
    p.*.checkIndex = base
    return -1
}

// xmlParseGetLasts: the last '<' of the buffer and the last '>' closing
// a tag (quotes skipped), 0 for none.
fn getLasts(p: *Parser, lastlt: *usize, lastgt: *usize) -> void {
    lastlt.* = 0
    lastgt.* = 0
    if p.*.progressive == 0 || p.*.inputNr != 1 { return }
    const i = inp(p)
    if i.*.end == i.*.base { return }
    var tmp = i.*.end - 1
    while tmp > i.*.base && text.get8(tmp) != 60 { tmp -= 1 }
    if text.get8(tmp) != 60 { return }
    lastlt.* = tmp
    tmp += 1
    while tmp < i.*.end && text.get8(tmp) != 62 {
        if text.get8(tmp) == 39 {
            tmp += 1
            while tmp < i.*.end && text.get8(tmp) != 39 { tmp += 1 }
            if tmp < i.*.end { tmp += 1 }
        } else if text.get8(tmp) == 34 {
            tmp += 1
            while tmp < i.*.end && text.get8(tmp) != 34 { tmp += 1 }
            if tmp < i.*.end { tmp += 1 }
        } else {
            tmp += 1
        }
    }
    if tmp < i.*.end {
        lastgt.* = tmp
    } else {
        tmp = lastlt.*
        var found = false
        while tmp > i.*.base {
            tmp -= 1
            if text.get8(tmp) == 62 {
                found = true
                break
            }
        }
        if found { lastgt.* = tmp }
    }
}

// xmlCheckCdataPush: how many of the LEN bytes at UTF are whole
// characters of XML (a negative count: the bytes before a wrong one).
fn checkCdataPush(utf: usize, len: i64, complete: bool) -> i64 {
    var ix: i64 = 0
    while ix < len {
        const at = utf + @intCast(usize, ix)
        const c = text.get8(at)
        if (c & 0x80) == 0 {
            if c >= 0x20 || c == 0xA || c == 0xD || c == 0x9 {
                ix += 1
            } else {
                return -ix
            }
        } else if (c & 0xE0) == 0xC0 {
            if ix + 2 > len { return if complete { -ix } else { ix } }
            if (text.get8(at + 1) & 0xC0) != 0x80 { return -ix }
            const cp = ((c & 0x1F) << 6) | (text.get8(at + 1) & 0x3F)
            if !text.isChar(cp) { return -ix }
            ix += 2
        } else if (c & 0xF0) == 0xE0 {
            if ix + 3 > len { return if complete { -ix } else { ix } }
            if (text.get8(at + 1) & 0xC0) != 0x80 || (text.get8(at + 2) & 0xC0) != 0x80 { return -ix }
            const cp = ((c & 0xF) << 12) | ((text.get8(at + 1) & 0x3F) << 6) | (text.get8(at + 2) & 0x3F)
            if !text.isChar(cp) { return -ix }
            ix += 3
        } else if (c & 0xF8) == 0xF0 {
            if ix + 4 > len { return if complete { -ix } else { ix } }
            if (text.get8(at + 1) & 0xC0) != 0x80 || (text.get8(at + 2) & 0xC0) != 0x80 || (text.get8(at + 3) & 0xC0) != 0x80 { return -ix }
            const cp = ((c & 0x7) << 18) | ((text.get8(at + 1) & 0x3F) << 12) | ((text.get8(at + 2) & 0x3F) << 6) | (text.get8(at + 3) & 0x3F)
            if !text.isChar(cp) { return -ix }
            ix += 4
        } else {
            return -ix
        }
    }
    return ix
}

// xmlSHRINK in the push parser: what was parsed dropped from the
// buffer, but the last line's worth.
fn shrinkDocument(p: *Parser) -> void {
    if p.*.halted || p.*.input == 0 || !inp(p).*.document { return }
    const i = inp(p)
    const used = i.*.cur - p.*.content.address
    if used > 250 {
        const n = used - 80
        text.bufferShrink(&p.*.content, n)
        i.*.consumed += @intCast(u64, n)
        i.*.base = p.*.content.address
        i.*.cur = i.*.cur - n
        i.*.end = i.*.base + p.*.content.length
    }
}

fn startDocument(p: *Parser) -> void {
    if p.*.handler.startDocument != 0 && p.*.disableSAX == 0 { call0(p.*.handler.startDocument, user(p)) }
}

fn endDocument(p: *Parser) -> void {
    if p.*.handler.endDocument != 0 { call0(p.*.handler.endDocument, user(p)) }
}

fn setDocumentLocator(p: *Parser) -> void {
    if p.*.handler.setDocumentLocator != 0 { call0(p.*.handler.setDocumentLocator, user(p)) }
}

fn defaultVersion(p: *Parser) -> void {
    dealloc(p, p.*.version)
    p.*.version = text.duplicateText(p.*.allocator, "1.0")
}

fn tryOrFinish(p: *Parser, terminate: bool) -> void {
    if p.*.input == 0 { return }
    if inp(p).*.cur - inp(p).*.base > 4096 {
        shrinkDocument(p)
        p.*.checkIndex = 0
    }
    var lastlt: usize = 0
    var lastgt: usize = 0
    getLasts(p, &lastlt, &lastgt)
    while p.*.instate != STATE_EOF {
        if p.*.errNo != ERR_OK && p.*.disableSAX == 1 { return }
        if p.*.input == 0 { break }
        if p.*.instate != STATE_START && p.*.hasEncoder && p.*.raw.length > 0 && inp(p).*.document {
            const ignored = bufferPush(p, 0, 0)
        }
        var avail = @intCast(i64, inp(p).*.end - inp(p).*.cur)
        if avail < 1 { return }
        const state = p.*.instate
        if state == STATE_START {
            if p.*.charset == encoding.ENC_NONE {
                if avail < 4 { return }
                const enc = encoding.detect(CUR_PTR(p), 4)
                const ignored = switchEncoding(p, enc)
                continue
            }
            if avail < 2 { return }
            const cur = RAW(p)
            const next = NXT(p, 1)
            if cur == 0 {
                setDocumentLocator(p)
                fatalErr(p, ERR_DOCUMENT_EMPTY, 0)
                halt(p)
                endDocument(p)
                return
            }
            if cur == 60 && next == 63 {
                if avail < 5 { return }
                if !terminate && lookupSequence(p, 63, 62, 0) < 0 { return }
                setDocumentLocator(p)
                if NXT(p, 2) == 120 && NXT(p, 3) == 109 && NXT(p, 4) == 108 && text.isBlank(NXT(p, 5)) {
                    parseXMLDecl(p)
                    if p.*.errNo == ERR_UNSUPPORTED_ENCODING {
                        halt(p)
                        return
                    }
                    p.*.standalone = inp(p).*.standalone
                    if p.*.encodingName == 0 && inp(p).*.encoding != 0 {
                        p.*.encodingName = text.duplicateString(p.*.allocator, inp(p).*.encoding)
                    }
                    startDocument(p)
                    p.*.instate = STATE_MISC
                } else {
                    defaultVersion(p)
                    startDocument(p)
                    p.*.instate = STATE_MISC
                }
            } else {
                setDocumentLocator(p)
                defaultVersion(p)
                startDocument(p)
                p.*.instate = STATE_MISC
            }
        } else if state == STATE_START_TAG {
            const line = inp(p).*.line
            const nsNr = p.*.nsNr
            if avail < 2 && p.*.inputNr == 1 { return }
            if RAW(p) != 60 {
                fatalErr(p, ERR_DOCUMENT_EMPTY, 0)
                halt(p)
                endDocument(p)
                return
            }
            if !terminate {
                if p.*.progressive != 0 {
                    if lastgt == 0 || CUR_PTR(p) >= lastgt { return }
                } else if lookupSequence(p, 62, 0, 0) < 0 {
                    return
                }
            }
            if p.*.spaceNr == 0 {
                spacePush(p, -1)
            } else if space(p) == -2 {
                spacePush(p, -1)
            } else {
                spacePush(p, space(p))
            }
            var prefix: usize = 0
            var uriValue: usize = 0
            const name = parseStartTag2(p, &prefix, &uriValue)
            if p.*.instate == STATE_EOF { return }
            if name == 0 {
                spacePop(p)
                halt(p)
                endDocument(p)
                return
            }
            if RAW(p) == 47 && NXT(p, 1) == 62 {
                SKIP(p, 2)
                endElementNs(p, name, prefix, uriValue)
                if p.*.nsNr - nsNr > 0 { nsPop(p, p.*.nsNr - nsNr) }
                if p.*.instate == STATE_EOF { return }
                spacePop(p)
                if p.*.nameNr == 0 {
                    p.*.instate = STATE_EPILOG
                } else {
                    p.*.instate = STATE_CONTENT
                }
                p.*.progressive = 1
                continue
            }
            if RAW(p) == 62 {
                nextChar(p)
            } else {
                fatalErrMsgStr(p, ERR_GT_REQUIRED, "Couldn't find end of Start Tag %s\n", name)
                spacePop(p)
            }
            nameNsPush(p, name, prefix, uriValue, line, p.*.nsNr - nsNr)
            p.*.instate = STATE_CONTENT
            p.*.progressive = 1
        } else if state == STATE_CONTENT {
            if avail < 2 && p.*.inputNr == 1 { return }
            const cur = RAW(p)
            const next = NXT(p, 1)
            const before = CUR_PTR(p)
            const cons = inp(p).*.consumed
            if cur == 60 && next == 47 {
                p.*.instate = STATE_END_TAG
                continue
            } else if cur == 60 && next == 63 {
                if !terminate && lookupSequence(p, 63, 62, 0) < 0 {
                    p.*.progressive = STATE_PI
                    return
                }
                parsePI(p)
                p.*.instate = STATE_CONTENT
                p.*.progressive = 1
            } else if cur == 60 && next != 33 {
                p.*.instate = STATE_START_TAG
                continue
            } else if cur == 60 && next == 33 && NXT(p, 2) == 45 && NXT(p, 3) == 45 {
                if avail < 4 { return }
                inp(p).*.cur += 4
                const term = lookupSequence(p, 45, 45, 62)
                inp(p).*.cur -= 4
                if !terminate && term < 0 {
                    p.*.progressive = STATE_COMMENT
                    return
                }
                parseComment(p)
                p.*.instate = STATE_CONTENT
                p.*.progressive = 1
            } else if cur == 60 && CMP(p, "<![CDATA[") {
                SKIP(p, 9)
                p.*.instate = STATE_CDATA_SECTION
                continue
            } else if cur == 60 && next == 33 && avail < 9 {
                return
            } else if cur == 38 {
                if !terminate && lookupSequence(p, 59, 0, 0) < 0 { return }
                parseReference(p)
            } else {
                if p.*.inputNr == 1 && avail < @intCast(i64, BIG_BUFFER_SIZE) {
                    if !terminate {
                        if p.*.progressive != 0 {
                            if lastlt == 0 || CUR_PTR(p) > lastlt { return }
                        } else if lookupSequence(p, 60, 0, 0) < 0 {
                            return
                        }
                    }
                }
                p.*.checkIndex = 0
                parseCharData(p, false)
            }
            if cons == inp(p).*.consumed && before == CUR_PTR(p) {
                fatalErrInfo(p, ERR_INTERNAL_ERROR, "detected an error in element content\n")
                halt(p)
            }
        } else if state == STATE_END_TAG {
            if avail < 2 { return }
            if !terminate {
                if p.*.progressive != 0 {
                    if lastgt == 0 || CUR_PTR(p) >= lastgt { return }
                } else if lookupSequence(p, 62, 0, 0) < 0 {
                    return
                }
            }
            if p.*.nameNr > 0 {
                parseEndTag2(p, p.*.nameNr - 1)
                namePop(p)
            }
            if p.*.instate == STATE_EOF {
                // (nothing)
            } else if p.*.nameNr == 0 {
                p.*.instate = STATE_EPILOG
            } else {
                p.*.instate = STATE_CONTENT
            }
        } else if state == STATE_CDATA_SECTION {
            const base = lookupSequence(p, 93, 93, 62)
            if base < 0 {
                if avail >= @intCast(i64, BIG_BUFFER_SIZE) + 2 {
                    var tmp = checkCdataPush(CUR_PTR(p), @intCast(i64, BIG_BUFFER_SIZE), false)
                    if tmp < 0 {
                        tmp = -tmp
                        inp(p).*.cur += @intCast(usize, tmp)
                        errNotUTF8(p)
                        return
                    }
                    if p.*.disableSAX == 0 { cdataBlock(p, CUR_PTR(p), @intCast(usize, tmp)) }
                    if p.*.instate == STATE_EOF { return }
                    SKIPL(p, @intCast(usize, tmp))
                    p.*.checkIndex = 0
                }
                return
            } else {
                var tmp = checkCdataPush(CUR_PTR(p), base, true)
                if tmp < 0 || tmp != base {
                    tmp = -tmp
                    inp(p).*.cur += @intCast(usize, tmp)
                    errNotUTF8(p)
                    return
                }
                if base == 0 && p.*.handler.cdataBlock != 0 && p.*.disableSAX == 0 {
                    // An empty section's block, where libxml2 sees its start.
                    if CUR_PTR(p) - inp(p).*.base >= 9 && cmpText(CUR_PTR(p) - 9, "<![CDATA[") {
                        callText(p.*.handler.cdataBlock, user(p), p.*.empty, 0)
                    }
                } else if base > 0 && p.*.disableSAX == 0 {
                    cdataBlock(p, CUR_PTR(p), @intCast(usize, base))
                }
                if p.*.instate == STATE_EOF { return }
                SKIPL(p, @intCast(usize, base) + 3)
                p.*.checkIndex = 0
                p.*.instate = STATE_CONTENT
            }
        } else if state == STATE_MISC || state == STATE_PROLOG || state == STATE_EPILOG {
            const ignored = skipBlanks(p)
            avail = @intCast(i64, inp(p).*.end - inp(p).*.cur)
            if avail < 2 { return }
            const cur = RAW(p)
            const next = NXT(p, 1)
            if cur == 60 && next == 63 {
                if !terminate && lookupSequence(p, 63, 62, 0) < 0 {
                    p.*.progressive = STATE_PI
                    return
                }
                parsePI(p)
                if p.*.instate == STATE_EOF { return }
                p.*.instate = state
                p.*.progressive = 1
                if state == STATE_MISC { p.*.checkIndex = 0 }
            } else if cur == 60 && next == 33 && NXT(p, 2) == 45 && NXT(p, 3) == 45 {
                if !terminate && lookupSequence(p, 45, 45, 62) < 0 {
                    p.*.progressive = STATE_COMMENT
                    return
                }
                parseComment(p)
                if p.*.instate == STATE_EOF { return }
                p.*.instate = state
                p.*.progressive = 1
                if state == STATE_MISC { p.*.checkIndex = 0 }
            } else if state == STATE_MISC && cur == 60 && next == 33 && CMP(p, "<!DOCTYPE") {
                if !terminate && lookupSequence(p, 62, 0, 0) < 0 {
                    p.*.progressive = STATE_DTD
                    return
                }
                p.*.inSubset = 1
                p.*.progressive = 0
                p.*.checkIndex = 0
                parseDocTypeDecl(p)
                if p.*.instate == STATE_EOF { return }
                if RAW(p) == 91 {
                    p.*.instate = STATE_DTD
                } else {
                    p.*.inSubset = 2
                    externalSubset(p)
                    p.*.inSubset = 0
                    cleanSpecialAttr(p)
                    p.*.instate = STATE_PROLOG
                }
            } else if cur == 60 && next == 33 && avail < (if state == STATE_MISC { 9 } else { 4 }) {
                return
            } else if state == STATE_EPILOG {
                fatalErr(p, ERR_DOCUMENT_END, 0)
                halt(p)
                endDocument(p)
                return
            } else {
                p.*.instate = STATE_START_TAG
                if state == STATE_MISC {
                    p.*.progressive = STATE_START_TAG
                } else if p.*.progressive == 0 {
                    p.*.progressive = STATE_START_TAG
                }
                getLasts(p, &lastlt, &lastgt)
            }
        } else if state == STATE_DTD {
            // The internal subset is parsed once all of it is there: its
            // end is "]" S? ">" outside quotes and comments.
            var base = @intCast(i64, inp(p).*.cur - inp(p).*.base)
            if base < 0 { return }
            if p.*.checkIndex > base { base = p.*.checkIndex }
            const buf = inp(p).*.base
            const use = @intCast(i64, inp(p).*.end - inp(p).*.base)
            var quote: u64 = 0
            var foundEnd = false
            var stopScan = false
            while base < use && !foundEnd && !stopScan {
                const c = text.get8(buf + @intCast(usize, base))
                if quote != 0 {
                    if c == quote { quote = 0 }
                    base += 1
                    continue
                }
                if c == 60 {
                    if base + 4 < use && text.get8(buf + @intCast(usize, base) + 1) == 33 && text.get8(buf + @intCast(usize, base) + 2) == 45 && text.get8(buf + @intCast(usize, base) + 3) == 45 {
                        var found = false
                        while base + 3 < use {
                            const at = buf + @intCast(usize, base)
                            if text.get8(at) == 45 && text.get8(at + 1) == 45 && text.get8(at + 2) == 62 {
                                found = true
                                base += 2
                                break
                            }
                            base += 1
                        }
                        if !found {
                            stopScan = true
                            continue
                        }
                        base += 1
                        continue
                    }
                }
                if c == 34 {
                    quote = 34
                    base += 1
                    continue
                }
                if c == 39 {
                    quote = 39
                    base += 1
                    continue
                }
                if c == 93 {
                    if base + 1 >= use {
                        stopScan = true
                        continue
                    }
                    if text.get8(buf + @intCast(usize, base) + 1) == 93 {
                        base += 2
                        continue
                    }
                    var k: i64 = 1
                    var decided = false
                    while base + k < use {
                        const d = text.get8(buf + @intCast(usize, base + k))
                        if d == 62 {
                            foundEnd = true
                            decided = true
                            break
                        }
                        if !text.isBlank(d) {
                            decided = true
                            break
                        }
                        k += 1
                    }
                    if !decided {
                        stopScan = true
                        continue
                    }
                }
                base += 1
            }
            if !foundEnd {
                if quote == 0 {
                    p.*.checkIndex = base
                } else {
                    p.*.checkIndex = 0
                }
                return
            }
            p.*.checkIndex = 0
            parseInternalSubset(p)
            if p.*.instate == STATE_EOF { return }
            p.*.inSubset = 2
            externalSubset(p)
            p.*.inSubset = 0
            cleanSpecialAttr(p)
            if p.*.instate == STATE_EOF { return }
            p.*.instate = STATE_PROLOG
            p.*.checkIndex = 0
        } else if state == STATE_COMMENT || state == STATE_PI || state == STATE_ENTITY_VALUE {
            p.*.instate = STATE_CONTENT
        } else if state == STATE_IGNORE || state == STATE_ENTITY_DECL {
            p.*.instate = STATE_DTD
        } else {
            p.*.instate = STATE_START_TAG
        }
    }
}

// xmlParseCheckTransition: whether a chunk may let the parser on (it
// waits for a '>' where it waits for the end of markup).
fn checkTransition(p: *Parser, chunk: usize, size: usize) -> bool {
    var hasGt = false
    var index: usize = 0
    while index < size {
        if text.get8(chunk + index) == 62 {
            hasGt = true
            break
        }
        index += 1
    }
    if p.*.instate == STATE_START_TAG { return hasGt }
    if p.*.progressive == STATE_COMMENT { return hasGt }
    if p.*.instate == STATE_CDATA_SECTION { return hasGt }
    if p.*.progressive == STATE_PI { return hasGt }
    if p.*.instate == STATE_END_TAG { return hasGt }
    if p.*.progressive == STATE_DTD || p.*.instate == STATE_DTD { return hasGt }
    return true
}

fn parseChunkInner(p: *Parser, chunkAt: usize, sizeIn: usize, terminate: bool) -> i64 {
    if p.*.errNo != ERR_OK && p.*.disableSAX == 1 { return p.*.errNo }
    if p.*.instate == STATE_EOF { return -1 }
    var chunk = chunkAt
    var size = sizeIn
    var endInLf = false
    if size > 0 && chunk != 0 && !terminate && text.get8(chunk + size - 1) == 13 {
        endInLf = true
        size -= 1
    }
    while true {
        var remain: usize = 0
        var oldAvail: usize = 0
        if size > 0 && chunk != 0 && p.*.input != 0 && p.*.instate != STATE_EOF {
            oldAvail = p.*.content.length
            if p.*.instate == STATE_START && p.*.hasEncoder {
                var len = @intCast(usize, p.*.encoder.firstLine)
                if p.*.rawConsumed < @intCast(u64, len) { len -= @intCast(usize, p.*.rawConsumed) }
                if size > len {
                    remain = size - len
                    size = len
                }
            }
            const res = bufferPush(p, chunk, size)
            if res < 0 {
                p.*.errNo = STATE_EOF
                halt(p)
                return STATE_EOF
            }
        } else if p.*.instate != STATE_EOF {
            if p.*.hasEncoder && p.*.input != 0 && p.*.raw.length > 0 {
                const nbchars = decodeRaw(p, 0)
                resetDocumentInput(p)
                if nbchars < 0 {
                    raiseNoContext(p, 0, 0, LEVEL_ERROR, "xmlParseChunk: encoder error\n", 0)
                    halt(p)
                    return ERR_INVALID_ENCODING
                }
            }
        }
        if remain != 0 {
            tryOrFinish(p, false)
        } else {
            const avail = p.*.content.length
            if terminate || avail > MAX_TEXT_LENGTH || oldAvail == 0 || avail == 0 || checkTransition(p, p.*.content.address + oldAvail, avail - oldAvail) {
                tryOrFinish(p, terminate)
            }
        }
        if p.*.instate == STATE_EOF { return p.*.errNo }
        if p.*.input != 0 && (p.*.options & PARSE_HUGE) == 0 {
            const i = inp(p)
            if i.*.end - i.*.cur > MAX_TEXT_LENGTH || i.*.cur - i.*.base > MAX_TEXT_LENGTH {
                fatalErrInfo(p, ERR_INTERNAL_ERROR, "Huge input lookup")
                halt(p)
            }
        }
        if p.*.errNo != ERR_OK && p.*.disableSAX == 1 { return p.*.errNo }
        if remain == 0 { break }
        chunk += size
        size = remain
    }
    if endInLf && p.*.input != 0 {
        text.put8(p.*.scratch, 13)
        const ignored = bufferPush(p, p.*.scratch, 1)
    }
    if terminate {
        var curAvail: i64 = 0
        if p.*.input != 0 { curAvail = @intCast(i64, inp(p).*.end - inp(p).*.cur) }
        if p.*.instate != STATE_EOF && p.*.instate != STATE_EPILOG { fatalErr(p, ERR_DOCUMENT_END, 0) }
        if p.*.instate == STATE_EPILOG && curAvail > 0 { fatalErr(p, ERR_DOCUMENT_END, 0) }
        if p.*.instate != STATE_EOF { endDocument(p) }
        p.*.instate = STATE_EOF
    }
    if !p.*.wellFormed { return p.*.errNo }
    return 0
}

// xmlParseChunk: SIZE bytes at CHUNK pushed (and the document's end when
// TERMINATE); libxml2's answer (0, or the error code).
pub fn parseChunk(p: *Parser, chunkAt: usize, sizeIn: usize, terminate: bool) -> i64 {
    const root = p.*.stackBase == 0
    if root { p.*.stackBase = @frameAddress() }
    const ret = parseChunkInner(p, chunkAt, sizeIn, terminate)
    if root { p.*.stackBase = 0 }
    return ret
}

// ---------------------------------------------------------------------------
// Parsers made, set up and freed

fn init(p: *Parser, allocator: Allocator, handler: Handler, dict: usize) -> bool {
    text.zero(@intFromPtr(p), @sizeOf(Parser))
    p.*.allocator = allocator
    p.*.handler = handler
    if dict != 0 {
        p.*.dict = dict
        text.dictReference(dict)
    } else {
        p.*.dict = text.dictCreate(allocator)
    }
    if p.*.dict == 0 { return false }
    p.*.hasDict = true
    p.*.inputs = alloc(p, 5 * 8)
    p.*.inputMax = 5
    p.*.nameTab = alloc(p, 10 * 8)
    p.*.pushTab = alloc(p, 10 * 4 * 8)
    p.*.nameMax = 10
    p.*.spaceTab = alloc(p, 10 * 8)
    p.*.spaceMax = 10
    p.*.spaceNr = 1
    setWord(p.*.spaceTab, 0, @bitCast(usize, @intCast(i64, -1)))
    p.*.empty = alloc(p, 16)
    p.*.scratch = alloc(p, 16)
    if p.*.scratch == 0 || p.*.inputs == 0 || p.*.nameTab == 0 || p.*.pushTab == 0 || p.*.spaceTab == 0 || p.*.empty == 0 { return false }
    if !text.bufferInit(&p.*.message, allocator, 256) { return false }
    if !text.bufferInit(&p.*.content, allocator, 4096) { return false }
    if !text.bufferInit(&p.*.raw, allocator, 64) { return false }
    p.*.standalone = -1
    p.*.instate = STATE_START
    p.*.wellFormed = true
    p.*.nsWellFormed = true
    p.*.valid = true
    p.*.keepBlanks = true
    p.*.charset = encoding.ENC_UTF8
    p.*.inputId = 1
    p.*.strXml = text.dictLookupText(p.*.dict, "xml")
    p.*.strXmlns = text.dictLookupText(p.*.dict, "xmlns")
    p.*.strXmlNs = text.dictLookupText(p.*.dict, XML_XML_NAMESPACE)
    return true
}

// The document's input, reading the parser's buffer.
fn documentInput(p: *Parser) -> bool {
    const address = newInput(p)
    if address == 0 { return false }
    const i = inputAt(address)
    i.*.document = true
    i.*.base = p.*.content.address
    i.*.cur = i.*.base
    i.*.end = i.*.base + p.*.content.length
    return inputPush(p, address) >= 0
}

// xmlCreatePushParserCtxt: a parser to push a document to (CHUNK its
// first SIZE bytes, if any); 0 when there is no memory.
pub fn createPush(allocator: Allocator, handler: Handler, chunk: usize, size: usize) -> usize {
    const address = text.allocate(allocator, @sizeOf(Parser))
    if address == 0 { return 0 }
    const p = parserAt(address)
    if !init(p, allocator, handler, 0) || !documentInput(p) {
        free(address)
        return 0
    }
    var enc = encoding.ENC_NONE
    if chunk != 0 && size >= 4 { enc = encoding.detect(chunk, size) }
    if size == 0 || chunk == 0 {
        p.*.charset = encoding.ENC_NONE
    } else {
        const ignored = bufferPush(p, chunk, size)
    }
    if enc != encoding.ENC_NONE { const ignored = switchEncoding(p, enc) }
    return address
}

// xmlCreateMemoryParserCtxt: a parser of the SIZE bytes at BUFFER (a
// copy), to parse with parseContent; 0 for no bytes.
pub fn createMemory(allocator: Allocator, handler: Handler, buffer: usize, size: usize) -> usize {
    if buffer == 0 || size == 0 { return 0 }
    const address = text.allocate(allocator, @sizeOf(Parser))
    if address == 0 { return 0 }
    const p = parserAt(address)
    if !init(p, allocator, handler, 0) {
        free(address)
        return 0
    }
    text.bufferAdd(&p.*.content, buffer, size)
    if !documentInput(p) {
        free(address)
        return 0
    }
    return address
}

// The parser of an entity's content: P's dictionary and handler, and a
// node (libxml2's pseudo root) as the place its text goes.
fn createNested(p: *Parser, string: usize, size: usize) -> usize {
    const address = text.allocate(p.*.allocator, @sizeOf(Parser))
    if address == 0 { return 0 }
    const n = parserAt(address)
    if !init(n, p.*.allocator, p.*.handler, p.*.dict) {
        free(address)
        return 0
    }
    text.bufferAdd(&n.*.content, string, size)
    if !documentInput(n) {
        free(address)
        return 0
    }
    n.*.inputId = p.*.inputId + 1
    n.*.parent = @intFromPtr(p)
    n.*.nested = true
    return address
}

// xmlFreeParserCtxt.
pub fn free(address: usize) -> void {
    if address == 0 { return }
    const p = parserAt(address)
    const allocator = p.*.allocator
    while p.*.inputNr > 0 { freeInput(p, inputPop(p)) }
    dealloc(p, p.*.inputs)
    dealloc(p, p.*.nameTab)
    dealloc(p, p.*.pushTab)
    dealloc(p, p.*.spaceTab)
    dealloc(p, p.*.nsTab)
    dealloc(p, p.*.atts)
    dealloc(p, p.*.attallocs)
    dealloc(p, p.*.empty)
    dealloc(p, p.*.scratch)
    dealloc(p, p.*.version)
    dealloc(p, p.*.encodingName)
    dealloc(p, p.*.extSubURI)
    dealloc(p, p.*.extSubSystem)
    if p.*.message.address != 0 { text.bufferFree(&p.*.message) }
    if p.*.content.address != 0 { text.bufferFree(&p.*.content) }
    if p.*.raw.address != 0 { text.bufferFree(&p.*.raw) }
    freeAttributeTables(p)
    freeOwn(p)
    if p.*.hasDict { text.dictFree(p.*.dict) }
    text.release(allocator, address)
}

// xmlCtxtUseOptions: the options the parser takes (those not about
// the SAX handler's callbacks, which its C API changes); the ones it
// does not know.
pub fn useOptions(p: *Parser, optionsIn: u64) -> u64 {
    var options = optionsIn
    p.*.recovery = (options & PARSE_RECOVER) != 0
    if p.*.recovery { p.*.options = p.*.options | PARSE_RECOVER }
    options = options & ~PARSE_RECOVER
    p.*.replaceEntities = (options & PARSE_NOENT) != 0
    const known = PARSE_DTDLOAD | PARSE_DTDATTR | PARSE_NOENT | PARSE_PEDANTIC | PARSE_NOBLANKS | PARSE_DTDVALID | PARSE_NODICT | PARSE_NOCDATA | PARSE_NSCLEAN | PARSE_NONET | PARSE_COMPACT | PARSE_OLD10 | PARSE_NOBASEFIX | PARSE_HUGE | PARSE_OLDSAX | PARSE_IGNORE_ENC | PARSE_BIG_LINES | PARSE_SAX1
    p.*.options = p.*.options | (options & known)
    p.*.pedantic = (options & PARSE_PEDANTIC) != 0
    p.*.keepBlanks = (options & PARSE_NOBLANKS) == 0
    p.*.validate = (options & PARSE_DTDVALID) != 0
    if (options & PARSE_NOCDATA) != 0 { p.*.handler.cdataBlock = 0 }
    return options & ~(known | PARSE_NOERROR | PARSE_NOWARNING)
}

// ---------------------------------------------------------------------------
// For the parser's C API (compiler/libc/xml2): what libxml2's
// parserInternals.h gives its users of a parser, and the state its SAX2
// callbacks change.

// xmlSwitchToEncoding: the document's encoding from now on, H's.
pub fn switchToHandler(p: *Parser, h: encoding.Handler) -> i64 { return switchToEncoding(p, h, -1) }

// xmlCurrentChar: the current character, its length in LEN.
pub fn current(p: *Parser, len: *usize) -> u64 { return currentChar(p, len) }

// xmlNextChar.
pub fn next(p: *Parser) -> void { nextChar(p) }

// xmlStringCurrentChar: the character at CUR, its length in LEN.
pub fn stringCurrent(p: *Parser, cur: usize, len: *usize) -> u64 { return stringCurrentChar(p, cur, len) }

// xmlStringLenDecodeEntities: the LEN bytes at STR with the references
// WHAT says (1 general entities, 2 parameter entities, 3 both) replaced;
// a string of the parser's allocator, 0 on an error.
pub fn decodeEntities(p: *Parser, str: usize, len: usize, what: u64) -> usize { return stringDecodeEntitiesInt(p, str, len, what, false) }

// Whether the parser takes no more errors (xmlHaltParser's state).
pub fn isStopped(p: *Parser) -> bool { return stopped(p) }

// The state a fatal error of libxml2's SAX2 callbacks leaves (their
// xmlFatalErrMsg; the error itself is the caller's to report).
pub fn noteFatal(p: *Parser, code: i64) -> void {
    p.*.errNo = code
    p.*.wellFormed = false
    p.*.valid = false
    if !p.*.recovery { p.*.disableSAX = 1 }
}

// xmlCtxtResetLastError's part of the parser's state.
pub fn resetErrNo(p: *Parser) -> void { p.*.errNo = 0 }
