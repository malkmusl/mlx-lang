// std.xml.text: what the parts of std.xml.sax share: memory by address
// (the parser's tables, its input and the strings it hands out are
// blocks of an Allocator, as libxml2's are blocks of malloc), growable
// byte buffers, the character classes of XML 1.0 (fifth edition), UTF-8
// as libxml2 reads and writes it, the dictionary that interns names,
// and the printf subset its error messages are written with.
//
// Strings are C's: an address and the 0 byte after them, so that a C
// library made of std.xml.sax (compiler/libc/xml2) hands them to C as
// they are.
const allocator_module = @import("../../bootstrap/allocator.mlx")
const bmem = @import("../../bootstrap/mem.mlx")

pub const Allocator = allocator_module.Allocator

pub inline fn bytes(address: usize) -> [*]u8 { return unsafe { @ptrFromInt([*]u8, address) } }
pub inline fn words(address: usize) -> [*]usize { return unsafe { @ptrFromInt([*]usize, address) } }

pub inline fn get8(address: usize) -> u64 { unsafe { return @intCast(u64, @ptrFromInt(*u8, address).*) } }
pub inline fn put8(address: usize, value: u64) -> void { unsafe { @ptrFromInt(*u8, address).* = @intCast(u8, value & 255) } }
pub inline fn get32(address: usize) -> u64 { unsafe { return @intCast(u64, @ptrFromInt(*u32, address).*) } }
pub inline fn put32(address: usize, value: u64) -> void { unsafe { @ptrFromInt(*u32, address).* = @intCast(u32, value & 0xffffffff) } }
pub inline fn get64(address: usize) -> u64 { unsafe { return @ptrFromInt(*u64, address).* } }
pub inline fn put64(address: usize, value: u64) -> void { unsafe { @ptrFromInt(*u64, address).* = value } }
pub inline fn getWord(address: usize) -> usize { unsafe { return @ptrFromInt(*usize, address).* } }
pub inline fn putWord(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*usize, address).* = value } }

// A 32-bit int of C (as libxml2's structures hold them), read signed.
pub fn getInt(address: usize) -> i64 {
    const v = get32(address)
    if v >= 0x80000000 { return @intCast(i64, v) - 4294967296 }
    return @intCast(i64, v)
}
pub fn putInt(address: usize, value: i64) -> void { put32(address, @bitCast(u64, value) & 0xffffffff) }

pub fn copy(target: usize, source: usize, count: usize) -> void {
    if count != 0 { bmem.copy(bytes(target), bytes(source), count) }
}

// A copy between places that may overlap.
pub fn move(target: usize, source: usize, count: usize) -> void {
    if count == 0 || target == source { return }
    if target < source || target >= source + count {
        var index: usize = 0
        while index < count {
            put8(target + index, get8(source + index))
            index += 1
        }
    } else {
        bmem.copyBackwards(bytes(target), bytes(source), count)
    }
}

pub fn zero(target: usize, count: usize) -> void {
    if count != 0 { bmem.zero(bytes(target), count) }
}

pub fn same(a: usize, b: usize, count: usize) -> bool {
    var index: usize = 0
    while index < count {
        if get8(a + index) != get8(b + index) { return false }
        index += 1
    }
    return true
}

// SIZE bytes, 16-byte aligned and zeroed; 0 when there are none. Every
// block remembers its size in the 16 bytes before it, so that `release`
// needs only the address (as free does).
pub fn allocate(allocator: Allocator, size: usize) -> usize {
    const memory = allocator.alloc(size + 16, 16)
    if memory == null { return 0 }
    const address = @intFromPtr(memory.?)
    zero(address, size + 16)
    put64(address, @intCast(u64, size))
    return address + 16
}

pub fn release(allocator: Allocator, address: usize) -> void {
    if address == 0 { return }
    const size = @intCast(usize, get64(address - 16))
    allocator.free(bytes(address - 16), size + 16, 16)
}

pub fn sizeOf(address: usize) -> usize {
    if address == 0 { return 0 }
    return @intCast(usize, get64(address - 16))
}

// The block at ADDRESS made SIZE bytes long (its bytes kept, the new
// ones zero): a new block, the old one released.
pub fn reallocate(allocator: Allocator, address: usize, size: usize) -> usize {
    const block = allocate(allocator, size)
    if block == 0 { return 0 }
    if address != 0 {
        const old = sizeOf(address)
        copy(block, address, if old < size { old } else { size })
        release(allocator, address)
    }
    return block
}

// ---------------------------------------------------------------------------
// C strings

pub fn length(s: usize) -> usize {
    if s == 0 { return 0 }
    var n: usize = 0
    while get8(s + n) != 0 { n += 1 }
    return n
}

// xmlStrEqual: both absent, or the same bytes.
pub fn equal(a: usize, b: usize) -> bool {
    if a == b { return true }
    if a == 0 || b == 0 { return false }
    var index: usize = 0
    while true {
        const x = get8(a + index)
        if x != get8(b + index) { return false }
        if x == 0 { return true }
        index += 1
    }
    return true
}

// Whether the C string S is TEXT.
pub fn equalText(s: usize, text: []const u8) -> bool {
    if s == 0 { return false }
    var index: usize = 0
    while index < text.length {
        if get8(s + index) != @intCast(u64, text[index]) { return false }
        index += 1
    }
    return get8(s + text.length) == 0
}

inline fn lower(c: u64) -> u64 { return if c >= 65 && c <= 90 { c + 32 } else { c } }

// xmlStrcasecmp == 0 against TEXT.
pub fn equalTextNoCase(s: usize, text: []const u8) -> bool {
    if s == 0 { return false }
    var index: usize = 0
    while index < text.length {
        if lower(get8(s + index)) != lower(@intCast(u64, text[index])) { return false }
        index += 1
    }
    return get8(s + text.length) == 0
}

// xmlStrcasestr != NULL for TEXT.
pub fn containsNoCase(s: usize, text: []const u8) -> bool {
    if s == 0 { return false }
    const n = length(s)
    if text.length > n { return false }
    var at: usize = 0
    while at + text.length <= n {
        var index: usize = 0
        while index < text.length && lower(get8(s + at + index)) == lower(@intCast(u64, text[index])) { index += 1 }
        if index == text.length { return true }
        at += 1
    }
    return false
}

// xmlStrchr != NULL.
pub fn contains(s: usize, c: u64) -> bool {
    if s == 0 { return false }
    var at = s
    while get8(at) != 0 {
        if get8(at) == c { return true }
        at += 1
    }
    return false
}

// A copy of the COUNT bytes at S and a 0 after them.
pub fn duplicate(allocator: Allocator, s: usize, count: usize) -> usize {
    const block = allocate(allocator, count + 1)
    if block == 0 { return 0 }
    if count > 0 { copy(block, s, count) }
    return block
}

pub fn duplicateText(allocator: Allocator, text: []const u8) -> usize {
    const block = allocate(allocator, text.length + 1)
    if block == 0 { return 0 }
    var index: usize = 0
    while index < text.length {
        put8(block + index, @intCast(u64, text[index]))
        index += 1
    }
    return block
}

pub fn duplicateString(allocator: Allocator, s: usize) -> usize {
    if s == 0 { return 0 }
    return duplicate(allocator, s, length(s))
}

// ---------------------------------------------------------------------------
// Growable buffers: ADDRESS holds LENGTH bytes and a 0 after them.

pub const Buffer = struct {
    allocator: Allocator
    address: usize
    length: usize
    capacity: usize
}

pub fn bufferInit(buffer: *Buffer, allocator: Allocator, capacity: usize) -> bool {
    buffer.*.allocator = allocator
    buffer.*.length = 0
    buffer.*.capacity = if capacity < 16 { 16 } else { capacity }
    buffer.*.address = allocate(allocator, buffer.*.capacity + 8)
    return buffer.*.address != 0
}

pub fn bufferFree(buffer: *Buffer) -> void {
    release(buffer.*.allocator, buffer.*.address)
    buffer.*.address = 0
    buffer.*.length = 0
    buffer.*.capacity = 0
}

// Room for EXTRA more bytes (and the 0 and some zero bytes of slack
// after them, which the parser's lookahead reads).
pub fn bufferReserve(buffer: *Buffer, extra: usize) -> bool {
    if buffer.*.length + extra <= buffer.*.capacity { return true }
    var capacity = buffer.*.capacity * 2
    if capacity < buffer.*.length + extra { capacity = buffer.*.length + extra }
    const block = allocate(buffer.*.allocator, capacity + 8)
    if block == 0 { return false }
    copy(block, buffer.*.address, buffer.*.length)
    release(buffer.*.allocator, buffer.*.address)
    buffer.*.address = block
    buffer.*.capacity = capacity
    return true
}

pub fn bufferAddByte(buffer: *Buffer, c: u64) -> void {
    if !bufferReserve(buffer, 1) { return }
    put8(buffer.*.address + buffer.*.length, c)
    buffer.*.length += 1
    put8(buffer.*.address + buffer.*.length, 0)
}

pub fn bufferAdd(buffer: *Buffer, source: usize, count: usize) -> void {
    if count == 0 { return }
    if !bufferReserve(buffer, count) { return }
    copy(buffer.*.address + buffer.*.length, source, count)
    buffer.*.length += count
    put8(buffer.*.address + buffer.*.length, 0)
}

pub fn bufferAddText(buffer: *Buffer, text: []const u8) -> void {
    if !bufferReserve(buffer, text.length) { return }
    var index: usize = 0
    while index < text.length {
        put8(buffer.*.address + buffer.*.length, @intCast(u64, text[index]))
        buffer.*.length += 1
        index += 1
    }
    put8(buffer.*.address + buffer.*.length, 0)
}

pub fn bufferAddString(buffer: *Buffer, s: usize) -> void {
    if s != 0 { bufferAdd(buffer, s, length(s)) }
}

// The code point C in UTF-8.
pub fn bufferAddChar(buffer: *Buffer, c: u64) -> void {
    if !bufferReserve(buffer, 4) { return }
    buffer.*.length += copyChar(buffer.*.address + buffer.*.length, c)
    put8(buffer.*.address + buffer.*.length, 0)
}

// The first COUNT bytes dropped.
pub fn bufferShrink(buffer: *Buffer, count: usize) -> void {
    const n = if count > buffer.*.length { buffer.*.length } else { count }
    move(buffer.*.address, buffer.*.address + n, buffer.*.length - n)
    buffer.*.length -= n
    put8(buffer.*.address + buffer.*.length, 0)
}

// The buffer's bytes as a block of their own (the buffer left empty).
pub fn bufferTake(buffer: *Buffer) -> usize {
    const result = duplicate(buffer.*.allocator, buffer.*.address, buffer.*.length)
    buffer.*.length = 0
    put8(buffer.*.address, 0)
    return result
}

// ---------------------------------------------------------------------------
// Characters (XML 1.0, fifth edition, as libxml2 2.9 tests them)

// IS_CHAR: [2] Char.
pub fn isChar(c: u64) -> bool {
    if c < 0x100 { return (c >= 0x20) || c == 0x9 || c == 0xA || c == 0xD }
    return (c >= 0x100 && c <= 0xD7FF) || (c >= 0xE000 && c <= 0xFFFD) || (c >= 0x10000 && c <= 0x10FFFF)
}

// IS_BLANK_CH: [3] S.
pub inline fn isBlank(c: u64) -> bool { return c == 0x20 || c == 0x9 || c == 0xA || c == 0xD }

// IS_BYTE_CHAR.
pub inline fn isByteChar(c: u64) -> bool { return (c >= 0x20) || c == 0x9 || c == 0xA || c == 0xD }

// IS_PUBIDCHAR_CH: [13] PubidChar.
pub fn isPubidChar(c: u64) -> bool {
    if c == 0x20 || c == 0xD || c == 0xA { return true }
    if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) { return true }
    return c == 45 || c == 39 || c == 40 || c == 41 || c == 43 || c == 44 || c == 46 || c == 47 || c == 58 || c == 61 || c == 63 || c == 59 || c == 33 || c == 42 || c == 35 || c == 64 || c == 36 || c == 95 || c == 37
}

// xmlIsNameStartChar: [4] NameStartChar.
pub fn isNameStartChar(c: u64) -> bool {
    if c == 32 || c == 62 || c == 47 { return false }
    if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 || c == 58 { return true }
    return (c >= 0xC0 && c <= 0xD6) || (c >= 0xD8 && c <= 0xF6) || (c >= 0xF8 && c <= 0x2FF) || (c >= 0x370 && c <= 0x37D) || (c >= 0x37F && c <= 0x1FFF) || (c >= 0x200C && c <= 0x200D) || (c >= 0x2070 && c <= 0x218F) || (c >= 0x2C00 && c <= 0x2FEF) || (c >= 0x3001 && c <= 0xD7FF) || (c >= 0xF900 && c <= 0xFDCF) || (c >= 0xFDF0 && c <= 0xFFFD) || (c >= 0x10000 && c <= 0xEFFFF)
}

// xmlIsNameChar: [4a] NameChar.
pub fn isNameChar(c: u64) -> bool {
    if c == 32 || c == 62 || c == 47 { return false }
    if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 || c == 58 || c == 45 || c == 46 || c == 0xB7 { return true }
    return (c >= 0xC0 && c <= 0xD6) || (c >= 0xD8 && c <= 0xF6) || (c >= 0xF8 && c <= 0x2FF) || (c >= 0x300 && c <= 0x36F) || (c >= 0x370 && c <= 0x37D) || (c >= 0x37F && c <= 0x1FFF) || (c >= 0x200C && c <= 0x200D) || (c >= 0x203F && c <= 0x2040) || (c >= 0x2070 && c <= 0x218F) || (c >= 0x2C00 && c <= 0x2FEF) || (c >= 0x3001 && c <= 0xD7FF) || (c >= 0xF900 && c <= 0xFDCF) || (c >= 0xFDF0 && c <= 0xFFFD) || (c >= 0x10000 && c <= 0xEFFFF)
}

// xmlCopyCharMultiByte: VAL in UTF-8 at OUT; the bytes written (0 for a
// value beyond Unicode).
pub fn copyChar(out: usize, val: u64) -> usize {
    if val < 0x80 {
        put8(out, val)
        return 1
    }
    if val < 0x800 {
        put8(out, (val >> 6) | 0xC0)
        put8(out + 1, (val & 0x3F) | 0x80)
        return 2
    }
    if val < 0x10000 {
        put8(out, (val >> 12) | 0xE0)
        put8(out + 1, ((val >> 6) & 0x3F) | 0x80)
        put8(out + 2, (val & 0x3F) | 0x80)
        return 3
    }
    if val < 0x110000 {
        put8(out, (val >> 18) | 0xF0)
        put8(out + 1, ((val >> 12) & 0x3F) | 0x80)
        put8(out + 2, ((val >> 6) & 0x3F) | 0x80)
        put8(out + 3, (val & 0x3F) | 0x80)
        return 4
    }
    return 0
}

// ---------------------------------------------------------------------------
// The dictionary: each name once, at an address that stays (libxml2's
// xmlDict). Entries are kept in a table of (hash, address, length)
// triples, open addressing; the strings in pools that are never moved.

pub const Dict = struct {
    allocator: Allocator
    table: usize
    size: usize
    count: usize
    pool: usize
    poolUsed: usize
    poolSize: usize
    references: usize
}

pub inline fn dictAt(address: usize) -> *Dict { return unsafe { @ptrFromInt(*Dict, address) } }

const POOL_SIZE: usize = 8192

pub fn dictCreate(allocator: Allocator) -> usize {
    const address = allocate(allocator, @sizeOf(Dict))
    if address == 0 { return 0 }
    const d = dictAt(address)
    d.*.allocator = allocator
    d.*.size = 256
    d.*.table = allocate(allocator, 256 * 24)
    d.*.references = 1
    if d.*.table == 0 {
        release(allocator, address)
        return 0
    }
    return address
}

pub fn dictReference(address: usize) -> void {
    if address != 0 { dictAt(address).*.references += 1 }
}

pub fn dictFree(address: usize) -> void {
    if address == 0 { return }
    const d = dictAt(address)
    d.*.references -= 1
    if d.*.references > 0 { return }
    const allocator = d.*.allocator
    // The pools are chained through their first word.
    var pool = d.*.pool
    while pool != 0 {
        const next = getWord(pool)
        release(allocator, pool)
        pool = next
    }
    release(allocator, d.*.table)
    release(allocator, address)
}

fn hashOf(s: usize, count: usize) -> u64 {
    var h: u64 = 14695981039346656037
    var index: usize = 0
    while index < count {
        h = (h ^ get8(s + index)) *% 1099511628211
        index += 1
    }
    return h
}

fn dictStore(d: *Dict, s: usize, count: usize) -> usize {
    if d.*.pool == 0 || d.*.poolUsed + count + 1 > d.*.poolSize {
        const size = if count + 1 + 16 > POOL_SIZE { count + 1 + 16 } else { POOL_SIZE }
        const pool = allocate(d.*.allocator, size)
        if pool == 0 { return 0 }
        putWord(pool, d.*.pool)
        d.*.pool = pool
        d.*.poolUsed = 16
        d.*.poolSize = size
    }
    const at = d.*.pool + d.*.poolUsed
    copy(at, s, count)
    put8(at + count, 0)
    d.*.poolUsed += count + 1
    return at
}

fn dictGrow(d: *Dict) -> void {
    const old = d.*.table
    const oldSize = d.*.size
    const table = allocate(d.*.allocator, oldSize * 2 * 24)
    if table == 0 { return }
    d.*.table = table
    d.*.size = oldSize * 2
    var index: usize = 0
    while index < oldSize {
        const entry = old + index * 24
        if getWord(entry + 8) != 0 {
            const h = get64(entry)
            var slot = @intCast(usize, h & @intCast(u64, d.*.size - 1))
            while getWord(table + slot * 24 + 8) != 0 { slot = (slot + 1) & (d.*.size - 1) }
            put64(table + slot * 24, h)
            putWord(table + slot * 24 + 8, getWord(entry + 8))
            putWord(table + slot * 24 + 16, getWord(entry + 16))
        }
        index += 1
    }
    release(d.*.allocator, old)
}

// xmlDictLookup: the dictionary's copy of the COUNT bytes at S.
pub fn dictLookup(address: usize, s: usize, count: usize) -> usize {
    if address == 0 || s == 0 { return 0 }
    const d = dictAt(address)
    const h = hashOf(s, count)
    var slot = @intCast(usize, h & @intCast(u64, d.*.size - 1))
    while true {
        const entry = d.*.table + slot * 24
        const at = getWord(entry + 8)
        if at == 0 { break }
        if get64(entry) == h && getWord(entry + 16) == count && same(at, s, count) { return at }
        slot = (slot + 1) & (d.*.size - 1)
    }
    const stored = dictStore(d, s, count)
    if stored == 0 { return 0 }
    const entry = d.*.table + slot * 24
    put64(entry, h)
    putWord(entry + 8, stored)
    putWord(entry + 16, count)
    d.*.count += 1
    if d.*.count * 2 > d.*.size { dictGrow(d) }
    return stored
}

pub fn dictLookupString(address: usize, s: usize) -> usize { return dictLookup(address, s, length(s)) }

pub fn dictLookupText(address: usize, text: []const u8) -> usize {
    return dictLookup(address, @intFromPtr(text.pointer), text.length)
}

// xmlDictExists: the dictionary's copy, or 0 when it has none.
pub fn dictExists(address: usize, s: usize, count: usize) -> usize {
    if address == 0 || s == 0 { return 0 }
    const d = dictAt(address)
    const h = hashOf(s, count)
    var slot = @intCast(usize, h & @intCast(u64, d.*.size - 1))
    while true {
        const entry = d.*.table + slot * 24
        const at = getWord(entry + 8)
        if at == 0 { return 0 }
        if get64(entry) == h && getWord(entry + 16) == count && same(at, s, count) { return at }
        slot = (slot + 1) & (d.*.size - 1)
    }
    return 0
}

// xmlDictOwns: whether S is one of the dictionary's strings.
pub fn dictOwns(address: usize, s: usize) -> bool {
    if address == 0 || s == 0 { return false }
    var pool = dictAt(address).*.pool
    while pool != 0 {
        if s >= pool && s < pool + sizeOf(pool) { return true }
        pool = getWord(pool)
    }
    return false
}

pub fn dictSize(address: usize) -> usize {
    if address == 0 { return 0 }
    return dictAt(address).*.count
}

// ---------------------------------------------------------------------------
// The messages: printf's %s (and %.Ns), %d, %X, %02X, %c and %%, as
// libxml2's formats use them, of up to three arguments (a string's
// argument is its address; 0 is printed "(null)", as glibc does).

fn addDecimal(buffer: *Buffer, value: i64) -> void {
    var v = value
    if v < 0 {
        bufferAddByte(buffer, 45)
        v = -v
    }
    var digits: [24]u8 = undefined
    var n: usize = 0
    var u = @bitCast(u64, v)
    while true {
        digits[n] = @intCast(u8, 48 + (u % 10))
        n += 1
        u = u / 10
        if u == 0 { break }
    }
    while n > 0 {
        n -= 1
        bufferAddByte(buffer, @intCast(u64, digits[n]))
    }
}

fn addHex(buffer: *Buffer, value: u64, width: usize) -> void {
    var digits: [24]u8 = undefined
    var n: usize = 0
    var u = value
    while true {
        const d = u & 15
        digits[n] = @intCast(u8, if d < 10 { 48 + d } else { 55 + d })
        n += 1
        u = u >> 4
        if u == 0 { break }
    }
    while n < width {
        digits[n] = 48
        n += 1
    }
    while n > 0 {
        n -= 1
        bufferAddByte(buffer, @intCast(u64, digits[n]))
    }
}

pub fn addDecimalTo(buffer: *Buffer, value: i64) -> void { addDecimal(buffer, value) }

pub fn format(buffer: *Buffer, fmt: []const u8, a1: u64, a2: u64, a3: u64) -> void {
    var args: [3]u64 = undefined
    args[0] = a1
    args[1] = a2
    args[2] = a3
    var next: usize = 0
    var index: usize = 0
    while index < fmt.length {
        const c = fmt[index]
        if c != 37 || index + 1 >= fmt.length {
            bufferAddByte(buffer, @intCast(u64, c))
            index += 1
            continue
        }
        index += 1
        if fmt[index] == 37 {
            bufferAddByte(buffer, 37)
            index += 1
            continue
        }
        // Flags and width (only '0' and digits), precision.
        var zeroPad = false
        var width: usize = 0
        var precision: usize = 0
        var hasPrecision = false
        if fmt[index] == 48 {
            zeroPad = true
            index += 1
        }
        while index < fmt.length && fmt[index] >= 48 && fmt[index] <= 57 {
            width = width * 10 + @intCast(usize, fmt[index] - 48)
            index += 1
        }
        if index < fmt.length && fmt[index] == 46 {
            hasPrecision = true
            index += 1
            while index < fmt.length && fmt[index] >= 48 && fmt[index] <= 57 {
                precision = precision * 10 + @intCast(usize, fmt[index] - 48)
                index += 1
            }
        }
        if index >= fmt.length { break }
        const conversion = fmt[index]
        index += 1
        const arg = if next < 3 { args[next] } else { 0 }
        next += 1
        if conversion == 115 {
            const s = @intCast(usize, arg)
            if s == 0 {
                bufferAddText(buffer, "(null)")
            } else {
                var n = length(s)
                if hasPrecision && n > precision { n = precision }
                bufferAdd(buffer, s, n)
            }
        } else if conversion == 100 {
            // An int: the low 32 bits, signed.
            var v = @intCast(i64, arg & 0xffffffff)
            if v >= 2147483648 { v = v - 4294967296 }
            addDecimal(buffer, v)
        } else if conversion == 88 {
            addHex(buffer, arg & 0xffffffff, if zeroPad { width } else { 0 })
        } else if conversion == 99 {
            bufferAddByte(buffer, arg & 255)
        }
    }
}

// ---------------------------------------------------------------------------
// Text escaped and names checked, for programs writing XML (what
// libxml2's xmlEncodeEntitiesReentrant, xmlEncodeSpecialChars and
// xmlValidateName family do, over Mlx slices)

// Where text is written: `write(context, bytes)` appends the bytes.
pub const Sink = struct {
    context: usize
    write: fn(usize, []const u8) -> void
}

fn put(sink: Sink, bytes: []const u8) -> void { sink.write(sink.context, bytes) }

// How text is escaped: `content` for character data ('<', '>' and '&'
// escaped, a return as "&#13;", other control characters dropped, text
// beyond ASCII kept as UTF-8); `contentAscii` the same with every
// character beyond ASCII a hexadecimal character reference (each byte of
// a sequence that is not UTF-8 a decimal one), for a document with no
// encoding declared; `attribute` for an attribute's value ('"' escaped
// too, every other byte kept); `html` as `content` but returns kept.
pub const Escape = enum(u8) {
    content,
    contentAscii,
    attribute,
    html,
}

// The code point of the UTF-8 sequence at `at` (its length in `length`),
// or 0 with length 0 when the bytes there are not one.
fn codePointAt(value: []const u8, at: usize, length: *usize) -> u64 {
    const c = @intCast(u64, value[at])
    length.* = 0
    if c < 0x80 {
        length.* = 1
        return c
    }
    const rest = value.length - at
    if rest < 2 || (c & 0xC0) != 0xC0 || (value[at + 1] & 0xC0) != 0x80 { return 0 }
    const second = @intCast(u64, value[at + 1])
    if c < 0xE0 {
        length.* = 2
        return ((c & 0x1F) << 6) | (second & 0x3F)
    }
    if rest < 3 || (value[at + 2] & 0xC0) != 0x80 { return 0 }
    const third = @intCast(u64, value[at + 2])
    if c < 0xF0 {
        length.* = 3
        return ((c & 0x0F) << 12) | ((second & 0x3F) << 6) | (third & 0x3F)
    }
    if rest < 4 || (value[at + 3] & 0xC0) != 0x80 || c >= 0xF8 { return 0 }
    const fourth = @intCast(u64, value[at + 3])
    length.* = 4
    return ((c & 0x07) << 18) | ((second & 0x3F) << 12) | ((third & 0x3F) << 6) | (fourth & 0x3F)
}

// A character reference: "&#13;" or "&#xE9;".
fn writeReference(sink: Sink, value: u64, hex: bool) -> void {
    var digits: [24]u8 = undefined
    var end: usize = 24
    var rest = value
    const base: u64 = if hex { 16 } else { 10 }
    while true {
        const digit = rest % base
        end -= 1
        digits[end] = if digit < 10 { @intCast(u8, 48 + digit) } else { @intCast(u8, 55 + digit) }
        rest /= base
        if rest == 0 { break }
    }
    put(sink, if hex { "&#x" } else { "&#" })
    put(sink, digits[end..24])
    put(sink, ";")
}

// `value` escaped as `mode` says, written to the sink in runs.
pub fn writeEscaped(sink: Sink, value: []const u8, mode: Escape) -> void {
    var start: usize = 0
    var at: usize = 0
    while at < value.length {
        const c = @intCast(u64, value[at])
        var replacement: []const u8 = ""
        var skip: usize = 1
        var reference: u64 = 0
        var hex = false
        var handled = true
        if c == 60 {
            replacement = "&lt;"
        } else if c == 62 {
            replacement = "&gt;"
        } else if c == 38 {
            replacement = "&amp;"
        } else if c == 34 && mode == Escape.attribute {
            replacement = "&quot;"
        } else if c == 13 && mode != Escape.html {
            reference = 13
        } else if mode == Escape.attribute || c >= 0x20 || c == 9 || c == 10 || c == 13 {
            if c >= 0x80 && mode == Escape.contentAscii {
                var length: usize = 0
                const point = codePointAt(value, at, &length)
                if length < 2 || !isChar(point) {
                    reference = c
                } else {
                    reference = point
                    hex = true
                    skip = length
                }
            } else {
                handled = false
            }
        }
        // Other control characters of content are dropped: handled,
        // nothing written.
        if handled {
            if at > start { put(sink, value[start..at]) }
            if replacement.length > 0 {
                put(sink, replacement)
            } else if reference != 0 {
                writeReference(sink, reference, hex)
            }
            at += skip
            start = at
        } else {
            at += 1
        }
    }
    if at > start { put(sink, value[start..at]) }
}

// The index after the name that starts at `at` (NameChars, the first a
// NameStartChar unless `token`, colons allowed when `colons`), or `at`
// when none starts there.
pub fn nameEnd(value: []const u8, at: usize, token: bool, colons: bool) -> usize {
    var index = at
    var first = true
    while index < value.length {
        var length: usize = 0
        const c = codePointAt(value, index, &length)
        if length == 0 || c == 0 { break }
        if c == 58 && !colons { break }
        const ok = if first && !token { isNameStartChar(c) } else { isNameChar(c) }
        if !ok { break }
        first = false
        index += length
    }
    if first { return at }
    return index
}

// XML 1.0's Name, Namespaces' NCName and QName, and Nmtoken.
pub const NameKind = enum(u8) {
    name,
    ncName,
    qName,
    nmtoken,
}

// Whether `value` is one name of the kind, blanks around it allowed
// when `blanks`.
pub fn validName(value: []const u8, kind: NameKind, blanks: bool) -> bool {
    var at: usize = 0
    if blanks { while at < value.length && isBlank(@intCast(u64, value[at])) { at += 1 } }
    const token = kind == NameKind.nmtoken
    const colons = kind == NameKind.name || kind == NameKind.nmtoken
    var end = nameEnd(value, at, token, colons)
    if end == at { return false }
    if kind == NameKind.qName && end < value.length && value[end] == 58 {
        const local = nameEnd(value, end + 1, false, false)
        if local == end + 1 { return false }
        end = local
    }
    if blanks { while end < value.length && isBlank(@intCast(u64, value[end])) { end += 1 } }
    return end == value.length
}

pub fn isName(value: []const u8) -> bool { return validName(value, NameKind.name, false) }
pub fn isNCName(value: []const u8) -> bool { return validName(value, NameKind.ncName, false) }
pub fn isQName(value: []const u8) -> bool { return validName(value, NameKind.qName, false) }
pub fn isNmtoken(value: []const u8) -> bool { return validName(value, NameKind.nmtoken, false) }
