// std.xml.uri: whether a string is a URI reference of RFC 3986 as
// libxml2 2.9.14 reads one (uri.c's xmlParse3986URIReference: an
// absolute URI, or else a relative reference), and whether it has a
// scheme and a fragment: what the parser needs to know of the URIs of
// namespace declarations and of external entities (it keeps none of
// their parts).
const text = @import("./text.mlx")

pub const Parsed = struct {
    valid: bool
    hasScheme: bool
    hasFragment: bool
}

inline fn at(s: usize, i: usize) -> u64 { return text.get8(s + i) }

inline fn isAlpha(c: u64) -> bool { return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) }
inline fn isDigit(c: u64) -> bool { return c >= 48 && c <= 57 }
inline fn isHex(c: u64) -> bool { return isDigit(c) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70) }
inline fn isSubDelim(c: u64) -> bool { return c == 33 || c == 36 || c == 38 || c == 40 || c == 41 || c == 42 || c == 43 || c == 44 || c == 59 || c == 61 || c == 39 }
inline fn isUnreserved(c: u64) -> bool { return isAlpha(c) || isDigit(c) || c == 45 || c == 46 || c == 95 || c == 126 }

fn isPctEncoded(p: usize) -> bool { return at(p, 0) == 37 && isHex(at(p, 1)) && isHex(at(p, 2)) }

// ISA_PCHAR.
fn isPchar(p: usize) -> bool {
    const c = at(p, 0)
    return isUnreserved(c) || isPctEncoded(p) || isSubDelim(c) || c == 58 || c == 64
}

// NEXT: past a character (three for a percent escape).
inline fn next(p: usize) -> usize { return if at(p, 0) == 37 { p + 3 } else { p + 1 } }

// Each part: true when it is not there (the parse fails); CUR moved past
// what it read.

fn scheme(cur: *usize) -> bool {
    var p = cur.*
    if !isAlpha(at(p, 0)) { return true }
    p += 1
    while isAlpha(at(p, 0)) || isDigit(at(p, 0)) || at(p, 0) == 43 || at(p, 0) == 45 || at(p, 0) == 46 { p += 1 }
    cur.* = p
    return false
}

fn fragment(cur: *usize) -> void {
    var p = cur.*
    while isPchar(p) || at(p, 0) == 47 || at(p, 0) == 63 || at(p, 0) == 91 || at(p, 0) == 93 { p = next(p) }
    cur.* = p
}

fn query(cur: *usize) -> void {
    var p = cur.*
    while isPchar(p) || at(p, 0) == 47 || at(p, 0) == 63 { p = next(p) }
    cur.* = p
}

fn port(cur: *usize) -> bool {
    var p = cur.*
    if !isDigit(at(p, 0)) { return true }
    var value: u64 = 0
    while isDigit(at(p, 0)) {
        value = value * 10 + (at(p, 0) - 48)
        if value > 2147483647 { return true }
        p += 1
    }
    cur.* = p
    return false
}

fn userinfo(cur: *usize) -> bool {
    var p = cur.*
    while isUnreserved(at(p, 0)) || isPctEncoded(p) || isSubDelim(at(p, 0)) || at(p, 0) == 58 { p = next(p) }
    if at(p, 0) == 64 {
        cur.* = p
        return false
    }
    return true
}

fn decOctet(cur: *usize) -> bool {
    var p = cur.*
    if !isDigit(at(p, 0)) { return true }
    if !isDigit(at(p, 1)) {
        p += 1
    } else if at(p, 0) != 48 && isDigit(at(p, 1)) && !isDigit(at(p, 2)) {
        p += 2
    } else if at(p, 0) == 49 && isDigit(at(p, 1)) && isDigit(at(p, 2)) {
        p += 3
    } else if at(p, 0) == 50 && at(p, 1) >= 48 && at(p, 1) <= 52 && isDigit(at(p, 2)) {
        p += 3
    } else if at(p, 0) == 50 && at(p, 1) == 53 && at(p, 2) >= 48 && at(p, 1) <= 53 {
        p += 3
    } else {
        return true
    }
    cur.* = p
    return false
}

fn host(cur: *usize) -> bool {
    var p = cur.*
    if at(p, 0) == 91 {
        p += 1
        while at(p, 0) != 93 && at(p, 0) != 0 { p += 1 }
        if at(p, 0) != 93 { return true }
        cur.* = p + 1
        return false
    }
    if isDigit(at(p, 0)) {
        // A dotted IPv4 address (libxml2 checks three dots' worth).
        var q = p
        var ipv4 = true
        if decOctet(&q) || at(q, 0) != 46 { ipv4 = false }
        if ipv4 {
            q += 1
            if decOctet(&q) || at(q, 0) != 46 { ipv4 = false }
        }
        if ipv4 {
            if decOctet(&q) || at(q, 0) != 46 { ipv4 = false }
        }
        if ipv4 {
            if decOctet(&q) { ipv4 = false }
        }
        if ipv4 {
            cur.* = q
            return false
        }
    }
    while isUnreserved(at(p, 0)) || isPctEncoded(p) || isSubDelim(at(p, 0)) { p = next(p) }
    cur.* = p
    return false
}

fn authority(cur: *usize) -> bool {
    var p = cur.*
    if userinfo(&p) || at(p, 0) != 64 {
        p = cur.*
    } else {
        p += 1
    }
    if host(&p) { return true }
    if at(p, 0) == 58 {
        p += 1
        if port(&p) { return true }
    }
    cur.* = p
    return false
}

fn segment(cur: *usize, forbid: u64, empty: bool) -> bool {
    var p = cur.*
    if !isPchar(p) { return !empty }
    while isPchar(p) && at(p, 0) != forbid { p = next(p) }
    cur.* = p
    return false
}

fn pathAbEmpty(cur: *usize) -> bool {
    var p = cur.*
    while at(p, 0) == 47 {
        p += 1
        if segment(&p, 0, true) { return true }
    }
    cur.* = p
    return false
}

fn pathAbsolute(cur: *usize) -> bool {
    var p = cur.*
    if at(p, 0) != 47 { return true }
    p += 1
    if !segment(&p, 0, false) {
        while at(p, 0) == 47 {
            p += 1
            if segment(&p, 0, true) { return true }
        }
    }
    cur.* = p
    return false
}

fn pathRootless(cur: *usize, forbid: u64) -> bool {
    var p = cur.*
    if segment(&p, forbid, false) { return true }
    while at(p, 0) == 47 {
        p += 1
        if segment(&p, 0, true) { return true }
    }
    cur.* = p
    return false
}

fn hierPart(cur: *usize) -> bool {
    var p = cur.*
    if at(p, 0) == 47 && at(p, 1) == 47 {
        p += 2
        if authority(&p) { return true }
        if pathAbEmpty(&p) { return true }
        cur.* = p
        return false
    } else if at(p, 0) == 47 {
        if pathAbsolute(&p) { return true }
    } else if isPchar(p) {
        if pathRootless(&p, 0) { return true }
    }
    cur.* = p
    return false
}

// The end of a URI or reference: its query and fragment; whether all of
// the string was read.
fn tail(p0: usize, result: *Parsed) -> bool {
    var p = p0
    if at(p, 0) == 63 {
        p += 1
        query(&p)
    }
    if at(p, 0) == 35 {
        p += 1
        result.*.hasFragment = true
        fragment(&p)
    }
    return at(p, 0) == 0
}

fn absolute(s: usize, result: *Parsed) -> bool {
    var p = s
    if scheme(&p) { return false }
    if at(p, 0) != 58 { return false }
    p += 1
    if hierPart(&p) { return false }
    result.*.hasScheme = true
    return tail(p, result)
}

fn relative(s: usize, result: *Parsed) -> bool {
    var p = s
    if at(p, 0) == 47 && at(p, 1) == 47 {
        p += 2
        if authority(&p) { return false }
        if pathAbEmpty(&p) { return false }
    } else if at(p, 0) == 47 {
        if pathAbsolute(&p) { return false }
    } else if isPchar(p) {
        if pathRootless(&p, 58) { return false }
    }
    return tail(p, result)
}

// xmlParseURI of the C string S.
pub fn parse(s: usize) -> Parsed {
    var result: Parsed = undefined
    result.valid = false
    result.hasScheme = false
    result.hasFragment = false
    if s == 0 { return result }
    if absolute(s, &result) {
        result.valid = true
        return result
    }
    result.hasScheme = false
    result.hasFragment = false
    if relative(s, &result) {
        result.valid = true
        return result
    }
    result.hasFragment = false
    return result
}
