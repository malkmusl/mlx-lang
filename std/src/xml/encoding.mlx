// std.xml.encoding: the character encodings of XML documents, decoded
// to UTF-8 as libxml2 (2.9.14) decodes them (encoding.c): the encoding
// a document's first four bytes show (xmlDetectCharEncoding), the
// decoders libxml2 has of its own (UTF-8, UTF-16LE, UTF-16BE, UTF-16,
// ISO-8859-1, ASCII) and, where libxml2 asks iconv, UCS-4 and the
// single-byte charsets of std.unicode.charmaps (ISO-8859-2 to -16,
// windows-125x, KOI8, IBM866, macintosh).
//
// A decoder converts what it can of a run of bytes and keeps the rest
// (a split sequence) for the next run; it stops at a byte the encoding
// does not have (an error, as iconv's EILSEQ) or, for ASCII, at a byte
// above 127 (where libxml2's asciiToUTF8 stops without one).
const text = @import("./text.mlx")
const charmaps = @import("std.unicode.charmaps")

// xmlCharEncoding.
pub const ENC_ERROR: i64 = -1
pub const ENC_NONE: i64 = 0
pub const ENC_UTF8: i64 = 1
pub const ENC_UTF16LE: i64 = 2
pub const ENC_UTF16BE: i64 = 3
pub const ENC_UCS4LE: i64 = 4
pub const ENC_UCS4BE: i64 = 5
pub const ENC_EBCDIC: i64 = 6
pub const ENC_UCS4_2143: i64 = 7
pub const ENC_UCS4_3412: i64 = 8
pub const ENC_UCS2: i64 = 9
pub const ENC_8859_1: i64 = 10
pub const ENC_8859_2: i64 = 11
pub const ENC_8859_9: i64 = 18
pub const ENC_2022_JP: i64 = 19
pub const ENC_SHIFT_JIS: i64 = 20
pub const ENC_EUC_JP: i64 = 21
pub const ENC_ASCII: i64 = 22

// The decoders (a handler's kind).
pub const KIND_NONE: u64 = 0
pub const KIND_UTF8: u64 = 1
pub const KIND_UTF16LE: u64 = 2
pub const KIND_UTF16BE: u64 = 3
// libxml2's "UTF-16" handler: little endian.
pub const KIND_UTF16: u64 = 4
pub const KIND_LATIN1: u64 = 5
pub const KIND_ASCII: u64 = 6
pub const KIND_UCS4BE: u64 = 7
pub const KIND_UCS4LE: u64 = 8
pub const KIND_CHARMAP: u64 = 9

// A handler: the decoder, the charset of a KIND_CHARMAP one, and how
// libxml2 names it (its own name, or the name iconv was asked for):
// the parser reads the first line of a document in an encoding of
// "UTF-16" names 90 bytes long, "UCS-4" 180, others 45.
pub const Handler = struct {
    kind: u64
    map: charmaps.Charmap
    firstLine: u64
    builtin: bool
}

pub fn handlerOf(kind: u64) -> Handler {
    var h: Handler = undefined
    h.kind = kind
    h.map = charmaps.Charmap.{ .table = 0, .c1 = false }
    h.firstLine = if kind == KIND_UTF16LE || kind == KIND_UTF16BE || kind == KIND_UTF16 { 90 } else if kind == KIND_UCS4BE || kind == KIND_UCS4LE { 180 } else { 45 }
    h.builtin = kind != KIND_UCS4BE && kind != KIND_UCS4LE && kind != KIND_CHARMAP
    return h
}

// Whether two handlers are the same one (xmlSwitchInputEncodingInt
// keeps a decoder it is given again): libxml2's own handlers are
// static, iconv's made anew each time.
pub fn sameHandler(a: Handler, b: Handler) -> bool {
    return a.kind == b.kind && a.builtin && b.builtin
}

// The handler's name as libxml2 has it, for those whose name decides
// something (the byte order marks skipped when switching).
pub fn isUTF16LEName(h: Handler) -> bool { return h.kind == KIND_UTF16LE || h.kind == KIND_UTF16 }
pub fn isUTF16BEName(h: Handler) -> bool { return h.kind == KIND_UTF16BE }
pub fn isUTF8Name(h: Handler) -> bool { return h.kind == KIND_UTF8 }

// xmlDetectCharEncoding.
pub fn detect(at: usize, count: usize) -> i64 {
    if count >= 4 {
        const a = text.get8(at)
        const b = text.get8(at + 1)
        const c = text.get8(at + 2)
        const d = text.get8(at + 3)
        if a == 0 && b == 0 && c == 0 && d == 0x3C { return ENC_UCS4BE }
        if a == 0x3C && b == 0 && c == 0 && d == 0 { return ENC_UCS4LE }
        if a == 0 && b == 0 && c == 0x3C && d == 0 { return ENC_UCS4_2143 }
        if a == 0 && b == 0x3C && c == 0 && d == 0 { return ENC_UCS4_3412 }
        if a == 0x4C && b == 0x6F && c == 0xA7 && d == 0x94 { return ENC_EBCDIC }
        if a == 0x3C && b == 0x3F && c == 0x78 && d == 0x6D { return ENC_UTF8 }
        if a == 0x3C && b == 0 && c == 0x3F && d == 0 { return ENC_UTF16LE }
        if a == 0 && b == 0x3C && c == 0 && d == 0x3F { return ENC_UTF16BE }
    }
    if count >= 3 {
        if text.get8(at) == 0xEF && text.get8(at + 1) == 0xBB && text.get8(at + 2) == 0xBF { return ENC_UTF8 }
    }
    if count >= 2 {
        if text.get8(at) == 0xFE && text.get8(at + 1) == 0xFF { return ENC_UTF16BE }
        if text.get8(at) == 0xFF && text.get8(at + 1) == 0xFE { return ENC_UTF16LE }
    }
    return ENC_NONE
}

// xmlGetCharEncodingHandler: the handler of an xmlCharEncoding; false
// when libxml2 has none (UTF-8 needs none; the UCS-4 orders 2143 and
// 3412, EBCDIC, UCS-2 and the Japanese encodings are not here).
pub fn handlerForEncoding(enc: i64, h: *Handler) -> bool {
    if enc == ENC_UTF16LE {
        h.* = handlerOf(KIND_UTF16LE)
        return true
    }
    if enc == ENC_UTF16BE {
        h.* = handlerOf(KIND_UTF16BE)
        return true
    }
    if enc == ENC_UCS4BE || enc == ENC_UCS4LE {
        // iconv's ISO-10646-UCS-4, which is big endian.
        h.* = handlerOf(KIND_UCS4BE)
        return true
    }
    if enc == ENC_8859_1 {
        h.* = handlerOf(KIND_LATIN1)
        return true
    }
    if enc > ENC_8859_1 && enc <= ENC_8859_9 {
        var name: [10]u8 = undefined
        name[0] = 73
        name[1] = 83
        name[2] = 79
        name[3] = 56
        name[4] = 56
        name[5] = 53
        name[6] = 57
        name[7] = 45
        name[8] = @intCast(u8, 48 + @intCast(u64, enc - ENC_8859_1 + 1))
        var map: charmaps.Charmap = undefined
        if charmaps.find(name[0..9], &map) {
            h.* = handlerOf(KIND_CHARMAP)
            h.*.map = map
            return true
        }
        return false
    }
    return false
}

fn normalized(name: usize, out: *[40]u8) -> usize {
    var n: usize = 0
    var at = name
    while text.get8(at) != 0 && n < 39 {
        var c = text.get8(at)
        if c >= 65 && c <= 90 { c += 32 }
        if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
            out.*[n] = @intCast(u8, c)
            n += 1
        }
        at += 1
    }
    return n
}

fn isName(s: []const u8, name: []const u8) -> bool {
    if s.length != name.length { return false }
    var index: usize = 0
    while index < s.length {
        if s[index] != name[index] { return false }
        index += 1
    }
    return true
}

// xmlFindCharEncodingHandler: the handler of an encoding's name (libxml2's
// own by their upper-case names, then the names iconv knows of the
// encodings here); false when there is none.
pub fn handlerForName(name: usize, h: *Handler) -> bool {
    if name == 0 || text.get8(name) == 0 { return false }
    if text.equalTextNoCase(name, "UTF-8") {
        h.* = handlerOf(KIND_UTF8)
        return true
    }
    if text.equalTextNoCase(name, "UTF-16LE") {
        h.* = handlerOf(KIND_UTF16LE)
        return true
    }
    if text.equalTextNoCase(name, "UTF-16BE") {
        h.* = handlerOf(KIND_UTF16BE)
        return true
    }
    if text.equalTextNoCase(name, "UTF-16") {
        h.* = handlerOf(KIND_UTF16)
        return true
    }
    if text.equalTextNoCase(name, "ISO-8859-1") {
        h.* = handlerOf(KIND_LATIN1)
        return true
    }
    if text.equalTextNoCase(name, "ASCII") || text.equalTextNoCase(name, "US-ASCII") {
        h.* = handlerOf(KIND_ASCII)
        return true
    }
    var buffer: [40]u8 = undefined
    const n = normalized(name, &buffer)
    const s = buffer[0..n]
    // iconv's names of these (as glibc's iconv knows them).
    var kind: u64 = KIND_NONE
    if isName(s, "utf8") {
        kind = KIND_UTF8
    } else if isName(s, "utf16le") || isName(s, "unicodelittle") {
        kind = KIND_UTF16LE
    } else if isName(s, "utf16be") || isName(s, "unicodebig") || isName(s, "utf16") {
        kind = KIND_UTF16BE
    } else if isName(s, "iso88591") || isName(s, "latin1") || isName(s, "l1") || isName(s, "isoir100") || isName(s, "cp819") || isName(s, "ibm819") || isName(s, "csisolatin1") || isName(s, "iso885911987") {
        kind = KIND_LATIN1
    } else if isName(s, "usascii") || isName(s, "ascii") || isName(s, "ansix341968") || isName(s, "iso646us") || isName(s, "us") || isName(s, "ibm367") || isName(s, "cp367") || isName(s, "csascii") {
        kind = KIND_ASCII
    } else if isName(s, "ucs4") || isName(s, "iso10646ucs4") || isName(s, "ucs4be") || isName(s, "utf32be") || isName(s, "utf32") {
        kind = KIND_UCS4BE
    } else if isName(s, "ucs4le") || isName(s, "utf32le") {
        kind = KIND_UCS4LE
    }
    if kind != KIND_NONE {
        h.* = handlerOf(kind)
        h.*.builtin = false
        if text.containsNoCase(name, "UTF-16") || text.containsNoCase(name, "UTF16") {
            h.*.firstLine = 90
        } else if text.containsNoCase(name, "UCS-4") || text.containsNoCase(name, "UCS4") {
            h.*.firstLine = 180
        } else {
            h.*.firstLine = 45
        }
        return true
    }
    var map: charmaps.Charmap = undefined
    if charmaps.find(text.bytes(name)[0..text.length(name)], &map) {
        h.* = handlerOf(KIND_CHARMAP)
        h.*.map = map
        return true
    }
    return false
}

// The result of a decoding: the bytes of INPUT used, and how it ended:
// 0 all decoded (but a split sequence at the end), -1 stopped without
// an error (ASCII above 127), -2 a byte the encoding does not have.
pub const Result = struct {
    used: usize
    status: i64
}

fn put16(out: *text.Buffer, c: u64) -> void {
    text.bufferAddChar(out, c)
}

// Decodes the COUNT bytes at IN onto OUT.
pub fn decode(h: Handler, source: usize, count: usize, out: *text.Buffer) -> Result {
    var r: Result = undefined
    r.used = 0
    r.status = 0
    const kind = h.kind
    if !text.bufferReserve(out, count * 3 + 8) {
        r.status = -2
        return r
    }
    if kind == KIND_UTF8 {
        text.bufferAdd(out, source, count)
        r.used = count
        return r
    }
    if kind == KIND_LATIN1 {
        var i: usize = 0
        while i < count {
            text.bufferAddChar(out, text.get8(source + i))
            i += 1
        }
        r.used = count
        return r
    }
    if kind == KIND_ASCII {
        var i: usize = 0
        while i < count {
            const c = text.get8(source + i)
            if c >= 0x80 {
                r.used = i
                r.status = -1
                return r
            }
            text.bufferAddByte(out, c)
            i += 1
        }
        r.used = count
        return r
    }
    if kind == KIND_UTF16LE || kind == KIND_UTF16 || kind == KIND_UTF16BE {
        const big = kind == KIND_UTF16BE
        var i: usize = 0
        while i + 2 <= count {
            var c = if big { (text.get8(source + i) << 8) | text.get8(source + i + 1) } else { text.get8(source + i) | (text.get8(source + i + 1) << 8) }
            var step: usize = 2
            if (c & 0xFC00) == 0xD800 {
                if i + 4 > count { break }
                const d = if big { (text.get8(source + i + 2) << 8) | text.get8(source + i + 3) } else { text.get8(source + i + 2) | (text.get8(source + i + 3) << 8) }
                if (d & 0xFC00) == 0xDC00 {
                    c = (((c & 0x3FF) << 10) | (d & 0x3FF)) + 0x10000
                    step = 4
                } else {
                    r.used = i
                    r.status = -2
                    return r
                }
            }
            text.bufferAddChar(out, c)
            i += step
        }
        r.used = i
        return r
    }
    if kind == KIND_UCS4BE || kind == KIND_UCS4LE {
        var i: usize = 0
        while i + 4 <= count {
            var c: u64 = 0
            if kind == KIND_UCS4BE {
                c = (text.get8(source + i) << 24) | (text.get8(source + i + 1) << 16) | (text.get8(source + i + 2) << 8) | text.get8(source + i + 3)
            } else {
                c = text.get8(source + i) | (text.get8(source + i + 1) << 8) | (text.get8(source + i + 2) << 16) | (text.get8(source + i + 3) << 24)
            }
            if c > 0x10FFFF || (c >= 0xD800 && c <= 0xDFFF) {
                r.used = i
                r.status = -2
                return r
            }
            text.bufferAddChar(out, c)
            i += 4
        }
        r.used = i
        return r
    }
    if kind == KIND_CHARMAP {
        var i: usize = 0
        while i < count {
            const c = charmaps.decode(h.map, @intCast(u8, text.get8(source + i)))
            if c == charmaps.NONE {
                r.used = i
                r.status = -2
                return r
            }
            text.bufferAddChar(out, @intCast(u64, c))
            i += 1
        }
        r.used = count
        return r
    }
    r.status = -2
    return r
}
