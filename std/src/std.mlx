// The generic containers (std/src/containers): `std.ArrayList(T)`,
// `std.AutoHashMap(K, V)`, `std.StringHashMap(V)`, `std.AutoHashSet(K)`,
// `std.HashMap(K, V, Context)` name the same instances as the modules'
// own functions do.
const containers_array_list = @import("./containers/array_list.mlx")
const containers_hash_map = @import("./containers/hash_map.mlx")
pub fn ArrayList(comptime T: type) -> type { return containers_array_list.ArrayList(T) }
pub fn HashMap(comptime K: type, comptime V: type, comptime Context: type) -> type { return containers_hash_map.HashMap(K, V, Context) }
pub fn AutoHashMap(comptime K: type, comptime V: type) -> type { return containers_hash_map.AutoHashMap(K, V) }
pub fn StringHashMap(comptime V: type) -> type { return containers_hash_map.StringHashMap(V) }
pub fn AutoHashSet(comptime K: type) -> type { return containers_hash_map.AutoHashSet(K) }
