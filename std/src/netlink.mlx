// std.netlink: Linux netlink sockets (AF_NETLINK) without libc. Route
// netlink (NETLINK_ROUTE) lists and changes the network's links, IPv4
// addresses and routes, and tells their changes to the multicast groups a
// socket joins; generic netlink (NETLINK_GENERIC) reaches families named
// at run time, as nl80211 (Wi-Fi).
//
// A message is built with a Builder over the caller's buffer (begin, the
// family's fixed header, attributes, finish) and sent; what comes back is
// read with nextMessage and nextAttribute. transact sends a request that
// asks for an acknowledgement and waits for it (0, or a negative errno).
const std = @import("std")

pub const ROUTE: usize = 0
pub const GENERIC: usize = 16

// Message types.
pub const NLMSG_NOOP: u16 = 1
pub const NLMSG_ERROR: u16 = 2
pub const NLMSG_DONE: u16 = 3
pub const RTM_NEWLINK: u16 = 16
pub const RTM_DELLINK: u16 = 17
pub const RTM_GETLINK: u16 = 18
pub const RTM_NEWADDR: u16 = 20
pub const RTM_DELADDR: u16 = 21
pub const RTM_GETADDR: u16 = 22
pub const RTM_NEWROUTE: u16 = 24
pub const RTM_DELROUTE: u16 = 25
pub const RTM_GETROUTE: u16 = 26
pub const GENL_ID_CTRL: u16 = 16

// Flags.
pub const F_REQUEST: u16 = 1
pub const F_MULTI: u16 = 2
pub const F_ACK: u16 = 4
pub const F_DUMP: u16 = 768
pub const F_REPLACE: u16 = 256
pub const F_EXCL: u16 = 512
pub const F_CREATE: u16 = 1024

// Route multicast groups (bits for bind).
pub const GROUP_LINK: u32 = 1
pub const GROUP_IPV4_ADDRESS: u32 = 16
pub const GROUP_IPV4_ROUTE: u32 = 64

// Link attributes and flags.
pub const IFLA_ADDRESS: u16 = 1
pub const IFLA_IFNAME: u16 = 3
pub const IFLA_MTU: u16 = 4
pub const IFLA_WIRELESS: u16 = 11
pub const IFLA_OPERSTATE: u16 = 16
pub const IFF_UP: u32 = 1
pub const IFF_LOOPBACK: u32 = 8
pub const IFF_RUNNING: u32 = 64
pub const IFF_LOWER_UP: u32 = 65536

// Address and route attributes.
pub const IFA_ADDRESS: u16 = 1
pub const IFA_LOCAL: u16 = 2
pub const IFA_BROADCAST: u16 = 4
pub const RTA_DST: u16 = 1
pub const RTA_OIF: u16 = 4
pub const RTA_GATEWAY: u16 = 5
pub const RTA_PRIORITY: u16 = 6
pub const RTA_TABLE: u16 = 15

pub const AF_UNSPEC: u8 = 0
pub const AF_INET: u8 = 2
pub const RT_TABLE_MAIN: u8 = 254
pub const RTPROT_STATIC: u8 = 4
pub const RTPROT_DHCP: u8 = 16
pub const RT_SCOPE_UNIVERSE: u8 = 0
pub const RT_SCOPE_LINK: u8 = 253
pub const RTN_UNICAST: u8 = 1

// Generic netlink's controller.
pub const CTRL_CMD_GETFAMILY: u8 = 3
pub const CTRL_ATTR_FAMILY_ID: u16 = 1
pub const CTRL_ATTR_FAMILY_NAME: u16 = 2
pub const CTRL_ATTR_MCAST_GROUPS: u16 = 7
pub const CTRL_ATTR_MCAST_GRP_NAME: u16 = 1
pub const CTRL_ATTR_MCAST_GRP_ID: u16 = 2
// A nested attribute's type carries this bit.
pub const NLA_F_NESTED: u16 = 32768

const SYS_close: usize = 3
const SYS_poll: usize = 7
const SYS_socket: usize = 41
const SYS_sendto: usize = 44
const SYS_recvfrom: usize = 45
const SYS_bind: usize = 49
const SYS_getsockname: usize = 51
const SYS_setsockopt: usize = 54
const AF_NETLINK: usize = 16
const SOCK_RAW: usize = 3
const SOCK_CLOEXEC: usize = 524288
const MSG_DONTWAIT: usize = 64
const SOL_NETLINK: usize = 270
const NETLINK_ADD_MEMBERSHIP: usize = 1
const POLLIN: u16 = 1
const EINTR: isize = -4

pub const Socket = struct {
    descriptor: isize
    // The socket's address (the kernel's answers name it), the last
    // sequence number used.
    port: u32
    sequence: u32
}

// sockaddr_nl.
const Address = struct {
    family: u16
    pad: u16
    port: u32
    groups: u32
}

// Opens a socket of `protocol` (ROUTE, GENERIC) that joins `groups`
// (GROUP_*; 0: none); false when the kernel refuses.
pub fn open(socket: *Socket, protocol: usize, groups: u32) -> bool {
    const descriptor = std.linux.syscall3(SYS_socket, AF_NETLINK, SOCK_RAW | SOCK_CLOEXEC, protocol)
    socket.*.descriptor = descriptor
    socket.*.sequence = 0
    socket.*.port = 0
    if descriptor < 0 { return false }
    var address = Address.{ .family = @intCast(u16, AF_NETLINK), .pad = 0, .port = 0, .groups = groups }
    if std.linux.syscall3(SYS_bind, @bitCast(usize, descriptor), @intFromPtr(&address), 12) < 0 {
        close(socket)
        return false
    }
    var length: u32 = 12
    _ = std.linux.syscall3(SYS_getsockname, @bitCast(usize, descriptor), @intFromPtr(&address), @intFromPtr(&length))
    socket.*.port = address.port
    return true
}

// Joins generic netlink multicast group `group` (a family's, by id).
pub fn join(socket: *Socket, group: u32) -> bool {
    var value = group
    return std.linux.syscall5(SYS_setsockopt, @bitCast(usize, socket.*.descriptor), SOL_NETLINK, NETLINK_ADD_MEMBERSHIP, @intFromPtr(&value), 4) == 0
}

pub fn close(socket: *Socket) -> void {
    if socket.*.descriptor >= 0 { _ = std.linux.syscall1(SYS_close, @bitCast(usize, socket.*.descriptor)) }
    socket.*.descriptor = -1
}

// ---------------------------------------------------------------------------
// Building

pub const Builder = struct {
    bytes: [*]u8
    capacity: usize
    length: usize
    // Where the message started (its header).
    start: usize
    failed: bool
    sequence: u32
}

fn store16(bytes: [*]u8, at: usize, value: u16) -> void {
    bytes[at] = @intCast(u8, value & 255)
    bytes[at + 1] = @intCast(u8, value >> 8)
}

fn store32(bytes: [*]u8, at: usize, value: u32) -> void {
    bytes[at] = @intCast(u8, value & 255)
    bytes[at + 1] = @intCast(u8, (value >> 8) & 255)
    bytes[at + 2] = @intCast(u8, (value >> 16) & 255)
    bytes[at + 3] = @intCast(u8, value >> 24)
}

pub fn load16(bytes: [*]const u8, at: usize) -> u16 { return @intCast(u16, bytes[at]) | (@intCast(u16, bytes[at + 1]) << 8) }

pub fn load32(bytes: [*]const u8, at: usize) -> u32 {
    return @intCast(u32, bytes[at]) | (@intCast(u32, bytes[at + 1]) << 8) | (@intCast(u32, bytes[at + 2]) << 16) | (@intCast(u32, bytes[at + 3]) << 24)
}

fn room(builder: *Builder, size: usize) -> bool {
    if builder.*.failed || builder.*.length + size > builder.*.capacity {
        builder.*.failed = true
        return false
    }
    return true
}

// Zeros up to the next multiple of 4.
fn align4(builder: *Builder) -> void {
    while builder.*.length % 4 != 0 && room(builder, 1) {
        builder.*.bytes[builder.*.length] = 0
        builder.*.length += 1
    }
}

// A message of `kind` with `flags` (F_REQUEST is added) into `bytes`.
pub fn begin(builder: *Builder, socket: *Socket, bytes: [*]u8, capacity: usize, kind: u16, flags: u16) -> void {
    builder.*.bytes = bytes
    builder.*.capacity = capacity
    builder.*.length = 0
    builder.*.start = 0
    builder.*.failed = false
    socket.*.sequence += 1
    builder.*.sequence = socket.*.sequence
    if !room(builder, 16) { return }
    store32(bytes, 0, 0)
    store16(bytes, 4, kind)
    store16(bytes, 6, flags | F_REQUEST)
    store32(bytes, 8, socket.*.sequence)
    store32(bytes, 12, socket.*.port)
    builder.*.length = 16
}

pub fn putU8(builder: *Builder, value: u8) -> void {
    if !room(builder, 1) { return }
    builder.*.bytes[builder.*.length] = value
    builder.*.length += 1
}

pub fn putU16(builder: *Builder, value: u16) -> void {
    if !room(builder, 2) { return }
    store16(builder.*.bytes, builder.*.length, value)
    builder.*.length += 2
}

pub fn putU32(builder: *Builder, value: u32) -> void {
    if !room(builder, 4) { return }
    store32(builder.*.bytes, builder.*.length, value)
    builder.*.length += 4
}

pub fn putBytes(builder: *Builder, data: []const u8) -> void {
    if !room(builder, data.length) { return }
    for byte in data {
        builder.*.bytes[builder.*.length] = byte
        builder.*.length += 1
    }
}

// ifinfomsg: a link's fixed header.
pub fn putLink(builder: *Builder, family: u8, index: u32, flags: u32, change: u32) -> void {
    putU8(builder, family)
    putU8(builder, 0)
    putU16(builder, 0)
    putU32(builder, index)
    putU32(builder, flags)
    putU32(builder, change)
}

// ifaddrmsg: an address's.
pub fn putAddress(builder: *Builder, family: u8, prefix: u8, flags: u8, scope: u8, index: u32) -> void {
    putU8(builder, family)
    putU8(builder, prefix)
    putU8(builder, flags)
    putU8(builder, scope)
    putU32(builder, index)
}

// rtmsg: a route's.
pub fn putRoute(builder: *Builder, family: u8, destination_prefix: u8, table: u8, protocol: u8, scope: u8, kind: u8) -> void {
    putU8(builder, family)
    putU8(builder, destination_prefix)
    putU8(builder, 0)
    putU8(builder, 0)
    putU8(builder, table)
    putU8(builder, protocol)
    putU8(builder, scope)
    putU8(builder, kind)
    putU32(builder, 0)
}

// genlmsghdr: a generic netlink command.
pub fn putCommand(builder: *Builder, command: u8, version: u8) -> void {
    putU8(builder, command)
    putU8(builder, version)
    putU16(builder, 0)
}

// An attribute of `kind` holding `data` (padded to 4 bytes).
pub fn attribute(builder: *Builder, kind: u16, data: []const u8) -> void {
    align4(builder)
    if !room(builder, 4 + data.length) { return }
    store16(builder.*.bytes, builder.*.length, @intCast(u16, 4 + data.length))
    store16(builder.*.bytes, builder.*.length + 2, kind)
    builder.*.length += 4
    putBytes(builder, data)
    align4(builder)
}

pub fn attributeU32(builder: *Builder, kind: u16, value: u32) -> void {
    var bytes: [4]u8 = undefined
    const view: [*]u8 = &bytes
    store32(view, 0, value)
    attribute(builder, kind, view[0..4])
}

pub fn attributeU16(builder: *Builder, kind: u16, value: u16) -> void {
    var bytes: [2]u8 = undefined
    const view: [*]u8 = &bytes
    store16(view, 0, value)
    attribute(builder, kind, view[0..2])
}

pub fn attributeU8(builder: *Builder, kind: u16, value: u8) -> void {
    var bytes: [1]u8 = [1]u8{ value }
    const view: [*]u8 = &bytes
    attribute(builder, kind, view[0..1])
}

// A string with its NUL.
pub fn attributeString(builder: *Builder, kind: u16, text: []const u8) -> void {
    align4(builder)
    if !room(builder, 5 + text.length) { return }
    store16(builder.*.bytes, builder.*.length, @intCast(u16, 5 + text.length))
    store16(builder.*.bytes, builder.*.length + 2, kind)
    builder.*.length += 4
    putBytes(builder, text)
    putU8(builder, 0)
    align4(builder)
}

pub fn attributeFlag(builder: *Builder, kind: u16) -> void {
    align4(builder)
    if !room(builder, 4) { return }
    store16(builder.*.bytes, builder.*.length, 4)
    store16(builder.*.bytes, builder.*.length + 2, kind)
    builder.*.length += 4
}

// A nested attribute: its start (for endNest).
pub fn beginNest(builder: *Builder, kind: u16) -> usize {
    align4(builder)
    const at = builder.*.length
    if !room(builder, 4) { return at }
    store16(builder.*.bytes, at, 4)
    store16(builder.*.bytes, at + 2, kind | NLA_F_NESTED)
    builder.*.length += 4
    return at
}

pub fn endNest(builder: *Builder, at: usize) -> void {
    align4(builder)
    if builder.*.failed { return }
    store16(builder.*.bytes, at, @intCast(u16, builder.*.length - at))
}

// The message's length into its header.
pub fn finish(builder: *Builder) -> void {
    align4(builder)
    if builder.*.failed { return }
    store32(builder.*.bytes, builder.*.start, @intCast(u32, builder.*.length - builder.*.start))
}

// Sends the built message to the kernel; false when it could not.
pub fn send(socket: *Socket, builder: *Builder) -> bool {
    finish(builder)
    if builder.*.failed { return false }
    var kernel = Address.{ .family = @intCast(u16, AF_NETLINK), .pad = 0, .port = 0, .groups = 0 }
    while true {
        const sent = std.linux.syscall6(SYS_sendto, @bitCast(usize, socket.*.descriptor), @intFromPtr(builder.*.bytes), builder.*.length, 0, @intFromPtr(&kernel), 12)
        if sent == EINTR { continue }
        return sent == @intCast(isize, builder.*.length)
    }
    return false
}

// ---------------------------------------------------------------------------
// Reading

// Waits up to `timeout` milliseconds (-1: for ever, 0: not) for something
// to read; then reads one datagram into `bytes`. Its length; 0 when there
// was nothing, negative on an error.
pub fn receive(socket: *Socket, bytes: [*]u8, capacity: usize, timeout: isize) -> isize {
    var poll: [8]u8 = undefined
    const view: [*]u8 = &poll
    store32(view, 0, @bitCast(u32, @intCast(i32, socket.*.descriptor)))
    store16(view, 4, POLLIN)
    store16(view, 6, 0)
    while true {
        const ready = std.linux.syscall3(SYS_poll, @intFromPtr(view), 1, @bitCast(usize, timeout))
        if ready == EINTR { continue }
        if ready <= 0 { return ready }
        break
    }
    while true {
        const count = std.linux.syscall6(SYS_recvfrom, @bitCast(usize, socket.*.descriptor), @intFromPtr(bytes), capacity, MSG_DONTWAIT, 0, 0)
        if count == EINTR { continue }
        return count
    }
    return -1
}

pub const Message = struct {
    kind: u16
    flags: u16
    sequence: u32
    port: u32
    // What follows the header.
    payload: [*]const u8
    length: usize
}

// The message at `offset.*` in `bytes[0..length]` (offset moves past it);
// false when there is none left.
pub fn nextMessage(bytes: [*]const u8, length: usize, offset: *usize, message: *Message) -> bool {
    const at = offset.*
    if at + 16 > length { return false }
    const size = @intCast(usize, load32(bytes, at))
    if size < 16 || at + size > length { return false }
    message.*.kind = load16(bytes, at + 4)
    message.*.flags = load16(bytes, at + 6)
    message.*.sequence = load32(bytes, at + 8)
    message.*.port = load32(bytes, at + 12)
    message.*.payload = bytes + at + 16
    message.*.length = size - 16
    offset.* = at + ((size + 3) / 4) * 4
    return true
}

// An NLMSG_ERROR's error (0: an acknowledgement; else a negative errno).
pub fn errorOf(message: *const Message) -> i32 {
    if message.*.length < 4 { return -5 }
    return @bitCast(i32, load32(message.*.payload, 0))
}

pub const Attribute = struct {
    kind: u16
    data: [*]const u8
    length: usize
}

// The attribute at `offset.*` in `bytes[0..length]` (offset moves past
// it); false when there is none left. The kind is without NLA_F_NESTED.
pub fn nextAttribute(bytes: [*]const u8, length: usize, offset: *usize, found: *Attribute) -> bool {
    const at = offset.*
    if at + 4 > length { return false }
    const size = @intCast(usize, load16(bytes, at))
    if size < 4 || at + size > length { return false }
    found.*.kind = load16(bytes, at + 2) & 16383
    found.*.data = bytes + at + 4
    found.*.length = size - 4
    offset.* = at + ((size + 3) / 4) * 4
    return true
}

pub fn u32Of(found: *const Attribute) -> u32 { return if found.*.length >= 4 { load32(found.*.data, 0) } else { 0 } }

pub fn u16Of(found: *const Attribute) -> u16 { return if found.*.length >= 2 { load16(found.*.data, 0) } else { 0 } }

pub fn u8Of(found: *const Attribute) -> u8 { return if found.*.length >= 1 { found.*.data[0] } else { 0 } }

// A string attribute without its NUL.
pub fn stringOf(found: *const Attribute) -> []const u8 {
    var length = found.*.length
    while length > 0 && found.*.data[length - 1] == 0 { length -= 1 }
    return found.*.data[0..length]
}

pub fn bytesOf(found: *const Attribute) -> []const u8 { return found.*.data[0..found.*.length] }

// ---------------------------------------------------------------------------
// Requests

// Sends the built request (asking for an acknowledgement) and waits for
// its answer: 0, or a negative errno (-110: no answer in time).
pub fn transact(socket: *Socket, builder: *Builder, scratch: [*]u8, capacity: usize) -> i32 {
    // The flags with F_ACK.
    if !builder.*.failed && builder.*.length >= 16 { store16(builder.*.bytes, 6, load16(builder.*.bytes, 6) | F_ACK) }
    const sequence = builder.*.sequence
    if !send(socket, builder) { return -12 }
    var waited = 0
    while waited < 20 {
        const count = receive(socket, scratch, capacity, 250)
        if count < 0 { return @intCast(i32, count) }
        if count == 0 {
            waited += 1
            continue
        }
        var offset: usize = 0
        var message: Message = undefined
        while nextMessage(scratch, @intCast(usize, count), &offset, &message) {
            if message.sequence == sequence && message.kind == NLMSG_ERROR { return errorOf(&message) }
        }
    }
    return -110
}

// Puts link `index` up or down.
pub fn setLinkUp(socket: *Socket, scratch: [*]u8, capacity: usize, index: u32, up: bool) -> i32 {
    var request: [64]u8 = undefined
    const bytes: [*]u8 = &request
    var builder: Builder = undefined
    begin(&builder, socket, bytes, 64, RTM_NEWLINK, 0)
    putLink(&builder, AF_UNSPEC, index, if up { IFF_UP } else { 0 }, IFF_UP)
    return transact(socket, &builder, scratch, capacity)
}

// Adds (or with `remove` takes away) IPv4 address `address`/`prefix` on
// link `index` (the broadcast address from them).
pub fn changeAddress(socket: *Socket, scratch: [*]u8, capacity: usize, index: u32, address: [4]u8, prefix: u8, remove: bool) -> i32 {
    var request: [128]u8 = undefined
    const bytes: [*]u8 = &request
    var builder: Builder = undefined
    begin(&builder, socket, bytes, 128, if remove { RTM_DELADDR } else { RTM_NEWADDR }, if remove { 0 } else { F_CREATE | F_REPLACE })
    putAddress(&builder, AF_INET, prefix, 0, RT_SCOPE_UNIVERSE, index)
    var copy = address
    const view: [*]u8 = &copy
    attribute(&builder, IFA_LOCAL, view[0..4])
    attribute(&builder, IFA_ADDRESS, view[0..4])
    // The broadcast address: the host part all ones.
    var broadcast = address
    var host_bits: u32 = if prefix >= 32 { 0 } else { 32 - @intCast(u32, prefix) }
    var byte: usize = 4
    while byte > 0 && host_bits > 0 {
        byte -= 1
        const take: u32 = if host_bits >= 8 { 8 } else { host_bits }
        const one: u32 = 1
        const ones: u32 = (one << @intCast(u5, take)) - 1
        broadcast[byte] = broadcast[byte] | @intCast(u8, ones & 255)
        host_bits -= take
    }
    const broadcast_view: [*]u8 = &broadcast
    if prefix < 31 { attribute(&builder, IFA_BROADCAST, broadcast_view[0..4]) }
    return transact(socket, &builder, scratch, capacity)
}

// Adds (or takes away) the default route through `gateway` on link
// `index` with `metric`, for `protocol` (RTPROT_DHCP, RTPROT_STATIC).
pub fn changeDefaultRoute(socket: *Socket, scratch: [*]u8, capacity: usize, index: u32, gateway: [4]u8, metric: u32, protocol: u8, remove: bool) -> i32 {
    var request: [128]u8 = undefined
    const bytes: [*]u8 = &request
    var builder: Builder = undefined
    begin(&builder, socket, bytes, 128, if remove { RTM_DELROUTE } else { RTM_NEWROUTE }, if remove { 0 } else { F_CREATE | F_REPLACE })
    putRoute(&builder, AF_INET, 0, RT_TABLE_MAIN, protocol, RT_SCOPE_UNIVERSE, RTN_UNICAST)
    var copy = gateway
    const view: [*]u8 = &copy
    attribute(&builder, RTA_GATEWAY, view[0..4])
    attributeU32(&builder, RTA_OIF, index)
    attributeU32(&builder, RTA_PRIORITY, metric)
    return transact(socket, &builder, scratch, capacity)
}

// Asks for all links (RTM_GETLINK dump; the answers come as RTM_NEWLINK
// messages up to NLMSG_DONE).
pub fn dumpLinks(socket: *Socket) -> bool {
    var request: [64]u8 = undefined
    const bytes: [*]u8 = &request
    var builder: Builder = undefined
    begin(&builder, socket, bytes, 64, RTM_GETLINK, F_DUMP)
    putLink(&builder, AF_UNSPEC, 0, 0, 0)
    return send(socket, &builder)
}

// Asks for all IPv4 addresses (RTM_NEWADDR messages up to NLMSG_DONE).
pub fn dumpAddresses(socket: *Socket) -> bool {
    var request: [64]u8 = undefined
    const bytes: [*]u8 = &request
    var builder: Builder = undefined
    begin(&builder, socket, bytes, 64, RTM_GETADDR, F_DUMP)
    putAddress(&builder, AF_INET, 0, 0, 0, 0)
    return send(socket, &builder)
}

// A link's message (RTM_NEWLINK, RTM_DELLINK): its fixed header.
pub const Link = struct {
    index: u32
    flags: u32
    kind: u16
}

pub fn linkOf(message: *const Message, link: *Link) -> bool {
    if message.*.length < 16 { return false }
    link.*.kind = load16(message.*.payload, 2)
    link.*.index = load32(message.*.payload, 4)
    link.*.flags = load32(message.*.payload, 8)
    return true
}

// Its attributes start here.
pub const LINK_HEADER: usize = 16
pub const ADDRESS_HEADER: usize = 8
pub const ROUTE_HEADER: usize = 12
pub const COMMAND_HEADER: usize = 4

// The family id of generic netlink family `name` (0: none such), and the
// id of its multicast group `group` into `group_id` (0: none such).
pub fn family(socket: *Socket, scratch: [*]u8, capacity: usize, name: []const u8, group: []const u8, group_id: *u32) -> u16 {
    group_id.* = 0
    var request: [96]u8 = undefined
    const bytes: [*]u8 = &request
    var builder: Builder = undefined
    begin(&builder, socket, bytes, 96, GENL_ID_CTRL, 0)
    putCommand(&builder, CTRL_CMD_GETFAMILY, 1)
    attributeString(&builder, CTRL_ATTR_FAMILY_NAME, name)
    const sequence = builder.sequence
    if !send(socket, &builder) { return 0 }
    var waited = 0
    while waited < 20 {
        const count = receive(socket, scratch, capacity, 250)
        if count < 0 { return 0 }
        if count == 0 {
            waited += 1
            continue
        }
        var offset: usize = 0
        var message: Message = undefined
        while nextMessage(scratch, @intCast(usize, count), &offset, &message) {
            if message.sequence != sequence { continue }
            if message.kind == NLMSG_ERROR { return 0 }
            var id: u16 = 0
            var at: usize = COMMAND_HEADER
            var found: Attribute = undefined
            while nextAttribute(message.payload, message.length, &at, &found) {
                if found.kind == CTRL_ATTR_FAMILY_ID { id = u16Of(&found) }
                if found.kind == CTRL_ATTR_MCAST_GROUPS && group.length > 0 {
                    var outer: usize = 0
                    var entry: Attribute = undefined
                    while nextAttribute(found.data, found.length, &outer, &entry) {
                        var inner: usize = 0
                        var part: Attribute = undefined
                        var entry_name: []const u8 = ""
                        var entry_id: u32 = 0
                        while nextAttribute(entry.data, entry.length, &inner, &part) {
                            if part.kind == CTRL_ATTR_MCAST_GRP_NAME { entry_name = stringOf(&part) }
                            if part.kind == CTRL_ATTR_MCAST_GRP_ID { entry_id = u32Of(&part) }
                        }
                        if sameText(entry_name, group) { group_id.* = entry_id }
                    }
                }
            }
            return id
        }
    }
    return 0
}

fn sameText(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}
