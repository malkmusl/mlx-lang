// The nv12 shader (std.gpu.video's colour conversion): part of
// std.gpu.shaders, built with std.spirv.builder. See shaders.mlx for the
// kernel's contract (bindings, push constants).
const spv = @import("std.spirv.core")
const builder = @import("std.spirv.builder")
const compute = @import("std.spirv.compute")
const shaders = @import("std.gpu.shaders")

fn uop(b: *builder.Builder, common: *const shaders.Common, opcode: spv.Op, left: u32, right: u32) -> u32 {
    return builder.binary(b, opcode, common.*.uint, left, right)
}

fn iop(b: *builder.Builder, common: *const shaders.Common, opcode: spv.Op, left: u32, right: u32) -> u32 {
    return builder.binary(b, opcode, common.*.int, left, right)
}

// Byte `index` of the source buffer (binding 0, words).
fn byteAt(b: *builder.Builder, common: *const shaders.Common, index: u32) -> u32 {
    const word = builder.load(b, common.*.uint, compute.element(b, common, common.*.buffers[0], uop(b, common, spv.Op.shiftRightLogical, index, compute.constant(b, common, 2))))
    const shift = uop(b, common, spv.Op.shiftLeftLogical, uop(b, common, spv.Op.bitwiseAnd, index, compute.constant(b, common, 3)), compute.constant(b, common, 3))
    return uop(b, common, spv.Op.bitwiseAnd, uop(b, common, spv.Op.shiftRightLogical, word, shift), compute.constant(b, common, 255))
}

// A 16.16 value to a channel: >> 16, clamped to 0..255, unsigned.
fn channelOf(b: *builder.Builder, common: *const shaders.Common, value: u32) -> u32 {
    const shifted = iop(b, common, spv.Op.shiftRightArithmetic, value, shaders.intConstant(b, common, 16))
    const low = compute.select(b, common.*.int, builder.binary(b, spv.Op.sLessThan, common.*.boolean, shifted, shaders.intConstant(b, common, 0)), shaders.intConstant(b, common, 0), shifted)
    const high = compute.select(b, common.*.int, builder.binary(b, spv.Op.sGreaterThan, common.*.boolean, low, shaders.intConstant(b, common, 255)), shaders.intConstant(b, common, 255), low)
    return shaders.unsigned(b, common, high)
}

pub fn buildNv12(b: *builder.Builder) -> void {
    var common: shaders.Common = undefined
    compute.declare(b, &common, shaders.NV12_WORDS, 2, false)
    const main = builder.function(b, common.voidType, spv.FUNCTION_CONTROL_NONE, common.functionType)
    _ = builder.label(b)
    const id = builder.load(b, common.uvec3, common.globalId)
    const x = builder.compositeExtract(b, common.uint, id, 0)
    const y = builder.compositeExtract(b, common.uint, id, 1)
    const width = compute.pushWord(b, &common, 0)
    const height = compute.pushWord(b, &common, 1)
    const luma_offset = compute.pushWord(b, &common, 2)
    const luma_stride = compute.pushWord(b, &common, 3)
    const chroma_offset = compute.pushWord(b, &common, 4)
    const chroma_stride = compute.pushWord(b, &common, 5)
    const target_offset = compute.pushWord(b, &common, 6)
    const target_stride = compute.pushWord(b, &common, 7)
    const y_bias = shaders.signed(b, &common, compute.pushWord(b, &common, 8))
    const y_scale = shaders.signed(b, &common, compute.pushWord(b, &common, 9))
    const r_cr = shaders.signed(b, &common, compute.pushWord(b, &common, 10))
    const g_cb = shaders.signed(b, &common, compute.pushWord(b, &common, 11))
    const g_cr = shaders.signed(b, &common, compute.pushWord(b, &common, 12))
    const b_cb = shaders.signed(b, &common, compute.pushWord(b, &common, 13))
    const inside = builder.binary(b, spv.Op.logicalAnd, common.boolean, builder.binary(b, spv.Op.uLessThan, common.boolean, x, width), builder.binary(b, spv.Op.uLessThan, common.boolean, y, height))
    const body = builder.newId(b)
    const merge = builder.newId(b)
    builder.selectionMerge(b, merge)
    builder.branchConditional(b, inside, body, merge)

    _ = builder.labelWith(b, body)
    const one = compute.constant(b, &common, 1)
    const luma = byteAt(b, &common, uop(b, &common, spv.Op.iAdd, luma_offset, uop(b, &common, spv.Op.iAdd, uop(b, &common, spv.Op.iMul, y, luma_stride), x)))
    const chroma_row = uop(b, &common, spv.Op.iMul, uop(b, &common, spv.Op.shiftRightLogical, y, one), chroma_stride)
    const chroma_column = uop(b, &common, spv.Op.shiftLeftLogical, uop(b, &common, spv.Op.shiftRightLogical, x, one), one)
    const chroma_index = uop(b, &common, spv.Op.iAdd, chroma_offset, uop(b, &common, spv.Op.iAdd, chroma_row, chroma_column))
    const cb = iop(b, &common, spv.Op.iSub, shaders.signed(b, &common, byteAt(b, &common, chroma_index)), shaders.intConstant(b, &common, 128))
    const cr = iop(b, &common, spv.Op.iSub, shaders.signed(b, &common, byteAt(b, &common, uop(b, &common, spv.Op.iAdd, chroma_index, one))), shaders.intConstant(b, &common, 128))
    const scaled = iop(b, &common, spv.Op.iAdd, iop(b, &common, spv.Op.iMul, iop(b, &common, spv.Op.iSub, shaders.signed(b, &common, luma), y_bias), y_scale), shaders.intConstant(b, &common, 32768))
    const red = channelOf(b, &common, iop(b, &common, spv.Op.iAdd, scaled, iop(b, &common, spv.Op.iMul, cr, r_cr)))
    const green = channelOf(b, &common, iop(b, &common, spv.Op.iAdd, scaled, iop(b, &common, spv.Op.iAdd, iop(b, &common, spv.Op.iMul, cb, g_cb), iop(b, &common, spv.Op.iMul, cr, g_cr))))
    const blue = channelOf(b, &common, iop(b, &common, spv.Op.iAdd, scaled, iop(b, &common, spv.Op.iMul, cb, b_cb)))
    const pixel = compute.pack(b, &common, red, green, blue)
    const target_index = uop(b, &common, spv.Op.iAdd, target_offset, uop(b, &common, spv.Op.iAdd, uop(b, &common, spv.Op.iMul, y, target_stride), x))
    builder.store(b, compute.element(b, &common, common.buffers[1], target_index), pixel)
    builder.branch(b, merge)

    _ = builder.labelWith(b, merge)
    builder.returnVoid(b)
    builder.functionEnd(b)
    compute.finish(b, &common, main, shaders.GROUP_SIZE, shaders.GROUP_SIZE)
}
