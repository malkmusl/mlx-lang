// The warp (wobbly windows) and shrink (window previews) shaders: part
// of shaders.mlx, which describes them.
const spv = @import("std.spirv.core")
const builder = @import("std.spirv.builder")
const compute = @import("std.spirv.compute")
const shaders = @import("std.gpu.shaders")

// ---------------------------------------------------------------------------
// warp

fn iconst(b: *builder.Builder, common: *const shaders.Common, value: i32) -> u32 { return shaders.intConstant(b, common, value) }

fn iop(b: *builder.Builder, common: *const shaders.Common, opcode: spv.Op, left: u32, right: u32) -> u32 {
    return builder.binary(b, opcode, common.*.int, left, right)
}

fn clampInt(b: *builder.Builder, common: *const shaders.Common, value: u32, low: u32, high: u32) -> u32 {
    const raised = compute.select(b, common.*.int, builder.binary(b, spv.Op.sLessThan, common.*.boolean, value, low), low, value)
    return compute.select(b, common.*.int, builder.binary(b, spv.Op.sGreaterThan, common.*.boolean, raised, high), high, raised)
}

// The four cubic Bernstein weights of t (0-1024) in 1/1024.
fn bernstein(b: *builder.Builder, common: *const shaders.Common, t: u32, weights: *[4]u32) -> void {
    const s = iop(b, common, spv.Op.iSub, iconst(b, common, 1024), t)
    const shift = iconst(b, common, 20)
    const three = iconst(b, common, 3)
    const ss = iop(b, common, spv.Op.iMul, s, s)
    const tt = iop(b, common, spv.Op.iMul, t, t)
    weights.*[0] = iop(b, common, spv.Op.shiftRightArithmetic, iop(b, common, spv.Op.iMul, ss, s), shift)
    weights.*[1] = iop(b, common, spv.Op.shiftRightArithmetic, iop(b, common, spv.Op.iMul, iop(b, common, spv.Op.iMul, three, t), ss), shift)
    weights.*[2] = iop(b, common, spv.Op.shiftRightArithmetic, iop(b, common, spv.Op.iMul, iop(b, common, spv.Op.iMul, three, tt), s), shift)
    weights.*[3] = iop(b, common, spv.Op.shiftRightArithmetic, iop(b, common, spv.Op.iMul, tt, t), shift)
}

// The surface's offset at point (x, y) (1/16 pixels, relative to the rest
// rectangle's origin, which is `width` x `height` in 1/16 pixels): the
// control points' offsets weighted along x in each row, then down.
fn warpOffset(b: *builder.Builder, common: *const shaders.Common, x: u32, y: u32, width: u32, height: u32, offsets: *const [16]u32, out: *u32) -> void {
    const zero = iconst(b, common, 0)
    const full = iconst(b, common, 1024)
    const u = clampInt(b, common, iop(b, common, spv.Op.sDiv, iop(b, common, spv.Op.iMul, x, full), width), zero, full)
    const v = clampInt(b, common, iop(b, common, spv.Op.sDiv, iop(b, common, spv.Op.iMul, y, full), height), zero, full)
    var across: [4]u32 = undefined
    var down: [4]u32 = undefined
    bernstein(b, common, u, &across)
    bernstein(b, common, v, &down)
    const ten = iconst(b, common, 10)
    var total = zero
    var row: usize = 0
    while row < 4 {
        var sum = zero
        var column: usize = 0
        while column < 4 {
            sum = iop(b, common, spv.Op.iAdd, sum, iop(b, common, spv.Op.iMul, across[column], offsets.*[row * 4 + column]))
            column += 1
        }
        const row_value = iop(b, common, spv.Op.shiftRightArithmetic, sum, ten)
        total = iop(b, common, spv.Op.iAdd, total, iop(b, common, spv.Op.iMul, down[row], row_value))
        row += 1
    }
    out.* = iop(b, common, spv.Op.shiftRightArithmetic, total, ten)
}

// Source pixel (x, y) (signed), 0 outside the width x height source.
fn warpTexel(b: *builder.Builder, common: *const shaders.Common, x: u32, y: u32, width: u32, height: u32, stride: u32) -> u32 {
    const zero = iconst(b, common, 0)
    const in_x = builder.binary(b, spv.Op.logicalAnd, common.*.boolean, builder.binary(b, spv.Op.sGreaterThanEqual, common.*.boolean, x, zero), builder.binary(b, spv.Op.sLessThan, common.*.boolean, x, width))
    const in_y = builder.binary(b, spv.Op.logicalAnd, common.*.boolean, builder.binary(b, spv.Op.sGreaterThanEqual, common.*.boolean, y, zero), builder.binary(b, spv.Op.sLessThan, common.*.boolean, y, height))
    const inside = builder.binary(b, spv.Op.logicalAnd, common.*.boolean, in_x, in_y)
    const index = iop(b, common, spv.Op.iAdd, iop(b, common, spv.Op.iMul, y, stride), x)
    const safe = builder.unary(b, spv.Op.bitcast, common.*.uint, compute.select(b, common.*.int, inside, index, zero))
    const value = builder.load(b, common.*.uint, compute.element(b, common, common.*.buffers[0], safe))
    return compute.select(b, common.*.uint, inside, value, common.*.zero)
}

pub fn buildWarp(b: *builder.Builder) -> void {
    var common: shaders.Common = undefined
    compute.declare(b, &common, shaders.WARP_WORDS, 3, false)
    const main = builder.function(b, common.voidType, spv.FUNCTION_CONTROL_NONE, common.functionType)
    const entry = builder.label(b)
    const id = builder.load(b, common.uvec3, common.globalId)
    const x = builder.compositeExtract(b, common.uint, id, 0)
    const y = builder.compositeExtract(b, common.uint, id, 1)
    const target_width = compute.pushWord(b, &common, 0)
    const target_height = compute.pushWord(b, &common, 1)
    const target_offset = compute.pushWord(b, &common, 2)
    const target_stride = compute.pushWord(b, &common, 3)
    const box_x = shaders.signed(b, &common, compute.pushWord(b, &common, 4))
    const box_y = shaders.signed(b, &common, compute.pushWord(b, &common, 5))
    const box_width = compute.pushWord(b, &common, 6)
    const box_height = compute.pushWord(b, &common, 7)
    const rest_x = shaders.signed(b, &common, compute.pushWord(b, &common, 8))
    const rest_y = shaders.signed(b, &common, compute.pushWord(b, &common, 9))
    const rest_width = shaders.signed(b, &common, compute.pushWord(b, &common, 10))
    const rest_height = shaders.signed(b, &common, compute.pushWord(b, &common, 11))
    const source_stride = shaders.signed(b, &common, compute.pushWord(b, &common, 12))
    const grid_offset = compute.pushWord(b, &common, 13)
    const px = iop(b, &common, spv.Op.iAdd, box_x, shaders.signed(b, &common, x))
    const py = iop(b, &common, spv.Op.iAdd, box_y, shaders.signed(b, &common, y))
    const zero = iconst(b, &common, 0)
    const in_box = builder.binary(b, spv.Op.logicalAnd, common.boolean, builder.binary(b, spv.Op.uLessThan, common.boolean, x, box_width), builder.binary(b, spv.Op.uLessThan, common.boolean, y, box_height))
    const in_x = builder.binary(b, spv.Op.logicalAnd, common.boolean, builder.binary(b, spv.Op.sGreaterThanEqual, common.boolean, px, zero), builder.binary(b, spv.Op.sLessThan, common.boolean, px, shaders.signed(b, &common, target_width)))
    const in_y = builder.binary(b, spv.Op.logicalAnd, common.boolean, builder.binary(b, spv.Op.sGreaterThanEqual, common.boolean, py, zero), builder.binary(b, spv.Op.sLessThan, common.boolean, py, shaders.signed(b, &common, target_height)))
    const visible = builder.binary(b, spv.Op.logicalAnd, common.boolean, in_box, builder.binary(b, spv.Op.logicalAnd, common.boolean, in_x, in_y))
    const body = builder.newId(b)
    const merge = builder.newId(b)
    builder.selectionMerge(b, merge)
    builder.branchConditional(b, visible, body, merge)

    const body_label = builder.labelWith(b, body)
    var offsets_x: [16]u32 = undefined
    var offsets_y: [16]u32 = undefined
    var index: u32 = 0
    while index < 16 {
        offsets_x[index] = shaders.signed(b, &common, builder.load(b, common.uint, compute.element(b, &common, common.buffers[2], builder.binary(b, spv.Op.iAdd, common.uint, grid_offset, compute.constant(b, &common, index)))))
        offsets_y[index] = shaders.signed(b, &common, builder.load(b, common.uint, compute.element(b, &common, common.buffers[2], builder.binary(b, spv.Op.iAdd, common.uint, grid_offset, compute.constant(b, &common, index + 16)))))
        index += 1
    }
    // In 1/16 pixels, relative to the rest rectangle: the pixel's centre,
    // and the rectangle's size.
    const sixteen = iconst(b, &common, 16)
    const px16 = iop(b, &common, spv.Op.iSub, iop(b, &common, spv.Op.iAdd, iop(b, &common, spv.Op.iMul, px, sixteen), iconst(b, &common, 8)), iop(b, &common, spv.Op.iMul, rest_x, sixteen))
    const py16 = iop(b, &common, spv.Op.iSub, iop(b, &common, spv.Op.iAdd, iop(b, &common, spv.Op.iMul, py, sixteen), iconst(b, &common, 8)), iop(b, &common, spv.Op.iMul, rest_y, sixteen))
    const width16 = iop(b, &common, spv.Op.iMul, rest_width, sixteen)
    const height16 = iop(b, &common, spv.Op.iMul, rest_height, sixteen)
    // s = p - offset(s), three times from s = p.
    var sx = px16
    var sy = py16
    var round: u32 = 0
    while round < 3 {
        var offset_x: u32 = 0
        var offset_y: u32 = 0
        warpOffset(b, &common, sx, sy, width16, height16, &offsets_x, &offset_x)
        warpOffset(b, &common, sx, sy, width16, height16, &offsets_y, &offset_y)
        sx = iop(b, &common, spv.Op.iSub, px16, offset_x)
        sy = iop(b, &common, spv.Op.iSub, py16, offset_y)
        round += 1
    }
    // Bilinear: the pixel centres around (sx, sy).
    const centred_x = iop(b, &common, spv.Op.iSub, sx, iconst(b, &common, 8))
    const centred_y = iop(b, &common, spv.Op.iSub, sy, iconst(b, &common, 8))
    const four = iconst(b, &common, 4)
    const fifteen = iconst(b, &common, 15)
    const ix = iop(b, &common, spv.Op.shiftRightArithmetic, centred_x, four)
    const iy = iop(b, &common, spv.Op.shiftRightArithmetic, centred_y, four)
    const fx = builder.unary(b, spv.Op.bitcast, common.uint, iop(b, &common, spv.Op.bitwiseAnd, centred_x, fifteen))
    const fy = builder.unary(b, spv.Op.bitcast, common.uint, iop(b, &common, spv.Op.bitwiseAnd, centred_y, fifteen))
    const one = iconst(b, &common, 1)
    const ix1 = iop(b, &common, spv.Op.iAdd, ix, one)
    const iy1 = iop(b, &common, spv.Op.iAdd, iy, one)
    const c00 = warpTexel(b, &common, ix, iy, rest_width, rest_height, source_stride)
    const c10 = warpTexel(b, &common, ix1, iy, rest_width, rest_height, source_stride)
    const c01 = warpTexel(b, &common, ix, iy1, rest_width, rest_height, source_stride)
    const c11 = warpTexel(b, &common, ix1, iy1, rest_width, rest_height, source_stride)
    const u16 = compute.constant(b, &common, 16)
    const gx = builder.binary(b, spv.Op.iSub, common.uint, u16, fx)
    const gy = builder.binary(b, spv.Op.iSub, common.uint, u16, fy)
    const w00 = builder.binary(b, spv.Op.iMul, common.uint, gx, gy)
    const w10 = builder.binary(b, spv.Op.iMul, common.uint, fx, gy)
    const w01 = builder.binary(b, spv.Op.iMul, common.uint, gx, fy)
    const w11 = builder.binary(b, spv.Op.iMul, common.uint, fx, fy)
    var sampled: [4]u32 = [4]u32{ 0, 0, 0, 0 }
    index = 0
    while index < 4 {
        const shift = 24 - index * 8
        var sum = builder.binary(b, spv.Op.iMul, common.uint, compute.channel(b, &common, c00, shift), w00)
        sum = builder.binary(b, spv.Op.iAdd, common.uint, sum, builder.binary(b, spv.Op.iMul, common.uint, compute.channel(b, &common, c10, shift), w10))
        sum = builder.binary(b, spv.Op.iAdd, common.uint, sum, builder.binary(b, spv.Op.iMul, common.uint, compute.channel(b, &common, c01, shift), w01))
        sum = builder.binary(b, spv.Op.iAdd, common.uint, sum, builder.binary(b, spv.Op.iMul, common.uint, compute.channel(b, &common, c11, shift), w11))
        sampled[index] = builder.binary(b, spv.Op.shiftRightLogical, common.uint, builder.binary(b, spv.Op.iAdd, common.uint, sum, compute.constant(b, &common, 128)), compute.constant(b, &common, 8))
        index += 1
    }
    // Over the target, premultiplied (as the blit shader blends).
    const target_index = builder.binary(b, spv.Op.iAdd, common.uint, target_offset, builder.binary(b, spv.Op.iAdd, common.uint, builder.binary(b, spv.Op.iMul, common.uint, builder.unary(b, spv.Op.bitcast, common.uint, py), target_stride), builder.unary(b, spv.Op.bitcast, common.uint, px)))
    const target_pointer = compute.element(b, &common, common.buffers[1], target_index)
    const target = builder.load(b, common.uint, target_pointer)
    const inverse = builder.binary(b, spv.Op.iSub, common.uint, compute.constant(b, &common, 255), sampled[0])
    var blended: [4]u32 = [4]u32{ 0, 0, 0, 0 }
    index = 0
    while index < 4 {
        const shift = 24 - index * 8
        const kept = builder.binary(b, spv.Op.iAdd, common.uint, builder.binary(b, spv.Op.iMul, common.uint, compute.channel(b, &common, target, shift), inverse), compute.constant(b, &common, 127))
        const sum = builder.binary(b, spv.Op.iAdd, common.uint, sampled[index], builder.binary(b, spv.Op.uDiv, common.uint, kept, compute.constant(b, &common, 255)))
        blended[index] = compute.select(b, common.uint, builder.binary(b, spv.Op.uGreaterThan, common.boolean, sum, compute.constant(b, &common, 255)), compute.constant(b, &common, 255), sum)
        index += 1
    }
    builder.store(b, target_pointer, compute.packAlpha(b, &common, blended[0], blended[1], blended[2], blended[3]))
    builder.branch(b, merge)

    const merge_label = builder.labelWith(b, merge)
    builder.returnVoid(b)
    builder.functionEnd(b)
    compute.finish(b, &common, main, shaders.GROUP_SIZE, shaders.GROUP_SIZE)
}

// ---------------------------------------------------------------------------
// shrink

pub fn buildShrink(b: *builder.Builder) -> void {
    var common: shaders.Common = undefined
    compute.declare(b, &common, shaders.SHRINK_WORDS, 2, false)
    const main = builder.function(b, common.voidType, spv.FUNCTION_CONTROL_NONE, common.functionType)
    const entry = builder.label(b)
    const id = builder.load(b, common.uvec3, common.globalId)
    const x = builder.compositeExtract(b, common.uint, id, 0)
    const y = builder.compositeExtract(b, common.uint, id, 1)
    const target_width = compute.pushWord(b, &common, 0)
    const target_height = compute.pushWord(b, &common, 1)
    const target_offset = compute.pushWord(b, &common, 2)
    const target_stride = compute.pushWord(b, &common, 3)
    const box_x = shaders.signed(b, &common, compute.pushWord(b, &common, 4))
    const box_y = shaders.signed(b, &common, compute.pushWord(b, &common, 5))
    const box_width = compute.pushWord(b, &common, 6)
    const box_height = compute.pushWord(b, &common, 7)
    const source_width = compute.pushWord(b, &common, 8)
    const source_height = compute.pushWord(b, &common, 9)
    const source_stride = compute.pushWord(b, &common, 10)
    const opacity = compute.pushWord(b, &common, 11)
    const px = iop(b, &common, spv.Op.iAdd, box_x, shaders.signed(b, &common, x))
    const py = iop(b, &common, spv.Op.iAdd, box_y, shaders.signed(b, &common, y))
    const zero = iconst(b, &common, 0)
    const in_box = builder.binary(b, spv.Op.logicalAnd, common.boolean, builder.binary(b, spv.Op.uLessThan, common.boolean, x, box_width), builder.binary(b, spv.Op.uLessThan, common.boolean, y, box_height))
    const in_x = builder.binary(b, spv.Op.logicalAnd, common.boolean, builder.binary(b, spv.Op.sGreaterThanEqual, common.boolean, px, zero), builder.binary(b, spv.Op.sLessThan, common.boolean, px, shaders.signed(b, &common, target_width)))
    const in_y = builder.binary(b, spv.Op.logicalAnd, common.boolean, builder.binary(b, spv.Op.sGreaterThanEqual, common.boolean, py, zero), builder.binary(b, spv.Op.sLessThan, common.boolean, py, shaders.signed(b, &common, target_height)))
    const visible = builder.binary(b, spv.Op.logicalAnd, common.boolean, in_box, builder.binary(b, spv.Op.logicalAnd, common.boolean, in_x, in_y))
    const body = builder.newId(b)
    const merge = builder.newId(b)
    builder.selectionMerge(b, merge)
    builder.branchConditional(b, visible, body, merge)

    const body_label = builder.labelWith(b, body)
    // Sample k (0-3) across: source column (x * 8 + 2k + 1) * width / (box * 8).
    const eight = compute.constant(b, &common, 8)
    const across = builder.binary(b, spv.Op.iMul, common.uint, box_width, eight)
    const down = builder.binary(b, spv.Op.iMul, common.uint, box_height, eight)
    var columns: [4]u32 = undefined
    var rows: [4]u32 = undefined
    var k: u32 = 0
    while k < 4 {
        const offset = compute.constant(b, &common, 2 * k + 1)
        columns[k] = builder.binary(b, spv.Op.uDiv, common.uint, builder.binary(b, spv.Op.iMul, common.uint, builder.binary(b, spv.Op.iAdd, common.uint, builder.binary(b, spv.Op.iMul, common.uint, x, eight), offset), source_width), across)
        rows[k] = builder.binary(b, spv.Op.uDiv, common.uint, builder.binary(b, spv.Op.iMul, common.uint, builder.binary(b, spv.Op.iAdd, common.uint, builder.binary(b, spv.Op.iMul, common.uint, y, eight), offset), source_height), down)
        k += 1
    }
    var sums: [4]u32 = [4]u32{ common.zero, common.zero, common.zero, common.zero }
    var row: u32 = 0
    while row < 4 {
        var column: u32 = 0
        while column < 4 {
            const index = builder.binary(b, spv.Op.iAdd, common.uint, builder.binary(b, spv.Op.iMul, common.uint, rows[row], source_stride), columns[column])
            const texel = builder.load(b, common.uint, compute.element(b, &common, common.buffers[0], index))
            var channel_index: u32 = 0
            while channel_index < 4 {
                sums[channel_index] = builder.binary(b, spv.Op.iAdd, common.uint, sums[channel_index], compute.channel(b, &common, texel, 24 - channel_index * 8))
                channel_index += 1
            }
            column += 1
        }
        row += 1
    }
    var sampled: [4]u32 = undefined
    k = 0
    while k < 4 {
        const averaged = builder.binary(b, spv.Op.shiftRightLogical, common.uint, builder.binary(b, spv.Op.iAdd, common.uint, sums[k], compute.constant(b, &common, 8)), compute.constant(b, &common, 4))
        // Premultiplied: every channel faded alike.
        sampled[k] = builder.binary(b, spv.Op.uDiv, common.uint, builder.binary(b, spv.Op.iAdd, common.uint, builder.binary(b, spv.Op.iMul, common.uint, averaged, opacity), compute.constant(b, &common, 127)), compute.constant(b, &common, 255))
        k += 1
    }
    const target_index = builder.binary(b, spv.Op.iAdd, common.uint, target_offset, builder.binary(b, spv.Op.iAdd, common.uint, builder.binary(b, spv.Op.iMul, common.uint, builder.unary(b, spv.Op.bitcast, common.uint, py), target_stride), builder.unary(b, spv.Op.bitcast, common.uint, px)))
    const target_pointer = compute.element(b, &common, common.buffers[1], target_index)
    const target = builder.load(b, common.uint, target_pointer)
    const inverse = builder.binary(b, spv.Op.iSub, common.uint, compute.constant(b, &common, 255), sampled[0])
    var blended: [4]u32 = undefined
    k = 0
    while k < 4 {
        const kept = builder.binary(b, spv.Op.iAdd, common.uint, builder.binary(b, spv.Op.iMul, common.uint, compute.channel(b, &common, target, 24 - k * 8), inverse), compute.constant(b, &common, 127))
        const sum = builder.binary(b, spv.Op.iAdd, common.uint, sampled[k], builder.binary(b, spv.Op.uDiv, common.uint, kept, compute.constant(b, &common, 255)))
        blended[k] = compute.select(b, common.uint, builder.binary(b, spv.Op.uGreaterThan, common.boolean, sum, compute.constant(b, &common, 255)), compute.constant(b, &common, 255), sum)
        k += 1
    }
    builder.store(b, target_pointer, compute.packAlpha(b, &common, blended[0], blended[1], blended[2], blended[3]))
    builder.branch(b, merge)

    const merge_label = builder.labelWith(b, merge)
    builder.returnVoid(b)
    builder.functionEnd(b)
    compute.finish(b, &common, main, shaders.GROUP_SIZE, shaders.GROUP_SIZE)
}
