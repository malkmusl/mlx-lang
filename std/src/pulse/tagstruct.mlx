// std.pulse.tagstruct: PulseAudio's tagstructs, the bodies of its native
// protocol's commands and replies (std.pulse), for both ends: MLX Audio's
// server (projects/desktop/audio) writes them into its message buffer,
// its libpulse (compiler/libc/pulse) into growing C memory. Each value has a tag byte before it and is
// big-endian: 'L' u32, 'B' u8, 'R' u64, 'r' s64, 't' a NUL-terminated
// string, 'N' no string, '1' and '0' booleans, 'x' bytes (u32 length
// first), 'a' a sample spec (format u8, channels u8, rate u32), 'm' a
// channel map (count u8, positions u8), 'v' a volume per channel (count
// u8, u32 each), 'V' a volume, 'U' microseconds (u64), 'T' a time (u32
// seconds, u32 microseconds), 'P' a property list (string keys, each with
// 'L' length and 'x' value, ended by 'N') and 'f' a format (u8 encoding
// and a property list).

const std = @import("std")

const Allocator = std.allocator.Allocator

pub const TAG_U32: u8 = 76
pub const TAG_U8: u8 = 66
pub const TAG_U64: u8 = 82
pub const TAG_S64: u8 = 114
pub const TAG_STRING: u8 = 116
pub const TAG_STRING_NULL: u8 = 78
pub const TAG_TRUE: u8 = 49
pub const TAG_FALSE: u8 = 48
pub const TAG_ARBITRARY: u8 = 120
pub const TAG_SAMPLE_SPEC: u8 = 97
pub const TAG_CHANNEL_MAP: u8 = 109
pub const TAG_CVOLUME: u8 = 118
pub const TAG_VOLUME: u8 = 86
pub const TAG_USEC: u8 = 85
pub const TAG_TIMEVAL: u8 = 84
pub const TAG_PROPLIST: u8 = 80
pub const TAG_FORMAT_INFO: u8 = 102

// The most channels a map or volume has.
pub const MAX_CHANNELS: usize = 32

// A tagstruct being written: into `capacity` bytes, or, made with
// beginGrowing, into memory of `allocator`'s that grows as it fills.
// `failed` once something did not fit.
pub const Writer = struct {
    bytes: [*]u8
    capacity: usize
    length: usize
    failed: bool
    grows: bool
    allocator: Allocator
}

pub const Reader = struct {
    bytes: [*]const u8
    length: usize
    position: usize
    failed: bool
}

// A sample spec as it came: PulseAudio's format code, channels and rate.
pub const SampleSpec = struct {
    format: u8
    channels: u8
    rate: u32
}

// ---------------------------------------------------------------------------
// Writing

pub fn begin(writing: *Writer, bytes: [*]u8, capacity: usize) -> void {
    writing.*.bytes = bytes
    writing.*.capacity = capacity
    writing.*.length = 0
    writing.*.failed = false
    writing.*.grows = false
}

// A writer whose memory (`capacity` bytes to start with) comes from
// `allocator` and doubles when full; release gives it back. False when
// there is no memory (then it has failed).
pub fn beginGrowing(writing: *Writer, allocator: Allocator, capacity: usize) -> bool {
    writing.*.length = 0
    writing.*.capacity = 0
    writing.*.grows = true
    writing.*.allocator = allocator
    const memory = allocator.alloc(capacity, 16)
    if memory == null {
        writing.*.failed = true
        return false
    }
    writing.*.bytes = memory.?
    writing.*.capacity = capacity
    writing.*.failed = false
    return true
}

pub fn release(writing: *Writer) -> void {
    if writing.*.grows && writing.*.capacity > 0 { writing.*.allocator.free(writing.*.bytes, writing.*.capacity, 16) }
    writing.*.capacity = 0
}

fn room(writing: *Writer, count: usize) -> bool {
    if writing.*.failed { return false }
    if writing.*.length + count <= writing.*.capacity { return true }
    if writing.*.grows {
        var capacity = writing.*.capacity * 2
        while capacity < writing.*.length + count { capacity = capacity * 2 }
        const grown = writing.*.allocator.resize(writing.*.bytes, writing.*.capacity, capacity, 16)
        if grown != null {
            writing.*.bytes = grown.?
            writing.*.capacity = capacity
            return true
        }
    }
    writing.*.failed = true
    return false
}

// Untagged values: a packet's own fields, and what the tagged ones are
// made of.
pub fn raw8(writing: *Writer, value: u8) -> void {
    if !room(writing, 1) { return }
    writing.*.bytes[writing.*.length] = value
    writing.*.length += 1
}

pub fn raw32(writing: *Writer, value: u32) -> void {
    if !room(writing, 4) { return }
    std.mem.writeU32Big(writing.*.bytes, writing.*.length, value)
    writing.*.length += 4
}

pub fn raw64(writing: *Writer, value: u64) -> void {
    raw32(writing, @intCast(u32, value >> 32))
    raw32(writing, @intCast(u32, value & 4294967295))
}

pub fn rawBytes(writing: *Writer, bytes: [*]const u8, count: usize) -> void {
    if count == 0 || !room(writing, count) { return }
    std.mem.copy(writing.*.bytes + writing.*.length, bytes, count)
    writing.*.length += count
}

// `count` zero bytes, to fill in later (a packet's descriptor).
pub fn reserve(writing: *Writer, count: usize) -> void {
    if !room(writing, count) { return }
    std.mem.zero(writing.*.bytes + writing.*.length, count)
    writing.*.length += count
}

pub fn putU32(writing: *Writer, value: u32) -> void {
    raw8(writing, TAG_U32)
    raw32(writing, value)
}

pub fn putU8(writing: *Writer, value: u8) -> void {
    raw8(writing, TAG_U8)
    raw8(writing, value)
}

pub fn putU64(writing: *Writer, value: u64) -> void {
    raw8(writing, TAG_U64)
    raw64(writing, value)
}

pub fn putS64(writing: *Writer, value: i64) -> void {
    raw8(writing, TAG_S64)
    raw64(writing, @bitCast(u64, value))
}

pub fn putBool(writing: *Writer, value: bool) -> void { raw8(writing, if value { TAG_TRUE } else { TAG_FALSE }) }

pub fn putString(writing: *Writer, text: []const u8) -> void {
    raw8(writing, TAG_STRING)
    if !room(writing, text.length + 1) { return }
    var index: usize = 0
    while index < text.length {
        writing.*.bytes[writing.*.length + index] = text[index]
        index += 1
    }
    writing.*.bytes[writing.*.length + text.length] = 0
    writing.*.length += text.length + 1
}

pub fn putNullString(writing: *Writer) -> void { raw8(writing, TAG_STRING_NULL) }

// Bytes as they are ('x': their count first).
pub fn putArbitrary(writing: *Writer, bytes: [*]const u8, count: usize) -> void {
    raw8(writing, TAG_ARBITRARY)
    raw32(writing, @intCast(u32, count))
    rawBytes(writing, bytes, count)
}

pub fn putSampleSpec(writing: *Writer, format: u8, channels: u8, rate: u32) -> void {
    raw8(writing, TAG_SAMPLE_SPEC)
    raw8(writing, format)
    raw8(writing, channels)
    raw32(writing, rate)
}

pub fn putChannelMap(writing: *Writer, positions: [*]const u8, count: usize) -> void {
    raw8(writing, TAG_CHANNEL_MAP)
    raw8(writing, @intCast(u8, count))
    var index: usize = 0
    while index < count {
        raw8(writing, positions[index])
        index += 1
    }
}

// The usual map of `channels`: mono, front left and right, then the
// positions PulseAudio's default maps use.
pub fn putDefaultChannelMap(writing: *Writer, channels: usize) -> void {
    var positions: [8]u8 = [8]u8{ 1, 2, 5, 6, 3, 7, 10, 11 }
    if channels == 1 { positions[0] = 0 }
    const bytes: [*]const u8 = &positions
    putChannelMap(writing, bytes, if channels > 8 { 8 } else { channels })
}

pub fn putCvolume(writing: *Writer, channels: usize, volume: u32) -> void {
    raw8(writing, TAG_CVOLUME)
    raw8(writing, @intCast(u8, channels))
    var index: usize = 0
    while index < channels {
        raw32(writing, volume)
        index += 1
    }
}

// A volume per channel, each its own.
pub fn putVolumes(writing: *Writer, volumes: [*]const u32, count: usize) -> void {
    raw8(writing, TAG_CVOLUME)
    raw8(writing, @intCast(u8, count))
    var index: usize = 0
    while index < count {
        raw32(writing, volumes[index])
        index += 1
    }
}

pub fn putVolume(writing: *Writer, volume: u32) -> void {
    raw8(writing, TAG_VOLUME)
    raw32(writing, volume)
}

pub fn putUsec(writing: *Writer, value: u64) -> void {
    raw8(writing, TAG_USEC)
    raw64(writing, value)
}

pub fn putTimeval(writing: *Writer, seconds: u32, microseconds: u32) -> void {
    raw8(writing, TAG_TIMEVAL)
    raw32(writing, seconds)
    raw32(writing, microseconds)
}

pub fn beginProplist(writing: *Writer) -> void { raw8(writing, TAG_PROPLIST) }

// A property whose value is `text` (stored NUL-terminated, as libpulse
// keeps strings).
pub fn putProperty(writing: *Writer, key: []const u8, text: []const u8) -> void {
    putString(writing, key)
    putU32(writing, @intCast(u32, text.length + 1))
    raw8(writing, TAG_ARBITRARY)
    raw32(writing, @intCast(u32, text.length + 1))
    if !room(writing, text.length + 1) { return }
    var index: usize = 0
    while index < text.length {
        writing.*.bytes[writing.*.length + index] = text[index]
        index += 1
    }
    writing.*.bytes[writing.*.length + text.length] = 0
    writing.*.length += text.length + 1
}

pub fn endProplist(writing: *Writer) -> void { raw8(writing, TAG_STRING_NULL) }

pub fn putEmptyProplist(writing: *Writer) -> void {
    beginProplist(writing)
    endProplist(writing)
}

// A PCM format with no properties (encoding 1).
pub fn putPcmFormat(writing: *Writer) -> void {
    raw8(writing, TAG_FORMAT_INFO)
    putU8(writing, 1)
    putEmptyProplist(writing)
}

// ---------------------------------------------------------------------------
// Reading

pub fn reader(bytes: [*]const u8, length: usize) -> Reader {
    return Reader.{ .bytes = bytes, .length = length, .position = 0, .failed = false }
}

pub fn atEnd(reading: *const Reader) -> bool { return reading.*.position >= reading.*.length }

// The tag at the reading position is `tag`, with `count` bytes after it:
// the tag is taken (else the reading has failed).
pub fn expect(reading: *Reader, tag: u8, count: usize) -> bool {
    if reading.*.failed || reading.*.position + 1 + count > reading.*.length || reading.*.bytes[reading.*.position] != tag {
        reading.*.failed = true
        return false
    }
    reading.*.position += 1
    return true
}

fn take8(reading: *Reader) -> u8 {
    const value = reading.*.bytes[reading.*.position]
    reading.*.position += 1
    return value
}

fn take32(reading: *Reader) -> u32 {
    const value = std.mem.readU32Big(reading.*.bytes, reading.*.position)
    reading.*.position += 4
    return value
}

fn take64(reading: *Reader) -> u64 {
    const high = @intCast(u64, take32(reading))
    return (high << 32) | @intCast(u64, take32(reading))
}

pub fn readU32(reading: *Reader) -> u32 {
    if !expect(reading, TAG_U32, 4) { return 0 }
    return take32(reading)
}

pub fn readU8(reading: *Reader) -> u8 {
    if !expect(reading, TAG_U8, 1) { return 0 }
    return take8(reading)
}

pub fn readU64(reading: *Reader) -> u64 {
    if !expect(reading, TAG_U64, 8) { return 0 }
    return take64(reading)
}

pub fn readS64(reading: *Reader) -> i64 {
    if !expect(reading, TAG_S64, 8) { return 0 }
    return @bitCast(i64, take64(reading))
}

pub fn readUsec(reading: *Reader) -> u64 {
    if !expect(reading, TAG_USEC, 8) { return 0 }
    return take64(reading)
}

pub fn readVolume(reading: *Reader) -> u32 {
    if !expect(reading, TAG_VOLUME, 4) { return 0 }
    return take32(reading)
}

pub fn readBool(reading: *Reader) -> bool {
    if reading.*.failed || reading.*.position >= reading.*.length {
        reading.*.failed = true
        return false
    }
    const tag = reading.*.bytes[reading.*.position]
    if tag != TAG_TRUE && tag != TAG_FALSE {
        reading.*.failed = true
        return false
    }
    reading.*.position += 1
    return tag == TAG_TRUE
}

// A string, or "" for no string (`isNull` says which).
pub fn readStringOrNull(reading: *Reader, isNull: *bool) -> []const u8 {
    isNull.* = false
    if reading.*.failed || reading.*.position >= reading.*.length {
        reading.*.failed = true
        return reading.*.bytes[0..0]
    }
    if reading.*.bytes[reading.*.position] == TAG_STRING_NULL {
        reading.*.position += 1
        isNull.* = true
        return reading.*.bytes[0..0]
    }
    if !expect(reading, TAG_STRING, 0) { return reading.*.bytes[0..0] }
    const start = reading.*.position
    var end = start
    while end < reading.*.length && reading.*.bytes[end] != 0 { end += 1 }
    if end >= reading.*.length {
        reading.*.failed = true
        return reading.*.bytes[0..0]
    }
    reading.*.position = end + 1
    return reading.*.bytes[start..end]
}

pub fn readString(reading: *Reader) -> []const u8 {
    var isNull = false
    return readStringOrNull(reading, &isNull)
}

pub fn readSampleSpec(reading: *Reader, spec: *SampleSpec) -> void {
    spec.*.format = 0
    spec.*.channels = 0
    spec.*.rate = 0
    if !expect(reading, TAG_SAMPLE_SPEC, 6) { return }
    spec.*.format = take8(reading)
    spec.*.channels = take8(reading)
    spec.*.rate = take32(reading)
}

// A channel map's positions into `positions` (MAX_CHANNELS): how many.
pub fn readChannelMap(reading: *Reader, positions: [*]u8) -> usize {
    if !expect(reading, TAG_CHANNEL_MAP, 1) { return 0 }
    const count = @intCast(usize, take8(reading))
    if count > MAX_CHANNELS || reading.*.position + count > reading.*.length {
        reading.*.failed = true
        return 0
    }
    var index: usize = 0
    while index < count {
        positions[index] = take8(reading)
        index += 1
    }
    return count
}

// A volume per channel into `volumes` (MAX_CHANNELS): how many.
pub fn readVolumes(reading: *Reader, volumes: [*]u32) -> usize {
    if !expect(reading, TAG_CVOLUME, 1) { return 0 }
    const count = @intCast(usize, take8(reading))
    if count > MAX_CHANNELS || reading.*.position + count * 4 > reading.*.length {
        reading.*.failed = true
        return 0
    }
    var index: usize = 0
    while index < count {
        volumes[index] = take32(reading)
        index += 1
    }
    return count
}

// Bytes ('x'): where they are in the tagstruct, their count in `count`.
pub fn readArbitrary(reading: *Reader, count: *usize) -> [*]const u8 {
    count.* = 0
    if !expect(reading, TAG_ARBITRARY, 4) { return reading.*.bytes }
    const size = @intCast(usize, take32(reading))
    if reading.*.position + size > reading.*.length {
        reading.*.failed = true
        return reading.*.bytes
    }
    const start = reading.*.bytes + reading.*.position
    reading.*.position += size
    count.* = size
    return start
}

// A volume per channel: their mean (PulseAudio's scale, 65536 is 100%).
pub fn readCvolume(reading: *Reader) -> u32 {
    if !expect(reading, TAG_CVOLUME, 1) { return 0 }
    const count = @intCast(usize, take8(reading))
    if count > MAX_CHANNELS || reading.*.position + count * 4 > reading.*.length {
        reading.*.failed = true
        return 0
    }
    if count == 0 { return 0 }
    var sum: u64 = 0
    var index: usize = 0
    while index < count {
        sum += @intCast(u64, take32(reading))
        index += 1
    }
    return @intCast(u32, sum / count)
}

pub fn readTimeval(reading: *Reader, seconds: *u32, microseconds: *u32) -> void {
    seconds.* = 0
    microseconds.* = 0
    if !expect(reading, TAG_TIMEVAL, 8) { return }
    seconds.* = take32(reading)
    microseconds.* = take32(reading)
}

// Skips a property list; where it lay (from its tag to past its end) is
// `start` and the reading position after, for property().
pub fn readProplist(reading: *Reader, start: *usize) -> void {
    start.* = reading.*.position
    if !expect(reading, TAG_PROPLIST, 0) { return }
    while !reading.*.failed {
        var isNull = false
        _ = readStringOrNull(reading, &isNull)
        if isNull || reading.*.failed { return }
        const length = readU32(reading)
        if !expect(reading, TAG_ARBITRARY, 4) { return }
        const stored = take32(reading)
        if stored != length || reading.*.position + @intCast(usize, stored) > reading.*.length {
            reading.*.failed = true
            return
        }
        reading.*.position += @intCast(usize, stored)
    }
}

// The value of `key` in the property list read from `start` to `end`
// (without a trailing NUL); "" when it has none.
pub fn property(bytes: [*]const u8, start: usize, end: usize, key: []const u8) -> []const u8 {
    var reading = Reader.{ .bytes = bytes, .length = end, .position = start, .failed = false }
    if !expect(&reading, TAG_PROPLIST, 0) { return bytes[0..0] }
    while !reading.failed {
        var isNull = false
        const name = readStringOrNull(&reading, &isNull)
        if isNull || reading.failed { return bytes[0..0] }
        const length = readU32(&reading)
        if !expect(&reading, TAG_ARBITRARY, 4) { return bytes[0..0] }
        const stored = @intCast(usize, take32(&reading))
        if stored != @intCast(usize, length) || reading.position + stored > end { return bytes[0..0] }
        const value_start = reading.position
        reading.position += stored
        if std.text.same(name, key) {
            var value_end = value_start + stored
            if value_end > value_start && bytes[value_end - 1] == 0 { value_end -= 1 }
            return bytes[value_start..value_end]
        }
    }
    return bytes[0..0]
}

// Skips a format (its encoding and property list).
pub fn readFormatInfo(reading: *Reader) -> void {
    if !expect(reading, TAG_FORMAT_INFO, 0) { return }
    _ = readU8(reading)
    var start: usize = 0
    readProplist(reading, &start)
}
