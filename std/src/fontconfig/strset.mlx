// std.fontconfig.strset: sets of strings (FcStrSet) in the order they were
// added, no string twice (compared byte for byte), and lists walking them
// (FcStrList). Directories, configuration files, a langset's languages
// that have no orthography, the default languages.
//
// A set is a record reached by its address:
//     0  references
//     8  the number of strings
//    16  the room for strings
//    24  the strings (C strings of the module's memory)
// A list: the set (referenced) and the next position.
const mem = @import("./mem.mlx")
const strings = @import("./strings.mlx")

pub fn create() -> usize {
    const set = mem.alloc(32)
    if set == 0 { return 0 }
    mem.put64(set, 1)
    return set
}

pub fn reference(set: usize) -> usize {
    if set != 0 { _ = @atomicRmw(u64, unsafe { @ptrFromInt(*u64, set) }, add, 1, monotonic) }
    return set
}

pub fn destroy(set: usize) -> void {
    if set == 0 { return }
    if @atomicRmw(u64, unsafe { @ptrFromInt(*u64, set) }, sub, 1, acq_rel) != 1 { return }
    var i: usize = 0
    while i < size(set) {
        mem.free(at(set, i))
        i += 1
    }
    mem.free(mem.getWord(set + 24))
    mem.free(set)
}

pub fn size(set: usize) -> usize { return if set == 0 { 0 } else { mem.getWord(set + 8) } }

// The string at `index` (a C string).
pub fn at(set: usize, index: usize) -> usize { return mem.getWord(mem.getWord(set + 24) + index * 8) }

pub fn member(set: usize, s: usize) -> bool {
    var i: usize = 0
    while i < size(set) {
        if strings.cmp(at(set, i), s) == 0 { return true }
        i += 1
    }
    return false
}

// A copy of `s` added at the end (true when it is there already).
pub fn add(set: usize, s: usize) -> bool {
    if set == 0 || s == 0 { return false }
    if member(set, s) { return true }
    const copy = mem.dupC(s)
    if copy == 0 { return false }
    return insert(set, copy, size(set))
}

pub fn addText(set: usize, text: []const u8) -> bool {
    const copy = mem.dupText(text)
    if copy == 0 { return false }
    const ok = add(set, copy)
    mem.free(copy)
    return ok
}

// `copy` (taken by the set) put at `position`.
pub fn insert(set: usize, copy: usize, position: usize) -> bool {
    const n = size(set)
    if n == mem.getWord(set + 16) {
        const room = if n < 8 { 8 } else { n * 2 }
        const strs = mem.grow(mem.getWord(set + 24), room * 8)
        if strs == 0 {
            mem.free(copy)
            return false
        }
        mem.putWord(set + 24, strs)
        mem.putWord(set + 16, room)
    }
    const strs = mem.getWord(set + 24)
    if position < n { mem.copy(strs + (position + 1) * 8, strs + position * 8, (n - position) * 8) }
    mem.putWord(strs + position * 8, copy)
    mem.putWord(set + 8, n + 1)
    return true
}

pub fn del(set: usize, s: usize) -> bool {
    var i: usize = 0
    while i < size(set) {
        if strings.cmp(at(set, i), s) == 0 {
            mem.free(at(set, i))
            const strs = mem.getWord(set + 24)
            const n = size(set)
            if i + 1 < n { mem.copy(strs + i * 8, strs + (i + 1) * 8, (n - i - 1) * 8) }
            mem.putWord(set + 8, n - 1)
            return true
        }
        i += 1
    }
    return false
}

// Whether the two sets have the same strings.
pub fn equal(a: usize, b: usize) -> bool {
    if size(a) != size(b) { return false }
    var i: usize = 0
    while i < size(a) {
        if !member(b, at(a, i)) { return false }
        i += 1
    }
    return true
}

// A copy of the set.
pub fn duplicate(set: usize) -> usize {
    const copy = create()
    if copy == 0 { return 0 }
    var i: usize = 0
    while i < size(set) {
        if !add(copy, at(set, i)) {
            destroy(copy)
            return 0
        }
        i += 1
    }
    return copy
}

// ---------------------------------------------------------------------------
// Lists.

pub fn listCreate(set: usize) -> usize {
    const list = mem.alloc(16)
    if list == 0 { return 0 }
    mem.putWord(list, reference(set))
    return list
}

pub fn listFirst(list: usize) -> void { mem.putWord(list + 8, 0) }

// The next string of the list, 0 at the end.
pub fn listNext(list: usize) -> usize {
    const set = mem.getWord(list)
    const n = mem.getWord(list + 8)
    if n >= size(set) { return 0 }
    mem.putWord(list + 8, n + 1)
    return at(set, n)
}

pub fn listDone(list: usize) -> void {
    if list == 0 { return }
    destroy(mem.getWord(list))
    mem.free(list)
}
