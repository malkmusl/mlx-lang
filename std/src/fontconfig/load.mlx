// std.fontconfig.load: configurations loaded and their fonts read, as
// Fontconfig's fcinit.c, fccfg.c and fcdir.c do it.
//
// A configuration is fonts.conf (FONTCONFIG_FILE, found as config.mlx's
// configFilename finds it) and what it includes, or, when there is none,
// Fontconfig's own fallback: /usr/share/fonts and the XDG fonts
// directories, /etc/fonts/conf.d and the XDG configuration's.
//
// Its fonts are its font directories' (and their subdirectories', each
// added at the end of the list as Fontconfig does, so that the order of
// the fonts is Fontconfig's): the files of a directory in byte order, each
// face (and named instance) read by scan.mlx and edited by the
// configuration's <match target="scan"> rules, then kept when the
// configuration accepts its file and pattern.
//
// What a directory has is kept in a cache of this module's own, not in
// Fontconfig's (whose binary format is Fontconfig's business): a text file
// a directory under $XDG_CACHE_HOME/mlx-fontconfig (~/.cache/...), named
// by a hash of the directory's name, with the directory's name and
// modification time, its subdirectories and its fonts' patterns as names
// (FcNameUnparse). It is used while the directory's time is the one it
// has, as Fontconfig uses its own; a directory whose cache cannot be
// written is read each time.
const mem = @import("./mem.mlx")
const strings = @import("./strings.mlx")
const strset = @import("./strset.mlx")
const objects = @import("./objects.mlx")
const pattern = @import("./pattern.mlx")
const config = @import("./config.mlx")
const confparse = @import("./confparse.mlx")
const paths = @import("./paths.mlx")
const scan = @import("./scan.mlx")
const env = @import("./env.mlx")
const fs = @import("../../bootstrap/fs.mlx")
const linux = @import("../../bootstrap/os/linux.mlx")

// FcInitFallbackConfig's configuration (FC_DEFAULT_FONTS, FC_CACHEDIR and
// CONFIGDIR as Fontconfig is built on Linux distributions).
const FALLBACK: []const u8 = "<fontconfig>\n  <dir>/usr/share/fonts</dir>\n  <dir prefix=\"xdg\">fonts</dir>\n  <cachedir>/var/cache/fontconfig</cachedir>\n  <cachedir prefix=\"xdg\">fontconfig</cachedir>\n  <include ignore_missing=\"yes\">/etc/fonts/conf.d</include>\n  <include ignore_missing=\"yes\" prefix=\"xdg\">fontconfig/conf.d</include>\n  <include ignore_missing=\"yes\" prefix=\"xdg\">fontconfig/fonts.conf</include>\n</fontconfig>\n"

const CACHE_MAGIC: []const u8 = "mlx-fontconfig-cache 1"

// ---------------------------------------------------------------------------
// Configurations.

// FcConfigParseAndLoad: the configuration file `name` (0: fonts.conf)
// read into `c`.
pub fn parseAndLoad(c: usize, name: usize, complain: bool) -> bool {
    return confparse.parseFile(c, name, complain, true)
}

// FcConfigParseAndLoadFromMemory.
pub fn parseAndLoadMemory(c: usize, text: usize, complain: bool) -> bool {
    const name = mem.dupText("memory")
    const ok = confparse.parseMemory(c, name, text, mem.cLength(text), true)
    mem.free(name)
    return ok || !complain
}

fn fallbackConfig() -> usize {
    const c = config.create()
    if c == 0 { return 0 }
    const text = mem.dupText(FALLBACK)
    _ = parseAndLoadMemory(c, text, false)
    mem.free(text)
    return c
}

// FcInitLoadOwnConfig: `c` (0: a new configuration) with fonts.conf read
// into it, or the fallback configuration when fonts.conf cannot be read.
pub fn loadConfig(c0: usize) -> usize {
    var c = c0
    if c == 0 { c = config.create() }
    if c == 0 { return 0 }
    if !parseAndLoad(c, 0, true) {
        config.destroy(c)
        return fallbackConfig()
    }
    if strset.size(config.cacheDirs(c)) == 0 {
        _ = strset.addText(config.cacheDirs(c), "/var/cache/fontconfig")
        const home = paths.xdgCacheHome()
        if home != 0 {
            const dir = paths.buildFilenameText(home, "fontconfig")
            _ = strset.add(config.cacheDirs(c), dir)
            mem.free(dir)
            mem.free(home)
        }
    }
    return c
}

// FcInitLoadConfigAndFonts.
pub fn loadConfigAndFonts() -> usize {
    const c = loadConfig(0)
    if c == 0 { return 0 }
    if !buildFonts(c) {
        config.destroy(c)
        return 0
    }
    return c
}

// FcConfigBuildFonts: the system fonts of `c` read anew.
pub fn buildFonts(c: usize) -> bool {
    if c == 0 { return false }
    const set = pattern.fontSetCreate()
    if set == 0 { return false }
    config.setFonts(c, config.SET_SYSTEM, set)
    return addDirList(c, config.SET_SYSTEM, config.fontDirs(c))
}

// ---------------------------------------------------------------------------
// The current configuration.

// FcConfigGetCurrent (FcConfigEnsure): the current configuration, loaded
// with its fonts by the first who asks.
pub fn current() -> usize {
    mem.enter(&config.currentLock)
    if config.current == 0 {
        const c = loadConfigAndFonts()
        if c != 0 { config.current = c }
    }
    const result = config.current
    mem.leave(&config.currentLock)
    return result
}

// FcConfigReference(NULL) and FcConfigReference(c).
pub fn reference(c: usize) -> usize {
    if c != 0 { return config.reference(c) }
    mem.enter(&config.currentLock)
    const cur = current()
    _ = config.reference(cur)
    mem.leave(&config.currentLock)
    return cur
}

// FcConfigSetCurrent: `c` made current (its fonts built when they are not
// yet); the configuration it replaces released.
pub fn setCurrent(c: usize) -> bool {
    mem.enter(&config.currentLock)
    if c == config.current {
        mem.leave(&config.currentLock)
        return true
    }
    if c != 0 && config.fonts(c, config.SET_SYSTEM) == 0 {
        if !buildFonts(c) {
            mem.leave(&config.currentLock)
            return false
        }
    }
    const old = config.current
    if c != 0 { _ = config.reference(c) }
    config.current = c
    mem.leave(&config.currentLock)
    if old != 0 { config.destroy(old) }
    return true
}

// FcInit.
pub fn init() -> bool { return current() != 0 }

// FcFini: the current configuration released and the configuration
// files forgotten.
pub fn fini() -> void {
    mem.enter(&config.currentLock)
    const old = config.current
    config.current = 0
    mem.leave(&config.currentLock)
    if old != 0 { config.destroy(old) }
    confparse.forgetFiles()
}

// FcInitReinitialize: a new configuration with its fonts made current.
pub fn reinitialize() -> bool {
    // (The files read by the old configuration are read again.)
    confparse.forgetFiles()
    const c = loadConfigAndFonts()
    if c == 0 { return false }
    const ok = setCurrent(c)
    config.destroy(c)
    return ok
}

// The newest modification time (seconds) of a set's files, -1 when none
// can be read.
fn newest(set: usize) -> i64 {
    var result: i64 = -1
    var i: usize = 0
    while i < strset.size(set) {
        const t = paths.modified(strset.at(set, i))
        if t >= 0 {
            const seconds = t / 1000000000
            if seconds > result { result = seconds }
        }
        i += 1
    }
    return result
}

// FcConfigUptoDate: whether no configuration file, configuration
// directory or font directory changed since the configuration was built
// (a time in the future taken as no change, as Fontconfig takes it).
pub fn uptoDate(c0: usize) -> bool {
    const c = if c0 == 0 { current() } else { c0 }
    if c == 0 { return false }
    const rescanTime = @bitCast(i64, mem.get64(c + config.CONFIG_RESCAN_TIME))
    const t = mem.now()
    const a = newest(config.configFiles(c))
    const b = newest(config.configDirs(c))
    const f = newest(config.fontDirs(c))
    if a > rescanTime || b > rescanTime || f > rescanTime {
        if a > t || b > t || f > t {
            mem.put64(c + config.CONFIG_RESCAN_TIME, @bitCast(u64, t))
            return true
        }
        return false
    }
    mem.put64(c + config.CONFIG_RESCAN_TIME, @bitCast(u64, t))
    return true
}

// FcInitBringUptoDate: the current configuration reloaded when its rescan
// interval has passed and it is not up to date.
pub fn bringUptoDate() -> bool {
    const c = current()
    if c == 0 { return false }
    const interval = @bitCast(i64, mem.get64(c + config.CONFIG_RESCAN))
    if interval == 0 { return true }
    const rescanTime = @bitCast(i64, mem.get64(c + config.CONFIG_RESCAN_TIME))
    if rescanTime + interval - mem.now() > 0 { return true }
    if uptoDate(c) { return true }
    return reinitialize()
}

// ---------------------------------------------------------------------------
// Application fonts.

fn applicationSet(c: usize) -> usize {
    var set = config.fonts(c, config.SET_APPLICATION)
    if set == 0 {
        set = pattern.fontSetCreate()
        config.setFonts(c, config.SET_APPLICATION, set)
    }
    return set
}

// FcConfigAppFontAddFile: the fonts of a file (or of a directory and its
// subdirectories) added to the application fonts.
pub fn appFontAddFile(c: usize, file: usize) -> bool {
    if c == 0 || file == 0 { return false }
    const set = applicationSet(c)
    const subdirs = strset.create()
    const s = newScanner()
    if s == 0 {
        strset.destroy(subdirs)
        return false
    }
    const ok = scanFile(c, set, subdirs, file, s)
    freeScanner(s)
    if ok {
        var i: usize = 0
        while i < strset.size(subdirs) {
            _ = appFontAddDir(c, strset.at(subdirs, i))
            i += 1
        }
    }
    strset.destroy(subdirs)
    return ok
}

// FcConfigAppFontAddDir: the fonts of a directory and its subdirectories
// added to the application fonts.
pub fn appFontAddDir(c: usize, dir: usize) -> bool {
    if c == 0 || dir == 0 { return false }
    _ = applicationSet(c)
    const dirs = strset.create()
    addFilename(dirs, dir)
    const ok = addDirList(c, config.SET_APPLICATION, dirs)
    strset.destroy(dirs)
    return ok
}

// FcConfigAppFontClear.
pub fn appFontClear(c: usize) -> void {
    if c == 0 { return }
    config.setFonts(c, config.SET_APPLICATION, pattern.fontSetCreate())
}

// ---------------------------------------------------------------------------
// Directories and files read.

fn newScanner() -> usize {
    const block = mem.alloc(@sizeOf(scan.Scanner))
    if block == 0 { return 0 }
    const s = unsafe { @ptrFromInt(*scan.Scanner, block) }
    if !scan.initScanner(s) {
        scan.doneScanner(s)
        mem.free(block)
        return 0
    }
    return block
}

fn freeScanner(block: usize) -> void {
    scan.doneScanner(unsafe { @ptrFromInt(*scan.Scanner, block) })
    mem.free(block)
}

fn scannerOf(block: usize) -> *scan.Scanner { unsafe { return @ptrFromInt(*scan.Scanner, block) } }

// FcStrSetAddFilename: a file name made canonical, added unless it is
// there.
fn addFilename(set: usize, name: usize) -> void {
    const canonical = paths.copyFilename(name)
    if canonical == 0 { return }
    if !strset.member(set, canonical) {
        _ = strset.insert(set, canonical, strset.size(set))
    } else {
        mem.free(canonical)
    }
}

// FcConfigAddDirList: the fonts of the directories of `dirs` (and of the
// subdirectories they have, added to `dirs` as they are found) added to
// the configuration's set.
fn addDirList(c: usize, set: i64, dirs: usize) -> bool {
    const s = newScanner()
    if s == 0 { return false }
    var i: usize = 0
    while i < strset.size(dirs) {
        const dir = strset.at(dirs, i)
        const read = readDirectory(c, dir, s)
        if read.0 != 0 {
            addCache(c, read.0, read.1, set, dirs)
            pattern.fontSetDestroy(read.0)
            strset.destroy(read.1)
        }
        i += 1
    }
    freeScanner(s)
    return true
}

// FcConfigAddCache: a directory's fonts the configuration accepts added
// to its set, its subdirectories it accepts to `dirs`.
fn addCache(c: usize, fonts: usize, subdirs: usize, set: i64, dirs: usize) -> void {
    const target = config.fonts(c, set)
    var i: usize = 0
    while i < pattern.fontSetCount(fonts) {
        const font = pattern.fontSetFont(fonts, i)
        const file = pattern.firstString(font, objects.FILE)
        var accepted = true
        if file != 0 && !config.acceptFilename(c, file) { accepted = false }
        if accepted && !config.acceptFont(c, font) { accepted = false }
        if accepted {
            pattern.reference(font)
            if !pattern.fontSetAdd(target, font) { pattern.destroy(font) }
        }
        i += 1
    }
    i = 0
    while i < strset.size(subdirs) {
        const dir = strset.at(subdirs, i)
        if config.acceptFilename(c, dir) { addFilename(dirs, dir) }
        i += 1
    }
}

// FcDirCacheRead: a directory's fonts and subdirectories (a font set and a
// strset), from its cache while that is valid, else read (and cached);
// (0, 0) when the directory cannot be read.
pub fn readDirectory(c: usize, dir: usize, s: usize) -> (usize, usize) {
    const stamp = paths.modified(dir)
    if stamp < 0 || !paths.isDirectory(dir) { return (0, 0) }
    const cacheFile = cacheFilename(dir)
    if cacheFile != 0 {
        const cached = readCache(cacheFile, dir, stamp)
        if cached.0 != 0 {
            mem.free(cacheFile)
            return cached
        }
    }
    const fonts = pattern.fontSetCreate()
    const subdirs = strset.create()
    scanDirectory(c, fonts, subdirs, dir, s)
    if cacheFile != 0 {
        writeCache(cacheFile, dir, stamp, fonts, subdirs)
        mem.free(cacheFile)
    }
    return (fonts, subdirs)
}

// FcDirScanConfig: the files of a directory (not those whose names begin
// with "."), in byte order, read into `fonts` and `subdirs`.
pub fn scanDirectory(c: usize, fonts: usize, subdirs: usize, dir: usize, s: usize) -> void {
    const names = paths.listDirectory(dir)
    if names == 0 { return }
    paths.sortStrings(names)
    var i: usize = 0
    while i < strset.size(names) {
        const name = strset.at(names, i)
        if mem.get8(name) != 46 {
            const file = paths.buildFilename(dir, name)
            _ = scanFile(c, fonts, subdirs, file, s)
            mem.free(file)
        }
        i += 1
    }
    strset.destroy(names)
}

// FcFileScanConfig: a directory added to `subdirs`, a file's faces to
// `fonts` (edited by the configuration's scan rules).
pub fn scanFile(c: usize, fonts: usize, subdirs: usize, file: usize, s: usize) -> bool {
    if paths.isDirectory(file) {
        _ = strset.add(subdirs, file)
        return true
    }
    if fonts == 0 { return true }
    const before = pattern.fontSetCount(fonts)
    if scan.queryAll(scannerOf(s), file, fonts) == 0 { return false }
    var ok = true
    var i = before
    while i < pattern.fontSetCount(fonts) {
        if c != 0 && !config.substitute(c, pattern.fontSetFont(fonts, i), config.MATCH_SCAN) { ok = false }
        i += 1
    }
    return ok
}

// FcFreeTypeQuery / FcFileScan without a configuration: the faces of a
// file added to `fonts`; their number.
pub fn queryFile(file: usize, fonts: usize) -> usize {
    const s = newScanner()
    if s == 0 { return 0 }
    const n = scan.queryAll(scannerOf(s), file, fonts)
    freeScanner(s)
    return n
}

// ---------------------------------------------------------------------------
// The cache.

// The cache file of a directory: its name's FNV-1a hash in hexadecimal,
// under the cache directory (made when it is not there); 0 when there is
// no home for it.
fn cacheFilename(dir: usize) -> usize {
    const home = paths.xdgCacheHome()
    if home == 0 { return 0 }
    const base = paths.buildFilenameText(home, "mlx-fontconfig")
    mem.free(home)
    if !paths.isDirectory(base) {
        makeDirectories(base)
        if !paths.isDirectory(base) {
            mem.free(base)
            return 0
        }
    }
    var h: u64 = 14695981039346656037
    var at = dir
    while mem.get8(at) != 0 {
        h = (h ^ mem.get8(at)) *% 1099511628211
        at += 1
    }
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    _ = mem.appendC(&b, base)
    _ = mem.appendText(&b, "/")
    var shift: u64 = 64
    while shift > 0 {
        shift -= 4
        const digit = (h >> shift) & 15
        _ = mem.appendByte(&b, if digit < 10 { 48 + digit } else { 87 + digit })
    }
    _ = mem.appendText(&b, ".cache")
    mem.free(base)
    return mem.takeBuffer(&b)
}

// A directory made with the directories above it.
fn makeDirectories(dir: usize) -> void {
    if paths.isDirectory(dir) { return }
    const parent = paths.dirname(dir)
    if parent != 0 {
        if !mem.cIs(parent, "/") && !mem.cIs(parent, ".") && strings.cmp(parent, dir) != 0 { makeDirectories(parent) }
        mem.free(parent)
    }
    _ = fs.makeDir(mem.bytes(dir), 448)
}

// The line at `at` of the text ending at `end` ((start, length, next)).
fn lineAt(at: usize, end: usize) -> (usize, usize, usize) {
    var n: usize = 0
    while at + n < end && mem.get8(at + n) != 10 { n += 1 }
    var next = at + n
    if next < end { next += 1 }
    return (at, n, next)
}

fn lineIs(start: usize, length: usize, text: usize) -> bool {
    var i: usize = 0
    while i < length {
        if mem.get8(text + i) == 0 || mem.get8(text + i) != mem.get8(start + i) { return false }
        i += 1
    }
    return mem.get8(text + length) == 0
}

// A cache file read: (fonts, subdirectories) when it is the directory's at
// its time `stamp`, else (0, 0).
fn readCache(file: usize, dir: usize, stamp: i64) -> (usize, usize) {
    const data = paths.readFile(file)
    if data == 0 { return (0, 0) }
    const end = data + mem.sizeOf(data) - 1
    const magic = mem.dupText(CACHE_MAGIC)
    var line = lineAt(data, end)
    var valid = lineIs(line.0, line.1, magic)
    mem.free(magic)
    if valid {
        line = lineAt(line.2, end)
        valid = lineIs(line.0, line.1, dir)
    }
    if valid {
        line = lineAt(line.2, end)
        const copy = mem.dup(line.0, line.1)
        var stop: usize = 0
        valid = mem.parseInteger(copy, &stop) == stamp && stop == copy + line.1
        mem.free(copy)
    }
    if !valid {
        mem.free(data)
        return (0, 0)
    }
    const fonts = pattern.fontSetCreate()
    const subdirs = strset.create()
    var at = line.2
    while at < end && valid {
        line = lineAt(at, end)
        at = line.2
        if line.1 >= 2 {
            const kind = mem.get8(line.0)
            const copy = mem.dup(line.0 + 2, line.1 - 2)
            if kind == 100 {
                _ = strset.insert(subdirs, copy, strset.size(subdirs))
            } else if kind == 102 {
                const p = pattern.parseName(copy)
                mem.free(copy)
                if p == 0 {
                    valid = false
                } else if !pattern.fontSetAdd(fonts, p) {
                    pattern.destroy(p)
                }
            } else {
                mem.free(copy)
                valid = false
            }
        }
    }
    mem.free(data)
    if !valid {
        pattern.fontSetDestroy(fonts)
        strset.destroy(subdirs)
        return (0, 0)
    }
    return (fonts, subdirs)
}

// A font's pattern as a name for the cache: FcNameUnparse's, but with its
// size as an element (":size=[0 3276.75]"), since a range after the
// family ("Unifont-[0 3276.75]") does not parse back.
fn cacheName(font: usize) -> usize {
    const sizes = pattern.values(font, objects.SIZE)
    if sizes == 0 { return pattern.unparseName(font, true) }
    const copy = pattern.duplicate(font)
    if copy == 0 { return 0 }
    _ = pattern.del(copy, objects.SIZE)
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    const rest = pattern.unparseName(copy, true)
    pattern.destroy(copy)
    if rest == 0 { return 0 }
    _ = mem.appendC(&b, rest)
    mem.free(rest)
    _ = mem.appendText(&b, ":size=")
    _ = pattern.unparseValueList(&b, sizes, "\\=_:,")
    _ = mem.appendText(&b, "")
    return mem.takeBuffer(&b)
}

fn hasNewline(text: usize) -> bool {
    var at = text
    while mem.get8(at) != 0 {
        if mem.get8(at) == 10 { return true }
        at += 1
    }
    return false
}

// A directory's cache written (to a file of the process's renamed into
// place, so that a reader never sees half of it); nothing when a name
// would not fit on a line.
fn writeCache(file: usize, dir: usize, stamp: i64, fonts: usize, subdirs: usize) -> void {
    if hasNewline(dir) { return }
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    _ = mem.appendText(&b, CACHE_MAGIC)
    _ = mem.appendText(&b, "\n")
    _ = mem.appendC(&b, dir)
    _ = mem.appendText(&b, "\n")
    _ = mem.appendSigned(&b, stamp)
    _ = mem.appendText(&b, "\n")
    var fits = true
    var i: usize = 0
    while i < strset.size(subdirs) && fits {
        const d = strset.at(subdirs, i)
        if hasNewline(d) { fits = false }
        _ = mem.appendText(&b, "d ")
        _ = mem.appendC(&b, d)
        _ = mem.appendText(&b, "\n")
        i += 1
    }
    i = 0
    while i < pattern.fontSetCount(fonts) && fits {
        const name = cacheName(pattern.fontSetFont(fonts, i))
        if name == 0 || hasNewline(name) {
            fits = false
        } else {
            _ = mem.appendText(&b, "f ")
            _ = mem.appendC(&b, name)
            _ = mem.appendText(&b, "\n")
        }
        mem.free(name)
        i += 1
    }
    if !fits {
        mem.freeBuffer(&b)
        return
    }
    var tb: mem.Buffer = undefined
    mem.initBuffer(&tb)
    _ = mem.appendC(&tb, file)
    _ = mem.appendText(&tb, ".")
    _ = mem.appendSigned(&tb, @intCast(i64, linux.getpid()))
    const temporary = mem.takeBuffer(&tb)
    const out = fs.open(mem.bytes(temporary), fs.WRITE_ONLY | fs.CREATE | fs.TRUNCATE, 420)
    if fs.isValid(out) {
        const text = mem.bufferText(&b)
        const written = fs.writeAllBytes(out, text.pointer, text.length)
        _ = fs.close(out)
        if !written || !fs.rename(mem.bytes(temporary), mem.bytes(file)) { _ = fs.delete(mem.bytes(temporary)) }
    }
    mem.free(temporary)
    mem.freeBuffer(&b)
}
