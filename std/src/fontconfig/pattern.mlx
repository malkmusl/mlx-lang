// std.fontconfig.pattern: patterns (FcPattern), sets of them (FcFontSet)
// and sets of object names (FcObjectSet), as Fontconfig 2.15 has them: a
// pattern is a list of elements sorted by object number, each a list of
// values with their bindings; values are added at an element's end
// (`append`) or start. Patterns are counted references.
//
// A pattern is a record reached by its address:
//     0  references
//     8  the number of elements
//    16  the room for elements
//    24  the elements: records of 16 bytes (the object number, the
//        values: a list of value.mlx nodes)
// A font set is C's FcFontSet: 0 the number of fonts (32-bit), 4 the room
// (32-bit), 8 the patterns (an array of addresses). An object set is C's
// FcObjectSet: 0 the number (32-bit), 4 the room, 8 the names (an array
// of C strings, in the order they were added).
const mem = @import("./mem.mlx")
const strings = @import("./strings.mlx")
const objects = @import("./objects.mlx")
const value = @import("./value.mlx")
const charset = @import("./charset.mlx")
const lang = @import("./lang.mlx")

// FcResult.
pub const RESULT_MATCH: i64 = 0
pub const RESULT_NO_MATCH: i64 = 1
pub const RESULT_TYPE_MISMATCH: i64 = 2
pub const RESULT_NO_ID: i64 = 3
pub const RESULT_OUT_OF_MEMORY: i64 = 4

pub fn create() -> usize {
    const p = mem.alloc(32)
    if p == 0 { return 0 }
    mem.put64(p, 1)
    return p
}

pub fn reference(p: usize) -> void {
    if p != 0 { _ = @atomicRmw(u64, unsafe { @ptrFromInt(*u64, p) }, add, 1, monotonic) }
}

pub fn destroy(p: usize) -> void {
    if p == 0 { return }
    if @atomicRmw(u64, unsafe { @ptrFromInt(*u64, p) }, sub, 1, acq_rel) != 1 { return }
    var i: usize = 0
    while i < count(p) {
        value.destroyList(eltValues(elt(p, i)))
        i += 1
    }
    mem.free(mem.getWord(p + 24))
    mem.free(p)
}

pub fn count(p: usize) -> usize { return if p == 0 { 0 } else { mem.getWord(p + 8) } }
pub fn elt(p: usize, i: usize) -> usize { return mem.getWord(p + 24) + i * 16 }
pub fn eltObject(e: usize) -> i64 { return @bitCast(i64, mem.get64(e)) }
pub fn eltValues(e: usize) -> usize { return mem.getWord(e + 8) }
pub fn setEltValues(e: usize, list: usize) -> void { mem.putWord(e + 8, list) }

// The position of `object`'s element, or -(the position it would have) - 1.
pub fn position(p: usize, object: i64) -> i64 {
    var low: i64 = 0
    var high: i64 = @intCast(i64, count(p)) - 1
    var c: i64 = 1
    var mid: i64 = 0
    while low <= high {
        mid = (low + high) >> 1
        c = eltObject(elt(p, @intCast(usize, mid))) - object
        if c == 0 { return mid }
        if c < 0 { low = mid + 1 } else { high = mid - 1 }
    }
    if c < 0 { mid += 1 }
    return 0 - (mid + 1)
}

pub fn findElt(p: usize, object: i64) -> usize {
    if p == 0 { return 0 }
    const i = position(p, object)
    if i < 0 { return 0 }
    return elt(p, @intCast(usize, i))
}

// The values of `object` (a list), 0 when the pattern has none.
pub fn values(p: usize, object: i64) -> usize {
    const e = findElt(p, object)
    return if e == 0 { 0 } else { eltValues(e) }
}

// The element of `object`, made (empty) when there is none.
pub fn insertElt(p: usize, object: i64) -> usize {
    var i = position(p, object)
    if i >= 0 { return elt(p, @intCast(usize, i)) }
    i = 0 - i - 1
    const n = count(p)
    if n + 1 >= mem.getWord(p + 16) {
        const room = mem.getWord(p + 16) + 16
        const grown = mem.grow(mem.getWord(p + 24), room * 16)
        if grown == 0 { return 0 }
        mem.putWord(p + 24, grown)
        mem.putWord(p + 16, room)
    }
    const elts = mem.getWord(p + 24)
    const at = @intCast(usize, i)
    if at < n { mem.copy(elts + (at + 1) * 16, elts + at * 16, (n - at) * 16) }
    mem.put64(elts + at * 16, @bitCast(u64, object))
    mem.putWord(elts + at * 16 + 8, 0)
    mem.putWord(p + 8, n + 1)
    return elts + at * 16
}

// The element `e` taken out (its values destroyed).
fn removeElt(p: usize, e: usize) -> void {
    value.destroyList(eltValues(e))
    const elts = mem.getWord(p + 24)
    const n = count(p)
    const at = (e - elts) / 16
    if at + 1 < n { mem.copy(elts + at * 16, elts + (at + 1) * 16, (n - at - 1) * 16) }
    mem.putWord(p + 8, n - 1)
    mem.put64(elts + (n - 1) * 16, 0)
    mem.putWord(elts + (n - 1) * 16 + 8, 0)
}

// A node (taken) put in the element of `object` (false, the node
// destroyed, for one of the wrong type).
pub fn addNode(p: usize, object: i64, n: usize, append: bool) -> bool {
    if p == 0 || n == 0 { return false }
    if !objects.validType(object, value.typeOf(n + 8)) {
        value.destroyList(n)
        return false
    }
    const e = insertElt(p, object)
    if e == 0 {
        value.destroyList(n)
        return false
    }
    if append {
        const tail = value.last(eltValues(e))
        if tail == 0 { setEltValues(e, n) } else { value.setNext(tail, n) }
    } else {
        value.setNext(n, eltValues(e))
        setEltValues(e, n)
    }
    return true
}

// FcPatternObjectAddWithBinding: a copy of the value `t`, `word` added
// (false for a void value or one of the wrong type).
pub fn addWithBinding(p: usize, object: i64, t: i64, word: u64, binding: i64, append: bool) -> bool {
    if p == 0 { return false }
    return addNode(p, object, value.node(t, word, binding), append)
}

pub fn add(p: usize, object: i64, t: i64, word: u64, append: bool) -> bool { return addWithBinding(p, object, t, word, value.BINDING_STRONG, append) }

// A copy of the value at `v` (a FcValue of 16 bytes) added.
pub fn addValue(p: usize, object: i64, v: usize, binding: i64, append: bool) -> bool { return addWithBinding(p, object, value.typeOf(v), value.wordOf(v), binding, append) }

// FcPatternObjectListAdd: the list `list` (taken) added to the element.
pub fn listAdd(p: usize, object: i64, list: usize, append: bool) -> bool {
    var l = list
    while l != 0 {
        if !objects.validType(object, value.typeOf(l + 8)) { return false }
        l = value.next(l)
    }
    const e = insertElt(p, object)
    if e == 0 { return false }
    if append {
        const tail = value.last(eltValues(e))
        if tail == 0 { setEltValues(e, list) } else { value.setNext(tail, list) }
    } else {
        const tail = value.last(list)
        if tail != 0 {
            value.setNext(tail, eltValues(e))
            setEltValues(e, list)
        }
    }
    return true
}

pub fn addInteger(p: usize, object: i64, i: i64) -> bool { return add(p, object, objects.TYPE_INTEGER, value.intWord(i), true) }
pub fn addDouble(p: usize, object: i64, d: f64) -> bool { return add(p, object, objects.TYPE_DOUBLE, value.doubleWord(d), true) }
pub fn addBool(p: usize, object: i64, b: i64) -> bool { return add(p, object, objects.TYPE_BOOL, value.intWord(b), true) }

// A string (a C string, copied); a null string is refused.
pub fn addString(p: usize, object: i64, s: usize) -> bool {
    if s == 0 { return false }
    return add(p, object, objects.TYPE_STRING, @intCast(u64, s), true)
}

pub fn addText(p: usize, object: i64, text: []const u8) -> bool {
    const s = mem.dupText(text)
    if s == 0 { return false }
    return addNode(p, object, value.nodeTaking(objects.TYPE_STRING, @intCast(u64, s), value.BINDING_STRONG), true)
}

// A value pointing to `address` (copied, or referenced for a charset).
pub fn addPointer(p: usize, object: i64, t: i64, address: usize) -> bool {
    if address == 0 { return false }
    return add(p, object, t, @intCast(u64, address), true)
}

pub fn addRange(p: usize, object: i64, begin: f64, end: f64) -> bool {
    const r = value.rangeCreate(begin, end)
    if r == 0 { return false }
    return addNode(p, object, value.nodeTaking(objects.TYPE_RANGE, @intCast(u64, r), value.BINDING_STRONG), true)
}

pub fn del(p: usize, object: i64) -> bool {
    const e = findElt(p, object)
    if e == 0 { return false }
    removeElt(p, e)
    return true
}

// FcPatternRemove: the value `id` of the element taken out (the element
// too when it was its last).
pub fn remove(p: usize, object: i64, id: i64) -> bool {
    const e = findElt(p, object)
    if e == 0 { return false }
    var previous: usize = 0
    var l = eltValues(e)
    var k = id
    while l != 0 {
        if k == 0 {
            if previous == 0 { setEltValues(e, value.next(l)) } else { value.setNext(previous, value.next(l)) }
            value.setNext(l, 0)
            value.destroyList(l)
            if eltValues(e) == 0 { _ = del(p, object) }
            return true
        }
        k -= 1
        previous = l
        l = value.next(l)
    }
    return false
}

// FcPatternObjectGetWithBinding: the value `id` (its address in the
// pattern, a FcValue of 16 bytes) into `out`, with its binding.
pub fn getWithBinding(p: usize, object: i64, id: i64, out: *usize, binding: *i64) -> i64 {
    if p == 0 { return RESULT_NO_MATCH }
    const e = findElt(p, object)
    if e == 0 { return RESULT_NO_MATCH }
    var l = eltValues(e)
    var k = id
    while l != 0 {
        if k == 0 {
            out.* = value.valueOf(l)
            binding.* = value.bindingOf(l)
            return RESULT_MATCH
        }
        k -= 1
        l = value.next(l)
    }
    return RESULT_NO_ID
}

pub fn get(p: usize, object: i64, id: i64, out: *usize) -> i64 {
    var binding: i64 = 0
    return getWithBinding(p, object, id, out, &binding)
}

pub fn getInteger(p: usize, object: i64, id: i64, i: *i64) -> i64 {
    var v: usize = 0
    const r = get(p, object, id, &v)
    if r != RESULT_MATCH { return r }
    const t = value.typeOf(v)
    if t == objects.TYPE_DOUBLE {
        i.* = truncate(value.doubleOf(v))
    } else if t == objects.TYPE_INTEGER {
        i.* = value.intOf(v)
    } else {
        return RESULT_TYPE_MISMATCH
    }
    return RESULT_MATCH
}

// C's (int) of a double.
pub fn truncate(d: f64) -> i64 {
    if d != d { return -2147483648 }
    if d >= 2147483647.0 { return 2147483647 }
    if d <= -2147483648.0 { return -2147483648 }
    return @intFromFloat(i64, d)
}

pub fn getDouble(p: usize, object: i64, id: i64, d: *f64) -> i64 {
    var v: usize = 0
    const r = get(p, object, id, &v)
    if r != RESULT_MATCH { return r }
    var ok = false
    const n = value.number(v, &ok)
    if !ok { return RESULT_TYPE_MISMATCH }
    d.* = n
    return RESULT_MATCH
}

// A value of the type `t` pointing somewhere (a string, matrix, charset,
// langset or range): its pointer into `out`.
pub fn getPointer(p: usize, object: i64, id: i64, t: i64, out: *usize) -> i64 {
    var v: usize = 0
    const r = get(p, object, id, &v)
    if r != RESULT_MATCH { return r }
    if value.typeOf(v) != t { return RESULT_TYPE_MISMATCH }
    out.* = value.pointerOf(v)
    return RESULT_MATCH
}

pub fn getString(p: usize, object: i64, id: i64, out: *usize) -> i64 { return getPointer(p, object, id, objects.TYPE_STRING, out) }

pub fn getBool(p: usize, object: i64, id: i64, b: *i64) -> i64 {
    var v: usize = 0
    const r = get(p, object, id, &v)
    if r != RESULT_MATCH { return r }
    if value.typeOf(v) != objects.TYPE_BOOL { return RESULT_TYPE_MISMATCH }
    b.* = value.boolOf(v)
    return RESULT_MATCH
}

// The first string of `object`, 0 when there is none.
pub fn firstString(p: usize, object: i64) -> usize {
    var s: usize = 0
    if getString(p, object, 0, &s) != RESULT_MATCH { return 0 }
    return s
}

pub fn duplicate(p: usize) -> usize {
    if p == 0 { return 0 }
    const copy = create()
    if copy == 0 { return 0 }
    var i: usize = 0
    while i < count(p) {
        const e = elt(p, i)
        setEltValues(insertElt(copy, eltObject(e)), value.duplicateList(eltValues(e)))
        i += 1
    }
    return copy
}

// FcPatternAppend: every value of `s` added to `p`.
pub fn append(p: usize, s: usize) -> bool {
    var i: usize = 0
    while i < count(s) {
        const e = elt(s, i)
        var l = eltValues(e)
        while l != 0 {
            if !addValue(p, eltObject(e), value.valueOf(l), value.bindingOf(l), true) { return false }
            l = value.next(l)
        }
        i += 1
    }
    return true
}

pub fn equal(a: usize, b: usize) -> bool {
    if a == b { return true }
    if count(a) != count(b) { return false }
    var i: usize = 0
    while i < count(a) {
        const ea = elt(a, i)
        const eb = elt(b, i)
        if eltObject(ea) != eltObject(eb) { return false }
        if !value.listEqual(eltValues(ea), eltValues(eb)) { return false }
        i += 1
    }
    return true
}

// FcPatternHash (32-bit).
pub fn hash(p: usize) -> u64 {
    var h: u64 = 0
    var i: usize = 0
    while i < count(p) {
        const e = elt(p, i)
        h = ((((h << 1) & 0xffffffff) | (h >> 31)) ^ (@bitCast(u64, eltObject(e)) & 0xffffffff) ^ value.listHash(eltValues(e))) & 0xffffffff
        i += 1
    }
    return h
}

// ---------------------------------------------------------------------------
// Object sets.

pub fn objectSetCreate() -> usize { return mem.alloc(16) }

pub fn objectSetCount(os: usize) -> usize { return @intCast(usize, mem.get32(os)) }
pub fn objectSetName(os: usize, i: usize) -> usize { return mem.getWord(mem.getWord(os + 8) + i * 8) }

// A name added (a copy; nothing when it is there already). Fontconfig
// keeps the names sorted by the addresses of its copies, which is the
// order they were added in for a program's allocator handing out rising
// addresses; here it is that order.
pub fn objectSetAdd(os: usize, name: usize) -> bool {
    const n = objectSetCount(os)
    var i: usize = 0
    while i < n {
        if strings.cmp(objectSetName(os, i), name) == 0 { return true }
        i += 1
    }
    if n == @intCast(usize, mem.get32(os + 4)) {
        const room = n + 4
        const grown = mem.grow(mem.getWord(os + 8), room * 8)
        if grown == 0 { return false }
        mem.putWord(os + 8, grown)
        mem.put32(os + 4, room)
    }
    const copy = mem.dupC(name)
    if copy == 0 { return false }
    mem.putWord(mem.getWord(os + 8) + n * 8, copy)
    mem.put32(os, n + 1)
    return true
}

pub fn objectSetDestroy(os: usize) -> void {
    if os == 0 { return }
    var i: usize = 0
    while i < objectSetCount(os) {
        mem.free(objectSetName(os, i))
        i += 1
    }
    mem.free(mem.getWord(os + 8))
    mem.free(os)
}

// FcPatternFilter: the pattern with only the objects of `os` (all of them
// when `os` is 0).
pub fn filter(p: usize, os: usize) -> usize {
    if os == 0 { return duplicate(p) }
    const result = create()
    if result == 0 { return 0 }
    var i: usize = 0
    while i < objectSetCount(os) {
        const object = objects.fromName(objectSetName(os, i))
        const e = findElt(p, object)
        if e != 0 {
            var l = eltValues(e)
            while l != 0 {
                if !addValue(result, object, value.valueOf(l), value.bindingOf(l), true) {
                    destroy(result)
                    return 0
                }
                l = value.next(l)
            }
        }
        i += 1
    }
    return result
}

// FcPatternEqualSubset: the same values for each object of `os`.
pub fn equalSubset(a: usize, b: usize, os: usize) -> bool {
    var i: usize = 0
    while i < objectSetCount(os) {
        const object = objects.fromName(objectSetName(os, i))
        const ea = findElt(a, object)
        const eb = findElt(b, object)
        if ea != 0 {
            if eb == 0 { return false }
            if !value.listEqual(eltValues(ea), eltValues(eb)) { return false }
        } else if eb != 0 {
            return false
        }
        i += 1
    }
    return true
}

// ---------------------------------------------------------------------------
// Font sets.

pub fn fontSetCreate() -> usize { return mem.alloc(16) }

pub fn fontSetCount(fs: usize) -> usize { return if fs == 0 { 0 } else { @intCast(usize, mem.get32(fs)) } }
pub fn fontSetFont(fs: usize, i: usize) -> usize { return mem.getWord(mem.getWord(fs + 8) + i * 8) }

// `font` added to the set (which takes the reference given).
pub fn fontSetAdd(fs: usize, font: usize) -> bool {
    const n = fontSetCount(fs)
    if n == @intCast(usize, mem.get32(fs + 4)) {
        const room = if n == 0 { 32 } else { n * 2 }
        const grown = mem.grow(mem.getWord(fs + 8), room * 8)
        if grown == 0 { return false }
        mem.putWord(fs + 8, grown)
        mem.put32(fs + 4, room)
    }
    mem.putWord(mem.getWord(fs + 8) + n * 8, font)
    mem.put32(fs, n + 1)
    return true
}

pub fn fontSetDestroy(fs: usize) -> void {
    if fs == 0 { return }
    var i: usize = 0
    while i < fontSetCount(fs) {
        destroy(fontSetFont(fs, i))
        i += 1
    }
    mem.free(mem.getWord(fs + 8))
    mem.free(fs)
}

// ---------------------------------------------------------------------------
// Names: "family-size:object=value,value:constant..." (FcNameParse,
// FcNameUnparse).

// The next part of a name from `at` (blanks first passed over; `\`
// escapes a byte) into `save`, up to a byte of `delims`; that byte (0 at
// the end) into `last`, the position after it returned.
fn findNext(at: usize, delims: []const u8, save: usize, last: *u64) -> usize {
    var cur = at
    while mem.get8(cur) != 0 && mem.isSpace(mem.get8(cur)) { cur += 1 }
    var out = save
    while true {
        var c = mem.get8(cur)
        if c == 0 { break }
        if c == 92 {
            cur += 1
            c = mem.get8(cur)
            if c == 0 { break }
        } else {
            var isDelim = false
            for d in delims {
                if @intCast(u64, d) == c { isDelim = true }
            }
            if isDelim { break }
        }
        cur += 1
        mem.put8(out, c)
        out += 1
    }
    mem.put8(out, 0)
    last.* = mem.get8(cur)
    if mem.get8(cur) != 0 { cur += 1 }
    return cur
}

// A value of the type `t` of an object (named `objectName`) from text
// (FcNameConvert): its type and word, what the word points to the
// caller's (a new string, matrix, charset, langset or range); void when
// the text is no such value.
pub fn convert(t: i64, objectName: usize, text: usize) -> (i64, u64) {
    var end: usize = 0
    if t == objects.TYPE_INTEGER {
        var i: i64 = 0
        if !objects.constantValueFor(text, objectName, &i) { i = mem.parseInteger(text, &end) }
        return (objects.TYPE_INTEGER, value.intWord(i))
    }
    if t == objects.TYPE_STRING {
        const copy = mem.dupC(text)
        if copy == 0 { return (objects.TYPE_VOID, 0) }
        return (objects.TYPE_STRING, @intCast(u64, copy))
    }
    if t == objects.TYPE_BOOL {
        var b: i64 = 0
        if !objects.nameBool(text, &b) { b = 0 }
        return (objects.TYPE_BOOL, value.intWord(b))
    }
    if t == objects.TYPE_DOUBLE { return (objects.TYPE_DOUBLE, value.doubleWord(mem.parseDouble(text, &end))) }
    if t == objects.TYPE_MATRIX {
        const m = mem.alloc(32)
        if m == 0 { return (objects.TYPE_VOID, 0) }
        value.matrixIdentity(m)
        var at = text
        var k: usize = 0
        while k < 4 {
            const d = mem.parseDouble(at, &end)
            if end == at { break }
            mem.putF64(m + k * 8, d)
            at = end
            k += 1
        }
        return (objects.TYPE_MATRIX, @intCast(u64, m))
    }
    if t == objects.TYPE_CHARSET {
        var stop: usize = 0
        const cs = charset.fromRanges(mem.cText(text), 0, &stop)
        if cs == 0 { return (objects.TYPE_VOID, 0) }
        return (objects.TYPE_CHARSET, @intCast(u64, cs))
    }
    if t == objects.TYPE_LANGSET {
        const ls = lang.parse(text)
        if ls == 0 { return (objects.TYPE_VOID, 0) }
        return (objects.TYPE_LANGSET, @intCast(u64, ls))
    }
    if t == objects.TYPE_RANGE { return convertRange(objectName, text) }
    return (objects.TYPE_VOID, 0)
}

// The constant named by `length` bytes at `at` of the object, -1 when
// those bytes name none of it (or none at all).
fn constantWord(objectName: usize, at: usize, length: usize) -> i64 {
    if length == 0 { return -1 }
    const word = mem.dup(at, length)
    if word == 0 { return -1 }
    var c: i64 = 0
    const ok = objects.constantValueFor(word, objectName, &c)
    mem.free(word)
    return if ok { c } else { -1 }
}

// "[b e]" (numbers or constants), else a number or a constant.
fn convertRange(objectName: usize, text: usize) -> (i64, u64) {
    var end: usize = 0
    if mem.get8(text) == 91 {
        const b = mem.parseDouble(text + 1, &end)
        if end != text + 1 {
            var after: usize = 0
            const e = mem.parseDouble(end, &after)
            if after != end {
                const r = value.rangeCreate(b, e)
                if r == 0 { return (objects.TYPE_VOID, 0) }
                return (objects.TYPE_RANGE, @intCast(u64, r))
            }
        }
        // ("[bold black]": two constants.)
        var at = text + 1
        while mem.get8(at) == 32 { at += 1 }
        var stop = at
        while mem.get8(stop) != 0 && mem.get8(stop) != 32 && mem.get8(stop) != 93 { stop += 1 }
        const first = constantWord(objectName, at, stop - at)
        at = stop
        while mem.get8(at) == 32 { at += 1 }
        stop = at
        while mem.get8(stop) != 0 && mem.get8(stop) != 32 && mem.get8(stop) != 93 { stop += 1 }
        const second = constantWord(objectName, at, stop - at)
        if first >= 0 && second >= 0 {
            const r = value.rangeCreate(@floatFromInt(f64, first), @floatFromInt(f64, second))
            if r == 0 { return (objects.TYPE_VOID, 0) }
            return (objects.TYPE_RANGE, @intCast(u64, r))
        }
    }
    var c: i64 = 0
    if objects.constantValueFor(text, objectName, &c) { return (objects.TYPE_DOUBLE, value.doubleWord(@floatFromInt(f64, c))) }
    const d = mem.parseDouble(text, &end)
    if end == text || mem.get8(end) != 0 { return (objects.TYPE_VOID, 0) }
    return (objects.TYPE_DOUBLE, value.doubleWord(d))
}

// FcNameParse.
pub fn parseName(name: usize) -> usize {
    const save = mem.alloc(mem.cLength(name) + 1)
    if save == 0 { return 0 }
    const p = create()
    if p == 0 {
        mem.free(save)
        return 0
    }
    var at = name
    var delim: u64 = 0
    while true {
        at = findNext(at, "-,:", save, &delim)
        if mem.get8(save) != 0 { _ = addString(p, objects.FAMILY, save) }
        if delim != 44 { break }
    }
    if delim == 45 {
        while true {
            at = findNext(at, "-,:", save, &delim)
            var end: usize = 0
            const d = mem.parseDouble(save, &end)
            if end != save { _ = addDouble(p, objects.SIZE, d) }
            if delim != 44 { break }
        }
    }
    while delim == 58 {
        at = findNext(at, "=_:", save, &delim)
        if mem.get8(save) == 0 { continue }
        if delim == 61 || delim == 95 {
            const object = objects.fromName(save)
            const objectName = objects.name(object)
            const t = objects.typeOf(object)
            while true {
                at = findNext(at, ":,", save, &delim)
                if t != objects.TYPE_UNKNOWN {
                    // (A value that is not one of the object's type fails
                    // the whole name, as FcPatternAdd's failure does.)
                    const converted = convert(t, objectName, save)
                    if converted.0 == objects.TYPE_VOID || !addNode(p, object, value.nodeTaking(converted.0, converted.1, value.BINDING_STRONG), true) {
                        mem.free(save)
                        destroy(p)
                        return 0
                    }
                }
                if delim != 44 { break }
            }
        } else {
            const c = objects.constantIndex(save)
            if c >= 0 {
                const index = @intCast(usize, c)
                const object = objects.fromName(objects.constantObject(index))
                const t = objects.typeOf(object)
                if t == objects.TYPE_INTEGER || t == objects.TYPE_DOUBLE || t == objects.TYPE_RANGE {
                    _ = addInteger(p, object, objects.constantValueAt(index))
                } else if t == objects.TYPE_BOOL {
                    _ = addBool(p, object, objects.constantValueAt(index))
                }
            }
        }
    }
    mem.free(save)
    return p
}

fn unparseString(b: *mem.Buffer, s: usize, escape: []const u8) -> bool {
    var i: usize = 0
    while mem.get8(s + i) != 0 {
        const c = mem.get8(s + i)
        for e in escape {
            if @intCast(u64, e) == c {
                if !mem.appendByte(b, @intCast(u64, escape[0])) { return false }
                break
            }
        }
        if !mem.appendByte(b, c) { return false }
        i += 1
    }
    return true
}

// FcNameUnparseValue: a value as text, its strings' bytes of `escape`
// preceded by the first of them.
pub fn unparseValue(b: *mem.Buffer, v: usize, escape: []const u8) -> bool {
    const t = value.typeOf(v)
    if t == objects.TYPE_INTEGER { return mem.appendSigned(b, value.intOf(v)) }
    if t == objects.TYPE_DOUBLE { return mem.appendDouble(b, value.doubleOf(v)) }
    if t == objects.TYPE_STRING { return unparseString(b, value.pointerOf(v), escape) }
    if t == objects.TYPE_BOOL {
        const x = value.boolOf(v)
        return mem.appendText(b, if x == 1 { "True" } else if x == 0 { "False" } else { "DontCare" })
    }
    if t == objects.TYPE_MATRIX {
        const m = value.pointerOf(v)
        var k: usize = 0
        while k < 4 {
            if k > 0 { if !mem.appendByte(b, 32) { return false } }
            if !mem.appendDouble(b, mem.getF64(m + k * 8)) { return false }
            k += 1
        }
        return true
    }
    if t == objects.TYPE_CHARSET { return charset.appendRanges(b, value.pointerOf(v)) }
    if t == objects.TYPE_LANGSET { return lang.unparse(b, value.pointerOf(v)) }
    if t == objects.TYPE_RANGE {
        const r = value.pointerOf(v)
        if !mem.appendByte(b, 91) { return false }
        if !mem.appendDouble(b, value.rangeBegin(r)) { return false }
        if !mem.appendByte(b, 32) { return false }
        if !mem.appendDouble(b, value.rangeEnd(r)) { return false }
        return mem.appendByte(b, 93)
    }
    return true
}

pub fn unparseValueList(b: *mem.Buffer, list: usize, escape: []const u8) -> bool {
    var l = list
    while l != 0 {
        if !unparseValue(b, value.valueOf(l), escape) { return false }
        l = value.next(l)
        if l != 0 { if !mem.appendByte(b, 44) { return false } }
    }
    return true
}

// FcNameUnparseEscaped: a pattern as a name (the family, the size, then
// every built-in object), a new C string.
pub fn unparseName(p: usize, escape: bool) -> usize {
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    const fixed = if escape { "\\-:," } else { "" }
    const variable = if escape { "\\=_:," } else { "" }
    var e = findElt(p, objects.FAMILY)
    if e != 0 { _ = unparseValueList(&b, eltValues(e), fixed) }
    e = findElt(p, objects.SIZE)
    if e != 0 {
        var sized: mem.Buffer = undefined
        mem.initBuffer(&sized)
        _ = mem.appendByte(&sized, 45)
        _ = unparseValueList(&sized, eltValues(e), fixed)
        if sized.length > 1 { _ = mem.appendText(&b, mem.bufferText(&sized)) }
        mem.freeBuffer(&sized)
    }
    var id: i64 = 1
    while id <= objects.MAX_BASE {
        if id != objects.FAMILY && id != objects.SIZE {
            e = findElt(p, id)
            if e != 0 {
                _ = mem.appendByte(&b, 58)
                _ = unparseString(&b, objects.name(id), variable)
                _ = mem.appendByte(&b, 61)
                _ = unparseValueList(&b, eltValues(e), variable)
            }
        }
        id += 1
    }
    return mem.takeBuffer(&b)
}

// ---------------------------------------------------------------------------
// Printing (FcValuePrint, FcPatternPrint) into a buffer.

pub fn printValue(b: *mem.Buffer, v: usize) -> bool {
    const t = value.typeOf(v)
    if t == objects.TYPE_UNKNOWN { return mem.appendText(b, "<unknown>") }
    if t == objects.TYPE_VOID { return mem.appendText(b, "<void>") }
    if t == objects.TYPE_INTEGER {
        _ = mem.appendSigned(b, value.intOf(v))
        return mem.appendText(b, "(i)")
    }
    if t == objects.TYPE_DOUBLE {
        _ = mem.appendDouble(b, value.doubleOf(v))
        return mem.appendText(b, "(f)")
    }
    if t == objects.TYPE_STRING {
        _ = mem.appendByte(b, 34)
        _ = mem.appendC(b, value.pointerOf(v))
        return mem.appendByte(b, 34)
    }
    if t == objects.TYPE_BOOL {
        const x = value.boolOf(v)
        return mem.appendText(b, if x == 1 { "True" } else if x == 0 { "False" } else { "DontCare" })
    }
    if t == objects.TYPE_MATRIX {
        const m = value.pointerOf(v)
        _ = mem.appendByte(b, 91)
        _ = mem.appendDouble(b, mem.getF64(m))
        _ = mem.appendByte(b, 32)
        _ = mem.appendDouble(b, mem.getF64(m + 8))
        _ = mem.appendText(b, "; ")
        _ = mem.appendDouble(b, mem.getF64(m + 16))
        _ = mem.appendByte(b, 32)
        _ = mem.appendDouble(b, mem.getF64(m + 24))
        return mem.appendByte(b, 93)
    }
    if t == objects.TYPE_CHARSET { return printCharSet(b, value.pointerOf(v)) }
    if t == objects.TYPE_LANGSET { return lang.unparse(b, value.pointerOf(v)) }
    if t == objects.TYPE_RANGE {
        const r = value.pointerOf(v)
        _ = mem.appendByte(b, 91)
        _ = mem.appendDouble(b, value.rangeBegin(r))
        _ = mem.appendByte(b, 32)
        _ = mem.appendDouble(b, value.rangeEnd(r))
        return mem.appendByte(b, 93)
    }
    return mem.appendText(b, "face")
}

// FcCharSetPrint: a line a page, its number and eight words of bits.
pub fn printCharSet(b: *mem.Buffer, cs: usize) -> bool {
    _ = mem.appendByte(b, 10)
    var i: usize = 0
    while i < @intCast(usize, charset.pageCount(cs)) {
        _ = mem.appendByte(b, 9)
        const page = mem.get32(mem.getWord(cs + 24) + i * 4)
        appendHexWidth(b, page, 4)
        _ = mem.appendByte(b, 58)
        const leaf = charset.leafAt(cs, i)
        var w: usize = 0
        while w < 8 {
            _ = mem.appendByte(b, 32)
            appendHexWidth(b, mem.get32(leaf + w * 4), 8)
            w += 1
        }
        _ = mem.appendByte(b, 10)
        i += 1
    }
    return true
}

fn appendHexWidth(b: *mem.Buffer, v: u64, width: u64) -> void {
    var digits: u64 = 1
    var rest = v >> 4
    while rest != 0 {
        digits += 1
        rest = rest >> 4
    }
    while digits < width {
        _ = mem.appendByte(b, 48)
        digits += 1
    }
    _ = mem.appendHex(b, v)
}

pub fn printValueList(b: *mem.Buffer, list: usize) -> bool {
    var l = list
    while l != 0 {
        _ = mem.appendByte(b, 32)
        _ = printValue(b, value.valueOf(l))
        const binding = value.bindingOf(l)
        _ = mem.appendText(b, if binding == value.BINDING_WEAK { "(w)" } else if binding == value.BINDING_STRONG { "(s)" } else { "(=)" })
        l = value.next(l)
    }
    return true
}

pub fn print(b: *mem.Buffer, p: usize) -> bool {
    if p == 0 { return mem.appendText(b, "Null pattern\n") }
    _ = mem.appendText(b, "Pattern has ")
    _ = mem.appendUnsigned(b, count(p))
    _ = mem.appendText(b, " elts (size ")
    _ = mem.appendUnsigned(b, mem.getWord(p + 16))
    _ = mem.appendText(b, ")\n")
    // (Fontconfig's loop prints a line of no object for an empty pattern.)
    if count(p) == 0 { _ = mem.appendText(b, "\t(null):\n") }
    var i: usize = 0
    while i < count(p) {
        const e = elt(p, i)
        _ = mem.appendByte(b, 9)
        _ = mem.appendC(b, objects.name(eltObject(e)))
        _ = mem.appendByte(b, 58)
        if eltValues(e) == 0 {
            _ = mem.appendText(b, " Empty")
        } else {
            _ = printValueList(b, eltValues(e))
        }
        _ = mem.appendText(b, "\n")
        i += 1
    }
    return mem.appendText(b, "\n")
}
