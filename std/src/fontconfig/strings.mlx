// std.fontconfig.strings: Fontconfig's comparisons of C strings (family
// names, styles, file names): ignoring case, ignoring blanks too, word
// and substring searches, globs, the hashes of its tables, and UTF-8 and
// UTF-16 to code points.
//
// Case is folded as Fontconfig folds it (fcstr.c's FcCaseWalker): a byte
// at a time, ASCII letters lowered, and a character that CaseFolding.txt
// folds (its common and full foldings, data.mlx's CASE_FOLDING) replaced
// by the UTF-8 of what it folds to, so that "Курсив" and "курсив" are
// the same name and "Straße" is "strasse". (Fontconfig 2.15's table is of
// Unicode 15.1, this one of the Unicode Character Database in
// std/registry/unicode: the letters added since fold here and not there.)
const mem = @import("./mem.mlx")
const data = @import("./data.mlx")

// ASCII's lower case (FcToLower: what the language and constant
// comparisons use).
pub fn lower(c: u64) -> u64 { return if c >= 65 && c <= 90 { c + 32 } else { c } }

// The folding, read from CASE_FOLDING when first needed: records of 8
// bytes in order of their characters (the code, 32 bits; where the UTF-8
// it folds to starts in `foldBytes`, 16 bits; its length, 8 bits).
var folds: usize = 0
var foldCount: usize = 0
var foldBytes: usize = 0
var foldGuard: u32 = 0

fn hexAt(text: []const u8, at: *usize) -> u64 {
    var value: u64 = 0
    while at.* < text.length {
        const digit = mem.hexDigit(@intCast(u64, text[at.*]))
        if digit < 0 { break }
        value = value * 16 + @intCast(u64, digit)
        at.* += 1
    }
    return value
}

fn loadFolds() -> void {
    mem.lock(&foldGuard)
    if folds != 0 {
        mem.unlock(&foldGuard)
        return
    }
    const text = data.CASE_FOLDING
    var lines: usize = 0
    for c in text {
        if c == 10 { lines += 1 }
    }
    const table = mem.alloc(lines * 8 + 8)
    const utf8 = mem.alloc(lines * 12 + 8)
    if table == 0 || utf8 == 0 {
        mem.unlock(&foldGuard)
        return
    }
    var count: usize = 0
    var used: usize = 0
    var at: usize = 0
    while at < text.length {
        const code = hexAt(text, &at)
        const start = used
        while at < text.length && text[at] == 32 {
            at += 1
            const folded = hexAt(text, &at)
            const n = ucs4ToUtf8(folded, utf8 + used)
            used += @intCast(usize, n)
        }
        at += 1
        mem.put32(table + count * 8, code)
        mem.put16(table + count * 8 + 4, @intCast(u64, start))
        mem.put8(table + count * 8 + 6, @intCast(u64, used - start))
        count += 1
    }
    foldBytes = utf8
    foldCount = count
    @atomicStore(usize, &folds, table, release)
    mem.unlock(&foldGuard)
}

// The record of the character `c` in the folding, 0 when it has none.
fn foldOf(c: u64) -> usize {
    if @atomicLoad(usize, &folds, acquire) == 0 { loadFolds() }
    if folds == 0 { return 0 }
    var low: usize = 0
    var high = foldCount
    while low < high {
        const middle = (low + high) / 2
        const code = mem.get32(folds + middle * 8)
        if code == c { return folds + middle * 8 }
        if code < c { low = middle + 1 } else { high = middle }
    }
    return 0
}

// FcStrCaseWalkerLong: the lead byte `r` of a character of `s` (`at.*`
// after it): its folding's first byte, the others left in `pending` (low
// byte first) and the character's other bytes passed; `r` when it does
// not fold.
fn walkLong(s: usize, at: *usize, pending: *u64, r: u64) -> u64 {
    var ucs4: u64 = 0
    const slen = utf8ToUcs4(s + at.* - 1, &ucs4, @intCast(i64, mem.cLength(s + at.* - 1)))
    if slen <= 0 { return r }
    const record = foldOf(ucs4)
    if record == 0 { return r }
    const from = foldBytes + @intCast(usize, mem.get16(record + 4))
    const n = @intCast(usize, mem.get8(record + 6))
    var rest: u64 = 0
    var k = n
    while k > 1 {
        k -= 1
        rest = (rest << 8) | mem.get8(from + k)
    }
    pending.* = rest
    at.* += @intCast(usize, slen) - 1
    return mem.get8(from)
}

// FcStrCaseWalkerNext (and ...NonBlank, ...NonDelim): the next byte of a
// walk over `s` (at `at`, with `pending` bytes of a folded character),
// folded; spaces (`skipBlanks`) or the bytes of `delims` skipped; 0 at
// the end.
fn walkFolded(s: usize, at: *usize, pending: *u64, skipBlanks: bool, delims: []const u8) -> u64 {
    if pending.* != 0 {
        const first = pending.* & 255
        pending.* = pending.* >> 8
        return first
    }
    var r = mem.get8(s + at.*)
    at.* += 1
    if skipBlanks {
        while r == 32 {
            r = mem.get8(s + at.*)
            at.* += 1
        }
    } else if delims.length != 0 {
        while r != 0 && isDelim(r, delims) {
            r = mem.get8(s + at.*)
            at.* += 1
        }
    }
    if (r & 0xc0) == 0xc0 { return walkLong(s, at, pending, r) }
    return lower(r)
}

fn walk(s: usize, at: *usize, pending: *u64, skipBlanks: bool) -> u64 { return walkFolded(s, at, pending, skipBlanks, "") }

// FcStrCmpIgnoreCase: <0, 0 or >0.
pub fn cmpIgnoreCase(a: usize, b: usize) -> i64 {
    if a == b { return 0 }
    var i: usize = 0
    var j: usize = 0
    var pi: u64 = 0
    var pj: u64 = 0
    while true {
        const c1 = walk(a, &i, &pi, false)
        const c2 = walk(b, &j, &pj, false)
        if c1 == 0 || c1 != c2 { return @intCast(i64, c1) - @intCast(i64, c2) }
    }
    return 0
}

// FcStrCmpIgnoreBlanksAndCase: spaces are not compared.
pub fn cmpIgnoreBlanksAndCase(a: usize, b: usize) -> i64 {
    if a == b { return 0 }
    var i: usize = 0
    var j: usize = 0
    var pi: u64 = 0
    var pj: u64 = 0
    while true {
        const c1 = walk(a, &i, &pi, true)
        const c2 = walk(b, &j, &pj, true)
        if c1 == 0 || c1 != c2 { return @intCast(i64, c1) - @intCast(i64, c2) }
    }
    return 0
}

// FcStrCmp: bytes.
pub fn cmp(a: usize, b: usize) -> i64 {
    if a == b { return 0 }
    var i: usize = 0
    while true {
        const c1 = mem.get8(a + i)
        const c2 = mem.get8(b + i)
        if c1 == 0 || c1 != c2 { return @intCast(i64, c1) - @intCast(i64, c2) }
        i += 1
    }
    return 0
}

pub fn equalIgnoreCase(a: usize, b: usize) -> bool { return cmpIgnoreCase(a, b) == 0 }

// The same ignoring case, of a C string and a slice of ASCII.
pub fn isIgnoreCase(a: usize, b: []const u8) -> bool {
    var i: usize = 0
    var pi: u64 = 0
    var k: usize = 0
    while k < b.length {
        const c1 = walk(a, &i, &pi, false)
        if c1 == 0 || c1 != lower(@intCast(u64, b[k])) { return false }
        k += 1
    }
    return walk(a, &i, &pi, false) == 0
}

// FcStrHashIgnoreCase and FcStrHashIgnoreBlanksAndCase (32-bit).
pub fn hashIgnoreCase(s: usize) -> u64 {
    var h: u64 = 0
    var i: usize = 0
    var pi: u64 = 0
    while true {
        const c = walk(s, &i, &pi, false)
        if c == 0 { break }
        h = (((h << 3) & 0xffffffff) ^ (h >> 3)) ^ c
    }
    return h
}

pub fn hashIgnoreBlanksAndCase(s: usize) -> u64 {
    var h: u64 = 0
    var i: usize = 0
    var pi: u64 = 0
    while true {
        const c = walk(s, &i, &pi, true)
        if c == 0 { break }
        h = (((h << 3) & 0xffffffff) ^ (h >> 3)) ^ c
    }
    return h
}

// FcStringHash: the hash of a pattern's strings.
pub fn hash(s: usize) -> u64 {
    var h: u64 = 0
    if s == 0 { return 0 }
    var i: usize = 0
    while mem.get8(s + i) != 0 {
        h = ((((h << 1) & 0xffffffff) | (h >> 31)) ^ mem.get8(s + i)) & 0xffffffff
        i += 1
    }
    return h
}

// Whether `s1` starts with `s2` (blanks skipped when `blanks`).
fn isAt(s1: usize, s2: usize, blanks: bool) -> bool {
    var i: usize = 0
    var j: usize = 0
    var pi: u64 = 0
    var pj: u64 = 0
    while true {
        const c1 = walk(s1, &i, &pi, blanks)
        const c2 = walk(s2, &j, &pj, blanks)
        if c1 == 0 || c1 != c2 { return c1 == c2 || c2 == 0 }
    }
    return false
}

// FcStrContainsIgnoreBlanksAndCase: whether `s1` has `s2` in it.
pub fn containsIgnoreBlanksAndCase(s1: usize, s2: usize) -> bool {
    var at = s1
    while mem.get8(at) != 0 {
        if isAt(at, s2, true) { return true }
        at += 1
    }
    return false
}

pub fn containsIgnoreCase(s1: usize, s2: usize) -> bool {
    var at = s1
    while mem.get8(at) != 0 {
        if isAt(at, s2, false) { return true }
        at += 1
    }
    return false
}

fn isPunct(c: u64) -> bool {
    if c < 48 { return true }
    if c <= 57 { return false }
    if c < 65 { return true }
    if c <= 90 { return false }
    if c < 97 { return true }
    if c <= 122 { return false }
    if c <= 126 { return true }
    return false
}

// FcStrContainsWord: `s2` in `s1` at a word's start and end.
pub fn containsWord(s1: usize, s2: usize) -> bool {
    var wordStart = true
    var length1 = mem.cLength(s1)
    const length2 = mem.cLength(s2)
    var at = s1
    while length1 >= length2 {
        if wordStart && isAt(at, s2, false) && (length1 == length2 || isPunct(mem.get8(at + length2))) { return true }
        wordStart = isPunct(mem.get8(at))
        at += 1
        length1 -= 1
    }
    return false
}

fn isDelim(c: u64, delims: []const u8) -> bool {
    for d in delims {
        if @intCast(u64, d) == c { return true }
    }
    return false
}

// FcStrMatchIgnoreCaseAndDelims: how many bytes of `s1` match `s2`,
// ignoring case and the bytes of `delims`.
pub fn matchIgnoreCaseAndDelims(s1: usize, s2: usize, delims: []const u8) -> i64 {
    if s1 == s2 { return 0 }
    var i: usize = 0
    var j: usize = 0
    var pi: u64 = 0
    var pj: u64 = 0
    // (An empty `delims` skips nothing, as a delimiter list of none.)
    while true {
        const c1 = walkFolded(s1, &i, &pi, false, delims)
        const c2 = walkFolded(s2, &j, &pj, false, delims)
        if c1 == 0 || c1 != c2 { break }
    }
    return @intCast(i64, i) - 1
}

// FcStrGlobMatch: `*` any bytes, `?` one byte.
pub fn globMatch(glob: usize, string: usize) -> bool {
    var g = glob
    var s = string
    while true {
        const c = mem.get8(g)
        if c == 0 { break }
        g += 1
        if c == 42 {
            if mem.get8(g) == 0 { return true }
            var star = false
            var k: usize = 0
            while mem.get8(g + k) != 0 {
                if mem.get8(g + k) == 42 { star = true }
                k += 1
            }
            if !star {
                const l1 = mem.cLength(s)
                const l2 = mem.cLength(g)
                if l1 < l2 { return false }
                s += l1 - l2
            }
            while mem.get8(s) != 0 {
                if globMatch(g, s) { return true }
                s += 1
            }
            return false
        } else if c == 63 {
            if mem.get8(s) == 0 { return false }
            s += 1
        } else {
            if mem.get8(s) != c { return false }
            s += 1
        }
    }
    return mem.get8(s) == 0
}

// FcStrStrIgnoreCase: where `s2` is in `s1` ignoring case, 0 when not.
pub fn strIgnoreCase(s1: usize, s2: usize) -> usize {
    if s1 == 0 || s2 == 0 { return 0 }
    if s1 == s2 { return s1 }
    var i: usize = 0
    var pi: u64 = 0
    var j: usize = 0
    var pj: u64 = 0
    const c2 = walk(s2, &j, &pj, false)
    while true {
        const cur = s1 + i
        const c1 = walk(s1, &i, &pi, false)
        if c1 == 0 { break }
        if c1 == c2 {
            var it = i
            var pit = pi
            var jt = j
            var pjt = pj
            while true {
                const c1t = walk(s1, &it, &pit, false)
                const c2t = walk(s2, &jt, &pjt, false)
                if c2t == 0 { return cur }
                if c2t != c1t { break }
            }
        }
    }
    return 0
}

// FcStrStr: where `s2` is in `s1`, 0 when not.
pub fn str(s1: usize, s2: usize) -> usize {
    if s1 == 0 || s2 == 0 { return 0 }
    if s1 == s2 { return s1 }
    if mem.get8(s2) == 0 { return 0 }
    var at = s1
    while mem.get8(at) != 0 {
        var k: usize = 0
        while true {
            const c2 = mem.get8(s2 + k)
            if c2 == 0 { return at }
            if mem.get8(at + k) != c2 { break }
            k += 1
        }
        at += 1
    }
    return 0
}

// A copy of `s` with its case folded (FcStrDowncase).
pub fn downcase(s: usize) -> usize {
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    var i: usize = 0
    var pi: u64 = 0
    while true {
        const c = walk(s, &i, &pi, false)
        if c == 0 { break }
        if !mem.appendByte(&b, c) {
            mem.freeBuffer(&b)
            return 0
        }
    }
    _ = mem.appendText(&b, "")
    return mem.takeBuffer(&b)
}

// ---------------------------------------------------------------------------
// UTF-8 and UTF-16.

// FcUtf8ToUcs4: the code point at `src` (at most `length` bytes) into
// `out`, and the bytes it took (-1 when it is not UTF-8).
pub fn utf8ToUcs4(src: usize, out: *u64, length: i64) -> i64 {
    if length <= 0 { return -1 }
    const s = mem.get8(src)
    var result: u64 = 0
    var extra: i64 = 0
    if (s & 0x80) == 0 {
        result = s
        extra = 0
    } else if (s & 0x40) == 0 {
        return -1
    } else if (s & 0x20) == 0 {
        result = s & 0x1f
        extra = 1
    } else if (s & 0x10) == 0 {
        result = s & 0x0f
        extra = 2
    } else if (s & 0x08) == 0 {
        result = s & 0x07
        extra = 3
    } else if (s & 0x04) == 0 {
        result = s & 0x03
        extra = 4
    } else if (s & 0x02) == 0 {
        result = s & 0x01
        extra = 5
    } else {
        return -1
    }
    if extra > length - 1 { return -1 }
    var i: i64 = 1
    while i <= extra {
        const c = mem.get8(src + @intCast(usize, i))
        if (c & 0xc0) != 0x80 { return -1 }
        result = (result << 6) | (c & 0x3f)
        i += 1
    }
    out.* = result
    return extra + 1
}

// FcUcs4ToUtf8: the bytes of `ucs4` at `dest` (room for six), their count.
pub fn ucs4ToUtf8(ucs4: u64, dest: usize) -> i64 {
    var bits: i64 = 0
    var d = dest
    if ucs4 < 0x80 {
        mem.put8(d, ucs4)
        return 1
    } else if ucs4 < 0x800 {
        mem.put8(d, ((ucs4 >> 6) & 0x1f) | 0xc0)
        bits = 0
    } else if ucs4 < 0x10000 {
        mem.put8(d, ((ucs4 >> 12) & 0x0f) | 0xe0)
        bits = 6
    } else if ucs4 < 0x200000 {
        mem.put8(d, ((ucs4 >> 18) & 0x07) | 0xf0)
        bits = 12
    } else if ucs4 < 0x4000000 {
        mem.put8(d, ((ucs4 >> 24) & 0x03) | 0xf8)
        bits = 18
    } else {
        mem.put8(d, ((ucs4 >> 30) & 0x01) | 0xfc)
        bits = 24
    }
    d += 1
    while bits >= 0 {
        mem.put8(d, ((ucs4 >> @intCast(u64, bits)) & 0x3f) | 0x80)
        d += 1
        bits -= 6
    }
    return @intCast(i64, d - dest)
}

pub fn appendUtf8(b: *mem.Buffer, ucs4: u64) -> bool {
    if ucs4 < 0x80 { return mem.appendByte(b, ucs4) }
    var bits: u64 = 0
    var lead: u64 = 0
    if ucs4 < 0x800 {
        lead = ((ucs4 >> 6) & 0x1f) | 0xc0
        bits = 0
    } else if ucs4 < 0x10000 {
        lead = ((ucs4 >> 12) & 0x0f) | 0xe0
        bits = 6
    } else {
        lead = ((ucs4 >> 18) & 0x07) | 0xf0
        bits = 12
    }
    if !mem.appendByte(b, lead) { return false }
    while true {
        if !mem.appendByte(b, ((ucs4 >> bits) & 0x3f) | 0x80) { return false }
        if bits == 0 { break }
        bits -= 6
    }
    return true
}

// FcUtf8Len: the characters of `length` bytes of UTF-8 and the width
// (1, 2 or 4 bytes) that holds the largest; false when it is not UTF-8.
pub fn utf8Len(src: usize, length: i64, nchar: *i64, wchar: *i64) -> bool {
    var n: i64 = 0
    var max: u64 = 0
    var at = src
    var left = length
    while left > 0 {
        var c: u64 = 0
        const k = utf8ToUcs4(at, &c, left)
        if k <= 0 { return false }
        if c > max { max = c }
        at += @intCast(usize, k)
        left -= k
        n += 1
    }
    nchar.* = n
    wchar.* = if max >= 0x10000 { 4 } else if max > 0xff { 2 } else { 1 }
    return true
}

// FcUtf16ToUcs4: a character of UTF-16 (`big` endian or not) at `src`.
pub fn utf16ToUcs4(src: usize, big: bool, out: *u64, length: i64) -> i64 {
    if length < 2 { return 0 }
    const a = unit(src, big)
    if (a & 0xfc00) != 0xd800 {
        out.* = a
        return 2
    }
    if length < 4 { return 0 }
    const b = unit(src + 2, big)
    if (b & 0xfc00) != 0xdc00 { return 0 }
    out.* = (((a & 0x3ff) << 10) | (b & 0x3ff)) + 0x10000
    return 4
}

fn unit(at: usize, big: bool) -> u64 {
    if big { return (mem.get8(at) << 8) | mem.get8(at + 1) }
    return mem.get8(at) | (mem.get8(at + 1) << 8)
}

// FcUtf16Len.
pub fn utf16Len(src: usize, big: bool, length: i64, nchar: *i64, wchar: *i64) -> bool {
    var n: i64 = 0
    var max: u64 = 0
    var at = src
    var left = length
    while left > 0 {
        var c: u64 = 0
        const k = utf16ToUcs4(at, big, &c, left)
        if k <= 0 { return false }
        if c > max { max = c }
        at += @intCast(usize, k)
        left -= k
        n += 1
    }
    nchar.* = n
    wchar.* = if max >= 0x10000 { 4 } else if max > 0xff { 2 } else { 1 }
    return true
}
