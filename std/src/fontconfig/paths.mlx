// std.fontconfig.paths: file names and the file system as Fontconfig uses
// them: names joined (FcStrBuildFilename) and made canonical (`~`, `.`,
// `..` and doubled slashes taken out: FcStrCopyFilename), the XDG
// directories, the configuration files' search path (FONTCONFIG_FILE,
// FONTCONFIG_PATH, /etc/fonts), symbolic links followed one step
// (FcConfigRealFilename), whole files read, directories listed and sorted.
const mem = @import("./mem.mlx")
const strings = @import("./strings.mlx")
const strset = @import("./strset.mlx")
const env = @import("./env.mlx")
const fs = @import("../../bootstrap/fs.mlx")
const linux = @import("../../bootstrap/os/linux.mlx")

// Where the configuration is when nothing says otherwise.
pub const CONFIG_DIR: []const u8 = "/etc/fonts"
pub const CONFIG_FILE: []const u8 = "fonts.conf"

// `a` and `b` joined by a slash (a new C string).
pub fn buildFilename(a: usize, b: usize) -> usize {
    var buffer: mem.Buffer = undefined
    mem.initBuffer(&buffer)
    _ = mem.appendC(&buffer, a)
    _ = mem.appendByte(&buffer, 47)
    _ = mem.appendC(&buffer, b)
    return mem.takeBuffer(&buffer)
}

pub fn buildFilenameText(a: usize, b: []const u8) -> usize {
    var buffer: mem.Buffer = undefined
    mem.initBuffer(&buffer)
    _ = mem.appendC(&buffer, a)
    _ = mem.appendByte(&buffer, 47)
    _ = mem.appendText(&buffer, b)
    return mem.takeBuffer(&buffer)
}

// FcStrCanonAbsoluteFilename: an absolute name without `//`, `/.`, `/..`
// and a final slash.
pub fn canonAbsolute(s: usize) -> usize {
    const n = mem.cLength(s)
    const file = mem.alloc(n + 1)
    if file == 0 { return 0 }
    var f: usize = 0
    var slash: i64 = -1
    var i: usize = 0
    while true {
        const c = mem.get8(s + i)
        if c == 47 || c == 0 {
            if slash >= 0 {
                const d = @intCast(i64, i) - slash
                const at = @intCast(usize, slash)
                if d == 1 {
                    f -= 1
                } else if d == 2 && mem.get8(s + at + 1) == 46 {
                    f -= 2
                } else if d == 3 && mem.get8(s + at + 1) == 46 && mem.get8(s + at + 2) == 46 {
                    f -= 3
                    while f > 0 {
                        f -= 1
                        if mem.get8(file + f) == 47 { break }
                    }
                }
            }
            slash = @intCast(i64, i)
        }
        mem.put8(file + f, c)
        f += 1
        i += 1
        if c == 0 { break }
    }
    return file
}

// FcStrCanonFilename: relative names taken from the working directory.
pub fn canon(s: usize) -> usize {
    if mem.get8(s) == 47 { return canonAbsolute(s) }
    const cwd = mem.alloc(4097)
    if cwd == 0 { return 0 }
    const n = linux.syscall2(linux.SYS_getcwd, cwd, 4096)
    if n <= 0 {
        mem.free(cwd)
        return 0
    }
    const full = buildFilename(cwd, s)
    mem.free(cwd)
    const result = canonAbsolute(full)
    mem.free(full)
    return result
}

// FcStrCopyFilename: `~` as the home directory, then canonical; 0 for a
// `~` name without a home.
pub fn copyFilename(s: usize) -> usize {
    if mem.get8(s) == 126 {
        const home = env.get("HOME")
        if home == 0 { return 0 }
        var buffer: mem.Buffer = undefined
        mem.initBuffer(&buffer)
        _ = mem.appendC(&buffer, home)
        _ = mem.appendC(&buffer, s + 1)
        const full = mem.takeBuffer(&buffer)
        const result = canon(full)
        mem.free(full)
        return result
    }
    return canon(s)
}

// The directory of a name (FcStrDirname: "." for none).
pub fn dirname(file: usize) -> usize {
    const n = mem.cLength(file)
    var slash = n
    while slash > 0 && mem.get8(file + slash - 1) != 47 { slash -= 1 }
    if slash == 0 { return mem.dupText(".") }
    if slash == 1 { return mem.dupText("/") }
    return mem.dup(file, slash - 1)
}

// The XDG directories (new C strings, 0 without a home).
fn xdgHome(variable: []const u8, fallback: []const u8, emptyIsUnset: bool) -> usize {
    const value = env.get(variable)
    if value != 0 && (!emptyIsUnset || mem.get8(value) != 0) { return mem.dupC(value) }
    const home = env.get("HOME")
    var buffer: mem.Buffer = undefined
    mem.initBuffer(&buffer)
    if home != 0 { _ = mem.appendC(&buffer, home) }
    _ = mem.appendText(&buffer, fallback)
    return mem.takeBuffer(&buffer)
}

pub fn xdgDataHome() -> usize { return xdgHome("XDG_DATA_HOME", "/.local/share", false) }
pub fn xdgConfigHome() -> usize { return xdgHome("XDG_CONFIG_HOME", "/.config", false) }
pub fn xdgCacheHome() -> usize { return xdgHome("XDG_CACHE_HOME", "/.cache", true) }

// XDG_DATA_DIRS's directories (their final slashes taken off), or
// /usr/local/share and /usr/share.
pub fn xdgDataDirs() -> usize {
    const set = strset.create()
    const value = env.get("XDG_DATA_DIRS")
    if value == 0 {
        _ = strset.addText(set, "/usr/local/share")
        _ = strset.addText(set, "/usr/share")
        return set
    }
    var at = value
    while true {
        var n: usize = 0
        while mem.get8(at + n) != 0 && mem.get8(at + n) != 58 { n += 1 }
        var length = n
        if length > 0 && mem.get8(at + length - 1) == 47 {
            length -= 1
            while length > 1 && mem.get8(at + length - 1) == 47 { length -= 1 }
        }
        const s = mem.dup(at, length)
        _ = strset.add(set, s)
        mem.free(s)
        if mem.get8(at + n) == 0 { break }
        at += n + 1
    }
    return set
}

fn readable(path: usize) -> bool { return linux.syscall2(linux.SYS_access, path, 4) == 0 }

// FcConfigFileExists: `dir` and `file` joined when the result is readable.
fn fileExists(dir: usize, file: usize) -> usize {
    var buffer: mem.Buffer = undefined
    mem.initBuffer(&buffer)
    if dir != 0 { _ = mem.appendC(&buffer, dir) }
    if (buffer.length == 0 || mem.get8(buffer.address + buffer.length - 1) != 47) && mem.get8(file) != 47 { _ = mem.appendByte(&buffer, 47) }
    _ = mem.appendC(&buffer, file)
    const path = mem.takeBuffer(&buffer)
    if readable(path) { return path }
    mem.free(path)
    return 0
}

// FcConfigGetFilename: the configuration file `name` (0 or "": FONTCONFIG_FILE
// or fonts.conf) found: absolute as it is, `~` under the home, else in
// FONTCONFIG_PATH's directories and /etc/fonts. A new C string, 0 when it
// is not there.
pub fn configFilename(name: usize) -> usize {
    var url = name
    var own: usize = 0
    if url == 0 || mem.get8(url) == 0 {
        url = env.get("FONTCONFIG_FILE")
        if url == 0 {
            own = mem.dupText(CONFIG_FILE)
            url = own
        }
    }
    var result: usize = 0
    if mem.get8(url) == 47 {
        result = fileExists(0, url)
    } else if mem.get8(url) == 126 {
        const home = env.get("HOME")
        if home != 0 { result = fileExists(home, url + 1) }
    } else {
        const search = env.get("FONTCONFIG_PATH")
        if search != 0 {
            var at = search
            while result == 0 {
                var n: usize = 0
                while mem.get8(at + n) != 0 && mem.get8(at + n) != 58 { n += 1 }
                const dir = mem.dup(at, n)
                result = fileExists(dir, url)
                mem.free(dir)
                if mem.get8(at + n) == 0 { break }
                at += n + 1
            }
        }
        if result == 0 {
            const dir = mem.dupText(CONFIG_DIR)
            result = fileExists(dir, url)
            mem.free(dir)
        }
    }
    mem.free(own)
    return result
}

// FcConfigRealFilename's link: `file` with a symbolic link to it followed
// one step (a relative target from the link's directory, canonical).
pub fn realFilename(file: usize) -> usize {
    const buffer = mem.alloc(4097)
    if buffer == 0 { return mem.dupC(file) }
    const n = linux.syscall3(linux.SYS_readlink, file, buffer, 4096)
    if n <= 0 {
        mem.free(buffer)
        return mem.dupC(file)
    }
    mem.put8(buffer + @bitCast(usize, n), 0)
    if mem.get8(buffer) == 47 {
        const result = mem.dupC(buffer)
        mem.free(buffer)
        return result
    }
    const dir = dirname(file)
    const joined = buildFilename(dir, buffer)
    mem.free(dir)
    mem.free(buffer)
    const result = canon(joined)
    mem.free(joined)
    return result
}

// A file's status (following links) in a block of the module's (a local
// record whose address the system call takes would be the export's
// arena's), 0 when there is none.
fn statOf(path: usize) -> usize {
    const block = mem.alloc(@sizeOf(fs.Stat))
    if block == 0 { return 0 }
    if fs.status(mem.bytes(path), unsafe { @ptrFromInt(*fs.Stat, block) }) != 0 {
        mem.free(block)
        return 0
    }
    return block
}

fn statRecord(block: usize) -> *fs.Stat { unsafe { return @ptrFromInt(*fs.Stat, block) } }

pub fn isDirectory(path: usize) -> bool {
    const st = statOf(path)
    if st == 0 { return false }
    const result = (statRecord(st).*.mode & 61440) == 16384
    mem.free(st)
    return result
}

pub fn isRegular(path: usize) -> bool {
    const st = statOf(path)
    if st == 0 { return false }
    const result = (statRecord(st).*.mode & 61440) == 32768
    mem.free(st)
    return result
}

// A file's modification time (seconds and nanoseconds as one number;
// -1 when it cannot be read).
pub fn modified(path: usize) -> i64 {
    const st = statOf(path)
    if st == 0 { return -1 }
    const r = statRecord(st)
    const result = @intCast(i64, r.*.modifiedSeconds) *% 1000000000 +% @intCast(i64, r.*.modifiedNanoseconds)
    mem.free(st)
    return result
}

// A whole file (a block of the module's with a 0 after the bytes; its
// length is sizeOf(block) - 1), 0 when it cannot be read.
pub fn readFile(path: usize) -> usize {
    const st = statOf(path)
    if st == 0 { return 0 }
    const size = @intCast(usize, statRecord(st).*.size)
    mem.free(st)
    const block = mem.alloc(size + 1)
    if block == 0 { return 0 }
    const n = fs.readFileResult(mem.bytes(path), mem.bytes(block), size)
    if n < 0 || @bitCast(usize, n) != size {
        mem.free(block)
        return 0
    }
    return block
}

// The names in a directory (not "." and ".."), in the order the system
// gives them; 0 when it cannot be read.
pub fn listDirectory(path: usize) -> usize {
    const dir = fs.open(mem.bytes(path), fs.READ_ONLY | fs.DIRECTORY, 0)
    if !fs.isValid(dir) { return 0 }
    const set = strset.create()
    const buffer = mem.alloc(16384)
    while true {
        const n = fs.readDirectory(dir, mem.bytes(buffer), 16384)
        if n <= 0 { break }
        var at: usize = 0
        while at < @bitCast(usize, n) {
            const record = buffer + at
            const length = mem.get16(record + 16)
            const name = record + 19
            const isDot = mem.get8(name) == 46 && (mem.get8(name + 1) == 0 || (mem.get8(name + 1) == 46 && mem.get8(name + 2) == 0))
            if !isDot { _ = strset.insert(set, mem.dupC(name), strset.size(set)) }
            at += @intCast(usize, length)
        }
    }
    mem.free(buffer)
    _ = fs.close(dir)
    return set
}

// A strset's strings sorted by their bytes (strcmp).
pub fn sortStrings(set: usize) -> void {
    const n = strset.size(set)
    const strs = mem.getWord(set + 24)
    var i: usize = 1
    while i < n {
        const s = mem.getWord(strs + i * 8)
        var j = i
        while j > 0 && strings.cmp(mem.getWord(strs + (j - 1) * 8), s) > 0 {
            mem.putWord(strs + j * 8, mem.getWord(strs + (j - 1) * 8))
            j -= 1
        }
        mem.putWord(strs + j * 8, s)
        i += 1
    }
}
