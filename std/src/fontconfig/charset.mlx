// std.fontconfig.charset: sets of Unicode characters (FcCharSet), as
// Fontconfig keeps them: pages of 256 characters (a page number, the
// character's bits above the low 8, and a leaf of 256 bits), sorted by
// their numbers. A leaf once made stays, emptied or not, as in Fontconfig
// (it counts in `pages` and in equality, not in the characters).
//
// A charset is a record reached by its address:
//     0  references (-1: a constant one, never changed or freed)
//     8  the number of pages
//    16  the room for pages
//    24  the page numbers (32-bit, sorted)
//    32  the leaves (eight 32-bit words each)
const mem = @import("./mem.mlx")

pub const DONE: u64 = 0xffffffff
pub const MAP_SIZE: usize = 8

fn pages(cs: usize) -> usize { return mem.getWord(cs + 8) }
fn numberAt(cs: usize, i: usize) -> u64 { return mem.get32(mem.getWord(cs + 24) + i * 4) }
pub fn leafAt(cs: usize, i: usize) -> usize { return mem.getWord(cs + 32) + i * 32 }

pub fn create() -> usize {
    const cs = mem.alloc(40)
    if cs == 0 { return 0 }
    mem.put64(cs, 1)
    return cs
}

// A new reference to `cs` (FcCharSetCopy: charsets are shared, not copied).
pub fn reference(cs: usize) -> usize {
    if cs == 0 { return 0 }
    if @bitCast(i64, mem.get64(cs)) >= 0 { _ = @atomicRmw(u64, unsafe { @ptrFromInt(*u64, cs) }, add, 1, monotonic) }
    return cs
}

pub fn destroy(cs: usize) -> void {
    if cs == 0 { return }
    if @bitCast(i64, mem.get64(cs)) < 0 { return }
    if @atomicRmw(u64, unsafe { @ptrFromInt(*u64, cs) }, sub, 1, acq_rel) != 1 { return }
    mem.free(mem.getWord(cs + 24))
    mem.free(mem.getWord(cs + 32))
    mem.free(cs)
}

// A copy of `cs` of its own (its pages and leaves copied).
pub fn duplicate(cs: usize) -> usize {
    const copy = create()
    if copy == 0 || cs == 0 { return copy }
    const n = pages(cs)
    if n > 0 {
        const numbers = mem.alloc(n * 4)
        const leaves = mem.alloc(n * 32)
        if numbers == 0 || leaves == 0 {
            mem.free(numbers)
            mem.free(leaves)
            destroy(copy)
            return 0
        }
        mem.copy(numbers, mem.getWord(cs + 24), n * 4)
        mem.copy(leaves, mem.getWord(cs + 32), n * 32)
        mem.putWord(copy + 8, n)
        mem.putWord(copy + 16, n)
        mem.putWord(copy + 24, numbers)
        mem.putWord(copy + 32, leaves)
    }
    return copy
}

pub fn isConstant(cs: usize) -> bool { return @bitCast(i64, mem.get64(cs)) < 0 }

// The position of the page of `ucs4`, or -(the position it would have) - 1.
fn findPosition(cs: usize, ucs4: u64) -> i64 {
    const page = (ucs4 >> 8) & 0xffff
    var low: i64 = 0
    var high: i64 = @intCast(i64, pages(cs)) - 1
    while low <= high {
        const mid = (low + high) >> 1
        const n = numberAt(cs, @intCast(usize, mid))
        if n == page { return mid }
        if n < page { low = mid + 1 } else { high = mid - 1 }
    }
    return 0 - low - 1
}

// The leaf of the page of `ucs4`, 0 when the set has none.
pub fn findLeaf(cs: usize, ucs4: u64) -> usize {
    const at = findPosition(cs, ucs4)
    if at < 0 { return 0 }
    return leafAt(cs, @intCast(usize, at))
}

// A page inserted at `position`, its leaf zeroed; its leaf.
fn insertPage(cs: usize, position: usize, page: u64) -> usize {
    const n = pages(cs)
    if n == mem.getWord(cs + 16) {
        const room = if n < 8 { 8 } else { n * 2 }
        const numbers = mem.grow(mem.getWord(cs + 24), room * 4)
        if numbers == 0 { return 0 }
        mem.putWord(cs + 24, numbers)
        const leaves = mem.grow(mem.getWord(cs + 32), room * 32)
        if leaves == 0 { return 0 }
        mem.putWord(cs + 32, leaves)
        mem.putWord(cs + 16, room)
    }
    const numbers = mem.getWord(cs + 24)
    const leaves = mem.getWord(cs + 32)
    if position < n {
        mem.copy(numbers + (position + 1) * 4, numbers + position * 4, (n - position) * 4)
        mem.copy(leaves + (position + 1) * 32, leaves + position * 32, (n - position) * 32)
    }
    mem.put32(numbers + position * 4, page)
    mem.zero(leaves + position * 32, 32)
    mem.putWord(cs + 8, n + 1)
    return leaves + position * 32
}

fn findLeafCreate(cs: usize, ucs4: u64) -> usize {
    const at = findPosition(cs, ucs4)
    if at >= 0 { return leafAt(cs, @intCast(usize, at)) }
    return insertPage(cs, @intCast(usize, 0 - at - 1), (ucs4 >> 8) & 0xffff)
}

pub fn addChar(cs: usize, ucs4: u64) -> bool {
    if cs == 0 || isConstant(cs) { return false }
    const leaf = findLeafCreate(cs, ucs4)
    if leaf == 0 { return false }
    const word = leaf + ((ucs4 & 0xff) >> 5) * 4
    mem.put32(word, mem.get32(word) | ((@intCast(u64, 1) << (ucs4 & 31)) & 0xffffffff))
    return true
}

// The characters `first` to `last` added.
pub fn addRange(cs: usize, first: u64, last: u64) -> bool {
    var c = first
    while c <= last {
        if !addChar(cs, c) { return false }
        c += 1
    }
    return true
}

pub fn delChar(cs: usize, ucs4: u64) -> bool {
    if cs == 0 || isConstant(cs) { return false }
    const leaf = findLeaf(cs, ucs4)
    if leaf == 0 { return true }
    const word = leaf + ((ucs4 & 0xff) >> 5) * 4
    mem.put32(word, mem.get32(word) & (0xffffffff ^ ((@intCast(u64, 1) << (ucs4 & 31)) & 0xffffffff)))
    return true
}

pub fn hasChar(cs: usize, ucs4: u64) -> bool {
    if cs == 0 { return false }
    const leaf = findLeaf(cs, ucs4)
    if leaf == 0 { return false }
    return ((mem.get32(leaf + ((ucs4 & 0xff) >> 5) * 4) >> (ucs4 & 31)) & 1) != 0
}

pub fn popCount(word: u64) -> u64 {
    var c = word & 0xffffffff
    c = c - ((c >> 1) & 0x55555555)
    c = (c & 0x33333333) + ((c >> 2) & 0x33333333)
    c = (c + (c >> 4)) & 0x0f0f0f0f
    return ((c * 0x01010101) & 0xffffffff) >> 24
}

pub fn count(cs: usize) -> u64 {
    if cs == 0 { return 0 }
    var total: u64 = 0
    var i: usize = 0
    while i < pages(cs) {
        const leaf = leafAt(cs, i)
        var w: usize = 0
        while w < 8 {
            total += popCount(mem.get32(leaf + w * 4))
            w += 1
        }
        i += 1
    }
    return total
}

pub fn pageCount(cs: usize) -> u64 { return if cs == 0 { 0 } else { @intCast(u64, pages(cs)) } }

// Whether the two sets have the same pages with the same bits.
pub fn equal(a: usize, b: usize) -> bool {
    if a == 0 || b == 0 { return a == b }
    if pages(a) != pages(b) { return false }
    var i: usize = 0
    while i < pages(a) {
        if numberAt(a, i) != numberAt(b, i) { return false }
        var w: usize = 0
        while w < 8 {
            if mem.get32(leafAt(a, i) + w * 4) != mem.get32(leafAt(b, i) + w * 4) { return false }
            w += 1
        }
        i += 1
    }
    return true
}

// The characters of `a` not in `b` (FcCharSetSubtractCount).
pub fn subtractCount(a: usize, b: usize) -> u64 {
    if a == 0 || b == 0 { return 0 }
    var total: u64 = 0
    var i: usize = 0
    var j: usize = 0
    const na = pages(a)
    const nb = pages(b)
    while i < na {
        const an = numberAt(a, i)
        while j < nb && numberAt(b, j) < an { j += 1 }
        const leaf = leafAt(a, i)
        if j < nb && numberAt(b, j) == an {
            const other = leafAt(b, j)
            var w: usize = 0
            while w < 8 {
                total += popCount(mem.get32(leaf + w * 4) & (0xffffffff ^ mem.get32(other + w * 4)))
                w += 1
            }
        } else {
            var w: usize = 0
            while w < 8 {
                total += popCount(mem.get32(leaf + w * 4))
                w += 1
            }
        }
        i += 1
    }
    return total
}

pub fn intersectCount(a: usize, b: usize) -> u64 {
    if a == 0 || b == 0 { return 0 }
    var total: u64 = 0
    var i: usize = 0
    var j: usize = 0
    while i < pages(a) && j < pages(b) {
        const an = numberAt(a, i)
        const bn = numberAt(b, j)
        if an < bn {
            i += 1
        } else if bn < an {
            j += 1
        } else {
            var w: usize = 0
            while w < 8 {
                total += popCount(mem.get32(leafAt(a, i) + w * 4) & mem.get32(leafAt(b, j) + w * 4))
                w += 1
            }
            i += 1
            j += 1
        }
    }
    return total
}

// Whether every character of `a` is in `b`.
pub fn isSubset(a: usize, b: usize) -> bool {
    if a == 0 { return true }
    if b == 0 { return count(a) == 0 }
    return subtractCount(a, b) == 0
}

// The kinds of FcCharSetOperate: what a page of both makes, and whether a
// page of one set alone is kept.
const OP_INTERSECT: u8 = 0
const OP_UNION: u8 = 1
const OP_SUBTRACT: u8 = 2

fn addLeaf(result: usize, page: u64, leaf: usize) -> bool {
    const at = findPosition(result, page << 8)
    var target: usize = 0
    if at >= 0 {
        target = leafAt(result, @intCast(usize, at))
    } else {
        target = insertPage(result, @intCast(usize, 0 - at - 1), page)
    }
    if target == 0 { return false }
    mem.copy(target, leaf, 32)
    return true
}

fn operate(a: usize, b: usize, op: u8) -> usize {
    const result = create()
    if result == 0 { return 0 }
    var i: usize = 0
    var j: usize = 0
    const na = if a == 0 { 0 } else { pages(a) }
    const nb = if b == 0 { 0 } else { pages(b) }
    // (A leaf of the heap: a local array whose address is taken would be
    // the export's arena's until it returns.)
    const scratch = mem.alloc(32)
    if scratch == 0 { return fail(result) }
    while i < na || j < nb {
        const an = if i < na { numberAt(a, i) } else { 0x10000 }
        const bn = if j < nb { numberAt(b, j) } else { 0x10000 }
        if an < bn {
            if op != OP_INTERSECT {
                if !addLeaf(result, an, leafAt(a, i)) { return fail(result) }
            }
            i += 1
        } else if bn < an {
            if op == OP_UNION {
                if !addLeaf(result, bn, leafAt(b, j)) { return fail(result) }
            }
            j += 1
        } else {
            var nonzero = false
            var w: usize = 0
            while w < 8 {
                const x = mem.get32(leafAt(a, i) + w * 4)
                const y = mem.get32(leafAt(b, j) + w * 4)
                var v: u64 = 0
                if op == OP_INTERSECT { v = x & y } else if op == OP_UNION { v = x | y } else { v = x & (0xffffffff ^ y) }
                mem.put32(scratch + w * 4, v)
                if v != 0 { nonzero = true }
                w += 1
            }
            if nonzero {
                if !addLeaf(result, an, scratch) {
                    mem.free(scratch)
                    return fail(result)
                }
            }
            i += 1
            j += 1
        }
    }
    mem.free(scratch)
    return result
}

fn fail(result: usize) -> usize {
    destroy(result)
    return 0
}

pub fn intersect(a: usize, b: usize) -> usize { return operate(a, b, OP_INTERSECT) }
pub fn unite(a: usize, b: usize) -> usize { return operate(a, b, OP_UNION) }
pub fn subtract(a: usize, b: usize) -> usize { return operate(a, b, OP_SUBTRACT) }

// The characters of `b` added to `a` (FcCharSetMerge); `changed` says
// whether `a` gained any.
pub fn merge(a: usize, b: usize, changed: *bool) -> bool {
    if a == 0 || b == 0 { return false }
    if isConstant(a) {
        changed.* = false
        return false
    }
    changed.* = !isSubset(b, a)
    if !changed.* { return true }
    var j: usize = 0
    while j < pages(b) {
        const bn = numberAt(b, j)
        const at = findPosition(a, bn << 8)
        if at >= 0 {
            const al = leafAt(a, @intCast(usize, at))
            const bl = leafAt(b, j)
            var w: usize = 0
            while w < 8 {
                mem.put32(al + w * 4, mem.get32(al + w * 4) | mem.get32(bl + w * 4))
                w += 1
            }
        } else {
            if !addLeaf(a, bn, leafAt(b, j)) { return false }
        }
        j += 1
    }
    return true
}

// The page at or after the page of `ucs4`: its position, -1 when none.
fn pageFrom(cs: usize, ucs4: u64) -> i64 {
    const at = findPosition(cs, ucs4)
    const position = if at >= 0 { at } else { 0 - at - 1 }
    if position >= @intCast(i64, pages(cs)) { return -1 }
    return position
}

// FcCharSetNextPage: the page at or after `next.*` (its first character),
// its bits into `map` (eight words), `next.*` the first character of the
// page after; DONE when there is none.
pub fn nextPage(cs: usize, map: usize, next: *u64) -> u64 {
    if cs == 0 { return DONE }
    const at = pageFrom(cs, next.*)
    if at < 0 { return DONE }
    const i = @intCast(usize, at)
    const page = numberAt(cs, i) << 8
    mem.copy(map, leafAt(cs, i), 32)
    next.* = if i + 1 < pages(cs) { numberAt(cs, i + 1) << 8 } else { DONE }
    return page
}

pub fn firstPage(cs: usize, map: usize, next: *u64) -> u64 {
    next.* = 0
    return nextPage(cs, map, next)
}

// FcCharSetCoverage: the bits of the page at or after `page` into
// `result`, and the next page's first character (0 when none).
pub fn coverage(cs: usize, page: u64, result: usize) -> u64 {
    const at = if cs == 0 { -1 } else { pageFrom(cs, page) }
    if at < 0 {
        mem.zero(result, 32)
        return 0
    }
    const i = @intCast(usize, at)
    mem.copy(result, leafAt(cs, i), 32)
    return if i + 1 < pages(cs) { numberAt(cs, i + 1) << 8 } else { DONE }
}

// The set's characters as ranges of hexadecimal numbers ("20-7e a0"),
// appended to `b` (the cache's form of a charset).
pub fn appendRanges(b: *mem.Buffer, cs: usize) -> bool {
    var first = true
    var start: u64 = 0
    var last: u64 = 0
    var open = false
    var i: usize = 0
    while i < pages(cs) {
        const base = numberAt(cs, i) << 8
        const leaf = leafAt(cs, i)
        var k: u64 = 0
        while k < 256 {
            const on = ((mem.get32(leaf + @intCast(usize, k >> 5) * 4) >> (k & 31)) & 1) != 0
            if on {
                const c = base + k
                if open && c == last + 1 {
                    last = c
                } else {
                    if open {
                        if !writeRange(b, start, last, first) { return false }
                        first = false
                    }
                    start = c
                    last = c
                    open = true
                }
            }
            k += 1
        }
        i += 1
    }
    if open { return writeRange(b, start, last, first) }
    return true
}

fn writeRange(b: *mem.Buffer, start: u64, last: u64, first: bool) -> bool {
    if !first { if !mem.appendByte(b, 32) { return false } }
    if !mem.appendHex(b, start) { return false }
    if last > start {
        if !mem.appendByte(b, 45) { return false }
        if !mem.appendHex(b, last) { return false }
    }
    return true
}

// A charset of ranges written by appendRanges (or a language's): `text`
// up to its end or a newline; the position after in `end`.
pub fn fromRanges(text: []const u8, at: usize, end: *usize) -> usize {
    const cs = create()
    if cs == 0 { return 0 }
    var i = at
    while i < text.length && text[i] != 10 {
        while i < text.length && text[i] == 32 { i += 1 }
        if i >= text.length || text[i] == 10 { break }
        var first: u64 = 0
        while i < text.length && mem.hexDigit(@intCast(u64, text[i])) >= 0 {
            first = first * 16 + @intCast(u64, mem.hexDigit(@intCast(u64, text[i])))
            i += 1
        }
        var last = first
        if i < text.length && text[i] == 45 {
            i += 1
            last = 0
            while i < text.length && mem.hexDigit(@intCast(u64, text[i])) >= 0 {
                last = last * 16 + @intCast(u64, mem.hexDigit(@intCast(u64, text[i])))
                i += 1
            }
        }
        if !addRange(cs, first, last) {
            destroy(cs)
            return 0
        }
        // (Anything else in the way is passed over.)
        if i < text.length && text[i] != 32 && text[i] != 10 { i += 1 }
    }
    end.* = i
    return cs
}
