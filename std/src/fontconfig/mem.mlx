// std.fontconfig.mem: the memory every part of std.fontconfig takes from,
// bytes by address, growing buffers of text, and a lock. Patterns, value
// lists, charsets and the configuration are records reached by their
// addresses (usize), as Fontconfig's C reaches them by pointers; the C
// API (compiler/capi/fontconfig) hands those addresses to C as FcPattern*
// and the others. The blocks come from one Allocator the program gives
// once (`use`; the page allocator until then), which must be safe to call
// from several threads (the C API gives the C library's malloc). Each
// block carries its length in the 16 bytes before it, so that it is freed
// by its address alone.
//
// Arithmetic is done in 64-bit words and values are narrowed only where
// memory holds them narrower: a shifted or complemented narrow integer is
// masked before it is compared or stored.
const allocator_module = @import("../../bootstrap/allocator.mlx")
const page_allocator = @import("../../bootstrap/page_allocator.mlx")
const mem = @import("../../bootstrap/mem.mlx")
const linux = @import("../../bootstrap/os/linux.mlx")

pub const Allocator = allocator_module.Allocator

// (A plain variable and a flag: an optional struct variable would keep
// where the struct it was given lives, not a copy of it.)
var heap: Allocator = undefined
var heapReady: bool = false
var liveBlocks: usize = 0

// The allocator std.fontconfig takes its memory from, from now on.
pub fn use(allocator: Allocator) -> void {
    heap.context = allocator.context
    heap.allocFn = allocator.allocFn
    heap.resizeFn = allocator.resizeFn
    heap.remapFn = allocator.remapFn
    heap.freeFn = allocator.freeFn
    heapReady = true
}

pub fn ready() -> bool { return heapReady }

// How many blocks are taken and not yet given back (the tests' leak check).
pub fn blocks() -> usize { return liveBlocks }

fn ensure() -> void {
    if !heapReady { use(page_allocator.init()) }
}

// The allocator itself (for the engines std.fontconfig drives: std.truetype's).
pub fn allocator() -> Allocator {
    ensure()
    return heap
}

// `size` bytes, zeroed (0 when there is no memory).
pub fn alloc(size: usize) -> usize {
    const address = allocRaw(size)
    if address != 0 { zero(address, size) }
    return address
}

fn allocRaw(size: usize) -> usize {
    ensure()
    const total = size + 16
    const got = heap.alloc(total, 16)
    if got == null { return 0 }
    const base = @intFromPtr(got.?)
    put64(base, size)
    put64(base + 8, 0)
    _ = @atomicRmw(usize, &liveBlocks, add, 1, monotonic)
    return base + 16
}

pub fn free(address: usize) -> void {
    if address == 0 { return }
    const base = address - 16
    const size = get64(base)
    _ = @atomicRmw(usize, &liveBlocks, sub, 1, monotonic)
    heap.free(bytes(base), size + 16, 16)
}

// The length a block was taken with.
pub fn sizeOf(address: usize) -> usize {
    if address == 0 { return 0 }
    return get64(address - 16)
}

// The block at `address` grown (or shrunk) to `size` bytes, its contents
// kept as far as they go and the rest zeroed; 0 when there is no memory
// (the old block is then still there).
pub fn grow(address: usize, size: usize) -> usize {
    if address == 0 { return alloc(size) }
    const old = sizeOf(address)
    const fresh = allocRaw(size)
    if fresh == 0 { return 0 }
    copy(fresh, address, if old < size { old } else { size })
    if size > old { zero(fresh + old, size - old) }
    free(address)
    return fresh
}

// A copy of `length` bytes at `address`, with a 0 after them.
pub fn dup(address: usize, length: usize) -> usize {
    const copied = allocRaw(length + 1)
    if copied == 0 { return 0 }
    if length > 0 { copy(copied, address, length) }
    put8(copied + length, 0)
    return copied
}

pub fn dupText(text: []const u8) -> usize { return dup(@intFromPtr(text.pointer), text.length) }

// A copy of the C string at `text`.
pub fn dupC(text: usize) -> usize { return dup(text, cLength(text)) }

// ---------------------------------------------------------------------------
// Bytes by address.

pub inline fn bytes(address: usize) -> [*]u8 { unsafe { return @ptrFromInt([*]u8, address) } }

pub inline fn view(address: usize, length: usize) -> []const u8 {
    unsafe { return @ptrFromInt([*]const u8, address)[0..length] }
}

// The C string at `text` as a slice (its 0 not counted).
pub fn cText(text: usize) -> []const u8 { return view(text, cLength(text)) }

pub inline fn get8(address: usize) -> u64 { unsafe { return @intCast(u64, @ptrFromInt(*u8, address).*) } }
pub inline fn put8(address: usize, value: u64) -> void { unsafe { @ptrFromInt(*u8, address).* = @intCast(u8, value & 255) } }
pub inline fn get16(address: usize) -> u64 { unsafe { return @intCast(u64, @ptrFromInt(*u16, address).*) } }
pub inline fn put16(address: usize, value: u64) -> void { unsafe { @ptrFromInt(*u16, address).* = @intCast(u16, value & 0xffff) } }
pub inline fn get32(address: usize) -> u64 { unsafe { return @intCast(u64, @ptrFromInt(*u32, address).*) } }
pub inline fn put32(address: usize, value: u64) -> void { unsafe { @ptrFromInt(*u32, address).* = @intCast(u32, value & 0xffffffff) } }
pub inline fn get64(address: usize) -> u64 { unsafe { return @ptrFromInt(*u64, address).* } }
pub inline fn put64(address: usize, value: u64) -> void { unsafe { @ptrFromInt(*u64, address).* = value } }
pub inline fn getWord(address: usize) -> usize { unsafe { return @ptrFromInt(*usize, address).* } }
pub inline fn putWord(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*usize, address).* = value } }
pub inline fn getF64(address: usize) -> f64 { unsafe { return @ptrFromInt(*f64, address).* } }
pub inline fn putF64(address: usize, value: f64) -> void { unsafe { @ptrFromInt(*f64, address).* = value } }

// A 32-bit signed value (C's int) at `address`.
pub fn getI32(address: usize) -> i64 { return @intCast(i64, @bitCast(i32, @intCast(u32, get32(address)))) }
pub fn putI32(address: usize, value: i64) -> void { put32(address, @bitCast(u64, value) & 0xffffffff) }

// Big-endian fields, as font files have them.
pub fn get16be(address: usize) -> u64 { return (get8(address) << 8) | get8(address + 1) }
pub fn get32be(address: usize) -> u64 { return (get16be(address) << 16) | get16be(address + 2) }

pub fn copy(target: usize, source: usize, count: usize) -> void {
    if count == 0 || target == source { return }
    if target > source && target < source + count {
        mem.copyBackwards(bytes(target), bytes(source), count)
    } else {
        mem.copy(bytes(target), bytes(source), count)
    }
}

pub fn zero(target: usize, count: usize) -> void {
    if count == 0 { return }
    mem.set(bytes(target), 0, count)
}

pub fn cLength(text: usize) -> usize {
    if text == 0 { return 0 }
    var n: usize = 0
    while get8(text + n) != 0 { n += 1 }
    return n
}

pub fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var i: usize = 0
    while i < a.length {
        if a[i] != b[i] { return false }
        i += 1
    }
    return true
}

// Whether the C string at `text` is `expected`.
pub fn cIs(text: usize, expected: []const u8) -> bool {
    if text == 0 { return false }
    var i: usize = 0
    while i < expected.length {
        if get8(text + i) != @intCast(u64, expected[i]) { return false }
        i += 1
    }
    return get8(text + expected.length) == 0
}

// ---------------------------------------------------------------------------
// Buffers: text grown as it is written, with a 0 kept after it (so that
// `address` is a C string).

pub const Buffer = struct {
    address: usize
    length: usize
    capacity: usize
}

pub fn initBuffer(b: *Buffer) -> void {
    b.*.address = 0
    b.*.length = 0
    b.*.capacity = 0
}

pub fn freeBuffer(b: *Buffer) -> void {
    free(b.*.address)
    initBuffer(b)
}

fn reserve(b: *Buffer, more: usize) -> bool {
    if b.*.length + more + 1 <= b.*.capacity { return true }
    var size = if b.*.capacity == 0 { 64 } else { b.*.capacity * 2 }
    while size < b.*.length + more + 1 { size = size * 2 }
    const grown = grow(b.*.address, size)
    if grown == 0 { return false }
    b.*.address = grown
    b.*.capacity = size
    return true
}

pub fn appendByte(b: *Buffer, value: u64) -> bool {
    if !reserve(b, 1) { return false }
    put8(b.*.address + b.*.length, value)
    b.*.length += 1
    put8(b.*.address + b.*.length, 0)
    return true
}

pub fn appendBytes(b: *Buffer, address: usize, length: usize) -> bool {
    if length == 0 { return reserve(b, 0) }
    if !reserve(b, length) { return false }
    copy(b.*.address + b.*.length, address, length)
    b.*.length += length
    put8(b.*.address + b.*.length, 0)
    return true
}

pub fn appendText(b: *Buffer, text: []const u8) -> bool { return appendBytes(b, @intFromPtr(text.pointer), text.length) }
pub fn appendC(b: *Buffer, text: usize) -> bool { return appendBytes(b, text, cLength(text)) }

pub fn bufferText(b: *const Buffer) -> []const u8 {
    if b.*.address == 0 { return "" }
    return view(b.*.address, b.*.length)
}

// The buffer's text as a block of its own (a C string), the buffer empty
// after; 0 when there is no memory.
pub fn takeBuffer(b: *Buffer) -> usize {
    if !reserve(b, 0) { return 0 }
    const text = b.*.address
    initBuffer(b)
    return text
}

pub fn appendUnsigned(b: *Buffer, value: u64) -> bool {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    while count > 0 {
        count -= 1
        if !appendByte(b, @intCast(u64, digits[count])) { return false }
    }
    return true
}

pub fn appendSigned(b: *Buffer, value: i64) -> bool {
    if value < 0 {
        if !appendByte(b, 45) { return false }
        return appendUnsigned(b, @bitCast(u64, 0 -% value))
    }
    return appendUnsigned(b, @intCast(u64, value))
}

pub fn appendHex(b: *Buffer, value: u64) -> bool {
    const hex = "0123456789abcdef"
    var digits: [16]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[count] = hex[@intCast(usize, rest & 15)]
        count += 1
        rest = rest >> 4
        if rest == 0 { break }
    }
    while count > 0 {
        count -= 1
        if !appendByte(b, @intCast(u64, digits[count])) { return false }
    }
    return true
}

// A double as C's printf("%g") writes it: six significant digits, the
// exponent form (`1e+06`, `1.5e-05`) when the exponent is below -4 or not
// below 6, trailing zeros dropped. (The digits are rounded from the double
// scaled by a power of ten, not from its exact decimal value: a value
// halfway between two six-digit numbers may round the other way.)
pub fn appendDouble(b: *Buffer, value: f64) -> bool {
    if value != value { return appendText(b, "nan") }
    var v = value
    if v < 0.0 {
        if !appendByte(b, 45) { return false }
        v = 0.0 - v
    }
    if v == 0.0 { return appendByte(b, 48) }
    if v > 1.0e308 * 10.0 { return appendText(b, "inf") }
    // The exponent: 10^e <= v < 10^(e+1).
    var e: i64 = 0
    var scaled = v
    while scaled >= 10.0 {
        scaled = scaled / 10.0
        e += 1
    }
    while scaled < 1.0 {
        scaled = scaled * 10.0
        e -= 1
    }
    var digits = roundedDigits(v, e)
    if digits >= 1000000 {
        e += 1
        digits = roundedDigits(v, e)
        if digits >= 1000000 { digits = digits / 10 }
    }
    var text: [8]u8 = undefined
    var i: usize = 6
    var rest = digits
    while i > 0 {
        i -= 1
        text[i] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
    }
    var count: usize = 6
    while count > 1 && text[count - 1] == 48 { count -= 1 }
    if e < -4 || e >= 6 {
        if !appendByte(b, @intCast(u64, text[0])) { return false }
        if count > 1 {
            if !appendByte(b, 46) { return false }
            var k: usize = 1
            while k < count {
                if !appendByte(b, @intCast(u64, text[k])) { return false }
                k += 1
            }
        }
        if !appendByte(b, 101) { return false }
        if !appendByte(b, if e < 0 { 45 } else { 43 }) { return false }
        const magnitude = @intCast(u64, if e < 0 { 0 - e } else { e })
        if magnitude < 10 { if !appendByte(b, 48) { return false } }
        return appendUnsigned(b, magnitude)
    }
    if e < 0 {
        if !appendText(b, "0.") { return false }
        var z: i64 = -1
        while z > e {
            if !appendByte(b, 48) { return false }
            z -= 1
        }
        var k: usize = 0
        while k < count {
            if !appendByte(b, @intCast(u64, text[k])) { return false }
            k += 1
        }
        return true
    }
    // (The digits a byte at a time: a slice of the local array would put
    // it in the export's arena.)
    const whole = @intCast(usize, e) + 1
    var k: usize = 0
    while k < whole {
        if !appendByte(b, @intCast(u64, text[k])) { return false }
        k += 1
    }
    if count > whole {
        if !appendByte(b, 46) { return false }
        while k < count {
            if !appendByte(b, @intCast(u64, text[k])) { return false }
            k += 1
        }
    }
    return true
}

// `v` as six digits for the exponent `e` (v / 10^(e-5), rounded half up).
fn roundedDigits(v: f64, e: i64) -> u64 {
    var scaled = v
    var k = e - 5
    while k > 0 {
        scaled = scaled / 10.0
        k -= 1
    }
    while k < 0 {
        scaled = scaled * 10.0
        k += 1
    }
    return @intFromFloat(u64, scaled + 0.5)
}

// ---------------------------------------------------------------------------
// Numbers read from text, as C's strtol and strtod read them: blanks
// first, a sign, the digits (strtol's base 0: `0x` hexadecimal, a leading
// 0 octal); the position after them in `end` (the start when there are
// none).

pub fn isSpace(c: u64) -> bool { return c == 32 || (c >= 9 && c <= 13) }

pub fn parseInteger(text: usize, end: *usize) -> i64 {
    var i: usize = 0
    while isSpace(get8(text + i)) { i += 1 }
    var negative = false
    if get8(text + i) == 45 || get8(text + i) == 43 {
        negative = get8(text + i) == 45
        i += 1
    }
    var base: u64 = 10
    if get8(text + i) == 48 && (get8(text + i + 1) == 120 || get8(text + i + 1) == 88) && hexDigit(get8(text + i + 2)) >= 0 {
        base = 16
        i += 2
    } else if get8(text + i) == 48 {
        base = 8
    }
    const start = i
    var value: u64 = 0
    while true {
        const c = get8(text + i)
        var d: i64 = -1
        if base == 16 { d = hexDigit(c) } else if c >= 48 && c < 48 + base { d = @intCast(i64, c - 48) }
        if d < 0 { break }
        value = value *% base +% @intCast(u64, d)
        i += 1
    }
    if i == start {
        end.* = text
        return 0
    }
    end.* = text + i
    const signed = @bitCast(i64, value)
    return if negative { 0 -% signed } else { signed }
}

pub fn hexDigit(c: u64) -> i64 {
    if c >= 48 && c <= 57 { return @intCast(i64, c - 48) }
    if c >= 97 && c <= 102 { return @intCast(i64, c - 87) }
    if c >= 65 && c <= 70 { return @intCast(i64, c - 55) }
    return -1
}

// A decimal number with a fraction and an exponent (`1.5`, `.2`, `1e3`,
// `-0.25`); `inf` and `nan` are not read.
pub fn parseDouble(text: usize, end: *usize) -> f64 {
    var i: usize = 0
    while isSpace(get8(text + i)) { i += 1 }
    var negative = false
    if get8(text + i) == 45 || get8(text + i) == 43 {
        negative = get8(text + i) == 45
        i += 1
    }
    var mantissa: u64 = 0
    var digits: usize = 0
    var scale: i64 = 0
    var seen = false
    while get8(text + i) >= 48 && get8(text + i) <= 57 {
        if digits < 18 {
            mantissa = mantissa * 10 + (get8(text + i) - 48)
            if mantissa != 0 { digits += 1 }
        } else {
            scale += 1
        }
        seen = true
        i += 1
    }
    if get8(text + i) == 46 {
        i += 1
        while get8(text + i) >= 48 && get8(text + i) <= 57 {
            if digits < 18 {
                mantissa = mantissa * 10 + (get8(text + i) - 48)
                if mantissa != 0 { digits += 1 }
                scale -= 1
            }
            seen = true
            i += 1
        }
    }
    if !seen {
        end.* = text
        return 0.0
    }
    if get8(text + i) == 101 || get8(text + i) == 69 {
        var j = i + 1
        var minus = false
        if get8(text + j) == 45 || get8(text + j) == 43 {
            minus = get8(text + j) == 45
            j += 1
        }
        if get8(text + j) >= 48 && get8(text + j) <= 57 {
            var exponent: i64 = 0
            while get8(text + j) >= 48 && get8(text + j) <= 57 {
                if exponent < 10000 { exponent = exponent * 10 + @intCast(i64, get8(text + j) - 48) }
                j += 1
            }
            scale += if minus { 0 - exponent } else { exponent }
            i = j
        }
    }
    end.* = text + i
    // (Exact for the short decimals of configurations: an integer and a
    // power of ten below 10^22 are exact doubles, and one division of them
    // is rounded once.)
    var value = @floatFromInt(f64, mantissa)
    var power: f64 = 1.0
    var k = if scale < 0 { 0 - scale } else { scale }
    while k > 0 {
        power = power * 10.0
        k -= 1
    }
    if scale < 0 { value = value / power } else { value = value * power }
    return if negative { 0.0 - value } else { value }
}

// ---------------------------------------------------------------------------
// Locks between threads: a futex word (0 free, 1 held, 2 held and waited
// for), and a recursive lock of an owner, a word and a depth (the
// configuration's: a substitution may build the fonts, which takes it
// again).

pub fn lock(word: *u32) -> void {
    const first = @cmpxchgStrong(u32, word, 0, 1, acquire, monotonic)
    if first.0 { return }
    while @atomicRmw(u32, word, xchg, 2, acquire) != 0 {
        _ = linux.syscall6(linux.SYS_futex, @intFromPtr(word), 128, 2, 0, 0, 0)
    }
}

pub fn unlock(word: *u32) -> void {
    if @atomicRmw(u32, word, xchg, 0, release) == 2 {
        _ = linux.syscall6(linux.SYS_futex, @intFromPtr(word), 129, 1, 0, 0, 0)
    }
}

// Seconds since 1970 (time(0); the clock's two words read into a block of
// the module's, not into an export's arena).
pub fn now() -> i64 {
    const block = alloc(16)
    if block == 0 { return 0 }
    _ = linux.syscall2(linux.SYS_clock_gettime, 0, block)
    const seconds = @bitCast(i64, get64(block))
    free(block)
    return seconds
}

fn threadId() -> u32 { return @intCast(u32, @bitCast(usize, linux.syscall0(linux.SYS_gettid)) & 0xffffffff) }

pub const Mutex = struct {
    owner: u32
    word: u32
    depth: u32
}

pub fn enter(m: *Mutex) -> void {
    const me = threadId()
    if @atomicLoad(u32, &m.*.owner, acquire) == me {
        m.*.depth += 1
        return
    }
    lock(&m.*.word)
    @atomicStore(u32, &m.*.owner, me, release)
    m.*.depth = 1
}

pub fn leave(m: *Mutex) -> void {
    if m.*.depth > 1 {
        m.*.depth -= 1
        return
    }
    m.*.depth = 0
    @atomicStore(u32, &m.*.owner, 0, release)
    unlock(&m.*.word)
}
