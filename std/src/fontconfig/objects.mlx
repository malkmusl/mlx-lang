// std.fontconfig.objects: the properties a pattern has (Fontconfig's
// objects: "family", "weight", "charset"...), their numbers and the type
// of their values, and the constants their values may be named by
// ("bold", "italic", "mono"...). The built-in objects are numbered from 1
// in Fontconfig's order (fcobjs.h), which is the order of a pattern's
// elements; an object first named by a program or a configuration
// ("pixelsizefixupfactor") gets the next number from 1079 on, as in
// Fontconfig, and takes values of any type.
const mem = @import("./mem.mlx")
const strings = @import("./strings.mlx")

// FcType.
pub const TYPE_UNKNOWN: i64 = -1
pub const TYPE_VOID: i64 = 0
pub const TYPE_INTEGER: i64 = 1
pub const TYPE_DOUBLE: i64 = 2
pub const TYPE_STRING: i64 = 3
pub const TYPE_BOOL: i64 = 4
pub const TYPE_MATRIX: i64 = 5
pub const TYPE_CHARSET: i64 = 6
pub const TYPE_FTFACE: i64 = 7
pub const TYPE_LANGSET: i64 = 8
pub const TYPE_RANGE: i64 = 9

pub const FAMILY: i64 = 1
pub const FAMILYLANG: i64 = 2
pub const STYLE: i64 = 3
pub const STYLELANG: i64 = 4
pub const FULLNAME: i64 = 5
pub const FULLNAMELANG: i64 = 6
pub const SLANT: i64 = 7
pub const WEIGHT: i64 = 8
pub const WIDTH: i64 = 9
pub const SIZE: i64 = 10
pub const ASPECT: i64 = 11
pub const PIXEL_SIZE: i64 = 12
pub const SPACING: i64 = 13
pub const FOUNDRY: i64 = 14
pub const ANTIALIAS: i64 = 15
pub const HINT_STYLE: i64 = 16
pub const HINTING: i64 = 17
pub const VERTICAL_LAYOUT: i64 = 18
pub const AUTOHINT: i64 = 19
pub const GLOBAL_ADVANCE: i64 = 20
pub const FILE: i64 = 21
pub const INDEX: i64 = 22
pub const RASTERIZER: i64 = 23
pub const OUTLINE: i64 = 24
pub const SCALABLE: i64 = 25
pub const DPI: i64 = 26
pub const RGBA: i64 = 27
pub const SCALE: i64 = 28
pub const MINSPACE: i64 = 29
pub const CHARWIDTH: i64 = 30
pub const CHAR_HEIGHT: i64 = 31
pub const MATRIX: i64 = 32
pub const CHARSET: i64 = 33
pub const LANG: i64 = 34
pub const FONTVERSION: i64 = 35
pub const CAPABILITY: i64 = 36
pub const FONTFORMAT: i64 = 37
pub const EMBOLDEN: i64 = 38
pub const EMBEDDED_BITMAP: i64 = 39
pub const DECORATIVE: i64 = 40
pub const LCD_FILTER: i64 = 41
pub const NAMELANG: i64 = 42
pub const FONT_FEATURES: i64 = 43
pub const PRGNAME: i64 = 44
pub const HASH: i64 = 45
pub const POSTSCRIPT_NAME: i64 = 46
pub const COLOR: i64 = 47
pub const SYMBOL: i64 = 48
pub const FONT_VARIATIONS: i64 = 49
pub const VARIABLE: i64 = 50
pub const FONT_HAS_HINT: i64 = 51
pub const ORDER: i64 = 52
pub const DESKTOP_NAME: i64 = 53
pub const NAMED_INSTANCE: i64 = 54
pub const FONT_WRAPPER: i64 = 55
pub const MAX_BASE: i64 = 55

// The objects' names, in their order, and their types.
const NAMES = "family familylang style stylelang fullname fullnamelang slant weight width size aspect pixelsize spacing foundry antialias hintstyle hinting verticallayout autohint globaladvance file index rasterizer outline scalable dpi rgba scale minspace charwidth charheight matrix charset lang fontversion capability fontformat embolden embeddedbitmap decorative lcdfilter namelang fontfeatures prgname hash postscriptname color symbol fontvariations variable fonthashint order desktop namedinstance fontwrapper"

fn builtinType(id: i64) -> i64 {
    if id == SLANT || id == SPACING || id == HINT_STYLE || id == INDEX || id == RGBA || id == CHARWIDTH || id == CHAR_HEIGHT || id == FONTVERSION || id == LCD_FILTER || id == ORDER { return TYPE_INTEGER }
    if id == WEIGHT || id == WIDTH || id == SIZE { return TYPE_RANGE }
    if id == ASPECT || id == PIXEL_SIZE || id == DPI || id == SCALE { return TYPE_DOUBLE }
    if id == ANTIALIAS || id == HINTING || id == VERTICAL_LAYOUT || id == AUTOHINT || id == GLOBAL_ADVANCE || id == OUTLINE || id == SCALABLE || id == MINSPACE || id == EMBOLDEN || id == EMBEDDED_BITMAP || id == DECORATIVE || id == COLOR || id == SYMBOL || id == VARIABLE || id == FONT_HAS_HINT || id == NAMED_INSTANCE { return TYPE_BOOL }
    if id == MATRIX { return TYPE_MATRIX }
    if id == CHARSET { return TYPE_CHARSET }
    if id == LANG { return TYPE_LANGSET }
    return TYPE_STRING
}

// The names as C strings (made once), and the objects named since:
// records of a name (a C string) and a number.
var builtinNames: usize = 0
var others: usize = 0
var otherCount: usize = 0
var otherRoom: usize = 0
var nextId: i64 = 1079
var guard: u32 = 0

fn load() -> void {
    if builtinNames != 0 { return }
    const table = mem.alloc(@intCast(usize, MAX_BASE + 1) * 8)
    var at: usize = 0
    var id: usize = 1
    const text = NAMES
    while at < text.length && id <= @intCast(usize, MAX_BASE) {
        var stop = at
        while stop < text.length && text[stop] != 32 { stop += 1 }
        mem.putWord(table + id * 8, mem.dupText(text[at..stop]))
        id += 1
        at = stop + 1
    }
    builtinNames = table
}

// The number of a built-in object's name, 0 when it is none.
pub fn builtinId(name: usize) -> i64 {
    mem.lock(&guard)
    load()
    mem.unlock(&guard)
    var id: i64 = 1
    while id <= MAX_BASE {
        if strings.cmp(mem.getWord(builtinNames + @intCast(usize, id) * 8), name) == 0 { return id }
        id += 1
    }
    return 0
}

// The number of the object `name` (FcObjectFromName), one of its own for
// a name not built in.
pub fn fromName(name: usize) -> i64 {
    if name == 0 { return 0 }
    const id = builtinId(name)
    if id != 0 { return id }
    mem.lock(&guard)
    var i: usize = 0
    while i < otherCount {
        if strings.cmp(mem.getWord(others + i * 16), name) == 0 {
            const found = @bitCast(i64, mem.get64(others + i * 16 + 8))
            mem.unlock(&guard)
            return found
        }
        i += 1
    }
    if otherCount == otherRoom {
        const room = if otherRoom == 0 { 16 } else { otherRoom * 2 }
        const grown = mem.grow(others, room * 16)
        if grown == 0 {
            mem.unlock(&guard)
            return 0
        }
        others = grown
        otherRoom = room
    }
    const result = nextId
    nextId += 1
    mem.putWord(others + otherCount * 16, mem.dupC(name))
    mem.put64(others + otherCount * 16 + 8, @bitCast(u64, result))
    otherCount += 1
    mem.unlock(&guard)
    return result
}

// The number the next object named will have (no object has it yet).
pub fn idLimit() -> i64 {
    mem.lock(&guard)
    const result = nextId
    mem.unlock(&guard)
    return result
}

pub fn fromText(name: []const u8) -> i64 {
    const c = mem.dupText(name)
    const id = fromName(c)
    mem.free(c)
    return id
}

// The object's name (a C string of the module's), 0 for no object.
pub fn name(id: i64) -> usize {
    mem.lock(&guard)
    load()
    var result: usize = 0
    if id >= 1 && id <= MAX_BASE {
        result = mem.getWord(builtinNames + @intCast(usize, id) * 8)
    } else {
        var i: usize = 0
        while i < otherCount {
            if @bitCast(i64, mem.get64(others + i * 16 + 8)) == id { result = mem.getWord(others + i * 16) }
            i += 1
        }
    }
    mem.unlock(&guard)
    return result
}

// The type of the object's values (TYPE_UNKNOWN for one not built in).
pub fn typeOf(id: i64) -> i64 {
    if id >= 1 && id <= MAX_BASE { return builtinType(id) }
    return TYPE_UNKNOWN
}

// FcObjectValidType: whether a value of `t` may be the object's.
pub fn validType(id: i64, t: i64) -> bool {
    const want = typeOf(id)
    if want == TYPE_UNKNOWN { return true }
    if want == TYPE_DOUBLE || want == TYPE_INTEGER { return t == TYPE_DOUBLE || t == TYPE_INTEGER }
    if want == TYPE_LANGSET { return t == TYPE_LANGSET || t == TYPE_STRING }
    if want == TYPE_RANGE { return t == TYPE_RANGE || t == TYPE_DOUBLE || t == TYPE_INTEGER }
    return t == want
}

// ---------------------------------------------------------------------------
// Constants: a name, the object it is a value of, and the value.

pub const Constant = struct {
    name: []const u8
    object: []const u8
    value: i64
}

fn constantAt(i: usize) -> Constant {
    return match i {
        0 => Constant.{ .name = "thin", .object = "weight", .value = 0 }
        1 => Constant.{ .name = "extralight", .object = "weight", .value = 40 }
        2 => Constant.{ .name = "ultralight", .object = "weight", .value = 40 }
        3 => Constant.{ .name = "demilight", .object = "weight", .value = 55 }
        4 => Constant.{ .name = "semilight", .object = "weight", .value = 55 }
        5 => Constant.{ .name = "light", .object = "weight", .value = 50 }
        6 => Constant.{ .name = "book", .object = "weight", .value = 75 }
        7 => Constant.{ .name = "regular", .object = "weight", .value = 80 }
        8 => Constant.{ .name = "normal", .object = "weight", .value = 80 }
        9 => Constant.{ .name = "medium", .object = "weight", .value = 100 }
        10 => Constant.{ .name = "demibold", .object = "weight", .value = 180 }
        11 => Constant.{ .name = "semibold", .object = "weight", .value = 180 }
        12 => Constant.{ .name = "bold", .object = "weight", .value = 200 }
        13 => Constant.{ .name = "extrabold", .object = "weight", .value = 205 }
        14 => Constant.{ .name = "ultrabold", .object = "weight", .value = 205 }
        15 => Constant.{ .name = "black", .object = "weight", .value = 210 }
        16 => Constant.{ .name = "heavy", .object = "weight", .value = 210 }
        17 => Constant.{ .name = "extrablack", .object = "weight", .value = 215 }
        18 => Constant.{ .name = "ultrablack", .object = "weight", .value = 215 }
        19 => Constant.{ .name = "roman", .object = "slant", .value = 0 }
        20 => Constant.{ .name = "italic", .object = "slant", .value = 100 }
        21 => Constant.{ .name = "oblique", .object = "slant", .value = 110 }
        22 => Constant.{ .name = "ultracondensed", .object = "width", .value = 50 }
        23 => Constant.{ .name = "extracondensed", .object = "width", .value = 63 }
        24 => Constant.{ .name = "condensed", .object = "width", .value = 75 }
        25 => Constant.{ .name = "semicondensed", .object = "width", .value = 87 }
        26 => Constant.{ .name = "normal", .object = "width", .value = 100 }
        27 => Constant.{ .name = "semiexpanded", .object = "width", .value = 113 }
        28 => Constant.{ .name = "expanded", .object = "width", .value = 125 }
        29 => Constant.{ .name = "extraexpanded", .object = "width", .value = 150 }
        30 => Constant.{ .name = "ultraexpanded", .object = "width", .value = 200 }
        31 => Constant.{ .name = "proportional", .object = "spacing", .value = 0 }
        32 => Constant.{ .name = "dual", .object = "spacing", .value = 90 }
        33 => Constant.{ .name = "mono", .object = "spacing", .value = 100 }
        34 => Constant.{ .name = "charcell", .object = "spacing", .value = 110 }
        35 => Constant.{ .name = "unknown", .object = "rgba", .value = 0 }
        36 => Constant.{ .name = "rgb", .object = "rgba", .value = 1 }
        37 => Constant.{ .name = "bgr", .object = "rgba", .value = 2 }
        38 => Constant.{ .name = "vrgb", .object = "rgba", .value = 3 }
        39 => Constant.{ .name = "vbgr", .object = "rgba", .value = 4 }
        40 => Constant.{ .name = "none", .object = "rgba", .value = 5 }
        41 => Constant.{ .name = "hintnone", .object = "hintstyle", .value = 0 }
        42 => Constant.{ .name = "hintslight", .object = "hintstyle", .value = 1 }
        43 => Constant.{ .name = "hintmedium", .object = "hintstyle", .value = 2 }
        44 => Constant.{ .name = "hintfull", .object = "hintstyle", .value = 3 }
        45 => Constant.{ .name = "antialias", .object = "antialias", .value = 1 }
        46 => Constant.{ .name = "hinting", .object = "hinting", .value = 1 }
        47 => Constant.{ .name = "verticallayout", .object = "verticallayout", .value = 1 }
        48 => Constant.{ .name = "autohint", .object = "autohint", .value = 1 }
        49 => Constant.{ .name = "globaladvance", .object = "globaladvance", .value = 1 }
        50 => Constant.{ .name = "outline", .object = "outline", .value = 1 }
        51 => Constant.{ .name = "scalable", .object = "scalable", .value = 1 }
        52 => Constant.{ .name = "minspace", .object = "minspace", .value = 1 }
        53 => Constant.{ .name = "embolden", .object = "embolden", .value = 1 }
        54 => Constant.{ .name = "embeddedbitmap", .object = "embeddedbitmap", .value = 1 }
        55 => Constant.{ .name = "decorative", .object = "decorative", .value = 1 }
        56 => Constant.{ .name = "lcdnone", .object = "lcdfilter", .value = 0 }
        57 => Constant.{ .name = "lcddefault", .object = "lcdfilter", .value = 1 }
        58 => Constant.{ .name = "lcdlight", .object = "lcdfilter", .value = 2 }
        else => Constant.{ .name = "lcdlegacy", .object = "lcdfilter", .value = 3 }
    }
}

// How many constants there are.
pub const CONSTANTS: usize = 60

// The constants as the lookups read them, made once: records of three
// words, the name and the object (C strings) and the value. (Reading
// them through constantAt, whose struct the match makes in the aggregate
// arena, would take the arena's room a constant at a time: an export of
// the C API has 64 KB of it per call.)
var constantTable: usize = 0
var constantGuard: u32 = 0

fn constantRecords() -> usize {
    if @atomicLoad(usize, &constantTable, acquire) != 0 { return constantTable }
    mem.lock(&constantGuard)
    if constantTable == 0 {
        const table = mem.alloc(CONSTANTS * 24)
        var i: usize = 0
        while i < CONSTANTS {
            const c = constantAt(i)
            mem.putWord(table + i * 24, mem.dupText(c.name))
            mem.putWord(table + i * 24 + 8, mem.dupText(c.object))
            mem.put64(table + i * 24 + 16, @bitCast(u64, c.value))
            i += 1
        }
        @atomicStore(usize, &constantTable, table, release)
    }
    mem.unlock(&constantGuard)
    return constantTable
}

// The name, object and value of the constant `i`.
pub fn constantName(i: usize) -> usize { return mem.getWord(constantRecords() + i * 24) }
pub fn constantObject(i: usize) -> usize { return mem.getWord(constantRecords() + i * 24 + 8) }
pub fn constantValueAt(i: usize) -> i64 { return @bitCast(i64, mem.get64(constantRecords() + i * 24 + 16)) }

// The constant named `s` (ignoring case; FcNameGetConstant), its index, -1
// when there is none.
pub fn constantIndex(s: usize) -> i64 {
    var i: usize = 0
    while i < CONSTANTS {
        if strings.cmpIgnoreCase(s, constantName(i)) == 0 { return @intCast(i64, i) }
        i += 1
    }
    return -1
}

// FcNameGetConstantFor: the constant named `s` of `object`.
pub fn constantIndexFor(s: usize, object: usize) -> i64 {
    var i: usize = 0
    while i < CONSTANTS {
        if strings.cmpIgnoreCase(s, constantName(i)) == 0 && strings.cmpIgnoreCase(object, constantObject(i)) == 0 { return @intCast(i64, i) }
        i += 1
    }
    return -1
}

pub fn constant(i: i64) -> Constant { return constantAt(@intCast(usize, i)) }

// FcNameConstant: the value of the constant `s`.
pub fn constantValue(s: usize, value: *i64) -> bool {
    const i = constantIndex(s)
    if i < 0 { return false }
    value.* = constantValueAt(@intCast(usize, i))
    return true
}

// FcNameConstantWithObjectCheck: the constant `s` of `object`, or of none
// other (a constant of another object is refused).
pub fn constantValueFor(s: usize, object: usize, value: *i64) -> bool {
    var i = constantIndexFor(s, object)
    if i >= 0 {
        value.* = constantValueAt(@intCast(usize, i))
        return true
    }
    i = constantIndex(s)
    if i >= 0 {
        if strings.cmp(constantObject(@intCast(usize, i)), object) != 0 { return false }
        value.* = constantValueAt(@intCast(usize, i))
        return true
    }
    return false
}

// FcNameBool: true for t, y, 1, on; false for f, n, 0, off; FcDontCare (2)
// for d, x, 2, or.
pub fn nameBool(v: usize, result: *i64) -> bool {
    const c0 = strings.lower(mem.get8(v))
    if c0 == 116 || c0 == 121 || c0 == 49 {
        result.* = 1
        return true
    }
    if c0 == 102 || c0 == 110 || c0 == 48 {
        result.* = 0
        return true
    }
    if c0 == 100 || c0 == 120 || c0 == 50 {
        result.* = 2
        return true
    }
    if c0 == 111 {
        const c1 = strings.lower(mem.get8(v + 1))
        if c1 == 110 {
            result.* = 1
            return true
        }
        if c1 == 102 {
            result.* = 0
            return true
        }
        if c1 == 114 {
            result.* = 2
            return true
        }
    }
    return false
}

// ---------------------------------------------------------------------------
// Weights: OpenType's (100 to 1000) and Fontconfig's (0 to 215).

const WEIGHT_MAP_OT = [13]i64{ 0, 100, 200, 300, 350, 380, 400, 500, 600, 700, 800, 900, 1000 }
const WEIGHT_MAP_FC = [13]i64{ 0, 0, 40, 50, 55, 75, 80, 100, 180, 200, 205, 210, 215 }

fn lerp(x: f64, x1: i64, x2: i64, y1: i64, y2: i64) -> f64 {
    const dx = x2 - x1
    const dy = y2 - y1
    return @floatFromInt(f64, y1) + (x - @floatFromInt(f64, x1)) * @floatFromInt(f64, dy) / @floatFromInt(f64, dx)
}

pub fn weightFromOpenType(otWeight: f64) -> f64 {
    if otWeight < 0.0 { return -1.0 }
    var w = otWeight
    if w > 1000.0 { w = 1000.0 }
    var i: usize = 1
    while w > @floatFromInt(f64, WEIGHT_MAP_OT[i]) { i += 1 }
    if w == @floatFromInt(f64, WEIGHT_MAP_OT[i]) { return @floatFromInt(f64, WEIGHT_MAP_FC[i]) }
    return lerp(w, WEIGHT_MAP_OT[i - 1], WEIGHT_MAP_OT[i], WEIGHT_MAP_FC[i - 1], WEIGHT_MAP_FC[i])
}

pub fn weightToOpenType(fcWeight: f64) -> f64 {
    if fcWeight < 0.0 || fcWeight > 215.0 { return -1.0 }
    var i: usize = 1
    while fcWeight > @floatFromInt(f64, WEIGHT_MAP_FC[i]) { i += 1 }
    if fcWeight == @floatFromInt(f64, WEIGHT_MAP_FC[i]) { return @floatFromInt(f64, WEIGHT_MAP_OT[i]) }
    return lerp(fcWeight, WEIGHT_MAP_FC[i - 1], WEIGHT_MAP_FC[i], WEIGHT_MAP_OT[i - 1], WEIGHT_MAP_OT[i])
}
