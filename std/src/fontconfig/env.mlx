// std.fontconfig.env: the environment variables Fontconfig reads (HOME,
// the XDG directories, FC_LANG, LC_ALL, LC_CTYPE, LANG, FONTCONFIG_FILE,
// FONTCONFIG_PATH, XDG_CURRENT_DESKTOP). A program gives its environment
// list (`useList`, main's `envp`), or a library its C library's values
// (`set`, which the C API calls from getenv); until then the process's
// first environment is read from /proc/self/environ.
const mem = @import("./mem.mlx")
const fs = @import("../../bootstrap/fs.mlx")

// Records of two words (a name and its value, C strings of the module's
// own memory); `value` 0 for a variable known to be unset.
const MAX_VARIABLES: usize = 64
var table: usize = 0
var count: usize = 0
var listed: usize = 0
var loaded: bool = false
var guard: u32 = 0

// The environment list `entries` ("NAME=value" C strings, a 0 after
// them) as the program's, from now on.
pub fn useList(entries: [*][*]const u8) -> void {
    mem.lock(&guard)
    listed = @intFromPtr(entries)
    loaded = true
    mem.unlock(&guard)
}

// `name` set to the C string `value` (0: unset), above the list.
pub fn set(name: []const u8, value: usize) -> void {
    mem.lock(&guard)
    if table == 0 { table = mem.alloc(MAX_VARIABLES * 16) }
    var i: usize = 0
    while i < count {
        if mem.same(mem.cText(mem.getWord(table + i * 16)), name) {
            mem.free(mem.getWord(table + i * 16 + 8))
            mem.putWord(table + i * 16 + 8, if value == 0 { 0 } else { mem.dupC(value) })
            mem.unlock(&guard)
            return
        }
        i += 1
    }
    if table != 0 && count < MAX_VARIABLES {
        mem.putWord(table + count * 16, mem.dupText(name))
        mem.putWord(table + count * 16 + 8, if value == 0 { 0 } else { mem.dupC(value) })
        count += 1
    }
    mem.unlock(&guard)
}

// The process's first environment, read once: a block of "NAME=value"
// strings, each ended by a 0, and a list of them.
fn loadProcess() -> void {
    const capacity: usize = 131072
    const data = mem.alloc(capacity + 1)
    if data == 0 { return }
    const path = mem.dupText("/proc/self/environ")
    const length = fs.readFileResult(mem.bytes(path), mem.bytes(data), capacity)
    mem.free(path)
    if length <= 0 {
        mem.free(data)
        return
    }
    const n = @bitCast(usize, length)
    var entries: usize = 0
    var i: usize = 0
    while i < n {
        if mem.get8(data + i) == 0 { entries += 1 }
        i += 1
    }
    const list = mem.alloc((entries + 2) * 8)
    if list == 0 { return }
    var at: usize = 0
    var k: usize = 0
    while at < n && k <= entries {
        mem.putWord(list + k * 8, data + at)
        k += 1
        while at < n && mem.get8(data + at) != 0 { at += 1 }
        at += 1
    }
    mem.putWord(list + k * 8, 0)
    listed = list
}

// The value of `name` (a C string), 0 when it is not set.
pub fn get(name: []const u8) -> usize {
    mem.lock(&guard)
    var i: usize = 0
    while i < count {
        if mem.same(mem.cText(mem.getWord(table + i * 16)), name) {
            const value = mem.getWord(table + i * 16 + 8)
            mem.unlock(&guard)
            return value
        }
        i += 1
    }
    if !loaded {
        loaded = true
        loadProcess()
    }
    var result: usize = 0
    if listed != 0 {
        var k: usize = 0
        while mem.getWord(listed + k * 8) != 0 {
            const entry = mem.getWord(listed + k * 8)
            var j: usize = 0
            var matches = true
            while j < name.length {
                if mem.get8(entry + j) != @intCast(u64, name[j]) {
                    matches = false
                    break
                }
                j += 1
            }
            if matches && mem.get8(entry + name.length) == 61 {
                result = entry + name.length + 1
                break
            }
            k += 1
        }
    }
    mem.unlock(&guard)
    return result
}

// The value of `name` when it is set and not empty, else 0.
pub fn getNonEmpty(name: []const u8) -> usize {
    const value = get(name)
    if value == 0 || mem.get8(value) == 0 { return 0 }
    return value
}
