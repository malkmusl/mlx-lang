// std.fontconfig.confparse: configuration files (fonts.conf, conf.d) read
// into a configuration, as Fontconfig's fcxml.c reads them: font
// directories (<dir>, prefix="xdg", "~"), <include> of files and of
// directories (their [0-9]*.conf files in order of their names, each
// file once), <match> rules of <test>s and <edit>s (target pattern, font
// or scan), <alias> (<prefer>, <accept>, <default>: a test of the family
// and edits prepending, appending, appending last), <selectfont> (fonts
// accepted or rejected by <glob> or <pattern>), the value elements (int,
// double, string, bool, const, name, matrix, range, charset, langset)
// and the operators (or, and, eq... plus, minus, times, divide, not, if,
// floor, ceil, round, trunc). <cachedir>, <description>, <rescan> and the
// rest are read and kept or passed over. Errors make warnings in
// Fontconfig; here the element in error is passed over silently.
//
// As in Fontconfig, an element's children leave values on a stack, each
// marked with the element they belong to (their parent), and the element
// takes them when it ends.
const mem = @import("./mem.mlx")
const strings = @import("./strings.mlx")
const strset = @import("./strset.mlx")
const charset = @import("./charset.mlx")
const lang = @import("./lang.mlx")
const objects = @import("./objects.mlx")
const value = @import("./value.mlx")
const pattern = @import("./pattern.mlx")
const config = @import("./config.mlx")
const env = @import("./env.mlx")
const paths = @import("./paths.mlx")
const xml = @import("../xml.mlx")
const fs = @import("../../bootstrap/fs.mlx")

// Elements.
const E_UNKNOWN: i64 = 0
const E_FONTCONFIG: i64 = 1
const E_DIR: i64 = 2
const E_CACHEDIR: i64 = 3
const E_CACHE: i64 = 4
const E_INCLUDE: i64 = 5
const E_CONFIG: i64 = 6
const E_MATCH: i64 = 7
const E_ALIAS: i64 = 8
const E_DESCRIPTION: i64 = 9
const E_REMAP_DIR: i64 = 10
const E_RESET_DIRS: i64 = 11
const E_RESCAN: i64 = 12
const E_PREFER: i64 = 13
const E_ACCEPT: i64 = 14
const E_DEFAULT: i64 = 15
const E_FAMILY: i64 = 16
const E_SELECTFONT: i64 = 17
const E_ACCEPTFONT: i64 = 18
const E_REJECTFONT: i64 = 19
const E_GLOB: i64 = 20
const E_PATTERN: i64 = 21
const E_PATELT: i64 = 22
const E_TEST: i64 = 23
const E_EDIT: i64 = 24
const E_INT: i64 = 25
const E_DOUBLE: i64 = 26
const E_STRING: i64 = 27
const E_MATRIX: i64 = 28
const E_RANGE: i64 = 29
const E_BOOL: i64 = 30
const E_CHARSET: i64 = 31
const E_LANGSET: i64 = 32
const E_NAME: i64 = 33
const E_CONST: i64 = 34
// (The operators: E_OPERATOR + their FcOp.)
const E_OPERATOR: i64 = 100

const ELEMENT_NAMES = "fontconfig dir cachedir cache include config match alias description remap-dir reset-dirs rescan prefer accept default family selectfont acceptfont rejectfont glob pattern patelt test edit int double string matrix range bool charset langset name const"

fn elementOf(name: []const u8) -> i64 {
    var at: usize = 0
    var id: i64 = 1
    const text = ELEMENT_NAMES
    while at < text.length {
        var stop = at
        while stop < text.length && text[stop] != 32 { stop += 1 }
        if mem.same(text[at..stop], name) { return id }
        id += 1
        at = stop + 1
    }
    if mem.same(name, "or") { return E_OPERATOR + config.OP_OR }
    if mem.same(name, "and") { return E_OPERATOR + config.OP_AND }
    if mem.same(name, "eq") { return E_OPERATOR + config.OP_EQUAL }
    if mem.same(name, "not_eq") { return E_OPERATOR + config.OP_NOT_EQUAL }
    if mem.same(name, "less") { return E_OPERATOR + config.OP_LESS }
    if mem.same(name, "less_eq") { return E_OPERATOR + config.OP_LESS_EQUAL }
    if mem.same(name, "more") { return E_OPERATOR + config.OP_MORE }
    if mem.same(name, "more_eq") { return E_OPERATOR + config.OP_MORE_EQUAL }
    if mem.same(name, "contains") { return E_OPERATOR + config.OP_CONTAINS }
    if mem.same(name, "not_contains") { return E_OPERATOR + config.OP_NOT_CONTAINS }
    if mem.same(name, "plus") { return E_OPERATOR + config.OP_PLUS }
    if mem.same(name, "minus") { return E_OPERATOR + config.OP_MINUS }
    if mem.same(name, "times") { return E_OPERATOR + config.OP_TIMES }
    if mem.same(name, "divide") { return E_OPERATOR + config.OP_DIVIDE }
    if mem.same(name, "not") { return E_OPERATOR + config.OP_NOT }
    if mem.same(name, "if") { return E_OPERATOR + config.OP_QUEST }
    if mem.same(name, "floor") { return E_OPERATOR + config.OP_FLOOR }
    if mem.same(name, "ceil") { return E_OPERATOR + config.OP_CEIL }
    if mem.same(name, "round") { return E_OPERATOR + config.OP_ROUND }
    if mem.same(name, "trunc") { return E_OPERATOR + config.OP_TRUNC }
    return E_UNKNOWN
}

// Values on the stack.
const V_NONE: i64 = 0
const V_STRING: i64 = 1
const V_FAMILY: i64 = 2
const V_PREFER: i64 = 3
const V_ACCEPT: i64 = 4
const V_DEFAULT: i64 = 5
const V_INTEGER: i64 = 6
const V_DOUBLE: i64 = 7
const V_MATRIX: i64 = 8
const V_RANGE: i64 = 9
const V_BOOL: i64 = 10
const V_CHARSET: i64 = 11
const V_LANGSET: i64 = 12
const V_TEST: i64 = 13
const V_EXPR: i64 = 14
const V_EDIT: i64 = 15
const V_PATTERN: i64 = 16
const V_NAME: i64 = 17
const V_CONSTANT: i64 = 18
const V_GLOB: i64 = 19

// The parse: its configuration and file, the elements open (frames) and
// the value stack.
//     frame (40 bytes): its serial, element, attributes (a strset of
//         name and value in turn), text (a Buffer of 24 bytes)
//     value (56 bytes): its tag, the serial of the frame it is for, then
//         five words
const FRAME_SIZE: usize = 48
const VALUE_SIZE: usize = 56
const MAX_FRAMES: usize = 64

pub const Parse = struct {
    cfg: usize
    name: usize
    frames: usize
    depth: usize
    serial: u64
    values: usize
    count: usize
    room: usize
    loading: bool
}

fn frameAt(ps: *Parse, i: usize) -> usize { return ps.*.frames + i * FRAME_SIZE }
fn top(ps: *Parse) -> usize { return frameAt(ps, ps.*.depth - 1) }
fn topSerial(ps: *Parse) -> u64 { return if ps.*.depth == 0 { 0 } else { mem.get64(top(ps)) } }
fn topElement(ps: *Parse) -> i64 { return @bitCast(i64, mem.get64(top(ps) + 8)) }
fn frameText(frame: usize) -> *mem.Buffer { unsafe { return @ptrFromInt(*mem.Buffer, frame + 24) } }

// The attribute `name` of the open element (a C string), 0 when absent.
fn attribute(ps: *Parse, name: []const u8) -> usize {
    const set = mem.getWord(top(ps) + 16)
    var i: usize = 0
    while i + 1 < strset.size(set) {
        if mem.same(mem.cText(strset.at(set, i)), name) { return strset.at(set, i + 1) }
        i += 2
    }
    return 0
}

// The open element's text (a C string, the frame's).
fn text(ps: *Parse) -> usize {
    const b = frameText(top(ps))
    if b.*.address == 0 { _ = mem.appendText(b, "") }
    return b.*.address
}

fn valueAt(ps: *Parse, i: usize) -> usize { return ps.*.values + i * VALUE_SIZE }

// A value pushed for the open element's parent.
fn push(ps: *Parse, tag: i64, w1: u64, w2: u64) -> usize {
    if ps.*.count == ps.*.room {
        const room = if ps.*.room == 0 { 64 } else { ps.*.room * 2 }
        const grown = mem.grow(ps.*.values, room * VALUE_SIZE)
        if grown == 0 { return 0 }
        ps.*.values = grown
        ps.*.room = room
    }
    const v = valueAt(ps, ps.*.count)
    mem.zero(v, VALUE_SIZE)
    mem.put64(v, @bitCast(u64, tag))
    mem.put64(v + 8, if ps.*.depth >= 2 { mem.get64(frameAt(ps, ps.*.depth - 2)) } else { 0 })
    mem.put64(v + 16, w1)
    mem.put64(v + 24, w2)
    ps.*.count += 1
    return v
}

fn word(v: usize, k: usize) -> u64 { return mem.get64(v + 8 + 8 * k) }
fn tagOf(v: usize) -> i64 { return @bitCast(i64, mem.get64(v)) }

// The top value when it is the open element's (a child's), else 0.
fn peek(ps: *Parse) -> usize {
    if ps.*.count == 0 { return 0 }
    const v = valueAt(ps, ps.*.count - 1)
    if mem.get64(v + 8) != topSerial(ps) { return 0 }
    return v
}

// The top value taken off and destroyed (what it still holds freed).
fn popDestroy(ps: *Parse) -> void {
    const v = peek(ps)
    if v == 0 { return }
    const tag = tagOf(v)
    if tag == V_STRING || tag == V_CONSTANT || tag == V_GLOB || tag == V_FAMILY {
        if tag == V_FAMILY { config.destroyExpr(@intCast(usize, word(v, 1))) } else { mem.free(@intCast(usize, word(v, 1))) }
    } else if tag == V_PATTERN {
        pattern.destroy(@intCast(usize, word(v, 1)))
    } else if tag == V_MATRIX {
        var k: usize = 1
        while k <= 4 {
            config.destroyExpr(@intCast(usize, word(v, k)))
            k += 1
        }
    } else if tag == V_RANGE {
        mem.free(@intCast(usize, word(v, 1)))
    } else if tag == V_CHARSET {
        charset.destroy(@intCast(usize, word(v, 1)))
    } else if tag == V_LANGSET {
        lang.destroy(@intCast(usize, word(v, 1)))
    } else if tag == V_TEST || tag == V_EDIT {
        config.destroyItemList(@intCast(usize, word(v, 1)))
    } else if tag == V_EXPR || tag == V_PREFER || tag == V_ACCEPT || tag == V_DEFAULT {
        config.destroyExpr(@intCast(usize, word(v, 1)))
    }
    ps.*.count -= 1
}

// The top value given up by the stack (taken as it is: what it holds is
// the caller's now).
fn popTaken(ps: *Parse) -> void {
    if peek(ps) != 0 { ps.*.count -= 1 }
}

// ---------------------------------------------------------------------------
// Expressions of the values.

// FcPopExpr: the top value as an expression (0 when it is none).
fn popExpr(ps: *Parse) -> usize {
    const v = peek(ps)
    if v == 0 { return 0 }
    const tag = tagOf(v)
    var e: usize = 0
    if tag == V_STRING {
        e = config.expr(config.OP_STRING, word(v, 1), 0)
        popTaken(ps)
        return e
    }
    if tag == V_FAMILY || tag == V_EXPR || tag == V_PREFER || tag == V_ACCEPT || tag == V_DEFAULT {
        e = @intCast(usize, word(v, 1))
        popTaken(ps)
        return e
    }
    if tag == V_NAME {
        e = config.expr(config.OP_FIELD, word(v, 1), word(v, 2))
    } else if tag == V_CONSTANT {
        e = config.expr(config.OP_CONST, word(v, 1), 0)
        popTaken(ps)
        return e
    } else if tag == V_INTEGER {
        e = config.expr(config.OP_INTEGER, word(v, 1), 0)
    } else if tag == V_DOUBLE {
        e = config.expr(config.OP_DOUBLE, word(v, 1), 0)
    } else if tag == V_MATRIX {
        e = config.expr(config.OP_MATRIX, word(v, 1), word(v, 2))
        config.setExprWord(e, 3, word(v, 3))
        config.setExprWord(e, 4, word(v, 4))
        popTaken(ps)
        return e
    } else if tag == V_RANGE {
        e = config.expr(config.OP_RANGE, word(v, 1), 0)
        popTaken(ps)
        return e
    } else if tag == V_BOOL {
        e = config.expr(config.OP_BOOL, word(v, 1), 0)
    } else if tag == V_CHARSET {
        e = config.expr(config.OP_CHARSET, word(v, 1), 0)
        popTaken(ps)
        return e
    } else if tag == V_LANGSET {
        e = config.expr(config.OP_LANGSET, word(v, 1), 0)
        popTaken(ps)
        return e
    }
    popDestroy(ps)
    return e
}

// FcPopBinary: the values (last first) joined by `op` into one expression,
// right to left.
fn popBinary(ps: *Parse, op: i64) -> usize {
    var e: usize = 0
    while true {
        const left = popExpr(ps)
        if left == 0 { break }
        if e != 0 {
            e = config.expr(op, @intCast(u64, left), @intCast(u64, e))
        } else {
            e = left
        }
    }
    return e
}

// ---------------------------------------------------------------------------
// The elements' ends.

fn parseInt(ps: *Parse) -> void {
    const s = text(ps)
    var end: usize = 0
    const v = mem.parseInteger(s, &end)
    if end == s + mem.cLength(s) && end != s { _ = push(ps, V_INTEGER, value.intWord(v), 0) }
}

fn parseDouble(ps: *Parse) -> void {
    const s = text(ps)
    var end: usize = 0
    const d = mem.parseDouble(s, &end)
    if end == s + mem.cLength(s) && end != s { _ = push(ps, V_DOUBLE, @bitCast(u64, d), 0) }
}

fn parseString(ps: *Parse, tag: i64) -> void {
    const s = mem.dupC(text(ps))
    if s != 0 { _ = push(ps, tag, @intCast(u64, s), 0) }
}

fn parseFamily(ps: *Parse) -> void {
    const e = config.expr(config.OP_STRING, @intCast(u64, mem.dupC(text(ps))), 0)
    if e != 0 { _ = push(ps, V_FAMILY, @intCast(u64, e), 0) }
}

fn parseFamilies(ps: *Parse, tag: i64) -> void {
    var e: usize = 0
    while true {
        const v = peek(ps)
        if v == 0 { break }
        if tagOf(v) != V_FAMILY {
            popDestroy(ps)
            continue
        }
        const left = @intCast(usize, word(v, 1))
        popTaken(ps)
        if e != 0 {
            e = config.expr(config.OP_COMMA, @intCast(u64, left), @intCast(u64, e))
        } else {
            e = left
        }
    }
    if e != 0 { _ = push(ps, tag, @intCast(u64, e), 0) }
}

fn kindOf(s: usize, allowDefault: bool, allowScan: bool, result: *i64) -> bool {
    if s == 0 {
        result.* = config.MATCH_DEFAULT
        return true
    }
    if mem.cIs(s, "pattern") {
        result.* = config.MATCH_PATTERN
    } else if mem.cIs(s, "font") {
        result.* = config.MATCH_FONT
    } else if allowScan && mem.cIs(s, "scan") {
        result.* = config.MATCH_SCAN
    } else if allowDefault && mem.cIs(s, "default") {
        result.* = config.MATCH_DEFAULT
    } else {
        return false
    }
    return true
}

fn parseName(ps: *Parse) -> void {
    var kind: i64 = 0
    if !kindOf(attribute(ps, "target"), true, false, &kind) { return }
    const object = objects.fromName(text(ps))
    _ = push(ps, V_NAME, @bitCast(u64, object), @bitCast(u64, kind))
}

fn parseMatrix(ps: *Parse) -> void {
    const yy = popExpr(ps)
    const yx = popExpr(ps)
    const xy = popExpr(ps)
    const xx = popExpr(ps)
    if yy == 0 || yx == 0 || xy == 0 || xx == 0 {
        config.destroyExpr(yy)
        config.destroyExpr(yx)
        config.destroyExpr(xy)
        config.destroyExpr(xx)
        return
    }
    const extra = popExpr(ps)
    if extra != 0 {
        config.destroyExpr(extra)
        config.destroyExpr(yy)
        config.destroyExpr(yx)
        config.destroyExpr(xy)
        config.destroyExpr(xx)
        return
    }
    const v = push(ps, V_MATRIX, @intCast(u64, xx), @intCast(u64, xy))
    if v != 0 {
        mem.put64(v + 32, @intCast(u64, yx))
        mem.put64(v + 40, @intCast(u64, yy))
    }
}

fn parseRange(ps: *Parse) -> void {
    var n0: i64 = 0
    var n1: i64 = 0
    var d0: f64 = 0.0
    var d1: f64 = 0.0
    var count: i64 = 1
    var doubles = false
    while true {
        const v = peek(ps)
        if v == 0 { break }
        if count < 0 { return }
        const tag = tagOf(v)
        if tag == V_INTEGER {
            const i = @intCast(i64, @bitCast(i32, @intCast(u32, word(v, 1) & 0xffffffff)))
            if doubles {
                if count == 0 { d0 = @floatFromInt(f64, i) } else { d1 = @floatFromInt(f64, i) }
            } else {
                if count == 0 { n0 = i } else { n1 = i }
            }
        } else if tag == V_DOUBLE {
            if count == 0 && !doubles { d1 = @floatFromInt(f64, n1) }
            const d = @bitCast(f64, word(v, 1))
            if count == 0 { d0 = d } else { d1 = d }
            doubles = true
        }
        count -= 1
        popDestroy(ps)
    }
    if count >= 0 { return }
    var r: usize = 0
    if doubles {
        if d0 > d1 { return }
        r = value.rangeCreate(d0, d1)
    } else {
        if n0 > n1 { return }
        r = value.rangeCreate(@floatFromInt(f64, n0), @floatFromInt(f64, n1))
    }
    if r != 0 { _ = push(ps, V_RANGE, @intCast(u64, r), 0) }
}

fn parseBool(ps: *Parse) -> void {
    var b: i64 = 0
    if !objects.nameBool(text(ps), &b) { b = 0 }
    _ = push(ps, V_BOOL, value.intWord(b), 0)
}

fn parseCharSet(ps: *Parse) -> void {
    const cs = charset.create()
    var n: usize = 0
    while true {
        const v = peek(ps)
        if v == 0 { break }
        if tagOf(v) == V_INTEGER {
            if charset.addChar(cs, word(v, 1) & 0xffffffff) { n += 1 }
        } else if tagOf(v) == V_RANGE {
            const r = @intCast(usize, word(v, 1))
            const begin = @intFromFloat(u64, value.rangeBegin(r))
            const end = @intFromFloat(u64, value.rangeEnd(r))
            if begin <= end {
                var c = begin
                while c <= end {
                    if charset.addChar(cs, c) { n += 1 }
                    c += 1
                }
            }
        }
        popDestroy(ps)
    }
    if n > 0 {
        _ = push(ps, V_CHARSET, @intCast(u64, cs), 0)
    } else {
        charset.destroy(cs)
    }
}

fn parseLangSet(ps: *Parse) -> void {
    const ls = lang.create()
    var n: usize = 0
    while true {
        const v = peek(ps)
        if v == 0 { break }
        if tagOf(v) == V_STRING {
            if lang.add(ls, @intCast(usize, word(v, 1))) { n += 1 }
        }
        popDestroy(ps)
    }
    if n > 0 {
        _ = push(ps, V_LANGSET, @intCast(u64, ls), 0)
    } else {
        lang.destroy(ls)
    }
}

// An operator of the values: a binary one folds them all, a unary one
// takes one.
fn parseOperator(ps: *Parse, op: i64) -> void {
    var e: usize = 0
    if op == config.OP_NOT || op == config.OP_FLOOR || op == config.OP_CEIL || op == config.OP_ROUND || op == config.OP_TRUNC {
        const operand = popExpr(ps)
        if operand != 0 { e = config.expr(op, @intCast(u64, operand), 0) }
    } else {
        e = popBinary(ps, op)
    }
    if e != 0 { _ = push(ps, V_EXPR, @intCast(u64, e), 0) }
}

fn compareOf(s: usize) -> i64 {
    if mem.cIs(s, "eq") { return config.OP_EQUAL }
    if mem.cIs(s, "not_eq") { return config.OP_NOT_EQUAL }
    if mem.cIs(s, "less") { return config.OP_LESS }
    if mem.cIs(s, "less_eq") { return config.OP_LESS_EQUAL }
    if mem.cIs(s, "more") { return config.OP_MORE }
    if mem.cIs(s, "more_eq") { return config.OP_MORE_EQUAL }
    if mem.cIs(s, "contains") { return config.OP_CONTAINS }
    if mem.cIs(s, "not_contains") { return config.OP_NOT_CONTAINS }
    return config.OP_INVALID
}

fn modeOf(s: usize) -> i64 {
    if mem.cIs(s, "assign") { return config.OP_ASSIGN }
    if mem.cIs(s, "assign_replace") { return config.OP_ASSIGN_REPLACE }
    if mem.cIs(s, "prepend") { return config.OP_PREPEND }
    if mem.cIs(s, "prepend_first") { return config.OP_PREPEND_FIRST }
    if mem.cIs(s, "append") { return config.OP_APPEND }
    if mem.cIs(s, "append_last") { return config.OP_APPEND_LAST }
    if mem.cIs(s, "delete") { return config.OP_DELETE }
    if mem.cIs(s, "delete_all") { return config.OP_DELETE_ALL }
    return config.OP_INVALID
}

fn bindingOf(s: usize, result: *i64) -> bool {
    if s == 0 || mem.cIs(s, "weak") {
        result.* = value.BINDING_WEAK
    } else if mem.cIs(s, "strong") {
        result.* = value.BINDING_STRONG
    } else if mem.cIs(s, "same") {
        result.* = value.BINDING_SAME
    } else {
        return false
    }
    return true
}

fn parseTest(ps: *Parse) -> void {
    var kind: i64 = 0
    if !kindOf(attribute(ps, "target"), true, true, &kind) { return }
    var qual = config.QUAL_ANY
    const q = attribute(ps, "qual")
    if q != 0 {
        if mem.cIs(q, "any") {
            qual = config.QUAL_ANY
        } else if mem.cIs(q, "all") {
            qual = config.QUAL_ALL
        } else if mem.cIs(q, "first") {
            qual = config.QUAL_FIRST
        } else if mem.cIs(q, "not_first") {
            qual = config.QUAL_NOT_FIRST
        } else {
            return
        }
    }
    const name = attribute(ps, "name")
    if name == 0 { return }
    var compare = config.OP_EQUAL
    const c = attribute(ps, "compare")
    if c != 0 {
        compare = compareOf(c)
        if compare == config.OP_INVALID { return }
    }
    const blanks = attribute(ps, "ignore-blanks")
    if blanks != 0 {
        var f: i64 = 0
        if objects.nameBool(blanks, &f) && f == 1 { compare = compare | config.FLAG_IGNORE_BLANKS }
    }
    const e = popBinary(ps, config.OP_COMMA)
    if e == 0 { return }
    const t = config.newTest(kind, qual, objects.fromName(name), compare, e)
    const it = config.item(config.ITEM_TEST, t)
    _ = push(ps, V_TEST, @intCast(u64, it), 0)
}

fn parseEdit(ps: *Parse) -> void {
    const name = attribute(ps, "name")
    if name == 0 { return }
    var mode = config.OP_ASSIGN
    const m = attribute(ps, "mode")
    if m != 0 {
        mode = modeOf(m)
        if mode == config.OP_INVALID { return }
    }
    var binding: i64 = 0
    if !bindingOf(attribute(ps, "binding"), &binding) { return }
    var e = popBinary(ps, config.OP_COMMA)
    if (mode == config.OP_DELETE || mode == config.OP_DELETE_ALL) && e != 0 {
        config.destroyExpr(e)
        e = 0
    }
    const ed = config.edit(objects.fromName(name), mode, e, binding)
    const it = config.item(config.ITEM_EDIT, ed)
    _ = push(ps, V_EDIT, @intCast(u64, it), 0)
}

// <match>: its tests and edits (the values, last first) as a rule.
fn parseMatch(ps: *Parse) -> void {
    var kind = config.MATCH_PATTERN
    const k = attribute(ps, "target")
    if k != 0 {
        if mem.cIs(k, "pattern") {
            kind = config.MATCH_PATTERN
        } else if mem.cIs(k, "font") {
            kind = config.MATCH_FONT
        } else if mem.cIs(k, "scan") {
            kind = config.MATCH_SCAN
        } else {
            return
        }
    }
    var first: usize = 0
    while true {
        const v = peek(ps)
        if v == 0 { break }
        const tag = tagOf(v)
        if tag == V_TEST || tag == V_EDIT {
            const it = @intCast(usize, word(v, 1))
            popTaken(ps)
            config.setItemNext(it, first)
            first = it
        } else {
            popDestroy(ps)
        }
    }
    if first != 0 && ps.*.loading { _ = config.addRule(ps.*.cfg, kind, first) } else { config.destroyItemList(first) }
}

// <alias>: a test of the families (ignoring blanks) and edits prepending
// the preferred, appending the accepted and appending last the defaults.
fn parseAlias(ps: *Parse) -> void {
    var binding: i64 = 0
    if !bindingOf(attribute(ps, "binding"), &binding) { return }
    var family: usize = 0
    var prefer: usize = 0
    var accept: usize = 0
    var def: usize = 0
    var tests: usize = 0
    while true {
        const v = peek(ps)
        if v == 0 { break }
        const tag = tagOf(v)
        const e = @intCast(usize, word(v, 1))
        if tag == V_FAMILY {
            popTaken(ps)
            if family != 0 { family = config.expr(config.OP_COMMA, @intCast(u64, e), @intCast(u64, family)) } else { family = e }
        } else if tag == V_PREFER {
            popTaken(ps)
            config.destroyExpr(prefer)
            prefer = e
        } else if tag == V_ACCEPT {
            popTaken(ps)
            config.destroyExpr(accept)
            accept = e
        } else if tag == V_DEFAULT {
            popTaken(ps)
            config.destroyExpr(def)
            def = e
        } else if tag == V_TEST {
            popTaken(ps)
            config.setItemNext(e, tests)
            tests = e
        } else {
            popDestroy(ps)
        }
    }
    if family == 0 || (prefer == 0 && accept == 0 && def == 0) {
        config.destroyExpr(family)
        config.destroyItemList(tests)
        return
    }
    const t = config.newTest(config.MATCH_PATTERN, config.QUAL_ANY, objects.FAMILY, config.OP_EQUAL | config.FLAG_IGNORE_BLANKS, family)
    var last = config.item(config.ITEM_TEST, t)
    var first = last
    if tests != 0 {
        first = tests
        var at = tests
        while config.itemNext(at) != 0 { at = config.itemNext(at) }
        config.setItemNext(at, last)
    }
    if prefer != 0 {
        const it = config.item(config.ITEM_EDIT, config.edit(objects.FAMILY, config.OP_PREPEND, prefer, binding))
        config.setItemNext(last, it)
        last = it
    }
    if accept != 0 {
        const it = config.item(config.ITEM_EDIT, config.edit(objects.FAMILY, config.OP_APPEND, accept, binding))
        config.setItemNext(last, it)
        last = it
    }
    if def != 0 {
        const it = config.item(config.ITEM_EDIT, config.edit(objects.FAMILY, config.OP_APPEND_LAST, def, binding))
        config.setItemNext(last, it)
        last = it
    }
    if ps.*.loading { _ = config.addRule(ps.*.cfg, config.MATCH_PATTERN, first) } else { config.destroyItemList(first) }
}

// <dir> (and <remap-dir>'s directory): the directories of a prefix
// ("xdg": the XDG data home's and each XDG data directory's; "relative":
// the configuration file's directory) added to the font directories.
fn parseDir(ps: *Parse) -> void {
    const data = text(ps)
    if mem.get8(data) == 0 { return }
    const prefix = attribute(ps, "prefix")
    const dirs = strset.create()
    if prefix != 0 && mem.cIs(prefix, "xdg") {
        const home = paths.xdgDataHome()
        if home == 0 {
            strset.destroy(dirs)
            return
        }
        _ = strset.insert(dirs, paths.buildFilename(home, data), 0)
        mem.free(home)
        const others = paths.xdgDataDirs()
        var i: usize = 0
        while i < strset.size(others) {
            _ = strset.insert(dirs, paths.buildFilename(strset.at(others, i), data), strset.size(dirs))
            i += 1
        }
        strset.destroy(others)
    } else if prefix != 0 && mem.cIs(prefix, "relative") {
        const parent = paths.dirname(ps.*.name)
        _ = strset.insert(dirs, paths.buildFilename(parent, data), 0)
        mem.free(parent)
    } else {
        _ = strset.insert(dirs, mem.dupC(data), 0)
    }
    if ps.*.loading {
        var i: usize = 0
        while i < strset.size(dirs) {
            const d = strset.at(dirs, i)
            if mem.get8(d) != 0 && (mem.get8(d) != 126 || env.get("HOME") != 0) {
                const canonical = paths.copyFilename(d)
                if canonical != 0 {
                    // (A directory named again moves to the end, as
                    // FcStrSetAddFilenamePairWithSalt deletes it first.)
                    _ = strset.del(config.fontDirs(ps.*.cfg), canonical)
                    _ = strset.add(config.fontDirs(ps.*.cfg), canonical)
                    mem.free(canonical)
                }
            }
            i += 1
        }
    }
    strset.destroy(dirs)
}

fn parseCacheDir(ps: *Parse) -> void {
    const data = text(ps)
    if mem.get8(data) == 0 || !ps.*.loading { return }
    const prefix = attribute(ps, "prefix")
    var dir: usize = 0
    if prefix != 0 && mem.cIs(prefix, "xdg") {
        const home = paths.xdgCacheHome()
        if home == 0 { return }
        dir = paths.buildFilename(home, data)
        mem.free(home)
    } else {
        dir = paths.copyFilename(data)
    }
    if dir != 0 {
        _ = strset.add(config.cacheDirs(ps.*.cfg), dir)
        mem.free(dir)
    }
}

fn parseInclude(ps: *Parse) -> void {
    const s = text(ps)
    var ignoreMissing = false
    const im = attribute(ps, "ignore_missing")
    if im != 0 {
        var b: i64 = 0
        if objects.nameBool(im, &b) && b == 1 { ignoreMissing = true }
    }
    const prefix = attribute(ps, "prefix")
    var name: usize = 0
    if prefix != 0 && mem.cIs(prefix, "xdg") {
        const home = paths.xdgConfigHome()
        if home == 0 { return }
        name = paths.buildFilename(home, s)
        mem.free(home)
    } else {
        name = mem.dupC(s)
    }
    _ = parseFile(ps.*.cfg, name, !ignoreMissing, ps.*.loading)
    mem.free(name)
}

fn parseRescan(ps: *Parse) -> void {
    var i = ps.*.count
    while i > 0 {
        const v = valueAt(ps, i - 1)
        if mem.get64(v + 8) != topSerial(ps) { break }
        if tagOf(v) == V_INTEGER && ps.*.loading { mem.put64(ps.*.cfg + config.CONFIG_RESCAN, word(v, 1) & 0xffffffff) }
        i -= 1
    }
}

// <acceptfont>, <rejectfont>: globs of file names and patterns.
fn parseAcceptReject(ps: *Parse, accept: bool) -> void {
    const c = ps.*.cfg
    while true {
        const v = peek(ps)
        if v == 0 { break }
        const tag = tagOf(v)
        if tag == V_GLOB && ps.*.loading {
            const glob = paths.copyFilename(@intCast(usize, word(v, 1)))
            if glob != 0 {
                _ = strset.add(mem.getWord(c + (if accept { config.CONFIG_ACCEPT_GLOBS } else { config.CONFIG_REJECT_GLOBS })), glob)
                mem.free(glob)
            }
        } else if tag == V_PATTERN && ps.*.loading {
            const p = @intCast(usize, word(v, 1))
            popTaken(ps)
            _ = pattern.fontSetAdd(mem.getWord(c + (if accept { config.CONFIG_ACCEPT_PATTERNS } else { config.CONFIG_REJECT_PATTERNS })), p)
            continue
        }
        popDestroy(ps)
    }
}

// <patelt name="...">: its values (last first) in a pattern of one element.
fn parsePatelt(ps: *Parse) -> void {
    const name = attribute(ps, "name")
    if name == 0 { return }
    const p = pattern.create()
    const object = objects.fromName(name)
    while true {
        const v = peek(ps)
        if v == 0 { break }
        const tag = tagOf(v)
        var t = objects.TYPE_VOID
        var w: u64 = 0
        if tag == V_STRING {
            t = objects.TYPE_STRING
            w = word(v, 1)
        } else if tag == V_CONSTANT {
            var c: i64 = 0
            if objects.constantValue(@intCast(usize, word(v, 1)), &c) {
                t = objects.TYPE_INTEGER
                w = value.intWord(c)
            }
        } else if tag == V_INTEGER {
            t = objects.TYPE_INTEGER
            w = word(v, 1)
        } else if tag == V_DOUBLE {
            t = objects.TYPE_DOUBLE
            w = word(v, 1)
        } else if tag == V_BOOL {
            t = objects.TYPE_BOOL
            w = word(v, 1)
        } else if tag == V_CHARSET {
            t = objects.TYPE_CHARSET
            w = word(v, 1)
        } else if tag == V_LANGSET {
            t = objects.TYPE_LANGSET
            w = word(v, 1)
        } else if tag == V_RANGE {
            t = objects.TYPE_RANGE
            w = word(v, 1)
        }
        if t == objects.TYPE_VOID {
            popDestroy(ps)
            break
        }
        // (The value copied into the pattern, Fontconfig adding each at the
        // end as it takes them from the top.)
        _ = pattern.add(p, object, t, w, true)
        popDestroy(ps)
    }
    _ = push(ps, V_PATTERN, @intCast(u64, p), 0)
}

fn parsePattern(ps: *Parse) -> void {
    const p = pattern.create()
    while true {
        const v = peek(ps)
        if v == 0 { break }
        if tagOf(v) == V_PATTERN { _ = pattern.append(p, @intCast(usize, word(v, 1))) }
        popDestroy(ps)
    }
    _ = push(ps, V_PATTERN, @intCast(u64, p), 0)
}

fn endElement(ps: *Parse) -> void {
    const element = topElement(ps)
    if element == E_DIR || element == E_REMAP_DIR {
        parseDir(ps)
    } else if element == E_CACHEDIR {
        parseCacheDir(ps)
    } else if element == E_INCLUDE {
        parseInclude(ps)
    } else if element == E_MATCH {
        parseMatch(ps)
    } else if element == E_ALIAS {
        parseAlias(ps)
    } else if element == E_RESET_DIRS {
        if ps.*.loading {
            strset.destroy(config.fontDirs(ps.*.cfg))
            mem.putWord(ps.*.cfg + config.CONFIG_FONT_DIRS, strset.create())
        }
    } else if element == E_RESCAN {
        parseRescan(ps)
    } else if element == E_PREFER {
        parseFamilies(ps, V_PREFER)
    } else if element == E_ACCEPT {
        parseFamilies(ps, V_ACCEPT)
    } else if element == E_DEFAULT {
        parseFamilies(ps, V_DEFAULT)
    } else if element == E_FAMILY {
        parseFamily(ps)
    } else if element == E_TEST {
        parseTest(ps)
    } else if element == E_EDIT {
        parseEdit(ps)
    } else if element == E_INT {
        parseInt(ps)
    } else if element == E_DOUBLE {
        parseDouble(ps)
    } else if element == E_STRING {
        parseString(ps, V_STRING)
    } else if element == E_MATRIX {
        parseMatrix(ps)
    } else if element == E_RANGE {
        parseRange(ps)
    } else if element == E_BOOL {
        parseBool(ps)
    } else if element == E_CHARSET {
        parseCharSet(ps)
    } else if element == E_LANGSET {
        parseLangSet(ps)
    } else if element == E_ACCEPTFONT {
        parseAcceptReject(ps, true)
    } else if element == E_REJECTFONT {
        parseAcceptReject(ps, false)
    } else if element == E_GLOB {
        parseString(ps, V_GLOB)
    } else if element == E_PATTERN {
        parsePattern(ps)
    } else if element == E_PATELT {
        parsePatelt(ps)
    } else if element == E_NAME {
        parseName(ps)
    } else if element == E_CONST {
        parseString(ps, V_CONSTANT)
    } else if element >= E_OPERATOR {
        parseOperator(ps, element - E_OPERATOR)
    }
    // The element's frame closed: the values of its children it did not
    // take destroyed.
    while peek(ps) != 0 { popDestroy(ps) }
    const frame = top(ps)
    strset.destroy(mem.getWord(frame + 16))
    mem.freeBuffer(frameText(frame))
    ps.*.depth -= 1
}

fn startElement(ps: *Parse, name: []const u8) -> bool {
    if ps.*.depth == MAX_FRAMES { return false }
    ps.*.serial += 1
    const frame = frameAt(ps, ps.*.depth)
    mem.zero(frame, FRAME_SIZE)
    mem.put64(frame, ps.*.serial)
    mem.put64(frame + 8, @bitCast(u64, elementOf(name)))
    mem.putWord(frame + 16, strset.create())
    mem.initBuffer(frameText(frame))
    ps.*.depth += 1
    return true
}

// Raw XML text decoded (its references expanded) and appended to `b`.
fn appendDecoded(b: *mem.Buffer, raw: xml.String) -> void {
    if raw.length == 0 { return }
    if xml.isPlain(raw) {
        _ = mem.appendBytes(b, @intFromPtr(raw.pointer), raw.length)
        return
    }
    const scratch = mem.alloc(raw.length + 1)
    if scratch == 0 { return }
    const n = xml.decode(raw, mem.bytes(scratch), raw.length)
    if n > 0 { _ = mem.appendBytes(b, scratch, @bitCast(usize, n)) }
    mem.free(scratch)
}

// The configuration in `data` (`length` bytes) read into `cfg` (as the
// file `name`; `loading` false: only checked). False when it is not
// well-formed XML.
pub fn parseMemory(cfg: usize, name: usize, data: usize, length: usize, loading: bool) -> bool {
    const ps = unsafe { @ptrFromInt(*Parse, mem.alloc(@sizeOf(Parse))) }
    if @intFromPtr(ps) == 0 { return false }
    ps.*.cfg = cfg
    ps.*.name = name
    ps.*.frames = mem.alloc(MAX_FRAMES * FRAME_SIZE)
    ps.*.loading = loading
    // (The tokenizer's fixed storage is large: on the heap, not in an
    // export's arena.)
    const tokenizerBlock = mem.alloc(@sizeOf(xml.Tokenizer))
    const tokenBlock = mem.alloc(@sizeOf(xml.Token))
    var ok = ps.*.frames != 0 && tokenizerBlock != 0 && tokenBlock != 0
    if ok {
        const tokenizer = unsafe { @ptrFromInt(*xml.Tokenizer, tokenizerBlock) }
        const token = unsafe { @ptrFromInt(*xml.Token, tokenBlock) }
        xml.initAt(tokenizer, unsafe { @ptrFromInt([*]const u8, data) }, length)
        while xml.next(tokenizer, token) {
            const kind = token.*.kind
            if kind == xml.TokenKind.elementStart {
                if !startElement(ps, token.*.name.pointer[0..token.*.name.length]) {
                    ok = false
                    break
                }
            } else if kind == xml.TokenKind.attribute {
                if ps.*.depth > 0 {
                    const set = mem.getWord(top(ps) + 16)
                    const key = mem.dup(@intFromPtr(token.*.name.pointer), token.*.name.length)
                    var decoded: mem.Buffer = undefined
                    mem.initBuffer(&decoded)
                    appendDecoded(&decoded, token.*.value)
                    _ = mem.appendText(&decoded, "")
                    // (Name and value in turn: inserted at the end, a value
                    // equal to a name not merged as add() would.)
                    _ = strset.insert(set, key, strset.size(set))
                    _ = strset.insert(set, mem.takeBuffer(&decoded), strset.size(set))
                }
            } else if kind == xml.TokenKind.text || kind == xml.TokenKind.cdata {
                if ps.*.depth > 0 {
                    if kind == xml.TokenKind.cdata {
                        _ = mem.appendBytes(frameText(top(ps)), @intFromPtr(token.*.value.pointer), token.*.value.length)
                    } else {
                        appendDecoded(frameText(top(ps)), token.*.value)
                    }
                }
            } else if kind == xml.TokenKind.elementEnd {
                if ps.*.depth > 0 { endElement(ps) }
            }
        }
        if xml.failed(tokenizer) { ok = false }
    }
    while ps.*.depth > 0 {
        const frame = top(ps)
        strset.destroy(mem.getWord(frame + 16))
        mem.freeBuffer(frameText(frame))
        ps.*.depth -= 1
    }
    while ps.*.count > 0 {
        ps.*.count -= 1
    }
    mem.free(ps.*.values)
    mem.free(ps.*.frames)
    mem.free(tokenizerBlock)
    mem.free(tokenBlock)
    mem.free(@intFromPtr(ps))
    return ok
}

// The configuration files read (by their real names), not read twice.
var availableFiles: usize = 0

// _FcConfigParse: the file or directory `name` (absolute, "~/...", or
// relative to the configuration directories: FONTCONFIG_PATH's, then
// /etc/fonts) read into `cfg`; false when it is missing and `complain`,
// or when it is not well-formed.
pub fn parseFile(cfg: usize, name: usize, complain: bool, loading: bool) -> bool {
    const file = paths.configFilename(name)
    if file == 0 { return !complain }
    const real = paths.realFilename(file)
    if availableFiles == 0 { availableFiles = strset.create() }
    if strset.member(availableFiles, real) {
        mem.free(file)
        mem.free(real)
        return true
    }
    if loading { _ = strset.add(config.configFiles(cfg), file) }
    _ = strset.add(availableFiles, real)
    var ok = false
    if paths.isDirectory(real) {
        ok = parseDirectory(cfg, real, complain, loading)
    } else {
        const contents = paths.readFile(real)
        if contents != 0 {
            ok = parseMemory(cfg, file, contents, mem.sizeOf(contents) - 1, loading)
            mem.free(contents)
        }
    }
    mem.free(file)
    mem.free(real)
    if !complain { return true }
    return ok
}

// FcConfigParseAndLoadDir: the [0-9]*.conf files of `dir`, in byte order.
fn parseDirectory(cfg: usize, dir: usize, complain: bool, loading: bool) -> bool {
    if loading { _ = strset.add(config.configDirs(cfg), dir) }
    const files = paths.listDirectory(dir)
    if files == 0 { return !complain }
    const chosen = strset.create()
    var i: usize = 0
    while i < strset.size(files) {
        const base = strset.at(files, i)
        const n = mem.cLength(base)
        const c0 = mem.get8(base)
        if c0 >= 48 && c0 <= 57 && n > 5 && mem.same(mem.view(base + n - 5, 5), ".conf") {
            _ = strset.insert(chosen, paths.buildFilename(dir, base), strset.size(chosen))
        }
        i += 1
    }
    strset.destroy(files)
    paths.sortStrings(chosen)
    var ok = true
    i = 0
    while ok && i < strset.size(chosen) {
        ok = parseFile(cfg, strset.at(chosen, i), complain, loading)
        i += 1
    }
    strset.destroy(chosen)
    return ok || !complain
}

// A file set aside as read when a configuration starts over.
pub fn forgetFiles() -> void {
    strset.destroy(availableFiles)
    availableFiles = 0
}
