// std.fontconfig.value: values (FcValue) and lists of them (FcValueList),
// laid out as Fontconfig's C has them so that the C API hands them out as
// they are:
//
//     a value (16 bytes):  0 its type (32-bit), 8 the value: an integer
//                          (32-bit), a bool (32-bit: 0, 1, 2 for "don't
//                          care"), a double, or the address of a string,
//                          matrix, charset, langset, range or FT_Face
//     a list node (32):    0 the next node, 8 the value, 24 the binding
//                          (32-bit: weak, strong, same)
//
// A value a list holds owns what it points to (a string, a matrix, a
// range or a langset of its own; a reference to a charset); a value
// passed in or handed out does not.
const mem = @import("./mem.mlx")
const strings = @import("./strings.mlx")
const objects = @import("./objects.mlx")
const charset = @import("./charset.mlx")
const lang = @import("./lang.mlx")

pub const BINDING_WEAK: i64 = 0
pub const BINDING_STRONG: i64 = 1
pub const BINDING_SAME: i64 = 2

pub const SIZE: usize = 16
pub const NODE_SIZE: usize = 32

pub fn typeOf(v: usize) -> i64 { return mem.getI32(v) }
pub fn setType(v: usize, t: i64) -> void {
    mem.putI32(v, t)
    mem.put32(v + 4, 0)
}
pub fn intOf(v: usize) -> i64 { return mem.getI32(v + 8) }
pub fn doubleOf(v: usize) -> f64 { return mem.getF64(v + 8) }
pub fn pointerOf(v: usize) -> usize { return mem.getWord(v + 8) }
pub fn boolOf(v: usize) -> i64 { return mem.getI32(v + 8) }

pub fn setInt(v: usize, i: i64) -> void {
    setType(v, objects.TYPE_INTEGER)
    mem.put64(v + 8, 0)
    mem.putI32(v + 8, i)
}

pub fn setDouble(v: usize, d: f64) -> void {
    setType(v, objects.TYPE_DOUBLE)
    mem.putF64(v + 8, d)
}

pub fn setBool(v: usize, b: i64) -> void {
    setType(v, objects.TYPE_BOOL)
    mem.put64(v + 8, 0)
    mem.putI32(v + 8, b)
}

pub fn setPointer(v: usize, t: i64, p: usize) -> void {
    setType(v, t)
    mem.putWord(v + 8, p)
}

pub fn setVoid(v: usize) -> void {
    setType(v, objects.TYPE_VOID)
    mem.put64(v + 8, 0)
}

// ---------------------------------------------------------------------------
// Matrices (four doubles: xx, xy, yx, yy) and ranges (begin, end).

pub fn matrixCopy(m: usize) -> usize {
    if m == 0 { return 0 }
    const copy = mem.alloc(32)
    if copy != 0 { mem.copy(copy, m, 32) }
    return copy
}

pub fn matrixEqual(a: usize, b: usize) -> bool {
    if a == b { return true }
    if a == 0 || b == 0 { return false }
    return mem.getF64(a) == mem.getF64(b) && mem.getF64(a + 8) == mem.getF64(b + 8) && mem.getF64(a + 16) == mem.getF64(b + 16) && mem.getF64(a + 24) == mem.getF64(b + 24)
}

// FcMatrixMultiply: `result` = a * b (`result` may be either).
pub fn matrixMultiply(result: usize, a: usize, b: usize) -> void {
    const xx = mem.getF64(a) * mem.getF64(b) + mem.getF64(a + 8) * mem.getF64(b + 16)
    const xy = mem.getF64(a) * mem.getF64(b + 8) + mem.getF64(a + 8) * mem.getF64(b + 24)
    const yx = mem.getF64(a + 16) * mem.getF64(b) + mem.getF64(a + 24) * mem.getF64(b + 16)
    const yy = mem.getF64(a + 16) * mem.getF64(b + 8) + mem.getF64(a + 24) * mem.getF64(b + 24)
    mem.putF64(result, xx)
    mem.putF64(result + 8, xy)
    mem.putF64(result + 16, yx)
    mem.putF64(result + 24, yy)
}

pub fn matrixIdentity(m: usize) -> void {
    mem.putF64(m, 1.0)
    mem.putF64(m + 8, 0.0)
    mem.putF64(m + 16, 0.0)
    mem.putF64(m + 24, 1.0)
}

pub fn rangeCreate(begin: f64, end: f64) -> usize {
    const r = mem.alloc(16)
    if r != 0 {
        mem.putF64(r, begin)
        mem.putF64(r + 8, end)
    }
    return r
}

pub fn rangeBegin(r: usize) -> f64 { return mem.getF64(r) }
pub fn rangeEnd(r: usize) -> f64 { return mem.getF64(r + 8) }

pub fn rangeCopy(r: usize) -> usize { return rangeCreate(rangeBegin(r), rangeEnd(r)) }

pub fn rangeIsInRange(a: usize, b: usize) -> bool { return rangeBegin(a) >= rangeBegin(b) && rangeEnd(a) <= rangeEnd(b) }

fn truncated(d: f64) -> i64 {
    if d != d { return 0 }
    if d >= 2147483647.0 { return 2147483647 }
    if d <= -2147483648.0 { return -2147483648 }
    return @intFromFloat(i64, d)
}

// FcRangeHash (32-bit).
pub fn rangeHash(r: usize) -> u64 {
    const b = @bitCast(u64, truncated(rangeBegin(r) * 100.0)) & 0xffffffff
    const e = @bitCast(u64, truncated(rangeEnd(r) * 100.0)) & 0xffffffff
    return (b ^ ((b << 1) & 0xffffffff) ^ ((e << 9) & 0xffffffff)) & 0xffffffff
}

// ---------------------------------------------------------------------------
// Values.

// What a value of the type `t` and the word `word` (its union: an
// integer, a double's bits or an address) owns, copied (FcValueSave): the
// new word, 0 when there is no memory for it.
pub fn ownedWord(t: i64, word: u64) -> u64 {
    const p = @intCast(usize, word)
    if t == objects.TYPE_STRING { return @intCast(u64, mem.dupC(p)) }
    if t == objects.TYPE_MATRIX { return @intCast(u64, matrixCopy(p)) }
    if t == objects.TYPE_CHARSET { return @intCast(u64, charset.reference(p)) }
    if t == objects.TYPE_LANGSET { return @intCast(u64, lang.copy(p)) }
    if t == objects.TYPE_RANGE { return @intCast(u64, rangeCopy(p)) }
    return word
}

pub fn ownsPointer(t: i64) -> bool { return t == objects.TYPE_STRING || t == objects.TYPE_MATRIX || t == objects.TYPE_CHARSET || t == objects.TYPE_LANGSET || t == objects.TYPE_RANGE }

// FcValueSave: `to` the value of `from` owning a copy of what it points to
// (false, and `to` void, when there is no memory).
pub fn save(to: usize, from: usize) -> bool {
    const t = typeOf(from)
    const word = mem.get64(from + 8)
    setType(to, t)
    if !ownsPointer(t) {
        mem.put64(to + 8, word)
        return true
    }
    const copy = ownedWord(t, word)
    if copy == 0 {
        setVoid(to)
        return false
    }
    mem.put64(to + 8, copy)
    return true
}

// FcValueDestroy: what the value owns freed.
pub fn release(v: usize) -> void {
    const t = typeOf(v)
    if t == objects.TYPE_STRING || t == objects.TYPE_MATRIX || t == objects.TYPE_RANGE {
        mem.free(pointerOf(v))
    } else if t == objects.TYPE_CHARSET {
        charset.destroy(pointerOf(v))
    } else if t == objects.TYPE_LANGSET {
        lang.destroy(pointerOf(v))
    }
}

// The value as a double when it is a number (`ok` false when not).
pub fn number(v: usize, ok: *bool) -> f64 {
    const t = typeOf(v)
    ok.* = true
    if t == objects.TYPE_INTEGER { return @floatFromInt(f64, intOf(v)) }
    if t == objects.TYPE_DOUBLE { return doubleOf(v) }
    ok.* = false
    return 0.0
}

// FcValueEqual: an integer equal to a double of its value; strings
// ignoring case; ranges when `a` is in `b`.
pub fn equal(a: usize, b: usize) -> bool {
    var ta = typeOf(a)
    var tb = typeOf(b)
    if ta != tb {
        if (ta == objects.TYPE_INTEGER || ta == objects.TYPE_DOUBLE) && (tb == objects.TYPE_INTEGER || tb == objects.TYPE_DOUBLE) {
            var ok = false
            return number(a, &ok) == number(b, &ok)
        }
        return false
    }
    if ta == objects.TYPE_UNKNOWN { return false }
    if ta == objects.TYPE_VOID { return true }
    if ta == objects.TYPE_INTEGER || ta == objects.TYPE_BOOL { return intOf(a) == intOf(b) }
    if ta == objects.TYPE_DOUBLE { return doubleOf(a) == doubleOf(b) }
    if ta == objects.TYPE_STRING { return strings.cmpIgnoreCase(pointerOf(a), pointerOf(b)) == 0 }
    if ta == objects.TYPE_MATRIX { return matrixEqual(pointerOf(a), pointerOf(b)) }
    if ta == objects.TYPE_CHARSET { return charset.equal(pointerOf(a), pointerOf(b)) }
    if ta == objects.TYPE_FTFACE { return pointerOf(a) == pointerOf(b) }
    if ta == objects.TYPE_LANGSET { return lang.equal(pointerOf(a), pointerOf(b)) }
    if ta == objects.TYPE_RANGE { return rangeIsInRange(pointerOf(a), pointerOf(b)) }
    return false
}

fn doubleHash(d: f64) -> u64 {
    var v = d
    if v < 0.0 { v = 0.0 - v }
    if v > 4294967295.0 { v = 4294967295.0 }
    return @intFromFloat(u64, v) & 0xffffffff
}

// FcValueHash (32-bit; an FT_Face hashes as 0 here).
pub fn hash(v: usize) -> u64 {
    const t = typeOf(v)
    if t == objects.TYPE_INTEGER || t == objects.TYPE_BOOL { return @bitCast(u64, intOf(v)) & 0xffffffff }
    if t == objects.TYPE_DOUBLE { return doubleHash(doubleOf(v)) }
    if t == objects.TYPE_STRING { return strings.hash(pointerOf(v)) }
    if t == objects.TYPE_MATRIX {
        const m = pointerOf(v)
        return doubleHash(mem.getF64(m)) ^ doubleHash(mem.getF64(m + 8)) ^ doubleHash(mem.getF64(m + 16)) ^ doubleHash(mem.getF64(m + 24))
    }
    if t == objects.TYPE_CHARSET { return charset.pageCount(pointerOf(v)) & 0xffffffff }
    if t == objects.TYPE_LANGSET { return lang.hash(pointerOf(v)) }
    if t == objects.TYPE_RANGE { return rangeHash(pointerOf(v)) }
    return 0
}

// ---------------------------------------------------------------------------
// Lists.

pub fn next(node: usize) -> usize { return mem.getWord(node) }
pub fn setNext(node: usize, n: usize) -> void { mem.putWord(node, n) }
pub fn valueOf(node: usize) -> usize { return node + 8 }
pub fn bindingOf(node: usize) -> i64 { return mem.getI32(node + 24) }
pub fn setBinding(node: usize, b: i64) -> void { mem.putI32(node + 24, b) }

// A node of the value `t`, `word` with a copy of what it points to, 0
// when it is void or there is no memory.
pub fn node(t: i64, word: u64, binding: i64) -> usize {
    if t == objects.TYPE_VOID { return 0 }
    var w = word
    if ownsPointer(t) {
        w = ownedWord(t, word)
        if w == 0 { return 0 }
    }
    return nodeTaking(t, w, binding)
}

// A node taking the value as it is (what it points to now the list's).
pub fn nodeTaking(t: i64, word: u64, binding: i64) -> usize {
    const n = mem.alloc(NODE_SIZE)
    if n == 0 { return 0 }
    setType(n + 8, t)
    mem.put64(n + 8 + 8, word)
    mem.putI32(n + 24, binding)
    return n
}

// The words of values: an integer's (32-bit, sign kept as C's int), a
// double's bits.
pub fn intWord(i: i64) -> u64 { return @bitCast(u64, i) & 0xffffffff }
pub fn doubleWord(d: f64) -> u64 { return @bitCast(u64, d) }
pub fn wordOf(v: usize) -> u64 { return mem.get64(v + 8) }

// FcValueListDestroy.
pub fn destroyList(list: usize) -> void {
    var l = list
    while l != 0 {
        const following = next(l)
        release(l + 8)
        mem.free(l)
        l = following
    }
}

// FcValueListDuplicate.
pub fn duplicateList(list: usize) -> usize {
    var head: usize = 0
    var tail: usize = 0
    var l = list
    while l != 0 {
        const n = mem.alloc(NODE_SIZE)
        if n == 0 { break }
        _ = save(n + 8, l + 8)
        mem.putI32(n + 24, bindingOf(l))
        if tail == 0 { head = n } else { setNext(tail, n) }
        tail = n
        l = next(l)
    }
    return head
}

pub fn listLength(list: usize) -> usize {
    var n: usize = 0
    var l = list
    while l != 0 {
        n += 1
        l = next(l)
    }
    return n
}

// The last node of a list (0 for an empty one).
pub fn last(list: usize) -> usize {
    var l = list
    if l == 0 { return 0 }
    while next(l) != 0 { l = next(l) }
    return l
}

pub fn listEqual(a: usize, b: usize) -> bool {
    if a == b { return true }
    var la = a
    var lb = b
    while la != 0 && lb != 0 {
        if !equal(la + 8, lb + 8) { return false }
        la = next(la)
        lb = next(lb)
    }
    return la == 0 && lb == 0
}

pub fn listHash(list: usize) -> u64 {
    var h: u64 = 0
    var l = list
    while l != 0 {
        h = ((((h << 1) & 0xffffffff) | (h >> 31)) ^ hash(l + 8)) & 0xffffffff
        l = next(l)
    }
    return h
}
