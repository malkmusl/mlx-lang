// std.fontconfig.match: the font nearest to a pattern (FcFontMatch,
// FcFontSetMatch), the fonts in order of nearness (FcFontSort), the fonts
// having what a pattern asks for (FcFontList), and a matched font's
// pattern made for rendering (FcFontRenderPrepare), as Fontconfig 2.15
// does them.
//
// A font is scored against the pattern by the objects both have, each
// into a priority (file, wrapper, format, variable, named instance,
// scalable, color, foundry, charset, family strongly, PostScript name
// strongly, language, family weakly, PostScript name weakly, symbol,
// spacing, size, pixel size, style, slant, weight, width, hinting,
// decorative, antialiasing, rasterizer, outline, order, version); the
// scores are compared priority by priority, the lower the nearer. A
// score is the distance of the best pair of values (the font's value
// nearest to one of the pattern's) times 1000, plus a hundred for each
// pattern value passed over to reach it; families score the position of
// the first pattern family the font has, strong and weak bindings apart.
const mem = @import("./mem.mlx")
const strings = @import("./strings.mlx")
const strset = @import("./strset.mlx")
const charset = @import("./charset.mlx")
const lang = @import("./lang.mlx")
const objects = @import("./objects.mlx")
const value = @import("./value.mlx")
const pattern = @import("./pattern.mlx")
const config = @import("./config.mlx")

const PRI_FILE: usize = 0
const PRI_FONT_WRAPPER: usize = 1
const PRI_FONTFORMAT: usize = 2
const PRI_VARIABLE: usize = 3
const PRI_NAMED_INSTANCE: usize = 4
const PRI_SCALABLE: usize = 5
const PRI_COLOR: usize = 6
const PRI_FOUNDRY: usize = 7
const PRI_CHARSET: usize = 8
const PRI_FAMILY_STRONG: usize = 9
const PRI_POSTSCRIPT_NAME_STRONG: usize = 10
const PRI_LANG: usize = 11
const PRI_FAMILY_WEAK: usize = 12
const PRI_POSTSCRIPT_NAME_WEAK: usize = 13
const PRI_SYMBOL: usize = 14
const PRI_SPACING: usize = 15
const PRI_SIZE: usize = 16
const PRI_PIXEL_SIZE: usize = 17
const PRI_STYLE: usize = 18
const PRI_SLANT: usize = 19
const PRI_WEIGHT: usize = 20
const PRI_WIDTH: usize = 21
const PRI_FONT_HAS_HINT: usize = 22
const PRI_DECORATIVE: usize = 23
const PRI_ANTIALIAS: usize = 24
const PRI_RASTERIZER: usize = 25
const PRI_OUTLINE: usize = 26
const PRI_ORDER: usize = 27
const PRI_FONTVERSION: usize = 28
pub const PRI_END: usize = 29

// The comparisons.
const CMP_NONE: u8 = 0
const CMP_FAMILY: u8 = 1
const CMP_STRING: u8 = 2
const CMP_NUMBER: u8 = 3
const CMP_BOOL: u8 = 4
const CMP_FILENAME: u8 = 5
const CMP_CHARSET: u8 = 6
const CMP_LANG: u8 = 7
const CMP_POSTSCRIPT: u8 = 8
const CMP_RANGE: u8 = 9
const CMP_SIZE: u8 = 10

// An object's matcher: its comparison and its strong and weak priorities
// (CMP_NONE: not compared). `includeLang`: the languages of names compared
// as languages.
pub const Matcher = struct {
    kind: u8
    strong: usize
    weak: usize
}

fn matcher(kind: u8, priority: usize) -> Matcher { return Matcher.{ .kind = kind, .strong = priority, .weak = priority } }

pub fn matcherOf(object0: i64, includeLang: bool) -> Matcher {
    var object = object0
    if includeLang && (object == objects.FAMILYLANG || object == objects.STYLELANG || object == objects.FULLNAMELANG) { object = objects.LANG }
    if object == objects.FAMILY { return Matcher.{ .kind = CMP_FAMILY, .strong = PRI_FAMILY_STRONG, .weak = PRI_FAMILY_WEAK } }
    if object == objects.STYLE { return matcher(CMP_STRING, PRI_STYLE) }
    if object == objects.SLANT { return matcher(CMP_NUMBER, PRI_SLANT) }
    if object == objects.WEIGHT { return matcher(CMP_RANGE, PRI_WEIGHT) }
    if object == objects.WIDTH { return matcher(CMP_RANGE, PRI_WIDTH) }
    if object == objects.SIZE { return matcher(CMP_SIZE, PRI_SIZE) }
    if object == objects.PIXEL_SIZE { return matcher(CMP_NUMBER, PRI_PIXEL_SIZE) }
    if object == objects.SPACING { return matcher(CMP_NUMBER, PRI_SPACING) }
    if object == objects.FOUNDRY { return matcher(CMP_STRING, PRI_FOUNDRY) }
    if object == objects.ANTIALIAS { return matcher(CMP_BOOL, PRI_ANTIALIAS) }
    if object == objects.FILE { return matcher(CMP_FILENAME, PRI_FILE) }
    if object == objects.RASTERIZER { return matcher(CMP_STRING, PRI_RASTERIZER) }
    if object == objects.OUTLINE { return matcher(CMP_BOOL, PRI_OUTLINE) }
    if object == objects.SCALABLE { return matcher(CMP_BOOL, PRI_SCALABLE) }
    if object == objects.CHARSET { return matcher(CMP_CHARSET, PRI_CHARSET) }
    if object == objects.LANG { return matcher(CMP_LANG, PRI_LANG) }
    if object == objects.FONTVERSION { return matcher(CMP_NUMBER, PRI_FONTVERSION) }
    if object == objects.FONTFORMAT { return matcher(CMP_STRING, PRI_FONTFORMAT) }
    if object == objects.DECORATIVE { return matcher(CMP_BOOL, PRI_DECORATIVE) }
    if object == objects.POSTSCRIPT_NAME { return Matcher.{ .kind = CMP_POSTSCRIPT, .strong = PRI_POSTSCRIPT_NAME_STRONG, .weak = PRI_POSTSCRIPT_NAME_WEAK } }
    if object == objects.COLOR { return matcher(CMP_BOOL, PRI_COLOR) }
    if object == objects.SYMBOL { return matcher(CMP_BOOL, PRI_SYMBOL) }
    if object == objects.VARIABLE { return matcher(CMP_BOOL, PRI_VARIABLE) }
    if object == objects.FONT_HAS_HINT { return matcher(CMP_BOOL, PRI_FONT_HAS_HINT) }
    if object == objects.ORDER { return matcher(CMP_NUMBER, PRI_ORDER) }
    if object == objects.NAMED_INSTANCE { return matcher(CMP_BOOL, PRI_NAMED_INSTANCE) }
    if object == objects.FONT_WRAPPER { return matcher(CMP_STRING, PRI_FONT_WRAPPER) }
    return Matcher.{ .kind = CMP_NONE, .strong = 0, .weak = 0 }
}

// ---------------------------------------------------------------------------
// The comparisons of two values: the distance (-1: the types do not go
// together) and the value matched (its type and word, the font's value's
// own unless said otherwise).

pub const Compared = struct {
    distance: f64
    t: i64
    word: u64
}

fn compared(distance: f64, v2: usize) -> Compared { return Compared.{ .distance = distance, .t = value.typeOf(v2), .word = value.wordOf(v2) } }
fn mismatch() -> Compared { return Compared.{ .distance = -1.0, .t = objects.TYPE_VOID, .word = 0 } }

fn bounds(v: usize, begin: *f64, end: *f64) -> bool {
    const t = value.typeOf(v)
    if t == objects.TYPE_INTEGER {
        begin.* = @floatFromInt(f64, value.intOf(v))
        end.* = begin.*
        return true
    }
    if t == objects.TYPE_DOUBLE {
        begin.* = value.doubleOf(v)
        end.* = begin.*
        return true
    }
    if t == objects.TYPE_RANGE {
        begin.* = value.rangeBegin(value.pointerOf(v))
        end.* = value.rangeEnd(value.pointerOf(v))
        return true
    }
    return false
}

fn fabs(x: f64) -> f64 { return if x < 0.0 { 0.0 - x } else { x } }
fn fmin(a: f64, b: f64) -> f64 { return if a < b { a } else { b } }
fn fmax(a: f64, b: f64) -> f64 { return if a > b { a } else { b } }

fn compareValues(kind: u8, v1: usize, v2: usize) -> Compared {
    const t1 = value.typeOf(v1)
    const t2 = value.typeOf(v2)
    if kind == CMP_NUMBER {
        var ok1 = false
        var ok2 = false
        const a = value.number(v1, &ok1)
        const b = value.number(v2, &ok2)
        if !ok1 || !ok2 { return mismatch() }
        return compared(fabs(b - a), v2)
    }
    if kind == CMP_STRING {
        return compared(if strings.cmpIgnoreCase(value.pointerOf(v1), value.pointerOf(v2)) != 0 { 1.0 } else { 0.0 }, v2)
    }
    if kind == CMP_FAMILY || kind == CMP_POSTSCRIPT {
        const s1 = value.pointerOf(v1)
        const s2 = value.pointerOf(v2)
        const c1 = mem.get8(s1)
        const c2 = mem.get8(s2)
        if strings.lower(c1) != strings.lower(c2) && c1 != 32 && c2 != 32 { return compared(1.0, v2) }
        if kind == CMP_FAMILY { return compared(if strings.cmpIgnoreBlanksAndCase(s1, s2) != 0 { 1.0 } else { 0.0 }, v2) }
        const n = strings.matchIgnoreCaseAndDelims(s1, s2, " -")
        const l1 = mem.cLength(s1)
        const l2 = mem.cLength(s2)
        const longest = if l1 > l2 { l1 } else { l2 }
        return compared(@floatFromInt(f64, @intCast(i64, longest) - n) / @floatFromInt(f64, longest), v2)
    }
    if kind == CMP_LANG {
        var result: i64 = 0
        if t1 == objects.TYPE_LANGSET {
            if t2 == objects.TYPE_LANGSET {
                result = lang.compareSets(value.pointerOf(v1), value.pointerOf(v2))
            } else if t2 == objects.TYPE_STRING {
                result = lang.hasLang(value.pointerOf(v1), value.pointerOf(v2))
            } else {
                return mismatch()
            }
        } else if t1 == objects.TYPE_STRING {
            if t2 == objects.TYPE_LANGSET {
                result = lang.hasLang(value.pointerOf(v2), value.pointerOf(v1))
            } else if t2 == objects.TYPE_STRING {
                result = lang.compare(value.pointerOf(v1), value.pointerOf(v2))
            } else {
                return mismatch()
            }
        } else {
            return mismatch()
        }
        return compared(@floatFromInt(f64, result), v2)
    }
    if kind == CMP_BOOL {
        if t1 != objects.TYPE_BOOL || t2 != objects.TYPE_BOOL { return mismatch() }
        const b1 = value.boolOf(v1)
        const b2 = value.boolOf(v2)
        const best = if b2 != 2 { b2 } else { b1 }
        return Compared.{ .distance = if (b1 ^ b2) == 1 { 1.0 } else { 0.0 }, .t = objects.TYPE_BOOL, .word = value.intWord(best) }
    }
    if kind == CMP_CHARSET { return compared(@floatFromInt(f64, charset.subtractCount(value.pointerOf(v1), value.pointerOf(v2))), v2) }
    if kind == CMP_RANGE || kind == CMP_SIZE {
        var b1: f64 = 0.0
        var e1: f64 = 0.0
        var b2: f64 = 0.0
        var e2: f64 = 0.0
        if !bounds(v1, &b1, &e1) || !bounds(v2, &b2, &e2) { return mismatch() }
        if kind == CMP_RANGE {
            var d: f64 = 0.0
            if e1 < b2 { d = b2 } else if e2 < b1 { d = e2 } else { d = (fmax(b1, b2) + fmin(e1, e2)) * 0.5 }
            const result = Compared.{ .distance = 0.0, .t = objects.TYPE_DOUBLE, .word = value.doubleWord(d) }
            if e1 < b2 || e2 < b1 { return Compared.{ .distance = fmin(fabs(b2 - e1), fabs(b1 - e2)), .t = result.t, .word = result.word } }
            return result
        }
        const best = value.doubleWord((b1 + e1) * 0.5)
        if e1 < b2 || e2 < b1 { return Compared.{ .distance = fmin(fabs(b2 - e1), fabs(b1 - e2)), .t = objects.TYPE_DOUBLE, .word = best } }
        if b2 != e2 && b1 == e2 { return Compared.{ .distance = 0.000000000000001, .t = objects.TYPE_DOUBLE, .word = best } }
        return Compared.{ .distance = 0.0, .t = objects.TYPE_DOUBLE, .word = best }
    }
    if kind == CMP_FILENAME {
        const s1 = value.pointerOf(v1)
        const s2 = value.pointerOf(v2)
        var d: f64 = 3.0
        if strings.cmp(s1, s2) == 0 { d = 0.0 } else if strings.cmpIgnoreCase(s1, s2) == 0 { d = 1.0 } else if strings.globMatch(s1, s2) { d = 2.0 }
        return compared(d, v2)
    }
    return mismatch()
}

// FcCompareValueList: the best pair of the pattern's values `l1` and the
// font's `l2`, added into `scores` (nothing when `scores` is 0); the
// value matched and its position. False when the types do not go
// together.
pub const ListResult = struct {
    ok: bool
    t: i64
    word: u64
    position: usize
}

fn compareValueList(m: Matcher, l1: usize, l2: usize, scores: usize) -> ListResult {
    if m.kind == CMP_NONE {
        return ListResult.{ .ok = true, .t = value.typeOf(value.valueOf(l2)), .word = value.wordOf(value.valueOf(l2)), .position = 0 }
    }
    var best: f64 = 1.0e99
    var bestStrong: f64 = 1.0e99
    var bestWeak: f64 = 1.0e99
    var bestT = objects.TYPE_VOID
    var bestWord: u64 = 0
    var position: usize = 0
    var j: usize = 0
    var v1 = l1
    var done = false
    while v1 != 0 && !done {
        var k: usize = 0
        var v2 = l2
        while v2 != 0 {
            const c = compareValues(m.kind, value.valueOf(v1), value.valueOf(v2))
            if c.distance < 0.0 { return ListResult.{ .ok = false, .t = 0, .word = 0, .position = 0 } }
            const isString = value.typeOf(value.valueOf(v2)) == objects.TYPE_STRING
            const v = c.distance * 1000.0 + @floatFromInt(f64, j) * 100.0 + (if isString { @floatFromInt(f64, k) } else { 0.0 })
            if v < best {
                bestT = c.t
                bestWord = c.word
                best = v
                position = k
            }
            if m.weak == m.strong {
                if best < 1000.0 {
                    done = true
                    break
                }
            } else if value.bindingOf(v1) == value.BINDING_STRONG {
                if v < bestStrong { bestStrong = v }
            } else {
                if v < bestWeak { bestWeak = v }
            }
            k += 1
            v2 = value.next(v2)
        }
        j += 1
        v1 = value.next(v1)
    }
    if scores != 0 {
        if m.weak == m.strong {
            addScore(scores, m.strong, best)
        } else {
            addScore(scores, m.weak, bestWeak)
            addScore(scores, m.strong, bestStrong)
        }
    }
    return ListResult.{ .ok = true, .t = bestT, .word = bestWord, .position = position }
}

fn addScore(scores: usize, i: usize, v: f64) -> void { mem.putF64(scores + i * 8, mem.getF64(scores + i * 8) + v) }
fn score(scores: usize, i: usize) -> f64 { return mem.getF64(scores + i * 8) }

// The pattern's families (FcCompareDataInit): records of a family (a C
// string) and the first positions it has strongly and weakly (doubles).
const Families = struct {
    table: usize
    count: usize
}

fn familiesOf(p: usize) -> Families {
    const list = pattern.values(p, objects.FAMILY)
    const n = value.listLength(list)
    var f = Families.{ .table = 0, .count = 0 }
    if n == 0 { return f }
    f.table = mem.alloc(n * 24)
    var l = list
    var i: usize = 0
    while l != 0 {
        const s = value.pointerOf(value.valueOf(l))
        var e: usize = 0
        while e < f.count {
            if strings.cmpIgnoreBlanksAndCase(mem.getWord(f.table + e * 24), s) == 0 { break }
            e += 1
        }
        if e == f.count {
            mem.putWord(f.table + e * 24, s)
            mem.putF64(f.table + e * 24 + 8, 1.0e99)
            mem.putF64(f.table + e * 24 + 16, 1.0e99)
            f.count += 1
        }
        const at = if value.bindingOf(l) == value.BINDING_WEAK { f.table + e * 24 + 16 } else { f.table + e * 24 + 8 }
        if @floatFromInt(f64, i) < mem.getF64(at) { mem.putF64(at, @floatFromInt(f64, i)) }
        i += 1
        l = value.next(l)
    }
    return f
}

// FcCompareFamilies: the nearest strong and weak positions of the font's
// families among the pattern's.
fn compareFamilies(f: *Families, fontList: usize, scores: usize) -> void {
    var strong: f64 = 1.0e99
    var weak: f64 = 1.0e99
    var l = fontList
    while l != 0 {
        const s = value.pointerOf(value.valueOf(l))
        var e: usize = 0
        while e < f.*.count {
            if strings.cmpIgnoreBlanksAndCase(mem.getWord(f.*.table + e * 24), s) == 0 {
                if mem.getF64(f.*.table + e * 24 + 8) < strong { strong = mem.getF64(f.*.table + e * 24 + 8) }
                if mem.getF64(f.*.table + e * 24 + 16) < weak { weak = mem.getF64(f.*.table + e * 24 + 16) }
                break
            }
            e += 1
        }
        l = value.next(l)
    }
    mem.putF64(scores + PRI_FAMILY_STRONG * 8, strong)
    mem.putF64(scores + PRI_FAMILY_WEAK * 8, weak)
}

// FcCompare: the font's scores (PRI_END doubles at `scores`).
fn compare(p: usize, font: usize, scores: usize, f: *Families) -> bool {
    mem.zero(scores, PRI_END * 8)
    var i1: usize = 0
    var i2: usize = 0
    while i1 < pattern.count(p) && i2 < pattern.count(font) {
        const e1 = pattern.elt(p, i1)
        const e2 = pattern.elt(font, i2)
        const o1 = pattern.eltObject(e1)
        const o2 = pattern.eltObject(e2)
        if o1 > o2 {
            i2 += 1
        } else if o1 < o2 {
            i1 += 1
        } else {
            if o1 == objects.FAMILY {
                compareFamilies(f, pattern.eltValues(e2), scores)
            } else {
                const r = compareValueList(matcherOf(o1, false), pattern.eltValues(e1), pattern.eltValues(e2), scores)
                if !r.ok { return false }
            }
            i1 += 1
            i2 += 1
        }
    }
    return true
}

// ---------------------------------------------------------------------------
// Matching.

// FcFontSetMatchInternal: the best font of the sets (an array of `nsets`
// font set addresses, 0s passed over) for `p`, as a pattern of its own
// whose compared values are bound strongly when they matched exactly; 0
// when there is none.
fn bestOf(sets: usize, nsets: usize, p: usize) -> usize {
    const scores = mem.alloc(PRI_END * 8)
    const bestScores = mem.alloc(PRI_END * 8)
    var f = familiesOf(p)
    var best: usize = 0
    var s: usize = 0
    while s < nsets {
        const fs = mem.getWord(sets + s * 8)
        var k: usize = 0
        while fs != 0 && k < pattern.fontSetCount(fs) {
            const font = pattern.fontSetFont(fs, k)
            if !compare(p, font, scores, &f) {
                best = 0
                s = nsets
                break
            }
            var i: usize = 0
            while i < PRI_END {
                if best != 0 && score(bestScores, i) < score(scores, i) { break }
                if best == 0 || score(scores, i) < score(bestScores, i) {
                    mem.copy(bestScores, scores, PRI_END * 8)
                    best = font
                    break
                }
                i += 1
            }
            k += 1
        }
        s += 1
    }
    mem.free(f.table)
    var result: usize = 0
    if best != 0 {
        result = pattern.create()
        var i: usize = 0
        while i < pattern.count(best) {
            const e = pattern.elt(best, i)
            const object = pattern.eltObject(e)
            const m = matcherOf(object, false)
            if m.kind == CMP_NONE {
                _ = pattern.listAdd(result, object, value.duplicateList(pattern.eltValues(e)), true)
            } else {
                const binding = if score(bestScores, m.strong) < 1000.0 { value.BINDING_STRONG } else { value.BINDING_WEAK }
                const copy = value.duplicateList(pattern.eltValues(e))
                var l = copy
                while l != 0 {
                    value.setBinding(l, binding)
                    l = value.next(l)
                }
                _ = pattern.listAdd(result, object, copy, true)
            }
            i += 1
        }
    }
    mem.free(scores)
    mem.free(bestScores)
    return result
}

// FcFontRenderPrepare: the font's pattern for rendering: each of its
// values the pattern compares chosen by the comparison, the names in the
// language the pattern asks for first, the pattern's objects the font
// lacks added, variation settings for a variable font, then the rules
// of the font kind applied.
pub fn renderPrepare(c: usize, p: usize, font: usize) -> usize {
    var variable: i64 = 0
    _ = pattern.getBool(font, objects.VARIABLE, 0, &variable)
    var variations: mem.Buffer = undefined
    mem.initBuffer(&variations)
    const result = pattern.create()
    if result == 0 { return 0 }
    var i: usize = 0
    while i < pattern.count(font) {
        const fe = pattern.elt(font, i)
        const object = pattern.eltObject(fe)
        i += 1
        if object == objects.FAMILYLANG || object == objects.STYLELANG || object == objects.FULLNAMELANG { continue }
        if object == objects.FAMILY || object == objects.STYLE || object == objects.FULLNAME {
            const fel = pattern.findElt(font, object + 1)
            const pel = pattern.findElt(p, object + 1)
            if fel != 0 && pel != 0 {
                const r = compareValueList(matcherOf(object + 1, true), pattern.eltValues(pel), pattern.eltValues(fel), 0)
                if !r.ok {
                    pattern.destroy(result)
                    mem.freeBuffer(&variations)
                    return 0
                }
                const n = r.position
                var names: usize = 0
                var langs: usize = 0
                var l1 = pattern.eltValues(fe)
                var l2 = pattern.eltValues(fel)
                var j: usize = 0
                while l1 != 0 || l2 != 0 {
                    if l1 != 0 {
                        const node = value.node(value.typeOf(value.valueOf(l1)), value.wordOf(value.valueOf(l1)), value.bindingOf(l1))
                        names = place(names, node, j == n)
                    }
                    if l2 != 0 {
                        const binding = if j == n { value.BINDING_STRONG } else { value.bindingOf(l2) }
                        const node = value.node(value.typeOf(value.valueOf(l2)), value.wordOf(value.valueOf(l2)), binding)
                        langs = place(langs, node, j == n)
                    }
                    j += 1
                    if l1 != 0 { l1 = value.next(l1) }
                    if l2 != 0 { l2 = value.next(l2) }
                }
                _ = pattern.listAdd(result, object, names, false)
                _ = pattern.listAdd(result, object + 1, langs, false)
                continue
            } else if fel != 0 {
                _ = pattern.listAdd(result, object, value.duplicateList(pattern.eltValues(fe)), false)
                _ = pattern.listAdd(result, object + 1, value.duplicateList(pattern.eltValues(fel)), false)
                continue
            }
        }
        const pe = pattern.findElt(p, object)
        if pe != 0 {
            const r = compareValueList(matcherOf(object, false), pattern.eltValues(pe), pattern.eltValues(fe), 0)
            if !r.ok {
                pattern.destroy(result)
                mem.freeBuffer(&variations)
                return 0
            }
            _ = pattern.add(result, object, r.t, r.word, false)
            const first = pattern.eltValues(fe)
            if variable == 1 && value.typeOf(value.valueOf(first)) == objects.TYPE_RANGE && (object == objects.WEIGHT || object == objects.WIDTH || object == objects.SIZE) {
                var num = @bitCast(f64, r.word)
                var tag: []const u8 = "    "
                if object == objects.WEIGHT {
                    tag = "wght"
                    num = objects.weightToOpenType(num)
                } else if object == objects.WIDTH {
                    tag = "wdth"
                } else {
                    tag = "opsz"
                }
                if variations.length > 0 { _ = mem.appendByte(&variations, 44) }
                _ = mem.appendText(&variations, tag)
                _ = mem.appendByte(&variations, 61)
                _ = mem.appendDouble(&variations, num)
            }
        } else {
            _ = pattern.listAdd(result, object, value.duplicateList(pattern.eltValues(fe)), true)
        }
    }
    i = 0
    while i < pattern.count(p) {
        const pe = pattern.elt(p, i)
        const object = pattern.eltObject(pe)
        if pattern.findElt(font, object) == 0 && object != objects.FAMILYLANG && object != objects.STYLELANG && object != objects.FULLNAMELANG {
            _ = pattern.listAdd(result, object, value.duplicateList(pattern.eltValues(pe)), false)
        }
        i += 1
    }
    if variable == 1 && variations.length > 0 {
        var vars: usize = 0
        if pattern.getString(result, objects.FONT_VARIATIONS, 0, &vars) == pattern.RESULT_MATCH {
            _ = mem.appendByte(&variations, 44)
            _ = mem.appendC(&variations, vars)
            _ = pattern.del(result, objects.FONT_VARIATIONS)
        }
        _ = pattern.addString(result, objects.FONT_VARIATIONS, variations.address)
    }
    mem.freeBuffer(&variations)
    _ = config.substituteWithPat(c, result, p, config.MATCH_FONT)
    return result
}

// A node put at the start of a list (`first`) or at its end.
fn place(list: usize, node: usize, first: bool) -> usize {
    if node == 0 { return list }
    if first {
        value.setNext(node, list)
        return node
    }
    const tail = value.last(list)
    if tail == 0 { return node }
    value.setNext(tail, node)
    return list
}

// The system's and the application's fonts of a configuration (an array
// of two words) for matching.
fn fontSetsOf(c: usize, sets: usize) -> usize {
    var n: usize = 0
    var k: i64 = 0
    while k < 2 {
        const fs = config.fonts(c, k)
        if fs != 0 {
            mem.putWord(sets + n * 8, fs)
            n += 1
        }
        k += 1
    }
    return n
}

// FcFontSetMatch: the best font of the sets, prepared for rendering; 0
// when there is none (`result` says why).
pub fn fontSetMatch(c: usize, sets: usize, nsets: usize, p: usize, result: *i64) -> usize {
    result.* = pattern.RESULT_NO_MATCH
    const best = bestOf(sets, nsets, p)
    if best == 0 { return 0 }
    result.* = pattern.RESULT_MATCH
    const prepared = renderPrepare(c, p, best)
    pattern.destroy(best)
    return prepared
}

// FcFontMatch: the best of the configuration's fonts.
pub fn fontMatch(c: usize, p: usize, result: *i64) -> usize {
    const sets = mem.alloc(16)
    const n = fontSetsOf(c, sets)
    const matched = fontSetMatch(c, sets, n, p, result)
    mem.free(sets)
    return matched
}

// ---------------------------------------------------------------------------
// Sorting.

// Nodes: a font and its scores (PRI_END doubles).
fn nodeScore(node: usize, i: usize) -> f64 { return mem.getF64(node + 8 + i * 8) }

fn nodeLess(a: usize, b: usize) -> bool {
    var i: usize = 0
    while i < PRI_END {
        const x = nodeScore(a, i)
        const y = nodeScore(b, i)
        if x != y { return x < y }
        i += 1
    }
    return false
}

// A stable merge sort of `n` node addresses at `items` (glibc's qsort,
// which Fontconfig's sort uses, is a merge sort).
fn sortNodes(items: usize, n: usize) -> void {
    if n < 2 { return }
    const scratch = mem.alloc(n * 8)
    var width: usize = 1
    while width < n {
        var start: usize = 0
        while start < n {
            const middle = if start + width < n { start + width } else { n }
            const end = if start + 2 * width < n { start + 2 * width } else { n }
            var i = start
            var j = middle
            var k = start
            while i < middle && j < end {
                if nodeLess(mem.getWord(items + j * 8), mem.getWord(items + i * 8)) {
                    mem.putWord(scratch + k * 8, mem.getWord(items + j * 8))
                    j += 1
                } else {
                    mem.putWord(scratch + k * 8, mem.getWord(items + i * 8))
                    i += 1
                }
                k += 1
            }
            while i < middle {
                mem.putWord(scratch + k * 8, mem.getWord(items + i * 8))
                i += 1
                k += 1
            }
            while j < end {
                mem.putWord(scratch + k * 8, mem.getWord(items + j * 8))
                j += 1
                k += 1
            }
            start += 2 * width
        }
        mem.copy(items, scratch, n * 8)
        width = width * 2
    }
    mem.free(scratch)
}

// FcFontSetSort: the fonts of the sets in order of their scores, those
// covering none of the pattern's languages after those that do; with
// `trim`, a font adding no characters to those before it left out. The
// union of their characters into `csp` when it is not 0.
pub fn fontSetSort(sets: usize, nsets: usize, p: usize, trim: bool, csp: usize, result: *i64) -> usize {
    result.* = pattern.RESULT_NO_MATCH
    var total: usize = 0
    var s: usize = 0
    while s < nsets {
        total += pattern.fontSetCount(mem.getWord(sets + s * 8))
        s += 1
    }
    const ret = pattern.fontSetCreate()
    if total == 0 { return ret }
    const nodeSize = 8 + PRI_END * 8
    const nodes = mem.alloc(total * nodeSize)
    const order = mem.alloc(total * 8)
    var f = familiesOf(p)
    var n: usize = 0
    s = 0
    var ok = true
    while s < nsets && ok {
        const fs = mem.getWord(sets + s * 8)
        var k: usize = 0
        while fs != 0 && k < pattern.fontSetCount(fs) {
            const node = nodes + n * nodeSize
            mem.putWord(node, pattern.fontSetFont(fs, k))
            if !compare(p, pattern.fontSetFont(fs, k), node + 8, &f) {
                ok = false
                break
            }
            mem.putWord(order + n * 8, node)
            n += 1
            k += 1
        }
        s += 1
    }
    mem.free(f.table)
    if !ok {
        mem.free(nodes)
        mem.free(order)
        pattern.fontSetDestroy(ret)
        return 0
    }
    sortNodes(order, n)
    // The pattern's languages each satisfied by the first font covering
    // it; the others' language score made worst.
    const langs = pattern.values(p, objects.LANG)
    const nlangs = value.listLength(langs)
    const satisfied = mem.alloc(nlangs + 1)
    var i: usize = 0
    while i < n {
        const node = mem.getWord(order + i * 8)
        var satisfies = false
        if nodeScore(node, PRI_LANG) < 2000.0 {
            var nodeLang: usize = 0
            const hasLang = pattern.get(mem.getWord(node), objects.LANG, 0, &nodeLang) == pattern.RESULT_MATCH
            var l = langs
            var li: usize = 0
            while l != 0 && hasLang {
                if mem.get8(satisfied + li) == 0 {
                    const c = compareValues(CMP_LANG, value.valueOf(l), nodeLang)
                    if c.distance >= 0.0 && c.distance < 2.0 {
                        mem.put8(satisfied + li, 1)
                        satisfies = true
                        break
                    }
                }
                li += 1
                l = value.next(l)
            }
        }
        if !satisfies { mem.putF64(node + 8 + PRI_LANG * 8, 10000.0) }
        i += 1
    }
    mem.free(satisfied)
    sortNodes(order, n)
    // FcSortWalk.
    var cs: usize = 0
    if trim || csp != 0 { cs = charset.create() }
    i = 0
    while i < n {
        const node = mem.getWord(order + i * 8)
        const font = mem.getWord(node)
        var adds = false
        var skip = false
        if cs != 0 {
            var ncs: usize = 0
            if pattern.getPointer(font, objects.CHARSET, 0, objects.TYPE_CHARSET, &ncs) != pattern.RESULT_MATCH {
                skip = true
            } else {
                _ = charset.merge(cs, ncs, &adds)
            }
        }
        if !skip && (i == 0 || !trim || adds) {
            pattern.reference(font)
            _ = pattern.fontSetAdd(ret, font)
        }
        i += 1
    }
    if csp != 0 {
        mem.putWord(csp, cs)
    } else {
        charset.destroy(cs)
    }
    mem.free(nodes)
    mem.free(order)
    if pattern.fontSetCount(ret) > 0 { result.* = pattern.RESULT_MATCH }
    return ret
}

// FcFontSort: the configuration's fonts sorted.
pub fn fontSort(c: usize, p: usize, trim: bool, csp: usize, result: *i64) -> usize {
    const sets = mem.alloc(16)
    const n = fontSetsOf(c, sets)
    const sorted = fontSetSort(sets, n, p, trim, csp, result)
    mem.free(sets)
    return sorted
}

// ---------------------------------------------------------------------------
// Listing.

fn listValueHash(v: usize) -> u64 {
    const t = value.typeOf(v)
    if t == objects.TYPE_INTEGER || t == objects.TYPE_BOOL { return @bitCast(u64, value.intOf(v)) & 0xffffffff }
    if t == objects.TYPE_DOUBLE { return @bitCast(u64, pattern.truncate(value.doubleOf(v))) & 0xffffffff }
    if t == objects.TYPE_STRING { return strings.hashIgnoreCase(value.pointerOf(v)) }
    if t == objects.TYPE_MATRIX {
        const m = value.pointerOf(v)
        var h: u64 = 0
        var k: usize = 0
        while k < 4 {
            h ^= @bitCast(u64, pattern.truncate(mem.getF64(m + k * 8) * 100.0)) & 0xffffffff
            k += 1
        }
        return h
    }
    if t == objects.TYPE_CHARSET { return charset.count(value.pointerOf(v)) & 0xffffffff }
    if t == objects.TYPE_LANGSET { return lang.hash(value.pointerOf(v)) }
    if t == objects.TYPE_RANGE { return value.rangeHash(value.pointerOf(v)) }
    return 0
}

fn listPatternHash(font: usize, os: usize) -> u64 {
    var h: u64 = 0
    var i: usize = 0
    while i < pattern.objectSetCount(os) {
        const e = pattern.findElt(font, objects.fromName(pattern.objectSetName(os, i)))
        if e != 0 {
            var l = pattern.eltValues(e)
            var lh: u64 = 0
            while l != 0 {
                lh ^= listValueHash(value.valueOf(l))
                l = value.next(l)
            }
            h ^= lh
        }
        i += 1
    }
    return h & 0xffffffff
}

fn listValueListEqual(a: usize, b: usize) -> bool {
    var v1 = a
    while v1 != 0 {
        var v2 = b
        while v2 != 0 {
            if value.equal(value.valueOf(v1), value.valueOf(v2)) { break }
            v2 = value.next(v2)
        }
        if v2 == 0 { return false }
        v1 = value.next(v1)
    }
    var v2 = b
    while v2 != 0 {
        var w = a
        while w != 0 {
            if value.equal(value.valueOf(w), value.valueOf(v2)) { break }
            w = value.next(w)
        }
        if w == 0 { return false }
        v2 = value.next(v2)
    }
    return true
}

fn listPatternEqual(a: usize, b: usize, os: usize) -> bool {
    var i: usize = 0
    while i < pattern.objectSetCount(os) {
        const object = objects.fromName(pattern.objectSetName(os, i))
        const e1 = pattern.findElt(a, object)
        const e2 = pattern.findElt(b, object)
        if e1 != 0 || e2 != 0 {
            if e1 == 0 || e2 == 0 { return false }
            if !listValueListEqual(pattern.eltValues(e1), pattern.eltValues(e2)) { return false }
        }
        i += 1
    }
    return true
}

// FcGetDefaultObjectLangIndex: the value of a name in `lang` (or the same
// language), else the English one, else the first.
fn defaultLangIndex(font: usize, object: i64, langName: usize) -> usize {
    var idx: i64 = -1
    var defidx: i64 = -1
    var l = pattern.values(font, object)
    var i: i64 = 0
    const en = mem.dupText("en")
    while l != 0 {
        const v = value.valueOf(l)
        if value.typeOf(v) == objects.TYPE_STRING {
            const res = lang.compare(value.pointerOf(v), langName)
            if res == lang.EQUAL {
                mem.free(en)
                return @intCast(usize, i)
            }
            if res == lang.DIFFERENT_COUNTRY && idx < 0 { idx = i }
            if defidx < 0 && lang.compare(value.pointerOf(v), en) == lang.EQUAL { defidx = i }
        }
        i += 1
        l = value.next(l)
    }
    mem.free(en)
    if idx > 0 { return @intCast(usize, idx) }
    if defidx > 0 { return @intCast(usize, defidx) }
    return 0
}

const LIST_HASH_SIZE: u64 = 4099

// FcFontSetList: the fonts of the sets matching every element of `p`,
// each as a pattern of the objects of `os` (all the built-in ones when
// `os` is 0), patterns alike given once; in the order of Fontconfig's
// hash table (its buckets, then the order they were added).
pub fn fontSetList(sets: usize, nsets: usize, p: usize, os0: usize) -> usize {
    var os = os0
    if os == 0 {
        os = pattern.objectSetCreate()
        var id: i64 = 1
        while id <= objects.MAX_BASE {
            _ = pattern.objectSetAdd(os, objects.name(id))
            id += 1
        }
    }
    // Buckets: the first and last entries of a chain; an entry: the next,
    // its hash, its pattern.
    const buckets = mem.alloc(@intCast(usize, LIST_HASH_SIZE) * 16)
    var langName = pattern.firstString(p, objects.NAMELANG)
    if langName == 0 { langName = lang.defaultLang() }
    var s: usize = 0
    while s < nsets {
        const fs = mem.getWord(sets + s * 8)
        var k: usize = 0
        while fs != 0 && k < pattern.fontSetCount(fs) {
            const font = pattern.fontSetFont(fs, k)
            if config.listPatternMatchAny(p, font) { listAppend(buckets, font, os, langName) }
            k += 1
        }
        s += 1
    }
    const ret = pattern.fontSetCreate()
    var b: u64 = 0
    while b < LIST_HASH_SIZE {
        var entry = mem.getWord(buckets + @intCast(usize, b) * 16)
        while entry != 0 {
            _ = pattern.fontSetAdd(ret, mem.getWord(entry + 16))
            const following = mem.getWord(entry)
            mem.free(entry)
            entry = following
        }
        b += 1
    }
    mem.free(buckets)
    if os0 == 0 { pattern.objectSetDestroy(os) }
    return ret
}

fn listAppend(buckets: usize, font: usize, os: usize, langName: usize) -> void {
    const h = listPatternHash(font, os)
    const bucket = buckets + @intCast(usize, h % LIST_HASH_SIZE) * 16
    var entry = mem.getWord(bucket)
    while entry != 0 {
        if mem.get64(entry + 8) == h && listPatternEqual(mem.getWord(entry + 16), font, os) { return }
        entry = mem.getWord(entry)
    }
    const p = pattern.create()
    var familyIdx: i64 = -1
    var fullnameIdx: i64 = -1
    var styleIdx: i64 = -1
    var i: usize = 0
    while i < pattern.objectSetCount(os) {
        const name = pattern.objectSetName(os, i)
        var defidx: usize = 0
        if mem.cIs(name, "family") || mem.cIs(name, "familylang") {
            if familyIdx < 0 { familyIdx = @intCast(i64, defaultLangIndex(font, objects.FAMILYLANG, langName)) }
            defidx = @intCast(usize, familyIdx)
        } else if mem.cIs(name, "fullname") || mem.cIs(name, "fullnamelang") {
            if fullnameIdx < 0 { fullnameIdx = @intCast(i64, defaultLangIndex(font, objects.FULLNAMELANG, langName)) }
            defidx = @intCast(usize, fullnameIdx)
        } else if mem.cIs(name, "style") || mem.cIs(name, "stylelang") {
            if styleIdx < 0 { styleIdx = @intCast(i64, defaultLangIndex(font, objects.STYLELANG, langName)) }
            defidx = @intCast(usize, styleIdx)
        }
        const object = objects.fromName(name)
        const e = pattern.findElt(font, object)
        if e != 0 {
            var l = pattern.eltValues(e)
            var idx: usize = 0
            while l != 0 {
                _ = pattern.add(p, object, value.typeOf(value.valueOf(l)), value.wordOf(value.valueOf(l)), defidx != idx)
                idx += 1
                l = value.next(l)
            }
        }
        i += 1
    }
    const fresh = mem.alloc(24)
    mem.put64(fresh + 8, h)
    mem.putWord(fresh + 16, p)
    // (At the end of the bucket's chain.)
    if mem.getWord(bucket) == 0 {
        mem.putWord(bucket, fresh)
    } else {
        mem.putWord(mem.getWord(bucket + 8), fresh)
    }
    mem.putWord(bucket + 8, fresh)
}

// FcFontList: the configuration's fonts listed.
pub fn fontList(c: usize, p: usize, os: usize) -> usize {
    const sets = mem.alloc(16)
    const n = fontSetsOf(c, sets)
    const listed = fontSetList(sets, n, p, os)
    mem.free(sets)
    return listed
}
