// std.fontconfig.scan: font files read into patterns, as Fontconfig's
// FcFreeTypeQuery reads them through FreeType, here through std.truetype's
// engine (the same reading as FreeType's): every face of a collection,
// every named instance of a variable font and the variable font itself;
// the families, styles and full names of the `name` table in every
// language it has them in (the preferred names first: Microsoft's
// platform, then Unicode's, Macintosh's, ISO's; the WWS and typographic
// names before the legacy ones), the PostScript name, the foundry (OS/2's
// vendor, else a notice's), weight, width and slant (OS/2's classes, else
// the style's words, else the face's flags), the characters (the Unicode
// charmap, or the symbol one), the languages they cover, the spacing (the
// advances of the characters' glyphs), the OpenType scripts, the optical
// sizes, the format.
//
// What the engine does not read is not found: Type 1 fonts (.pfb, .pfa)
// and bitmap fonts (PCF, BDF) give no patterns. Names in the legacy CJK
// encodings (Shift-JIS, GB18030, Big5, Wansung, Johab: Fontconfig converts
// them with iconv) are read as UTF-16, as Fontconfig reads them when iconv
// fails on them.
const mem = @import("./mem.mlx")
const strings = @import("./strings.mlx")
const strset = @import("./strset.mlx")
const charset = @import("./charset.mlx")
const lang = @import("./lang.mlx")
const objects = @import("./objects.mlx")
const value = @import("./value.mlx")
const pattern = @import("./pattern.mlx")
const tables = @import("./scantables.mlx")
const tt = @import("../truetype.mlx")
const fs = @import("../../bootstrap/fs.mlx")

const r = tt.records
const o = tt.objects

const PLATFORM_APPLE_UNICODE: u64 = 0
const PLATFORM_MACINTOSH: u64 = 1
const PLATFORM_ISO: u64 = 2
const PLATFORM_MICROSOFT: u64 = 3

const NAME_FONT_FAMILY: u64 = 1
const NAME_FONT_SUBFAMILY: u64 = 2
const NAME_FULL_NAME: u64 = 4
const NAME_TRADEMARK: u64 = 7
const NAME_MANUFACTURER: u64 = 8
const NAME_TYPOGRAPHIC_FAMILY: u64 = 16
const NAME_TYPOGRAPHIC_SUBFAMILY: u64 = 17
const NAME_MAC_FULL_NAME: u64 = 18
const NAME_WWS_FAMILY: u64 = 21
const NAME_WWS_SUBFAMILY: u64 = 22

const SFNT_HEAD: i32 = 0
const SFNT_OS2: i32 = 2

// The engine of a scan (one library for the fonts read), and scratch
// words for the engine's results (the glyph of a character, an advance, a
// name record, a variation record, a PostScript font information record).
pub const Scanner = struct {
    engine: usize
    scratch: usize
}

const SCRATCH_GLYPH: usize = 0
const SCRATCH_ADVANCE: usize = 8
const SCRATCH_NAME: usize = 16
const SCRATCH_MMVAR: usize = 48
const SCRATCH_PSINFO: usize = 64
const SCRATCH_SIZE: usize = 160

pub fn initScanner(s: *Scanner) -> bool {
    s.*.engine = mem.alloc(@sizeOf(tt.Engine))
    s.*.scratch = mem.alloc(SCRATCH_SIZE)
    if s.*.engine == 0 || s.*.scratch == 0 { return false }
    tt.initEngine(unsafe { @ptrFromInt(*tt.Engine, s.*.engine) }, mem.allocator())
    return true
}

pub fn doneScanner(s: *Scanner) -> void {
    mem.free(s.*.engine)
    mem.free(s.*.scratch)
}

fn library(s: *Scanner) -> usize { return tt.libraryOf(unsafe { @ptrFromInt(*tt.Engine, s.*.engine) }) }

// The face `index` of the file (its named instance in the high 16 bits),
// 0 when it cannot be read.
fn openFace(s: *Scanner, file: usize, index: i64) -> usize {
    const opened = tt.faces.newFace(library(s), tt.faces.SOURCE_PATH, 0, 0, file)
    if opened.0 != r.OK { return 0 }
    if tt.faces.openFace(opened.1, index, 0, 2) != r.OK { return 0 }
    return opened.1
}

fn faceOf(face: usize) -> *o.Face { return o.faceRecord(face) }

// ---------------------------------------------------------------------------
// Names.

// A name of the `name` table: platform, encoding, language, name ID, its
// bytes and their number (FT_SfntName), into the scratch record.
fn sfntName(s: *Scanner, face: usize, index: u64) -> bool {
    return tt.info.sfntName(face, @intCast(u32, index), s.*.scratch + SCRATCH_NAME) == r.OK
}

fn namePlatform(s: *Scanner) -> u64 { return mem.get16(s.*.scratch + SCRATCH_NAME) }
fn nameEncoding(s: *Scanner) -> u64 { return mem.get16(s.*.scratch + SCRATCH_NAME + 2) }
fn nameLanguage(s: *Scanner) -> u64 { return mem.get16(s.*.scratch + SCRATCH_NAME + 4) }
fn nameId(s: *Scanner) -> u64 { return mem.get16(s.*.scratch + SCRATCH_NAME + 6) }
fn nameBytes(s: *Scanner) -> usize { return mem.getWord(s.*.scratch + SCRATCH_NAME + 8) }
fn nameLength(s: *Scanner) -> usize { return @intCast(usize, mem.get32(s.*.scratch + SCRATCH_NAME + 16)) }

// FcLooksLikeSJIS: more than a third of the bytes with the high bit.
fn looksLikeSjis(bytes: usize, length: usize) -> bool {
    var high: usize = 0
    var low: usize = 0
    var i: usize = 0
    while i < length {
        if (mem.get8(bytes + i) & 0x80) != 0 { high += 1 } else { low += 1 }
        i += 1
    }
    return high * 2 > low
}

// The encodings of names (FcSfntNameTranscode's fromcode).
const CODE_NONE: u64 = 0
const CODE_UTF16BE: u64 = 1
const CODE_MAC_ROMAN: u64 = 2
const CODE_LATIN1: u64 = 3
const CODE_OTHER: u64 = 4

fn encodingOf(platform: u64, encoding: u64) -> u64 {
    if platform == PLATFORM_APPLE_UNICODE { return CODE_UTF16BE }
    if platform == PLATFORM_MACINTOSH {
        if encoding == 0 { return CODE_MAC_ROMAN }
        if encoding == 1 { return CODE_OTHER }
        return CODE_NONE
    }
    if platform == PLATFORM_MICROSOFT {
        if encoding == 0 || encoding == 1 || encoding == 10 { return CODE_UTF16BE }
        if encoding >= 2 && encoding <= 6 { return CODE_OTHER }
        return CODE_NONE
    }
    if platform == PLATFORM_ISO {
        if encoding == 0 || encoding == 2 { return CODE_LATIN1 }
        if encoding == 1 { return CODE_UTF16BE }
    }
    return CODE_NONE
}

fn utf16Name(bytes: usize, length: usize) -> usize {
    var n: i64 = 0
    var width: i64 = 0
    if !strings.utf16Len(bytes, true, @intCast(i64, length), &n, &width) { return 0 }
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    var at = bytes
    var left = @intCast(i64, length)
    while true {
        var c: u64 = 0
        const k = strings.utf16ToUcs4(at, true, &c, left)
        if k <= 0 { break }
        _ = strings.appendUtf8(&b, c)
        at += @intCast(usize, k)
        left -= k
    }
    _ = mem.appendText(&b, "")
    return mem.takeBuffer(&b)
}

// FcSfntNameTranscode: the name in the scratch record as UTF-8 (a new C
// string), 0 when it cannot be read or is blank.
fn transcode(s: *Scanner) -> usize {
    var code = encodingOf(namePlatform(s), nameEncoding(s))
    if code == CODE_NONE { return 0 }
    const bytes = nameBytes(s)
    const length = nameLength(s)
    if code == CODE_MAC_ROMAN {
        const language = nameLanguage(s)
        if language == 0 && looksLikeSjis(bytes, length) {
            code = CODE_OTHER
        } else if language == 11 {
            code = CODE_OTHER
        } else if language >= 0x100 {
            if language == 0x0411 {
                code = CODE_OTHER
            } else if language == 0x0409 {
                code = CODE_LATIN1
            } else {
                return 0
            }
        }
    }
    var result: usize = 0
    if code == CODE_UTF16BE || code == CODE_OTHER {
        // (The legacy CJK encodings read as UTF-16, as Fontconfig does
        // when iconv cannot read them.)
        result = utf16Name(bytes, length)
    } else {
        var b: mem.Buffer = undefined
        mem.initBuffer(&b)
        var i: usize = 0
        while i < length {
            var c = mem.get8(bytes + i)
            if code == CODE_MAC_ROMAN && c >= 128 {
                const at = (c - 128) * 4
                var u: u64 = 0
                var k: usize = 0
                while k < 4 {
                    u = u * 16 + @intCast(u64, mem.hexDigit(@intCast(u64, tables.MAC_ROMAN[@intCast(usize, at) + k])))
                    k += 1
                }
                c = u
            }
            _ = strings.appendUtf8(&b, c)
            i += 1
        }
        _ = mem.appendText(&b, "")
        result = mem.takeBuffer(&b)
    }
    if result == 0 { return 0 }
    const blank = mem.dupText("")
    const isBlank = strings.cmpIgnoreBlanksAndCase(result, blank) == 0
    mem.free(blank)
    if isBlank {
        mem.free(result)
        return 0
    }
    return result
}

// FcSfntNameLanguage: the language of the name in the scratch record (a C
// string of the module's), 0 for none.
var languageNames: usize = 0

fn nameLanguageOf(s: *Scanner) -> usize {
    const platform = namePlatform(s)
    var language = nameLanguage(s)
    if platform == PLATFORM_MACINTOSH && nameEncoding(s) == 0 && looksLikeSjis(nameBytes(s), nameLength(s)) { language = 11 }
    const text = tables.NAME_LANGUAGES
    var at: usize = 0
    var line: usize = 0
    while at < text.length {
        var stop = at
        var p: u64 = 0
        while text[stop] != 32 {
            p = p * 10 + @intCast(u64, text[stop] - 48)
            stop += 1
        }
        stop += 1
        var l: u64 = 0
        while text[stop] != 32 {
            l = l * 10 + @intCast(u64, text[stop] - 48)
            stop += 1
        }
        stop += 1
        const start = stop
        while text[stop] != 10 { stop += 1 }
        if p == platform && (l == 65535 || l == language) {
            if text[start] == 45 { return 0 }
            return languageName(line, text[start..stop])
        }
        at = stop + 1
        line += 1
    }
    return 0
}

// The table's languages as C strings, made once a line.
fn languageName(line: usize, name: []const u8) -> usize {
    if languageNames == 0 { languageNames = mem.alloc(512 * 8) }
    if languageNames == 0 || line >= 512 { return 0 }
    var s = mem.getWord(languageNames + line * 8)
    if s == 0 {
        s = mem.dupText(name)
        mem.putWord(languageNames + line * 8, s)
    }
    return s
}

// FcNoticeFoundry: the foundry a notice names, 0 for none.
fn noticeFoundry(notice: usize) -> []const u8 {
    if notice == 0 { return "" }
    const text = tables.NOTICE_FOUNDRIES
    var at: usize = 0
    while at < text.length {
        var bar = at
        while text[bar] != 124 { bar += 1 }
        var stop = bar
        while text[stop] != 10 { stop += 1 }
        const word = mem.dupText(text[at..bar])
        const found = strings.str(notice, word) != 0
        mem.free(word)
        if found { return text[bar + 1..stop] }
        at = stop + 1
    }
    return ""
}

// ---------------------------------------------------------------------------
// Words of styles.

fn isConst(s: usize, words: []const u8, values: []const i64) -> i64 {
    var at: usize = 0
    var k: usize = 0
    while at < words.length {
        var stop = at
        while stop < words.length && words[stop] != 32 { stop += 1 }
        const w = mem.dupText(words[at..stop])
        const same = strings.cmpIgnoreBlanksAndCase(s, w) == 0
        mem.free(w)
        if same { return values[k] }
        k += 1
        at = stop + 1
    }
    return -1
}

// FcStringContainsConst: the value of the first word of the list in `s`
// (ignoring blanks and case; a word after `<` only as a word of its own).
fn containsConst(s: usize, words: []const u8, values: []const i64) -> i64 {
    var at: usize = 0
    var k: usize = 0
    while at < words.length {
        var stop = at
        while stop < words.length && words[stop] != 32 { stop += 1 }
        var found = false
        if words[at] == 60 {
            const w = mem.dupText(words[at + 1..stop])
            found = strings.containsWord(s, w)
            mem.free(w)
        } else {
            const w = mem.dupText(words[at..stop])
            found = strings.containsIgnoreBlanksAndCase(s, w)
            mem.free(w)
        }
        if found { return values[k] }
        k += 1
        at = stop + 1
    }
    return -1
}

const WEIGHT_WORDS = "thin extralight ultralight demilight semilight light book regular normal medium demibold demi semibold extrabold superbold ultrabold bold ultrablack superblack extrablack <ultra black heavy"
const WEIGHT_VALUES = [23]i64{ 0, 40, 40, 55, 55, 50, 75, 80, 80, 100, 180, 180, 180, 205, 205, 205, 200, 215, 215, 215, 205, 210, 210 }
const WIDTH_WORDS = "ultracondensed extracondensed semicondensed condensed normal semiexpanded extraexpanded ultraexpanded expanded extended"
const WIDTH_VALUES = [10]i64{ 50, 63, 87, 75, 100, 113, 150, 200, 125, 125 }
const SLANT_WORDS = "italic kursiv oblique"
const SLANT_VALUES = [3]i64{ 100, 100, 110 }
const DECORATIVE_WORDS = "shadow caps antiqua romansc embosed dunhill"
const DECORATIVE_VALUES = [6]i64{ 1, 1, 1, 1, 1, 1 }

// ---------------------------------------------------------------------------
// The charset and the spacing.

fn selectCharmap(face: usize, symbol: bool) -> bool {
    return tt.info.selectCharmap(face, if symbol { r.ENCODING_MS_SYMBOL } else { r.ENCODING_UNICODE }) == r.OK
}

// FcFreeTypeCharSet: the characters of the Unicode charmap (else the
// symbol one: then also U+F000..F0FF at U+0000..00FF) that have glyphs;
// control characters only when their glyph has contours.
fn charSetOf(s: *Scanner, face: usize) -> usize {
    const cs = charset.create()
    if cs == 0 { return 0 }
    const flags = r.LOAD_IGNORE_GLOBAL_ADVANCE_WIDTH | r.LOAD_NO_SCALE | r.LOAD_NO_HINTING
    const glyphAt = s.*.scratch + SCRATCH_GLYPH
    var k: usize = 0
    while k < 2 {
        const symbol = k == 1
        if !selectCharmap(face, symbol) {
            k += 1
            continue
        }
        var ucs4 = tt.info.firstChar(face, glyphAt)
        while mem.get32(glyphAt) != 0 {
            var good = true
            if ucs4 <= 0x1F {
                const glyph = mem.get32(glyphAt)
                if tt.load.loadGlyph(face, @intCast(i64, glyph), flags) != r.OK {
                    good = false
                } else {
                    const slot = o.slotRecord(faceOf(face).*.glyph)
                    if slot.*.format == r.FORMAT_OUTLINE && slot.*.outline.nContours == 0 { good = false }
                }
            }
            if good { _ = charset.addChar(cs, ucs4) }
            ucs4 = tt.info.nextChar(face, ucs4, glyphAt)
        }
        if symbol {
            var c: u64 = 0xF000
            while c < 0xF100 {
                if charset.hasChar(cs, c) { _ = charset.addChar(cs, c - 0xF000) }
                c += 1
            }
        }
        break
    }
    return cs
}

fn approximatelyEqual(x: i64, y: i64) -> bool {
    const ax = if x < 0 { 0 - x } else { x }
    const ay = if y < 0 { 0 - y } else { y }
    const d = if x > y { x - y } else { y - x }
    return d * 33 <= (if ax > ay { ax } else { ay })
}

// FcFreeTypeSpacing: mono when the glyphs of the characters have one
// advance (of up to three different ones looked at), dual when two, one
// twice the other, else proportional.
fn spacingOf(s: *Scanner, face: usize) -> i64 {
    var flags = r.LOAD_IGNORE_GLOBAL_ADVANCE_WIDTH | r.LOAD_NO_SCALE | r.LOAD_NO_HINTING
    const f = faceOf(face)
    if (f.*.faceFlags & r.FACE_SCALABLE) != 0 { flags |= r.LOAD_NO_BITMAP }
    if (f.*.faceFlags & r.FACE_SCALABLE) == 0 && f.*.numFixedSizes > 0 && tt.info.sfntTable(face, SFNT_HEAD) != 0 {
        var strike: i64 = 0
        var i: i64 = 1
        while i < @intCast(i64, f.*.numFixedSizes) {
            const h = sizeHeight(f, i)
            const best = sizeHeight(f, strike)
            if absolute(h - 16) < absolute(best - 16) { strike = i }
            i += 1
        }
        _ = tt.faces.selectSize(face, @intCast(i32, strike))
    }
    var advances: [3]i64 = [3]i64{ 0, 0, 0 }
    var count: usize = 0
    const glyphAt = s.*.scratch + SCRATCH_GLYPH
    const advanceAt = s.*.scratch + SCRATCH_ADVANCE
    var k: usize = 0
    while k < 2 {
        if !selectCharmap(face, k == 1) {
            k += 1
            continue
        }
        var ucs4 = tt.info.firstChar(face, glyphAt)
        while mem.get32(glyphAt) != 0 && count < 3 {
            mem.put64(advanceAt, 0)
            const glyph = mem.get32(glyphAt)
            if tt.load.getAdvances(face, @intCast(i64, glyph), 1, flags, advanceAt) == r.OK {
                const advance = @bitCast(i64, mem.get64(advanceAt))
                if advance != 0 {
                    var j: usize = 0
                    while j < count {
                        if approximatelyEqual(advance, advances[j]) { break }
                        j += 1
                    }
                    if j == count {
                        advances[count] = advance
                        count += 1
                    }
                }
            }
            ucs4 = tt.info.nextChar(face, ucs4, glyphAt)
        }
        break
    }
    if count <= 1 { return 100 }
    if count == 2 {
        const small = if advances[0] < advances[1] { advances[0] } else { advances[1] }
        const large = if advances[0] < advances[1] { advances[1] } else { advances[0] }
        if approximatelyEqual(small * 2, large) { return 90 }
    }
    return 0
}

fn absolute(x: i64) -> i64 { return if x < 0 { 0 - x } else { x } }

fn sizeHeight(f: *o.Face, i: i64) -> i64 { return @intCast(i64, @bitCast(i16, @intCast(u16, mem.get16(f.*.availableSizes + @intCast(usize, i) * @sizeOf(r.BitmapSize))))) }

// ---------------------------------------------------------------------------
// OpenType layout scripts (FcFontCapabilities).

fn tableOf(face: usize, tag: u32) -> (u64, u64) { return tt.table(face, tag) }

// The script tags of GSUB or GPOS, sorted, at `out` (32-bit each); their
// number.
fn scriptTags(face: usize, tag: u32, out: usize, room: usize) -> usize {
    const t = tableOf(face, tag)
    if t.1 == 0 { return 0 }
    const data = @intFromPtr(tt.fontData(face))
    const size = @intCast(u64, tt.fontSize(face))
    const base = t.0
    if base + 6 > size { return 0 }
    const list = base + mem.get16be(data + @intCast(usize, base) + 4)
    if list + 2 > size { return 0 }
    const count = mem.get16be(data + @intCast(usize, list))
    var n: usize = 0
    var i: u64 = 0
    while i < count && n < room {
        const record = list + 2 + i * 6
        if record + 6 > size { break }
        const scriptTag = mem.get32be(data + @intCast(usize, record))
        const offset = list + mem.get16be(data + @intCast(usize, record) + 4)
        // (A script whose table is beyond the file is passed over, as the
        // stream refuses to seek there.)
        if offset <= size {
            mem.put32(out + n * 4, scriptTag)
            n += 1
        }
        i += 1
    }
    // (Sorted.)
    var a: usize = 1
    while a < n {
        const v = mem.get32(out + a * 4)
        var b = a
        while b > 0 && mem.get32(out + (b - 1) * 4) > v {
            mem.put32(out + b * 4, mem.get32(out + (b - 1) * 4))
            b -= 1
        }
        mem.put32(out + b * 4, v)
        a += 1
    }
    return n
}

fn validScript(c: u64) -> bool { return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 32 }

fn addTag(b: *mem.Buffer, tag: u64) -> void {
    const c0 = (tag >> 24) & 255
    const c1 = (tag >> 16) & 255
    const c2 = (tag >> 8) & 255
    const c3 = tag & 255
    if !validScript(c0) || !validScript(c1) || !validScript(c2) || !validScript(c3) { return }
    if b.*.length > 0 { _ = mem.appendByte(b, 32) }
    _ = mem.appendText(b, "otlayout:")
    _ = mem.appendByte(b, c0)
    _ = mem.appendByte(b, c1)
    _ = mem.appendByte(b, c2)
    _ = mem.appendByte(b, c3)
}

fn capabilities(face: usize) -> usize {
    const silf = tableOf(face, 0x53696C66).1 != 0
    const room: usize = 512
    const gpos = mem.alloc(room * 4)
    const gsub = mem.alloc(room * 4)
    const gposCount = scriptTags(face, 0x47504F53, gpos, room)
    const gsubCount = scriptTags(face, 0x47535542, gsub, room)
    var result: usize = 0
    if silf || gsubCount != 0 || gposCount != 0 {
        var b: mem.Buffer = undefined
        mem.initBuffer(&b)
        if silf { _ = mem.appendText(&b, "ttable:Silf ") }
        var i: usize = 0
        var j: usize = 0
        while i < gsubCount || j < gposCount {
            if i == gsubCount {
                addTag(&b, mem.get32(gpos + j * 4))
                j += 1
            } else if j == gposCount || mem.get32(gsub + i * 4) < mem.get32(gpos + j * 4) {
                addTag(&b, mem.get32(gsub + i * 4))
                i += 1
            } else if mem.get32(gsub + i * 4) == mem.get32(gpos + j * 4) {
                addTag(&b, mem.get32(gsub + i * 4))
                i += 1
                j += 1
            } else {
                addTag(&b, mem.get32(gpos + j * 4))
                j += 1
            }
        }
        _ = mem.appendText(&b, "")
        result = mem.takeBuffer(&b)
    }
    mem.free(gpos)
    mem.free(gsub)
    return result
}

// ---------------------------------------------------------------------------
// The query.

// The `name` table's records in Fontconfig's order: by platform, name ID,
// encoding, then English first, then language, then their order (words:
// platform, name ID, encoding, language, index; -1 for one unread).
fn nameMapping(s: *Scanner, face: usize, count: usize) -> usize {
    const map = mem.alloc(count * 40 + 8)
    if map == 0 { return 0 }
    var i: usize = 0
    while i < count {
        const at = map + i * 40
        if sfntName(s, face, @intCast(u64, i)) {
            mem.put64(at, namePlatform(s))
            mem.put64(at + 8, nameId(s))
            mem.put64(at + 16, nameEncoding(s))
            mem.put64(at + 24, nameLanguage(s))
            mem.put64(at + 32, @intCast(u64, i))
        } else {
            var k: usize = 0
            while k < 5 {
                mem.put64(at + k * 8, 0xffffffff)
                k += 1
            }
        }
        i += 1
    }
    // (Insertion sort with Fontconfig's comparison: stable, and every
    // record differs in its index.)
    i = 1
    const tmp = mem.alloc(40)
    while i < count {
        mem.copy(tmp, map + i * 40, 40)
        var j = i
        while j > 0 && mappingLess(tmp, map + (j - 1) * 40) {
            mem.copy(map + j * 40, map + (j - 1) * 40, 40)
            j -= 1
        }
        mem.copy(map + j * 40, tmp, 40)
        i += 1
    }
    mem.free(tmp)
    return map
}

fn isEnglish(platform: u64, language: u64) -> bool {
    if platform == PLATFORM_MACINTOSH { return language == 0 }
    if platform == PLATFORM_MICROSOFT { return language == 0x0409 }
    return false
}

fn mappingLess(a: usize, b: usize) -> bool {
    var k: usize = 0
    while k < 3 {
        if mem.get64(a + k * 8) != mem.get64(b + k * 8) { return mem.get64(a + k * 8) < mem.get64(b + k * 8) }
        k += 1
    }
    const la = mem.get64(a + 24)
    const lb = mem.get64(b + 24)
    if la != lb {
        if isEnglish(mem.get64(a), la) { return true }
        if isEnglish(mem.get64(b), lb) { return false }
        return la < lb
    }
    return mem.get64(a + 32) < mem.get64(b + 32)
}

// Whether a string of `object` in the pattern equals `s` ignoring blanks
// and case (FcStringInPatternElement).
fn inElement(p: usize, object: i64, s: usize) -> bool {
    var l = pattern.values(p, object)
    while l != 0 {
        const v = value.valueOf(l)
        if value.typeOf(v) != objects.TYPE_STRING { break }
        if strings.cmpIgnoreBlanksAndCase(value.pointerOf(v), s) == 0 { return true }
        l = value.next(l)
    }
    return false
}

// Spaces taken off a C string's ends, in place.
fn trimSpaces(s: usize) -> void {
    var start: usize = 0
    while mem.get8(s + start) == 32 { start += 1 }
    const n = mem.cLength(s + start)
    mem.copy(s, s + start, n + 1)
    var end = n
    while end > 0 && mem.get8(s + end - 1) == 32 { end -= 1 }
    mem.put8(s + end, 0)
}

// The variation record of a face (FT_MM_Var: the number of axes and of
// named instances, the axes and instances), 0 when it has none.
fn mmVar(s: *Scanner, face: usize) -> usize {
    if (faceOf(face).*.faceFlags & r.FACE_MULTIPLE_MASTERS) == 0 { return 0 }
    mem.putWord(s.*.scratch + SCRATCH_MMVAR, 0)
    if tt.variations.getMMVarRecord(face, s.*.scratch + SCRATCH_MMVAR) != r.OK { return 0 }
    return mem.getWord(s.*.scratch + SCRATCH_MMVAR)
}

fn doneMMVar(s: *Scanner, mm: usize) -> void {
    if mm != 0 { tt.memory.release(mem.getWord(library(s)), mm) }
}

fn mmAxes(mm: usize) -> u64 { return mem.get32(mm) }
fn mmNamedStyles(mm: usize) -> u64 { return mem.get32(mm + 8) }
fn mmAxis(mm: usize, i: u64) -> usize { return mem.getWord(mm + 16) + @intCast(usize, i) * 48 }
fn axisMinimum(a: usize) -> f64 { return @floatFromInt(f64, @bitCast(i64, mem.get64(a + 8))) / 65536.0 }
fn axisDefault(a: usize) -> f64 { return @floatFromInt(f64, @bitCast(i64, mem.get64(a + 16))) / 65536.0 }
fn axisMaximum(a: usize) -> f64 { return @floatFromInt(f64, @bitCast(i64, mem.get64(a + 24))) / 65536.0 }
fn axisTag(a: usize) -> u64 { return mem.get64(a + 32) }
fn mmStyle(mm: usize, i: u64) -> usize { return mem.getWord(mm + 24) + @intCast(usize, i) * 16 }
fn styleCoord(style: usize, axis: u64) -> i64 { return @bitCast(i64, mem.get64(mem.getWord(style) + @intCast(usize, axis) * 8)) }
fn styleStrid(style: usize) -> u64 { return mem.get32(style + 8) }

const TAG_WGHT: u64 = 0x77676874
const TAG_WDTH: u64 = 0x77647468
const TAG_OPSZ: u64 = 0x6F70737A

// The shared parts of a face's patterns (its named instances read the
// same characters, languages and names).
pub const Shared = struct {
    cs: usize
    ls: usize
    names: usize
    nameCount: usize
}

fn freeShared(sh: *Shared) -> void {
    charset.destroy(sh.*.cs)
    lang.destroy(sh.*.ls)
    mem.free(sh.*.names)
    sh.*.cs = 0
    sh.*.ls = 0
    sh.*.names = 0
}

// FcFreeTypeQueryFaceInternal: the pattern of the face (its file `file`,
// its id: the face's index, the named instance in the high 16 bits, 0x8000
// for the variable font itself), 0 when it has none.
pub fn queryFace(s: *Scanner, face: usize, file: usize, id: u64, sh: *Shared) -> usize {
    const p = pattern.create()
    if p == 0 { return 0 }
    const f = faceOf(face)
    const hasOutline = (f.*.faceFlags & r.FACE_SCALABLE) != 0
    const hasColor = (f.*.faceFlags & r.FACE_COLOR) != 0
    _ = pattern.addBool(p, objects.OUTLINE, if hasOutline { 1 } else { 0 })
    _ = pattern.addBool(p, objects.COLOR, if hasColor { 1 } else { 0 })
    _ = pattern.addBool(p, objects.SCALABLE, if hasOutline || hasColor { 1 } else { 0 })
    var weight: f64 = -1.0
    var width: f64 = -1.0
    var slant: i64 = -1
    var decorative = false
    var variable = false
    var variableWeight = false
    var variableWidth = false
    var variableSize = false
    var weightMult: f64 = 1.0
    var widthMult: f64 = 1.0
    var instance: usize = 0
    var faceId = id
    const mm = mmVar(s, face)
    if (id >> 16) != 0 {
        if mm == 0 {
            pattern.destroy(p)
            return 0
        }
        if (id >> 16) == 0x8000 {
            var i: u64 = 0
            while i < mmAxes(mm) {
                const a = mmAxis(mm, i)
                var minimum = axisMinimum(a)
                const def = axisDefault(a)
                var maximum = axisMaximum(a)
                i += 1
                if minimum > def || def > maximum || minimum == maximum { continue }
                var object: i64 = 0
                const tag = axisTag(a)
                if tag == TAG_WGHT {
                    object = objects.WEIGHT
                    minimum = objects.weightFromOpenType(minimum)
                    maximum = objects.weightFromOpenType(maximum)
                    variableWeight = true
                    weight = 0.0
                } else if tag == TAG_WDTH {
                    object = objects.WIDTH
                    variableWidth = true
                    width = 0.0
                } else if tag == TAG_OPSZ {
                    object = objects.SIZE
                    variableSize = true
                }
                if object != 0 {
                    _ = pattern.addRange(p, object, minimum, maximum)
                    variable = true
                }
            }
            if !variable {
                doneMMVar(s, mm)
                pattern.destroy(p)
                return 0
            }
            faceId = id & 0xFFFF
        } else if (id >> 16) - 1 < mmNamedStyles(mm) {
            instance = mmStyle(mm, (id >> 16) - 1)
            var i: u64 = 0
            while i < mmAxes(mm) {
                const a = mmAxis(mm, i)
                const v = @floatFromInt(f64, styleCoord(instance, i)) / 65536.0
                const def = axisDefault(a)
                const mult = if def != 0.0 { v / def } else { 1.0 }
                const tag = axisTag(a)
                if tag == TAG_WGHT {
                    weightMult = mult
                } else if tag == TAG_WDTH {
                    widthMult = mult
                } else if tag == TAG_OPSZ {
                    _ = pattern.addDouble(p, objects.SIZE, v)
                }
                i += 1
            }
        } else {
            doneMMVar(s, mm)
            pattern.destroy(p)
            return 0
        }
    } else if mm != 0 {
        var i: u64 = 0
        while i < mmAxes(mm) {
            const a = mmAxis(mm, i)
            if axisTag(a) == TAG_OPSZ {
                _ = pattern.addDouble(p, objects.SIZE, axisDefault(a))
                variableSize = true
            }
            i += 1
        }
    }
    _ = pattern.addBool(p, objects.VARIABLE, if variable { 1 } else { 0 })
    const os2 = tt.info.sfntTable(face, SFNT_OS2)
    var foundry: usize = 0
    var ownFoundry = false
    if os2 != 0 && mem.get16(os2) >= 1 && mem.get16(os2) != 0xffff && mem.get8(os2 + 80) != 0 {
        foundry = mem.dup(os2 + 80, 4)
        ownFoundry = true
    }
    // The names, by platform and by name ID in Fontconfig's orders.
    const nameCount = @intCast(usize, tt.info.sfntNameCount(face))
    if sh.*.names == 0 {
        sh.*.names = nameMapping(s, face, nameCount)
        sh.*.nameCount = nameCount
    }
    const map = sh.*.names
    var nfamily: usize = 0
    var nfamilyLang: usize = 0
    var nstyle: usize = 0
    var nstyleLang: usize = 0
    var nfullname: usize = 0
    var nfullnameLang: usize = 0
    const platforms = [4]u64{ PLATFORM_MICROSOFT, PLATFORM_APPLE_UNICODE, PLATFORM_MACINTOSH, PLATFORM_ISO }
    const nameIds = [10]u64{ NAME_WWS_FAMILY, NAME_TYPOGRAPHIC_FAMILY, NAME_FONT_FAMILY, NAME_MAC_FULL_NAME, NAME_FULL_NAME, NAME_WWS_SUBFAMILY, NAME_TYPOGRAPHIC_SUBFAMILY, NAME_FONT_SUBFAMILY, NAME_TRADEMARK, NAME_MANUFACTURER }
    const und = mem.dupText("und")
    for platform in platforms {
        for nid in nameIds {
            var lookup = nid
            if instance != 0 {
                if nid == NAME_WWS_SUBFAMILY || nid == NAME_TYPOGRAPHIC_SUBFAMILY || nid == NAME_FULL_NAME { continue }
                if nid == NAME_FONT_SUBFAMILY { lookup = styleStrid(instance) }
            }
            // (The first record of the platform and name ID.)
            var index: usize = 0
            while index < nameCount && !(mem.get64(map + index * 40) == platform && mem.get64(map + index * 40 + 8) == lookup) { index += 1 }
            while index < nameCount && mem.get64(map + index * 40) == platform && mem.get64(map + index * 40 + 8) == lookup {
                if !sfntName(s, face, mem.get64(map + index * 40 + 32)) { break }
                var object: i64 = 0
                var objectLang: i64 = 0
                var counter: *usize = &nfamily
                var langCounter: *usize = &nfamilyLang
                if nid == NAME_WWS_FAMILY || nid == NAME_TYPOGRAPHIC_FAMILY || nid == NAME_FONT_FAMILY {
                    object = objects.FAMILY
                    objectLang = objects.FAMILYLANG
                } else if nid == NAME_MAC_FULL_NAME || nid == NAME_FULL_NAME {
                    if !variable {
                        object = objects.FULLNAME
                        objectLang = objects.FULLNAMELANG
                        counter = &nfullname
                        langCounter = &nfullnameLang
                    }
                } else if nid == NAME_WWS_SUBFAMILY || nid == NAME_TYPOGRAPHIC_SUBFAMILY || nid == NAME_FONT_SUBFAMILY {
                    if !variable {
                        object = objects.STYLE
                        objectLang = objects.STYLELANG
                        counter = &nstyle
                        langCounter = &nstyleLang
                    }
                } else if foundry == 0 {
                    const utf8 = transcode(s)
                    const named = noticeFoundry(utf8)
                    if named.length > 0 {
                        foundry = mem.dupText(named)
                        ownFoundry = true
                    }
                    mem.free(utf8)
                }
                if object != 0 {
                    const utf8 = transcode(s)
                    const language = nameLanguageOf(s)
                    if utf8 != 0 {
                        trimSpaces(utf8)
                        if !inElement(p, object, utf8) {
                            _ = pattern.addNode(p, object, value.nodeTaking(objects.TYPE_STRING, @intCast(u64, utf8), value.BINDING_STRONG), true)
                            if language != 0 {
                                while langCounter.* < counter.* {
                                    _ = pattern.addString(p, objectLang, und)
                                    langCounter.* += 1
                                }
                                _ = pattern.addString(p, objectLang, language)
                                langCounter.* += 1
                            }
                            counter.* += 1
                        } else {
                            mem.free(utf8)
                        }
                    }
                }
                index += 1
            }
        }
    }
    const en = mem.dupText("en")
    if nfamily == 0 && f.*.familyName != 0 && !isBlankName(f.*.familyName) {
        _ = pattern.addString(p, objects.FAMILY, f.*.familyName)
        _ = pattern.addString(p, objects.FAMILYLANG, en)
        nfamily += 1
    }
    if !variable && nstyle == 0 {
        var ss = f.*.styleName
        var own: usize = 0
        if ss == 0 || isBlankName(ss) {
            own = mem.dupText("Regular")
            ss = own
        }
        _ = pattern.addString(p, objects.STYLE, ss)
        _ = pattern.addString(p, objects.STYLELANG, en)
        mem.free(own)
        nstyle += 1
    }
    if nfamily == 0 && file != 0 && mem.get8(file) != 0 {
        const n = mem.cLength(file)
        var start = n
        while start > 0 && mem.get8(file + start - 1) != 47 { start -= 1 }
        var end = n
        var k = n
        while k > start {
            if mem.get8(file + k - 1) == 46 {
                end = k - 1
                break
            }
            k -= 1
        }
        const family = mem.dup(file + start, end - start)
        _ = pattern.addString(p, objects.FAMILY, family)
        _ = pattern.addString(p, objects.FAMILYLANG, en)
        mem.free(family)
        nfamily += 1
    }
    if !variable && nfullname == 0 {
        const family = englishValue(p, objects.FAMILY, objects.FAMILYLANG)
        const style = englishValue(p, objects.STYLE, objects.STYLELANG)
        if family != 0 && style != 0 {
            var b: mem.Buffer = undefined
            mem.initBuffer(&b)
            var flen = mem.cLength(family)
            while flen > 0 && mem.isSpace(mem.get8(family + flen - 1)) { flen -= 1 }
            _ = mem.appendBytes(&b, family, flen)
            _ = mem.appendByte(&b, 32)
            var sstart: usize = 0
            while mem.get8(style + sstart) != 0 && mem.isSpace(mem.get8(style + sstart)) { sstart += 1 }
            _ = mem.appendC(&b, style + sstart)
            const full = mem.takeBuffer(&b)
            _ = pattern.addNode(p, objects.FULLNAME, value.nodeTaking(objects.TYPE_STRING, @intCast(u64, full), value.BINDING_STRONG), true)
            _ = pattern.addString(p, objects.FULLNAMELANG, en)
            nfullname += 1
        }
    }
    if !variable {
        const ps = tt.info.postscriptName(face)
        if ps != 0 {
            const copy = mem.dup(ps, if mem.cLength(ps) > 255 { 255 } else { mem.cLength(ps) })
            _ = pattern.addNode(p, objects.POSTSCRIPT_NAME, value.nodeTaking(objects.TYPE_STRING, @intCast(u64, copy), value.BINDING_STRONG), true)
        } else {
            const family = englishValue(p, objects.FAMILY, objects.FAMILYLANG)
            if family != 0 {
                var b: mem.Buffer = undefined
                mem.initBuffer(&b)
                var i: usize = 0
                while mem.get8(family + i) != 0 && i < 255 {
                    const c = mem.get8(family + i)
                    const excluded = c == 4 || c == 40 || c == 41 || c == 47 || c == 60 || c == 62 || c == 91 || c == 93 || c == 123 || c == 125 || c == 9 || c == 12 || c == 13 || c == 10 || c == 32
                    _ = mem.appendByte(&b, if excluded { 45 } else { c })
                    i += 1
                }
                _ = mem.appendText(&b, "")
                const psname = mem.takeBuffer(&b)
                _ = pattern.addNode(p, objects.POSTSCRIPT_NAME, value.nodeTaking(objects.TYPE_STRING, @intCast(u64, psname), value.BINDING_STRONG), true)
            }
        }
    }
    if file != 0 && mem.get8(file) != 0 { _ = pattern.addString(p, objects.FILE, file) }
    _ = pattern.addInteger(p, objects.INDEX, @intCast(i64, faceId))
    const head = tt.info.sfntTable(face, SFNT_HEAD)
    _ = pattern.addInteger(p, objects.FONTVERSION, if head != 0 { @bitCast(i64, mem.get64(head + 8)) } else { 0 })
    _ = pattern.addInteger(p, objects.ORDER, 0)
    var exclusive: usize = 0
    if os2 != 0 && mem.get16(os2) >= 1 && mem.get16(os2) != 0xffff {
        const ranges = mem.get64(os2 + 104)
        var bit: usize = 17
        while bit <= 20 {
            if ((ranges >> @intCast(u64, bit)) & 1) != 0 {
                if exclusive != 0 {
                    mem.free(exclusive)
                    exclusive = 0
                    break
                }
                exclusive = mem.dupText(lang.codePageLang(bit))
            }
            bit += 1
        }
    }
    if os2 != 0 && mem.get16(os2) != 0xffff {
        weight = objects.weightFromOpenType(@floatFromInt(f64, mem.get16(os2 + 4)) * weightMult)
        const wc = mem.get16(os2 + 6)
        if wc >= 1 && wc <= 9 {
            const classes = [9]f64{ 50.0, 63.0, 75.0, 87.0, 100.0, 113.0, 125.0, 150.0, 200.0 }
            width = classes[@intCast(usize, wc - 1)]
        }
        width = width * widthMult
    }
    if os2 != 0 {
        const caps = capabilities(face)
        if caps != 0 { _ = pattern.addNode(p, objects.CAPABILITY, value.nodeTaking(objects.TYPE_STRING, @intCast(u64, caps), value.BINDING_STRONG), true) }
    }
    _ = pattern.addBool(p, objects.FONT_HAS_HINT, if tableOf(face, 0x70726570).1 != 0 { 1 } else { 0 })
    if !variableSize && os2 != 0 && mem.get16(os2) >= 5 && mem.get16(os2) != 0xffff {
        const lower = @floatFromInt(f64, mem.get16(os2 + 130)) / 20.0
        const upper = @floatFromInt(f64, mem.get16(os2 + 132)) / 20.0
        if lower == upper { _ = pattern.addDouble(p, objects.SIZE, lower) } else { _ = pattern.addRange(p, objects.SIZE, lower, upper) }
    }
    // A CFF font's PostScript information: its weight, its notice's
    // foundry.
    if tt.info.psFontInfo(face, s.*.scratch + SCRATCH_PSINFO) == r.OK {
        const psWeight = mem.getWord(s.*.scratch + SCRATCH_PSINFO + 32)
        if weight == -1.0 && psWeight != 0 { weight = @floatFromInt(f64, isConst(psWeight, WEIGHT_WORDS, WEIGHT_VALUES[0..23])) }
        if foundry == 0 {
            const named = noticeFoundry(mem.getWord(s.*.scratch + SCRATCH_PSINFO + 8))
            if named.length > 0 {
                foundry = mem.dupText(named)
                ownFoundry = true
            }
        }
    }
    var st: i64 = 0
    while true {
        var style: usize = 0
        if pattern.getString(p, objects.STYLE, st, &style) != pattern.RESULT_MATCH { break }
        if weight == -1.0 { weight = @floatFromInt(f64, containsConst(style, WEIGHT_WORDS, WEIGHT_VALUES[0..23])) }
        if width == -1.0 { width = @floatFromInt(f64, containsConst(style, WIDTH_WORDS, WIDTH_VALUES[0..10])) }
        if slant == -1 { slant = containsConst(style, SLANT_WORDS, SLANT_VALUES[0..3]) }
        if !decorative { decorative = containsConst(style, DECORATIVE_WORDS, DECORATIVE_VALUES[0..6]) > 0 }
        st += 1
    }
    if slant == -1 { slant = if (f.*.styleFlags & 1) != 0 { 100 } else { 0 } }
    if weight == -1.0 { weight = if (f.*.styleFlags & 2) != 0 { 200.0 } else { 100.0 } }
    if width == -1.0 { width = 100.0 }
    if foundry == 0 {
        foundry = mem.dupText("unknown")
        ownFoundry = true
    }
    _ = pattern.addInteger(p, objects.SLANT, slant)
    if !variableWeight { _ = pattern.addDouble(p, objects.WEIGHT, weight) }
    if !variableWidth { _ = pattern.addDouble(p, objects.WIDTH, width) }
    _ = pattern.addString(p, objects.FOUNDRY, foundry)
    if ownFoundry { mem.free(foundry) }
    _ = pattern.addBool(p, objects.DECORATIVE, if decorative { 1 } else { 0 })
    // The characters and languages.
    if sh.*.cs == 0 { sh.*.cs = charSetOf(s, face) }
    const cs = sh.*.cs
    const charmap = f.*.charmap
    const symbol = charmap != 0 && o.charMap(charmap).*.encoding == r.ENCODING_MS_SYMBOL
    _ = pattern.addBool(p, objects.SYMBOL, if symbol { 1 } else { 0 })
    const spacing = spacingOf(s, face)
    _ = pattern.addPointer(p, objects.CHARSET, objects.TYPE_CHARSET, cs)
    if !symbol {
        if sh.*.ls == 0 { sh.*.ls = lang.ofCharSet(cs, exclusive) }
        _ = pattern.addPointer(p, objects.LANG, objects.TYPE_LANGSET, sh.*.ls)
    } else {
        const empty = lang.create()
        _ = pattern.addPointer(p, objects.LANG, objects.TYPE_LANGSET, empty)
        lang.destroy(empty)
    }
    mem.free(exclusive)
    if spacing != 0 { _ = pattern.addInteger(p, objects.SPACING, spacing) }
    if !hasOutline {
        var i: i64 = 0
        while i < @intCast(i64, f.*.numFixedSizes) {
            const yPpem = mem.get64(f.*.availableSizes + @intCast(usize, i) * @sizeOf(r.BitmapSize) + 24)
            _ = pattern.addDouble(p, objects.PIXEL_SIZE, @floatFromInt(f64, @bitCast(i64, yPpem)) / 64.0)
            i += 1
        }
        _ = pattern.addBool(p, objects.ANTIALIAS, 0)
    }
    const format = tt.info.fontFormat(face)
    if format != 0 { _ = pattern.addString(p, objects.FONTFORMAT, format) }
    _ = pattern.addBool(p, objects.NAMED_INSTANCE, if id > 0xffff { 1 } else { 0 })
    _ = pattern.addText(p, objects.FONT_WRAPPER, wrapperOf(file))
    mem.free(und)
    mem.free(en)
    doneMMVar(s, mm)
    return p
}

fn isBlankName(s: usize) -> bool {
    const blank = mem.dupText("")
    const result = strings.cmpIgnoreBlanksAndCase(s, blank) == 0
    mem.free(blank)
    return result
}

// The value of `object` whose language (of `langObject`) is "en", else
// the first.
fn englishValue(p: usize, object: i64, langObject: i64) -> usize {
    var n: i64 = 0
    var found = false
    while true {
        var l: usize = 0
        if pattern.getString(p, langObject, n, &l) != pattern.RESULT_MATCH { break }
        if mem.cIs(l, "en") {
            found = true
            break
        }
        n += 1
    }
    if !found { n = 0 }
    var s: usize = 0
    if pattern.getString(p, object, n, &s) != pattern.RESULT_MATCH { return 0 }
    return s
}

// "SFNT", or "WOFF" / "WOFF2" by the file's first bytes.
fn wrapperOf(file: usize) -> []const u8 {
    const block = mem.alloc(8)
    var result: []const u8 = "SFNT"
    if block != 0 {
        const n = fs.readFileResult(mem.bytes(file), mem.bytes(block), 4)
        if n >= 4 && mem.get8(block) == 119 && mem.get8(block + 1) == 79 && mem.get8(block + 2) == 70 {
            if mem.get8(block + 3) == 70 { result = "WOFF" } else if mem.get8(block + 3) == 50 { result = "WOFF2" }
        }
        mem.free(block)
    }
    return result
}

// FcFreeTypeQueryAll: the patterns of every face of the file (each named
// instance not the default one, then the variable font) added to `set`;
// their number.
pub fn queryAll(s: *Scanner, file: usize, set: usize) -> usize {
    var count: usize = 0
    var faceNum: i64 = 0
    var face = openFace(s, file, 0)
    if face == 0 { return 0 }
    const numFaces = faceOf(face).*.numFaces
    // (A face or named instance that gives no pattern ends the file's
    // reading, as in Fontconfig; the variable font itself may give none.)
    var failed = false
    while true {
        var numInstances = @intCast(u64, (faceOf(face).*.styleFlags >> 16) & 0x7fff)
        var mm: usize = 0
        if numInstances != 0 {
            mm = mmVar(s, face)
            if mm == 0 { numInstances = 0 }
        }
        var sh: Shared = Shared.{ .cs = 0, .ls = 0, .names = 0, .nameCount = 0 }
        var instanceNum: u64 = 0
        while true {
            var skip = false
            if instanceNum == 0x8000 || instanceNum > numInstances {
                _ = tt.variations.setDesignCoordinates(face, 0, 0)
            } else if instanceNum != 0 {
                const style = mmStyle(mm, instanceNum - 1)
                var nonzero = false
                var i: u64 = 0
                while i < mmAxes(mm) {
                    if styleCoord(style, i) != @bitCast(i64, mem.get64(mmAxis(mm, i) + 16)) {
                        nonzero = true
                        break
                    }
                    i += 1
                }
                if !nonzero {
                    skip = true
                } else {
                    _ = tt.variations.setDesignCoordinates(face, @intCast(u32, mmAxes(mm)), mem.getWord(style))
                }
            }
            if !skip {
                const id = (instanceNum << 16) + @intCast(u64, faceNum)
                const p = queryFace(s, face, file, id, &sh)
                if p != 0 {
                    count += 1
                    if !pattern.fontSetAdd(set, p) { pattern.destroy(p) }
                } else if instanceNum != 0x8000 {
                    failed = true
                    break
                }
            }
            if instanceNum < numInstances {
                instanceNum += 1
            } else if instanceNum == numInstances {
                instanceNum = 0x8000
            } else {
                break
            }
        }
        freeShared(&sh)
        doneMMVar(s, mm)
        tt.faces.doneFace(face)
        faceNum += 1
        if failed || faceNum >= numFaces { break }
        face = openFace(s, file, faceNum)
        if face == 0 { break }
    }
    return count
}
