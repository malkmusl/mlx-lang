// std.fontconfig.config: a configuration (FcConfig): the font directories,
// the configuration files read, the rules of fonts.conf and conf.d (on
// patterns, on fonts matched, on fonts scanned), the fonts accepted and
// rejected by name and by pattern, and the fonts themselves (the system's
// set, built from the directories, and an application's). Substitution
// (FcConfigSubstitute) applies the rules of a kind to a pattern, as
// Fontconfig's FcConfigSubstituteWithPat does: each rule's tests in
// order, then its edits (assign, prepend, append, delete, at the value a
// test matched or at the element's ends), the expressions evaluated with
// Fontconfig's types and promotions. FcDefaultSubstitute fills in what a
// pattern leaves out.
//
// A configuration is a record reached by its address (CONFIG_* offsets,
// words); a rule a record of the next rule and its items; an item a
// record of the next item, its kind (ITEM_TEST, ITEM_EDIT) and its test
// or edit; an expression a record of its operation and four words.
const mem = @import("./mem.mlx")
const strings = @import("./strings.mlx")
const strset = @import("./strset.mlx")
const charset = @import("./charset.mlx")
const lang = @import("./lang.mlx")
const objects = @import("./objects.mlx")
const value = @import("./value.mlx")
const pattern = @import("./pattern.mlx")
const env = @import("./env.mlx")
const linux = @import("../../bootstrap/os/linux.mlx")

// FcMatchKind.
pub const MATCH_DEFAULT: i64 = -1
pub const MATCH_PATTERN: i64 = 0
pub const MATCH_FONT: i64 = 1
pub const MATCH_SCAN: i64 = 2

// FcSetName.
pub const SET_SYSTEM: i64 = 0
pub const SET_APPLICATION: i64 = 1

// FcQual.
pub const QUAL_ANY: i64 = 0
pub const QUAL_ALL: i64 = 1
pub const QUAL_FIRST: i64 = 2
pub const QUAL_NOT_FIRST: i64 = 3

// FcOp, in Fontconfig's order (an expression's operation, a test's
// comparison and an edit's mode are all of them).
pub const OP_INTEGER: i64 = 0
pub const OP_DOUBLE: i64 = 1
pub const OP_STRING: i64 = 2
pub const OP_MATRIX: i64 = 3
pub const OP_RANGE: i64 = 4
pub const OP_BOOL: i64 = 5
pub const OP_CHARSET: i64 = 6
pub const OP_LANGSET: i64 = 7
pub const OP_NIL: i64 = 8
pub const OP_FIELD: i64 = 9
pub const OP_CONST: i64 = 10
pub const OP_ASSIGN: i64 = 11
pub const OP_ASSIGN_REPLACE: i64 = 12
pub const OP_PREPEND_FIRST: i64 = 13
pub const OP_PREPEND: i64 = 14
pub const OP_APPEND: i64 = 15
pub const OP_APPEND_LAST: i64 = 16
pub const OP_DELETE: i64 = 17
pub const OP_DELETE_ALL: i64 = 18
pub const OP_QUEST: i64 = 19
pub const OP_OR: i64 = 20
pub const OP_AND: i64 = 21
pub const OP_EQUAL: i64 = 22
pub const OP_NOT_EQUAL: i64 = 23
pub const OP_CONTAINS: i64 = 24
pub const OP_LISTING: i64 = 25
pub const OP_NOT_CONTAINS: i64 = 26
pub const OP_LESS: i64 = 27
pub const OP_LESS_EQUAL: i64 = 28
pub const OP_MORE: i64 = 29
pub const OP_MORE_EQUAL: i64 = 30
pub const OP_PLUS: i64 = 31
pub const OP_MINUS: i64 = 32
pub const OP_TIMES: i64 = 33
pub const OP_DIVIDE: i64 = 34
pub const OP_NOT: i64 = 35
pub const OP_COMMA: i64 = 36
pub const OP_FLOOR: i64 = 37
pub const OP_CEIL: i64 = 38
pub const OP_ROUND: i64 = 39
pub const OP_TRUNC: i64 = 40
pub const OP_INVALID: i64 = 41
// (A flag above the operation: strings compared ignoring blanks.)
pub const FLAG_IGNORE_BLANKS: i64 = 65536

pub fn opOf(op: i64) -> i64 { return op & 0xffff }

// ---------------------------------------------------------------------------
// The record.

pub const CONFIG_REFS: usize = 0
pub const CONFIG_FONT_DIRS: usize = 8
pub const CONFIG_CONFIG_DIRS: usize = 16
pub const CONFIG_CONFIG_FILES: usize = 24
pub const CONFIG_CACHE_DIRS: usize = 32
pub const CONFIG_ACCEPT_GLOBS: usize = 40
pub const CONFIG_REJECT_GLOBS: usize = 48
pub const CONFIG_ACCEPT_PATTERNS: usize = 56
pub const CONFIG_REJECT_PATTERNS: usize = 64
// The rules of each kind (pattern, font, scan) and the last of each.
pub const CONFIG_RULES: usize = 72
pub const CONFIG_LAST_RULES: usize = 96
pub const CONFIG_FONTS: usize = 120
pub const CONFIG_RESCAN: usize = 136
pub const CONFIG_SYSROOT: usize = 144
pub const CONFIG_RESCAN_TIME: usize = 152
pub const CONFIG_SIZE: usize = 160

pub const ITEM_TEST: i64 = 1
pub const ITEM_EDIT: i64 = 2

pub fn create() -> usize {
    const c = mem.alloc(CONFIG_SIZE)
    if c == 0 { return 0 }
    mem.put64(c, 1)
    mem.putWord(c + CONFIG_FONT_DIRS, strset.create())
    mem.putWord(c + CONFIG_CONFIG_DIRS, strset.create())
    mem.putWord(c + CONFIG_CONFIG_FILES, strset.create())
    mem.putWord(c + CONFIG_CACHE_DIRS, strset.create())
    mem.putWord(c + CONFIG_ACCEPT_GLOBS, strset.create())
    mem.putWord(c + CONFIG_REJECT_GLOBS, strset.create())
    mem.putWord(c + CONFIG_ACCEPT_PATTERNS, pattern.fontSetCreate())
    mem.putWord(c + CONFIG_REJECT_PATTERNS, pattern.fontSetCreate())
    mem.put64(c + CONFIG_RESCAN, 30)
    mem.put64(c + CONFIG_RESCAN_TIME, @bitCast(u64, mem.now()))
    return c
}

pub fn reference(c: usize) -> usize {
    if c != 0 { _ = @atomicRmw(u64, unsafe { @ptrFromInt(*u64, c) }, add, 1, monotonic) }
    return c
}

pub fn destroy(c: usize) -> void {
    if c == 0 { return }
    if @atomicRmw(u64, unsafe { @ptrFromInt(*u64, c) }, sub, 1, acq_rel) != 1 { return }
    if current == c { current = 0 }
    strset.destroy(mem.getWord(c + CONFIG_FONT_DIRS))
    strset.destroy(mem.getWord(c + CONFIG_CONFIG_DIRS))
    strset.destroy(mem.getWord(c + CONFIG_CONFIG_FILES))
    strset.destroy(mem.getWord(c + CONFIG_CACHE_DIRS))
    strset.destroy(mem.getWord(c + CONFIG_ACCEPT_GLOBS))
    strset.destroy(mem.getWord(c + CONFIG_REJECT_GLOBS))
    pattern.fontSetDestroy(mem.getWord(c + CONFIG_ACCEPT_PATTERNS))
    pattern.fontSetDestroy(mem.getWord(c + CONFIG_REJECT_PATTERNS))
    var k: usize = 0
    while k < 3 {
        var rule = mem.getWord(c + CONFIG_RULES + k * 8)
        while rule != 0 {
            const following = mem.getWord(rule)
            destroyRule(rule)
            rule = following
        }
        k += 1
    }
    pattern.fontSetDestroy(mem.getWord(c + CONFIG_FONTS))
    pattern.fontSetDestroy(mem.getWord(c + CONFIG_FONTS + 8))
    mem.free(mem.getWord(c + CONFIG_SYSROOT))
    mem.free(c)
}

pub fn fontDirs(c: usize) -> usize { return mem.getWord(c + CONFIG_FONT_DIRS) }
pub fn configDirs(c: usize) -> usize { return mem.getWord(c + CONFIG_CONFIG_DIRS) }
pub fn configFiles(c: usize) -> usize { return mem.getWord(c + CONFIG_CONFIG_FILES) }
pub fn cacheDirs(c: usize) -> usize { return mem.getWord(c + CONFIG_CACHE_DIRS) }

// The fonts of a set (SET_SYSTEM, SET_APPLICATION), 0 when it has none.
pub fn fonts(c: usize, set: i64) -> usize { return mem.getWord(c + CONFIG_FONTS + @intCast(usize, set) * 8) }

// The set's fonts replaced by `fs` (taken).
pub fn setFonts(c: usize, set: i64, fs: usize) -> void {
    const at = c + CONFIG_FONTS + @intCast(usize, set) * 8
    pattern.fontSetDestroy(mem.getWord(at))
    mem.putWord(at, fs)
}

pub fn sysroot(c: usize) -> usize { return if c == 0 { 0 } else { mem.getWord(c + CONFIG_SYSROOT) } }

// ---------------------------------------------------------------------------
// The current configuration (the one a null FcConfig* means), made by
// whoever first asks (load.mlx's `current`).

pub var current: usize = 0
pub var currentLock: mem.Mutex = mem.Mutex.{ .owner = 0, .word = 0, .depth = 0 }

// ---------------------------------------------------------------------------
// Expressions, tests, edits, rules.

pub fn expr(op: i64, w1: u64, w2: u64) -> usize {
    const e = mem.alloc(40)
    if e == 0 { return 0 }
    mem.put64(e, @bitCast(u64, op))
    mem.put64(e + 8, w1)
    mem.put64(e + 16, w2)
    return e
}

pub fn exprOp(e: usize) -> i64 { return @bitCast(i64, mem.get64(e)) }
pub fn exprWord(e: usize, k: usize) -> u64 { return mem.get64(e + 8 * k) }
pub fn setExprWord(e: usize, k: usize, w: u64) -> void { mem.put64(e + 8 * k, w) }

pub fn destroyExpr(e: usize) -> void {
    if e == 0 { return }
    const op = opOf(exprOp(e))
    if op == OP_STRING || op == OP_CONST {
        mem.free(@intCast(usize, exprWord(e, 1)))
    } else if op == OP_MATRIX {
        var k: usize = 1
        while k <= 4 {
            destroyExpr(@intCast(usize, exprWord(e, k)))
            k += 1
        }
    } else if op == OP_RANGE {
        mem.free(@intCast(usize, exprWord(e, 1)))
    } else if op == OP_CHARSET {
        charset.destroy(@intCast(usize, exprWord(e, 1)))
    } else if op == OP_LANGSET {
        lang.destroy(@intCast(usize, exprWord(e, 1)))
    } else if op >= OP_QUEST && op != OP_NIL {
        destroyExpr(@intCast(usize, exprWord(e, 1)))
        destroyExpr(@intCast(usize, exprWord(e, 2)))
    }
    mem.free(e)
}

// A test: its kind (MATCH_...), qual, object, comparison (with flags) and
// expression.
pub fn newTest(kind: i64, qual: i64, object: i64, op: i64, e: usize) -> usize {
    const t = mem.alloc(40)
    if t == 0 { return 0 }
    mem.put64(t, @bitCast(u64, kind))
    mem.put64(t + 8, @bitCast(u64, qual))
    mem.put64(t + 16, @bitCast(u64, object))
    mem.put64(t + 24, @bitCast(u64, op))
    mem.putWord(t + 32, e)
    return t
}

fn testKind(t: usize) -> i64 { return @bitCast(i64, mem.get64(t)) }
fn testQual(t: usize) -> i64 { return @bitCast(i64, mem.get64(t + 8)) }
fn testObject(t: usize) -> i64 { return @bitCast(i64, mem.get64(t + 16)) }
fn testOp(t: usize) -> i64 { return @bitCast(i64, mem.get64(t + 24)) }
fn testExpr(t: usize) -> usize { return mem.getWord(t + 32) }

// An edit: its object, mode (OP_ASSIGN...), expression and binding.
pub fn edit(object: i64, op: i64, e: usize, binding: i64) -> usize {
    const ed = mem.alloc(32)
    if ed == 0 { return 0 }
    mem.put64(ed, @bitCast(u64, object))
    mem.put64(ed + 8, @bitCast(u64, op))
    mem.putWord(ed + 16, e)
    mem.put64(ed + 24, @bitCast(u64, binding))
    return ed
}

fn editObject(ed: usize) -> i64 { return @bitCast(i64, mem.get64(ed)) }
fn editOp(ed: usize) -> i64 { return @bitCast(i64, mem.get64(ed + 8)) }
fn editExpr(ed: usize) -> usize { return mem.getWord(ed + 16) }
fn editBinding(ed: usize) -> i64 { return @bitCast(i64, mem.get64(ed + 24)) }

// An item of a rule.
pub fn item(kind: i64, payload: usize) -> usize {
    const it = mem.alloc(24)
    if it == 0 { return 0 }
    mem.put64(it + 8, @bitCast(u64, kind))
    mem.putWord(it + 16, payload)
    return it
}

pub fn itemNext(it: usize) -> usize { return mem.getWord(it) }
pub fn setItemNext(it: usize, n: usize) -> void { mem.putWord(it, n) }
fn itemKind(it: usize) -> i64 { return @bitCast(i64, mem.get64(it + 8)) }
fn itemPayload(it: usize) -> usize { return mem.getWord(it + 16) }

fn destroyItems(first: usize) -> void {
    var it = first
    while it != 0 {
        const following = itemNext(it)
        const payload = itemPayload(it)
        if itemKind(it) == ITEM_TEST {
            destroyExpr(testExpr(payload))
        } else {
            destroyExpr(editExpr(payload))
        }
        mem.free(payload)
        mem.free(it)
        it = following
    }
}

fn destroyRule(rule: usize) -> void {
    destroyItems(mem.getWord(rule + 8))
    mem.free(rule)
}

pub fn destroyItemList(first: usize) -> void { destroyItems(first) }

// A rule of the items from `first` added at the end of the kind's rules;
// its tests of the default kind take the rule's kind (FcRuleSetAdd).
pub fn addRule(c: usize, kind: i64, first: usize) -> bool {
    const rule = mem.alloc(16)
    if rule == 0 {
        destroyItems(first)
        return false
    }
    mem.putWord(rule + 8, first)
    var it = first
    while it != 0 {
        if itemKind(it) == ITEM_TEST && testKind(itemPayload(it)) == MATCH_DEFAULT { mem.put64(itemPayload(it), @bitCast(u64, kind)) }
        it = itemNext(it)
    }
    const k = @intCast(usize, kind)
    const last = mem.getWord(c + CONFIG_LAST_RULES + k * 8)
    if last == 0 { mem.putWord(c + CONFIG_RULES + k * 8, rule) } else { mem.putWord(last, rule) }
    mem.putWord(c + CONFIG_LAST_RULES + k * 8, rule)
    return true
}

// ---------------------------------------------------------------------------
// Values while evaluating: a type and a word (value.mlx's), owning what
// they point to unless said otherwise.

fn release(t: i64, word: u64) -> void {
    if t == objects.TYPE_STRING || t == objects.TYPE_MATRIX || t == objects.TYPE_RANGE {
        mem.free(@intCast(usize, word))
    } else if t == objects.TYPE_CHARSET {
        charset.destroy(@intCast(usize, word))
    } else if t == objects.TYPE_LANGSET {
        lang.destroy(@intCast(usize, word))
    }
}

fn toDouble(word: u64) -> f64 { return @bitCast(f64, word) }
fn toInt(word: u64) -> i64 { return @intCast(i64, @bitCast(i32, @intCast(u32, word & 0xffffffff))) }

// FcConfigPromote: `t`, `word` as the type `u` asks for where Fontconfig
// promotes (an integer to a double; a double to a range when `u` is one; a
// void to an identity matrix, an empty langset or charset; a string to a
// langset). The result's third word: whether it made something that is to
// be released (the original stays the caller's).
fn promote(t: i64, word: u64, u: i64, ranges: bool) -> (i64, u64, bool) {
    var nt = t
    var nw = word
    if t == objects.TYPE_INTEGER {
        nt = objects.TYPE_DOUBLE
        nw = @bitCast(u64, @floatFromInt(f64, toInt(word)))
    }
    if nt == objects.TYPE_DOUBLE {
        if u == objects.TYPE_RANGE && ranges {
            const d = toDouble(nw)
            return (objects.TYPE_RANGE, @intCast(u64, value.rangeCreate(d, d)), true)
        }
        return (nt, nw, false)
    }
    if t == objects.TYPE_VOID {
        if u == objects.TYPE_MATRIX {
            const m = mem.alloc(32)
            value.matrixIdentity(m)
            return (objects.TYPE_MATRIX, @intCast(u64, m), true)
        }
        if u == objects.TYPE_LANGSET && ranges { return (objects.TYPE_LANGSET, @intCast(u64, lang.create()), true) }
        if u == objects.TYPE_CHARSET && ranges { return (objects.TYPE_CHARSET, @intCast(u64, charset.create()), true) }
        return (t, word, false)
    }
    if t == objects.TYPE_STRING && u == objects.TYPE_LANGSET && ranges {
        const ls = lang.create()
        _ = lang.add(ls, @intCast(usize, word))
        return (objects.TYPE_LANGSET, @intCast(u64, ls), true)
    }
    return (t, word, false)
}

fn rangeCompare(op: i64, a: usize, b: usize) -> bool {
    const ab = value.rangeBegin(a)
    const ae = value.rangeEnd(a)
    const bb = value.rangeBegin(b)
    const be = value.rangeEnd(b)
    if op == OP_EQUAL { return ab == bb && ae == be }
    if op == OP_CONTAINS || op == OP_LISTING { return ab >= bb && ae <= be }
    if op == OP_NOT_EQUAL { return ab != bb || ae != be }
    if op == OP_NOT_CONTAINS { return !(ab >= bb && ae <= be) }
    if op == OP_LESS { return ae < bb }
    if op == OP_LESS_EQUAL { return ae <= bb }
    if op == OP_MORE { return ab > be }
    if op == OP_MORE_EQUAL { return ab >= be }
    return false
}

// FcConfigCompareValue: `left` `op` `right`.
pub fn compareValue(lt0: i64, lw0: u64, opFlags: i64, rt0: i64, rw0: u64) -> bool {
    const op = opOf(opFlags)
    const ignoreBlanks = (opFlags & FLAG_IGNORE_BLANKS) != 0
    var lt = lt0
    var lw = lw0
    var rt = rt0
    var rw = rw0
    var madeLeft = false
    var madeRight = false
    if lt != rt {
        const pl = promote(lt0, lw0, rt0, true)
        lt = pl.0
        lw = pl.1
        madeLeft = pl.2
        const pr = promote(rt0, rw0, lt, true)
        rt = pr.0
        rw = pr.1
        madeRight = pr.2
        if lt != rt {
            if madeLeft { release(lt, lw) }
            if madeRight { release(rt, rw) }
            return op == OP_NOT_EQUAL || op == OP_NOT_CONTAINS
        }
    }
    var ret = false
    if lt == objects.TYPE_INTEGER {
        const l = toInt(lw)
        const r = toInt(rw)
        if op == OP_EQUAL || op == OP_CONTAINS || op == OP_LISTING {
            ret = l == r
        } else if op == OP_NOT_EQUAL || op == OP_NOT_CONTAINS {
            ret = l != r
        } else if op == OP_LESS {
            ret = l < r
        } else if op == OP_LESS_EQUAL {
            ret = l <= r
        } else if op == OP_MORE {
            ret = l > r
        } else if op == OP_MORE_EQUAL {
            ret = l >= r
        }
    } else if lt == objects.TYPE_DOUBLE {
        const l = toDouble(lw)
        const r = toDouble(rw)
        if op == OP_EQUAL || op == OP_CONTAINS || op == OP_LISTING {
            ret = l == r
        } else if op == OP_NOT_EQUAL || op == OP_NOT_CONTAINS {
            ret = l != r
        } else if op == OP_LESS {
            ret = l < r
        } else if op == OP_LESS_EQUAL {
            ret = l <= r
        } else if op == OP_MORE {
            ret = l > r
        } else if op == OP_MORE_EQUAL {
            ret = l >= r
        }
    } else if lt == objects.TYPE_BOOL {
        const l = toInt(lw)
        const r = toInt(rw)
        if op == OP_EQUAL {
            ret = l == r
        } else if op == OP_CONTAINS || op == OP_LISTING {
            ret = l == r || l >= 2
        } else if op == OP_NOT_EQUAL {
            ret = l != r
        } else if op == OP_NOT_CONTAINS {
            ret = !(l == r || l >= 2)
        } else if op == OP_LESS {
            ret = l != r && r >= 2
        } else if op == OP_LESS_EQUAL {
            ret = l == r || r >= 2
        } else if op == OP_MORE {
            ret = l != r && l >= 2
        } else if op == OP_MORE_EQUAL {
            ret = l == r || l >= 2
        }
    } else if lt == objects.TYPE_STRING {
        const l = @intCast(usize, lw)
        const r = @intCast(usize, rw)
        if op == OP_EQUAL || op == OP_LISTING {
            ret = if ignoreBlanks { strings.cmpIgnoreBlanksAndCase(l, r) == 0 } else { strings.cmpIgnoreCase(l, r) == 0 }
        } else if op == OP_CONTAINS {
            ret = strings.strIgnoreCase(l, r) != 0
        } else if op == OP_NOT_EQUAL {
            ret = if ignoreBlanks { strings.cmpIgnoreBlanksAndCase(l, r) != 0 } else { strings.cmpIgnoreCase(l, r) != 0 }
        } else if op == OP_NOT_CONTAINS {
            ret = strings.strIgnoreCase(l, r) == 0
        }
    } else if lt == objects.TYPE_MATRIX {
        const same = value.matrixEqual(@intCast(usize, lw), @intCast(usize, rw))
        if op == OP_EQUAL || op == OP_CONTAINS || op == OP_LISTING {
            ret = same
        } else if op == OP_NOT_EQUAL || op == OP_NOT_CONTAINS {
            ret = !same
        }
    } else if lt == objects.TYPE_CHARSET {
        const l = @intCast(usize, lw)
        const r = @intCast(usize, rw)
        if op == OP_CONTAINS || op == OP_LISTING {
            ret = charset.isSubset(r, l)
        } else if op == OP_NOT_CONTAINS {
            ret = !charset.isSubset(r, l)
        } else if op == OP_EQUAL {
            ret = charset.equal(l, r)
        } else if op == OP_NOT_EQUAL {
            ret = !charset.equal(l, r)
        }
    } else if lt == objects.TYPE_LANGSET {
        const l = @intCast(usize, lw)
        const r = @intCast(usize, rw)
        if op == OP_CONTAINS || op == OP_LISTING {
            ret = lang.containsSet(l, r)
        } else if op == OP_NOT_CONTAINS {
            ret = !lang.containsSet(l, r)
        } else if op == OP_EQUAL {
            ret = lang.equal(l, r)
        } else if op == OP_NOT_EQUAL {
            ret = !lang.equal(l, r)
        }
    } else if lt == objects.TYPE_VOID {
        ret = op == OP_EQUAL || op == OP_CONTAINS || op == OP_LISTING
    } else if lt == objects.TYPE_FTFACE {
        if op == OP_EQUAL || op == OP_CONTAINS || op == OP_LISTING {
            ret = lw == rw
        } else if op == OP_NOT_EQUAL || op == OP_NOT_CONTAINS {
            ret = lw != rw
        }
    } else if lt == objects.TYPE_RANGE {
        ret = rangeCompare(op, @intCast(usize, lw), @intCast(usize, rw))
    }
    if madeLeft { release(lt, lw) }
    if madeRight { release(rt, rw) }
    return ret
}

// C's (int) of a double, and Fontconfig's FcDoubleFloor and the others.
fn cInt(d: f64) -> i64 { return pattern.truncate(d) }
fn ceilOf(d: f64) -> i64 {
    if @floatFromInt(f64, cInt(d)) == d { return cInt(d) }
    return cInt(d + 1.0)
}
fn floorOf(d: f64) -> i64 { return if d >= 0.0 { cInt(d) } else { 0 - ceilOf(0.0 - d) } }
fn ceilSigned(d: f64) -> i64 { return if d >= 0.0 { ceilOf(d) } else { 0 - cInt(0.0 - d) } }

// FcConfigEvaluate: the value of `e` for the pattern `p` (`pPat` the
// pattern a font is matched to, for <name target="pattern">), owned by
// the caller.
pub fn evaluate(p: usize, pPat: usize, kind: i64, e: usize) -> (i64, u64) {
    const op = opOf(exprOp(e))
    if op == OP_INTEGER { return (objects.TYPE_INTEGER, exprWord(e, 1)) }
    if op == OP_DOUBLE { return (objects.TYPE_DOUBLE, exprWord(e, 1)) }
    if op == OP_STRING {
        const s = mem.dupC(@intCast(usize, exprWord(e, 1)))
        if s == 0 { return (objects.TYPE_VOID, 0) }
        return (objects.TYPE_STRING, @intCast(u64, s))
    }
    if op == OP_MATRIX {
        var m: [4]f64 = [4]f64{ 0.0, 0.0, 0.0, 0.0 }
        var ok = true
        var k: usize = 0
        while k < 4 {
            const v = evaluate(p, pPat, kind, @intCast(usize, exprWord(e, k + 1)))
            const pv = promote(v.0, v.1, objects.TYPE_MATRIX, false)
            if pv.0 == objects.TYPE_DOUBLE { m[k] = toDouble(pv.1) } else { ok = false }
            release(v.0, v.1)
            k += 1
        }
        if !ok { return (objects.TYPE_VOID, 0) }
        const result = mem.alloc(32)
        if result == 0 { return (objects.TYPE_VOID, 0) }
        mem.putF64(result, m[0])
        mem.putF64(result + 8, m[1])
        mem.putF64(result + 16, m[2])
        mem.putF64(result + 24, m[3])
        return (objects.TYPE_MATRIX, @intCast(u64, result))
    }
    if op == OP_CHARSET { return (objects.TYPE_CHARSET, @intCast(u64, charset.reference(@intCast(usize, exprWord(e, 1))))) }
    if op == OP_LANGSET { return (objects.TYPE_LANGSET, @intCast(u64, lang.copy(@intCast(usize, exprWord(e, 1))))) }
    if op == OP_RANGE { return (objects.TYPE_RANGE, @intCast(u64, value.rangeCopy(@intCast(usize, exprWord(e, 1))))) }
    if op == OP_BOOL { return (objects.TYPE_BOOL, exprWord(e, 1)) }
    if op == OP_FIELD {
        const object = @bitCast(i64, exprWord(e, 1))
        const target = @bitCast(i64, exprWord(e, 2))
        var source = p
        if kind == MATCH_FONT && target == MATCH_PATTERN {
            source = pPat
        } else if kind == MATCH_PATTERN && target == MATCH_FONT {
            return (objects.TYPE_VOID, 0)
        }
        var at: usize = 0
        if pattern.get(source, object, 0, &at) != pattern.RESULT_MATCH { return (objects.TYPE_VOID, 0) }
        const t = value.typeOf(at)
        const w = value.ownedWord(t, value.wordOf(at))
        if value.ownsPointer(t) && w == 0 { return (objects.TYPE_VOID, 0) }
        return (t, w)
    }
    if op == OP_CONST {
        var c: i64 = 0
        if objects.constantValue(@intCast(usize, exprWord(e, 1)), &c) { return (objects.TYPE_INTEGER, value.intWord(c)) }
        return (objects.TYPE_VOID, 0)
    }
    if op == OP_QUEST {
        const condition = evaluate(p, pPat, kind, @intCast(usize, exprWord(e, 1)))
        const branches = @intCast(usize, exprWord(e, 2))
        var result = (objects.TYPE_VOID, @intCast(u64, 0))
        if condition.0 == objects.TYPE_BOOL {
            const pick = if toInt(condition.1) != 0 { exprWord(branches, 1) } else { exprWord(branches, 2) }
            result = evaluate(p, pPat, kind, @intCast(usize, pick))
        }
        release(condition.0, condition.1)
        return result
    }
    if op == OP_EQUAL || op == OP_NOT_EQUAL || op == OP_LESS || op == OP_LESS_EQUAL || op == OP_MORE || op == OP_MORE_EQUAL || op == OP_CONTAINS || op == OP_NOT_CONTAINS || op == OP_LISTING {
        const l = evaluate(p, pPat, kind, @intCast(usize, exprWord(e, 1)))
        const r = evaluate(p, pPat, kind, @intCast(usize, exprWord(e, 2)))
        const b = compareValue(l.0, l.1, exprOp(e), r.0, r.1)
        release(l.0, l.1)
        release(r.0, r.1)
        return (objects.TYPE_BOOL, if b { 1 } else { 0 })
    }
    if op == OP_OR || op == OP_AND || op == OP_PLUS || op == OP_MINUS || op == OP_TIMES || op == OP_DIVIDE {
        const l = evaluate(p, pPat, kind, @intCast(usize, exprWord(e, 1)))
        const r = evaluate(p, pPat, kind, @intCast(usize, exprWord(e, 2)))
        const result = arithmetic(op, l.0, l.1, r.0, r.1)
        release(l.0, l.1)
        release(r.0, r.1)
        return result
    }
    if op == OP_NOT {
        const l = evaluate(p, pPat, kind, @intCast(usize, exprWord(e, 1)))
        var result = (objects.TYPE_VOID, @intCast(u64, 0))
        if l.0 == objects.TYPE_BOOL { result = (objects.TYPE_BOOL, if toInt(l.1) != 0 { 0 } else { 1 }) }
        release(l.0, l.1)
        return result
    }
    if op == OP_FLOOR || op == OP_CEIL || op == OP_ROUND || op == OP_TRUNC {
        const l = evaluate(p, pPat, kind, @intCast(usize, exprWord(e, 1)))
        var result = (objects.TYPE_VOID, @intCast(u64, 0))
        if l.0 == objects.TYPE_INTEGER {
            result = l
        } else if l.0 == objects.TYPE_DOUBLE {
            const d = toDouble(l.1)
            var i: i64 = 0
            if op == OP_FLOOR {
                i = floorOf(d)
            } else if op == OP_CEIL {
                i = ceilSigned(d)
            } else if op == OP_ROUND {
                i = floorOf(d + 0.5)
            } else {
                i = if d >= 0.0 { cInt(d) } else { 0 - cInt(0.0 - d) }
            }
            result = (objects.TYPE_INTEGER, value.intWord(i))
        } else {
            release(l.0, l.1)
        }
        return result
    }
    return (objects.TYPE_VOID, 0)
}

// The arithmetic and logic of two values (both kept by the caller): doubles
// (a whole result an integer), bools, strings joined, matrices
// multiplied, charsets and langsets united or subtracted.
fn arithmetic(op: i64, lt: i64, lw: u64, rt: i64, rw: u64) -> (i64, u64) {
    const pl = promote(lt, lw, rt, true)
    const pr = promote(rt, rw, pl.0, true)
    var result = (objects.TYPE_VOID, @intCast(u64, 0))
    if pl.0 == pr.0 {
        const t = pl.0
        if t == objects.TYPE_DOUBLE {
            const a = toDouble(pl.1)
            const b = toDouble(pr.1)
            var ok = true
            var d: f64 = 0.0
            if op == OP_PLUS {
                d = a + b
            } else if op == OP_MINUS {
                d = a - b
            } else if op == OP_TIMES {
                d = a * b
            } else if op == OP_DIVIDE {
                d = a / b
            } else {
                ok = false
            }
            if ok {
                result = (objects.TYPE_DOUBLE, @bitCast(u64, d))
                // (An integral result becomes an integer written over the
                // low half of the double, its high half left in the
                // value's word as Fontconfig's union leaves it: what
                // reads the value as a double, as FcDefaultSubstitute
                // reads a pixel size, sees nearly the double.)
                if d == d && d < 2147483648.0 && d > -2147483649.0 && @floatFromInt(f64, cInt(d)) == d { result = (objects.TYPE_INTEGER, (@bitCast(u64, d) & 0xffffffff00000000) | value.intWord(cInt(d))) }
            }
        } else if t == objects.TYPE_BOOL {
            if op == OP_OR {
                result = (objects.TYPE_BOOL, if toInt(pl.1) != 0 || toInt(pr.1) != 0 { 1 } else { 0 })
            } else if op == OP_AND {
                result = (objects.TYPE_BOOL, if toInt(pl.1) != 0 && toInt(pr.1) != 0 { 1 } else { 0 })
            }
        } else if t == objects.TYPE_STRING {
            if op == OP_PLUS {
                var b: mem.Buffer = undefined
                mem.initBuffer(&b)
                _ = mem.appendC(&b, @intCast(usize, pl.1))
                _ = mem.appendC(&b, @intCast(usize, pr.1))
                const s = mem.takeBuffer(&b)
                if s != 0 { result = (objects.TYPE_STRING, @intCast(u64, s)) }
            }
        } else if t == objects.TYPE_MATRIX {
            if op == OP_TIMES {
                const m = mem.alloc(32)
                if m != 0 {
                    value.matrixMultiply(m, @intCast(usize, pl.1), @intCast(usize, pr.1))
                    result = (objects.TYPE_MATRIX, @intCast(u64, m))
                }
            }
        } else if t == objects.TYPE_CHARSET {
            var cs: usize = 0
            if op == OP_PLUS {
                cs = charset.unite(@intCast(usize, pl.1), @intCast(usize, pr.1))
            } else if op == OP_MINUS {
                cs = charset.subtract(@intCast(usize, pl.1), @intCast(usize, pr.1))
            }
            if cs != 0 { result = (objects.TYPE_CHARSET, @intCast(u64, cs)) }
        } else if t == objects.TYPE_LANGSET {
            var ls: usize = 0
            if op == OP_PLUS {
                ls = lang.unite(@intCast(usize, pl.1), @intCast(usize, pr.1))
            } else if op == OP_MINUS {
                ls = lang.subtract(@intCast(usize, pl.1), @intCast(usize, pr.1))
            }
            if ls != 0 { result = (objects.TYPE_LANGSET, @intCast(u64, ls)) }
        }
    }
    if pl.2 { release(pl.0, pl.1) }
    if pr.2 { release(pr.0, pr.1) }
    return result
}

// ---------------------------------------------------------------------------
// Substitution.

// The values of `e` (a comma list) as a value list of the binding, voids
// left out (FcConfigValues).
fn valuesOf(p: usize, pPat: usize, kind: i64, e: usize, binding: i64) -> usize {
    if e == 0 { return 0 }
    var head: usize = 0
    var tail: usize = 0
    var at = e
    while at != 0 {
        var v = (objects.TYPE_VOID, @intCast(u64, 0))
        if opOf(exprOp(at)) == OP_COMMA {
            v = evaluate(p, pPat, kind, @intCast(usize, exprWord(at, 1)))
            at = @intCast(usize, exprWord(at, 2))
        } else {
            v = evaluate(p, pPat, kind, at)
            at = 0
        }
        if v.0 == objects.TYPE_VOID { continue }
        const n = value.nodeTaking(v.0, v.1, binding)
        if n == 0 {
            release(v.0, v.1)
            continue
        }
        if tail == 0 { head = n } else { value.setNext(tail, n) }
        tail = n
    }
    return head
}

// FcConfigMatchValueList: the value of `values` the test matches (the
// first, for qual any; the first of all of them matching, for qual all),
// 0 when it does not match.
fn matchValueList(p: usize, pPat: usize, kind: i64, t: usize, values: usize) -> usize {
    var result: usize = 0
    var e = testExpr(t)
    while e != 0 {
        var v = (objects.TYPE_VOID, @intCast(u64, 0))
        if opOf(exprOp(e)) == OP_COMMA {
            v = evaluate(p, pPat, kind, @intCast(usize, exprWord(e, 1)))
            e = @intCast(usize, exprWord(e, 2))
        } else {
            v = evaluate(p, pPat, kind, e)
            e = 0
        }
        var l = values
        while l != 0 {
            const at = value.valueOf(l)
            if compareValue(value.typeOf(at), value.wordOf(at), testOp(t), v.0, v.1) {
                if result == 0 { result = l }
                if testQual(t) != QUAL_ALL { break }
            } else if testQual(t) == QUAL_ALL {
                result = 0
                break
            }
            l = value.next(l)
        }
        release(v.0, v.1)
    }
    return result
}

// FcConfigAdd: `list` (taken) put in the values of the element `e`, after
// (`append`) or before `position` (a node of them; 0: at the end or the
// start); its bindings `same` take the position's.
fn addValues(e: usize, position: usize, append: bool, list: usize, object: i64) -> bool {
    var l = list
    while l != 0 {
        if !objects.validType(object, value.typeOf(value.valueOf(l))) {
            value.destroyList(list)
            return false
        }
        l = value.next(l)
    }
    const sameBinding = if position != 0 { value.bindingOf(position) } else { value.BINDING_WEAK }
    l = list
    while l != 0 {
        if value.bindingOf(l) == value.BINDING_SAME { value.setBinding(l, sameBinding) }
        l = value.next(l)
    }
    if list == 0 { return true }
    const tail = value.last(list)
    if append {
        if position != 0 {
            value.setNext(tail, value.next(position))
            value.setNext(position, list)
        } else {
            const last = value.last(pattern.eltValues(e))
            if last == 0 { pattern.setEltValues(e, list) } else { value.setNext(last, list) }
        }
    } else {
        // (Before `position`, or at the start when it is not in the list.)
        var previous: usize = 0
        var at = pattern.eltValues(e)
        if position != 0 {
            while at != 0 && at != position {
                previous = at
                at = value.next(at)
            }
        }
        if position == 0 || at == 0 {
            if position != 0 && at == 0 {
                // (Fontconfig appends when the position is not on the list.)
                const last = value.last(pattern.eltValues(e))
                if last == 0 { pattern.setEltValues(e, list) } else { value.setNext(last, list) }
                return true
            }
            value.setNext(tail, pattern.eltValues(e))
            pattern.setEltValues(e, list)
        } else {
            value.setNext(tail, at)
            if previous == 0 { pattern.setEltValues(e, list) } else { value.setNext(previous, list) }
        }
    }
    return true
}

// FcConfigDel: the node `position` taken out of the element's values.
fn delValue(e: usize, position: usize) -> void {
    var previous: usize = 0
    var at = pattern.eltValues(e)
    while at != 0 {
        if at == position {
            if previous == 0 { pattern.setEltValues(e, value.next(at)) } else { value.setNext(previous, value.next(at)) }
            value.setNext(at, 0)
            value.destroyList(at)
            return
        }
        previous = at
        at = value.next(at)
    }
}

// The pattern's element of `object` emptied (not taken out).
fn delAll(p: usize, object: i64) -> void {
    const e = pattern.findElt(p, object)
    if e == 0 { return }
    value.destroyList(pattern.eltValues(e))
    pattern.setEltValues(e, 0)
}

fn patternAddList(p: usize, object: i64, list: usize, append: bool) -> void {
    if list == 0 { return }
    const e = pattern.insertElt(p, object)
    if e == 0 {
        value.destroyList(list)
        return
    }
    _ = addValues(e, 0, append, list, object)
}

// An element left without values taken out (FcConfigPatternCanon).
fn canon(p: usize, object: i64) -> void {
    const e = pattern.findElt(p, object)
    if e != 0 && pattern.eltValues(e) == 0 { _ = pattern.del(p, object) }
}

// The slot of an object in the per-rule tables: the built-in objects by
// number, the others after them.
fn slotOf(object: i64) -> usize {
    if object <= objects.MAX_BASE { return @intCast(usize, object) }
    return @intCast(usize, objects.MAX_BASE + 1 + (object - 1079))
}

// FcConfigSubstituteWithPat.
pub fn substituteWithPat(c: usize, p: usize, pPat: usize, kind: i64) -> bool {
    if kind < MATCH_PATTERN || kind > MATCH_SCAN || c == 0 || p == 0 { return false }
    if kind == MATCH_PATTERN {
        addDefaultLangs(p)
        var prg: usize = 0
        if pattern.get(p, objects.PRGNAME, 0, &prg) == pattern.RESULT_NO_MATCH {
            const name = programName()
            if name != 0 { _ = pattern.addString(p, objects.PRGNAME, name) }
        }
    }
    // Per rule: the element, the matched value and the test of each object
    // a test names (three words a slot).
    const slots = slotOf(objects.idLimit()) + 1
    const table = mem.alloc(slots * 24)
    if table == 0 { return false }
    var rule = mem.getWord(c + CONFIG_RULES + @intCast(usize, kind) * 8)
    while rule != 0 {
        mem.zero(table, slots * 24)
        var it = mem.getWord(rule + 8)
        var matched = true
        while it != 0 && matched {
            if itemKind(it) == ITEM_TEST {
                const t = itemPayload(it)
                const object = testObject(t)
                const slot = slotOf(object)
                if slot >= slots {
                    matched = false
                    break
                }
                var m = p
                if kind == MATCH_FONT && testKind(t) == MATCH_PATTERN { m = pPat }
                var e: usize = 0
                if m != 0 { e = pattern.findElt(m, object) }
                if mem.getWord(table + slot * 24) == 0 && kind == testKind(t) {
                    mem.putWord(table + slot * 24, e)
                    mem.putWord(table + slot * 24 + 16, t)
                }
                if e == 0 {
                    if testQual(t) == QUAL_ALL {
                        mem.putWord(table + slot * 24 + 8, 0)
                        it = itemNext(it)
                        continue
                    }
                    matched = false
                    break
                }
                const vl = matchValueList(m, pPat, kind, t, pattern.eltValues(e))
                if mem.getWord(table + slot * 24 + 8) == 0 && kind == testKind(t) { mem.putWord(table + slot * 24 + 8, vl) }
                if vl == 0 || (testQual(t) == QUAL_FIRST && vl != pattern.eltValues(e)) || (testQual(t) == QUAL_NOT_FIRST && vl == pattern.eltValues(e)) {
                    matched = false
                    break
                }
            } else {
                applyEdit(p, pPat, kind, itemPayload(it), table, slots)
            }
            it = itemNext(it)
        }
        rule = mem.getWord(rule)
    }
    mem.free(table)
    return true
}

fn applyEdit(p: usize, pPat: usize, kind: i64, ed: usize, table: usize, slots: usize) -> void {
    const object = editObject(ed)
    const slot = slotOf(object)
    if slot >= slots { return }
    const list = valuesOf(p, pPat, kind, editExpr(ed), editBinding(ed))
    const t = mem.getWord(table + slot * 24 + 16)
    if t != 0 && (testKind(t) == MATCH_FONT || kind == MATCH_PATTERN) { mem.putWord(table + slot * 24, pattern.findElt(p, testObject(t))) }
    const e = mem.getWord(table + slot * 24)
    const matched = mem.getWord(table + slot * 24 + 8)
    const op = opOf(editOp(ed))
    if op == OP_ASSIGN && matched != 0 {
        // The matched value replaced by the list (kept where it was).
        _ = addValues(e, matched, true, list, object)
        delValue(e, matched)
        mem.putWord(table + slot * 24 + 8, list)
    } else if op == OP_ASSIGN || op == OP_ASSIGN_REPLACE {
        delAll(p, object)
        patternAddList(p, object, list, true)
        mem.putWord(table + slot * 24 + 8, 0)
    } else if op == OP_PREPEND && matched != 0 {
        _ = addValues(e, matched, false, list, object)
    } else if op == OP_PREPEND || op == OP_PREPEND_FIRST {
        patternAddList(p, object, list, false)
    } else if op == OP_APPEND && matched != 0 {
        _ = addValues(e, matched, true, list, object)
    } else if op == OP_APPEND || op == OP_APPEND_LAST {
        patternAddList(p, object, list, true)
    } else if op == OP_DELETE && matched != 0 {
        delValue(e, matched)
        value.destroyList(list)
    } else if op == OP_DELETE || op == OP_DELETE_ALL {
        delAll(p, object)
        value.destroyList(list)
    } else {
        value.destroyList(list)
    }
    canon(p, object)
}

pub fn substitute(c: usize, p: usize, kind: i64) -> bool { return substituteWithPat(c, p, 0, kind) }

// The default languages added to a pattern's "lang" (weak) up to the
// first it has already, or "und" ("undetermined") it has.
fn addDefaultLangs(p: usize) -> void {
    const langs = lang.defaultLangs()
    const und = mem.dupText("und")
    var k: usize = 0
    while k < strset.size(langs) {
        const l = strset.at(langs, k)
        const e = pattern.findElt(p, objects.LANG)
        if e != 0 {
            var v = pattern.eltValues(e)
            while v != 0 {
                const at = value.valueOf(v)
                if value.typeOf(at) == objects.TYPE_LANGSET {
                    const ls = lang.create()
                    _ = lang.add(ls, l)
                    const has = lang.containsSet(value.pointerOf(at), ls)
                    lang.destroy(ls)
                    const lsund = lang.create()
                    _ = lang.add(lsund, und)
                    const hasUnd = lang.containsSet(value.pointerOf(at), lsund)
                    lang.destroy(lsund)
                    if has || hasUnd {
                        mem.free(und)
                        return
                    }
                } else if value.typeOf(at) == objects.TYPE_STRING {
                    if strings.cmpIgnoreCase(value.pointerOf(at), l) == 0 || strings.cmpIgnoreCase(value.pointerOf(at), und) == 0 {
                        mem.free(und)
                        return
                    }
                }
                v = value.next(v)
            }
        }
        _ = pattern.addWithBinding(p, objects.LANG, objects.TYPE_STRING, @intCast(u64, l), value.BINDING_WEAK, true)
        k += 1
    }
    mem.free(und)
}

var prgname: usize = 0
var prgnameDone: bool = false
var prgnameGuard: u32 = 0

// The program's name (the base name of /proc/self/exe), 0 when unknown.
pub fn programName() -> usize {
    mem.lock(&prgnameGuard)
    if !prgnameDone {
        prgnameDone = true
        const buffer = mem.alloc(4097)
        const path = mem.dupText("/proc/self/exe")
        const n = linux.syscall3(linux.SYS_readlink, path, buffer, 4096)
        mem.free(path)
        if n > 0 {
            const length = @bitCast(usize, n)
            var start = length
            while start > 0 && mem.get8(buffer + start - 1) != 47 { start -= 1 }
            if start < length { prgname = mem.dup(buffer + start, length - start) }
        }
        mem.free(buffer)
    }
    mem.unlock(&prgnameGuard)
    return prgname
}

// FcDefaultSubstitute: weight, slant and width normal, the booleans'
// defaults, the size from the pixel size or the pixel size from the
// size (12 points, 75 dots per inch, scale 1), the font version, hinting
// style, the languages of names (the default language, then "en-us"
// weakly), the program, the desktop, the order.
pub fn defaultSubstitute(p: usize) -> void {
    if pattern.findElt(p, objects.WEIGHT) == 0 { _ = pattern.addInteger(p, objects.WEIGHT, 80) }
    if pattern.findElt(p, objects.SLANT) == 0 { _ = pattern.addInteger(p, objects.SLANT, 0) }
    if pattern.findElt(p, objects.WIDTH) == 0 { _ = pattern.addInteger(p, objects.WIDTH, 100) }
    if pattern.findElt(p, objects.HINTING) == 0 { _ = pattern.addBool(p, objects.HINTING, 1) }
    if pattern.findElt(p, objects.VERTICAL_LAYOUT) == 0 { _ = pattern.addBool(p, objects.VERTICAL_LAYOUT, 0) }
    if pattern.findElt(p, objects.AUTOHINT) == 0 { _ = pattern.addBool(p, objects.AUTOHINT, 0) }
    if pattern.findElt(p, objects.GLOBAL_ADVANCE) == 0 { _ = pattern.addBool(p, objects.GLOBAL_ADVANCE, 1) }
    if pattern.findElt(p, objects.EMBEDDED_BITMAP) == 0 { _ = pattern.addBool(p, objects.EMBEDDED_BITMAP, 1) }
    if pattern.findElt(p, objects.DECORATIVE) == 0 { _ = pattern.addBool(p, objects.DECORATIVE, 0) }
    if pattern.findElt(p, objects.SYMBOL) == 0 { _ = pattern.addBool(p, objects.SYMBOL, 0) }
    if pattern.findElt(p, objects.VARIABLE) == 0 { _ = pattern.addBool(p, objects.VARIABLE, 0) }
    var size: f64 = 0.0
    if pattern.getDouble(p, objects.SIZE, 0, &size) != pattern.RESULT_MATCH {
        var r: usize = 0
        if pattern.getPointer(p, objects.SIZE, 0, objects.TYPE_RANGE, &r) == pattern.RESULT_MATCH {
            size = (value.rangeBegin(r) + value.rangeEnd(r)) * 0.5
        } else {
            size = 12.0
        }
    }
    var scale: f64 = 0.0
    if pattern.getDouble(p, objects.SCALE, 0, &scale) != pattern.RESULT_MATCH { scale = 1.0 }
    var dpi: f64 = 0.0
    if pattern.getDouble(p, objects.DPI, 0, &dpi) != pattern.RESULT_MATCH { dpi = 75.0 }
    const pixel = pattern.findElt(p, objects.PIXEL_SIZE)
    if pixel == 0 {
        _ = pattern.del(p, objects.SCALE)
        _ = pattern.addDouble(p, objects.SCALE, scale)
        var pixelSize = size * scale
        _ = pattern.del(p, objects.DPI)
        _ = pattern.addDouble(p, objects.DPI, dpi)
        pixelSize = pixelSize * (dpi / 72.0)
        _ = pattern.addDouble(p, objects.PIXEL_SIZE, pixelSize)
    } else {
        // (The first value read as a double whatever its type, as
        // Fontconfig reads `u.d`.)
        size = value.doubleOf(value.valueOf(pattern.eltValues(pixel)))
        size = size / dpi * 72.0 / scale
    }
    _ = pattern.del(p, objects.SIZE)
    _ = pattern.addDouble(p, objects.SIZE, size)
    if pattern.findElt(p, objects.FONTVERSION) == 0 { _ = pattern.addInteger(p, objects.FONTVERSION, 0x7fffffff) }
    if pattern.findElt(p, objects.HINT_STYLE) == 0 { _ = pattern.addInteger(p, objects.HINT_STYLE, 3) }
    if pattern.findElt(p, objects.NAMELANG) == 0 { _ = pattern.addString(p, objects.NAMELANG, lang.defaultLang()) }
    var namelang: usize = 0
    _ = pattern.get(p, objects.NAMELANG, 0, &namelang)
    const t = value.typeOf(namelang)
    const w = value.wordOf(namelang)
    const enUs = mem.dupText("en-us")
    var k: i64 = objects.FAMILYLANG
    while k <= objects.FULLNAMELANG {
        if pattern.findElt(p, k) == 0 {
            _ = pattern.add(p, k, t, w, true)
            _ = pattern.addWithBinding(p, k, objects.TYPE_STRING, @intCast(u64, enUs), value.BINDING_WEAK, true)
        }
        k += 2
    }
    mem.free(enUs)
    var v: usize = 0
    if pattern.get(p, objects.PRGNAME, 0, &v) == pattern.RESULT_NO_MATCH {
        const name = programName()
        if name != 0 { _ = pattern.addString(p, objects.PRGNAME, name) }
    }
    if pattern.get(p, objects.DESKTOP_NAME, 0, &v) == pattern.RESULT_NO_MATCH {
        const desktop = env.getNonEmpty("XDG_CURRENT_DESKTOP")
        if desktop != 0 { _ = pattern.addString(p, objects.DESKTOP_NAME, desktop) }
    }
    if pattern.findElt(p, objects.ORDER) == 0 { _ = pattern.addInteger(p, objects.ORDER, 0) }
}

// ---------------------------------------------------------------------------
// Fonts accepted and rejected.

// FcListPatternMatchAny: whether the font has, for each element of `p`,
// a value containing each of its values (strings equal ignoring blanks
// and case).
pub fn listPatternMatchAny(p: usize, font: usize) -> bool {
    if p == 0 { return false }
    var i: usize = 0
    while i < pattern.count(p) {
        const pe = pattern.elt(p, i)
        const object = pattern.eltObject(pe)
        if object != objects.NAMELANG {
            const fe = pattern.findElt(font, object)
            if fe == 0 { return false }
            var pv = pattern.eltValues(pe)
            while pv != 0 {
                var found = false
                var fv = pattern.eltValues(fe)
                while fv != 0 {
                    const a = value.valueOf(fv)
                    const b = value.valueOf(pv)
                    if compareValue(value.typeOf(a), value.wordOf(a), OP_LISTING | FLAG_IGNORE_BLANKS, value.typeOf(b), value.wordOf(b)) {
                        found = true
                        break
                    }
                    fv = value.next(fv)
                }
                if !found { return false }
                pv = value.next(pv)
            }
        }
        i += 1
    }
    return true
}

fn globsMatch(globs: usize, s: usize) -> bool {
    var i: usize = 0
    while i < strset.size(globs) {
        if strings.globMatch(strset.at(globs, i), s) { return true }
        i += 1
    }
    return false
}

pub fn acceptFilename(c: usize, file: usize) -> bool {
    if globsMatch(mem.getWord(c + CONFIG_ACCEPT_GLOBS), file) { return true }
    if globsMatch(mem.getWord(c + CONFIG_REJECT_GLOBS), file) { return false }
    return true
}

fn patternsMatch(fs: usize, font: usize) -> bool {
    var i: usize = 0
    while i < pattern.fontSetCount(fs) {
        if listPatternMatchAny(pattern.fontSetFont(fs, i), font) { return true }
        i += 1
    }
    return false
}

pub fn acceptFont(c: usize, font: usize) -> bool {
    if patternsMatch(mem.getWord(c + CONFIG_ACCEPT_PATTERNS), font) { return true }
    if patternsMatch(mem.getWord(c + CONFIG_REJECT_PATTERNS), font) { return false }
    return true
}
