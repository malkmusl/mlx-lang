// std.fontconfig.lang: languages and sets of them (FcLangSet), as
// Fontconfig 2.15 has them. The languages with an orthography
// (data.mlx, Fontconfig's fc-lang) are kept in order of their names,
// each with its bit in a langset's map (the position of its file in
// fc-lang's list) and its characters; a langset is that map of 279 bits
// and the other languages added to it as strings (`extra`).
//
// A font supports a language when its charset has every character of the
// language's orthography (FcFreeTypeLangSet); fonts that say in their
// OS/2 table that they are for one CJK language (Japanese, Simplified or
// Traditional Chinese, Korean) only support those of the four whose
// orthography has as many pages as that one's.
//
// A langset is a record reached by its address:
//     0  the extra languages (a strset, 0 for none)
//     8  the map: MAP_WORDS 32-bit words
const mem = @import("./mem.mlx")
const strings = @import("./strings.mlx")
const strset = @import("./strset.mlx")
const charset = @import("./charset.mlx")
const env = @import("./env.mlx")
const data = @import("./data.mlx")

pub const MAP_WORDS: usize = (data.LANG_COUNT + 31) / 32
pub const RECORD_SIZE: usize = 8 + MAP_WORDS * 4

// FcLangResult.
pub const EQUAL: i64 = 0
pub const DIFFERENT_COUNTRY: i64 = 1
pub const DIFFERENT_TERRITORY: i64 = 1
pub const DIFFERENT_LANG: i64 = 2

// ---------------------------------------------------------------------------
// The languages: names (C strings), bits and charsets by their order, and
// the language of each bit; read from data.mlx when first needed.

var names: usize = 0
var bits: usize = 0
var charsets: usize = 0
var ofBit: usize = 0
// The languages with territories, by language (fcLangCountrySets): records
// of the language's name (a C string) and a map.
var countrySets: usize = 0
var countrySetCount: usize = 0
var loaded: bool = false
var guard: u32 = 0

pub fn count() -> usize { return data.LANG_COUNT }

fn load() -> void {
    if @atomicLoad(bool, &loaded, acquire) { return }
    mem.lock(&guard)
    if !loaded {
        names = mem.alloc(data.LANG_COUNT * 8)
        bits = mem.alloc(data.LANG_COUNT * 8)
        charsets = mem.alloc(data.LANG_COUNT * 8)
        ofBit = mem.alloc(data.LANG_COUNT * 8)
        countrySets = mem.alloc(data.LANG_COUNT * 16)
        const text = data.LANGS
        var at: usize = 0
        var i: usize = 0
        while i < data.LANG_COUNT && at < text.length {
            var stop = at
            while stop < text.length && text[stop] != 32 { stop += 1 }
            const name = mem.dupText(text[at..stop])
            mem.putWord(names + i * 8, name)
            at = stop + 1
            var bit: usize = 0
            while at < text.length && text[at] >= 48 && text[at] <= 57 {
                bit = bit * 10 + @intCast(usize, text[at] - 48)
                at += 1
            }
            mem.putWord(bits + i * 8, bit)
            mem.putWord(ofBit + bit * 8, i)
            var end: usize = at
            const cs = charset.fromRanges(text, at, &end)
            // (Constant: shared by every caller, never freed.)
            if cs != 0 { mem.put64(cs, @bitCast(u64, @intCast(i64, -1))) }
            mem.putWord(charsets + i * 8, cs)
            at = end + 1
            addCountry(name, bit)
            i += 1
        }
        @atomicStore(bool, &loaded, true, release)
    }
    mem.unlock(&guard)
}

// A language with a territory ("zh-cn") put in its language's country set.
fn addCountry(name: usize, bit: usize) -> void {
    var dash: usize = 0
    while mem.get8(name + dash) != 0 && mem.get8(name + dash) != 45 { dash += 1 }
    if mem.get8(name + dash) != 45 { return }
    var i: usize = 0
    while i < countrySetCount {
        const other = mem.getWord(countrySets + i * 16)
        if mem.cLength(other) == dash && mem.same(mem.view(other, dash), mem.view(name, dash)) { break }
        i += 1
    }
    if i == countrySetCount {
        mem.putWord(countrySets + i * 16, mem.dup(name, dash))
        mem.putWord(countrySets + i * 16 + 8, mem.alloc(MAP_WORDS * 4))
        countrySetCount += 1
    }
    const map = mem.getWord(countrySets + i * 16 + 8)
    mem.put32(map + (bit >> 5) * 4, mem.get32(map + (bit >> 5) * 4) | ((@intCast(u64, 1) << (bit & 31)) & 0xffffffff))
}

// The name (a C string), charset and bit of the language at `index` (in
// the order of names).
pub fn nameAt(index: usize) -> usize {
    load()
    return mem.getWord(names + index * 8)
}

pub fn charsetAt(index: usize) -> usize {
    load()
    return mem.getWord(charsets + index * 8)
}

fn bitOf(index: usize) -> usize { return mem.getWord(bits + index * 8) }

// The language index of `lang` (FcLangSetIndex), or -(the index it would
// have) - 1 when it has no orthography.
pub fn index(lang: usize) -> i64 {
    load()
    var low: i64 = 0
    var high: i64 = @intCast(i64, data.LANG_COUNT) - 1
    var c: i64 = 0
    var mid: i64 = 0
    while low <= high {
        mid = (low + high) >> 1
        c = strings.cmpIgnoreCase(mem.getWord(names + @intCast(usize, mid) * 8), lang)
        if c == 0 { return mid }
        if c < 0 { low = mid + 1 } else { high = mid - 1 }
    }
    if c < 0 { mid += 1 }
    return 0 - (mid + 1)
}

fn isLangEnd(c: u64) -> bool { return c == 45 || c == 0 }

// FcLangCompare: the same language and territory, the same language, or
// not ("und" is a different language from everything, "und-x" no more).
pub fn compare(s1: usize, s2: usize) -> i64 {
    var result = DIFFERENT_LANG
    var isUnd = strings.lower(mem.get8(s1)) == 117 && strings.lower(mem.get8(s1 + 1)) == 110 && strings.lower(mem.get8(s1 + 2)) == 100 && isLangEnd(mem.get8(s1 + 3))
    var i: usize = 0
    while true {
        const c1 = strings.lower(mem.get8(s1 + i))
        const c2 = strings.lower(mem.get8(s2 + i))
        i += 1
        if c1 != c2 {
            if !isUnd && isLangEnd(c1) && isLangEnd(c2) { result = DIFFERENT_TERRITORY }
            return result
        } else if c1 == 0 {
            return if isUnd { result } else { EQUAL }
        } else if c1 == 45 {
            if !isUnd { result = DIFFERENT_TERRITORY }
        }
        if isUnd && i == 4 { isUnd = false }
    }
    return result
}

// FcLangContains: `superLang` the same language as `sub`, and the same
// territory or one of them without one.
fn contains(superLang: usize, sub: usize) -> bool {
    var i: usize = 0
    while true {
        const c1 = strings.lower(mem.get8(superLang + i))
        const c2 = strings.lower(mem.get8(sub + i))
        i += 1
        if c1 != c2 {
            if c1 == 45 && c2 == 0 { return true }
            if c1 == 0 && c2 == 45 { return true }
            return false
        } else if c1 == 0 {
            return true
        }
    }
    return false
}

// FcLangGetCharSet: the orthography of `lang`, or of a language of it
// with another territory; 0 when none.
pub fn getCharSet(lang: usize) -> usize {
    load()
    var country: i64 = -1
    var i: usize = 0
    while i < data.LANG_COUNT {
        const r = compare(lang, mem.getWord(names + i * 8))
        if r == EQUAL { return mem.getWord(charsets + i * 8) }
        if r == DIFFERENT_TERRITORY && country == -1 { country = @intCast(i64, i) }
        i += 1
    }
    if country == -1 { return 0 }
    return mem.getWord(charsets + @intCast(usize, country) * 8)
}

// ---------------------------------------------------------------------------
// Langsets.

pub fn create() -> usize { return mem.alloc(RECORD_SIZE) }

pub fn destroy(ls: usize) -> void {
    if ls == 0 { return }
    strset.destroy(mem.getWord(ls))
    mem.free(ls)
}

pub fn copy(ls: usize) -> usize {
    if ls == 0 { return 0 }
    const result = create()
    if result == 0 { return 0 }
    mem.copy(result + 8, ls + 8, MAP_WORDS * 4)
    const extra = mem.getWord(ls)
    if extra != 0 {
        const copied = strset.duplicate(extra)
        if copied == 0 {
            destroy(result)
            return 0
        }
        mem.putWord(result, copied)
    }
    return result
}

fn mapWord(ls: usize, word: usize) -> u64 { return mem.get32(ls + 8 + word * 4) }

fn bitGet(ls: usize, index: usize) -> bool {
    const bit = bitOf(index)
    return ((mapWord(ls, bit >> 5) >> (bit & 31)) & 1) != 0
}

fn bitSet(ls: usize, index: usize, on: bool) -> void {
    const bit = bitOf(index)
    const word = ls + 8 + (bit >> 5) * 4
    const mask = (@intCast(u64, 1) << (bit & 31)) & 0xffffffff
    if on { mem.put32(word, mem.get32(word) | mask) } else { mem.put32(word, mem.get32(word) & (0xffffffff ^ mask)) }
}

// The langset's extra languages (a strset, made when first needed).
fn extraOf(ls: usize) -> usize {
    if mem.getWord(ls) == 0 { mem.putWord(ls, strset.create()) }
    return mem.getWord(ls)
}

pub fn add(ls: usize, lang: usize) -> bool {
    if ls == 0 || lang == 0 { return false }
    const id = index(lang)
    if id >= 0 {
        bitSet(ls, @intCast(usize, id), true)
        return true
    }
    const extra = extraOf(ls)
    if extra == 0 { return false }
    return strset.add(extra, lang)
}

pub fn del(ls: usize, lang: usize) -> bool {
    const id = index(lang)
    if id >= 0 {
        bitSet(ls, @intCast(usize, id), false)
    } else if mem.getWord(ls) != 0 {
        _ = strset.del(mem.getWord(ls), lang)
    }
    return true
}

// FcLangSetHasLang: how near the langset comes to `lang`.
pub fn hasLang(ls: usize, lang: usize) -> i64 {
    var id = index(lang)
    if id < 0 {
        id = 0 - id - 1
    } else if bitGet(ls, @intCast(usize, id)) {
        return EQUAL
    }
    var best = DIFFERENT_LANG
    var i = id - 1
    while i >= 0 {
        const r = compare(lang, mem.getWord(names + @intCast(usize, i) * 8))
        if r == DIFFERENT_LANG { break }
        if bitGet(ls, @intCast(usize, i)) && r < best { best = r }
        i -= 1
    }
    i = id
    while i < @intCast(i64, data.LANG_COUNT) {
        const r = compare(lang, mem.getWord(names + @intCast(usize, i) * 8))
        if r == DIFFERENT_LANG { break }
        if bitGet(ls, @intCast(usize, i)) && r < best { best = r }
        i += 1
    }
    const extra = mem.getWord(ls)
    if extra != 0 {
        var k: usize = 0
        while best > EQUAL && k < strset.size(extra) {
            const r = compare(lang, strset.at(extra, k))
            if r < best { best = r }
            k += 1
        }
    }
    return best
}

fn compareStrSet(ls: usize, set: usize) -> i64 {
    var best = DIFFERENT_LANG
    var k: usize = 0
    while best > EQUAL && k < strset.size(set) {
        const r = hasLang(ls, strset.at(set, k))
        if r < best { best = r }
        k += 1
    }
    return best
}

// FcLangSetCompare: a language in both, or languages of one language with
// territories in both, or neither.
pub fn compareSets(a: usize, b: usize) -> i64 {
    load()
    var i: usize = 0
    while i < MAP_WORDS {
        if (mapWord(a, i) & mapWord(b, i)) != 0 { return EQUAL }
        i += 1
    }
    var best = DIFFERENT_LANG
    var j: usize = 0
    while j < countrySetCount {
        const map = mem.getWord(countrySets + j * 16 + 8)
        var inA: u64 = 0
        var inB: u64 = 0
        i = 0
        while i < MAP_WORDS {
            inA |= mapWord(a, i) & mem.get32(map + i * 4)
            inB |= mapWord(b, i) & mem.get32(map + i * 4)
            if inA != 0 && inB != 0 {
                best = DIFFERENT_TERRITORY
                break
            }
            i += 1
        }
        j += 1
    }
    if mem.getWord(a) != 0 {
        const r = compareStrSet(b, mem.getWord(a))
        if r < best { best = r }
    }
    if best > EQUAL && mem.getWord(b) != 0 {
        const r = compareStrSet(a, mem.getWord(b))
        if r < best { best = r }
    }
    return best
}

fn containsLang(ls: usize, lang: usize) -> bool {
    var id = index(lang)
    if id < 0 {
        id = 0 - id - 1
    } else if bitGet(ls, @intCast(usize, id)) {
        return true
    }
    var i = id - 1
    while i >= 0 {
        const name = mem.getWord(names + @intCast(usize, i) * 8)
        if compare(name, lang) == DIFFERENT_LANG { break }
        if bitGet(ls, @intCast(usize, i)) && contains(name, lang) { return true }
        i -= 1
    }
    i = id
    while i < @intCast(i64, data.LANG_COUNT) {
        const name = mem.getWord(names + @intCast(usize, i) * 8)
        if compare(name, lang) == DIFFERENT_LANG { break }
        if bitGet(ls, @intCast(usize, i)) && contains(name, lang) { return true }
        i += 1
    }
    const extra = mem.getWord(ls)
    if extra != 0 {
        var k: usize = 0
        while k < strset.size(extra) {
            if contains(strset.at(extra, k), lang) { return true }
            k += 1
        }
    }
    return false
}

// FcLangSetContains: whether `a` has every language of `b`.
pub fn containsSet(a: usize, b: usize) -> bool {
    load()
    var i: usize = 0
    while i < MAP_WORDS {
        const missing = mapWord(b, i) & (0xffffffff ^ mapWord(a, i))
        if missing != 0 {
            var j: u64 = 0
            while j < 32 {
                if ((missing >> j) & 1) != 0 {
                    const bit = i * 32 + @intCast(usize, j)
                    if !containsLang(a, mem.getWord(names + mem.getWord(ofBit + bit * 8) * 8)) { return false }
                }
                j += 1
            }
        }
        i += 1
    }
    const extra = mem.getWord(b)
    if extra != 0 {
        var k: usize = 0
        while k < strset.size(extra) {
            if !containsLang(a, strset.at(extra, k)) { return false }
            k += 1
        }
    }
    return true
}

pub fn equal(a: usize, b: usize) -> bool {
    var i: usize = 0
    while i < MAP_WORDS {
        if mapWord(a, i) != mapWord(b, i) { return false }
        i += 1
    }
    const ea = mem.getWord(a)
    const eb = mem.getWord(b)
    if ea == 0 && eb == 0 { return true }
    if ea != 0 && eb != 0 { return strset.equal(ea, eb) }
    return false
}

// FcLangSetHash (32-bit).
pub fn hash(ls: usize) -> u64 {
    var h: u64 = 0
    var i: usize = 0
    while i < MAP_WORDS {
        h ^= mapWord(ls, i)
        i += 1
    }
    if mem.getWord(ls) != 0 { h ^= @intCast(u64, strset.size(mem.getWord(ls))) }
    return h
}

// The languages of the set (FcLangSetGetLangs): those with an orthography
// in the order of their names, then the others.
pub fn getLangs(ls: usize) -> usize {
    load()
    const set = strset.create()
    if set == 0 { return 0 }
    var i: usize = 0
    while i < data.LANG_COUNT {
        if bitGet(ls, i) { _ = strset.add(set, mem.getWord(names + i * 8)) }
        i += 1
    }
    const extra = mem.getWord(ls)
    var k: usize = 0
    while k < strset.size(extra) {
        _ = strset.add(set, strset.at(extra, k))
        k += 1
    }
    return set
}

// FcLangSetUnion and FcLangSetSubtract: copies of `a` with the languages
// of `b` added or taken out.
pub fn unite(a: usize, b: usize) -> usize { return operate(a, b, true) }
pub fn subtract(a: usize, b: usize) -> usize { return operate(a, b, false) }

fn operate(a: usize, b: usize, adding: bool) -> usize {
    const result = copy(a)
    if result == 0 { return 0 }
    const langs = getLangs(b)
    var k: usize = 0
    while k < strset.size(langs) {
        if adding { _ = add(result, strset.at(langs, k)) } else { _ = del(result, strset.at(langs, k)) }
        k += 1
    }
    strset.destroy(langs)
    return result
}

// The languages `|`-separated, in the order of their bits and then the
// extra ones (FcNameUnparseLangSet).
pub fn unparse(b: *mem.Buffer, ls: usize) -> bool {
    load()
    var first = true
    var i: usize = 0
    while i < MAP_WORDS {
        const word = mapWord(ls, i)
        if word != 0 {
            var bit: u64 = 0
            while bit < 32 {
                if ((word >> bit) & 1) != 0 {
                    if !first { if !mem.appendByte(b, 124) { return false } }
                    const id = mem.getWord(ofBit + (i * 32 + @intCast(usize, bit)) * 8)
                    if !mem.appendC(b, mem.getWord(names + id * 8)) { return false }
                    first = false
                }
                bit += 1
            }
        }
        i += 1
    }
    const extra = mem.getWord(ls)
    var k: usize = 0
    while k < strset.size(extra) {
        if !first { if !mem.appendByte(b, 124) { return false } }
        if !mem.appendC(b, strset.at(extra, k)) { return false }
        first = false
        k += 1
    }
    return true
}

// FcNameParseLangSet: languages separated by `|` (each at most 31 bytes).
pub fn parse(text: usize) -> usize {
    const ls = create()
    if ls == 0 { return 0 }
    const buffer = mem.alloc(32)
    if buffer == 0 {
        destroy(ls)
        return 0
    }
    var at = text
    while true {
        var i: usize = 0
        var c: u64 = 0
        while i < 31 {
            c = mem.get8(at)
            at += 1
            if c == 0 || c == 124 { break }
            mem.put8(buffer + i, c)
            i += 1
        }
        mem.put8(buffer + i, 0)
        if !add(ls, buffer) {
            mem.free(buffer)
            destroy(ls)
            return 0
        }
        if c == 0 { break }
    }
    mem.free(buffer)
    return ls
}

// FcFreeTypeLangSet: the languages whose every character `cs` has; with an
// `exclusive` language (one of the four CJK of the font's OS/2 code
// pages), the other three left out unless their orthographies have as
// many pages as its.
pub fn ofCharSet(cs: usize, exclusive: usize) -> usize {
    load()
    var exclusiveCharSet: usize = 0
    if exclusive != 0 { exclusiveCharSet = getCharSet(exclusive) }
    const ls = create()
    if ls == 0 { return 0 }
    var i: usize = 0
    while i < data.LANG_COUNT {
        const langCs = mem.getWord(charsets + i * 8)
        var skip = false
        if exclusiveCharSet != 0 && isExclusive(mem.getWord(names + i * 8)) {
            if charset.pageCount(langCs) != charset.pageCount(exclusiveCharSet) { skip = true }
        }
        if !skip && charset.subtractCount(langCs, cs) == 0 { bitSet(ls, i, true) }
        i += 1
    }
    return ls
}

// The CJK languages a font's OS/2 code page bits name: ja (17), zh-cn
// (18), ko (19), zh-tw (20).
pub fn codePageLang(bit: usize) -> []const u8 {
    if bit == 17 { return "ja" }
    if bit == 18 { return "zh-cn" }
    if bit == 19 { return "ko" }
    return "zh-tw"
}

pub fn isExclusive(lang: usize) -> bool {
    var bit: usize = 17
    while bit <= 20 {
        const name = mem.dupText(codePageLang(bit))
        const r = compare(lang, name)
        mem.free(name)
        if r == EQUAL { return true }
        bit += 1
    }
    return false
}

// ---------------------------------------------------------------------------
// Locales and the default languages.

// FcLangNormalize: a locale name ("de_DE.UTF-8@euro", "C") as the language
// Fontconfig knows ("de", "en"): the territory kept when there is an
// orthography for it; a new C string, 0 when it is no language.
pub fn normalize(lang: usize) -> usize {
    if lang == 0 || mem.get8(lang) == 0 { return 0 }
    if strings.isIgnoreCase(lang, "C") || strings.isIgnoreCase(lang, "C.UTF-8") || strings.isIgnoreCase(lang, "C.utf8") || strings.isIgnoreCase(lang, "POSIX") { return mem.dupText("en") }
    const s = mem.dupC(lang)
    if s == 0 { return 0 }
    const length = mem.cLength(s)
    // The modifier, the encoding (cut, the modifier moved over it) and the
    // territory.
    var modifier: usize = 0
    var i: usize = 0
    while i < length && mem.get8(s + i) != 64 { i += 1 }
    if i < length {
        mem.put8(s + i, 0)
        modifier = s + i + 1
    }
    i = 0
    while mem.get8(s + i) != 0 && mem.get8(s + i) != 46 { i += 1 }
    if mem.get8(s + i) == 46 {
        mem.put8(s + i, 0)
        const encoding = s + i + 1
        if modifier != 0 {
            mem.copy(encoding, modifier, mem.cLength(modifier) + 1)
            modifier = encoding
        }
    }
    var territory: usize = 0
    i = 0
    while mem.get8(s + i) != 0 && mem.get8(s + i) != 95 { i += 1 }
    if mem.get8(s + i) == 0 {
        i = 0
        while mem.get8(s + i) != 0 && mem.get8(s + i) != 45 { i += 1 }
    }
    var tlen: usize = 0
    if mem.get8(s + i) != 0 {
        mem.put8(s + i, 0)
        territory = s + i + 1
        tlen = mem.cLength(territory)
    }
    const llen = mem.cLength(s)
    if llen < 2 || llen > 3 {
        mem.free(s)
        return 0
    }
    if territory != 0 && (tlen < 2 || tlen > 3) && !(mem.get8(territory) == 122 && tlen < 5) {
        mem.free(s)
        return 0
    }
    if territory != 0 { mem.put8(territory - 1, 45) }
    if modifier != 0 { mem.put8(modifier - 1, 64) }
    const original = strings.downcase(s)
    var result: usize = 0
    if territory != 0 {
        if index(s) < 0 {
            // (The territory taken out, the modifier moved up.)
            const mlen = if modifier != 0 { mem.cLength(modifier) } else { 0 }
            mem.copy(territory - 1, territory + tlen, (if mlen > 0 { mlen + 1 } else { 0 }) + 1)
            if modifier != 0 { modifier = territory }
        } else {
            mem.free(original)
            return s
        }
    }
    if modifier != 0 {
        if index(s) < 0 {
            mem.put8(modifier - 1, 0)
        } else {
            mem.free(original)
            return s
        }
    }
    if index(s) < 0 {
        result = original
        mem.free(s)
    } else {
        result = s
        mem.free(original)
    }
    return result
}

// FcStrSetAddLangs: the `:`-separated locales of `languages` normalized
// into `set`; whether any was.
pub fn addLangs(set: usize, languages: usize) -> bool {
    var ok = false
    var at = languages
    const buffer = mem.alloc(128)
    if buffer == 0 { return false }
    while true {
        var n: usize = 0
        while mem.get8(at + n) != 0 && mem.get8(at + n) != 58 { n += 1 }
        const last = mem.get8(at + n) == 0
        const length = if n > 127 { 127 } else { n }
        mem.copy(buffer, at, length)
        mem.put8(buffer + length, 0)
        if length > 0 {
            const normalized = normalize(buffer)
            if normalized != 0 {
                _ = strset.add(set, normalized)
                mem.free(normalized)
                ok = true
            }
        }
        if last { break }
        at += n + 1
    }
    mem.free(buffer)
    return ok
}

var defaults: usize = 0
var defaultsGuard: u32 = 0

// FcGetDefaultLangs: the languages of FC_LANG, else LC_ALL, else LC_CTYPE
// (not "UTF-8"), else LANG; "en" when none (a strset kept for the
// process: not to be destroyed).
pub fn defaultLangs() -> usize {
    mem.lock(&defaultsGuard)
    if defaults == 0 {
        const set = strset.create()
        var langs = env.getNonEmpty("FC_LANG")
        if langs == 0 { langs = env.getNonEmpty("LC_ALL") }
        if langs == 0 {
            langs = env.getNonEmpty("LC_CTYPE")
            if langs != 0 && strings.isIgnoreCase(langs, "UTF-8") { langs = 0 }
        }
        if langs == 0 { langs = env.getNonEmpty("LANG") }
        if langs != 0 {
            if !addLangs(set, langs) { _ = strset.addText(set, "en") }
        } else {
            _ = strset.addText(set, "en")
        }
        defaults = set
    }
    mem.unlock(&defaultsGuard)
    return defaults
}

// FcGetDefaultLang: the first of them.
pub fn defaultLang() -> usize { return strset.at(defaultLangs(), 0) }
