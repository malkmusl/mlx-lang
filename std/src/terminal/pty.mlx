// std.terminal.pty: a program on a pseudo-terminal, for a terminal
// emulator: the master side stays with the emulator (read what the
// program writes, write what the user types), the program runs on the
// slave side as a session leader with the slave as its controlling
// terminal and its standard descriptors.
//
//     var child: pty.Child = undefined
//     if !pty.spawn(&child, path, argv, envp, 80, 24) { ... }
//     const got = pty.read(&child, buffer, capacity)    // EAGAIN: nothing yet;
//                                                        // 0 or EIO: it ended
//     pty.write(&child, bytes, length)
//     pty.resize(&child, columns, rows)                  // SIGWINCH to the program
//     const status = pty.wait(&child)                    // null: still running
const std = @import("std")

const SYS_read: usize = 0
const SYS_write: usize = 1
const SYS_close: usize = 3
const SYS_ioctl: usize = 16
const SYS_dup2: usize = 33
const SYS_fork: usize = 57
const SYS_execve: usize = 59
const SYS_wait4: usize = 61
const SYS_kill: usize = 62
const SYS_fcntl: usize = 72
const SYS_setsid: usize = 112
const SYS_rt_sigprocmask: usize = 14
const SYS_exit_group: usize = 231
const SYS_openat: usize = 257

const AT_FDCWD: usize = 18446744073709551516
const O_RDWR: usize = 2
const O_NOCTTY: usize = 256
const O_NONBLOCK: usize = 2048
const O_CLOEXEC: usize = 524288
const TIOCSPTLCK: usize = 1074025521
const TIOCGPTN: usize = 2147767344
const TIOCSWINSZ: usize = 21524
const TIOCSCTTY: usize = 21518
const F_SETFL: usize = 4
const WNOHANG: usize = 1
const SIGHUP: usize = 1

pub const EAGAIN: isize = -11
pub const EIO: isize = -5

pub const Child = struct {
    master: isize
    pid: isize
    // Set once wait() saw it end: its exit code, or 128 plus the signal.
    ended: bool
    status: usize
}

fn windowSize(columns: u16, rows: u16, size: [*]u8) -> void {
    size[0] = @intCast(u8, rows & 255)
    size[1] = @intCast(u8, rows >> 8)
    size[2] = @intCast(u8, columns & 255)
    size[3] = @intCast(u8, columns >> 8)
    size[4] = 0
    size[5] = 0
    size[6] = 0
    size[7] = 0
}

// Opens a pty of `columns` x `rows`, forks, and runs `path` with
// `arguments` and `environment` (null-terminated pointer arrays) on the
// slave side. False when a step fails.
pub fn spawn(child: *Child, path: [*]const u8, arguments: [*][*]const u8, environment: [*][*]const u8, columns: u16, rows: u16) -> bool {
    var ptmx: usize = 0
    unsafe { ptmx = @intFromPtr(@ptrCast([*]const u8, "/dev/ptmx")) }
    const master = std.linux.syscall4(SYS_openat, AT_FDCWD, ptmx, O_RDWR | O_NOCTTY | O_CLOEXEC, 0)
    if master < 0 { return false }
    var unlock: u32 = 0
    if std.linux.syscall3(SYS_ioctl, @bitCast(usize, master), TIOCSPTLCK, @intFromPtr(&unlock)) < 0 { return false }
    var number: u32 = 0
    if std.linux.syscall3(SYS_ioctl, @bitCast(usize, master), TIOCGPTN, @intFromPtr(&number)) < 0 { return false }
    var size: [8]u8 = undefined
    var size_bytes: [*]u8 = undefined
    unsafe { size_bytes = @ptrCast([*]u8, &size) }
    windowSize(columns, rows, size_bytes)
    const sized = std.linux.syscall3(SYS_ioctl, @bitCast(usize, master), TIOCSWINSZ, @intFromPtr(&size))
    // "/dev/pts/NUMBER"
    var slave_path: [32]u8 = undefined
    var length: usize = 0
    for byte in "/dev/pts/" {
        slave_path[length] = byte
        length += 1
    }
    var digits: [12]u8 = undefined
    var count: usize = 0
    var rest = number
    if rest == 0 {
        digits[0] = 48
        count = 1
    }
    while rest > 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    while count > 0 {
        count -= 1
        slave_path[length] = digits[count]
        length += 1
    }
    slave_path[length] = 0
    const pid = std.linux.syscall0(SYS_fork)
    if pid < 0 { return false }
    if pid == 0 {
        // Signals the emulator blocked are the program's to take.
        var none: [2]usize = [2]usize{ 0, 0 }
        const unblocked = std.linux.syscall4(SYS_rt_sigprocmask, 2, @intFromPtr(&none), 0, 8)
        const session = std.linux.syscall0(SYS_setsid)
        const slave = std.linux.syscall4(SYS_openat, AT_FDCWD, @intFromPtr(&slave_path), O_RDWR, 0)
        if slave < 0 { const failed = std.linux.syscall1(SYS_exit_group, 127) }
        const controlling = std.linux.syscall3(SYS_ioctl, @bitCast(usize, slave), TIOCSCTTY, 0)
        const standard_input = std.linux.syscall2(SYS_dup2, @bitCast(usize, slave), 0)
        const standard_output = std.linux.syscall2(SYS_dup2, @bitCast(usize, slave), 1)
        const standard_error = std.linux.syscall2(SYS_dup2, @bitCast(usize, slave), 2)
        if slave > 2 { const closed = std.linux.syscall1(SYS_close, @bitCast(usize, slave)) }
        const executed = std.linux.syscall3(SYS_execve, @intFromPtr(path), @intFromPtr(arguments), @intFromPtr(environment))
        const exited = std.linux.syscall1(SYS_exit_group, 127)
    }
    const nonblocking = std.linux.syscall3(SYS_fcntl, @bitCast(usize, master), F_SETFL, O_RDWR | O_NONBLOCK)
    child.*.master = master
    child.*.pid = pid
    child.*.ended = false
    child.*.status = 0
    return true
}

// Tells the program its new size (the kernel sends SIGWINCH).
pub fn resize(child: *const Child, columns: u16, rows: u16) -> void {
    var size: [8]u8 = undefined
    var size_bytes: [*]u8 = undefined
    unsafe { size_bytes = @ptrCast([*]u8, &size) }
    windowSize(columns, rows, size_bytes)
    const sized = std.linux.syscall3(SYS_ioctl, @bitCast(usize, child.*.master), TIOCSWINSZ, @intFromPtr(&size))
}

// What the program wrote: the bytes, EAGAIN for none yet, 0 or EIO once
// it has closed its side.
pub fn read(child: *const Child, buffer: [*]u8, capacity: usize) -> isize {
    return std.linux.syscall3(SYS_read, @bitCast(usize, child.*.master), @intFromPtr(buffer), capacity)
}

pub fn write(child: *const Child, bytes: [*]const u8, length: usize) -> void {
    var sent: usize = 0
    while sent < length {
        const result = std.linux.syscall3(SYS_write, @bitCast(usize, child.*.master), @intFromPtr(bytes) + sent, length - sent)
        if result == EAGAIN { continue }
        if result <= 0 { return }
        sent += @bitCast(usize, result)
    }
}

// Whether the program ended (without blocking); its status then.
pub fn wait(child: *Child) -> ?usize {
    if child.*.ended { return child.*.status }
    var raw: [4]u8 = [4]u8{ 0, 0, 0, 0 }
    const waited = std.linux.syscall4(SYS_wait4, @bitCast(usize, child.*.pid), @intFromPtr(&raw), WNOHANG, 0)
    if waited != child.*.pid { return null }
    const status = @intCast(usize, raw[0]) | (@intCast(usize, raw[1]) << 8)
    child.*.ended = true
    child.*.status = if status & 127 == 0 { (status >> 8) & 255 } else { 128 + (status & 127) }
    return child.*.status
}

// Ends the program (SIGHUP, as a closed terminal does) and the pty.
pub fn hangUp(child: *Child) -> void {
    if !child.*.ended { const signalled = std.linux.syscall2(SYS_kill, @bitCast(usize, child.*.pid), SIGHUP) }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, child.*.master))
    var raw: [4]u8 = [4]u8{ 0, 0, 0, 0 }
    const waited = std.linux.syscall4(SYS_wait4, @bitCast(usize, child.*.pid), @intFromPtr(&raw), WNOHANG, 0)
}

pub fn milliseconds() -> usize { return std.time.milliseconds() }
