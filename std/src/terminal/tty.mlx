// std.terminal.tty: the terminal a program runs on (Linux): whether a
// descriptor is one, its size, its modes (termios) and raw mode for a
// line editor, and its foreground process group for a shell's job
// control.
//
//     if tty.isTerminal(1) { ... }
//     const width = tty.columns(1)                  // 0 when unknown
//
//     var cooked: tty.Termios = undefined
//     if tty.getAttributes(0, &cooked) {
//         var raw: tty.Termios = undefined
//         tty.makeRaw(&cooked, &raw)
//         _ = tty.setAttributes(0, &raw)            // keys as they come
//         ...
//         _ = tty.setAttributes(0, &cooked)         // as it was
//     }
//
//     _ = tty.setProcessGroup(pid, pid)              // a job's own group
//     _ = tty.setForegroundGroup(0, pid)             // the terminal is the job's
const linux = @import("../../bootstrap/os/linux.mlx")

const SYS_ioctl: usize = 16
const SYS_setpgid: usize = 109
const SYS_getpgrp: usize = 111

const TCGETS: usize = 21505
const TCSETS: usize = 21506
const TIOCGWINSZ: usize = 21523
const TIOCGPGRP: usize = 21519
const TIOCSPGRP: usize = 21520

// The mode bits makeRaw clears: c_iflag's ICRNL and IXON, c_lflag's
// ICANON, ECHO, ISIG and IEXTEN.
pub const ICRNL: u32 = 256
pub const IXON: u32 = 1024
pub const ISIG: u32 = 1
pub const ICANON: u32 = 2
pub const ECHO: u32 = 8
pub const IEXTEN: u32 = 32768
// Places in c_cc.
pub const VTIME: usize = 5
pub const VMIN: usize = 6

// The kernel's termios as TCGETS gives it: c_iflag, c_oflag, c_cflag
// and c_lflag (4 bytes each), c_line, c_cc[19], then room to spare.
pub const Termios = struct {
    bytes: [60]u8
}

// A terminal's size in characters (0 when unknown).
pub const Size = struct {
    rows: u16
    columns: u16
}

fn ioctl(descriptor: isize, request: usize, argument: usize) -> isize {
    return linux.syscall3(SYS_ioctl, @bitCast(usize, descriptor), request, argument)
}

pub fn getAttributes(descriptor: isize, termios: *Termios) -> bool {
    return ioctl(descriptor, TCGETS, @intFromPtr(termios)) == 0
}

// The modes at once (TCSETS: without waiting for output to drain).
pub fn setAttributes(descriptor: isize, termios: *const Termios) -> bool {
    return ioctl(descriptor, TCSETS, @intFromPtr(termios)) == 0
}

// Whether `descriptor` is a terminal (it has modes).
pub fn isTerminal(descriptor: isize) -> bool {
    var termios: Termios = undefined
    return getAttributes(descriptor, &termios)
}

fn load32(bytes: [*]const u8, at: usize) -> u32 {
    return @intCast(u32, bytes[at]) | (@intCast(u32, bytes[at + 1]) << 8) | (@intCast(u32, bytes[at + 2]) << 16) | (@intCast(u32, bytes[at + 3]) << 24)
}

fn store32(bytes: [*]u8, at: usize, value: u32) -> void {
    bytes[at] = @intCast(u8, value & 255)
    bytes[at + 1] = @intCast(u8, (value >> 8) & 255)
    bytes[at + 2] = @intCast(u8, (value >> 16) & 255)
    bytes[at + 3] = @intCast(u8, (value >> 24) & 255)
}

// `raw` from `cooked`: no echo, no line editing by the kernel, no
// signals from keys, carriage returns as they are, no flow control; a
// read returns as soon as one byte is there.
pub fn makeRaw(cooked: *const Termios, raw: *Termios) -> void {
    const from: [*]const u8 = &cooked.*.bytes
    const into: [*]u8 = &raw.*.bytes
    var index: usize = 0
    while index < 60 {
        into[index] = from[index]
        index += 1
    }
    store32(into, 0, load32(from, 0) & ((ICRNL | IXON) ^ 4294967295))
    store32(into, 12, load32(from, 12) & ((ICANON | ECHO | ISIG | IEXTEN) ^ 4294967295))
    // c_cc starts at 17, after c_line.
    into[17 + VMIN] = 1
    into[17 + VTIME] = 0
}

// The terminal's size; false when `descriptor` is no terminal.
pub fn windowSize(descriptor: isize, size: *Size) -> bool {
    // struct winsize: rows, columns, then the pixel sizes.
    var words: [4]u16 = [4]u16{ 0, 0, 0, 0 }
    if ioctl(descriptor, TIOCGWINSZ, @intFromPtr(&words)) != 0 { return false }
    size.*.rows = words[0]
    size.*.columns = words[1]
    return true
}

// Columns of the terminal, 0 when unknown.
pub fn columns(descriptor: isize) -> usize {
    var size = Size.{ .rows = 0, .columns = 0 }
    if !windowSize(descriptor, &size) { return 0 }
    return @intCast(usize, size.columns)
}

// Rows of the terminal, 0 when unknown.
pub fn rows(descriptor: isize) -> usize {
    var size = Size.{ .rows = 0, .columns = 0 }
    if !windowSize(descriptor, &size) { return 0 }
    return @intCast(usize, size.rows)
}

// The terminal's foreground process group, -1 when it has none or
// `descriptor` is no terminal.
pub fn foregroundGroup(descriptor: isize) -> isize {
    var group: i32 = 0
    if ioctl(descriptor, TIOCGPGRP, @intFromPtr(&group)) != 0 { return -1 }
    return @intCast(isize, group)
}

// Makes `group` the terminal's foreground process group (a process
// outside it that reads or writes the terminal is stopped).
pub fn setForegroundGroup(descriptor: isize, group: isize) -> bool {
    var value: i32 = @intCast(i32, group)
    return ioctl(descriptor, TIOCSPGRP, @intFromPtr(&value)) == 0
}

// Puts process `pid` (0: this one) into process group `group` (0: a
// group of its own, numbered as it); 0 or a negative errno.
pub fn setProcessGroup(pid: isize, group: isize) -> isize {
    return linux.syscall2(SYS_setpgid, @bitCast(usize, pid), @bitCast(usize, group))
}

// This process's group.
pub fn processGroup() -> isize { return linux.syscall0(SYS_getpgrp) }
