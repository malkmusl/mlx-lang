// std.terminal.keys: what a key sends to the program in a terminal. A key
// arrives as std.ui gives it: its Linux key code, the modifiers held
// (std.ui.keys: SHIFT, CONTROL, ALT, SUPER), the text it types with those
// modifiers (UTF-8 from the keymap; empty for a key that types nothing or
// a control combination) and the text it types without Control and Alt
// (for Ctrl+C on any layout).
//
//     var bytes: [16]u8 = undefined
//     const length = keys.encode(key, modifiers, typed, plain, screen.applicationCursor, screen.newlineMode, &bytes)
//     pty.write(&child, &bytes, length)
//
// The encoding is xterm's: cursor and function keys as CSI sequences (SS3
// in application cursor mode), with the modifier parameter when any is
// held; Alt as an ESC prefix; Control with a letter as the control
// character; Backspace as DEL (Ctrl+Backspace as BS); Shift+Tab as CSI Z.
const std = @import("std")
const ui_keys = @import("std.ui.keys")

const KEY_ESC: u32 = 1
const KEY_BACKSPACE: u32 = 14
const KEY_TAB: u32 = 15
const KEY_ENTER: u32 = 28
const KEY_SPACE: u32 = 57
const KEY_F1: u32 = 59
const KEY_F10: u32 = 68
const KEY_KP7: u32 = 71
const KEY_KP8: u32 = 72
const KEY_KP9: u32 = 73
const KEY_KP4: u32 = 75
const KEY_KP6: u32 = 77
const KEY_KP1: u32 = 79
const KEY_KP2: u32 = 80
const KEY_KP3: u32 = 81
const KEY_KP0: u32 = 82
const KEY_KPDOT: u32 = 83
const KEY_F11: u32 = 87
const KEY_F12: u32 = 88
const KEY_KPENTER: u32 = 96
const KEY_HOME: u32 = 102
const KEY_UP: u32 = 103
const KEY_PAGEUP: u32 = 104
const KEY_LEFT: u32 = 105
const KEY_RIGHT: u32 = 106
const KEY_END: u32 = 107
const KEY_DOWN: u32 = 108
const KEY_PAGEDOWN: u32 = 109
const KEY_INSERT: u32 = 110
const KEY_DELETE: u32 = 111

fn put(out: [*]u8, at: *usize, byte: u8) -> void {
    out[at.*] = byte
    at.* += 1
}

fn putText(out: [*]u8, at: *usize, text: []const u8) -> void {
    for byte in text { put(out, at, byte) }
}

// xterm's modifier parameter: 1 + Shift 1 + Alt 2 + Control 4 + Super 8.
fn modifierParameter(modifiers: u32) -> u32 {
    var value: u32 = 1
    if modifiers & ui_keys.SHIFT != 0 { value += 1 }
    if modifiers & ui_keys.ALT != 0 { value += 2 }
    if modifiers & ui_keys.CONTROL != 0 { value += 4 }
    if modifiers & ui_keys.SUPER != 0 { value += 8 }
    return value
}

// CSI 1 ; MODIFIER FINAL, or CSI FINAL (SS3 FINAL in application mode)
// without modifiers.
fn cursorKey(out: [*]u8, at: *usize, final: u8, modifiers: u32, application: bool) -> void {
    put(out, at, 27)
    const parameter = modifierParameter(modifiers)
    if parameter == 1 {
        put(out, at, if application { 79 } else { 91 })
        put(out, at, final)
        return
    }
    put(out, at, 91)
    put(out, at, 49)
    put(out, at, 59)
    put(out, at, @intCast(u8, 48 + parameter % 10))
    put(out, at, final)
}

// CSI NUMBER ~, or CSI NUMBER ; MODIFIER ~ with modifiers.
fn tildeKey(out: [*]u8, at: *usize, number: u32, modifiers: u32) -> void {
    put(out, at, 27)
    put(out, at, 91)
    if number >= 10 { put(out, at, @intCast(u8, 48 + number / 10)) }
    put(out, at, @intCast(u8, 48 + number % 10))
    const parameter = modifierParameter(modifiers)
    if parameter != 1 {
        put(out, at, 59)
        if parameter >= 10 { put(out, at, 49) }
        put(out, at, @intCast(u8, 48 + parameter % 10))
    }
    put(out, at, 126)
}

// A keypad key without Num Lock stands for a cursor key (the keymap then
// types nothing for it).
fn keypadAs(key: u32) -> u32 {
    if key == KEY_KP7 { return KEY_HOME }
    if key == KEY_KP8 { return KEY_UP }
    if key == KEY_KP9 { return KEY_PAGEUP }
    if key == KEY_KP4 { return KEY_LEFT }
    if key == KEY_KP6 { return KEY_RIGHT }
    if key == KEY_KP1 { return KEY_END }
    if key == KEY_KP2 { return KEY_DOWN }
    if key == KEY_KP3 { return KEY_PAGEDOWN }
    if key == KEY_KP0 { return KEY_INSERT }
    if key == KEY_KPDOT { return KEY_DELETE }
    return key
}

// The control character of a key's plain text under Control, or 256 for
// none: letters, and the usual @ [ \ ] ^ _ ? and digits.
fn controlCharacter(plain: []const u8) -> u32 {
    if plain.length != 1 { return 256 }
    const byte = plain[0]
    if byte >= 97 && byte <= 122 { return @intCast(u32, byte - 96) }
    if byte >= 65 && byte <= 90 { return @intCast(u32, byte - 64) }
    if byte == 32 || byte == 64 || byte == 50 { return 0 }
    if byte == 91 || byte == 51 { return 27 }
    if byte == 92 || byte == 52 { return 28 }
    if byte == 93 || byte == 53 { return 29 }
    if byte == 94 || byte == 54 { return 30 }
    if byte == 95 || byte == 55 || byte == 45 || byte == 47 { return 31 }
    if byte == 63 || byte == 56 { return 127 }
    return 256
}

// The bytes key `given_key` sends (at most 16 into `out`); 0 for a key
// that sends nothing (a modifier, an unknown key).
pub fn encode(given_key: u32, modifiers: u32, typed: []const u8, plain: []const u8, application_cursor: bool, newline_mode: bool, out: [*]u8) -> usize {
    var at: usize = 0
    const alt = modifiers & ui_keys.ALT != 0
    const control = modifiers & ui_keys.CONTROL != 0
    const shift = modifiers & ui_keys.SHIFT != 0
    const key = if typed.length == 0 { keypadAs(given_key) } else { given_key }
    if key == KEY_ENTER || key == KEY_KPENTER {
        if alt { put(out, &at, 27) }
        put(out, &at, 13)
        if newline_mode { put(out, &at, 10) }
        return at
    }
    if key == KEY_TAB {
        if shift {
            put(out, &at, 27)
            put(out, &at, 91)
            put(out, &at, 90)
            return at
        }
        if alt { put(out, &at, 27) }
        put(out, &at, 9)
        return at
    }
    if key == KEY_BACKSPACE {
        if alt { put(out, &at, 27) }
        put(out, &at, if control { 8 } else { 127 })
        return at
    }
    if key == KEY_ESC {
        if alt { put(out, &at, 27) }
        put(out, &at, 27)
        return at
    }
    if key == KEY_UP || key == KEY_DOWN || key == KEY_RIGHT || key == KEY_LEFT || key == KEY_HOME || key == KEY_END {
        var final: u8 = 65
        if key == KEY_DOWN { final = 66 }
        if key == KEY_RIGHT { final = 67 }
        if key == KEY_LEFT { final = 68 }
        if key == KEY_HOME { final = 72 }
        if key == KEY_END { final = 70 }
        cursorKey(out, &at, final, modifiers, application_cursor)
        return at
    }
    if key == KEY_INSERT || key == KEY_DELETE || key == KEY_PAGEUP || key == KEY_PAGEDOWN {
        var number: u32 = 2
        if key == KEY_DELETE { number = 3 }
        if key == KEY_PAGEUP { number = 5 }
        if key == KEY_PAGEDOWN { number = 6 }
        tildeKey(out, &at, number, modifiers)
        return at
    }
    if key >= KEY_F1 && key <= KEY_F1 + 3 {
        // F1..F4: SS3 P..S, CSI 1 ; MODIFIER P..S with modifiers.
        cursorKey(out, &at, @intCast(u8, 80 + (key - KEY_F1)), modifiers, true)
        return at
    }
    if (key >= KEY_F1 + 4 && key <= KEY_F10) || key == KEY_F11 || key == KEY_F12 {
        var number: u32 = 15
        if key == KEY_F1 + 5 { number = 17 }
        if key == KEY_F1 + 6 { number = 18 }
        if key == KEY_F1 + 7 { number = 19 }
        if key == KEY_F1 + 8 { number = 20 }
        if key == KEY_F10 { number = 21 }
        if key == KEY_F11 { number = 23 }
        if key == KEY_F12 { number = 24 }
        tildeKey(out, &at, number, modifiers)
        return at
    }
    if control {
        const character = controlCharacter(plain)
        if character != 256 {
            if alt { put(out, &at, 27) }
            put(out, &at, @intCast(u8, character))
            return at
        }
    }
    if typed.length > 0 && typed.length <= 8 {
        if alt { put(out, &at, 27) }
        putText(out, &at, typed)
        return at
    }
    return 0
}
