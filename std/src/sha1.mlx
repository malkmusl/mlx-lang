// std.sha1: SHA-1 (FIPS 180-4), HMAC-SHA1 (RFC 2104) and
// PBKDF2-HMAC-SHA1 (RFC 8018), what WPA2 asks for: the PSK of a Wi-Fi
// passphrase, the 802.11 PRF and the EAPOL-Key MIC. SHA-1 is broken for
// collisions; it is here for the protocols that still use it, not for
// anything new.
//
//     var hashing: sha1.Sha1 = undefined
//     sha1.sha1Init(&hashing)
//     sha1.sha1Update(&hashing, bytes)
//     var digest: [20]u8 = undefined
//     sha1.sha1Final(&hashing, &digest)        // wipes the state
//
//     sha1.hmacSha1(key, message, &digest)
//
//     var keyed: sha1.Hmac = undefined          // HMAC over several parts
//     sha1.hmacInit(&keyed, key)
//     sha1.hmacUpdate(&keyed, part)
//     sha1.hmacFinal(&keyed, &digest)
//
//     sha1.pbkdf2Sha1(password, salt, rounds, out, length)
//
// The states are wiped when they are finished: they hold what was
// hashed.

const std = @import("std")

const MASK32: u32 = 4294967295

pub const Sha1 = struct {
    state: [5]u32
    block: [64]u8
    filled: usize
    total: u64
}

// HMAC's two hashes, the inner one running, the outer one keyed and
// waiting for the inner digest.
pub const Hmac = struct {
    inner: Sha1
    outer: Sha1
}

fn rotate(value: u32, count: u32) -> u32 {
    return ((value << count) & MASK32) | (value >> (32 - count))
}

// Zeroes `length` bytes (what a key left behind).
pub fn wipe(bytes: [*]u8, length: usize) -> void {
    var index: usize = 0
    while index < length {
        bytes[index] = 0
        index += 1
    }
}

fn compress(hashing: *Sha1) -> void {
    const block: [*]const u8 = &hashing.*.block
    var w: [80]u32 = undefined
    var index: usize = 0
    while index < 16 {
        w[index] = std.mem.readU32Big(block, index * 4)
        index += 1
    }
    while index < 80 {
        w[index] = rotate(w[index - 3] ^ w[index - 8] ^ w[index - 14] ^ w[index - 16], 1)
        index += 1
    }
    var a = hashing.*.state[0]
    var b = hashing.*.state[1]
    var c = hashing.*.state[2]
    var d = hashing.*.state[3]
    var e = hashing.*.state[4]
    index = 0
    while index < 80 {
        var f: u32 = 0
        var k: u32 = 0
        if index < 20 {
            f = (b & c) | ((b ^ MASK32) & d)
            k = 1518500249
        } else if index < 40 {
            f = b ^ c ^ d
            k = 1859775393
        } else if index < 60 {
            f = (b & c) | (b & d) | (c & d)
            k = 2400959708
        } else {
            f = b ^ c ^ d
            k = 3395469782
        }
        const next = rotate(a, 5) +% f +% e +% k +% w[index]
        e = d
        d = c
        c = rotate(b, 30)
        b = a
        a = next
        index += 1
    }
    hashing.*.state[0] = hashing.*.state[0] +% a
    hashing.*.state[1] = hashing.*.state[1] +% b
    hashing.*.state[2] = hashing.*.state[2] +% c
    hashing.*.state[3] = hashing.*.state[3] +% d
    hashing.*.state[4] = hashing.*.state[4] +% e
    const words: [*]u8 = unsafe { @ptrCast([*]u8, &w) }
    wipe(words, 320)
}

pub fn sha1Init(hashing: *Sha1) -> void {
    hashing.*.state = [5]u32{ 1732584193, 4023233417, 2562383102, 271733878, 3285377520 }
    hashing.*.filled = 0
    hashing.*.total = 0
}

pub fn sha1Update(hashing: *Sha1, bytes: []const u8) -> void { sha1Absorb(hashing, bytes.pointer, bytes.length) }

// The same as sha1Update, from a pointer and a length. Code hashing a
// buffer of its own frame calls this one: a slice made of a local array
// and handed to a call moves that array into the aggregate arena, which
// is never freed, so a slice per call grows it without end.
pub fn sha1Absorb(hashing: *Sha1, bytes: [*]const u8, length: usize) -> void {
    var index: usize = 0
    while index < length {
        hashing.*.block[hashing.*.filled] = bytes[index]
        hashing.*.filled += 1
        if hashing.*.filled == 64 {
            compress(hashing)
            hashing.*.filled = 0
        }
        index += 1
    }
    hashing.*.total +%= length
}

pub fn sha1Final(hashing: *Sha1, digest: *[20]u8) -> void {
    const bits = hashing.*.total *% 8
    var padding: [72]u8 = undefined
    padding[0] = 128
    var length: usize = 1
    while (hashing.*.filled + length) % 64 != 56 {
        padding[length] = 0
        length += 1
    }
    const tail: [*]u8 = &padding
    std.mem.writeU32Big(tail, length, @intCast(u32, bits >> 32))
    std.mem.writeU32Big(tail, length + 4, @intCast(u32, bits & 4294967295))
    sha1Absorb(hashing, tail, length + 8)
    const out: [*]u8 = unsafe { @ptrCast([*]u8, digest) }
    var index: usize = 0
    while index < 5 {
        std.mem.writeU32Big(out, index * 4, hashing.*.state[index])
        index += 1
    }
    clear(hashing)
}

// The state zeroed, field by field: it holds what was hashed.
fn clear(hashing: *Sha1) -> void {
    hashing.*.state = [5]u32{ 0, 0, 0, 0, 0 }
    var index: usize = 0
    while index < 64 {
        hashing.*.block[index] = 0
        index += 1
    }
    hashing.*.filled = 0
    hashing.*.total = 0
}

fn copy(into: *Sha1, from: *Sha1) -> void {
    var index: usize = 0
    while index < 5 {
        into.*.state[index] = from.*.state[index]
        index += 1
    }
    index = 0
    while index < 64 {
        into.*.block[index] = from.*.block[index]
        index += 1
    }
    into.*.filled = from.*.filled
    into.*.total = from.*.total
}

pub fn sha1(bytes: []const u8, digest: *[20]u8) -> void {
    var hashing: Sha1 = undefined
    sha1Init(&hashing)
    sha1Update(&hashing, bytes)
    sha1Final(&hashing, digest)
}

fn innerOf(keyed: *Hmac) -> *Sha1 {
    const hashing: *Sha1 = unsafe { @ptrCast(*Sha1, &keyed.*.inner) }
    return hashing
}

fn outerOf(keyed: *Hmac) -> *Sha1 {
    const hashing: *Sha1 = unsafe { @ptrCast(*Sha1, &keyed.*.outer) }
    return hashing
}

// HMAC-SHA1 keyed with `key`, ready for the message's parts.
pub fn hmacInit(keyed: *Hmac, key: []const u8) -> void {
    var block: [64]u8 = undefined
    const bytes: [*]u8 = &block
    wipe(bytes, 64)
    if key.length > 64 {
        var short: [20]u8 = undefined
        sha1(key, &short)
        var index: usize = 0
        while index < 20 {
            block[index] = short[index]
            index += 1
        }
        const shortBytes: [*]u8 = &short
        wipe(shortBytes, 20)
    } else {
        var index: usize = 0
        while index < key.length {
            block[index] = key[index]
            index += 1
        }
    }
    var pad: [64]u8 = undefined
    const padBytes: [*]u8 = &pad
    var index: usize = 0
    while index < 64 {
        pad[index] = block[index] ^ 54
        index += 1
    }
    sha1Init(innerOf(keyed))
    sha1Absorb(innerOf(keyed), padBytes, 64)
    index = 0
    while index < 64 {
        pad[index] = block[index] ^ 92
        index += 1
    }
    sha1Init(outerOf(keyed))
    sha1Absorb(outerOf(keyed), padBytes, 64)
    wipe(bytes, 64)
    wipe(padBytes, 64)
}

pub fn hmacUpdate(keyed: *Hmac, bytes: []const u8) -> void {
    sha1Update(innerOf(keyed), bytes)
}

pub fn hmacFinal(keyed: *Hmac, digest: *[20]u8) -> void {
    var innerDigest: [20]u8 = undefined
    sha1Final(innerOf(keyed), &innerDigest)
    const innerBytes: [*]u8 = &innerDigest
    sha1Absorb(outerOf(keyed), innerBytes, 20)
    sha1Final(outerOf(keyed), digest)
    wipe(innerBytes, 20)
}

// A copy of a keyed HMAC (the key's two blocks hashed once, used for
// many messages).
pub fn hmacCopy(into: *Hmac, from: *Hmac) -> void {
    copy(innerOf(into), innerOf(from))
    copy(outerOf(into), outerOf(from))
}

pub fn hmacWipe(keyed: *Hmac) -> void {
    clear(innerOf(keyed))
    clear(outerOf(keyed))
}

// HMAC-SHA1 of `message` under `key`.
pub fn hmacSha1(key: []const u8, message: []const u8, digest: *[20]u8) -> void {
    var keyed: Hmac = undefined
    hmacInit(&keyed, key)
    hmacUpdate(&keyed, message)
    hmacFinal(&keyed, digest)
}

// PBKDF2 with HMAC-SHA1: `length` bytes from `password` and `salt` in
// `rounds` iterations, into `out`. (WPA's PSK: the passphrase, the SSID,
// 4096 rounds, 32 bytes.)
pub fn pbkdf2Sha1(password: []const u8, salt: []const u8, rounds: u64, out: [*]u8, length: usize) -> void {
    var keyed: Hmac = undefined
    hmacInit(&keyed, password)
    var running: Hmac = undefined
    var number: [4]u8 = undefined
    const numberBytes: [*]u8 = &number
    var u: [20]u8 = undefined
    var t: [20]u8 = undefined
    const uBytes: [*]u8 = &u
    var block: u32 = 1
    var done: usize = 0
    while done < length {
        std.mem.writeU32Big(numberBytes, 0, block)
        hmacCopy(&running, &keyed)
        hmacUpdate(&running, salt)
        sha1Absorb(innerOf(&running), numberBytes, 4)
        hmacFinal(&running, &u)
        var index: usize = 0
        while index < 20 {
            t[index] = u[index]
            index += 1
        }
        var round: u64 = 1
        while round < rounds {
            hmacCopy(&running, &keyed)
            sha1Absorb(innerOf(&running), uBytes, 20)
            hmacFinal(&running, &u)
            index = 0
            while index < 20 {
                t[index] = t[index] ^ u[index]
                index += 1
            }
            round += 1
        }
        index = 0
        while index < 20 && done < length {
            out[done] = t[index]
            done += 1
            index += 1
        }
        block += 1
    }
    wipe(uBytes, 20)
    const tBytes: [*]u8 = &t
    wipe(tBytes, 20)
    hmacWipe(&keyed)
    hmacWipe(&running)
}
