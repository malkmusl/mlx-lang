// std.asn1: reading DER (ITU-T X.690), the encoding of certificates and
// keys: elements with their tags and lengths, the children of a
// constructed one, and the universal types X.509 uses (integers, object
// identifiers, bit strings, strings, times).
//
//     var element: asn1.Element = undefined
//     if !asn1.read(data, 0, &element) { ... }      // strict DER
//     var children: asn1.Reader = undefined
//     asn1.readerInit(&children, data, &element)
//     while asn1.next(&children, &child) { ... }
//     asn1.contents(data, &element)                 // the content octets
//
// Nothing is copied: an element is where it is in the data, its header
// at `start`, its contents from `contentStart` for `length` bytes. DER is
// read strictly (definite, shortest lengths), as certificates must be.

pub const TAG_BOOLEAN: u8 = 1
pub const TAG_INTEGER: u8 = 2
pub const TAG_BIT_STRING: u8 = 3
pub const TAG_OCTET_STRING: u8 = 4
pub const TAG_NULL: u8 = 5
pub const TAG_OID: u8 = 6
pub const TAG_UTF8_STRING: u8 = 12
pub const TAG_PRINTABLE_STRING: u8 = 19
pub const TAG_T61_STRING: u8 = 20
pub const TAG_IA5_STRING: u8 = 22
pub const TAG_UTC_TIME: u8 = 23
pub const TAG_GENERALIZED_TIME: u8 = 24
pub const TAG_UNIVERSAL_STRING: u8 = 28
pub const TAG_BMP_STRING: u8 = 30
pub const TAG_SEQUENCE: u8 = 48
pub const TAG_SET: u8 = 49

// The context-specific tags [0] to [8], primitive and constructed.
pub fn contextTag(number: u8, constructed: bool) -> u8 {
    return if constructed { 160 | number } else { 128 | number }
}

pub const Element = struct {
    // The identifier octet (class, constructed bit, number below 31).
    tag: u8
    start: usize
    contentStart: usize
    length: usize
    end: usize
}

pub const Reader = struct {
    data: [*]const u8
    at: usize
    end: usize
}

// The element at `at` of `data`, which must end within it; false for
// anything that is not DER (multi-byte tags, indefinite or long-winded
// lengths, lengths past the end).
pub fn read(data: []const u8, at: usize, out: *Element) -> bool {
    return readWithin(data.pointer, at, data.length, out)
}

pub fn readWithin(data: [*]const u8, at: usize, limit: usize, out: *Element) -> bool {
    if at + 2 > limit { return false }
    const tag = data[at]
    // Tag numbers of 31 and up take more octets; X.509 has none.
    if (tag & 31) == 31 { return false }
    var position = at + 1
    const first = data[position]
    position += 1
    var length: usize = 0
    if first < 128 {
        length = @intCast(usize, first)
    } else {
        const count = @intCast(usize, first & 127)
        // 128 alone is BER's indefinite length; more than four octets of
        // length is more than any certificate.
        if count == 0 || count > 4 { return false }
        if position + count > limit { return false }
        if data[position] == 0 { return false }
        var index: usize = 0
        while index < count {
            length = (length << 8) | @intCast(usize, data[position + index])
            index += 1
        }
        position += count
        // The shortest form: a long form only from 128 on.
        if length < 128 { return false }
    }
    if length > limit - position { return false }
    out.*.tag = tag
    out.*.start = at
    out.*.contentStart = position
    out.*.length = length
    out.*.end = position + length
    return true
}

pub fn isConstructed(element: *Element) -> bool {
    return (element.*.tag & 32) != 0
}

pub fn contents(data: []const u8, element: *Element) -> []const u8 {
    return data[element.*.contentStart..element.*.end]
}

// The whole element, header included.
pub fn encoded(data: []const u8, element: *Element) -> []const u8 {
    return data[element.*.start..element.*.end]
}

// The children of a constructed element.
pub fn readerInit(reader: *Reader, data: []const u8, element: *Element) -> void {
    reader.*.data = data.pointer
    reader.*.at = element.*.contentStart
    reader.*.end = element.*.end
}

// The bytes from `start` to `end` as a run of elements.
pub fn readerRange(reader: *Reader, data: []const u8, start: usize, end: usize) -> void {
    reader.*.data = data.pointer
    reader.*.at = start
    reader.*.end = end
}

// The next child; false at the end, or when it is not DER.
pub fn next(reader: *Reader, out: *Element) -> bool {
    if reader.*.at >= reader.*.end { return false }
    if !readWithin(reader.*.data, reader.*.at, reader.*.end, out) { return false }
    reader.*.at = out.*.end
    return true
}

// The next child when it has `tag`; nothing is taken otherwise.
pub fn nextIf(reader: *Reader, tag: u8, out: *Element) -> bool {
    if reader.*.at >= reader.*.end { return false }
    if reader.*.data[reader.*.at] != tag { return false }
    return next(reader, out)
}

pub fn atEnd(reader: *Reader) -> bool {
    return reader.*.at == reader.*.end
}

// Whether the element's contents are these bytes (an OID's, mostly).
pub fn contentsAre(data: []const u8, element: *Element, bytes: []const u8) -> bool {
    if element.*.length != bytes.length { return false }
    var index: usize = 0
    while index < bytes.length {
        if data[element.*.contentStart + index] != bytes[index] { return false }
        index += 1
    }
    return true
}

// An INTEGER's magnitude, without the sign octet DER puts before a high
// bit; false for a negative one or an empty one.
pub fn unsignedInteger(data: []const u8, element: *Element, start: *usize, length: *usize) -> bool {
    if element.*.tag != TAG_INTEGER || element.*.length == 0 { return false }
    var at = element.*.contentStart
    var count = element.*.length
    if (data[at] & 128) != 0 { return false }
    if data[at] == 0 && count > 1 {
        // A zero first octet only before a high bit (the shortest form).
        if (data[at + 1] & 128) == 0 { return false }
        at += 1
        count -= 1
    }
    start.* = at
    length.* = count
    return true
}

// A small non-negative INTEGER (below 2^63); false otherwise.
pub fn smallInteger(data: []const u8, element: *Element, value: *u64) -> bool {
    var start: usize = 0
    var length: usize = 0
    if !unsignedInteger(data, element, &start, &length) { return false }
    if length > 8 { return false }
    var result: u64 = 0
    var index: usize = 0
    while index < length {
        result = (result << 8) | @intCast(u64, data[start + index])
        index += 1
    }
    if (result >> 63) != 0 { return false }
    value.* = result
    return true
}

// A BIT STRING's bits with no unused bits at the end (keys and
// signatures): where they start and how many bytes.
pub fn bitStringBytes(data: []const u8, element: *Element, start: *usize, length: *usize) -> bool {
    if element.*.tag != TAG_BIT_STRING || element.*.length == 0 { return false }
    if data[element.*.contentStart] != 0 { return false }
    start.* = element.*.contentStart + 1
    length.* = element.*.length - 1
    return true
}

// The first bits of a BIT STRING as flags (bit 0 the first, as KeyUsage
// numbers them), at most 16.
pub fn bitStringFlags(data: []const u8, element: *Element, flags: *u64) -> bool {
    if element.*.tag != TAG_BIT_STRING || element.*.length == 0 { return false }
    const unused = data[element.*.contentStart]
    if unused > 7 { return false }
    var value: u64 = 0
    var index: usize = 1
    while index < element.*.length && index <= 2 {
        const byte = @intCast(u64, data[element.*.contentStart + index])
        var bit: usize = 0
        while bit < 8 {
            if ((byte >> @intCast(u64, 7 - bit)) & 1) != 0 { value = value | (@intCast(u64, 1) << @intCast(u64, (index - 1) * 8 + bit)) }
            bit += 1
        }
        index += 1
    }
    flags.* = value
    return true
}

// A BOOLEAN; DER's TRUE is 255.
pub fn boolean(data: []const u8, element: *Element, value: *bool) -> bool {
    if element.*.tag != TAG_BOOLEAN || element.*.length != 1 { return false }
    const byte = data[element.*.contentStart]
    if byte != 0 && byte != 255 { return false }
    value.* = byte == 255
    return true
}

fn digits(data: []const u8, at: usize, count: usize, value: *i64) -> bool {
    var result: i64 = 0
    var index: usize = 0
    while index < count {
        const byte = data[at + index]
        if byte < 48 || byte > 57 { return false }
        result = result * 10 + @intCast(i64, byte - 48)
        index += 1
    }
    value.* = result
    return true
}

// Days from 1970-01-01 to a date of the proleptic Gregorian calendar
// (Howard Hinnant's days_from_civil).
pub fn daysFromCivil(year: i64, month: i64, day: i64) -> i64 {
    var y = year
    if month <= 2 { y = y - 1 }
    var era: i64 = 0
    if y >= 0 { era = y / 400 } else { era = (y - 399) / 400 }
    const yoe = y - era * 400
    var m = month + 9
    if month > 2 { m = month - 3 }
    const doy = (153 * m + 2) / 5 + day - 1
    const doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

// A UTCTime (YYMMDDHHMMSSZ, the years 1950 to 2049) or GeneralizedTime
// (YYYYMMDDHHMMSSZ) as seconds since 1970, as RFC 5280 4.1.2.5 has them.
pub fn time(data: []const u8, element: *Element, seconds: *i64) -> bool {
    const at = element.*.contentStart
    var year: i64 = 0
    var position = at
    if element.*.tag == TAG_UTC_TIME {
        if element.*.length != 13 { return false }
        if !digits(data, at, 2, &year) { return false }
        year = if year < 50 { 2000 + year } else { 1900 + year }
        position = at + 2
    } else if element.*.tag == TAG_GENERALIZED_TIME {
        if element.*.length != 15 { return false }
        if !digits(data, at, 4, &year) { return false }
        position = at + 4
    } else {
        return false
    }
    var month: i64 = 0
    var day: i64 = 0
    var hour: i64 = 0
    var minute: i64 = 0
    var second: i64 = 0
    if !digits(data, position, 2, &month) || !digits(data, position + 2, 2, &day) { return false }
    if !digits(data, position + 4, 2, &hour) || !digits(data, position + 6, 2, &minute) { return false }
    if !digits(data, position + 8, 2, &second) { return false }
    if data[position + 10] != 90 { return false }
    if month < 1 || month > 12 || day < 1 || day > 31 || hour > 23 || minute > 59 || second > 60 { return false }
    seconds.* = daysFromCivil(year, month, day) * 86400 + hour * 3600 + minute * 60 + second
    return true
}

// A string type's element: whether it is one X.509 names use.
pub fn isString(tag: u8) -> bool {
    return tag == TAG_UTF8_STRING || tag == TAG_PRINTABLE_STRING || tag == TAG_T61_STRING || tag == TAG_IA5_STRING || tag == TAG_UNIVERSAL_STRING || tag == TAG_BMP_STRING
}

// An OID's dotted text ("2.5.4.3") into `out` (room for 128 bytes): the
// length, 0 for contents that are no OID.
pub fn oidText(data: []const u8, element: *Element, out: [*]u8) -> usize {
    if element.*.tag != TAG_OID || element.*.length == 0 { return 0 }
    var written: usize = 0
    var value: u64 = 0
    var first = true
    var index: usize = 0
    while index < element.*.length {
        const byte = data[element.*.contentStart + index]
        if value > 72057594037927935 { return 0 }
        value = (value << 7) | @intCast(u64, byte & 127)
        if (byte & 128) == 0 {
            if first {
                var head: u64 = 2
                if value < 80 { head = value / 40 }
                written += writeNumber(out + written, head)
                out[written] = 46
                written += 1
                value = value - head * 40
                first = false
            }
            written += writeNumber(out + written, value)
            if index + 1 < element.*.length {
                out[written] = 46
                written += 1
            }
            if written > 100 { return 0 }
            value = 0
        }
        index += 1
    }
    return written
}

fn writeNumber(out: [*]u8, value: u64) -> usize {
    var reversed: [20]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        reversed[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var index: usize = 0
    while index < count {
        out[index] = reversed[count - 1 - index]
        index += 1
    }
    return count
}
