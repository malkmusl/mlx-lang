// The platform a program is built for: this file for brixOS
// (x86_64-brixos); see platform.linux.mlx. For a choice inside one
// function, `@import("builtin").os` says the same at compile time.
pub const NAME = "brixos"
pub const ANDROID = false
// The shell for `sh -c` commands (brixOS has no /bin: its programs are
// in /system/programs).
pub const SHELL = "/system/programs/mlx-sh"
