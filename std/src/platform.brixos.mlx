// The platform a program is built for: this file for brixOS
// (x86_64-brixos); see platform.linux.mlx. For a choice inside one
// function, `@import("builtin").os` says the same at compile time.
pub const NAME = "brixos"
pub const ANDROID = false
// The shell for `sh -c` commands (brixOS has no /bin: its programs are
// in /system/programs).
pub const SHELL = "/system/programs/mlx-sh"
// The users and groups (passwd's and group's format).
pub const USERS = "/system/settings/users"
pub const GROUPS = "/system/settings/groups"
// The name servers (resolv.conf's format) and the hosts file.
pub const RESOLV_CONF = "/system/settings/resolv.conf"
pub const HOSTS = "/system/settings/hosts"
// The trusted certificates (PEM, one after another) https clients check
// servers against.
pub const CA_CERTIFICATES = "/system/settings/certificates"
// Where programs are when the environment has no PATH.
pub const PROGRAMS = "/system/programs"
