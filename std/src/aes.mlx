// std.aes: AES-128 (FIPS 197) on single blocks, and the AES key wrap of
// RFC 3394, which WPA2 uses to hand over the group key (the EAPOL-Key
// data under the KEK). No modes of operation beyond that: a block cipher
// alone encrypts nothing safely.
//
//     var cipher: aes.Aes128 = undefined
//     aes.init(&cipher, key)                   // 16 bytes
//     aes.encrypt(&cipher, block)              // 16 bytes, in place
//     aes.decrypt(&cipher, block)
//     aes.finish(&cipher)                      // wipes the round keys
//
//     aes.wrap(kek, plain, length, out)        // length + 8 bytes out
//     aes.unwrap(kek, wrapped, length, out)    // length - 8 bytes out;
//                                              // false when it is not
//                                              // what was wrapped
//
// It is a byte-oriented implementation with table lookups: what a
// handshake needs, not bulk encryption (the Wi-Fi card does that).

pub const Aes128 = struct {
    keys: [176]u8
    box: [256]u8
    inverse: [256]u8
}

// The key wrap's initial value (RFC 3394, 2.2.3.1).
const WRAP_IV: u8 = 166

fn xtime(value: u32) -> u32 {
    const shifted = value << 1
    return if (value & 128) != 0 { (shifted ^ 27) & 255 } else { shifted & 255 }
}

// value * factor in GF(2^8), factor below 16.
fn times(value: u32, factor: u32) -> u32 {
    var result: u32 = 0
    var power = value
    var bits = factor
    while bits != 0 {
        if (bits & 1) != 0 { result = result ^ power }
        power = xtime(power)
        bits = bits >> 1
    }
    return result
}

fn keysOf(cipher: *Aes128) -> [*]u8 {
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &cipher.*.keys) }
    return bytes
}

fn boxOf(cipher: *Aes128) -> [*]u8 {
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &cipher.*.box) }
    return bytes
}

fn inverseOf(cipher: *Aes128) -> [*]u8 {
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &cipher.*.inverse) }
    return bytes
}

// The round keys of a 16-byte key.
pub fn init(cipher: *Aes128, key: [*]const u8) -> void {
    var box: [256]u8 = [256]u8{ 99, 124, 119, 123, 242, 107, 111, 197, 48, 1, 103, 43, 254, 215, 171, 118, 202, 130, 201, 125, 250, 89, 71, 240, 173, 212, 162, 175, 156, 164, 114, 192, 183, 253, 147, 38, 54, 63, 247, 204, 52, 165, 229, 241, 113, 216, 49, 21, 4, 199, 35, 195, 24, 150, 5, 154, 7, 18, 128, 226, 235, 39, 178, 117, 9, 131, 44, 26, 27, 110, 90, 160, 82, 59, 214, 179, 41, 227, 47, 132, 83, 209, 0, 237, 32, 252, 177, 91, 106, 203, 190, 57, 74, 76, 88, 207, 208, 239, 170, 251, 67, 77, 51, 133, 69, 249, 2, 127, 80, 60, 159, 168, 81, 163, 64, 143, 146, 157, 56, 245, 188, 182, 218, 33, 16, 255, 243, 210, 205, 12, 19, 236, 95, 151, 68, 23, 196, 167, 126, 61, 100, 93, 25, 115, 96, 129, 79, 220, 34, 42, 144, 136, 70, 238, 184, 20, 222, 94, 11, 219, 224, 50, 58, 10, 73, 6, 36, 92, 194, 211, 172, 98, 145, 149, 228, 121, 231, 200, 55, 109, 141, 213, 78, 169, 108, 86, 244, 234, 101, 122, 174, 8, 186, 120, 37, 46, 28, 166, 180, 198, 232, 221, 116, 31, 75, 189, 139, 138, 112, 62, 181, 102, 72, 3, 246, 14, 97, 53, 87, 185, 134, 193, 29, 158, 225, 248, 152, 17, 105, 217, 142, 148, 155, 30, 135, 233, 206, 85, 40, 223, 140, 161, 137, 13, 191, 230, 66, 104, 65, 153, 45, 15, 176, 84, 187, 22 }
    var inverse: [256]u8 = [256]u8{ 82, 9, 106, 213, 48, 54, 165, 56, 191, 64, 163, 158, 129, 243, 215, 251, 124, 227, 57, 130, 155, 47, 255, 135, 52, 142, 67, 68, 196, 222, 233, 203, 84, 123, 148, 50, 166, 194, 35, 61, 238, 76, 149, 11, 66, 250, 195, 78, 8, 46, 161, 102, 40, 217, 36, 178, 118, 91, 162, 73, 109, 139, 209, 37, 114, 248, 246, 100, 134, 104, 152, 22, 212, 164, 92, 204, 93, 101, 182, 146, 108, 112, 72, 80, 253, 237, 185, 218, 94, 21, 70, 87, 167, 141, 157, 132, 144, 216, 171, 0, 140, 188, 211, 10, 247, 228, 88, 5, 184, 179, 69, 6, 208, 44, 30, 143, 202, 63, 15, 2, 193, 175, 189, 3, 1, 19, 138, 107, 58, 145, 17, 65, 79, 103, 220, 234, 151, 242, 207, 206, 240, 180, 230, 115, 150, 172, 116, 34, 231, 173, 53, 133, 226, 249, 55, 232, 28, 117, 223, 110, 71, 241, 26, 113, 29, 41, 197, 137, 111, 183, 98, 14, 170, 24, 190, 27, 252, 86, 62, 75, 198, 210, 121, 32, 154, 219, 192, 254, 120, 205, 90, 244, 31, 221, 168, 51, 136, 7, 199, 49, 177, 18, 16, 89, 39, 128, 236, 95, 96, 81, 127, 169, 25, 181, 74, 13, 45, 229, 122, 159, 147, 201, 156, 239, 160, 224, 59, 77, 174, 42, 245, 176, 200, 235, 187, 60, 131, 83, 153, 97, 23, 43, 4, 126, 186, 119, 214, 38, 225, 105, 20, 99, 85, 33, 12, 125 }
    var index: usize = 0
    while index < 256 {
        cipher.*.box[index] = box[index]
        cipher.*.inverse[index] = inverse[index]
        index += 1
    }
    const keys = keysOf(cipher)
    index = 0
    while index < 16 {
        keys[index] = key[index]
        index += 1
    }
    var round: u32 = 1
    while index < 176 {
        var word0 = keys[index - 4]
        var word1 = keys[index - 3]
        var word2 = keys[index - 2]
        var word3 = keys[index - 1]
        if index % 16 == 0 {
            // RotWord, SubWord and the round constant.
            const first = word0
            word0 = box[@intCast(usize, word1)] ^ @intCast(u8, round)
            word1 = box[@intCast(usize, word2)]
            word2 = box[@intCast(usize, word3)]
            word3 = box[@intCast(usize, first)]
            round = xtime(round)
        }
        keys[index] = keys[index - 16] ^ word0
        keys[index + 1] = keys[index - 15] ^ word1
        keys[index + 2] = keys[index - 14] ^ word2
        keys[index + 3] = keys[index - 13] ^ word3
        index += 4
    }
}

pub fn finish(cipher: *Aes128) -> void {
    const keys = keysOf(cipher)
    var index: usize = 0
    while index < 176 {
        keys[index] = 0
        index += 1
    }
}

fn addRoundKey(cipher: *Aes128, block: [*]u8, round: usize) -> void {
    const keys = keysOf(cipher)
    var index: usize = 0
    while index < 16 {
        block[index] = block[index] ^ keys[round * 16 + index]
        index += 1
    }
}

fn substitute(table: [*]u8, block: [*]u8) -> void {
    var index: usize = 0
    while index < 16 {
        block[index] = table[@intCast(usize, block[index])]
        index += 1
    }
}

// Row r turns left by r (the block is in columns: byte r + 4c).
fn shiftRows(block: [*]u8) -> void {
    var old: [16]u8 = undefined
    var index: usize = 0
    while index < 16 {
        old[index] = block[index]
        index += 1
    }
    var row: usize = 1
    while row < 4 {
        var column: usize = 0
        while column < 4 {
            block[row + 4 * column] = old[row + 4 * ((column + row) % 4)]
            column += 1
        }
        row += 1
    }
}

fn unshiftRows(block: [*]u8) -> void {
    var old: [16]u8 = undefined
    var index: usize = 0
    while index < 16 {
        old[index] = block[index]
        index += 1
    }
    var row: usize = 1
    while row < 4 {
        var column: usize = 0
        while column < 4 {
            block[row + 4 * ((column + row) % 4)] = old[row + 4 * column]
            column += 1
        }
        row += 1
    }
}

fn mixColumns(block: [*]u8) -> void {
    var column: usize = 0
    while column < 4 {
        const at = column * 4
        const a0 = @intCast(u32, block[at])
        const a1 = @intCast(u32, block[at + 1])
        const a2 = @intCast(u32, block[at + 2])
        const a3 = @intCast(u32, block[at + 3])
        block[at] = @intCast(u8, xtime(a0) ^ (xtime(a1) ^ a1) ^ a2 ^ a3)
        block[at + 1] = @intCast(u8, a0 ^ xtime(a1) ^ (xtime(a2) ^ a2) ^ a3)
        block[at + 2] = @intCast(u8, a0 ^ a1 ^ xtime(a2) ^ (xtime(a3) ^ a3))
        block[at + 3] = @intCast(u8, (xtime(a0) ^ a0) ^ a1 ^ a2 ^ xtime(a3))
        column += 1
    }
}

fn unmixColumns(block: [*]u8) -> void {
    var column: usize = 0
    while column < 4 {
        const at = column * 4
        const a0 = @intCast(u32, block[at])
        const a1 = @intCast(u32, block[at + 1])
        const a2 = @intCast(u32, block[at + 2])
        const a3 = @intCast(u32, block[at + 3])
        block[at] = @intCast(u8, times(a0, 14) ^ times(a1, 11) ^ times(a2, 13) ^ times(a3, 9))
        block[at + 1] = @intCast(u8, times(a0, 9) ^ times(a1, 14) ^ times(a2, 11) ^ times(a3, 13))
        block[at + 2] = @intCast(u8, times(a0, 13) ^ times(a1, 9) ^ times(a2, 14) ^ times(a3, 11))
        block[at + 3] = @intCast(u8, times(a0, 11) ^ times(a1, 13) ^ times(a2, 9) ^ times(a3, 14))
        column += 1
    }
}

// Encrypts the 16 bytes at `block` in place.
pub fn encrypt(cipher: *Aes128, block: [*]u8) -> void {
    const box = boxOf(cipher)
    addRoundKey(cipher, block, 0)
    var round: usize = 1
    while round < 10 {
        substitute(box, block)
        shiftRows(block)
        mixColumns(block)
        addRoundKey(cipher, block, round)
        round += 1
    }
    substitute(box, block)
    shiftRows(block)
    addRoundKey(cipher, block, 10)
}

// Decrypts the 16 bytes at `block` in place.
pub fn decrypt(cipher: *Aes128, block: [*]u8) -> void {
    const inverse = inverseOf(cipher)
    addRoundKey(cipher, block, 10)
    var round: usize = 9
    while round > 0 {
        unshiftRows(block)
        substitute(inverse, block)
        addRoundKey(cipher, block, round)
        unmixColumns(block)
        round -= 1
    }
    unshiftRows(block)
    substitute(inverse, block)
    addRoundKey(cipher, block, 0)
}

fn wipeBlock(block: [*]u8) -> void {
    var index: usize = 0
    while index < 16 {
        block[index] = 0
        index += 1
    }
}

// RFC 3394 key wrap of `length` bytes (a multiple of 8, at least 16)
// under the 16-byte `kek`: length + 8 bytes into `out`.
pub fn wrap(kek: [*]const u8, plain: [*]const u8, length: usize, out: [*]u8) -> bool {
    if length < 16 || length % 8 != 0 { return false }
    var cipher: Aes128 = undefined
    init(&cipher, kek)
    var index: usize = 0
    while index < 8 {
        out[index] = WRAP_IV
        index += 1
    }
    index = 0
    while index < length {
        out[8 + index] = plain[index]
        index += 1
    }
    const blocks = length / 8
    var block: [16]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &block) }
    var step: usize = 0
    while step < 6 {
        var item: usize = 1
        while item <= blocks {
            index = 0
            while index < 8 {
                bytes[index] = out[index]
                bytes[8 + index] = out[8 * item + index]
                index += 1
            }
            encrypt(&cipher, bytes)
            var t = @intCast(u64, blocks * step + item)
            index = 0
            while index < 8 {
                out[7 - index] = bytes[7 - index] ^ @intCast(u8, t & 255)
                t = t >> 8
                index += 1
            }
            index = 0
            while index < 8 {
                out[8 * item + index] = bytes[8 + index]
                index += 1
            }
            item += 1
        }
        step += 1
    }
    wipeBlock(bytes)
    finish(&cipher)
    return true
}

// RFC 3394 key unwrap of `length` wrapped bytes (a multiple of 8, at
// least 24): length - 8 bytes into `out`. False when the integrity check
// fails (another key, or bytes changed); `out` is wiped then.
pub fn unwrap(kek: [*]const u8, wrapped: [*]const u8, length: usize, out: [*]u8) -> bool {
    if length < 24 || length % 8 != 0 { return false }
    var cipher: Aes128 = undefined
    init(&cipher, kek)
    var a: [8]u8 = undefined
    var index: usize = 0
    while index < 8 {
        a[index] = wrapped[index]
        index += 1
    }
    const blocks = length / 8 - 1
    index = 0
    while index < blocks * 8 {
        out[index] = wrapped[8 + index]
        index += 1
    }
    var block: [16]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &block) }
    var step: usize = 6
    while step > 0 {
        var item = blocks
        while item >= 1 {
            var t = @intCast(u64, blocks * (step - 1) + item)
            index = 0
            while index < 8 {
                bytes[7 - index] = a[7 - index] ^ @intCast(u8, t & 255)
                t = t >> 8
                index += 1
            }
            index = 0
            while index < 8 {
                bytes[8 + index] = out[8 * (item - 1) + index]
                index += 1
            }
            decrypt(&cipher, bytes)
            index = 0
            while index < 8 {
                a[index] = bytes[index]
                out[8 * (item - 1) + index] = bytes[8 + index]
                index += 1
            }
            item -= 1
        }
        step -= 1
    }
    wipeBlock(bytes)
    finish(&cipher)
    var good = true
    index = 0
    while index < 8 {
        if a[index] != WRAP_IV { good = false }
        index += 1
    }
    if !good {
        index = 0
        while index < blocks * 8 {
            out[index] = 0
            index += 1
        }
    }
    return good
}
