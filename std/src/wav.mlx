// std.wav: WAVE files (RIFF): reading the format and where the samples
// are, writing the header in front of PCM samples. MLX Audio's mlx-audio
// plays and records them, and its daemon writes its mix into one
// (--output file:PATH).
//
//     var info: wav.Info = undefined
//     if wav.parse(bytes, length, &info) { ... bytes[info.dataStart ..] ... }
//
//     wav.writeHeader(header, 48000, 2, wav.FORMAT_PCM, 16, data_length)
pub const FORMAT_PCM: u32 = 1
pub const FORMAT_FLOAT: u32 = 3
pub const FORMAT_EXTENSIBLE: u32 = 65534

// The header writeHeader writes.
pub const HEADER_SIZE: usize = 44

pub const Info = struct {
    // FORMAT_PCM (integers) or FORMAT_FLOAT (an extensible file's
    // subformat, when it has one).
    format: u32
    channels: u32
    rate: u32
    bits: u32
    // The samples: their offset in the file and their length (whole
    // frames).
    dataStart: usize
    dataLength: usize
}

fn load16(bytes: [*]const u8, at: usize) -> u32 { return @intCast(u32, bytes[at]) | (@intCast(u32, bytes[at + 1]) << 8) }

fn load32(bytes: [*]const u8, at: usize) -> u32 { return load16(bytes, at) | (load16(bytes, at + 2) << 16) }

fn isTag(bytes: [*]const u8, at: usize, tag: []const u8) -> bool {
    return bytes[at] == tag[0] && bytes[at + 1] == tag[1] && bytes[at + 2] == tag[2] && bytes[at + 3] == tag[3]
}

// Reads the header of the WAVE file in `bytes`; false when it is not one
// this reads (PCM of 8, 16, 24 or 32 bits, or 32-bit float).
pub fn parse(bytes: [*]const u8, length: usize, info: *Info) -> bool {
    if length < 12 || !isTag(bytes, 0, "RIFF") || !isTag(bytes, 8, "WAVE") { return false }
    var at: usize = 12
    var have_format = false
    while at + 8 <= length {
        const size = @intCast(usize, load32(bytes, at + 4))
        const body = at + 8
        if isTag(bytes, at, "fmt ") && size >= 16 && body + size <= length {
            info.*.format = load16(bytes, body)
            info.*.channels = load16(bytes, body + 2)
            info.*.rate = load32(bytes, body + 4)
            info.*.bits = load16(bytes, body + 14)
            if info.*.format == FORMAT_EXTENSIBLE && size >= 40 { info.*.format = load16(bytes, body + 24) }
            have_format = true
        } else if isTag(bytes, at, "data") && have_format {
            var data_length = size
            if body + data_length > length { data_length = length - body }
            const frame = @intCast(usize, info.*.channels * (info.*.bits / 8))
            if frame == 0 { return false }
            info.*.dataStart = body
            info.*.dataLength = data_length / frame * frame
            const integer = info.*.format == FORMAT_PCM && (info.*.bits == 8 || info.*.bits == 16 || info.*.bits == 24 || info.*.bits == 32)
            const floating = info.*.format == FORMAT_FLOAT && info.*.bits == 32
            return (integer || floating) && info.*.channels > 0 && info.*.rate > 0
        }
        // Chunks are padded to even sizes.
        at = body + size + (size & 1)
    }
    return false
}

fn store16(bytes: [*]u8, at: usize, value: u32) -> void {
    bytes[at] = @intCast(u8, value & 255)
    bytes[at + 1] = @intCast(u8, (value >> 8) & 255)
}

fn store32(bytes: [*]u8, at: usize, value: u32) -> void {
    store16(bytes, at, value & 65535)
    store16(bytes, at + 2, value >> 16)
}

fn storeTag(bytes: [*]u8, at: usize, tag: []const u8) -> void {
    var index: usize = 0
    while index < 4 {
        bytes[at + index] = tag[index]
        index += 1
    }
}

// The HEADER_SIZE bytes of a WAVE file whose `data_length` bytes of
// samples follow.
pub fn writeHeader(bytes: [*]u8, rate: u32, channels: u32, format: u32, bits: u32, data_length: usize) -> void {
    const frame = channels * (bits / 8)
    storeTag(bytes, 0, "RIFF")
    store32(bytes, 4, @intCast(u32, 36 + data_length))
    storeTag(bytes, 8, "WAVE")
    storeTag(bytes, 12, "fmt ")
    store32(bytes, 16, 16)
    store16(bytes, 20, format)
    store16(bytes, 22, channels)
    store32(bytes, 24, rate)
    store32(bytes, 28, rate * frame)
    store16(bytes, 32, frame)
    store16(bytes, 34, bits)
    storeTag(bytes, 36, "data")
    store32(bytes, 40, @intCast(u32, data_length))
}
