// Font variations, as FreeType's TrueType driver handles them (its
// ttgxvar.c, with the public functions of ftmm.c and the PostScript names
// of instances of sfdriver.c): the axes and named instances of `fvar`,
// the axis maps of `avar` (versions 1 and 2), the item variation stores
// of `HVAR`, `VVAR` and `MVAR` that vary advances and global metrics, and
// the glyph deltas of `gvar` with the interpolation of the points that
// have none. A CFF2 font's charstrings vary by its own blend (cff.mlx),
// from the normalized coordinates set here.
//
// The state is FreeType's blend: made when first needed (by
// FT_Get_MM_Var or by setting coordinates), freed with the face.
const m = @import("./memory.mlx")
const r = @import("./records.mlx")
const o = @import("./objects.mlx")
const calc = @import("./calc.mlx")
const sfnt = @import("./sfnt.mlx")
const library = @import("./library.mlx")

// What the face's variations vary (FreeType's variation_support).
const VAR_HADVANCE: i64 = 2
const VAR_VADVANCE: i64 = 16
const VAR_MVAR: i64 = 256

// The flags of the tuple variation headers of `gvar`.
const TUPLES_SHARE_POINT_NUMBERS: u64 = 0x8000
const TUPLE_COUNT_MASK: u64 = 0x0FFF
const EMBEDDED_TUPLE_COORD: u64 = 0x8000
const INTERMEDIATE_TUPLE: u64 = 0x4000
const PRIVATE_POINT_NUMBERS: u64 = 0x2000
const TUPLE_INDEX_MASK: u64 = 0x0FFF

// Packed point numbers: none read (an error), all the points, or a list.
const POINTS_NONE: i64 = 0
const POINTS_ALL: i64 = 1
const POINTS_LIST: i64 = 2

// The sizes of FT_MM_Var, FT_Var_Axis and FT_Var_Named_Style.
const MM_VAR_SIZE: usize = 32
const AXIS_SIZE: usize = 48
const STYLE_SIZE: usize = 16

// An item variation store: its regions (for each, per axis, the start,
// peak and end coordinates, 8 bytes each) and its item variation data.
const Store = struct {
    axisCount: u64
    regionCount: u64
    regions: usize
    dataCount: u64
    data: usize
}

// The deltas of an item variation data are read where they are in the
// font (`deltaSet` is their offset in it).
const VarData = struct {
    itemCount: u64
    wordDeltaCount: u64
    longWords: bool
    regionIdxCount: u64
    regionIndices: usize
    deltaSet: u64
}

// A delta-set index map: the outer and inner indices (4 bytes each) of
// each entry.
const IdxMap = struct {
    mapCount: u64
    outer: usize
    inner: usize
}

// FreeType's GX_BlendRec, with the face's doblend and variation_support.
pub const Blend = struct {
    numAxis: u64
    // The FT_MM_Var of the face (copied by FT_Get_MM_Var) and its size.
    mmvar: usize
    mmvarLen: usize
    // The design and normalized coordinates set, and the normalized ones
    // of the named instances.
    coords: usize
    normalized: usize
    styleCoords: usize
    doblend: bool
    support: i64
    // `avar`: per axis its number of pairs and their address (pairs of
    // 8-byte from and to coordinates); version 2's store and axis map.
    avarLoaded: bool
    hasAvar: bool
    avarSegments: usize
    avarStore: Store
    avarMap: IdxMap
    hvarLoaded: bool
    hvarChecked: bool
    hvarError: i32
    hvarStore: Store
    hvarMap: IdxMap
    vvarLoaded: bool
    vvarChecked: bool
    vvarError: i32
    vvarStore: Store
    vvarMap: IdxMap
    // `MVAR`: its values (16 bytes each: tag, outer and inner index, the
    // value unvaried) and their store.
    hasMvar: bool
    mvarCount: u64
    mvarValues: usize
    mvarStore: Store
    // `gvar`: the offsets of the glyphs' variation data, the shared tuples.
    glyphOffsets: usize
    gvGlyphCount: u64
    gvarSize: u64
    tupleCoords: usize
    tupleCount: u64
    // The prefix of the PostScript names of instances.
    psPrefix: usize
    psPrefixLen: u64
    // The `gasp` ranges' maxPPEM values as `MVAR` varies them.
    gaspMax: usize
}

fn blendOf(f: *o.Face) -> *Blend { unsafe { return @ptrFromInt(*Blend, f.*.blend) } }
fn varDataAt(s: *Store, i: u64) -> *VarData { unsafe { return @ptrFromInt(*VarData, s.*.data + @intCast(usize, i) * @sizeOf(VarData)) } }

fn fixedAt(base: usize, i: u64) -> i64 { return m.getI64(base + @intCast(usize, i) * 8) }
fn setFixedAt(base: usize, i: u64, value: i64) -> void { m.putI64(base + @intCast(usize, i) * 8, value) }

// FreeType's FT_fdot14ToFixed, FT_intToFixed, FT_fixedToInt and
// FT_fixedToFdot6.
fn fdot14ToFixed(x: i64) -> i64 { return @bitCast(i64, @bitCast(u64, x) << 2) }
fn intToFixed(x: i64) -> i64 { return @bitCast(i64, @bitCast(u64, x) << 16) }
fn fixedToInt(x: i64) -> i64 { return calc.low16((x +% 0x8000) >> 16) }
fn fixedToFdot6(x: i64) -> i64 { return (x +% 0x200) >> 10 }

// ---------------------------------------------------------------------------
// Reading the font as FreeType's stream does: a read past the end is an
// invalid stream operation.

const Reader = struct {
    f: *o.Face
    pos: u64
    err: i32
}

fn reader(f: *o.Face, pos: u64) -> Reader {
    var rd = Reader.{ .f = f, .pos = pos, .err = r.OK }
    if pos > f.*.size { rd.err = r.ERR_INVALID_STREAM_OPERATION }
    return rd
}

fn seek(rd: *Reader, pos: u64) -> bool {
    if pos > rd.*.f.*.size {
        rd.*.err = r.ERR_INVALID_STREAM_OPERATION
        return false
    }
    rd.*.pos = pos
    return true
}

fn readable(rd: *Reader, count: u64) -> bool {
    if rd.*.err != r.OK { return false }
    if !o.within(rd.*.f, rd.*.pos, count) {
        rd.*.err = r.ERR_INVALID_STREAM_OPERATION
        return false
    }
    return true
}

fn readU8(rd: *Reader) -> i64 {
    if !readable(rd, 1) { return 0 }
    const v = o.byteAt(rd.*.f, rd.*.pos)
    rd.*.pos += 1
    return v
}

fn readU16(rd: *Reader) -> i64 {
    if !readable(rd, 2) { return 0 }
    const v = o.u16At(rd.*.f, rd.*.pos)
    rd.*.pos += 2
    return v
}

fn readS16(rd: *Reader) -> i64 {
    if !readable(rd, 2) { return 0 }
    const v = o.i16At(rd.*.f, rd.*.pos)
    rd.*.pos += 2
    return v
}

fn readU32(rd: *Reader) -> i64 {
    if !readable(rd, 4) { return 0 }
    const v = o.u32At(rd.*.f, rd.*.pos)
    rd.*.pos += 4
    return v
}

// Inside a frame FreeType reads without checking (and a memory stream
// reads on past the frame): the font's bytes, 0 past its end.
fn s8(f: *o.Face, p: u64) -> i64 {
    const b = o.byteAt(f, p)
    return if b >= 128 { b - 256 } else { b }
}

// ---------------------------------------------------------------------------
// Packed point numbers and deltas (FreeType's ft_var_readpackedpoints and
// ft_var_readpackeddeltas), read from `start`.

// The kind of list read, the list (2-byte point numbers), its length and
// where reading stopped.
fn readPackedPoints(f: *o.Face, start: u64, size: u64) -> (i64, usize, u64, u64) {
    var p = start
    var n = @intCast(u64, o.byteAt(f, p))
    p += 1
    if n == 0 { return -> (POINTS_ALL, 0, 0, p) }
    if (n & 0x80) != 0 {
        n = ((n & 0x7F) << 8) | @intCast(u64, o.byteAt(f, p))
        p += 1
    }
    if n > size { return -> (POINTS_NONE, 0, 0, p) }
    const points = m.alloc(f.*.memory, @intCast(usize, n + 1) * 2)
    if points == 0 { return -> (POINTS_NONE, 0, 0, p) }
    var first: u64 = 0
    var i: u64 = 0
    while i < n {
        var runcnt = @intCast(u64, o.byteAt(f, p))
        p += 1
        if (runcnt & 0x80) != 0 {
            runcnt &= 0x7F
            first = (first + @intCast(u64, o.u16At(f, p))) & 0xFFFF
            p += 2
            m.put16(points + @intCast(usize, i) * 2, @intCast(u16, first))
            i += 1
            var j: u64 = 0
            while j < runcnt {
                first = (first + @intCast(u64, o.u16At(f, p))) & 0xFFFF
                p += 2
                m.put16(points + @intCast(usize, i) * 2, @intCast(u16, first))
                i += 1
                if i >= n { break }
                j += 1
            }
        } else {
            first = (first + @intCast(u64, o.byteAt(f, p))) & 0xFFFF
            p += 1
            m.put16(points + @intCast(usize, i) * 2, @intCast(u16, first))
            i += 1
            var j: u64 = 0
            while j < runcnt {
                first = (first + @intCast(u64, o.byteAt(f, p))) & 0xFFFF
                p += 1
                m.put16(points + @intCast(usize, i) * 2, @intCast(u16, first))
                i += 1
                if i >= n { break }
                j += 1
            }
        }
    }
    return -> (POINTS_LIST, points, n, p)
}

// The deltas (16.16) and where reading stopped; 0 for none.
fn readPackedDeltas(f: *o.Face, start: u64, size: u64, count: u64) -> (usize, u64) {
    var p = start
    if count == 0 { return -> (0, p) }
    const deltas = m.alloc(f.*.memory, @intCast(usize, count) * 8)
    if deltas == 0 { return -> (0, p) }
    var i: u64 = 0
    var bytesUsed: u64 = 0
    var failed = false
    while i < count && bytesUsed < size {
        const runcnt = @intCast(u64, o.byteAt(f, p))
        p += 1
        const cnt = runcnt & 0x3F
        bytesUsed += 1
        var j: u64 = 0
        if (runcnt & 0x80) != 0 {
            while j <= cnt && i < count {
                setFixedAt(deltas, i, 0)
                i += 1
                j += 1
            }
        } else if (runcnt & 0x40) != 0 {
            bytesUsed += 2 * (cnt + 1)
            if bytesUsed > size {
                failed = true
                break
            }
            while j <= cnt && i < count {
                setFixedAt(deltas, i, intToFixed(o.i16At(f, p)))
                p += 2
                i += 1
                j += 1
            }
        } else {
            bytesUsed += cnt + 1
            if bytesUsed > size {
                failed = true
                break
            }
            while j <= cnt && i < count {
                setFixedAt(deltas, i, intToFixed(s8(f, p)))
                p += 1
                i += 1
                j += 1
            }
        }
        if j <= cnt {
            failed = true
            break
        }
    }
    if failed || i < count {
        m.release(f.*.memory, deltas)
        return -> (0, p)
    }
    return -> (deltas, p)
}

// ---------------------------------------------------------------------------
// Item variation stores and delta-set index maps.

// FreeType's tt_var_load_item_variation_store.
fn loadItemStore(f: *o.Face, b: *Blend, offset: u64, store: *Store) -> i32 {
    const memory = f.*.memory
    var rd = reader(f, offset)
    if rd.err != r.OK { return rd.err }
    const format = readU16(&rd)
    if rd.err != r.OK { return rd.err }
    if format != 1 { return r.ERR_INVALID_TABLE }
    const regionOffset = @intCast(u64, readU32(&rd))
    const dataCount = @intCast(u64, readU16(&rd))
    if rd.err != r.OK { return rd.err }
    if dataCount == 0 { return r.ERR_INVALID_TABLE }
    const offsets = m.alloc(memory, @intCast(usize, dataCount) * 8)
    if offsets == 0 { return r.ERR_OUT_OF_MEMORY }
    const err = loadItemStoreData(f, b, offset, store, &rd, regionOffset, dataCount, offsets)
    m.release(memory, offsets)
    return err
}

fn loadItemStoreData(f: *o.Face, b: *Blend, offset: u64, store: *Store, rd: *Reader, regionOffset: u64, dataCount: u64, offsets: usize) -> i32 {
    const memory = f.*.memory
    var i: u64 = 0
    while i < dataCount {
        m.put64(offsets + @intCast(usize, i) * 8, @intCast(u64, readU32(rd)))
        if rd.*.err != r.OK { return rd.*.err }
        i += 1
    }
    if !seek(rd, offset + regionOffset) { return rd.*.err }
    const axisCount = @intCast(u64, readU16(rd))
    const regionCount = @intCast(u64, readU16(rd))
    if rd.*.err != r.OK { return rd.*.err }
    if axisCount != b.*.numAxis { return r.ERR_INVALID_TABLE }
    store.*.axisCount = axisCount
    if regionCount >= 32768 { return r.ERR_INVALID_TABLE }
    if regionCount * axisCount != 0 {
        store.*.regions = m.alloc(memory, @intCast(usize, regionCount * axisCount) * 24)
        if store.*.regions == 0 { return r.ERR_OUT_OF_MEMORY }
    }
    store.*.regionCount = regionCount
    i = 0
    while i < regionCount {
        var j: u64 = 0
        while j < axisCount {
            const start = readS16(rd)
            const peak = readS16(rd)
            const end = readS16(rd)
            if rd.*.err != r.OK { return rd.*.err }
            const at = store.*.regions + @intCast(usize, i * axisCount + j) * 24
            m.putI64(at, fdot14ToFixed(start))
            m.putI64(at + 8, fdot14ToFixed(peak))
            m.putI64(at + 16, fdot14ToFixed(end))
            j += 1
        }
        i += 1
    }
    store.*.data = m.alloc(memory, @intCast(usize, dataCount) * @sizeOf(VarData))
    if store.*.data == 0 { return r.ERR_OUT_OF_MEMORY }
    store.*.dataCount = dataCount
    i = 0
    while i < dataCount {
        const vd = varDataAt(store, i)
        if !seek(rd, offset + m.get64(offsets + @intCast(usize, i) * 8)) { return rd.*.err }
        const itemCount = @intCast(u64, readU16(rd))
        var wordDeltaCount = @intCast(u64, readU16(rd))
        const regionIdxCount = @intCast(u64, readU16(rd))
        if rd.*.err != r.OK { return rd.*.err }
        const longWords = (wordDeltaCount & 0x8000) != 0
        wordDeltaCount &= 0x7FFF
        if wordDeltaCount > regionIdxCount { return r.ERR_INVALID_TABLE }
        if regionIdxCount > store.*.regionCount { return r.ERR_INVALID_TABLE }
        if regionIdxCount != 0 {
            vd.*.regionIndices = m.alloc(memory, @intCast(usize, regionIdxCount) * 2)
            if vd.*.regionIndices == 0 { return r.ERR_OUT_OF_MEMORY }
        }
        vd.*.regionIdxCount = regionIdxCount
        vd.*.wordDeltaCount = wordDeltaCount
        vd.*.longWords = longWords
        var j: u64 = 0
        while j < regionIdxCount {
            const index = readU16(rd)
            if rd.*.err != r.OK { return rd.*.err }
            m.put16(vd.*.regionIndices + @intCast(usize, j) * 2, @intCast(u16, index))
            if @intCast(u64, index) >= store.*.regionCount { return r.ERR_INVALID_TABLE }
            j += 1
        }
        var perRegion = wordDeltaCount + regionIdxCount
        if longWords { perRegion *= 2 }
        if !o.within(f, rd.*.pos, perRegion * itemCount) { return r.ERR_INVALID_TABLE }
        vd.*.deltaSet = rd.*.pos
        vd.*.itemCount = itemCount
        i += 1
    }
    return r.OK
}

// FreeType's tt_var_load_delta_set_index_mapping.
fn loadIdxMap(f: *o.Face, offset: u64, map: *IdxMap, store: *Store, tableLen: u64) -> i32 {
    const memory = f.*.memory
    var rd = reader(f, offset)
    if rd.err != r.OK { return rd.err }
    const format = readU8(&rd)
    const entryFormat = readU8(&rd)
    if rd.err != r.OK { return rd.err }
    if format == 0 {
        map.*.mapCount = @intCast(u64, readU16(&rd))
    } else if format == 1 {
        map.*.mapCount = @intCast(u64, readU32(&rd))
    } else {
        return r.ERR_INVALID_TABLE
    }
    if rd.err != r.OK { return rd.err }
    if (entryFormat & 0xC0) != 0 { return r.ERR_INVALID_TABLE }
    const entrySize = @intCast(u64, ((entryFormat & 0x30) >> 4) + 1)
    const innerBitCount = @intCast(u64, (entryFormat & 0x0F) + 1)
    const innerMask = (@intCast(u64, 1) << @intCast(u6, innerBitCount)) - 1
    if map.*.mapCount * entrySize > tableLen { return r.ERR_INVALID_TABLE }
    if map.*.mapCount != 0 {
        map.*.inner = m.alloc(memory, @intCast(usize, map.*.mapCount) * 4)
        if map.*.inner == 0 { return r.ERR_OUT_OF_MEMORY }
        map.*.outer = m.alloc(memory, @intCast(usize, map.*.mapCount) * 4)
        if map.*.outer == 0 { return r.ERR_OUT_OF_MEMORY }
    }
    var i: u64 = 0
    while i < map.*.mapCount {
        var mapData: u64 = 0
        var j: u64 = 0
        while j < entrySize {
            const data = readU8(&rd)
            if rd.err != r.OK { return rd.err }
            mapData = ((mapData << 8) | @intCast(u64, data)) & 0xFFFFFFFF
            j += 1
        }
        if mapData == 0xFFFFFFFF {
            m.put32(map.*.outer + @intCast(usize, i) * 4, 0xFFFF)
            m.put32(map.*.inner + @intCast(usize, i) * 4, 0xFFFF)
        } else {
            const outer = mapData >> @intCast(u6, innerBitCount)
            if outer >= store.*.dataCount { return r.ERR_INVALID_TABLE }
            m.put32(map.*.outer + @intCast(usize, i) * 4, @intCast(u32, outer))
            const inner = mapData & innerMask
            if inner >= varDataAt(store, outer).*.itemCount { return r.ERR_INVALID_TABLE }
            m.put32(map.*.inner + @intCast(usize, i) * 4, @intCast(u32, inner))
        }
        i += 1
    }
    return r.OK
}

// The delta of an item at the blend's coordinates (FreeType's
// tt_var_get_item_delta), a 32-bit value.
fn itemDelta(f: *o.Face, b: *Blend, store: *Store, outer: u64, inner: u64) -> i64 {
    if b.*.normalized == 0 { return 0 }
    if outer == 0xFFFF && inner == 0xFFFF { return 0 }
    if outer >= store.*.dataCount { return 0 }
    const vd = varDataAt(store, outer)
    if inner >= vd.*.itemCount { return 0 }
    var perRegion = vd.*.wordDeltaCount + vd.*.regionIdxCount
    if vd.*.longWords { perRegion *= 2 }
    var p = vd.*.deltaSet + perRegion * inner
    var sum: i64 = 0
    var master: u64 = 0
    while master < vd.*.regionIdxCount {
        var delta: i64 = 0
        if vd.*.longWords {
            if master < vd.*.wordDeltaCount {
                delta = o.i32At(f, p)
                p += 4
            } else {
                delta = o.i16At(f, p)
                p += 2
            }
        } else {
            if master < vd.*.wordDeltaCount {
                delta = o.i16At(f, p)
                p += 2
            } else {
                delta = s8(f, p)
                p += 1
            }
        }
        var scalar: i64 = 0x10000
        const regionIndex = @intCast(u64, m.get16(vd.*.regionIndices + @intCast(usize, master) * 2))
        var j: u64 = 0
        while j < store.*.axisCount {
            const axis = store.*.regions + @intCast(usize, regionIndex * store.*.axisCount + j) * 24
            const start = m.getI64(axis)
            const peak = m.getI64(axis + 8)
            const end = m.getI64(axis + 16)
            const coord = fixedAt(b.*.normalized, j)
            j += 1
            if start > peak || peak > end { continue }
            if start < 0 && end > 0 && peak != 0 { continue }
            if peak == 0 { continue }
            if coord == peak { continue }
            if coord <= start || coord >= end {
                scalar = 0
                break
            }
            if coord < peak {
                scalar = calc.mulDiv(scalar, coord - start, peak - start)
            } else {
                scalar = calc.mulDiv(scalar, end - coord, end - peak)
            }
        }
        sum = sum +% scalar *% delta
        master += 1
    }
    return calc.low32((sum +% 0x8000) >> 16)
}

fn doneStore(memory: usize, s: *Store) -> void {
    if s.*.data != 0 {
        var i: u64 = 0
        while i < s.*.dataCount {
            m.release(memory, varDataAt(s, i).*.regionIndices)
            i += 1
        }
        m.release(memory, s.*.data)
    }
    m.release(memory, s.*.regions)
    s.*.data = 0
    s.*.regions = 0
}

fn doneMap(memory: usize, map: *IdxMap) -> void {
    m.release(memory, map.*.inner)
    m.release(memory, map.*.outer)
    map.*.inner = 0
    map.*.outer = 0
}

// The outer and inner indices of entry `index` of a map (the last one for
// those past its end), or `index` of the first item variation data when
// there is no map.
fn mapIndex(map: *IdxMap, index: u64) -> (u64, u64) {
    if map.*.inner == 0 { return -> (0, index) }
    var idx = index
    if idx >= map.*.mapCount { idx = map.*.mapCount - 1 }
    return -> (@intCast(u64, m.get32(map.*.outer + @intCast(usize, idx) * 4)), @intCast(u64, m.get32(map.*.inner + @intCast(usize, idx) * 4)))
}

// ---------------------------------------------------------------------------
// `avar` (FreeType's ft_var_load_avar).

fn loadAvar(f: *o.Face, b: *Blend) -> void {
    const memory = f.*.memory
    b.*.avarLoaded = true
    const t = o.table(f, o.TAG_avar)
    if t.1 == 0 { return }
    const tableLen = t.1
    if !o.within(f, t.0, tableLen) { return }
    var p = t.0
    const version = o.i32At(f, p)
    const axisCount = o.i32At(f, p + 4)
    p += 8
    if version != 0x00010000 && version != 0x00020000 { return }
    if axisCount != @intCast(i64, b.*.numAxis) { return }
    b.*.hasAvar = true
    if axisCount != 0 {
        b.*.avarSegments = m.alloc(memory, @intCast(usize, axisCount) * 16)
        if b.*.avarSegments == 0 { return }
    }
    var i: i64 = 0
    while i < axisCount {
        const pairCount = o.u16At(f, p)
        p += 2
        var pairs: usize = 0
        if @intCast(u64, pairCount) * 4 > tableLen {
            freeSegments(memory, b, i)
            return
        }
        if pairCount != 0 {
            pairs = m.alloc(memory, @intCast(usize, pairCount) * 16)
            if pairs == 0 {
                freeSegments(memory, b, i)
                return
            }
        }
        const seg = b.*.avarSegments + @intCast(usize, i) * 16
        m.putI64(seg, pairCount)
        m.putWord(seg + 8, pairs)
        var j: i64 = 0
        while j < pairCount {
            m.putI64(pairs + @intCast(usize, j) * 16, fdot14ToFixed(o.i16At(f, p)))
            m.putI64(pairs + @intCast(usize, j) * 16 + 8, fdot14ToFixed(o.i16At(f, p + 2)))
            p += 4
            j += 1
        }
        i += 1
    }
    if version < 0x00020000 { return }
    const axisMapOffset = @intCast(u64, o.u32At(f, p))
    const storeOffset = @intCast(u64, o.u32At(f, p + 4))
    if storeOffset != 0 {
        if loadItemStore(f, b, t.0 + storeOffset, &b.*.avarStore) != r.OK { return }
    }
    if axisMapOffset != 0 {
        _ = loadIdxMap(f, t.0 + axisMapOffset, &b.*.avarMap, &b.*.avarStore, tableLen)
    }
}

// The segments of the first `count` axes freed, and none kept.
fn freeSegments(memory: usize, b: *Blend, count: i64) -> void {
    var j: i64 = count - 1
    while j >= 0 {
        m.release(memory, m.getWord(b.*.avarSegments + @intCast(usize, j) * 16 + 8))
        j -= 1
    }
    m.release(memory, b.*.avarSegments)
    b.*.avarSegments = 0
}

fn segmentPairs(b: *Blend, axis: u64) -> (i64, usize) {
    const seg = b.*.avarSegments + @intCast(usize, axis) * 16
    return -> (m.getI64(seg), m.getWord(seg + 8))
}

// ---------------------------------------------------------------------------
// `HVAR` and `VVAR` (FreeType's ft_var_load_hvvar and tt_hvadvance_adjust).

fn loadHvvar(f: *o.Face, b: *Blend, vertical: bool) -> i32 {
    var t = o.table(f, o.TAG_HVAR)
    if vertical {
        b.*.vvarLoaded = true
        t = o.table(f, o.TAG_VVAR)
    } else {
        b.*.hvarLoaded = true
    }
    var err = r.OK
    if t.1 == 0 {
        err = r.ERR_TABLE_MISSING
    } else {
        err = loadHvvarTable(f, b, vertical, t.0, t.1)
    }
    if err == r.OK {
        if vertical {
            b.*.vvarChecked = true
            b.*.support |= VAR_VADVANCE
        } else {
            b.*.hvarChecked = true
            b.*.support |= VAR_HADVANCE
        }
    }
    return err
}

fn loadHvvarTable(f: *o.Face, b: *Blend, vertical: bool, offset: u64, tableLen: u64) -> i32 {
    var rd = reader(f, offset)
    if rd.err != r.OK { return rd.err }
    const majorVersion = readU16(&rd)
    _ = readU16(&rd)
    if rd.err != r.OK { return rd.err }
    if majorVersion != 1 { return r.ERR_INVALID_TABLE }
    const storeOffset = @intCast(u64, readU32(&rd))
    const mapOffset = @intCast(u64, readU32(&rd))
    if rd.err != r.OK { return rd.err }
    const store = if vertical { &b.*.vvarStore } else { &b.*.hvarStore }
    const map = if vertical { &b.*.vvarMap } else { &b.*.hvarMap }
    var err = loadItemStore(f, b, offset + storeOffset, store)
    if err != r.OK { return err }
    if mapOffset != 0 {
        err = loadIdxMap(f, offset + mapOffset, map, store, tableLen)
        if err != r.OK { return err }
    }
    return r.OK
}

// An advance adjusted by `HVAR` or `VVAR`: the error of loading the table
// and the advance.
fn advanceAdjust(f: *o.Face, b: *Blend, gindex: i64, value: i64, vertical: bool) -> (i32, i64) {
    if !b.*.doblend { return -> (r.OK, value) }
    if vertical {
        if !b.*.vvarLoaded { b.*.vvarError = loadHvvar(f, b, true) }
        if !b.*.vvarChecked { return -> (b.*.vvarError, value) }
    } else {
        if !b.*.hvarLoaded { b.*.hvarError = loadHvvar(f, b, false) }
        if !b.*.hvarChecked { return -> (b.*.hvarError, value) }
    }
    const store = if vertical { &b.*.vvarStore } else { &b.*.hvarStore }
    const map = if vertical { &b.*.vvarMap } else { &b.*.hvarMap }
    const idx = mapIndex(map, @intCast(u64, gindex))
    const delta = itemDelta(f, b, store, idx.0, idx.1)
    if delta != 0 { return -> (r.OK, calc.low32(value +% delta)) }
    return -> (r.OK, value)
}

// ---------------------------------------------------------------------------
// `MVAR` (FreeType's ft_var_load_mvar and tt_apply_mvar).

// The address of the 16-bit value that the `MVAR` tag varies (0 for one
// the library does not know).
fn valuePointer(f: *o.Face, b: *Blend, tag: u32) -> usize {
    if (tag >> 8) == 0x677370 && (tag & 0xFF) >= 48 && (tag & 0xFF) <= 57 {
        const idx = @intCast(i64, tag & 0xFF) - 48
        if idx < f.*.gaspRanges - 1 && b.*.gaspMax != 0 { return b.*.gaspMax + @intCast(usize, idx) * 2 }
        return 0
    }
    const names = "cphthaschclahcldhcofhcrnhcrshdschlgpsbxosbxssbyosbysspxospxsspyospysstrostrsundoundsvascvcofvcrnvcrsvdscvlgpxhgt"
    var i: usize = 0
    while i < 28 {
        const t = (@intCast(u32, names[i * 4]) << 24) | (@intCast(u32, names[i * 4 + 1]) << 16) | (@intCast(u32, names[i * 4 + 2]) << 8) | @intCast(u32, names[i * 4 + 3])
        if t == tag { return fieldAddress(f, i) }
        i += 1
    }
    return 0
}

// The fields of the tags above, in their order: in TT_OS2, TT_HoriHeader,
// TT_VertHeader and TT_Postscript.
fn fieldAddress(f: *o.Face, i: usize) -> usize {
    if i == 0 { return f.*.os2 + 122 }
    if i == 1 { return f.*.os2 + 90 }
    if i == 2 { return f.*.os2 + 96 }
    if i == 3 { return f.*.os2 + 98 }
    if i == 4 { return f.*.hhea + 26 }
    if i == 5 { return f.*.hhea + 24 }
    if i == 6 { return f.*.hhea + 22 }
    if i == 7 { return f.*.os2 + 92 }
    if i == 8 { return f.*.os2 + 94 }
    if i == 9 { return f.*.os2 + 14 }
    if i == 10 { return f.*.os2 + 10 }
    if i == 11 { return f.*.os2 + 16 }
    if i == 12 { return f.*.os2 + 12 }
    if i == 13 { return f.*.os2 + 22 }
    if i == 14 { return f.*.os2 + 18 }
    if i == 15 { return f.*.os2 + 24 }
    if i == 16 { return f.*.os2 + 20 }
    if i == 17 { return f.*.os2 + 28 }
    if i == 18 { return f.*.os2 + 26 }
    if i == 19 { return f.*.post + 16 }
    if i == 20 { return f.*.post + 18 }
    if i == 21 { return f.*.vhea + 8 }
    if i == 22 { return f.*.vhea + 26 }
    if i == 23 { return f.*.vhea + 24 }
    if i == 24 { return f.*.vhea + 22 }
    if i == 25 { return f.*.vhea + 10 }
    if i == 26 { return f.*.vhea + 12 }
    return f.*.os2 + 120
}

fn loadMvar(f: *o.Face, b: *Blend) -> void {
    const memory = f.*.memory
    const t = o.table(f, o.TAG_MVAR)
    if t.1 == 0 { return }
    var rd = reader(f, t.0)
    if rd.err != r.OK { return }
    const majorVersion = readU16(&rd)
    _ = readU16(&rd)
    if rd.err != r.OK { return }
    if majorVersion != 1 { return }
    b.*.hasMvar = true
    _ = readU32(&rd)
    const valueCount = @intCast(u64, readU16(&rd))
    const storeOffset = @intCast(u64, readU16(&rd))
    if rd.err != r.OK { return }
    b.*.mvarCount = valueCount
    const recordsOffset = rd.pos
    if loadItemStore(f, b, t.0 + storeOffset, &b.*.mvarStore) != r.OK { return }
    if valueCount != 0 {
        b.*.mvarValues = m.alloc(memory, @intCast(usize, valueCount) * 16)
        if b.*.mvarValues == 0 { return }
    }
    if !o.within(f, recordsOffset, valueCount * 8) { return }
    if f.*.gaspRanges > 0 && b.*.gaspMax == 0 {
        b.*.gaspMax = m.alloc(memory, @intCast(usize, f.*.gaspRanges) * 2)
        if b.*.gaspMax == 0 { return }
        var g: i64 = 0
        while g < f.*.gaspRanges {
            m.put16(b.*.gaspMax + @intCast(usize, g) * 2, @intCast(u16, o.u16At(f, f.*.gaspOffset + @intCast(u64, g) * 4)))
            g += 1
        }
    }
    var p = recordsOffset
    var i: u64 = 0
    while i < valueCount {
        const value = b.*.mvarValues + @intCast(usize, i) * 16
        const outer = o.u16At(f, p + 4)
        const inner = o.u16At(f, p + 6)
        m.put32(value, @intCast(u32, o.u32At(f, p)))
        m.put16(value + 4, @intCast(u16, outer))
        m.put16(value + 6, @intCast(u16, inner))
        p += 8
        i += 1
        if outer == 0xFFFF && inner == 0xFFFF { continue }
        if @intCast(u64, outer) >= b.*.mvarStore.dataCount || @intCast(u64, inner) >= varDataAt(&b.*.mvarStore, @intCast(u64, outer)).*.itemCount { return }
    }
    i = 0
    while i < valueCount {
        const value = b.*.mvarValues + @intCast(usize, i) * 16
        const at = valuePointer(f, b, m.get32(value))
        if at != 0 { m.put16(value + 8, m.get16(at)) }
        i += 1
    }
    b.*.support |= VAR_MVAR
}

// The global metrics varied (FreeType's tt_apply_mvar, the metrics
// adjustment of FT_Set_Var_Design_Coordinates and the like).
fn applyMvar(face: usize) -> void {
    const f = o.faceRecord(face)
    const root = o.faceRecord(face)
    if f.*.blend == 0 { return }
    const b = blendOf(f)
    if (b.*.support & VAR_MVAR) == 0 { return }
    var hascDelta: i64 = 0
    var hdscDelta: i64 = 0
    var hlgpDelta: i64 = 0
    var i: u64 = 0
    while i < b.*.mvarCount {
        const value = b.*.mvarValues + @intCast(usize, i) * 16
        const tag = m.get32(value)
        const at = valuePointer(f, b, tag)
        const delta = itemDelta(f, b, &b.*.mvarStore, @intCast(u64, m.get16(value + 4)), @intCast(u64, m.get16(value + 6)))
        if at != 0 && delta != 0 {
            m.putI16(at, @intCast(i16, calc.low16(@intCast(i64, m.getI16(value + 8)) + calc.low16(delta))))
            if tag == 0x68617363 {
                hascDelta = calc.low16(delta)
            } else if tag == 0x68647363 {
                hdscDelta = calc.low16(delta)
            } else if tag == 0x686C6770 {
                hlgpDelta = calc.low16(delta)
            }
        }
        i += 1
    }
    const lineGap = calc.low16(@intCast(i64, root.*.height) - @intCast(i64, root.*.ascender) + @intCast(i64, root.*.descender))
    root.*.ascender = @intCast(i16, calc.low16(@intCast(i64, root.*.ascender) + hascDelta))
    root.*.descender = @intCast(i16, calc.low16(@intCast(i64, root.*.descender) + hdscDelta))
    root.*.height = @intCast(i16, calc.low16(@intCast(i64, root.*.ascender) - @intCast(i64, root.*.descender) + lineGap + hlgpDelta))
    const position = @intCast(i64, m.getI16(f.*.post + 16))
    const thickness = @intCast(i64, m.getI16(f.*.post + 18))
    root.*.underlinePosition = @intCast(i16, calc.low16(position - thickness / 2))
    root.*.underlineThickness = @intCast(i16, thickness)
    // The TrueType driver's sizes recompute their heights (FreeType's
    // tt_size_reset_height); the CFF driver's do not.
    if f.*.driver == library.TRUETYPE {
        var size = root.*.sizes
        while size != 0 {
            resetHeight(face, size)
            size = o.sizeRecord(size).*.next
        }
    }
}

fn resetHeight(face: usize, size: usize) -> void {
    const f = o.faceRecord(face)
    const root = o.faceRecord(face)
    const s = o.sizeRecord(size)
    const t = o.sizeRecord(size)
    t.*.ttValid = false
    t.*.tt_x_ppem = @intCast(i64, s.*.xPpem)
    t.*.tt_y_ppem = @intCast(i64, s.*.yPpem)
    t.*.tt_x_scale = s.*.xScale
    t.*.tt_y_scale = s.*.yScale
    t.*.tt_ascender = s.*.ascender
    t.*.tt_descender = s.*.descender
    t.*.tt_height = s.*.height
    t.*.tt_max_advance = s.*.maxAdvance
    if s.*.xPpem < 1 || s.*.yPpem < 1 { return }
    if (sfnt.headFlags(f) & 8) != 0 {
        t.*.tt_ascender = calc.pixRound(calc.mulFix(@intCast(i64, root.*.ascender), s.*.yScale))
        t.*.tt_descender = calc.pixRound(calc.mulFix(@intCast(i64, root.*.descender), s.*.yScale))
        t.*.tt_height = calc.pixRound(calc.mulFix(@intCast(i64, root.*.height), s.*.yScale))
    }
    t.*.ttValid = true
}

// The maxPPEM of `gasp` range `index` (as `MVAR` varies it).
pub fn gaspMaxPPEM(f: *o.Face, index: i64) -> i64 {
    if f.*.blend != 0 {
        const b = blendOf(f)
        if b.*.gaspMax != 0 { return @intCast(i64, m.get16(b.*.gaspMax + @intCast(usize, index) * 2)) }
    }
    return o.u16At(f, f.*.gaspOffset + @intCast(u64, index) * 4)
}

// ---------------------------------------------------------------------------
// `gvar` (FreeType's ft_var_load_gvar).

fn loadGvar(f: *o.Face, b: *Blend) -> i32 {
    const memory = f.*.memory
    const t = o.table(f, o.TAG_gvar)
    if t.1 == 0 { return r.ERR_TABLE_MISSING }
    const tableLen = t.1
    const start = t.0
    if !o.within(f, start, 20) { return r.ERR_INVALID_STREAM_OPERATION }
    const version = o.i32At(f, start)
    const axisCount = @intCast(u64, o.u16At(f, start + 4))
    const globalCoordCount = @intCast(u64, o.u16At(f, start + 6))
    const offsetToCoord = @intCast(u64, o.u32At(f, start + 8))
    const glyphCount = @intCast(u64, o.u16At(f, start + 12))
    const flags = o.u16At(f, start + 14)
    const offsetToData = start + @intCast(u64, o.u32At(f, start + 16))
    if version != 0x00010000 { return r.ERR_INVALID_TABLE }
    if axisCount != (b.*.numAxis & 0xFFFF) { return r.ERR_INVALID_TABLE }
    if globalCoordCount * axisCount > tableLen / 2 { return r.ERR_INVALID_TABLE }
    const longOffsets = (flags & 1) != 0
    const offsetsLen = (glyphCount + 1) * (if longOffsets { @intCast(u64, 4) } else { @intCast(u64, 2) })
    if offsetsLen > tableLen { return r.ERR_INVALID_TABLE }
    b.*.gvarSize = tableLen
    if !o.within(f, start + 20, offsetsLen) { return r.ERR_INVALID_STREAM_OPERATION }
    b.*.glyphOffsets = m.alloc(memory, @intCast(usize, glyphCount + 1) * 8)
    if b.*.glyphOffsets == 0 { return r.ERR_OUT_OF_MEMORY }
    const limit = start + tableLen
    var maxOffset: u64 = 0
    var i: u64 = 0
    while i <= glyphCount {
        var value: u64 = 0
        if longOffsets {
            value = offsetToData + @intCast(u64, o.u32At(f, start + 20 + i * 4))
        } else {
            value = offsetToData + @intCast(u64, o.u16At(f, start + 20 + i * 2)) * 2
        }
        if maxOffset <= value { maxOffset = value } else { value = maxOffset }
        if limit < value { value = limit }
        m.put64(b.*.glyphOffsets + @intCast(usize, i) * 8, value)
        i += 1
    }
    b.*.gvGlyphCount = glyphCount
    if globalCoordCount != 0 {
        const at = start + offsetToCoord
        if at > f.*.size || !o.within(f, at, globalCoordCount * axisCount * 2) {
            m.release(memory, b.*.glyphOffsets)
            b.*.glyphOffsets = 0
            b.*.gvGlyphCount = 0
            return r.ERR_INVALID_STREAM_OPERATION
        }
        b.*.tupleCoords = m.alloc(memory, @intCast(usize, axisCount * globalCoordCount) * 8)
        if b.*.tupleCoords == 0 {
            m.release(memory, b.*.glyphOffsets)
            b.*.glyphOffsets = 0
            b.*.gvGlyphCount = 0
            return r.ERR_OUT_OF_MEMORY
        }
        i = 0
        while i < globalCoordCount * axisCount {
            setFixedAt(b.*.tupleCoords, i, fdot14ToFixed(o.i16At(f, at + i * 2)))
            i += 1
        }
        b.*.tupleCount = globalCoordCount
    }
    return r.OK
}

// The factor of a tuple at the blend's coordinates (FreeType's
// ft_var_apply_tuple).
fn applyTuple(b: *Blend, tupleIndex: u64, tuple: usize, imStart: usize, imEnd: usize) -> i64 {
    var apply: i64 = 0x10000
    var i: u64 = 0
    while i < b.*.numAxis {
        const t = fixedAt(tuple, i)
        const c = fixedAt(b.*.normalized, i)
        i += 1
        if t == 0 { continue }
        if c == 0 { return 0 }
        if c == t { continue }
        if (tupleIndex & INTERMEDIATE_TUPLE) == 0 {
            if c < calc.min(0, t) || c > calc.max(0, t) { return 0 }
            apply = calc.mulDiv(apply, c, t)
        } else {
            const s = fixedAt(imStart, i - 1)
            const e = fixedAt(imEnd, i - 1)
            if c <= s || c >= e { return 0 }
            if c < t {
                apply = calc.mulDiv(apply, c - s, t - s)
            } else {
                apply = calc.mulDiv(apply, e - c, e - t)
            }
        }
    }
    return apply
}

// ---------------------------------------------------------------------------
// Design and normalized coordinates.

// FreeType's ft_var_to_normalized.
fn toNormalized(f: *o.Face, b: *Blend, numCoords_: u64, coords: usize, normalized: usize) -> void {
    const memory = f.*.memory
    const mmvar = b.*.mmvar
    const numAxis = @intCast(u64, m.get32(mmvar))
    var numCoords = numCoords_
    if numCoords > numAxis { numCoords = numAxis }
    const axes = m.getWord(mmvar + 16)
    var i: u64 = 0
    while i < numCoords {
        const a = axes + @intCast(usize, i) * AXIS_SIZE
        const coord = fixedAt(coords, i)
        const minimum = m.getI64(a + 8)
        const def = m.getI64(a + 16)
        const maximum = m.getI64(a + 24)
        var n: i64 = 0
        if coord > def {
            n = if coord >= maximum { 0x10000 } else { calc.divFix(coord -% def, maximum -% def) }
        } else if coord < def {
            n = if coord <= minimum { -0x10000 } else { calc.divFix(coord -% def, def -% minimum) }
        }
        setFixedAt(normalized, i, n)
        i += 1
    }
    while i < numAxis {
        setFixedAt(normalized, i, 0)
        i += 1
    }
    if !b.*.hasAvar { return }
    if b.*.avarSegments != 0 {
        i = 0
        while i < numAxis {
            const seg = segmentPairs(b, i)
            const v = fixedAt(normalized, i)
            var j: i64 = 1
            while j < seg.0 {
                const pj = seg.1 + @intCast(usize, j) * 16
                const pk = seg.1 + @intCast(usize, j - 1) * 16
                if v < m.getI64(pj) {
                    setFixedAt(normalized, i, calc.mulDiv(v - m.getI64(pk), m.getI64(pj + 8) - m.getI64(pk + 8), m.getI64(pj) - m.getI64(pk)) + m.getI64(pk + 8))
                    break
                }
                j += 1
            }
            i += 1
        }
    }
    if b.*.avarStore.data != 0 {
        const fresh = m.alloc(memory, @intCast(usize, numAxis) * 8)
        if fresh == 0 { return }
        const old = b.*.normalized
        b.*.normalized = normalized
        i = 0
        while i < numAxis {
            var v = fixedAt(normalized, i)
            const idx = mapIndex(&b.*.avarMap, i)
            const delta = itemDelta(f, b, &b.*.avarStore, idx.0, idx.1)
            v = v +% calc.shl(delta, 2)
            if v >= 0x10000 { v = 0x10000 }
            if v <= -0x10000 { v = -0x10000 }
            setFixedAt(fresh, i, v)
            i += 1
        }
        m.copy(normalized, fresh, @intCast(usize, numAxis) * 8)
        b.*.normalized = old
        m.release(memory, fresh)
    }
}

// FreeType's ft_var_to_design.
fn toDesign(b: *Blend, numCoords: u64, coords: usize, design: usize) -> void {
    var nc = numCoords
    if numCoords > b.*.numAxis { nc = b.*.numAxis }
    var i: u64 = 0
    while i < nc {
        setFixedAt(design, i, fixedAt(coords, i))
        i += 1
    }
    while i < numCoords {
        setFixedAt(design, i, 0)
        i += 1
    }
    if b.*.hasAvar && b.*.avarSegments != 0 {
        i = 0
        while i < nc {
            const seg = segmentPairs(b, i)
            const v = fixedAt(design, i)
            var j: i64 = 1
            while j < seg.0 {
                const pj = seg.1 + @intCast(usize, j) * 16
                const pk = seg.1 + @intCast(usize, j - 1) * 16
                if v < m.getI64(pj + 8) {
                    setFixedAt(design, i, calc.mulDiv(v - m.getI64(pk + 8), m.getI64(pj) - m.getI64(pk), m.getI64(pj + 8) - m.getI64(pk + 8)) + m.getI64(pk))
                    break
                }
                j += 1
            }
            i += 1
        }
    }
    const axes = m.getWord(b.*.mmvar + 16)
    i = 0
    while i < nc {
        const a = axes + @intCast(usize, i) * AXIS_SIZE
        const def = m.getI64(a + 16)
        const v = fixedAt(design, i)
        if v < 0 {
            setFixedAt(design, i, def + calc.mulFix(v, def - m.getI64(a + 8)))
        } else if v > 0 {
            setFixedAt(design, i, def + calc.mulFix(v, m.getI64(a + 24) - def))
        } else {
            setFixedAt(design, i, def)
        }
        i += 1
    }
}

// ---------------------------------------------------------------------------
// The FT_MM_Var of the face (FreeType's TT_Get_MM_Var): made with the
// blend when first asked for; a copy of it in `out` when not 0.

fn align8(n: usize) -> usize { return (n + 7) & ~@intCast(usize, 7) }

fn getMMVar(face: usize, out: usize) -> i32 {
    const f = o.faceRecord(face)
    const root = o.faceRecord(face)
    const memory = f.*.memory
    const numInstances = @intCast(u64, @bitCast(u64, root.*.styleFlags) & 0xFFFFFFFF) >> 16
    const needInit = f.*.blend == 0
    var numAxes: u64 = 0
    var fvarStart: u64 = 0
    var offsetToData: u64 = 0
    var instanceCount: u64 = 0
    var usePsName = false
    if needInit {
        const t = o.table(f, o.TAG_fvar)
        if t.1 == 0 { return r.ERR_TABLE_MISSING }
        fvarStart = t.0
        if !o.within(f, fvarStart, 16) { return r.ERR_INVALID_STREAM_OPERATION }
        offsetToData = @intCast(u64, o.u16At(f, fvarStart + 4))
        const axisCount = @intCast(u64, o.u16At(f, fvarStart + 8))
        instanceCount = @intCast(u64, o.u16At(f, fvarStart + 12))
        const instanceSize = @intCast(u64, o.u16At(f, fvarStart + 14))
        if numInstances < instanceCount { return r.ERR_INVALID_TABLE }
        usePsName = instanceSize == 6 + 4 * axisCount
        const blend = m.alloc(memory, @sizeOf(Blend))
        if blend == 0 { return r.ERR_OUT_OF_MEMORY }
        f.*.blend = blend
        numAxes = axisCount
        blendOf(f).*.numAxis = numAxes
    } else {
        numAxes = blendOf(f).*.numAxis
    }
    const b = blendOf(f)
    const mmvarSize = align8(MM_VAR_SIZE)
    const axisFlagsSize = align8(@intCast(usize, numAxes) * 2)
    const axisSize = align8(@intCast(usize, numAxes) * AXIS_SIZE)
    const namedSize = align8(@intCast(usize, numInstances) * STYLE_SIZE)
    const coordsSize = align8(@intCast(usize, numInstances * numAxes) * 8)
    const nameSize = @intCast(usize, numAxes) * 5
    if needInit {
        b.*.mmvarLen = mmvarSize + axisFlagsSize + axisSize + namedSize + coordsSize + nameSize
        const mmvar = m.alloc(memory, b.*.mmvarLen)
        if mmvar == 0 { return r.ERR_OUT_OF_MEMORY }
        b.*.mmvar = mmvar
        m.put32(mmvar, @intCast(u32, numAxes))
        m.put32(mmvar + 4, 0xFFFFFFFF)
        m.put32(mmvar + 8, @intCast(u32, numInstances))
        const axisFlags = mmvar + mmvarSize
        const axes = axisFlags + axisFlagsSize
        const styles = axes + axisSize
        m.putWord(mmvar + 16, axes)
        m.putWord(mmvar + 24, styles)
        var nextCoords = styles + namedSize
        var i: u64 = 0
        while i < numInstances {
            m.putWord(styles + @intCast(usize, i) * STYLE_SIZE, nextCoords)
            nextCoords += @intCast(usize, numAxes) * 8
            i += 1
        }
        var nextName = styles + namedSize + coordsSize
        i = 0
        while i < numAxes {
            m.putWord(axes + @intCast(usize, i) * AXIS_SIZE, nextName)
            nextName += 5
            i += 1
        }
        var p = fvarStart + offsetToData
        if p > f.*.size { return r.ERR_INVALID_STREAM_OPERATION }
        i = 0
        while i < numAxes {
            if !o.within(f, p, 20) { return r.ERR_INVALID_STREAM_OPERATION }
            const a = axes + @intCast(usize, i) * AXIS_SIZE
            const tag = @intCast(u64, o.u32At(f, p))
            var minimum = o.i32At(f, p + 4)
            const def = o.i32At(f, p + 8)
            var maximum = o.i32At(f, p + 12)
            if minimum > def || def > maximum {
                minimum = def
                maximum = def
            }
            m.putI64(a + 8, minimum)
            m.putI64(a + 16, def)
            m.putI64(a + 24, maximum)
            m.put64(a + 32, tag)
            m.put32(a + 40, @intCast(u32, o.u16At(f, p + 18)))
            const name = m.getWord(a)
            m.put8(name, @intCast(u8, (tag >> 24) & 0xFF))
            m.put8(name + 1, @intCast(u8, (tag >> 16) & 0xFF))
            m.put8(name + 2, @intCast(u8, (tag >> 8) & 0xFF))
            m.put8(name + 3, @intCast(u8, tag & 0xFF))
            m.put8(name + 4, 0)
            m.put16(axisFlags + @intCast(usize, i) * 2, @intCast(u16, o.u16At(f, p + 16)))
            p += 20
            i += 1
        }
        if numAxes * numInstances != 0 {
            b.*.styleCoords = m.alloc(memory, @intCast(usize, numAxes * numInstances) * 8)
            if b.*.styleCoords == 0 { return r.ERR_OUT_OF_MEMORY }
        }
        if instanceCount != 0 && !b.*.avarLoaded { loadAvar(f, b) }
        const record = (if usePsName { @intCast(u64, 6) } else { @intCast(u64, 4) }) + 4 * numAxes
        i = 0
        while i < instanceCount {
            if !o.within(f, p, record) { return r.ERR_INVALID_STREAM_OPERATION }
            const style = styles + @intCast(usize, i) * STYLE_SIZE
            m.put32(style + 8, @intCast(u32, o.u16At(f, p)))
            const c = m.getWord(style)
            var j: u64 = 0
            while j < numAxes {
                setFixedAt(c, j, o.i32At(f, p + 4 + j * 4))
                j += 1
            }
            m.put32(style + 12, if usePsName { @intCast(u32, o.u16At(f, p + 4 + numAxes * 4)) } else { 0xFFFF })
            toNormalized(f, b, numAxes, c, b.*.styleCoords + @intCast(usize, i * numAxes) * 8)
            p += record
            i += 1
        }
        if numInstances != instanceCount {
            var strid: u32 = 0xFFFFFFFF
            var ids = sfnt.nameIds(f, 17)
            var found = ids.0 >= 0 || ids.1 >= 0
            if found {
                strid = 17
            } else {
                ids = sfnt.nameIds(f, 2)
                found = ids.0 >= 0 || ids.1 >= 0
                if found { strid = 2 }
            }
            if found {
                ids = sfnt.nameIds(f, 6)
                if ids.0 >= 0 || ids.1 >= 0 {
                    f.*.varDefaultNamedInstance = @intCast(i64, numInstances)
                    const style = styles + @intCast(usize, instanceCount) * STYLE_SIZE
                    m.put32(style + 8, strid)
                    m.put32(style + 12, 6)
                    const c = m.getWord(style)
                    var j: u64 = 0
                    while j < numAxes {
                        setFixedAt(c, j, m.getI64(axes + @intCast(usize, j) * AXIS_SIZE + 16))
                        j += 1
                    }
                }
            }
        }
        loadMvar(f, b)
    }
    if out != 0 {
        const copy = m.alloc(memory, b.*.mmvarLen)
        if copy == 0 { return r.ERR_OUT_OF_MEMORY }
        m.copy(copy, b.*.mmvar, b.*.mmvarLen)
        const axisFlags = copy + mmvarSize
        const axes = axisFlags + axisFlagsSize
        const styles = axes + axisSize
        m.putWord(copy + 16, axes)
        m.putWord(copy + 24, styles)
        var nextCoords = styles + namedSize
        var n: u64 = 0
        while n < @intCast(u64, m.get32(copy + 8)) {
            m.putWord(styles + @intCast(usize, n) * STYLE_SIZE, nextCoords)
            nextCoords += @intCast(usize, numAxes) * 8
            n += 1
        }
        var nextName = styles + namedSize + coordsSize
        n = 0
        while n < numAxes {
            const a = axes + @intCast(usize, n) * AXIS_SIZE
            const tag = m.get64(a + 32)
            var name = nextName
            if tag == 0x77676874 {
                name = m.literal("Weight\x00")
            } else if tag == 0x77647468 {
                name = m.literal("Width\x00")
            } else if tag == 0x6F70737A {
                name = m.literal("OpticalSize\x00")
            } else if tag == 0x736C6E74 {
                name = m.literal("Slant\x00")
            } else if tag == 0x6974616C {
                name = m.literal("Italic\x00")
            }
            m.putWord(a, name)
            nextName += 5
            n += 1
        }
        m.putWord(out, copy)
    }
    return r.OK
}

// ---------------------------------------------------------------------------
// Setting and reading coordinates.

// FreeType's tt_set_mm_blend: the normalized coordinates set (the rest
// of the axes keep theirs); -1 when nothing changes.
fn setMMBlend(face: usize, numCoords_: u64, coords: usize, setDesign: bool) -> i32 {
    const f = o.faceRecord(face)
    const root = o.faceRecord(face)
    const memory = f.*.memory
    if f.*.blend != 0 { blendOf(f).*.doblend = false }
    if f.*.blend == 0 {
        const err = getMMVar(face, 0)
        if err != r.OK { return err }
    }
    const b = blendOf(f)
    b.*.doblend = false
    const numAxis = @intCast(u64, m.get32(b.*.mmvar))
    var numCoords = numCoords_
    if numCoords > numAxis { numCoords = numAxis }
    var i: u64 = 0
    while i < numCoords {
        const c = fixedAt(coords, i)
        if c < -0x10000 || c > 0x10000 { return r.ERR_INVALID_ARGUMENT }
        i += 1
    }
    if f.*.outlines != o.OUTLINES_CFF2 && b.*.glyphOffsets == 0 {
        const err = loadGvar(f, b)
        if err != r.ERR_TABLE_MISSING && err != r.OK { return err }
    }
    var allDesign = false
    if b.*.coords == 0 {
        b.*.coords = m.alloc(memory, @intCast(usize, numAxis) * 8 + 8)
        if b.*.coords == 0 { return r.ERR_OUT_OF_MEMORY }
        allDesign = true
    }
    if b.*.normalized == 0 {
        b.*.normalized = m.alloc(memory, @intCast(usize, numAxis) * 8 + 8)
        if b.*.normalized == 0 { return r.ERR_OUT_OF_MEMORY }
    } else {
        var haveDiff = false
        i = 0
        while i < numCoords {
            if fixedAt(b.*.normalized, i) != fixedAt(coords, i) {
                haveDiff = true
                break
            }
            i += 1
        }
        if !haveDiff {
            if (root.*.faceIndex & 0x7FFF0000) != 0 {
                const instance = @intCast(u64, (@bitCast(u64, root.*.faceIndex) & 0xFFFFFFFF) >> 16)
                var j = i
                while j < numAxis {
                    if fixedAt(b.*.normalized, j) != fixedAt(b.*.styleCoords + @intCast(usize, (instance - 1) * numAxis) * 8, j) { haveDiff = true }
                    j += 1
                }
            } else {
                var j = i
                while j < numAxis {
                    if fixedAt(b.*.normalized, j) != 0 { haveDiff = true }
                    j += 1
                }
            }
        }
        if !haveDiff {
            b.*.doblend = true
            return -1
        }
    }
    b.*.numAxis = numAxis
    if coords != 0 { m.copy(b.*.normalized, coords, @intCast(usize, numCoords) * 8) }
    if setDesign { toDesign(b, if allDesign { b.*.numAxis } else { numCoords }, b.*.normalized, b.*.coords) }
    b.*.doblend = true
    return r.OK
}

// FreeType's TT_Get_MM_Blend.
fn getMMBlend(face: usize, numCoords: u64, coords: usize) -> i32 {
    const f = o.faceRecord(face)
    if f.*.blend == 0 {
        const err = getMMVar(face, 0)
        if err != r.OK { return err }
    }
    const b = blendOf(f)
    if b.*.coords == 0 {
        const err = setMMBlend(face, 0, 0, true)
        if err != r.OK { return err }
    }
    var nc = numCoords
    if numCoords > b.*.numAxis { nc = b.*.numAxis }
    var i: u64 = 0
    while i < nc {
        setFixedAt(coords, i, if b.*.doblend { fixedAt(b.*.normalized, i) } else { 0 })
        i += 1
    }
    while i < numCoords {
        setFixedAt(coords, i, 0)
        i += 1
    }
    return r.OK
}

// FreeType's TT_Set_Var_Design.
fn setVarDesign(face: usize, numCoords_: u64, coords: usize) -> i32 {
    const f = o.faceRecord(face)
    const root = o.faceRecord(face)
    const memory = f.*.memory
    if f.*.blend == 0 {
        const err = getMMVar(face, 0)
        if err != r.OK { return err }
    }
    const b = blendOf(f)
    const mmvar = b.*.mmvar
    const numAxis = @intCast(u64, m.get32(mmvar))
    var numCoords = numCoords_
    if numCoords > numAxis { numCoords = numAxis }
    if b.*.coords == 0 {
        b.*.coords = m.alloc(memory, @intCast(usize, numAxis) * 8 + 8)
        if b.*.coords == 0 { return r.ERR_OUT_OF_MEMORY }
    }
    var haveDiff = false
    var i: u64 = 0
    while i < numCoords {
        if fixedAt(b.*.coords, i) != fixedAt(coords, i) {
            setFixedAt(b.*.coords, i, fixedAt(coords, i))
            haveDiff = true
        }
        i += 1
    }
    if (root.*.faceIndex & 0x7FFF0000) != 0 {
        const instance = @intCast(u64, (@bitCast(u64, root.*.faceIndex) & 0xFFFFFFFF) >> 16)
        const style = m.getWord(mmvar + 24) + @intCast(usize, instance - 1) * STYLE_SIZE
        const styleCoords = m.getWord(style)
        while i < numAxis {
            if fixedAt(b.*.coords, i) != fixedAt(styleCoords, i) {
                setFixedAt(b.*.coords, i, fixedAt(styleCoords, i))
                haveDiff = true
            }
            i += 1
        }
    } else {
        const axes = m.getWord(mmvar + 16)
        while i < numAxis {
            const def = m.getI64(axes + @intCast(usize, i) * AXIS_SIZE + 16)
            if fixedAt(b.*.coords, i) != def {
                setFixedAt(b.*.coords, i, def)
                haveDiff = true
            }
            i += 1
        }
    }
    if b.*.normalized != 0 && !haveDiff { return -1 }
    const normalized = m.alloc(memory, @intCast(usize, numAxis) * 8 + 8)
    if normalized == 0 { return r.ERR_OUT_OF_MEMORY }
    if !b.*.avarLoaded { loadAvar(f, b) }
    toNormalized(f, b, numCoords, b.*.coords, normalized)
    const err = setMMBlend(face, numAxis, normalized, false)
    m.release(memory, normalized)
    return err
}

// FreeType's TT_Get_Var_Design.
fn getVarDesign(face: usize, numCoords: u64, coords: usize) -> i32 {
    const f = o.faceRecord(face)
    if f.*.blend == 0 {
        const err = getMMVar(face, 0)
        if err != r.OK { return err }
    }
    const b = blendOf(f)
    if b.*.coords == 0 {
        const err = setMMBlend(face, 0, 0, true)
        if err != r.OK { return err }
    }
    var nc = numCoords
    if numCoords > b.*.numAxis { nc = b.*.numAxis }
    var i: u64 = 0
    while i < nc {
        setFixedAt(coords, i, if b.*.doblend { fixedAt(b.*.coords, i) } else { 0 })
        i += 1
    }
    while i < numCoords {
        setFixedAt(coords, i, 0)
        i += 1
    }
    return r.OK
}

// FreeType's TT_Set_Named_Instance.
fn setNamedInstanceDriver(face: usize, index: u64) -> i32 {
    const f = o.faceRecord(face)
    const root = o.faceRecord(face)
    const memory = f.*.memory
    if f.*.blend == 0 {
        const err = getMMVar(face, 0)
        if err != r.OK { return err }
    }
    const b = blendOf(f)
    const mmvar = b.*.mmvar
    const numInstances = @intCast(u64, @bitCast(u64, root.*.styleFlags) & 0xFFFFFFFF) >> 16
    if index > numInstances { return r.ERR_INVALID_ARGUMENT }
    if index > 0 {
        const style = m.getWord(mmvar + 24) + @intCast(usize, index - 1) * STYLE_SIZE
        const name = sfnt.getName(f, @intCast(i64, m.get32(style + 8)))
        m.release(memory, root.*.styleName)
        root.*.styleName = name
        return setVarDesign(face, @intCast(u64, m.get32(mmvar)), m.getWord(style))
    }
    m.release(memory, root.*.styleName)
    root.*.styleName = 0
    if f.*.nonVarStyleName != 0 {
        root.*.styleName = m.dupBytes(memory, f.*.nonVarStyleName, m.cLength(f.*.nonVarStyleName))
        if root.*.styleName == 0 { return r.ERR_OUT_OF_MEMORY }
    }
    return setVarDesign(face, 0, 0)
}

// The PostScript name of the face forgotten (FreeType's
// tt_construct_ps_name): made again when next asked for.
fn constructPsName(face: usize) -> void {
    const f = o.faceRecord(face)
    m.release(f.*.memory, f.*.psName)
    f.*.psName = 0
    f.*.psNameDone = false
}

// ---------------------------------------------------------------------------
// The glyph deltas of `gvar` (FreeType's TT_Vary_Apply_Glyph_Deltas):
// for the `nPoints` points at `points` (16-byte vectors, the phantom
// points last), in contours `contours` (2-byte end points, less `base`).
// Their unrounded values (26.6) are set in `unrounded`. The error, and
// whether the deltas were applied (the phantom points then to be read).

pub fn applyGlyphDeltas(face: usize, gindex: i64, points: usize, nPoints: i64, contours: usize, nContours: i64, base: i64, unrounded: usize) -> (i32, bool) {
    const f = o.faceRecord(face)
    if f.*.blend == 0 { return -> (r.ERR_INVALID_ARGUMENT, false) }
    const b = blendOf(f)
    if !b.*.doblend { return -> (r.ERR_INVALID_ARGUMENT, false) }
    const n = @intCast(u64, nPoints)
    var i: u64 = 0
    while i < n {
        m.putI64(unrounded + @intCast(usize, i) * 16, m.getI64(points + @intCast(usize, i) * 16) *% 64)
        m.putI64(unrounded + @intCast(usize, i) * 16 + 8, m.getI64(points + @intCast(usize, i) * 16 + 8) *% 64)
        i += 1
    }
    const g = @intCast(u64, gindex)
    if g >= b.*.gvGlyphCount || m.get64(b.*.glyphOffsets + @intCast(usize, g) * 8) == m.get64(b.*.glyphOffsets + @intCast(usize, g + 1) * 8) { return -> (r.OK, false) }
    const memory = f.*.memory
    // The scratch arrays: original and varied points (16.16 vectors),
    // which points have deltas, the accumulated deltas, the tuples.
    const axes = @intCast(usize, b.*.numAxis)
    const total = @intCast(usize, n) * (16 + 16 + 1 + 16) + axes * 24 + 64
    const scratch = m.alloc(memory, total)
    if scratch == 0 { return -> (r.ERR_OUT_OF_MEMORY, false) }
    const err = varyGlyph(f, b, g, points, n, contours, nContours, base, unrounded, scratch)
    m.release(memory, scratch)
    return -> (err, err == r.OK)
}

fn varyGlyph(f: *o.Face, b: *Blend, g: u64, points: usize, n: u64, contours: usize, nContours: i64, base: i64, unrounded: usize, scratch: usize) -> i32 {
    const memory = f.*.memory
    const nn = @intCast(usize, n)
    const org = scratch
    const outp = org + nn * 16
    const deltas = outp + nn * 16
    const hasDelta = deltas + nn * 16
    const tuple = align8(hasDelta + nn)
    const imStart = tuple + @intCast(usize, b.*.numAxis) * 8
    const imEnd = imStart + @intCast(usize, b.*.numAxis) * 8
    const glyphStart = m.get64(b.*.glyphOffsets + @intCast(usize, g) * 8)
    const limit = m.get64(b.*.glyphOffsets + @intCast(usize, g + 1) * 8)
    const dataSize = limit - glyphStart
    if glyphStart > f.*.size || !o.within(f, glyphStart, dataSize) { return r.ERR_INVALID_STREAM_OPERATION }
    var here = glyphStart
    const tupleCount = @intCast(u64, o.u16At(f, here))
    var offsetToData = @intCast(u64, o.u16At(f, here + 2))
    here += 4
    if offsetToData > dataSize || (tupleCount & TUPLE_COUNT_MASK) * 4 > dataSize { return r.ERR_INVALID_TABLE }
    offsetToData += glyphStart
    var sharedKind = POINTS_NONE
    var sharedList: usize = 0
    var sharedCount: u64 = 0
    if (tupleCount & TUPLES_SHARE_POINT_NUMBERS) != 0 {
        const shared = readPackedPoints(f, clampTo(offsetToData, limit), b.*.gvarSize)
        sharedKind = shared.0
        sharedList = shared.1
        sharedCount = shared.2
        offsetToData = shared.3
    }
    var i: u64 = 0
    while i < n {
        m.putI64(org + @intCast(usize, i) * 16, intToFixed(m.getI64(points + @intCast(usize, i) * 16)))
        m.putI64(org + @intCast(usize, i) * 16 + 8, intToFixed(m.getI64(points + @intCast(usize, i) * 16 + 8)))
        i += 1
    }
    var err = r.OK
    var t: u64 = 0
    while t < (tupleCount & TUPLE_COUNT_MASK) {
        const tupleDataSize = @intCast(u64, o.u16At(f, here))
        const tupleIndex = @intCast(u64, o.u16At(f, here + 2))
        here += 4
        t += 1
        if (tupleIndex & EMBEDDED_TUPLE_COORD) != 0 {
            var j: u64 = 0
            while j < b.*.numAxis {
                setFixedAt(tuple, j, fdot14ToFixed(o.i16At(f, here)))
                here += 2
                j += 1
            }
        } else if (tupleIndex & TUPLE_INDEX_MASK) >= b.*.tupleCount {
            err = r.ERR_INVALID_TABLE
            break
        } else {
            m.copy(tuple, b.*.tupleCoords + @intCast(usize, (tupleIndex & TUPLE_INDEX_MASK) * b.*.numAxis) * 8, @intCast(usize, b.*.numAxis) * 8)
        }
        if (tupleIndex & INTERMEDIATE_TUPLE) != 0 {
            var j: u64 = 0
            while j < b.*.numAxis {
                setFixedAt(imStart, j, fdot14ToFixed(o.i16At(f, here)))
                here += 2
                j += 1
            }
            j = 0
            while j < b.*.numAxis {
                setFixedAt(imEnd, j, fdot14ToFixed(o.i16At(f, here)))
                here += 2
                j += 1
            }
        }
        const apply = applyTuple(b, tupleIndex, tuple, imStart, imEnd)
        if apply == 0 {
            offsetToData += tupleDataSize
            continue
        }
        var pos = clampTo(offsetToData, limit)
        var kind = sharedKind
        var list = sharedList
        var listCount = sharedCount
        var localKind = POINTS_NONE
        if (tupleIndex & PRIVATE_POINT_NUMBERS) != 0 {
            const local = readPackedPoints(f, pos, b.*.gvarSize)
            pos = local.3
            kind = local.0
            list = local.1
            listCount = local.2
            localKind = local.0
        }
        const count = if listCount == 0 { n } else { listCount }
        const dx = readPackedDeltas(f, pos, b.*.gvarSize, count)
        const dy = readPackedDeltas(f, dx.1, b.*.gvarSize, count)
        if kind == POINTS_NONE || dx.0 == 0 || dy.0 == 0 {
            // (Nothing applied.)
        } else if kind == POINTS_ALL {
            var j: u64 = 0
            while j < n {
                const d = deltas + @intCast(usize, j) * 16
                m.putI64(d, m.getI64(d) +% calc.mulFix(fixedAt(dx.0, j), apply))
                m.putI64(d + 8, m.getI64(d + 8) +% calc.mulFix(fixedAt(dy.0, j), apply))
                j += 1
            }
        } else {
            var j: u64 = 0
            while j < n {
                m.put8(hasDelta + @intCast(usize, j), 0)
                m.putI64(outp + @intCast(usize, j) * 16, m.getI64(org + @intCast(usize, j) * 16))
                m.putI64(outp + @intCast(usize, j) * 16 + 8, m.getI64(org + @intCast(usize, j) * 16 + 8))
                j += 1
            }
            j = 0
            while j < listCount {
                const idx = @intCast(u64, m.get16(list + @intCast(usize, j) * 2))
                j += 1
                if idx >= n { continue }
                m.put8(hasDelta + @intCast(usize, idx), 1)
                const q = outp + @intCast(usize, idx) * 16
                m.putI64(q, m.getI64(q) +% calc.mulFix(fixedAt(dx.0, j - 1), apply))
                m.putI64(q + 8, m.getI64(q + 8) +% calc.mulFix(fixedAt(dy.0, j - 1), apply))
            }
            interpolateDeltas(contours, nContours, base, outp, org, hasDelta)
            j = 0
            while j < n {
                const d = deltas + @intCast(usize, j) * 16
                m.putI64(d, m.getI64(d) +% (m.getI64(outp + @intCast(usize, j) * 16) -% m.getI64(org + @intCast(usize, j) * 16)))
                m.putI64(d + 8, m.getI64(d + 8) +% (m.getI64(outp + @intCast(usize, j) * 16 + 8) -% m.getI64(org + @intCast(usize, j) * 16 + 8)))
                j += 1
            }
        }
        if localKind == POINTS_LIST { m.release(memory, list) }
        m.release(memory, dx.0)
        m.release(memory, dy.0)
        offsetToData += tupleDataSize
    }
    if sharedKind == POINTS_LIST { m.release(memory, sharedList) }
    if err != r.OK { return err }
    if (b.*.support & VAR_HADVANCE) != 0 {
        zeroDelta(deltas, n - 4)
        zeroDelta(deltas, n - 3)
    }
    if (b.*.support & VAR_VADVANCE) != 0 {
        zeroDelta(deltas, n - 2)
        zeroDelta(deltas, n - 1)
    }
    i = 0
    while i < n {
        const d = deltas + @intCast(usize, i) * 16
        const u = unrounded + @intCast(usize, i) * 16
        const p = points + @intCast(usize, i) * 16
        m.putI64(u, m.getI64(u) +% fixedToFdot6(m.getI64(d)))
        m.putI64(u + 8, m.getI64(u + 8) +% fixedToFdot6(m.getI64(d + 8)))
        m.putI64(p, m.getI64(p) +% fixedToInt(m.getI64(d)))
        m.putI64(p + 8, m.getI64(p + 8) +% fixedToInt(m.getI64(d + 8)))
        i += 1
    }
    return r.OK
}

fn clampTo(offset: u64, limit: u64) -> u64 { return if offset < limit { offset } else { limit } }

fn zeroDelta(deltas: usize, i: u64) -> void {
    m.putI64(deltas + @intCast(usize, i) * 16, 0)
    m.putI64(deltas + @intCast(usize, i) * 16 + 8, 0)
}

// The points without deltas moved as their neighbours with deltas are
// (FreeType's tt_interpolate_deltas, tt_delta_shift and
// tt_delta_interpolate).
fn interpolateDeltas(contours: usize, nContours: i64, base: i64, outp: usize, inp: usize, hasDelta: usize) -> void {
    if nContours <= 0 { return }
    var contour: i64 = 0
    var point: i64 = 0
    while contour < nContours {
        const endPoint = @intCast(i64, m.getI16(contours + @intCast(usize, contour) * 2)) - base
        const firstPoint = point
        while point <= endPoint && m.get8(hasDelta + @intCast(usize, point)) == 0 { point += 1 }
        if point <= endPoint {
            const firstDelta = point
            var curDelta = point
            point += 1
            while point <= endPoint {
                if m.get8(hasDelta + @intCast(usize, point)) != 0 {
                    deltaInterpolate(curDelta + 1, point - 1, curDelta, point, inp, outp)
                    curDelta = point
                }
                point += 1
            }
            if curDelta == firstDelta {
                deltaShift(firstPoint, endPoint, curDelta, inp, outp)
            } else {
                deltaInterpolate(curDelta + 1, endPoint, curDelta, firstDelta, inp, outp)
                if firstDelta > 0 { deltaInterpolate(firstPoint, firstDelta - 1, curDelta, firstDelta, inp, outp) }
            }
        }
        contour += 1
    }
}

fn deltaShift(p1: i64, p2: i64, ref: i64, inp: usize, outp: usize) -> void {
    const dx = m.getI64(outp + @intCast(usize, ref) * 16) -% m.getI64(inp + @intCast(usize, ref) * 16)
    const dy = m.getI64(outp + @intCast(usize, ref) * 16 + 8) -% m.getI64(inp + @intCast(usize, ref) * 16 + 8)
    if dx == 0 && dy == 0 { return }
    var p = p1
    while p <= p2 {
        if p != ref {
            const q = outp + @intCast(usize, p) * 16
            m.putI64(q, m.getI64(q) +% dx)
            m.putI64(q + 8, m.getI64(q + 8) +% dy)
        }
        p += 1
    }
}

fn deltaInterpolate(p1: i64, p2: i64, ref1_: i64, ref2_: i64, inp: usize, outp: usize) -> void {
    if p1 > p2 { return }
    var ref1 = ref1_
    var ref2 = ref2_
    var axis: usize = 0
    while axis <= 8 {
        if m.getI64(inp + @intCast(usize, ref1) * 16 + axis) > m.getI64(inp + @intCast(usize, ref2) * 16 + axis) {
            const swap = ref1
            ref1 = ref2
            ref2 = swap
        }
        const in1 = m.getI64(inp + @intCast(usize, ref1) * 16 + axis)
        const in2 = m.getI64(inp + @intCast(usize, ref2) * 16 + axis)
        const out1 = m.getI64(outp + @intCast(usize, ref1) * 16 + axis)
        const out2 = m.getI64(outp + @intCast(usize, ref2) * 16 + axis)
        const d1 = out1 -% in1
        const d2 = out2 -% in2
        if in1 != in2 || out1 == out2 {
            const scale = if in1 != in2 { calc.divFix(out2 -% out1, in2 -% in1) } else { 0 }
            var p = p1
            while p <= p2 {
                var out = m.getI64(inp + @intCast(usize, p) * 16 + axis)
                if out <= in1 {
                    out = out +% d1
                } else if out >= in2 {
                    out = out +% d2
                } else {
                    out = out1 +% calc.mulFix(out -% in1, scale)
                }
                m.putI64(outp + @intCast(usize, p) * 16 + axis, out)
                p += 1
            }
        }
        axis += 8
    }
}

// ---------------------------------------------------------------------------
// What the rest of the library asks.

// Whether glyphs vary: a named instance or a variation is set
// (FreeType's !IS_DEFAULT_INSTANCE).
pub fn isVaried(face: usize) -> bool {
    const root = o.faceRecord(face)
    return (root.*.faceIndex & 0x7FFF0000) != 0 || (root.*.faceFlags & r.FACE_VARIATION) != 0
}

pub fn variesHorizontalAdvances(face: usize) -> bool {
    const f = o.faceRecord(face)
    return f.*.blend != 0 && (blendOf(f).*.support & VAR_HADVANCE) != 0
}

pub fn variesVerticalAdvances(face: usize) -> bool {
    const f = o.faceRecord(face)
    return f.*.blend != 0 && (blendOf(f).*.support & VAR_VADVANCE) != 0
}

// The side bearing and advance of a glyph in font units (FreeType's
// tt_face_get_metrics): the advance varied by `HVAR` or `VVAR` (the CFF
// driver varies horizontal advances only).
pub fn glyphMetrics(face: usize, vertical: bool, gindex: i64) -> (i64, i64) {
    const f = o.faceRecord(face)
    const metrics = sfnt.glyphMetrics(f, vertical, gindex)
    if f.*.blend == 0 { return metrics }
    var advance = metrics.1
    if !vertical || f.*.driver == library.TRUETYPE { advance = advanceAdjust(f, blendOf(f), gindex, advance, vertical).1 }
    return -> (metrics.0, calc.ulow16(advance))
}

// The number of axes and the normalized coordinates (0 when none are set)
// of the blend (FreeType's tt_get_var_blend), for CFF2's blend.
pub fn normalizedCoords(face: usize) -> (u64, usize) {
    const f = o.faceRecord(face)
    if f.*.blend == 0 { return -> (0, 0) }
    const b = blendOf(f)
    return -> (b.*.numAxis, b.*.normalized)
}

pub fn done(face: usize) -> void {
    const f = o.faceRecord(face)
    if f.*.blend == 0 { return }
    const memory = f.*.memory
    const b = blendOf(f)
    const numAxes = @intCast(i64, m.get32(b.*.mmvar))
    m.release(memory, b.*.coords)
    m.release(memory, b.*.normalized)
    m.release(memory, b.*.styleCoords)
    if b.*.avarSegments != 0 { freeSegments(memory, b, numAxes) }
    doneStore(memory, &b.*.avarStore)
    doneMap(memory, &b.*.avarMap)
    doneStore(memory, &b.*.hvarStore)
    doneMap(memory, &b.*.hvarMap)
    doneStore(memory, &b.*.vvarStore)
    doneMap(memory, &b.*.vvarMap)
    doneStore(memory, &b.*.mvarStore)
    m.release(memory, b.*.mvarValues)
    m.release(memory, b.*.tupleCoords)
    m.release(memory, b.*.glyphOffsets)
    m.release(memory, b.*.psPrefix)
    m.release(memory, b.*.gaspMax)
    m.release(memory, b.*.mmvar)
    m.release(memory, f.*.blend)
    f.*.blend = 0
}

// ---------------------------------------------------------------------------
// The PostScript name (FreeType's sfnt_get_ps_name, with
// sfnt_get_var_ps_name for instances).

pub fn postscriptName(face: usize) -> usize {
    const f = o.faceRecord(face)
    if f.*.psNameDone { return f.*.psName }
    var name: usize = 0
    if f.*.blend != 0 && isVaried(face) {
        name = varPsName(face)
    } else {
        name = sfnt.postscriptName(f)
    }
    f.*.psName = name
    f.*.psNameDone = name != 0
    return name
}

const MAX_PS_NAME_LEN: u64 = 127

fn varPsName(face: usize) -> usize {
    const f = o.faceRecord(face)
    const root = o.faceRecord(face)
    const memory = f.*.memory
    const b = blendOf(f)
    if b.*.psPrefix == 0 {
        var ids = sfnt.nameIds(f, 25)
        if ids.0 < 0 && ids.1 < 0 { ids = sfnt.nameIds(f, 16) }
        if ids.0 < 0 && ids.1 < 0 { ids = sfnt.nameIds(f, 1) }
        if ids.0 < 0 && ids.1 < 0 { return 0 }
        var prefix: usize = 0
        if ids.0 != -1 { prefix = sfnt.filteredName(f, ids.0, true, 2) }
        if prefix == 0 && ids.1 != -1 { prefix = sfnt.filteredName(f, ids.1, false, 2) }
        if prefix == 0 { return 0 }
        var len = @intCast(u64, m.cLength(prefix))
        if len > MAX_PS_NAME_LEN - (1 + 32 + 3) {
            len = MAX_PS_NAME_LEN - (1 + 32 + 3)
            m.put8(prefix + @intCast(usize, len), 0)
        }
        b.*.psPrefix = prefix
        b.*.psPrefixLen = len
    }
    const prefixLen = @intCast(usize, b.*.psPrefixLen)
    const mmvar = b.*.mmvar
    var result: usize = 0
    var end: usize = 0
    var instanceName = (root.*.faceIndex & 0x7FFF0000) != 0 && (root.*.faceFlags & r.FACE_VARIATION) == 0
    if instanceName {
        const instance = ((root.*.faceIndex & 0x7FFF0000) >> 16) - 1
        const style = m.getWord(mmvar + 24) + @intCast(usize, instance) * STYLE_SIZE
        const psid = @intCast(i64, m.get32(style + 12))
        var psName: usize = 0
        if psid == 6 || (psid > 255 && psid < 32768) { psName = sfnt.getName(f, psid) }
        if psName != 0 {
            result = psName
            end = result + m.cLength(result) + 1
        } else {
            const subfamily = sfnt.getName(f, @intCast(i64, m.get32(style + 8)))
            if subfamily == 0 {
                instanceName = false
            } else {
                result = m.alloc(memory, prefixLen + 1 + m.cLength(subfamily) + 1)
                if result == 0 { return 0 }
                m.copy(result, b.*.psPrefix, prefixLen)
                var p = result + prefixLen
                m.put8(p, 45)
                p += 1
                var s = subfamily
                while m.get8(s) != 0 {
                    if sfnt.isAlphanumeric(@intCast(i64, m.get8(s))) {
                        m.put8(p, m.get8(s))
                        p += 1
                    }
                    s += 1
                }
                m.put8(p, 0)
                end = p + 1
                m.release(memory, subfamily)
            }
        }
    }
    if !instanceName {
        const numCoords = b.*.numAxis
        result = m.alloc(memory, prefixLen + @intCast(usize, numCoords) * 18 + 1)
        if result == 0 { return 0 }
        m.copy(result, b.*.psPrefix, prefixLen)
        var p = result + prefixLen
        const axes = m.getWord(mmvar + 16)
        var i: u64 = 0
        while i < numCoords {
            const a = axes + @intCast(usize, i) * AXIS_SIZE
            const coord = fixedAt(b.*.coords, i)
            i += 1
            if coord == m.getI64(a + 16) { continue }
            m.put8(p, 95)
            p += 1
            p = fixedToDecimal(calc.low32(coord), p)
            const tag = m.get64(a + 32)
            var k: u64 = 0
            while k < 4 {
                const c = @intCast(i64, (tag >> @intCast(u6, 24 - k * 8)) & 0xFF)
                if c != 32 && sfnt.isAlphanumeric(c) {
                    m.put8(p, @intCast(u8, c))
                    p += 1
                }
                k += 1
            }
        }
        m.put8(p, 0)
        end = p + 1
    }
    if @intCast(u64, end - result) > MAX_PS_NAME_LEN {
        const hash = murmur3(result, @intCast(u64, end - result), 123456789)
        var p = result + prefixLen
        m.put8(p, 45)
        p += 1
        p += 32 + 3
        m.put8(p, 0)
        p -= 1
        m.put8(p, 46)
        p -= 1
        m.put8(p, 46)
        p -= 1
        m.put8(p, 46)
        p -= 1
        const digits = "0123456789ABCDEF"
        var hi: i64 = 3
        while hi >= 0 {
            var v = if hi == 3 { hash.3 } else if hi == 2 { hash.2 } else if hi == 1 { hash.1 } else { hash.0 }
            var j: u64 = 0
            while j < 8 {
                m.put8(p, digits[@intCast(usize, v & 0xF)])
                p -= 1
                v >>= 4
                j += 1
            }
            hi -= 1
        }
    }
    return result
}

// A 16.16 value as the shortest decimal that reads back as it (FreeType's
// fixed2float), written at `buffer`; where it ends.
fn fixedToDecimal(fixed_: i64, buffer: usize) -> usize {
    var p = buffer
    var fixed = fixed_
    if fixed == 0 {
        m.put8(p, 48)
        return p + 1
    }
    if fixed < 0 {
        m.put8(p, 45)
        p += 1
        fixed = calc.low32(0 -% fixed)
    }
    var intPart = (fixed >> 16) & 0xFFFF
    var fracPart = fixed & 0xFFFF
    var digits: [5]u8 = undefined
    var count: usize = 0
    while intPart > 0 {
        digits[count] = @intCast(u8, 48 + intPart % 10)
        count += 1
        intPart = intPart / 10
    }
    while count > 0 {
        count -= 1
        m.put8(p, digits[count])
        p += 1
    }
    if fracPart == 0 { return p }
    const q = p
    m.put8(p, 46)
    p += 1
    fracPart = fracPart * 10 + 5
    var i: i64 = 0
    while i < 5 {
        m.put8(p, @intCast(u8, 48 + fracPart / 0x10000))
        p += 1
        fracPart = fracPart % 0x10000
        if fracPart == 0 { break }
        fracPart *= 10
        i += 1
    }
    p -= 1
    if p - q == 5 {
        const last = m.get8(p)
        if fracPart < 34480 * 10 && last == 49 {
            m.put8(p, 48)
        } else if fracPart == 17232 * 10 && (last & 1) != 0 {
            m.put8(p, last - 1)
        } else if fracPart < 17232 * 10 && last != 48 {
            m.put8(p, last - 1)
        }
    }
    while m.get8(p) == 48 {
        m.put8(p, 0)
        p -= 1
    }
    return p + 1
}

fn rotl32(x: u64, n: u64) -> u64 { return ((x << @intCast(u6, n)) | (x >> @intCast(u6, 32 - n))) & 0xFFFFFFFF }

fn fmix32(h_: u64) -> u64 {
    var h = h_
    h ^= h >> 16
    h = (h *% 0x85EBCA6B) & 0xFFFFFFFF
    h ^= h >> 13
    h = (h *% 0xC2B2AE35) & 0xFFFFFFFF
    h ^= h >> 16
    return h
}

fn mul32(a: u64, b: u64) -> u64 { return (a *% b) & 0xFFFFFFFF }
fn add32(a: u64, b: u64) -> u64 { return (a +% b) & 0xFFFFFFFF }

// MurmurHash3's x86 128-bit hash (FreeType's murmur_hash_3_128) as its
// four 32-bit words.
fn murmur3(data: usize, len: u64, seed: u64) -> (u64, u64, u64, u64) {
    const c1: u64 = 0x239B961B
    const c2: u64 = 0xAB0E9789
    const c3: u64 = 0x38B34AE5
    const c4: u64 = 0xA1E38B93
    var h1 = seed
    var h2 = seed
    var h3 = seed
    var h4 = seed
    const nblocks = len / 16
    var i: u64 = 0
    while i < nblocks {
        const block = data + @intCast(usize, i) * 16
        var k1 = @intCast(u64, m.get32(block))
        var k2 = @intCast(u64, m.get32(block + 4))
        var k3 = @intCast(u64, m.get32(block + 8))
        var k4 = @intCast(u64, m.get32(block + 12))
        k1 = mul32(rotl32(mul32(k1, c1), 15), c2)
        h1 ^= k1
        h1 = add32(mul32(add32(rotl32(h1, 19), h2), 5), 0x561CCD1B)
        k2 = mul32(rotl32(mul32(k2, c2), 16), c3)
        h2 ^= k2
        h2 = add32(mul32(add32(rotl32(h2, 17), h3), 5), 0x0BCAA747)
        k3 = mul32(rotl32(mul32(k3, c3), 17), c4)
        h3 ^= k3
        h3 = add32(mul32(add32(rotl32(h3, 15), h4), 5), 0x96CD1C35)
        k4 = mul32(rotl32(mul32(k4, c4), 18), c1)
        h4 ^= k4
        h4 = add32(mul32(add32(rotl32(h4, 13), h1), 5), 0x32AC3B17)
        i += 1
    }
    const tail = data + @intCast(usize, nblocks) * 16
    const rest = len & 15
    var k1: u64 = 0
    var k2: u64 = 0
    var k3: u64 = 0
    var k4: u64 = 0
    if rest >= 13 {
        if rest >= 15 { k4 ^= @intCast(u64, m.get8(tail + 14)) << 16 }
        if rest >= 14 { k4 ^= @intCast(u64, m.get8(tail + 13)) << 8 }
        k4 ^= @intCast(u64, m.get8(tail + 12))
        k4 = mul32(rotl32(mul32(k4, c4), 18), c1)
        h4 ^= k4
    }
    if rest >= 9 {
        if rest >= 12 { k3 ^= @intCast(u64, m.get8(tail + 11)) << 24 }
        if rest >= 11 { k3 ^= @intCast(u64, m.get8(tail + 10)) << 16 }
        if rest >= 10 { k3 ^= @intCast(u64, m.get8(tail + 9)) << 8 }
        k3 ^= @intCast(u64, m.get8(tail + 8))
        k3 = mul32(rotl32(mul32(k3, c3), 17), c4)
        h3 ^= k3
    }
    if rest >= 5 {
        if rest >= 8 { k2 ^= @intCast(u64, m.get8(tail + 7)) << 24 }
        if rest >= 7 { k2 ^= @intCast(u64, m.get8(tail + 6)) << 16 }
        if rest >= 6 { k2 ^= @intCast(u64, m.get8(tail + 5)) << 8 }
        k2 ^= @intCast(u64, m.get8(tail + 4))
        k2 = mul32(rotl32(mul32(k2, c2), 16), c3)
        h2 ^= k2
    }
    if rest >= 1 {
        if rest >= 4 { k1 ^= @intCast(u64, m.get8(tail + 3)) << 24 }
        if rest >= 3 { k1 ^= @intCast(u64, m.get8(tail + 2)) << 16 }
        if rest >= 2 { k1 ^= @intCast(u64, m.get8(tail + 1)) << 8 }
        k1 ^= @intCast(u64, m.get8(tail))
        k1 = mul32(rotl32(mul32(k1, c1), 15), c2)
        h1 ^= k1
    }
    h1 ^= len & 0xFFFFFFFF
    h2 ^= len & 0xFFFFFFFF
    h3 ^= len & 0xFFFFFFFF
    h4 ^= len & 0xFFFFFFFF
    h1 = add32(add32(add32(h1, h2), h3), h4)
    h2 = add32(h2, h1)
    h3 = add32(h3, h1)
    h4 = add32(h4, h1)
    h1 = fmix32(h1)
    h2 = fmix32(h2)
    h3 = fmix32(h3)
    h4 = fmix32(h4)
    h1 = add32(add32(add32(h1, h2), h3), h4)
    h2 = add32(h2, h1)
    h3 = add32(h3, h1)
    h4 = add32(h4, h1)
    return -> (h1, h2, h3, h4)
}

// ---------------------------------------------------------------------------
// The functions of variable fonts (FreeType's ftmm.c): the axes and named
// instances (an MM_Var record), the coordinates in design units or
// normalized (16.16 each), a named instance set.

pub const ChangeHook = fn(usize) -> void

fn hasMultipleMasters(face: usize) -> bool { return (o.faceRecord(face).*.faceFlags & r.FACE_MULTIPLE_MASTERS) != 0 }

// What setting coordinates does after the driver set them (its error or
// -1 for no change): the variation flag, the PostScript name, the global
// metrics, the face's change hook called.
fn afterSet(face: usize, err: i32, setVariation: bool, instance: i64) -> i32 {
    const root = o.faceRecord(face)
    if err == r.OK || err == -1 {
        const wasVariation = (root.*.faceFlags & r.FACE_VARIATION) != 0
        if instance >= 0 {
            root.*.faceFlags &= ~r.FACE_VARIATION
            root.*.faceIndex = (instance << 16) | (root.*.faceIndex & 0xFFFF)
        } else if setVariation {
            root.*.faceFlags |= r.FACE_VARIATION
        } else {
            root.*.faceFlags &= ~r.FACE_VARIATION
        }
        if err == -1 {
            if wasVariation != ((root.*.faceFlags & r.FACE_VARIATION) != 0) { constructPsName(face) }
            return r.OK
        }
        constructPsName(face)
    }
    if err == r.OK {
        applyMvar(face)
        if root.*.changeHook != 0 {
            const call: ChangeHook = unsafe { @ptrFromInt(ChangeHook, root.*.changeHook) }
            call(face)
        }
    }
    return err
}

// The axes and named instances of the face in an MM_Var record made in
// the face's memory, its address at `amaster` (FreeType's FT_Get_MM_Var).
pub fn getMMVarRecord(face: usize, amaster: usize) -> i32 {
    if amaster == 0 { return r.ERR_INVALID_ARGUMENT }
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if !hasMultipleMasters(face) { return r.ERR_INVALID_ARGUMENT }
    return getMMVar(face, amaster)
}

// Sets the face's coordinates in design units (FreeType's
// FT_Set_Var_Design_Coordinates; none: the default instance).
pub fn setDesignCoordinates(face: usize, num_coords: u32, coords: usize) -> i32 {
    if num_coords != 0 && coords == 0 { return r.ERR_INVALID_ARGUMENT }
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if !hasMultipleMasters(face) { return r.ERR_INVALID_ARGUMENT }
    const err = setVarDesign(face, @intCast(u64, num_coords), coords)
    return afterSet(face, err, num_coords != 0, -1)
}

// The face's coordinates in design units (FreeType's
// FT_Get_Var_Design_Coordinates).
pub fn getDesignCoordinates(face: usize, num_coords: u32, coords: usize) -> i32 {
    if coords == 0 { return r.ERR_INVALID_ARGUMENT }
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if !hasMultipleMasters(face) { return r.ERR_INVALID_ARGUMENT }
    return getVarDesign(face, @intCast(u64, num_coords), coords)
}

// Sets the face's normalized coordinates (FreeType's
// FT_Set_Var_Blend_Coordinates).
pub fn setBlendCoordinates(face: usize, num_coords: u32, coords: usize) -> i32 {
    if num_coords != 0 && coords == 0 { return r.ERR_INVALID_ARGUMENT }
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if !hasMultipleMasters(face) { return r.ERR_INVALID_ARGUMENT }
    const err = setMMBlend(face, @intCast(u64, num_coords), coords, true)
    return afterSet(face, err, num_coords != 0, -1)
}


// The face's normalized coordinates (FreeType's
// FT_Get_Var_Blend_Coordinates).
pub fn getBlendCoordinates(face: usize, num_coords: u32, coords: usize) -> i32 {
    if coords == 0 { return r.ERR_INVALID_ARGUMENT }
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if !hasMultipleMasters(face) { return r.ERR_INVALID_ARGUMENT }
    return getMMBlend(face, @intCast(u64, num_coords), coords)
}


// The flags of an axis of an MM_Var record (FreeType's
// FT_Get_Var_Axis_Flags).
pub fn axisFlags(master: usize, axis_index: u32, flags: usize) -> i32 {
    if master == 0 || flags == 0 { return r.ERR_INVALID_ARGUMENT }
    if axis_index >= m.get32(master) { return r.ERR_INVALID_ARGUMENT }
    m.put32(flags, @intCast(u32, m.get16(master + MM_VAR_SIZE + @intCast(usize, axis_index) * 2)))
    return r.OK
}

// Sets a named instance (from 1; 0 the default instance: FreeType's
// FT_Set_Named_Instance, also what opening a named instance does).
pub fn setNamedInstance(face: usize, instance: i64) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if !hasMultipleMasters(face) { return r.ERR_INVALID_ARGUMENT }
    const index = @intCast(u64, @bitCast(u64, instance) & 0xFFFFFFFF)
    const err = setNamedInstanceDriver(face, index)
    return afterSet(face, err, false, @intCast(i64, index))
}

// The named instance of the default coordinates (FreeType's
// FT_Get_Default_Named_Instance), at `instance_index` (32-bit).
pub fn defaultNamedInstance(face: usize, instance_index: usize) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if !hasMultipleMasters(face) { return r.ERR_INVALID_ARGUMENT }
    const f = o.faceRecord(face)
    if f.*.blend == 0 {
        const err = getMMVar(face, 0)
        if err != r.OK { return err }
    }
    m.put32(instance_index, @intCast(u32, f.*.varDefaultNamedInstance))
    return r.OK
}

// ---------------------------------------------------------------------------
// Item variation stores of other tables (COLR's paints vary by one), with
// their delta-set index maps; the blend is made first when need be.

pub fn newStore(face: usize, offset: u64) -> (i32, usize) {
    const f = o.faceRecord(face)
    if f.*.blend == 0 {
        const err = getMMVar(face, 0)
        if err != r.OK { return -> (err, 0) }
    }
    const store = m.alloc(f.*.memory, @sizeOf(Store))
    if store == 0 { return -> (r.ERR_OUT_OF_MEMORY, 0) }
    const s: *Store = unsafe { @ptrFromInt(*Store, store) }
    const err = loadItemStore(f, blendOf(f), offset, s)
    return -> (err, store)
}

pub fn newIdxMap(face: usize, offset: u64, store: usize, tableLen: u64) -> (i32, usize) {
    const f = o.faceRecord(face)
    const map = m.alloc(f.*.memory, @sizeOf(IdxMap))
    if map == 0 { return -> (r.ERR_OUT_OF_MEMORY, 0) }
    const s: *Store = unsafe { @ptrFromInt(*Store, store) }
    const mp: *IdxMap = unsafe { @ptrFromInt(*IdxMap, map) }
    const err = loadIdxMap(f, offset, mp, s, tableLen)
    return -> (err, map)
}

pub fn storeAxisCount(store: usize) -> u64 {
    if store == 0 { return 0 }
    const s: *Store = unsafe { @ptrFromInt(*Store, store) }
    return s.*.axisCount
}

// The delta of entry `index` of the map (or of the first item variation
// data when there is no map) at the blend's coordinates.
pub fn storeDelta(face: usize, store: usize, map: usize, index: u64) -> i64 {
    const f = o.faceRecord(face)
    if store == 0 || f.*.blend == 0 { return 0 }
    const s: *Store = unsafe { @ptrFromInt(*Store, store) }
    var outer: u64 = 0
    var inner = index
    if map != 0 {
        const mp: *IdxMap = unsafe { @ptrFromInt(*IdxMap, map) }
        const idx = mapIndex(mp, index)
        outer = idx.0
        inner = idx.1
    }
    return itemDelta(f, blendOf(f), s, outer, inner)
}

pub fn freeStore(face: usize, store: usize, map: usize) -> void {
    const memory = o.faceRecord(face).*.memory
    if map != 0 {
        const mp: *IdxMap = unsafe { @ptrFromInt(*IdxMap, map) }
        doneMap(memory, mp)
        m.release(memory, map)
    }
    if store != 0 {
        const s: *Store = unsafe { @ptrFromInt(*Store, store) }
        doneStore(memory, s)
        m.release(memory, store)
    }
}
