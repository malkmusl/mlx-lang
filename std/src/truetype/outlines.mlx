// Outlines (ftoutln.h, ftbbox.h): walking their segments as FreeType's
// FT_Outline_Decompose walks them (a contour starting on a conic control
// point starts at the end point, or at the middle of the two controls;
// consecutive conic controls have their middle as an on-curve point),
// their control box and exact box, translating, transforming, reversing,
// emboldening as FreeType does it, and their orientation.
const m = @import("./memory.mlx")
const r = @import("./records.mlx")
const calc = @import("./calc.mlx")

pub const MOVE: i64 = 0
pub const LINE: i64 = 1
pub const CONIC: i64 = 2
pub const CUBIC: i64 = 3

// What a walk calls for each segment: the context, the kind, then the
// points (control ones first, the end last).
pub const Sink = fn(usize, i64, i64, i64, i64, i64, i64, i64) -> i32

fn px(points: usize, i: i64) -> i64 { return m.getI64(points + @intCast(usize, i) * 16) }
fn py(points: usize, i: i64) -> i64 { return m.getI64(points + @intCast(usize, i) * 16 + 8) }
fn tagOf(tags: usize, i: i64) -> i64 { return @intCast(i64, m.get8(tags + @intCast(usize, i)) & 3) }

// Walks the outline `o` (an FT_Outline), each coordinate made
// `x * 2^shift - delta`; the first result other than 0 of the sink, or
// FT_Err_Invalid_Outline.
pub fn decompose(o: usize, shift: i64, delta: i64, sink: Sink, context: usize) -> i32 {
    const rec = r.outline(o)
    const points = rec.*.points
    const tags = rec.*.tags
    const nContours = @intCast(i64, rec.*.nContours)
    var last: i64 = -1
    var n: i64 = 0
    while n < nContours {
        const first = last + 1
        last = @intCast(i64, m.getI16(rec.*.contours + @intCast(usize, n) * 2))
        n += 1
        if last < first { return r.ERR_INVALID_OUTLINE }
        var limit = last
        var startX = scaled(px(points, first), shift, delta)
        var startY = scaled(py(points, first), shift, delta)
        const lastX = scaled(px(points, last), shift, delta)
        const lastY = scaled(py(points, last), shift, delta)
        var controlX = startX
        var controlY = startY
        var point = first
        var tag = tagOf(tags, first)
        if tag == 2 { return r.ERR_INVALID_OUTLINE }
        if tag == 0 {
            if tagOf(tags, last) == 1 {
                startX = lastX
                startY = lastY
                limit -= 1
            } else {
                startX = (startX + lastX) / 2
                startY = (startY + lastY) / 2
            }
            point -= 1
        }
        var err = sink(context, MOVE, startX, startY, 0, 0, 0, 0)
        if err != 0 { return err }
        var closed = false
        while point < limit {
            point += 1
            tag = tagOf(tags, point)
            if tag == 1 {
                err = sink(context, LINE, scaled(px(points, point), shift, delta), scaled(py(points, point), shift, delta), 0, 0, 0, 0)
                if err != 0 { return err }
                continue
            }
            if tag == 0 {
                controlX = scaled(px(points, point), shift, delta)
                controlY = scaled(py(points, point), shift, delta)
                var done = false
                while point < limit {
                    point += 1
                    tag = tagOf(tags, point)
                    const vx = scaled(px(points, point), shift, delta)
                    const vy = scaled(py(points, point), shift, delta)
                    if tag == 1 {
                        err = sink(context, CONIC, controlX, controlY, vx, vy, 0, 0)
                        if err != 0 { return err }
                        done = true
                        break
                    }
                    if tag != 0 { return r.ERR_INVALID_OUTLINE }
                    err = sink(context, CONIC, controlX, controlY, (controlX + vx) / 2, (controlY + vy) / 2, 0, 0)
                    if err != 0 { return err }
                    controlX = vx
                    controlY = vy
                }
                if done { continue }
                err = sink(context, CONIC, controlX, controlY, startX, startY, 0, 0)
                if err != 0 { return err }
                closed = true
                break
            }
            // A cubic: two controls, then the end.
            if point + 1 > limit || tagOf(tags, point + 1) != 2 { return r.ERR_INVALID_OUTLINE }
            point += 2
            const c1x = scaled(px(points, point - 2), shift, delta)
            const c1y = scaled(py(points, point - 2), shift, delta)
            const c2x = scaled(px(points, point - 1), shift, delta)
            const c2y = scaled(py(points, point - 1), shift, delta)
            if point <= limit {
                err = sink(context, CUBIC, c1x, c1y, c2x, c2y, scaled(px(points, point), shift, delta), scaled(py(points, point), shift, delta))
                if err != 0 { return err }
                continue
            }
            err = sink(context, CUBIC, c1x, c1y, c2x, c2y, startX, startY)
            if err != 0 { return err }
            closed = true
            break
        }
        if !closed {
            err = sink(context, LINE, startX, startY, 0, 0, 0, 0)
            if err != 0 { return err }
        }
    }
    return r.OK
}

fn scaled(x: i64, shift: i64, delta: i64) -> i64 { return (x << @intCast(u6, shift & 63)) -% delta }

// The control box of `count` points: xMin, yMin, xMax, yMax.
pub fn cbox(points: usize, count: i64) -> (i64, i64, i64, i64) {
    if count <= 0 { return -> (0, 0, 0, 0) }
    var xMin = px(points, 0)
    var xMax = xMin
    var yMin = py(points, 0)
    var yMax = yMin
    var i: i64 = 1
    while i < count {
        const x = px(points, i)
        const y = py(points, i)
        if x < xMin { xMin = x }
        if x > xMax { xMax = x }
        if y < yMin { yMin = y }
        if y > yMax { yMax = y }
        i += 1
    }
    return -> (xMin, yMin, xMax, yMax)
}

pub fn outlineCbox(o: usize) -> (i64, i64, i64, i64) {
    const rec = r.outline(o)
    return cbox(rec.*.points, @intCast(i64, rec.*.nPoints))
}

pub fn translate(points: usize, count: i64, dx: i64, dy: i64) -> void {
    var i: i64 = 0
    while i < count {
        const at = points + @intCast(usize, i) * 16
        m.putI64(at, m.getI64(at) +% dx)
        m.putI64(at + 8, m.getI64(at + 8) +% dy)
        i += 1
    }
}

// Each point times the matrix (16.16: xx, xy, yx, yy).
pub fn transform(points: usize, count: i64, xx: i64, xy: i64, yx: i64, yy: i64) -> void {
    var i: i64 = 0
    while i < count {
        const at = points + @intCast(usize, i) * 16
        const x = m.getI64(at)
        const y = m.getI64(at + 8)
        m.putI64(at, calc.mulFix(x, xx) +% calc.mulFix(y, xy))
        m.putI64(at + 8, calc.mulFix(x, yx) +% calc.mulFix(y, yy))
        i += 1
    }
}

pub fn reverse(o: usize) -> void {
    const rec = r.outline(o)
    var last: i64 = -1
    var n: i64 = 0
    while n < @intCast(i64, rec.*.nContours) {
        const first = last + 2
        last = @intCast(i64, m.getI16(rec.*.contours + @intCast(usize, n) * 2))
        var p = first
        var q = last
        while p < q {
            const a = rec.*.points + @intCast(usize, p) * 16
            const b = rec.*.points + @intCast(usize, q) * 16
            const ax = m.getI64(a)
            const ay = m.getI64(a + 8)
            m.putI64(a, m.getI64(b))
            m.putI64(a + 8, m.getI64(b + 8))
            m.putI64(b, ax)
            m.putI64(b + 8, ay)
            const t = m.get8(rec.*.tags + @intCast(usize, p))
            m.put8(rec.*.tags + @intCast(usize, p), m.get8(rec.*.tags + @intCast(usize, q)))
            m.put8(rec.*.tags + @intCast(usize, q), t)
            p += 1
            q -= 1
        }
        n += 1
    }
    rec.*.flags ^= r.OUTLINE_REVERSE_FILL
}

pub fn check(o: usize) -> i32 {
    if o == 0 { return r.ERR_INVALID_OUTLINE }
    const rec = r.outline(o)
    const nPoints = @intCast(i64, rec.*.nPoints)
    const nContours = @intCast(i64, rec.*.nContours)
    if nPoints == 0 && nContours == 0 { return r.OK }
    if nPoints <= 0 || nContours <= 0 { return r.ERR_INVALID_OUTLINE }
    var end0: i64 = -1
    var n: i64 = 0
    while n < nContours {
        const end = @intCast(i64, m.getI16(rec.*.contours + @intCast(usize, n) * 2))
        if end <= end0 || end >= nPoints { return r.ERR_INVALID_OUTLINE }
        end0 = end
        n += 1
    }
    if end0 != nPoints - 1 { return r.ERR_INVALID_OUTLINE }
    return r.OK
}

pub const ORIENTATION_TRUETYPE: i32 = 0
pub const ORIENTATION_POSTSCRIPT: i32 = 1
pub const ORIENTATION_NONE: i32 = 2

pub fn orientation(o: usize) -> i32 {
    const rec = r.outline(o)
    const nPoints = @intCast(i64, rec.*.nPoints)
    if o == 0 || nPoints <= 0 { return ORIENTATION_TRUETYPE }
    const box = cbox(rec.*.points, nPoints)
    if box.0 == box.2 || box.1 == box.3 { return ORIENTATION_NONE }
    if box.0 < -0x1000000 || box.1 < -0x1000000 || box.2 > 0x1000000 || box.3 > 0x1000000 { return ORIENTATION_NONE }
    var xshift = calc.msb(@bitCast(u64, calc.abs(box.2) | calc.abs(box.0))) - 14
    if xshift < 0 { xshift = 0 }
    var yshift = calc.msb(@bitCast(u64, box.3 - box.1)) - 14
    if yshift < 0 { yshift = 0 }
    const xs = @intCast(u6, xshift)
    const ys = @intCast(u6, yshift)
    const points = rec.*.points
    var area: i64 = 0
    var last: i64 = -1
    var c: i64 = 0
    while c < @intCast(i64, rec.*.nContours) {
        const first = last + 1
        last = @intCast(i64, m.getI16(rec.*.contours + @intCast(usize, c) * 2))
        var prevX = px(points, last) >> xs
        var prevY = py(points, last) >> ys
        var n = first
        while n <= last {
            const curX = px(points, n) >> xs
            const curY = py(points, n) >> ys
            area = area +% (curY -% prevY) *% (curX +% prevX)
            prevX = curX
            prevY = curY
            n += 1
        }
        c += 1
    }
    if area > 0 { return ORIENTATION_POSTSCRIPT }
    if area < 0 { return ORIENTATION_TRUETYPE }
    return ORIENTATION_NONE
}

// FreeType's FT_Outline_EmboldenXY: each contour's points moved out by
// half the strengths, along the bisector of their edges.
pub fn embolden(o: usize, xstrength_: i64, ystrength_: i64) -> i32 {
    if o == 0 { return r.ERR_INVALID_OUTLINE }
    const xstrength = xstrength_ / 2
    const ystrength = ystrength_ / 2
    if xstrength == 0 && ystrength == 0 { return r.OK }
    const orient = orientation(o)
    const rec = r.outline(o)
    if orient == ORIENTATION_NONE {
        if rec.*.nContours != 0 { return r.ERR_INVALID_ARGUMENT }
        return r.OK
    }
    const points = rec.*.points
    var last: i64 = -1
    var c: i64 = 0
    while c < @intCast(i64, rec.*.nContours) {
        const first = last + 1
        last = @intCast(i64, m.getI16(rec.*.contours + @intCast(usize, c) * 2))
        c += 1
        var lIn: i64 = 0
        var inX: i64 = 0
        var inY: i64 = 0
        var anchorX: i64 = 0
        var anchorY: i64 = 0
        var lAnchor: i64 = 0
        var i = last
        var j = first
        var k: i64 = -1
        while j != i && i != k {
            var outX: i64 = 0
            var outY: i64 = 0
            var lOut: i64 = 0
            var skip = false
            if j != k {
                const nl = calc.vectorNormLen(px(points, j) -% px(points, i), py(points, j) -% py(points, i))
                outX = nl.0
                outY = nl.1
                lOut = nl.2
                if lOut == 0 { skip = true }
            } else {
                outX = anchorX
                outY = anchorY
                lOut = lAnchor
            }
            if !skip {
                if lIn != 0 {
                    if k < 0 {
                        k = i
                        anchorX = inX
                        anchorY = inY
                        lAnchor = lIn
                    }
                    var d = calc.mulFix(inX, outX) +% calc.mulFix(inY, outY)
                    var shiftX: i64 = 0
                    var shiftY: i64 = 0
                    if d > -0xF000 {
                        d = d + 0x10000
                        shiftX = inY + outY
                        shiftY = inX + outX
                        if orient == ORIENTATION_TRUETYPE {
                            shiftX = 0 - shiftX
                        } else {
                            shiftY = 0 - shiftY
                        }
                        var q = calc.mulFix(outX, inY) -% calc.mulFix(outY, inX)
                        if orient == ORIENTATION_TRUETYPE { q = 0 - q }
                        const l = calc.min(lIn, lOut)
                        if calc.mulFix(xstrength, q) <= calc.mulFix(l, d) {
                            shiftX = calc.mulDiv(shiftX, xstrength, d)
                        } else {
                            shiftX = calc.mulDiv(shiftX, l, q)
                        }
                        if calc.mulFix(ystrength, q) <= calc.mulFix(l, d) {
                            shiftY = calc.mulDiv(shiftY, ystrength, d)
                        } else {
                            shiftY = calc.mulDiv(shiftY, l, q)
                        }
                    }
                    while i != j {
                        const at = points + @intCast(usize, i) * 16
                        m.putI64(at, m.getI64(at) +% xstrength +% shiftX)
                        m.putI64(at + 8, m.getI64(at + 8) +% ystrength +% shiftY)
                        i = if i < last { i + 1 } else { first }
                    }
                } else {
                    i = j
                }
                inX = outX
                inY = outY
                lIn = lOut
            }
            j = if j < last { j + 1 } else { first }
        }
    }
    return r.OK
}

// ---------------------------------------------------------------------------
// The exact box (FreeType's FT_Outline_Get_BBox): the control box of the
// on-curve points, grown to the extremes of the arcs reaching out of it.

const BBox = struct {
    lastX: i64
    lastY: i64
    xMin: i64
    yMin: i64
    xMax: i64
    yMax: i64
}

fn conicCheck(y1_: i64, y2_: i64, y3_: i64, min: *i64, max: *i64) -> void {
    const y1 = y1_ - y2_
    const y3 = y3_ - y2_
    const y2 = y2_ + calc.mulDiv(y1, y3, y1 + y3)
    if y2 < min.* { min.* = y2 }
    if y2 > max.* { max.* = y2 }
}

fn cubicPeak(q1_: i64, q2_: i64, q3_: i64, q4_: i64) -> i64 {
    var q1 = q1_
    var q2 = q2_
    var q3 = q3_
    var q4 = q4_
    var peak: i64 = 0
    var shift = 27 - calc.msb(@bitCast(u64, calc.abs(q1) | calc.abs(q2) | calc.abs(q3) | calc.abs(q4)))
    if shift > 0 {
        if shift > 2 { shift = 2 }
        q1 = q1 << @intCast(u6, shift)
        q2 = q2 << @intCast(u6, shift)
        q3 = q3 << @intCast(u6, shift)
        q4 = q4 << @intCast(u6, shift)
    } else {
        q1 = q1 >> @intCast(u6, 0 - shift)
        q2 = q2 >> @intCast(u6, 0 - shift)
        q3 = q3 >> @intCast(u6, 0 - shift)
        q4 = q4 >> @intCast(u6, 0 - shift)
    }
    while q2 > 0 || q3 > 0 {
        if q1 + q2 > q3 + q4 {
            q4 = q4 + q3
            q3 = q3 + q2
            q2 = q2 + q1
            q4 = q4 + q3
            q3 = q3 + q2
            q4 = (q4 + q3) >> 3
            q3 = q3 >> 2
            q2 = q2 >> 1
        } else {
            q1 = q1 + q2
            q2 = q2 + q3
            q3 = q3 + q4
            q1 = q1 + q2
            q2 = q2 + q3
            q1 = (q1 + q2) >> 3
            q2 = q2 >> 2
            q3 = q3 >> 1
        }
        if q1 == q2 && q1 >= q3 {
            peak = q1
            break
        }
        if q3 == q4 && q2 <= q4 {
            peak = q4
            break
        }
    }
    if shift > 0 {
        peak = peak >> @intCast(u6, shift)
    } else {
        peak = peak << @intCast(u6, 0 - shift)
    }
    return peak
}

fn cubicCheck(p1: i64, p2: i64, p3: i64, p4: i64, min: *i64, max: *i64) -> void {
    if p2 > max.* || p3 > max.* { max.* = max.* + cubicPeak(p1 - max.*, p2 - max.*, p3 - max.*, p4 - max.*) }
    if p2 < min.* || p3 < min.* { min.* = min.* - cubicPeak(min.* - p1, min.* - p2, min.* - p3, min.* - p4) }
}

fn bboxSink(context: usize, kind: i64, x1: i64, y1: i64, x2: i64, y2: i64, x3: i64, y3: i64) -> i32 {
    const b: *BBox = unsafe { @ptrFromInt(*BBox, context) }
    if kind == MOVE {
        if x1 < b.*.xMin { b.*.xMin = x1 }
        if x1 > b.*.xMax { b.*.xMax = x1 }
        if y1 < b.*.yMin { b.*.yMin = y1 }
        if y1 > b.*.yMax { b.*.yMax = y1 }
        b.*.lastX = x1
        b.*.lastY = y1
    } else if kind == LINE {
        b.*.lastX = x1
        b.*.lastY = y1
    } else if kind == CONIC {
        if x2 < b.*.xMin { b.*.xMin = x2 }
        if x2 > b.*.xMax { b.*.xMax = x2 }
        if y2 < b.*.yMin { b.*.yMin = y2 }
        if y2 > b.*.yMax { b.*.yMax = y2 }
        if x1 < b.*.xMin || x1 > b.*.xMax { conicCheck(b.*.lastX, x1, x2, &b.*.xMin, &b.*.xMax) }
        if y1 < b.*.yMin || y1 > b.*.yMax { conicCheck(b.*.lastY, y1, y2, &b.*.yMin, &b.*.yMax) }
        b.*.lastX = x2
        b.*.lastY = y2
    } else {
        if x1 < b.*.xMin || x1 > b.*.xMax || x2 < b.*.xMin || x2 > b.*.xMax { cubicCheck(b.*.lastX, x1, x2, x3, &b.*.xMin, &b.*.xMax) }
        if y1 < b.*.yMin || y1 > b.*.yMax || y2 < b.*.yMin || y2 > b.*.yMax { cubicCheck(b.*.lastY, y1, y2, y3, &b.*.yMin, &b.*.yMax) }
        b.*.lastX = x3
        b.*.lastY = y3
    }
    return 0
}

pub fn bbox(o: usize, out: usize) -> i32 {
    const rec = r.outline(o)
    if rec.*.nPoints == 0 || rec.*.nContours <= 0 {
        m.putI64(out, 0)
        m.putI64(out + 8, 0)
        m.putI64(out + 16, 0)
        m.putI64(out + 24, 0)
        return r.OK
    }
    var cxMin: i64 = 0x7FFFFFFF
    var cyMin: i64 = 0x7FFFFFFF
    var cxMax: i64 = -0x7FFFFFFF
    var cyMax: i64 = -0x7FFFFFFF
    var box: BBox = undefined
    const b: *BBox = &box
    const context = @intFromPtr(b)
    b.*.xMin = 0x7FFFFFFF
    b.*.yMin = 0x7FFFFFFF
    b.*.xMax = -0x7FFFFFFF
    b.*.yMax = -0x7FFFFFFF
    var n: i64 = 0
    while n < @intCast(i64, rec.*.nPoints) {
        const x = px(rec.*.points, n)
        const y = py(rec.*.points, n)
        if x < cxMin { cxMin = x }
        if x > cxMax { cxMax = x }
        if y < cyMin { cyMin = y }
        if y > cyMax { cyMax = y }
        if tagOf(rec.*.tags, n) == 1 {
            if x < b.*.xMin { b.*.xMin = x }
            if x > b.*.xMax { b.*.xMax = x }
            if y < b.*.yMin { b.*.yMin = y }
            if y > b.*.yMax { b.*.yMax = y }
        }
        n += 1
    }
    var err: i32 = r.OK
    if cxMin < b.*.xMin || cxMax > b.*.xMax || cyMin < b.*.yMin || cyMax > b.*.yMax {
        err = decompose(o, 0, 0, bboxSink, context)
    }
    if err == r.OK {
        m.putI64(out, b.*.xMin)
        m.putI64(out + 8, b.*.yMin)
        m.putI64(out + 16, b.*.xMax)
        m.putI64(out + 24, b.*.yMax)
    }
    return err
}

// A new outline of `numPoints` points and `numContours` contours in
// `memory`, owning them, at `anoutline`.
pub fn newOutline(memory: usize, numPoints: u32, numContours: i32, anoutline: usize) -> i32 {
    if anoutline == 0 || memory == 0 { return r.ERR_INVALID_ARGUMENT }
    m.zero(anoutline, 40)
    if numContours < 0 || @intCast(u32, numContours) > numPoints { return r.ERR_INVALID_ARGUMENT }
    if numPoints > 32767 { return r.ERR_ARRAY_TOO_LARGE }
    const rec = r.outline(anoutline)
    rec.*.points = m.alloc(memory, @intCast(usize, numPoints) * 16)
    rec.*.tags = m.alloc(memory, @intCast(usize, numPoints))
    rec.*.contours = m.alloc(memory, @intCast(usize, numContours) * 2)
    rec.*.nPoints = @intCast(i16, numPoints)
    rec.*.nContours = @intCast(i16, numContours)
    rec.*.flags |= r.OUTLINE_OWNER
    if (numPoints != 0 && (rec.*.points == 0 || rec.*.tags == 0)) || (numContours != 0 && rec.*.contours == 0) {
        _ = doneOutline(memory, anoutline)
        return r.ERR_OUT_OF_MEMORY
    }
    return r.OK
}

// Frees what an outline of `memory` owns, and empties it.
pub fn doneOutline(memory: usize, outline: usize) -> i32 {
    if outline == 0 { return r.ERR_INVALID_OUTLINE }
    if memory == 0 { return r.ERR_INVALID_ARGUMENT }
    const rec = r.outline(outline)
    if (rec.*.flags & r.OUTLINE_OWNER) != 0 {
        m.release(memory, rec.*.points)
        m.release(memory, rec.*.tags)
        m.release(memory, rec.*.contours)
    }
    m.zero(outline, 40)
    return r.OK
}

pub fn copyOutline(source: usize, target: usize) -> i32 {
    if source == 0 || target == 0 { return r.ERR_INVALID_OUTLINE }
    const s = r.outline(source)
    const t = r.outline(target)
    if s.*.nPoints != t.*.nPoints || s.*.nContours != t.*.nContours { return r.ERR_INVALID_ARGUMENT }
    if source == target { return r.OK }
    if s.*.nPoints != 0 {
        m.copy(t.*.points, s.*.points, @intCast(usize, s.*.nPoints) * 16)
        m.copy(t.*.tags, s.*.tags, @intCast(usize, s.*.nPoints))
    }
    if s.*.nContours != 0 { m.copy(t.*.contours, s.*.contours, @intCast(usize, s.*.nContours) * 2) }
    const owner = t.*.flags & r.OUTLINE_OWNER
    t.*.flags = (s.*.flags & ~r.OUTLINE_OWNER) | owner
    return r.OK
}
