// The values the engine's records hold and its constants: vectors,
// matrices, boxes, glyph metrics, bitmaps and outlines (laid out as
// FreeType lays out its own, so that its C API hands them on as they
// are), the formats of glyphs, the flags of faces, loads and outlines,
// render and pixel modes, encodings and the errors (FreeType's numbers).

// 26.6 or 16.16 coordinates, or font units.
pub const Vector = struct {
    x: i64
    y: i64
}

// A 2x2 matrix of 16.16 values: x' = xx * x + xy * y, y' = yx * x + yy * y.
pub const Matrix = struct {
    xx: i64
    xy: i64
    yx: i64
    yy: i64
}

pub const BBox = struct {
    xMin: i64
    yMin: i64
    xMax: i64
    yMax: i64
}

// A glyph's metrics: its size, its horizontal and vertical bearings and
// advances.
pub const GlyphMetrics = struct {
    width: i64
    height: i64
    horiBearingX: i64
    horiBearingY: i64
    horiAdvance: i64
    vertBearingX: i64
    vertBearingY: i64
    vertAdvance: i64
}

// A bitmap: `rows` rows of `pitch` bytes (from the top when positive,
// from the bottom when negative), `width` pixels of `pixelMode`
// (PIXEL_...).
pub const Bitmap = struct {
    rows: u32
    width: u32
    pitch: i32
    buffer: usize
    numGrays: u16
    pixelMode: u8
    paletteMode: u8
    palette: usize
}

// An outline: `nPoints` points (Vector, 26.6 or font units) with their
// tags (bit 0 on the curve, bit 1 a cubic control point), the last point
// of each of `nContours` contours (16-bit), its flags (OUTLINE_...).
pub const Outline = struct {
    nContours: i16
    nPoints: i16
    points: usize
    tags: usize
    contours: usize
    flags: i32
}

// A strike of embedded bitmaps: its height and width in pixels, its
// size and pixels per em (26.6).
pub const BitmapSize = struct {
    height: i16
    width: i16
    size: i64
    xPpem: i64
    yPpem: i64
}

// A size requested of a face: its kind (SIZE_REQUEST_...), width and
// height (26.6; 16.16 scales for SIZE_REQUEST_SCALES), and the
// resolutions they are in (dots per inch; 0 for pixels).
pub const SizeRequest = struct {
    kind: i32
    width: i64
    height: i64
    horiResolution: u32
    vertResolution: u32
}

// The kinds of size requests: of the em square, of the ascender to the
// descender, of the font's box, of its cells (the largest advance by
// the ascender to the descender), or the scales themselves.
pub const SIZE_REQUEST_NOMINAL: i32 = 0
pub const SIZE_REQUEST_REAL_DIM: i32 = 1
pub const SIZE_REQUEST_BBOX: i32 = 2
pub const SIZE_REQUEST_CELL: i32 = 3
pub const SIZE_REQUEST_SCALES: i32 = 4

pub fn bitmap(address: usize) -> *Bitmap { unsafe { return @ptrFromInt(*Bitmap, address) } }
pub fn outline(address: usize) -> *Outline { unsafe { return @ptrFromInt(*Outline, address) } }
pub fn vector(address: usize) -> *Vector { unsafe { return @ptrFromInt(*Vector, address) } }

// Glyph formats (FT_Glyph_Format).
pub const FORMAT_NONE: u32 = 0
pub const FORMAT_COMPOSITE: u32 = 0x636F6D70
pub const FORMAT_BITMAP: u32 = 0x62697473
pub const FORMAT_OUTLINE: u32 = 0x6F75746C

