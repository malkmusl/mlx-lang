// Loading a glyph into a face's slot (FreeType's FT_Load_Glyph): the
// driver's outline or embedded bitmap, its metrics fitted to the pixel
// grid when hinting is asked for, its advances, the face's transform,
// then the bitmap rendered or its size set; advances and kerning.
//
// The library has no hinter: a glyph loaded with hinting has the outline
// of an unhinted load (scaled as the TrueType hinter scales it) and the
// grid-fitted metrics FreeType gives a glyph loaded with hinting.
const m = @import("./memory.mlx")
const r = @import("./records.mlx")
const o = @import("./objects.mlx")
const calc = @import("./calc.mlx")
const library = @import("./library.mlx")
const sfnt = @import("./sfnt.mlx")
const cmap = @import("./cmap.mlx")
const truetype = @import("./glyf.mlx")
const cff = @import("./cff.mlx")
const sbit = @import("./sbit.mlx")
const variations = @import("./variations.mlx")
const outlines = @import("./outlines.mlx")
const render = @import("./render.mlx")

// Frees the slot's bitmap when the slot owns it (FreeType's
// ft_glyphslot_free_bitmap).
pub fn freeBitmap(slot: usize) -> void {
    const s = o.slotRecord(slot)
    const internal = o.slotRecord(slot)
    if internal.*.ownBitmap {
        m.release(o.faceRecord(s.*.face).*.memory, s.*.bitmap.buffer)
        internal.*.ownBitmap = false
    }
    s.*.bitmap.buffer = 0
}

// Empties the slot's public fields (FreeType's ft_glyphslot_clear).
pub fn clearSlot(slot: usize) -> void {
    const s = o.slotRecord(slot)
    freeBitmap(slot)
    s.*.glyphIndex = 0
    s.*.metrics.width = 0
    s.*.metrics.height = 0
    s.*.metrics.horiBearingX = 0
    s.*.metrics.horiBearingY = 0
    s.*.metrics.horiAdvance = 0
    s.*.metrics.vertBearingX = 0
    s.*.metrics.vertBearingY = 0
    s.*.metrics.vertAdvance = 0
    s.*.outline.nContours = 0
    s.*.outline.nPoints = 0
    s.*.outline.points = 0
    s.*.outline.tags = 0
    s.*.outline.contours = 0
    s.*.outline.flags = 0
    s.*.bitmap.width = 0
    s.*.bitmap.rows = 0
    s.*.bitmap.pitch = 0
    s.*.bitmap.pixelMode = 0
    s.*.bitmapLeft = 0
    s.*.bitmapTop = 0
    s.*.numSubglyphs = 0
    s.*.subglyphs = 0
    s.*.format = r.FORMAT_NONE
    s.*.linearHoriAdvance = 0
    s.*.linearVertAdvance = 0
    s.*.advance.x = 0
    s.*.advance.y = 0
    s.*.lsbDelta = 0
    s.*.rsbDelta = 0
}

// Whether the face is a variable font at other than its default instance.
fn isDefaultInstance(face: usize) -> bool { return !variations.isVaried(face) }

// The TrueType driver's glyph load (FreeType's tt_glyph_load and
// TT_Load_Glyph).
fn loadTrueType(face: usize, size: usize, slot: usize, gindex: i64, loadFlags_: i64) -> i32 {
    const root = o.faceRecord(face)
    if size == 0 { return r.ERR_INVALID_SIZE_HANDLE }
    if gindex >= root.*.numGlyphs { return r.ERR_INVALID_ARGUMENT }
    var loadFlags = loadFlags_
    if (loadFlags & r.LOAD_NO_HINTING) != 0 && (loadFlags & r.LOAD_NO_AUTOHINT) != 0 { loadFlags |= r.LOAD_NO_HINTING }
    if (loadFlags & (r.LOAD_NO_RECURSE | r.LOAD_NO_SCALE)) != 0 { loadFlags |= r.LOAD_NO_BITMAP | r.LOAD_NO_SCALE | r.LOAD_NO_HINTING }
    const t = o.sizeRecord(size)
    const s = o.slotRecord(slot)
    if t.*.strikeIndex >= 0 && (loadFlags & r.LOAD_NO_BITMAP) == 0 && isDefaultInstance(face) {
        const xScale = o.sizeRecord(size).*.xScale
        const yScale = o.sizeRecord(size).*.yScale
        const err = sbit.loadGlyph(face, size, slot, gindex, loadFlags)
        if err == r.ERR_MISSING_BITMAP {
            if (root.*.faceFlags & r.FACE_SCALABLE) == 0 {
                const f = o.faceRecord(face)
                if f.*.hmtxSize == 0 { return err }
                // (An empty glyph of a bitmap font: its metrics only.)
                const h = variations.glyphMetrics(face, false, gindex)
                var tsb: i64 = 0
                var ah: i64 = 0
                if f.*.verticalInfo {
                    const v = variations.glyphMetrics(face, true, gindex)
                    tsb = v.0
                    ah = v.1
                } else if sfnt.os2Present(f) {
                    tsb = calc.low16(sfnt.typoAscender(f))
                    ah = calc.ulow16(calc.abs(sfnt.typoAscender(f) - sfnt.typoDescender(f)))
                } else {
                    tsb = calc.low16(sfnt.ascender(f))
                    ah = calc.ulow16(calc.abs(sfnt.ascender(f) - sfnt.descender(f)))
                }
                s.*.outline.nPoints = 0
                s.*.outline.nContours = 0
                s.*.metrics.width = 0
                s.*.metrics.height = 0
                s.*.metrics.horiBearingX = calc.mulFix(h.0, xScale)
                s.*.metrics.horiBearingY = 0
                s.*.metrics.horiAdvance = calc.mulFix(h.1, xScale)
                s.*.metrics.vertBearingX = 0
                s.*.metrics.vertBearingY = calc.mulFix(tsb, yScale)
                s.*.metrics.vertAdvance = calc.mulFix(ah, yScale)
                s.*.format = r.FORMAT_BITMAP
                s.*.bitmap.pixelMode = r.PIXEL_MONO
                s.*.bitmapLeft = 0
                s.*.bitmapTop = 0
                return r.OK
            }
        } else if err != r.OK {
            if (root.*.faceFlags & r.FACE_SCALABLE) == 0 { return err }
        } else {
            if (root.*.faceFlags & r.FACE_SCALABLE) != 0 || (root.*.faceFlags & r.FACE_SBIX) != 0 {
                const header = truetype.loadHeader(face, size, slot, gindex, loadFlags)
                s.*.linearHoriAdvance = header.0
                s.*.linearVertAdvance = header.1
                if o.faceRecord(face).*.sbitKind == sbit.KIND_SBIX && header.2 > 0 {
                    var left: i64 = 0
                    var top: i64 = 0
                    if (loadFlags & r.LOAD_VERTICAL_LAYOUT) != 0 {
                        left = header.3
                        top = header.6
                    } else {
                        left = header.5
                        top = header.4
                    }
                    s.*.bitmapLeft = @intCast(i32, calc.low32(@intCast(i64, s.*.bitmapLeft) + (calc.mulFix(left, xScale) >> 6)))
                    s.*.bitmapTop = @intCast(i32, calc.low32(@intCast(i64, s.*.bitmapTop) + (calc.mulFix(top, yScale) >> 6)))
                }
                if s.*.metrics.horiAdvance == 0 && s.*.linearHoriAdvance != 0 { s.*.metrics.horiAdvance = calc.mulFix(s.*.linearHoriAdvance, xScale) }
                if s.*.metrics.vertAdvance == 0 && s.*.linearVertAdvance != 0 { s.*.metrics.vertAdvance = calc.mulFix(s.*.linearVertAdvance, yScale) }
            }
            return r.OK
        }
    }
    if (loadFlags & r.LOAD_SBITS_ONLY) != 0 { return r.ERR_INVALID_ARGUMENT }
    return truetype.load(face, size, slot, gindex, loadFlags)
}

// The CFF driver's glyph load (FreeType's cff_glyph_load).
fn loadCff(face: usize, size_: usize, slot: usize, gindex: i64, loadFlags_: i64) -> i32 {
    var loadFlags = loadFlags_
    if size_ == 0 { loadFlags |= r.LOAD_NO_SCALE | r.LOAD_NO_HINTING }
    // FreeType forgets the size here only for its own check: the glyph
    // loader still gets it (and sets the outline's precision from it).
    return cff.loadGlyph(face, size_, slot, gindex, loadFlags)
}

// The driver's load of the face.
pub fn driverLoad(face: usize, size: usize, slot: usize, gindex: i64, loadFlags: i64) -> i32 {
    if o.faceRecord(face).*.driver == library.CFF { return loadCff(face, size, slot, gindex, loadFlags) }
    return loadTrueType(face, size, slot, gindex, loadFlags)
}

// The metrics of a glyph loaded with hinting, fitted to the pixel grid
// (FreeType's ft_glyphslot_grid_fit_metrics).
fn gridFitMetrics(slot: usize, vertical: bool) -> void {
    const s = o.slotRecord(slot)
    if vertical {
        s.*.metrics.horiBearingX = calc.pixFloor(s.*.metrics.horiBearingX)
        s.*.metrics.horiBearingY = calc.pixCeil(s.*.metrics.horiBearingY)
        const right = calc.pixCeil(s.*.metrics.vertBearingX +% s.*.metrics.width)
        const bottom = calc.pixCeil(s.*.metrics.vertBearingY +% s.*.metrics.height)
        s.*.metrics.vertBearingX = calc.pixFloor(s.*.metrics.vertBearingX)
        s.*.metrics.vertBearingY = calc.pixFloor(s.*.metrics.vertBearingY)
        s.*.metrics.width = right -% s.*.metrics.vertBearingX
        s.*.metrics.height = bottom -% s.*.metrics.vertBearingY
    } else {
        s.*.metrics.vertBearingX = calc.pixFloor(s.*.metrics.vertBearingX)
        s.*.metrics.vertBearingY = calc.pixFloor(s.*.metrics.vertBearingY)
        const right = calc.pixCeil(s.*.metrics.horiBearingX +% s.*.metrics.width)
        const bottom = calc.pixFloor(s.*.metrics.horiBearingY -% s.*.metrics.height)
        s.*.metrics.horiBearingX = calc.pixFloor(s.*.metrics.horiBearingX)
        s.*.metrics.horiBearingY = calc.pixCeil(s.*.metrics.horiBearingY)
        s.*.metrics.width = right -% s.*.metrics.horiBearingX
        s.*.metrics.height = s.*.metrics.horiBearingY -% bottom
    }
    s.*.metrics.horiAdvance = calc.pixRound(s.*.metrics.horiAdvance)
    s.*.metrics.vertAdvance = calc.pixRound(s.*.metrics.vertAdvance)
}

// Loads glyph `gindex` into the face's glyph slot at its size (FreeType's
// FT_Load_Glyph): its outline or bitmap, metrics and advances, the
// face's transform applied, rendered when LOAD_RENDER asks for it.
pub fn loadGlyph(face: usize, gindex: i64, loadFlags_: i64) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    const root = o.faceRecord(face)
    if root.*.activeSize == 0 || root.*.glyph == 0 { return r.ERR_INVALID_FACE_HANDLE }
    const slot = root.*.glyph
    const s = o.slotRecord(slot)
    clearSlot(slot)
    var loadFlags = loadFlags_
    const metrics = o.sizeRecord(root.*.activeSize)
    if metrics.*.xPpem == 0 || metrics.*.yPpem == 0 { loadFlags |= r.LOAD_NO_SCALE }
    if (loadFlags & r.LOAD_NO_RECURSE) != 0 { loadFlags |= r.LOAD_NO_SCALE | r.LOAD_IGNORE_TRANSFORM }
    if (loadFlags & r.LOAD_NO_SCALE) != 0 {
        loadFlags |= r.LOAD_NO_HINTING | r.LOAD_NO_BITMAP
        loadFlags &= ~r.LOAD_RENDER
    }
    if (loadFlags & r.LOAD_BITMAP_METRICS_ONLY) != 0 { loadFlags &= ~r.LOAD_RENDER }
    var err = driverLoad(face, root.*.activeSize, slot, gindex, loadFlags)
    if err != r.OK { return err }
    if s.*.format == r.FORMAT_OUTLINE {
        err = outlines.check(o.slotOutline(slot))
        if err != r.OK { return err }
        if (loadFlags & r.LOAD_NO_HINTING) == 0 { gridFitMetrics(slot, (loadFlags & r.LOAD_VERTICAL_LAYOUT) != 0) }
    }
    if (loadFlags & r.LOAD_VERTICAL_LAYOUT) != 0 {
        s.*.advance.x = 0
        s.*.advance.y = s.*.metrics.vertAdvance
    } else {
        s.*.advance.x = s.*.metrics.horiAdvance
        s.*.advance.y = 0
    }
    if (loadFlags & r.LOAD_LINEAR_DESIGN) == 0 && (root.*.faceFlags & r.FACE_SCALABLE) != 0 {
        s.*.linearHoriAdvance = calc.mulDiv(s.*.linearHoriAdvance, metrics.*.xScale, 64)
        s.*.linearVertAdvance = calc.mulDiv(s.*.linearVertAdvance, metrics.*.yScale, 64)
    }
    if (loadFlags & r.LOAD_IGNORE_TRANSFORM) == 0 {
        const f = o.faceRecord(face)
        if f.*.transformFlags != 0 {
            if s.*.format == r.FORMAT_OUTLINE {
                // (The outline renderer's transform.)
                const count = @intCast(i64, s.*.outline.nPoints)
                if (f.*.transformFlags & 1) != 0 { outlines.transform(s.*.outline.points, count, f.*.txx, f.*.txy, f.*.tyx, f.*.tyy) }
                if (f.*.transformFlags & 2) != 0 { outlines.translate(s.*.outline.points, count, f.*.tdx, f.*.tdy) }
            }
            const x = s.*.advance.x
            const y = s.*.advance.y
            s.*.advance.x = calc.mulFix(x, f.*.txx) +% calc.mulFix(y, f.*.txy)
            s.*.advance.y = calc.mulFix(x, f.*.tyx) +% calc.mulFix(y, f.*.tyy)
        }
    }
    s.*.glyphIndex = @intCast(u32, gindex & 0xFFFFFFFF)
    o.slotRecord(slot).*.loadFlags = loadFlags
    if (loadFlags & r.LOAD_NO_SCALE) == 0 && s.*.format != r.FORMAT_BITMAP && s.*.format != r.FORMAT_COMPOSITE {
        var mode = (loadFlags >> 16) & 15
        if mode == r.RENDER_NORMAL && (loadFlags & r.LOAD_MONOCHROME) != 0 { mode = r.RENDER_MONO }
        if (loadFlags & r.LOAD_RENDER) != 0 {
            err = render.renderGlyph(slot, mode)
        } else {
            _ = render.presetBitmap(slot, mode, 0, 0)
        }
    }
    return err
}

// The glyph of character `code` in the face's charmap (0 for none).
pub fn charIndex(face: usize, code: u64) -> u64 {
    if face == 0 { return 0 }
    const charmap = o.faceRecord(face).*.charmap
    if charmap == 0 { return 0 }
    if code > 0xFFFFFFFF { return 0 }
    const index = cmap.charIndex(charmap, code)
    if index >= @intCast(u64, o.faceRecord(face).*.numGlyphs) { return 0 }
    return index
}

// Loads the glyph of character `code` (FreeType's FT_Load_Char: the code
// is the glyph's index when the face has no charmap).
pub fn loadChar(face: usize, char_code: u64, load_flags: i64) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    var gindex = char_code & 0xFFFFFFFF
    if o.faceRecord(face).*.charmap != 0 { gindex = charIndex(face, char_code) }
    return loadGlyph(face, @intCast(i64, gindex), load_flags)
}

// ---------------------------------------------------------------------------
// Advances (FreeType's ftadvanc.c).

const ADVANCE_FLAG_FAST_ONLY: i64 = 0x20000000

fn scaleAdvances(face: usize, advances: usize, count: i64, flags: i64) -> i32 {
    if (flags & r.LOAD_NO_SCALE) != 0 { return r.OK }
    const size = o.faceRecord(face).*.activeSize
    if size == 0 { return r.ERR_INVALID_SIZE_HANDLE }
    const scale = if (flags & r.LOAD_VERTICAL_LAYOUT) != 0 { o.sizeRecord(size).*.yScale } else { o.sizeRecord(size).*.xScale }
    var i: i64 = 0
    while i < count {
        const at = advances + @intCast(usize, i) * 8
        m.putI64(at, calc.mulDiv(m.getI64(at), scale, 64))
        i += 1
    }
    return r.OK
}

// The driver's advances from `hmtx` or `vmtx`, unscaled (FreeType's
// tt_get_advances and cff_get_advances).
fn fastAdvances(face: usize, start: i64, count: i64, flags: i64, advances: usize) -> i32 {
    const f = o.faceRecord(face)
    const root = o.faceRecord(face)
    const vertical = (flags & r.LOAD_VERTICAL_LAYOUT) != 0
    const varied = (root.*.faceFlags & r.FACE_VARIATION) != 0 || (root.*.faceIndex >> 16) != 0
    if vertical {
        if varied && !variations.variesVerticalAdvances(face) { return r.ERR_UNIMPLEMENTED_FEATURE }
    } else {
        if varied && !variations.variesHorizontalAdvances(face) { return r.ERR_UNIMPLEMENTED_FEATURE }
    }
    if f.*.driver == library.CFF {
        if vertical && !f.*.verticalInfo { return cffAdvances(face, start, count, flags, advances) }
        if !vertical && sfnt.numberOfHMetrics(f) == 0 { return cffAdvances(face, start, count, flags, advances) }
    }
    var i: i64 = 0
    while i < count {
        var advance: i64 = 0
        if !vertical {
            advance = variations.glyphMetrics(face, false, start + i).1
        } else if f.*.verticalInfo {
            advance = variations.glyphMetrics(face, true, start + i).1
        } else if sfnt.os2Present(f) {
            advance = calc.ulow16(calc.abs(sfnt.typoAscender(f) - sfnt.typoDescender(f)))
        } else {
            advance = calc.ulow16(calc.abs(sfnt.ascender(f) - sfnt.descender(f)))
        }
        m.putI64(advances + @intCast(usize, i) * 8, advance)
        i += 1
    }
    return r.OK
}

// A CFF font's advances from its glyphs when its SFNT has no metrics.
fn cffAdvances(face: usize, start: i64, count: i64, flags: i64, advances: usize) -> i32 {
    const slot = o.faceRecord(face).*.glyph
    const s = o.slotRecord(slot)
    var i: i64 = 0
    while i < count {
        const err = loadCff(face, o.faceRecord(face).*.activeSize, slot, start + i, flags | r.LOAD_ADVANCE_ONLY)
        if err != r.OK { return err }
        m.putI64(advances + @intCast(usize, i) * 8, if (flags & r.LOAD_VERTICAL_LAYOUT) != 0 { s.*.linearVertAdvance } else { s.*.linearHoriAdvance })
        i += 1
    }
    return r.OK
}

fn fastCheck(flags: i64) -> bool { return (flags & (r.LOAD_NO_SCALE | r.LOAD_NO_HINTING)) != 0 || ((flags >> 16) & 15) == r.RENDER_LIGHT }

// The advances of `count` glyphs from `start` (16.16 pixels, or font
// units with LOAD_NO_SCALE), 64-bit each at `advances` (FreeType's
// FT_Get_Advances): from the metrics tables when the flags allow it
// unhinted, otherwise by loading each glyph (into the glyph slot).
pub fn getAdvances(face: usize, start: i64, count: i64, flags_: i64, advances: usize) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if advances == 0 { return r.ERR_INVALID_ARGUMENT }
    const num = o.faceRecord(face).*.numGlyphs
    const end = start + count
    if start >= num || end < start || end > num { return r.ERR_INVALID_GLYPH_INDEX }
    if count == 0 { return r.OK }
    var flags = flags_
    if fastCheck(flags) {
        const err = fastAdvances(face, start, count, flags, advances)
        if err == r.OK { return scaleAdvances(face, advances, count, flags) }
        if err != r.ERR_UNIMPLEMENTED_FEATURE { return err }
    }
    if (flags & ADVANCE_FLAG_FAST_ONLY) != 0 { return r.ERR_UNIMPLEMENTED_FEATURE }
    flags |= r.LOAD_ADVANCE_ONLY
    const factor: i64 = if (flags & r.LOAD_NO_SCALE) != 0 { 1 } else { 1024 }
    const s = o.slotRecord(o.faceRecord(face).*.glyph)
    var i: i64 = 0
    while i < count {
        const err = loadGlyph(face, start + i, flags)
        if err != r.OK { return err }
        m.putI64(advances + @intCast(usize, i) * 8, (if (flags & r.LOAD_VERTICAL_LAYOUT) != 0 { s.*.advance.y } else { s.*.advance.x }) *% factor)
        i += 1
    }
    return r.OK
}

// ---------------------------------------------------------------------------
// Kerning.

pub const KERNING_DEFAULT: u32 = 0
pub const KERNING_UNFITTED: u32 = 1
pub const KERNING_UNSCALED: u32 = 2

// The kerning of a pair of glyphs (`kern`): in font units
// (KERNING_UNSCALED), scaled to the size (KERNING_UNFITTED), or scaled
// and rounded to the pixel grid (FreeType's FT_Get_Kerning).
pub fn kerning(face: usize, left_glyph: u32, right_glyph: u32, kern_mode: u32) -> (i64, i64) {
    var x = sfnt.kerning(o.faceRecord(face), @intCast(i64, left_glyph), @intCast(i64, right_glyph))
    var y: i64 = 0
    if kern_mode != KERNING_UNSCALED {
        const size = o.sizeRecord(o.faceRecord(face).*.activeSize)
        x = calc.mulFix(x, size.*.xScale)
        y = calc.mulFix(y, size.*.yScale)
        if kern_mode != KERNING_UNFITTED {
            if size.*.xPpem < 25 { x = calc.mulDiv(x, @intCast(i64, size.*.xPpem), 25) }
            if size.*.yPpem < 25 { y = calc.mulDiv(y, @intCast(i64, size.*.yPpem), 25) }
            x = calc.pixRound(x)
            y = calc.pixRound(y)
        }
    }
    return -> (x, y)
}
