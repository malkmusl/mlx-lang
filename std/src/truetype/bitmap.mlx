// Bitmaps (ftbitmap.h) and synthetic styles (ftsynth.h) as FreeType
// makes them: copies, emboldening, conversion to 8-bit gray, blending
// into a BGRA bitmap; slanted and emboldened glyphs.
const m = @import("./memory.mlx")
const r = @import("./records.mlx")
const o = @import("./objects.mlx")
const calc = @import("./calc.mlx")
const outlines = @import("./outlines.mlx")

// FT_Bitmap: rows, width, pitch, buffer, num_grays, pixel_mode,
// palette_mode, palette (32 bytes).
const BITMAP_SIZE: usize = 32

fn memoryOf(library: usize) -> usize { return m.getWord(library) }

pub fn init(bitmap: usize) -> void { if bitmap != 0 { m.zero(bitmap, BITMAP_SIZE) } }

export fn FT_Bitmap_Init(abitmap: usize) -> void { init(abitmap) }
export fn FT_Bitmap_New(abitmap: usize) -> void { init(abitmap) }

pub fn done(library: usize, bitmap: usize) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    if bitmap == 0 { return r.ERR_INVALID_ARGUMENT }
    m.release(memoryOf(library), r.bitmap(bitmap).*.buffer)
    m.zero(bitmap, BITMAP_SIZE)
    return r.OK
}

export fn FT_Bitmap_Done(library: usize, bitmap: usize) -> i32 { return done(library, bitmap) }

pub fn copy(library: usize, source: usize, target: usize) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    if source == 0 || target == 0 { return r.ERR_INVALID_ARGUMENT }
    if source == target { return r.OK }
    const s = r.bitmap(source)
    const t = r.bitmap(target)
    const flip = (s.*.pitch < 0 && t.*.pitch > 0) || (s.*.pitch > 0 && t.*.pitch < 0)
    const memory = memoryOf(library)
    m.release(memory, t.*.buffer)
    m.copy(target, source, BITMAP_SIZE)
    if flip { t.*.pitch = 0 - t.*.pitch }
    if s.*.buffer == 0 { return r.OK }
    const pitch = @intCast(usize, calc.abs(@intCast(i64, s.*.pitch)))
    const rows = @intCast(usize, t.*.rows)
    t.*.buffer = m.alloc(memory, rows * pitch)
    if t.*.buffer == 0 { return r.ERR_OUT_OF_MEMORY }
    if flip {
        var sp = s.*.buffer
        var tp = t.*.buffer + pitch * (rows - 1)
        var i = rows
        while i > 0 {
            m.copy(tp, sp, pitch)
            sp += pitch
            tp -= pitch
            i -= 1
        }
    } else {
        m.copy(t.*.buffer, s.*.buffer, rows * pitch)
    }
    return r.OK
}

export fn FT_Bitmap_Copy(library: usize, source: usize, target: usize) -> i32 { return copy(library, source, target) }

// Room for `xpixels` more columns and `ypixels` more rows (above), the
// bits right of the image cleared (FreeType's ft_bitmap_assure_buffer).
fn assureBuffer(memory: usize, bitmap: usize, xpixels: i64, ypixels: i64) -> i32 {
    const b = r.bitmap(bitmap)
    const width = @intCast(i64, b.*.width)
    const height = @intCast(i64, b.*.rows)
    const pitch = calc.abs(@intCast(i64, b.*.pitch))
    var bpp: i64 = 0
    var newPitch: i64 = 0
    const mode = b.*.pixel_mode
    if mode == r.PIXEL_MONO {
        bpp = 1
        newPitch = (width + xpixels + 7) >> 3
    } else if mode == r.PIXEL_GRAY2 {
        bpp = 2
        newPitch = (width + xpixels + 3) >> 2
    } else if mode == r.PIXEL_GRAY4 {
        bpp = 4
        newPitch = (width + xpixels + 1) >> 1
    } else if mode == r.PIXEL_GRAY || mode == r.PIXEL_LCD || mode == r.PIXEL_LCD_V {
        bpp = 8
        newPitch = width + xpixels
    } else {
        return r.ERR_INVALID_GLYPH_FORMAT
    }
    if ypixels == 0 && newPitch <= pitch {
        const bitWidth = pitch * 8
        const bitLast = (width + xpixels) * bpp
        if bitLast < bitWidth {
            var line = b.*.buffer + @intCast(usize, bitLast >> 3)
            var end = b.*.buffer + @intCast(usize, pitch)
            const shift = bitLast & 7
            const mask = @intCast(i64, 0xFF00) >> @intCast(u6, shift)
            var count = height
            while count > 0 {
                var write = line
                if shift > 0 {
                    m.put8(write, @intCast(u8, @intCast(i64, m.get8(write)) & mask & 0xFF))
                    write += 1
                }
                if write < end { m.zero(write, end - write) }
                count -= 1
                line += @intCast(usize, pitch)
                end += @intCast(usize, pitch)
            }
        }
        return r.OK
    }
    const buffer = m.alloc(memory, @intCast(usize, (height + ypixels) * newPitch))
    if buffer == 0 { return r.ERR_OUT_OF_MEMORY }
    const len = (width * bpp + 7) >> 3
    var input = b.*.buffer
    const limit = b.*.buffer + @intCast(usize, pitch * height)
    var out = buffer
    if b.*.pitch > 0 { out += @intCast(usize, newPitch * ypixels) }
    while input < limit {
        m.copy(out, input, @intCast(usize, len))
        input += @intCast(usize, pitch)
        out += @intCast(usize, newPitch)
    }
    m.release(memory, b.*.buffer)
    b.*.buffer = buffer
    b.*.pitch = @intCast(i32, if b.*.pitch < 0 { 0 - newPitch } else { newPitch })
    return r.OK
}

pub fn embolden(library: usize, bitmap: usize, xStrength: i64, yStrength: i64) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    if bitmap == 0 || r.bitmap(bitmap).*.buffer == 0 { return r.ERR_INVALID_ARGUMENT }
    if (calc.pixRound(xStrength) >> 6) > 0x7FFFFFFF || (calc.pixRound(yStrength) >> 6) > 0x7FFFFFFF { return r.ERR_INVALID_ARGUMENT }
    var xstr = calc.low32(calc.pixRound(xStrength)) >> 6
    var ystr = calc.low32(calc.pixRound(yStrength)) >> 6
    if xstr == 0 && ystr == 0 { return r.OK }
    if xstr < 0 || ystr < 0 { return r.ERR_INVALID_ARGUMENT }
    const b = r.bitmap(bitmap)
    const mode = b.*.pixel_mode
    if mode == r.PIXEL_GRAY2 || mode == r.PIXEL_GRAY4 {
        var tmp: [4]u64 = undefined
        const t = @intFromPtr(&tmp[0])
        init(t)
        const err = convert(library, bitmap, t, 1)
        if err != r.OK { return err }
        _ = done(library, bitmap)
        m.copy(bitmap, t, BITMAP_SIZE)
    } else if mode == r.PIXEL_MONO {
        if xstr > 8 { xstr = 8 }
    } else if mode == r.PIXEL_LCD {
        xstr *= 3
    } else if mode == r.PIXEL_LCD_V {
        ystr *= 3
    } else if mode == r.PIXEL_BGRA {
        return r.OK
    }
    const err = assureBuffer(memoryOf(library), bitmap, xstr, ystr)
    if err != r.OK { return err }
    var pitch = @intCast(i64, b.*.pitch)
    var p: i64 = 0
    if pitch > 0 {
        p = @bitCast(i64, b.*.buffer) + pitch * ystr
    } else {
        pitch = 0 - pitch
        p = @bitCast(i64, b.*.buffer) + pitch * (@intCast(i64, b.*.rows) - 1)
    }
    const grays = @intCast(i64, b.*.num_grays)
    const monochrome = b.*.pixel_mode == r.PIXEL_MONO
    var y: i64 = 0
    while y < @intCast(i64, b.*.rows) {
        var x = pitch - 1
        while x >= 0 {
            const tmp = at(p + x)
            var i: i64 = 1
            while i <= xstr {
                if monochrome {
                    put(p + x, (at(p + x) | (tmp >> @intCast(u6, i))) & 0xFF)
                    if x > 0 { put(p + x, (at(p + x) | (at(p + x - 1) << @intCast(u6, 8 - i))) & 0xFF) }
                } else {
                    if x - i >= 0 {
                        if at(p + x) + at(p + x - i) > grays - 1 {
                            put(p + x, (grays - 1) & 0xFF)
                            break
                        } else {
                            put(p + x, (at(p + x) + at(p + x - i)) & 0xFF)
                            if at(p + x) == grays - 1 { break }
                        }
                    } else {
                        break
                    }
                }
                i += 1
            }
            x -= 1
        }
        var k: i64 = 1
        while k <= ystr {
            const q = p - @intCast(i64, b.*.pitch) * k
            var i: i64 = 0
            while i < pitch {
                put(q + i, at(q + i) | at(p + i))
                i += 1
            }
            k += 1
        }
        p += @intCast(i64, b.*.pitch)
        y += 1
    }
    b.*.width = @intCast(u32, (@intCast(i64, b.*.width) + xstr) & 0xFFFFFFFF)
    b.*.rows = @intCast(u32, (@intCast(i64, b.*.rows) + ystr) & 0xFFFFFFFF)
    return r.OK
}

fn at(address: i64) -> i64 { return @intCast(i64, m.get8(@bitCast(usize, address))) }
fn put(address: i64, value: i64) -> void { m.put8(@bitCast(usize, address), @intCast(u8, value & 0xFF)) }

export fn FT_Bitmap_Embolden(library: usize, bitmap: usize, xStrength: i64, yStrength: i64) -> i32 { return embolden(library, bitmap, xStrength, yStrength) }

// The gray of a premultiplied sRGB BGRA pixel (FreeType's
// ft_gray_for_premultiplied_srgb_bgra).
fn grayOfBgra(p: i64) -> i64 {
    const a = at(p + 3)
    if a == 0 { return 0 }
    const l = (4731 * at(p) * at(p) + 46868 * at(p + 1) * at(p + 1) + 13937 * at(p + 2) * at(p + 2)) >> 16
    return (a - l / a) & 0xFF
}

pub fn convert(library: usize, source: usize, target: usize, alignment: i64) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    if source == 0 || target == 0 { return r.ERR_INVALID_ARGUMENT }
    const s = r.bitmap(source)
    const t = r.bitmap(target)
    const mode = s.*.pixel_mode
    if mode != r.PIXEL_MONO && mode != r.PIXEL_GRAY && mode != r.PIXEL_GRAY2 && mode != r.PIXEL_GRAY4 && mode != r.PIXEL_LCD && mode != r.PIXEL_LCD_V && mode != r.PIXEL_BGRA { return r.ERR_INVALID_ARGUMENT }
    var width = @intCast(i64, s.*.width)
    const neg = (t.*.pitch == 0 && s.*.pitch < 0) || t.*.pitch < 0
    _ = done(library, target)
    t.*.pixel_mode = r.PIXEL_GRAY
    t.*.rows = s.*.rows
    t.*.width = s.*.width
    if alignment != 0 {
        const rem = width % alignment
        if rem != 0 { width = if alignment > 0 { width - rem + alignment } else { width - rem - alignment } }
    }
    t.*.buffer = m.alloc(memoryOf(library), @intCast(usize, @intCast(i64, t.*.rows) * width))
    if t.*.buffer == 0 && t.*.rows != 0 && width != 0 { return r.ERR_OUT_OF_MEMORY }
    t.*.pitch = @intCast(i32, if neg { 0 - width } else { width })
    var sp = @bitCast(i64, s.*.buffer)
    var tp = @bitCast(i64, t.*.buffer)
    const spitch = @intCast(i64, s.*.pitch)
    const tpitch = @intCast(i64, t.*.pitch)
    if spitch < 0 { sp -= spitch * (@intCast(i64, s.*.rows) - 1) }
    if tpitch < 0 { tp -= tpitch * (@intCast(i64, t.*.rows) - 1) }
    const sw = @intCast(i64, s.*.width)
    var rows = @intCast(i64, s.*.rows)
    if mode == r.PIXEL_MONO {
        t.*.num_grays = 2
    } else if mode == r.PIXEL_GRAY2 {
        t.*.num_grays = 4
    } else if mode == r.PIXEL_GRAY4 {
        t.*.num_grays = 16
    } else {
        t.*.num_grays = 256
    }
    while rows > 0 {
        var j: i64 = 0
        while j < sw {
            var value: i64 = 0
            if mode == r.PIXEL_MONO {
                value = (at(sp + (j >> 3)) >> @intCast(u6, 7 - (j & 7))) & 1
            } else if mode == r.PIXEL_GRAY2 {
                value = (at(sp + (j >> 2)) >> @intCast(u6, 6 - 2 * (j & 3))) & 3
            } else if mode == r.PIXEL_GRAY4 {
                value = (at(sp + (j >> 1)) >> @intCast(u6, 4 - 4 * (j & 1))) & 15
            } else if mode == r.PIXEL_BGRA {
                value = grayOfBgra(sp + j * 4)
            } else {
                value = at(sp + j)
            }
            put(tp + j, value)
            j += 1
        }
        sp += spitch
        tp += tpitch
        rows -= 1
    }
    return r.OK
}

export fn FT_Bitmap_Convert(library: usize, source: usize, target: usize, alignment: i32) -> i32 { return convert(library, source, target, @intCast(i64, alignment)) }

const LONG_MAX: i64 = 0x7FFFFFFFFFFFFFFF
const LONG_MIN: i64 = -0x7FFFFFFFFFFFFFFF - 1

// FT_Bitmap_Blend: the source (FT_Vector source_offset and FT_Color
// color passed by value: two words, then a word on the stack).
export fn FT_Bitmap_Blend(library: usize, source_: usize, offsetX: i64, offsetY: i64, target: usize, atarget_offset: usize, color: u64) -> i32 {
    if library == 0 || target == 0 || source_ == 0 || atarget_offset == 0 { return r.ERR_INVALID_ARGUMENT }
    const memory = memoryOf(library)
    const t = r.bitmap(target)
    const src = r.bitmap(source_)
    if !(t.*.pixel_mode == r.PIXEL_NONE || (t.*.pixel_mode == r.PIXEL_BGRA && t.*.buffer != 0)) { return r.ERR_INVALID_ARGUMENT }
    if src.*.pixel_mode == r.PIXEL_NONE { return r.OK }
    if t.*.pixel_mode == r.PIXEL_BGRA && (src.*.pitch ^ t.*.pitch) < 0 { return r.ERR_INVALID_ARGUMENT }
    if src.*.width == 0 || src.*.rows == 0 { return r.OK }
    const sox = calc.pixFloor(offsetX)
    const soy = calc.pixFloor(offsetY)
    const tox = calc.pixFloor(m.getI64(atarget_offset))
    const toy = calc.pixFloor(m.getI64(atarget_offset + 8))
    var sllx = sox
    const srows = @intCast(i64, src.*.rows)
    const swidth = @intCast(i64, src.*.width)
    if LONG_MIN + (srows << 6) + 64 > soy { return r.ERR_INVALID_ARGUMENT }
    var slly = soy - (srows << 6)
    if LONG_MAX - (swidth << 6) - 64 < sllx { return r.ERR_INVALID_ARGUMENT }
    const surx = sllx + (swidth << 6)
    const sury = soy
    var tllx = LONG_MAX
    var tlly = LONG_MAX
    var turx = LONG_MIN
    var tury = LONG_MIN
    const hasTarget = t.*.width != 0 && t.*.rows != 0
    if hasTarget {
        tllx = tox
        if LONG_MIN + (@intCast(i64, t.*.rows) << 6) > toy { return r.ERR_INVALID_ARGUMENT }
        tlly = toy - (@intCast(i64, t.*.rows) << 6)
        if LONG_MAX - (@intCast(i64, t.*.width) << 6) < tllx { return r.ERR_INVALID_ARGUMENT }
        turx = tllx + (@intCast(i64, t.*.width) << 6)
        tury = toy
    }
    const fllx = calc.min(sllx, tllx)
    const flly = calc.min(slly, tlly)
    const furx = calc.max(surx, turx)
    const fury = calc.max(sury, tury)
    const finalWidth = ((furx - fllx) >> 6) & 0xFFFFFFFF
    const finalRows = ((fury - flly) >> 6) & 0xFFFFFFFF
    if finalWidth == 0 || finalRows == 0 { return r.OK }
    sllx -= fllx
    slly -= flly
    if hasTarget {
        tllx -= fllx
        tlly -= flly
    }
    var freeTargetOnError = false
    if t.*.pixel_mode == r.PIXEL_NONE {
        t.*.width = @intCast(u32, finalWidth)
        t.*.rows = @intCast(u32, finalRows)
        t.*.pixel_mode = r.PIXEL_BGRA
        t.*.pitch = @intCast(i32, calc.low32(finalWidth * 4))
        t.*.num_grays = 256
        t.*.buffer = m.alloc(memory, @intCast(usize, finalWidth * 4 * finalRows))
        if t.*.buffer == 0 { return r.ERR_OUT_OF_MEMORY }
        freeTargetOnError = true
    } else if @intCast(i64, t.*.width) != finalWidth || @intCast(i64, t.*.rows) != finalRows {
        const pitch = calc.abs(@intCast(i64, t.*.pitch))
        const newPitch = finalWidth * 4
        const buffer = m.alloc(memory, @intCast(usize, newPitch * finalRows))
        if buffer == 0 { return r.ERR_OUT_OF_MEMORY }
        const x = tllx >> 6
        const y = tlly >> 6
        if t.*.pitch >= 0 {
            var p = t.*.buffer
            var q = buffer + @intCast(usize, (finalRows - y - @intCast(i64, t.*.rows)) * newPitch + x * 4)
            const limitP = p + @intCast(usize, pitch * @intCast(i64, t.*.rows))
            while p < limitP {
                m.copy(q, p, @intCast(usize, pitch))
                p += @intCast(usize, pitch)
                q += @intCast(usize, newPitch)
            }
        }
        m.release(memory, t.*.buffer)
        t.*.width = @intCast(u32, finalWidth)
        t.*.rows = @intCast(u32, finalRows)
        t.*.pitch = @intCast(i32, if t.*.pitch < 0 { 0 - newPitch } else { newPitch })
        t.*.buffer = buffer
    }
    var converted: [4]u64 = undefined
    var source = source_
    var freeSource = false
    if src.*.pixel_mode != r.PIXEL_GRAY {
        source = @intFromPtr(&converted[0])
        init(source)
        const err = convert(library, source_, source, 1)
        if err != r.OK {
            if freeTargetOnError { _ = done(library, target) }
            _ = done(library, source)
            return err
        }
        freeSource = true
    }
    const s = r.bitmap(source)
    const x = sllx >> 6
    const y = slly >> 6
    if t.*.pitch >= 0 {
        const blue = @intCast(i64, color & 0xFF)
        const green = @intCast(i64, (color >> 8) & 0xFF)
        const red = @intCast(i64, (color >> 16) & 0xFF)
        const alpha = @intCast(i64, (color >> 24) & 0xFF)
        var p = @bitCast(i64, s.*.buffer)
        var q = @bitCast(i64, t.*.buffer) + (@intCast(i64, t.*.rows) - y - @intCast(i64, s.*.rows)) * @intCast(i64, t.*.pitch) + x * 4
        const limitP = p + @intCast(i64, s.*.pitch) * @intCast(i64, s.*.rows)
        while p < limitP {
            var rr = p
            var ss = q
            const limitR = rr + @intCast(i64, s.*.width)
            while rr < limitR {
                const aa = at(rr)
                rr += 1
                const fa = alpha * aa / 255
                const fb = blue * fa / 255
                const fg = green * fa / 255
                const fr = red * fa / 255
                const ba2 = 255 - fa
                put(ss, at(ss) * ba2 / 255 + fb)
                put(ss + 1, at(ss + 1) * ba2 / 255 + fg)
                put(ss + 2, at(ss + 2) * ba2 / 255 + fr)
                put(ss + 3, at(ss + 3) * ba2 / 255 + fa)
                ss += 4
            }
            p += @intCast(i64, s.*.pitch)
            q += @intCast(i64, t.*.pitch)
        }
    }
    m.putI64(atarget_offset, fllx)
    m.putI64(atarget_offset + 8, flly + (finalRows << 6))
    if freeSource { _ = done(library, source) }
    return r.OK
}

pub fn ownBitmap(slot: usize) -> i32 {
    if slot == 0 { return r.OK }
    const s = r.slotRec(slot)
    const internal = o.slotRecord(slot)
    if s.*.format == r.FORMAT_BITMAP && !internal.*.ownBitmap {
        var copied: [4]u64 = undefined
        const b = @intFromPtr(&copied[0])
        init(b)
        const err = copy(s.*.library, slot + r.SLOT_BITMAP, b)
        if err != r.OK { return err }
        m.copy(slot + r.SLOT_BITMAP, b, BITMAP_SIZE)
        internal.*.ownBitmap = true
    }
    return r.OK
}

export fn FT_GlyphSlot_Own_Bitmap(slot: usize) -> i32 { return ownBitmap(slot) }

// ---------------------------------------------------------------------------
// Synthetic styles.

export fn FT_GlyphSlot_Oblique(slot: usize) -> void { FT_GlyphSlot_Slant(slot, 0x0366A, 0) }

export fn FT_GlyphSlot_Slant(slot: usize, xslant: i64, yslant: i64) -> void {
    if slot == 0 { return }
    const s = r.slotRec(slot)
    if s.*.format != r.FORMAT_OUTLINE { return }
    outlines.transform(s.*.points, @intCast(i64, s.*.n_points), 0x10000, xslant, 0 - yslant, 0x10000)
}

export fn FT_GlyphSlot_Embolden(slot: usize) -> void { FT_GlyphSlot_AdjustWeight(slot, 0x0AAA, 0x0AAA) }

export fn FT_GlyphSlot_AdjustWeight(slot: usize, xdelta: i64, ydelta: i64) -> void {
    if slot == 0 { return }
    const s = r.slotRec(slot)
    const size = r.sizeRec(r.faceRec(s.*.face).*.size)
    if s.*.format != r.FORMAT_OUTLINE && s.*.format != r.FORMAT_BITMAP { return }
    var xstr = @intCast(i64, size.*.x_ppem) *% xdelta / 1024
    var ystr = @intCast(i64, size.*.y_ppem) *% ydelta / 1024
    if s.*.format == r.FORMAT_OUTLINE {
        _ = outlines.embolden(slot + r.SLOT_OUTLINE, xstr, ystr)
    } else {
        xstr &= ~@intCast(i64, 63)
        if xstr == 0 { xstr = 64 }
        ystr &= ~@intCast(i64, 63)
        if (ystr >> 6) > 0x7FFFFFFF || (ystr >> 6) < -0x80000000 { return }
        if ownBitmap(slot) != r.OK { return }
        if embolden(s.*.library, slot + r.SLOT_BITMAP, xstr, ystr) != r.OK { return }
    }
    if s.*.advance_x != 0 { s.*.advance_x += xstr }
    if s.*.advance_y != 0 { s.*.advance_y += ystr }
    s.*.width += xstr
    s.*.height += ystr
    s.*.horiAdvance += xstr
    s.*.vertAdvance += ystr
    s.*.horiBearingY += ystr
    if s.*.format == r.FORMAT_BITMAP { s.*.bitmap_top = @intCast(i32, calc.low32(@intCast(i64, s.*.bitmap_top) + (ystr >> 6))) }
}
