// FreeType's monochrome rasterizer (its "raster" module, ftraster.c),
// computed as it computes it: the outline's contours become profiles
// (runs of x coordinates of the edges going up or down, one per
// scanline) in a pool of 2048 words; the scanlines are swept between
// left and right edges, with FreeType's drop-out control (the outline's
// flags, or the scan mode of its contours' first tags); a second sweep
// across the columns adds the pixels that thin horizontal parts would
// lose. A pool that overflows splits the band in two, as FreeType does.
const m = @import("./memory.mlx")
const r = @import("./records.mlx")
const calc = @import("./calc.mlx")

const POOL: i64 = 2048
// A profile in the pool: X, link, offset, flags, height, start, countL,
// next (8 words; offsets and links are indexes of the pool, NONE none).
const PROFILE_SIZE: i64 = 8
const NONE: i64 = -1
const P_X: i64 = 0
const P_LINK: i64 = 1
const P_OFFSET: i64 = 2
const P_FLAGS: i64 = 3
const P_HEIGHT: i64 = 4
const P_START: i64 = 5
const P_COUNT: i64 = 6
const P_NEXT: i64 = 7

const FLOW_UP: i64 = 0x08
const OVERSHOOT_TOP: i64 = 0x10
const OVERSHOOT_BOTTOM: i64 = 0x20

const UNKNOWN: i64 = 0
const ASCENDING: i64 = 1
const DESCENDING: i64 = 2

const MAX_BEZIER: i64 = 32
const BIT7: i64 = 0x80
const BYTE: i64 = 0xFF
const ERR_RASTER_NEGATIVE_HEIGHT: i32 = 0x63

const Worker = struct {
    precisionBits: i64
    precision: i64
    precisionHalf: i64
    precisionScale: i64
    precisionStep: i64
    precisionJitter: i64
    buff: usize
    maxBuff: i64
    top: i64
    err: i32
    numTurns: i64
    dropOutControl: i64
    bWidth: i64
    bOrigin: i64
    bLine: i64
    lastX: i64
    lastY: i64
    minY: i64
    maxY: i64
    numProfs: i64
    fresh: bool
    joint: bool
    cProfile: i64
    fProfile: i64
    gProfile: i64
    state: i64
    rows: i64
    width: i64
    pitch: i64
    buffer: usize
    outline: usize
    horizontal: bool
    // The arcs of a curve being split: 3 * 32 + 1 points.
    arcs: usize
}

fn worker(address: usize) -> *Worker { unsafe { return @ptrFromInt(*Worker, address) } }

fn word(w: *Worker, i: i64) -> i64 { return m.getI64(w.*.buff + @intCast(usize, i) * 8) }
fn setWord(w: *Worker, i: i64, value: i64) -> void { m.putI64(w.*.buff + @intCast(usize, i) * 8, value) }
fn field(w: *Worker, p: i64, f: i64) -> i64 { return word(w, p + f) }
fn setField(w: *Worker, p: i64, f: i64, value: i64) -> void { setWord(w, p + f, value) }

fn ax(w: *Worker, i: i64) -> i64 { return m.getI64(w.*.arcs + @intCast(usize, i) * 16) }
fn ay(w: *Worker, i: i64) -> i64 { return m.getI64(w.*.arcs + @intCast(usize, i) * 16 + 8) }
fn setArc(w: *Worker, i: i64, x: i64, y: i64) -> void {
    m.putI64(w.*.arcs + @intCast(usize, i) * 16, x)
    m.putI64(w.*.arcs + @intCast(usize, i) * 16 + 8, y)
}
fn setAy(w: *Worker, i: i64, y: i64) -> void { m.putI64(w.*.arcs + @intCast(usize, i) * 16 + 8, y) }

fn floor(w: *Worker, x: i64) -> i64 { return x & (0 - w.*.precision) }
fn ceiling(w: *Worker, x: i64) -> i64 { return (x + w.*.precision - 1) & (0 - w.*.precision) }
fn trunc(w: *Worker, x: i64) -> i64 { return x >> @intCast(u6, w.*.precisionBits) }
fn frac(w: *Worker, x: i64) -> i64 { return x & (w.*.precision - 1) }
fn scaled(w: *Worker, x: i64) -> i64 { return x * w.*.precisionScale - w.*.precisionHalf }
fn bottomOvershoot(w: *Worker, x: i64) -> bool { return ceiling(w, x) - x >= w.*.precisionHalf }
fn topOvershoot(w: *Worker, x: i64) -> bool { return x - floor(w, x) >= w.*.precisionHalf }
fn smart(w: *Worker, p: i64, q: i64) -> i64 { return floor(w, (p + q + w.*.precision * 63 / 64) >> 1) }

fn setHighPrecision(w: *Worker, high: bool) -> void {
    if high {
        w.*.precisionBits = 12
        w.*.precisionStep = 256
        w.*.precisionJitter = 30
    } else {
        w.*.precisionBits = 6
        w.*.precisionStep = 32
        w.*.precisionJitter = 2
    }
    w.*.precision = @intCast(i64, 1) << @intCast(u6, w.*.precisionBits)
    w.*.precisionHalf = w.*.precision >> 1
    w.*.precisionScale = w.*.precision >> 6
}

// FreeType's Booleans: SUCCESS is false, FAILURE true.
fn newProfile(w: *Worker, state: i64, overshoot: bool) -> bool {
    if w.*.fProfile == NONE {
        w.*.cProfile = w.*.top
        w.*.fProfile = w.*.cProfile
        w.*.top += PROFILE_SIZE
    }
    if w.*.top >= w.*.maxBuff {
        w.*.err = r.ERR_RASTER_OVERFLOW
        return true
    }
    const p = w.*.cProfile
    setField(w, p, P_START, 0)
    setField(w, p, P_HEIGHT, 0)
    setField(w, p, P_OFFSET, w.*.top)
    setField(w, p, P_LINK, NONE)
    setField(w, p, P_NEXT, NONE)
    var flags = w.*.dropOutControl
    if state == ASCENDING {
        flags |= FLOW_UP
        if overshoot { flags |= OVERSHOOT_BOTTOM }
    } else if state == DESCENDING {
        if overshoot { flags |= OVERSHOOT_TOP }
    } else {
        w.*.err = r.ERR_INVALID_OUTLINE
        return true
    }
    setField(w, p, P_FLAGS, flags)
    if w.*.gProfile == NONE { w.*.gProfile = p }
    w.*.state = state
    w.*.fresh = true
    w.*.joint = false
    return false
}

fn endProfile(w: *Worker, overshoot: bool) -> bool {
    const p = w.*.cProfile
    const h = w.*.top - field(w, p, P_OFFSET)
    if h < 0 {
        w.*.err = ERR_RASTER_NEGATIVE_HEIGHT
        return true
    }
    if h > 0 {
        setField(w, p, P_HEIGHT, h)
        if overshoot {
            if (field(w, p, P_FLAGS) & FLOW_UP) != 0 {
                setField(w, p, P_FLAGS, field(w, p, P_FLAGS) | OVERSHOOT_TOP)
            } else {
                setField(w, p, P_FLAGS, field(w, p, P_FLAGS) | OVERSHOOT_BOTTOM)
            }
        }
        w.*.cProfile = w.*.top
        w.*.top += PROFILE_SIZE
        setField(w, w.*.cProfile, P_HEIGHT, 0)
        setField(w, w.*.cProfile, P_OFFSET, w.*.top)
        setField(w, p, P_NEXT, w.*.cProfile)
        w.*.numProfs += 1
    }
    if w.*.top >= w.*.maxBuff {
        w.*.err = r.ERR_RASTER_OVERFLOW
        return true
    }
    w.*.joint = false
    return false
}

// The turns (the scanlines where profiles start or end) are kept sorted
// at the end of the pool.
fn insertYTurn(w: *Worker, y_: i64) -> bool {
    var y = calc.low32(y_)
    var n = w.*.numTurns - 1
    const turns = POOL - w.*.numTurns
    while n >= 0 && y < word(w, turns + n) { n -= 1 }
    if n >= 0 && y > word(w, turns + n) {
        while true {
            const y2 = calc.low32(word(w, turns + n))
            setWord(w, turns + n, y)
            y = y2
            n -= 1
            if n < 0 { break }
        }
    }
    if n < 0 {
        w.*.maxBuff -= 1
        if w.*.maxBuff <= w.*.top {
            w.*.err = r.ERR_RASTER_OVERFLOW
            return true
        }
        w.*.numTurns += 1
        setWord(w, POOL - w.*.numTurns, y)
    }
    return false
}

fn finalizeProfileTable(w: *Worker) -> bool {
    var n = w.*.numProfs & 0xFFFF
    var p = w.*.fProfile
    if n > 1 && p != NONE {
        while true {
            if n > 1 {
                setField(w, p, P_LINK, field(w, p, P_OFFSET) + field(w, p, P_HEIGHT))
            } else {
                setField(w, p, P_LINK, NONE)
            }
            var bottom: i64 = 0
            var top: i64 = 0
            if (field(w, p, P_FLAGS) & FLOW_UP) != 0 {
                bottom = calc.low32(field(w, p, P_START))
                top = calc.low32(field(w, p, P_START) + field(w, p, P_HEIGHT) - 1)
            } else {
                bottom = calc.low32(field(w, p, P_START) - field(w, p, P_HEIGHT) + 1)
                top = calc.low32(field(w, p, P_START))
                setField(w, p, P_START, bottom)
                setField(w, p, P_OFFSET, field(w, p, P_OFFSET) + field(w, p, P_HEIGHT) - 1)
            }
            if insertYTurn(w, bottom) || insertYTurn(w, top + 1) { return true }
            p = field(w, p, P_LINK)
            n -= 1
            if n == 0 { break }
        }
    } else {
        w.*.fProfile = NONE
    }
    return false
}

fn splitConic(w: *Worker, i: i64) -> void {
    var k: usize = 0
    while k < 2 {
        const base = w.*.arcs + @intCast(usize, i) * 16 + k * 8
        m.putI64(base + 64, m.getI64(base + 32))
        const a = m.getI64(base) + m.getI64(base + 16)
        const b = m.getI64(base + 16) + m.getI64(base + 32)
        m.putI64(base + 48, b >> 1)
        m.putI64(base + 32, (a + b) >> 2)
        m.putI64(base + 16, a >> 1)
        k += 1
    }
}

fn splitCubic(w: *Worker, i: i64) -> void {
    var k: usize = 0
    while k < 2 {
        const base = w.*.arcs + @intCast(usize, i) * 16 + k * 8
        m.putI64(base + 96, m.getI64(base + 48))
        var a = m.getI64(base) + m.getI64(base + 16)
        const b = m.getI64(base + 16) + m.getI64(base + 32)
        var c = m.getI64(base + 32) + m.getI64(base + 48)
        m.putI64(base + 80, c >> 1)
        c += b
        m.putI64(base + 64, c >> 2)
        m.putI64(base + 16, a >> 1)
        a += b
        m.putI64(base + 32, a >> 2)
        m.putI64(base + 48, (a + c) >> 3)
        k += 1
    }
}

fn split(w: *Worker, degree: i64, i: i64) -> void {
    if degree == 2 {
        splitConic(w, i)
    } else {
        splitCubic(w, i)
    }
}

fn lineUp(w: *Worker, x1_: i64, y1: i64, x2: i64, y2: i64, miny: i64, maxy: i64) -> bool {
    var x1 = x1_
    var dx = x2 - x1
    const dy = y2 - y1
    if dy <= 0 || y2 < miny || y1 > maxy { return false }
    var e1: i64 = 0
    var f1: i64 = 0
    var e2: i64 = 0
    var f2: i64 = 0
    if y1 < miny {
        x1 += calc.mulDiv(dx, miny - y1, dy)
        e1 = calc.low32(trunc(w, miny))
        f1 = 0
    } else {
        e1 = calc.low32(trunc(w, y1))
        f1 = calc.low32(frac(w, y1))
    }
    if y2 > maxy {
        e2 = calc.low32(trunc(w, maxy))
        f2 = 0
    } else {
        e2 = calc.low32(trunc(w, y2))
        f2 = calc.low32(frac(w, y2))
    }
    if f1 > 0 {
        if e1 == e2 { return false }
        x1 += calc.mulDiv(dx, w.*.precision - f1, dy)
        e1 += 1
    } else if w.*.joint {
        w.*.top -= 1
        w.*.joint = false
    }
    w.*.joint = f2 == 0
    if w.*.fresh {
        setField(w, w.*.cProfile, P_START, e1)
        w.*.fresh = false
    }
    var size = e2 - e1 + 1
    if w.*.top + size >= w.*.maxBuff {
        w.*.err = r.ERR_RASTER_OVERFLOW
        return true
    }
    var ix: i64 = 0
    var rx: i64 = 0
    if dx > 0 {
        ix = calc.mulDivNoRound(w.*.precision, dx, dy)
        rx = (w.*.precision * dx) % dy
        dx = 1
    } else {
        ix = 0 - calc.mulDivNoRound(w.*.precision, 0 - dx, dy)
        rx = (w.*.precision * (0 - dx)) % dy
        dx = -1
    }
    var acc = 0 - dy
    var top = w.*.top
    while size > 0 {
        setWord(w, top, x1)
        top += 1
        x1 += ix
        acc += rx
        if acc >= 0 {
            acc -= dy
            x1 += dx
        }
        size -= 1
    }
    w.*.top = top
    return false
}

fn lineDown(w: *Worker, x1: i64, y1: i64, x2: i64, y2: i64, miny: i64, maxy: i64) -> bool {
    const fresh = w.*.fresh
    const result = lineUp(w, x1, 0 - y1, x2, 0 - y2, 0 - maxy, 0 - miny)
    if fresh && !w.*.fresh { setField(w, w.*.cProfile, P_START, 0 - field(w, w.*.cProfile, P_START)) }
    return result
}

fn bezierUp(w: *Worker, degree: i64, arc_: i64, miny: i64, maxy: i64) -> bool {
    var arc = arc_
    var y1 = ay(w, arc + degree)
    var y2 = ay(w, arc)
    var top = w.*.top
    if y2 < miny || y1 > maxy {
        w.*.top = top
        return false
    }
    var e2 = floor(w, y2)
    if e2 > maxy { e2 = maxy }
    var e0 = miny
    var e: i64 = 0
    if y1 < miny {
        e = miny
    } else {
        e = ceiling(w, y1)
        const f1 = calc.low16(frac(w, y1))
        e0 = e
        if f1 == 0 {
            if w.*.joint {
                top -= 1
                w.*.joint = false
            }
            setWord(w, top, ax(w, arc + degree))
            top += 1
            e += w.*.precision
        }
    }
    if w.*.fresh {
        setField(w, w.*.cProfile, P_START, trunc(w, e0))
        w.*.fresh = false
    }
    if e2 < e {
        w.*.top = top
        return false
    }
    if top + trunc(w, e2 - e) + 1 >= w.*.maxBuff {
        w.*.top = top
        w.*.err = r.ERR_RASTER_OVERFLOW
        return true
    }
    const start = arc
    while true {
        w.*.joint = false
        y2 = ay(w, arc)
        if y2 > e {
            y1 = ay(w, arc + degree)
            if y2 - y1 >= w.*.precisionStep && arc + degree * 2 < MAX_BEZIER * 3 {
                split(w, degree, arc)
                arc += degree
            } else {
                setWord(w, top, ax(w, arc + degree) + (ax(w, arc) - ax(w, arc + degree)) * (e - y1) / (y2 - y1))
                top += 1
                arc -= degree
                e += w.*.precision
            }
        } else {
            if y2 == e {
                w.*.joint = true
                setWord(w, top, ax(w, arc))
                top += 1
                e += w.*.precision
            }
            arc -= degree
        }
        if !(arc >= start && e <= e2) { break }
    }
    w.*.top = top
    return false
}

fn bezierDown(w: *Worker, degree: i64, arc: i64, miny: i64, maxy: i64) -> bool {
    setAy(w, arc, 0 - ay(w, arc))
    setAy(w, arc + 1, 0 - ay(w, arc + 1))
    setAy(w, arc + 2, 0 - ay(w, arc + 2))
    if degree > 2 { setAy(w, arc + 3, 0 - ay(w, arc + 3)) }
    const fresh = w.*.fresh
    const result = bezierUp(w, degree, arc, 0 - maxy, 0 - miny)
    if fresh && !w.*.fresh { setField(w, w.*.cProfile, P_START, 0 - field(w, w.*.cProfile, P_START)) }
    setAy(w, arc, 0 - ay(w, arc))
    return result
}

fn lineTo(w: *Worker, x: i64, y: i64) -> bool {
    if w.*.state == UNKNOWN {
        if y > w.*.lastY {
            if newProfile(w, ASCENDING, bottomOvershoot(w, w.*.lastY)) { return true }
        } else if y < w.*.lastY {
            if newProfile(w, DESCENDING, topOvershoot(w, w.*.lastY)) { return true }
        }
    } else if w.*.state == ASCENDING {
        if y < w.*.lastY {
            if endProfile(w, topOvershoot(w, w.*.lastY)) || newProfile(w, DESCENDING, topOvershoot(w, w.*.lastY)) { return true }
        }
    } else if w.*.state == DESCENDING {
        if y > w.*.lastY {
            if endProfile(w, bottomOvershoot(w, w.*.lastY)) || newProfile(w, ASCENDING, bottomOvershoot(w, w.*.lastY)) { return true }
        }
    }
    if w.*.state == ASCENDING {
        if lineUp(w, w.*.lastX, w.*.lastY, x, y, w.*.minY, w.*.maxY) { return true }
    } else if w.*.state == DESCENDING {
        if lineDown(w, w.*.lastX, w.*.lastY, x, y, w.*.minY, w.*.maxY) { return true }
    }
    w.*.lastX = x
    w.*.lastY = y
    return false
}

fn conicTo(w: *Worker, cx: i64, cy: i64, x: i64, y: i64) -> bool {
    var arc: i64 = 0
    setArc(w, 2, w.*.lastX, w.*.lastY)
    setArc(w, 1, cx, cy)
    setArc(w, 0, x, y)
    var y3: i64 = 0
    var x3: i64 = 0
    while true {
        const y1 = ay(w, arc + 2)
        const y2 = ay(w, arc + 1)
        y3 = ay(w, arc)
        x3 = ax(w, arc)
        var ymin = y1
        var ymax = y3
        if y1 > y3 {
            ymin = y3
            ymax = y1
        }
        if (y2 < ymin || y2 > ymax) && arc + 4 < 2 * MAX_BEZIER {
            splitConic(w, arc)
            arc += 2
        } else if y1 == y3 {
            arc -= 2
        } else {
            const state = if y1 < y3 { ASCENDING } else { DESCENDING }
            if w.*.state != state {
                const o_ = if state == ASCENDING { bottomOvershoot(w, y1) } else { topOvershoot(w, y1) }
                if w.*.state != UNKNOWN && endProfile(w, o_) { return true }
                if newProfile(w, state, o_) { return true }
            }
            if state == ASCENDING {
                if bezierUp(w, 2, arc, w.*.minY, w.*.maxY) { return true }
            } else {
                if bezierDown(w, 2, arc, w.*.minY, w.*.maxY) { return true }
            }
            arc -= 2
        }
        if arc < 0 { break }
    }
    w.*.lastX = x3
    w.*.lastY = y3
    return false
}

fn cubicTo(w: *Worker, cx1: i64, cy1: i64, cx2: i64, cy2: i64, x: i64, y: i64) -> bool {
    var arc: i64 = 0
    setArc(w, 3, w.*.lastX, w.*.lastY)
    setArc(w, 2, cx1, cy1)
    setArc(w, 1, cx2, cy2)
    setArc(w, 0, x, y)
    var y4: i64 = 0
    var x4: i64 = 0
    while true {
        const y1 = ay(w, arc + 3)
        const y2 = ay(w, arc + 2)
        const y3 = ay(w, arc + 1)
        y4 = ay(w, arc)
        x4 = ax(w, arc)
        var ymin1 = y1
        var ymax1 = y4
        if y1 > y4 {
            ymin1 = y4
            ymax1 = y1
        }
        var ymin2 = y2
        var ymax2 = y3
        if y2 > y3 {
            ymin2 = y3
            ymax2 = y2
        }
        if (ymin2 < ymin1 || ymax2 > ymax1) && arc + 6 < 3 * MAX_BEZIER {
            splitCubic(w, arc)
            arc += 3
        } else if y1 == y4 {
            arc -= 3
        } else {
            const state = if y1 <= y4 { ASCENDING } else { DESCENDING }
            if w.*.state != state {
                const o_ = if state == ASCENDING { bottomOvershoot(w, y1) } else { topOvershoot(w, y1) }
                if w.*.state != UNKNOWN && endProfile(w, o_) { return true }
                if newProfile(w, state, o_) { return true }
            }
            if state == ASCENDING {
                if bezierUp(w, 3, arc, w.*.minY, w.*.maxY) { return true }
            } else {
                if bezierDown(w, 3, arc, w.*.minY, w.*.maxY) { return true }
            }
            arc -= 3
        }
        if arc < 0 { break }
    }
    w.*.lastX = x4
    w.*.lastY = y4
    return false
}

fn pointX(w: *Worker, i: i64) -> i64 { return m.getI64(r.outline(w.*.outline).*.points + @intCast(usize, i) * 16) }
fn pointY(w: *Worker, i: i64) -> i64 { return m.getI64(r.outline(w.*.outline).*.points + @intCast(usize, i) * 16 + 8) }
fn tagAt(w: *Worker, i: i64) -> i64 { return @intCast(i64, m.get8(r.outline(w.*.outline).*.tags + @intCast(usize, i))) }

// A contour's segments (FreeType's Decompose_Curve); `flipped` swaps x
// and y (the horizontal sweep).
fn decomposeCurve(w: *Worker, first: i64, last: i64, flipped: bool) -> bool {
    var limit = last
    var startX = scaled(w, pointX(w, first))
    var startY = scaled(w, pointY(w, first))
    var lastX = scaled(w, pointX(w, last))
    var lastY = scaled(w, pointY(w, last))
    if flipped {
        const t1 = startX
        startX = startY
        startY = t1
        const t2 = lastX
        lastX = lastY
        lastY = t2
    }
    var controlX = startX
    var controlY = startY
    var point = first
    if (tagAt(w, first) & 4) != 0 { w.*.dropOutControl = (tagAt(w, first) & 0xFF) >> 5 }
    var tag = tagAt(w, first) & 3
    if tag == 2 {
        w.*.err = r.ERR_INVALID_OUTLINE
        return true
    }
    if tag == 0 {
        if (tagAt(w, last) & 3) == 1 {
            startX = lastX
            startY = lastY
            limit -= 1
        } else {
            startX = (startX + lastX) / 2
            startY = (startY + lastY) / 2
        }
        point -= 1
    }
    w.*.lastX = startX
    w.*.lastY = startY
    while point < limit {
        point += 1
        tag = tagAt(w, point) & 3
        if tag == 1 {
            var x = scaled(w, pointX(w, point))
            var y = scaled(w, pointY(w, point))
            if flipped {
                const t = x
                x = y
                y = t
            }
            if lineTo(w, x, y) { return true }
            continue
        }
        if tag == 0 {
            controlX = scaled(w, pointX(w, point))
            controlY = scaled(w, pointY(w, point))
            if flipped {
                const t = controlX
                controlX = controlY
                controlY = t
            }
            var finished = false
            while point < limit {
                point += 1
                tag = tagAt(w, point) & 3
                var x = scaled(w, pointX(w, point))
                var y = scaled(w, pointY(w, point))
                if flipped {
                    const t = x
                    x = y
                    y = t
                }
                if tag == 1 {
                    if conicTo(w, controlX, controlY, x, y) { return true }
                    finished = true
                    break
                }
                if tag != 0 {
                    w.*.err = r.ERR_INVALID_OUTLINE
                    return true
                }
                if conicTo(w, controlX, controlY, (controlX + x) / 2, (controlY + y) / 2) { return true }
                controlX = x
                controlY = y
            }
            if finished { continue }
            return conicTo(w, controlX, controlY, startX, startY)
        }
        // A cubic.
        if point + 1 > limit || (tagAt(w, point + 1) & 3) != 2 {
            w.*.err = r.ERR_INVALID_OUTLINE
            return true
        }
        point += 2
        var x1 = scaled(w, pointX(w, point - 2))
        var y1 = scaled(w, pointY(w, point - 2))
        var x2 = scaled(w, pointX(w, point - 1))
        var y2 = scaled(w, pointY(w, point - 1))
        if flipped {
            var t = x1
            x1 = y1
            y1 = t
            t = x2
            x2 = y2
            y2 = t
        }
        if point <= limit {
            var x3 = scaled(w, pointX(w, point))
            var y3 = scaled(w, pointY(w, point))
            if flipped {
                const t = x3
                x3 = y3
                y3 = t
            }
            if cubicTo(w, x1, y1, x2, y2, x3, y3) { return true }
            continue
        }
        return cubicTo(w, x1, y1, x2, y2, startX, startY)
    }
    return lineTo(w, startX, startY)
}

fn convertGlyph(w: *Worker, flipped: bool) -> bool {
    w.*.fProfile = NONE
    w.*.joint = false
    w.*.fresh = false
    w.*.maxBuff = POOL - PROFILE_SIZE
    w.*.numTurns = 0
    w.*.cProfile = w.*.top
    setField(w, w.*.cProfile, P_OFFSET, w.*.top)
    w.*.numProfs = 0
    const o_ = r.outline(w.*.outline)
    var last: i64 = -1
    var i: i64 = 0
    while i < @intCast(i64, o_.*.n_contours) {
        w.*.state = UNKNOWN
        w.*.gProfile = NONE
        const first = last + 1
        last = @intCast(i64, m.getI16(o_.*.contours + @intCast(usize, i) * 2))
        i += 1
        if decomposeCurve(w, first, last, flipped) { return true }
        if frac(w, w.*.lastY) == 0 && w.*.lastY >= w.*.minY && w.*.lastY <= w.*.maxY {
            if w.*.gProfile != NONE && (field(w, w.*.gProfile, P_FLAGS) & FLOW_UP) == (field(w, w.*.cProfile, P_FLAGS) & FLOW_UP) { w.*.top -= 1 }
        }
        const lastProfile = w.*.cProfile
        var overshoot = false
        if w.*.top != field(w, w.*.cProfile, P_OFFSET) && (field(w, w.*.cProfile, P_FLAGS) & FLOW_UP) != 0 {
            overshoot = topOvershoot(w, w.*.lastY)
        } else {
            overshoot = bottomOvershoot(w, w.*.lastY)
        }
        if endProfile(w, overshoot) { return true }
        if w.*.gProfile != NONE { setField(w, lastProfile, P_NEXT, w.*.gProfile) }
    }
    if finalizeProfileTable(w) { return true }
    return !(w.*.top < w.*.maxBuff)
}

// Sorted lists of profiles (by X), linked by P_LINK; a list is held in a
// word of the worker's own (its head).

fn insNew(w: *Worker, list: usize, profile: i64) -> void {
    var previous: i64 = NONE
    var current = m.getI64(list)
    const x = field(w, profile, P_X)
    while current != NONE {
        if x < field(w, current, P_X) { break }
        previous = current
        current = field(w, current, P_LINK)
    }
    setField(w, profile, P_LINK, current)
    if previous == NONE {
        m.putI64(list, profile)
    } else {
        setField(w, previous, P_LINK, profile)
    }
}

fn delOld(w: *Worker, list: usize, profile: i64) -> void {
    var previous: i64 = NONE
    var current = m.getI64(list)
    while current != NONE {
        if current == profile {
            if previous == NONE {
                m.putI64(list, field(w, current, P_LINK))
            } else {
                setField(w, previous, P_LINK, field(w, current, P_LINK))
            }
            return
        }
        previous = current
        current = field(w, current, P_LINK)
    }
}

fn sortList(w: *Worker, list: usize) -> void {
    var current = m.getI64(list)
    while current != NONE {
        setField(w, current, P_X, word(w, field(w, current, P_OFFSET)))
        setField(w, current, P_OFFSET, field(w, current, P_OFFSET) + (if (field(w, current, P_FLAGS) & FLOW_UP) != 0 { 1 } else { -1 }))
        setField(w, current, P_HEIGHT, field(w, current, P_HEIGHT) - 1)
        current = field(w, current, P_LINK)
    }
    var previous: i64 = NONE
    current = m.getI64(list)
    if current == NONE { return }
    var next = field(w, current, P_LINK)
    while next != NONE {
        if field(w, current, P_X) <= field(w, next, P_X) {
            previous = current
            current = field(w, current, P_LINK)
            if current == NONE { return }
        } else {
            if previous == NONE {
                m.putI64(list, next)
            } else {
                setField(w, previous, P_LINK, next)
            }
            setField(w, current, P_LINK, field(w, next, P_LINK))
            setField(w, next, P_LINK, current)
            previous = NONE
            current = m.getI64(list)
        }
        next = field(w, current, P_LINK)
    }
}

fn byteAt(address: i64) -> i64 { return @intCast(i64, m.get8(@bitCast(usize, address))) }
fn orByte(address: i64, value: i64) -> void { m.put8(@bitCast(usize, address), @intCast(u8, (byteAt(address) | value) & 0xFF)) }

fn sweepInit(w: *Worker, min: i64) -> void {
    if !w.*.horizontal { w.*.bLine = w.*.bOrigin - min * w.*.pitch }
}

fn sweepStep(w: *Worker) -> void {
    if !w.*.horizontal { w.*.bLine -= w.*.pitch }
}

fn sweepSpan(w: *Worker, y: i64, x1: i64, x2: i64, left: i64) -> void {
    if w.*.horizontal {
        var e1 = ceiling(w, x1)
        if x1 == e1 {
            e1 = trunc(w, e1)
            if e1 >= 0 && e1 < w.*.rows { orByte(w.*.bOrigin + (y >> 3) - e1 * w.*.pitch, BIT7 >> @intCast(u6, y & 7)) }
        }
        var e2 = floor(w, x2)
        if x2 == e2 {
            e2 = trunc(w, e2)
            if e2 >= 0 && e2 < w.*.rows { orByte(w.*.bOrigin + (y >> 3) - e2 * w.*.pitch, BIT7 >> @intCast(u6, y & 7)) }
        }
        return
    }
    const dropOutControl = field(w, left, P_FLAGS) & 7
    var e1 = ceiling(w, x1)
    var e2 = floor(w, x2)
    if dropOutControl != 2 && x2 - x1 - w.*.precision <= w.*.precisionJitter && e1 != x1 && e2 != x2 { e2 = e1 }
    e1 = trunc(w, e1)
    e2 = trunc(w, e2)
    if e2 >= 0 && e1 < w.*.bWidth {
        if e1 < 0 { e1 = 0 }
        if e2 >= w.*.bWidth { e2 = w.*.bWidth - 1 }
        const c1 = calc.low16(e1 >> 3)
        var c2 = calc.low16(e2 >> 3)
        const f1 = (BYTE >> @intCast(u6, e1 & 7)) & 0xFF
        const f2 = (~(@intCast(i64, 0x7F) >> @intCast(u6, e2 & 7))) & 0xFF
        var target = w.*.bLine + c1
        c2 -= c1
        if c2 > 0 {
            orByte(target, f1)
            c2 -= 1
            while c2 > 0 {
                target += 1
                m.put8(@bitCast(usize, target), 0xFF)
                c2 -= 1
            }
            orByte(target + 1, f2)
        } else {
            orByte(target, f1 & f2)
        }
    }
}

fn sweepDrop(w: *Worker, y: i64, x1: i64, x2: i64, left: i64, right: i64) -> void {
    var e1 = ceiling(w, x1)
    const e2 = floor(w, x2)
    var pxl = e1
    const limit = if w.*.horizontal { w.*.rows } else { w.*.bWidth }
    if e1 > e2 {
        const dropOutControl = field(w, left, P_FLAGS) & 7
        if e1 != e2 + w.*.precision { return }
        if dropOutControl == 0 {
            pxl = e2
        } else if dropOutControl == 4 {
            pxl = smart(w, x1, x2)
        } else if dropOutControl == 1 || dropOutControl == 5 {
            const flags = field(w, left, P_FLAGS)
            if field(w, left, P_NEXT) == right && field(w, left, P_HEIGHT) <= 0 && !((flags & OVERSHOOT_TOP) != 0 && x2 - x1 >= w.*.precisionHalf) { return }
            if field(w, right, P_NEXT) == left && field(w, left, P_START) == y && !((flags & OVERSHOOT_BOTTOM) != 0 && x2 - x1 >= w.*.precisionHalf) { return }
            if dropOutControl == 1 {
                pxl = e2
            } else {
                pxl = smart(w, x1, x2)
            }
        } else {
            return
        }
        if pxl < 0 {
            pxl = e1
        } else if trunc(w, pxl) >= limit {
            pxl = e2
        }
        e1 = if pxl == e1 { e2 } else { e1 }
        e1 = trunc(w, e1)
        if w.*.horizontal {
            const bits = w.*.bOrigin + (y >> 3) - e1 * w.*.pitch
            if e1 >= 0 && e1 < w.*.rows && (byteAt(bits) & (BIT7 >> @intCast(u6, y & 7))) != 0 { return }
        } else {
            const c1 = calc.low16(e1 >> 3)
            const f1 = calc.low16(e1 & 7)
            if e1 >= 0 && e1 < w.*.bWidth && (byteAt(w.*.bLine + c1) & (BIT7 >> @intCast(u6, f1 & 7))) != 0 { return }
        }
    }
    e1 = trunc(w, pxl)
    if e1 >= 0 && e1 < limit {
        if w.*.horizontal {
            orByte(w.*.bOrigin + (y >> 3) - e1 * w.*.pitch, BIT7 >> @intCast(u6, y & 7))
        } else {
            orByte(w.*.bLine + calc.low16(e1 >> 3), BIT7 >> @intCast(u6, e1 & 7))
        }
    }
}

// The sweep of the profiles (FreeType's Draw_Sweep).
fn drawSweep(w: *Worker, lists: usize) -> bool {
    const waiting = lists
    const drawLeft = lists + 8
    const drawRight = lists + 16
    m.putI64(waiting, NONE)
    m.putI64(drawLeft, NONE)
    m.putI64(drawRight, NONE)
    var p = w.*.fProfile
    var maxY = calc.low16(trunc(w, w.*.minY))
    var minY = calc.low16(trunc(w, w.*.maxY))
    while p != NONE {
        const q = field(w, p, P_LINK)
        const bottom = calc.low16(field(w, p, P_START))
        const top = calc.low16(field(w, p, P_START) + field(w, p, P_HEIGHT) - 1)
        if minY > bottom { minY = bottom }
        if maxY < top { maxY = top }
        setField(w, p, P_X, 0)
        insNew(w, waiting, p)
        p = q
    }
    if w.*.numTurns == 0 {
        w.*.err = r.ERR_INVALID_OUTLINE
        return true
    }
    sweepInit(w, minY)
    p = m.getI64(waiting)
    while p != NONE {
        setField(w, p, P_COUNT, calc.low32(field(w, p, P_START) - minY))
        p = field(w, p, P_LINK)
    }
    var y = minY
    var yHeight: i64 = 0
    if w.*.numTurns > 0 && word(w, POOL - w.*.numTurns) == minY { w.*.numTurns -= 1 }
    while w.*.numTurns > 0 {
        p = m.getI64(waiting)
        while p != NONE {
            const q = field(w, p, P_LINK)
            setField(w, p, P_COUNT, calc.low32(field(w, p, P_COUNT) - yHeight))
            if field(w, p, P_COUNT) == 0 {
                delOld(w, waiting, p)
                if (field(w, p, P_FLAGS) & FLOW_UP) != 0 {
                    insNew(w, drawLeft, p)
                } else {
                    insNew(w, drawRight, p)
                }
            }
            p = q
        }
        sortList(w, drawLeft)
        sortList(w, drawRight)
        const yChange = calc.low16(word(w, POOL - w.*.numTurns))
        w.*.numTurns -= 1
        yHeight = calc.low16(yChange - y)
        while y < yChange {
            var dropouts: i64 = 0
            var left = m.getI64(drawLeft)
            var right = m.getI64(drawRight)
            while left != NONE && right != NONE {
                var x1 = field(w, left, P_X)
                var x2 = field(w, right, P_X)
                if x1 > x2 {
                    const xs = x1
                    x1 = x2
                    x2 = xs
                }
                const e1 = floor(w, x1)
                const e2 = ceiling(w, x2)
                var skip = false
                if x2 - x1 <= w.*.precision && e1 != x1 && e2 != x2 {
                    if e1 > e2 || e2 == e1 + w.*.precision {
                        const dropOutControl = field(w, left, P_FLAGS) & 7
                        if dropOutControl != 2 {
                            setField(w, left, P_X, x1)
                            setField(w, right, P_X, x2)
                            setField(w, left, P_COUNT, 1)
                            dropouts += 1
                        }
                        skip = true
                    }
                }
                if !skip { sweepSpan(w, y, x1, x2, left) }
                left = field(w, left, P_LINK)
                right = field(w, right, P_LINK)
            }
            if dropouts > 0 {
                // (The drop-outs of the line.)
                left = m.getI64(drawLeft)
                right = m.getI64(drawRight)
                while left != NONE && right != NONE {
                    if field(w, left, P_COUNT) != 0 {
                        setField(w, left, P_COUNT, 0)
                        sweepDrop(w, y, field(w, left, P_X), field(w, right, P_X), left, right)
                    }
                    left = field(w, left, P_LINK)
                    right = field(w, right, P_LINK)
                }
            }
            sweepStep(w)
            y = calc.low16(y + 1)
            if y < yChange {
                sortList(w, drawLeft)
                sortList(w, drawRight)
            }
        }
        p = m.getI64(drawLeft)
        while p != NONE {
            const q = field(w, p, P_LINK)
            if field(w, p, P_HEIGHT) == 0 { delOld(w, drawLeft, p) }
            p = q
        }
        p = m.getI64(drawRight)
        while p != NONE {
            const q = field(w, p, P_LINK)
            if field(w, p, P_HEIGHT) == 0 { delOld(w, drawRight, p) }
            p = q
        }
    }
    while y <= maxY {
        sweepStep(w)
        y = calc.low16(y + 1)
    }
    return false
}

// Renders in bands, a band whose profiles overflow the pool split in
// two (FreeType's Render_Single_Pass).
fn renderSinglePass(w: *Worker, flipped: bool, yMin_: i64, yMax_: i64, lists: usize) -> i32 {
    var yMin = yMin_
    var yMax = yMax_
    var stack: [64]i64 = undefined
    var bandTop: i64 = 0
    while true {
        w.*.minY = yMin * w.*.precision
        w.*.maxY = yMax * w.*.precision
        w.*.top = 0
        w.*.err = r.OK
        if convertGlyph(w, flipped) {
            if w.*.err != r.ERR_RASTER_OVERFLOW { return w.*.err }
            if yMin == yMax || bandTop >= 63 { return w.*.err }
            const yMid = (yMin + yMax) >> 1
            stack[@intCast(usize, bandTop)] = yMin
            bandTop += 1
            yMin = yMid + 1
        } else {
            if w.*.fProfile != NONE {
                if drawSweep(w, lists) { return w.*.err }
            }
            bandTop -= 1
            if bandTop < 0 { break }
            yMax = yMin - 1
            yMin = stack[@intCast(usize, bandTop)]
        }
    }
    return r.OK
}

// The rasterizer on an outline and a monochrome bitmap (FreeType's
// ft_black_render with FT_RASTER_FLAG_DEFAULT).
pub fn render(memory: usize, outline: usize, bitmap: usize) -> i32 {
    if outline == 0 { return r.ERR_INVALID_OUTLINE }
    const o_ = r.outline(outline)
    if o_.*.n_points == 0 || o_.*.n_contours <= 0 { return r.OK }
    if o_.*.contours == 0 || o_.*.points == 0 { return r.ERR_INVALID_OUTLINE }
    if @intCast(i64, o_.*.n_points) != @intCast(i64, m.getI16(o_.*.contours + @intCast(usize, o_.*.n_contours - 1) * 2)) + 1 { return r.ERR_INVALID_OUTLINE }
    if bitmap == 0 { return r.ERR_INVALID_ARGUMENT }
    const b = r.bitmap(bitmap)
    if b.*.width == 0 || b.*.rows == 0 { return r.OK }
    if b.*.buffer == 0 { return r.ERR_INVALID_ARGUMENT }
    // The worker, the pool, the arcs and the three lists' heads.
    const block = m.cAlloc(@sizeOf(Worker) + @intCast(usize, POOL) * 8 + @intCast(usize, MAX_BEZIER * 3 + 4) * 16 + 32)
    if block == 0 { return r.ERR_OUT_OF_MEMORY }
    const w = worker(block)
    w.*.buff = block + @sizeOf(Worker)
    w.*.arcs = w.*.buff + @intCast(usize, POOL) * 8
    const lists = w.*.arcs + @intCast(usize, MAX_BEZIER * 3 + 4) * 16
    w.*.outline = outline
    w.*.rows = @intCast(i64, b.*.rows)
    w.*.width = @intCast(i64, b.*.width)
    w.*.pitch = @intCast(i64, b.*.pitch)
    w.*.buffer = b.*.buffer
    const flags = @intCast(i64, o_.*.flags)
    setHighPrecision(w, (flags & @intCast(i64, r.OUTLINE_HIGH_PRECISION)) != 0)
    if (flags & @intCast(i64, r.OUTLINE_IGNORE_DROPOUTS)) != 0 {
        w.*.dropOutControl = 2
    } else {
        w.*.dropOutControl = if (flags & @intCast(i64, r.OUTLINE_SMART_DROPOUTS)) != 0 { 4 } else { 0 }
        if (flags & @intCast(i64, r.OUTLINE_INCLUDE_STUBS)) == 0 { w.*.dropOutControl += 1 }
    }
    w.*.horizontal = false
    w.*.bWidth = w.*.width & 0xFFFF
    w.*.bOrigin = @bitCast(i64, b.*.buffer)
    if w.*.pitch > 0 { w.*.bOrigin += (w.*.rows - 1) * w.*.pitch }
    var err = renderSinglePass(w, false, 0, w.*.rows - 1, lists)
    if err == r.OK && (flags & @intCast(i64, r.OUTLINE_SINGLE_PASS)) == 0 {
        w.*.horizontal = true
        err = renderSinglePass(w, true, 0, w.*.width - 1, lists)
    }
    m.cFree(block)
    return err
}
