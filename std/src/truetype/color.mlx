// Color fonts as FreeType's SFNT driver reads them (its ttcpal.c and
// ttcolr.c, with the public functions of ftcolor.c and ftobjs.c): the
// palettes of `CPAL`, the layers of `COLR` version 0 and their blending
// into a BGRA bitmap, and the paints of `COLR` version 1 (gradients,
// transforms, compositions, varied by the font's coordinates), which a
// program walks and draws itself.
//
// As in FreeType, the paints and iterators handed out point into the
// font's bytes.
const m = @import("./memory.mlx")
const r = @import("./records.mlx")
const o = @import("./objects.mlx")
const calc = @import("./calc.mlx")
const variations = @import("./variations.mlx")

const BASE_GLYPH_SIZE: u64 = 6
const BASE_GLYPH_PAINT_RECORD_SIZE: u64 = 6
const LAYER_V1_LIST_PAINT_OFFSET_SIZE: u64 = 4
const LAYER_V1_LIST_NUM_LAYERS_SIZE: u64 = 4
const COLOR_STOP_SIZE: u64 = 6
const VAR_IDX_BASE_SIZE: u64 = 4
const LAYER_SIZE: u64 = 4
const COLRV0_HEADER_SIZE: u64 = 14
const COLRV1_HEADER_SIZE: u64 = 34
const CPAL_V0_HEADER_BASE_SIZE: u64 = 12

// The paint formats, the public ones and those FreeType reads as them.
const PAINT_COLR_LAYERS: i64 = 1
const PAINT_SOLID: i64 = 2
const PAINT_VAR_SOLID: i64 = 3
const PAINT_LINEAR_GRADIENT: i64 = 4
const PAINT_VAR_LINEAR_GRADIENT: i64 = 5
const PAINT_RADIAL_GRADIENT: i64 = 6
const PAINT_VAR_RADIAL_GRADIENT: i64 = 7
const PAINT_SWEEP_GRADIENT: i64 = 8
const PAINT_VAR_SWEEP_GRADIENT: i64 = 9
const PAINT_GLYPH: i64 = 10
const PAINT_COLR_GLYPH: i64 = 11
const PAINT_TRANSFORM: i64 = 12
const PAINT_VAR_TRANSFORM: i64 = 13
const PAINT_TRANSLATE: i64 = 14
const PAINT_VAR_TRANSLATE: i64 = 15
const PAINT_SCALE: i64 = 16
const PAINT_VAR_SCALE: i64 = 17
const PAINT_SCALE_CENTER: i64 = 18
const PAINT_VAR_SCALE_CENTER: i64 = 19
const PAINT_SCALE_UNIFORM: i64 = 20
const PAINT_VAR_SCALE_UNIFORM: i64 = 21
const PAINT_SCALE_UNIFORM_CENTER: i64 = 22
const PAINT_VAR_SCALE_UNIFORM_CENTER: i64 = 23
const PAINT_ROTATE: i64 = 24
const PAINT_VAR_ROTATE: i64 = 25
const PAINT_ROTATE_CENTER: i64 = 26
const PAINT_VAR_ROTATE_CENTER: i64 = 27
const PAINT_SKEW: i64 = 28
const PAINT_VAR_SKEW: i64 = 29
const PAINT_SKEW_CENTER: i64 = 30
const PAINT_VAR_SKEW_CENTER: i64 = 31
const PAINT_COMPOSITE: i64 = 32
const PAINT_FORMAT_MAX: i64 = 33
const COMPOSITE_MAX: i64 = 28
const PAINT_EXTEND_REFLECT: i64 = 2
const PALETTE_FOR_DARK_BACKGROUND: u64 = 2

// FT_Palette_Data: the palettes, their names and flags, the entries and
// their names.
const PALETTE_DATA_SIZE: usize = 40

// The state of the tables (CPAL's colors and COLR's lists as addresses in
// the font's bytes).
const Color = struct {
    hasCpal: bool
    numColors: u64
    colorIndices: usize
    colors: usize
    hasColr: bool
    version: i64
    numBaseGlyphs: u64
    numLayers: u64
    baseGlyphs: usize
    layers: usize
    numBaseGlyphsV1: u64
    baseGlyphsV1: usize
    numLayersV1: u64
    layersV1: usize
    clipList: usize
    paintsStartV1: usize
    table: usize
    tableSize: u64
    varStore: usize
    varMap: usize
}

fn stateOf(f: *o.Face) -> *Color { unsafe { return @ptrFromInt(*Color, f.*.color) } }

// Big-endian values at an address.
fn u8at(p: usize) -> i64 { return @intCast(i64, m.get8(p)) }
fn u16at(p: usize) -> i64 { return @intCast(i64, m.u16be(p)) }
fn s16at(p: usize) -> i64 { return @intCast(i64, m.i16be(p)) }
fn u24at(p: usize) -> i64 { return @intCast(i64, m.u24be(p)) }
fn u32at(p: usize) -> i64 { return @intCast(i64, m.u32be(p)) }
fn s32at(p: usize) -> i64 { return @intCast(i64, m.i32be(p)) }

fn intToFixed(x: i64) -> i64 { return x *% 65536 }
fn f2dot14ToFixed(x: i64) -> i64 { return x *% 4 }

// The palette data of the face (made when first needed).
fn paletteData(f: *o.Face) -> usize {
    if f.*.paletteData == 0 { f.*.paletteData = m.alloc(f.*.memory, PALETTE_DATA_SIZE) }
    return f.*.paletteData
}

fn numPalettes(f: *o.Face) -> u64 {
    if f.*.paletteData == 0 { return 0 }
    return @intCast(u64, m.get16(f.*.paletteData))
}

fn numPaletteEntries(f: *o.Face) -> u64 {
    if f.*.paletteData == 0 { return 0 }
    return @intCast(u64, m.get16(f.*.paletteData + 24))
}

// ---------------------------------------------------------------------------
// `CPAL` (FreeType's tt_face_load_cpal and tt_face_palette_set).

fn loadCpal(f: *o.Face, c: *Color) -> i32 {
    const t = o.table(f, o.tag(67, 80, 65, 76))
    if t.1 == 0 { return r.ERR_TABLE_MISSING }
    const tableSize = t.1
    if tableSize < CPAL_V0_HEADER_BASE_SIZE { return r.ERR_INVALID_TABLE }
    if !o.within(f, t.0, tableSize) { return r.ERR_INVALID_STREAM_OPERATION }
    const memory = f.*.memory
    const table = f.*.data + t.0
    const data = paletteData(f)
    if data == 0 { return r.ERR_OUT_OF_MEMORY }
    const version = u16at(table)
    if version > 1 { return r.ERR_INVALID_TABLE }
    const entries = @intCast(u64, u16at(table + 2))
    const palettes = @intCast(u64, u16at(table + 4))
    m.put16(data + 24, @intCast(u16, entries))
    m.put16(data, @intCast(u16, palettes))
    const numColors = @intCast(u64, u16at(table + 6))
    const colorsOffset = @intCast(u64, u32at(table + 8))
    if CPAL_V0_HEADER_BASE_SIZE + palettes * 2 > tableSize { return r.ERR_INVALID_TABLE }
    if colorsOffset >= tableSize { return r.ERR_INVALID_TABLE }
    if numColors * 4 > tableSize - colorsOffset { return r.ERR_INVALID_TABLE }
    if entries > numColors { return r.ERR_INVALID_TABLE }
    c.*.numColors = numColors
    c.*.colorIndices = table + 12
    c.*.colors = table + @intCast(usize, colorsOffset)
    if version == 1 {
        if CPAL_V0_HEADER_BASE_SIZE + palettes * 2 + 12 > tableSize { return r.ERR_INVALID_TABLE }
        const p = table + 12 + @intCast(usize, palettes) * 2
        const typeOffset = @intCast(u64, u32at(p))
        const labelOffset = @intCast(u64, u32at(p + 4))
        const entryLabelOffset = @intCast(u64, u32at(p + 8))
        if typeOffset != 0 {
            if typeOffset >= tableSize || palettes * 2 > tableSize - typeOffset { return r.ERR_INVALID_TABLE }
            const array = readUShorts(memory, table + @intCast(usize, typeOffset), palettes)
            if array == 0 && palettes != 0 { return r.ERR_OUT_OF_MEMORY }
            m.putWord(data + 16, array)
        }
        if labelOffset != 0 {
            if labelOffset >= tableSize || palettes * 2 > tableSize - labelOffset { return r.ERR_INVALID_TABLE }
            const array = readUShorts(memory, table + @intCast(usize, labelOffset), palettes)
            if array == 0 && palettes != 0 { return r.ERR_OUT_OF_MEMORY }
            m.putWord(data + 8, array)
        }
        if entryLabelOffset != 0 {
            if entryLabelOffset >= tableSize || entries * 2 > tableSize - entryLabelOffset { return r.ERR_INVALID_TABLE }
            const array = readUShorts(memory, table + @intCast(usize, entryLabelOffset), entries)
            if array == 0 && entries != 0 { return r.ERR_OUT_OF_MEMORY }
            m.putWord(data + 32, array)
        }
    }
    c.*.hasCpal = true
    f.*.cpalOffset = t.0
    f.*.cpalSize = tableSize
    if entries != 0 {
        f.*.palette = m.alloc(memory, @intCast(usize, entries) * 4)
        if f.*.palette == 0 {
            c.*.hasCpal = false
            return r.ERR_OUT_OF_MEMORY
        }
    }
    if setPalette(f, 0) != r.OK {
        c.*.hasCpal = false
        return r.ERR_INVALID_TABLE
    }
    return r.OK
}

// `count` 16-bit values (native order) read from `p`.
fn readUShorts(memory: usize, p: usize, count: u64) -> usize {
    if count == 0 { return 0 }
    const array = m.alloc(memory, @intCast(usize, count) * 2)
    if array == 0 { return 0 }
    var i: u64 = 0
    while i < count {
        m.put16(array + @intCast(usize, i) * 2, @intCast(u16, u16at(p + @intCast(usize, i) * 2)))
        i += 1
    }
    return array
}

fn setPalette(f: *o.Face, index: u64) -> i32 {
    if f.*.color == 0 { return r.ERR_INVALID_ARGUMENT }
    const c = stateOf(f)
    if !c.*.hasCpal || index >= numPalettes(f) { return r.ERR_INVALID_ARGUMENT }
    const colorIndex = @intCast(u64, u16at(c.*.colorIndices + @intCast(usize, index) * 2))
    const entries = numPaletteEntries(f)
    if colorIndex + entries > c.*.numColors { return r.ERR_INVALID_TABLE }
    var p = c.*.colors + @intCast(usize, colorIndex) * 4
    var i: u64 = 0
    while i < entries {
        // (FT_Color is blue, green, red, alpha, as the table is.)
        m.put32(f.*.palette + @intCast(usize, i) * 4, m.get32(p))
        p += 4
        i += 1
    }
    return r.OK
}

// ---------------------------------------------------------------------------
// `COLR` (FreeType's tt_face_load_colr).

fn loadColr(face: usize, f: *o.Face, c: *Color) -> i32 {
    if !c.*.hasCpal { return r.ERR_INVALID_FILE_FORMAT }
    const t = o.table(f, o.tag(67, 79, 76, 82))
    if t.1 == 0 { return r.ERR_TABLE_MISSING }
    const tableSize = t.1
    if tableSize < COLRV0_HEADER_SIZE { return r.OK }
    if !o.within(f, t.0, tableSize) { return r.ERR_INVALID_STREAM_OPERATION }
    const table = f.*.data + t.0
    const version = u16at(table)
    if version != 0 && version != 1 { return r.ERR_INVALID_TABLE }
    c.*.version = version
    c.*.numBaseGlyphs = @intCast(u64, u16at(table + 2))
    const baseGlyphOffset = @intCast(u64, u32at(table + 4))
    if baseGlyphOffset >= tableSize { return r.ERR_INVALID_TABLE }
    if c.*.numBaseGlyphs * BASE_GLYPH_SIZE > tableSize - baseGlyphOffset { return r.ERR_INVALID_TABLE }
    const layerOffset = @intCast(u64, u32at(table + 8))
    c.*.numLayers = @intCast(u64, u16at(table + 12))
    if layerOffset >= tableSize { return r.ERR_INVALID_TABLE }
    if c.*.numLayers * LAYER_SIZE > tableSize - layerOffset { return r.ERR_INVALID_TABLE }
    if version == 1 {
        if tableSize < COLRV1_HEADER_SIZE { return r.ERR_INVALID_TABLE }
        const baseGlyphsOffsetV1 = @intCast(u64, u32at(table + 14))
        if baseGlyphsOffsetV1 >= tableSize - 4 { return r.ERR_INVALID_TABLE }
        const p1 = table + @intCast(usize, baseGlyphsOffsetV1)
        const numBaseGlyphsV1 = @intCast(u64, u32at(p1))
        if numBaseGlyphsV1 * BASE_GLYPH_PAINT_RECORD_SIZE > tableSize - baseGlyphsOffsetV1 { return r.ERR_INVALID_TABLE }
        c.*.numBaseGlyphsV1 = numBaseGlyphsV1
        c.*.baseGlyphsV1 = p1
        const layerOffsetV1 = @intCast(u64, u32at(table + 18))
        if layerOffsetV1 >= tableSize { return r.ERR_INVALID_TABLE }
        if layerOffsetV1 != 0 {
            if layerOffsetV1 >= tableSize - 4 { return r.ERR_INVALID_TABLE }
            const p2 = table + @intCast(usize, layerOffsetV1)
            const numLayersV1 = @intCast(u64, u32at(p2))
            if numLayersV1 * LAYER_V1_LIST_PAINT_OFFSET_SIZE > tableSize - layerOffsetV1 { return r.ERR_INVALID_TABLE }
            c.*.numLayersV1 = numLayersV1
            c.*.layersV1 = p2
            const a = c.*.baseGlyphsV1 + @intCast(usize, c.*.numBaseGlyphsV1 * BASE_GLYPH_PAINT_RECORD_SIZE)
            const b = c.*.layersV1 + @intCast(usize, c.*.numLayersV1 * LAYER_V1_LIST_PAINT_OFFSET_SIZE)
            c.*.paintsStartV1 = if a < b { a } else { b }
        } else {
            c.*.numLayersV1 = 0
            c.*.layersV1 = 0
            c.*.paintsStartV1 = c.*.baseGlyphsV1 + @intCast(usize, c.*.numBaseGlyphsV1 * BASE_GLYPH_PAINT_RECORD_SIZE)
        }
        const clipListOffset = @intCast(u64, u32at(table + 22))
        if clipListOffset >= tableSize { return r.ERR_INVALID_TABLE }
        c.*.clipList = if clipListOffset != 0 { table + @intCast(usize, clipListOffset) } else { 0 }
        if f.*.hasFvar {
            const varIdxMapOffset = @intCast(u64, u32at(table + 26))
            if varIdxMapOffset >= tableSize { return r.ERR_INVALID_TABLE }
            const varStoreOffset = @intCast(u64, u32at(table + 30))
            if varStoreOffset >= tableSize { return r.ERR_INVALID_TABLE }
            if varStoreOffset != 0 {
                const loaded = variations.newStore(face, t.0 + varStoreOffset)
                c.*.varStore = loaded.1
                if loaded.0 != r.OK { return r.ERR_INVALID_TABLE }
            }
            if variations.storeAxisCount(c.*.varStore) != 0 && varIdxMapOffset != 0 {
                const loaded = variations.newIdxMap(face, t.0 + varIdxMapOffset, c.*.varStore, tableSize)
                c.*.varMap = loaded.1
                if loaded.0 != r.OK { return r.ERR_INVALID_TABLE }
            }
        }
    }
    c.*.baseGlyphs = table + @intCast(usize, baseGlyphOffset)
    c.*.layers = table + @intCast(usize, layerOffset)
    c.*.table = table
    c.*.tableSize = tableSize
    c.*.hasColr = true
    f.*.colrOffset = t.0
    f.*.colrSize = tableSize
    return r.OK
}

// The face's palettes and color layers (FreeType loads `CPAL`, then
// `COLR`, ignoring their errors).
pub fn load(face: usize) -> void {
    const f = o.faceRecord(face)
    f.*.color = m.alloc(f.*.memory, @sizeOf(Color))
    if f.*.color == 0 { return }
    const c = stateOf(f)
    _ = loadCpal(f, c)
    if loadColr(face, f, c) != r.OK {
        variations.freeStore(face, c.*.varStore, c.*.varMap)
        c.*.varStore = 0
        c.*.varMap = 0
        c.*.hasColr = false
    }
}

pub fn done(face: usize) -> void {
    const f = o.faceRecord(face)
    const memory = f.*.memory
    if f.*.color != 0 {
        const c = stateOf(f)
        variations.freeStore(face, c.*.varStore, c.*.varMap)
        m.release(memory, f.*.color)
        f.*.color = 0
    }
    if f.*.paletteData != 0 {
        m.release(memory, m.getWord(f.*.paletteData + 8))
        m.release(memory, m.getWord(f.*.paletteData + 16))
        m.release(memory, m.getWord(f.*.paletteData + 32))
        m.release(memory, f.*.paletteData)
        f.*.paletteData = 0
    }
    m.release(memory, f.*.palette)
    f.*.palette = 0
}

fn colrOf(face: usize) -> usize {
    const f = o.faceRecord(face)
    if f.*.color == 0 || !stateOf(f).*.hasColr { return 0 }
    return f.*.color
}

// ---------------------------------------------------------------------------
// Version 0: the layers of a base glyph (FreeType's
// tt_face_get_colr_layer), with FT_LayerIterator at `iterator`
// (num_layers, layer, p).

fn findBaseGlyph(c: *Color, glyph: u64) -> (bool, u64, u64) {
    var lo: u64 = 0
    var hi = c.*.numBaseGlyphs
    while lo < hi {
        const mid = lo + (hi - lo) / 2
        const p = c.*.baseGlyphs + @intCast(usize, mid * BASE_GLYPH_SIZE)
        const gid = @intCast(u64, u16at(p))
        if gid < glyph {
            lo = mid + 1
        } else if gid > glyph {
            hi = mid
        } else {
            return -> (true, @intCast(u64, u16at(p + 2)), @intCast(u64, u16at(p + 4)))
        }
    }
    return -> (false, 0, 0)
}

pub fn colrLayer(face: usize, baseGlyph: u64, aglyph: usize, acolor: usize, iterator: usize) -> bool {
    const cs = colrOf(face)
    if cs == 0 { return false }
    const f = o.faceRecord(face)
    const c = stateOf(f)
    if m.getWord(iterator + 8) == 0 {
        m.put32(iterator + 4, 0)
        const record = findBaseGlyph(c, baseGlyph)
        if !record.0 { return false }
        if record.2 == 0 { return false }
        m.put32(iterator, @intCast(u32, record.2))
        const offset = LAYER_SIZE * record.1
        if offset + LAYER_SIZE * record.2 > c.*.tableSize { return false }
        m.putWord(iterator + 8, c.*.layers + @intCast(usize, offset))
    }
    const p = m.getWord(iterator + 8)
    if m.get32(iterator + 4) >= m.get32(iterator) || p < c.*.layers || p >= c.*.table + @intCast(usize, c.*.tableSize) { return false }
    const glyph = u16at(p)
    const colorIndex = u16at(p + 2)
    m.put32(aglyph, @intCast(u32, glyph))
    m.put32(acolor, @intCast(u32, colorIndex))
    m.putWord(iterator + 8, p + 4)
    if glyph >= o.faceRecord(face).*.numGlyphs || (colorIndex != 0xFFFF && @intCast(u64, colorIndex) >= numPaletteEntries(f)) { return false }
    m.put32(iterator + 4, m.get32(iterator + 4) + 1)
    return true
}

// A layer rendered in `src` blended in its color into the BGRA bitmap of
// `dst` (FreeType's tt_face_colr_blend_layer).
pub fn blendLayer(face: usize, colorIndex: u64, dst: usize, src: usize) -> i32 {
    const f = o.faceRecord(face)
    const memory = f.*.memory
    const d = o.slotRecord(dst)
    const s = o.slotRecord(src)
    if d.*.bitmap.buffer == 0 {
        d.*.bitmapLeft = s.*.bitmapLeft
        d.*.bitmapTop = s.*.bitmapTop
        d.*.bitmap.width = s.*.bitmap.width
        d.*.bitmap.rows = s.*.bitmap.rows
        d.*.bitmap.pixelMode = r.PIXEL_BGRA
        d.*.bitmap.pitch = @intCast(i32, d.*.bitmap.width) * 4
        d.*.bitmap.numGrays = 256
        const size = @intCast(usize, d.*.bitmap.rows) * @intCast(usize, d.*.bitmap.pitch)
        const internal = o.slotRecord(dst)
        if internal.*.ownBitmap { m.release(memory, d.*.bitmap.buffer) }
        internal.*.ownBitmap = true
        d.*.bitmap.buffer = m.alloc(memory, size)
        if d.*.bitmap.buffer == 0 && size != 0 { return r.ERR_OUT_OF_MEMORY }
    } else {
        const dl = @intCast(i64, d.*.bitmapLeft)
        const dt = @intCast(i64, d.*.bitmapTop)
        const dw = @intCast(i64, d.*.bitmap.width)
        const dr = @intCast(i64, d.*.bitmap.rows)
        const sl = @intCast(i64, s.*.bitmapLeft)
        const st = @intCast(i64, s.*.bitmapTop)
        const xMin = calc.min(dl, sl)
        const xMax = calc.max(dl + dw, sl + @intCast(i64, s.*.bitmap.width))
        const yMin = calc.min(dt - dr, st - @intCast(i64, s.*.bitmap.rows))
        const yMax = calc.max(dt, st)
        if xMin != dl || xMax != dl + dw || yMin != dt - dr || yMax != dt {
            const width = xMax - xMin
            const rows = yMax - yMin
            const pitch = width * 4
            const size = @intCast(usize, rows * pitch)
            const buf = m.alloc(memory, size)
            if buf == 0 && size != 0 { return r.ERR_OUT_OF_MEMORY }
            var p = d.*.bitmap.buffer
            var q = buf + @intCast(usize, pitch * (yMax - dt) + 4 * (dl - xMin))
            var y: i64 = 0
            while y < dr {
                m.copy(q, p, @intCast(usize, dw) * 4)
                p += @intCast(usize, @intCast(i64, d.*.bitmap.pitch))
                q += @intCast(usize, pitch)
                y += 1
            }
            const internal = o.slotRecord(dst)
            if internal.*.ownBitmap { m.release(memory, d.*.bitmap.buffer) }
            d.*.bitmap.buffer = buf
            d.*.bitmapTop = @intCast(i32, yMax)
            d.*.bitmapLeft = @intCast(i32, xMin)
            d.*.bitmap.width = @intCast(u32, width)
            d.*.bitmap.rows = @intCast(u32, rows)
            d.*.bitmap.pitch = @intCast(i32, pitch)
            internal.*.ownBitmap = true
            d.*.format = r.FORMAT_BITMAP
        }
    }
    var b: i64 = 0
    var g: i64 = 0
    var rd: i64 = 0
    var alpha: i64 = 0xFF
    if colorIndex == 0xFFFF {
        if f.*.hasForeground {
            const fg = f.*.foreground
            b = @intCast(i64, fg & 0xFF)
            g = @intCast(i64, (fg >> 8) & 0xFF)
            rd = @intCast(i64, (fg >> 16) & 0xFF)
            alpha = @intCast(i64, (fg >> 24) & 0xFF)
        } else {
            const flags = if f.*.paletteData != 0 { m.getWord(f.*.paletteData + 16) } else { 0 }
            if flags != 0 && (@intCast(u64, m.get16(flags + @intCast(usize, f.*.paletteIndex) * 2)) & PALETTE_FOR_DARK_BACKGROUND) != 0 {
                b = 0xFF
                g = 0xFF
                rd = 0xFF
            }
        }
    } else {
        const e = f.*.palette + @intCast(usize, colorIndex) * 4
        b = u8at(e)
        g = u8at(e + 1)
        rd = u8at(e + 2)
        alpha = u8at(e + 3)
    }
    var srcRow = s.*.bitmap.buffer
    var dstRow = d.*.bitmap.buffer + @intCast(usize, @intCast(i64, d.*.bitmap.pitch) * (@intCast(i64, d.*.bitmapTop) - @intCast(i64, s.*.bitmapTop)) + 4 * (@intCast(i64, s.*.bitmapLeft) - @intCast(i64, d.*.bitmapLeft)))
    var y: u32 = 0
    while y < s.*.bitmap.rows {
        var x: usize = 0
        while x < @intCast(usize, s.*.bitmap.width) {
            const aa = u8at(srcRow + x)
            const fa = alpha * aa / 255
            const fb = b * fa / 255
            const fgr = g * fa / 255
            const fr = rd * fa / 255
            const ba2 = 255 - fa
            const px = dstRow + 4 * x
            m.put8(px, @intCast(u8, (u8at(px) * ba2 / 255 + fb) & 0xFF))
            m.put8(px + 1, @intCast(u8, (u8at(px + 1) * ba2 / 255 + fgr) & 0xFF))
            m.put8(px + 2, @intCast(u8, (u8at(px + 2) * ba2 / 255 + fr) & 0xFF))
            m.put8(px + 3, @intCast(u8, (u8at(px + 3) * ba2 / 255 + fa) & 0xFF))
            x += 1
        }
        srcRow += @intCast(usize, @intCast(i64, s.*.bitmap.pitch))
        dstRow += @intCast(usize, @intCast(i64, d.*.bitmap.pitch))
        y += 1
    }
    return r.OK
}

// ---------------------------------------------------------------------------
// Version 1: paints (FreeType's read_paint and the functions around it).

fn tableEnd(c: *Color) -> usize { return c.*.table + @intCast(usize, c.*.tableSize) }

// Whether `n` bytes at `p` are in the paints.
fn readable(c: *Color, p: usize, n: u64) -> bool {
    return p >= c.*.paintsStartV1 && p <= tableEnd(c) - @intCast(usize, n)
}

// FT_ColorLine at `out`: its extend and its color stop iterator.
fn readColorLine(c: *Color, p: usize, out: usize, readVariable: bool) -> bool {
    if !readable(c, p, 3) { return false }
    const extend = u8at(p)
    if extend > PAINT_EXTEND_REFLECT { return false }
    m.putI32(out, @intCast(i32, extend))
    m.put32(out + 8, @intCast(u32, u16at(p + 1)))
    m.put32(out + 12, 0)
    m.putWord(out + 16, p + 3)
    m.put8(out + 24, if readVariable { 1 } else { 0 })
    return true
}

// The paint at the 24-bit offset at `*at` from `base`; 0 for none.
fn childTable(c: *Color, base: usize, at: usize) -> usize {
    if at < c.*.paintsStartV1 || at > tableEnd(c) - 4 { return 0 }
    const offset = @intCast(usize, u24at(at))
    if offset == 0 { return 0 }
    const child = base + offset
    if child < c.*.paintsStartV1 || child >= tableEnd(c) { return 0 }
    return child
}

// The deltas of `count` variation indices from `base` (32-bit each, at
// `deltas`).
fn deltas(face: usize, c: *Color, base: u64, count: u64, out: usize) -> void {
    var i: u64 = 0
    while i < count {
        var d: i64 = 0
        if base != 0xFFFFFFFF { d = variations.storeDelta(face, c.*.varStore, c.*.varMap, base + i) }
        m.putI64(out + @intCast(usize, i) * 8, d)
        i += 1
    }
}

fn setPaintRef(at: usize, p: usize) -> void {
    m.putWord(at, p)
    m.put8(at + 8, 0)
}

fn addFixed(at: usize, delta: i64) -> void { m.putI64(at, m.getI64(at) +% delta) }

fn readPaint(face: usize, c: *Color, start: usize, paint: usize) -> bool {
    if start == 0 || c.*.table == 0 { return false }
    if start < c.*.paintsStartV1 || start > tableEnd(c) - 2 { return false }
    var buffer: [6]i64 = undefined
    const d = @intFromPtr(&buffer)
    const base = start
    var p = start
    const format = u8at(p)
    p += 1
    m.putI32(paint, @intCast(i32, format))
    if format >= PAINT_FORMAT_MAX { return false }
    const u = paint + 8
    if format == PAINT_COLR_LAYERS {
        const numLayers = @intCast(u64, u8at(p))
        if numLayers > c.*.numLayersV1 { return false }
        const first = @intCast(u64, u32at(p + 1))
        if first + numLayers > c.*.numLayersV1 { return false }
        m.put32(u, @intCast(u32, numLayers))
        m.put32(u + 4, 0)
        m.putWord(u + 8, c.*.layersV1 + @intCast(usize, LAYER_V1_LIST_NUM_LAYERS_SIZE + LAYER_V1_LIST_PAINT_OFFSET_SIZE * first))
        return true
    }
    if format == PAINT_SOLID || format == PAINT_VAR_SOLID {
        if !readable(c, p, 4) { return false }
        m.put16(u, @intCast(u16, u16at(p)))
        var alpha = s16at(p + 2)
        p += 4
        if format == PAINT_VAR_SOLID {
            if !readable(c, p, 4) { return false }
            deltas(face, c, @intCast(u64, u32at(p)), 1, d)
            alpha = calc.low16(alpha + calc.low16(buffer[0]))
        }
        m.putI16(u + 2, @intCast(i16, alpha))
        m.putI32(paint, @intCast(i32, PAINT_SOLID))
        return true
    }
    if format == PAINT_COLR_GLYPH {
        if !readable(c, p, 2) { return false }
        m.put32(u, @intCast(u32, u16at(p)))
        return true
    }
    const child = childTable(c, base, p)
    if child == 0 { return false }
    p += 3
    if format == PAINT_LINEAR_GRADIENT || format == PAINT_VAR_LINEAR_GRADIENT {
        const variable = format == PAINT_VAR_LINEAR_GRADIENT
        if !readColorLine(c, child, u, variable) { return false }
        if !readable(c, p, 12) { return false }
        var i: usize = 0
        while i < 6 {
            m.putI64(u + 32 + i * 8, intToFixed(s16at(p + i * 2)))
            i += 1
        }
        p += 12
        if variable {
            if !readable(c, p, 4) { return false }
            deltas(face, c, @intCast(u64, u32at(p)), 6, d)
            i = 0
            while i < 6 {
                addFixed(u + 32 + i * 8, intToFixed(buffer[i]))
                i += 1
            }
        }
        m.putI32(paint, @intCast(i32, PAINT_LINEAR_GRADIENT))
        return true
    }
    if format == PAINT_RADIAL_GRADIENT || format == PAINT_VAR_RADIAL_GRADIENT {
        const variable = format == PAINT_VAR_RADIAL_GRADIENT
        if !readColorLine(c, child, u, variable) { return false }
        if !readable(c, p, 12) { return false }
        m.putI64(u + 32, intToFixed(s16at(p)))
        m.putI64(u + 40, intToFixed(s16at(p + 2)))
        const r0 = intToFixed(s16at(p + 4))
        m.putI64(u + 48, if r0 < 0 { 0x7FFFFFFF } else { r0 })
        m.putI64(u + 56, intToFixed(s16at(p + 6)))
        m.putI64(u + 64, intToFixed(s16at(p + 8)))
        const r1 = intToFixed(s16at(p + 10))
        m.putI64(u + 72, if r1 < 0 { 0x7FFFFFFF } else { r1 })
        p += 12
        if variable {
            if !readable(c, p, 4) { return false }
            deltas(face, c, @intCast(u64, u32at(p)), 6, d)
            var i: usize = 0
            while i < 6 {
                addFixed(u + 32 + i * 8, intToFixed(buffer[i]))
                i += 1
            }
        }
        m.putI32(paint, @intCast(i32, PAINT_RADIAL_GRADIENT))
        return true
    }
    if format == PAINT_SWEEP_GRADIENT || format == PAINT_VAR_SWEEP_GRADIENT {
        const variable = format == PAINT_VAR_SWEEP_GRADIENT
        if !readColorLine(c, child, u, variable) { return false }
        if !readable(c, p, 8) { return false }
        m.putI64(u + 32, intToFixed(s16at(p)))
        m.putI64(u + 40, intToFixed(s16at(p + 2)))
        m.putI64(u + 48, f2dot14ToFixed(s16at(p + 4)))
        m.putI64(u + 56, f2dot14ToFixed(s16at(p + 6)))
        p += 8
        if variable {
            if !readable(c, p, 4) { return false }
            deltas(face, c, @intCast(u64, u32at(p)), 4, d)
            addFixed(u + 32, intToFixed(buffer[0]))
            addFixed(u + 40, intToFixed(buffer[1]))
            addFixed(u + 48, f2dot14ToFixed(buffer[2]))
            addFixed(u + 56, f2dot14ToFixed(buffer[3]))
        }
        m.putI32(paint, @intCast(i32, PAINT_SWEEP_GRADIENT))
        return true
    }
    if format == PAINT_GLYPH {
        if !readable(c, p, 2) { return false }
        setPaintRef(u, child)
        m.put32(u + 16, @intCast(u32, u16at(p)))
        return true
    }
    if format == PAINT_TRANSFORM || format == PAINT_VAR_TRANSFORM {
        setPaintRef(u, child)
        const affine = childTable(c, base, p)
        if affine == 0 { return false }
        p = affine
        if !readable(c, p, 24) { return false }
        // (The table's order: xx, yx, xy, yy, dx, dy; FT_Affine23's: xx,
        // xy, dx, yx, yy, dy.)
        m.putI64(u + 16, s32at(p))
        m.putI64(u + 40, s32at(p + 4))
        m.putI64(u + 24, s32at(p + 8))
        m.putI64(u + 48, s32at(p + 12))
        m.putI64(u + 32, s32at(p + 16))
        m.putI64(u + 56, s32at(p + 20))
        p += 24
        if format == PAINT_VAR_TRANSFORM {
            if !readable(c, p, 4) { return false }
            deltas(face, c, @intCast(u64, u32at(p)), 6, d)
            addFixed(u + 16, buffer[0])
            addFixed(u + 40, buffer[1])
            addFixed(u + 24, buffer[2])
            addFixed(u + 48, buffer[3])
            addFixed(u + 32, buffer[4])
            addFixed(u + 56, buffer[5])
        }
        m.putI32(paint, @intCast(i32, PAINT_TRANSFORM))
        return true
    }
    if format == PAINT_TRANSLATE || format == PAINT_VAR_TRANSLATE {
        setPaintRef(u, child)
        if !readable(c, p, 4) { return false }
        m.putI64(u + 16, intToFixed(s16at(p)))
        m.putI64(u + 24, intToFixed(s16at(p + 2)))
        p += 4
        if format == PAINT_VAR_TRANSLATE {
            if !readable(c, p, 4) { return false }
            deltas(face, c, @intCast(u64, u32at(p)), 2, d)
            addFixed(u + 16, intToFixed(buffer[0]))
            addFixed(u + 24, intToFixed(buffer[1]))
        }
        m.putI32(paint, @intCast(i32, PAINT_TRANSLATE))
        return true
    }
    if format >= PAINT_SCALE && format <= PAINT_VAR_SCALE_UNIFORM_CENTER {
        setPaintRef(u, child)
        if !readable(c, p, 2) { return false }
        m.putI64(u + 16, f2dot14ToFixed(s16at(p)))
        p += 2
        if format == PAINT_SCALE || format == PAINT_VAR_SCALE || format == PAINT_SCALE_CENTER || format == PAINT_VAR_SCALE_CENTER {
            if !readable(c, p, 2) { return false }
            m.putI64(u + 24, f2dot14ToFixed(s16at(p)))
            p += 2
        } else {
            m.putI64(u + 24, m.getI64(u + 16))
        }
        if format == PAINT_SCALE_CENTER || format == PAINT_VAR_SCALE_CENTER || format == PAINT_SCALE_UNIFORM_CENTER || format == PAINT_VAR_SCALE_UNIFORM_CENTER {
            if !readable(c, p, 4) { return false }
            m.putI64(u + 32, intToFixed(s16at(p)))
            m.putI64(u + 40, intToFixed(s16at(p + 2)))
            p += 4
        } else {
            m.putI64(u + 32, 0)
            m.putI64(u + 40, 0)
        }
        if format == PAINT_VAR_SCALE || format == PAINT_VAR_SCALE_CENTER || format == PAINT_VAR_SCALE_UNIFORM || format == PAINT_VAR_SCALE_UNIFORM_CENTER {
            if !readable(c, p, 4) { return false }
            const varBase = @intCast(u64, u32at(p))
            if format == PAINT_VAR_SCALE {
                deltas(face, c, varBase, 2, d)
                addFixed(u + 16, f2dot14ToFixed(buffer[0]))
                addFixed(u + 24, f2dot14ToFixed(buffer[1]))
            }
            if format == PAINT_VAR_SCALE_CENTER {
                deltas(face, c, varBase, 4, d)
                addFixed(u + 16, f2dot14ToFixed(buffer[0]))
                addFixed(u + 24, f2dot14ToFixed(buffer[1]))
                addFixed(u + 32, intToFixed(buffer[2]))
                addFixed(u + 40, intToFixed(buffer[3]))
            }
            if format == PAINT_VAR_SCALE_UNIFORM {
                deltas(face, c, varBase, 1, d)
                addFixed(u + 16, f2dot14ToFixed(buffer[0]))
                addFixed(u + 24, f2dot14ToFixed(buffer[0]))
            }
            if format == PAINT_VAR_SCALE_UNIFORM_CENTER {
                deltas(face, c, varBase, 3, d)
                addFixed(u + 16, f2dot14ToFixed(buffer[0]))
                addFixed(u + 24, f2dot14ToFixed(buffer[0]))
                addFixed(u + 32, intToFixed(buffer[1]))
                addFixed(u + 40, intToFixed(buffer[2]))
            }
        }
        m.putI32(paint, @intCast(i32, PAINT_SCALE))
        return true
    }
    if format == PAINT_ROTATE || format == PAINT_ROTATE_CENTER || format == PAINT_VAR_ROTATE || format == PAINT_VAR_ROTATE_CENTER {
        setPaintRef(u, child)
        if !readable(c, p, 2) { return false }
        m.putI64(u + 16, f2dot14ToFixed(s16at(p)))
        p += 2
        if format == PAINT_ROTATE_CENTER || format == PAINT_VAR_ROTATE_CENTER {
            if !readable(c, p, 4) { return false }
            m.putI64(u + 24, intToFixed(s16at(p)))
            m.putI64(u + 32, intToFixed(s16at(p + 2)))
            p += 4
        } else {
            m.putI64(u + 24, 0)
            m.putI64(u + 32, 0)
        }
        if format == PAINT_VAR_ROTATE || format == PAINT_VAR_ROTATE_CENTER {
            if !readable(c, p, 4) { return false }
            const count: u64 = if format == PAINT_VAR_ROTATE_CENTER { 3 } else { 1 }
            deltas(face, c, @intCast(u64, u32at(p)), count, d)
            addFixed(u + 16, f2dot14ToFixed(buffer[0]))
            if count == 3 {
                addFixed(u + 24, intToFixed(buffer[1]))
                addFixed(u + 32, intToFixed(buffer[2]))
            }
        }
        m.putI32(paint, @intCast(i32, PAINT_ROTATE))
        return true
    }
    if format == PAINT_SKEW || format == PAINT_VAR_SKEW || format == PAINT_SKEW_CENTER || format == PAINT_VAR_SKEW_CENTER {
        setPaintRef(u, child)
        if !readable(c, p, 4) { return false }
        m.putI64(u + 16, f2dot14ToFixed(s16at(p)))
        m.putI64(u + 24, f2dot14ToFixed(s16at(p + 2)))
        p += 4
        if format == PAINT_SKEW_CENTER || format == PAINT_VAR_SKEW_CENTER {
            if !readable(c, p, 4) { return false }
            m.putI64(u + 32, intToFixed(s16at(p)))
            m.putI64(u + 40, intToFixed(s16at(p + 2)))
            p += 4
        } else {
            m.putI64(u + 32, 0)
            m.putI64(u + 40, 0)
        }
        if format == PAINT_VAR_SKEW || format == PAINT_VAR_SKEW_CENTER {
            if !readable(c, p, 4) { return false }
            const varBase = @intCast(u64, u32at(p))
            if format == PAINT_VAR_SKEW {
                deltas(face, c, varBase, 2, d)
                addFixed(u + 16, f2dot14ToFixed(buffer[0]))
                addFixed(u + 24, f2dot14ToFixed(buffer[1]))
            } else {
                deltas(face, c, varBase, 4, d)
                addFixed(u + 16, f2dot14ToFixed(buffer[0]))
                addFixed(u + 24, f2dot14ToFixed(buffer[1]))
                addFixed(u + 32, intToFixed(buffer[2]))
                addFixed(u + 40, intToFixed(buffer[3]))
            }
        }
        m.putI32(paint, @intCast(i32, PAINT_SKEW))
        return true
    }
    if format == PAINT_COMPOSITE {
        setPaintRef(u, child)
        if !readable(c, p, 1) { return false }
        const mode = u8at(p)
        p += 1
        if mode >= COMPOSITE_MAX { return false }
        m.putI32(u + 16, @intCast(i32, mode))
        const backdrop = childTable(c, base, p)
        if backdrop == 0 { return false }
        setPaintRef(u + 24, backdrop)
        return true
    }
    return false
}

fn findBaseGlyphV1(c: *Color, glyph: u64) -> (bool, u64) {
    var lo: u64 = 0
    var hi = c.*.numBaseGlyphsV1
    while lo < hi {
        const mid = lo + (hi - lo) / 2
        const p = c.*.baseGlyphsV1 + 4 + @intCast(usize, mid * BASE_GLYPH_PAINT_RECORD_SIZE)
        const gid = @intCast(u64, u16at(p))
        if gid < glyph {
            lo = mid + 1
        } else if gid > glyph {
            hi = mid
        } else {
            return -> (true, @intCast(u64, u32at(p + 2)))
        }
    }
    return -> (false, 0)
}

// ---------------------------------------------------------------------------
// The functions of color fonts (FreeType's ftcolor.h, as its SFNT driver
// answers them).

fn isSfnt(face: usize) -> bool { return (o.faceRecord(face).*.faceFlags & r.FACE_SFNT) != 0 }

// The next layer of a base glyph's `COLR` version 0 layers (FreeType's
// FT_Get_Color_Glyph_Layer): its glyph and color index (32-bit each at
// `aglyph_index` and `acolor_index`), with a LayerIterator at `iterator`
// (numLayers, layer, p: zeroed for the first); false after the last.
pub fn colorGlyphLayer(face: usize, base_glyph: u32, aglyph_index: usize, acolor_index: usize, iterator: usize) -> bool {
    if face == 0 || aglyph_index == 0 || acolor_index == 0 || iterator == 0 { return false }
    if @intCast(i64, base_glyph) >= o.faceRecord(face).*.numGlyphs { return false }
    if !isSfnt(face) { return false }
    return colrLayer(face, @intCast(u64, base_glyph), aglyph_index, acolor_index, iterator)
}

// The root paint of a base glyph of `COLR` version 1 into the
// OpaquePaint at `paint` (FreeType's FT_Get_Color_Glyph_Paint).
pub fn colorGlyphPaint(face: usize, base_glyph: u32, root_transform: i32, paint: usize) -> bool {
    if face == 0 || paint == 0 { return false }
    if !isSfnt(face) { return false }
    if colrOf(face) == 0 { return false }
    const c = stateOf(o.faceRecord(face))
    if c.*.table == 0 { return false }
    if c.*.version < 1 || c.*.numBaseGlyphsV1 == 0 || c.*.baseGlyphsV1 == 0 { return false }
    if m.getWord(paint) != 0 { return false }
    const record = findBaseGlyphV1(c, @intCast(u64, base_glyph))
    if !record.0 { return false }
    if record.1 == 0 || record.1 > c.*.tableSize { return false }
    const p = c.*.baseGlyphsV1 + @intCast(usize, record.1)
    if p >= tableEnd(c) { return false }
    m.putWord(paint, p)
    m.put8(paint + 8, if root_transform == 0 { 1 } else { 0 })
    return true
}

// The clip box of a base glyph (four Vectors at `clip_box`, through the
// face's transform: FreeType's FT_Get_Color_Glyph_ClipBox).
pub fn colorGlyphClipBox(face: usize, base_glyph: u32, clip_box: usize) -> bool {
    if face == 0 || clip_box == 0 { return false }
    if !isSfnt(face) { return false }
    if colrOf(face) == 0 { return false }
    const f = o.faceRecord(face)
    const c = stateOf(f)
    if c.*.clipList == 0 { return false }
    var p = c.*.clipList
    const limit = tableEnd(c)
    if p > limit - 5 { return false }
    const clipBase = p
    const format = u8at(p)
    if format != 1 { return false }
    const numClipBoxes = @intCast(u64, u32at(p + 1))
    p += 5
    if c.*.tableSize / 7 < numClipBoxes || p > limit - @intCast(usize, 7 * numClipBoxes) { return false }
    const root = o.faceRecord(face)
    const glyph = @intCast(i64, base_glyph)
    var i: u64 = 0
    while i < numClipBoxes {
        const gidStart = u16at(p)
        const gidEnd = u16at(p + 2)
        const offset = @intCast(usize, u24at(p + 4))
        p += 7
        i += 1
        if glyph >= gidStart && glyph <= gidEnd {
            var p1 = clipBase + offset
            if p1 > limit - 1 { return false }
            const boxFormat = u8at(p1)
            p1 += 1
            if boxFormat > 2 { return false }
            if p1 > limit - 8 { return false }
            const size = o.sizeRecord(root.*.activeSize)
            var xMin = calc.mulFix(s16at(p1), size.*.xScale)
            var yMin = calc.mulFix(s16at(p1 + 2), size.*.yScale)
            var xMax = calc.mulFix(s16at(p1 + 4), size.*.xScale)
            var yMax = calc.mulFix(s16at(p1 + 6), size.*.yScale)
            p1 += 8
            if boxFormat == 2 {
                if p1 > limit - 4 { return false }
                var buffer: [4]i64 = undefined
                deltas(face, c, @intCast(u64, u32at(p1)), 4, @intFromPtr(&buffer))
                xMin = xMin +% calc.mulFix(buffer[0], size.*.xScale)
                yMin = yMin +% calc.mulFix(buffer[1], size.*.yScale)
                xMax = xMax +% calc.mulFix(buffer[2], size.*.xScale)
                yMax = yMax +% calc.mulFix(buffer[3], size.*.yScale)
            }
            corner(f, clip_box, xMin, yMin)
            corner(f, clip_box + 16, xMin, yMax)
            corner(f, clip_box + 32, xMax, yMax)
            corner(f, clip_box + 48, xMax, yMin)
            return true
        }
    }
    return false
}

// A corner of the clip box, through the face's transform.
fn corner(f: *o.Face, at: usize, x_: i64, y_: i64) -> void {
    var x = x_
    var y = y_
    if (f.*.transformFlags & 1) != 0 {
        const tx = calc.mulFix(x, f.*.txx) +% calc.mulFix(y, f.*.txy)
        const ty = calc.mulFix(x, f.*.tyx) +% calc.mulFix(y, f.*.tyy)
        x = tx
        y = ty
    }
    if (f.*.transformFlags & 2) != 0 {
        x = x +% f.*.tdx
        y = y +% f.*.tdy
    }
    m.putI64(at, x)
    m.putI64(at + 8, y)
}

// The next paint of a PaintColrLayers' layers (FreeType's
// FT_Get_Paint_Layers).
pub fn paintLayers(face: usize, iterator: usize, paint: usize) -> bool {
    if face == 0 || paint == 0 || iterator == 0 { return false }
    if !isSfnt(face) { return false }
    if m.get32(iterator + 4) == m.get32(iterator) { return false }
    if colrOf(face) == 0 { return false }
    const c = stateOf(o.faceRecord(face))
    const p = m.getWord(iterator + 8)
    const firstLayer = p -% @intCast(usize, @intCast(u64, m.get32(iterator + 4)) * LAYER_V1_LIST_PAINT_OFFSET_SIZE) -% @intCast(usize, LAYER_V1_LIST_NUM_LAYERS_SIZE)
    if firstLayer < c.*.layersV1 { return false }
    if firstLayer >= c.*.layersV1 + @intCast(usize, LAYER_V1_LIST_NUM_LAYERS_SIZE + c.*.numLayersV1 * LAYER_V1_LIST_PAINT_OFFSET_SIZE) { return false }
    if p < c.*.layersV1 || p > tableEnd(c) - 4 { return false }
    const offset = @intCast(usize, u32at(p))
    m.put8(paint + 8, 0)
    const target = c.*.layersV1 + offset
    if target < c.*.paintsStartV1 || target >= tableEnd(c) { return false }
    m.putWord(paint, target)
    m.putWord(iterator + 8, p + 4)
    m.put32(iterator + 4, m.get32(iterator + 4) + 1)
    return true
}

// The next stop of a color line (FreeType's FT_Get_Colorline_Stops).
pub fn colorlineStops(face: usize, color_stop: usize, iterator: usize) -> bool {
    if face == 0 || color_stop == 0 || iterator == 0 { return false }
    if !isSfnt(face) { return false }
    if colrOf(face) == 0 { return false }
    const c = stateOf(o.faceRecord(face))
    if c.*.table == 0 { return false }
    const num = @intCast(u64, m.get32(iterator))
    const current = @intCast(u64, m.get32(iterator + 4))
    if current >= num { return false }
    const variable = m.get8(iterator + 16) != 0
    var entrySize = COLOR_STOP_SIZE
    if variable { entrySize += VAR_IDX_BASE_SIZE }
    var p = m.getWord(iterator + 8)
    const last = p + @intCast(usize, (num - 1 - current) * entrySize)
    if p < c.*.paintsStartV1 || last > tableEnd(c) - @intCast(usize, entrySize) { return false }
    var offset = f2dot14ToFixed(s16at(p))
    m.put16(color_stop + 8, @intCast(u16, u16at(p + 2)))
    var alpha = s16at(p + 4)
    p += 6
    if variable {
        var buffer: [2]i64 = undefined
        deltas(face, c, @intCast(u64, u32at(p)), 2, @intFromPtr(&buffer))
        p += 4
        offset = offset +% f2dot14ToFixed(buffer[0])
        alpha = calc.low16(alpha + calc.low16(buffer[1]))
    }
    m.putI64(color_stop, offset)
    m.putI16(color_stop + 10, @intCast(i16, alpha))
    m.putWord(iterator + 8, p)
    m.put32(iterator + 4, m.get32(iterator + 4) + 1)
    return true
}

// The paint an OpaquePaint (its address and flag, passed by value)
// refers to, into the COLR_Paint record at `paint` (FreeType's
// FT_Get_Paint).
pub fn getPaint(face: usize, paint_p: usize, insert_root_transform: u64, paint: usize) -> bool {
    if face == 0 || paint == 0 { return false }
    if !isSfnt(face) { return false }
    if colrOf(face) == 0 { return false }
    const f = o.faceRecord(face)
    const c = stateOf(f)
    if c.*.baseGlyphsV1 == 0 || c.*.table == 0 { return false }
    if (insert_root_transform & 0xFF) != 0 {
        m.putI32(paint, @intCast(i32, PAINT_TRANSFORM))
        const u = paint + 8
        setPaintRef(u, paint_p)
        const size = o.sizeRecord(o.faceRecord(face).*.activeSize)
        var xx = (size.*.xScale +% 32) >> 6
        var xy: i64 = 0
        var yx: i64 = 0
        var yy = (size.*.yScale +% 32) >> 6
        if (f.*.transformFlags & 1) != 0 {
            const nxx = calc.mulFix(f.*.txx, xx) +% calc.mulFix(f.*.txy, yx)
            const nxy = calc.mulFix(f.*.txx, xy) +% calc.mulFix(f.*.txy, yy)
            const nyx = calc.mulFix(f.*.tyx, xx) +% calc.mulFix(f.*.tyy, yx)
            const nyy = calc.mulFix(f.*.tyx, xy) +% calc.mulFix(f.*.tyy, yy)
            xx = nxx
            xy = nxy
            yx = nyx
            yy = nyy
        }
        m.putI64(u + 16, xx)
        m.putI64(u + 24, xy)
        m.putI64(u + 40, yx)
        m.putI64(u + 48, yy)
        if (f.*.transformFlags & 2) != 0 {
            m.putI64(u + 32, f.*.tdx *% 1024)
            m.putI64(u + 56, f.*.tdy *% 1024)
        } else {
            m.putI64(u + 32, 0)
            m.putI64(u + 56, 0)
        }
        return true
    }
    return readPaint(face, c, paint_p, paint)
}

// ---------------------------------------------------------------------------
// Palettes (FreeType's ftcolor.c).

// The face's palette data (a PaletteData record copied to
// `apalette_data`: FreeType's FT_Palette_Data_Get).
pub fn paletteDataGet(face: usize, apalette_data: usize) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if apalette_data == 0 { return r.ERR_INVALID_ARGUMENT }
    m.zero(apalette_data, PALETTE_DATA_SIZE)
    const f = o.faceRecord(face)
    if isSfnt(face) && f.*.paletteData != 0 { m.copy(apalette_data, f.*.paletteData, PALETTE_DATA_SIZE) }
    return r.OK
}

// Selects a palette; the address of its colors (BGRA, four bytes each)
// at `apalette` (FreeType's FT_Palette_Select).
pub fn paletteSelect(face: usize, palette_index: u16, apalette: usize) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if !isSfnt(face) {
        if apalette != 0 { m.putWord(apalette, 0) }
        return r.OK
    }
    const f = o.faceRecord(face)
    const err = setPalette(f, @intCast(u64, palette_index))
    if err != r.OK { return err }
    f.*.paletteIndex = @intCast(i64, palette_index)
    if apalette != 0 { m.putWord(apalette, f.*.palette) }
    return r.OK
}

// The color of the layers in the foreground color (BGRA in a word).
pub fn setForegroundColor(face: usize, foreground_color: u32) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if !isSfnt(face) { return r.OK }
    const f = o.faceRecord(face)
    f.*.foreground = foreground_color
    f.*.hasForeground = true
    return r.OK
}
