// CFF and CFF2 outlines in an SFNT (OpenType's `OTTO`), as FreeType's
// CFF driver gives them: the font loaded (cffload.mlx), the face's
// glyph count, font matrix and flags, the charmap of the CFF encoding,
// glyphs loaded through the Type 2 charstring engine (cf2.mlx) and
// scaled, their metrics, glyph names, the PostScript information and
// the CID functions.
const m = @import("./memory.mlx")
const r = @import("./records.mlx")
const o = @import("./objects.mlx")
const calc = @import("./calc.mlx")
const library = @import("./library.mlx")
const sfnt = @import("./sfnt.mlx")
const cmap = @import("./cmap.mlx")
const cffload = @import("./cffload.mlx")
const cf2 = @import("./cf2.mlx")
const truetype = @import("./glyf.mlx")
const outlines = @import("./outlines.mlx")
const variations = @import("./variations.mlx")
const sbit = @import("./sbit.mlx")
const psnames = @import("./psnames.mlx")

fn fontOfFace(face: usize) -> *cffload.Font { return cffload.fontOf(o.faceRecord(face).*.cff) }

// Loads the CFF (or CFF2) font at `offset` (FreeType's cff_font_load): a
// table of an SFNT, or a CFF font of its own (`pure`).
pub fn load(face: usize, offset: u64, isCff2: bool, pure: bool, faceIndex: i64) -> i32 {
    const f = o.faceRecord(face)
    const font = m.alloc(f.*.memory, @sizeOf(cffload.Font))
    if font == 0 { return r.ERR_OUT_OF_MEMORY }
    f.*.cff = font
    return cffload.fontLoad(cffload.fontOf(font), f.*.memory, f.*.data, f.*.size, offset, if pure { faceIndex } else { f.*.faceIndex }, pure, isCff2)
}

pub fn numGlyphs(face: usize) -> i64 { return @intCast(i64, fontOfFace(face).*.numGlyphs) }

pub fn numFaces(face: usize) -> u64 { return fontOfFace(face).*.numFaces }

// The font's name (of its name INDEX), a CFF font's own PostScript name.
pub fn fontName(face: usize) -> usize { return fontOfFace(face).*.fontName }

// The font matrix made of unit scale (FreeType's normalization in
// cff_face_init): divided by its yy (or yx), the offset in integers.
fn normalizeMatrix(d: *cffload.FontDict) -> void {
    const temp = if d.*.yy != 0 { calc.abs(d.*.yy) } else { calc.abs(d.*.yx) }
    if temp != 0x10000 {
        d.*.unitsPerEm = @bitCast(u64, calc.divFix(@bitCast(i64, d.*.unitsPerEm), temp))
        d.*.xx = calc.divFix(d.*.xx, temp)
        d.*.yx = calc.divFix(d.*.yx, temp)
        d.*.xy = calc.divFix(d.*.xy, temp)
        d.*.yy = calc.divFix(d.*.yy, temp)
        d.*.offsetX = calc.divFix(d.*.offsetX, temp)
        d.*.offsetY = calc.divFix(d.*.offsetY, temp)
    }
    d.*.offsetX >>= 16
    d.*.offsetY >>= 16
}

// The rest of FreeType's cff_face_init: the font matrices, a pure CFF
// font's metrics, names and flags, the glyph names flag, the charmaps of
// the glyph names and of the encoding; the error.
pub fn finishFace(face: usize, pure: bool, sfntFormat: bool, faceIndex: i64) -> i32 {
    const root = o.faceRecord(face)
    const font = fontOfFace(face)
    const dict = &font.*.topFont.dict
    if !dict.*.hasFontMatrix { dict.*.unitsPerEm = if pure { 1000 } else { @intCast(u64, root.*.unitsPerEm) } }
    normalizeMatrix(dict)
    var i = font.*.numSubfonts
    while i > 0 {
        const sub = &cffload.subfont(font, i - 1).*.dict
        if sub.*.hasFontMatrix {
            if dict.*.hasFontMatrix {
                var scaling: i64 = 1
                if dict.*.unitsPerEm > 1 && sub.*.unitsPerEm > 1 { scaling = @intCast(i64, if dict.*.unitsPerEm < sub.*.unitsPerEm { dict.*.unitsPerEm } else { sub.*.unitsPerEm }) }
                const val = 0x10000 * scaling
                const xx = calc.mulDiv(dict.*.xx, sub.*.xx, val) +% calc.mulDiv(dict.*.xy, sub.*.yx, val)
                const xy = calc.mulDiv(dict.*.xx, sub.*.xy, val) +% calc.mulDiv(dict.*.xy, sub.*.yy, val)
                const yx = calc.mulDiv(dict.*.yx, sub.*.xx, val) +% calc.mulDiv(dict.*.yy, sub.*.yx, val)
                const yy = calc.mulDiv(dict.*.yx, sub.*.xy, val) +% calc.mulDiv(dict.*.yy, sub.*.yy, val)
                sub.*.xx = xx
                sub.*.xy = xy
                sub.*.yx = yx
                sub.*.yy = yy
                const ox = calc.mulDiv(sub.*.offsetX, dict.*.xx, val) +% calc.mulDiv(sub.*.offsetY, dict.*.xy, val)
                const oy = calc.mulDiv(sub.*.offsetX, dict.*.yx, val) +% calc.mulDiv(sub.*.offsetY, dict.*.yy, val)
                sub.*.offsetX = ox
                sub.*.offsetY = oy
                sub.*.unitsPerEm = @bitCast(u64, calc.mulDiv(@bitCast(i64, sub.*.unitsPerEm), @bitCast(i64, dict.*.unitsPerEm), scaling))
            }
        } else {
            sub.*.xx = dict.*.xx
            sub.*.xy = dict.*.xy
            sub.*.yx = dict.*.yx
            sub.*.yy = dict.*.yy
            sub.*.offsetX = dict.*.offsetX
            sub.*.offsetY = dict.*.offsetY
            sub.*.unitsPerEm = dict.*.unitsPerEm
        }
        normalizeMatrix(sub)
        i -= 1
    }
    if pure {
        const err = pureFace(face, font, sfntFormat, faceIndex)
        if err != r.OK { return err }
    }
    if dict.*.cidRegistry == 0xFFFF && !font.*.cff2 { root.*.faceFlags |= r.FACE_GLYPH_NAMES }
    if dict.*.cidRegistry != 0xFFFF && pure { root.*.faceFlags |= r.FACE_CID_KEYED }
    // A Unicode charmap of the charset's glyph names when the font has
    // no charmap of platform 3 and encoding 1 or of platform 0.
    var hasUnicode = false
    var n: i32 = 0
    while n < root.*.numCharmaps {
        const c = o.charMap(m.getWord(root.*.charmaps + @intCast(usize, n) * 8))
        if (c.*.platformId == 3 && c.*.encodingId == 1) || c.*.platformId == 0 { hasUnicode = true }
        n += 1
    }
    // (A CID-keyed font of its own has no glyph names, and gets no
    // charmap.)
    if !hasUnicode && pure && dict.*.cidRegistry != 0xFFFF { return r.OK }
    if !hasUnicode && font.*.charset.sids != 0 {
        const count = font.*.numGlyphs
        const names = m.alloc(root.*.memory, @intCast(usize, count) * 8 + 8)
        if names == 0 { return r.ERR_OUT_OF_MEMORY }
        var g: u64 = 0
        while g < count {
            m.putWord(names + @intCast(usize, g) * 8, glyphName(face, @intCast(i64, g)))
            g += 1
        }
        const err = cmap.addNamesCharmap(face, names, count)
        m.release(root.*.memory, names)
        if err != r.OK && err != psnames.ERR_NO_UNICODE_GLYPH_NAME { return err }
    }
    // The charmap of the encoding.
    if font.*.encoding.count > 0 {
        var encodingId: i64 = 2
        var encoding = r.ENCODING_ADOBE_CUSTOM
        if font.*.encoding.offset == 0 {
            encodingId = 0
            encoding = r.ENCODING_ADOBE_STANDARD
        } else if font.*.encoding.offset == 1 {
            encodingId = 1
            encoding = r.ENCODING_ADOBE_EXPERT
        }
        const c = cmap.addCharmap(face, 7, encodingId, 0, @intFromPtr(&font.*.encoding.codes[0]))
        if c != 0 {
            o.charMap(c).*.kind = 1
            o.charMap(c).*.encoding = encoding
        }
    }
    return r.OK
}

// A pure CFF font's face (FreeType's cff_face_init for one): its faces
// and glyphs, box, metrics and names of its top DICT, its flags.
fn pureFace(face: usize, font: *cffload.Font, sfntFormat: bool, faceIndex: i64) -> i32 {
    const f = o.faceRecord(face)
    const memory = f.*.memory
    const dict = &font.*.topFont.dict
    f.*.numFaces = @intCast(i64, font.*.numFaces)
    if dict.*.cidRegistry != 0xFFFF {
        f.*.numGlyphs = @intCast(i64, font.*.charset.maxCid + 1)
    } else {
        f.*.numGlyphs = @intCast(i64, font.*.charstringsIndex.count)
    }
    f.*.bbox.xMin = dict.*.bboxXMin >> 16
    f.*.bbox.yMin = dict.*.bboxYMin >> 16
    f.*.bbox.xMax = (dict.*.bboxXMax + 0xFFFF) >> 16
    f.*.bbox.yMax = (dict.*.bboxYMax + 0xFFFF) >> 16
    f.*.unitsPerEm = @intCast(u16, dict.*.unitsPerEm & 0xFFFF)
    f.*.ascender = @intCast(i16, calc.low16(f.*.bbox.yMax))
    f.*.descender = @intCast(i16, calc.low16(f.*.bbox.yMin))
    var height = calc.low16(@intCast(i64, f.*.unitsPerEm) * 12 / 10)
    if height < @intCast(i64, f.*.ascender) - @intCast(i64, f.*.descender) { height = calc.low16(@intCast(i64, f.*.ascender) - @intCast(i64, f.*.descender)) }
    f.*.height = @intCast(i16, height)
    f.*.underlinePosition = @intCast(i16, calc.low16(dict.*.underlinePosition >> 16))
    f.*.underlineThickness = @intCast(i16, calc.low16(dict.*.underlineThickness >> 16))
    // The family and style names.
    var styleName: usize = 0
    if dict.*.familyName != 0 {
        const family = cffload.sidString(font, @intCast(u64, dict.*.familyName))
        if family != 0 { f.*.familyName = m.dupBytes(memory, family, m.cLength(family)) }
    }
    if f.*.familyName == 0 {
        f.*.familyName = cffload.indexName(font, @bitCast(u64, faceIndex) & 0xFFFF)
        if f.*.familyName != 0 { removeSubsetPrefix(f.*.familyName) }
    }
    if f.*.familyName != 0 {
        const full = cffload.sidString(font, @intCast(u64, dict.*.fullName))
        if full != 0 {
            var fullp = full
            var family = f.*.familyName
            while m.get8(fullp) != 0 {
                if m.get8(fullp) == m.get8(family) {
                    family += 1
                    fullp += 1
                    continue
                }
                if m.get8(fullp) == 32 || m.get8(fullp) == 45 {
                    fullp += 1
                    continue
                }
                if m.get8(family) == 32 || m.get8(family) == 45 {
                    family += 1
                    continue
                }
                if m.get8(family) == 0 && m.get8(fullp) != 0 {
                    styleName = m.dupBytes(memory, fullp, m.cLength(fullp))
                    if styleName != 0 { removeStyle(f.*.familyName, styleName) }
                }
                break
            }
        }
    } else {
        const cidFontName = cffload.sidString(font, @intCast(u64, dict.*.cidFontName))
        if cidFontName != 0 { f.*.familyName = m.dupBytes(memory, cidFontName, m.cLength(cidFontName)) }
    }
    f.*.styleName = if styleName != 0 { styleName } else { m.dupLiteral(memory, "Regular") }
    // The flags.
    var flags = r.FACE_SCALABLE | r.FACE_HORIZONTAL | r.FACE_HINTER
    if sfntFormat { flags |= r.FACE_SFNT }
    if dict.*.isFixedPitch != 0 { flags |= r.FACE_FIXED_WIDTH }
    f.*.faceFlags |= flags
    var style: i64 = 0
    if dict.*.italicAngle != 0 { style |= 1 }
    const weight = cffload.sidString(font, @intCast(u64, dict.*.weight))
    if weight != 0 && (m.cIs(weight, "Bold") || m.cIs(weight, "Black")) { style |= 2 }
    if (style & 2) == 0 && f.*.styleName != 0 && (startsWith(f.*.styleName, "Bold") || startsWith(f.*.styleName, "Black")) { style |= 2 }
    f.*.styleFlags = style
    return r.OK
}

fn startsWith(text: usize, word: []const u8) -> bool {
    var i: usize = 0
    while i < word.length {
        if m.get8(text + i) != word[i] { return false }
        i += 1
    }
    return true
}

// A subset's name without its prefix of six capitals and `+` (FreeType's
// remove_subset_prefix).
fn removeSubsetPrefix(name: usize) -> void {
    var idx: usize = 0
    var length = m.cLength(name) + 1
    var continueSearch = true
    while continueSearch {
        if length >= 7 && m.get8(name + idx + 6) == 43 {
            var i: usize = 0
            var ok = true
            while i < 6 {
                const c = m.get8(name + idx + i)
                if c < 65 || c > 90 { ok = false }
                i += 1
            }
            if ok {
                idx += 7
                length -= 7
            } else {
                continueSearch = false
            }
        } else {
            continueSearch = false
        }
    }
    if idx > 0 { m.copy(name, name + idx, length) }
}

// The family name without the style name at its end, and the spaces
// and dashes before it (FreeType's remove_style).
fn removeStyle(family: usize, style: usize) -> void {
    const familyLen = @intCast(i64, m.cLength(family))
    const styleLen = @intCast(i64, m.cLength(style))
    if familyLen <= styleLen { return }
    var idx = familyLen - 1
    var s = styleLen - 1
    var matched = true
    while s >= 0 {
        if m.get8(family + @intCast(usize, idx)) != m.get8(style + @intCast(usize, s)) {
            matched = false
            break
        }
        idx -= 1
        s -= 1
    }
    if !matched { return }
    while idx >= 0 {
        const c = m.get8(family + @intCast(usize, idx))
        if c != 32 && c != 45 { break }
        m.put8(family + @intCast(usize, idx), 0)
        idx -= 1
    }
    if idx >= 0 { m.put8(family + @intCast(usize, idx) + 1, 0) }
}

pub fn done(face: usize) -> void {
    const f = o.faceRecord(face)
    if f.*.cff == 0 { return }
    cffload.fontDone(cffload.fontOf(f.*.cff))
    m.release(f.*.memory, f.*.cff)
    f.*.cff = 0
}

// ---------------------------------------------------------------------------
// Glyphs (FreeType's cff_slot_load).

fn ensureStorage(memory: usize, storage: usize, points: i64, contours: i64) -> bool {
    const s: *o.Slot = unsafe { @ptrFromInt(*o.Slot, storage) }
    return truetype.ensure(memory, s, points, contours)
}

// FreeType's cff_compute_bias.
fn bias(charstringType: i64, numSubrs: i64) -> i64 {
    if charstringType == 1 { return 0 }
    if numSubrs < 1240 { return 107 }
    if numSubrs < 33900 { return 1131 }
    return 32768
}

pub fn loadGlyph(face: usize, size: usize, slot: usize, gindex_: i64, loadFlags_: i64) -> i32 {
    const f = o.faceRecord(face)
    const root = o.faceRecord(face)
    const font = fontOfFace(face)
    const s = o.slotRecord(slot)
    const internal = o.slotRecord(slot)
    var gindex = gindex_
    var loadFlags = loadFlags_
    var forceScaling = false
    if font.*.topFont.dict.cidRegistry != 0xFFFF && font.*.charset.cids != 0 {
        if gindex != 0 {
            gindex = @intCast(i64, cffload.cidToGindex(&font.*.charset, @intCast(u64, gindex)))
            if gindex == 0 { return r.ERR_INVALID_ARGUMENT }
        }
    } else if gindex >= @intCast(i64, font.*.numGlyphs) || gindex < 0 {
        return r.ERR_INVALID_ARGUMENT
    }
    if (loadFlags & r.LOAD_NO_RECURSE) != 0 { loadFlags |= r.LOAD_NO_SCALE | r.LOAD_NO_HINTING }
    var xScale: i64 = 0x10000
    var yScale: i64 = 0x10000
    if size != 0 {
        xScale = o.sizeRecord(size).*.xScale
        yScale = o.sizeRecord(size).*.yScale
    }
    // An embedded bitmap first, with linear advances of `hmtx` (and
    // `vmtx`, or made up of `OS/2` or `hhea`).
    if size != 0 && o.sizeRecord(size).*.strikeIndex >= 0 && (loadFlags & r.LOAD_NO_BITMAP) == 0 && !variations.isVaried(face) {
        if sbit.loadGlyph(face, size, slot, gindex, loadFlags) == r.OK {
            s.*.linearHoriAdvance = sfnt.glyphMetrics(f, false, gindex).1
            if f.*.verticalInfo && sfnt.numberOfVMetrics(f) > 0 {
                s.*.linearVertAdvance = sfnt.glyphMetrics(f, true, gindex).1
            } else if sfnt.os2Present(f) {
                s.*.linearVertAdvance = sfnt.typoAscender(f) - sfnt.typoDescender(f)
            } else {
                s.*.linearVertAdvance = sfnt.ascender(f) - sfnt.descender(f)
            }
            return r.OK
        }
    }
    if (loadFlags & r.LOAD_SBITS_ONLY) != 0 { return r.ERR_INVALID_ARGUMENT }
    var xx = font.*.topFont.dict.xx
    var xy = font.*.topFont.dict.xy
    var yx = font.*.topFont.dict.yx
    var yy = font.*.topFont.dict.yy
    var offsetX = font.*.topFont.dict.offsetX
    var offsetY = font.*.topFont.dict.offsetY
    if font.*.numSubfonts != 0 {
        var fd = cffload.fdSelectGet(&font.*.fdSelect, @intCast(u64, gindex))
        if fd >= font.*.numSubfonts { fd = font.*.numSubfonts - 1 }
        const topUpm = @bitCast(i64, font.*.topFont.dict.unitsPerEm)
        const sd = &cffload.subfont(font, fd).*.dict
        const subUpm = @bitCast(i64, sd.*.unitsPerEm)
        xx = sd.*.xx
        xy = sd.*.xy
        yx = sd.*.yx
        yy = sd.*.yy
        offsetX = sd.*.offsetX
        offsetY = sd.*.offsetY
        if topUpm != subUpm {
            xScale = calc.mulDiv(xScale, topUpm, subUpm)
            yScale = calc.mulDiv(yScale, topUpm, subUpm)
            forceScaling = true
        }
    }
    s.*.outline.nPoints = 0
    s.*.outline.nContours = 0
    var hinting = (loadFlags & r.LOAD_NO_HINTING) == 0
    const scaled = (loadFlags & r.LOAD_NO_SCALE) == 0
    s.*.format = r.FORMAT_OUTLINE
    // The decoder (FreeType's cff_decoder_init and cff_decoder_prepare).
    var sub = &font.*.topFont
    if font.*.numSubfonts != 0 {
        const fd = cffload.fdSelectGet(&font.*.fdSelect, @intCast(u64, gindex))
        if fd >= font.*.numSubfonts { return r.ERR_INVALID_FILE_FORMAT }
        sub = cffload.subfont(font, fd)
    }
    const element = cffload.accessElement(&font.*.stream, &font.*.charstringsIndex, @intCast(u64, gindex))
    if element.0 != r.OK { return element.0 }
    const engine = m.alloc(f.*.memory, @sizeOf(cf2.Engine))
    if engine == 0 { return r.ERR_OUT_OF_MEMORY }
    const e: *cf2.Engine = unsafe { @ptrFromInt(*cf2.Engine, engine) }
    e.*.font = font
    e.*.sub = sub
    e.*.isCFF2 = font.*.cff2
    e.*.memory = f.*.memory
    e.*.storage = @intFromPtr(internal)
    e.*.ensure = @intFromPtr(ensureStorage)
    e.*.unitsPerEm = @intCast(i64, root.*.unitsPerEm)
    const charstringType = @intCast(i64, font.*.topFont.dict.charstringType)
    e.*.globals = font.*.globalSubrs
    e.*.numGlobals = @intCast(i64, font.*.globalSubrsIndex.count)
    e.*.globalsBias = bias(charstringType, e.*.numGlobals)
    e.*.locals = sub.*.localSubrs
    e.*.numLocals = @intCast(i64, sub.*.localSubrsIndex.count)
    e.*.localsBias = bias(charstringType, e.*.numLocals)
    e.*.defaultWidthX = sub.*.priv.defaultWidth
    e.*.widthOnly = (loadFlags & r.LOAD_ADVANCE_ONLY) != 0
    const l = library.lib(f.*.library)
    e.*.darkenParams[0] = l.*.darken0
    e.*.darkenParams[1] = l.*.darken1
    e.*.darkenParams[2] = l.*.darken2
    e.*.darkenParams[3] = l.*.darken3
    e.*.darkenParams[4] = l.*.darken4
    e.*.darkenParams[5] = l.*.darken5
    e.*.darkenParams[6] = l.*.darken6
    e.*.darkenParams[7] = l.*.darken7
    const fontNoDarkening = f.*.noStemDarkening
    e.*.stemDarkened = scaled && (fontNoDarkening == 0 || (fontNoDarkening < 0 && !l.*.noStemDarkening))
    // The variation of a CFF2 font: its blend at the face's coordinates.
    if font.*.cff2 && font.*.vsDataCount != 0 {
        const coords = variations.normalizedCoords(face)
        e.*.lenNDV = coords.0
        e.*.ndv = coords.1
        if cffload.blendCheckVector(sub, @intCast(u64, sub.*.priv.vsindex), e.*.lenNDV, e.*.ndv) { _ = cffload.loadPrivateDict(font, sub, e.*.lenNDV, e.*.ndv) }
        e.*.vsindex = @intCast(i64, sub.*.priv.vsindex)
    }
    var ppemY: i64 = 0
    if root.*.activeSize != 0 { ppemY = @intCast(i64, o.sizeRecord(root.*.activeSize).*.yPpem) }
    var err = r.OK
    var width: i64 = 0
    var pass: i64 = 0
    while pass < 2 {
        e.*.hinted = hinting
        e.*.scaled = scaled
        var scaleX: i64 = 0x400
        var scaleY: i64 = 0x400
        if hinting {
            scaleX = calc.low32(xScale +% 32) / 64
            scaleY = calc.low32(yScale +% 32) / 64
        }
        err = r.OK
        if scaled {
            // (FreeType's cf2_checkTransform.)
            if scaleX <= 0 || scaleY <= 0 {
                err = r.ERR_INVALID_SIZE_HANDLE
            } else if e.*.unitsPerEm > 0x7FFF {
                err = r.ERR_GLYPH_TOO_BIG
            } else {
                const maxScale = calc.divFix(2000 << 16, e.*.unitsPerEm << 16)
                if scaleX > maxScale || scaleY > maxScale { err = r.ERR_GLYPH_TOO_BIG }
            }
        }
        if err == r.OK {
            cf2.setup(e, ppemY, scaleX, scaleY)
            const w = cf2.glyphOutline(e, element.1, element.1 + @intCast(usize, element.2))
            if e.*.err != r.OK {
                err = r.ERR_INVALID_FILE_FORMAT
            } else {
                width = cf2.widthOfFixed(w)
            }
        }
        if err == r.ERR_GLYPH_TOO_BIG && pass == 0 {
            hinting = false
            forceScaling = true
            pass += 1
            continue
        }
        break
    }
    const nPoints = e.*.nPoints
    const nContours = e.*.nContours
    m.release(f.*.memory, engine)
    if err != r.OK { return err }
    s.*.outline.nPoints = @intCast(i16, calc.low16(nPoints))
    s.*.outline.nContours = @intCast(i16, calc.low16(nContours))
    s.*.outline.points = internal.*.points
    s.*.outline.tags = internal.*.tags
    s.*.outline.contours = internal.*.contours
    if (loadFlags & r.LOAD_NO_RECURSE) != 0 {
        s.*.metrics.horiBearingX = 0
        s.*.metrics.horiAdvance = width
        return r.OK
    }
    if sfnt.numberOfHMetrics(f) != 0 {
        const h = variations.glyphMetrics(face, false, gindex)
        s.*.metrics.horiAdvance = h.1
        s.*.metrics.horiBearingX = h.0
        s.*.linearHoriAdvance = h.1
    } else {
        s.*.metrics.horiAdvance = width
        s.*.linearHoriAdvance = width
    }
    const hasVerticalInfo = f.*.verticalInfo && sfnt.numberOfVMetrics(f) > 0
    if hasVerticalInfo {
        const v = variations.glyphMetrics(face, true, gindex)
        s.*.metrics.vertBearingY = v.0
        s.*.metrics.vertAdvance = v.1
    } else if sfnt.os2Present(f) {
        s.*.metrics.vertAdvance = sfnt.typoAscender(f) - sfnt.typoDescender(f)
    } else {
        s.*.metrics.vertAdvance = sfnt.ascender(f) - sfnt.descender(f)
    }
    s.*.linearVertAdvance = s.*.metrics.vertAdvance
    s.*.format = r.FORMAT_OUTLINE
    s.*.outline.flags = 0
    if size != 0 && o.sizeRecord(size).*.yPpem < 24 { s.*.outline.flags |= r.OUTLINE_HIGH_PRECISION }
    s.*.outline.flags |= r.OUTLINE_REVERSE_FILL
    const count = @intCast(i64, s.*.outline.nPoints)
    if xx != 0x10000 || yy != 0x10000 || xy != 0 || yx != 0 {
        outlines.transform(s.*.outline.points, count, xx, xy, yx, yy)
        s.*.metrics.horiAdvance = calc.mulFix(s.*.metrics.horiAdvance, xx)
        s.*.metrics.vertAdvance = calc.mulFix(s.*.metrics.vertAdvance, yy)
    }
    if offsetX != 0 || offsetY != 0 {
        outlines.translate(s.*.outline.points, count, offsetX, offsetY)
        s.*.metrics.horiAdvance += offsetX
        s.*.metrics.vertAdvance += offsetY
    }
    if scaled || forceScaling {
        if !hinting {
            var n: i64 = 0
            while n < count {
                const at = s.*.outline.points + @intCast(usize, n) * 16
                m.putI64(at, calc.mulFix(m.getI64(at), xScale))
                m.putI64(at + 8, calc.mulFix(m.getI64(at + 8), yScale))
                n += 1
            }
        }
        s.*.metrics.horiAdvance = calc.mulFix(s.*.metrics.horiAdvance, xScale)
        s.*.metrics.vertAdvance = calc.mulFix(s.*.metrics.vertAdvance, yScale)
    }
    const box = outlines.cbox(s.*.outline.points, count)
    s.*.metrics.width = box.2 - box.0
    s.*.metrics.height = box.3 - box.1
    s.*.metrics.horiBearingX = box.0
    s.*.metrics.horiBearingY = box.3
    if hasVerticalInfo {
        s.*.metrics.vertBearingX = s.*.metrics.horiBearingX - s.*.metrics.horiAdvance / 2
        s.*.metrics.vertBearingY = calc.mulFix(s.*.metrics.vertBearingY, yScale)
    } else if (loadFlags & r.LOAD_VERTICAL_LAYOUT) != 0 {
        // (FreeType's ft_synthesize_vertical_metrics.)
        var height = s.*.metrics.height
        if s.*.metrics.horiBearingY < 0 {
            if height < s.*.metrics.horiBearingY { height = s.*.metrics.horiBearingY }
        } else if s.*.metrics.horiBearingY > 0 {
            height -= s.*.metrics.horiBearingY
        }
        var advance = s.*.metrics.vertAdvance
        if advance == 0 { advance = height * 12 / 10 }
        s.*.metrics.vertBearingX = s.*.metrics.horiBearingX - s.*.metrics.horiAdvance / 2
        s.*.metrics.vertBearingY = (advance - height) / 2
        s.*.metrics.vertAdvance = advance
    }
    return r.OK
}

// ---------------------------------------------------------------------------
// Names and information.

pub fn glyphName(face: usize, gindex: i64) -> usize {
    const font = fontOfFace(face)
    if font.*.charset.sids == 0 || gindex < 0 || @intCast(u64, gindex) >= font.*.numGlyphs { return 0 }
    return cffload.sidString(font, cffload.glyphSid(font, @intCast(u64, gindex)))
}

pub fn nameIndex(face: usize, name: usize) -> i64 {
    const font = fontOfFace(face)
    if font.*.charset.sids == 0 { return 0 }
    var i: u64 = 0
    while i < font.*.numGlyphs {
        const s = cffload.sidString(font, cffload.glyphSid(font, i))
        if s != 0 && m.cEqual(s, name) { return @intCast(i64, i) }
        i += 1
    }
    return 0
}

pub fn hasGlyphNames(face: usize) -> i32 { return if (o.faceRecord(face).*.faceFlags & r.FACE_GLYPH_NAMES) != 0 { 1 } else { 0 } }

// PS_FontInfoRec: version, notice, full_name, family_name, weight (C
// strings), italic_angle (FT_Long), is_fixed_pitch (FT_Bool),
// underline_position (FT_Short), underline_thickness (FT_UShort).
pub fn fontInfo(face: usize, info: usize) -> i32 {
    const font = fontOfFace(face)
    if font.*.cff2 { return r.ERR_INVALID_ARGUMENT }
    const d = &font.*.topFont.dict
    m.putWord(info, cffload.sidString(font, @intCast(u64, d.*.version)))
    m.putWord(info + 8, cffload.sidString(font, @intCast(u64, d.*.notice)))
    m.putWord(info + 16, cffload.sidString(font, @intCast(u64, d.*.fullName)))
    m.putWord(info + 24, cffload.sidString(font, @intCast(u64, d.*.familyName)))
    m.putWord(info + 32, cffload.sidString(font, @intCast(u64, d.*.weight)))
    m.putI64(info + 40, d.*.italicAngle)
    m.put8(info + 48, d.*.isFixedPitch)
    m.putI16(info + 50, @intCast(i16, calc.low16(d.*.underlinePosition)))
    m.put16(info + 52, @intCast(u16, calc.ulow16(d.*.underlineThickness)))
    return r.OK
}

// The FSType of the embedded PostScript (`/FSType N def`), 0 when none.
pub fn fsType(face: usize) -> i64 {
    const font = fontOfFace(face)
    const ps = cffload.sidString(font, @intCast(u64, font.*.topFont.dict.embeddedPostscript))
    if ps == 0 { return 0 }
    const key = "/FSType"
    var p = ps
    var found = false
    while m.get8(p) != 0 {
        var k: usize = 0
        while k < key.length && m.get8(p + k) == key[k] { k += 1 }
        if k == key.length {
            found = true
            break
        }
        p += 1
    }
    if !found { return 0 }
    var q = p + key.length
    var def: usize = 0
    var t = q
    while m.get8(t) != 0 {
        if m.get8(t) == 100 && m.get8(t + 1) == 101 && m.get8(t + 2) == 102 {
            def = t
            break
        }
        t += 1
    }
    if def == 0 { return 0 }
    var value: i64 = 0
    while q != def {
        const c = @intCast(i64, m.get8(q))
        if c >= 48 && c <= 57 {
            if value >= (0xFFFF - 9) / 10 { return 0 }
            value = value * 10 + (c - 48)
        } else if c != 32 && c != 10 && c != 13 {
            return 0
        }
        q += 1
    }
    return value
}

pub fn registryOrderingSupplement(face: usize) -> (i32, usize, usize, i64) {
    const font = fontOfFace(face)
    const d = &font.*.topFont.dict
    if d.*.cidRegistry == 0xFFFF { return -> (r.ERR_INVALID_ARGUMENT, 0, 0, 0) }
    return -> (r.OK, cffload.sidString(font, @intCast(u64, d.*.cidRegistry)), cffload.sidString(font, @intCast(u64, d.*.cidOrdering)), calc.low32(d.*.cidSupplement))
}

pub fn isCid(face: usize) -> bool { return fontOfFace(face).*.topFont.dict.cidRegistry != 0xFFFF }

pub fn cidOfGlyph(face: usize, gindex: i64) -> (i32, i64) {
    const font = fontOfFace(face)
    if font.*.topFont.dict.cidRegistry == 0xFFFF { return -> (r.ERR_INVALID_ARGUMENT, 0) }
    if gindex >= @intCast(i64, font.*.numGlyphs) { return -> (r.ERR_INVALID_ARGUMENT, 0) }
    return -> (r.OK, @intCast(i64, cffload.glyphSid(font, @intCast(u64, gindex))))
}
