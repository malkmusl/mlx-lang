// What the engine stands on: memory by address (fonts, outlines and
// bitmaps are reached through their addresses), the bytes of a font read
// big-endian, NUL-ended strings, and the memory of a library: a Memory
// record of three functions (alloc, free, realloc, called through their
// addresses), which the C API fills with a C program's own and
// `useAllocator` with an Allocator's.
//
// The functions here make no aggregates: a plugin's exported function's
// stack arena is given back only when it returns, and glyphs are loaded
// and rendered in loops within one call.
const allocator_module = @import("../../bootstrap/allocator.mlx")
const mem = @import("../../bootstrap/mem.mlx")

pub const Allocator = allocator_module.Allocator

pub fn get8(address: usize) -> u8 { unsafe { return @ptrFromInt(*u8, address).* } }
pub fn put8(address: usize, value: u8) -> void { unsafe { @ptrFromInt(*u8, address).* = value } }
pub fn get16(address: usize) -> u16 { unsafe { return @ptrFromInt(*u16, address).* } }
pub fn put16(address: usize, value: u16) -> void { unsafe { @ptrFromInt(*u16, address).* = value } }
pub fn get32(address: usize) -> u32 { unsafe { return @ptrFromInt(*u32, address).* } }
pub fn put32(address: usize, value: u32) -> void { unsafe { @ptrFromInt(*u32, address).* = value } }
pub fn get64(address: usize) -> u64 { unsafe { return @ptrFromInt(*u64, address).* } }
pub fn put64(address: usize, value: u64) -> void { unsafe { @ptrFromInt(*u64, address).* = value } }
pub fn getWord(address: usize) -> usize { unsafe { return @ptrFromInt(*usize, address).* } }
pub fn putWord(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*usize, address).* = value } }
pub fn getI16(address: usize) -> i16 { return @bitCast(i16, get16(address)) }
pub fn putI16(address: usize, value: i16) -> void { put16(address, @bitCast(u16, value)) }
pub fn getI32(address: usize) -> i32 { return @bitCast(i32, get32(address)) }
pub fn putI32(address: usize, value: i32) -> void { put32(address, @bitCast(u32, value)) }
pub fn getI64(address: usize) -> i64 { return @bitCast(i64, get64(address)) }
pub fn putI64(address: usize, value: i64) -> void { put64(address, @bitCast(u64, value)) }

// Big-endian values of a font's bytes.
pub fn u16be(address: usize) -> u32 { return (@intCast(u32, get8(address)) << 8) | @intCast(u32, get8(address + 1)) }
pub fn i16be(address: usize) -> i32 { return @intCast(i32, @bitCast(i16, @intCast(u16, u16be(address)))) }
pub fn u24be(address: usize) -> u32 { return (@intCast(u32, get8(address)) << 16) | (@intCast(u32, get8(address + 1)) << 8) | @intCast(u32, get8(address + 2)) }
pub fn u32be(address: usize) -> u32 { return (@intCast(u32, get8(address)) << 24) | (@intCast(u32, get8(address + 1)) << 16) | (@intCast(u32, get8(address + 2)) << 8) | @intCast(u32, get8(address + 3)) }
pub fn i32be(address: usize) -> i32 { return @bitCast(i32, u32be(address)) }
pub fn i8at(address: usize) -> i64 { return @intCast(i64, @bitCast(i8, get8(address))) }

// `count` bytes from `source` to `target` (which may overlap).
pub fn copy(target: usize, source: usize, count: usize) -> void {
    if count == 0 || target == source { return }
    unsafe {
        if target > source && target < source + count {
            mem.copyBackwards(@ptrFromInt([*]u8, target), @ptrFromInt([*]const u8, source), count)
        } else {
            mem.copy(@ptrFromInt([*]u8, target), @ptrFromInt([*]const u8, source), count)
        }
    }
}

pub fn zero(target: usize, count: usize) -> void {
    if count == 0 { return }
    unsafe { mem.zero(@ptrFromInt([*]u8, target), count) }
}

pub fn fill(target: usize, value: u8, count: usize) -> void {
    if count == 0 { return }
    unsafe { mem.set(@ptrFromInt([*]u8, target), value, count) }
}

// ---------------------------------------------------------------------------
// The memory of a library: a Memory record (laid out as FreeType's
// FT_MemoryRec: its user word, then the addresses of its functions).

pub const Memory = struct {
    user: usize
    alloc: usize
    free: usize
    realloc: usize
}

pub const AllocFunc = fn(usize, i64) -> usize
pub const FreeFunc = fn(usize, usize) -> void
pub const ReallocFunc = fn(usize, i64, i64, usize) -> usize

// `size` zeroed bytes of `memory` (0 when it has none).
pub fn alloc(memory: usize, size: usize) -> usize {
    if size == 0 { return 0 }
    const f = getWord(memory + 8)
    const call: AllocFunc = unsafe { @ptrFromInt(AllocFunc, f) }
    const block = call(memory, @intCast(i64, size))
    if block != 0 { zero(block, size) }
    return block
}

pub fn release(memory: usize, block: usize) -> void {
    if block == 0 { return }
    const f = getWord(memory + 16)
    const call: FreeFunc = unsafe { @ptrFromInt(FreeFunc, f) }
    call(memory, block)
}

// `block` grown from `current` to `size` bytes (the new ones zeroed).
pub fn grow(memory: usize, block: usize, current: usize, size: usize) -> usize {
    if block == 0 { return alloc(memory, size) }
    const f = getWord(memory + 24)
    const call: ReallocFunc = unsafe { @ptrFromInt(ReallocFunc, f) }
    const result = call(memory, @intCast(i64, current), @intCast(i64, size), block)
    if result != 0 && size > current { zero(result + current, size - current) }
    return result
}

// A Memory record of an Allocator (which must outlive it): each block
// has its length in the 16 bytes before it, which free needs.
pub fn useAllocator(memory: *Memory, allocator: *Allocator) -> void {
    memory.*.user = @intFromPtr(allocator)
    memory.*.alloc = @intFromPtr(allocatorAlloc)
    memory.*.free = @intFromPtr(allocatorFree)
    memory.*.realloc = @intFromPtr(allocatorRealloc)
}

fn allocatorOf(memory: usize) -> *Allocator { unsafe { return @ptrFromInt(*Allocator, getWord(memory)) } }

fn allocatorAlloc(memory: usize, size: i64) -> usize {
    const length = @intCast(usize, if size <= 0 { 1 } else { size }) + 16
    const block = allocatorOf(memory).*.alloc(length, 16)
    if block == null { return 0 }
    const address = @intFromPtr(block.?)
    putWord(address, length)
    return address + 16
}

fn allocatorFree(memory: usize, block: usize) -> void {
    if block == 0 { return }
    const address = block - 16
    unsafe { allocatorOf(memory).*.free(@ptrFromInt([*]u8, address), getWord(address), 16) }
}

fn allocatorRealloc(memory: usize, current: i64, size: i64, block: usize) -> usize {
    const result = allocatorAlloc(memory, size)
    if result == 0 { return 0 }
    if block != 0 {
        const old = getWord(block - 16) - 16
        const keep = if @intCast(usize, if size <= 0 { 1 } else { size }) < old { @intCast(usize, if size <= 0 { 1 } else { size }) } else { old }
        copy(result, block, keep)
        allocatorFree(memory, block)
    }
    return result
}

// ---------------------------------------------------------------------------
// NUL-ended strings.

// A string's length.
pub fn cLength(text: usize) -> usize {
    if text == 0 { return 0 }
    var count: usize = 0
    while get8(text + count) != 0 { count += 1 }
    return count
}

// Whether the string `text` is the bytes of `word`.
pub fn cIs(text: usize, word: []const u8) -> bool {
    if text == 0 { return false }
    var index: usize = 0
    while index < word.length {
        if get8(text + index) != word[index] { return false }
        index += 1
    }
    return get8(text + word.length) == 0
}

pub fn cEqual(a: usize, b: usize) -> bool {
    if a == 0 || b == 0 { return a == b }
    var index: usize = 0
    while true {
        const x = get8(a + index)
        if x != get8(b + index) { return false }
        if x == 0 { return true }
        index += 1
    }
    return true
}

// The address of a literal's bytes (a NUL follows them).
pub fn literal(text: []const u8) -> usize { return @intFromPtr(text.pointer) }

// A copy of `length` bytes at `text` in `memory`, NUL-ended.
pub fn dupBytes(memory: usize, text: usize, length: usize) -> usize {
    const copied = alloc(memory, length + 1)
    if copied == 0 { return 0 }
    copy(copied, text, length)
    return copied
}

pub fn dupLiteral(memory: usize, text: []const u8) -> usize { return dupBytes(memory, literal(text), text.length) }

// Copies the words of `text` (separated by single spaces) into `block`
// (at least text.length + 1 bytes), each ended by a NUL, and their
// addresses into `words` (`count` of them at most); the number copied.
pub fn splitWords(text: []const u8, block: usize, words: usize, count: usize) -> usize {
    copy(block, literal(text), text.length)
    var start: usize = 0
    var n: usize = 0
    var i: usize = 0
    while i <= text.length && n < count {
        if i == text.length || text[i] == 32 {
            put8(block + i, 0)
            putWord(words + n * 8, block + start)
            n += 1
            start = i + 1
        }
        i += 1
    }
    return n
}
