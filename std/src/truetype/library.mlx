// A library: the memory its faces, sizes, slots and bitmaps are made of,
// the LCD filter it renders subpixel images with, and the properties of
// its CFF driver (stem darkening and its parameters, the random seed).
// The faces of a library share them.
const m = @import("./memory.mlx")

pub const Library = struct {
    // The library's memory (a Memory record's address).
    memory: usize
    // The LCD filter: 0 none, 1 a five-tap one of `lcdWeights`, 2 the
    // legacy one.
    lcdFilter: i64
    lcdWeights: u64
    // The CFF driver's properties.
    noStemDarkening: bool
    randomSeed: i64
    darken0: i64
    darken1: i64
    darken2: i64
    darken3: i64
    darken4: i64
    darken5: i64
    darken6: i64
    darken7: i64
}

pub fn lib(address: usize) -> *Library { unsafe { return @ptrFromInt(*Library, address) } }

// The drivers a face is loaded by: glyf outlines and embedded bitmaps,
// or CFF and CFF2.
pub const TRUETYPE: i64 = 0
pub const CFF: i64 = 1

// A library's start (FreeType's, without the LCD filter its renderers
// set: `setLcdFilter`).
pub fn init(l: *Library, memory: usize) -> void {
    l.*.memory = memory
    l.*.lcdFilter = 0
    l.*.lcdWeights = 0
    l.*.noStemDarkening = true
    l.*.randomSeed = 0
    l.*.darken0 = 500
    l.*.darken1 = 400
    l.*.darken2 = 1000
    l.*.darken3 = 275
    l.*.darken4 = 1667
    l.*.darken5 = 275
    l.*.darken6 = 2333
    l.*.darken7 = 0
}

// The weight `index` (0 to 4) of a five-tap filter packed in a word.
pub fn weight(weights: u64, index: i64) -> i64 { return @intCast(i64, (weights >> @intCast(u6, index * 8)) & 0xFF) }

// The five weights at `address` packed in a word.
pub fn packWeights(address: usize) -> u64 {
    var result: u64 = 0
    var i: usize = 0
    while i < 5 {
        result |= @intCast(u64, m.get8(address + i)) << @intCast(u6, i * 8)
        i += 1
    }
    return result
}

// The default filter, FreeType's: 0x08 0x4D 0x56 0x4D 0x08.
pub const DEFAULT_WEIGHTS: u64 = 0x084D564D08
pub const LIGHT_WEIGHTS: u64 = 0x0055565500

// The LCD filters by FreeType's numbers: 0 none, 1 the default, 2 the
// light one, 3 (or 16) the legacy one; false for another.
pub fn setLcdFilter(l: *Library, filter: i64) -> bool {
    if filter == 0 {
        l.*.lcdFilter = 0
    } else if filter == 1 {
        l.*.lcdWeights = DEFAULT_WEIGHTS
        l.*.lcdFilter = 1
    } else if filter == 2 {
        l.*.lcdWeights = LIGHT_WEIGHTS
        l.*.lcdFilter = 1
    } else if filter == 3 || filter == 16 {
        l.*.lcdFilter = 2
    } else {
        return false
    }
    return true
}

// A five-tap filter of the weights at `address`.
pub fn setLcdWeights(l: *Library, address: usize) -> void {
    l.*.lcdWeights = packWeights(address)
    l.*.lcdFilter = 1
}

// The darkening parameter `i` (0 to 7: x1, y1 ... x4, y4).
pub fn darken(l: *Library, i: i64) -> i64 {
    return match i {
        0 => l.*.darken0
        1 => l.*.darken1
        2 => l.*.darken2
        3 => l.*.darken3
        4 => l.*.darken4
        5 => l.*.darken5
        6 => l.*.darken6
        else => l.*.darken7
    }
}

// Sets the darkening parameters (eight values at `values`, 64-bit);
// false, and none set, when they are not four points rising in x with y
// from 0 to 500.
pub fn setDarkening(l: *Library, values: usize) -> bool {
    const x1 = m.getI64(values)
    const y1 = m.getI64(values + 8)
    const x2 = m.getI64(values + 16)
    const y2 = m.getI64(values + 24)
    const x3 = m.getI64(values + 32)
    const y3 = m.getI64(values + 40)
    const x4 = m.getI64(values + 48)
    const y4 = m.getI64(values + 56)
    if x1 < 0 || x2 < 0 || x3 < 0 || x4 < 0 || y1 < 0 || y2 < 0 || y3 < 0 || y4 < 0 { return false }
    if x1 > x2 || x2 > x3 || x3 > x4 || y1 > 500 || y2 > 500 || y3 > 500 || y4 > 500 { return false }
    l.*.darken0 = x1
    l.*.darken1 = y1
    l.*.darken2 = x2
    l.*.darken3 = y2
    l.*.darken4 = x3
    l.*.darken5 = y3
    l.*.darken6 = x4
    l.*.darken7 = y4
    return true
}
