// The engine's records of a face, a size, a glyph slot and a charmap: a
// face of a font file with its global metrics, charmaps and tables; a
// size (scales and metrics in 26.6 pixels); a slot a glyph is loaded
// into (its metrics, outline or bitmap); a charmap of the face. They are
// reached by their addresses, as the rest of the engine reaches the
// font's bytes; `user` is a word the engine never reads, for its callers
// (the C API keeps its own records of them there).
const m = @import("./memory.mlx")
const r = @import("./records.mlx")

pub const OUTLINES_NONE: i64 = 0
pub const OUTLINES_GLYF: i64 = 1
pub const OUTLINES_CFF: i64 = 2
pub const OUTLINES_CFF2: i64 = 3

// How the font's bytes are held: the caller's, mapped from a file, or
// allocated by the library's memory.
pub const DATA_CALLER: i64 = 0
pub const DATA_MAPPED: i64 = 1
pub const DATA_ALLOCATED: i64 = 2

pub const Face = struct {
    // The faces of the file (a collection's fonts), this one's index (its
    // named instance in the high 16 bits), its flags (FACE_...) and style
    // (bit 0 italic, bit 1 bold; the number of named instances in the
    // high 16 bits), its glyphs.
    numFaces: i64
    faceIndex: i64
    faceFlags: i64
    styleFlags: i64
    numGlyphs: i64
    // NUL-ended ASCII names (0 when the font has none).
    familyName: usize
    styleName: usize
    // The strikes of embedded bitmaps (BitmapSize records).
    numFixedSizes: i32
    availableSizes: usize
    // The charmaps (an array of CharMap addresses).
    numCharmaps: i32
    charmaps: usize
    // Global metrics in font units.
    bbox: r.BBox
    unitsPerEm: u16
    ascender: i16
    descender: i16
    height: i16
    maxAdvanceWidth: i16
    maxAdvanceHeight: i16
    underlinePosition: i16
    underlineThickness: i16
    // The face's slots (Slot.next), the first of them its glyph slot; the
    // size glyphs are loaded at; the charmap characters are looked up in.
    glyph: usize
    activeSize: usize
    charmap: usize
    // The face's sizes (Size.next).
    sizes: usize
    user: usize
    // A function called with the face when its design changes (variation
    // coordinates, a named instance), 0 for none.
    changeHook: usize
    library: usize
    memory: usize
    refcount: i64
    // The face's driver (library.TRUETYPE or library.CFF).
    driver: i64
    // The font's bytes, and how they are held (DATA_...).
    data: usize
    size: u64
    dataKind: i64
    // Whether they are a file's (for the errors of formats not read).
    fromPath: bool
    // The font of a collection the face is: its table directory.
    dirOffset: u64
    formatTag: u32
    numTables: i64
    // Records of 16 bytes: tag, checksum, offset, length.
    tables: usize
    outlines: i64
    // The tables as FreeType reads them: TT_Header, TT_MaxProfile,
    // TT_HoriHeader, TT_VertHeader, TT_OS2 (its version 0xFFFF when the
    // font has none), TT_Postscript, TT_PCLT.
    head: usize
    maxp: usize
    hhea: usize
    vhea: usize
    os2: usize
    post: usize
    pclt: usize
    hasPost: bool
    hasPclt: bool
    hasVhea: bool
    hmtxOffset: u64
    hmtxSize: u64
    vmtxOffset: u64
    vmtxSize: u64
    verticalInfo: bool
    // `name`: records of 16 bytes (platform, encoding, language, name ID,
    // length as 16-bit values, then the string's offset in the font),
    // and the language tags of a format 1 table (length, offset).
    nameFormat: i64
    names: usize
    numNames: i64
    langTags: usize
    numLangTags: i64
    cmapOffset: u64
    cmapSize: u64
    glyfOffset: u64
    glyfLen: u64
    locaOffset: u64
    locaSize: u64
    numLocations: u64
    gaspOffset: u64
    gaspRanges: i64
    gaspVersion: i64
    // `kern`: the table, its subtables usable (bits) and those whose pairs
    // are in order (for a binary search).
    kernOffset: u64
    kernSize: u64
    kernTables: i64
    kernAvailBits: u64
    kernOrderBits: u64
    // `post` glyph names: an array of string addresses, made when first
    // asked for (0 when the table has none).
    postNames: usize
    numPostNames: i64
    postNamesLoaded: bool
    postNameStrings: usize
    // The PostScript name, made when first asked for.
    psName: usize
    psNameDone: bool
    nonVarStyleName: usize
    // What loading the SFNT part found: outlines, `sbix`.
    loadHasOutline: bool
    loadHasSbix: bool
    // The CFF or CFF2 font.
    cff: usize
    // Variations: the blend (axes, coordinates, the tables varying).
    blend: usize
    hasFvar: bool
    varDefaultNamedInstance: i64
    // Color: `COLR` and `CPAL`, the palette selected (FT_Color array),
    // the palette data and the foreground color.
    colrOffset: u64
    colrSize: u64
    cpalOffset: u64
    cpalSize: u64
    palette: usize
    paletteIndex: i64
    paletteData: usize
    // The tables' state (color.mlx).
    color: usize
    foreground: u32
    hasForeground: bool
    // Embedded bitmaps: their kind, the strikes and the map of the
    // public strikes to them.
    sbitKind: i64
    sbitTableOffset: u64
    sbitTableSize: u64
    sbitDataOffset: u64
    sbitDataSize: u64
    sbitStrikes: i64
    sbitStrikeMap: usize
    ebscOffset: u64
    // The transform of FT_Set_Transform.
    txx: i64
    txy: i64
    tyx: i64
    tyy: i64
    tdx: i64
    tdy: i64
    transformFlags: i64
    // Properties of the face (FT_Face_Properties).
    noStemDarkening: i64
    randomSeed: i64
    lcdWeights: u64
    hasLcdWeights: bool
    // The scratch memory of glyph loading: points, tags, contours.
    hdmxOffset: u64
    hdmxSize: u64
    hdmxRecords: i64
    hdmxRecordSize: u64
}

pub const Size = struct {
    face: usize
    // The size's metrics: pixels per em, the scales of font units to 26.6
    // pixels (16.16), and the face's global metrics scaled (26.6, on the
    // pixel grid).
    xPpem: u16
    yPpem: u16
    xScale: i64
    yScale: i64
    ascender: i64
    descender: i64
    height: i64
    maxAdvance: i64
    // The strike it selects (-1 none).
    strikeIndex: i64
    // TrueType's metrics for loading: the scales from the rounded ppem
    // when `head` asks for integer ppems.
    tt_x_ppem: i64
    tt_y_ppem: i64
    tt_x_scale: i64
    tt_y_scale: i64
    tt_ascender: i64
    tt_descender: i64
    tt_height: i64
    tt_max_advance: i64
    ttValid: bool
    // The face's next size.
    next: usize
    user: usize
}

pub const Slot = struct {
    library: usize
    face: usize
    // The face's next slot.
    next: usize
    glyphIndex: u32
    // The glyph's metrics (26.6, or font units when loaded unscaled), its
    // advances unhinted (16.16) and as loaded (26.6).
    metrics: r.GlyphMetrics
    linearHoriAdvance: i64
    linearVertAdvance: i64
    advance: r.Vector
    // What the slot holds: FORMAT_OUTLINE, FORMAT_BITMAP (the bitmap's
    // left and top in pixels from the origin), FORMAT_COMPOSITE (the
    // subglyphs of a composite loaded with LOAD_NO_RECURSE).
    format: u32
    bitmap: r.Bitmap
    bitmapLeft: i32
    bitmapTop: i32
    outline: r.Outline
    numSubglyphs: u32
    subglyphs: usize
    lsbDelta: i64
    rsbDelta: i64
    user: usize
    loadFlags: i64
    ownBitmap: bool
    // The outline's storage, grown as glyphs need it.
    points: usize
    tags: usize
    contours: usize
    pointsMax: i64
    contoursMax: i64
    // The storage of the subglyphs: index, flags, arg1, arg2, then a 2x2
    // matrix (8 words each).
    subglyphStore: usize
    subglyphsMax: i64
    // The TrueType glyph loader's record (made when first needed).
    loader: usize
}

// A charmap: its face, encoding and IDs, then the engine's own fields.
pub const CharMap = struct {
    face: usize
    encoding: u32
    platformId: u16
    encodingId: u16
    // The subtable's format, its address, its flags (unsorted or
    // overlapping segments).
    format: i64
    table: usize
    flags: i64
    // The state of walking a format 4 or 12 subtable.
    curCharcode: u64
    curGindex: u64
    curRange: u64
    curGroup: u64
    curStart: u64
    curEnd: u64
    curDelta: i64
    curValues: usize
    numRanges: u64
    valid: bool
    // The results of the format 14 functions.
    results: usize
    resultsMax: u64
    // Synthesized: 1 for the CFF encoding's charmap, 2 for a Unicode
    // charmap of glyph names (its table the map, numRanges its length).
    kind: i64
}

pub fn faceRecord(face: usize) -> *Face { unsafe { return @ptrFromInt(*Face, face) } }
pub fn faceOf(address: usize) -> *Face { unsafe { return @ptrFromInt(*Face, address) } }
pub fn sizeRecord(size: usize) -> *Size { unsafe { return @ptrFromInt(*Size, size) } }
pub fn slotRecord(slot: usize) -> *Slot { unsafe { return @ptrFromInt(*Slot, slot) } }
pub fn charMap(address: usize) -> *CharMap { unsafe { return @ptrFromInt(*CharMap, address) } }

pub fn memoryOf(face: usize) -> usize { return faceRecord(face).*.memory }

// The addresses of a slot's outline and bitmap.
pub fn slotOutline(slot: usize) -> usize { return slot + @offsetOf(Slot, "outline") }
pub fn slotBitmap(slot: usize) -> usize { return slot + @offsetOf(Slot, "bitmap") }

// The font's byte at `offset` and its big-endian values (0 past its end).
pub fn byteAt(f: *Face, offset: u64) -> i64 {
    if offset >= f.*.size { return 0 }
    return @intCast(i64, m.get8(f.*.data + offset))
}

// Whether `count` bytes from `offset` are in the font.
pub fn within(f: *Face, offset: u64, count: u64) -> bool { return offset <= f.*.size && count <= f.*.size - offset }

pub fn u16At(f: *Face, offset: u64) -> i64 {
    if !within(f, offset, 2) { return 0 }
    return @intCast(i64, m.u16be(f.*.data + offset))
}

pub fn i16At(f: *Face, offset: u64) -> i64 {
    if !within(f, offset, 2) { return 0 }
    return @intCast(i64, m.i16be(f.*.data + offset))
}

pub fn u32At(f: *Face, offset: u64) -> i64 {
    if !within(f, offset, 4) { return 0 }
    return @intCast(i64, m.u32be(f.*.data + offset))
}

pub fn i32At(f: *Face, offset: u64) -> i64 {
    if !within(f, offset, 4) { return 0 }
    return @intCast(i64, m.i32be(f.*.data + offset))
}

// The table `tag` of the face's directory: its offset and length (a
// length 0 when it has none, as for FreeType, which skips empty ones).
pub fn table(f: *Face, tag: u32) -> (u64, u64) {
    var i: i64 = 0
    while i < f.*.numTables {
        const entry = f.*.tables + @intCast(usize, i) * 16
        if m.get32(entry) == tag && m.get32(entry + 12) != 0 {
            return -> (@intCast(u64, m.get32(entry + 8)), @intCast(u64, m.get32(entry + 12)))
        }
        i += 1
    }
    return -> (0, 0)
}

pub fn hasTable(f: *Face, tag: u32) -> bool { return table(f, tag).1 != 0 }

pub fn tag(a: u8, b: u8, c: u8, d: u8) -> u32 { return (@intCast(u32, a) << 24) | (@intCast(u32, b) << 16) | (@intCast(u32, c) << 8) | @intCast(u32, d) }

pub const TAG_head: u32 = 0x68656164
pub const TAG_bhed: u32 = 0x62686564
pub const TAG_maxp: u32 = 0x6D617870
pub const TAG_cmap: u32 = 0x636D6170
pub const TAG_name: u32 = 0x6E616D65
pub const TAG_post: u32 = 0x706F7374
pub const TAG_hhea: u32 = 0x68686561
pub const TAG_hmtx: u32 = 0x686D7478
pub const TAG_vhea: u32 = 0x76686561
pub const TAG_vmtx: u32 = 0x766D7478
pub const TAG_OS2: u32 = 0x4F532F32
pub const TAG_PCLT: u32 = 0x50434C54
pub const TAG_gasp: u32 = 0x67617370
pub const TAG_kern: u32 = 0x6B65726E
pub const TAG_glyf: u32 = 0x676C7966
pub const TAG_loca: u32 = 0x6C6F6361
pub const TAG_CFF: u32 = 0x43464620
pub const TAG_CFF2: u32 = 0x43464632
pub const TAG_fvar: u32 = 0x66766172
pub const TAG_avar: u32 = 0x61766172
pub const TAG_gvar: u32 = 0x67766172
pub const TAG_HVAR: u32 = 0x48564152
pub const TAG_VVAR: u32 = 0x56564152
pub const TAG_MVAR: u32 = 0x4D564152
pub const TAG_COLR: u32 = 0x434F4C52
pub const TAG_CPAL: u32 = 0x4350414C
pub const TAG_CBLC: u32 = 0x43424C43
pub const TAG_CBDT: u32 = 0x43424454
pub const TAG_EBLC: u32 = 0x45424C43
pub const TAG_EBDT: u32 = 0x45424454
pub const TAG_EBSC: u32 = 0x45425343
pub const TAG_bloc: u32 = 0x626C6F63
pub const TAG_bdat: u32 = 0x62646174
pub const TAG_sbix: u32 = 0x73626978
pub const TAG_SVG: u32 = 0x53564720
pub const TAG_hdmx: u32 = 0x68646D78
pub const TAG_ttcf: u32 = 0x74746366
pub const TAG_OTTO: u32 = 0x4F54544F
pub const TAG_true: u32 = 0x74727565
pub const TAG_typ1: u32 = 0x74797031
