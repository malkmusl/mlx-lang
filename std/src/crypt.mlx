// std.crypt: the password hashes of /etc/shadow, the way crypt(3) of
// glibc and libxcrypt write them, in Mlx and without libc. A login
// program hashes the password it was given under the stored hash as the
// setting and compares the two; that is what `verify` does.
//
//     if crypt.verify(password, stored) { ... }
//
//     var out: [256]u8 = undefined
//     const length = crypt.hash(password, setting, &out, 256)  // 0: no
//
// A setting is a stored hash, or just its prefix: "$6$SALT",
// "$6$rounds=100000$SALT", "$y$j9T$SALT". What it knows:
//
//     $y$   yescrypt       (Debian's and Ubuntu's default)
//     $7$   scrypt
//     $6$   SHA-512 crypt
//     $5$   SHA-256 crypt
//
// The buffers the password passes through are wiped when they are done
// with. The DES and MD5 hashes ($1$, $2a$, no prefix) are not here:
// nothing should still be using them, and a login that cannot read a
// hash refuses rather than letting anyone in.
const sha2 = @import("std.sha2")
const shacrypt = @import("std.crypt.shacrypt")
const yescrypt = @import("std.crypt.yescrypt")

// Room enough for any hash this writes ($6$rounds=999999999$ and 16
// characters of salt and 86 of SHA-512: 123).
pub const MOST: usize = 256

// The hash of `password` under `setting` into `out` (at most `capacity`
// bytes): its length, or 0 when the setting is not one this knows, the
// password is longer than the hash takes, or it does not fit.
pub fn hash(password: []const u8, setting: []const u8, out: [*]u8, capacity: usize) -> usize {
    sha2.wipe(out, capacity)
    if setting.length < 3 || setting[0] != 36 { return 0 }
    if setting[2] == 36 {
        if setting[1] == 121 || setting[1] == 55 { return yescrypt.hash(password, setting, out, capacity) }
        if setting[1] == 54 { return shacrypt.hash(password, setting, true, out, capacity) }
        if setting[1] == 53 { return shacrypt.hash(password, setting, false, out, capacity) }
    }
    return 0
}

// Whether `password` is the one `stored` holds. The comparison looks at
// every byte either way, so it takes the same time wherever the two
// differ; a hash this cannot read is a no.
pub fn verify(password: []const u8, stored: []const u8) -> bool {
    var ours: [MOST]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &ours) }
    const length = hash(password, stored, bytes, MOST)
    var difference: u32 = if length > 0 && length == stored.length { 0 } else { 1 }
    var index: usize = 0
    while index < MOST {
        const theirs: u8 = if index < stored.length { stored[index] } else { 0 }
        difference = difference | @intCast(u32, bytes[index] ^ theirs)
        index += 1
    }
    sha2.wipe(bytes, MOST)
    return difference == 0
}
