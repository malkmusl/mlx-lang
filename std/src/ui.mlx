// std.ui: layout building blocks for pixel user interfaces.
//
// Everything here is integer layout math on screen pixels (x to the right,
// y down) and knows nothing about the renderer: a layout hands out
// rectangles, and the caller draws into them with whatever it has (the CPU,
// the Vulkan `text` shader of examples/vulkan-shared, ...). fillRect is the
// one drawing helper, for 0xAARRGGBB pixel buffers.
//
//     var screen = ui.screen(width, height, ui.insets(status_bar, 0, 0, 0))
//     const bar = ui.reserveTop(&screen, 48)          // a top bar
//     const title = ui.place(bar.content, label_size, ui.alignment(ui.Align.center, ui.Align.center))
//     // screen.free is what is left for the content below the bar.
//
// See docs/reference/ui.md.

// ── Geometry ──────────────────────────────────────────────────────────────

pub const Rect = struct {
    x: i32
    y: i32
    width: i32
    height: i32
}

pub const Size = struct {
    width: i32
    height: i32
}

// Space kept free at each edge (padding, system bars, display cutouts).
pub const Insets = struct {
    top: i32
    right: i32
    bottom: i32
    left: i32
}

pub fn rect(x: i32, y: i32, width: i32, height: i32) -> Rect {
    return Rect.{ .x = x, .y = y, .width = width, .height = height }
}

pub fn size(width: i32, height: i32) -> Size {
    return Size.{ .width = width, .height = height }
}

pub fn insets(top: i32, right: i32, bottom: i32, left: i32) -> Insets {
    return Insets.{ .top = top, .right = right, .bottom = bottom, .left = left }
}

// The same space on every edge.
pub fn uniform(value: i32) -> Insets {
    return insets(value, value, value, value)
}

// `vertical` at the top and bottom, `horizontal` left and right.
pub fn symmetric(vertical: i32, horizontal: i32) -> Insets {
    return insets(vertical, horizontal, vertical, horizontal)
}

fn atLeastZero(value: i32) -> i32 {
    if value < 0 { return 0 }
    return value
}

fn smaller(a: i32, b: i32) -> i32 {
    if a < b { return a }
    return b
}

fn larger(a: i32, b: i32) -> i32 {
    if a > b { return a }
    return b
}

// The first column and row past the rectangle.
pub fn right(area: Rect) -> i32 {
    return area.x + area.width
}

pub fn bottom(area: Rect) -> i32 {
    return area.y + area.height
}

pub fn isEmpty(area: Rect) -> bool {
    return area.width <= 0 || area.height <= 0
}

pub fn contains(area: Rect, x: i32, y: i32) -> bool {
    return x >= area.x && y >= area.y && x < right(area) && y < bottom(area)
}

// The overlap of two rectangles (empty, with a size of 0, when they do not
// overlap).
pub fn intersect(a: Rect, b: Rect) -> Rect {
    const x = larger(a.x, b.x)
    const y = larger(a.y, b.y)
    const width = atLeastZero(smaller(right(a), right(b)) - x)
    const height = atLeastZero(smaller(bottom(a), bottom(b)) - y)
    return rect(x, y, width, height)
}

// The rectangle shrunk by `edges`; it never gets a negative size.
pub fn inset(area: Rect, edges: Insets) -> Rect {
    const width = atLeastZero(area.width - edges.left - edges.right)
    const height = atLeastZero(area.height - edges.top - edges.bottom)
    return rect(area.x + edges.left, area.y + edges.top, width, height)
}

// ── Alignment ─────────────────────────────────────────────────────────────

// Where a child goes along one axis: at the start (left or top), centered,
// at the end, or stretched to fill the space.
pub const Align = enum(u8) { start, center, end, fill }

pub const Alignment = struct {
    horizontal: Align
    vertical: Align
}

pub fn alignment(horizontal: Align, vertical: Align) -> Alignment {
    return Alignment.{ .horizontal = horizontal, .vertical = vertical }
}

pub fn topLeft() -> Alignment { return alignment(Align.start, Align.start) }
pub fn topCenter() -> Alignment { return alignment(Align.center, Align.start) }
pub fn topRight() -> Alignment { return alignment(Align.end, Align.start) }
pub fn centerLeft() -> Alignment { return alignment(Align.start, Align.center) }
pub fn centered() -> Alignment { return alignment(Align.center, Align.center) }
pub fn centerRight() -> Alignment { return alignment(Align.end, Align.center) }
pub fn bottomLeft() -> Alignment { return alignment(Align.start, Align.end) }
pub fn bottomCenter() -> Alignment { return alignment(Align.center, Align.end) }
pub fn bottomRight() -> Alignment { return alignment(Align.end, Align.end) }
pub fn stretch() -> Alignment { return alignment(Align.fill, Align.fill) }

// The offset of a `length` child in `space` pixels. A centered child that
// does not fit overflows both ends equally (rounded toward the start).
fn alignOffset(space: i32, length: i32, align_to: Align) -> i32 {
    if align_to == Align.center {
        const spare = space - length
        // Floor division, so odd negative leftovers round the same way.
        if spare < 0 { return -((1 - spare) / 2) }
        return spare / 2
    }
    if align_to == Align.end { return space - length }
    return 0
}

fn alignLength(space: i32, length: i32, align_to: Align) -> i32 {
    if align_to == Align.fill { return space }
    return length
}

// Where a child of `child` size goes inside `outer`. The child keeps its
// size (except along a `fill` axis) even when it does not fit, so the
// caller decides whether to clip it (see intersect).
pub fn place(outer: Rect, child: Size, where: Alignment) -> Rect {
    const width = alignLength(outer.width, child.width, where.horizontal)
    const height = alignLength(outer.height, child.height, where.vertical)
    const x = outer.x + alignOffset(outer.width, width, where.horizontal)
    const y = outer.y + alignOffset(outer.height, height, where.vertical)
    return rect(x, y, width, height)
}

// ── Cutting bands off an area ─────────────────────────────────────────────

// Takes `amount` pixels (at most what is there) off one edge of `area`,
// returns that band and leaves the rest in `area`.
pub fn takeTop(area: *Rect, amount: i32) -> Rect {
    const taken = smaller(atLeastZero(amount), area.*.height)
    const band = rect(area.*.x, area.*.y, area.*.width, taken)
    area.*.y = area.*.y + taken
    area.*.height = area.*.height - taken
    return band
}

pub fn takeBottom(area: *Rect, amount: i32) -> Rect {
    const taken = smaller(atLeastZero(amount), area.*.height)
    area.*.height = area.*.height - taken
    return rect(area.*.x, area.*.y + area.*.height, area.*.width, taken)
}

pub fn takeLeft(area: *Rect, amount: i32) -> Rect {
    const taken = smaller(atLeastZero(amount), area.*.width)
    const band = rect(area.*.x, area.*.y, taken, area.*.height)
    area.*.x = area.*.x + taken
    area.*.width = area.*.width - taken
    return band
}

pub fn takeRight(area: *Rect, amount: i32) -> Rect {
    const taken = smaller(atLeastZero(amount), area.*.width)
    area.*.width = area.*.width - taken
    return rect(area.*.x + area.*.width, area.*.y, taken, area.*.height)
}

// ── Container ─────────────────────────────────────────────────────────────

// A box that holds one child: `padding` inside its bounds, and the child
// aligned in what is left.
pub const Container = struct {
    bounds: Rect
    padding: Insets
    alignment: Alignment
}

pub fn container(bounds: Rect, padding: Insets, where: Alignment) -> Container {
    return Container.{ .bounds = bounds, .padding = padding, .alignment = where }
}

// The area inside the padding.
pub fn content(box: *const Container) -> Rect {
    return inset(box.*.bounds, box.*.padding)
}

// Where a child of `child` size goes.
pub fn placeIn(box: *const Container, child: Size) -> Rect {
    return place(content(box), child, box.*.alignment)
}

// ── Stack ─────────────────────────────────────────────────────────────────

pub const Axis = enum(u8) { horizontal, vertical }

// Children one after another along `axis` with `spacing` between them,
// each aligned across the axis by `cross`. Children past the end of the
// area still get a rectangle (outside it); check with isEmpty(intersect(..)).
pub const Stack = struct {
    area: Rect
    axis: Axis
    spacing: i32
    cross: Align
    // Pixels used along the axis so far, and children placed.
    used: i32
    count: u32
}

pub fn stack(area: Rect, axis: Axis, spacing: i32, cross: Align) -> Stack {
    return Stack.{ .area = area, .axis = axis, .spacing = spacing, .cross = cross, .used = 0, .count = 0 }
}

// The rectangle for the next child.
pub fn next(line: *Stack, child: Size) -> Rect {
    const area = line.*.area
    var used = line.*.used
    if line.*.count > 0 { used = used + line.*.spacing }
    var placed = rect(0, 0, 0, 0)
    if line.*.axis == Axis.horizontal {
        const height = alignLength(area.height, child.height, line.*.cross)
        placed = rect(area.x + used, area.y + alignOffset(area.height, height, line.*.cross), child.width, height)
        used = used + child.width
    } else {
        const width = alignLength(area.width, child.width, line.*.cross)
        placed = rect(area.x + alignOffset(area.width, width, line.*.cross), area.y + used, width, child.height)
        used = used + child.height
    }
    line.*.used = used
    line.*.count = line.*.count + 1
    return placed
}

// ── Screen ────────────────────────────────────────────────────────────────

// A whole surface: its `bounds`, the `safe` insets the system covers
// (status and navigation bars, cutouts) and the `free` area not yet
// reserved. Reserving a bar takes it from the free area.
pub const Screen = struct {
    bounds: Rect
    safe: Insets
    free: Rect
}

// A reserved bar: `area` reaches the screen edge (paint its background
// there, behind a system bar); `content` is the part clear of the system
// insets, for its children.
pub const Band = struct {
    area: Rect
    content: Rect
}

pub fn screen(width: i32, height: i32, safe: Insets) -> Screen {
    const bounds = rect(0, 0, width, height)
    return Screen.{ .bounds = bounds, .safe = safe, .free = inset(bounds, safe) }
}

// A bar of `height` content pixels along the top of the free area. The
// first bar at the top also covers the top safe inset.
pub fn reserveTop(surface: *Screen, height: i32) -> Band {
    var free = surface.*.free
    const content_band = takeTop(&free, height)
    surface.*.free = free
    var area = content_band
    if content_band.y == surface.*.bounds.y + surface.*.safe.top {
        area.y = surface.*.bounds.y
        area.height = area.height + surface.*.safe.top
    }
    // Side insets still apply to the content, not to the background.
    area.x = surface.*.bounds.x
    area.width = surface.*.bounds.width
    return Band.{ .area = area, .content = content_band }
}

// The same along the bottom (the first one also covers the bottom inset).
pub fn reserveBottom(surface: *Screen, height: i32) -> Band {
    var free = surface.*.free
    const content_band = takeBottom(&free, height)
    surface.*.free = free
    var area = content_band
    if bottom(content_band) == bottom(surface.*.bounds) - surface.*.safe.bottom {
        area.height = area.height + surface.*.safe.bottom
    }
    area.x = surface.*.bounds.x
    area.width = surface.*.bounds.width
    return Band.{ .area = area, .content = content_band }
}

// ── Drawing ───────────────────────────────────────────────────────────────

// Blends `color` (0xAARRGGBB, straight alpha) over the part of `area`
// inside a `width` x `height` buffer of 0xAARRGGBB pixels, `stride` pixels
// per row. The arithmetic is the text shader's (and std.truetype.drawRun's)
// at full coverage: alpha = (255 * a + 127) / 255, each channel
// (color * alpha + under * (255 - alpha) + 127) / 255, result opaque.
pub fn fillRect(pixels: [*]u32, width: usize, height: usize, stride: usize, area: Rect, color: u32) -> void {
    const clipped = intersect(area, rect(0, 0, @intCast(i32, width), @intCast(i32, height)))
    if isEmpty(clipped) { return }
    const alpha = ((color >> 24) * 255 + 127) / 255
    const inverse = 255 - alpha
    var y = clipped.y
    while y < bottom(clipped) {
        var index = @intCast(usize, y) * stride + @intCast(usize, clipped.x)
        const end_index = index + @intCast(usize, clipped.width)
        while index < end_index {
            const under = pixels[index]
            var result: u32 = 4278190080
            var shift: u32 = 0
            while shift < 24 {
                const mixed = (((color >> shift) & 255) * alpha + ((under >> shift) & 255) * inverse + 127) / 255
                result = result | (mixed << shift)
                shift += 8
            }
            pixels[index] = result
            index += 1
        }
        y += 1
    }
}
