// std.colorprofile: ICC colour management as Little CMS (2.14) does it,
// to the bit: ICC v2 and v4 profiles read (the header, the tag
// directory, XYZ numbers, `curv` and `para` tone curves, `chad`, and the
// LUT-based transforms `mft1`, `mft2`, `mAB `, `mBA `), the profiles
// Little CMS builds in memory (sRGB, RGB of primaries and curves, grey,
// XYZ), and colour transforms between them for the four ICC intents on
// 8- and 16-bit pixels (RGB, RGBA, BGRA, ARGB, grey, CMYK... in Little
// CMS's format words), made of the profiles' pipelines as Little CMS
// links and optimizes them (the matrix-shaper in 1.14 fixed point, the
// prelinearized 8-bit grid, the resampled grid with its white fixed),
// so that their pixels are the ones Little CMS gives.
//
// The parts are Little CMS's: std/src/colorprofile/curve.mlx (tone
// curves), interp.mlx (grid interpolation), pipeline.mlx (stages and
// pipelines), matrix.mlx (3 x 3 matrices, chromatic adaptation),
// profile.mlx (reading and building profiles), link.mlx (intents),
// optimize.mlx, format.mlx and transform.mlx. The C API of Little CMS
// (compiler/capi/lcms2, <lcms2.h>) is made of them.
//
//     const allocator = std.page_allocator.init()
//     const icc = colorprofile.openProfile(allocator, bytes, length)
//     const srgb = colorprofile.createSRGBProfile(allocator)
//     const t = colorprofile.createTransform(allocator, icc, colorprofile.TYPE_BGRA_8, srgb, colorprofile.TYPE_BGRA_8, colorprofile.INTENT_RELATIVE_COLORIMETRIC, 0)
//     colorprofile.transformPixels(t, row, row, width)
//
// Not done: black point compensation, the float tags (D2Bn, B2Dn),
// named colours, floating-point pixel formats, gamut checks and proofing.
pub const mem = @import("./colorprofile/mem.mlx")
pub const curve = @import("./colorprofile/curve.mlx")
pub const interp = @import("./colorprofile/interp.mlx")
pub const pipeline = @import("./colorprofile/pipeline.mlx")
pub const matrix = @import("./colorprofile/matrix.mlx")
pub const profile = @import("./colorprofile/profile.mlx")
pub const link = @import("./colorprofile/link.mlx")
pub const optimize = @import("./colorprofile/optimize.mlx")
pub const format = @import("./colorprofile/format.mlx")
pub const transform = @import("./colorprofile/transform.mlx")

pub const Allocator = mem.Allocator

pub const INTENT_PERCEPTUAL: u64 = 0
pub const INTENT_RELATIVE_COLORIMETRIC: u64 = 1
pub const INTENT_SATURATION: u64 = 2
pub const INTENT_ABSOLUTE_COLORIMETRIC: u64 = 3

// Pixel formats (lcms2.h's TYPE_ words).
pub const TYPE_GRAY_8: u64 = 0x30009
pub const TYPE_GRAY_16: u64 = 0x3000a
pub const TYPE_GRAYA_8: u64 = 0x30089
pub const TYPE_RGB_8: u64 = 0x40019
pub const TYPE_RGB_16: u64 = 0x4001a
pub const TYPE_BGR_8: u64 = 0x40419
pub const TYPE_RGBA_8: u64 = 0x40099
pub const TYPE_RGBA_16: u64 = 0x4009a
pub const TYPE_ARGB_8: u64 = 0x44099
pub const TYPE_BGRA_8: u64 = 0x44499
pub const TYPE_ABGR_8: u64 = 0x40499

// The profile of LENGTH bytes at DATA (copied); 0 when it is not one.
pub fn openProfile(allocator: Allocator, data: [*]const u8, length: usize) -> usize {
    return profile.open(allocator, @intFromPtr(data), length)
}

pub fn createSRGBProfile(allocator: Allocator) -> usize { return profile.createSRGB(allocator) }

pub fn closeProfile(address: usize) -> void { profile.close(address) }

// The profile's colour space signature ('RGB ', 'GRAY', ...).
pub fn colorSpace(address: usize) -> u64 { return profile.profileAt(address).*.colorSpace }

pub fn createTransform(allocator: Allocator, input: usize, inputFormat: u64, output: usize, outputFormat: u64, intent: u64, flags: u64) -> usize {
    return transform.create(allocator, input, inputFormat, output, outputFormat, intent, flags)
}

pub fn deleteTransform(address: usize) -> void { transform.delete(address) }

pub fn transformPixels(address: usize, input: [*]const u8, output: [*]u8, count: usize) -> void {
    transform.transform(address, @intFromPtr(input), @intFromPtr(output), count)
}
