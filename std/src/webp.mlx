// std.webp: WebP pictures decoded as libwebp (1.3.2) decodes them, byte
// for byte: lossy (VP8) with its loop filter and fancy upsampling, lossless
// (VP8L) with its transforms and colour cache, the alpha of lossy
// pictures (ALPH, raw or lossless, filtered), the extended format (VP8X),
// and animations (ANIM, ANMF) through the demuxer. The parts are
// libwebp's: std/src/webp/vp8.mlx, vp8l.mlx, alpha.mlx, io.mlx (the
// output colour spaces), decode.mlx (the container, WebPDecode and the
// incremental decoder) and demux.mlx (WebPDemux). The libwebp C API
// (compiler/libc/webp) is made of the same parts.
//
//     var picture: webp.Picture = undefined
//     if webp.decodeRgba(&picture, file, length, allocator) == webp.Status.ok { ... }
//     webp.deinitPicture(&picture)
//
// decodeRgba gives a still picture (or an animation's first frame as
// is) as 8-bit RGBA, not premultiplied. A file cut short does not decode
// (the incremental decoder, decode.newDecoder, gives what there is).
//
// Encoding is lossless (std/src/webp/encode.mlx, not libwebp's encoder:
// larger files, the exact pixels), with the muxer (mux.mlx) for metadata
// chunks and animations:
//
//     var out: webp.encode.Bytes = undefined
//     webp.encode.initBytes(&out, allocator)
//     if webp.encodeRgba(&out, pixels, width, height) { ... out.data, out.size ... }
//     webp.encode.freeBytes(&out)
const allocator_module = @import("../bootstrap/allocator.mlx")
pub const io = @import("./webp/io.mlx")
pub const decode = @import("./webp/decode.mlx")
pub const demux = @import("./webp/demux.mlx")
pub const anim = @import("./webp/anim.mlx")
pub const encode = @import("./webp/encode.mlx")
pub const mux = @import("./webp/mux.mlx")
pub const vp8 = @import("./webp/vp8.mlx")
pub const vp8l = @import("./webp/vp8l.mlx")

pub const Allocator = allocator_module.Allocator

pub const Status = enum(u8) {
    ok,
    notWebP,
    unsupported,
    corrupt,
    noMemory
}

pub fn statusMessage(status: Status) -> []const u8 {
    if status == Status.ok { return "ok" }
    if status == Status.notWebP { return "not a WebP file" }
    if status == Status.unsupported { return "unsupported WebP feature" }
    if status == Status.noMemory { return "out of memory" }
    return "corrupt WebP data"
}

pub const Picture = struct {
    width: usize
    height: usize
    // width * height * 4 bytes: R, G, B, A (not premultiplied).
    pixels: [*]u8
    hasAlpha: bool
    allocator: Allocator
    size: usize
}

pub fn deinitPicture(picture: *Picture) -> void {
    io.release(picture.*.allocator, @intFromPtr(picture.*.pixels), picture.*.size)
    picture.*.size = 0
}

fn statusOf(code: i32) -> Status {
    if code == io.OK { return Status.ok }
    if code == io.OUT_OF_MEMORY { return Status.noMemory }
    if code == io.UNSUPPORTED_FEATURE { return Status.unsupported }
    return Status.corrupt
}

// The picture of a WebP file (an animation's first frame, as stored).
pub fn decodeRgba(picture: *Picture, data: [*]const u8, length: usize, allocator: Allocator) -> Status {
    picture.*.allocator = allocator
    picture.*.size = 0
    const address = @intFromPtr(data)
    // A RIFF file of WebP, or a VP8 or VP8L stream as it is.
    const riff = length >= 12 && decode.isTag(address, "RIFF") && decode.isTag(address + 8, "WEBP")
    const raw = vp8l.checkSignature(address, length) || (length >= 10 && vp8.checkSignature(address + 3, length - 3))
    if !riff && !raw { return Status.notWebP }
    var features: io.Features = undefined
    const status = decode.getFeatures(address, length, &features)
    if status != io.OK {
        if status == io.NOT_ENOUGH_DATA { return Status.corrupt }
        return statusOf(status)
    }
    var start = address
    var size = length
    if features.hasAnimation != 0 {
        var state: i32 = 0
        const d = demux.create(address, length, false, &state, allocator)
        if d == 0 { return Status.corrupt }
        var frame: demux.Iterator = undefined
        const found = demux.getFrame(d, 1, &frame)
        demux.delete(d)
        if !found { return Status.corrupt }
        start = frame.fragmentBytes
        size = frame.fragmentSize
    }
    var output: io.Buffer = undefined
    io.zero(@intFromPtr(&output), @sizeOf(io.Buffer))
    output.colorspace = io.MODE_RGBA
    var p: io.Params = undefined
    io.resetParams(&p, allocator)
    p.output = @intFromPtr(&output)
    const result = decode.decodeInto(start, size, &p)
    if result != io.OK { return statusOf(result) }
    picture.*.width = @intCast(usize, output.width)
    picture.*.height = @intCast(usize, output.height)
    picture.*.pixels = unsafe { @ptrFromInt([*]u8, output.privateMemory) }
    picture.*.size = output.privateSize
    picture.*.hasAlpha = features.hasAlpha != 0
    return Status.ok
}

// RGBA pixels (WIDTH x HEIGHT, 4 bytes each, rows one after the other)
// as a lossless WebP file, onto OUT.
pub fn encodeRgba(out: *encode.Bytes, pixels: [*]const u8, width: usize, height: usize) -> bool {
    const count = width * height
    const argb = io.allocate(out.*.allocator, 4 * count)
    if argb == 0 { return false }
    var i: usize = 0
    while i < count {
        const r = @intCast(u64, pixels[4 * i])
        const g = @intCast(u64, pixels[4 * i + 1])
        const b = @intCast(u64, pixels[4 * i + 2])
        const a = @intCast(u64, pixels[4 * i + 3])
        io.put32(argb + 4 * i, (a << 24) | (r << 16) | (g << 8) | b)
        i += 1
    }
    const ok = encode.encodeFile(out, argb, width, height, width)
    io.release(out.*.allocator, argb, 4 * count)
    return ok
}
