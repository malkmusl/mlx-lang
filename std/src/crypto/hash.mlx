// std.crypto.hash: the hashes TLS and X.509 name, behind one state
// (SHA-1, SHA-256, SHA-384, SHA-512 of std.sha1 and std.sha2), and what
// is built on any of them: HMAC (RFC 2104) and HKDF (RFC 5869).
//
//     var hashing: hash.Hash = undefined
//     hash.init(&hashing, hash.Algorithm.sha384)
//     hash.update(&hashing, bytes)
//     hash.peek(&hashing, out)            // the digest so far; goes on
//     hash.finish(&hashing, out)          // digestLength bytes; wipes
//
//     hash.hmac(algorithm, key, message, out)
//     hash.hkdfExtract(algorithm, salt, secret, prk)
//     hash.hkdfExpand(algorithm, prk, info, out, length)
//
// A TLS handshake hashes its transcript as it goes and asks for the
// digest at several points of it: peek finishes a copy of the state.

const std = @import("std")
const sha1 = @import("../sha1.mlx")
const sha2 = @import("../sha2.mlx")

pub const Algorithm = enum(u8) {
    sha1,
    sha256,
    sha384,
    sha512,
}

// The longest digest and block: SHA-512's.
pub const MAX_DIGEST: usize = 64
pub const MAX_BLOCK: usize = 128

// One state for each family; `algorithm` says which is in use.
pub const Hash = struct {
    algorithm: Algorithm
    old: sha1.Sha1
    small: sha2.Sha256
    large: sha2.Sha512
}

// HMAC's two hashes, the inner one running, the outer one keyed and
// waiting for the inner digest.
pub const Hmac = struct {
    inner: Hash
    outer: Hash
}

pub fn digestLength(algorithm: Algorithm) -> usize {
    return match algorithm {
        Algorithm.sha1 => 20,
        Algorithm.sha256 => 32,
        Algorithm.sha384 => 48,
        Algorithm.sha512 => 64,
    }
}

pub fn blockLength(algorithm: Algorithm) -> usize {
    return match algorithm {
        Algorithm.sha1 => 64,
        Algorithm.sha256 => 64,
        Algorithm.sha384 => 128,
        Algorithm.sha512 => 128,
    }
}

// Zeroes `length` bytes (what a key or a secret left behind).
pub fn wipe(bytes: [*]u8, length: usize) -> void {
    var index: usize = 0
    while index < length {
        bytes[index] = 0
        index += 1
    }
}

pub fn init(hashing: *Hash, algorithm: Algorithm) -> void {
    hashing.*.algorithm = algorithm
    match algorithm {
        Algorithm.sha1 => sha1.sha1Init(&hashing.*.old),
        Algorithm.sha256 => sha2.sha256Init(&hashing.*.small),
        Algorithm.sha384 => sha2.sha384Init(&hashing.*.large),
        Algorithm.sha512 => sha2.sha512Init(&hashing.*.large),
    }
}

pub fn update(hashing: *Hash, bytes: []const u8) -> void {
    match hashing.*.algorithm {
        Algorithm.sha1 => sha1.sha1Update(&hashing.*.old, bytes),
        Algorithm.sha256 => sha2.sha256Update(&hashing.*.small, bytes),
        Algorithm.sha384 => sha2.sha512Update(&hashing.*.large, bytes),
        Algorithm.sha512 => sha2.sha512Update(&hashing.*.large, bytes),
    }
}

// The digest into `out` (digestLength bytes); the state is wiped.
pub fn finish(hashing: *Hash, out: [*]u8) -> void {
    match hashing.*.algorithm {
        Algorithm.sha1 => sha1.sha1Final(&hashing.*.old, unsafe { @ptrCast(*[20]u8, out) }),
        Algorithm.sha256 => sha2.sha256Final(&hashing.*.small, unsafe { @ptrCast(*[32]u8, out) }),
        Algorithm.sha384 => sha2.sha384Final(&hashing.*.large, unsafe { @ptrCast(*[48]u8, out) }),
        Algorithm.sha512 => sha2.sha512Final(&hashing.*.large, unsafe { @ptrCast(*[64]u8, out) }),
    }
}

// The digest of what was hashed so far, the state going on as it was.
pub fn peek(hashing: *Hash, out: [*]u8) -> void {
    var copy: Hash = hashing.*
    finish(&copy, out)
}

pub fn digest(algorithm: Algorithm, bytes: []const u8, out: [*]u8) -> void {
    var hashing: Hash = undefined
    init(&hashing, algorithm)
    update(&hashing, bytes)
    finish(&hashing, out)
}

// ---------------------------------------------------------------------------
// HMAC (RFC 2104): H(K ^ opad, H(K ^ ipad, message)), a key longer than
// the block hashed first.

pub fn hmacInit(keyed: *Hmac, algorithm: Algorithm, key: []const u8) -> void {
    const block = blockLength(algorithm)
    var pad: [128]u8 = undefined
    const padding: [*]u8 = &pad
    wipe(padding, 128)
    if key.length > block {
        digest(algorithm, key, padding)
    } else {
        var index: usize = 0
        while index < key.length {
            pad[index] = key[index]
            index += 1
        }
    }
    var index: usize = 0
    while index < block {
        pad[index] = pad[index] ^ 54
        index += 1
    }
    init(&keyed.*.inner, algorithm)
    update(&keyed.*.inner, padding[0..block])
    index = 0
    while index < block {
        // 0x36 ^ 0x5c: from the inner pad to the outer one.
        pad[index] = pad[index] ^ 106
        index += 1
    }
    init(&keyed.*.outer, algorithm)
    update(&keyed.*.outer, padding[0..block])
    wipe(padding, 128)
}

pub fn hmacUpdate(keyed: *Hmac, bytes: []const u8) -> void {
    update(&keyed.*.inner, bytes)
}

// The MAC into `out` (digestLength bytes); both states are wiped.
pub fn hmacFinish(keyed: *Hmac, out: [*]u8) -> void {
    var inner: [64]u8 = undefined
    const bytes: [*]u8 = &inner
    const length = digestLength(keyed.*.inner.algorithm)
    finish(&keyed.*.inner, bytes)
    update(&keyed.*.outer, bytes[0..length])
    finish(&keyed.*.outer, out)
    wipe(bytes, 64)
}

pub fn hmac(algorithm: Algorithm, key: []const u8, message: []const u8, out: [*]u8) -> void {
    var keyed: Hmac = undefined
    hmacInit(&keyed, algorithm, key)
    hmacUpdate(&keyed, message)
    hmacFinish(&keyed, out)
}

// ---------------------------------------------------------------------------
// HKDF (RFC 5869).

// PRK = HMAC(salt, secret) into `prk` (digestLength bytes). An empty
// salt is a block of zeroes, which HMAC makes of an empty key anyway.
pub fn hkdfExtract(algorithm: Algorithm, salt: []const u8, secret: []const u8, prk: [*]u8) -> void {
    hmac(algorithm, salt, secret, prk)
}

// T(1) | T(2) | ... cut to `length` bytes (at most 255 digests), where
// T(i) = HMAC(PRK, T(i-1) | info | i).
pub fn hkdfExpand(algorithm: Algorithm, prk: []const u8, info: []const u8, out: [*]u8, length: usize) -> bool {
    const size = digestLength(algorithm)
    if length > 255 * size { return false }
    var block: [64]u8 = undefined
    const previous: [*]u8 = &block
    var made: usize = 0
    var counter: [1]u8 = [1]u8{ 0 }
    const count: [*]u8 = &counter
    var keyed: Hmac = undefined
    while made < length {
        hmacInit(&keyed, algorithm, prk)
        if made != 0 { hmacUpdate(&keyed, previous[0..size]) }
        hmacUpdate(&keyed, info)
        counter[0] = counter[0] + 1
        hmacUpdate(&keyed, count[0..1])
        hmacFinish(&keyed, previous)
        var index: usize = 0
        while index < size && made < length {
            out[made] = block[index]
            made += 1
            index += 1
        }
    }
    wipe(previous, 64)
    return true
}

// Whether two byte runs are the same, in a time that does not depend on
// where they differ (for MACs and tags).
pub fn equal(a: [*]const u8, b: [*]const u8, length: usize) -> bool {
    var difference: u64 = 0
    var index: usize = 0
    while index < length {
        difference = difference | @intCast(u64, a[index] ^ b[index])
        index += 1
    }
    return difference == 0
}
