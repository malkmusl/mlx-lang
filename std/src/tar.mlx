// std.tar: the files of a tar archive (POSIX ustar, as npm, GNU tar and
// the rest write it) held in memory:
//
//     const tar = @import("std.tar")
//     var reader = tar.reader(data, length)
//     var entry: tar.Entry = undefined
//     while tar.next(&reader, &entry) { ... entry.name, entry.data[0..entry.size] ... }
//
// Regular files only are given; directories, links and the rest are
// passed over. Names are the header's prefix and name joined ("a/b");
// GNU long names and pax headers are not read.

pub const Entry = struct {
    // The name, at most 256 bytes ("prefix/name").
    nameBytes: [257]u8
    nameLength: usize
    data: [*]const u8
    size: usize
}

pub const Reader = struct {
    data: [*]const u8
    length: usize
    at: usize
}

pub fn reader(data: [*]const u8, length: usize) -> Reader {
    return Reader.{ .data = data, .length = length, .at = 0 }
}

pub fn name(entry: *const Entry) -> []const u8 {
    const bytes: [*]const u8 = unsafe { @ptrCast([*]const u8, &entry.*.nameBytes) }
    return bytes[0..entry.*.nameLength]
}

fn octal(data: [*]const u8, at: usize, width: usize) -> usize {
    var value: usize = 0
    var index: usize = 0
    while index < width {
        const byte = data[at + index]
        if byte >= 48 && byte <= 55 { value = value * 8 + @intCast(usize, byte - 48) }
        index += 1
    }
    return value
}

// The next regular file into ENTRY; false at the end (two zero blocks, or
// the data's end).
pub fn next(r: *Reader, entry: *Entry) -> bool {
    while r.*.at + 512 <= r.*.length {
        const header = r.*.at
        const data = r.*.data
        if data[header] == 0 { return false }
        const size = octal(data, header + 124, 12)
        const kind = data[header + 156]
        const body = header + 512
        r.*.at = body + (size + 511) / 512 * 512
        if body + size > r.*.length { return false }
        // '0' and NUL are regular files.
        if kind != 48 && kind != 0 { continue }
        var length: usize = 0
        // ustar: the prefix (155 bytes at 345), then a slash and the name.
        if data[header + 257] == 117 && data[header + 345] != 0 {
            var index: usize = 0
            while index < 155 && data[header + 345 + index] != 0 {
                entry.*.nameBytes[length] = data[header + 345 + index]
                length += 1
                index += 1
            }
            entry.*.nameBytes[length] = 47
            length += 1
        }
        var index: usize = 0
        while index < 100 && data[header + index] != 0 {
            entry.*.nameBytes[length] = data[header + index]
            length += 1
            index += 1
        }
        entry.*.nameLength = length
        unsafe { entry.*.data = @ptrFromInt([*]const u8, @intFromPtr(data) + body) }
        entry.*.size = size
        return true
    }
    return false
}
