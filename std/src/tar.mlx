// std.tar: tar archives (POSIX ustar, as GNU tar, npm and the rest
// write them): the header blocks read and written, and the files of an
// archive held in memory:
//
//     const tar = @import("std.tar")
//     var reader = tar.reader(data, length)
//     var entry: tar.Entry = undefined
//     while tar.next(&reader, &entry) { ... entry.name, entry.data[0..entry.size] ... }
//
// `next` gives regular files only; directories, links and the rest are
// passed over. For an archive read in pieces (a file, a gzip stream)
// `parseHeader` reads one 512-byte header block into a Header (its kind,
// name, size, mode, link target), and `writeHeader` makes one. Names are
// the header's prefix and name joined ("a/b"), at most 256 bytes; GNU
// long names and pax headers are not read (they are passed over as
// files of their own kinds).

pub const BLOCK: usize = 512

// The kinds (the header's type flag).
pub const FILE: u8 = 48
pub const HARD_LINK: u8 = 49
pub const SYMBOLIC_LINK: u8 = 50
pub const DIRECTORY: u8 = 53
pub const FIFO: u8 = 54
// GNU's long name and long link target: the data is the next header's
// name or link target.
pub const LONG_NAME: u8 = 76
pub const LONG_LINK: u8 = 75

pub const Header = struct {
    nameBytes: [257]u8
    nameLength: usize
    linkBytes: [101]u8
    linkLength: usize
    // The data's size in bytes (0 for all but files); the data follows
    // the header in whole blocks.
    size: usize
    // The permission bits.
    mode: usize
    modified: usize
    // FILE, DIRECTORY, ... (a NUL type flag is a file).
    kind: u8
}

pub fn headerName(header: *const Header) -> []const u8 {
    const bytes: [*]const u8 = unsafe { @ptrCast([*]const u8, &header.*.nameBytes) }
    return bytes[0..header.*.nameLength]
}

pub fn headerLink(header: *const Header) -> []const u8 {
    const bytes: [*]const u8 = unsafe { @ptrCast([*]const u8, &header.*.linkBytes) }
    return bytes[0..header.*.linkLength]
}

// The blocks the data of a header takes (rounded up to whole blocks).
pub fn dataBlocks(size: usize) -> usize { return (size + BLOCK - 1) / BLOCK * BLOCK }

pub const Entry = struct {
    // The name, at most 256 bytes ("prefix/name").
    nameBytes: [257]u8
    nameLength: usize
    data: [*]const u8
    size: usize
}

pub const Reader = struct {
    data: [*]const u8
    length: usize
    at: usize
}

pub fn reader(data: [*]const u8, length: usize) -> Reader {
    return Reader.{ .data = data, .length = length, .at = 0 }
}

pub fn name(entry: *const Entry) -> []const u8 {
    const bytes: [*]const u8 = unsafe { @ptrCast([*]const u8, &entry.*.nameBytes) }
    return bytes[0..entry.*.nameLength]
}

fn octal(data: [*]const u8, at: usize, width: usize) -> usize {
    var value: usize = 0
    var index: usize = 0
    while index < width {
        const byte = data[at + index]
        if byte >= 48 && byte <= 55 { value = value * 8 + @intCast(usize, byte - 48) }
        index += 1
    }
    return value
}

// `value` as `width` octal digits (the last byte NUL), as the headers
// hold numbers.
fn putOctal(block: [*]u8, at: usize, width: usize, value: usize) -> void {
    var rest = value
    var index = width - 1
    block[at + index] = 0
    while index > 0 {
        index -= 1
        block[at + index] = @intCast(u8, 48 + rest % 8)
        rest /= 8
    }
}

fn copyField(block: [*]const u8, at: usize, width: usize, into: [*]u8, length: *usize) -> void {
    var index: usize = 0
    while index < width && block[at + index] != 0 {
        into[length.*] = block[at + index]
        length.* += 1
        index += 1
    }
}

// The header block at `block` into `header`; false for the archive's
// end (a zero block).
pub fn parseHeader(block: [*]const u8, header: *Header) -> bool {
    if block[0] == 0 { return false }
    const nameBytes: [*]u8 = unsafe { @ptrCast([*]u8, &header.*.nameBytes) }
    const linkBytes: [*]u8 = unsafe { @ptrCast([*]u8, &header.*.linkBytes) }
    header.*.nameLength = 0
    header.*.linkLength = 0
    // ustar: the prefix (155 bytes at 345), then a slash and the name.
    if block[257] == 117 && block[258] == 115 && block[345] != 0 {
        copyField(block, 345, 155, nameBytes, &header.*.nameLength)
        nameBytes[header.*.nameLength] = 47
        header.*.nameLength += 1
    }
    copyField(block, 0, 100, nameBytes, &header.*.nameLength)
    copyField(block, 157, 100, linkBytes, &header.*.linkLength)
    header.*.mode = octal(block, 100, 8) & 4095
    header.*.size = octal(block, 124, 12)
    header.*.modified = octal(block, 136, 12)
    var kind = block[156]
    if kind == 0 { kind = FILE }
    header.*.kind = kind
    return true
}

// A header block for `path` (of `kind`, with `mode`, `size` bytes of
// data following for a file, `link` the target of a symbolic link) into
// the 512 bytes at `block`; false when the name does not fit (100 bytes,
// or 155 and 100 around a slash).
pub fn writeHeader(block: [*]u8, path: []const u8, kind: u8, mode: usize, size: usize, modified: usize, link: []const u8) -> bool {
    var index: usize = 0
    while index < BLOCK {
        block[index] = 0
        index += 1
    }
    var nameStart: usize = 0
    if path.length > 100 {
        // The last slash that leaves at most 100 bytes after it and 155
        // before it.
        var split: usize = 0
        var k: usize = 0
        while k < path.length {
            if path[k] == 47 && k <= 155 && path.length - k - 1 >= 1 && path.length - k - 1 <= 100 { split = k }
            k += 1
        }
        if split == 0 { return false }
        index = 0
        while index < split {
            block[345 + index] = path[index]
            index += 1
        }
        nameStart = split + 1
    }
    index = 0
    while nameStart + index < path.length {
        block[index] = path[nameStart + index]
        index += 1
    }
    putOctal(block, 100, 8, mode)
    putOctal(block, 108, 8, 0)
    putOctal(block, 116, 8, 0)
    putOctal(block, 124, 12, if kind == FILE { size } else { 0 })
    putOctal(block, 136, 12, modified)
    block[156] = kind
    if link.length > 100 { return false }
    index = 0
    while index < link.length {
        block[157 + index] = link[index]
        index += 1
    }
    const magic = "ustar"
    index = 0
    while index < magic.length {
        block[257 + index] = magic[index]
        index += 1
    }
    block[263] = 48
    block[264] = 48
    const user = "root"
    index = 0
    while index < user.length {
        block[265 + index] = user[index]
        block[297 + index] = user[index]
        index += 1
    }
    // The checksum: the bytes summed with the checksum field as spaces,
    // six octal digits, NUL, space.
    index = 0
    while index < 8 {
        block[148 + index] = 32
        index += 1
    }
    var sum: usize = 0
    index = 0
    while index < BLOCK {
        sum += @intCast(usize, block[index])
        index += 1
    }
    putOctal(block, 148, 7, sum)
    block[155] = 32
    return true
}

// The next regular file into ENTRY; false at the end (two zero blocks, or
// the data's end).
pub fn next(r: *Reader, entry: *Entry) -> bool {
    while r.*.at + BLOCK <= r.*.length {
        const at = r.*.at
        const data = r.*.data
        var header: Header = undefined
        if !parseHeader(data + at, &header) { return false }
        const body = at + BLOCK
        r.*.at = body + dataBlocks(header.size)
        if body + header.size > r.*.length { return false }
        if header.kind != FILE { continue }
        var index: usize = 0
        while index < header.nameLength {
            entry.*.nameBytes[index] = header.nameBytes[index]
            index += 1
        }
        entry.*.nameLength = header.nameLength
        unsafe { entry.*.data = @ptrFromInt([*]const u8, @intFromPtr(data) + body) }
        entry.*.size = header.size
        return true
    }
    return false
}
