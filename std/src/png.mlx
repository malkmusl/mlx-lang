// std.png: decodes PNG images (for icons and the like) into premultiplied
// ARGB words, the wl_shm / compositor convention, and writes such words as
// PNGs (saveFile, at the end).
//
//     const png = @import("std.png")
//     var image: png.Image = undefined
//     if png.loadFile(&image, path, allocator) == png.Status.ok { ... png.deinit(&image) }
//
// Supported: every colour type (greyscale, RGB, palette, greyscale with
// alpha, RGBA) at every bit depth PNG allows for it (1, 2, 4, 8, 16),
// transparency (tRNS) of each, interlaced (Adam7) images, all five row
// filters. The file is read by std.png.read, libpng's reader in Mlx (the
// same checks of chunks and CRCs); malformed data gives Status.corrupt,
// never a trap. decodeRgba gives 8-bit RGBA instead of premultiplied
// words. The libpng C API (compiler/capi/png) is made of the same parts.
//
// scale() resizes an image by area averaging (box filtering), which suits
// shrinking icons to the size they are shown at.

const std = @import("std")
const allocator_module = @import("../bootstrap/allocator.mlx")
const fs = @import("../bootstrap/fs.mlx")
const flate = @import("./flate.mlx")
const crc = @import("./crc.mlx")
const zs = @import("./flate/stream.mlx")
pub const read = @import("./png/read.mlx")
pub const rows = @import("./png/rows.mlx")

pub const Allocator = allocator_module.Allocator

pub const Status = enum(u8) {
    ok,
    unreadable,
    notPng,
    unsupported,
    corrupt,
    noMemory
}

pub fn statusMessage(status: Status) -> []const u8 {
    if status == Status.ok { return "ok" }
    if status == Status.unreadable { return "cannot read the file" }
    if status == Status.notPng { return "not a PNG image" }
    if status == Status.unsupported { return "a PNG larger than 16384 pixels across" }
    if status == Status.corrupt { return "a damaged PNG" }
    return "out of memory"
}

// Pixels are premultiplied 0xAARRGGBB, `width` per row.
pub const Image = struct {
    pixels: [*]u32
    width: usize
    height: usize
    allocator: Allocator
}

pub fn deinit(image: *Image) -> void {
    if image.*.width * image.*.height == 0 { return }
    unsafe { image.*.allocator.free(@ptrCast([*]u8, image.*.pixels), image.*.width * image.*.height * 4, 16) }
    image.*.width = 0
    image.*.height = 0
}

// Reads and decodes the PNG at `path`.
pub fn loadFile(image: *Image, path: [*]const u8, allocator: Allocator) -> Status {
    image.*.width = 0
    image.*.height = 0
    const loaded = fs.readFileAlloc(path, allocator)
    if loaded == null { return Status.unreadable }
    const contents = loaded.?
    if contents.length == 0 {
        fs.ArrayList.deinit(contents)
        return Status.unreadable
    }
    const data: [*]const u8 = unsafe { @ptrCast([*]const u8, contents.items) }
    const status = decode(image, data, contents.length, allocator)
    fs.ArrayList.deinit(contents)
    return status
}

// ---------------------------------------------------------------------------
// Decoding: std.png.read reads the file (as libpng does, with the same
// checks), std.png.rows undoes the filters and makes each row 8-bit RGBA:
// palettes and transparency expanded, grey made RGB, 16-bit samples cut
// to their high byte. Interlaced (Adam7) rows go straight to their
// places. An APNG gives its default image.

fn paeth(left: u8, up: u8, corner: u8) -> u8 {
    const a = @intCast(i32, left)
    const b = @intCast(i32, up)
    const c = @intCast(i32, corner)
    const p = a + b - c
    const pa = if p > a { p - a } else { a - p }
    const pb = if p > b { p - b } else { b - p }
    const pc = if p > c { p - c } else { c - p }
    if pa <= pb && pa <= pc { return left }
    if pb <= pc { return up }
    return corner
}

// An image as 8-bit RGBA, not premultiplied: 4 bytes a pixel, `width`
// pixels a row.
pub const Picture = struct {
    pixels: [*]u8
    width: usize
    height: usize
    allocator: Allocator
}

pub fn deinitPicture(picture: *Picture) -> void {
    if picture.*.width * picture.*.height == 0 { return }
    picture.*.allocator.free(picture.*.pixels, picture.*.width * picture.*.height * 4, 16)
    picture.*.width = 0
    picture.*.height = 0
}

// The state of a decoding (on the heap: the reader is large).
const Decoding = struct {
    reader: read.Reader
    info: read.Info
    rowBuffer: usize
    previous: usize
    rowCapacity: usize
    pixels: usize
    pass: usize
    row: usize
    passRows: usize
    passWidth: usize
    complete: bool
}

// The first pass from FIRST on with pixels, or 7.
fn firstPass(width: usize, height: usize, first: usize) -> usize {
    var pass = first
    while pass < 7 {
        if rows.passWidth(pass, width) != 0 && rows.passHeight(pass, height) != 0 { return pass }
        pass += 1
    }
    return 7
}

// Sets the reader up for the rows of the current pass.
fn startPass(d: *Decoding) -> void {
    const info = &d.*.info
    if info.*.interlace == 0 {
        d.*.passWidth = info.*.width
        d.*.passRows = info.*.height
    } else {
        d.*.passWidth = rows.passWidth(d.*.pass, info.*.width)
        d.*.passRows = rows.passHeight(d.*.pass, info.*.height)
    }
    d.*.row = 0
    zs.zero(d.*.previous, d.*.rowCapacity)
    d.*.reader.rowSize = rows.rowBytes(info.*.pixelDepth, d.*.passWidth) + 1
}

fn startImage(d: *Decoding, allocator: Allocator) -> Status {
    const info = &d.*.info
    if info.*.width > 16384 || info.*.height > 16384 { return Status.unsupported }
    // A row at its widest: 8 bytes a pixel, rounded up to 8 pixels.
    d.*.rowCapacity = ((info.*.width + 7) & ~@intCast(usize, 7)) * 8 + 64
    const total = d.*.rowCapacity * 2 + info.*.width * info.*.height * 4
    const memory = allocator.alloc(total, 16)
    if memory == null { return Status.noMemory }
    const base = @intFromPtr(memory.?)
    zs.zero(base, total)
    d.*.rowBuffer = base
    d.*.previous = base + d.*.rowCapacity
    d.*.pixels = base + d.*.rowCapacity * 2
    d.*.reader.rowBuffer = d.*.rowBuffer
    d.*.pass = 0
    if info.*.interlace != 0 { d.*.pass = firstPass(info.*.width, info.*.height, 0) }
    startPass(d)
    return Status.ok
}

// A row inflated: the filter undone, the row made RGBA, put in place.
fn takeRow(d: *Decoding) -> bool {
    const info = &d.*.info
    const bytes = rows.rowBytes(info.*.pixelDepth, d.*.passWidth)
    const filter = @intCast(usize, zs.get8(d.*.rowBuffer))
    if filter > 4 { return false }
    var pixelBytes = info.*.pixelDepth >> 3
    if pixelBytes == 0 { pixelBytes = 1 }
    rows.unfilter(filter, d.*.rowBuffer + 1, d.*.previous + 1, bytes, pixelBytes)
    zs.copy(d.*.previous, d.*.rowBuffer, bytes + 1)
    var row: rows.RowInfo = undefined
    row.width = d.*.passWidth
    row.rowBytes = bytes
    row.colorType = info.*.colorType
    row.bitDepth = info.*.bitDepth
    row.channels = info.*.channels
    row.pixelDepth = info.*.pixelDepth
    const line = d.*.rowBuffer + 1
    if row.colorType == 3 {
        rows.expandPalette(&row, line, @intFromPtr(&info.*.palette), @intFromPtr(&info.*.transAlpha), info.*.numTrans)
    } else {
        rows.expand(&row, line, info.*.numTrans != 0, info.*.transGray, info.*.transRed, info.*.transGreen, info.*.transBlue)
    }
    rows.chop16(&row, line)
    rows.grayToRgb(&row, line)
    if row.channels == 3 { rows.filler(&row, line, 255, true) }
    // Where the row's pixels go.
    var y = d.*.row
    var x0: usize = 0
    var step: usize = 1
    if info.*.interlace != 0 {
        y = rows.passStartRow(d.*.pass) + d.*.row * rows.passRowStep(d.*.pass)
        x0 = rows.passStartColumn(d.*.pass)
        step = rows.passColumnStep(d.*.pass)
    }
    var index: usize = 0
    while index < d.*.passWidth {
        zs.copy(d.*.pixels + (y * info.*.width + x0 + index * step) * 4, line + index * 4, 4)
        index += 1
    }
    d.*.row += 1
    if d.*.row >= d.*.passRows {
        if info.*.interlace != 0 { d.*.pass = firstPass(info.*.width, info.*.height, d.*.pass + 1) } else { d.*.pass = 7 }
        if d.*.pass >= 7 {
            d.*.complete = true
            d.*.reader.imageComplete = true
        } else {
            startPass(d)
        }
    }
    return true
}

// Decodes a PNG held in memory into 8-bit RGBA.
pub fn decodeRgba(picture: *Picture, data: [*]const u8, length: usize, allocator: Allocator) -> Status {
    picture.*.width = 0
    picture.*.height = 0
    picture.*.allocator = allocator
    if length < 8 { return Status.notPng }
    const signature = [8]u8{ 137, 80, 78, 71, 13, 10, 26, 10 }
    var index: usize = 0
    while index < 8 {
        if data[index] != signature[index] { return Status.notPng }
        index += 1
    }
    const memory = allocator.alloc(@sizeOf(Decoding), 16)
    if memory == null { return Status.noMemory }
    const d: *Decoding = unsafe { @ptrCast(*Decoding, memory.?) }
    read.init(&d.*.reader, &d.*.info, allocator)
    d.*.rowBuffer = 0
    d.*.complete = false
    read.give(&d.*.reader, @intFromPtr(data), length)
    var status = Status.corrupt
    var ended = false
    while true {
        const event = read.next(&d.*.reader)
        if event == read.Event.more || event == read.Event.failed { break }
        if event == read.Event.info {
            status = startImage(d, allocator)
            if status != Status.ok { break }
            status = Status.corrupt
        } else if event == read.Event.row {
            if !takeRow(d) { break }
        } else if event == read.Event.unknown {
            // An unknown critical chunk cannot be passed over.
            if d.*.reader.chunkName & 0x20000000 == 0 { break }
        } else if event == read.Event.end {
            ended = true
            break
        }
    }
    if ended && d.*.complete { status = Status.ok }
    const info = &d.*.info
    const width = info.*.width
    const height = info.*.height
    if d.*.rowBuffer != 0 {
        const total = d.*.rowCapacity * 2 + width * height * 4
        if status == Status.ok {
            // The pixels move to memory of their own.
            const pixels = allocator.alloc(width * height * 4, 16)
            if pixels == null {
                status = Status.noMemory
            } else {
                zs.copy(@intFromPtr(pixels.?), d.*.pixels, width * height * 4)
                picture.*.pixels = pixels.?
                picture.*.width = width
                picture.*.height = height
            }
        }
        allocator.free(zs.bytes(d.*.rowBuffer), total, 16)
    }
    read.deinit(&d.*.reader)
    allocator.free(memory.?, @sizeOf(Decoding), 16)
    return status
}

fn premultiply(alpha: u32, red: u32, green: u32, blue: u32) -> u32 {
    if alpha == 255 { return 4278190080 | (red << 16) | (green << 8) | blue }
    const r = (red * alpha + 127) / 255
    const g = (green * alpha + 127) / 255
    const b = (blue * alpha + 127) / 255
    return (alpha << 24) | (r << 16) | (g << 8) | b
}

// Decodes a PNG held in memory into premultiplied ARGB words.
pub fn decode(image: *Image, data: [*]const u8, length: usize, allocator: Allocator) -> Status {
    image.*.width = 0
    image.*.height = 0
    image.*.allocator = allocator
    var picture: Picture = undefined
    const status = decodeRgba(&picture, data, length, allocator)
    if status != Status.ok { return status }
    const count = picture.width * picture.height
    // The words take the place of the bytes, one for four.
    const words: [*]u32 = unsafe { @ptrCast([*]u32, picture.pixels) }
    var index: usize = 0
    while index < count {
        const at = index * 4
        const red = @intCast(u32, picture.pixels[at])
        const green = @intCast(u32, picture.pixels[at + 1])
        const blue = @intCast(u32, picture.pixels[at + 2])
        const alpha = @intCast(u32, picture.pixels[at + 3])
        words[index] = premultiply(alpha, red, green, blue)
        index += 1
    }
    image.*.pixels = words
    image.*.width = picture.width
    image.*.height = picture.height
    return Status.ok
}

// ---------------------------------------------------------------------------
// Scaling

// `source` resized to `width` x `height` by area averaging: each target
// pixel is the mean of the source pixels its area covers (at least one).
pub fn scale(target: *Image, source: *const Image, width: usize, height: usize, allocator: Allocator) -> Status {
    target.*.width = 0
    target.*.height = 0
    target.*.allocator = allocator
    if width == 0 || height == 0 || source.*.width == 0 || source.*.height == 0 { return Status.corrupt }
    const memory = allocator.alloc(width * height * 4, 16)
    if memory == null { return Status.noMemory }
    const pixels: [*]u32 = unsafe { @ptrCast([*]u32, memory.?) }
    var y: usize = 0
    while y < height {
        const top = y * source.*.height / height
        var bottom = (y + 1) * source.*.height / height
        if bottom <= top { bottom = top + 1 }
        var x: usize = 0
        while x < width {
            const left = x * source.*.width / width
            var right = (x + 1) * source.*.width / width
            if right <= left { right = left + 1 }
            var alpha: usize = 0
            var red: usize = 0
            var green: usize = 0
            var blue: usize = 0
            var row = top
            while row < bottom {
                var column = left
                while column < right {
                    const pixel = source.*.pixels[row * source.*.width + column]
                    alpha += @intCast(usize, pixel >> 24)
                    red += @intCast(usize, (pixel >> 16) & 255)
                    green += @intCast(usize, (pixel >> 8) & 255)
                    blue += @intCast(usize, pixel & 255)
                    column += 1
                }
                row += 1
            }
            const count = (bottom - top) * (right - left)
            pixels[y * width + x] = @intCast(u32, ((alpha / count) << 24) | ((red / count) << 16) | ((green / count) << 8) | (blue / count))
            x += 1
        }
        y += 1
    }
    target.*.pixels = pixels
    target.*.width = width
    target.*.height = height
    return Status.ok
}

// ---------------------------------------------------------------------------
// Encoding: saveFile writes premultiplied 0xAARRGGBB words as an 8-bit RGBA
// (or, opaque, RGB) PNG: each row filtered with the filter that leaves the
// smallest differences, compressed by std.flate (zlib's level 6).

// A chunk: its length, type, data (already at `at` + 8) and CRC; returns
// where the next one starts.
fn sealChunk(file: [*]u8, at: usize, kind: []const u8, length: usize) -> usize {
    std.mem.writeU32Big(file, at, @intCast(u32, length))
    var index: usize = 0
    while index < 4 {
        file[at + 4 + index] = kind[index]
        index += 1
    }
    const start: [*]const u8 = file + at + 4
    std.mem.writeU32Big(file, at + 8 + length, crc.crc32(0, start, length + 4))
    return at + 12 + length
}

// Row `row` filtered with `filter` (0 none, 1 sub, 2 up, 4 paeth) into
// `target`; returns the sum of the differences' sizes.
fn filterRow(raw: [*]const u8, row: usize, row_bytes: usize, pixel_bytes: usize, filter: u32, target: [*]u8) -> usize {
    const start = row * row_bytes
    var sum: usize = 0
    var index: usize = 0
    while index < row_bytes {
        const value = @intCast(u32, raw[start + index])
        const left = if index >= pixel_bytes { @intCast(u32, raw[start + index - pixel_bytes]) } else { 0 }
        const up = if row > 0 { @intCast(u32, raw[start - row_bytes + index]) } else { 0 }
        const corner = if row > 0 && index >= pixel_bytes { @intCast(u32, raw[start - row_bytes + index - pixel_bytes]) } else { 0 }
        var predicted: u32 = 0
        if filter == 1 { predicted = left }
        if filter == 2 { predicted = up }
        if filter == 4 { predicted = @intCast(u32, paeth(@intCast(u8, left), @intCast(u8, up), @intCast(u8, corner))) }
        const difference = (value + 256 - predicted) & 255
        target[index] = @intCast(u8, difference)
        sum += if difference < 128 { @intCast(usize, difference) } else { @intCast(usize, 256 - difference) }
        index += 1
    }
    return sum
}

// Writes `pixels` (premultiplied 0xAARRGGBB, rows `stride` words apart) as
// a PNG at `path`: RGBA, or RGB when `alpha` is false. False when memory or
// the file failed.
pub fn saveFile(path: [*]const u8, pixels: [*]const u32, width: usize, height: usize, stride: usize, alpha: bool, allocator: Allocator) -> bool {
    if width == 0 || height == 0 { return false }
    const pixel_bytes: usize = if alpha { 4 } else { 3 }
    const row_bytes = width * pixel_bytes
    const raw_length = height * row_bytes
    const filtered_length = height * (row_bytes + 1)
    const deflate_capacity = flate.compressBound(filtered_length, flate.Format.zlib)
    const file_capacity = deflate_capacity + 128
    const total = raw_length + filtered_length + file_capacity + row_bytes
    const memory = allocator.alloc(total, 16)
    if memory == null { return false }
    const base = memory.?
    var raw: [*]u8 = undefined
    var filtered: [*]u8 = undefined
    var file: [*]u8 = undefined
    var scratch: [*]u8 = undefined
    unsafe {
        raw = base
        filtered = base + raw_length
        scratch = base + raw_length + filtered_length
        file = base + raw_length + filtered_length + row_bytes
    }
    // Straight (not premultiplied) RGB(A) bytes.
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            const pixel = pixels[y * stride + x]
            const a = pixel >> 24
            var red = (pixel >> 16) & 255
            var green = (pixel >> 8) & 255
            var blue = pixel & 255
            if alpha && a != 0 && a != 255 {
                red = (red * 255 + a / 2) / a
                green = (green * 255 + a / 2) / a
                blue = (blue * 255 + a / 2) / a
                if red > 255 { red = 255 }
                if green > 255 { green = 255 }
                if blue > 255 { blue = 255 }
            }
            const at = y * row_bytes + x * pixel_bytes
            raw[at] = @intCast(u8, red)
            raw[at + 1] = @intCast(u8, green)
            raw[at + 2] = @intCast(u8, blue)
            if alpha { raw[at + 3] = @intCast(u8, a) }
            x += 1
        }
        y += 1
    }
    // Each row with the filter that leaves the least.
    y = 0
    while y < height {
        var best_filter: u32 = 0
        var best_sum: usize = 0
        var filter: u32 = 0
        while filter < 5 {
            if filter != 3 {
                const sum = filterRow(raw, y, row_bytes, pixel_bytes, filter, scratch)
                if filter == 0 || sum < best_sum {
                    best_sum = sum
                    best_filter = filter
                }
            }
            filter += 1
        }
        const start = y * (row_bytes + 1)
        filtered[start] = @intCast(u8, best_filter)
        const target: [*]u8 = filtered + start + 1
        _ = filterRow(raw, y, row_bytes, pixel_bytes, best_filter, target)
        y += 1
    }
    // Signature, IHDR.
    const signature = [8]u8{ 137, 80, 78, 71, 13, 10, 26, 10 }
    var at: usize = 0
    while at < 8 {
        file[at] = signature[at]
        at += 1
    }
    std.mem.writeU32Big(file, 16, @intCast(u32, width))
    std.mem.writeU32Big(file, 20, @intCast(u32, height))
    file[24] = 8
    file[25] = if alpha { 6 } else { 2 }
    file[26] = 0
    file[27] = 0
    file[28] = 0
    at = sealChunk(file, 8, "IHDR", 13)
    // IDAT: a zlib stream.
    const data_start = at + 8
    const data_length = flate.compress(filtered, filtered_length, file + data_start, deflate_capacity, 6, flate.Format.zlib, allocator)
    if data_length == 0 {
        allocator.free(base, total, 16)
        return false
    }
    at = sealChunk(file, at, "IDAT", data_length)
    at = sealChunk(file, at, "IEND", 0)
    const output = fs.open(path, fs.WRITE_ONLY | fs.CREATE | fs.TRUNCATE, 420)
    var written = false
    if fs.isValid(output) {
        written = fs.writeAllBytes(output, file, at)
        written = fs.close(output) && written
    }
    allocator.free(base, total, 16)
    return written
}
