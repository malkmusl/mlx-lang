// std.vulkan.registry: reads the Vulkan API registry (vk.xml) into a model
// of types, enumerants, commands and the requirements of a selected set of
// features and extensions.
//
// The model borrows the XML source: every name and value is a String slice
// into it, so the source must outlive the registry. Only the "vulkan" API is
// modeled; elements marked for other APIs (api="vulkansc") are skipped.
//
// `parse` records the definitions and the requirements of the selected
// features (VK_VERSION_1_0 up to `maxVersion`) and extensions; `resolve`
// then computes the closure of required types (every type a required struct,
// union, command or alias refers to). Enumerants added by an extension are
// attached to the enumeration they extend, with their computed value.

const allocator_module = @import("../../bootstrap/allocator.mlx")
const string = @import("../../bootstrap/string.mlx")
const vector = @import("../../bootstrap/vector.mlx")
const hash_map = @import("../../bootstrap/hash_map.mlx")
const xml = @import("../xml.mlx")

pub const Allocator = allocator_module.Allocator
pub const String = string.String
pub const Vector = vector.Vector
pub const HashMap = hash_map.HashMap

pub const NONE: usize = 18446744073709551615

// Type categories.
pub const CATEGORY_OPAQUE: u8 = 0 // platform or opaque type (wl_display, ANativeWindow, ...)
pub const CATEGORY_BASETYPE: u8 = 1
pub const CATEGORY_BITMASK: u8 = 2
pub const CATEGORY_HANDLE: u8 = 3
pub const CATEGORY_ENUM: u8 = 4
pub const CATEGORY_STRUCT: u8 = 5
pub const CATEGORY_UNION: u8 = 6
pub const CATEGORY_FUNCPOINTER: u8 = 7
pub const CATEGORY_OTHER: u8 = 8 // include, define

// Enumeration block kinds.
pub const BLOCK_CONSTANTS: u8 = 0
pub const BLOCK_ENUM: u8 = 1
pub const BLOCK_BITMASK: u8 = 2

pub const Type = struct {
    name: String
    category: u8
    alias: String
    // basetype: underlying C type (empty for an opaque struct); bitmask:
    // VkFlags or VkFlags64; handle: VK_DEFINE_HANDLE or
    // VK_DEFINE_NON_DISPATCHABLE_HANDLE.
    base: String
    // bitmask: the FlagBits enumeration naming its bits (may be empty).
    flagBits: String
    memberStart: usize
    memberCount: usize
    returnedOnly: bool
    hasBitfield: bool
    required: bool
    // Index of the <enums> block of an enum or FlagBits type, or NONE.
    block: usize
}

// A struct or union member, a command parameter, or a command prototype.
pub const Member = struct {
    name: String
    typeName: String
    // Pointer levels (0..2); constMask bit 0: the pointee is const, bit 1:
    // the pointer at the first level is itself pointed to as const
    // ("const char* const*").
    pointers: u8
    constMask: u8
    // Fixed array dimensions: a number or an API constant name; empty when
    // absent.
    arrayLength: String
    arrayLength2: String
    // The first entry of the `optional` attribute.
    optional: bool
    length: String
    values: String
    bitfield: bool
}

pub const Block = struct {
    name: String
    kind: u8
    bitwidth: u8
    valueStart: usize
}

pub const Enumerant = struct {
    name: String
    // Owning block, or NONE for a constant an extension defines on its own
    // (its SPEC_VERSION and EXTENSION_NAME).
    block: usize
    value: i64
    alias: String
    // Raw value text (for API and extension constants) and its C type.
    text: String
    constantType: String
    required: bool
}

pub const Command = struct {
    name: String
    alias: String
    returnType: String
    paramStart: usize
    paramCount: usize
    required: bool
}

pub const Selection = struct {
    // Features VK_VERSION_1_0 up to VK_VERSION_1_<maxMinor>.
    maxMinor: u8
    extensions: [32]String
    extensionCount: usize
}

pub const Registry = struct {
    allocator: Allocator
    source: [*]const u8
    length: usize
    types: Vector
    members: Vector
    blocks: Vector
    enumerants: Vector
    commands: Vector
    typeMap: HashMap
    blockMap: HashMap
    enumerantMap: HashMap
    commandMap: HashMap
    // Names required by the selected features and extensions.
    requiredTypes: Vector
    requiredCommands: Vector
    requiredEnumerants: Vector
    selection: Selection
    headerVersion: usize
    failure: String
    errorLine: usize
}

// ---------------------------------------------------------------------------
// Access

pub fn typeCount(registry: *const Registry) -> usize { return registry.*.types.length }

pub fn typeAt(registry: *const Registry, index: usize) -> *Type {
    unsafe { return @ptrCast(*Type, registry.*.types.at(index)) }
}

pub fn memberAt(registry: *const Registry, index: usize) -> *Member {
    unsafe { return @ptrCast(*Member, registry.*.members.at(index)) }
}

pub fn blockCount(registry: *const Registry) -> usize { return registry.*.blocks.length }

pub fn blockAt(registry: *const Registry, index: usize) -> *Block {
    unsafe { return @ptrCast(*Block, registry.*.blocks.at(index)) }
}

pub fn enumerantCount(registry: *const Registry) -> usize { return registry.*.enumerants.length }

pub fn enumerantAt(registry: *const Registry, index: usize) -> *Enumerant {
    unsafe { return @ptrCast(*Enumerant, registry.*.enumerants.at(index)) }
}

pub fn commandCount(registry: *const Registry) -> usize { return registry.*.commands.length }

pub fn commandAt(registry: *const Registry, index: usize) -> *Command {
    unsafe { return @ptrCast(*Command, registry.*.commands.at(index)) }
}

fn nameAt(list: *const Vector, index: usize) -> String {
    unsafe { return @ptrCast(*String, list.*.at(index)).* }
}

pub fn findType(registry: *const Registry, name: String) -> usize {
    const found = hash_map.get(registry.*.typeMap, name)
    if found.0 { return found.1 }
    return NONE
}

pub fn findCommand(registry: *const Registry, name: String) -> usize {
    const found = hash_map.get(registry.*.commandMap, name)
    if found.0 { return found.1 }
    return NONE
}

pub fn findEnumerant(registry: *const Registry, name: String) -> usize {
    const found = hash_map.get(registry.*.enumerantMap, name)
    if found.0 { return found.1 }
    return NONE
}

pub fn findBlock(registry: *const Registry, name: String) -> usize {
    const found = hash_map.get(registry.*.blockMap, name)
    if found.0 { return found.1 }
    return NONE
}

pub fn equals(value: String, text: []const u8) -> bool {
    return string.eql(value, string.fromSlice(text))
}

fn empty(registry: *const Registry) -> String {
    return string.fromParts(registry.*.source, 0)
}

// ---------------------------------------------------------------------------
// Reading XML: a tokenizer with one token of lookahead, and attributes.

const Reader = struct {
    tokenizer: *xml.Tokenizer
    token: *xml.Token
    pending: bool
}

fn advance(reader: *Reader) -> bool {
    if reader.*.pending {
        reader.*.pending = false
        return true
    }
    return xml.next(reader.*.tokenizer, reader.*.token)
}

fn pushBack(reader: *Reader) -> void { reader.*.pending = true }

const MAX_ATTRIBUTES: usize = 24

const Attributes = struct {
    count: usize
    names: [24]String
    values: [24]String
}

// Reads the attributes following an elementStart. Returns true when the
// element has content (false for `<name .../>`, whose end is consumed).
fn readAttributes(reader: *Reader, attributes: *Attributes) -> bool {
    attributes.*.count = 0
    while advance(reader) {
        const token = reader.*.token.*
        if token.kind == xml.TokenKind.attribute {
            if attributes.*.count < MAX_ATTRIBUTES {
                attributes.*.names[attributes.*.count] = copyString(token.name)
                attributes.*.values[attributes.*.count] = copyString(token.value)
                attributes.*.count += 1
            }
        } else {
            if token.kind == xml.TokenKind.elementEnd && token.selfClosing { return false }
            pushBack(reader)
            return true
        }
    }
    return false
}

fn attribute(attributes: *const Attributes, name: []const u8, fallback: String) -> String {
    var index: usize = 0
    while index < attributes.*.count {
        if equals(attributes.*.names[index], name) { return attributes.*.values[index] }
        index += 1
    }
    return fallback
}

fn hasAttribute(attributes: *const Attributes, name: []const u8) -> bool {
    var index: usize = 0
    while index < attributes.*.count {
        if equals(attributes.*.names[index], name) { return true }
        index += 1
    }
    return false
}

// Skips the rest of an element whose start (and attributes) were read.
fn skipContent(reader: *Reader) -> void {
    var depth: usize = 1
    while advance(reader) {
        const token = reader.*.token.*
        if token.kind == xml.TokenKind.elementStart { depth += 1 }
        if token.kind == xml.TokenKind.elementEnd {
            depth -= 1
            if depth == 0 { return }
        }
    }
}

fn skipElement(reader: *Reader) -> void {
    var attributes: Attributes = undefined
    if readAttributes(reader, &attributes) { skipContent(reader) }
}

// Reads the text content of a simple element such as <name>VkInstance</name>.
fn readText(registry: *const Registry, reader: *Reader) -> String {
    var attributes: Attributes = undefined
    var result = empty(registry)
    if !readAttributes(reader, &attributes) { return result }
    var depth: usize = 1
    while advance(reader) {
        const token = reader.*.token.*
        if token.kind == xml.TokenKind.text && depth == 1 && result.length == 0 { result = copyString(token.value) }
        if token.kind == xml.TokenKind.elementStart { depth += 1 }
        if token.kind == xml.TokenKind.elementEnd {
            depth -= 1
            if depth == 0 { return result }
        }
    }
    return result
}

// Token fields are copied through this call: assigning `token.value`
// directly to a String variable inside the reader loops loses the value
// with the bootstrap compiler.
fn copyString(value: String) -> String {
    return string.fromParts(value.pointer, value.length)
}

fn slice(value: String, start: usize, length: usize) -> String {
    unsafe { return string.fromParts(@ptrFromInt([*]const u8, @intFromPtr(value.pointer) + start), length) }
}

pub fn contains(value: String, text: []const u8) -> bool {
    const needle = string.fromSlice(text)
    if needle.length > value.length { return false }
    var start: usize = 0
    while start + needle.length <= value.length {
        var same = true
        var index: usize = 0
        while same && index < needle.length {
            if value.pointer[start + index] != needle.pointer[index] { same = false }
            index += 1
        }
        if same { return true }
        start += 1
    }
    return false
}

fn countByte(value: String, byte: u8) -> u8 {
    var count: u8 = 0
    var index: usize = 0
    while index < value.length {
        if value.pointer[index] == byte { count += 1 }
        index += 1
    }
    return count
}

// True when a comma-separated api list names "vulkan" (an absent list
// applies to every API).
fn forVulkan(list: String) -> bool {
    if list.length == 0 { return true }
    var start: usize = 0
    var index: usize = 0
    while index <= list.length {
        if index == list.length || list.pointer[index] == 44 {
            if index - start == 6 && equals(slice(list, start, 6), "vulkan") { return true }
            start = index + 1
        }
        index += 1
    }
    return false
}

// ---------------------------------------------------------------------------
// Numbers

fn digitValue(byte: u8) -> i64 {
    if byte >= 48 && byte <= 57 { return @intCast(i64, byte - 48) }
    if byte >= 97 && byte <= 102 { return @intCast(i64, byte - 87) }
    if byte >= 65 && byte <= 70 { return @intCast(i64, byte - 55) }
    return -1
}

// Parses a decimal or 0x-prefixed hexadecimal integer with an optional
// leading '-'. Returns false for anything else.
pub fn parseNumber(text: String, result: *i64) -> bool {
    var index: usize = 0
    var negative = false
    if index < text.length && text.pointer[index] == 45 {
        negative = true
        index += 1
    }
    var base: i64 = 10
    if index + 1 < text.length && text.pointer[index] == 48 && (text.pointer[index + 1] == 120 || text.pointer[index + 1] == 88) {
        base = 16
        index += 2
    }
    if index >= text.length { return false }
    var value: i64 = 0
    while index < text.length {
        const digit = digitValue(text.pointer[index])
        if digit < 0 || digit >= base { return false }
        value = value * base + digit
        index += 1
    }
    result.* = if negative { 0 - value } else { value }
    return true
}

// ---------------------------------------------------------------------------
// Building the model

fn fail(registry: *Registry, reader: *Reader, message: []const u8) -> bool {
    registry.*.failure = string.fromSlice(message)
    registry.*.errorLine = xml.lineOf(reader.*.tokenizer, reader.*.token.*.offset)
    return false
}

fn addName(list: Vector, name: String) -> Vector {
    var copy = name
    unsafe { return Vector.append(list, @ptrCast([*]const u8, &copy)) }
}

fn newMember(registry: *const Registry) -> Member {
    const blank = empty(registry)
    return Member.{
        .name = blank,
        .typeName = blank,
        .pointers = 0,
        .constMask = 0,
        .arrayLength = blank,
        .arrayLength2 = blank,
        .optional = false,
        .length = blank,
        .values = blank,
        .bitfield = false,
    }
}

// Reads the content of a <member>, <param> or <proto>: optional leading
// "const", <type>, pointer stars (with "const" between them), <name>, and
// array dimensions or a bitfield width.
fn readDeclaration(registry: *Registry, reader: *Reader, member: *Member) -> void {
    var seen_type = false
    var seen_name = false
    var bracket_count: usize = 0
    var depth: usize = 1
    while advance(reader) {
        const token = reader.*.token.*
        if token.kind == xml.TokenKind.elementEnd {
            depth -= 1
            if depth == 0 { return }
        } else if token.kind == xml.TokenKind.elementStart {
            if equals(token.name, "type") {
                member.*.typeName = readText(registry, reader)
                seen_type = true
            } else if equals(token.name, "name") {
                member.*.name = readText(registry, reader)
                seen_name = true
            } else if equals(token.name, "enum") {
                const constant = readText(registry, reader)
                if bracket_count == 1 { member.*.arrayLength = constant } else { member.*.arrayLength2 = constant }
            } else {
                skipElement(reader)
            }
        } else if token.kind == xml.TokenKind.text {
            const text = copyString(token.value)
            if !seen_type {
                if contains(text, "const") { member.*.constMask = member.*.constMask | 1 }
            } else if !seen_name {
                member.*.pointers = countByte(text, 42)
                if member.*.pointers == 2 && contains(text, "const") { member.*.constMask = member.*.constMask | 2 }
            } else {
                // "[4]", "[", "][2]", ":8" after the name.
                var index: usize = 0
                while index < text.length {
                    const byte = text.pointer[index]
                    if byte == 58 { member.*.bitfield = true }
                    if byte == 91 {
                        bracket_count += 1
                        var end = index + 1
                        while end < text.length && text.pointer[end] != 93 { end += 1 }
                        if end > index + 1 && end < text.length {
                            const dimension = slice(text, index + 1, end - index - 1)
                            if bracket_count == 1 { member.*.arrayLength = dimension } else { member.*.arrayLength2 = dimension }
                        }
                    }
                    index += 1
                }
            }
        }
    }
}

fn firstOptional(value: String) -> bool {
    return value.length >= 4 && value.pointer[0] == 116 && value.pointer[1] == 114 && value.pointer[2] == 117 && value.pointer[3] == 101
}

fn appendMember(registry: *Registry, member: Member) -> void {
    var copy = member
    unsafe { registry.*.members = Vector.append(registry.*.members, @ptrCast([*]const u8, &copy)) }
}

fn appendType(registry: *Registry, value: Type) -> void {
    var copy = value
    const index = registry.*.types.length
    unsafe { registry.*.types = Vector.append(registry.*.types, @ptrCast([*]const u8, &copy)) }
    registry.*.typeMap = hash_map.put(registry.*.typeMap, value.name, index)
}

// <type ...> inside <types>.
fn readType(registry: *Registry, reader: *Reader) -> bool {
    var attributes: Attributes = undefined
    const has_content = readAttributes(reader, &attributes)
    const blank = empty(registry)
    const api = attribute(&attributes, "api", blank)
    if !forVulkan(api) {
        if has_content { skipContent(reader) }
        return true
    }
    const category = attribute(&attributes, "category", blank)
    var value = Type.{
        .name = attribute(&attributes, "name", blank),
        .category = CATEGORY_OPAQUE,
        .alias = attribute(&attributes, "alias", blank),
        .base = blank,
        .flagBits = attribute(&attributes, "requires", blank),
        .memberStart = registry.*.members.length,
        .memberCount = 0,
        .returnedOnly = equals(attribute(&attributes, "returnedonly", blank), "true"),
        .hasBitfield = false,
        .required = false,
        .block = NONE,
    }
    if equals(category, "basetype") { value.category = CATEGORY_BASETYPE }
    if equals(category, "bitmask") {
        value.category = CATEGORY_BITMASK
        if hasAttribute(&attributes, "bitvalues") { value.flagBits = attribute(&attributes, "bitvalues", blank) }
    }
    if equals(category, "handle") { value.category = CATEGORY_HANDLE }
    if equals(category, "enum") { value.category = CATEGORY_ENUM }
    if equals(category, "struct") { value.category = CATEGORY_STRUCT }
    if equals(category, "union") { value.category = CATEGORY_UNION }
    if equals(category, "funcpointer") { value.category = CATEGORY_FUNCPOINTER }
    if equals(category, "include") || equals(category, "define") { value.category = CATEGORY_OTHER }
    if value.category == CATEGORY_OPAQUE && category.length > 0 { value.category = CATEGORY_OTHER }
    if value.category != CATEGORY_BITMASK { value.flagBits = blank }

    var element_name = blank
    var element_base = blank
    if has_content {
        var depth: usize = 1
        while advance(reader) {
            const token = reader.*.token.*
            if token.kind == xml.TokenKind.elementEnd {
                depth -= 1
                if depth == 0 { break }
            } else if token.kind == xml.TokenKind.elementStart {
                if equals(token.name, "member") {
                    var member_attributes: Attributes = undefined
                    var member = newMember(registry)
                    const member_content = readAttributes(reader, &member_attributes)
                    member.optional = firstOptional(attribute(&member_attributes, "optional", blank))
                    member.length = attribute(&member_attributes, "len", blank)
                    member.values = attribute(&member_attributes, "values", blank)
                    if member_content { readDeclaration(registry, reader, &member) }
                    if forVulkan(attribute(&member_attributes, "api", blank)) {
                        if member.bitfield { value.hasBitfield = true }
                        appendMember(registry, member)
                        value.memberCount += 1
                    }
                } else if equals(token.name, "name") {
                    element_name = readText(registry, reader)
                } else if equals(token.name, "type") {
                    element_base = readText(registry, reader)
                } else {
                    skipElement(reader)
                }
            } else if token.kind == xml.TokenKind.text && value.category == CATEGORY_OTHER && depth == 1 {
                // `#define <name>VK_HEADER_VERSION</name> 275`: keep the last text.
                element_base = copyString(token.value)
            }
        }
    }
    if element_name.length > 0 { value.name = element_name }
    if element_base.length > 0 { value.base = element_base }
    if value.name.length == 0 { return fail(registry, reader, "type without a name") }
    // The first definition for the vulkan API wins.
    if findType(registry, value.name) != NONE { return true }
    appendType(registry, value)
    return true
}

fn appendEnumerant(registry: *Registry, value: Enumerant) -> void {
    if findEnumerant(registry, value.name) != NONE { return }
    var copy = value
    const index = registry.*.enumerants.length
    unsafe { registry.*.enumerants = Vector.append(registry.*.enumerants, @ptrCast([*]const u8, &copy)) }
    registry.*.enumerantMap = hash_map.put(registry.*.enumerantMap, value.name, index)
}

fn bitValue(position: i64) -> i64 {
    const one: u64 = 1
    return @bitCast(i64, one << @intCast(u6, position))
}

// <enums name=... type=...> with its <enum> children.
fn readEnums(registry: *Registry, reader: *Reader) -> bool {
    var attributes: Attributes = undefined
    const has_content = readAttributes(reader, &attributes)
    const blank = empty(registry)
    const kind_text = attribute(&attributes, "type", blank)
    var block = Block.{
        .name = attribute(&attributes, "name", blank),
        .kind = BLOCK_CONSTANTS,
        .bitwidth = 32,
        .valueStart = registry.*.enumerants.length,
    }
    if equals(kind_text, "enum") { block.kind = BLOCK_ENUM }
    if equals(kind_text, "bitmask") { block.kind = BLOCK_BITMASK }
    if equals(attribute(&attributes, "bitwidth", blank), "64") { block.bitwidth = 64 }
    const block_index = registry.*.blocks.length
    var copy = block
    unsafe { registry.*.blocks = Vector.append(registry.*.blocks, @ptrCast([*]const u8, &copy)) }
    registry.*.blockMap = hash_map.put(registry.*.blockMap, block.name, block_index)
    if !has_content { return true }
    var depth: usize = 1
    while advance(reader) {
        const token = reader.*.token.*
        if token.kind == xml.TokenKind.elementEnd {
            depth -= 1
            if depth == 0 { return true }
        } else if token.kind == xml.TokenKind.elementStart {
            if equals(token.name, "enum") {
                var enum_attributes: Attributes = undefined
                const enum_content = readAttributes(reader, &enum_attributes)
                if enum_content { skipContent(reader) }
                if forVulkan(attribute(&enum_attributes, "api", blank)) {
                    var value = Enumerant.{
                        .name = attribute(&enum_attributes, "name", blank),
                        .block = block_index,
                        .value = 0,
                        .alias = attribute(&enum_attributes, "alias", blank),
                        .text = attribute(&enum_attributes, "value", blank),
                        .constantType = attribute(&enum_attributes, "type", blank),
                        .required = false,
                    }
                    if hasAttribute(&enum_attributes, "bitpos") {
                        var position: i64 = 0
                        if !parseNumber(attribute(&enum_attributes, "bitpos", blank), &position) { return fail(registry, reader, "invalid bitpos") }
                        value.value = bitValue(position)
                    } else if value.alias.length == 0 && block.kind != BLOCK_CONSTANTS {
                        var parsed: i64 = 0
                        if !parseNumber(value.text, &parsed) { return fail(registry, reader, "invalid enumerant value") }
                        value.value = parsed
                    }
                    appendEnumerant(registry, value)
                }
            } else {
                skipElement(reader)
            }
        }
    }
    return true
}

fn appendCommand(registry: *Registry, value: Command) -> void {
    if findCommand(registry, value.name) != NONE { return }
    var copy = value
    const index = registry.*.commands.length
    unsafe { registry.*.commands = Vector.append(registry.*.commands, @ptrCast([*]const u8, &copy)) }
    registry.*.commandMap = hash_map.put(registry.*.commandMap, value.name, index)
}

// <command> inside <commands>: either an alias or a prototype with params.
fn readCommand(registry: *Registry, reader: *Reader) -> bool {
    var attributes: Attributes = undefined
    const has_content = readAttributes(reader, &attributes)
    const blank = empty(registry)
    var value = Command.{
        .name = attribute(&attributes, "name", blank),
        .alias = attribute(&attributes, "alias", blank),
        .returnType = blank,
        .paramStart = registry.*.members.length,
        .paramCount = 0,
        .required = false,
    }
    const for_vulkan = forVulkan(attribute(&attributes, "api", blank))
    if has_content {
        var depth: usize = 1
        while advance(reader) {
            const token = reader.*.token.*
            if token.kind == xml.TokenKind.elementEnd {
                depth -= 1
                if depth == 0 { break }
            } else if token.kind == xml.TokenKind.elementStart {
                if equals(token.name, "proto") {
                    var prototype = newMember(registry)
                    var proto_attributes: Attributes = undefined
                    if readAttributes(reader, &proto_attributes) { readDeclaration(registry, reader, &prototype) }
                    value.name = prototype.name
                    value.returnType = prototype.typeName
                    if prototype.pointers > 0 { value.returnType = string.fromSlice("void*") }
                } else if equals(token.name, "param") {
                    var parameter = newMember(registry)
                    var param_attributes: Attributes = undefined
                    const param_content = readAttributes(reader, &param_attributes)
                    parameter.optional = firstOptional(attribute(&param_attributes, "optional", blank))
                    parameter.length = attribute(&param_attributes, "len", blank)
                    if param_content { readDeclaration(registry, reader, &parameter) }
                    if for_vulkan && forVulkan(attribute(&param_attributes, "api", blank)) {
                        appendMember(registry, parameter)
                        value.paramCount += 1
                    }
                } else {
                    skipElement(reader)
                }
            }
        }
    }
    if value.name.length == 0 { return fail(registry, reader, "command without a name") }
    if for_vulkan { appendCommand(registry, value) }
    return true
}

// ---------------------------------------------------------------------------
// Features and extensions

fn versionMinor(name: String) -> usize {
    // "VK_VERSION_1_<minor>"
    if name.length != 14 || !equals(string.fromParts(name.pointer, 13), "VK_VERSION_1_") { return NONE }
    const digit = name.pointer[13]
    if digit < 48 || digit > 57 { return NONE }
    return @intCast(usize, digit - 48)
}

fn extensionSelected(registry: *const Registry, name: String) -> bool {
    var index: usize = 0
    while index < registry.*.selection.extensionCount {
        if string.eql(registry.*.selection.extensions[index], name) { return true }
        index += 1
    }
    return false
}

fn available(registry: *const Registry, name: String) -> bool {
    const minor = versionMinor(name)
    if minor != NONE { return minor <= @intCast(usize, registry.*.selection.maxMinor) }
    return extensionSelected(registry, name)
}

// A `depends` expression is satisfied when every feature or extension it
// names is selected (a conservative reading of its ',' and '+').
fn dependsSatisfied(registry: *const Registry, expression: String) -> bool {
    var start: usize = 0
    var index: usize = 0
    while index <= expression.length {
        var separator = index == expression.length
        if !separator {
            const byte = expression.pointer[index]
            separator = byte == 44 || byte == 43 || byte == 40 || byte == 41
        }
        if separator {
            if index > start {
                const name = slice(expression, start, index - start)
                if !available(registry, name) { return false }
            }
            start = index + 1
        }
        index += 1
    }
    return true
}

// <require> of a selected feature or extension.
fn readRequire(registry: *Registry, reader: *Reader, extension_number: i64) -> bool {
    var attributes: Attributes = undefined
    const has_content = readAttributes(reader, &attributes)
    if !has_content { return true }
    const blank = empty(registry)
    if !forVulkan(attribute(&attributes, "api", blank)) || !dependsSatisfied(registry, attribute(&attributes, "depends", blank)) {
        skipContent(reader)
        return true
    }
    var depth: usize = 1
    while advance(reader) {
        const token = reader.*.token.*
        if token.kind == xml.TokenKind.elementEnd {
            depth -= 1
            if depth == 0 { return true }
        } else if token.kind == xml.TokenKind.elementStart {
            var item: Attributes = undefined
            const item_content = readAttributes(reader, &item)
            if item_content { skipContent(reader) }
            const name = attribute(&item, "name", blank)
            if !forVulkan(attribute(&item, "api", blank)) {
                // not for this API
            } else if equals(token.name, "type") {
                registry.*.requiredTypes = addName(registry.*.requiredTypes, name)
            } else if equals(token.name, "command") {
                registry.*.requiredCommands = addName(registry.*.requiredCommands, name)
            } else if equals(token.name, "enum") {
                const extends = attribute(&item, "extends", blank)
                if extends.length > 0 {
                    const block = findBlock(registry, extends)
                    if block == NONE { return fail(registry, reader, "enumerant extends an unknown enumeration") }
                    var value = Enumerant.{
                        .name = name,
                        .block = block,
                        .value = 0,
                        .alias = attribute(&item, "alias", blank),
                        .text = attribute(&item, "value", blank),
                        .constantType = blank,
                        .required = true,
                    }
                    if hasAttribute(&item, "offset") {
                        var offset: i64 = 0
                        var number = extension_number
                        if !parseNumber(attribute(&item, "offset", blank), &offset) { return fail(registry, reader, "invalid offset") }
                        if hasAttribute(&item, "extnumber") {
                            if !parseNumber(attribute(&item, "extnumber", blank), &number) { return fail(registry, reader, "invalid extnumber") }
                        }
                        value.value = 1000000000 + (number - 1) * 1000 + offset
                        if equals(attribute(&item, "dir", blank), "-") { value.value = 0 - value.value }
                    } else if hasAttribute(&item, "bitpos") {
                        var position: i64 = 0
                        if !parseNumber(attribute(&item, "bitpos", blank), &position) { return fail(registry, reader, "invalid bitpos") }
                        value.value = bitValue(position)
                    } else if value.alias.length == 0 {
                        var parsed: i64 = 0
                        if !parseNumber(value.text, &parsed) { return fail(registry, reader, "invalid enumerant value") }
                        value.value = parsed
                    }
                    const existing = findEnumerant(registry, name)
                    if existing == NONE {
                        appendEnumerant(registry, value)
                    } else {
                        enumerantAt(registry, existing).*.required = true
                    }
                } else if hasAttribute(&item, "value") && findEnumerant(registry, name) == NONE {
                    // An extension's own constant (SPEC_VERSION, EXTENSION_NAME).
                    appendEnumerant(registry, Enumerant.{
                        .name = name,
                        .block = NONE,
                        .value = 0,
                        .alias = blank,
                        .text = attribute(&item, "value", blank),
                        .constantType = blank,
                        .required = true,
                    })
                } else {
                    registry.*.requiredEnumerants = addName(registry.*.requiredEnumerants, name)
                }
            }
        }
    }
    return true
}

// <feature> or <extension>: its requirements count when it is selected.
fn readRequirements(registry: *Registry, reader: *Reader, is_extension: bool) -> bool {
    var attributes: Attributes = undefined
    const has_content = readAttributes(reader, &attributes)
    if !has_content { return true }
    const blank = empty(registry)
    const name = attribute(&attributes, "name", blank)
    var selected = false
    var number: i64 = 0
    if is_extension {
        selected = extensionSelected(registry, name) && forVulkan(attribute(&attributes, "supported", blank))
        if selected && !parseNumber(attribute(&attributes, "number", blank), &number) { return fail(registry, reader, "extension without a number") }
    } else {
        selected = forVulkan(attribute(&attributes, "api", blank)) && available(registry, name)
    }
    if !selected {
        skipContent(reader)
        return true
    }
    var depth: usize = 1
    while advance(reader) {
        const token = reader.*.token.*
        if token.kind == xml.TokenKind.elementEnd {
            depth -= 1
            if depth == 0 { return true }
        } else if token.kind == xml.TokenKind.elementStart {
            if equals(token.name, "require") {
                if !readRequire(registry, reader, number) { return false }
            } else {
                skipElement(reader)
            }
        }
    }
    return true
}

// ---------------------------------------------------------------------------
// Parsing

pub fn initAt(registry: *Registry, allocator: Allocator, source: [*]const u8, length: usize, selection: Selection) -> void {
    registry.*.allocator = allocator
    registry.*.source = source
    registry.*.length = length
    registry.*.types = Vector.init(allocator, @sizeOf(Type), @alignOf(Type), 4096)
    registry.*.members = Vector.init(allocator, @sizeOf(Member), @alignOf(Member), 16384)
    registry.*.blocks = Vector.init(allocator, @sizeOf(Block), @alignOf(Block), 512)
    registry.*.enumerants = Vector.init(allocator, @sizeOf(Enumerant), @alignOf(Enumerant), 16384)
    registry.*.commands = Vector.init(allocator, @sizeOf(Command), @alignOf(Command), 1024)
    registry.*.typeMap = hash_map.init(allocator, 8192)
    registry.*.blockMap = hash_map.init(allocator, 1024)
    registry.*.enumerantMap = hash_map.init(allocator, 32768)
    registry.*.commandMap = hash_map.init(allocator, 2048)
    registry.*.requiredTypes = Vector.init(allocator, @sizeOf(String), @alignOf(String), 1024)
    registry.*.requiredCommands = Vector.init(allocator, @sizeOf(String), @alignOf(String), 512)
    registry.*.requiredEnumerants = Vector.init(allocator, @sizeOf(String), @alignOf(String), 512)
    registry.*.selection = selection
    registry.*.headerVersion = 0
    registry.*.failure = string.fromSlice("")
    registry.*.errorLine = 0
}

// Reads the registry. Returns false with `failure`/`errorLine` set when the
// XML is malformed or the registry is inconsistent.
pub fn parse(registry: *Registry) -> bool {
    var tokenizer: xml.Tokenizer = undefined
    var token: xml.Token = undefined
    xml.initAt(&tokenizer, registry.*.source, registry.*.length)
    var reader = Reader.{ .tokenizer = &tokenizer, .token = &token, .pending = false }
    var in_types = false
    var in_commands = false
    var in_extensions = false
    while advance(&reader) {
        const current = token
        if current.kind == xml.TokenKind.elementStart {
            const depth = xml.depth(&tokenizer)
            if depth == 2 && equals(current.name, "types") {
                in_types = true
            } else if depth == 2 && equals(current.name, "commands") {
                in_commands = true
            } else if depth == 2 && equals(current.name, "extensions") {
                in_extensions = true
            } else if depth == 2 && equals(current.name, "enums") {
                if !readEnums(registry, &reader) { return false }
            } else if depth == 2 && equals(current.name, "feature") {
                if !readRequirements(registry, &reader, false) { return false }
            } else if depth == 3 && in_types && equals(current.name, "type") {
                if !readType(registry, &reader) { return false }
            } else if depth == 3 && in_commands && equals(current.name, "command") {
                if !readCommand(registry, &reader) { return false }
            } else if depth == 3 && in_extensions && equals(current.name, "extension") {
                if !readRequirements(registry, &reader, true) { return false }
            } else if depth >= 2 {
                skipElement(&reader)
            }
        } else if current.kind == xml.TokenKind.elementEnd {
            if xml.depth(&tokenizer) == 1 {
                in_types = false
                in_commands = false
                in_extensions = false
            }
        }
    }
    if xml.failed(&tokenizer) {
        registry.*.failure = string.fromSlice(xml.errorMessage(xml.errorCode(&tokenizer)))
        registry.*.errorLine = xml.lineOf(&tokenizer, xml.errorOffset(&tokenizer))
        return false
    }
    return true
}

// ---------------------------------------------------------------------------
// Closure of required definitions

fn requireType(registry: *Registry, name: String) -> bool {
    const index = findType(registry, name)
    if index == NONE {
        // C scalar types (uint32_t, char, void, ...) are not registry types.
        return true
    }
    const value = typeAt(registry, index)
    if value.*.required { return true }
    value.*.required = true
    if value.*.alias.length > 0 { return requireType(registry, value.*.alias) }
    if value.*.category == CATEGORY_BITMASK && value.*.flagBits.length > 0 {
        if !requireType(registry, value.*.flagBits) { return false }
    }
    if value.*.category == CATEGORY_BASETYPE && value.*.base.length > 0 {
        if !requireType(registry, value.*.base) { return false }
    }
    if value.*.category == CATEGORY_ENUM {
        value.*.block = findBlock(registry, value.*.name)
    }
    if value.*.category == CATEGORY_STRUCT || value.*.category == CATEGORY_UNION {
        var member: usize = 0
        while member < value.*.memberCount {
            const field = memberAt(registry, value.*.memberStart + member)
            if !requireType(registry, field.*.typeName) { return false }
            member += 1
        }
    }
    return true
}

fn requireCommand(registry: *Registry, name: String) -> bool {
    const index = findCommand(registry, name)
    if index == NONE {
        registry.*.failure = name
        return false
    }
    const command = commandAt(registry, index)
    if command.*.required { return true }
    command.*.required = true
    if command.*.alias.length > 0 { return requireCommand(registry, command.*.alias) }
    if !requireType(registry, command.*.returnType) { return false }
    var parameter: usize = 0
    while parameter < command.*.paramCount {
        if !requireType(registry, memberAt(registry, command.*.paramStart + parameter).*.typeName) { return false }
        parameter += 1
    }
    return true
}

// Marks everything the selected features and extensions require, directly
// or through the types they use. Returns false (with `failure` naming the
// definition) when a requirement is missing from the registry.
pub fn resolve(registry: *Registry) -> bool {
    var index: usize = 0
    while index < registry.*.requiredCommands.length {
        if !requireCommand(registry, nameAt(&registry.*.requiredCommands, index)) { return false }
        index += 1
    }
    index = 0
    while index < registry.*.requiredTypes.length {
        if !requireType(registry, nameAt(&registry.*.requiredTypes, index)) { return false }
        index += 1
    }
    index = 0
    while index < registry.*.requiredEnumerants.length {
        const found = findEnumerant(registry, nameAt(&registry.*.requiredEnumerants, index))
        if found != NONE { enumerantAt(registry, found).*.required = true }
        index += 1
    }
    // A FlagBits or enum type found through a bitmask needs its block too.
    index = 0
    while index < registry.*.types.length {
        const value = typeAt(registry, index)
        if value.*.required && value.*.category == CATEGORY_ENUM && value.*.block == NONE {
            value.*.block = findBlock(registry, value.*.name)
        }
        index += 1
    }
    // The header version, from `#define VK_HEADER_VERSION <n>`.
    const header = findType(registry, string.fromSlice("VK_HEADER_VERSION"))
    if header != NONE {
        const text = typeAt(registry, header).*.base
        var number: usize = 0
        var position: usize = 0
        while position < text.length {
            const byte = text.pointer[position]
            if byte >= 48 && byte <= 57 { number = number * 10 + @intCast(usize, byte - 48) }
            position += 1
        }
        registry.*.headerVersion = number
    }
    return true
}
