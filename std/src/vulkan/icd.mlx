// std.vulkan.icd: the driver side of the Vulkan loader/driver interface
// (Khronos LoaderDriverInterface), the building blocks for a Vulkan driver
// written in Mlx (the brixOS GPU drivers, or a software rasterizer).
//
// A driver (ICD) is a shared library that
//
//   1. exports vk_icdNegotiateLoaderICDInterfaceVersion(uint32_t* version):
//      the loader passes the highest interface version it supports; the
//      driver answers min(that, its own) and returns VK_SUCCESS, or
//      VK_ERROR_INCOMPATIBLE_DRIVER when the loader's version is too old;
//   2. exports vk_icdGetInstanceProcAddr (and, from interface 4,
//      vk_icdGetPhysicalDeviceProcAddr), through which every other entry
//      point is found;
//   3. starts each dispatchable object (VkInstance, VkPhysicalDevice,
//      VkDevice, VkQueue, VkCommandBuffer) with a pointer-sized word holding
//      LOADER_MAGIC, which a loader may overwrite with its dispatch table;
//   4. from interface 3, creates VkSurfaceKHR objects itself;
//   5. is announced by a JSON manifest (writeManifest) installed in an icd.d
//      directory.
//
// `negotiate`, `initDispatchable` and `writeManifest` implement 1, 3 and 5.
// Building the library itself needs shared-object output for the target
// (the aarch64-android target has it; x86_64 writes executables so far).

const allocator_module = @import("../../bootstrap/allocator.mlx")
const string = @import("../../bootstrap/string.mlx")
const array_list = @import("../../bootstrap/array_list.mlx")
const json = @import("../json.mlx")
const vk = @import("../vulkan.mlx")

pub const String = string.String
pub const ArrayList = array_list.ArrayList

// ICD_LOADER_MAGIC (0x01CDC0DE).
pub const LOADER_MAGIC: usize = 0x01CDC0DE

pub const NEGOTIATE_ENTRY = "vk_icdNegotiateLoaderICDInterfaceVersion"
pub const GET_INSTANCE_PROC_ADDR_ENTRY = "vk_icdGetInstanceProcAddr"
pub const GET_PHYSICAL_DEVICE_PROC_ADDR_ENTRY = "vk_icdGetPhysicalDeviceProcAddr"

// The interface versions this module describes (see std.vulkan.loader).
pub const INTERFACE_VERSION: u32 = 5
pub const MINIMUM_INTERFACE_VERSION: u32 = 3

// The first word of every dispatchable object a driver creates.
pub const DispatchableHeader = struct {
    loaderData: usize
}

pub fn initDispatchable(header: *DispatchableHeader) -> void {
    header.*.loaderData = LOADER_MAGIC
}

// True when the object at `handle` (a dispatchable handle) was created by a
// driver and not yet claimed by a loader.
pub fn hasLoaderMagic(handle: usize) -> bool {
    if handle == 0 { return false }
    unsafe { return @ptrFromInt(*const usize, handle).* == LOADER_MAGIC }
}

// The driver's answer to vk_icdNegotiateLoaderICDInterfaceVersion:
// `supported` is the highest version the driver implements.
pub fn negotiate(version: *u32, supported: u32) -> vk.Result {
    if version.* < MINIMUM_INTERFACE_VERSION { return vk.Result.errorIncompatibleDriver }
    if version.* > supported { version.* = supported }
    return vk.Result.success
}

fn append(out: *ArrayList, text: []const u8) -> void {
    for byte in text {
        const ignored = ArrayList.appendAt(out, byte)
    }
}

fn appendNumber(out: *ArrayList, value: u32) -> void {
    var digits: [12]u8 = undefined
    var count: usize = 0
    var rest = value
    if rest == 0 {
        const zero = ArrayList.appendAt(out, 48)
        return
    }
    while rest > 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    while count > 0 {
        count -= 1
        const digit = ArrayList.appendAt(out, digits[count])
    }
}

fn appendJsonString(out: *ArrayList, value: String) -> bool {
    var buffer: [1100]u8 = undefined
    var length: isize = 0
    unsafe { length = json.escapeString(value, @ptrCast([*]u8, &buffer), 1100) }
    if length < 0 { return false }
    var index: usize = 0
    while index < @bitCast(usize, length) {
        const ignored = ArrayList.appendAt(out, buffer[index])
        index += 1
    }
    return true
}

// Writes the ICD manifest announcing a driver library (file format 1.0.1):
//
//   { "file_format_version": "1.0.1",
//     "ICD": { "library_path": ..., "api_version": "1.3.0",
//              "library_arch": "64", "is_portability_driver": false } }
//
// `library_path` is absolute, relative to the manifest's directory (when it
// contains a slash), or a bare name for the dynamic linker's search path.
// Returns false when the path is longer than 180 bytes.
pub fn writeManifest(out: *ArrayList, library_path: String, api_version: u32, portability: bool) -> bool {
    if library_path.length > 180 { return false }
    append(out, "{\n    \"file_format_version\": \"1.0.1\",\n    \"ICD\": {\n        \"library_path\": ")
    if !appendJsonString(out, library_path) { return false }
    append(out, ",\n        \"api_version\": \"")
    appendNumber(out, vk.apiVersionMajor(api_version))
    append(out, ".")
    appendNumber(out, vk.apiVersionMinor(api_version))
    append(out, ".")
    appendNumber(out, vk.apiVersionPatch(api_version))
    append(out, "\",\n        \"library_arch\": \"64\",\n        \"is_portability_driver\": ")
    append(out, if portability { "true" } else { "false" })
    append(out, "\n    }\n}\n")
    return true
}
