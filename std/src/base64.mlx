// std.base64: the encodings of RFC 4648 — base64 (section 4), base64url
// (section 5), base32 (section 6), base32hex (section 7) and base16
// (section 8) — and lower-case hex, the way digests are written. Nothing
// is allocated: the caller gives the output, sized with encodedLength and
// decodedLength.
//
//     var out: [8]u8 = undefined
//     const count = base64.encode(base64.Encoding.base64, "foo", &out, true)   // "Zm9v"
//
//     var decoded: [8]u8 = undefined
//     const result = base64.decode(base64.Encoding.base64, "Zm9v", &decoded, false)
//     // result.ok, result.length == 3
//
// Data that comes in pieces (a file read a buffer at a time) goes through
// an Encoder or a Decoder, which keep the bits that do not yet make a
// whole symbol or byte between the pieces:
//
//     var encoder: base64.Encoder = undefined
//     base64.encoderInit(&encoder, base64.Encoding.base32)
//     count = base64.encodeUpdate(&encoder, piece, out)   // room: encodedLength(piece.length) + 8
//     count = base64.encodeFinal(&encoder, out, true)      // the last symbol and the padding
//
//     var decoder: base64.Decoder = undefined
//     base64.decoderInit(&decoder, base64.Encoding.base32, false)
//     const step = base64.decodeUpdate(&decoder, piece, out)   // room: decodedLength(piece.length) + 1
//
// Decoding skips line breaks, spaces and tabs, stops at the first "="
// (what follows the padding is ignored), and drops the bits left over at
// the end that do not make a whole byte. A byte outside the alphabet is
// an error, or is skipped when the decoder ignores garbage (as base64 -i).

pub const Encoding = enum(u8) {
    base64,
    base64url,
    base32,
    base32hex,
    base16,
}

// What decoding gave: how many bytes it wrote and whether the text was
// all in the alphabet.
pub const Decoded = struct {
    length: usize
    ok: bool
}

pub const Encoder = struct {
    encoding: Encoding
    // The bits not yet written (fewer than a symbol's), and how many.
    pending: u64
    bits: u64
    // Symbols written so far, for the padding.
    symbols: usize
}

pub const Decoder = struct {
    encoding: Encoding
    pending: u64
    bits: u64
    // After the padding nothing more is decoded.
    ended: bool
    ignoreGarbage: bool
}

const PAD: u8 = 61

// The encoding's symbols, in value order.
pub fn alphabet(encoding: Encoding) -> []const u8 {
    if encoding == Encoding.base64 { return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" }
    if encoding == Encoding.base64url { return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_" }
    if encoding == Encoding.base32 { return "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567" }
    if encoding == Encoding.base32hex { return "0123456789ABCDEFGHIJKLMNOPQRSTUV" }
    return "0123456789ABCDEF"
}

// Bits a symbol carries: 6, 5 or 4.
pub fn symbolBits(encoding: Encoding) -> u64 {
    if encoding == Encoding.base64 || encoding == Encoding.base64url { return 6 }
    if encoding == Encoding.base32 || encoding == Encoding.base32hex { return 5 }
    return 4
}

// Symbols in a padded group: 4 for base64 (3 bytes), 8 for base32 (5
// bytes), 2 for base16 (1 byte, never padded).
pub fn groupSymbols(encoding: Encoding) -> usize {
    if encoding == Encoding.base64 || encoding == Encoding.base64url { return 4 }
    if encoding == Encoding.base32 || encoding == Encoding.base32hex { return 8 }
    return 2
}

// The value of symbol `byte`, 255 when it is not in the alphabet.
pub fn symbolValue(encoding: Encoding, byte: u8) -> u8 {
    if encoding == Encoding.base64 || encoding == Encoding.base64url {
        if byte >= 65 && byte <= 90 { return byte - 65 }
        if byte >= 97 && byte <= 122 { return byte - 71 }
        if byte >= 48 && byte <= 57 { return byte + 4 }
        if encoding == Encoding.base64 {
            if byte == 43 { return 62 }
            if byte == 47 { return 63 }
        } else {
            if byte == 45 { return 62 }
            if byte == 95 { return 63 }
        }
        return 255
    }
    if encoding == Encoding.base32 {
        if byte >= 65 && byte <= 90 { return byte - 65 }
        if byte >= 50 && byte <= 55 { return byte - 24 }
        return 255
    }
    if byte >= 48 && byte <= 57 { return byte - 48 }
    if encoding == Encoding.base32hex {
        if byte >= 65 && byte <= 86 { return byte - 55 }
        return 255
    }
    if byte >= 65 && byte <= 70 { return byte - 55 }
    return 255
}

// Symbols for `length` bytes, padded to whole groups or not.
pub fn encodedLength(encoding: Encoding, length: usize, padded: bool) -> usize {
    const bits = @intCast(usize, symbolBits(encoding))
    const symbols = (length * 8 + bits - 1) / bits
    if !padded { return symbols }
    const group = groupSymbols(encoding)
    return (symbols + group - 1) / group * group
}

// At most how many bytes `length` symbols decode to.
pub fn decodedLength(encoding: Encoding, length: usize) -> usize {
    return length * @intCast(usize, symbolBits(encoding)) / 8
}

pub fn encoderInit(encoder: *Encoder, encoding: Encoding) -> void {
    encoder.*.encoding = encoding
    encoder.*.pending = 0
    encoder.*.bits = 0
    encoder.*.symbols = 0
}

// Encodes `bytes` into `out`: how many symbols it wrote (up to
// encodedLength(bytes.length, false) + 1).
pub fn encodeUpdate(encoder: *Encoder, bytes: []const u8, out: [*]u8) -> usize {
    const symbols = alphabet(encoder.*.encoding)
    const width = symbolBits(encoder.*.encoding)
    const mask: u64 = (@intCast(u64, 1) << width) - 1
    var pending = encoder.*.pending
    var bits = encoder.*.bits
    var written: usize = 0
    for byte in bytes {
        pending = (pending << 8) | @intCast(u64, byte)
        bits += 8
        while bits >= width {
            bits -= width
            out[written] = symbols[@intCast(usize, (pending >> bits) & mask)]
            written += 1
        }
        pending = pending & ((@intCast(u64, 1) << bits) - 1)
    }
    encoder.*.pending = pending
    encoder.*.bits = bits
    encoder.*.symbols += written
    return written
}

// The last symbol (its bits filled with zeros) and, when `padded`, the
// "=" that make the output whole groups: how many bytes it wrote (at most
// a group's).
pub fn encodeFinal(encoder: *Encoder, out: [*]u8, padded: bool) -> usize {
    const symbols = alphabet(encoder.*.encoding)
    const width = symbolBits(encoder.*.encoding)
    const mask: u64 = (@intCast(u64, 1) << width) - 1
    var written: usize = 0
    if encoder.*.bits > 0 {
        out[0] = symbols[@intCast(usize, (encoder.*.pending << (width - encoder.*.bits)) & mask)]
        written = 1
    }
    var total = encoder.*.symbols + written
    if padded {
        const group = groupSymbols(encoder.*.encoding)
        while total % group != 0 {
            out[written] = PAD
            written += 1
            total += 1
        }
    }
    encoder.*.pending = 0
    encoder.*.bits = 0
    encoder.*.symbols = total
    return written
}

// `bytes` encoded into `out` (room for encodedLength(bytes.length,
// padded)): how many symbols.
pub fn encode(encoding: Encoding, bytes: []const u8, out: [*]u8, padded: bool) -> usize {
    var encoder: Encoder = undefined
    encoderInit(&encoder, encoding)
    const body = encodeUpdate(&encoder, bytes, out)
    const rest: [*]u8 = unsafe { out + body }
    return body + encodeFinal(&encoder, rest, padded)
}

pub fn decoderInit(decoder: *Decoder, encoding: Encoding, ignoreGarbage: bool) -> void {
    decoder.*.encoding = encoding
    decoder.*.pending = 0
    decoder.*.bits = 0
    decoder.*.ended = false
    decoder.*.ignoreGarbage = ignoreGarbage
}

// Decodes `text` into `out` (room for decodedLength(text.length) + 1):
// the bytes it wrote, and false at a byte outside the alphabet (the
// bytes before it are written).
pub fn decodeUpdate(decoder: *Decoder, text: []const u8, out: [*]u8) -> Decoded {
    const width = symbolBits(decoder.*.encoding)
    var pending = decoder.*.pending
    var bits = decoder.*.bits
    var written: usize = 0
    var ok = true
    var index: usize = 0
    while index < text.length && !decoder.*.ended {
        const byte = text[index]
        index += 1
        if byte == 10 || byte == 13 || byte == 32 || byte == 9 { continue }
        if byte == PAD {
            decoder.*.ended = true
            break
        }
        const value = symbolValue(decoder.*.encoding, byte)
        if value == 255 {
            if decoder.*.ignoreGarbage { continue }
            ok = false
            break
        }
        pending = (pending << width) | @intCast(u64, value)
        bits += width
        if bits >= 8 {
            bits -= 8
            out[written] = @intCast(u8, (pending >> bits) & 255)
            written += 1
        }
        pending = pending & ((@intCast(u64, 1) << bits) - 1)
    }
    decoder.*.pending = pending
    decoder.*.bits = bits
    return Decoded.{ .length = written, .ok = ok }
}

// `text` decoded into `out` (room for decodedLength(text.length)).
pub fn decode(encoding: Encoding, text: []const u8, out: [*]u8, ignoreGarbage: bool) -> Decoded {
    var decoder: Decoder = undefined
    decoderInit(&decoder, encoding, ignoreGarbage)
    return decodeUpdate(&decoder, text, out)
}

// ---------------------------------------------------------------------------
// Lower-case hex, as digests are printed (base16 is upper-case).

// `bytes` as two lower-case hex digits each into `out`: how many digits.
pub fn hexEncode(bytes: []const u8, out: [*]u8) -> usize {
    const digits = "0123456789abcdef"
    var index: usize = 0
    while index < bytes.length {
        const byte = bytes[index]
        out[index * 2] = digits[@intCast(usize, (byte >> 4) & 15)]
        out[index * 2 + 1] = digits[@intCast(usize, byte & 15)]
        index += 1
    }
    return bytes.length * 2
}

// The value of a hex digit of either case, 255 for anything else.
pub fn hexValue(byte: u8) -> u8 {
    if byte >= 48 && byte <= 57 { return byte - 48 }
    if byte >= 97 && byte <= 102 { return byte - 87 }
    if byte >= 65 && byte <= 70 { return byte - 55 }
    return 255
}

// Hex digits of either case, two a byte, into `out` (text.length / 2
// bytes); false for an odd count or a byte that is no digit.
pub fn hexDecode(text: []const u8, out: [*]u8) -> bool {
    if text.length % 2 != 0 { return false }
    var index: usize = 0
    while index < text.length / 2 {
        const high = hexValue(text[index * 2])
        const low = hexValue(text[index * 2 + 1])
        if high == 255 || low == 255 { return false }
        out[index] = (high << 4) | low
        index += 1
    }
    return true
}
