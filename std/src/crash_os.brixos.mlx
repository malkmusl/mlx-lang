// What std.crash asks of brixOS (crash_os.mlx is Linux's): a fault comes
// as the fault event through the program's one upcall (os/upcalls.mlx:
// shared with std.events), whose context has the registers and the
// fault's address; they are given to std.crash's handler as a signal
// handler gets them (the signal the fault would be, a siginfo with the
// address, a ucontext with the registers in their places), so the report
// is the same one. The program's own file is the one process_self names;
// files are read and mapped by node calls; memory_region says what is
// mapped.
const brix = @import("../bootstrap/os/brix.mlx")
const upcalls = @import("../bootstrap/os/upcalls.mlx")

pub const Crashed = fn(signal: i32, info: usize, context: usize) -> void

pub const FAIL_SIGNAL: usize = 12

// ucontext_t's gregs (from byte 40): r8 to r15, rdi, rsi, rbp, rbx, rdx,
// rax, rcx, rsp, rip, ..., the exception's number at 20.
const GREGS: usize = 5
// siginfo_t's si_code: an address that is not mapped; none (a general
// protection fault).
const SEGV_MAPERR: usize = 1
const SI_KERNEL: usize = 128
// Sent by a process (kill), not the processor's.
const SI_USER: usize = 0
// A fault event's detail: the signal it was sent as (abort), not the
// processor's exception.
const SENT: u32 = 0x80000000

var handler: Crashed = undefined // (per run)
// The siginfo and the ucontext the handler gets: not values of onFault's
// own (a full value arena is a crash the handler makes room for first).
var faultInfo: [16]usize = undefined // (per run)
var faultRegisters: [32]usize = undefined // (per run)
// The context's registers in gregs' order.
const ORDER = [16]usize{ upcalls.R8, upcalls.R9, upcalls.R10, upcalls.R11, upcalls.R12, upcalls.R13, upcalls.R14, upcalls.R15, upcalls.RDI, upcalls.RSI, upcalls.RBP, upcalls.RBX, upcalls.RDX, upcalls.RAX, upcalls.RCX, upcalls.RSP }

pub fn threadId() -> u32 { return 1 }

pub fn processId() -> usize {
    var record: brix.ProcessRecord = undefined
    var none: [1]u8 = undefined
    if brix.processSelf(&record, none[0..0]) < 0 { return 0 }
    return @intCast(usize, record.pid)
}

// (A brixOS process runs one thread: nobody else says a crash.)
pub fn idle() -> void { _ = brix.call3(brix.WAIT, 0, 0, brix.clock(brix.Clock.MONOTONIC) + 1000000000) }

pub fn exit(code: usize) -> void { brix.exit(code) }

pub fn mapMemory(size: usize) -> usize {
    const result = brix.map(size)
    return if result < 0 { 0 } else { @bitCast(usize, result) }
}

pub fn unmapMemory(address: usize, size: usize) -> void { _ = brix.unmap(address, size) }

// Whether the page holding `address` is mapped (memory_region).
pub fn pageMapped(address: usize) -> bool {
    var region: [2]usize = [2]usize{ 0, 0 }
    return brix.memoryRegion(address, &region) == 0
}

// brixOS has no list of mappings: std.crash reads the program's file.
pub fn processMaps(into: [*]u8, capacity: usize) -> usize { return 0 }

pub fn ownImagePath(into: [*]u8, capacity: usize) -> usize {
    var record: brix.ProcessRecord = undefined
    const length = brix.processSelf(&record, into[0..capacity])
    return if length > 0 { @bitCast(usize, length) } else { 0 }
}

pub fn openOwnImage() -> isize {
    var path: [1024]u8 = undefined
    const bytes: [*]u8 = &path
    const length = ownImagePath(bytes, 1024)
    if length == 0 { return -2 }
    return brix.open(0, bytes[0..length], brix.Open.READ, 0)
}

pub fn openFile(path: [*]const u8) -> isize {
    var length: usize = 0
    while path[length] != 0 { length += 1 }
    return brix.open(0, path[0..length], brix.Open.READ, 0)
}

pub fn fileSize(file: isize) -> isize {
    var info: brix.NodeInfo = undefined
    if brix.nodeInfo(@intCast(brix.Handle, file), &info) < 0 { return -1 }
    return @intCast(isize, info.size)
}

// The file mapped as the process's own pages (node_map): the address, or
// below 0.
pub fn mapFile(file: isize, size: usize) -> isize { return brix.mapNode(@intCast(brix.Handle, file), 0, size) }

pub fn readAt(file: isize, address: usize, count: usize, offset: usize) -> isize {
    const into: [*]u8 = unsafe { @ptrFromInt([*]u8, address) }
    return brix.read(@intCast(brix.Handle, file), into[0..count], offset)
}

pub fn closeFile(file: isize) -> void { _ = brix.close(@intCast(brix.Handle, file)) }

// No signal to queue: fail() reports from where it is.
pub fn queueFailure(info: usize) -> bool { return false }

// The signal a processor's exception is, as Linux numbers them (the
// report says what each means).
fn signalOf(vector: usize) -> i32 {
    if vector == 0 || vector == 16 || vector == 19 { return 8 }
    if vector == 1 || vector == 3 { return 5 }
    if vector == 6 { return 4 }
    if vector == 17 { return 7 }
    return 11
}

// The fault: the registers as a ucontext's, the address as a siginfo's;
// std.crash's handler says where and ends the program.
fn onFault(record: upcalls.Record, context: usize) -> void {
    const info: [*]usize = &faultInfo
    const registers: [*]usize = &faultRegisters
    var index: usize = 0
    while index < 32 {
        registers[index] = 0
        if index < 16 { info[index] = 0 }
        index += 1
    }
    const vector = upcalls.word(context, upcalls.VECTOR)
    // A fault sent as a signal (an abort: the detail has its number) is
    // where the program was when it sent it, at no address.
    const sent = record.detail & SENT != 0
    const signal = if sent { @intCast(i32, record.detail & 0xFF) } else { signalOf(vector) }
    info[0] = @intCast(usize, signal)
    info[1] = if sent { SI_USER } else if vector == 14 { SEGV_MAPERR } else { SI_KERNEL }
    info[2] = if sent { @intCast(usize, 0) } else { upcalls.word(context, upcalls.FAULT_ADDRESS) }
    index = 0
    while index < 16 {
        registers[GREGS + index] = upcalls.word(context, ORDER[index])
        index += 1
    }
    registers[GREGS + 16] = upcalls.word(context, upcalls.RIP)
    registers[GREGS + 20] = vector
    handler(signal, @intFromPtr(info), @intFromPtr(registers))
}

// `crashed` for the faults, through the one upcall (on its own stack:
// `stack` is not needed); false when the upcall could not be set.
pub fn install(crashed: Crashed, stack: usize, size: usize) -> bool {
    handler = crashed
    if stack != 0 { _ = brix.unmap(stack, size) }
    return upcalls.handle(brix.Event.FAULT, onFault)
}
