// std.xdg: where a program keeps its files, by the XDG Base Directory
// Specification. A user's own directories are $XDG_CONFIG_HOME,
// $XDG_DATA_HOME, $XDG_CACHE_HOME and $XDG_STATE_HOME, else ~/.config,
// ~/.local/share, ~/.cache and ~/.local/state; the session's runtime
// directory is $XDG_RUNTIME_DIR; the system's are the colon-separated
// lists $XDG_DATA_DIRS (else /usr/local/share:/usr/share) and
// $XDG_CONFIG_DIRS (else /etc/xdg), searched after the user's own.
//
//     var path: [512]u8 = undefined
//     const bytes: [*]u8 = &path
//     const length = xdg.path(environment, xdg.CONFIG, "/mlx/audio.conf", bytes, 512)
//     if length == 0 { ... }                   // no home, or too long
//
//     const list = xdg.dataDirectories(environment)
//     var at: usize = 0
//     var directory: []const u8 = undefined
//     while xdg.nextDirectory(list, &at, &directory) { ... }
//
// As the specification asks, a variable that is empty or holds a relative
// path is ignored (the default stands in for it), and so is a $HOME that
// is not absolute. `environment` is the program's (or a child's)
// NUL-terminated environment list.
const std = @import("std")

// The kinds of a user's directory.
pub const CONFIG: u8 = 0
pub const DATA: u8 = 1
pub const CACHE: u8 = 2
pub const STATE: u8 = 3

// The value of `name` when it is an absolute path; empty otherwise.
pub fn absolute(environment: [*][*]const u8, name: []const u8) -> []const u8 {
    const value = std.process.environmentFrom(environment, name)
    if value == null || value.?.length == 0 || value.?.pointer[0] != 47 { return name[0..0] }
    return std.string.asSlice(value.?)
}

fn variableOf(kind: u8) -> []const u8 {
    if kind == CONFIG { return "XDG_CONFIG_HOME" }
    if kind == DATA { return "XDG_DATA_HOME" }
    if kind == CACHE { return "XDG_CACHE_HOME" }
    return "XDG_STATE_HOME"
}

// Where the kind's directory is under $HOME.
fn underHome(kind: u8) -> []const u8 {
    if kind == CONFIG { return "/.config" }
    if kind == DATA { return "/.local/share" }
    if kind == CACHE { return "/.cache" }
    return "/.local/state"
}

// The user's directory of `kind` into `into`, NUL-terminated: its length;
// 0 when there is none (neither the variable nor $HOME says) or it does
// not fit in `capacity` bytes with its NUL.
pub fn home(environment: [*][*]const u8, kind: u8, into: [*]u8, capacity: usize) -> usize {
    return path(environment, kind, "", into, capacity)
}

// The user's directory of `kind` with `rest` after it ("/mlx/audio.conf")
// into `into`, NUL-terminated: its length; 0 when there is no directory
// or the whole path does not fit (nothing of it is cut off).
pub fn path(environment: [*][*]const u8, kind: u8, rest: []const u8, into: [*]u8, capacity: usize) -> usize {
    var base = absolute(environment, variableOf(kind))
    var middle: []const u8 = ""
    if base.length == 0 {
        base = absolute(environment, "HOME")
        if base.length == 0 { return 0 }
        middle = underHome(kind)
    }
    const length = base.length + middle.length + rest.length
    if length + 1 > capacity { return 0 }
    var at = std.text.append(into, 0, capacity, base)
    at = std.text.append(into, at, capacity, middle)
    at = std.text.append(into, at, capacity, rest)
    into[at] = 0
    return at
}

// The session's runtime directory ($XDG_RUNTIME_DIR, NUL-terminated in
// the environment); empty when it is not set.
pub fn runtimeDirectory(environment: [*][*]const u8) -> []const u8 {
    return absolute(environment, "XDG_RUNTIME_DIR")
}

// The system's data directories, colon-separated: $XDG_DATA_DIRS, else
// /usr/local/share:/usr/share.
pub fn dataDirectories(environment: [*][*]const u8) -> []const u8 {
    const value = std.process.environmentFrom(environment, "XDG_DATA_DIRS")
    if value == null || value.?.length == 0 { return "/usr/local/share:/usr/share" }
    return std.string.asSlice(value.?)
}

// The system's configuration directories, colon-separated:
// $XDG_CONFIG_DIRS, else /etc/xdg.
pub fn configDirectories(environment: [*][*]const u8) -> []const u8 {
    const value = std.process.environmentFrom(environment, "XDG_CONFIG_DIRS")
    if value == null || value.?.length == 0 { return "/etc/xdg" }
    return std.string.asSlice(value.?)
}

// The next directory of a colon-separated `list` from `at` into
// `directory` (and `at` past it); false after the last. Empty entries
// and relative ones are skipped.
pub fn nextDirectory(list: []const u8, at: *usize, directory: *[]const u8) -> bool {
    while at.* < list.length {
        const start = at.*
        var end = start
        while end < list.length && list[end] != 58 { end += 1 }
        at.* = end + 1
        if end > start && list[start] == 47 {
            directory.* = list[start..end]
            return true
        }
    }
    return false
}
