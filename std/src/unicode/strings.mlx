// Strings of UTF-16 code units (ustring.h): lengths, copies, searches,
// comparisons, and conversion from and to UTF-8 and UTF-32.
const m = @import("std.unicode.memory")
const casing = @import("std.unicode.casing")

fn unit(s: usize, index: usize) -> u32 { return @intCast(u32, m.get16(s + index * 2)) }

fn isLead(u: u32) -> bool { return u >= 55296 && u <= 56319 }
fn isTrail(u: u32) -> bool { return u >= 56320 && u <= 57343 }

pub fn u_strlen(s: usize) -> i32 { return @intCast(i32, m.units(s, -1)) }

pub fn u_countChar32(s: usize, length: i32) -> i32 {
    if s == 0 || length < -1 { return 0 }
    const count = m.units(s, length)
    var code_points: i32 = 0
    var index: usize = 0
    while index < count {
        if isLead(unit(s, index)) && index + 1 < count && isTrail(unit(s, index + 1)) { index += 1 }
        index += 1
        code_points += 1
    }
    return code_points
}

pub fn u_strcpy(dst: usize, src: usize) -> usize {
    const count = m.units(src, -1)
    m.copy(dst, src, (count + 1) * 2)
    return dst
}

pub fn u_strncpy(dst: usize, src: usize, n: i32) -> usize {
    var index: usize = 0
    while index < @intCast(usize, if n > 0 { n } else { 0 }) {
        const u = m.get16(src + index * 2)
        m.put16(dst + index * 2, u)
        index += 1
        if u == 0 { break }
    }
    return dst
}

pub fn u_strcat(dst: usize, src: usize) -> usize {
    _ = u_strcpy(dst + m.units(dst, -1) * 2, src)
    return dst
}

pub fn u_strncat(dst: usize, src: usize, n: i32) -> usize {
    if n <= 0 { return dst }
    var end = dst + m.units(dst, -1) * 2
    var index: usize = 0
    while index < @intCast(usize, n) {
        const u = m.get16(src + index * 2)
        if u == 0 { break }
        m.put16(end, u)
        end += 2
        index += 1
    }
    m.put16(end, 0)
    return dst
}

pub fn u_uastrcpy(dst: usize, src: usize) -> usize {
    var index: usize = 0
    while true {
        const byte = m.get8(src + index)
        m.put16(dst + index * 2, @intCast(u16, byte))
        if byte == 0 { break }
        index += 1
    }
    return dst
}

pub fn u_uastrncpy(dst: usize, src: usize, n: i32) -> usize {
    var index: usize = 0
    while index < @intCast(usize, if n > 0 { n } else { 0 }) {
        const byte = m.get8(src + index)
        m.put16(dst + index * 2, @intCast(u16, byte))
        index += 1
        if byte == 0 { break }
    }
    return dst
}

pub fn u_austrcpy(dst: usize, src: usize) -> usize {
    var index: usize = 0
    while true {
        const u = m.get16(src + index * 2)
        m.put8(dst + index, if u < 256 { @intCast(u8, u) } else { 26 })
        if u == 0 { break }
        index += 1
    }
    return dst
}

pub fn u_austrncpy(dst: usize, src: usize, n: i32) -> usize {
    var index: usize = 0
    while index < @intCast(usize, if n > 0 { n } else { 0 }) {
        const u = m.get16(src + index * 2)
        m.put8(dst + index, if u < 256 { @intCast(u8, u) } else { 26 })
        index += 1
        if u == 0 { break }
    }
    return dst
}

pub fn u_memcpy(dest: usize, src: usize, count: i32) -> usize {
    if count > 0 { m.copy(dest, src, @intCast(usize, count) * 2) }
    return dest
}

pub fn u_memmove(dest: usize, src: usize, count: i32) -> usize {
    if count > 0 { m.copy(dest, src, @intCast(usize, count) * 2) }
    return dest
}

pub fn u_memset(dest: usize, c: u16, count: i32) -> usize {
    var index: usize = 0
    while index < @intCast(usize, if count > 0 { count } else { 0 }) {
        m.put16(dest + index * 2, c)
        index += 1
    }
    return dest
}

// The code unit order (or code point order: the surrogates moved above
// U+E000..U+FFFF) of two strings.
fn rotated(u: u32) -> u32 {
    if u >= 55296 && u <= 57343 { return u + 8192 }
    if u >= 57344 { return u - 2048 }
    return u
}

fn compareUnits(a: usize, aCount: usize, b: usize, bCount: usize, codePointOrder: bool) -> i32 {
    var index: usize = 0
    while index < aCount && index < bCount {
        var x = unit(a, index)
        var y = unit(b, index)
        if x != y {
            if codePointOrder && x >= 55296 && y >= 55296 {
                x = rotated(x)
                y = rotated(y)
            }
            return @intCast(i32, x) - @intCast(i32, y)
        }
        index += 1
    }
    if aCount == bCount { return 0 }
    return if aCount < bCount { -1 } else { 1 }
}

pub fn u_strcmp(s1: usize, s2: usize) -> i32 { return compareUnits(s1, m.units(s1, -1), s2, m.units(s2, -1), false) }
pub fn u_strcmpCodePointOrder(s1: usize, s2: usize) -> i32 { return compareUnits(s1, m.units(s1, -1), s2, m.units(s2, -1), true) }

pub fn u_strncmp(s1: usize, s2: usize, n: i32) -> i32 {
    if n <= 0 { return 0 }
    var index: usize = 0
    while index < @intCast(usize, n) {
        const x = unit(s1, index)
        const y = unit(s2, index)
        if x != y { return @intCast(i32, x) - @intCast(i32, y) }
        if x == 0 { return 0 }
        index += 1
    }
    return 0
}

pub fn u_strCompare(s1: usize, length1: i32, s2: usize, length2: i32, codePointOrder: i8) -> i32 {
    if s1 == 0 || length1 < -1 || s2 == 0 || length2 < -1 { return 0 }
    return compareUnits(s1, m.units(s1, length1), s2, m.units(s2, length2), codePointOrder != 0)
}

pub fn u_memcmp(b1: usize, b2: usize, count: i32) -> i32 {
    if count <= 0 { return 0 }
    return compareUnits(b1, @intCast(usize, count), b2, @intCast(usize, count), false)
}

pub fn u_memcmpCodePointOrder(s1: usize, s2: usize, count: i32) -> i32 {
    if count <= 0 { return 0 }
    return compareUnits(s1, @intCast(usize, count), s2, @intCast(usize, count), true)
}

// Case-insensitive comparison: of the full case foldings, in code point
// order.
fn compareFolded(s1: usize, count1: usize, s2: usize, count2: usize, options: u32) -> i32 {
    var a = m.buffer()
    var b = m.buffer()
    casing.folded(&a, s1, count1, options & 1)
    casing.folded(&b, s2, count2, options & 1)
    var result: i32 = 0
    var index: usize = 0
    while index < a.length && index < b.length {
        const x = m.at(&a, index)
        const y = m.at(&b, index)
        if x != y {
            result = if x < y { -1 } else { 1 }
            break
        }
        index += 1
    }
    if result == 0 && a.length != b.length { result = if a.length < b.length { -1 } else { 1 } }
    m.dispose(&a)
    m.dispose(&b)
    return result
}

pub fn u_strCaseCompare(s1: usize, length1: i32, s2: usize, length2: i32, options: u32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    if s1 == 0 || length1 < -1 || s2 == 0 || length2 < -1 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    return compareFolded(s1, m.units(s1, length1), s2, m.units(s2, length2), options)
}

pub fn u_strcasecmp(s1: usize, s2: usize, options: u32) -> i32 { return compareFolded(s1, m.units(s1, -1), s2, m.units(s2, -1), options) }

pub fn u_strncasecmp(s1: usize, s2: usize, n: i32, options: u32) -> i32 {
    if n <= 0 { return 0 }
    var a: usize = 0
    while a < @intCast(usize, n) && unit(s1, a) != 0 { a += 1 }
    var b: usize = 0
    while b < @intCast(usize, n) && unit(s2, b) != 0 { b += 1 }
    return compareFolded(s1, a, s2, b, options)
}

pub fn u_memcasecmp(s1: usize, s2: usize, length: i32, options: u32) -> i32 {
    if length <= 0 { return 0 }
    return compareFolded(s1, @intCast(usize, length), s2, @intCast(usize, length), options)
}

pub fn u_strchr(s: usize, c: u16) -> usize {
    var index: usize = 0
    while true {
        const u = m.get16(s + index * 2)
        if u == c { return s + index * 2 }
        if u == 0 { return 0 }
        index += 1
    }
    return 0
}

pub fn u_strchr32(s: usize, c: i32) -> usize {
    if c < 65536 { return u_strchr(s, @intCast(u16, c)) }
    const lead = @intCast(u32, (c >> 10) + 55232)
    const trail = @intCast(u32, (c & 1023) | 56320)
    var index: usize = 0
    while unit(s, index) != 0 {
        if unit(s, index) == lead && unit(s, index + 1) == trail { return s + index * 2 }
        index += 1
    }
    return 0
}

pub fn u_strrchr(s: usize, c: u16) -> usize {
    var found: usize = 0
    var index: usize = 0
    while true {
        const u = m.get16(s + index * 2)
        if u == c { found = s + index * 2 }
        if u == 0 { return found }
        index += 1
    }
    return 0
}

pub fn u_memchr(s: usize, c: u16, count: i32) -> usize {
    var index: usize = 0
    while index < @intCast(usize, if count > 0 { count } else { 0 }) {
        if m.get16(s + index * 2) == c { return s + index * 2 }
        index += 1
    }
    return 0
}

pub fn u_strstr(s: usize, substring: usize) -> usize {
    const count = m.units(s, -1)
    const wanted = m.units(substring, -1)
    if wanted == 0 { return s }
    var start: usize = 0
    while start + wanted <= count {
        var index: usize = 0
        while index < wanted && unit(s, start + index) == unit(substring, index) { index += 1 }
        if index == wanted { return s + start * 2 }
        start += 1
    }
    return 0
}

// `\uXXXX`, `\UXXXXXXXX`, `\xXX` and the C escapes, in invariant
// characters, into UTF-16.
pub fn u_unescape(src: usize, dest: usize, capacity: i32) -> i32 {
    var out = m.buffer()
    var index: usize = 0
    while m.get8(src + index) != 0 {
        var c = @intCast(u32, m.get8(src + index))
        index += 1
        if c == 92 && m.get8(src + index) != 0 {
            const kind = m.get8(src + index)
            index += 1
            var digits: usize = 0
            if kind == 117 { digits = 4 }
            if kind == 85 { digits = 8 }
            if kind == 120 { digits = 2 }
            if digits > 0 {
                c = 0
                var read: usize = 0
                while read < digits {
                    const d = m.get8(src + index)
                    var value: u32 = 99
                    if d >= 48 && d <= 57 { value = @intCast(u32, d - 48) }
                    if d >= 65 && d <= 70 { value = @intCast(u32, d - 55) }
                    if d >= 97 && d <= 102 { value = @intCast(u32, d - 87) }
                    if value == 99 { break }
                    c = c * 16 + value
                    index += 1
                    read += 1
                }
            } else if kind == 110 {
                c = 10
            } else if kind == 116 {
                c = 9
            } else if kind == 114 {
                c = 13
            } else if kind == 97 {
                c = 7
            } else if kind == 98 {
                c = 8
            } else if kind == 101 {
                c = 27
            } else if kind == 102 {
                c = 12
            } else if kind == 118 {
                c = 11
            } else {
                c = @intCast(u32, kind)
            }
        }
        m.push(&out, c)
    }
    const room = if capacity > 0 { @intCast(usize, capacity) } else { 0 }
    const written = m.encode16(&out, dest, room)
    if written < room { m.put16(dest + written * 2, 0) }
    m.dispose(&out)
    return @intCast(i32, written)
}

// ---------------------------------------------------------------------------
// UTF-8 and UTF-32

// The code point of the well-formed UTF-8 at `s + index` and the bytes it
// takes; or -1 and the bytes of its longest well-formed beginning.
fn decode8(s: usize, index: usize, count: usize) -> (i32, usize) {
    const lead = @intCast(i32, m.get8(s + index))
    if lead < 128 { return -> (lead, 1) }
    var need: usize = 0
    var c: i32 = 0
    var low: u8 = 128
    var high: u8 = 191
    if lead >= 194 && lead <= 223 {
        need = 1
        c = lead & 31
    } else if lead >= 224 && lead <= 239 {
        need = 2
        c = lead & 15
        if c == 0 { low = 160 }
        if c == 13 { high = 159 }
    } else if lead >= 240 && lead <= 244 {
        need = 3
        c = lead & 7
        if c == 0 { low = 144 }
        if c == 4 { high = 143 }
    } else {
        return -> (-1, 1)
    }
    var k: usize = 1
    while k <= need {
        if index + k >= count { return -> (-1, k) }
        const t = m.get8(s + index + k)
        if t < low || t > high { return -> (-1, k) }
        low = 128
        high = 191
        c = (c << 6) | @intCast(i32, t & 63)
        k += 1
    }
    return -> (c, need + 1)
}

// UTF-8 to UTF-16; `sub` for what is ill-formed (-1: an error).
fn fromUTF8(dest: usize, capacity: i32, destLength: usize, src: usize, length: i32, sub: i32, substitutions: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if (src == 0 && length != 0) || length < -1 || capacity < 0 || (dest == 0 && capacity > 0) || (sub > 1114111) || (sub >= 55296 && sub <= 57343) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    var count: usize = 0
    if length >= 0 {
        count = @intCast(usize, length)
    } else if src != 0 {
        count = m.cLength(src)
    }
    const room = @intCast(usize, capacity)
    var written: usize = 0
    var replaced: i32 = 0
    var index: usize = 0
    while index < count {
        const read = decode8(src, index, count)
        var c = read.0
        index += read.1
        if c < 0 {
            if sub < 0 {
                m.setError(status, m.INVALID_CHAR_FOUND)
                return 0
            }
            c = sub
            replaced += 1
        }
        if c < 65536 {
            if written < room { m.put16(dest + written * 2, @intCast(u16, c)) }
            written += 1
        } else {
            if written + 1 < room {
                m.put16(dest + written * 2, @intCast(u16, (c >> 10) + 55232))
                m.put16(dest + written * 2 + 2, @intCast(u16, (c & 1023) | 56320))
            }
            written += 2
        }
    }
    if substitutions != 0 { m.putI32(substitutions, replaced) }
    if destLength != 0 { m.putI32(destLength, @intCast(i32, written)) }
    _ = m.terminate(dest, written, capacity, status)
    return dest
}

pub fn u_strFromUTF8(dest: usize, capacity: i32, destLength: usize, src: usize, length: i32, status: usize) -> usize {
    return fromUTF8(dest, capacity, destLength, src, length, -1, 0, status)
}

pub fn u_strFromUTF8WithSub(dest: usize, capacity: i32, destLength: usize, src: usize, length: i32, sub: i32, substitutions: usize, status: usize) -> usize {
    return fromUTF8(dest, capacity, destLength, src, length, sub, substitutions, status)
}

pub fn u_strFromUTF8Lenient(dest: usize, capacity: i32, destLength: usize, src: usize, length: i32, status: usize) -> usize {
    return fromUTF8(dest, capacity, destLength, src, length, 65533, 0, status)
}

fn toUTF8(dest: usize, capacity: i32, destLength: usize, src: usize, length: i32, sub: i32, substitutions: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if (src == 0 && length != 0) || length < -1 || capacity < 0 || (dest == 0 && capacity > 0) || sub > 1114111 || (sub >= 55296 && sub <= 57343) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const count = if src == 0 { 0 } else { m.units(src, length) }
    const room = @intCast(usize, capacity)
    var written: usize = 0
    var replaced: i32 = 0
    var index: usize = 0
    while index < count {
        var c = @intCast(i32, unit(src, index))
        index += 1
        if c >= 55296 && c <= 57343 {
            if c <= 56319 && index < count && isTrail(unit(src, index)) {
                c = (c << 10) + @intCast(i32, unit(src, index)) - 56613888
                index += 1
            } else {
                if sub < 0 {
                    m.setError(status, m.INVALID_CHAR_FOUND)
                    return 0
                }
                c = sub
                replaced += 1
            }
        }
        var size: usize = 4
        if c < 128 {
            size = 1
        } else if c < 2048 {
            size = 2
        } else if c < 65536 {
            size = 3
        }
        if written + size <= room {
            const at = dest + written
            if size == 1 {
                m.put8(at, @intCast(u8, c))
            } else if size == 2 {
                m.put8(at, @intCast(u8, (c >> 6) | 192))
                m.put8(at + 1, @intCast(u8, (c & 63) | 128))
            } else if size == 3 {
                m.put8(at, @intCast(u8, (c >> 12) | 224))
                m.put8(at + 1, @intCast(u8, ((c >> 6) & 63) | 128))
                m.put8(at + 2, @intCast(u8, (c & 63) | 128))
            } else {
                m.put8(at, @intCast(u8, (c >> 18) | 240))
                m.put8(at + 1, @intCast(u8, ((c >> 12) & 63) | 128))
                m.put8(at + 2, @intCast(u8, ((c >> 6) & 63) | 128))
                m.put8(at + 3, @intCast(u8, (c & 63) | 128))
            }
        }
        written += size
    }
    if substitutions != 0 { m.putI32(substitutions, replaced) }
    if destLength != 0 { m.putI32(destLength, @intCast(i32, written)) }
    _ = m.terminate8(dest, written, capacity, status)
    return dest
}

pub fn u_strToUTF8(dest: usize, capacity: i32, destLength: usize, src: usize, length: i32, status: usize) -> usize {
    return toUTF8(dest, capacity, destLength, src, length, -1, 0, status)
}

pub fn u_strToUTF8WithSub(dest: usize, capacity: i32, destLength: usize, src: usize, length: i32, sub: i32, substitutions: usize, status: usize) -> usize {
    return toUTF8(dest, capacity, destLength, src, length, sub, substitutions, status)
}

pub fn u_strToUTF32(dest: usize, capacity: i32, destLength: usize, src: usize, length: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if (src == 0 && length != 0) || length < -1 || capacity < 0 || (dest == 0 && capacity > 0) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const count = if src == 0 { 0 } else { m.units(src, length) }
    const room = @intCast(usize, capacity)
    var written: usize = 0
    var index: usize = 0
    while index < count {
        var c = @intCast(i32, unit(src, index))
        index += 1
        if c >= 55296 && c <= 57343 {
            if c <= 56319 && index < count && isTrail(unit(src, index)) {
                c = (c << 10) + @intCast(i32, unit(src, index)) - 56613888
                index += 1
            } else {
                m.setError(status, m.INVALID_CHAR_FOUND)
                return 0
            }
        }
        if written < room { m.putI32(dest + written * 4, c) }
        written += 1
    }
    if destLength != 0 { m.putI32(destLength, @intCast(i32, written)) }
    if written < room {
        m.putI32(dest + written * 4, 0)
    } else if written == room {
        if m.getI32(status) <= 0 { m.putI32(status, m.STRING_NOT_TERMINATED_WARNING) }
    } else {
        m.putI32(status, m.BUFFER_OVERFLOW_ERROR)
    }
    return dest
}

pub fn u_strFromUTF32(dest: usize, capacity: i32, destLength: usize, src: usize, length: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if (src == 0 && length != 0) || length < -1 || capacity < 0 || (dest == 0 && capacity > 0) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    var count: usize = 0
    if length >= 0 {
        count = @intCast(usize, length)
    } else {
        while m.getI32(src + count * 4) != 0 { count += 1 }
    }
    var out = m.buffer()
    var index: usize = 0
    while index < count {
        const c = m.getI32(src + index * 4)
        if c < 0 || c > 1114111 || (c >= 55296 && c <= 57343) {
            m.dispose(&out)
            m.setError(status, m.INVALID_CHAR_FOUND)
            return 0
        }
        m.push(&out, @intCast(u32, c))
        index += 1
    }
    const written = m.encode16(&out, dest, @intCast(usize, capacity))
    m.dispose(&out)
    if destLength != 0 { m.putI32(destLength, @intCast(i32, written)) }
    _ = m.terminate(dest, written, capacity, status)
    return dest
}
