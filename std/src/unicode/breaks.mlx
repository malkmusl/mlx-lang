// Break iterators (ubrk.h) and UText (utext.h): the boundaries of
// grapheme clusters, words and sentences (UAX #29) and the line break
// opportunities (UAX #14), by their rules as Unicode 16.0 states them.
//
// An iterator holds a copy of its text (UTF-16) and finds all of its
// boundaries the first time it is asked for one; moving about is then a
// search in that list.
const m = @import("std.unicode.memory")
const p = @import("std.unicode.properties")
const unicode = @import("std.unicode")
const utf = @import("std.unicode.utf")

// UBreakIteratorType
const CHARACTER: u32 = 0
const WORD: u32 = 1
const LINE: u32 = 2
const SENTENCE: u32 = 3
const TITLE: u32 = 4

// Line breaking as the locale's `lb` and `lw` keywords ask.
const LB_STRICT: u32 = 1
const LB_LOOSE: u32 = 2
const LW_KEEP_ALL: u32 = 4
const LW_BREAK_ALL: u32 = 8

const DONE: i32 = -1

// The iterator (C memory):
const TYPE: usize = 0
const OPTIONS: usize = 4
const TEXT: usize = 8
const LENGTH: usize = 16
const BOUNDARIES: usize = 24
const STATUSES: usize = 32
const COUNT: usize = 40
const CURRENT: usize = 48
const FOUND: usize = 56
const SIZE: usize = 64

fn boundaryAt(it: usize, index: usize) -> i32 { return m.getI32(m.getWord(it + BOUNDARIES) + index * 4) }
fn statusAt(it: usize, index: usize) -> i32 { return m.getI32(m.getWord(it + STATUSES) + index * 4) }

// ---------------------------------------------------------------------------
// The text, as code points with their offsets

const Text = struct {
    codes: usize
    starts: usize
    count: usize
    units: usize
}

fn decode(it: usize) -> Text {
    const text = m.getWord(it + TEXT)
    const length = m.getWord(it + LENGTH)
    const codes = m.alloc((length + 1) * 4)
    const starts = m.alloc((length + 2) * 4)
    var count: usize = 0
    var index: usize = 0
    while index < length {
        m.put32(starts + count * 4, @intCast(u32, index))
        var c = @intCast(u32, m.get16(text + index * 2))
        index += 1
        if c >= 55296 && c <= 56319 && index < length {
            const trail = @intCast(u32, m.get16(text + index * 2))
            if trail >= 56320 && trail <= 57343 {
                c = (c << 10) + trail - 56613888
                index += 1
            }
        }
        m.put32(codes + count * 4, c)
        count += 1
    }
    m.put32(starts + count * 4, @intCast(u32, length))
    return Text.{ .codes = codes, .starts = starts, .count = count, .units = length }
}

fn code(t: *Text, i: usize) -> i32 { return @intCast(i32, m.get32(t.*.codes + i * 4)) }

fn dispose(t: *Text) -> void {
    m.release(t.*.codes)
    m.release(t.*.starts)
}

// The boundaries found, as they are found.
var found: m.Buffer = undefined
var statuses: m.Buffer = undefined

fn mark(t: *Text, i: usize, status: i32) -> void {
    m.push(&found, m.get32(t.*.starts + i * 4))
    m.push(&statuses, @bitCast(u32, status))
}

// ---------------------------------------------------------------------------
// Grapheme clusters (UAX #29, GB rules)

const GCB_OTHER: u32 = 0
const GCB_CONTROL: u32 = 1
const GCB_CR: u32 = 2
const GCB_EXTEND: u32 = 3
const GCB_L: u32 = 4
const GCB_LF: u32 = 5
const GCB_LV: u32 = 6
const GCB_LVT: u32 = 7
const GCB_T: u32 = 8
const GCB_V: u32 = 9
const GCB_SPACING_MARK: u32 = 10
const GCB_PREPEND: u32 = 11
const GCB_RI: u32 = 12
const GCB_ZWJ: u32 = 17

const EXTENDED_PICTOGRAPHIC: usize = 64
const INCB_CONSONANT: u32 = 1
const INCB_EXTEND: u32 = 2
const INCB_LINKER: u32 = 3

// Whether there is a grapheme cluster boundary before code point `i`.
fn graphemeBoundary(t: *Text, i: usize) -> bool {
    if i == 0 || i >= t.*.count { return true }
    const before = p.graphemeBreak(code(t, i - 1))
    const after = p.graphemeBreak(code(t, i))
    if before == GCB_CR && after == GCB_LF { return false }
    if before == GCB_CONTROL || before == GCB_CR || before == GCB_LF { return true }
    if after == GCB_CONTROL || after == GCB_CR || after == GCB_LF { return true }
    if before == GCB_L && (after == GCB_L || after == GCB_V || after == GCB_LV || after == GCB_LVT) { return false }
    if (before == GCB_LV || before == GCB_V) && (after == GCB_V || after == GCB_T) { return false }
    if (before == GCB_LVT || before == GCB_T) && after == GCB_T { return false }
    if after == GCB_EXTEND || after == GCB_ZWJ { return false }
    if after == GCB_SPACING_MARK { return false }
    if before == GCB_PREPEND { return false }
    // GB9c: Consonant [Extend Linker]* Linker [Extend Linker]* × Consonant
    if p.conjunctBreak(code(t, i)) == INCB_CONSONANT {
        var k = i
        var linker = false
        while k > 0 {
            k -= 1
            const value = p.conjunctBreak(code(t, k))
            if value == INCB_LINKER {
                linker = true
            } else if value != INCB_EXTEND {
                if value == INCB_CONSONANT && linker { return false }
                break
            }
        }
    }
    // GB11: ExtPict Extend* ZWJ × ExtPict
    if before == GCB_ZWJ && p.binary(code(t, i), EXTENDED_PICTOGRAPHIC) {
        var k = i - 1
        while k > 0 {
            k -= 1
            const c = code(t, k)
            if p.graphemeBreak(c) == GCB_EXTEND { continue }
            if p.binary(c, EXTENDED_PICTOGRAPHIC) { return false }
            break
        }
    }
    // GB12, GB13: regional indicators in pairs.
    if before == GCB_RI && after == GCB_RI {
        var count: usize = 0
        var k = i
        while k > 0 && p.graphemeBreak(code(t, k - 1)) == GCB_RI {
            count += 1
            k -= 1
        }
        return count % 2 == 0
    }
    return true
}

fn graphemes(t: *Text) -> void {
    var i: usize = 1
    while i < t.*.count {
        if graphemeBoundary(t, i) { mark(t, i, 0) }
        i += 1
    }
}

// ---------------------------------------------------------------------------
// Words (UAX #29, WB rules)

const WB_OTHER: u32 = 0
const WB_ALETTER: u32 = 1
const WB_FORMAT: u32 = 2
const WB_KATAKANA: u32 = 3
const WB_MIDLETTER: u32 = 4
const WB_MIDNUM: u32 = 5
const WB_NUMERIC: u32 = 6
const WB_EXTENDNUMLET: u32 = 7
const WB_CR: u32 = 8
const WB_EXTEND: u32 = 9
const WB_LF: u32 = 10
const WB_MIDNUMLET: u32 = 11
const WB_NEWLINE: u32 = 12
const WB_RI: u32 = 13
const WB_HEBREW_LETTER: u32 = 14
const WB_SINGLE_QUOTE: u32 = 15
const WB_DOUBLE_QUOTE: u32 = 16
const WB_ZWJ: u32 = 21
const WB_WSEGSPACE: u32 = 22

fn wb(t: *Text, i: usize) -> u32 { return p.wordBreak(code(t, i)) }

fn ignoredInWords(value: u32) -> bool { return value == WB_EXTEND || value == WB_FORMAT || value == WB_ZWJ }

// The code point before `i` WB4 does not skip (-1: none).
fn wordBefore(t: *Text, i: usize) -> isize {
    var k = i
    while k > 0 {
        k -= 1
        const value = wb(t, k)
        if !ignoredInWords(value) { return @intCast(isize, k) }
        // (Extend after a newline or at the start is not attached.)
        if k == 0 { return 0 }
        const previous = wb(t, k - 1)
        if previous == WB_CR || previous == WB_LF || previous == WB_NEWLINE { return @intCast(isize, k) }
    }
    return -1
}

// The code point from `i` on WB4 does not skip.
fn wordAfter(t: *Text, i: usize) -> isize {
    var k = i
    while k < t.*.count {
        if !ignoredInWords(wb(t, k)) { return @intCast(isize, k) }
        k += 1
    }
    return -1
}

fn valueAt(t: *Text, k: isize) -> u32 {
    if k < 0 { return 99 }
    return wb(t, @intCast(usize, k))
}

fn ahLetter(value: u32) -> bool { return value == WB_ALETTER || value == WB_HEBREW_LETTER }
fn midNumLetQ(value: u32) -> bool { return value == WB_MIDNUMLET || value == WB_SINGLE_QUOTE }

fn wordBoundary(t: *Text, i: usize) -> bool {
    if i == 0 || i >= t.*.count { return true }
    const rawBefore = wb(t, i - 1)
    const rawAfter = wb(t, i)
    if rawBefore == WB_CR && rawAfter == WB_LF { return false }
    if rawBefore == WB_CR || rawBefore == WB_LF || rawBefore == WB_NEWLINE { return true }
    if rawAfter == WB_CR || rawAfter == WB_LF || rawAfter == WB_NEWLINE { return true }
    if rawBefore == WB_ZWJ && p.binary(code(t, i), EXTENDED_PICTOGRAPHIC) { return false }
    if rawBefore == WB_WSEGSPACE && rawAfter == WB_WSEGSPACE { return false }
    if ignoredInWords(rawAfter) { return false }
    const b = wordBefore(t, i)
    const before = valueAt(t, b)
    const after = rawAfter
    const beforeBefore = if b > 0 { valueAt(t, wordBefore(t, @intCast(usize, b))) } else { 99 }
    const next = if i + 1 < t.*.count { valueAt(t, wordAfter(t, i + 1)) } else { 99 }
    if ahLetter(before) && ahLetter(after) { return false }
    if ahLetter(before) && (after == WB_MIDLETTER || midNumLetQ(after)) && ahLetter(next) { return false }
    if ahLetter(beforeBefore) && (before == WB_MIDLETTER || midNumLetQ(before)) && ahLetter(after) { return false }
    if before == WB_HEBREW_LETTER && after == WB_SINGLE_QUOTE { return false }
    if before == WB_HEBREW_LETTER && after == WB_DOUBLE_QUOTE && next == WB_HEBREW_LETTER { return false }
    if beforeBefore == WB_HEBREW_LETTER && before == WB_DOUBLE_QUOTE && after == WB_HEBREW_LETTER { return false }
    if before == WB_NUMERIC && after == WB_NUMERIC { return false }
    if ahLetter(before) && after == WB_NUMERIC { return false }
    if before == WB_NUMERIC && ahLetter(after) { return false }
    if beforeBefore == WB_NUMERIC && (before == WB_MIDNUM || midNumLetQ(before)) && after == WB_NUMERIC { return false }
    if before == WB_NUMERIC && (after == WB_MIDNUM || midNumLetQ(after)) && next == WB_NUMERIC { return false }
    if before == WB_KATAKANA && after == WB_KATAKANA { return false }
    if (ahLetter(before) || before == WB_NUMERIC || before == WB_KATAKANA || before == WB_EXTENDNUMLET) && after == WB_EXTENDNUMLET { return false }
    if before == WB_EXTENDNUMLET && (ahLetter(after) || after == WB_NUMERIC || after == WB_KATAKANA) { return false }
    if before == WB_RI && after == WB_RI {
        var count: usize = 0
        var k = b
        while k >= 0 && valueAt(t, k) == WB_RI {
            count += 1
            if k == 0 { break }
            k = wordBefore(t, @intCast(usize, k))
        }
        return count % 2 == 0
    }
    return true
}

// The rule status of a word ending at code point `end` (exclusive) that
// began at `start`: what its letters are.
const WORD_NONE: i32 = 0
const WORD_NUMBER: i32 = 100
const WORD_LETTER: i32 = 200
const WORD_KANA: i32 = 300
const WORD_IDEO: i32 = 400

fn wordStatus(t: *Text, start: usize, end: usize) -> i32 {
    var status = WORD_NONE
    var i = start
    while i < end {
        const c = code(t, i)
        const value = wb(t, i)
        if p.binary(c, 17) {
            return WORD_IDEO
        }
        if value == WB_KATAKANA || (c >= 12352 && c <= 12447) || (c >= 110592 && c <= 110959) {
            if status < WORD_KANA { status = WORD_KANA }
        } else if ahLetter(value) || (p.categoryMask(c) & p.MASK_L) != 0 {
            if status < WORD_LETTER { status = WORD_LETTER }
        } else if value == WB_NUMERIC {
            if status < WORD_NUMBER { status = WORD_NUMBER }
        }
        i += 1
    }
    return status
}

fn words(t: *Text) -> void {
    var start: usize = 0
    var i: usize = 1
    while i < t.*.count {
        if wordBoundary(t, i) {
            mark(t, i, wordStatus(t, start, i))
            start = i
        }
        i += 1
    }
}

// ---------------------------------------------------------------------------
// Sentences (UAX #29, SB rules)

const SB_OTHER: u32 = 0
const SB_ATERM: u32 = 1
const SB_CLOSE: u32 = 2
const SB_FORMAT: u32 = 3
const SB_LOWER: u32 = 4
const SB_NUMERIC: u32 = 5
const SB_OLETTER: u32 = 6
const SB_SEP: u32 = 7
const SB_SP: u32 = 8
const SB_STERM: u32 = 9
const SB_UPPER: u32 = 10
const SB_CR: u32 = 11
const SB_EXTEND: u32 = 12
const SB_LF: u32 = 13
const SB_SCONTINUE: u32 = 14

fn sb(t: *Text, i: usize) -> u32 { return p.sentenceBreak(code(t, i)) }
fn paraSep(value: u32) -> bool { return value == SB_SEP || value == SB_CR || value == SB_LF }
fn saTerm(value: u32) -> bool { return value == SB_STERM || value == SB_ATERM }

// The code point before `i` SB5 does not skip.
fn sentenceBefore(t: *Text, i: usize) -> isize {
    var k = i
    while k > 0 {
        k -= 1
        const value = sb(t, k)
        if value != SB_EXTEND && value != SB_FORMAT { return @intCast(isize, k) }
        if k == 0 { return 0 }
        if paraSep(sb(t, k - 1)) { return @intCast(isize, k) }
    }
    return -1
}

fn sbAt(t: *Text, k: isize) -> u32 {
    if k < 0 { return 99 }
    return sb(t, @intCast(usize, k))
}

fn sentenceBoundary(t: *Text, i: usize) -> bool {
    if i == 0 || i >= t.*.count { return true }
    const rawBefore = sb(t, i - 1)
    const rawAfter = sb(t, i)
    if rawBefore == SB_CR && rawAfter == SB_LF { return false }
    if paraSep(rawBefore) { return true }
    if rawAfter == SB_EXTEND || rawAfter == SB_FORMAT { return false }
    var k = sentenceBefore(t, i)
    const before = sbAt(t, k)
    const after = rawAfter
    if before == SB_ATERM && after == SB_NUMERIC { return false }
    if before == SB_ATERM && after == SB_UPPER {
        const two = if k > 0 { sbAt(t, sentenceBefore(t, @intCast(usize, k))) } else { 99 }
        if two == SB_UPPER || two == SB_LOWER { return false }
    }
    // Back over Sp* and Close* to the terminator.
    var spaces = false
    while k >= 0 && sbAt(t, k) == SB_SP {
        spaces = true
        k = if k > 0 { sentenceBefore(t, @intCast(usize, k)) } else { -1 }
    }
    var closes = false
    while k >= 0 && sbAt(t, k) == SB_CLOSE {
        closes = true
        k = if k > 0 { sentenceBefore(t, @intCast(usize, k)) } else { -1 }
    }
    const term = sbAt(t, k)
    if !saTerm(term) { return false }
    // SB8: ATerm Close* Sp* × ( ¬(OLetter | Upper | Lower | ParaSep | SATerm) )* Lower
    if term == SB_ATERM {
        var j = i
        while j < t.*.count {
            const value = sb(t, j)
            if value == SB_LOWER { return false }
            if value == SB_OLETTER || value == SB_UPPER || paraSep(value) || saTerm(value) { break }
            j += 1
        }
    }
    if after == SB_SCONTINUE || saTerm(after) { return false }
    if !spaces && (after == SB_CLOSE || after == SB_SP || paraSep(after)) { return false }
    if after == SB_SP || paraSep(after) { return false }
    return true
}

const SENTENCE_TERM: i32 = 0
const SENTENCE_SEP: i32 = 100

fn sentences(t: *Text) -> void {
    var i: usize = 1
    while i < t.*.count {
        if sentenceBoundary(t, i) { mark(t, i, if paraSep(sb(t, i - 1)) { SENTENCE_SEP } else { SENTENCE_TERM }) }
        i += 1
    }
}

// ---------------------------------------------------------------------------
// Lines (UAX #14)

const XX: u32 = 0
const AI: u32 = 1
const AL: u32 = 2
const B2: u32 = 3
const BA: u32 = 4
const BB: u32 = 5
const BK: u32 = 6
const CB: u32 = 7
const CL: u32 = 8
const CM: u32 = 9
const CR: u32 = 10
const EX: u32 = 11
const GL: u32 = 12
const HY: u32 = 13
const ID: u32 = 14
const IN: u32 = 15
const IS: u32 = 16
const LF: u32 = 17
const NS: u32 = 18
const NU: u32 = 19
const OP: u32 = 20
const PO: u32 = 21
const PR: u32 = 22
const QU: u32 = 23
const SA: u32 = 24
const SG: u32 = 25
const SP: u32 = 26
const SY: u32 = 27
const ZW: u32 = 28
const NL: u32 = 29
const WJ: u32 = 30
const H2: u32 = 31
const H3: u32 = 32
const JL: u32 = 33
const JT: u32 = 34
const JV: u32 = 35
const CP: u32 = 36
const CJ: u32 = 37
const HL: u32 = 38
const RI: u32 = 39
const EB: u32 = 40
const EM: u32 = 41
const ZWJ: u32 = 42
const AK: u32 = 43
const AP: u32 = 44
const AS: u32 = 45
const VF: u32 = 46
const VI: u32 = 47

// The classes of the text after LB1, and after LB9/LB10 (`effective`: a
// combining mark takes its base's class; `absorbed`: it has a base).
var raw: usize = 0
var effective: usize = 0
var absorbed: usize = 0

fn rawAt(i: usize) -> u32 { return m.get32(raw + i * 4) }
fn eff(i: usize) -> u32 { return m.get32(effective + i * 4) }
fn isAbsorbed(i: usize) -> bool { return m.get8(absorbed + i) != 0 }

fn resolve(c: i32, options: u32) -> u32 {
    var value = p.lineBreak(c)
    if value == AI || value == SG || value == XX { value = AL }
    if value == SA {
        const gc = p.category(c)
        value = if gc == 6 || gc == 8 { CM } else { AL }
    }
    if value == CJ { value = if (options & LB_STRICT) != 0 { NS } else { ID } }
    if (options & LW_BREAK_ALL) != 0 && (value == AL || value == HL || value == NU) { value = ID }
    if (options & LW_KEEP_ALL) != 0 && (value == ID || value == H2 || value == H3 || value == JL || value == JV || value == JT) { value = AL }
    return value
}

// The index of the code point before `i` (absorbed ones skipped; -1 at
// the start).
fn baseBefore(i: usize) -> isize {
    var k = i
    while k > 0 {
        k -= 1
        if !isAbsorbed(k) { return @intCast(isize, k) }
    }
    return -1
}

// The index of the code point from `i` on that is not absorbed (-1 past
// the end).
fn baseFrom(t: *Text, i: usize) -> isize {
    var k = i
    while k < t.*.count {
        if !isAbsorbed(k) { return @intCast(isize, k) }
        k += 1
    }
    return -1
}

fn effAt(k: isize) -> u32 {
    if k < 0 { return 99 }
    return eff(@intCast(usize, k))
}

fn eastAsian(t: *Text, k: isize) -> bool {
    if k < 0 { return false }
    const value = p.eastAsianWidth(code(t, @intCast(usize, k)))
    return value == 2 || value == 3 || value == 5
}

fn categoryAt(t: *Text, k: isize) -> u32 {
    if k < 0 { return 99 }
    return p.category(code(t, @intCast(usize, k)))
}

// Back from `k` over spaces: the first that is no space.
fn skipSpaces(k: isize) -> isize {
    var at = k
    while at >= 0 && effAt(at) == SP { at = baseBefore(@intCast(usize, at)) }
    return at
}

fn dottedCircleLike(t: *Text, k: isize) -> bool {
    const value = effAt(k)
    return value == AK || value == AS || (k >= 0 && code(t, @intCast(usize, k)) == 9676)
}

// 0: break, 1: no break, 2: a mandatory break, before code point `i`.
fn lineBoundary(t: *Text, i: usize) -> u32 {
    const rb = rawAt(i - 1)
    const ra = rawAt(i)
    if rb == BK { return 2 }
    if rb == CR && ra == LF { return 1 }
    if rb == CR || rb == LF || rb == NL { return 2 }
    if ra == BK || ra == CR || ra == LF || ra == NL { return 1 }
    if ra == SP || ra == ZW { return 1 }
    // LB8: ZW SP* ÷
    var k: isize = @intCast(isize, i) - 1
    while k >= 0 && rawAt(@intCast(usize, k)) == SP { k -= 1 }
    if k >= 0 && rawAt(@intCast(usize, k)) == ZW { return 0 }
    if rb == ZWJ { return 1 }
    if isAbsorbed(i) { return 1 }
    const b = baseBefore(i)
    const before = effAt(b)
    const after = eff(i)
    const next = if i + 1 < t.*.count { baseFrom(t, i + 1) } else { -1 }
    const afterNext = effAt(next)
    if after == WJ || before == WJ { return 1 }
    if before == GL { return 1 }
    if after == GL && before != SP && before != BA && before != HY { return 1 }
    if after == CL || after == CP || after == EX || after == SY { return 1 }
    // LB14: OP SP* ×
    const nonSpace = skipSpaces(b)
    if effAt(nonSpace) == OP { return 1 }
    // LB15a: (sot | BK | CR | LF | NL | OP | QU | GL | SP | ZW) [Pi & QU] SP* ×
    if effAt(nonSpace) == QU && categoryAt(t, nonSpace) == 28 {
        const preceding = if nonSpace > 0 { baseBefore(@intCast(usize, nonSpace)) } else { -1 }
        const value = effAt(preceding)
        if preceding < 0 || value == BK || value == CR || value == LF || value == NL || value == OP || value == QU || value == GL || value == SP || value == ZW { return 1 }
    }
    // LB15b: × [Pf & QU] (SP | GL | WJ | CL | QU | CP | EX | IS | SY | BK | CR | LF | NL | ZW | eot)
    if after == QU && categoryAt(t, @intCast(isize, i)) == 29 {
        if next < 0 || afterNext == SP || afterNext == GL || afterNext == WJ || afterNext == CL || afterNext == QU || afterNext == CP || afterNext == EX || afterNext == IS || afterNext == SY || afterNext == BK || afterNext == CR || afterNext == LF || afterNext == NL || afterNext == ZW { return 1 }
    }
    // LB15c: SP ÷ IS NU; LB15d: × IS
    if before == SP && after == IS && afterNext == NU { return 0 }
    if after == IS { return 1 }
    // LB16: (CL | CP) SP* × NS
    if after == NS && (effAt(nonSpace) == CL || effAt(nonSpace) == CP) { return 1 }
    // LB17: B2 SP* × B2
    if after == B2 && effAt(nonSpace) == B2 { return 1 }
    if before == SP { return 0 }
    // LB19, LB19a: quotation marks
    if after == QU && categoryAt(t, @intCast(isize, i)) != 28 { return 1 }
    if before == QU && categoryAt(t, b) != 29 { return 1 }
    if after == QU && !eastAsian(t, b) { return 1 }
    if after == QU && (next < 0 || !eastAsian(t, next)) { return 1 }
    if before == QU && !eastAsian(t, @intCast(isize, i)) { return 1 }
    if before == QU {
        const preceding = if b > 0 { baseBefore(@intCast(usize, b)) } else { -1 }
        if preceding < 0 || !eastAsian(t, preceding) { return 1 }
    }
    if after == CB || before == CB { return 0 }
    // LB20a: (sot | BK | CR | LF | NL | SP | ZW | CB | GL) (HY | U+2010) × AL
    if (before == HY || (b >= 0 && code(t, @intCast(usize, b)) == 8208)) && after == AL {
        const preceding = if b > 0 { baseBefore(@intCast(usize, b)) } else { -1 }
        const value = effAt(preceding)
        if preceding < 0 || value == BK || value == CR || value == LF || value == NL || value == SP || value == ZW || value == CB || value == GL { return 1 }
    }
    if after == BA || after == HY || after == NS { return 1 }
    if before == BB { return 1 }
    // LB21a: HL (HY | [BA - EastAsian]) × [^HL]
    if (before == HY || (before == BA && !eastAsian(t, b))) && after != HL {
        const preceding = if b > 0 { baseBefore(@intCast(usize, b)) } else { -1 }
        if effAt(preceding) == HL { return 1 }
    }
    if before == SY && after == HL { return 1 }
    if after == IN { return 1 }
    if (before == AL || before == HL) && after == NU { return 1 }
    if before == NU && (after == AL || after == HL) { return 1 }
    if before == PR && (after == ID || after == EB || after == EM) { return 1 }
    if (before == ID || before == EB || before == EM) && after == PO { return 1 }
    if (before == PR || before == PO) && (after == AL || after == HL) { return 1 }
    if (before == AL || before == HL) && (after == PR || after == PO) { return 1 }
    // LB25: numbers
    if after == PO || after == PR || after == NU {
        var at = b
        if after != NU && (effAt(at) == CL || effAt(at) == CP) { at = if at > 0 { baseBefore(@intCast(usize, at)) } else { -1 } }
        while effAt(at) == SY || effAt(at) == IS { at = if at > 0 { baseBefore(@intCast(usize, at)) } else { -1 } }
        if effAt(at) == NU { return 1 }
    }
    if (before == PO || before == PR) && after == OP {
        if afterNext == NU { return 1 }
        if afterNext == IS {
            const third = if next >= 0 && @intCast(usize, next) + 1 < t.*.count { baseFrom(t, @intCast(usize, next) + 1) } else { -1 }
            if effAt(third) == NU { return 1 }
        }
    }
    if (before == PO || before == PR || before == HY || before == IS) && after == NU { return 1 }
    // LB26, LB27: Korean
    if before == JL && (after == JL || after == JV || after == H2 || after == H3) { return 1 }
    if (before == JV || before == H2) && (after == JV || after == JT) { return 1 }
    if (before == JT || before == H3) && after == JT { return 1 }
    if (before == JL || before == JV || before == JT || before == H2 || before == H3) && after == PO { return 1 }
    if before == PR && (after == JL || after == JV || after == JT || after == H2 || after == H3) { return 1 }
    if (before == AL || before == HL) && (after == AL || after == HL) { return 1 }
    // LB28a: Brahmic orthographic syllables
    if before == AP && dottedCircleLike(t, @intCast(isize, i)) { return 1 }
    if dottedCircleLike(t, b) && (after == VF || after == VI) { return 1 }
    if before == VI && (after == AK || (code(t, i) == 9676)) {
        const preceding = if b > 0 { baseBefore(@intCast(usize, b)) } else { -1 }
        if dottedCircleLike(t, preceding) { return 1 }
    }
    if dottedCircleLike(t, b) && dottedCircleLike(t, @intCast(isize, i)) && afterNext == VF { return 1 }
    if before == IS && (after == AL || after == HL) { return 1 }
    // LB30
    if (before == AL || before == HL || before == NU) && after == OP && !eastAsian(t, @intCast(isize, i)) { return 1 }
    if before == CP && !eastAsian(t, b) && (after == AL || after == HL || after == NU) { return 1 }
    // LB30a: regional indicators in pairs
    if before == RI && after == RI {
        var count: usize = 0
        var at = b
        while at >= 0 && effAt(at) == RI {
            count += 1
            at = if at > 0 { baseBefore(@intCast(usize, at)) } else { -1 }
        }
        if count % 2 == 1 { return 1 }
    }
    // LB30b
    if before == EB && after == EM { return 1 }
    if after == EM && b >= 0 && p.binary(code(t, @intCast(usize, b)), EXTENDED_PICTOGRAPHIC) && categoryAt(t, b) == 0 { return 1 }
    return 0
}

const LINE_SOFT: i32 = 0
const LINE_HARD: i32 = 100

fn lines(t: *Text, options: u32) -> void {
    const count = t.*.count
    raw = m.alloc(count * 4 + 4)
    effective = m.alloc(count * 4 + 4)
    absorbed = m.alloc(count + 1)
    var i: usize = 0
    while i < count {
        m.put32(raw + i * 4, resolve(code(t, i), options))
        i += 1
    }
    i = 0
    while i < count {
        const value = rawAt(i)
        var result = value
        if (value == CM || value == ZWJ) && i > 0 {
            const before = rawAt(i - 1)
            // (The base of a run of marks is what the run follows.)
            const base = eff(i - 1)
            if !(before == BK || before == CR || before == LF || before == NL || before == SP || before == ZW) && !(base == BK || base == CR || base == LF || base == NL || base == SP || base == ZW) {
                m.put8(absorbed + i, 1)
                result = base
            } else {
                result = AL
            }
        } else if value == CM || value == ZWJ {
            result = AL
        }
        m.put32(effective + i * 4, result)
        i += 1
    }
    i = 1
    while i < count {
        const kind = lineBoundary(t, i)
        if kind != 1 { mark(t, i, if kind == 2 { LINE_HARD } else { LINE_SOFT }) }
        i += 1
    }
    m.release(raw)
    m.release(effective)
    m.release(absorbed)
}

// ---------------------------------------------------------------------------
// The iterator

fn compute(it: usize) -> void {
    if m.getWord(it + FOUND) != 0 { return }
    var t = decode(it)
    found = m.buffer()
    statuses = m.buffer()
    m.push(&found, 0)
    m.push(&statuses, 0)
    const kind = m.get32(it + TYPE)
    if kind == CHARACTER {
        graphemes(&t)
    } else if kind == WORD {
        words(&t)
    } else if kind == LINE {
        lines(&t, m.get32(it + OPTIONS))
    } else if kind == SENTENCE {
        sentences(&t)
    } else {
        words(&t)
    }
    // The end of the text, with the status of what it ends.
    if t.count > 0 {
        var status: i32 = 0
        if kind == WORD || kind == TITLE { status = wordStatus(&t, lastStart(&t), t.count) }
        if kind == SENTENCE && paraSep(sb(&t, t.count - 1)) { status = SENTENCE_SEP }
        if kind == LINE {
            const last = p.lineBreak(code(&t, t.count - 1))
            if last == BK || last == CR || last == LF || last == NL { status = LINE_HARD }
        }
        m.push(&found, @intCast(u32, t.units))
        m.push(&statuses, @bitCast(u32, status))
    }
    dispose(&t)
    m.release(m.getWord(it + BOUNDARIES))
    m.release(m.getWord(it + STATUSES))
    m.putWord(it + BOUNDARIES, found.address)
    m.putWord(it + STATUSES, statuses.address)
    m.putWord(it + COUNT, found.length)
    m.putWord(it + FOUND, 1)
}

// The code point where the last segment of `t` starts (for the status of
// the end).
fn lastStart(t: *Text) -> usize {
    if found.length < 2 { return 0 }
    const unit = m.at(&found, found.length - 1)
    var i: usize = 0
    while i < t.*.count && m.get32(t.*.starts + i * 4) < unit { i += 1 }
    return i
}

fn setTextUnits(it: usize, text: usize, length: usize) -> bool {
    const copy = m.alloc(length * 2 + 2)
    if copy == 0 { return false }
    m.copy(copy, text, length * 2)
    m.release(m.getWord(it + TEXT))
    m.putWord(it + TEXT, copy)
    m.putWord(it + LENGTH, length)
    m.putWord(it + FOUND, 0)
    m.putWord(it + CURRENT, 0)
    m.release(m.getWord(it + BOUNDARIES))
    m.release(m.getWord(it + STATUSES))
    m.putWord(it + BOUNDARIES, 0)
    m.putWord(it + STATUSES, 0)
    m.putWord(it + COUNT, 0)
    return true
}

// The options of a locale ID's keywords: `@lb=strict;lw=keepall`.
fn localeOptions(locale: usize) -> u32 {
    var options = LB_STRICT
    if locale == 0 { return options }
    const text = m.cSlice(locale)
    var index: usize = 0
    while index < text.length && text[index] != 64 { index += 1 }
    while index < text.length {
        index += 1
        const start = index
        while index < text.length && text[index] != 59 { index += 1 }
        const keyword = text[start..index]
        if p.looselySame(keyword, "lb=loose") { options = (options & ~LB_STRICT) | LB_LOOSE }
        if p.looselySame(keyword, "lb=normal") { options = options & ~LB_STRICT }
        if p.looselySame(keyword, "lb=strict") { options = options | LB_STRICT }
        if p.looselySame(keyword, "lw=keepall") { options = options | LW_KEEP_ALL }
        if p.looselySame(keyword, "lw=breakall") { options = options | LW_BREAK_ALL }
    }
    return options
}

pub fn ubrk_open(kind: i32, locale: usize, text: usize, length: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if kind < 0 || kind > 4 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const it = m.alloc(SIZE)
    if it == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    m.put32(it + TYPE, @intCast(u32, kind))
    m.put32(it + OPTIONS, localeOptions(locale))
    if text != 0 {
        ubrk_setText(it, text, length, status)
    } else {
        _ = setTextUnits(it, 0, 0)
    }
    return it
}

pub fn ubrk_openRules(rules: usize, rulesLength: i32, text: usize, textLength: i32, parseError: usize, status: usize) -> usize {
    // (Rules of the program's own are not read: the iterator is a word
    // iterator.)
    if m.failed(status) { return 0 }
    m.setError(status, m.UNSUPPORTED_ERROR)
    return 0
}

pub fn ubrk_clone(bi: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if bi == 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const it = m.alloc(SIZE)
    if it == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    m.put32(it + TYPE, m.get32(bi + TYPE))
    m.put32(it + OPTIONS, m.get32(bi + OPTIONS))
    _ = setTextUnits(it, m.getWord(bi + TEXT), m.getWord(bi + LENGTH))
    if m.getWord(bi + FOUND) != 0 {
        compute(it)
        m.putWord(it + CURRENT, m.getWord(bi + CURRENT))
    }
    return it
}

pub fn ubrk_safeClone(bi: usize, stackBuffer: usize, bufferSize: usize, status: usize) -> usize {
    if bufferSize != 0 && m.getI32(bufferSize) == 0 {
        m.putI32(bufferSize, 1)
        return 0
    }
    return ubrk_clone(bi, status)
}

pub fn ubrk_close(bi: usize) -> void {
    if bi == 0 { return }
    m.release(m.getWord(bi + TEXT))
    m.release(m.getWord(bi + BOUNDARIES))
    m.release(m.getWord(bi + STATUSES))
    m.release(bi)
}

pub fn ubrk_setText(bi: usize, text: usize, length: i32, status: usize) -> void {
    if m.failed(status) { return }
    if bi == 0 || (text == 0 && length != 0) || length < -1 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    if !setTextUnits(bi, text, if text == 0 { 0 } else { m.units(text, length) }) { m.setError(status, m.MEMORY_ALLOCATION_ERROR) }
}

// UText: the text read through its provider's chunks (native indexes
// taken as UTF-16 offsets, as the providers here have them).
// The fields of a UText (utext.h), by offset.
const UT_MAGIC: usize = 0
const UT_FLAGS: usize = 4
const UT_PROVIDER_PROPERTIES: usize = 8
const UT_SIZE_OF_STRUCT: usize = 12
const UT_CHUNK_NATIVE_LIMIT: usize = 16
const UT_EXTRA_SIZE: usize = 24
const UT_NATIVE_INDEXING_LIMIT: usize = 28
const UT_CHUNK_NATIVE_START: usize = 32
const UT_CHUNK_OFFSET: usize = 40
const UT_CHUNK_LENGTH: usize = 44
const UT_CHUNK_CONTENTS: usize = 48
const UT_FUNCS: usize = 56
const UT_EXTRA: usize = 64
const UT_CONTEXT: usize = 72
const UT_P: usize = 80
const UT_Q: usize = 88
const UT_R: usize = 96
const UT_PRIV_P: usize = 104
const UT_A: usize = 112
const UT_B: usize = 120
const UT_C: usize = 128
const UT_PRIV_A: usize = 136
const UT_PRIV_B: usize = 144
const UT_PRIV_C: usize = 152

const UTEXT_MAGIC: u32 = 878368812
const FUNCS_CLONE: usize = 16
const FUNCS_LENGTH: usize = 24
const FUNCS_ACCESS: usize = 32
const FUNCS_EXTRACT: usize = 40
const FUNCS_CLOSE: usize = 80
const NativeLength = fn(usize) -> i64
const Access = fn(usize, i64, u8) -> u8
const Close = fn(usize) -> void

fn nativeLength(ut: usize) -> i64 {
    const function = m.getWord(m.getWord(ut + UT_FUNCS) + FUNCS_LENGTH)
    const target: NativeLength = unsafe { @ptrFromInt(NativeLength, function) }
    return target(ut)
}

fn access(ut: usize, index: i64, forward: bool) -> bool {
    const function = m.getWord(m.getWord(ut + UT_FUNCS) + FUNCS_ACCESS)
    const target: Access = unsafe { @ptrFromInt(Access, function) }
    return (target(ut, index, if forward { 1 } else { 0 }) & 255) != 0
}

// The units of a UText into `out` (16-bit values in a 32-bit buffer).
fn readUText(ut: usize, out: *m.Buffer) -> void {
    const length = nativeLength(ut)
    var index: i64 = 0
    while index < length {
        if !access(ut, index, true) { break }
        const start = m.getI64(ut + UT_CHUNK_NATIVE_START)
        const limit = m.getI64(ut + UT_CHUNK_NATIVE_LIMIT)
        if limit <= index { break }
        const contents = m.getWord(ut + UT_CHUNK_CONTENTS)
        const chunkLength = @intCast(usize, m.getI32(ut + UT_CHUNK_LENGTH))
        var unit = @intCast(usize, index - start)
        while unit < chunkLength {
            m.push(out, @intCast(u32, m.get16(contents + unit * 2)))
            unit += 1
        }
        index = limit
    }
}

pub fn ubrk_setUText(bi: usize, ut: usize, status: usize) -> void {
    if m.failed(status) { return }
    if bi == 0 || ut == 0 || m.get32(ut + UT_MAGIC) != UTEXT_MAGIC {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    var units = m.buffer()
    readUText(ut, &units)
    const copy = m.alloc(units.length * 2 + 2)
    var index: usize = 0
    while index < units.length {
        m.put16(copy + index * 2, @intCast(u16, m.at(&units, index)))
        index += 1
    }
    const ok = setTextUnits(bi, copy, units.length)
    m.release(copy)
    m.dispose(&units)
    if !ok { m.setError(status, m.MEMORY_ALLOCATION_ERROR) }
}

pub fn ubrk_refreshUText(bi: usize, ut: usize, status: usize) -> void {
    const current = if bi != 0 { m.getWord(bi + CURRENT) } else { 0 }
    ubrk_setUText(bi, ut, status)
    if bi != 0 { m.putWord(bi + CURRENT, current) }
}

fn currentOffset(bi: usize) -> i32 {
    compute(bi)
    return boundaryAt(bi, m.getWord(bi + CURRENT))
}

pub fn ubrk_current(bi: usize) -> i32 {
    if bi == 0 { return DONE }
    return currentOffset(bi)
}

pub fn ubrk_first(bi: usize) -> i32 {
    if bi == 0 { return DONE }
    compute(bi)
    m.putWord(bi + CURRENT, 0)
    return 0
}

pub fn ubrk_last(bi: usize) -> i32 {
    if bi == 0 { return DONE }
    compute(bi)
    m.putWord(bi + CURRENT, m.getWord(bi + COUNT) - 1)
    return currentOffset(bi)
}

pub fn ubrk_next(bi: usize) -> i32 {
    if bi == 0 { return DONE }
    compute(bi)
    const current = m.getWord(bi + CURRENT)
    if current + 1 >= m.getWord(bi + COUNT) { return DONE }
    m.putWord(bi + CURRENT, current + 1)
    return boundaryAt(bi, current + 1)
}

pub fn ubrk_previous(bi: usize) -> i32 {
    if bi == 0 { return DONE }
    compute(bi)
    const current = m.getWord(bi + CURRENT)
    if current == 0 { return DONE }
    m.putWord(bi + CURRENT, current - 1)
    return boundaryAt(bi, current - 1)
}

// The index of the first boundary at or after `offset`.
fn firstAtOrAfter(bi: usize, offset: i32) -> usize {
    var low: usize = 0
    var high = m.getWord(bi + COUNT)
    while low < high {
        const middle = (low + high) / 2
        if boundaryAt(bi, middle) < offset { low = middle + 1 } else { high = middle }
    }
    return low
}

pub fn ubrk_following(bi: usize, offset: i32) -> i32 {
    if bi == 0 { return DONE }
    compute(bi)
    const count = m.getWord(bi + COUNT)
    if offset < 0 { return ubrk_first(bi) }
    var index = firstAtOrAfter(bi, offset)
    if index < count && boundaryAt(bi, index) == offset { index += 1 }
    if index >= count {
        m.putWord(bi + CURRENT, count - 1)
        return DONE
    }
    m.putWord(bi + CURRENT, index)
    return boundaryAt(bi, index)
}

pub fn ubrk_preceding(bi: usize, offset: i32) -> i32 {
    if bi == 0 { return DONE }
    compute(bi)
    const count = m.getWord(bi + COUNT)
    if offset > boundaryAt(bi, count - 1) { return ubrk_last(bi) }
    const index = firstAtOrAfter(bi, offset)
    if index == 0 {
        m.putWord(bi + CURRENT, 0)
        return DONE
    }
    m.putWord(bi + CURRENT, index - 1)
    return boundaryAt(bi, index - 1)
}

pub fn ubrk_isBoundary(bi: usize, offset: i32) -> u8 {
    if bi == 0 { return 0 }
    compute(bi)
    const count = m.getWord(bi + COUNT)
    if offset < 0 {
        _ = ubrk_first(bi)
        return 0
    }
    const index = firstAtOrAfter(bi, offset)
    if index >= count {
        _ = ubrk_last(bi)
        return 0
    }
    m.putWord(bi + CURRENT, index)
    return if boundaryAt(bi, index) == offset { 1 } else { 0 }
}

pub fn ubrk_getRuleStatus(bi: usize) -> i32 {
    if bi == 0 { return 0 }
    compute(bi)
    return statusAt(bi, m.getWord(bi + CURRENT))
}

pub fn ubrk_getRuleStatusVec(bi: usize, fillIn: usize, capacity: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    if capacity < 1 {
        m.setError(status, m.BUFFER_OVERFLOW_ERROR)
        return 1
    }
    m.putI32(fillIn, ubrk_getRuleStatus(bi))
    return 1
}

pub fn ubrk_countAvailable() -> i32 { return 1 }

pub fn ubrk_getAvailable(index: i32) -> usize {
    if index != 0 { return 0 }
    return m.literal("en")
}

pub fn ubrk_getLocaleByType(bi: usize, kind: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    return m.literal("root")
}

// ---------------------------------------------------------------------------
// UText (utext.h): set up, closed, and over UTF-16 strings

const HEAP_ALLOCATED: i32 = 1
const EXTRA_HEAP_ALLOCATED: i32 = 2
const OPEN: i32 = 4
const UTEXT_SIZE: usize = 160

fn callClose(ut: usize) -> void {
    const funcs = m.getWord(ut + UT_FUNCS)
    if funcs == 0 { return }
    const close = m.getWord(funcs + FUNCS_CLOSE)
    if close == 0 { return }
    const target: Close = unsafe { @ptrFromInt(Close, close) }
    target(ut)
}

pub fn utext_setup(ut: usize, extraSpace: i32, status: usize) -> usize {
    if m.failed(status) { return ut }
    var text = ut
    if text == 0 {
        const extra = if extraSpace > 0 { @intCast(usize, extraSpace) } else { 0 }
        text = m.alloc(UTEXT_SIZE + extra)
        if text == 0 {
            m.setError(status, m.MEMORY_ALLOCATION_ERROR)
            return 0
        }
        m.put32(text + UT_MAGIC, UTEXT_MAGIC)
        m.putI32(text + UT_FLAGS, HEAP_ALLOCATED)
        m.putI32(text + UT_SIZE_OF_STRUCT, @intCast(i32, UTEXT_SIZE))
        if extra > 0 {
            m.putI32(text + UT_EXTRA_SIZE, extraSpace)
            m.putWord(text + UT_EXTRA, text + UTEXT_SIZE)
        }
    } else {
        if m.get32(text + UT_MAGIC) != UTEXT_MAGIC {
            m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
            return text
        }
        if (m.getI32(text + UT_FLAGS) & OPEN) != 0 { callClose(text) }
        m.putI32(text + UT_FLAGS, m.getI32(text + UT_FLAGS) & ~OPEN)
        if extraSpace > m.getI32(text + UT_EXTRA_SIZE) {
            if (m.getI32(text + UT_FLAGS) & EXTRA_HEAP_ALLOCATED) != 0 { m.release(m.getWord(text + UT_EXTRA)) }
            const extra = m.alloc(@intCast(usize, extraSpace))
            m.putWord(text + UT_EXTRA, extra)
            if extra == 0 {
                m.setError(status, m.MEMORY_ALLOCATION_ERROR)
                return text
            }
            m.putI32(text + UT_EXTRA_SIZE, extraSpace)
            m.putI32(text + UT_FLAGS, m.getI32(text + UT_FLAGS) | EXTRA_HEAP_ALLOCATED)
        }
    }
    m.putI32(text + UT_FLAGS, m.getI32(text + UT_FLAGS) | OPEN)
    m.putI32(text + UT_PROVIDER_PROPERTIES, 0)
    m.putI64(text + UT_CHUNK_NATIVE_LIMIT, 0)
    m.putI32(text + UT_NATIVE_INDEXING_LIMIT, 0)
    m.putI64(text + UT_CHUNK_NATIVE_START, 0)
    m.putI32(text + UT_CHUNK_OFFSET, 0)
    m.putI32(text + UT_CHUNK_LENGTH, 0)
    m.putWord(text + UT_CHUNK_CONTENTS, 0)
    m.putWord(text + UT_CONTEXT, 0)
    m.putWord(text + UT_P, 0)
    m.putWord(text + UT_Q, 0)
    m.putWord(text + UT_R, 0)
    m.putWord(text + UT_PRIV_P, 0)
    m.putI64(text + UT_A, 0)
    m.putI64(text + UT_B, 0)
    m.putI64(text + UT_C, 0)
    m.putI64(text + UT_PRIV_A, 0)
    m.putI64(text + UT_PRIV_B, 0)
    m.putI64(text + UT_PRIV_C, 0)
    const extra = m.getWord(text + UT_EXTRA)
    const extraSize = m.getI32(text + UT_EXTRA_SIZE)
    if extra != 0 && extraSize > 0 { m.zero(extra, @intCast(usize, extraSize)) }
    return text
}

pub fn utext_close(ut: usize) -> usize {
    if ut == 0 { return 0 }
    if m.get32(ut + UT_MAGIC) != UTEXT_MAGIC || (m.getI32(ut + UT_FLAGS) & OPEN) == 0 { return ut }
    callClose(ut)
    var flags = m.getI32(ut + UT_FLAGS) & ~OPEN
    if (flags & EXTRA_HEAP_ALLOCATED) != 0 {
        m.release(m.getWord(ut + UT_EXTRA))
        m.putWord(ut + UT_EXTRA, 0)
        flags = flags & ~EXTRA_HEAP_ALLOCATED
        m.putI32(ut + UT_EXTRA_SIZE, 0)
    }
    m.putI32(ut + UT_FLAGS, flags)
    if (flags & HEAP_ALLOCATED) != 0 {
        m.put32(ut + UT_MAGIC, 0)
        m.putI32(ut + UT_FLAGS, 0)
        m.release(ut)
        return 0
    }
    return ut
}

// A UText over UTF-16 units of the caller's: one chunk, the whole text.
var ucharsFuncs: [16]usize = undefined
var ucharsFuncsReady: bool = false

fn ucharsLength(ut: usize) -> i64 { return m.getI64(ut + UT_A) }

fn ucharsAccess(ut: usize, index: i64, forward: u8) -> u8 {
    const length = m.getI64(ut + UT_A)
    var at = index
    if at < 0 { at = 0 }
    if at > length { at = length }
    m.putI32(ut + UT_CHUNK_OFFSET, @intCast(i32, at))
    if forward != 0 { return if at < length { 1 } else { 0 } }
    return if at > 0 { 1 } else { 0 }
}

fn ucharsClose(ut: usize) -> void {}

pub fn utext_openUChars(ut: usize, s: usize, length: i64, status: usize) -> usize {
    if m.failed(status) { return ut }
    if s == 0 && length != 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return ut
    }
    if !ucharsFuncsReady {
        ucharsFuncs[0] = 128
        ucharsFuncs[3] = @intFromPtr(ucharsLength)
        ucharsFuncs[4] = @intFromPtr(ucharsAccess)
        ucharsFuncs[10] = @intFromPtr(ucharsClose)
        ucharsFuncsReady = true
    }
    const text = utext_setup(ut, 0, status)
    if m.failed(status) { return text }
    const count = if s == 0 { 0 } else { m.units(s, if length < 0 { -1 } else { @intCast(i32, length) }) }
    m.putWord(text + UT_FUNCS, @intFromPtr(&ucharsFuncs))
    m.putWord(text + UT_CONTEXT, s)
    m.putI64(text + UT_A, @intCast(i64, count))
    m.putWord(text + UT_CHUNK_CONTENTS, s)
    m.putI32(text + UT_CHUNK_LENGTH, @intCast(i32, count))
    m.putI64(text + UT_CHUNK_NATIVE_START, 0)
    m.putI64(text + UT_CHUNK_NATIVE_LIMIT, @intCast(i64, count))
    m.putI32(text + UT_NATIVE_INDEXING_LIMIT, @intCast(i32, count))
    m.putI32(text + UT_PROVIDER_PROPERTIES, 4)
    return text
}

pub fn utext_nativeLength(ut: usize) -> i64 {
    if ut == 0 { return 0 }
    return nativeLength(ut)
}

// ---------------------------------------------------------------------------
// The native API (std.unicode: UTF-8 text, results from the allocator
// given, failures as unicode.Error).

pub const Kind = enum(u8) {
    grapheme,
    word,
    line,
    sentence,
}

// The boundaries of a UTF-8 text, one at a time: byte offsets from 0 to
// the text's length.
//
//     var boundaries = try breaks.open(allocator, breaks.Kind.word, text, "")
//     defer breaks.close(&boundaries)
//     var start: usize = 0
//     while breaks.next(&boundaries) |end| { ... text[start..end] ... }
pub const Boundaries = struct {
    allocator: utf.Allocator
    iterator: usize
    units: []u16
    text: []const u8
    // Where the last boundary was, in units and in bytes.
    unit: usize
    byte: usize
}

pub fn open(allocator: utf.Allocator, kind: Kind, text: []const u8, locale: []const u8) -> unicode.Error!Boundaries {
    var name: [160]u8 = undefined
    const id = try unicode.cName(locale, &name)
    const units = try utf.toUtf16(allocator, text)
    var status: i32 = 0
    const iterator = ubrk_open(@intCast(i32, @intFromEnum(kind)), id, @intFromPtr(units.pointer), @intCast(i32, units.length), @intFromPtr(&status))
    if status > 0 || iterator == 0 {
        utf.free16(allocator, units)
        try unicode.check(if status > 0 { status } else { unicode.MEMORY_ALLOCATION_ERROR })
    }
    return Boundaries.{ .allocator = allocator, .iterator = iterator, .units = units, .text = text, .unit = 0, .byte = 0 }
}

// The next boundary after the last (the first is the one after 0), else
// null at the end.
pub fn next(boundaries: *Boundaries) -> ?usize {
    const found = ubrk_next(boundaries.*.iterator)
    if found < 0 { return null }
    const target = @intCast(usize, found)
    while boundaries.*.unit < target && boundaries.*.byte < boundaries.*.text.length {
        const step = utf.decode8(boundaries.*.text, boundaries.*.byte)
        boundaries.*.unit += utf.length16(step.codepoint)
        boundaries.*.byte += step.length
    }
    return boundaries.*.byte
}

pub fn close(boundaries: *Boundaries) -> void {
    ubrk_close(boundaries.*.iterator)
    utf.free16(boundaries.*.allocator, boundaries.*.units)
    boundaries.*.iterator = 0
}

// How many pieces of `kind` `text` has (grapheme clusters: the
// characters a reader sees).
pub fn count(allocator: utf.Allocator, kind: Kind, text: []const u8) -> unicode.Error!usize {
    var boundaries = try open(allocator, kind, text, "")
    defer close(&boundaries)
    var pieces: usize = 0
    while next(&boundaries) != null { pieces += 1 }
    return pieces
}
