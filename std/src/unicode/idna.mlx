// Internationalized domain names (uidna.h): UTS #46 processing (mapping
// by the IDNA mapping table, NFC, labels checked: hyphens, marks,
// disallowed code points, the bidi rule of RFC 5893, the CONTEXTJ and
// CONTEXTO rules of RFC 5892) with Punycode (RFC 3492) for ToASCII. It
// goes as ICU's UTS46 class goes, so that what it returns and the errors
// it finds are ICU's: a fast path over ASCII, the rest mapped and
// normalized, then label by label.
//
// Text is worked on as UTF-16 code units (kept in m.Buffer, one unit a
// value), as ICU indexes it.
const tables = @import("std.unicode.tables")
const m = @import("std.unicode.memory")
const p = @import("std.unicode.properties")
const normalize = @import("std.unicode.normalize")
const unicode = @import("std.unicode")
const utf = @import("std.unicode.utf")

// Options
const USE_STD3_RULES: u32 = 2
const CHECK_BIDI: u32 = 4
const CHECK_CONTEXTJ: u32 = 8
const NONTRANSITIONAL_TO_ASCII: u32 = 16
const NONTRANSITIONAL_TO_UNICODE: u32 = 32
const CHECK_CONTEXTO: u32 = 64

// Errors
const ERROR_EMPTY_LABEL: u32 = 1
const ERROR_LABEL_TOO_LONG: u32 = 2
const ERROR_DOMAIN_NAME_TOO_LONG: u32 = 4
const ERROR_LEADING_HYPHEN: u32 = 8
const ERROR_TRAILING_HYPHEN: u32 = 16
const ERROR_HYPHEN_3_4: u32 = 32
const ERROR_LEADING_COMBINING_MARK: u32 = 64
const ERROR_DISALLOWED: u32 = 128
const ERROR_PUNYCODE: u32 = 256
const ERROR_LABEL_HAS_DOT: u32 = 512
const ERROR_INVALID_ACE_LABEL: u32 = 1024
const ERROR_BIDI: u32 = 2048
const ERROR_CONTEXTJ: u32 = 4096
const ERROR_CONTEXTO_PUNCTUATION: u32 = 8192
const ERROR_CONTEXTO_DIGITS: u32 = 16384

const SEVERE_ERRORS: u32 = 64 | 128 | 256 | 512 | 1024

// The statuses of the mapping table.
const VALID: u32 = 0
const MAPPED: u32 = 1
const DEVIATION: u32 = 2
const IGNORED: u32 = 3
const DISALLOWED: u32 = 4

const Info = struct {
    errors: u32
    labelErrors: u32
    isTransDiff: bool
    isBiDi: bool
    isOkBiDi: bool
}

// ASCII: -1 disallowed by STD3, 0 valid, 1 mapped (upper case).
fn asciiData(c: u32) -> i32 {
    if c >= 65 && c <= 90 { return 1 }
    if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 46 { return 0 }
    return -1
}

fn isSurrogate(c: u32) -> bool { return c >= 55296 && c <= 57343 }
fn isLead(c: u32) -> bool { return c >= 55296 && c <= 56319 }
fn isTrail(c: u32) -> bool { return c >= 56320 && c <= 57343 }

// ---------------------------------------------------------------------------
// Unit buffers

fn unitAt(b: *m.Buffer, index: usize) -> u32 { return m.at(b, index) }

// `b` from `start` (its units to `end`) into a new buffer.
fn slice(b: *m.Buffer, start: usize, end: usize) -> m.Buffer {
    var out = m.buffer()
    var index = start
    while index < end {
        m.push(&out, m.at(b, index))
        index += 1
    }
    return out
}

fn append(out: *m.Buffer, b: *m.Buffer) -> void {
    var index: usize = 0
    while index < b.*.length {
        m.push(out, m.at(b, index))
        index += 1
    }
}

// The code point at unit `index` (and how many units it takes).
fn codeAt(b: *m.Buffer, index: usize, end: usize, used: *usize) -> i32 {
    const c = m.at(b, index)
    if isLead(c) && index + 1 < end && isTrail(m.at(b, index + 1)) {
        used.* = 2
        return @intCast(i32, (c << 10) + m.at(b, index + 1) - 56613888)
    }
    used.* = 1
    return @intCast(i32, c)
}

// The code point ending before unit `index`.
fn codeBefore(b: *m.Buffer, start: usize, index: usize, used: *usize) -> i32 {
    const c = m.at(b, index - 1)
    if isTrail(c) && index - 1 > start && isLead(m.at(b, index - 2)) {
        used.* = 2
        return @intCast(i32, (m.at(b, index - 2) << 10) + c - 56613888)
    }
    used.* = 1
    return @intCast(i32, c)
}

fn pushCode(out: *m.Buffer, c: u32) -> void {
    if c < 65536 {
        m.push(out, c)
    } else {
        m.push(out, (c >> 10) + 55232)
        m.push(out, (c & 1023) | 56320)
    }
}

// ---------------------------------------------------------------------------
// The UTS #46 normalization: the mapping table (deviation characters
// kept, disallowed ones U+FFFD, ignored ones gone), then NFC.

fn record(c: i32) -> u32 {
    const code = @intCast(usize, c)
    const block = @intCast(usize, tables.IDNA_INDEX[code >> 6])
    return tables.IDNA_RECORDS[@intCast(usize, tables.IDNA_BLOCKS[(block << 6) + (code & 63)])]
}

fn statusOf(c: i32) -> u32 { return record(c) >> 29 }

fn uts46Normalize(units: *m.Buffer, start: usize, end: usize) -> m.Buffer {
    var codes = m.buffer()
    var index = start
    while index < end {
        var used: usize = 1
        const c = codeAt(units, index, end, &used)
        index += used
        const value = record(c)
        const status = value >> 29
        if status == VALID || status == DEVIATION {
            m.push(&codes, @intCast(u32, c))
        } else if status == MAPPED {
            const count = @intCast(usize, (value >> 24) & 31)
            const offset = @intCast(usize, value & 16777215)
            var k: usize = 0
            while k < count {
                m.push(&codes, tables.IDNA_DATA[offset + k])
                k += 1
            }
        } else if status == DISALLOWED {
            m.push(&codes, 65533)
        }
    }
    var composed = m.buffer()
    normalize.normalizeCodes(&composed, &codes, normalize.NFC)
    m.dispose(&codes)
    var out = m.buffer()
    index = 0
    while index < composed.length {
        pushCode(&out, m.at(&composed, index))
        index += 1
    }
    m.dispose(&composed)
    return out
}

fn sameUnits(a: *m.Buffer, b: *m.Buffer) -> bool {
    if a.*.length != b.*.length { return false }
    var index: usize = 0
    while index < a.*.length {
        if m.at(a, index) != m.at(b, index) { return false }
        index += 1
    }
    return true
}

// ---------------------------------------------------------------------------
// Punycode (RFC 3492)

const BASE: i64 = 36
const TMIN: i64 = 1
const TMAX: i64 = 26
const SKEW: i64 = 38
const DAMP: i64 = 700
const INITIAL_BIAS: i64 = 72
const INITIAL_N: i64 = 128

fn adaptBias(deltaIn: i64, length: i64, firstTime: bool) -> i64 {
    var delta = if firstTime { deltaIn / DAMP } else { deltaIn / 2 }
    delta += delta / length
    var count: i64 = 0
    while delta > ((BASE - TMIN) * TMAX) / 2 {
        delta = delta / (BASE - TMIN)
        count += BASE
    }
    return count + (((BASE - TMIN + 1) * delta) / (delta + SKEW))
}

fn digitToBasic(digit: i64) -> u32 {
    if digit < 26 { return @intCast(u32, 97 + digit) }
    return @intCast(u32, 22 + digit)
}

fn basicToDigit(c: u32) -> i64 {
    if c >= 97 && c <= 122 { return @intCast(i64, c - 97) }
    if c >= 65 && c <= 90 { return @intCast(i64, c - 65) }
    if c >= 48 && c <= 57 { return @intCast(i64, c - 22) }
    return -1
}

// The Punycode of units `start`..`end` appended to `out`; false for an
// unpaired surrogate.
fn toPunycode(label: *m.Buffer, start: usize, end: usize, out: *m.Buffer) -> bool {
    var codes = m.buffer()
    var basic: i64 = 0
    var index = start
    while index < end {
        const c = m.at(label, index)
        if c < 128 {
            m.push(out, c)
            m.push(&codes, 0)
            basic += 1
            index += 1
        } else if !isSurrogate(c) {
            m.push(&codes, c)
            index += 1
        } else if isLead(c) && index + 1 < end && isTrail(m.at(label, index + 1)) {
            m.push(&codes, (c << 10) + m.at(label, index + 1) - 56613888)
            index += 2
        } else {
            m.dispose(&codes)
            return false
        }
    }
    if basic > 0 { m.push(out, 45) }
    var n = INITIAL_N
    var delta: i64 = 0
    var bias = INITIAL_BIAS
    var handled = basic
    const total = @intCast(i64, codes.length)
    while handled < total {
        var least: i64 = 2147483647
        var j: usize = 0
        while j < codes.length {
            const q = @intCast(i64, m.at(&codes, j))
            if n <= q && q < least { least = q }
            j += 1
        }
        delta += (least - n) * (handled + 1)
        n = least
        j = 0
        while j < codes.length {
            const q0 = @intCast(i64, m.at(&codes, j))
            if q0 < n {
                delta += 1
            } else if q0 == n {
                var q = delta
                var k = BASE
                while true {
                    var t = k - bias
                    if t < TMIN {
                        t = TMIN
                    } else if k >= bias + TMAX {
                        t = TMAX
                    }
                    if q < t { break }
                    m.push(out, digitToBasic(t + (q - t) % (BASE - t)))
                    q = (q - t) / (BASE - t)
                    k += BASE
                }
                m.push(out, digitToBasic(q))
                bias = adaptBias(delta, handled + 1, handled == basic)
                delta = 0
                handled += 1
            }
            j += 1
        }
        delta += 1
        n += 1
    }
    m.dispose(&codes)
    return true
}

// The code points Punycode units `start`..`end` decode to, as units in
// `out`; false when they do not decode.
fn fromPunycode(label: *m.Buffer, start: usize, end: usize, out: *m.Buffer) -> bool {
    var codes = m.buffer()
    var delimiter = end
    var j = end
    while j > start {
        j -= 1
        if m.at(label, j) == 45 {
            delimiter = j
            break
        }
    }
    const basicEnd = if delimiter == end { start } else { delimiter }
    j = start
    while j < basicEnd {
        const b = m.at(label, j)
        if b >= 128 {
            m.dispose(&codes)
            return false
        }
        m.push(&codes, b)
        j += 1
    }
    var n = INITIAL_N
    var i: i64 = 0
    var bias = INITIAL_BIAS
    var at = if basicEnd > start { basicEnd + 1 } else { start }
    while at < end {
        const oldi = i
        var w: i64 = 1
        var k = BASE
        while true {
            if at >= end {
                m.dispose(&codes)
                return false
            }
            const digit = basicToDigit(m.at(label, at))
            at += 1
            if digit < 0 || digit > (2147483647 - i) / w {
                m.dispose(&codes)
                return false
            }
            i += digit * w
            var t = k - bias
            if t < TMIN {
                t = TMIN
            } else if k >= bias + TMAX {
                t = TMAX
            }
            if digit < t { break }
            if w > 2147483647 / (BASE - t) {
                m.dispose(&codes)
                return false
            }
            w = w * (BASE - t)
            k += BASE
        }
        const count = @intCast(i64, codes.length) + 1
        bias = adaptBias(i - oldi, count, oldi == 0)
        if i / count > 2147483647 - n {
            m.dispose(&codes)
            return false
        }
        n += i / count
        i = i % count
        if n > 1114111 || (n >= 55296 && n <= 57343) {
            m.dispose(&codes)
            return false
        }
        // Insert n at i.
        m.push(&codes, 0)
        var place = codes.length - 1
        while place > @intCast(usize, i) {
            m.setAt(&codes, place, m.at(&codes, place - 1))
            place -= 1
        }
        m.setAt(&codes, @intCast(usize, i), @intCast(u32, n))
        i += 1
    }
    j = 0
    while j < codes.length {
        pushCode(out, m.at(&codes, j))
        j += 1
    }
    m.dispose(&codes)
    return true
}

// ---------------------------------------------------------------------------
// Checks of a label

const L: u32 = 0
const R: u32 = 1
const EN: u32 = 2
const ES: u32 = 3
const ET: u32 = 4
const AN: u32 = 5
const CS: u32 = 6
const ON: u32 = 10
const AL: u32 = 13
const NSM: u32 = 17
const BN: u32 = 18

fn mask(direction: u32) -> u32 { return @intCast(u32, 1) << @intCast(u5, direction) }

fn checkLabelBiDi(label: *m.Buffer, start: usize, end: usize, info: *Info) -> void {
    const lMask = mask(L)
    const rAlMask = mask(R) | mask(AL)
    const enAnMask = mask(EN) | mask(AN)
    const neutralMask = mask(ES) | mask(CS) | mask(ET) | mask(ON) | mask(BN) | mask(NSM)
    var used: usize = 1
    var i = start
    var c = codeAt(label, i, end, &used)
    i += used
    const firstMask = mask(p.bidiClass(c))
    if (firstMask & ~(lMask | rAlMask)) != 0 { info.*.isOkBiDi = false }
    var lastMask = firstMask
    var limit = end
    while true {
        if i >= limit {
            lastMask = firstMask
            break
        }
        c = codeBefore(label, i, limit, &used)
        limit -= used
        const direction = p.bidiClass(c)
        if direction != NSM {
            lastMask = mask(direction)
            break
        }
    }
    if (firstMask & lMask) != 0 {
        if (lastMask & ~(lMask | mask(EN))) != 0 { info.*.isOkBiDi = false }
    } else {
        if (lastMask & ~(rAlMask | enAnMask)) != 0 { info.*.isOkBiDi = false }
    }
    var all = firstMask | lastMask
    while i < limit {
        c = codeAt(label, i, limit, &used)
        i += used
        all |= mask(p.bidiClass(c))
    }
    if (firstMask & lMask) != 0 {
        if (all & ~(lMask | mask(EN) | neutralMask)) != 0 { info.*.isOkBiDi = false }
    } else {
        if (all & ~(rAlMask | enAnMask | neutralMask)) != 0 { info.*.isOkBiDi = false }
        if (all & enAnMask) == enAnMask { info.*.isOkBiDi = false }
    }
    if (all & (rAlMask | mask(AN))) != 0 { info.*.isBiDi = true }
}

fn isASCIIOkBiDi(s: *m.Buffer, length: usize) -> bool {
    var labelStart: usize = 0
    var i: usize = 0
    while i < length {
        var c = m.at(s, i)
        if c == 46 {
            if i > labelStart {
                c = m.at(s, i - 1)
                if !(c >= 97 && c <= 122) && !(c >= 48 && c <= 57) { return false }
            }
            labelStart = i + 1
        } else if i == labelStart {
            if !(c >= 97 && c <= 122) { return false }
        } else {
            if c <= 32 && (c >= 28 || (c >= 9 && c <= 13)) { return false }
        }
        i += 1
    }
    return true
}

// Joining types (UJoiningType): T transparent, L left, D dual, R right.
const JT_DUAL: u32 = 2
const JT_LEFT: u32 = 3
const JT_RIGHT: u32 = 4
const JT_TRANSPARENT: u32 = 5

fn isLabelOkContextJ(label: *m.Buffer, start: usize, end: usize) -> bool {
    var i = start
    while i < end {
        const unit = m.at(label, i)
        if unit == 8204 {
            if i == start { return false }
            var used: usize = 1
            var j = i
            var c = codeBefore(label, start, j, &used)
            j -= used
            if p.combiningClass(c) == 9 {
                i += 1
                continue
            }
            while true {
                const kind = p.joiningType(c)
                if kind == JT_TRANSPARENT {
                    if j == start { return false }
                    c = codeBefore(label, start, j, &used)
                    j -= used
                } else if kind == JT_LEFT || kind == JT_DUAL {
                    break
                } else {
                    return false
                }
            }
            j = i + 1
            while true {
                if j == end { return false }
                c = codeAt(label, j, end, &used)
                j += used
                const kind = p.joiningType(c)
                if kind == JT_TRANSPARENT {
                    // skipped
                } else if kind == JT_RIGHT || kind == JT_DUAL {
                    break
                } else {
                    return false
                }
            }
        } else if unit == 8205 {
            if i == start { return false }
            var used: usize = 1
            const c = codeBefore(label, start, i, &used)
            if p.combiningClass(c) != 9 { return false }
        }
        i += 1
    }
    return true
}

fn checkLabelContextO(label: *m.Buffer, start: usize, end: usize, info: *Info) -> void {
    const last = end - 1
    var arabicDigits: i32 = 0
    var i = start
    while i <= last {
        const c = m.at(label, i)
        if c < 183 {
            // nothing
        } else if c <= 1785 {
            if c == 183 {
                if !(start < i && m.at(label, i - 1) == 108 && i < last && m.at(label, i + 1) == 108) { info.*.labelErrors |= ERROR_CONTEXTO_PUNCTUATION }
            } else if c == 885 {
                var script: u32 = 999
                if i < last {
                    var used: usize = 1
                    script = p.script(codeAt(label, i + 1, end, &used))
                }
                if script != p.SCRIPT_GREEK { info.*.labelErrors |= ERROR_CONTEXTO_PUNCTUATION }
            } else if c == 1523 || c == 1524 {
                var script: u32 = 999
                if start < i {
                    var used: usize = 1
                    script = p.script(codeBefore(label, start, i, &used))
                }
                if script != p.SCRIPT_HEBREW { info.*.labelErrors |= ERROR_CONTEXTO_PUNCTUATION }
            } else if c >= 1632 {
                if c <= 1641 {
                    if arabicDigits > 0 { info.*.labelErrors |= ERROR_CONTEXTO_DIGITS }
                    arabicDigits = -1
                } else if c >= 1776 {
                    if arabicDigits < 0 { info.*.labelErrors |= ERROR_CONTEXTO_DIGITS }
                    arabicDigits = 1
                }
            }
        } else if c == 12539 {
            var j = start
            while true {
                if j > last {
                    info.*.labelErrors |= ERROR_CONTEXTO_PUNCTUATION
                    break
                }
                var used: usize = 1
                const script = p.script(codeAt(label, j, end, &used))
                j += used
                if script == p.SCRIPT_HIRAGANA || script == p.SCRIPT_KATAKANA || script == p.SCRIPT_HAN { break }
            }
        }
        i += 1
    }
}

// ---------------------------------------------------------------------------
// Labels

// A Punycode label that is not valid made sure not to look valid
// (ICU's markBadACELabel); the label's units, appended to `out`.
fn markBadACELabel(label: *m.Buffer, options: u32, toASCII: bool, info: *Info, out: *m.Buffer) -> void {
    const std3 = (options & USE_STD3_RULES) != 0
    var isASCII = true
    var onlyLDH = true
    var index: usize = 0
    while index < label.*.length {
        var c = m.at(label, index)
        if index >= 4 && c <= 127 {
            if c == 46 {
                info.*.labelErrors |= ERROR_LABEL_HAS_DOT
                c = 65533
                isASCII = false
                onlyLDH = false
            } else if asciiData(c) < 0 {
                onlyLDH = false
                if std3 {
                    c = 65533
                    isASCII = false
                }
            }
        } else if index >= 4 {
            isASCII = false
            onlyLDH = false
        }
        m.push(out, c)
        index += 1
    }
    if onlyLDH {
        m.push(out, 65533)
    } else if toASCII && isASCII && label.*.length > 63 {
        info.*.labelErrors |= ERROR_LABEL_TOO_LONG
    }
}

// One label (ICU's processLabel): its result appended to `out`.
fn processLabel(original: *m.Buffer, options: u32, toASCII: bool, info: *Info, out: *m.Buffer) -> void {
    const length = original.*.length
    var wasPunycode = false
    var label = m.buffer()
    if length >= 4 && m.at(original, 0) == 120 && m.at(original, 1) == 110 && m.at(original, 2) == 45 && m.at(original, 3) == 45 {
        if length == 4 || (length > 5 && m.at(original, length - 1) == 45) {
            info.*.labelErrors |= ERROR_INVALID_ACE_LABEL
            markBadACELabel(original, options, toASCII, info, out)
            return
        }
        wasPunycode = true
        if !fromPunycode(original, 4, length, &label) {
            m.dispose(&label)
            info.*.labelErrors |= ERROR_PUNYCODE
            markBadACELabel(original, options, toASCII, info, out)
            return
        }
        var normalized = uts46Normalize(&label, 0, label.length)
        const isValid = sameUnits(&normalized, &label)
        m.dispose(&normalized)
        const startsXn = label.length >= 4 && m.at(&label, 0) == 120 && m.at(&label, 1) == 110 && m.at(&label, 2) == 45 && m.at(&label, 3) == 45
        if !isValid || startsXn {
            m.dispose(&label)
            info.*.labelErrors |= ERROR_INVALID_ACE_LABEL
            markBadACELabel(original, options, toASCII, info, out)
            return
        }
    } else {
        append(&label, original)
    }
    var labelLength = label.length
    if labelLength == 0 {
        info.*.labelErrors |= ERROR_EMPTY_LABEL
        m.dispose(&label)
        return
    }
    if labelLength >= 4 && m.at(&label, 2) == 45 && m.at(&label, 3) == 45 { info.*.labelErrors |= ERROR_HYPHEN_3_4 }
    if m.at(&label, 0) == 45 { info.*.labelErrors |= ERROR_LEADING_HYPHEN }
    if m.at(&label, labelLength - 1) == 45 { info.*.labelErrors |= ERROR_TRAILING_HYPHEN }
    const std3 = (options & USE_STD3_RULES) != 0
    var oredChars: u32 = 0
    var index: usize = 0
    while index < labelLength {
        const c = m.at(&label, index)
        if c <= 127 {
            if c == 46 {
                info.*.labelErrors |= ERROR_LABEL_HAS_DOT
                m.setAt(&label, index, 65533)
            } else if std3 && asciiData(c) < 0 {
                info.*.labelErrors |= ERROR_DISALLOWED
                m.setAt(&label, index, 65533)
            }
        } else {
            oredChars |= c
            if c == 65533 { info.*.labelErrors |= ERROR_DISALLOWED }
        }
        index += 1
    }
    // A leading combining mark (after the other checks, so that its U+FFFD
    // is not counted as disallowed).
    var used: usize = 1
    const first = codeAt(&label, 0, labelLength, &used)
    const category = p.category(first)
    if category >= 6 && category <= 8 {
        info.*.labelErrors |= ERROR_LEADING_COMBINING_MARK
        var replaced = m.buffer()
        m.push(&replaced, 65533)
        index = used
        while index < labelLength {
            m.push(&replaced, m.at(&label, index))
            index += 1
        }
        m.dispose(&label)
        label = replaced
        labelLength = label.length
    }
    if (info.*.labelErrors & SEVERE_ERRORS) == 0 {
        if (options & CHECK_BIDI) != 0 && (!info.*.isBiDi || info.*.isOkBiDi) { checkLabelBiDi(&label, 0, labelLength, info) }
        if (options & CHECK_CONTEXTJ) != 0 && (oredChars & 8204) == 8204 && !isLabelOkContextJ(&label, 0, labelLength) { info.*.labelErrors |= ERROR_CONTEXTJ }
        if (options & CHECK_CONTEXTO) != 0 && oredChars >= 183 { checkLabelContextO(&label, 0, labelLength, info) }
        if toASCII {
            if wasPunycode {
                if length > 63 { info.*.labelErrors |= ERROR_LABEL_TOO_LONG }
                append(out, original)
                m.dispose(&label)
                return
            } else if oredChars >= 128 {
                var punycode = m.buffer()
                m.push(&punycode, 120)
                m.push(&punycode, 110)
                m.push(&punycode, 45)
                m.push(&punycode, 45)
                _ = toPunycode(&label, 0, labelLength, &punycode)
                if punycode.length > 63 { info.*.labelErrors |= ERROR_LABEL_TOO_LONG }
                append(out, &punycode)
                m.dispose(&punycode)
                m.dispose(&label)
                return
            } else {
                if labelLength > 63 { info.*.labelErrors |= ERROR_LABEL_TOO_LONG }
            }
        }
    } else if wasPunycode {
        info.*.labelErrors |= ERROR_INVALID_ACE_LABEL
        markBadACELabel(original, options, toASCII, info, out)
        m.dispose(&label)
        return
    }
    append(out, &label)
    m.dispose(&label)
}

// Deviation characters mapped from `from` on (ß to ss, ς to σ, the
// joiners removed), then the text from `labelStart` normalized again.
fn mapDevChars(dest: *m.Buffer, labelStart: usize, from: usize) -> void {
    var mapped = slice(dest, 0, from)
    var changed = false
    var index = from
    while index < dest.*.length {
        const c = m.at(dest, index)
        if c == 223 {
            m.push(&mapped, 115)
            m.push(&mapped, 115)
            changed = true
        } else if c == 962 {
            m.push(&mapped, 963)
            changed = true
        } else if c == 8204 || c == 8205 {
            changed = true
        } else {
            m.push(&mapped, c)
        }
        index += 1
    }
    if changed {
        var normalized = uts46Normalize(&mapped, labelStart, mapped.length)
        var result = slice(&mapped, 0, labelStart)
        append(&result, &normalized)
        m.dispose(&normalized)
        m.dispose(&mapped)
        m.dispose(dest)
        dest.* = result
        return
    }
    m.dispose(dest)
    dest.* = mapped
}

// The name or label (ICU's process): `src` units into `out`.
fn process(src: *m.Buffer, options: u32, isLabel: bool, toASCII: bool, out: *m.Buffer, info: *Info) -> void {
    info.*.errors = 0
    info.*.labelErrors = 0
    info.*.isTransDiff = false
    info.*.isBiDi = false
    info.*.isOkBiDi = true
    const srcLength = src.*.length
    if srcLength == 0 {
        info.*.errors |= ERROR_EMPTY_LABEL
        return
    }
    // The fast path over ASCII.
    const std3 = (options & USE_STD3_RULES) != 0
    var labelStart: usize = 0
    var i: usize = 0
    var dest = m.buffer()
    while true {
        if i == srcLength {
            if toASCII {
                if i - labelStart > 63 { info.*.labelErrors |= ERROR_LABEL_TOO_LONG }
                if !isLabel && i >= 254 && (i > 254 || labelStart < i) { info.*.errors |= ERROR_DOMAIN_NAME_TOO_LONG }
            }
            info.*.errors |= info.*.labelErrors
            append(out, &dest)
            m.dispose(&dest)
            return
        }
        const c = m.at(src, i)
        if c > 127 { break }
        const data = asciiData(c)
        if data > 0 {
            m.push(&dest, c + 32)
        } else if data < 0 && std3 {
            break
        } else {
            m.push(&dest, c)
            if c == 45 {
                if i == labelStart + 3 && m.at(src, i - 1) == 45 {
                    i += 1
                    break
                }
                if i == labelStart { info.*.labelErrors |= ERROR_LEADING_HYPHEN }
                if i + 1 == srcLength || m.at(src, i + 1) == 46 { info.*.labelErrors |= ERROR_TRAILING_HYPHEN }
            } else if c == 46 {
                if isLabel {
                    i += 1
                    break
                }
                if i == labelStart { info.*.labelErrors |= ERROR_EMPTY_LABEL }
                if toASCII && i - labelStart > 63 { info.*.labelErrors |= ERROR_LABEL_TOO_LONG }
                info.*.errors |= info.*.labelErrors
                info.*.labelErrors = 0
                labelStart = i + 1
            }
        }
        i += 1
    }
    info.*.errors |= info.*.labelErrors
    // The rest mapped and normalized, from the current label on (which
    // the fast path copied, lower case, up to i).
    var rest = slice(&dest, labelStart, dest.length)
    var index = i
    while index < srcLength {
        m.push(&rest, m.at(src, index))
        index += 1
    }
    var normalized = uts46Normalize(&rest, 0, rest.length)
    m.dispose(&rest)
    var whole = slice(&dest, 0, labelStart)
    append(&whole, &normalized)
    m.dispose(&normalized)
    m.dispose(&dest)
    processUnicode(&whole, labelStart, options, isLabel, toASCII, out, info)
    if info.*.isBiDi && (info.*.errors & SEVERE_ERRORS) == 0 && (!info.*.isOkBiDi || (labelStart > 0 && !isASCIIOkBiDi(&whole, labelStart))) {
        info.*.errors |= ERROR_BIDI
    }
    m.dispose(&whole)
}

// ICU's processUnicode over `dest` (mapped and normalized from
// `labelStart`): the labels from there processed, into `out` after the
// labels before.
fn processUnicode(dest: *m.Buffer, labelStartIn: usize, options: u32, isLabel: bool, toASCII: bool, out: *m.Buffer, info: *Info) -> void {
    var labelStart = labelStartIn
    var index: usize = 0
    while index < labelStart {
        m.push(out, m.at(dest, index))
        index += 1
    }
    var doMapDevChars = if toASCII { (options & NONTRANSITIONAL_TO_ASCII) == 0 } else { (options & NONTRANSITIONAL_TO_UNICODE) == 0 }
    var labelLimit = labelStart
    while labelLimit < dest.*.length {
        const c = m.at(dest, labelLimit)
        if c == 46 && !isLabel {
            var label = slice(dest, labelStart, labelLimit)
            processLabel(&label, options, toASCII, info, out)
            m.dispose(&label)
            m.push(out, 46)
            info.*.errors |= info.*.labelErrors
            info.*.labelErrors = 0
            labelLimit += 1
            labelStart = labelLimit
            continue
        } else if c < 223 {
            // nothing
        } else if c <= 8205 && (c == 223 || c == 962 || c >= 8204) {
            info.*.isTransDiff = true
            if doMapDevChars {
                mapDevChars(dest, labelStart, labelLimit)
                doMapDevChars = false
                continue
            }
        } else if isSurrogate(c) {
            const unpaired = if isLead(c) { labelLimit + 1 == dest.*.length || !isTrail(m.at(dest, labelLimit + 1)) } else { labelLimit == labelStart || !isLead(m.at(dest, labelLimit - 1)) }
            if unpaired {
                info.*.labelErrors |= ERROR_DISALLOWED
                m.setAt(dest, labelLimit, 65533)
            }
        }
        labelLimit += 1
    }
    if labelStart == 0 || labelStart < labelLimit {
        var label = slice(dest, labelStart, labelLimit)
        processLabel(&label, options, toASCII, info, out)
        m.dispose(&label)
        info.*.errors |= info.*.labelErrors
    }
}

fn isASCIIUnits(b: *m.Buffer) -> bool {
    var index: usize = 0
    while index < b.*.length {
        if m.at(b, index) > 127 { return false }
        index += 1
    }
    return true
}

// ---------------------------------------------------------------------------
// The C API. A UIDNA is its options (one word of C memory).

pub fn uidna_openUTS46(options: u32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    const idna = m.alloc(8)
    if idna == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    m.put32(idna, options)
    return idna
}

pub fn uidna_close(idna: usize) -> void { m.release(idna) }

// UIDNAInfo: size (i16), isTransitionalDifferent, reservedB3, errors (u32
// at 4), reservedI2, reservedI3.
fn checkArgs(text: usize, length: i32, dest: usize, capacity: i32, pInfo: usize, status: usize) -> bool {
    if m.failed(status) { return false }
    if pInfo == 0 || @bitCast(i16, m.get16(pInfo)) < 16 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    if (if text == 0 { length != 0 } else { length < -1 }) || (if dest == 0 { capacity != 0 } else { capacity < 0 }) || (dest == text && text != 0) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    const size = @intCast(usize, m.get16(pInfo))
    m.zero(pInfo + 2, size - 2)
    return true
}

fn run(idna: usize, text: usize, length: i32, dest: usize, capacity: i32, pInfo: usize, status: usize, isLabel: bool, toASCII: bool) -> i32 {
    if !checkArgs(text, length, dest, capacity, pInfo, status) { return 0 }
    var src = m.buffer()
    const count = if text == 0 { 0 } else { m.units(text, length) }
    var index: usize = 0
    while index < count {
        m.push(&src, @intCast(u32, m.get16(text + index * 2)))
        index += 1
    }
    var out = m.buffer()
    var info = Info.{ .errors = 0, .labelErrors = 0, .isTransDiff = false, .isBiDi = false, .isOkBiDi = true }
    process(&src, m.get32(idna), isLabel, toASCII, &out, &info)
    if toASCII && !isLabel && out.length >= 254 && (info.errors & ERROR_DOMAIN_NAME_TOO_LONG) == 0 && isASCIIUnits(&out) && (out.length > 254 || m.at(&out, 253) != 46) {
        info.errors |= ERROR_DOMAIN_NAME_TOO_LONG
    }
    m.put8(pInfo + 2, if info.isTransDiff { 1 } else { 0 })
    m.put32(pInfo + 4, info.errors)
    const room = if capacity > 0 { @intCast(usize, capacity) } else { 0 }
    index = 0
    while index < out.length && index < room {
        m.put16(dest + index * 2, @intCast(u16, m.at(&out, index)))
        index += 1
    }
    const written = m.terminate(dest, out.length, capacity, status)
    m.dispose(&src)
    m.dispose(&out)
    return written
}

pub fn uidna_labelToASCII(idna: usize, label: usize, length: i32, dest: usize, capacity: i32, pInfo: usize, status: usize) -> i32 { return run(idna, label, length, dest, capacity, pInfo, status, true, true) }
pub fn uidna_labelToUnicode(idna: usize, label: usize, length: i32, dest: usize, capacity: i32, pInfo: usize, status: usize) -> i32 { return run(idna, label, length, dest, capacity, pInfo, status, true, false) }
pub fn uidna_nameToASCII(idna: usize, name: usize, length: i32, dest: usize, capacity: i32, pInfo: usize, status: usize) -> i32 { return run(idna, name, length, dest, capacity, pInfo, status, false, true) }
pub fn uidna_nameToUnicode(idna: usize, name: usize, length: i32, dest: usize, capacity: i32, pInfo: usize, status: usize) -> i32 { return run(idna, name, length, dest, capacity, pInfo, status, false, false) }

// The UTF-8 forms: the name as UTF-16, processed, back to UTF-8.
fn runUTF8(idna: usize, text: usize, length: i32, dest: usize, capacity: i32, pInfo: usize, status: usize, toASCII: bool) -> i32 {
    if !checkArgs(text, length, dest, capacity, pInfo, status) { return 0 }
    const count = if text == 0 { 0 } else if length < 0 { m.cLength(text) } else { @intCast(usize, length) }
    var codes = m.buffer()
    var index: usize = 0
    while index < count {
        const b0 = @intCast(u32, m.get8(text + index))
        var c: u32 = 65533
        var used: usize = 1
        if b0 < 128 {
            c = b0
        } else if b0 >= 194 && b0 <= 223 && index + 1 < count && (m.get8(text + index + 1) & 192) == 128 {
            c = ((b0 & 31) << 6) | (@intCast(u32, m.get8(text + index + 1)) & 63)
            used = 2
        } else if b0 >= 224 && b0 <= 239 && index + 2 < count && (m.get8(text + index + 1) & 192) == 128 && (m.get8(text + index + 2) & 192) == 128 {
            c = ((b0 & 15) << 12) | ((@intCast(u32, m.get8(text + index + 1)) & 63) << 6) | (@intCast(u32, m.get8(text + index + 2)) & 63)
            if c < 2048 || (c >= 55296 && c <= 57343) { c = 65533 } else { used = 3 }
        } else if b0 >= 240 && b0 <= 244 && index + 3 < count && (m.get8(text + index + 1) & 192) == 128 && (m.get8(text + index + 2) & 192) == 128 && (m.get8(text + index + 3) & 192) == 128 {
            c = ((b0 & 7) << 18) | ((@intCast(u32, m.get8(text + index + 1)) & 63) << 12) | ((@intCast(u32, m.get8(text + index + 2)) & 63) << 6) | (@intCast(u32, m.get8(text + index + 3)) & 63)
            if c < 65536 || c > 1114111 { c = 65533 } else { used = 4 }
        }
        pushCode(&codes, c)
        index += used
    }
    var out = m.buffer()
    var info = Info.{ .errors = 0, .labelErrors = 0, .isTransDiff = false, .isBiDi = false, .isOkBiDi = true }
    process(&codes, m.get32(idna), false, toASCII, &out, &info)
    if toASCII && out.length >= 254 && (info.errors & ERROR_DOMAIN_NAME_TOO_LONG) == 0 && isASCIIUnits(&out) && (out.length > 254 || m.at(&out, 253) != 46) {
        info.errors |= ERROR_DOMAIN_NAME_TOO_LONG
    }
    m.put8(pInfo + 2, if info.isTransDiff { 1 } else { 0 })
    m.put32(pInfo + 4, info.errors)
    var bytes = m.bytesBuffer()
    index = 0
    while index < out.length {
        var used: usize = 1
        const c = @intCast(u32, codeAt(&out, index, out.length, &used))
        index += used
        if c < 128 {
            m.pushByte(&bytes, @intCast(u8, c))
        } else if c < 2048 {
            m.pushByte(&bytes, @intCast(u8, 192 | (c >> 6)))
            m.pushByte(&bytes, @intCast(u8, 128 | (c & 63)))
        } else if c < 65536 {
            m.pushByte(&bytes, @intCast(u8, 224 | (c >> 12)))
            m.pushByte(&bytes, @intCast(u8, 128 | ((c >> 6) & 63)))
            m.pushByte(&bytes, @intCast(u8, 128 | (c & 63)))
        } else {
            m.pushByte(&bytes, @intCast(u8, 240 | (c >> 18)))
            m.pushByte(&bytes, @intCast(u8, 128 | ((c >> 12) & 63)))
            m.pushByte(&bytes, @intCast(u8, 128 | ((c >> 6) & 63)))
            m.pushByte(&bytes, @intCast(u8, 128 | (c & 63)))
        }
    }
    const written = m.give(m.bytesText(&bytes), dest, capacity, status)
    m.disposeBytes(&bytes)
    m.dispose(&codes)
    m.dispose(&out)
    return written
}

pub fn uidna_nameToASCII_UTF8(idna: usize, name: usize, length: i32, dest: usize, capacity: i32, pInfo: usize, status: usize) -> i32 { return runUTF8(idna, name, length, dest, capacity, pInfo, status, true) }
pub fn uidna_nameToUnicodeUTF8(idna: usize, name: usize, length: i32, dest: usize, capacity: i32, pInfo: usize, status: usize) -> i32 { return runUTF8(idna, name, length, dest, capacity, pInfo, status, false) }

// ---------------------------------------------------------------------------
// The native API (std.unicode: UTF-8 text, results from the allocator
// given, failures as unicode.Error).

// UTS #46 as browsers use it: nontransitional, the bidi and CONTEXTJ
// rules checked (UIDNA_CHECK_BIDI | UIDNA_CHECK_CONTEXTJ |
// UIDNA_NONTRANSITIONAL_TO_ASCII | UIDNA_NONTRANSITIONAL_TO_UNICODE).
const NATIVE_OPTIONS: u32 = 60

fn convert(allocator: utf.Allocator, name: []const u8, toASCII: bool) -> unicode.Error![]u8 {
    var status: i32 = 0
    const idna = uidna_openUTS46(NATIVE_OPTIONS, @intFromPtr(&status))
    try unicode.check(status)
    defer uidna_close(idna)
    var info: [4]u32 = [4]u32{ 16, 0, 0, 0 }
    var capacity = name.length * 4 + 64
    while true {
        const memory = allocator.alloc(capacity, 1)
        if memory == null { return unicode.Error.OutOfMemory }
        const into = memory.?
        status = 0
        const length = if toASCII { uidna_nameToASCII_UTF8(idna, @intFromPtr(name.pointer), @intCast(i32, name.length), @intFromPtr(into), @intCast(i32, capacity), @intFromPtr(&info), @intFromPtr(&status)) } else { uidna_nameToUnicodeUTF8(idna, @intFromPtr(name.pointer), @intCast(i32, name.length), @intFromPtr(into), @intCast(i32, capacity), @intFromPtr(&info), @intFromPtr(&status)) }
        if status == unicode.BUFFER_OVERFLOW_ERROR && length > 0 {
            allocator.free(into, capacity, 1)
            capacity = @intCast(usize, length) + 1
            continue
        }
        if status > 0 || info[1] != 0 {
            allocator.free(into, capacity, 1)
            if status > 0 { try unicode.check(status) }
            return unicode.Error.InvalidText
        }
        // The caller frees what it gets by its length: keep only that.
        const result = try utf.copy(allocator, into[0..@intCast(usize, length)])
        allocator.free(into, capacity, 1)
        return result
    }
    return unicode.Error.Failed
}

// A domain name as ASCII ("bücher.de" is "xn--bcher-kva.de");
// InvalidText when it breaks UTS #46's rules.
pub fn toAscii(allocator: utf.Allocator, name: []const u8) -> unicode.Error![]u8 { return convert(allocator, name, true) }

// A domain name as Unicode ("xn--bcher-kva.de" is "bücher.de").
pub fn toUnicode(allocator: utf.Allocator, name: []const u8) -> unicode.Error![]u8 { return convert(allocator, name, false) }
