// Relative dates and times (ureldatefmt.h): ICU 74's
// RelativeDateTimeFormatter over CLDR's date fields. Numeric: the number
// formatted by the format given (a decimal format of the locale when
// none: decimalformat.mlx), its plural form by the locale's rules on the
// number as formatted, and the pattern of the unit, direction and form
// (dates/fields/UNIT[-short|-narrow]/relativeTime-type-future|past/
// relativeTimePattern-count-FORM; a style without one falls back as
// CLDR's aliases do, narrow to short to long, a form to "other") around
// it; with the number's fields, the numeric field over them and the
// literal field over the rest (UFIELD_CATEGORY_RELATIVE_DATETIME). With
// words (ureldatefmt_format): for offsets -2, -1, 0, 1 and 2 (within 1%)
// the unit's own phrase when CLDR has it (dates/fields/UNIT/relative-
// type-N: "yesterday", "next week"; "now" for 0 seconds), else the number.
// Dates and times are joined by the locale's pattern (dates/calendars/
// gregorian/dateTimeFormats-atTime/standard/medium, else
// dateTimeFormats/medium). The capitalization for the beginning of a
// sentence titlecases the first letter of strings (not of results, as
// ICU does not).
const m = @import("std.unicode.memory")
const resources = @import("std.unicode.locale.resources")
const formatted = @import("std.unicode.format")
const properties = @import("std.unicode.properties")
const casing = @import("std.unicode.casing")
const locale = @import("std.unicode.locale.defaults")
const plurals = @import("std.unicode.format.plural.rules")
const nd = @import("std.unicode.format.number.data")
const nq = @import("std.unicode.format.number.quantity")
const nb = @import("std.unicode.format.number.builder")
const nf = @import("std.unicode.format.number")
const pluralrules = @import("std.unicode.format.plural")
const decimalformat = @import("std.unicode.format.number.decimalformat")

// "URDT" and ICU's "FRDT" for the results.
const MAGIC: u32 = 1431454804
const RESULT_KIND: u32 = 1179796564

const INVALID_FORMAT_ERROR: i32 = 3

// UDateRelativeDateTimeFormatterStyle.
const STYLE_LONG: i32 = 0
const STYLE_SHORT: i32 = 1
const STYLE_NARROW: i32 = 2
const STYLE_COUNT: i32 = 3

// URelativeDateTimeUnit.
const UNIT_SECOND: i32 = 7
const UNIT_COUNT: i32 = 15
const UNIT_NAMES = [15][]const u8{ "year", "quarter", "month", "week", "day", "hour", "minute", "second", "sun", "mon", "tue", "wed", "thu", "fri", "sat" }

// UDisplayContext.
const CAPITALIZATION_FOR_BEGINNING_OF_SENTENCE: i32 = 258
const TYPE_CAPITALIZATION: i32 = 1

// The fields of a result: the literal field and the numeric field of
// the relative date-time category.
const LITERAL_FIELD: u8 = (nb.CATEGORY_RELATIVE << 4) | 0
const NUMERIC_FIELD: u8 = (nb.CATEGORY_RELATIVE << 4) | 1

const Formatter = struct {
    magic: u32
    numberFormat: usize
    style: i32
    context: i32
    titlecase: bool
    data: u32
    localeId: [160]u8
    localeLength: usize
    rules: [64]u8
    rulesLength: usize
}

fn formatterAt(address: usize) -> *Formatter { unsafe { return @ptrFromInt(*Formatter, address) } }

fn isFormatter(address: usize) -> bool { return address != 0 && m.get32(address) == MAGIC }

fn localeText(r: *const Formatter) -> []const u8 { return r.*.localeId[0..r.*.localeLength] }

fn styleSuffix(style: i32) -> []const u8 { return if style == STYLE_NARROW { "-narrow" } else if style == STYLE_SHORT { "-short" } else { "" } }

// The style a style falls back to (CLDR's aliases), -1 for none.
fn fallbackStyle(style: i32) -> i32 { return if style == STYLE_NARROW { STYLE_SHORT } else if style == STYLE_SHORT { STYLE_LONG } else { -1 } }

// The relative time pattern of UNIT, direction and plural form PLURAL,
// with the styles' fallback, then "other"'s ("" for none).
fn relativePattern(r: *const Formatter, unit: i32, future: bool, plural: usize) -> []const u8 {
    var form = plural
    while true {
        var style = r.*.style
        while style != -1 {
            var k = nd.key("dates/fields/")
            nd.add(&k, UNIT_NAMES[@intCast(usize, unit)])
            nd.add(&k, styleSuffix(style))
            nd.add(&k, if future { "/relativeTime-type-future/relativeTimePattern-count-" } else { "/relativeTime-type-past/relativeTimePattern-count-" })
            nd.add(&k, nf.PLURAL_NAMES[form])
            var value: []const u8 = ""
            if nd.lookup(r.*.data, &k, &value) && value.length > 0 { return value }
            style = fallbackStyle(style)
        }
        if form == nf.PLURAL_OTHER { break }
        form = nf.PLURAL_OTHER
    }
    return ""
}

// The phrase of UNIT for OFFSET (-2..2) with the styles' fallback ("" for
// none).
fn absolutePhrase(r: *const Formatter, unit: i32, offset: i32) -> []const u8 {
    var style = r.*.style
    while style != -1 {
        var k = nd.key("dates/fields/")
        nd.add(&k, UNIT_NAMES[@intCast(usize, unit)])
        nd.add(&k, styleSuffix(style))
        nd.add(&k, "/relative-type-")
        if offset < 0 {
            nd.addByte(&k, 45)
            nd.addByte(&k, 48 + @intCast(u8, -offset))
        } else {
            nd.addByte(&k, 48 + @intCast(u8, offset))
        }
        var value: []const u8 = ""
        if nd.lookup(r.*.data, &k, &value) && value.length > 0 { return value }
        style = fallbackStyle(style)
    }
    return ""
}

// ---------------------------------------------------------------------------
// Simple patterns ("in {0} days", "{1}, {0}") as ICU's SimpleFormatter
// reads them: an apostrophe quotes only before a brace or another
// apostrophe.

// PATTERN with the arguments' values (VALUES, VALUE_COUNT of them, UTF-8)
// into OUT, its literal text before the first argument into PREFIX and
// after it into SUFFIX; whether it has an argument.
fn simpleParts(pattern: []const u8, out: *m.Bytes, values: *const [2][]const u8, valueCount: usize, prefix: *m.Bytes, suffix: *m.Bytes) -> bool {
    var inQuote = false
    var seenArgument = false
    var at: usize = 0
    while at < pattern.length {
        var c = pattern[at]
        at += 1
        if c == 39 {
            if at < pattern.length && pattern[at] == 39 {
                at += 1
            } else if inQuote {
                inQuote = false
                continue
            } else if at < pattern.length && (pattern[at] == 123 || pattern[at] == 125) {
                c = pattern[at]
                at += 1
                inQuote = true
            }
        } else if !inQuote && c == 123 {
            // A one-digit argument.
            if at + 1 < pattern.length && pattern[at] >= 48 && pattern[at] <= 57 && pattern[at + 1] == 125 {
                const argument = @intCast(usize, pattern[at] - 48)
                at += 2
                if argument < valueCount { m.pushText(out, values.*[argument]) }
                seenArgument = true
                continue
            }
        }
        m.pushByte(out, c)
        m.pushByte(if seenArgument { suffix } else { prefix }, c)
    }
    return seenArgument
}

// ---------------------------------------------------------------------------
// Formatting.

// OFFSET in UNIT as a number with the pattern around it into B (ICU's
// formatNumericImpl); the status.
fn formatNumericInto(r: *const Formatter, offset: f64, unit: i32, b: *nb.Builder) -> i32 {
    if unit < 0 || unit >= UNIT_COUNT { return m.ILLEGAL_ARGUMENT_ERROR }
    // The direction of the sign bit (-0 is past).
    const bits = @bitCast(u64, offset)
    const future = (bits >> 63) == 0
    const value = @bitCast(f64, bits & 9223372036854775807)
    const qAddress = nq.create()
    const q = nq.at(qAddress)
    nq.setDouble(q, value)
    var status: i32 = 0
    const df = decimalformat.formatAt(r.*.numberFormat)
    nf.format(decimalformat.formatterOf(df), q, b, &status)
    if status > 0 {
        nq.destroy(qAddress)
        return status
    }
    const keyword = pluralrules.selectQuantity(r.*.rules[0..r.*.rulesLength], plurals.CARDINAL, q)
    nq.destroy(qAddress)
    const pattern = relativePattern(r, unit, future, nf.pluralIndex(keyword))
    if pattern.length == 0 { return INVALID_FORMAT_ERROR }
    // The pattern's text before and after the number (SimpleModifier).
    var whole = m.bytesBuffer()
    var prefix = m.bytesBuffer()
    var suffix = m.bytesBuffer()
    var none: [2][]const u8 = undefined
    const hasArgument = simpleParts(pattern, &whole, &none, 0, &prefix, &suffix)
    if !hasArgument {
        // No number in the pattern: its text takes the number's place.
        _ = nb.remove(b, 0, b.*.length)
        _ = nb.insertText(b, 0, m.bytesText(&whole), LITERAL_FIELD)
    } else {
        _ = nb.insertText(b, 0, m.bytesText(&prefix), LITERAL_FIELD)
        _ = nb.appendText(b, m.bytesText(&suffix), LITERAL_FIELD)
    }
    m.disposeBytes(&whole)
    m.disposeBytes(&prefix)
    m.disposeBytes(&suffix)
    return 0
}

// The phrase for OFFSET in UNIT when there is one, else the number
// (ICU's formatRelativeImpl).
fn formatInto(r: *const Formatter, offset: f64, unit: i32, b: *nb.Builder) -> i32 {
    var direction: i32 = 9
    if offset > -2.1 && offset < 2.1 {
        // A 1% epsilon: -1.01..-0.99 is "last".
        const hundredths = offset * 100.0
        const rounded = if hundredths < 0.0 { @intFromFloat(i32, hundredths - 0.5) } else { @intFromFloat(i32, hundredths + 0.5) }
        if rounded == -200 {
            direction = -2
        } else if rounded == -100 {
            direction = -1
        } else if rounded == 0 {
            direction = 0
        } else if rounded == 100 {
            direction = 1
        } else if rounded == 200 {
            direction = 2
        }
    }
    if direction != 9 && unit >= 0 && unit < UNIT_COUNT {
        // Seconds have only "now", for 0.
        if unit != UNIT_SECOND || direction == 0 {
            const phrase = absolutePhrase(r, unit, direction)
            if phrase.length > 0 {
                _ = nb.appendText(b, phrase, LITERAL_FIELD)
                return 0
            }
        }
    }
    return formatNumericInto(r, offset, unit, b)
}

// A string result with the capitalization for the beginning of a sentence.
fn give(r: *const Formatter, b: *nb.Builder, result: usize, resultCapacity: i32, status: usize) -> i32 {
    if r.*.titlecase && b.*.length > 0 {
        var at: usize = 0
        const first = nd.decode16(b.*.units, b.*.length, &at)
        if properties.category(@intCast(i32, first)) == 2 {
            var text = m.buffer()
            m.push(&text, first)
            if at < b.*.length {
                var next = at
                m.push(&text, nd.decode16(b.*.units, b.*.length, &next))
            }
            var out = m.buffer()
            const lang = casing.language(@intFromPtr(&r.*.localeId))
            casing.upperAt(&out, &text, 0, lang, true)
            var removed = at
            // Dutch titlecases "ij" together.
            if lang == casing.DUTCH && first == 105 && text.length > 1 && m.at(&text, 1) == 106 {
                m.push(&out, 74)
                removed += 1
            }
            var titled = m.bytesBuffer()
            var index: usize = 0
            while index < out.length {
                nd.appendUtf8(&titled, m.at(&out, index))
                index += 1
            }
            const field = nb.fieldAt(b, 0)
            _ = nb.remove(b, 0, removed)
            _ = nb.insertText(b, 0, m.bytesText(&titled), field)
            m.disposeBytes(&titled)
            m.dispose(&out)
            m.dispose(&text)
        }
    }
    return nd.give16Units(b.*.units, b.*.length, result, resultCapacity, status)
}

fn validOutput(reldatefmt: usize, result: usize, resultCapacity: i32, status: usize) -> bool {
    if m.failed(status) { return false }
    if (result == 0 && resultCapacity != 0) || (result != 0 && resultCapacity < 0) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    if !isFormatter(reldatefmt) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    return true
}

// The result of a ...ToResult call: the text and fields, or nothing and
// the error (also for the capitalization of sentences, which results do
// not take).
fn toResult(reldatefmt: usize, offset: f64, unit: i32, numeric: bool, result: usize, status: usize) -> void {
    if m.failed(status) { return }
    if result == 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    if !formatted.isKind(result, RESULT_KIND) {
        m.setError(status, INVALID_FORMAT_ERROR)
        return
    }
    formatted.clear(result)
    if !isFormatter(reldatefmt) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    const r = formatterAt(reldatefmt)
    if r.*.titlecase {
        m.setError(status, m.UNSUPPORTED_ERROR)
        return
    }
    var b = nb.builder()
    const failure = if numeric { formatNumericInto(r, offset, unit, &b) } else { formatInto(r, offset, unit, &b) }
    if failure > 0 {
        m.setError(status, failure)
    } else {
        var none: [1]nb.SpanInfo = undefined
        nb.toValue(&b, result, NUMERIC_FIELD, &none, 0)
    }
    nb.dispose(&b)
}

// ---------------------------------------------------------------------------
// The C API.

pub fn ureldatefmt_open(localeId: usize, nfToAdopt: usize, width: i32, capitalizationContext: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if width < 0 || width >= STYLE_COUNT {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    if (capitalizationContext >> 8) != TYPE_CAPITALIZATION {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    if !resources.available() {
        if nfToAdopt != 0 { decimalformat.close(nfToAdopt) }
        m.setError(status, m.MISSING_RESOURCE_ERROR)
        return 0
    }
    var numberFormat = nfToAdopt
    if numberFormat != 0 && !decimalformat.isFormat(numberFormat) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    if numberFormat == 0 {
        numberFormat = decimalformat.openDecimal(localeId, status)
        if numberFormat == 0 { return 0 }
    }
    const address = m.alloc(@sizeOf(Formatter))
    if address == 0 {
        decimalformat.close(numberFormat)
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    const r = formatterAt(address)
    r.*.magic = MAGIC
    r.*.numberFormat = numberFormat
    r.*.style = width
    r.*.context = capitalizationContext
    r.*.titlecase = capitalizationContext == CAPITALIZATION_FOR_BEGINNING_OF_SENTENCE
    const id = if localeId == 0 { locale.defaultLocale() } else { m.cSlice(localeId) }
    var length: usize = 0
    while length < id.length && length < 159 {
        r.*.localeId[length] = id[length]
        length += 1
    }
    r.*.localeId[length] = 0
    r.*.localeLength = length
    r.*.data = resources.find(localeText(r))
    var name: [64]u8 = undefined
    r.*.rulesLength = plurals.rulesLocale(localeText(r), plurals.CARDINAL, &name)
    var index: usize = 0
    while index < r.*.rulesLength {
        r.*.rules[index] = name[index]
        index += 1
    }
    return address
}

pub fn ureldatefmt_close(reldatefmt: usize) -> void {
    if !isFormatter(reldatefmt) { return }
    const r = formatterAt(reldatefmt)
    decimalformat.close(r.*.numberFormat)
    r.*.magic = 0
    m.release(reldatefmt)
}

pub fn ureldatefmt_openResult(ec: usize) -> usize {
    if m.failed(ec) { return 0 }
    const value = formatted.create(RESULT_KIND, 0)
    if value == 0 { m.setError(ec, m.MEMORY_ALLOCATION_ERROR) }
    return value
}

pub fn ureldatefmt_resultAsValue(ufrdt: usize, ec: usize) -> usize {
    if m.failed(ec) { return 0 }
    if ufrdt == 0 {
        m.setError(ec, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    if !formatted.isKind(ufrdt, RESULT_KIND) {
        m.setError(ec, INVALID_FORMAT_ERROR)
        return 0
    }
    return ufrdt
}

pub fn ureldatefmt_closeResult(ufrdt: usize) -> void {
    if !formatted.isKind(ufrdt, RESULT_KIND) { return }
    formatted.destroy(ufrdt)
}

pub fn ureldatefmt_formatNumeric(reldatefmt: usize, offset: f64, unit: i32, result: usize, resultCapacity: i32, status: usize) -> i32 {
    if !validOutput(reldatefmt, result, resultCapacity, status) { return 0 }
    var b = nb.builder()
    const r = formatterAt(reldatefmt)
    const failure = formatNumericInto(r, offset, unit, &b)
    var length: i32 = 0
    if failure > 0 {
        m.setError(status, failure)
    } else {
        length = give(r, &b, result, resultCapacity, status)
    }
    nb.dispose(&b)
    return length
}

pub fn ureldatefmt_formatNumericToResult(reldatefmt: usize, offset: f64, unit: i32, result: usize, status: usize) -> void {
    toResult(reldatefmt, offset, unit, true, result, status)
}

pub fn ureldatefmt_format(reldatefmt: usize, offset: f64, unit: i32, result: usize, resultCapacity: i32, status: usize) -> i32 {
    if !validOutput(reldatefmt, result, resultCapacity, status) { return 0 }
    var b = nb.builder()
    const r = formatterAt(reldatefmt)
    const failure = formatInto(r, offset, unit, &b)
    var length: i32 = 0
    if failure > 0 {
        m.setError(status, failure)
    } else {
        length = give(r, &b, result, resultCapacity, status)
    }
    nb.dispose(&b)
    return length
}

pub fn ureldatefmt_formatToResult(reldatefmt: usize, offset: f64, unit: i32, result: usize, status: usize) -> void {
    toResult(reldatefmt, offset, unit, false, result, status)
}

// The relative date and the time joined by the locale's pattern
// ({1} the date, {0} the time).
pub fn ureldatefmt_combineDateAndTime(reldatefmt: usize, relativeDateString: usize, relativeDateStringLen: i32, timeString: usize, timeStringLen: i32, result: usize, resultCapacity: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    if (result == 0 && resultCapacity != 0) || (result != 0 && resultCapacity < 0) || (relativeDateString == 0 && relativeDateStringLen != 0) || (relativeDateString != 0 && relativeDateStringLen < -1) || (timeString == 0 && timeStringLen != 0) || (timeString != 0 && timeStringLen < -1) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    if !isFormatter(reldatefmt) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const r = formatterAt(reldatefmt)
    var k = nd.key("dates/calendars/gregorian/dateTimeFormats-atTime/standard/medium")
    var pattern: []const u8 = ""
    if !nd.lookup(r.*.data, &k, &pattern) || pattern.length == 0 {
        k = nd.key("dates/calendars/gregorian/dateTimeFormats/medium")
        if !nd.lookup(r.*.data, &k, &pattern) || pattern.length == 0 { pattern = "{1} {0}" }
    }
    var date = m.bytesBuffer()
    var time = m.bytesBuffer()
    if relativeDateString != 0 { nd.toUtf8(relativeDateString, m.units(relativeDateString, relativeDateStringLen), &date) }
    if timeString != 0 { nd.toUtf8(timeString, m.units(timeString, timeStringLen), &time) }
    var values: [2][]const u8 = undefined
    values[0] = m.bytesText(&time)
    values[1] = m.bytesText(&date)
    var out = m.bytesBuffer()
    var prefix = m.bytesBuffer()
    var suffix = m.bytesBuffer()
    _ = simpleParts(pattern, &out, &values, 2, &prefix, &suffix)
    const length = nd.give16(m.bytesText(&out), result, resultCapacity, status)
    m.disposeBytes(&out)
    m.disposeBytes(&prefix)
    m.disposeBytes(&suffix)
    m.disposeBytes(&date)
    m.disposeBytes(&time)
    return length
}
