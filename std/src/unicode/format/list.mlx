// ulistformatter.h: lists in a locale ("a, b, and c"), from CLDR's list
// patterns (cldr.dat: listPatterns/listPattern-type-STYLE/2, start,
// middle, end; STYLE standard, or or unit, -short or -narrow after it),
// put together as ICU's ListFormatter does: two elements by the "2"
// pattern; more by "start" for the first two, "middle" for each next
// one, "end" for the last. ICU's cases of its own: Spanish "y" before an
// element that starts with an /i/ sound is "e", "o" before /o/ is "u";
// Hebrew "ו" before an element that does not start with a Hebrew letter
// is "ו-".
//
// The result (UFormattedList) is a formatted value (format.mlx) with
// the fields ICU gives: each element a ULISTFMT_ELEMENT_FIELD and a
// UFIELD_CATEGORY_LIST_SPAN span whose field is its index, the text
// between them ULISTFMT_LITERAL_FIELD.
//
// locale/displaynames.mlx (uldnames.h) is imported from here.
const m = @import("std.unicode.memory")
const formatted = @import("std.unicode.format")
const resources = @import("std.unicode.locale.resources")
const p = @import("std.unicode.properties")
const displaynames = @import("std.unicode.locale.displaynames")
const locale = @import("std.unicode.locale.defaults")
const unicode = @import("std.unicode")
const utf = @import("std.unicode.utf")

// "LSTF", and "FLST" for the results (ICU's own magic of them).
const MAGIC: u32 = 1280528454
const RESULT_KIND: u32 = 1179407188

const CATEGORY_LIST: i32 = 3
const CATEGORY_LIST_SPAN: i32 = 4099
const LITERAL_FIELD: i32 = 0
const ELEMENT_FIELD: i32 = 1

const INVALID_FORMAT_ERROR: i32 = 3

// The patterns of a formatter.
const TWO: usize = 0
const START: usize = 1
const MIDDLE: usize = 2
const END: usize = 3
// The "2" and "end" patterns of ICU's special cases (for an element
// that passes the test).
const THEN_TWO: usize = 4
const THEN_END: usize = 5

// The tests of the special cases.
const NO_TEST: u32 = 0
const SPANISH_E: u32 = 1
const SPANISH_U: u32 = 2
const HEBREW_VAV: u32 = 3

// A pattern as its texts around {0} and {1} (UTF-8 C strings), and
// whether {1} comes first.
const Split = struct {
    reversed: bool
    parts: [3]usize
    lengths: [3]usize
}

const Formatter = struct {
    magic: u32
    check: u32
    patterns: [6]Split
}

fn formatter(address: usize) -> *Formatter { unsafe { return @ptrFromInt(*Formatter, address) } }

fn isFormatter(address: usize) -> bool { return address != 0 && m.get32(address) == MAGIC }

// The style of ICU's typeWidthToStyleString, "" when there is none.
fn style(kind: i32, width: i32) -> []const u8 {
    if width < 0 || width > 2 { return "" }
    if kind == 0 { return if width == 0 { "standard" } else if width == 1 { "standard-short" } else { "standard-narrow" } }
    if kind == 1 { return if width == 0 { "or" } else if width == 1 { "or-short" } else { "or-narrow" } }
    if kind == 2 { return if width == 0 { "unit" } else if width == 1 { "unit-short" } else { "unit-narrow" } }
    return ""
}

fn pattern(data: u32, styleName: []const u8, which: []const u8, value: *[]const u8) -> bool {
    var key = m.bytesBuffer()
    m.pushText(&key, "listPatterns/listPattern-type-")
    m.pushText(&key, styleName)
    m.pushByte(&key, 47)
    m.pushText(&key, which)
    const found = resources.lookup(data, m.bytesText(&key), value)
    m.disposeBytes(&key)
    return found && value.*.length > 0
}

fn copyC(text: []const u8) -> usize {
    const at = m.alloc(text.length + 1)
    if at != 0 && text.length > 0 { m.copy(at, @intFromPtr(text.pointer), text.length) }
    return at
}

fn compile(f: *Formatter, index: usize, text: []const u8) -> bool {
    var parts: [3]m.Bytes = undefined
    var k: usize = 0
    while k < 3 {
        parts[k] = m.bytesBuffer()
        k += 1
    }
    var reversed = false
    const ok = displaynames.splitPattern(text, &parts, &reversed)
    f.*.patterns[index].reversed = reversed
    k = 0
    while k < 3 {
        f.*.patterns[index].parts[k] = copyC(m.bytesText(&parts[k]))
        f.*.patterns[index].lengths[k] = parts[k].length
        m.disposeBytes(&parts[k])
        k += 1
    }
    return ok
}

fn release(address: usize) -> void {
    var f = formatter(address)
    var index: usize = 0
    while index < 6 {
        var k: usize = 0
        while k < 3 {
            m.release(f.*.patterns[index].parts[k])
            k += 1
        }
        index += 1
    }
    f.*.magic = 0
    m.release(address)
}

// The language subtag of ID, lower case.
fn languageOf(id: []const u8, into: *[12]u8) -> usize {
    var length: usize = 0
    while length < id.length && length < 12 && id[length] != 95 && id[length] != 45 && id[length] != 64 {
        const c = id[length]
        into.*[length] = if c >= 65 && c <= 90 { c + 32 } else { c }
        length += 1
    }
    return length
}

pub fn open(localeID: usize, kind: i32, width: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    const styleName = style(kind, width)
    if styleName.length == 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    if !resources.available() {
        m.setError(status, m.MISSING_RESOURCE_ERROR)
        return 0
    }
    const name = if localeID == 0 { locale.defaultLocale() } else { m.cSlice(localeID) }
    const data = displaynames.dataLocale(name)
    var two: []const u8 = ""
    var start: []const u8 = ""
    var middle: []const u8 = ""
    var end: []const u8 = ""
    if !pattern(data, styleName, "2", &two) || !pattern(data, styleName, "start", &start) || !pattern(data, styleName, "middle", &middle) || !pattern(data, styleName, "end", &end) {
        m.setError(status, m.MISSING_RESOURCE_ERROR)
        return 0
    }
    const address = m.alloc(@sizeOf(Formatter))
    if address == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    var f = formatter(address)
    f.*.magic = MAGIC
    f.*.check = NO_TEST
    // ICU's special cases, by the language of the locale asked for.
    var language: [12]u8 = undefined
    const languageLength = languageOf(name, &language)
    const lang = m.bytes(@intFromPtr(&language), languageLength)
    var thenTwo = two
    var thenEnd = end
    if m.same(lang, "es") {
        const twoIsY = m.same(two, "{0} y {1}")
        const endIsY = m.same(end, "{0} y {1}")
        const twoIsO = m.same(two, "{0} o {1}")
        const endIsO = m.same(end, "{0} o {1}")
        if twoIsY || endIsY {
            f.*.check = SPANISH_E
            if twoIsY { thenTwo = "{0} e {1}" }
            if endIsY { thenEnd = "{0} e {1}" }
        } else if twoIsO || endIsO {
            f.*.check = SPANISH_U
            if twoIsO { thenTwo = "{0} u {1}" }
            if endIsO { thenEnd = "{0} u {1}" }
        }
    } else if m.same(lang, "he") || m.same(lang, "iw") {
        const vav = "{0} \u{05D5}{1}"
        const twoIsVav = m.same(two, vav)
        const endIsVav = m.same(end, vav)
        if twoIsVav || endIsVav {
            f.*.check = HEBREW_VAV
            if twoIsVav { thenTwo = "{0} \u{05D5}-{1}" }
            if endIsVav { thenEnd = "{0} \u{05D5}-{1}" }
        }
    }
    var ok = compile(f, TWO, two)
    ok = compile(f, START, start) && ok
    ok = compile(f, MIDDLE, middle) && ok
    ok = compile(f, END, end) && ok
    ok = compile(f, THEN_TWO, thenTwo) && ok
    ok = compile(f, THEN_END, thenEnd) && ok
    if !ok {
        release(address)
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    return address
}

// ---------------------------------------------------------------------------
// The tests of the special cases, on the last element (UTF-16).

fn unitAt(text: usize, length: usize, index: usize) -> u16 { return if index < length { m.get16(text + index * 2) } else { 0 } }

// "i", "hi" (not "hia", "hie"), any case.
fn changesToE(text: usize, length: usize) -> bool {
    if length == 0 { return false }
    const c0 = unitAt(text, length, 0)
    const c1 = unitAt(text, length, 1)
    const c2 = unitAt(text, length, 2)
    if (c0 == 104 || c0 == 72) && length > 1 && (c1 == 105 || c1 == 73) && (length == 2 || !(c2 == 97 || c2 == 65 || c2 == 101 || c2 == 69)) { return true }
    return c0 == 105 || c0 == 73
}

// "o", "ho", "8", and "11" alone or before a space.
fn changesToU(text: usize, length: usize) -> bool {
    if length == 0 { return false }
    const c0 = unitAt(text, length, 0)
    const c1 = unitAt(text, length, 1)
    if c0 == 111 || c0 == 79 || c0 == 56 { return true }
    if (c0 == 104 || c0 == 72) && length > 1 && (c1 == 111 || c1 == 79) { return true }
    return length >= 2 && c0 == 49 && c1 == 49 && (length == 2 || unitAt(text, length, 2) == 32)
}

// Whether the first code point is not of the Hebrew script.
fn changesToVavDash(text: usize, length: usize) -> bool {
    if length == 0 { return false }
    var c = @intCast(u32, unitAt(text, length, 0))
    const trail = @intCast(u32, unitAt(text, length, 1))
    if c >= 55296 && c <= 56319 && trail >= 56320 && trail <= 57343 { c = (c << 10) + trail - 56613888 }
    return p.script(@intCast(i32, c)) != p.SCRIPT_HEBREW
}

fn passes(f: *Formatter, text: usize, length: usize) -> bool {
    if f.*.check == SPANISH_E { return changesToE(text, length) }
    if f.*.check == SPANISH_U { return changesToU(text, length) }
    if f.*.check == HEBREW_VAV { return changesToVavDash(text, length) }
    return false
}

// ---------------------------------------------------------------------------
// Formatting: the result as pieces (literals and elements) in order,
// built from the front (what goes before {0}) and the back.

// A piece: 0 kind (0 literal UTF-8, 1 element UTF-16), 8 address, 16
// length (bytes or units), 24 the element's index.
const PIECE: usize = 32

const Pieces = struct {
    address: usize
    count: usize
    capacity: usize
}

fn pieces() -> Pieces { return Pieces.{ .address = 0, .count = 0, .capacity = 0 } }

fn add(list: *Pieces, kind: usize, address: usize, length: usize, index: usize) -> bool {
    if list.*.count == list.*.capacity {
        const larger = if list.*.capacity == 0 { 16 } else { list.*.capacity * 2 }
        const grown = m.grow(list.*.address, larger * PIECE)
        if grown == 0 { return false }
        list.*.address = grown
        list.*.capacity = larger
    }
    const at = list.*.address + list.*.count * PIECE
    m.putWord(at, kind)
    m.putWord(at + 8, address)
    m.putWord(at + 16, length)
    m.putWord(at + 24, index)
    list.*.count += 1
    return true
}

fn literal(list: *Pieces, s: *Split, part: usize) -> bool { return add(list, 0, s.*.parts[part], s.*.lengths[part], 0) }

// PATTERN applied to what is there ({0}) and the element ({1}).
fn apply(front: *Pieces, back: *Pieces, s: *Split, element: usize, length: usize, index: usize) -> bool {
    if !s.*.reversed {
        // prefix{0}infix{1}suffix
        return literal(front, s, 0) && literal(back, s, 1) && add(back, 1, element, length, index) && literal(back, s, 2)
    }
    // prefix{1}infix{0}suffix: the front is read backwards.
    return literal(front, s, 1) && add(front, 1, element, length, index) && literal(front, s, 0) && literal(back, s, 2)
}

// The text and the fields of PIECE (literal runs as one field) into VALUE.
fn emit(value: usize, at: usize, run: *i64) -> void {
    const kind = m.getWord(at)
    const address = m.getWord(at + 8)
    const length = m.getWord(at + 16)
    if kind == 0 {
        const before = formatted.length(value)
        formatted.appendText(value, m.bytes(address, length))
        if formatted.length(value) > before && run.* < 0 { run.* = @intCast(i64, before) }
        return
    }
    if length == 0 { return }
    const start = formatted.length(value)
    if run.* >= 0 {
        formatted.addSpan(value, CATEGORY_LIST, LITERAL_FIELD, @intCast(usize, run.*), start)
        run.* = -1
    }
    formatted.appendUnits(value, address, length)
    const index = @intCast(i32, m.getWord(at + 24))
    formatted.addSpan(value, CATEGORY_LIST_SPAN, index, start, start + length)
    formatted.addSpan(value, CATEGORY_LIST, ELEMENT_FIELD, start, start + length)
}

fn stringAt(strings: usize, lengths: usize, index: usize, length: *usize) -> usize {
    const s = m.getWord(strings + index * 8)
    const given = if lengths == 0 { -1 } else { m.getI32(lengths + index * 4) }
    length.* = if s == 0 { 0 } else { m.units(s, given) }
    return s
}

// The list of COUNT strings into VALUE (cleared first).
pub fn formatInto(address: usize, strings: usize, lengths: usize, count: usize, value: usize, status: usize) -> void {
    formatted.clear(value)
    if count == 0 { return }
    var f = formatter(address)
    var front = pieces()
    var back = pieces()
    var length: usize = 0
    var ok = add(&back, 1, stringAt(strings, lengths, 0, &length), length, 0)
    if count == 2 {
        const last = stringAt(strings, lengths, 1, &length)
        const which = if passes(f, last, length) { THEN_TWO } else { TWO }
        ok = ok && apply(&front, &back, &f.*.patterns[which], last, length, 1)
    } else if count > 2 {
        var s = stringAt(strings, lengths, 1, &length)
        ok = ok && apply(&front, &back, &f.*.patterns[START], s, length, 1)
        var index: usize = 2
        while index + 1 < count {
            s = stringAt(strings, lengths, index, &length)
            ok = ok && apply(&front, &back, &f.*.patterns[MIDDLE], s, length, index)
            index += 1
        }
        s = stringAt(strings, lengths, count - 1, &length)
        const which = if passes(f, s, length) { THEN_END } else { END }
        ok = ok && apply(&front, &back, &f.*.patterns[which], s, length, count - 1)
    }
    if !ok {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
    } else {
        var run: i64 = -1
        var k = front.count
        while k > 0 {
            k -= 1
            emit(value, front.address + k * PIECE, &run)
        }
        k = 0
        while k < back.count {
            emit(value, back.address + k * PIECE, &run)
            k += 1
        }
        if run >= 0 { formatted.addSpan(value, CATEGORY_LIST, LITERAL_FIELD, @intCast(usize, run), formatted.length(value)) }
    }
    m.release(front.address)
    m.release(back.address)
}

// ICU's getUnicodeStrings checks.
fn stringsValid(strings: usize, count: i32, status: usize) -> bool {
    if count < 0 || (strings == 0 && count > 0) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    return true
}

// ---------------------------------------------------------------------------
// The C API

pub fn ulistfmt_open(locale_: usize, status: usize) -> usize { return open(locale_, 0, 0, status) }

pub fn ulistfmt_openForType(locale_: usize, kind: i32, width: i32, status: usize) -> usize { return open(locale_, kind, width, status) }

pub fn ulistfmt_close(listfmt: usize) -> void {
    if isFormatter(listfmt) { release(listfmt) }
}

pub fn ulistfmt_openResult(ec: usize) -> usize {
    if m.failed(ec) { return 0 }
    const value = formatted.create(RESULT_KIND, 0)
    if value == 0 { m.setError(ec, m.MEMORY_ALLOCATION_ERROR) }
    return value
}

fn result(uresult: usize, ec: usize) -> bool {
    if m.failed(ec) { return false }
    if uresult == 0 {
        m.setError(ec, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    if !formatted.isKind(uresult, RESULT_KIND) {
        m.setError(ec, INVALID_FORMAT_ERROR)
        return false
    }
    return true
}

pub fn ulistfmt_resultAsValue(uresult: usize, ec: usize) -> usize {
    if !result(uresult, ec) { return 0 }
    return uresult
}

pub fn ulistfmt_closeResult(uresult: usize) -> void {
    if formatted.isKind(uresult, RESULT_KIND) { formatted.destroy(uresult) }
}

pub fn ulistfmt_format(listfmt: usize, strings: usize, stringLengths: usize, stringCount: i32, dest: usize, capacity: i32, status: usize) -> i32 {
    if m.failed(status) { return -1 }
    if (dest == 0 && capacity != 0) || (dest != 0 && capacity < 0) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return -1
    }
    if !stringsValid(strings, stringCount, status) { return -1 }
    if !isFormatter(listfmt) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return -1
    }
    const value = formatted.create(0, 0)
    if value == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return -1
    }
    formatInto(listfmt, strings, stringLengths, @intCast(usize, stringCount), value, status)
    var length: i32 = -1
    if !m.failed(status) { length = formatted.extract(value, dest, capacity, status) }
    formatted.destroy(value)
    return length
}

pub fn ulistfmt_formatStringsToResult(listfmt: usize, strings: usize, stringLengths: usize, stringCount: i32, uresult: usize, status: usize) -> void {
    if !result(uresult, status) { return }
    if !stringsValid(strings, stringCount, status) { return }
    if !isFormatter(listfmt) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    formatInto(listfmt, strings, stringLengths, @intCast(usize, stringCount), uresult, status)
}

// ---------------------------------------------------------------------------
// The native API (std.unicode: UTF-8 text, results from the allocator
// given, failures as unicode.Error).

pub const ListKind = enum(i32) {
    // "a, b, and c"
    conjunction = 0,
    // "a, b, or c"
    disjunction = 1,
    // "a, b, c" (units: "3 feet, 7 inches")
    units = 2,
}

pub const ListWidth = enum(i32) {
    wide = 0,
    short = 1,
    narrow = 2,
}

const ListJob = struct {
    formatter: usize
    strings: usize
    lengths: usize
    count: i32
}

fn formatList(dest: usize, capacity: i32, context: usize, status: usize) -> i32 {
    var job: *const ListJob = undefined
    unsafe { job = @ptrFromInt(*const ListJob, context) }
    return ulistfmt_format(job.*.formatter, job.*.strings, job.*.lengths, job.*.count, dest, capacity, status)
}

// `items` (UTF-8) joined as `locale` joins a list.
pub fn joinList(allocator: utf.Allocator, locale: []const u8, items: []const []const u8, kind: ListKind, width: ListWidth) -> unicode.Error![]u8 {
    var name: [160]u8 = undefined
    const id = try unicode.cName(locale, &name)
    var status: i32 = 0
    const formatter = ulistfmt_openForType(id, @intFromEnum(kind), @intFromEnum(width), @intFromPtr(&status))
    try unicode.check(status)
    defer ulistfmt_close(formatter)
    // The items as UTF-16 one after another, the address and the length
    // of each before them.
    const count = items.length
    var total: usize = 0
    for item in items { total += utf.units16Of(item) }
    const size = count * 12 + total * 2 + 16
    const memory = allocator.alloc(size, 8)
    if memory == null { return unicode.Error.OutOfMemory }
    const base = @intFromPtr(memory.?)
    defer allocator.free(memory.?, size, 8)
    const strings = base
    const lengths = base + count * 8
    var text = lengths + count * 4
    var units: [*]u16 = undefined
    var index: usize = 0
    while index < count {
        unsafe { units = @ptrFromInt([*]u16, text) }
        const item = items[index]
        var length: usize = 0
        var at: usize = 0
        while at < item.length {
            const next = utf.decode8(item, at)
            length += utf.encode16(next.codepoint, units + length)
            at += next.length
        }
        m.putWord(strings + index * 8, text)
        m.putI32(lengths + index * 4, @intCast(i32, length))
        text += length * 2
        index += 1
    }
    var job = ListJob.{ .formatter = formatter, .strings = strings, .lengths = lengths, .count = @intCast(i32, count) }
    return unicode.produce(allocator, formatList, @intFromPtr(&job))
}
