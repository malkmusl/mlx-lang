// The locale data of the date formats (ICU's DateFormatSymbols), from
// CLDR's calendars (dates/calendars/TYPE/...): eras, months (a Hebrew
// leap year's Adar II, the thirteenth months of the Coptic and Ethiopic
// calendars), weekdays, quarters, AM/PM and the other day periods
// (format and stand-alone, each width), the Chinese calendars' leap
// month patterns and cyclic names of years and zodiac signs, the time
// separator of the numbering system, the capitalization of names by
// context (contextTransforms); and what else a format takes of its
// locale: the locale's ID in ICU's form and its keywords (calendar,
// numbers, hours, rg), the locale with data it falls back to, the
// digits of its numbering system (CLDR's numberingSystems), its rules of
// day periods (dayPeriodRuleSet, for the flexible periods of 'B').
//
// A calendar type takes what it lacks from another (CLDR's aliases in
// its root calendars, cldrdata.mlx): the Islamic kinds from the Islamic
// calendar, Amete Alem from the Ethiopic one, Dangi from the Chinese,
// all of them at last from the Gregorian.
const m = @import("std.unicode.memory")
const resources = @import("std.unicode.locale.resources")
const locale = @import("std.unicode.locale.defaults")
const text = @import("std.unicode.format.date.text")
const cal = @import("std.unicode.calendar")
const uloc = @import("std.unicode.locale")

const Text = text.Text

// ---------------------------------------------------------------------------
// Locale IDs.

pub const Id = struct {
    // The ID in ICU's form ("de_AT@calendar=japanese;hours=h23").
    name: [160]u8
    length: usize
}

// The ICU form of C's locale ID (the default locale for 0).
pub fn idOf(localeId: usize) -> Id {
    var result: Id = undefined
    result.length = 0
    var status: i32 = 0
    const source = if localeId == 0 { uloc.uloc_getDefault() } else { localeId }
    const length = uloc.uloc_getName(source, @intFromPtr(&result.name), 159, @intFromPtr(&status))
    if status <= 0 && length >= 0 && length < 159 { result.length = @intCast(usize, length) }
    result.name[result.length] = 0
    return result
}

pub fn idText(id: *const Id) -> []const u8 {
    const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &id.*.name) }
    return view[0..id.*.length]
}

// The ID without its keywords.
pub fn baseName(id: *const Id) -> []const u8 {
    const all = idText(id)
    var end: usize = 0
    while end < all.length && all[end] != 64 { end += 1 }
    return all[0..end]
}

pub fn keyword(id: *const Id, key: []const u8) -> []const u8 { return locale.keyword(idText(id), key) }

// The language of the ID ("" for root).
pub fn language(id: *const Id) -> []const u8 {
    const base = baseName(id)
    var end: usize = 0
    while end < base.length && base[end] != 95 { end += 1 }
    return base[0..end]
}

// The region subtag of the ID itself ("" when it has none).
pub fn country(id: *const Id) -> []const u8 {
    const base = baseName(id)
    var at: usize = 0
    var start: usize = 0
    var part: usize = 0
    while at <= base.length {
        if at == base.length || base[at] == 95 {
            const piece = base[start..at]
            if part > 0 && (piece.length == 2 || (piece.length == 3 && piece[0] >= 48 && piece[0] <= 57)) { return piece }
            if part > 0 && piece.length != 4 { return "" }
            part += 1
            start = at + 1
        }
        at += 1
    }
    return ""
}

// The region of the ID with its likely subtags (zh_Hant: TW), two
// letters in a u16 (the first high); 0 for none.
pub fn likelyRegion(base: []const u8) -> u16 {
    var name: [160]u8 = undefined
    var k: usize = 0
    while k < base.length && k < 150 {
        name[k] = base[k]
        k += 1
    }
    name[k] = 0
    var maximized: [160]u8 = undefined
    var status: i32 = 0
    _ = uloc.uloc_addLikelySubtags(@intFromPtr(&name), @intFromPtr(&maximized), 159, @intFromPtr(&status))
    if status > 0 { return 0 }
    var region: [8]u8 = undefined
    status = 0
    const length = uloc.uloc_getCountry(@intFromPtr(&maximized), @intFromPtr(&region), 7, @intFromPtr(&status))
    if status > 0 || length != 2 { return 0 }
    return (@intCast(u16, region[0]) << 8) | @intCast(u16, region[1])
}

// The language of the ID with its likely subtags, into INTO; its length.
pub fn likelyLanguage(base: []const u8, into: *[12]u8) -> usize {
    var name: [160]u8 = undefined
    var k: usize = 0
    while k < base.length && k < 150 {
        name[k] = base[k]
        k += 1
    }
    name[k] = 0
    var maximized: [160]u8 = undefined
    var status: i32 = 0
    _ = uloc.uloc_addLikelySubtags(@intFromPtr(&name), @intFromPtr(&maximized), 159, @intFromPtr(&status))
    if status > 0 { return 0 }
    status = 0
    const length = uloc.uloc_getLanguage(@intFromPtr(&maximized), @intFromPtr(into), 11, @intFromPtr(&status))
    if status > 0 || length <= 0 { return 0 }
    return @intCast(usize, length)
}

// The region of the supplemental data for the ID: its rg keyword's, its
// own, else its likely one (0 for none).
pub fn supplementalRegion(id: *const Id) -> u16 {
    const rg = keyword(id, "rg")
    if rg.length >= 2 && isAlpha(rg[0]) && isAlpha(rg[1]) { return (@intCast(u16, upper(rg[0])) << 8) | @intCast(u16, upper(rg[1])) }
    const own = country(id)
    if own.length == 2 { return (@intCast(u16, own[0]) << 8) | @intCast(u16, own[1]) }
    return likelyRegion(baseName(id))
}

fn isAlpha(c: u8) -> bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }
fn upper(c: u8) -> u8 { return if c >= 97 && c <= 122 { c - 32 } else { c } }

// The locale with data for the ID (its fallback).
pub fn dataLocale(id: *const Id) -> u32 { return resources.find(baseName(id)) }

// The ICU name of a locale of the data ("de_AT"; "root" for und).
pub fn dataName(index: u32, into: *m.Bytes) -> void {
    if index == resources.NONE { return }
    const name = resources.localeName(index)
    if m.same(name, "und") {
        m.pushText(into, "root")
        return
    }
    for byte in name { m.pushByte(into, if byte == 45 { 95 } else { byte }) }
}

// ---------------------------------------------------------------------------
// The data of the locale (and its parents) as UTF-16.

pub fn lookupText(data: u32, path: []const u8, into: *Text) -> bool {
    var value: []const u8 = ""
    if !resources.lookup(data, path, &value) { return false }
    text.pushUtf8(into, value)
    return true
}

// ---------------------------------------------------------------------------
// The data of a calendar type.

pub const NO_TYPE: u8 = 255

// The type a type's data takes what it lacks from, NO_TYPE for the
// Gregorian calendar.
pub fn dataFallback(kind: u8) -> u8 {
    if kind == cal.GREGORIAN { return NO_TYPE }
    if kind == cal.ISLAMIC_CIVIL || kind == cal.ISLAMIC_UMALQURA || kind == cal.ISLAMIC_TBLA || kind == cal.ISLAMIC_RGSA { return cal.ISLAMIC }
    if kind == cal.ETHIOPIC_AMETE_ALEM { return cal.ETHIOPIC }
    if kind == cal.DANGI { return cal.CHINESE }
    return cal.GREGORIAN
}

// "dates/calendars/TYPE/REST".
pub fn calendarKey(into: *m.Bytes, kind: u8, rest: []const u8) -> void {
    m.pushText(into, "dates/calendars/")
    m.pushText(into, cal.typeName(kind))
    m.pushByte(into, 47)
    m.pushText(into, rest)
}

// REST of type KIND alone (the locale and its parents).
pub fn lookupOwn(data: u32, kind: u8, rest: []const u8, value: *[]const u8) -> bool {
    var key = m.bytesBuffer()
    calendarKey(&key, kind, rest)
    const found = resources.lookup(data, m.bytesText(&key), value)
    m.disposeBytes(&key)
    return found
}

// REST of type KIND, else of the types it takes from.
pub fn lookupCalendar(data: u32, kind: u8, rest: []const u8, value: *[]const u8) -> bool {
    var k = kind
    while k != NO_TYPE {
        if lookupOwn(data, k, rest, value) { return true }
        k = dataFallback(k)
    }
    return false
}

pub fn lookupCalendarText(data: u32, kind: u8, rest: []const u8, into: *Text) -> bool {
    var value: []const u8 = ""
    if !lookupCalendar(data, kind, rest, &value) { return false }
    text.pushUtf8(into, value)
    return true
}

// A pattern of the type (its "_value" when CLDR gives it with numbers of
// another system for some field: ja's "Gy年M月d日" with y=jpanyear).
pub fn lookupPattern(data: u32, kind: u8, rest: []const u8, into: *Text) -> bool {
    var withValue = m.bytesBuffer()
    m.pushText(&withValue, rest)
    m.pushText(&withValue, "/_value")
    var k = kind
    var value: []const u8 = ""
    var found = false
    while k != NO_TYPE && !found {
        found = lookupOwn(data, k, rest, &value) || lookupOwn(data, k, m.bytesText(&withValue), &value)
        k = dataFallback(k)
    }
    m.disposeBytes(&withValue)
    if found { text.pushUtf8(into, value) }
    return found
}

// The calendar type of a locale ID (its keyword's, else its region's).
pub fn calendarType(id: *const Id) -> u8 { return cal.localeType(idText(id)) }

// ---------------------------------------------------------------------------
// Numbering systems: the ten digits of the locale's.

pub const Digits = struct {
    digits: [10]u32
}

fn latin() -> Digits {
    var result: Digits = undefined
    var k: usize = 0
    while k < 10 {
        result.digits[k] = @intCast(u32, 48 + k)
        k += 1
    }
    return result
}

// The numbering system the ID names ("numbers" keyword: a system, or
// default, native, traditional, finance) or its locale's default, into
// NAME; its digits (Latin ones for an algorithmic system).
pub fn numberingSystem(id: *const Id, data: u32, name: *m.Bytes) -> Digits {
    var wanted = keyword(id, "numbers")
    if wanted.length == 0 || m.same(wanted, "default") {
        wanted = resources.get(data, "numbers/defaultNumberingSystem")
    } else if m.same(wanted, "native") || m.same(wanted, "traditional") || m.same(wanted, "finance") {
        var key = m.bytesBuffer()
        m.pushText(&key, "numbers/otherNumberingSystems/")
        m.pushText(&key, wanted)
        var found: []const u8 = ""
        if !resources.lookup(data, m.bytesText(&key), &found) && m.same(wanted, "traditional") {
            found = resources.get(data, "numbers/otherNumberingSystems/native")
        }
        m.disposeBytes(&key)
        wanted = if found.length > 0 { found } else { resources.get(data, "numbers/defaultNumberingSystem") }
    }
    if wanted.length == 0 { wanted = "latn" }
    var key = m.bytesBuffer()
    m.pushText(&key, "numberingSystems/")
    m.pushText(&key, wanted)
    m.pushText(&key, "/_digits")
    const digits = resources.get(resources.supplemental(), m.bytesText(&key))
    m.disposeBytes(&key)
    var result = latin()
    // Ten code points, else not a numeric system.
    var units = text.fromUtf8(digits)
    var count: usize = 0
    var codes: [10]u32 = undefined
    var index: usize = 0
    while index < units.length && count < 11 {
        var c = @intCast(u32, text.at(&units, index))
        index += 1
        if c >= 55296 && c <= 56319 && index < units.length {
            c = (c << 10) + @intCast(u32, text.at(&units, index)) - 56613888
            index += 1
        }
        if count < 10 { codes[count] = c }
        count += 1
    }
    text.dispose(&units)
    if count == 10 {
        result.digits = codes
        m.pushText(name, wanted)
    } else {
        m.pushText(name, "latn")
    }
    return result
}

// ---------------------------------------------------------------------------
// The symbols.

// The sets, in the order of UDateFormatSymbolType, then the ones C does
// not name.
pub const ERAS: usize = 0
pub const MONTHS: usize = 1
pub const SHORT_MONTHS: usize = 2
pub const WEEKDAYS: usize = 3
pub const SHORT_WEEKDAYS: usize = 4
pub const AM_PMS: usize = 5
pub const LOCALIZED_CHARS: usize = 6
pub const ERA_NAMES: usize = 7
pub const NARROW_MONTHS: usize = 8
pub const NARROW_WEEKDAYS: usize = 9
pub const STANDALONE_MONTHS: usize = 10
pub const STANDALONE_SHORT_MONTHS: usize = 11
pub const STANDALONE_NARROW_MONTHS: usize = 12
pub const STANDALONE_WEEKDAYS: usize = 13
pub const STANDALONE_SHORT_WEEKDAYS: usize = 14
pub const STANDALONE_NARROW_WEEKDAYS: usize = 15
pub const QUARTERS: usize = 16
pub const SHORT_QUARTERS: usize = 17
pub const STANDALONE_QUARTERS: usize = 18
pub const STANDALONE_SHORT_QUARTERS: usize = 19
pub const SHORTER_WEEKDAYS: usize = 20
pub const STANDALONE_SHORTER_WEEKDAYS: usize = 21
pub const CYCLIC_YEARS_WIDE: usize = 22
pub const CYCLIC_YEARS_ABBREVIATED: usize = 23
pub const CYCLIC_YEARS_NARROW: usize = 24
pub const ZODIAC_NAMES_WIDE: usize = 25
pub const ZODIAC_NAMES_ABBREVIATED: usize = 26
pub const ZODIAC_NAMES_NARROW: usize = 27
pub const NARROW_QUARTERS: usize = 28
pub const STANDALONE_NARROW_QUARTERS: usize = 29
pub const NARROW_ERAS: usize = 30
pub const NARROW_AM_PMS: usize = 31
pub const DAY_PERIODS_ABBREVIATED: usize = 32
pub const DAY_PERIODS_WIDE: usize = 33
pub const DAY_PERIODS_NARROW: usize = 34
pub const STANDALONE_DAY_PERIODS_ABBREVIATED: usize = 35
pub const STANDALONE_DAY_PERIODS_WIDE: usize = 36
pub const STANDALONE_DAY_PERIODS_NARROW: usize = 37
pub const TIME_SEPARATOR: usize = 38
// The leap month patterns (format wide, abbreviated, narrow, stand-alone
// wide, abbreviated, narrow, numeric), which C does not name.
pub const LEAP_MONTH_PATTERNS: usize = 39
pub const SET_COUNT: usize = 40

// The room of each set (a set's count is what the calendar has).
var SIZES: [40]usize = [40]usize{ 240, 14, 14, 8, 8, 2, 1, 240, 14, 8, 14, 14, 14, 8, 8, 8, 4, 4, 4, 4, 8, 8, 60, 60, 60, 12, 12, 12, 4, 4, 240, 2, 10, 10, 10, 10, 10, 10, 1, 7 }
pub const TEXT_COUNT: usize = 1181
// Where each set starts in Symbols.texts.
var OFFSETS: [40]usize = [40]usize{ 0, 240, 254, 268, 276, 284, 286, 287, 527, 541, 549, 563, 577, 591, 599, 607, 615, 619, 623, 627, 631, 639, 647, 707, 767, 827, 839, 851, 863, 867, 871, 1111, 1113, 1123, 1133, 1143, 1153, 1163, 1173, 1174 }

// The usages of capitalization by context (ICU's
// ECapitalizationContextUsageType), as contextTransforms names them.
pub const CAP_OTHER: usize = 0
pub const CAP_MONTH_FORMAT: usize = 1
pub const CAP_MONTH_STANDALONE: usize = 2
pub const CAP_MONTH_NARROW: usize = 3
pub const CAP_DAY_FORMAT: usize = 4
pub const CAP_DAY_STANDALONE: usize = 5
pub const CAP_DAY_NARROW: usize = 6
pub const CAP_ERA_WIDE: usize = 7
pub const CAP_ERA_ABBREV: usize = 8
pub const CAP_ERA_NARROW: usize = 9
pub const CAP_ZONE_LONG: usize = 10
pub const CAP_ZONE_SHORT: usize = 11
pub const CAP_METAZONE_LONG: usize = 12
pub const CAP_METAZONE_SHORT: usize = 13
pub const CAP_COUNT: usize = 14

const CAPITALIZATION_NAMES: []const u8 = "\nmonth-format-except-narrow\nmonth-standalone-except-narrow\nmonth-narrow\nday-format-except-narrow\nday-standalone-except-narrow\nday-narrow\nera-name\nera-abbr\nera-narrow\nzone-long\nzone-short\nmetazone-long\nmetazone-short\n"

// The pattern letters ICU uses (its "localized" letters are the same:
// CLDR has none of its own).
pub const PATTERN_CHARS: []const u8 = "GyMdkHmsSEDFwWahKzYeugAZvcLQqVUOXxrbB"

pub const Symbols = struct {
    texts: [1181]Text
    // Whether a day period has a name in the locale (others are bogus).
    present: [1181]bool
    // How many strings each set has.
    counts: [40]usize
    capitalization: [28]bool
}

fn symbolsAt(address: usize) -> *Symbols { unsafe { return @ptrFromInt(*Symbols, address) } }

pub fn setOffset(set: usize) -> usize { return if set < SET_COUNT { OFFSETS[set] } else { TEXT_COUNT } }

pub fn setSize(set: usize) -> usize { return if set < SET_COUNT { SIZES[set] } else { 0 } }

pub fn get(s: *Symbols, set: usize, index: usize) -> *Text { return &s.*.texts[setOffset(set) + index] }

pub fn has(s: *Symbols, set: usize, index: usize) -> bool { return index < count(s, set) && s.*.present[setOffset(set) + index] }

// The number of strings set SET has.
pub fn count(s: *Symbols, set: usize) -> usize { return if set < SET_COUNT { s.*.counts[set] } else { 0 } }

fn put(s: *Symbols, set: usize, index: usize, data: u32, path: []const u8) -> bool {
    const slot = setOffset(set) + index
    text.clear(&s.*.texts[slot])
    const found = lookupText(data, path, &s.*.texts[slot])
    s.*.present[slot] = found
    return found
}

// String INDEX of SET from REST of the calendar type's data.
fn putCalendar(s: *Symbols, set: usize, index: usize, data: u32, kind: u8, rest: []const u8, chained: bool) -> bool {
    const slot = setOffset(set) + index
    text.clear(&s.*.texts[slot])
    var value: []const u8 = ""
    const found = if chained { lookupCalendar(data, kind, rest, &value) } else { lookupOwn(data, kind, rest, &value) }
    if found { text.pushUtf8(&s.*.texts[slot], value) }
    s.*.present[slot] = found
    return found
}

fn copySet(s: *Symbols, to: usize, from: usize) -> void {
    var k: usize = 0
    while k < setSize(to) && k < count(s, from) {
        const a = setOffset(to) + k
        const b = setOffset(from) + k
        text.dispose(&s.*.texts[a])
        s.*.texts[a] = text.copy(&s.*.texts[b])
        s.*.present[a] = s.*.present[b]
        k += 1
    }
    s.*.counts[to] = if count(s, from) < setSize(to) { count(s, from) } else { setSize(to) }
}

const DAY_KEYS: []const u8 = "sunmontuewedthufrisat"
const PERIOD_KEYS: []const u8 = "\nmidnight\nnoon\nmorning1\nafternoon1\nevening1\nnight1\nmorning2\nafternoon2\nevening2\nnight2\n"

// Line INDEX of a list written "\na\nb\n".
pub fn listItem(list: []const u8, index: usize) -> []const u8 {
    var at: usize = 1
    var line: usize = 0
    while at < list.length {
        var end = at
        while end < list.length && list[end] != 10 { end += 1 }
        if line == index { return list[at..end] }
        line += 1
        at = end + 1
    }
    return ""
}

// The names of a set (months, days, quarters, day periods) of the
// calendar type: false when some are missing. Months go on while the
// data has them (13 in the Coptic and Ethiopic calendars, a Hebrew leap
// year's Adar II as the fourteenth).
fn loadNames(s: *Symbols, set: usize, data: u32, kind: u8, what: []const u8, context: []const u8, width: []const u8) -> bool {
    var all = true
    var k: usize = 0
    const isMonths = m.same(what, "months")
    var size = setSize(set)
    if isMonths { size = 12 }
    s.*.counts[set] = size
    while k < setSize(set) {
        var key = m.bytesBuffer()
        m.pushText(&key, what)
        m.pushByte(&key, 47)
        m.pushText(&key, context)
        m.pushByte(&key, 47)
        m.pushText(&key, width)
        m.pushByte(&key, 47)
        if m.same(what, "days") {
            if k == 0 {
                m.disposeBytes(&key)
                k += 1
                continue
            }
            m.pushText(&key, DAY_KEYS[(k - 1) * 3..(k - 1) * 3 + 3])
        } else if m.same(what, "dayPeriods") {
            m.pushText(&key, listItem(PERIOD_KEYS, k))
        } else if isMonths && k == 13 {
            m.pushText(&key, "7-yeartype-leap")
        } else {
            pushNumber(&key, k + 1)
        }
        const found = putCalendar(s, set, k, data, kind, m.bytesText(&key), true)
        m.disposeBytes(&key)
        if isMonths && k >= 12 {
            if !found { break }
            s.*.counts[set] = k + 1
        } else if !found {
            all = false
        }
        k += 1
    }
    return all
}

pub fn pushNumber(into: *m.Bytes, value: usize) -> void {
    if value >= 10 { pushNumber(into, value / 10) }
    m.pushByte(into, @intCast(u8, 48 + value % 10))
}

// The eras of a width: those of the first type (the calendar's, else
// one it takes from) that has any, to the last it has (CLDR's Coptic
// eras are era 1's alone: era 0 is left empty).
fn loadEras(s: *Symbols, set: usize, data: u32, kind: u8, width: []const u8) -> bool {
    var source = kind
    s.*.counts[set] = 0
    while source != NO_TYPE {
        var first: usize = 0
        var any = false
        while first < 2 && !any {
            var key = m.bytesBuffer()
            m.pushText(&key, "eras/")
            m.pushText(&key, width)
            m.pushByte(&key, 47)
            pushNumber(&key, first)
            var value: []const u8 = ""
            any = lookupOwn(data, source, m.bytesText(&key), &value)
            m.disposeBytes(&key)
            first += 1
        }
        if any { break }
        source = dataFallback(source)
    }
    if source == NO_TYPE { return false }
    var k: usize = 0
    var last: usize = 0
    var misses: usize = 0
    while k < setSize(set) && misses < 2 {
        var item = m.bytesBuffer()
        m.pushText(&item, "eras/")
        m.pushText(&item, width)
        m.pushByte(&item, 47)
        pushNumber(&item, k)
        const found = putCalendar(s, set, k, data, source, m.bytesText(&item), false)
        m.disposeBytes(&item)
        if found {
            last = k + 1
            misses = 0
        } else {
            misses += 1
        }
        k += 1
    }
    s.*.counts[set] = last
    return last > 0
}

fn loadPair(s: *Symbols, set: usize, data: u32, kind: u8, width: []const u8) -> bool {
    var key = m.bytesBuffer()
    m.pushText(&key, "dayPeriods/format/")
    m.pushText(&key, width)
    m.pushText(&key, "/am")
    const am = putCalendar(s, set, 0, data, kind, m.bytesText(&key), true)
    m.disposeBytes(&key)
    key = m.bytesBuffer()
    m.pushText(&key, "dayPeriods/format/")
    m.pushText(&key, width)
    m.pushText(&key, "/pm")
    const pm = putCalendar(s, set, 1, data, kind, m.bytesText(&key), true)
    m.disposeBytes(&key)
    s.*.counts[set] = 2
    return am && pm
}

const LEAP_PATTERN_KEYS: []const u8 = "\nformat/wide\nformat/abbreviated\nformat/narrow\nstand-alone/wide\nstand-alone/abbreviated\nstand-alone/narrow\nnumeric/all\n"

// The leap month patterns ("{0}bis"), all seven or none; a missing one
// another's, as ICU fills them.
fn loadLeapMonthPatterns(s: *Symbols, data: u32, kind: u8) -> void {
    var all = true
    var k: usize = 0
    while k < 7 {
        var key = m.bytesBuffer()
        m.pushText(&key, "monthPatterns/")
        m.pushText(&key, listItem(LEAP_PATTERN_KEYS, k))
        m.pushText(&key, "/leap")
        if !putCalendar(s, LEAP_MONTH_PATTERNS, k, data, kind, m.bytesText(&key), true) { all = false }
        m.disposeBytes(&key)
        k += 1
    }
    s.*.counts[LEAP_MONTH_PATTERNS] = if all { 7 } else { 0 }
    if !all { return }
    copyIfEmpty(s, 1, 0)
    copyIfEmpty(s, 2, 5)
    copyIfEmpty(s, 3, 0)
    copyIfEmpty(s, 4, 1)
}

fn copyIfEmpty(s: *Symbols, to: usize, from: usize) -> void {
    const a = setOffset(LEAP_MONTH_PATTERNS) + to
    const b = setOffset(LEAP_MONTH_PATTERNS) + from
    if s.*.texts[a].length == 0 {
        text.dispose(&s.*.texts[a])
        s.*.texts[a] = text.copy(&s.*.texts[b])
    }
}

// Cyclic names (years, zodiac signs: cyclicNameSets/WHAT/format/
// abbreviated, as ICU takes them for every width), as many as there are.
fn loadCyclicNames(s: *Symbols, set: usize, data: u32, kind: u8, what: []const u8) -> void {
    var k: usize = 0
    while k < setSize(set) {
        var key = m.bytesBuffer()
        m.pushText(&key, "cyclicNameSets/")
        m.pushText(&key, what)
        m.pushText(&key, "/format/abbreviated/")
        pushNumber(&key, k + 1)
        const found = putCalendar(s, set, k, data, kind, m.bytesText(&key), true)
        m.disposeBytes(&key)
        if !found { break }
        k += 1
    }
    s.*.counts[set] = k
}

// The symbols of locale DATA for calendar type KIND (with the numbering
// system NS for the time separator), as ICU's DateFormatSymbols loads
// them, with its fallbacks for what is missing.
fn loadFresh(data: u32, ns: []const u8, kind: u8) -> usize {
    const address = m.alloc(@sizeOf(Symbols))
    if address == 0 { return 0 }
    var s = symbolsAt(address)
    var set: usize = 0
    while set < SET_COUNT {
        s.*.counts[set] = setSize(set)
        set += 1
    }
    var slot: usize = 0
    while slot < TEXT_COUNT {
        s.*.texts[slot] = text.empty()
        s.*.present[slot] = false
        slot += 1
    }
    _ = loadEras(s, ERAS, data, kind, "eraAbbr")
    if !loadEras(s, ERA_NAMES, data, kind, "eraNames") { copySet(s, ERA_NAMES, ERAS) }
    if !loadEras(s, NARROW_ERAS, data, kind, "eraNarrow") { copySet(s, NARROW_ERAS, ERAS) }
    _ = loadNames(s, MONTHS, data, kind, "months", "format", "wide")
    _ = loadNames(s, SHORT_MONTHS, data, kind, "months", "format", "abbreviated")
    if !loadNames(s, STANDALONE_MONTHS, data, kind, "months", "stand-alone", "wide") { copySet(s, STANDALONE_MONTHS, MONTHS) }
    if !loadNames(s, STANDALONE_SHORT_MONTHS, data, kind, "months", "stand-alone", "abbreviated") { copySet(s, STANDALONE_SHORT_MONTHS, SHORT_MONTHS) }
    const narrow = loadNames(s, NARROW_MONTHS, data, kind, "months", "format", "narrow")
    const standaloneNarrow = loadNames(s, STANDALONE_NARROW_MONTHS, data, kind, "months", "stand-alone", "narrow")
    if !narrow && standaloneNarrow { copySet(s, NARROW_MONTHS, STANDALONE_NARROW_MONTHS) }
    if narrow && !standaloneNarrow { copySet(s, STANDALONE_NARROW_MONTHS, NARROW_MONTHS) }
    if !narrow && !standaloneNarrow {
        copySet(s, NARROW_MONTHS, SHORT_MONTHS)
        copySet(s, STANDALONE_NARROW_MONTHS, SHORT_MONTHS)
    }
    if !loadPair(s, AM_PMS, data, kind, "wide") { _ = loadPair(s, AM_PMS, data, kind, "abbreviated") }
    if !loadPair(s, NARROW_AM_PMS, data, kind, "narrow") {
        if !loadPair(s, NARROW_AM_PMS, data, kind, "abbreviated") { copySet(s, NARROW_AM_PMS, AM_PMS) }
    }
    _ = loadNames(s, QUARTERS, data, kind, "quarters", "format", "wide")
    if !loadNames(s, SHORT_QUARTERS, data, kind, "quarters", "format", "abbreviated") { copySet(s, SHORT_QUARTERS, QUARTERS) }
    if !loadNames(s, STANDALONE_QUARTERS, data, kind, "quarters", "stand-alone", "wide") { copySet(s, STANDALONE_QUARTERS, QUARTERS) }
    if !loadNames(s, STANDALONE_SHORT_QUARTERS, data, kind, "quarters", "stand-alone", "abbreviated") { copySet(s, STANDALONE_SHORT_QUARTERS, SHORT_QUARTERS) }
    if !loadNames(s, NARROW_QUARTERS, data, kind, "quarters", "format", "narrow") { copySet(s, NARROW_QUARTERS, SHORT_QUARTERS) }
    if !loadNames(s, STANDALONE_NARROW_QUARTERS, data, kind, "quarters", "stand-alone", "narrow") { copySet(s, STANDALONE_NARROW_QUARTERS, NARROW_QUARTERS) }
    _ = loadNames(s, WEEKDAYS, data, kind, "days", "format", "wide")
    _ = loadNames(s, SHORT_WEEKDAYS, data, kind, "days", "format", "abbreviated")
    if !loadNames(s, SHORTER_WEEKDAYS, data, kind, "days", "format", "short") { copySet(s, SHORTER_WEEKDAYS, SHORT_WEEKDAYS) }
    if !loadNames(s, STANDALONE_WEEKDAYS, data, kind, "days", "stand-alone", "wide") { copySet(s, STANDALONE_WEEKDAYS, WEEKDAYS) }
    if !loadNames(s, STANDALONE_SHORT_WEEKDAYS, data, kind, "days", "stand-alone", "abbreviated") { copySet(s, STANDALONE_SHORT_WEEKDAYS, SHORT_WEEKDAYS) }
    if !loadNames(s, STANDALONE_SHORTER_WEEKDAYS, data, kind, "days", "stand-alone", "short") { copySet(s, STANDALONE_SHORTER_WEEKDAYS, SHORTER_WEEKDAYS) }
    const narrowDays = loadNames(s, NARROW_WEEKDAYS, data, kind, "days", "format", "narrow")
    const standaloneNarrowDays = loadNames(s, STANDALONE_NARROW_WEEKDAYS, data, kind, "days", "stand-alone", "narrow")
    if !narrowDays && standaloneNarrowDays { copySet(s, NARROW_WEEKDAYS, STANDALONE_NARROW_WEEKDAYS) }
    if narrowDays && !standaloneNarrowDays { copySet(s, STANDALONE_NARROW_WEEKDAYS, NARROW_WEEKDAYS) }
    if !narrowDays && !standaloneNarrowDays {
        copySet(s, NARROW_WEEKDAYS, SHORT_WEEKDAYS)
        copySet(s, STANDALONE_NARROW_WEEKDAYS, SHORT_WEEKDAYS)
    }
    _ = loadNames(s, DAY_PERIODS_ABBREVIATED, data, kind, "dayPeriods", "format", "abbreviated")
    _ = loadNames(s, DAY_PERIODS_WIDE, data, kind, "dayPeriods", "format", "wide")
    _ = loadNames(s, DAY_PERIODS_NARROW, data, kind, "dayPeriods", "format", "narrow")
    _ = loadNames(s, STANDALONE_DAY_PERIODS_ABBREVIATED, data, kind, "dayPeriods", "stand-alone", "abbreviated")
    _ = loadNames(s, STANDALONE_DAY_PERIODS_WIDE, data, kind, "dayPeriods", "stand-alone", "wide")
    _ = loadNames(s, STANDALONE_DAY_PERIODS_NARROW, data, kind, "dayPeriods", "stand-alone", "narrow")
    // A missing wide or narrow day period is the abbreviated one; a
    // missing stand-alone one the format one.
    var k: usize = 0
    while k < 10 {
        fillPeriod(s, DAY_PERIODS_WIDE, DAY_PERIODS_ABBREVIATED, k)
        fillPeriod(s, DAY_PERIODS_NARROW, DAY_PERIODS_ABBREVIATED, k)
        fillPeriod(s, STANDALONE_DAY_PERIODS_ABBREVIATED, DAY_PERIODS_ABBREVIATED, k)
        fillPeriod(s, STANDALONE_DAY_PERIODS_WIDE, STANDALONE_DAY_PERIODS_ABBREVIATED, k)
        fillPeriod(s, STANDALONE_DAY_PERIODS_NARROW, STANDALONE_DAY_PERIODS_ABBREVIATED, k)
        k += 1
    }
    loadLeapMonthPatterns(s, data, kind)
    loadCyclicNames(s, CYCLIC_YEARS_ABBREVIATED, data, kind, "years")
    copySet(s, CYCLIC_YEARS_WIDE, CYCLIC_YEARS_ABBREVIATED)
    copySet(s, CYCLIC_YEARS_NARROW, CYCLIC_YEARS_ABBREVIATED)
    loadCyclicNames(s, ZODIAC_NAMES_ABBREVIATED, data, kind, "zodiacs")
    copySet(s, ZODIAC_NAMES_WIDE, ZODIAC_NAMES_ABBREVIATED)
    copySet(s, ZODIAC_NAMES_NARROW, ZODIAC_NAMES_ABBREVIATED)
    put(s, LOCALIZED_CHARS, 0, resources.NONE, "")
    text.pushUtf8(get(s, LOCALIZED_CHARS, 0), PATTERN_CHARS)
    var key = m.bytesBuffer()
    m.pushText(&key, "numbers/symbols-numberSystem-")
    m.pushText(&key, ns)
    m.pushText(&key, "/timeSeparator")
    if !put(s, TIME_SEPARATOR, 0, data, m.bytesText(&key)) { text.push(get(s, TIME_SEPARATOR, 0), 58) }
    m.disposeBytes(&key)
    // Capitalization: [uiListOrMenu, stand-alone] of each usage.
    var usage: usize = 1
    while usage < CAP_COUNT {
        const name = listItem(CAPITALIZATION_NAMES, usage - 1)
        var ui = m.bytesBuffer()
        m.pushText(&ui, "contextTransforms/")
        m.pushText(&ui, name)
        m.pushText(&ui, "/uiListOrMenu")
        s.*.capitalization[usage * 2] = m.same(resources.get(data, m.bytesText(&ui)), "titlecase-firstword")
        m.disposeBytes(&ui)
        var alone = m.bytesBuffer()
        m.pushText(&alone, "contextTransforms/")
        m.pushText(&alone, name)
        m.pushText(&alone, "/stand-alone")
        s.*.capitalization[usage * 2 + 1] = m.same(resources.get(data, m.bytesText(&alone)), "titlecase-firstword")
        m.disposeBytes(&alone)
        usage += 1
    }
    return address
}

fn fillPeriod(s: *Symbols, set: usize, from: usize, index: usize) -> void {
    const a = setOffset(set) + index
    const b = setOffset(from) + index
    if !s.*.present[a] && s.*.present[b] {
        text.dispose(&s.*.texts[a])
        s.*.texts[a] = text.copy(&s.*.texts[b])
        s.*.present[a] = true
    }
}

// The symbols of DATA with numbering system NS: a copy of those loaded
// before (the last CACHE_SIZE kept, shared by the threads under a lock).
const CACHE_SIZE: usize = 16
var cacheLock: u32 = 0
var cachedCount: usize = 0
var cachedNext: usize = 0
var cachedData: [16]u32 = undefined
var cachedKind: [16]u8 = undefined
var cachedNs: [16][16]u8 = undefined
var cachedNsLength: [16]usize = undefined
var cachedSymbols: [16]usize = undefined

fn lock() -> void {
    while @atomicRmw(u32, &cacheLock, xchg, 1, acquire) != 0 {}
}

fn unlock() -> void { @atomicStore(u32, &cacheLock, 0, release) }

fn cachedAt(k: usize, data: u32, ns: []const u8, kind: u8) -> bool {
    if cachedData[k] != data || cachedKind[k] != kind || cachedNsLength[k] != ns.length { return false }
    var n: usize = 0
    while n < ns.length {
        if cachedNs[k][n] != ns[n] { return false }
        n += 1
    }
    return true
}

pub fn load(data: u32, ns: []const u8, kind: u8) -> usize {
    if ns.length > 16 { return loadFresh(data, ns, kind) }
    lock()
    var k: usize = 0
    while k < cachedCount {
        if cachedAt(k, data, ns, kind) {
            const copy = clone(cachedSymbols[k])
            unlock()
            return copy
        }
        k += 1
    }
    unlock()
    const fresh = loadFresh(data, ns, kind)
    if fresh == 0 { return 0 }
    const kept = clone(fresh)
    if kept == 0 { return fresh }
    lock()
    var slot = cachedCount
    if cachedCount < CACHE_SIZE {
        cachedCount += 1
    } else {
        slot = cachedNext
        cachedNext = (cachedNext + 1) % CACHE_SIZE
        destroy(cachedSymbols[slot])
    }
    cachedData[slot] = data
    cachedKind[slot] = kind
    cachedNsLength[slot] = ns.length
    var n: usize = 0
    while n < ns.length {
        cachedNs[slot][n] = ns[n]
        n += 1
    }
    cachedSymbols[slot] = kept
    unlock()
    return fresh
}

pub fn clone(address: usize) -> usize {
    if address == 0 { return 0 }
    const copy = m.alloc(@sizeOf(Symbols))
    if copy == 0 { return 0 }
    m.copy(copy, address, @sizeOf(Symbols))
    var s = symbolsAt(copy)
    var k: usize = 0
    while k < TEXT_COUNT {
        s.*.texts[k] = text.copy(&symbolsAt(address).*.texts[k])
        k += 1
    }
    return copy
}

pub fn destroy(address: usize) -> void {
    if address == 0 { return }
    var s = symbolsAt(address)
    var k: usize = 0
    while k < TEXT_COUNT {
        text.dispose(&s.*.texts[k])
        k += 1
    }
    m.release(address)
}

pub fn of(address: usize) -> *Symbols { return symbolsAt(address) }

pub fn capitalizes(s: *Symbols, usage: usize, standalone: bool) -> bool {
    if usage == CAP_OTHER || usage >= CAP_COUNT { return false }
    return s.*.capitalization[usage * 2 + (if standalone { 1 } else { 0 })]
}

// ---------------------------------------------------------------------------
// The rules of day periods (CLDR's dayPeriodRuleSet): the period of each
// hour, and whether midnight and noon have their own.

pub const MIDNIGHT: i32 = 0
pub const NOON: i32 = 1
pub const MORNING1: i32 = 2
pub const AFTERNOON1: i32 = 3
pub const EVENING1: i32 = 4
pub const NIGHT1: i32 = 5
pub const MORNING2: i32 = 6
pub const AFTERNOON2: i32 = 7
pub const EVENING2: i32 = 8
pub const NIGHT2: i32 = 9
pub const AM: i32 = 10
pub const PM: i32 = 11
pub const UNKNOWN: i32 = -1

pub const DayPeriods = struct {
    found: bool
    hasMidnight: bool
    hasNoon: bool
    hours: [24]i32
}

fn hourOf(value: []const u8) -> i32 {
    var hour: i32 = 0
    var k: usize = 0
    while k < value.length && value[k] >= 48 && value[k] <= 57 {
        hour = hour * 10 + @intCast(i32, value[k] - 48)
        k += 1
    }
    return hour
}

// The rules of the locale named BASE (an ICU base name), else of its
// parents (by truncation, as ICU looks for them).
pub fn dayPeriods(base: []const u8) -> DayPeriods {
    var result: DayPeriods = undefined
    result.found = false
    result.hasMidnight = false
    result.hasNoon = false
    var h: usize = 0
    while h < 24 {
        result.hours[h] = UNKNOWN
        h += 1
    }
    var name: [100]u8 = undefined
    var length: usize = 0
    for byte in base {
        if length < 99 {
            name[length] = if byte == 95 { 45 } else { byte }
            length += 1
        }
    }
    if length == 0 {
        const root = "root"
        for byte in root {
            name[length] = byte
            length += 1
        }
    }
    const supplemental = resources.supplemental()
    while length > 0 {
        const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &name) }
        var prefix = m.bytesBuffer()
        m.pushText(&prefix, "dayPeriodRuleSet/")
        m.pushText(&prefix, view[0..length])
        var first: u32 = 0
        var end: u32 = 0
        resources.below(m.bytesText(&prefix), &first, &end)
        const prefixLength = prefix.length
        var any = false
        var k = first
        while k < end {
            if resources.own(supplemental, k) != resources.NONE { any = true }
            k += 1
        }
        if any {
            k = first
            while k < end {
                const keyName = resources.keyName(k)
                const value = resources.get(supplemental, keyName)
                // dayPeriodRuleSet/LOCALE/PERIOD/_from|_before|_at
                const period = resources.childName(k, prefixLength)
                var leaf = keyName.length
                while leaf > 0 && keyName[leaf - 1] != 47 { leaf -= 1 }
                const attribute = keyName[leaf..keyName.length]
                const kind = periodNumber(period)
                if kind != UNKNOWN {
                    if m.same(attribute, "_at") {
                        if kind == MIDNIGHT { result.hasMidnight = true }
                        if kind == NOON { result.hasNoon = true }
                    } else if m.same(attribute, "_from") {
                        // Paired with _before of the same period.
                        var before = m.bytesBuffer()
                        m.pushText(&before, keyName[0..leaf])
                        m.pushText(&before, "_before")
                        const limitText = resources.get(supplemental, m.bytesText(&before))
                        m.disposeBytes(&before)
                        var start = hourOf(value)
                        var limit = hourOf(limitText)
                        if limit == 24 { limit = 0 }
                        if limitText.length > 0 {
                            // Ranges may wrap past midnight.
                            var guard: i32 = 0
                            while start != limit && guard < 24 {
                                result.hours[@intCast(usize, start)] = kind
                                start = if start == 23 { 0 } else { start + 1 }
                                guard += 1
                            }
                        }
                    }
                }
                k += 1
            }
            m.disposeBytes(&prefix)
            result.found = result.hours[0] != UNKNOWN
            return result
        }
        m.disposeBytes(&prefix)
        // The parent: without the last subtag.
        while length > 0 && name[length - 1] != 45 { length -= 1 }
        if length > 0 { length -= 1 }
    }
    return result
}

fn periodNumber(name: []const u8) -> i32 {
    var k: usize = 0
    while k < 10 {
        if m.same(listItem(PERIOD_KEYS, k), name) { return @intCast(i32, k) }
        k += 1
    }
    if m.same(name, "am") { return AM }
    if m.same(name, "pm") { return PM }
    return UNKNOWN
}
