// Number formats (unum.h, uformattable.h): ICU 74's DecimalFormat, a
// property bag (DecimalFormatProperties) made of a pattern ("#,##0.###",
// UTS #35) and the attribute setters, mapped to a formatter of
// numberformat.mlx as ICU's NumberPropertyMapper does (the affixes of the
// properties, the currency, precision, integer width, grouping, padding,
// scientific and compact notation, scale), with the symbols of the
// locale (DecimalFormatSymbols: numbers/symbols-numberSystem-NS/..., the
// locale's currency) as the formatter keeps them or as unum_setSymbol set
// them. The styles of unum_open take the locale's pattern for the style
// (numbers/STYLEFormats-numberSystem-NS/standard, the currency's own),
// with ICU's changes for ISO codes, plural names, cash and compact
// styles. The properties' getters and the pattern (toPattern, localized
// or not) are ICU's. Parsing is ICU's parser of the properties (strict
// unless lenient: the affixes, signs, digits with their separators and
// grouping, the exponent, percent and currency signs; currencies of the
// locale's names for unum_parseDoubleCurrency); numbers as UFormattable
// (long, int64, double, with the decimal text).
//
// The rule-based styles (spellout, ordinal, duration, rule patterns and
// the algorithmic numbering systems) need CLDR's RBNF data, which
// cldr.dat does not have: unum_open fails for them with
// U_UNSUPPORTED_ERROR.
const m = @import("std.unicode.memory")
const resources = @import("std.unicode.locale.resources")
const formatted = @import("std.unicode.format")
const decimal = @import("std.unicode.format.number.decimal")
const properties = @import("std.unicode.properties")
const locale = @import("std.unicode.locale.defaults")
const numbersystems = @import("std.unicode.format.number.systems")
const currency = @import("std.unicode.format.number.currency")
const nd = @import("std.unicode.format.number.data")
const sk = @import("std.unicode.format.number.skeleton")
const nq = @import("std.unicode.format.number.quantity")
const np = @import("std.unicode.format.number.pattern")
const nb = @import("std.unicode.format.number.builder")
const nf = @import("std.unicode.format.number")
const uloc = @import("std.unicode.locale")
const ures = @import("std.unicode.locale.bundles")

extern("c") fn strtod(text: usize, end: usize) -> f64

// "UNMF" (a number format) and "UFMT" (a formattable).
const MAGIC: u32 = 1431194950
const VALUE_MAGIC: u32 = 1431678292

const PARSE_ERROR: i32 = 9
const INVALID_FORMAT_ERROR: i32 = 3
const INVARIANT_CONVERSION_ERROR: i32 = 26
const MAX_INT_FRAC_SIG: i32 = 999
const INT32_MAX: i32 = 2147483647
const INT32_MIN: i32 = -2147483647 - 1

// UNumberFormatStyle.
const STYLE_PATTERN_DECIMAL: i32 = 0
const STYLE_DECIMAL: i32 = 1
const STYLE_CURRENCY: i32 = 2
const STYLE_PERCENT: i32 = 3
const STYLE_SCIENTIFIC: i32 = 4
const STYLE_NUMBERING_SYSTEM: i32 = 8
const STYLE_CURRENCY_ISO: i32 = 10
const STYLE_CURRENCY_PLURAL: i32 = 11
const STYLE_CURRENCY_ACCOUNTING: i32 = 12
const STYLE_CASH_CURRENCY: i32 = 13
const STYLE_COMPACT_SHORT: i32 = 14
const STYLE_COMPACT_LONG: i32 = 15
const STYLE_CURRENCY_STANDARD: i32 = 16
const STYLE_COUNT: i32 = 17

// UNumberFormatAttribute.
const PARSE_INT_ONLY: i32 = 0
const GROUPING_USED: i32 = 1
const DECIMAL_ALWAYS_SHOWN: i32 = 2
const MAX_INTEGER_DIGITS: i32 = 3
const MIN_INTEGER_DIGITS: i32 = 4
const INTEGER_DIGITS: i32 = 5
const MAX_FRACTION_DIGITS: i32 = 6
const MIN_FRACTION_DIGITS: i32 = 7
const FRACTION_DIGITS: i32 = 8
const MULTIPLIER: i32 = 9
const GROUPING_SIZE: i32 = 10
const ROUNDING_MODE: i32 = 11
const ROUNDING_INCREMENT: i32 = 12
const FORMAT_WIDTH: i32 = 13
const PADDING_POSITION: i32 = 14
const SECONDARY_GROUPING_SIZE: i32 = 15
const SIGNIFICANT_DIGITS_USED: i32 = 16
const MIN_SIGNIFICANT_DIGITS: i32 = 17
const MAX_SIGNIFICANT_DIGITS: i32 = 18
const LENIENT_PARSE: i32 = 19
const PARSE_ALL_INPUT: i32 = 20
const SCALE: i32 = 21
const MINIMUM_GROUPING_DIGITS: i32 = 22
const CURRENCY_USAGE: i32 = 23
const FORMAT_FAIL_IF_MORE_THAN_MAX_DIGITS: i32 = 4096
const PARSE_NO_EXPONENT: i32 = 4097
const PARSE_DECIMAL_MARK_REQUIRED: i32 = 4098
const PARSE_CASE_SENSITIVE: i32 = 4099
const SIGN_ALWAYS_SHOWN: i32 = 4100

// UNumberFormatTextAttribute.
const POSITIVE_PREFIX: i32 = 0
const POSITIVE_SUFFIX: i32 = 1
const NEGATIVE_PREFIX: i32 = 2
const NEGATIVE_SUFFIX: i32 = 3
const PADDING_CHARACTER: i32 = 4
const CURRENCY_CODE: i32 = 5

// UNumberFormatSymbol.
const SYMBOL_DECIMAL: usize = 0
const SYMBOL_GROUPING: usize = 1
const SYMBOL_PATTERN_SEPARATOR: usize = 2
const SYMBOL_PERCENT: usize = 3
const SYMBOL_ZERO_DIGIT: usize = 4
const SYMBOL_DIGIT: usize = 5
const SYMBOL_MINUS: usize = 6
const SYMBOL_PLUS: usize = 7
const SYMBOL_CURRENCY: usize = 8
const SYMBOL_INTL_CURRENCY: usize = 9
const SYMBOL_MONETARY_SEPARATOR: usize = 10
const SYMBOL_EXPONENTIAL: usize = 11
const SYMBOL_PERMILL: usize = 12
const SYMBOL_PAD_ESCAPE: usize = 13
const SYMBOL_INFINITY: usize = 14
const SYMBOL_NAN: usize = 15
const SYMBOL_SIGNIFICANT_DIGIT: usize = 16
const SYMBOL_MONETARY_GROUPING: usize = 17
const SYMBOL_ONE_DIGIT: usize = 18
const SYMBOL_EXPONENT_MULTIPLICATION: usize = 27
const SYMBOL_APPROXIMATELY: usize = 28
const SYMBOL_COUNT: usize = 29

// IGNORE_ROUNDING_NEVER, _IF_CURRENCY, _ALWAYS.
const IGNORE_NEVER: i32 = 0
const IGNORE_IF_CURRENCY: i32 = 1
const IGNORE_ALWAYS: i32 = 2

// UDisplayContext: UDISPCTX_CAPITALIZATION_NONE, its type.
const CAPITALIZATION_NONE: i32 = 256
const TYPE_CAPITALIZATION: i32 = 1

// ---------------------------------------------------------------------------
// Owned strings (UTF-8), unset (ICU's bogus) or set.

pub const Text = struct {
    address: usize
    length: usize
    set: bool
}

fn noText() -> Text { return Text.{ .address = 0, .length = 0, .set = false } }

fn textOf(bytes: []const u8) -> Text {
    const address = m.alloc(bytes.length + 1)
    if bytes.length > 0 { m.copy(address, @intFromPtr(bytes.pointer), bytes.length) }
    return Text.{ .address = address, .length = bytes.length, .set = true }
}

fn freeText(t: *Text) -> void {
    m.release(t.*.address)
    t.* = noText()
}

fn assign(t: *Text, bytes: []const u8) -> void {
    const fresh = textOf(bytes)
    freeText(t)
    t.* = fresh
}

pub fn slice(t: *const Text) -> []const u8 {
    if t.*.length == 0 { return "" }
    return m.bytes(t.*.address, t.*.length)
}

fn duplicate(t: *const Text) -> Text {
    if !t.*.set { return noText() }
    return textOf(slice(t))
}

fn sameText(a: *const Text, b: *const Text) -> bool {
    if a.*.set != b.*.set { return false }
    return m.same(slice(a), slice(b))
}

// UTF-16 TEXT (LENGTH units, -1 for NUL-terminated) as UTF-8 into OUT.
fn utf8Of(text: usize, length: i32, out: *m.Bytes) -> void {
    if text == 0 { return }
    nd.toUtf8(text, m.units(text, length), out)
}

fn firstCodePoint(text: []const u8) -> u32 {
    if text.length == 0 { return 0 }
    var at: usize = 0
    return nd.decode(text, &at)
}

// ---------------------------------------------------------------------------
// The property bag (ICU's DecimalFormatProperties): -1 and unset for
// "not given".

const Properties = struct {
    compactStyle: i32
    currency: [4]u8
    hasCurrency: bool
    currencyPlural: bool
    currencyUsage: i32
    decimalPatternMatchRequired: bool
    decimalSeparatorAlwaysShown: bool
    exponentSignAlwaysShown: bool
    currencyAsDecimal: bool
    formatFailIfMoreThanMaxDigits: bool
    formatWidth: i32
    groupingSize: i32
    groupingUsed: bool
    magnitudeMultiplier: i32
    maximumFractionDigits: i32
    maximumIntegerDigits: i32
    maximumSignificantDigits: i32
    minimumExponentDigits: i32
    minimumFractionDigits: i32
    minimumGroupingDigits: i32
    minimumIntegerDigits: i32
    minimumSignificantDigits: i32
    multiplier: i32
    multiplierScale: i32
    negativePrefix: Text
    negativePrefixPattern: Text
    negativeSuffix: Text
    negativeSuffixPattern: Text
    padPosition: i32
    padString: Text
    parseCaseSensitive: bool
    parseIntegerOnly: bool
    parseMode: i32
    parseNoExponent: bool
    parseAllInput: i32
    positivePrefix: Text
    positivePrefixPattern: Text
    positiveSuffix: Text
    positiveSuffixPattern: Text
    roundingIncrement: f64
    roundingMode: i32
    secondaryGroupingSize: i32
    signAlwaysShown: bool
}

fn clearProperties(p: *Properties) -> void {
    p.*.compactStyle = -1
    p.*.currency = [4]u8{ 0, 0, 0, 0 }
    p.*.hasCurrency = false
    p.*.currencyPlural = false
    p.*.currencyUsage = -1
    p.*.decimalPatternMatchRequired = false
    p.*.decimalSeparatorAlwaysShown = false
    p.*.exponentSignAlwaysShown = false
    p.*.currencyAsDecimal = false
    p.*.formatFailIfMoreThanMaxDigits = false
    p.*.formatWidth = -1
    p.*.groupingSize = -1
    p.*.groupingUsed = true
    p.*.magnitudeMultiplier = 0
    p.*.maximumFractionDigits = -1
    p.*.maximumIntegerDigits = -1
    p.*.maximumSignificantDigits = -1
    p.*.minimumExponentDigits = -1
    p.*.minimumFractionDigits = -1
    p.*.minimumGroupingDigits = -1
    p.*.minimumIntegerDigits = -1
    p.*.minimumSignificantDigits = -1
    p.*.multiplier = 1
    p.*.multiplierScale = 0
    freeText(&p.*.negativePrefix)
    freeText(&p.*.negativePrefixPattern)
    freeText(&p.*.negativeSuffix)
    freeText(&p.*.negativeSuffixPattern)
    p.*.padPosition = -1
    freeText(&p.*.padString)
    p.*.parseCaseSensitive = false
    p.*.parseIntegerOnly = false
    p.*.parseMode = -1
    p.*.parseNoExponent = false
    p.*.parseAllInput = 2
    freeText(&p.*.positivePrefix)
    freeText(&p.*.positivePrefixPattern)
    freeText(&p.*.positiveSuffix)
    freeText(&p.*.positiveSuffixPattern)
    p.*.roundingIncrement = 0.0
    p.*.roundingMode = -1
    p.*.secondaryGroupingSize = -1
    p.*.signAlwaysShown = false
}

fn freeProperties(p: *Properties) -> void {
    freeText(&p.*.negativePrefix)
    freeText(&p.*.negativePrefixPattern)
    freeText(&p.*.negativeSuffix)
    freeText(&p.*.negativeSuffixPattern)
    freeText(&p.*.padString)
    freeText(&p.*.positivePrefix)
    freeText(&p.*.positivePrefixPattern)
    freeText(&p.*.positiveSuffix)
    freeText(&p.*.positiveSuffixPattern)
}

fn duplicateProperties(p: *Properties) -> void {
    p.*.negativePrefix = duplicate(&p.*.negativePrefix)
    p.*.negativePrefixPattern = duplicate(&p.*.negativePrefixPattern)
    p.*.negativeSuffix = duplicate(&p.*.negativeSuffix)
    p.*.negativeSuffixPattern = duplicate(&p.*.negativeSuffixPattern)
    p.*.padString = duplicate(&p.*.padString)
    p.*.positivePrefix = duplicate(&p.*.positivePrefix)
    p.*.positivePrefixPattern = duplicate(&p.*.positivePrefixPattern)
    p.*.positiveSuffix = duplicate(&p.*.positiveSuffix)
    p.*.positiveSuffixPattern = duplicate(&p.*.positiveSuffixPattern)
}

// ---------------------------------------------------------------------------
// A number format.

pub const Format = struct {
    magic: u32
    formatter: usize
    p: Properties
    // What the formatter made of the properties (ICU's exported ones).
    currency: [4]u8
    roundingMode: i32
    minInt: i32
    maxInt: i32
    minFrac: i32
    maxFrac: i32
    minSig: i32
    maxSig: i32
    increment: f64
    // NumberFormat's own fields.
    nfMaxInt: i32
    nfMinInt: i32
    nfMaxFrac: i32
    nfMinFrac: i32
    lenient: bool
    context: i32
    localeId: [160]u8
    localeLength: usize
    valid: [160]u8
    actual: [160]u8
    // The symbols (DecimalFormatSymbols), whether the currency symbols are
    // the caller's, the zero of the digits when they follow it (-1).
    symbols: [29]Text
    customCurrency: bool
    customIntl: bool
    codePointZero: i32
    // The affixes of the properties (PropertiesAffixPatternProvider).
    posPrefix: Text
    posSuffix: Text
    negPrefix: Text
    negSuffix: Text
    hasNegative: bool
    isCurrencyPattern: bool
    // UNUM_CURRENCY_PLURAL's pattern of plural names ("#,##0.### ¤¤¤").
    pluralPattern: Text
}

pub fn formatAt(address: usize) -> *Format { unsafe { return @ptrFromInt(*Format, address) } }

pub fn isFormat(address: usize) -> bool { return address != 0 && m.get32(address) == MAGIC }

pub fn formatterOf(df: *const Format) -> *nf.Formatter { return nf.formatterAt(df.*.formatter) }

fn localeText(df: *const Format) -> []const u8 { return df.*.localeId[0..df.*.localeLength] }

fn symbolText(df: *const Format, index: usize) -> []const u8 { return slice(&df.*.symbols[index]) }

fn setSymbolText(df: *Format, index: usize, value: []const u8) -> void { assign(&df.*.symbols[index], value) }

// The symbols of the locale (ICU's DecimalFormatSymbols(locale)): those of
// its numbering system, the currency's of its currency (¤ and XXX when it
// has none).
fn loadSymbols(df: *Format) -> void {
    var s: sk.Settings = undefined
    sk.initialize(&s)
    var code: currency.Code = undefined
    const hasCurrency = currency.forLocale(localeText(df), &code)
    if hasCurrency {
        s.unit = sk.UNIT_CURRENCY
        var index: usize = 0
        while index < 3 {
            s.currency[index] = code.bytes[index]
            index += 1
        }
    }
    var status: i32 = 0
    const address = nf.create(&s, @intFromPtr(&df.*.localeId), @intFromPtr(&status))
    if address == 0 { return }
    const f = nf.formatterAt(address)
    setSymbolText(df, SYMBOL_DECIMAL, f.*.decimalSymbol)
    setSymbolText(df, SYMBOL_GROUPING, f.*.groupSymbol)
    setSymbolText(df, SYMBOL_PATTERN_SEPARATOR, ";")
    setSymbolText(df, SYMBOL_PERCENT, f.*.percentSign)
    setSymbolText(df, SYMBOL_DIGIT, "#")
    setSymbolText(df, SYMBOL_MINUS, f.*.minusSign)
    setSymbolText(df, SYMBOL_PLUS, f.*.plusSign)
    if hasCurrency {
        const name = if f.*.currencySymbol.length > 0 { f.*.currencySymbol } else { currency.codeText(&code) }
        setSymbolText(df, SYMBOL_CURRENCY, name)
        setSymbolText(df, SYMBOL_INTL_CURRENCY, currency.codeText(&code))
    } else {
        setSymbolText(df, SYMBOL_CURRENCY, "\u{A4}")
        setSymbolText(df, SYMBOL_INTL_CURRENCY, "\u{A4}\u{A4}")
    }
    setSymbolText(df, SYMBOL_MONETARY_SEPARATOR, f.*.monetaryDecimal)
    setSymbolText(df, SYMBOL_EXPONENTIAL, f.*.exponential)
    setSymbolText(df, SYMBOL_PERMILL, f.*.permilleSign)
    setSymbolText(df, SYMBOL_PAD_ESCAPE, "*")
    setSymbolText(df, SYMBOL_INFINITY, f.*.infinity)
    setSymbolText(df, SYMBOL_NAN, f.*.nanSymbol)
    setSymbolText(df, SYMBOL_SIGNIFICANT_DIGIT, "@")
    setSymbolText(df, SYMBOL_MONETARY_GROUPING, f.*.monetaryGroup)
    setSymbolText(df, SYMBOL_EXPONENT_MULTIPLICATION, f.*.superscripting)
    setSymbolText(df, SYMBOL_APPROXIMATELY, f.*.approximatelySign)
    var consecutive = true
    var digit: usize = 0
    while digit < 10 {
        var b = m.bytesBuffer()
        nd.appendUtf8(&b, f.*.digits[digit])
        setSymbolText(df, if digit == 0 { SYMBOL_ZERO_DIGIT } else { SYMBOL_ONE_DIGIT + digit - 1 }, m.bytesText(&b))
        m.disposeBytes(&b)
        if f.*.digits[digit] != f.*.digits[0] + @intCast(u32, digit) { consecutive = false }
        digit += 1
    }
    df.*.codePointZero = if consecutive { @intCast(i32, f.*.digits[0]) } else { -1 }
    nf.destroy(address)
}

// The text of digit DIGIT of the symbols.
fn digitSymbol(df: *const Format, digit: usize) -> []const u8 {
    return symbolText(df, if digit == 0 { SYMBOL_ZERO_DIGIT } else { SYMBOL_ONE_DIGIT + digit - 1 })
}

// The symbols put into the formatter (all but the currency's, which are
// the formatter's own unless they were set).
fn applySymbols(df: *const Format, f: *nf.Formatter) -> void {
    f.*.decimalSymbol = symbolText(df, SYMBOL_DECIMAL)
    f.*.groupSymbol = symbolText(df, SYMBOL_GROUPING)
    f.*.patternSeparator = symbolText(df, SYMBOL_PATTERN_SEPARATOR)
    f.*.percentSign = symbolText(df, SYMBOL_PERCENT)
    f.*.minusSign = symbolText(df, SYMBOL_MINUS)
    f.*.plusSign = symbolText(df, SYMBOL_PLUS)
    if df.*.customCurrency { f.*.currencySymbol = symbolText(df, SYMBOL_CURRENCY) }
    if df.*.customIntl { f.*.intlSymbol = symbolText(df, SYMBOL_INTL_CURRENCY) }
    f.*.monetaryDecimal = symbolText(df, SYMBOL_MONETARY_SEPARATOR)
    f.*.exponential = symbolText(df, SYMBOL_EXPONENTIAL)
    f.*.permilleSign = symbolText(df, SYMBOL_PERMILL)
    f.*.infinity = symbolText(df, SYMBOL_INFINITY)
    f.*.nanSymbol = symbolText(df, SYMBOL_NAN)
    f.*.monetaryGroup = symbolText(df, SYMBOL_MONETARY_GROUPING)
    f.*.superscripting = symbolText(df, SYMBOL_EXPONENT_MULTIPLICATION)
    f.*.approximatelySign = symbolText(df, SYMBOL_APPROXIMATELY)
    var digit: usize = 0
    while digit < 10 {
        if df.*.codePointZero >= 0 {
            f.*.digits[digit] = @intCast(u32, df.*.codePointZero) + @intCast(u32, digit)
        } else {
            f.*.digits[digit] = firstCodePoint(digitSymbol(df, digit))
        }
        digit += 1
    }
}

// ---------------------------------------------------------------------------
// A pattern into the properties (ICU's patternInfoToProperties).

fn fromPattern(df: *Format, pattern: []const u8, ignore: i32) -> i32 {
    const p = &df.*.p
    if pattern.length == 0 {
        // For backwards compatibility: the defaults.
        clearProperties(p)
        return 0
    }
    var info: np.Info = undefined
    np.parse(pattern, &info)
    if info.fault != 0 { return info.fault }
    const pos = &info.positive
    const ignoreRounding = if ignore == IGNORE_NEVER { false } else if ignore == IGNORE_IF_CURRENCY { pos.*.hasCurrencySign } else { true }
    // Grouping.
    const g1 = np.grouping(pos, 0)
    const g2 = np.grouping(pos, 1)
    const g3 = np.grouping(pos, 2)
    if g2 != -1 {
        p.*.groupingSize = g1
        p.*.groupingUsed = true
    } else {
        p.*.groupingSize = -1
        p.*.groupingUsed = false
    }
    p.*.secondaryGroupingSize = if g3 != -1 { g2 } else { -1 }
    // At least one digit, for backwards compatibility.
    var minInt: i32 = 0
    var minFrac: i32 = 0
    if pos.*.integerTotal == 0 && pos.*.fractionTotal > 0 {
        minInt = 0
        minFrac = if pos.*.fractionNumerals > 1 { pos.*.fractionNumerals } else { 1 }
    } else if pos.*.integerNumerals == 0 && pos.*.fractionNumerals == 0 {
        minInt = 1
        minFrac = 0
    } else {
        minInt = pos.*.integerNumerals
        minFrac = pos.*.fractionNumerals
    }
    // Rounding.
    if pos.*.integerAtSigns > 0 {
        p.*.minimumFractionDigits = -1
        p.*.maximumFractionDigits = -1
        p.*.roundingIncrement = 0.0
        p.*.minimumSignificantDigits = pos.*.integerAtSigns
        p.*.maximumSignificantDigits = pos.*.integerAtSigns + pos.*.integerTrailingHashSigns
    } else {
        if !ignoreRounding {
            p.*.minimumFractionDigits = minFrac
            p.*.maximumFractionDigits = pos.*.fractionTotal
            p.*.roundingIncrement = if pos.*.roundingNonZero { roundingOf(pos) } else { 0.0 }
        } else {
            p.*.minimumFractionDigits = -1
            p.*.maximumFractionDigits = -1
            p.*.roundingIncrement = 0.0
        }
        p.*.minimumSignificantDigits = -1
        p.*.maximumSignificantDigits = -1
    }
    // A pattern ending with '.' shows the decimal point.
    p.*.decimalSeparatorAlwaysShown = pos.*.hasDecimal && pos.*.fractionTotal == 0
    p.*.currencyAsDecimal = pos.*.hasCurrencyDecimal
    // Scientific notation.
    if pos.*.exponentZeros > 0 {
        p.*.exponentSignAlwaysShown = pos.*.exponentHasPlusSign
        p.*.minimumExponentDigits = pos.*.exponentZeros
        if pos.*.integerAtSigns == 0 {
            p.*.minimumIntegerDigits = pos.*.integerNumerals
            p.*.maximumIntegerDigits = pos.*.integerTotal
        } else {
            p.*.minimumIntegerDigits = 1
            p.*.maximumIntegerDigits = -1
        }
    } else {
        p.*.exponentSignAlwaysShown = false
        p.*.minimumExponentDigits = -1
        p.*.minimumIntegerDigits = minInt
        p.*.maximumIntegerDigits = -1
    }
    const text = info.text
    const posPrefix = text[pos.*.prefixStart..pos.*.prefixEnd]
    const posSuffix = text[pos.*.suffixStart..pos.*.suffixEnd]
    // Padding: its width counts the affixes' estimated lengths.
    if pos.*.hasPadding {
        p.*.formatWidth = pos.*.widthExceptAffixes + np.estimateLength(posPrefix) + np.estimateLength(posSuffix)
        const raw = text[pos.*.paddingStart..pos.*.paddingEnd]
        if nd.codePoints(raw) == 1 {
            assign(&p.*.padString, raw)
        } else if m.same(raw, "''") {
            assign(&p.*.padString, "'")
        } else if raw.length >= 2 {
            assign(&p.*.padString, raw[1..raw.length - 1])
        } else {
            assign(&p.*.padString, raw)
        }
        p.*.padPosition = pos.*.paddingLocation
    } else {
        p.*.formatWidth = -1
        freeText(&p.*.padString)
        p.*.padPosition = -1
    }
    // The affixes, always set (an empty negative prefix is not "-").
    assign(&p.*.positivePrefixPattern, posPrefix)
    assign(&p.*.positiveSuffixPattern, posSuffix)
    if info.hasNegative {
        const neg = &info.negative
        assign(&p.*.negativePrefixPattern, text[neg.*.prefixStart..neg.*.prefixEnd])
        assign(&p.*.negativeSuffixPattern, text[neg.*.suffixStart..neg.*.suffixEnd])
    } else {
        freeText(&p.*.negativePrefixPattern)
        freeText(&p.*.negativeSuffixPattern)
    }
    // The magnitude multiplier.
    p.*.magnitudeMultiplier = if pos.*.hasPercentSign { 2 } else if pos.*.hasPerMilleSign { 3 } else { 0 }
    return 0
}

// The rounding increment of a pattern's digits ("#,##0.05": 0.05).
fn roundingOf(s: *const np.Subpattern) -> f64 {
    var text: [72]u8 = undefined
    var length: usize = 0
    while length < s.*.roundingLength {
        text[length] = s.*.rounding[length]
        length += 1
    }
    text[length] = 0
    return strtod(@intFromPtr(&text), 0)
}

// ---------------------------------------------------------------------------
// The affixes of the properties: the setters' (escaped) over the
// pattern's; the negative prefix "-" and the positive's by default.

fn escapeInto(input: []const u8, out: *m.Bytes) -> void {
    var inside = false
    var at: usize = 0
    while at < input.length {
        const c = nd.decode(input, &at)
        if c == 39 {
            m.pushText(out, "''")
        } else if c == 45 || c == 43 || c == 37 || c == 8240 || c == 164 {
            if !inside {
                m.pushByte(out, 39)
                inside = true
            }
            nd.appendUtf8(out, c)
        } else {
            if inside {
                m.pushByte(out, 39)
                inside = false
            }
            nd.appendUtf8(out, c)
        }
    }
    if inside { m.pushByte(out, 39) }
}

fn affixInto(override: *const Text, pattern: *const Text, target: *Text) -> void {
    var b = m.bytesBuffer()
    if override.*.set {
        escapeInto(slice(override), &b)
    } else if pattern.*.set {
        m.pushText(&b, slice(pattern))
    }
    assign(target, m.bytesText(&b))
    m.disposeBytes(&b)
}

fn resolveAffixes(df: *Format) -> void {
    const p = &df.*.p
    affixInto(&p.*.positivePrefix, &p.*.positivePrefixPattern, &df.*.posPrefix)
    affixInto(&p.*.positiveSuffix, &p.*.positiveSuffixPattern, &df.*.posSuffix)
    if p.*.negativePrefix.set || p.*.negativePrefixPattern.set {
        affixInto(&p.*.negativePrefix, &p.*.negativePrefixPattern, &df.*.negPrefix)
    } else {
        var b = m.bytesBuffer()
        m.pushByte(&b, 45)
        m.pushText(&b, slice(&p.*.positivePrefixPattern))
        assign(&df.*.negPrefix, m.bytesText(&b))
        m.disposeBytes(&b)
    }
    if p.*.negativeSuffix.set || p.*.negativeSuffixPattern.set {
        affixInto(&p.*.negativeSuffix, &p.*.negativeSuffixPattern, &df.*.negSuffix)
    } else {
        assign(&df.*.negSuffix, slice(&p.*.positiveSuffixPattern))
    }
    // A currency pattern by the pattern's affixes, not the setters'.
    df.*.isCurrencyPattern = np.hasCurrency(slice(&p.*.positivePrefixPattern)) || np.hasCurrency(slice(&p.*.positiveSuffixPattern)) || np.hasCurrency(slice(&p.*.negativePrefixPattern)) || np.hasCurrency(slice(&p.*.negativeSuffixPattern)) || p.*.currencyAsDecimal
    // UNUM_CURRENCY_PLURAL: the affixes of the plural names' pattern.
    if p.*.currencyPlural && df.*.pluralPattern.set {
        var info: np.Info = undefined
        np.parse(slice(&df.*.pluralPattern), &info)
        if info.fault == 0 {
            const text = info.text
            const pos = &info.positive
            assign(&df.*.posPrefix, text[pos.*.prefixStart..pos.*.prefixEnd])
            assign(&df.*.posSuffix, text[pos.*.suffixStart..pos.*.suffixEnd])
            if info.hasNegative {
                const neg = &info.negative
                assign(&df.*.negPrefix, text[neg.*.prefixStart..neg.*.prefixEnd])
                assign(&df.*.negSuffix, text[neg.*.suffixStart..neg.*.suffixEnd])
            } else {
                var b = m.bytesBuffer()
                m.pushByte(&b, 45)
                m.pushText(&b, slice(&df.*.posPrefix))
                assign(&df.*.negPrefix, m.bytesText(&b))
                m.disposeBytes(&b)
                assign(&df.*.negSuffix, slice(&df.*.posSuffix))
            }
            df.*.isCurrencyPattern = true
        }
    }
    // ICU's hasNegativeSubpattern.
    const negPrefix = slice(&df.*.negPrefix)
    const posPrefix = slice(&df.*.posPrefix)
    df.*.hasNegative = !m.same(slice(&df.*.negSuffix), slice(&df.*.posSuffix)) || negPrefix.length == 0 || negPrefix[0] != 45 || !m.same(negPrefix[1..negPrefix.length], posPrefix)
}

fn affixesOf(df: *const Format) -> np.Affixes {
    var a = np.affixesOfPatterns(slice(&df.*.posPrefix), slice(&df.*.posSuffix), slice(&df.*.negPrefix), slice(&df.*.negSuffix), df.*.hasNegative)
    a.hasCurrencySign = df.*.isCurrencyPattern
    a.currencyAsDecimal = df.*.p.currencyAsDecimal
    return a
}

// ---------------------------------------------------------------------------
// The properties into a formatter (ICU's touch and oldToNew).

// ICU's ignoreRoundingIncrement: an increment below half the last
// fraction digit shown does nothing.
fn ignoreRoundingIncrement(increment: f64, maxFrac: i32) -> bool {
    if maxFrac < 0 { return false }
    var frac: i32 = 0
    var value = increment * 2.0
    while frac <= maxFrac && value <= 1.0 {
        frac += 1
        value *= 10.0
    }
    return frac > maxFrac
}

// An increment as the formatter takes it (Precision::increment): the
// digits without trailing zeros and the magnitude of the last.
fn setIncrement(s: *sk.Settings, increment: f64, minFrac: i32) -> void {
    if !(increment > 0.0) {
        s.*.fault = sk.ARG_OUTOFBOUNDS_ERROR
        return
    }
    const d = decimal.fromDouble(increment)
    var mantissa: u64 = 0
    var index: usize = 0
    while index < d.count && index < 18 {
        mantissa = mantissa * 10 + @intCast(u64, d.digits[index])
        index += 1
    }
    const magnitude = d.point - @intCast(i32, d.count)
    s.*.increment = mantissa
    s.*.incrementMagnitude = magnitude
    s.*.precision = if mantissa == 1 { sk.PRECISION_INCREMENT_ONE } else if mantissa == 5 { sk.PRECISION_INCREMENT_FIVE } else { sk.PRECISION_INCREMENT }
    if minFrac >= 0 && minFrac <= MAX_INT_FRAC_SIG {
        s.*.incrementMinFrac = minFrac
    } else {
        s.*.fault = sk.ARG_OUTOFBOUNDS_ERROR
    }
}

fn setFraction(s: *sk.Settings, minFrac: i32, maxFrac: i32) -> void {
    s.*.precision = sk.PRECISION_FRACTION
    s.*.minFrac = minFrac
    s.*.maxFrac = maxFrac
}

fn setSignificant(s: *sk.Settings, minSig: i32, maxSig: i32) -> void {
    s.*.precision = sk.PRECISION_SIGNIFICANT
    s.*.minSig = minSig
    s.*.maxSig = maxSig
}

fn int16(value: i32) -> i32 { return @intCast(i32, @bitCast(i16, @intCast(u16, @bitCast(u32, value) & 65535))) }

fn clampDigits(value: i32, most: i32) -> i32 {
    if value < 0 { return 0 }
    return if value > most { most } else { value }
}

fn pow10(exponent: i32) -> f64 {
    var result: f64 = 1.0
    var k: i32 = 0
    while k < exponent {
        result *= 10.0
        k += 1
    }
    while k > exponent {
        result /= 10.0
        k -= 1
    }
    return result
}

// The currency of the properties, else the locale's, else XXX.
fn resolveCurrency(df: *const Format, code: *currency.Code) -> void {
    if df.*.p.hasCurrency {
        code.* = currency.Code.{ .bytes = df.*.p.currency, .length = 3 }
        return
    }
    if currency.forLocale(localeText(df), code) { return }
    code.* = currency.Code.{ .bytes = [4]u8{ 88, 88, 88, 0 }, .length = 3 }
}

// Rebuilds the formatter of the properties; the status of its making.
fn touch(df: *Format) -> i32 {
    const p = &df.*.p
    resolveAffixes(df)
    var s: sk.Settings = undefined
    sk.initialize(&s)
    var code: currency.Code = undefined
    resolveCurrency(df, &code)
    const useCurrency = p.*.hasCurrency || p.*.currencyPlural || p.*.currencyUsage != -1 || df.*.isCurrencyPattern
    const usage = if p.*.currencyUsage == -1 { currency.USAGE_STANDARD } else { p.*.currencyUsage }
    if useCurrency {
        s.unit = sk.UNIT_CURRENCY
        var index: usize = 0
        while index < 3 {
            s.currency[index] = code.bytes[index]
            index += 1
        }
    }
    // Rounding.
    var maxInt = p.*.maximumIntegerDigits
    var minInt = p.*.minimumIntegerDigits
    var maxFrac = p.*.maximumFractionDigits
    var minFrac = p.*.minimumFractionDigits
    var minSig = p.*.minimumSignificantDigits
    var maxSig = p.*.maximumSignificantDigits
    const increment = p.*.roundingIncrement
    const mode = if p.*.roundingMode < 0 || p.*.roundingMode > 10 { decimal.HALF_EVEN } else { p.*.roundingMode }
    const explicitFrac = minFrac != -1 || maxFrac != -1
    const explicitSig = minSig != -1 || maxSig != -1
    if useCurrency && (minFrac == -1 || maxFrac == -1) {
        const digits = currency.fractionDigits(&code, usage)
        if minFrac == -1 && maxFrac == -1 {
            minFrac = digits
            maxFrac = digits
        } else if minFrac == -1 {
            minFrac = if maxFrac < digits { maxFrac } else { digits }
        } else {
            maxFrac = if minFrac > digits { minFrac } else { digits }
        }
    }
    // The minimum wins over a maximum below it.
    if minInt == 0 && maxFrac != 0 {
        minFrac = if minFrac < 0 || (minFrac == 0 && maxInt == 0) { 1 } else { minFrac }
        maxFrac = if maxFrac < 0 { -1 } else if maxFrac < minFrac { minFrac } else { maxFrac }
        minInt = 0
        maxInt = if maxInt < 0 { -1 } else if maxInt > MAX_INT_FRAC_SIG { -1 } else { maxInt }
    } else {
        minFrac = if minFrac < 0 { 0 } else { minFrac }
        maxFrac = if maxFrac < 0 { -1 } else if maxFrac < minFrac { minFrac } else { maxFrac }
        minInt = if minInt <= 0 { 1 } else if minInt > MAX_INT_FRAC_SIG { 1 } else { minInt }
        maxInt = if maxInt < 0 { -1 } else if maxInt < minInt { minInt } else if maxInt > MAX_INT_FRAC_SIG { -1 } else { maxInt }
    }
    var precisionSet = true
    if p.*.currencyUsage != -1 {
        s.precision = sk.PRECISION_CURRENCY
        s.currencyUsage = usage
    } else if increment != 0.0 {
        if ignoreRoundingIncrement(increment, maxFrac) {
            setFraction(&s, minFrac, maxFrac)
        } else {
            setIncrement(&s, increment, minFrac)
        }
    } else if explicitSig {
        minSig = if minSig < 1 { 1 } else if minSig > MAX_INT_FRAC_SIG { MAX_INT_FRAC_SIG } else { minSig }
        maxSig = if maxSig < 0 { MAX_INT_FRAC_SIG } else if maxSig < minSig { minSig } else if maxSig > MAX_INT_FRAC_SIG { MAX_INT_FRAC_SIG } else { maxSig }
        setSignificant(&s, minSig, maxSig)
    } else if explicitFrac {
        setFraction(&s, minFrac, maxFrac)
    } else if useCurrency {
        s.precision = sk.PRECISION_CURRENCY
        s.currencyUsage = usage
    } else {
        precisionSet = false
    }
    if precisionSet { s.roundingMode = mode }
    const precision = s.precision
    const precisionMinFrac = s.minFrac
    const precisionMaxFrac = s.maxFrac
    const precisionMinSig = s.minSig
    const precisionMaxSig = s.maxSig
    const precisionIncrement = s.increment
    const precisionMagnitude = s.incrementMagnitude
    const precisionIncrementMinFrac = s.incrementMinFrac
    // Integer width.
    s.hasIntegerWidth = true
    s.minInt = minInt
    s.maxInt = maxInt
    // Grouping (Grouper::forProperties).
    if !p.*.groupingUsed {
        s.grouping = sk.GROUPING_OFF
    } else {
        var g1 = int16(p.*.groupingSize)
        var g2 = int16(p.*.secondaryGroupingSize)
        g1 = if g1 > 0 { g1 } else if g2 > 0 { g2 } else { g1 }
        g2 = if g2 > 0 { g2 } else { g1 }
        s.grouping = sk.GROUPING_PROPERTIES
        s.grouping1 = g1
        s.grouping2 = g2
        s.minGrouping = int16(p.*.minimumGroupingDigits)
    }
    s.decimal = if p.*.decimalSeparatorAlwaysShown { 1 } else { 0 }
    s.sign = if p.*.signAlwaysShown { sk.SIGN_ALWAYS } else { sk.SIGN_AUTO }
    // Scientific notation, with LDML's integer digits and rounding.
    if p.*.minimumExponentDigits != -1 {
        if maxInt > 8 {
            maxInt = minInt
            s.minInt = minInt
            s.maxInt = maxInt
        } else if maxInt > minInt && minInt > 1 {
            minInt = 1
            s.minInt = minInt
            s.maxInt = maxInt
        }
        const engineering = if maxInt < 0 { -1 } else { maxInt }
        s.notation = sk.NOTATION_SCIENTIFIC
        s.engineering = int8(engineering)
        s.requireMinInt = engineering == minInt
        s.minExponentDigits = p.*.minimumExponentDigits
        s.exponentSign = if p.*.exponentSignAlwaysShown { sk.SIGN_ALWAYS } else { sk.SIGN_AUTO }
        if s.precision == sk.PRECISION_FRACTION {
            const maxInt_ = p.*.maximumIntegerDigits
            var minInt_ = p.*.minimumIntegerDigits
            const minFrac_ = p.*.minimumFractionDigits
            const maxFrac_ = p.*.maximumFractionDigits
            if minInt_ == 0 && maxFrac_ == 0 {
                s.precision = sk.PRECISION_NONE
            } else if minInt_ == 0 && minFrac_ == 0 {
                setSignificant(&s, 1, maxFrac_ + 1)
            } else {
                const maxSig_ = minInt_ + maxFrac_
                if maxInt_ > minInt_ && minInt_ > 1 { minInt_ = 1 }
                setSignificant(&s, minInt_ + minFrac_, maxSig_)
            }
            s.roundingMode = mode
        }
    }
    // Compact notation.
    if p.*.compactStyle != -1 { s.notation = if p.*.compactStyle == 1 { sk.NOTATION_COMPACT_LONG } else { sk.NOTATION_COMPACT_SHORT } }
    // The multipliers.
    s.scaleMagnitude = p.*.magnitudeMultiplier + p.*.multiplierScale
    if p.*.multiplier != 1 {
        var b = m.bytesBuffer()
        pushInteger(&b, @intCast(i64, p.*.multiplier))
        const text = m.bytesText(&b)
        var index: usize = 0
        while index < text.length && index < 47 {
            s.scaleText[index] = text[index]
            index += 1
        }
        s.scaleTextLength = index
        m.disposeBytes(&b)
    }
    // The formatter.
    const a = affixesOf(df)
    var status: i32 = 0
    const address = nf.createWith(&s, @intFromPtr(&df.*.localeId), &a, true, @intFromPtr(&status))
    if address == 0 { return m.MEMORY_ALLOCATION_ERROR }
    const f = nf.formatterAt(address)
    applySymbols(df, f)
    f.*.failIfMoreThanMaxDigits = p.*.formatFailIfMoreThanMaxDigits
    if p.*.formatWidth > 0 {
        f.*.padWidth = p.*.formatWidth
        var pad = if p.*.padString.length > 0 { slice(&p.*.padString) } else { " " }
        var at: usize = 0
        _ = nd.decode(pad, &at)
        pad = pad[0..at]
        var index: usize = 0
        while index < pad.length && index < 16 {
            f.*.padText[index] = pad[index]
            index += 1
        }
        f.*.padLength = index
        f.*.padPosition = if p.*.padPosition < 0 { 0 } else { p.*.padPosition }
    }
    nf.destroy(df.*.formatter)
    df.*.formatter = address
    // The exported properties.
    df.*.currency = code.bytes
    df.*.roundingMode = mode
    df.*.minInt = minInt
    df.*.maxInt = if maxInt == -1 { INT32_MAX } else { maxInt }
    var minFracOut = minFrac
    var maxFracOut = maxFrac
    var minSigOut = minSig
    var maxSigOut = maxSig
    var incrementOut: f64 = 0.0
    if precision == sk.PRECISION_CURRENCY {
        const digits = currency.fractionDigits(&code, usage)
        const units = currency.roundingUnits(&code, usage)
        if units >= 2 {
            // The increment's minimum fraction digits: those of units / 10^digits.
            var mantissa = units
            var magnitude = -digits
            while mantissa % 10 == 0 {
                mantissa = mantissa / 10
                magnitude += 1
            }
            minFracOut = if magnitude > 0 { 0 } else { -magnitude }
            maxFracOut = minFracOut
            incrementOut = @floatFromInt(f64, units) / pow10(digits)
        } else {
            minFracOut = digits
            maxFracOut = digits
        }
    } else if precision == sk.PRECISION_FRACTION {
        minFracOut = precisionMinFrac
        maxFracOut = precisionMaxFrac
    } else if precision == sk.PRECISION_INCREMENT || precision == sk.PRECISION_INCREMENT_ONE || precision == sk.PRECISION_INCREMENT_FIVE {
        minFracOut = precisionIncrementMinFrac
        maxFracOut = precisionIncrementMinFrac
        incrementOut = @floatFromInt(f64, precisionIncrement) * pow10(precisionMagnitude)
    } else if precision == sk.PRECISION_SIGNIFICANT {
        minSigOut = precisionMinSig
        maxSigOut = precisionMaxSig
    }
    df.*.minFrac = minFracOut
    df.*.maxFrac = maxFracOut
    df.*.minSig = minSigOut
    df.*.maxSig = maxSigOut
    df.*.increment = incrementOut
    // NumberFormat's fields, as its setters clamp them.
    df.*.nfMaxInt = clampDigits(df.*.maxInt, 2000000000)
    if df.*.nfMinInt > df.*.nfMaxInt { df.*.nfMinInt = df.*.nfMaxInt }
    df.*.nfMinInt = clampDigits(df.*.minInt, 127)
    if df.*.nfMinInt > df.*.nfMaxInt { df.*.nfMaxInt = df.*.nfMinInt }
    df.*.nfMaxFrac = clampDigits(df.*.maxFrac, 2000000000)
    if df.*.nfMaxFrac < df.*.nfMinFrac { df.*.nfMinFrac = df.*.nfMaxFrac }
    df.*.nfMinFrac = clampDigits(df.*.minFrac, 127)
    if df.*.nfMaxFrac < df.*.nfMinFrac { df.*.nfMaxFrac = df.*.nfMinFrac }
    return 0
}

fn int8(value: i32) -> i32 { return @intCast(i32, @bitCast(i8, @intCast(u8, @bitCast(u32, value) & 255))) }

fn pushInteger(b: *m.Bytes, value: i64) -> void {
    var magnitude: u64 = if value < 0 { @bitCast(u64, 0 -% value) } else { @intCast(u64, value) }
    if value < 0 { m.pushByte(b, 45) }
    var reversed: [24]u8 = undefined
    var count: usize = 0
    while true {
        reversed[count] = 48 + @intCast(u8, magnitude % 10)
        count += 1
        magnitude /= 10
        if magnitude == 0 { break }
    }
    while count > 0 {
        count -= 1
        m.pushByte(b, reversed[count])
    }
}

// ---------------------------------------------------------------------------
// Making formats.

fn newFormat(localeId: usize) -> usize {
    const address = m.alloc(@sizeOf(Format))
    if address == 0 { return 0 }
    const df = formatAt(address)
    df.*.magic = MAGIC
    df.*.formatter = 0
    clearProperties(&df.*.p)
    df.*.nfMaxInt = 2000000000
    df.*.nfMinInt = 1
    df.*.nfMaxFrac = 3
    df.*.nfMinFrac = 0
    df.*.lenient = false
    df.*.context = CAPITALIZATION_NONE
    const id = if localeId == 0 { locale.defaultLocale() } else { m.cSlice(localeId) }
    var length: usize = 0
    while length < id.length && length < 159 {
        df.*.localeId[length] = id[length]
        length += 1
    }
    df.*.localeId[length] = 0
    df.*.localeLength = length
    df.*.valid[0] = 0
    df.*.actual[0] = 0
    df.*.customCurrency = false
    df.*.customIntl = false
    loadSymbols(df)
    return address
}

fn destroyFormat(address: usize) -> void {
    if !isFormat(address) { return }
    const df = formatAt(address)
    nf.destroy(df.*.formatter)
    freeProperties(&df.*.p)
    var index: usize = 0
    while index < SYMBOL_COUNT {
        freeText(&df.*.symbols[index])
        index += 1
    }
    freeText(&df.*.posPrefix)
    freeText(&df.*.posSuffix)
    freeText(&df.*.negPrefix)
    freeText(&df.*.negSuffix)
    freeText(&df.*.pluralPattern)
    df.*.magic = 0
    m.release(address)
}

pub fn cloneFormat(address: usize) -> usize {
    const copy = m.alloc(@sizeOf(Format))
    if copy == 0 { return 0 }
    m.copy(copy, address, @sizeOf(Format))
    const df = formatAt(copy)
    df.*.formatter = 0
    duplicateProperties(&df.*.p)
    var index: usize = 0
    while index < SYMBOL_COUNT {
        df.*.symbols[index] = duplicate(&df.*.symbols[index])
        index += 1
    }
    df.*.posPrefix = noText()
    df.*.posSuffix = noText()
    df.*.negPrefix = noText()
    df.*.negSuffix = noText()
    df.*.pluralPattern = duplicate(&df.*.pluralPattern)
    _ = touch(df)
    return copy
}

// The locales a format's data came from, as the resource bundle of the
// locale gives them.
fn setLocaleIds(df: *Format) -> void {
    var status: i32 = 0
    const bundle = ures.ures_open(0, @intFromPtr(&df.*.localeId), @intFromPtr(&status))
    if bundle == 0 { return }
    copyC(ures.ures_getLocaleByType(bundle, 1, @intFromPtr(&status)), &df.*.valid)
    copyC(ures.ures_getLocaleByType(bundle, 0, @intFromPtr(&status)), &df.*.actual)
    ures.ures_close(bundle)
}

fn copyC(text: usize, into: *[160]u8) -> void {
    if text == 0 { return }
    const bytes = m.cSlice(text)
    var index: usize = 0
    while index < bytes.length && index < 159 {
        into.*[index] = bytes[index]
        index += 1
    }
    into.*[index] = 0
}

// The plural names' pattern of the locale: the decimal pattern in the
// unit pattern for "other" with ¤¤¤ for the name (ICU's
// CurrencyPluralInfo).
fn pluralPatternOf(df: *Format, data: u32, ns: []const u8) -> void {
    const numberPattern = nf.patternFor(data, ns, nf.STYLE_DECIMAL)
    var k = nd.key("numbers/currencyFormats-numberSystem-latn/unitPattern-count-other")
    var unitPattern = nd.get(data, &k)
    if unitPattern.length == 0 { unitPattern = "{0} {1}" }
    // The positive and negative parts of the number pattern.
    var split = numberPattern.length
    var index: usize = 0
    while index < numberPattern.length {
        if numberPattern[index] == 59 {
            split = index
            break
        }
        index += 1
    }
    var b = m.bytesBuffer()
    putUnitPattern(&b, unitPattern, numberPattern[0..split])
    if split < numberPattern.length {
        m.pushByte(&b, 59)
        putUnitPattern(&b, unitPattern, numberPattern[split + 1..numberPattern.length])
    }
    assign(&df.*.pluralPattern, m.bytesText(&b))
    m.disposeBytes(&b)
}

fn putUnitPattern(b: *m.Bytes, unitPattern: []const u8, number: []const u8) -> void {
    var at: usize = 0
    while at < unitPattern.length {
        if unitPattern[at] == 123 && at + 2 < unitPattern.length && unitPattern[at + 2] == 125 {
            if unitPattern[at + 1] == 48 {
                m.pushText(b, number)
                at += 3
                continue
            }
            if unitPattern[at + 1] == 49 {
                m.pushText(b, "\u{A4}\u{A4}\u{A4}")
                at += 3
                continue
            }
        }
        m.pushByte(b, unitPattern[at])
        at += 1
    }
}

// A format of STYLE for the locale (ICU's NumberFormat::makeInstance and
// CompactDecimalFormat); 0 with the status set.
fn openStyle(style: i32, localeId: usize, status: usize) -> usize {
    const address = newFormat(localeId)
    if address == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    const df = formatAt(address)
    if style == STYLE_COMPACT_SHORT || style == STYLE_COMPACT_LONG {
        df.*.p.compactStyle = if style == STYLE_COMPACT_LONG { 1 } else { 0 }
        df.*.p.groupingSize = -2
        df.*.p.minimumGroupingDigits = 2
        _ = touch(df)
        return address
    }
    // The numbering system: an algorithmic one is rule-based (no RBNF data).
    var ns: [16]u8 = undefined
    var result: i32 = 0
    const nsLength = numbersystems.forLocale(localeText(df), &ns, &result)
    if result > 0 {
        m.setError(status, result)
        destroyFormat(address)
        return 0
    }
    const name = ns[0..nsLength]
    if numbersystems.isAlgorithmic(name) {
        m.setError(status, m.UNSUPPORTED_ERROR)
        destroyFormat(address)
        return 0
    }
    const data = resources.find(localeText(df))
    const cldrStyle = if style == STYLE_DECIMAL { nf.STYLE_DECIMAL } else if style == STYLE_PERCENT { nf.STYLE_PERCENT } else if style == STYLE_SCIENTIFIC { nf.STYLE_SCIENTIFIC } else if style == STYLE_CURRENCY_ACCOUNTING { nf.STYLE_ACCOUNTING } else { nf.STYLE_CURRENCY }
    var pattern = nf.patternFor(data, name, cldrStyle)
    if style == STYLE_CURRENCY || style == STYLE_CURRENCY_ISO || style == STYLE_CURRENCY_ACCOUNTING || style == STYLE_CASH_CURRENCY || style == STYLE_CURRENCY_STANDARD {
        // The pattern of the locale's currency, when it has its own.
        var code: currency.Code = undefined
        if currency.forLocale(localeText(df), &code) {
            var k = nd.key("numbers/currencies/")
            nd.add(&k, currency.codeText(&code))
            nd.add(&k, "/pattern")
            const own = nd.get(data, &k)
            if own.length > 0 { pattern = own }
        }
    }
    var b = m.bytesBuffer()
    if style == STYLE_CURRENCY_ISO {
        // ¤ becomes ¤¤.
        var at: usize = 0
        while at < pattern.length {
            const start = at
            const c = nd.decode(pattern, &at)
            m.pushText(&b, pattern[start..at])
            if c == 164 { m.pushText(&b, "\u{A4}") }
        }
    } else {
        m.pushText(&b, pattern)
    }
    const isCurrencyStyle = style == STYLE_CURRENCY || style == STYLE_CURRENCY_ISO || style == STYLE_CURRENCY_ACCOUNTING || style == STYLE_CASH_CURRENCY || style == STYLE_CURRENCY_STANDARD || style == STYLE_CURRENCY_PLURAL
    var fault = fromPattern(df, m.bytesText(&b), if isCurrencyStyle { IGNORE_ALWAYS } else { IGNORE_IF_CURRENCY })
    m.disposeBytes(&b)
    if style == STYLE_CURRENCY_PLURAL {
        df.*.p.currencyPlural = true
        pluralPatternOf(df, data, name)
    }
    if style == STYLE_CASH_CURRENCY { df.*.p.currencyUsage = currency.USAGE_CASH }
    if fault == 0 { fault = touch(df) }
    if fault > 0 {
        m.setError(status, fault)
        destroyFormat(address)
        return 0
    }
    setLocaleIds(df)
    return address
}

// ---------------------------------------------------------------------------
// Formatting.

// The micro-properties of the pattern's affixes for a sign (getAffixImpl).
fn affixMicros(f: *const nf.Formatter, negative: bool) -> nf.Micros {
    var micros: nf.Micros = undefined
    micros.rounder = f.*.rounder
    micros.scientific = false
    micros.exponent = 0
    micros.compact = false
    micros.compactPattern = ""
    micros.signType = np.resolveSign(f.*.sign, if negative { nq.SIGNUM_NEG } else { nq.SIGNUM_POS })
    micros.plural = nf.PLURAL_OTHER
    micros.outerPlural = 6
    micros.approximately = false
    return micros
}

// The prefix (IS_PREFIX) or suffix the format writes for a sign into B.
fn renderAffix(df: *const Format, isPrefix: bool, negative: bool, b: *nb.Builder) -> void {
    const f = formatterOf(df)
    const micros = affixMicros(f, negative)
    var whole = nb.builder()
    var prefixLength: usize = 0
    _ = nf.applyMiddlePrefix(f, &micros, &whole, 0, 0, &prefixLength)
    nb.clear(b)
    if isPrefix {
        _ = nb.insertUnits(b, 0, whole.units, prefixLength, nb.NONE)
    } else if whole.length > prefixLength {
        _ = nb.insertUnits(b, 0, whole.units + prefixLength * 2, whole.length - prefixLength, nb.NONE)
    }
    nb.dispose(&whole)
}

// Q formatted by the format into B; the status.
fn formatQuantity(df: *const Format, q: *nq.Quantity, b: *nb.Builder) -> i32 {
    var status: i32 = 0
    nf.format(formatterOf(df), q, b, &status)
    return status
}

// The end of every format call: the text into RESULT, the field position
// POS (a UFieldPosition: field, begin, end) or the iterator ITERATOR.
fn give(b: *const nb.Builder, failure: i32, result: usize, resultLength: i32, pos: usize, iterator: usize, ec: usize) -> i32 {
    if failure > 0 {
        m.setError(ec, failure)
        if pos != 0 {
            m.putI32(pos + 4, 0)
            m.putI32(pos + 8, 0)
        }
        return 0
    }
    if pos != 0 || iterator != 0 {
        const value = formatted.create(MAGIC, 0)
        var none: [1]nb.SpanInfo = undefined
        nb.toValue(b, value, 0, &none, 0)
        if pos != 0 {
            m.putI32(pos + 4, 0)
            m.putI32(pos + 8, 0)
            _ = nf.nextFieldPosition(value, pos, ec)
        }
        if iterator != 0 { formatted.fillIterator(iterator, value, 2) }
        formatted.destroy(value)
    }
    if m.failed(ec) { return @intCast(i32, b.*.length) }
    return nd.give16Units(b.*.units, b.*.length, result, resultLength, ec)
}

fn validFormat(fmt: usize, ec: usize) -> bool {
    if m.failed(ec) { return false }
    if !isFormat(fmt) {
        m.setError(ec, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    return true
}

fn formatInt64(fmt: usize, number: i64, result: usize, resultLength: i32, pos: usize, iterator: usize, ec: usize) -> i32 {
    if m.failed(ec) { return -1 }
    if !validFormat(fmt, ec) { return -1 }
    const qAddress = nq.create()
    const q = nq.at(qAddress)
    nq.setInt(q, number)
    var b = nb.builder()
    const failure = formatQuantity(formatAt(fmt), q, &b)
    const length = give(&b, failure, result, resultLength, pos, iterator, ec)
    nb.dispose(&b)
    nq.destroy(qAddress)
    return length
}

fn formatDouble(fmt: usize, number: f64, result: usize, resultLength: i32, pos: usize, iterator: usize, ec: usize) -> i32 {
    if m.failed(ec) { return -1 }
    if !validFormat(fmt, ec) { return -1 }
    const qAddress = nq.create()
    const q = nq.at(qAddress)
    nf.setDoubleWithSign(q, number)
    var b = nb.builder()
    const failure = formatQuantity(formatAt(fmt), q, &b)
    const length = give(&b, failure, result, resultLength, pos, iterator, ec)
    nb.dispose(&b)
    nq.destroy(qAddress)
    return length
}

// Decimal text (ICU's Formattable of a StringPiece) formatted.
fn formatDecimalText(fmt: usize, text: []const u8, result: usize, resultLength: i32, pos: usize, ec: usize) -> i32 {
    const qAddress = nq.create()
    const q = nq.at(qAddress)
    var length: i32 = 0
    if !nq.setText(q, text) {
        m.setError(ec, nf.DECIMAL_NUMBER_SYNTAX_ERROR)
    } else {
        var b = nb.builder()
        const failure = formatQuantity(formatAt(fmt), q, &b)
        length = give(&b, failure, result, resultLength, pos, 0, ec)
        nb.dispose(&b)
    }
    nq.destroy(qAddress)
    return length
}

pub fn unum_format(fmt: usize, number: i32, result: usize, resultLength: i32, pos: usize, status: usize) -> i32 {
    return formatInt64(fmt, @intCast(i64, number), result, resultLength, pos, 0, status)
}

pub fn unum_formatInt64(fmt: usize, number: i64, result: usize, resultLength: i32, pos: usize, status: usize) -> i32 {
    return formatInt64(fmt, number, result, resultLength, pos, 0, status)
}

pub fn unum_formatDouble(fmt: usize, number: f64, result: usize, resultLength: i32, pos: usize, status: usize) -> i32 {
    return formatDouble(fmt, number, result, resultLength, pos, 0, status)
}

pub fn unum_formatDoubleForFields(format: usize, number: f64, result: usize, resultLength: i32, fpositer: usize, status: usize) -> i32 {
    if m.failed(status) { return -1 }
    if (result == 0 && resultLength != 0) || (result != 0 && resultLength < 0) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return -1
    }
    return formatDouble(format, number, result, resultLength, 0, fpositer, status)
}

pub fn unum_formatDecimal(fmt: usize, number: usize, length: i32, result: usize, resultLength: i32, pos: usize, status: usize) -> i32 {
    if m.failed(status) { return -1 }
    if (result == 0 && resultLength != 0) || resultLength < 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return -1
    }
    if !validFormat(fmt, status) { return -1 }
    const count = if number == 0 { 0 } else if length < 0 { m.cLength(number) } else { @intCast(usize, length) }
    return formatDecimalText(fmt, if count == 0 { "" } else { m.bytes(number, count) }, result, resultLength, pos, status)
}

// A currency code of UTF-16 text as ICU's CurrencyUnit takes it: XXX for
// none; false with the status for a bad one.
fn currencyOf(text: usize, code: *[4]u8, status: usize) -> bool {
    code.* = [4]u8{ 88, 88, 88, 0 }
    if text == 0 || m.get16(text) == 0 { return true }
    if m.get16(text + 2) == 0 || m.get16(text + 4) == 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    var index: usize = 0
    while index < 3 {
        const unit = m.get16(text + index * 2)
        if unit >= 128 || unit == 0 {
            m.setError(status, INVARIANT_CONVERSION_ERROR)
            code.* = [4]u8{ 88, 88, 88, 0 }
            return false
        }
        code.*[index] = nd.upper(@intCast(u8, unit))
        index += 1
    }
    return true
}

// The currency of a format set (ICU's DecimalFormat::setCurrency): the
// property and the symbols' currency.
fn setCurrency(df: *Format, code: *const [4]u8) -> void {
    if df.*.p.hasCurrency && m.same(df.*.p.currency[0..3], code.*[0..3]) { return }
    df.*.p.hasCurrency = true
    df.*.p.currency = code.*
    const c = currency.Code.{ .bytes = code.*, .length = 3 }
    const look = currency.lookupOf(localeText(df))
    var found: i32 = 0
    const name = currency.name(look, &c, currency.SYMBOL_NAME, &found)
    setSymbolText(df, SYMBOL_INTL_CURRENCY, code.*[0..3])
    setSymbolText(df, SYMBOL_CURRENCY, if found == -1 || name.length == 0 { code.*[0..3] } else { name })
    // The currency's own separators, when the locale has them.
    const data = resources.find(localeText(df))
    var k = nd.key("numbers/currencies/")
    nd.add(&k, code.*[0..3])
    const base = k.length
    nd.add(&k, "/decimal")
    const decimalSep = nd.get(data, &k)
    k.length = base
    nd.add(&k, "/group")
    const groupSep = nd.get(data, &k)
    if decimalSep.length > 0 && groupSep.length > 0 {
        setSymbolText(df, SYMBOL_MONETARY_SEPARATOR, decimalSep)
        setSymbolText(df, SYMBOL_MONETARY_GROUPING, groupSep)
    }
    _ = touch(df)
}

pub fn unum_formatDoubleCurrency(fmt: usize, number: f64, currencyCode: usize, result: usize, resultLength: i32, pos: usize, status: usize) -> i32 {
    if m.failed(status) { return -1 }
    if !validFormat(fmt, status) { return -1 }
    var code: [4]u8 = undefined
    if !currencyOf(currencyCode, &code, status) { return 0 }
    const df = formatAt(fmt)
    if m.same(df.*.currency[0..3], code[0..3]) { return formatDouble(fmt, number, result, resultLength, pos, 0, status) }
    // Another currency: a copy of the format with it.
    const copy = cloneFormat(fmt)
    if copy == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    setCurrency(formatAt(copy), &code)
    const length = formatDouble(copy, number, result, resultLength, pos, 0, status)
    destroyFormat(copy)
    return length
}

pub fn unum_formatUFormattable(fmt: usize, number: usize, result: usize, resultLength: i32, pos: usize, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    if fmt == 0 || number == 0 || (result == 0 && resultLength != 0) || (result != 0 && resultLength < 0) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    if !validFormat(fmt, status) { return 0 }
    const v = valueAt(number)
    if (v.*.kind == UFMT_DOUBLE || v.*.kind == UFMT_LONG || v.*.kind == UFMT_INT64) && v.*.hasQuantity {
        return formatDecimalText(fmt, slice(&v.*.decimal), result, resultLength, pos, status)
    }
    if v.*.kind == UFMT_DOUBLE { return formatDouble(fmt, v.*.number, result, resultLength, pos, 0, status) }
    if v.*.kind == UFMT_LONG || v.*.kind == UFMT_INT64 { return formatInt64(fmt, v.*.integer, result, resultLength, pos, 0, status) }
    m.setError(status, INVALID_FORMAT_ERROR)
    return 0
}

// ---------------------------------------------------------------------------
// Parsing (ICU's NumberParserImpl over the properties): a greedy run of
// matchers, each taking what it can at the position and the run starting
// over after each take: the affixes (prefix and suffix patterns of the
// positive and negative subpatterns, token by token), the currency, the
// percent and permille signs and the signs (lenient), NaN, infinity,
// padding, ignorables, the digits with their separators (DecimalMatcher)
// and the exponent; then the affixes' flags, the validators and the
// multiplier. Strict unless UNUM_LENIENT_PARSE: then affixes are not
// required, grouping is not checked, more separators and signs pass and
// ignorables are skipped. Matches of strings fold case unless
// UNUM_PARSE_CASE_SENSITIVE.

const FLAG_NEGATIVE: u32 = 1
const FLAG_PERCENT: u32 = 2
const FLAG_PERMILLE: u32 = 4
const FLAG_HAS_EXPONENT: u32 = 8
const FLAG_HAS_DECIMAL: u32 = 32
const FLAG_NAN: u32 = 64
const FLAG_INFINITY: u32 = 128
const FLAG_FAIL: u32 = 256

// An affix not matched (ICU's bogus string) and one matched as empty.
const AFFIX_BOGUS: i32 = -1
const AFFIX_EMPTY: i32 = -2

const MATCH_AFFIX: i32 = 0
const MATCH_CURRENCY: i32 = 1
const MATCH_PERCENT: i32 = 2
const MATCH_PERMILLE: i32 = 3
const MATCH_PLUS: i32 = 4
const MATCH_MINUS: i32 = 5
const MATCH_NAN: i32 = 6
const MATCH_INFINITY: i32 = 7
const MATCH_PADDING: i32 = 8
const MATCH_IGNORABLES: i32 = 9
const MATCH_DECIMAL: i32 = 10
const MATCH_SCIENTIFIC: i32 = 11

const Matcher = struct {
    kind: i32
    // An affix pair: the indexes of its prefix and suffix patterns (-1
    // for none) and whether it is the negative subpattern's.
    prefix: i32
    suffix: i32
    negative: bool
}

const Parser = struct {
    df: *const Format
    f: *const nf.Formatter
    text: usize
    length: usize
    // The segment's offset and ICU's charEnd.
    at: usize
    end: usize
    strict: bool
    ignoreCase: bool
    integerOnly: bool
    groupingDisabled: bool
    monetary: bool
    foreignCurrency: bool
    decimalSeparator: []const u8
    groupingSeparator: []const u8
    grouping1: i32
    grouping2: i32
    // The affix patterns (with the signs put in) and the matchers.
    patterns: [6]m.Bytes
    patternCount: usize
    matchers: [24]Matcher
    matcherCount: usize
    // The result.
    flags: u32
    prefix: i32
    suffix: i32
    currency: [4]u8
    digits: m.Bytes
    hasQuantity: bool
    point: i32
    exponent: i32
    zeroed: bool
}

// The sets of ICU's static_unicode_sets (CLDR root's parse lenients).
fn inMinusSet(c: u32) -> bool { return c == 45 || c == 65293 || c == 65123 || c == 8208 || c == 8209 || c == 8210 || c == 8211 || c == 8722 || c == 8315 || c == 8331 || c == 10134 }
fn inPlusSet(c: u32) -> bool { return c == 43 || c == 65291 || c == 64297 || c == 65122 || c == 8314 || c == 8330 || c == 10133 }
fn inPercentSet(c: u32) -> bool { return c == 37 || c == 65285 || c == 65130 || c == 1642 }
fn inPermilleSet(c: u32) -> bool { return c == 8240 || c == 1545 }
fn inCommaSet(c: u32, strict: bool) -> bool {
    if c == 44 || c == 65292 || c == 65104 || c == 65040 || c == 11841 || c == 1643 { return true }
    return !strict && (c == 1548 || c == 12289 || c == 65105 || c == 65380 || c == 65041)
}
fn inPeriodSet(c: u32, strict: bool) -> bool {
    if c == 46 || c == 65294 || c == 8228 || c == 65106 || c == 65377 { return true }
    return !strict && (c == 12290 || c == 65042)
}
fn inApostropheSet(c: u32) -> bool { return c == 39 || c == 65287 || c == 8217 || c == 1370 || c == 8125 || c == 8127 || c == 700 }
fn inOtherGroupingSet(c: u32) -> bool { return c == 1644 || c == 8216 || c == 32 || c == 160 || (c >= 8192 && c <= 8202) || c == 8239 || c == 8287 || c == 12288 || inApostropheSet(c) }
fn inSeparatorSet(c: u32, strict: bool) -> bool { return inCommaSet(c, strict) || inPeriodSet(c, strict) || inOtherGroupingSet(c) }
fn isIgnorableFor(c: u32, strict: bool) -> bool { return if strict { isBidiControl(c) } else { nb.isIgnorable(c) } }
fn isBidiControl(c: u32) -> bool { return c == 1564 || c == 8206 || c == 8207 || (c >= 8234 && c <= 8238) || (c >= 8294 && c <= 8297) }

fn remaining(ps: *const Parser) -> usize { return ps.*.length - ps.*.at }

fn codePointAt(ps: *const Parser, at: usize, next: *usize) -> u32 {
    next.* = at
    if at >= ps.*.length { return 4294967295 }
    return nd.decode16(ps.*.text, ps.*.length, next)
}

fn foldAscii(c: u32) -> u32 { return if c >= 65 && c <= 90 { c + 32 } else { c } }

fn sameCodePoint(ps: *const Parser, a: u32, b: u32) -> bool {
    if a == b { return true }
    if !ps.*.ignoreCase { return false }
    return properties.simpleFold(@intCast(i32, a)) == properties.simpleFold(@intCast(i32, b))
}

// The units of TEXT at AT when all of it is there (case folded unless
// CASE_SENSITIVE), else -1.
fn fullMatch(ps: *const Parser, at: usize, text: []const u8, caseSensitive: bool) -> i32 {
    if text.length == 0 { return -1 }
    var here = at
    var k: usize = 0
    while k < text.length {
        if here >= ps.*.length { return -1 }
        const want = nd.decode(text, &k)
        const have = nd.decode16(ps.*.text, ps.*.length, &here)
        if want == have { continue }
        if caseSensitive || !sameCodePoint(ps, want, have) { return -1 }
    }
    return @intCast(i32, here - at)
}

fn consume(ps: *Parser, units: usize) -> void { ps.*.at += units }

fn setCharsConsumed(ps: *Parser) -> void { ps.*.end = ps.*.at }

fn seenNumber(ps: *const Parser) -> bool { return ps.*.hasQuantity || (ps.*.flags & (FLAG_NAN | FLAG_INFINITY)) != 0 }

// A symbol at the position: its string, else a code point of its set.
fn matchSymbol(ps: *Parser, symbol: []const u8, kind: i32) -> bool {
    const length = fullMatch(ps, ps.*.at, symbol, false)
    if length > 0 {
        consume(ps, @intCast(usize, length))
        return true
    }
    var next: usize = 0
    const c = codePointAt(ps, ps.*.at, &next)
    var inSet = false
    if kind == MATCH_MINUS {
        inSet = inMinusSet(c)
    } else if kind == MATCH_PLUS {
        inSet = inPlusSet(c)
    } else if kind == MATCH_PERCENT {
        inSet = inPercentSet(c)
    } else if kind == MATCH_PERMILLE {
        inSet = inPermilleSet(c)
    } else if kind == MATCH_INFINITY {
        inSet = c == 8734
    }
    if inSet {
        ps.*.at = next
        return true
    }
    return false
}

// A currency (CombinedCurrencyMatcher): the format's symbol, its ISO code,
// its long names; any currency's code when foreign currencies are
// allowed. Currency spacing around it is a weak match.
fn matchCurrencyAt(ps: *Parser) -> bool {
    if ps.*.currency[0] != 0 { return false }
    const f = ps.*.f
    const initial = ps.*.at
    if seenNumber(ps) {
        const spacing = fullMatch(ps, ps.*.at, f.*.spacingBefore, false)
        if spacing > 0 { consume(ps, @intCast(usize, spacing)) }
    }
    var code = ps.*.df.*.currency
    var matched = false
    const symbol = if f.*.isCurrency { f.*.currencySymbol } else { symbolText(ps.*.df, SYMBOL_CURRENCY) }
    var length = fullMatch(ps, ps.*.at, symbol, true)
    if length <= 0 { length = fullMatch(ps, ps.*.at, f.*.intlSymbol, true) }
    if length <= 0 && !f.*.isCurrency { length = fullMatch(ps, ps.*.at, symbolText(ps.*.df, SYMBOL_INTL_CURRENCY), true) }
    if length > 0 {
        matched = true
    } else {
        // The long names, the longest that matches.
        const c = currency.Code.{ .bytes = code, .length = 3 }
        const look = currency.lookupOf(localeText(ps.*.df))
        var best: i32 = 0
        var index: usize = 0
        while index < 6 {
            var found: i32 = 0
            const name = currency.pluralName(look, &c, nf.PLURAL_NAMES[index], &found)
            if found != -1 {
                const l = fullMatch(ps, ps.*.at, name, false)
                if l > best { best = l }
            }
            index += 1
        }
        if best > 0 {
            length = best
            matched = true
        }
    }
    if !matched && ps.*.foreignCurrency {
        const any = matchAnyCurrency(ps, &code)
        if any > 0 {
            length = any
            matched = true
        }
    }
    if !matched && ps.*.at + 3 <= ps.*.length {
        // An ISO code: the format's, or any when foreign ones are allowed.
        var iso: [4]u8 = [4]u8{ 0, 0, 0, 0 }
        var good = true
        var index: usize = 0
        while index < 3 {
            const unit = m.get16(ps.*.text + (ps.*.at + index) * 2)
            const upper = if unit >= 97 && unit <= 122 { unit - 32 } else { unit }
            if upper < 65 || upper > 90 { good = false }
            if good { iso[index] = @intCast(u8, upper) }
            index += 1
        }
        if good {
            const c = currency.Code.{ .bytes = iso, .length = 3 }
            if m.same(iso[0..3], code[0..3]) || (ps.*.foreignCurrency && currency.isKnown(&c)) {
                code = iso
                length = 3
                matched = true
            }
        }
    }
    if !matched {
        ps.*.at = initial
        return false
    }
    consume(ps, @intCast(usize, length))
    ps.*.currency = code
    setCharsConsumed(ps)
    if !seenNumber(ps) {
        const spacing = fullMatch(ps, ps.*.at, f.*.spacingAfter, false)
        if spacing > 0 { consume(ps, @intCast(usize, spacing)) }
    }
    return true
}

// The currency names of a locale for parsing (ICU's collectCurrencyNames):
// each currency's symbol and ISO code (matched as they are) and its
// display and plural names (case folded), kept for the last locales (a
// cache shared by the threads under a lock).
const NameEntry = struct {
    code: [4]u8
    folded: bool
    start: usize
    length: usize
}

const NAME_CACHE_SIZE: usize = 8
var nameLock: u32 = 0
var nameCacheNext: usize = 0
var nameCacheData: [8]u32 = undefined
var nameCacheEntries: [8]usize = undefined
var nameCacheCounts: [8]usize = undefined
var nameCachePools: [8]usize = undefined
var nameCacheUsed: [8]bool = undefined
var nameCacheReady: bool = false

fn lockNames() -> void {
    while @atomicRmw(u32, &nameLock, xchg, 1, acquire) != 0 {}
}

fn unlockNames() -> void { @atomicStore(u32, &nameLock, 0, release) }

fn addName(entries: *m.Bytes, pool: *m.Bytes, code: *const currency.Code, name: []const u8, folded: bool) -> void {
    if name.length == 0 { return }
    var entry = NameEntry.{ .code = code.*.bytes, .folded = folded, .start = pool.*.length, .length = name.length }
    m.pushText(pool, name)
    const bytes: [*]const u8 = unsafe { @ptrCast([*]const u8, &entry) }
    var k: usize = 0
    while k < @sizeOf(NameEntry) {
        m.pushByte(entries, bytes[k])
        k += 1
    }
}

// The slot of the names of DATA (made when missing); under the lock.
fn namesOf(ps: *const Parser) -> usize {
    const data = resources.find(localeText(ps.*.df))
    if !nameCacheReady {
        var k: usize = 0
        while k < NAME_CACHE_SIZE {
            nameCacheUsed[k] = false
            k += 1
        }
        nameCacheReady = true
    }
    var slot: usize = 0
    while slot < NAME_CACHE_SIZE {
        if nameCacheUsed[slot] && nameCacheData[slot] == data { return slot }
        slot += 1
    }
    const look = currency.lookupOf(localeText(ps.*.df))
    var entries = m.bytesBuffer()
    var pool = m.bytesBuffer()
    var c: currency.Code = undefined
    var index: usize = 0
    while currency.isoCodeAt(index, &c) {
        index += 1
        var found: i32 = 0
        const symbol = currency.name(look, &c, currency.SYMBOL_NAME, &found)
        if found != -1 { addName(&entries, &pool, &c, symbol, false) }
        addName(&entries, &pool, &c, currency.codeText(&c), false)
        const long = currency.name(look, &c, currency.LONG_NAME, &found)
        if found != -1 { addName(&entries, &pool, &c, long, true) }
        var plural: usize = 0
        while plural < 6 {
            const name = currency.pluralName(look, &c, nf.PLURAL_NAMES[plural], &found)
            if found != -1 { addName(&entries, &pool, &c, name, true) }
            plural += 1
        }
    }
    slot = nameCacheNext
    nameCacheNext = (nameCacheNext + 1) % NAME_CACHE_SIZE
    if nameCacheUsed[slot] {
        m.release(nameCacheEntries[slot])
        m.release(nameCachePools[slot])
    }
    nameCacheData[slot] = data
    nameCacheEntries[slot] = entries.address
    nameCacheCounts[slot] = entries.length / @sizeOf(NameEntry)
    nameCachePools[slot] = pool.address
    nameCacheUsed[slot] = true
    return slot
}

// Any currency of the locale (uprv_parseCurrency): the longest of the
// names (case folded) and of the symbols and ISO codes (case-sensitive),
// the names winning a tie.
fn matchAnyCurrency(ps: *Parser, code: *[4]u8) -> i32 {
    lockNames()
    const slot = namesOf(ps)
    var bestName: i32 = 0
    var bestSymbol: i32 = 0
    var nameCode: [4]u8 = [4]u8{ 0, 0, 0, 0 }
    var symbolCode: [4]u8 = [4]u8{ 0, 0, 0, 0 }
    const entries = nameCacheEntries[slot]
    const pool = nameCachePools[slot]
    var index: usize = 0
    while index < nameCacheCounts[slot] {
        const entry: *const NameEntry = unsafe { @ptrFromInt(*const NameEntry, entries + index * @sizeOf(NameEntry)) }
        index += 1
        const length = fullMatch(ps, ps.*.at, m.bytes(pool + entry.*.start, entry.*.length), !entry.*.folded)
        if entry.*.folded {
            if length > bestName {
                bestName = length
                nameCode = entry.*.code
            }
        } else if length > bestSymbol {
            bestSymbol = length
            symbolCode = entry.*.code
        }
    }
    unlockNames()
    if bestName > 0 && bestName >= bestSymbol {
        code.* = nameCode
        return bestName
    }
    if bestSymbol > 0 {
        code.* = symbolCode
        return bestSymbol
    }
    return 0
}

fn skipIgnorables(ps: *Parser) -> bool {
    const start = ps.*.at
    while ps.*.at < ps.*.length {
        var next: usize = 0
        const c = codePointAt(ps, ps.*.at, &next)
        if !isIgnorableFor(c, ps.*.strict) { break }
        ps.*.at = next
    }
    return ps.*.at != start
}

// One token of an affix pattern at the position (an AffixPatternMatcher's
// matchers); whether it took something.
fn matchToken(ps: *Parser, token: *const np.Token) -> bool {
    const f = ps.*.f
    const k = token.*.kind
    if k == np.TOKEN_LITERAL {
        var next: usize = 0
        const c = codePointAt(ps, ps.*.at, &next)
        if c == 4294967295 || !sameCodePoint(ps, token.*.codePoint, c) { return false }
        ps.*.at = next
        setCharsConsumed(ps)
        return true
    }
    if k == np.TOKEN_MINUS {
        if !matchSymbol(ps, f.*.minusSign, MATCH_MINUS) { return false }
        ps.*.flags |= FLAG_NEGATIVE
        setCharsConsumed(ps)
        return true
    }
    if k == np.TOKEN_PLUS {
        if !matchSymbol(ps, f.*.plusSign, MATCH_PLUS) { return false }
        setCharsConsumed(ps)
        return true
    }
    if k == np.TOKEN_PERCENT {
        if (ps.*.flags & FLAG_PERCENT) != 0 || !matchSymbol(ps, f.*.percentSign, MATCH_PERCENT) { return false }
        ps.*.flags |= FLAG_PERCENT
        setCharsConsumed(ps)
        return true
    }
    if k == np.TOKEN_PERMILLE {
        if (ps.*.flags & FLAG_PERMILLE) != 0 || !matchSymbol(ps, f.*.permilleSign, MATCH_PERMILLE) { return false }
        ps.*.flags |= FLAG_PERMILLE
        setCharsConsumed(ps)
        return true
    }
    if k == np.TOKEN_APPROXIMATELY { return false }
    return matchCurrencyAt(ps)
}

// An affix pattern at the position as a series of its tokens (with the
// ignorables between them when lenient); false and the state as it was
// when one fails.
fn matchAffixPattern(ps: *Parser, pattern: []const u8) -> bool {
    const startAt = ps.*.at
    const startEnd = ps.*.end
    const startFlags = ps.*.flags
    const startCurrency = ps.*.currency
    var at: usize = 0
    var state: i32 = 0
    var token = np.Token.{ .kind = 0, .codePoint = 0 }
    var count: usize = 0
    var lastIgnorable = false
    while np.nextToken(pattern, &at, &state, &token) {
        if !ps.*.strict {
            if count > 0 && !lastIgnorable { _ = skipIgnorables(ps) }
            if token.kind == np.TOKEN_LITERAL && nb.isIgnorable(token.codePoint) {
                lastIgnorable = true
                continue
            }
        }
        lastIgnorable = false
        count += 1
        if ps.*.at >= ps.*.length || !matchToken(ps, &token) {
            ps.*.at = startAt
            ps.*.end = startEnd
            ps.*.flags = startFlags
            ps.*.currency = startCurrency
            return false
        }
    }
    return true
}

// Whether a pattern makes matchers (an empty one, or only ignorables, does not).
fn patternHasMatchers(ps: *const Parser, pattern: []const u8) -> bool {
    var at: usize = 0
    var state: i32 = 0
    var token = np.Token.{ .kind = 0, .codePoint = 0 }
    while np.nextToken(pattern, &at, &state, &token) {
        if ps.*.strict || token.kind != np.TOKEN_LITERAL || !nb.isIgnorable(token.codePoint) { return true }
    }
    return false
}

fn patternText(ps: *Parser, index: i32) -> []const u8 {
    if index < 0 { return "" }
    return m.bytesText(&ps.*.patterns[@intCast(usize, index)])
}

// The index of the pattern of TEXT (added when new), -1 for no matchers.
fn patternIndex(ps: *Parser, text: []const u8) -> i32 {
    if !patternHasMatchers(ps, text) { return -1 }
    var index: usize = 0
    while index < ps.*.patternCount {
        if m.same(m.bytesText(&ps.*.patterns[index]), text) { return @intCast(i32, index) }
        index += 1
    }
    if ps.*.patternCount >= 6 { return -1 }
    ps.*.patterns[ps.*.patternCount] = m.bytesBuffer()
    m.pushText(&ps.*.patterns[ps.*.patternCount], text)
    ps.*.patternCount += 1
    return @intCast(i32, ps.*.patternCount - 1)
}

fn addMatcher(ps: *Parser, kind: i32, prefix: i32, suffix: i32, negative: bool) -> void {
    if ps.*.matcherCount >= 24 { return }
    ps.*.matchers[ps.*.matcherCount] = Matcher.{ .kind = kind, .prefix = prefix, .suffix = suffix, .negative = negative }
    ps.*.matcherCount += 1
}

// Whether an affix pattern is only symbols and ignorables.
fn onlySymbolsAndIgnorables(text: []const u8) -> bool {
    var at: usize = 0
    var state: i32 = 0
    var token = np.Token.{ .kind = 0, .codePoint = 0 }
    while np.nextToken(text, &at, &state, &token) {
        if token.kind == np.TOKEN_LITERAL && !nb.isIgnorable(token.codePoint) { return false }
    }
    return true
}

// The affix matchers (AffixMatcherWarehouse::createAffixMatchers).
fn addAffixMatchers(ps: *Parser) -> void {
    const df = ps.*.df
    const a = &ps.*.f.*.affixes
    const posPrefixText = slice(&df.*.posPrefix)
    const posSuffixText = slice(&df.*.posSuffix)
    const negPrefixText = slice(&df.*.negPrefix)
    const negSuffixText = slice(&df.*.negSuffix)
    if !ps.*.strict && onlySymbolsAndIgnorables(posPrefixText) && onlySymbolsAndIgnorables(posSuffixText) && onlySymbolsAndIgnorables(negPrefixText) && onlySymbolsAndIgnorables(negSuffixText) && !np.containsType(posSuffixText, np.TOKEN_PLUS) && !np.containsType(posSuffixText, np.TOKEN_MINUS) && !np.containsType(negSuffixText, np.TOKEN_PLUS) && !np.containsType(negSuffixText, np.TOKEN_MINUS) { return }
    const plusAllowed = df.*.p.signAlwaysShown
    const first = ps.*.matcherCount
    var posPrefix: i32 = -1
    var posSuffix: i32 = -1
    var type_: i32 = 0
    while type_ < 3 {
        // PatternSignType: POS, POS_SIGN, NEG.
        if (type_ == np.SIGN_POS && plusAllowed) || (type_ == np.SIGN_POS_SIGN && !plusAllowed) {
            type_ += 1
            continue
        }
        var b = m.bytesBuffer()
        np.affixPattern(a, true, type_, false, ps.*.f.*.isPermille, &b)
        const prefix = patternIndex(ps, m.bytesText(&b))
        m.disposeBytes(&b)
        b = m.bytesBuffer()
        np.affixPattern(a, false, type_, false, ps.*.f.*.isPermille, &b)
        const suffix = patternIndex(ps, m.bytesText(&b))
        m.disposeBytes(&b)
        const negative = type_ == np.SIGN_NEG
        if type_ != np.SIGN_NEG {
            posPrefix = prefix
            posSuffix = suffix
        } else if prefix == posPrefix && suffix == posSuffix {
            type_ += 1
            continue
        }
        addMatcher(ps, MATCH_AFFIX, prefix, suffix, negative)
        if !ps.*.strict && prefix >= 0 && suffix >= 0 {
            if type_ != np.SIGN_NEG || prefix != posPrefix { addMatcher(ps, MATCH_AFFIX, prefix, -1, negative) }
            if type_ != np.SIGN_NEG || suffix != posSuffix { addMatcher(ps, MATCH_AFFIX, -1, suffix, negative) }
        }
        type_ += 1
    }
    // The longer prefixes, then the longer suffixes, first.
    var changed = true
    while changed {
        changed = false
        var i = first + 1
        while i < ps.*.matcherCount {
            const left = ps.*.matchers[i - 1]
            const right = ps.*.matchers[i]
            const lp = patternText(ps, left.prefix).length
            const rp = patternText(ps, right.prefix).length
            const ls = patternText(ps, left.suffix).length
            const rs = patternText(ps, right.suffix).length
            if rp > lp || (rp == lp && rs > ls) {
                ps.*.matchers[i - 1] = right
                ps.*.matchers[i] = left
                changed = true
            }
            i += 1
        }
    }
}

fn affixMatched(affix: i32, matched: i32) -> bool { return (affix == -1 && matched == AFFIX_BOGUS) || (affix >= 0 && affix == matched) }

fn runAffix(ps: *Parser, mt: *const Matcher) -> void {
    if !seenNumber(ps) {
        if ps.*.prefix != AFFIX_BOGUS || mt.*.prefix < 0 { return }
        if matchAffixPattern(ps, patternText(ps, mt.*.prefix)) { ps.*.prefix = mt.*.prefix }
    } else {
        if ps.*.suffix != AFFIX_BOGUS || mt.*.suffix < 0 || !affixMatched(mt.*.prefix, ps.*.prefix) { return }
        if matchAffixPattern(ps, patternText(ps, mt.*.suffix)) { ps.*.suffix = mt.*.suffix }
    }
}

// A digit at the position: Unicode's decimal digits, else the symbols'
// digits when they are not Unicode's.
fn digitAt(ps: *Parser) -> i32 {
    var next: usize = 0
    const c = codePointAt(ps, ps.*.at, &next)
    if c < 1114112 && properties.category(@intCast(i32, c)) == 9 {
        ps.*.at = next
        return properties.digitValue(@intCast(i32, c))
    }
    const zero = ps.*.df.*.codePointZero
    if zero == -1 || properties.category(zero) != 9 || properties.digitValue(zero) != 0 {
        var digit: usize = 0
        while digit < 10 {
            const length = fullMatch(ps, ps.*.at, digitSymbol(ps.*.df, digit), false)
            if length > 0 {
                consume(ps, @intCast(usize, length))
                return @intCast(i32, digit)
            }
            digit += 1
        }
    }
    return -1
}

fn validateGroup(ps: *const Parser, sepType: i32, count: i32, isPrimary: bool) -> bool {
    if ps.*.strict {
        if sepType == -1 { return true }
        if sepType == 0 { return isPrimary || (count != 0 && count <= ps.*.grouping2) }
        if sepType == 1 { return if isPrimary { count == ps.*.grouping1 } else { count == ps.*.grouping2 } }
        return true
    }
    if sepType == 1 { return count != 1 }
    return true
}

// The digits with their separators (ICU's DecimalMatcher).
fn runDecimal(ps: *Parser) -> void {
    if seenNumber(ps) { return }
    const initial = ps.*.at
    var digits = m.bytesBuffer()
    var any = false
    var afterPoint: i32 = 0
    var decimalSeen = false
    var actualGrouping: u32 = 0
    var actualGroupingText: []const u8 = ""
    var groupingSeen = false
    var currGroupOffset: usize = 0
    var currGroupSepType: i32 = 0
    var currGroupCount: i32 = 0
    var prevGroupOffset: usize = 0
    var prevGroupOffsetSet = false
    var prevGroupSepType: i32 = -1
    var prevGroupCount: i32 = -1
    const strict = ps.*.strict
    const decimalText = ps.*.decimalSeparator
    const groupText = ps.*.groupingSeparator
    // The decimal set: the comma or period set holding the separator, or it.
    const decimalCp = firstCodePoint(decimalText)
    const decimalInComma = nd.codePoints(decimalText) == 1 && inCommaSet(decimalCp, strict)
    const decimalInPeriod = nd.codePoints(decimalText) == 1 && inPeriodSet(decimalCp, strict)
    while ps.*.at < ps.*.length {
        const digit = digitAt(ps)
        if digit >= 0 {
            m.pushByte(&digits, 48 + @intCast(u8, digit))
            any = true
            currGroupCount += 1
            if decimalSeen { afterPoint += 1 }
            continue
        }
        var isDecimal = false
        var isGrouping = false
        var separatorLength: usize = 0
        if !decimalSeen && decimalText.length > 0 {
            const length = fullMatch(ps, ps.*.at, decimalText, false)
            if length > 0 {
                isDecimal = true
                separatorLength = @intCast(usize, length)
            }
        }
        if groupingSeen && !isDecimal {
            const length = if actualGroupingText.length > 0 { fullMatch(ps, ps.*.at, actualGroupingText, false) } else { -1 }
            if length > 0 {
                isGrouping = true
                separatorLength = @intCast(usize, length)
            } else if actualGroupingText.length == 0 {
                var next: usize = 0
                if codePointAt(ps, ps.*.at, &next) == actualGrouping {
                    isGrouping = true
                    separatorLength = next - ps.*.at
                }
            }
        }
        if !ps.*.groupingDisabled && !groupingSeen && !decimalSeen && groupText.length > 0 && !isDecimal {
            const length = fullMatch(ps, ps.*.at, groupText, false)
            if length > 0 {
                isGrouping = true
                groupingSeen = true
                actualGroupingText = groupText
                separatorLength = @intCast(usize, length)
            }
        }
        var next: usize = 0
        const c = codePointAt(ps, ps.*.at, &next)
        if !isGrouping && !isDecimal && !decimalSeen {
            var inSet = false
            if decimalInComma {
                inSet = inCommaSet(c, strict)
            } else if decimalInPeriod {
                inSet = inPeriodSet(c, strict)
            } else {
                inSet = decimalText.length > 0 && c == decimalCp
            }
            if inSet {
                isDecimal = true
                separatorLength = next - ps.*.at
            }
        }
        if !ps.*.groupingDisabled && !groupingSeen && !decimalSeen && !isDecimal && !isGrouping {
            if inSeparatorSet(c, strict) {
                isGrouping = true
                groupingSeen = true
                actualGrouping = c
                actualGroupingText = ""
                separatorLength = next - ps.*.at
            }
        }
        if !isDecimal && !isGrouping { break }
        if isDecimal && ps.*.integerOnly { break }
        if currGroupSepType == 2 && isGrouping { break }
        const prevValidSecondary = validateGroup(ps, prevGroupSepType, prevGroupCount, false)
        const currValidPrimary = validateGroup(ps, currGroupSepType, currGroupCount, true)
        if !prevValidSecondary || (isDecimal && !currValidPrimary) {
            if isGrouping && currGroupCount == 0 {
                // A doubled separator.
            } else if strict {
                any = false
            }
            break
        } else if strict && currGroupCount == 0 && currGroupSepType == 1 {
            break
        } else {
            prevGroupOffset = currGroupOffset
            prevGroupOffsetSet = true
            prevGroupCount = currGroupCount
            prevGroupSepType = if isDecimal { -1 } else { currGroupSepType }
        }
        if currGroupCount != 0 { currGroupOffset = ps.*.at }
        currGroupSepType = if isGrouping { 1 } else { 2 }
        currGroupCount = 0
        if isDecimal { decimalSeen = true }
        consume(ps, separatorLength)
    }
    // A trailing separator does not count.
    if currGroupSepType != 2 && currGroupCount == 0 {
        ps.*.at = currGroupOffset
        currGroupOffset = prevGroupOffset
        currGroupSepType = prevGroupSepType
        currGroupCount = prevGroupCount
        prevGroupOffset = 0
        prevGroupSepType = 0
        prevGroupCount = 1
    }
    var prevValidSecondary = validateGroup(ps, prevGroupSepType, prevGroupCount, false)
    var currValidPrimary = validateGroup(ps, currGroupSepType, currGroupCount, true)
    if !strict {
        var remove: i32 = 0
        if !prevValidSecondary {
            ps.*.at = prevGroupOffset
            remove += prevGroupCount
            remove += currGroupCount
        } else if !currValidPrimary && (prevGroupSepType != 0 || prevGroupCount != 0) {
            ps.*.at = currGroupOffset
            remove += currGroupCount
        }
        while remove > 0 && digits.length > 0 {
            digits.length -= 1
            remove -= 1
        }
        if digits.length == 0 { any = false }
        prevValidSecondary = true
        currValidPrimary = true
    }
    if currGroupSepType != 2 && (!prevValidSecondary || !currValidPrimary) { any = false }
    if !any {
        m.disposeBytes(&digits)
        ps.*.at = initial
        return
    }
    m.disposeBytes(&ps.*.digits)
    ps.*.digits = digits
    ps.*.hasQuantity = true
    ps.*.point = @intCast(i32, digits.length) - afterPoint
    if decimalSeen { ps.*.flags |= FLAG_HAS_DECIMAL }
    setCharsConsumed(ps)
}

// The exponent (ScientificMatcher).
fn runScientific(ps: *Parser) -> void {
    if !seenNumber(ps) || (ps.*.flags & FLAG_HAS_EXPONENT) != 0 { return }
    const f = ps.*.f
    const initial = ps.*.at
    const length = fullMatch(ps, ps.*.at, f.*.exponential, false)
    if length <= 0 { return }
    consume(ps, @intCast(usize, length))
    while ps.*.at < ps.*.length {
        var next: usize = 0
        if !isBidiControl(codePointAt(ps, ps.*.at, &next)) { break }
        ps.*.at = next
    }
    if ps.*.at >= ps.*.length {
        ps.*.at = initial
        return
    }
    var sign: i32 = 1
    var next: usize = 0
    const c = codePointAt(ps, ps.*.at, &next)
    if inMinusSet(c) {
        sign = -1
        ps.*.at = next
    } else if fullMatch(ps, ps.*.at, f.*.minusSign, false) > 0 {
        sign = -1
        consume(ps, @intCast(usize, fullMatch(ps, ps.*.at, f.*.minusSign, false)))
    } else if inPlusSet(c) {
        ps.*.at = next
    } else if fullMatch(ps, ps.*.at, f.*.plusSign, false) > 0 {
        consume(ps, @intCast(usize, fullMatch(ps, ps.*.at, f.*.plusSign, false)))
    }
    var value: i64 = 0
    var seen = false
    var overflow = false
    while ps.*.at < ps.*.length {
        const save = ps.*.at
        const digit = digitAt(ps)
        if digit < 0 {
            ps.*.at = save
            break
        }
        seen = true
        if value > 2147483647 { overflow = true } else { value = value * 10 + @intCast(i64, digit) }
    }
    if !seen {
        ps.*.at = initial
        return
    }
    if value > 2147483647 { overflow = true }
    ps.*.flags |= FLAG_HAS_EXPONENT
    if overflow {
        if sign < 0 {
            ps.*.zeroed = true
        } else {
            ps.*.flags |= FLAG_INFINITY
        }
    } else {
        ps.*.exponent = sign * @intCast(i32, value)
    }
    setCharsConsumed(ps)
}

// The greedy run (NumberParserImpl::parseGreedy) and the post-processing.
fn runMatchers(ps: *Parser) -> void {
    var i: usize = 0
    while i < ps.*.matcherCount {
        if ps.*.at >= ps.*.length { return }
        const before = ps.*.at
        const mt = &ps.*.matchers[i]
        const k = mt.*.kind
        const f = ps.*.f
        if k == MATCH_AFFIX {
            runAffix(ps, mt)
        } else if k == MATCH_CURRENCY {
            _ = matchCurrencyAt(ps)
        } else if k == MATCH_PERCENT {
            if (ps.*.flags & FLAG_PERCENT) == 0 && matchSymbol(ps, f.*.percentSign, MATCH_PERCENT) {
                ps.*.flags |= FLAG_PERCENT
                setCharsConsumed(ps)
            }
        } else if k == MATCH_PERMILLE {
            if (ps.*.flags & FLAG_PERMILLE) == 0 && matchSymbol(ps, f.*.permilleSign, MATCH_PERMILLE) {
                ps.*.flags |= FLAG_PERMILLE
                setCharsConsumed(ps)
            }
        } else if k == MATCH_PLUS {
            if !seenNumber(ps) && matchSymbol(ps, f.*.plusSign, MATCH_PLUS) { setCharsConsumed(ps) }
        } else if k == MATCH_MINUS {
            if !seenNumber(ps) && matchSymbol(ps, f.*.minusSign, MATCH_MINUS) {
                ps.*.flags |= FLAG_NEGATIVE
                setCharsConsumed(ps)
            }
        } else if k == MATCH_NAN {
            if !seenNumber(ps) {
                const length = fullMatch(ps, ps.*.at, f.*.nanSymbol, false)
                if length > 0 {
                    consume(ps, @intCast(usize, length))
                    ps.*.flags |= FLAG_NAN
                    setCharsConsumed(ps)
                }
            }
        } else if k == MATCH_INFINITY {
            if (ps.*.flags & FLAG_INFINITY) == 0 && matchSymbol(ps, f.*.infinity, MATCH_INFINITY) {
                ps.*.flags |= FLAG_INFINITY
                setCharsConsumed(ps)
            }
        } else if k == MATCH_PADDING {
            const length = fullMatch(ps, ps.*.at, slice(&ps.*.df.*.p.padString), false)
            if length > 0 { consume(ps, @intCast(usize, length)) }
        } else if k == MATCH_IGNORABLES {
            _ = skipIgnorables(ps)
        } else if k == MATCH_DECIMAL {
            runDecimal(ps)
        } else if k == MATCH_SCIENTIFIC {
            runScientific(ps)
        }
        if ps.*.at != before { i = 0 } else { i += 1 }
    }
}

fn postProcess(ps: *Parser, parseCurrency: bool) -> void {
    var index: usize = 0
    while index < ps.*.matcherCount {
        const mt = &ps.*.matchers[index]
        if mt.*.kind == MATCH_AFFIX && affixMatched(mt.*.prefix, ps.*.prefix) && affixMatched(mt.*.suffix, ps.*.suffix) {
            if ps.*.prefix == AFFIX_BOGUS { ps.*.prefix = AFFIX_EMPTY }
            if ps.*.suffix == AFFIX_BOGUS { ps.*.suffix = AFFIX_EMPTY }
            if mt.*.negative { ps.*.flags |= FLAG_NEGATIVE }
        }
        index += 1
    }
    if !seenNumber(ps) { ps.*.flags |= FLAG_FAIL }
    if ps.*.strict && (ps.*.prefix == AFFIX_BOGUS || ps.*.suffix == AFFIX_BOGUS) { ps.*.flags |= FLAG_FAIL }
    if parseCurrency && ps.*.currency[0] == 0 { ps.*.flags |= FLAG_FAIL }
    const p = &ps.*.df.*.p
    if p.*.decimalPatternMatchRequired {
        const patternHasDecimal = p.*.decimalSeparatorAlwaysShown || p.*.maximumFractionDigits != 0
        if ((ps.*.flags & FLAG_HAS_DECIMAL) != 0) != patternHasDecimal { ps.*.flags |= FLAG_FAIL }
    }
}

fn makeParser(ps: *Parser, df: *const Format, text: usize, length: usize, start: usize, parseCurrency: bool) -> void {
    const f = formatterOf(df)
    const p = &df.*.p
    ps.*.df = df
    ps.*.f = f
    ps.*.text = text
    ps.*.length = length
    ps.*.at = start
    ps.*.end = 0
    ps.*.strict = p.*.parseMode != 0
    ps.*.ignoreCase = !p.*.parseCaseSensitive
    ps.*.integerOnly = p.*.parseIntegerOnly
    ps.*.monetary = parseCurrency || df.*.isCurrencyPattern
    ps.*.foreignCurrency = parseCurrency
    ps.*.decimalSeparator = symbolText(df, if ps.*.monetary { SYMBOL_MONETARY_SEPARATOR } else { SYMBOL_DECIMAL })
    ps.*.groupingSeparator = symbolText(df, if ps.*.monetary { SYMBOL_MONETARY_GROUPING } else { SYMBOL_GROUPING })
    // The grouping of the properties (Grouper::forProperties).
    var g1 = int16(p.*.groupingSize)
    var g2 = int16(p.*.secondaryGroupingSize)
    if !p.*.groupingUsed {
        g1 = -1
        g2 = -1
    } else {
        g1 = if g1 > 0 { g1 } else if g2 > 0 { g2 } else { g1 }
        g2 = if g2 > 0 { g2 } else { g1 }
    }
    ps.*.grouping1 = g1
    ps.*.grouping2 = g2
    ps.*.groupingDisabled = g1 <= 0
    ps.*.patternCount = 0
    ps.*.matcherCount = 0
    ps.*.flags = 0
    ps.*.prefix = AFFIX_BOGUS
    ps.*.suffix = AFFIX_BOGUS
    ps.*.currency = [4]u8{ 0, 0, 0, 0 }
    ps.*.digits = m.bytesBuffer()
    ps.*.hasQuantity = false
    ps.*.point = 0
    ps.*.exponent = 0
    ps.*.zeroed = false
    addAffixMatchers(ps)
    if parseCurrency || df.*.isCurrencyPattern { addMatcher(ps, MATCH_CURRENCY, -1, -1, false) }
    const a = &f.*.affixes
    if !ps.*.strict && affixesContain(a, np.TOKEN_PERCENT) { addMatcher(ps, MATCH_PERCENT, -1, -1, false) }
    if !ps.*.strict && affixesContain(a, np.TOKEN_PERMILLE) { addMatcher(ps, MATCH_PERMILLE, -1, -1, false) }
    if !ps.*.strict {
        addMatcher(ps, MATCH_PLUS, -1, -1, false)
        addMatcher(ps, MATCH_MINUS, -1, -1, false)
    }
    addMatcher(ps, MATCH_NAN, -1, -1, false)
    addMatcher(ps, MATCH_INFINITY, -1, -1, false)
    if p.*.padString.set && !(nd.codePoints(slice(&p.*.padString)) == 1 && isIgnorableFor(firstCodePoint(slice(&p.*.padString)), ps.*.strict)) { addMatcher(ps, MATCH_PADDING, -1, -1, false) }
    addMatcher(ps, MATCH_IGNORABLES, -1, -1, false)
    addMatcher(ps, MATCH_DECIMAL, -1, -1, false)
    if !p.*.parseNoExponent || p.*.minimumExponentDigits > 0 { addMatcher(ps, MATCH_SCIENTIFIC, -1, -1, false) }
}

fn affixesContain(a: *const np.Affixes, kind: i32) -> bool {
    return np.containsType(a.*.posPrefix, kind) || np.containsType(a.*.posSuffix, kind) || np.containsType(a.*.negPrefix, kind) || np.containsType(a.*.negSuffix, kind)
}

fn disposeParser(ps: *Parser) -> void {
    var index: usize = 0
    while index < ps.*.patternCount {
        m.disposeBytes(&ps.*.patterns[index])
        index += 1
    }
    m.disposeBytes(&ps.*.digits)
}

// A parse result (ICU's Formattable of a parse).
pub const Value = struct {
    magic: u32
    kind: i32
    number: f64
    integer: i64
    date: f64
    decimal: Text
    hasQuantity: bool
}

// UFormattableType.
const UFMT_DATE: i32 = 0
const UFMT_DOUBLE: i32 = 1
const UFMT_LONG: i32 = 2
const UFMT_STRING: i32 = 3
const UFMT_ARRAY: i32 = 4
const UFMT_INT64: i32 = 5
const UFMT_OBJECT: i32 = 6
const UFMT_COUNT: i32 = 7

fn valueAt(address: usize) -> *Value { unsafe { return @ptrFromInt(*Value, address) } }

fn resetValue(v: *Value) -> void {
    v.*.kind = UFMT_LONG
    v.*.number = 0.0
    v.*.integer = 0
    v.*.date = 0.0
    freeText(&v.*.decimal)
    v.*.hasQuantity = false
}

fn setDoubleValue(v: *Value, number: f64) -> void {
    resetValue(v)
    v.*.kind = UFMT_DOUBLE
    v.*.number = number
}

// Q's value as a 64-bit integer when it is an integer that fits.
fn quantityInt64(q: *const nq.Quantity, out: *i64) -> bool {
    const d = &q.*.d
    if d.*.nan || d.*.infinite { return false }
    if d.*.count == 0 {
        out.* = 0
        return true
    }
    if decimal.lowestPlace(d) < 0 || d.*.point > 19 { return false }
    var magnitude: u64 = 0
    var place: i32 = d.*.point - 1
    while place >= 0 {
        const digit = @intCast(u64, decimal.digitAt(d, place))
        if magnitude > 1844674407370955161 { return false }
        const next = magnitude * 10
        if next > 18446744073709551615 - digit { return false }
        magnitude = next + digit
        place -= 1
    }
    if d.*.negative {
        if magnitude > 9223372036854775808 { return false }
        out.* = 0 -% @bitCast(i64, magnitude)
    } else {
        if magnitude > 9223372036854775807 { return false }
        out.* = @bitCast(i64, magnitude)
    }
    return true
}

// Q's double (ICU's DecimalQuantity::toDouble: the closest double).
fn quantityDouble(q: *const nq.Quantity) -> f64 {
    var b = m.bytesBuffer()
    if q.*.d.negative { m.pushByte(&b, 45) }
    var index: usize = 0
    m.pushText(&b, "0.")
    while index < q.*.d.count {
        m.pushByte(&b, 48 + q.*.d.digits[index])
        index += 1
    }
    m.pushByte(&b, 101)
    pushInteger(&b, @intCast(i64, q.*.d.point))
    m.pushByte(&b, 0)
    const value = strtod(b.address, 0)
    m.disposeBytes(&b)
    return value
}

// Q as ICU's Formattable keeps a decimal number: plain for integers and
// magnitudes below 5, else "1.2345E+5".
fn decimalTextOf(q: *const nq.Quantity, integerType: bool, out: *m.Bytes) -> void {
    const d = &q.*.d
    if d.*.infinite {
        m.pushText(out, "Infinity")
        return
    }
    if d.*.nan {
        m.pushText(out, "NaN")
        return
    }
    if d.*.count == 0 {
        m.pushByte(out, 48)
        return
    }
    const mag = d.*.point - 1
    if integerType || (mag < 5 && mag > -5) {
        decimal.plainText(d, 0, out)
        return
    }
    if d.*.negative { m.pushByte(out, 45) }
    m.pushByte(out, 48 + d.*.digits[0])
    if d.*.count > 1 {
        m.pushByte(out, 46)
        var index: usize = 1
        while index < d.*.count {
            m.pushByte(out, 48 + d.*.digits[index])
            index += 1
        }
    }
    m.pushByte(out, 69)
    m.pushByte(out, if mag < 0 { 45 } else { 43 })
    pushInteger(out, @intCast(i64, if mag < 0 { -mag } else { mag }))
}

// Parses TEXT from *PARSE_POS (ICU's parseRes and DecimalFormat::parse)
// into V; the currency into CURRENCY_OUT when asked for one.
fn parseInto(fmt: usize, text: usize, textLength: i32, parsePos: usize, v: *Value, parseCurrency: bool, currencyOut: *[4]u8, status: usize) -> void {
    if m.failed(status) { return }
    if !isFormat(fmt) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    const df = formatAt(fmt)
    const length = if text == 0 { 0 } else { m.units(text, textLength) }
    const start = if parsePos != 0 { m.getI32(parsePos) } else { 0 }
    if start < 0 || start >= @intCast(i32, length) {
        // Nothing to parse is an error; a position outside the text is not.
        if start == @intCast(i32, length) {
            m.setError(status, PARSE_ERROR)
            if parsePos != 0 { m.putI32(parsePos, start) }
        }
        return
    }
    // CompactDecimalFormat does not parse: nothing, and no error.
    if df.*.p.compactStyle != -1 {
        if parseCurrency { m.setError(status, PARSE_ERROR) }
        return
    }
    var ps: Parser = undefined
    makeParser(&ps, df, text, length, @intCast(usize, start), parseCurrency)
    runMatchers(&ps)
    postProcess(&ps, parseCurrency)
    if ps.end == 0 || (ps.flags & FLAG_FAIL) != 0 {
        m.setError(status, PARSE_ERROR)
        // ICU's error index: the start and the absolute end of the match.
        if parsePos != 0 { m.putI32(parsePos, start + @intCast(i32, ps.end)) }
        disposeParser(&ps)
        return
    }
    if parsePos != 0 { m.putI32(parsePos, @intCast(i32, ps.end)) }
    currencyOut.* = ps.currency
    resetValue(v)
    const negative = (ps.flags & FLAG_NEGATIVE) != 0
    if (ps.flags & FLAG_NAN) != 0 {
        disposeParser(&ps)
        setDoubleValue(v, @bitCast(f64, @intCast(u64, 9221120237041090560)))
        return
    }
    if (ps.flags & FLAG_INFINITY) != 0 {
        disposeParser(&ps)
        setDoubleValue(v, @bitCast(f64, @intCast(u64, if negative { 18442240474082181120 } else { 9218868437227405312 })))
        return
    }
    // The digits, the point and the exponent, divided by the multipliers.
    var number = m.bytesBuffer()
    if ps.zeroed || ps.digits.length == 0 {
        m.pushByte(&number, 48)
    } else {
        m.pushText(&number, "0.")
        m.pushText(&number, m.bytesText(&ps.digits))
        m.pushByte(&number, 69)
        pushInteger(&number, @intCast(i64, ps.point) + @intCast(i64, ps.exponent))
    }
    disposeParser(&ps)
    const qAddress = nq.create()
    const q = nq.at(qAddress)
    _ = nq.setText(q, m.bytesText(&number))
    m.disposeBytes(&number)
    q.*.d.negative = negative
    const p = &df.*.p
    const magnitude = p.*.magnitudeMultiplier + p.*.multiplierScale
    if magnitude != 0 { nq.adjustMagnitude(q, -magnitude) }
    if p.*.multiplier != 1 {
        const value = quantityDouble(q) / @floatFromInt(f64, p.*.multiplier)
        nq.setDouble(q, value)
    }
    if nq.isZeroish(q) && q.*.d.negative && !p.*.parseIntegerOnly {
        nq.destroy(qAddress)
        setDoubleValue(v, @bitCast(f64, @intCast(u64, 9223372036854775808)))
        return
    }
    var integer: i64 = 0
    if quantityInt64(q, &integer) {
        v.*.integer = integer
        v.*.kind = if integer <= 2147483647 && integer >= -2147483648 { UFMT_LONG } else { UFMT_INT64 }
        v.*.number = @floatFromInt(f64, integer)
    } else {
        v.*.kind = UFMT_DOUBLE
        v.*.number = quantityDouble(q)
    }
    var decimalText = m.bytesBuffer()
    decimalTextOf(q, v.*.kind != UFMT_DOUBLE, &decimalText)
    assign(&v.*.decimal, m.bytesText(&decimalText))
    m.disposeBytes(&decimalText)
    v.*.hasQuantity = true
    nq.destroy(qAddress)
}

fn newValue() -> usize {
    const address = m.alloc(@sizeOf(Value))
    if address == 0 { return 0 }
    const v = valueAt(address)
    v.*.magic = VALUE_MAGIC
    v.*.decimal = noText()
    resetValue(v)
    return address
}

fn freeValue(address: usize) -> void {
    if address == 0 || m.get32(address) != VALUE_MAGIC { return }
    const v = valueAt(address)
    freeText(&v.*.decimal)
    v.*.magic = 0
    m.release(address)
}

// ICU's Formattable getters (C's casts of out-of-range doubles as x86
// makes them).
fn valueLong(v: *const Value, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    if v.*.kind == UFMT_LONG { return @intCast(i32, v.*.integer) }
    if v.*.kind == UFMT_INT64 {
        if v.*.integer > 2147483647 {
            m.setError(status, INVALID_FORMAT_ERROR)
            return INT32_MAX
        }
        if v.*.integer < -2147483648 {
            m.setError(status, INVALID_FORMAT_ERROR)
            return INT32_MIN
        }
        return @intCast(i32, v.*.integer)
    }
    if v.*.kind == UFMT_DOUBLE {
        const x = v.*.number
        if x > 2147483647.0 {
            m.setError(status, INVALID_FORMAT_ERROR)
            return INT32_MAX
        }
        if x < -2147483648.0 {
            m.setError(status, INVALID_FORMAT_ERROR)
            return INT32_MIN
        }
        if x != x { return INT32_MIN }
        return @intFromFloat(i32, x)
    }
    m.setError(status, INVALID_FORMAT_ERROR)
    return 0
}

fn valueInt64(v: *const Value, status: usize) -> i64 {
    if m.failed(status) { return 0 }
    if v.*.kind == UFMT_LONG || v.*.kind == UFMT_INT64 { return v.*.integer }
    if v.*.kind == UFMT_DOUBLE {
        const x = v.*.number
        if x > 9223372036854775807.0 {
            m.setError(status, INVALID_FORMAT_ERROR)
            return 9223372036854775807
        }
        if x < -9223372036854775808.0 {
            m.setError(status, INVALID_FORMAT_ERROR)
            return -9223372036854775807 - 1
        }
        if x != x { return -9223372036854775807 - 1 }
        const absolute = if x < 0.0 { -x } else { x }
        if absolute > 9007199254740992.0 && v.*.hasQuantity {
            const qAddress = nq.create()
            const q = nq.at(qAddress)
            _ = nq.setText(q, slice(&v.*.decimal))
            // The integer part, when it fits.
            var integer: i64 = 0
            const negative = q.*.d.negative
            const lowest = decimal.lowestPlace(&q.*.d)
            if lowest < 0 { decimal.roundAt(&q.*.d, 0, decimal.DOWN) }
            const fits = quantityInt64(q, &integer)
            nq.destroy(qAddress)
            if fits { return integer }
            m.setError(status, INVALID_FORMAT_ERROR)
            return if negative { -9223372036854775807 - 1 } else { 9223372036854775807 }
        }
        return @intFromFloat(i64, x)
    }
    m.setError(status, INVALID_FORMAT_ERROR)
    return 0
}

fn valueDouble(v: *const Value, status: usize) -> f64 {
    if m.failed(status) { return 0.0 }
    if v.*.kind == UFMT_LONG || v.*.kind == UFMT_INT64 { return @floatFromInt(f64, v.*.integer) }
    if v.*.kind == UFMT_DOUBLE { return v.*.number }
    m.setError(status, INVALID_FORMAT_ERROR)
    return 0.0
}

pub fn unum_parse(fmt: usize, text: usize, textLength: i32, parsePos: usize, status: usize) -> i32 {
    const address = newValue()
    var code: [4]u8 = undefined
    parseInto(fmt, text, textLength, parsePos, valueAt(address), false, &code, status)
    const result = valueLong(valueAt(address), status)
    freeValue(address)
    return result
}

pub fn unum_parseInt64(fmt: usize, text: usize, textLength: i32, parsePos: usize, status: usize) -> i64 {
    const address = newValue()
    var code: [4]u8 = undefined
    parseInto(fmt, text, textLength, parsePos, valueAt(address), false, &code, status)
    const result = valueInt64(valueAt(address), status)
    freeValue(address)
    return result
}

pub fn unum_parseDouble(fmt: usize, text: usize, textLength: i32, parsePos: usize, status: usize) -> f64 {
    const address = newValue()
    var code: [4]u8 = undefined
    parseInto(fmt, text, textLength, parsePos, valueAt(address), false, &code, status)
    const result = valueDouble(valueAt(address), status)
    freeValue(address)
    return result
}

// The decimal text of a value (Formattable::getDecimalNumber).
fn valueDecimal(v: *Value, status: usize) -> []const u8 {
    if v.*.decimal.set { return slice(&v.*.decimal) }
    const qAddress = nq.create()
    const q = nq.at(qAddress)
    if v.*.kind == UFMT_DOUBLE {
        nq.setDouble(q, v.*.number)
    } else if v.*.kind == UFMT_LONG || v.*.kind == UFMT_INT64 {
        nq.setInt(q, v.*.integer)
    } else {
        nq.destroy(qAddress)
        m.setError(status, INVALID_FORMAT_ERROR)
        return ""
    }
    var b = m.bytesBuffer()
    decimalTextOf(q, v.*.kind != UFMT_DOUBLE, &b)
    assign(&v.*.decimal, m.bytesText(&b))
    m.disposeBytes(&b)
    nq.destroy(qAddress)
    return slice(&v.*.decimal)
}

pub fn unum_parseDecimal(fmt: usize, text: usize, textLength: i32, parsePos: usize, outBuf: usize, outBufLength: i32, status: usize) -> i32 {
    if m.failed(status) { return -1 }
    if (outBuf == 0 && outBufLength != 0) || outBufLength < 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return -1
    }
    const address = newValue()
    var code: [4]u8 = undefined
    parseInto(fmt, text, textLength, parsePos, valueAt(address), false, &code, status)
    if m.failed(status) {
        freeValue(address)
        return -1
    }
    const number = valueDecimal(valueAt(address), status)
    if m.failed(status) {
        freeValue(address)
        return -1
    }
    const length = @intCast(i32, number.length)
    if length > outBufLength {
        m.setError(status, m.BUFFER_OVERFLOW_ERROR)
    } else {
        var index: usize = 0
        while index < number.length {
            m.put8(outBuf + index, number[index])
            index += 1
        }
        if length == outBufLength {
            m.setError(status, m.STRING_NOT_TERMINATED_WARNING)
        } else {
            m.put8(outBuf + number.length, 0)
        }
    }
    freeValue(address)
    return length
}

pub fn unum_parseDoubleCurrency(fmt: usize, text: usize, textLength: i32, parsePos: usize, currencyOut: usize, status: usize) -> f64 {
    if currencyOut != 0 { m.put16(currencyOut, 0) }
    if m.failed(status) { return 0.0 }
    const address = newValue()
    var code: [4]u8 = [4]u8{ 0, 0, 0, 0 }
    var local: i32 = 0
    parseInto(fmt, text, textLength, parsePos, valueAt(address), true, &code, @intFromPtr(&local))
    var result: f64 = 0.0
    if local > 0 {
        m.setError(status, PARSE_ERROR)
    } else {
        if currencyOut != 0 {
            var index: usize = 0
            while index < 3 {
                m.put16(currencyOut + index * 2, @intCast(u16, code[index]))
                index += 1
            }
            m.put16(currencyOut + 6, 0)
        }
        result = valueDouble(valueAt(address), status)
    }
    freeValue(address)
    return result
}

pub fn unum_parseToUFormattable(fmt: usize, result: usize, text: usize, textLength: i32, parsePos: usize, status: usize) -> usize {
    if m.failed(status) { return result }
    if fmt == 0 || (text == 0 && textLength != 0) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return result
    }
    var target = result
    var fresh: usize = 0
    if target == 0 {
        fresh = newValue()
        target = fresh
    }
    var code: [4]u8 = undefined
    parseInto(fmt, text, textLength, parsePos, valueAt(target), false, &code, status)
    if m.failed(status) && fresh != 0 {
        freeValue(fresh)
        return 0
    }
    return target
}

// ---------------------------------------------------------------------------
// UFormattable.

pub fn ufmt_open(status: usize) -> usize {
    if m.failed(status) { return 0 }
    const address = newValue()
    if address == 0 { m.setError(status, m.MEMORY_ALLOCATION_ERROR) }
    return address
}

pub fn ufmt_close(fmt: usize) -> void { freeValue(fmt) }

fn validValue(fmt: usize) -> bool { return fmt != 0 && m.get32(fmt) == VALUE_MAGIC }

pub fn ufmt_getType(fmt: usize, status: usize) -> i32 {
    if m.failed(status) { return UFMT_COUNT }
    if !validValue(fmt) { return UFMT_COUNT }
    return valueAt(fmt).*.kind
}

pub fn ufmt_isNumeric(fmt: usize) -> bool {
    if !validValue(fmt) { return false }
    const kind = valueAt(fmt).*.kind
    return kind == UFMT_DOUBLE || kind == UFMT_LONG || kind == UFMT_INT64
}

pub fn ufmt_getDate(fmt: usize, status: usize) -> f64 {
    if m.failed(status) { return 0.0 }
    if !validValue(fmt) || valueAt(fmt).*.kind != UFMT_DATE {
        m.setError(status, INVALID_FORMAT_ERROR)
        return 0.0
    }
    return valueAt(fmt).*.date
}

pub fn ufmt_getDouble(fmt: usize, status: usize) -> f64 {
    if !validValue(fmt) {
        if !m.failed(status) { m.setError(status, INVALID_FORMAT_ERROR) }
        return 0.0
    }
    return valueDouble(valueAt(fmt), status)
}

pub fn ufmt_getLong(fmt: usize, status: usize) -> i32 {
    if !validValue(fmt) {
        if !m.failed(status) { m.setError(status, INVALID_FORMAT_ERROR) }
        return 0
    }
    return valueLong(valueAt(fmt), status)
}

pub fn ufmt_getInt64(fmt: usize, status: usize) -> i64 {
    if !validValue(fmt) {
        if !m.failed(status) { m.setError(status, INVALID_FORMAT_ERROR) }
        return 0
    }
    return valueInt64(valueAt(fmt), status)
}

// Objects, strings and arrays are never made here: their getters fail.
pub fn ufmt_getObject(fmt: usize, status: usize) -> usize {
    if !m.failed(status) { m.setError(status, INVALID_FORMAT_ERROR) }
    return 0
}

pub fn ufmt_getUChars(fmt: usize, len: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    m.setError(status, INVALID_FORMAT_ERROR)
    return 0
}

pub fn ufmt_getArrayLength(fmt: usize, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    m.setError(status, INVALID_FORMAT_ERROR)
    return 0
}

pub fn ufmt_getArrayItemByIndex(fmt: usize, n: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    m.setError(status, INVALID_FORMAT_ERROR)
    return 0
}

pub fn ufmt_getDecNumChars(fmt: usize, len: usize, status: usize) -> usize {
    if m.failed(status) { return m.literal("\x00") }
    if !validValue(fmt) {
        m.setError(status, INVALID_FORMAT_ERROR)
        return m.literal("\x00")
    }
    const v = valueAt(fmt)
    const text = valueDecimal(v, status)
    if m.failed(status) { return m.literal("\x00") }
    if len != 0 { m.putI32(len, @intCast(i32, text.length)) }
    return v.*.decimal.address
}

// ---------------------------------------------------------------------------
// Patterns out (ICU's propertiesToPatternString and convertLocalized).

fn escapePadding(input: []const u8, out: *m.Bytes) -> void {
    const text = if input.length == 0 { " " } else { input }
    if nd.codePoints(text) == 1 {
        if m.same(text, "'") {
            m.pushText(out, "''")
        } else {
            m.pushText(out, text)
        }
        return
    }
    m.pushByte(out, 39)
    for byte in text {
        if byte == 39 {
            m.pushText(out, "''")
        } else {
            m.pushByte(out, byte)
        }
    }
    m.pushByte(out, 39)
}

fn insertAt(b: *m.Bytes, index: usize, text: []const u8) -> void {
    var rest = m.bytesBuffer()
    const whole = m.bytesText(b)
    m.pushText(&rest, whole[index..whole.length])
    b.*.length = index
    m.pushText(b, text)
    m.pushText(b, m.bytesText(&rest))
    m.disposeBytes(&rest)
}

fn minOf(a: i32, b: i32) -> i32 { return if a < b { a } else { b } }
fn maxOf(a: i32, b: i32) -> i32 { return if a > b { a } else { b } }

fn patternOf(df: *const Format, out: *m.Bytes) -> void {
    const p = &df.*.p
    // The currency's digits for a currency format (toPattern's tprops).
    var minFracProp = p.*.minimumFractionDigits
    var maxFracProp = p.*.maximumFractionDigits
    var increment = p.*.roundingIncrement
    const useCurrency = p.*.hasCurrency || p.*.currencyPlural || p.*.currencyUsage != -1 || p.*.currencyAsDecimal || df.*.isCurrencyPattern
    if useCurrency {
        minFracProp = df.*.minFrac
        maxFracProp = df.*.maxFrac
        increment = df.*.increment
    }
    const dosMax: i32 = 100
    var grouping1 = maxOf(0, minOf(p.*.groupingSize, dosMax))
    var grouping2 = maxOf(0, minOf(p.*.secondaryGroupingSize, dosMax))
    const useGrouping = p.*.groupingUsed
    const paddingWidth = minOf(p.*.formatWidth, dosMax)
    const minInt = maxOf(0, minOf(p.*.minimumIntegerDigits, dosMax))
    const maxInt = minOf(p.*.maximumIntegerDigits, dosMax)
    const minFrac = maxOf(0, minOf(minFracProp, dosMax))
    const maxFrac = minOf(maxFracProp, dosMax)
    const minSig = minOf(p.*.minimumSignificantDigits, dosMax)
    const maxSig = minOf(p.*.maximumSignificantDigits, dosMax)
    const alwaysShowDecimal = p.*.decimalSeparatorAlwaysShown
    const exponentDigits = minOf(p.*.minimumExponentDigits, dosMax)
    m.pushText(out, slice(&df.*.posPrefix))
    var afterPrefix = out.*.length
    if !useGrouping {
        grouping1 = 0
        grouping2 = 0
    } else if grouping1 == grouping2 {
        grouping1 = 0
    }
    const groupingLength = grouping1 + grouping2 + 1
    // The digits.
    var digits = m.bytesBuffer()
    var digitsScale: i32 = 0
    if maxSig != -1 {
        while @intCast(i32, digits.length) < minSig { m.pushByte(&digits, 64) }
        while @intCast(i32, digits.length) < maxSig { m.pushByte(&digits, 35) }
    } else if increment != 0.0 && !ignoreRoundingIncrement(increment, maxFrac) {
        const d = decimal.fromDouble(increment)
        digitsScale = decimal.lowestPlace(&d)
        // The digits of the increment, at least minInt - scale integer digits.
        const upper = maxOf(d.point - 1, minInt - digitsScale + digitsScale - 1)
        var place = upper
        while place >= digitsScale {
            m.pushByte(&digits, 48 + decimal.digitAt(&d, place))
            place -= 1
        }
    }
    while @intCast(i32, digits.length) + digitsScale < minInt { insertAt(&digits, 0, "0") }
    while -digitsScale < minFrac {
        m.pushByte(&digits, 48)
        digitsScale -= 1
    }
    const digitText = m.bytesText(&digits)
    var m0 = maxOf(groupingLength, @intCast(i32, digitText.length) + digitsScale)
    m0 = if maxInt != dosMax { maxOf(maxInt, m0) - 1 } else { m0 - 1 }
    const mN = if maxFrac != dosMax { minOf(-maxFrac, digitsScale) } else { digitsScale }
    var magnitude = m0
    while magnitude >= mN {
        const di = @intCast(i32, digitText.length) + digitsScale - magnitude - 1
        if di < 0 || di >= @intCast(i32, digitText.length) {
            m.pushByte(out, 35)
        } else {
            m.pushByte(out, digitText[@intCast(usize, di)])
        }
        if magnitude == 0 && (alwaysShowDecimal || mN < 0) {
            if p.*.currencyAsDecimal { m.pushText(out, "\u{A4}") } else { m.pushByte(out, 46) }
        }
        if useGrouping {
            if magnitude > 0 && magnitude == grouping1 { m.pushByte(out, 44) }
            if magnitude > grouping1 && grouping2 > 0 && (magnitude - grouping1) % grouping2 == 0 { m.pushByte(out, 44) }
        }
        magnitude -= 1
    }
    m.disposeBytes(&digits)
    if exponentDigits != -1 {
        m.pushByte(out, 69)
        if p.*.exponentSignAlwaysShown { m.pushByte(out, 43) }
        var k: i32 = 0
        while k < exponentDigits {
            m.pushByte(out, 48)
            k += 1
        }
    }
    var beforeSuffix = out.*.length
    m.pushText(out, slice(&df.*.posSuffix))
    // Padding.
    if paddingWidth > 0 && p.*.padPosition != -1 {
        while paddingWidth - @intCast(i32, nd.codePoints(m.bytesText(out))) > 0 {
            insertAt(out, afterPrefix, "#")
            beforeSuffix += 1
        }
        var padding = m.bytesBuffer()
        escapePadding(slice(&p.*.padString), &padding)
        const escaped = m.bytesText(&padding)
        const position = p.*.padPosition
        if position == np.PAD_BEFORE_PREFIX {
            insertAt(out, 0, escaped)
            insertAt(out, 0, "*")
            afterPrefix += escaped.length + 1
            beforeSuffix += escaped.length + 1
        } else if position == np.PAD_AFTER_PREFIX {
            insertAt(out, afterPrefix, escaped)
            insertAt(out, afterPrefix, "*")
            afterPrefix += escaped.length + 1
            beforeSuffix += escaped.length + 1
        } else if position == np.PAD_BEFORE_SUFFIX {
            insertAt(out, beforeSuffix, escaped)
            insertAt(out, beforeSuffix, "*")
        } else {
            m.pushByte(out, 42)
            m.pushText(out, escaped)
        }
        m.disposeBytes(&padding)
    }
    // The negative subpattern, when the affixes need one.
    if df.*.hasNegative {
        var body = m.bytesBuffer()
        const whole = m.bytesText(out)
        m.pushText(&body, whole[afterPrefix..beforeSuffix])
        m.pushByte(out, 59)
        m.pushText(out, slice(&df.*.negPrefix))
        m.pushText(out, m.bytesText(&body))
        m.pushText(out, slice(&df.*.negSuffix))
        m.disposeBytes(&body)
    }
}

// Converts a pattern between the standard symbols and the format's
// (TO_LOCALIZED); false for an unterminated quote.
fn convertLocalized(df: *const Format, input: []const u8, toLocalized: bool, out: *m.Bytes) -> bool {
    // The table of standard and localized strings (quotes made ’).
    var standard: [21][]const u8 = undefined
    var localized: [21]m.Bytes = undefined
    standard[0] = "%"
    standard[1] = "\u{2030}"
    standard[2] = "."
    standard[3] = ","
    standard[4] = "-"
    standard[5] = "+"
    standard[6] = ";"
    standard[7] = "@"
    standard[8] = "E"
    standard[9] = "*"
    standard[10] = "#"
    const sources = [11]usize{ SYMBOL_PERCENT, SYMBOL_PERMILL, SYMBOL_DECIMAL, SYMBOL_GROUPING, SYMBOL_MINUS, SYMBOL_PLUS, SYMBOL_PATTERN_SEPARATOR, SYMBOL_SIGNIFICANT_DIGIT, SYMBOL_EXPONENTIAL, SYMBOL_PAD_ESCAPE, SYMBOL_DIGIT }
    var index: usize = 0
    while index < 21 {
        localized[index] = m.bytesBuffer()
        const symbol = if index < 11 { symbolText(df, sources[index]) } else { digitSymbol(df, index - 11) }
        for byte in symbol {
            if byte == 39 { m.pushText(&localized[index], "\u{2019}") } else { m.pushByte(&localized[index], byte) }
        }
        if index >= 11 { standard[index] = "0123456789"[index - 11..index - 10] }
        index += 1
    }
    var state: i32 = 0
    var offset: usize = 0
    while offset < input.length {
        const ch = input[offset]
        if ch == 39 {
            if state == 0 {
                m.pushByte(out, 39)
                state = 1
            } else if state == 1 {
                m.pushByte(out, 39)
                state = 0
            } else if state == 2 {
                state = 3
            } else if state == 3 {
                m.pushText(out, "''")
                state = 1
            } else if state == 4 {
                state = 5
            } else {
                m.pushText(out, "''")
                state = 4
            }
            offset += 1
            continue
        }
        if state == 0 || state == 3 || state == 4 {
            var done = false
            var k: usize = 0
            while k < 21 && !done {
                const from = if toLocalized { standard[k] } else { m.bytesText(&localized[k]) }
                const to = if toLocalized { m.bytesText(&localized[k]) } else { standard[k] }
                if from.length > 0 && offset + from.length <= input.length && m.same(input[offset..offset + from.length], from) {
                    offset += from.length
                    if state == 3 || state == 4 {
                        m.pushByte(out, 39)
                        state = 0
                    }
                    m.pushText(out, to)
                    done = true
                }
                k += 1
            }
            if done { continue }
            // A special quote when the character is a symbol of the other side.
            k = 0
            while k < 21 && !done {
                const other = if toLocalized { m.bytesText(&localized[k]) } else { standard[k] }
                if other.length > 0 && offset + other.length <= input.length && m.same(input[offset..offset + other.length], other) {
                    if state == 0 {
                        m.pushByte(out, 39)
                        state = 4
                    }
                    m.pushByte(out, ch)
                    done = true
                }
                k += 1
            }
            if !done {
                if state == 3 || state == 4 {
                    m.pushByte(out, 39)
                    state = 0
                }
                m.pushByte(out, ch)
            }
        } else {
            m.pushByte(out, ch)
            state = 2
        }
        offset += 1
    }
    if state == 3 || state == 4 {
        m.pushByte(out, 39)
        state = 0
    }
    index = 0
    while index < 21 {
        m.disposeBytes(&localized[index])
        index += 1
    }
    return state == 0
}

// ---------------------------------------------------------------------------
// The C API: UNumberFormat.

pub fn unum_open(style: i32, pattern: usize, patternLength: i32, localeId: usize, parseErr: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if !resources.available() {
        m.setError(status, m.MISSING_RESOURCE_ERROR)
        return 0
    }
    if style == STYLE_PATTERN_DECIMAL {
        const address = newFormat(localeId)
        if address == 0 {
            m.setError(status, m.MEMORY_ALLOCATION_ERROR)
            return 0
        }
        const df = formatAt(address)
        var b = m.bytesBuffer()
        utf8Of(pattern, patternLength, &b)
        var fault = fromPattern(df, m.bytesText(&b), IGNORE_IF_CURRENCY)
        m.disposeBytes(&b)
        if fault == 0 { fault = touch(df) }
        if fault > 0 {
            m.setError(status, fault)
            destroyFormat(address)
            return 0
        }
        return address
    }
    if style == STYLE_NUMBERING_SYSTEM {
        // With a numbering system in the locale: the decimal style; else
        // rule-based.
        const id = if localeId == 0 { locale.defaultLocale() } else { m.cSlice(localeId) }
        if locale.keyword(id, "numbers").length > 0 { return openStyle(STYLE_DECIMAL, localeId, status) }
        m.setError(status, m.UNSUPPORTED_ERROR)
        return 0
    }
    if style == STYLE_DECIMAL || style == STYLE_CURRENCY || style == STYLE_PERCENT || style == STYLE_SCIENTIFIC || style == STYLE_CURRENCY_ISO || style == STYLE_CURRENCY_PLURAL || style == STYLE_CURRENCY_ACCOUNTING || style == STYLE_CASH_CURRENCY || style == STYLE_CURRENCY_STANDARD || style == STYLE_COMPACT_SHORT || style == STYLE_COMPACT_LONG {
        return openStyle(style, localeId, status)
    }
    // Spellout, ordinal, duration and rule patterns: RBNF.
    m.setError(status, m.UNSUPPORTED_ERROR)
    return 0
}

// The format a relative date formatter makes when given none.
pub fn openDecimal(localeId: usize, status: usize) -> usize { return unum_open(STYLE_DECIMAL, 0, 0, localeId, 0, status) }

pub fn close(fmt: usize) -> void { destroyFormat(fmt) }

pub fn unum_close(fmt: usize) -> void { destroyFormat(fmt) }

pub fn unum_clone(fmt: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if !isFormat(fmt) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const copy = cloneFormat(fmt)
    if copy == 0 { m.setError(status, m.MEMORY_ALLOCATION_ERROR) }
    return copy
}

pub fn unum_applyPattern(format: usize, localized: bool, pattern: usize, patternLength: i32, parseError: usize, status: usize) -> void {
    var local: i32 = 0
    const ec = if status == 0 { @intFromPtr(&local) } else { status }
    if !isFormat(format) {
        m.setError(ec, m.UNSUPPORTED_ERROR)
        return
    }
    if m.failed(ec) { return }
    const df = formatAt(format)
    var b = m.bytesBuffer()
    utf8Of(pattern, patternLength, &b)
    var standard = m.bytesBuffer()
    var good = true
    if localized {
        good = convertLocalized(df, m.bytesText(&b), false, &standard)
    } else {
        m.pushText(&standard, m.bytesText(&b))
    }
    m.disposeBytes(&b)
    if !good {
        m.disposeBytes(&standard)
        m.setError(ec, np.PATTERN_SYNTAX_ERROR)
        return
    }
    var fault = fromPattern(df, m.bytesText(&standard), IGNORE_NEVER)
    m.disposeBytes(&standard)
    if fault == 0 { fault = touch(df) }
    if fault > 0 { m.setError(ec, fault) }
}

pub fn unum_toPattern(fmt: usize, isPatternLocalized: bool, result: usize, resultLength: i32, status: usize) -> i32 {
    if m.failed(status) { return -1 }
    if !isFormat(fmt) { return nd.give16("", result, resultLength, status) }
    const df = formatAt(fmt)
    var b = m.bytesBuffer()
    patternOf(df, &b)
    var length: i32 = 0
    if isPatternLocalized {
        var local = m.bytesBuffer()
        _ = convertLocalized(df, m.bytesText(&b), true, &local)
        length = nd.give16(m.bytesText(&local), result, resultLength, status)
        m.disposeBytes(&local)
    } else {
        length = nd.give16(m.bytesText(&b), result, resultLength, status)
    }
    m.disposeBytes(&b)
    return length
}

pub fn unum_getAvailable(localeIndex: i32) -> usize { return uloc.uloc_getAvailable(localeIndex) }

pub fn unum_countAvailable() -> i32 { return uloc.uloc_countAvailable() }

pub fn unum_hasAttribute(fmt: usize, attr: i32) -> bool {
    if attr == LENIENT_PARSE || attr == MAX_INTEGER_DIGITS || attr == MIN_INTEGER_DIGITS || attr == INTEGER_DIGITS || attr == MAX_FRACTION_DIGITS || attr == MIN_FRACTION_DIGITS || attr == FRACTION_DIGITS || attr == ROUNDING_MODE { return true }
    return isFormat(fmt)
}

pub fn unum_getAttribute(fmt: usize, attr: i32) -> i32 {
    if !isFormat(fmt) { return -1 }
    const df = formatAt(fmt)
    const p = &df.*.p
    if attr == LENIENT_PARSE { return if df.*.lenient { 1 } else { 0 } }
    if attr == MAX_INTEGER_DIGITS { return df.*.nfMaxInt }
    if attr == MIN_INTEGER_DIGITS || attr == INTEGER_DIGITS { return df.*.nfMinInt }
    if attr == MAX_FRACTION_DIGITS { return df.*.nfMaxFrac }
    if attr == MIN_FRACTION_DIGITS || attr == FRACTION_DIGITS { return df.*.nfMinFrac }
    if attr == ROUNDING_MODE { return df.*.roundingMode }
    if attr == PARSE_INT_ONLY { return flag(p.*.parseIntegerOnly) }
    if attr == GROUPING_USED { return flag(p.*.groupingUsed) }
    if attr == DECIMAL_ALWAYS_SHOWN { return flag(p.*.decimalSeparatorAlwaysShown) }
    if attr == SIGNIFICANT_DIGITS_USED { return flag(p.*.minimumSignificantDigits != -1 || p.*.maximumSignificantDigits != -1) }
    if attr == MAX_SIGNIFICANT_DIGITS { return df.*.maxSig }
    if attr == MIN_SIGNIFICANT_DIGITS { return df.*.minSig }
    if attr == MULTIPLIER {
        if p.*.multiplier != 1 { return p.*.multiplier }
        if p.*.magnitudeMultiplier != 0 { return @intFromFloat(i32, pow10(p.*.magnitudeMultiplier)) }
        return 1
    }
    if attr == SCALE { return p.*.multiplierScale }
    if attr == GROUPING_SIZE { return if p.*.groupingSize < 0 { 0 } else { p.*.groupingSize } }
    if attr == SECONDARY_GROUPING_SIZE { return if p.*.secondaryGroupingSize < 0 { 0 } else { p.*.secondaryGroupingSize } }
    if attr == FORMAT_WIDTH { return p.*.formatWidth }
    if attr == PADDING_POSITION { return if p.*.padPosition < 0 { 0 } else { p.*.padPosition } }
    if attr == PARSE_NO_EXPONENT { return flag(p.*.parseNoExponent) }
    if attr == PARSE_DECIMAL_MARK_REQUIRED { return flag(p.*.decimalPatternMatchRequired) }
    if attr == CURRENCY_USAGE { return if p.*.currencyUsage < 0 { 0 } else { p.*.currencyUsage } }
    if attr == MINIMUM_GROUPING_DIGITS { return p.*.minimumGroupingDigits }
    if attr == PARSE_CASE_SENSITIVE { return flag(p.*.parseCaseSensitive) }
    if attr == SIGN_ALWAYS_SHOWN { return flag(p.*.signAlwaysShown) }
    if attr == FORMAT_FAIL_IF_MORE_THAN_MAX_DIGITS { return flag(p.*.formatFailIfMoreThanMaxDigits) }
    return -1
}

fn flag(value: bool) -> i32 { return if value { 1 } else { 0 } }

// The setters (ICU's DecimalFormat): a change of the properties, then the
// formatter made again.
fn setMaxInt(df: *Format, value: i32) -> void {
    const p = &df.*.p
    if value == p.*.maximumIntegerDigits { return }
    if p.*.minimumIntegerDigits >= 0 && p.*.minimumIntegerDigits > value { p.*.minimumIntegerDigits = value }
    p.*.maximumIntegerDigits = value
}

fn setMinInt(df: *Format, value: i32) -> void {
    const p = &df.*.p
    if value == p.*.minimumIntegerDigits { return }
    if p.*.maximumIntegerDigits >= 0 && p.*.maximumIntegerDigits < value { p.*.maximumIntegerDigits = value }
    p.*.minimumIntegerDigits = value
}

fn setMaxFrac(df: *Format, given: i32) -> void {
    const p = &df.*.p
    if given == p.*.maximumFractionDigits { return }
    const value = if given > MAX_INT_FRAC_SIG { MAX_INT_FRAC_SIG } else { given }
    if p.*.minimumFractionDigits >= 0 && p.*.minimumFractionDigits > value { p.*.minimumFractionDigits = value }
    p.*.maximumFractionDigits = value
}

fn setMinFrac(df: *Format, value: i32) -> void {
    const p = &df.*.p
    if value == p.*.minimumFractionDigits { return }
    if p.*.maximumFractionDigits >= 0 && p.*.maximumFractionDigits < value { p.*.maximumFractionDigits = value }
    p.*.minimumFractionDigits = value
}

pub fn unum_setAttribute(fmt: usize, attr: i32, newValue: i32) -> void {
    if !isFormat(fmt) { return }
    const df = formatAt(fmt)
    const p = &df.*.p
    const on = newValue != 0
    if attr == LENIENT_PARSE {
        df.*.lenient = on
        p.*.parseMode = if on { 0 } else { 1 }
    } else if attr == MAX_INTEGER_DIGITS {
        setMaxInt(df, newValue)
    } else if attr == MIN_INTEGER_DIGITS {
        setMinInt(df, newValue)
    } else if attr == INTEGER_DIGITS {
        setMinInt(df, newValue)
        _ = touch(df)
        setMaxInt(df, newValue)
    } else if attr == MAX_FRACTION_DIGITS {
        setMaxFrac(df, newValue)
    } else if attr == MIN_FRACTION_DIGITS {
        setMinFrac(df, newValue)
    } else if attr == FRACTION_DIGITS {
        setMinFrac(df, newValue)
        _ = touch(df)
        setMaxFrac(df, newValue)
    } else if attr == ROUNDING_MODE {
        p.*.roundingMode = newValue
    } else if attr == PARSE_INT_ONLY {
        p.*.parseIntegerOnly = on
    } else if attr == GROUPING_USED {
        p.*.groupingUsed = on
    } else if attr == DECIMAL_ALWAYS_SHOWN {
        p.*.decimalSeparatorAlwaysShown = on
    } else if attr == SIGNIFICANT_DIGITS_USED {
        if on && p.*.minimumSignificantDigits == -1 && p.*.maximumSignificantDigits == -1 {
            p.*.minimumSignificantDigits = 1
            p.*.maximumSignificantDigits = 6
        } else if !on {
            p.*.minimumSignificantDigits = -1
            p.*.maximumSignificantDigits = -1
        }
    } else if attr == MAX_SIGNIFICANT_DIGITS {
        if newValue != p.*.maximumSignificantDigits {
            if p.*.minimumSignificantDigits >= 0 && p.*.minimumSignificantDigits > newValue { p.*.minimumSignificantDigits = newValue }
            p.*.maximumSignificantDigits = newValue
        }
    } else if attr == MIN_SIGNIFICANT_DIGITS {
        if newValue != p.*.minimumSignificantDigits {
            if p.*.maximumSignificantDigits >= 0 && p.*.maximumSignificantDigits < newValue { p.*.maximumSignificantDigits = newValue }
            p.*.minimumSignificantDigits = newValue
        }
    } else if attr == MULTIPLIER {
        // A power of ten is a magnitude.
        const multiplier = if newValue == 0 { 1 } else { newValue }
        var delta: i32 = 0
        var value = multiplier
        while value != 1 {
            delta += 1
            const quotient = value / 10
            if quotient * 10 != value {
                delta = -1
                break
            }
            value = quotient
        }
        if delta != -1 {
            p.*.magnitudeMultiplier = delta
            p.*.multiplier = 1
        } else {
            p.*.magnitudeMultiplier = 0
            p.*.multiplier = multiplier
        }
    } else if attr == SCALE {
        p.*.multiplierScale = newValue
    } else if attr == GROUPING_SIZE {
        p.*.groupingSize = newValue
    } else if attr == SECONDARY_GROUPING_SIZE {
        p.*.secondaryGroupingSize = newValue
    } else if attr == FORMAT_WIDTH {
        p.*.formatWidth = newValue
    } else if attr == PADDING_POSITION {
        p.*.padPosition = newValue
    } else if attr == PARSE_ALL_INPUT {
        p.*.parseAllInput = newValue
    } else if attr == PARSE_NO_EXPONENT {
        p.*.parseNoExponent = on
    } else if attr == PARSE_DECIMAL_MARK_REQUIRED {
        p.*.decimalPatternMatchRequired = on
    } else if attr == CURRENCY_USAGE {
        p.*.currencyUsage = newValue
    } else if attr == MINIMUM_GROUPING_DIGITS {
        p.*.minimumGroupingDigits = newValue
    } else if attr == PARSE_CASE_SENSITIVE {
        p.*.parseCaseSensitive = on
    } else if attr == SIGN_ALWAYS_SHOWN {
        p.*.signAlwaysShown = on
    } else if attr == FORMAT_FAIL_IF_MORE_THAN_MAX_DIGITS {
        p.*.formatFailIfMoreThanMaxDigits = on
    } else {
        return
    }
    _ = touch(df)
}

pub fn unum_getDoubleAttribute(fmt: usize, attr: i32) -> f64 {
    if isFormat(fmt) && attr == ROUNDING_INCREMENT { return formatAt(fmt).*.increment }
    return -1.0
}

pub fn unum_setDoubleAttribute(fmt: usize, attr: i32, newValue: f64) -> void {
    if !isFormat(fmt) || attr != ROUNDING_INCREMENT { return }
    const df = formatAt(fmt)
    var same = false
    if newValue == df.*.p.roundingIncrement { same = true }
    if same { return }
    df.*.p.roundingIncrement = newValue
    _ = touch(df)
}

pub fn unum_getTextAttribute(fmt: usize, tag: i32, result: usize, resultLength: i32, status: usize) -> i32 {
    if m.failed(status) { return -1 }
    if !isFormat(fmt) {
        m.setError(status, m.UNSUPPORTED_ERROR)
        return -1
    }
    const df = formatAt(fmt)
    if tag == POSITIVE_PREFIX || tag == POSITIVE_SUFFIX || tag == NEGATIVE_PREFIX || tag == NEGATIVE_SUFFIX {
        var b = nb.builder()
        renderAffix(df, tag == POSITIVE_PREFIX || tag == NEGATIVE_PREFIX, tag == NEGATIVE_PREFIX || tag == NEGATIVE_SUFFIX, &b)
        const length = nd.give16Units(b.units, b.length, result, resultLength, status)
        nb.dispose(&b)
        return length
    }
    if tag == PADDING_CHARACTER { return nd.give16(if df.*.p.padString.set { slice(&df.*.p.padString) } else { " " }, result, resultLength, status) }
    if tag == CURRENCY_CODE { return nd.give16(df.*.currency[0..3], result, resultLength, status) }
    m.setError(status, m.UNSUPPORTED_ERROR)
    return -1
}

pub fn unum_setTextAttribute(fmt: usize, tag: i32, newValue: usize, newValueLength: i32, status: usize) -> void {
    if m.failed(status) { return }
    if !isFormat(fmt) {
        m.setError(status, m.UNSUPPORTED_ERROR)
        return
    }
    const df = formatAt(fmt)
    const p = &df.*.p
    var b = m.bytesBuffer()
    utf8Of(newValue, newValueLength, &b)
    const value = m.bytesText(&b)
    if tag == POSITIVE_PREFIX || tag == POSITIVE_SUFFIX || tag == NEGATIVE_PREFIX || tag == NEGATIVE_SUFFIX {
        const target = if tag == POSITIVE_PREFIX { &p.*.positivePrefix } else if tag == POSITIVE_SUFFIX { &p.*.positiveSuffix } else if tag == NEGATIVE_PREFIX { &p.*.negativePrefix } else { &p.*.negativeSuffix }
        if !(target.*.set && m.same(slice(target), value)) {
            assign(target, value)
            _ = touch(df)
        }
    } else if tag == PADDING_CHARACTER {
        if value.length > 0 {
            var at: usize = 0
            _ = nd.decode(value, &at)
            assign(&p.*.padString, value[0..at])
        } else {
            freeText(&p.*.padString)
        }
        _ = touch(df)
    } else if tag == CURRENCY_CODE {
        // UTF-16 of the value, NUL-terminated, as CurrencyUnit reads it.
        var units: [4]u16 = [4]u16{ 0, 0, 0, 0 }
        const count = if newValue == 0 { 0 } else { m.units(newValue, newValueLength) }
        var index: usize = 0
        while index < 3 && index < count {
            units[index] = m.get16(newValue + index * 2)
            index += 1
        }
        var code: [4]u8 = undefined
        if currencyOf(@intFromPtr(&units), &code, status) { setCurrency(df, &code) }
    } else {
        m.setError(status, m.UNSUPPORTED_ERROR)
    }
    m.disposeBytes(&b)
}

pub fn unum_getSymbol(fmt: usize, symbol: i32, buffer: usize, size: i32, status: usize) -> i32 {
    if status == 0 || m.failed(status) { return 0 }
    if fmt == 0 || symbol < 0 || symbol >= @intCast(i32, SYMBOL_COUNT) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    if !isFormat(fmt) {
        m.setError(status, m.UNSUPPORTED_ERROR)
        return 0
    }
    return nd.give16(symbolText(formatAt(fmt), @intCast(usize, symbol)), buffer, size, status)
}

pub fn unum_setSymbol(fmt: usize, symbol: i32, value: usize, length: i32, status: usize) -> void {
    if status == 0 || m.failed(status) { return }
    if fmt == 0 || symbol < 0 || symbol >= @intCast(i32, SYMBOL_COUNT) || value == 0 || length < -1 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    if !isFormat(fmt) {
        m.setError(status, m.UNSUPPORTED_ERROR)
        return
    }
    const df = formatAt(fmt)
    const which = @intCast(usize, symbol)
    var b = m.bytesBuffer()
    utf8Of(value, length, &b)
    const text = m.bytesText(&b)
    if which == SYMBOL_CURRENCY { df.*.customCurrency = true }
    if which == SYMBOL_INTL_CURRENCY { df.*.customIntl = true }
    setSymbolText(df, which, text)
    // A zero digit of Unicode's sets the nine after it.
    if which == SYMBOL_ZERO_DIGIT {
        const zero = firstCodePoint(text)
        if text.length > 0 && properties.digitValue(@intCast(i32, zero)) == 0 && nd.codePoints(text) == 1 {
            df.*.codePointZero = @intCast(i32, zero)
            var digit: usize = 1
            while digit <= 9 {
                var d = m.bytesBuffer()
                nd.appendUtf8(&d, zero + @intCast(u32, digit))
                setSymbolText(df, SYMBOL_ONE_DIGIT + digit - 1, m.bytesText(&d))
                m.disposeBytes(&d)
                digit += 1
            }
        } else {
            df.*.codePointZero = -1
        }
    } else if which >= SYMBOL_ONE_DIGIT && which < SYMBOL_ONE_DIGIT + 9 {
        df.*.codePointZero = -1
    }
    m.disposeBytes(&b)
    _ = touch(df)
}

pub fn unum_getLocaleByType(fmt: usize, type_: i32, status: usize) -> usize {
    if fmt == 0 {
        if !m.failed(status) { m.setError(status, m.ILLEGAL_ARGUMENT_ERROR) }
        return 0
    }
    if m.failed(status) { return 0 }
    if !isFormat(fmt) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const df = formatAt(fmt)
    if type_ == 0 { return @intFromPtr(&df.*.actual) }
    if type_ == 1 { return @intFromPtr(&df.*.valid) }
    m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
    return 0
}

pub fn unum_setContext(fmt: usize, value: i32, status: usize) -> void {
    if m.failed(status) { return }
    if !isFormat(fmt) { return }
    if (value >> 8) == TYPE_CAPITALIZATION {
        formatAt(fmt).*.context = value
    } else {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
    }
}

pub fn unum_getContext(fmt: usize, type_: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    if type_ != TYPE_CAPITALIZATION || !isFormat(fmt) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    return formatAt(fmt).*.context
}
