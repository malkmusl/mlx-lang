// What the number formatters share of the locale data (locale/resources.mlx):
// keys put together in a buffer and looked up for a locale, the
// supplemental data, UTF-8 read a code point at a time, and UTF-16
// copies of the data's strings kept for the library's life (for the C
// functions that hand back a string of the data, as ICU hands back its
// resource bundle's).
const m = @import("std.unicode.memory")
const resources = @import("std.unicode.locale.resources")

pub const Key = struct {
    bytes: [512]u8
    length: usize
}

pub fn key(first: []const u8) -> Key {
    var k: Key = undefined
    k.length = 0
    add(&k, first)
    return k
}

pub fn add(k: *Key, text: []const u8) -> void {
    for byte in text {
        if k.*.length < 511 {
            k.*.bytes[k.*.length] = byte
            k.*.length += 1
        }
    }
}

pub fn addByte(k: *Key, byte: u8) -> void {
    if k.*.length < 511 {
        k.*.bytes[k.*.length] = byte
        k.*.length += 1
    }
}

pub fn addNumber(k: *Key, value: u64) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[count] = 48 + @intCast(u8, rest % 10)
        count += 1
        rest /= 10
        if rest == 0 { break }
    }
    while count > 0 {
        count -= 1
        addByte(k, digits[count])
    }
}

// The value of the key for LOCALE (its parents after it).
pub fn lookup(locale: u32, k: *const Key, value: *[]const u8) -> bool {
    if locale == resources.NONE { return false }
    return resources.lookup(locale, k.*.bytes[0..k.*.length], value)
}

pub fn get(locale: u32, k: *const Key) -> []const u8 {
    var value: []const u8 = ""
    if lookup(locale, k, &value) { return value }
    return ""
}

// Whether locale ID names DATA itself (its language, script, region
// and variants, `_` or `-` between them), not a locale DATA stands in
// for: ICU's resource bundles are then its own, not a fallback's.
pub fn isExactly(id: []const u8, data: u32) -> bool {
    if data == resources.NONE { return false }
    const name = resources.localeName(data)
    var end: usize = 0
    while end < id.length && id[end] != 64 { end += 1 }
    // A tag's extensions are not part of the name.
    var cut: usize = 0
    while cut + 2 < end {
        if (id[cut] == 45 || id[cut] == 95) && (id[cut + 2] == 45 || id[cut + 2] == 95) {
            end = cut
            break
        }
        cut += 1
    }
    const base = id[0..end]
    if base.length == 0 || sameIgnoringCase(base, "root") { return m.same(name, "und") }
    if base.length != name.length { return false }
    var index: usize = 0
    while index < base.length {
        const a = if base[index] == 95 { 45 } else { lower(base[index]) }
        if a != lower(name[index]) { return false }
        index += 1
    }
    return true
}

// The string ID of the key's value for LOCALE, resources.NONE when none.
pub fn valueId(locale: u32, k: *const Key) -> u32 {
    if locale == resources.NONE { return resources.NONE }
    return resources.valueOf(locale, resources.key(k.*.bytes[0..k.*.length]))
}

pub fn supplemental(k: *const Key) -> []const u8 { return get(resources.supplemental(), k) }

// The index of the key, resources.NONE when no locale has it.
pub fn keyIndex(k: *const Key) -> u32 { return resources.key(k.*.bytes[0..k.*.length]) }

// The keys below the key (resources.below).
pub fn below(k: *const Key, first: *u32, end: *u32) -> void { resources.below(k.*.bytes[0..k.*.length], first, end) }

// ---------------------------------------------------------------------------
// Text.

// The code point of UTF-8 TEXT at AT, AT moved past it.
pub fn decode(utf8: []const u8, at: *usize) -> u32 {
    const b = utf8[at.*]
    var c: u32 = 0
    var extra: usize = 0
    if b < 128 {
        c = @intCast(u32, b)
    } else if b >= 240 {
        c = @intCast(u32, b & 7)
        extra = 3
    } else if b >= 224 {
        c = @intCast(u32, b & 15)
        extra = 2
    } else {
        c = @intCast(u32, b & 31)
        extra = 1
    }
    var k: usize = 0
    while k < extra && at.* + 1 + k < utf8.length {
        c = (c << 6) | @intCast(u32, utf8[at.* + 1 + k] & 63)
        k += 1
    }
    at.* += 1 + extra
    return c
}

// The number of code points of UTF-8 TEXT.
pub fn codePoints(utf8: []const u8) -> usize {
    var count: usize = 0
    var at: usize = 0
    while at < utf8.length {
        _ = decode(utf8, &at)
        count += 1
    }
    return count
}

pub fn lower(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }
pub fn upper(byte: u8) -> u8 { return if byte >= 97 && byte <= 122 { byte - 32 } else { byte } }

pub fn sameIgnoringCase(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if lower(a[index]) != lower(b[index]) { return false }
        index += 1
    }
    return true
}

pub fn startsWith(text: []const u8, prefix: []const u8) -> bool {
    return text.length >= prefix.length && m.same(text[0..prefix.length], prefix)
}

pub fn endsWith(text: []const u8, suffix: []const u8) -> bool {
    return text.length >= suffix.length && m.same(text[text.length - suffix.length..text.length], suffix)
}

// UTF-16 units of C (at most 2) into OUT; their count.
pub fn units(c: u32, out: *[2]u16) -> usize {
    if c < 65536 {
        out.*[0] = @intCast(u16, c)
        return 1
    }
    const v = c - 65536
    out.*[0] = @intCast(u16, 55296 + (v >> 10))
    out.*[1] = @intCast(u16, 56320 + (v & 1023))
    return 2
}

// The code point of UTF-16 TEXT (LENGTH units) at AT, AT moved past it.
pub fn decode16(text16: usize, length: usize, at: *usize) -> u32 {
    var c = @intCast(u32, m.get16(text16 + at.* * 2))
    at.* += 1
    if c >= 55296 && c <= 56319 && at.* < length {
        const trail = @intCast(u32, m.get16(text16 + at.* * 2))
        if trail >= 56320 && trail <= 57343 {
            c = (c << 10) + trail - 56613888
            at.* += 1
        }
    }
    return c
}

// UTF-16 TEXT (LENGTH units) as UTF-8 into OUT.
pub fn toUtf8(text16: usize, length: usize, out: *m.Bytes) -> void {
    var at: usize = 0
    while at < length {
        appendUtf8(out, decode16(text16, length, &at))
    }
}

pub fn appendUtf8(out: *m.Bytes, c: u32) -> void {
    if c < 128 {
        m.pushByte(out, @intCast(u8, c))
    } else if c < 2048 {
        m.pushByte(out, @intCast(u8, 192 | (c >> 6)))
        m.pushByte(out, @intCast(u8, 128 | (c & 63)))
    } else if c < 65536 {
        m.pushByte(out, @intCast(u8, 224 | (c >> 12)))
        m.pushByte(out, @intCast(u8, 128 | ((c >> 6) & 63)))
        m.pushByte(out, @intCast(u8, 128 | (c & 63)))
    } else {
        m.pushByte(out, @intCast(u8, 240 | (c >> 18)))
        m.pushByte(out, @intCast(u8, 128 | ((c >> 12) & 63)))
        m.pushByte(out, @intCast(u8, 128 | ((c >> 6) & 63)))
        m.pushByte(out, @intCast(u8, 128 | (c & 63)))
    }
}

// UTF-8 TEXT as UTF-16 into DEST (CAPACITY units) with the NUL and the
// status as C's results have them; its length.
pub fn give16(utf8: []const u8, dest: usize, capacity: i32, status: usize) -> i32 {
    const room = if capacity > 0 { @intCast(usize, capacity) } else { 0 }
    var length: usize = 0
    var at: usize = 0
    while at < utf8.length {
        var pair: [2]u16 = undefined
        const n = units(decode(utf8, &at), &pair)
        var k: usize = 0
        while k < n {
            if length < room && dest != 0 { m.put16(dest + length * 2, pair[k]) }
            length += 1
            k += 1
        }
    }
    return m.terminate(dest, length, capacity, status)
}

// UTF-16 SOURCE (COUNT units) into DEST the same way.
pub fn give16Units(source: usize, count: usize, dest: usize, capacity: i32, status: usize) -> i32 {
    const room = if capacity > 0 { @intCast(usize, capacity) } else { 0 }
    var index: usize = 0
    while index < count && index < room && dest != 0 {
        m.put16(dest + index * 2, m.get16(source + index * 2))
        index += 1
    }
    return m.terminate(dest, count, capacity, status)
}

// ---------------------------------------------------------------------------
// UTF-16 copies of the data's strings, by string ID, kept for good (an
// open-addressed table; a string asked for by two threads at once may
// be copied twice, which costs only the copy).

const SLOTS: usize = 4096
var slotIds: [4096]u32 = undefined
var slotCopies: [4096]usize = undefined
var slotLengths: [4096]u32 = undefined
var slotsReady: bool = false

// The UTF-16 copy (NUL-terminated) of data string ID, its length into
// LENGTH (an i32 *, may be 0).
pub fn utf16OfString(id: u32, length: usize) -> usize {
    if !slotsReady {
        var index: usize = 0
        while index < SLOTS {
            slotIds[index] = resources.NONE
            slotCopies[index] = 0
            index += 1
        }
        slotsReady = true
    }
    var slot = @intCast(usize, (id *% 2654435761) % 4096)
    var probes: usize = 0
    while probes < SLOTS {
        if slotIds[slot] == id && slotCopies[slot] != 0 {
            if length != 0 { m.putI32(length, @intCast(i32, slotLengths[slot])) }
            return slotCopies[slot]
        }
        if slotCopies[slot] == 0 { break }
        slot = (slot + 1) % SLOTS
        probes += 1
    }
    const value = resources.string(id)
    const copy = utf16Copy(value)
    const count = units16(copy)
    if probes < SLOTS {
        slotLengths[slot] = @intCast(u32, count)
        slotIds[slot] = id
        slotCopies[slot] = copy
    }
    if length != 0 { m.putI32(length, @intCast(i32, count)) }
    return copy
}

// A UTF-16 copy of UTF-8 TEXT, NUL-terminated, in C memory.
pub fn utf16Copy(utf8: []const u8) -> usize {
    const copy = m.alloc(utf8.length * 2 + 2)
    var length: usize = 0
    var at: usize = 0
    while at < utf8.length {
        var pair: [2]u16 = undefined
        const n = units(decode(utf8, &at), &pair)
        var k: usize = 0
        while k < n {
            m.put16(copy + length * 2, pair[k])
            length += 1
            k += 1
        }
    }
    m.put16(copy + length * 2, 0)
    return copy
}

pub fn units16(text16: usize) -> usize {
    var count: usize = 0
    while m.get16(text16 + count * 2) != 0 { count += 1 }
    return count
}

// A C string's copy (NUL-terminated) in C memory.
pub fn copyC(text: []const u8) -> usize {
    const copy = m.alloc(text.length + 1)
    m.copy(copy, @intFromPtr(text.pointer), text.length)
    return copy
}
