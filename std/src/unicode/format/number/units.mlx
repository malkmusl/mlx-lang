// Measure units for the number formatters (format/number.mlx): ICU 74's
// MeasureUnit (the built-in units, TYPE-SUBTYPE, and the units of a core
// unit identifier: products of single units with SI or binary prefixes
// and powers, "-per-"), and its LongNameHandler for them: a unit's
// patterns by plural form ("{0} km/h"), from CLDR's units (cldr.dat:
// units/long|short|narrow/TYPE-SUBTYPE/unitPattern-count-PLURAL and
// perUnitPattern, the compound patterns per, times, power2 and power3,
// the prefixes 10pN and 1024pN).
//
// A built-in unit takes its own patterns (its subtype through CLDR's unit
// aliases, a duration's "-person" taken off). Any other is put together
// as UTS #35 (and ICU's forArbitraryUnit and processPatternTimes) say:
// the units before "-per-" and after it each by the times pattern, each
// single unit its prefix and power around its own pattern's core; the
// denominator by its per-unit pattern when it is one built-in unit, else
// by the per pattern around its "one" form.
//
// What ICU's C API cannot ask for is not here: the grammatical cases of
// unit names. Mixed units ("foot-and-inch") and usages (unit
// preferences, conversions) are U_UNSUPPORTED_ERROR.
const m = @import("std.unicode.memory")
const nd = @import("std.unicode.format.number.data")
const sk = @import("std.unicode.format.number.skeleton")
const properties = @import("std.unicode.properties")
const locale = @import("std.unicode.locale.defaults")

pub const PLURAL_OTHER: usize = 5
const PLURAL_NAMES = [6][]const u8{ "zero", "one", "two", "few", "many", "other" }
// The slots of a unit's data: the six plural forms, its per-unit pattern.
const PER: usize = 6
const SLOTS: usize = 7

pub const MAX_SINGLES: usize = 8

// A single unit: a simple unit (a built-in unit's subtype), its prefix
// (10^power or 1024^power, power 0 for none) and its power (negative
// after "-per-").
pub const Single = struct {
    simple: []const u8
    prefixBase: i32
    prefixPower: i32
    power: i32
}

// A unit: built-in (its type and subtype) or a compound of single units.
pub const Unit = struct {
    builtIn: bool
    typeName: []const u8
    subtype: []const u8
    singles: [8]Single
    count: usize
    mixed: bool
    valid: bool
}

pub fn none() -> Unit {
    var u: Unit = undefined
    u.builtIn = false
    u.typeName = ""
    u.subtype = ""
    u.count = 0
    u.mixed = false
    u.valid = true
    return u
}

// ---------------------------------------------------------------------------
// Built-in units.

// The built-in unit whose subtype is SUBTYPE, of the first type that has
// it (ICU's findBySubType; "none" is no type of ICU's).
fn findBySubtype(subtype: []const u8, u: *Unit) -> bool {
    const list = sk.BUILT_IN_UNITS
    var at: usize = 0
    while at < list.length {
        var end = at
        while end < list.length && list[end] != 32 { end += 1 }
        var dash = at
        while dash < end && list[dash] != 45 { dash += 1 }
        if dash < end && m.same(list[dash + 1..end], subtype) && !m.same(list[at..dash], "none") {
            u.*.builtIn = true
            u.*.typeName = list[at..dash]
            u.*.subtype = list[dash + 1..end]
            return true
        }
        at = end + 1
    }
    return false
}

// The built-in unit TYPE-SUBTYPE (as the skeleton has checked it).
pub fn ofBuiltIn(name: []const u8) -> Unit {
    var u = none()
    const list = sk.BUILT_IN_UNITS
    var at: usize = 0
    while at < list.length {
        var end = at
        while end < list.length && list[end] != 32 { end += 1 }
        if m.same(list[at..end], name) {
            var dash = at
            while dash < end && list[dash] != 45 { dash += 1 }
            u.builtIn = true
            u.typeName = list[at..dash]
            u.subtype = list[dash + 1..end]
            return u
        }
        at = end + 1
    }
    u.valid = false
    return u
}

pub fn isSubtype(u: *const Unit, subtype: []const u8) -> bool { return u.*.builtIn && m.same(u.*.subtype, subtype) }

// ---------------------------------------------------------------------------
// Identifiers.

const SI_PREFIXES = [24][]const u8{ "quetta", "ronna", "yotta", "zetta", "exa", "peta", "tera", "giga", "mega", "kilo",
    "hecto", "deka", "deci", "centi", "milli", "micro", "nano", "pico", "femto", "atto", "zepto", "yocto", "ronto",
    "quecto" }
const SI_POWERS = [24]i32{ 30, 27, 24, 21, 18, 15, 12, 9, 6, 3, 2, 1, -1, -2, -3, -6, -9, -12, -15, -18, -21, -24, -27, -30 }
const BINARY_PREFIXES = [8][]const u8{ "kibi", "mebi", "gibi", "tebi", "pebi", "exbi", "zebi", "yobi" }

// Whether NAME is a simple unit: a built-in unit's subtype of one part
// (no "-per-").
fn isSimple(name: []const u8) -> bool {
    if name.length == 0 || contains(name, "-per-") { return false }
    var u = none()
    return findBySubtype(name, &u)
}

fn contains(text: []const u8, part: []const u8) -> bool {
    var at: usize = 0
    while at + part.length <= text.length {
        if m.same(text[at..at + part.length], part) { return true }
        at += 1
    }
    return false
}

// A single unit of TEXT (a simple unit, or a prefix and one) into S.
fn singleOf(text: []const u8, s: *Single) -> bool {
    s.*.prefixBase = 10
    s.*.prefixPower = 0
    if isSimple(text) {
        s.*.simple = simpleName(text)
        return true
    }
    var index: usize = 0
    while index < 24 {
        const prefix = SI_PREFIXES[index]
        if nd.startsWith(text, prefix) && isSimple(text[prefix.length..text.length]) {
            s.*.simple = simpleName(text[prefix.length..text.length])
            s.*.prefixPower = SI_POWERS[index]
            return true
        }
        index += 1
    }
    index = 0
    while index < 8 {
        const prefix = BINARY_PREFIXES[index]
        if nd.startsWith(text, prefix) && isSimple(text[prefix.length..text.length]) {
            s.*.simple = simpleName(text[prefix.length..text.length])
            s.*.prefixBase = 1024
            s.*.prefixPower = @intCast(i32, index) + 1
            return true
        }
        index += 1
    }
    return false
}

// The built-in list's own copy of a simple unit's name.
fn simpleName(name: []const u8) -> []const u8 {
    var u = none()
    if findBySubtype(name, &u) { return u.subtype }
    return name
}

// The single units of identifier ID (UTS #35's core unit identifier, as
// the skeleton has checked it) into U, with SIGN times their powers.
fn parseInto(id: []const u8, sign: i32, u: *Unit) -> bool {
    var rest = id
    var power = sign
    if nd.startsWith(rest, "per-") {
        rest = rest[4..rest.length]
        power = -sign
    }
    while rest.length > 0 {
        // The power.
        var dimension: i32 = 1
        if nd.startsWith(rest, "square-") {
            dimension = 2
            rest = rest[7..rest.length]
        } else if nd.startsWith(rest, "cubic-") {
            dimension = 3
            rest = rest[6..rest.length]
        } else if nd.startsWith(rest, "pow") {
            var at: usize = 3
            var value: i32 = 0
            while at < rest.length && rest[at] >= 48 && rest[at] <= 57 {
                value = value * 10 + @intCast(i32, rest[at] - 48)
                at += 1
            }
            if at > 3 && at < rest.length && rest[at] == 45 {
                dimension = value
                rest = rest[at + 1..rest.length]
            }
        }
        // The longest single unit up to a dash or the end.
        var end = rest.length
        var found = false
        var single: Single = undefined
        while end > 0 {
            if end == rest.length || rest[end] == 45 {
                const part = rest[0..end]
                if !contains(part, "-per-") && !contains(part, "-and-") && singleOf(part, &single) {
                    found = true
                    break
                }
            }
            end -= 1
        }
        if !found { return false }
        single.power = dimension * power
        if !append(u, &single) { return false }
        rest = rest[end..rest.length]
        if rest.length == 0 { break }
        // What joins it to the next: "-per-", "-and-" or "-".
        if nd.startsWith(rest, "-per-") {
            power = -sign
            rest = rest[5..rest.length]
        } else if nd.startsWith(rest, "-and-") {
            u.*.mixed = true
            rest = rest[5..rest.length]
        } else {
            rest = rest[1..rest.length]
        }
    }
    return true
}

// Appends S, adding its power to an equal single unit's (ICU's
// appendSingleUnit).
fn append(u: *Unit, s: *const Single) -> bool {
    var index: usize = 0
    while index < u.*.count {
        const t = &u.*.singles[index]
        if !u.*.mixed && m.same(t.*.simple, s.*.simple) && t.*.prefixBase == s.*.prefixBase && t.*.prefixPower == s.*.prefixPower {
            t.*.power += s.*.power
            return true
        }
        index += 1
    }
    if u.*.count == MAX_SINGLES { return false }
    u.*.singles[u.*.count] = s.*
    u.*.count += 1
    return true
}

// The single units of U's own (a built-in unit's from its subtype).
fn singlesOf(u: *const Unit, into: *Unit, sign: i32) -> bool {
    if u.*.builtIn { return parseInto(u.*.subtype, sign, into) }
    var index: usize = 0
    while index < u.*.count {
        var s = u.*.singles[index]
        s.power *= sign
        if !append(into, &s) { return false }
        index += 1
    }
    return true
}

// U's identifier (ICU's serialize, its single units in their order with
// the positive powers first) into OUT.
fn identifier(u: *const Unit, out: *m.Bytes) -> void {
    var pass: usize = 0
    var first = true
    var perDone = false
    while pass < 2 {
        var index: usize = 0
        while index < u.*.count {
            const s = &u.*.singles[index]
            const positive = s.*.power > 0
            if (pass == 0) == positive {
                if u.*.mixed {
                    if !first { m.pushText(out, "-and-") }
                } else if !positive && !perDone {
                    m.pushText(out, if first { "per-" } else { "-per-" })
                    perDone = true
                } else if !first {
                    m.pushByte(out, 45)
                }
                first = false
                const magnitude = if s.*.power < 0 { -s.*.power } else { s.*.power }
                if magnitude == 2 {
                    m.pushText(out, "square-")
                } else if magnitude == 3 {
                    m.pushText(out, "cubic-")
                } else if magnitude > 3 {
                    m.pushText(out, "pow")
                    pushNumber(out, magnitude)
                    m.pushByte(out, 45)
                }
                m.pushText(out, prefixName(s))
                m.pushText(out, s.*.simple)
            }
            index += 1
        }
        pass += 1
    }
}

fn prefixName(s: *const Single) -> []const u8 {
    if s.*.prefixPower == 0 { return "" }
    if s.*.prefixBase == 1024 { return BINARY_PREFIXES[@intCast(usize, s.*.prefixPower - 1)] }
    var index: usize = 0
    while index < 24 {
        if SI_POWERS[index] == s.*.prefixPower { return SI_PREFIXES[index] }
        index += 1
    }
    return ""
}

fn pushNumber(out: *m.Bytes, value: i32) -> void {
    var digits: [12]u8 = undefined
    var count: usize = 0
    var rest = if value < 0 { -value } else { value }
    if value < 0 { m.pushByte(out, 45) }
    while true {
        digits[count] = 48 + @intCast(u8, rest % 10)
        count += 1
        rest /= 10
        if rest == 0 { break }
    }
    while count > 0 {
        count -= 1
        m.pushByte(out, digits[count])
    }
}

// U made built-in when its identifier is a built-in unit's subtype (ICU's
// MeasureUnit of a MeasureUnitImpl).
fn settle(u: *Unit) -> void {
    if u.*.builtIn || u.*.count == 0 { return }
    var text = m.bytesBuffer()
    identifier(u, &text)
    var found = none()
    if findBySubtype(m.bytesText(&text), &found) {
        u.*.builtIn = true
        u.*.typeName = found.typeName
        u.*.subtype = found.subtype
    }
    m.disposeBytes(&text)
}

// The unit of identifier ID (the skeleton's unit/ID).
pub fn ofIdentifier(id: []const u8) -> Unit {
    var u = none()
    // A built-in unit's subtype names it.
    if findBySubtype(id, &u) { return u }
    if !parseInto(id, 1, &u) {
        u.valid = false
        return u
    }
    settle(&u)
    return u
}

// UNIT times PER to the power -1 (ICU's product with the reciprocal).
pub fn per(unit: *const Unit, perUnit: *const Unit) -> Unit {
    var u = none()
    if !singlesOf(unit, &u, 1) || !singlesOf(perUnit, &u, -1) {
        u.valid = false
        return u
    }
    settle(&u)
    return u
}

// ---------------------------------------------------------------------------
// Patterns as ICU's SimpleFormatter reads them: {0} and {1} the arguments,
// '' an apostrophe, '{...}' quoted.

// PATTERN with ARG0 and ARG1 put in for its arguments, into OUT (the
// arguments' text as it is).
fn formatPattern(pattern: []const u8, arg0: []const u8, arg1: []const u8, out: *m.Bytes) -> void {
    var at: usize = 0
    var quoted = false
    while at < pattern.length {
        const c = pattern[at]
        if c == 39 {
            if at + 1 < pattern.length && pattern[at + 1] == 39 {
                m.pushByte(out, 39)
                at += 2
                continue
            }
            if quoted {
                quoted = false
                at += 1
                continue
            }
            if at + 1 < pattern.length && (pattern[at + 1] == 123 || pattern[at + 1] == 125) {
                quoted = true
                at += 1
                continue
            }
            m.pushByte(out, 39)
            at += 1
            continue
        }
        if !quoted && c == 123 && at + 2 < pattern.length && pattern[at + 2] == 125 && (pattern[at + 1] == 48 || pattern[at + 1] == 49) {
            m.pushText(out, if pattern[at + 1] == 48 { arg0 } else { arg1 })
            at += 3
            continue
        }
        m.pushByte(out, c)
        at += 1
    }
}

// The text of PATTERN before its argument and after it (none: the whole
// before), and whether it has one.
pub fn split(pattern: []const u8, prefix: *m.Bytes, suffix: *m.Bytes) -> bool {
    var at: usize = 0
    var quoted = false
    var hasArgument = false
    while at < pattern.length {
        const target = if hasArgument { suffix } else { prefix }
        const c = pattern[at]
        if c == 39 {
            if at + 1 < pattern.length && pattern[at + 1] == 39 {
                m.pushByte(target, 39)
                at += 2
                continue
            }
            if quoted {
                quoted = false
                at += 1
                continue
            }
            if at + 1 < pattern.length && (pattern[at + 1] == 123 || pattern[at + 1] == 125) {
                quoted = true
                at += 1
                continue
            }
            m.pushByte(target, 39)
            at += 1
            continue
        }
        if !quoted && !hasArgument && c == 123 && at + 2 < pattern.length && pattern[at + 1] == 48 && pattern[at + 2] == 125 {
            hasArgument = true
            at += 3
            continue
        }
        m.pushByte(target, c)
        at += 1
    }
    return hasArgument
}

// Whether C is a space as Java has it (Zs, Zl, Zp).
fn isSpace(c: u32) -> bool {
    const g = properties.category(@intCast(i32, c))
    return g == 12 || g == 13 || g == 14
}

// TEXT without the spaces at its ends (ICU's trimSpaceChars).
fn trimmed(text: []const u8) -> []const u8 {
    var start: usize = 0
    while start < text.length {
        var at = start
        if !isSpace(nd.decode(text, &at)) { break }
        start = at
    }
    var end = text.length
    while end > start {
        var back = end - 1
        while back > start && (text[back] & 192) == 128 { back -= 1 }
        var at = back
        if !isSpace(nd.decode(text, &at)) { break }
        end = back
    }
    return text[start..end]
}

// TEXT in lower case (each code point's simple lower case), into OUT.
fn lowered(text: []const u8, out: *m.Bytes) -> void {
    var at: usize = 0
    while at < text.length {
        const c = nd.decode(text, &at)
        appendCodePoint(out, @intCast(u32, properties.simpleLower(@intCast(i32, c))))
    }
}

fn appendCodePoint(out: *m.Bytes, c: u32) -> void {
    if c < 128 {
        m.pushByte(out, @intCast(u8, c))
    } else if c < 2048 {
        m.pushByte(out, @intCast(u8, 192 | (c >> 6)))
        m.pushByte(out, @intCast(u8, 128 | (c & 63)))
    } else if c < 65536 {
        m.pushByte(out, @intCast(u8, 224 | (c >> 12)))
        m.pushByte(out, @intCast(u8, 128 | ((c >> 6) & 63)))
        m.pushByte(out, @intCast(u8, 128 | (c & 63)))
    } else {
        m.pushByte(out, @intCast(u8, 240 | (c >> 18)))
        m.pushByte(out, @intCast(u8, 128 | ((c >> 12) & 63)))
        m.pushByte(out, @intCast(u8, 128 | ((c >> 6) & 63)))
        m.pushByte(out, @intCast(u8, 128 | (c & 63)))
    }
}

// ---------------------------------------------------------------------------
// A unit's data: a pattern for each plural form and the per-unit pattern,
// each bogus (none) or a text, as ICU's arrays of UnicodeStrings.

const Patterns = struct {
    text: [7]m.Bytes
    bogus: [7]bool
}

fn initPatterns(p: *Patterns, allBogus: bool) -> void {
    var index: usize = 0
    while index < SLOTS {
        p.*.text[index] = m.bytesBuffer()
        p.*.bogus[index] = allBogus
        index += 1
    }
}

fn disposePatterns(p: *Patterns) -> void {
    var index: usize = 0
    while index < SLOTS {
        m.disposeBytes(&p.*.text[index])
        index += 1
    }
}

fn setPattern(p: *Patterns, index: usize, text: []const u8) -> void {
    p.*.text[index].length = 0
    m.pushText(&p.*.text[index], text)
    p.*.bogus[index] = false
}

fn patternText(p: *Patterns, index: usize) -> []const u8 { return m.bytesText(&p.*.text[index]) }

// The pattern of PLURAL, OTHER's when it has none (ICU's getWithPlural):
// its index, or SLOTS when neither is there.
fn withPlural(p: *const Patterns, plural: usize) -> usize {
    if !p.*.bogus[plural] { return plural }
    if !p.*.bogus[PLURAL_OTHER] { return PLURAL_OTHER }
    return SLOTS
}

fn widthName(width: i32) -> []const u8 {
    if width == sk.WIDTH_NARROW { return "narrow" }
    if width == sk.WIDTH_SHORT { return "short" }
    return "long"
}

// What a lookup needs: the locale's data and language.
pub const Context = struct {
    data: u32
    language: [8]u8
    languageLength: usize
}

pub fn context(data: u32, localeId: []const u8) -> Context {
    var c: Context = undefined
    c.data = data
    c.languageLength = locale.language(localeId, &c.language)
    return c
}

// The subtype CLDR keeps a built-in unit's data under: its alias's
// replacement, a duration without "-person".
fn dataSubtype(subtype: []const u8, out: *m.Bytes) -> void {
    var k = nd.key("metadata/alias/alias/")
    nd.add(&k, subtype)
    nd.add(&k, "/_replacement")
    var name = nd.supplemental(&k)
    if name.length == 0 { name = subtype }
    if name.length > 7 && nd.endsWith(name, "-person") { name = name[0..name.length - 7] }
    m.pushText(out, name)
}

fn unitKey(width: i32, typeName: []const u8, subtype: []const u8, leaf: []const u8) -> nd.Key {
    var k = nd.key("units/")
    nd.add(&k, widthName(width))
    nd.addByte(&k, 47)
    nd.add(&k, typeName)
    nd.addByte(&k, 45)
    nd.add(&k, subtype)
    nd.addByte(&k, 47)
    nd.add(&k, leaf)
    return k
}

// The patterns of a built-in unit into OUT (ICU's getMeasureData);
// a status (U_MISSING_RESOURCE_ERROR when a short unit has no data).
fn measureData(c: *const Context, typeName: []const u8, subtype: []const u8, width: i32, out: *Patterns) -> i32 {
    var name = m.bytesBuffer()
    dataSubtype(subtype, &name)
    const sub = m.bytesText(&name)
    var any = false
    var index: usize = 0
    while index < 6 {
        var leaf = nd.key("unitPattern-count-")
        nd.add(&leaf, PLURAL_NAMES[index])
        var k = unitKey(width, typeName, sub, leaf.bytes[0..leaf.length])
        var value: []const u8 = ""
        if nd.lookup(c.*.data, &k, &value) {
            setPattern(out, index, value)
            any = true
        }
        index += 1
    }
    var k = unitKey(width, typeName, sub, "perUnitPattern")
    var value: []const u8 = ""
    if nd.lookup(c.*.data, &k, &value) {
        setPattern(out, PER, value)
        any = true
    }
    m.disposeBytes(&name)
    if !any && width == sk.WIDTH_SHORT { return m.MISSING_RESOURCE_ERROR }
    return 0
}

// The gender of a built-in unit ("" for none).
fn genderOf(c: *const Context, typeName: []const u8, subtype: []const u8) -> []const u8 {
    var name = m.bytesBuffer()
    dataSubtype(subtype, &name)
    var k = unitKey(sk.WIDTH_FULL_NAME, typeName, m.bytesText(&name), "gender")
    m.disposeBytes(&name)
    return nd.get(c.*.data, &k)
}

// A compound pattern (per, times, 10p3...) of the width, short's when the
// width has none (ICU's getCompoundValue).
fn compoundValue(c: *const Context, name: []const u8, leaf: []const u8, width: i32) -> []const u8 {
    var k = nd.key("units/")
    nd.add(&k, widthName(width))
    nd.addByte(&k, 47)
    nd.add(&k, name)
    nd.addByte(&k, 47)
    nd.add(&k, leaf)
    var value: []const u8 = ""
    if nd.lookup(c.*.data, &k, &value) { return value }
    k = nd.key("units/short/")
    nd.add(&k, name)
    nd.addByte(&k, 47)
    nd.add(&k, leaf)
    return nd.get(c.*.data, &k)
}

// The power patterns ("square {0}") by plural form for GENDER into OUT
// (ICU's getInflectedMeasureData: the gender's, neuter's, then none's).
fn powerData(c: *const Context, power: i32, width: i32, gender: []const u8, out: *Patterns) -> bool {
    var name = nd.key("power")
    nd.addNumber(&name, @intCast(u64, power))
    const powerName = name.bytes[0..name.length]
    var any = false
    var index: usize = 0
    while index < 6 {
        var found = false
        var g: usize = 0
        while g < 3 && !found {
            var leaf = nd.key("compoundUnitPattern1")
            if g == 0 {
                if gender.length == 0 {
                    g += 1
                    continue
                }
                nd.add(&leaf, "-gender-")
                nd.add(&leaf, gender)
            } else if g == 1 {
                if gender.length == 0 || m.same(gender, "neuter") {
                    g += 1
                    continue
                }
                nd.add(&leaf, "-gender-neuter")
            }
            nd.add(&leaf, "-count-")
            nd.add(&leaf, PLURAL_NAMES[index])
            var k = nd.key("units/")
            nd.add(&k, widthName(width))
            nd.addByte(&k, 47)
            nd.add(&k, powerName)
            nd.addByte(&k, 47)
            nd.add(&k, leaf.bytes[0..leaf.length])
            var value: []const u8 = ""
            if nd.lookup(c.*.data, &k, &value) {
                setPattern(out, index, value)
                found = true
                any = true
            }
            g += 1
        }
        index += 1
    }
    if out.*.bogus[PLURAL_OTHER] {
        // A pattern of no plural form stands for them all.
        const plain = compoundValue(c, powerName, "compoundUnitPattern1", width)
        if plain.length > 0 {
            setPattern(out, PLURAL_OTHER, plain)
            any = true
        }
    }
    return any
}

// The plural form a structure gives its first (VALUE 0) or second part of
// a compound one (CLDR's deriveComponent rules, the language's or und's):
// "" for the compound's own.
fn derivedPlural(c: *const Context, structure: []const u8, which: usize, compound: []const u8) -> []const u8 {
    var k = nd.key("grammaticalData/")
    const base = k.length
    nd.add(&k, c.*.language[0..c.*.languageLength])
    nd.add(&k, "/deriveComponent-feature-plural-structure-")
    nd.add(&k, structure)
    nd.add(&k, if which == 0 { "/_value0" } else { "/_value1" })
    var value = nd.supplemental(&k)
    if value.length == 0 {
        k.length = base
        nd.add(&k, "und/deriveComponent-feature-plural-structure-")
        nd.add(&k, structure)
        nd.add(&k, if which == 0 { "/_value0" } else { "/_value1" })
        value = nd.supplemental(&k)
    }
    if value.length == 0 || m.same(value, "compound") { return compound }
    return value
}

fn pluralIndex(keyword: []const u8) -> usize {
    var index: usize = 0
    while index < 6 {
        if m.same(PLURAL_NAMES[index], keyword) { return index }
        index += 1
    }
    return PLURAL_OTHER
}

// Where a pattern's argument is.
const PH_EMPTY: i32 = 0
const PH_NONE: i32 = 1
const PH_BEGINNING: i32 = 2
const PH_MIDDLE: i32 = 3
const PH_END: i32 = 4

// The patterns of the product of U's single units of SIGN (1 those before
// "-per-", -1 those after, their powers made positive) into OUT (ICU's
// processPatternTimes). OUT is left empty (not bogus) when there are none.
fn productPatterns(c: *const Context, u: *const Unit, sign: i32, width: i32, out: *Patterns) -> i32 {
    var part = none()
    var index: usize = 0
    while index < u.*.count {
        var s = u.*.singles[index]
        if (s.power > 0) == (sign > 0) {
            s.power *= sign
            part.singles[part.count] = s
            part.count += 1
        }
        index += 1
    }
    initPatterns(out, false)
    if part.count == 0 { return 0 }
    // A built-in unit has its own patterns.
    settle(&part)
    if part.builtIn {
        initPatterns(out, true)
        return measureData(c, part.typeName, part.subtype, width, out)
    }
    const times = compoundValue(c, "times", "compoundUnitPattern", width)
    var placeholder: [6]i32 = undefined
    index = 0
    while index < SLOTS {
        out.*.bogus[index] = index != PLURAL_OTHER
        if index < 6 { placeholder[index] = PH_EMPTY }
        index += 1
    }
    var joiner = m.bytesBuffer()
    var category: []const u8 = ""
    var at: usize = 0
    var status: i32 = 0
    while at < part.count && status == 0 {
        const s = &part.singles[at]
        var singleCategory: []const u8 = ""
        if at + 1 < part.count {
            singleCategory = derivedPlural(c, "times", 0, category)
            category = derivedPlural(c, "times", 1, category)
        } else {
            singleCategory = derivedPlural(c, "times", 1, category)
        }
        var simple = none()
        if !findBySubtype(s.*.simple, &simple) {
            status = m.UNSUPPORTED_ERROR
            break
        }
        // The power's patterns.
        var powers: Patterns = undefined
        initPatterns(&powers, true)
        if s.*.power != 1 {
            if s.*.power > 3 || !powerData(c, s.*.power, width, genderOf(c, simple.typeName, simple.subtype), &powers) {
                disposePatterns(&powers)
                status = m.RESOURCE_TYPE_MISMATCH
                break
            }
        }
        // The prefix's pattern.
        var prefixPattern: []const u8 = ""
        if s.*.prefixPower != 0 {
            var name = nd.key("")
            nd.addNumber(&name, @intCast(u64, s.*.prefixBase))
            nd.addByte(&name, 112)
            if s.*.prefixPower < 0 {
                nd.addByte(&name, 45)
                nd.addNumber(&name, @intCast(u64, -s.*.prefixPower))
            } else {
                nd.addNumber(&name, @intCast(u64, s.*.prefixPower))
            }
            prefixPattern = compoundValue(c, name.bytes[0..name.length], "unitPrefixPattern", width)
        }
        var single: Patterns = undefined
        initPatterns(&single, true)
        status = measureData(c, simple.typeName, simple.subtype, width, &single)
        var plural: usize = 0
        while plural < 6 && status == 0 {
            if out.*.bogus[plural] {
                if single.bogus[plural] {
                    plural += 1
                    continue
                }
                const other = withPlural(out, plural)
                if other == SLOTS {
                    status = m.INTERNAL_PROGRAM_ERROR
                    break
                }
                var copy = m.bytesBuffer()
                m.pushText(&copy, patternText(out, other))
                setPattern(out, plural, m.bytesText(&copy))
                m.disposeBytes(&copy)
            }
            var form = plural
            if singleCategory.length > 0 { form = pluralIndex(singleCategory) }
            const chosen = withPlural(&single, form)
            if chosen == SLOTS {
                status = m.INTERNAL_PROGRAM_ERROR
                break
            }
            // The core of the single unit's pattern, where its argument is.
            const pattern = patternText(&single, chosen)
            var core: []const u8 = pattern
            var position = PH_NONE
            var join: []const u8 = ""
            if nd.startsWith(pattern, "{0}") {
                position = PH_BEGINNING
                core = pattern[3..pattern.length]
                if core.length > 0 {
                    var next: usize = 0
                    const first = nd.decode(core, &next)
                    if isSpace(first) {
                        join = core[0..next]
                        core = core[next..core.length]
                    }
                }
            } else if nd.endsWith(pattern, "{0}") {
                position = PH_END
                core = pattern[0..pattern.length - 3]
                if core.length > 0 {
                    var back = core.length - 1
                    while back > 0 && (core[back] & 192) == 128 { back -= 1 }
                    var next = back
                    if isSpace(nd.decode(core, &next)) {
                        join = core[back..core.length]
                        core = core[0..back]
                    }
                }
            } else if contains(pattern, "{0}") {
                status = m.UNSUPPORTED_ERROR
                break
            }
            if placeholder[plural] == PH_EMPTY {
                placeholder[plural] = position
                joiner.length = 0
                m.pushText(&joiner, join)
            }
            var unitText = m.bytesBuffer()
            m.pushText(&unitText, core)
            if s.*.prefixPower != 0 {
                var next = m.bytesBuffer()
                var low = m.bytesBuffer()
                if width == sk.WIDTH_FULL_NAME { lowered(m.bytesText(&unitText), &low) } else { m.pushText(&low, m.bytesText(&unitText)) }
                formatPattern(prefixPattern, m.bytesText(&low), "", &next)
                m.disposeBytes(&low)
                m.disposeBytes(&unitText)
                unitText = next
            }
            if s.*.power != 1 {
                const powerIndex = withPlural(&powers, form)
                var next = m.bytesBuffer()
                var low = m.bytesBuffer()
                if width == sk.WIDTH_FULL_NAME { lowered(m.bytesText(&unitText), &low) } else { m.pushText(&low, m.bytesText(&unitText)) }
                formatPattern(if powerIndex == SLOTS { "{0}" } else { patternText(&powers, powerIndex) }, m.bytesText(&low), "", &next)
                m.disposeBytes(&low)
                m.disposeBytes(&unitText)
                unitText = next
            }
            if out.*.text[plural].length == 0 {
                setPattern(out, plural, m.bytesText(&unitText))
            } else {
                var next = m.bytesBuffer()
                formatPattern(times, patternText(out, plural), m.bytesText(&unitText), &next)
                setPattern(out, plural, m.bytesText(&next))
                m.disposeBytes(&next)
            }
            m.disposeBytes(&unitText)
            plural += 1
        }
        disposePatterns(&single)
        disposePatterns(&powers)
        at += 1
    }
    if status != 0 {
        m.disposeBytes(&joiner)
        return status
    }
    // The argument where the single units had it.
    var plural: usize = 0
    while plural < 6 {
        if placeholder[plural] == PH_BEGINNING {
            var next = m.bytesBuffer()
            m.pushText(&next, "{0}")
            m.pushText(&next, m.bytesText(&joiner))
            m.pushText(&next, patternText(out, plural))
            setPattern(out, plural, m.bytesText(&next))
            m.disposeBytes(&next)
        } else if placeholder[plural] == PH_END {
            var next = m.bytesBuffer()
            m.pushText(&next, patternText(out, plural))
            m.pushText(&next, m.bytesText(&joiner))
            m.pushText(&next, "{0}")
            setPattern(out, plural, m.bytesText(&next))
            m.disposeBytes(&next)
        }
        plural += 1
    }
    m.disposeBytes(&joiner)
    return 0
}

// ---------------------------------------------------------------------------
// The patterns a formatter puts around its numbers.

// The pattern of each plural form for U (ICU's LongNameHandler
// forMeasureUnit), as text (SimpleFormatter's) into PATTERNS[0..6]: a
// block holding them, released by the formatter. A status.
pub fn load(c: *const Context, u: *const Unit, width: i32, patterns: *[6][]const u8, block: *usize) -> i32 {
    block.* = 0
    if !u.*.valid { return m.UNSUPPORTED_ERROR }
    if u.*.mixed { return m.UNSUPPORTED_ERROR }
    var result: Patterns = undefined
    var status: i32 = 0
    if u.*.builtIn {
        initPatterns(&result, true)
        status = measureData(c, u.*.typeName, u.*.subtype, width, &result)
        if status == 0 { status = finish(&result, "", patterns, block) }
        disposePatterns(&result)
        return status
    }
    // The numerator's and the denominator's.
    var numerator: Patterns = undefined
    var denominator: Patterns = undefined
    status = productPatterns(c, u, 1, width, &numerator)
    if status == 0 {
        status = productPatterns(c, u, -1, width, &denominator)
    } else {
        initPatterns(&denominator, false)
    }
    var perPattern = m.bytesBuffer()
    if status == 0 {
        if !denominator.bogus[PER] {
            m.pushText(&perPattern, patternText(&denominator, PER))
        } else {
            // The per pattern around the denominator's "one" form, its
            // argument and spaces taken off ("{0}/h").
            const perCompound = compoundValue(c, "per", "compoundUnitPattern", width)
            const one = withPlural(&denominator, 1)
            if one == SLOTS {
                status = m.INTERNAL_PROGRAM_ERROR
            } else {
                var prefix = m.bytesBuffer()
                var suffix = m.bytesBuffer()
                _ = split(patternText(&denominator, one), &prefix, &suffix)
                m.pushText(&prefix, m.bytesText(&suffix))
                formatPattern(perCompound, "{0}", trimmed(m.bytesText(&prefix)), &perPattern)
                m.disposeBytes(&prefix)
                m.disposeBytes(&suffix)
            }
        }
    }
    if status == 0 { status = finish(&numerator, m.bytesText(&perPattern), patterns, block) }
    m.disposeBytes(&perPattern)
    disposePatterns(&numerator)
    disposePatterns(&denominator)
    return status
}

// Each plural form's pattern of LEAD (OTHER's when it has none), put in
// TRAIL's argument when there is a TRAIL, into one block (ICU's
// simpleFormatsToModifiers, multiSimpleFormatsToModifiers).
fn finish(lead: *Patterns, trail: []const u8, patterns: *[6][]const u8, block: *usize) -> i32 {
    var all = m.bytesBuffer()
    var ends: [6]usize = undefined
    var plural: usize = 0
    while plural < 6 {
        const index = withPlural(lead, plural)
        if index == SLOTS {
            m.disposeBytes(&all)
            return m.INTERNAL_PROGRAM_ERROR
        }
        const text = patternText(lead, index)
        if trail.length == 0 {
            m.pushText(&all, text)
        } else if text.length == 0 {
            m.pushText(&all, trail)
        } else {
            formatPattern(trail, text, "", &all)
        }
        ends[plural] = all.length
        plural += 1
    }
    if all.address == 0 { m.pushByte(&all, 0) }
    block.* = all.address
    var start: usize = 0
    plural = 0
    while plural < 6 {
        patterns.*[plural] = m.bytes(all.address + start, ends[plural] - start)
        start = ends[plural]
        plural += 1
    }
    return 0
}
