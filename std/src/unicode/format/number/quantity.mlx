// The number a formatter works on (ICU's DecimalQuantity): a decimal
// (decimal.mlx) with the digits it must show at least (the minimum
// integer and fraction digits) and its exponent (the power of ten
// scientific and compact notation take out of it: 1.2K is 1.2 with
// exponent 3); rounding by ICU's precisions (RoundingImpl: fraction,
// significant, both with a priority, increments, unlimited), the
// rounding that finds the exponent of scientific and compact notation,
// the plural operands and the decimal text of the result.
//
// Quantities live in C memory (they are larger than what an exported
// function may keep in its frame), made with create and freed with
// destroy.
const m = @import("std.unicode.memory")
const decimal = @import("std.unicode.format.number.decimal")
const plurals = @import("std.unicode.format.plural.rules")
const sk = @import("std.unicode.format.number.skeleton")

pub const FORMAT_INEXACT_ERROR: i32 = 65809

pub const Quantity = struct {
    d: decimal.Decimal
    minInt: i32
    minFrac: i32
    exponent: i32
}

pub fn create() -> usize {
    const address = m.alloc(@sizeOf(Quantity))
    if address != 0 { reset(at(address)) }
    return address
}

pub fn at(address: usize) -> *Quantity { unsafe { return @ptrFromInt(*Quantity, address) } }

pub fn destroy(address: usize) -> void { m.release(address) }

pub fn reset(q: *Quantity) -> void {
    q.*.d.count = 0
    q.*.d.point = 0
    q.*.d.negative = false
    q.*.d.nan = false
    q.*.d.infinite = false
    q.*.minInt = 0
    q.*.minFrac = 0
    q.*.exponent = 0
}

pub fn copy(target: *Quantity, source: *const Quantity) -> void {
    target.*.d.count = source.*.d.count
    target.*.d.point = source.*.d.point
    target.*.d.negative = source.*.d.negative
    target.*.d.nan = source.*.d.nan
    target.*.d.infinite = source.*.d.infinite
    var index: usize = 0
    while index < source.*.d.count {
        target.*.d.digits[index] = source.*.d.digits[index]
        index += 1
    }
    target.*.minInt = source.*.minInt
    target.*.minFrac = source.*.minFrac
    target.*.exponent = source.*.exponent
}

pub fn setDouble(q: *Quantity, value: f64) -> void {
    reset(q)
    q.*.d = decimal.fromDouble(value)
}

pub fn setInt(q: *Quantity, value: i64) -> void {
    reset(q)
    var magnitude: u64 = if value < 0 { @bitCast(u64, 0 -% value) } else { @intCast(u64, value) }
    var reversed: [24]u8 = undefined
    var count: usize = 0
    while magnitude > 0 {
        reversed[count] = @intCast(u8, magnitude % 10)
        magnitude /= 10
        count += 1
    }
    var index: usize = 0
    while index < count {
        q.*.d.digits[index] = reversed[count - 1 - index]
        index += 1
    }
    q.*.d.count = count
    q.*.d.point = @intCast(i32, count)
    q.*.d.negative = value < 0
    trim(q)
}

// TEXT as a decimal number; false when it is not one.
pub fn setText(q: *Quantity, text: []const u8) -> bool {
    reset(q)
    return decimal.fromText(text, &q.*.d)
}

fn trim(q: *Quantity) -> void {
    while q.*.d.count > 0 && q.*.d.digits[q.*.d.count - 1] == 0 { q.*.d.count -= 1 }
    if q.*.d.count == 0 { q.*.d.point = 0 }
}

// ICU's isZeroish: no digits (zero, and NaN and infinity too).
pub fn isZeroish(q: *const Quantity) -> bool { return q.*.d.count == 0 }
pub fn isNaN(q: *const Quantity) -> bool { return q.*.d.nan }
pub fn isInfinite(q: *const Quantity) -> bool { return q.*.d.infinite }
pub fn isNegative(q: *const Quantity) -> bool { return q.*.d.negative }

// The place of the leading digit (meaningless for zero).
pub fn magnitude(q: *const Quantity) -> i32 { return q.*.d.point - 1 }

pub const SIGNUM_NEG: i32 = 0
pub const SIGNUM_NEG_ZERO: i32 = 1
pub const SIGNUM_POS_ZERO: i32 = 2
pub const SIGNUM_POS: i32 = 3

pub fn signum(q: *const Quantity) -> i32 {
    const zero = isZeroish(q) && !q.*.d.infinite
    if zero && q.*.d.negative { return SIGNUM_NEG_ZERO }
    if zero { return SIGNUM_POS_ZERO }
    if q.*.d.negative { return SIGNUM_NEG }
    return SIGNUM_POS
}

// The highest and lowest places shown.
pub fn upperDisplay(q: *const Quantity) -> i32 {
    const top = if q.*.d.count > 0 { q.*.d.point } else { 0 }
    return (if q.*.minInt > top { q.*.minInt } else { top }) - 1
}

pub fn lowerDisplay(q: *const Quantity) -> i32 {
    const low = decimal.lowestPlace(&q.*.d)
    return if -q.*.minFrac < low { -q.*.minFrac } else { low }
}

pub fn digit(q: *const Quantity, place: i32) -> u8 { return decimal.digitAt(&q.*.d, place) }

pub fn setMinInteger(q: *Quantity, count: i32) -> void { q.*.minInt = count }
pub fn setMinFraction(q: *Quantity, count: i32) -> void { q.*.minFrac = count }

// The digits at MAX_INT places and above dropped (integer-width truncation).
pub fn applyMaxInteger(q: *Quantity, maxInt: i32) -> void {
    if q.*.d.count == 0 { return }
    if maxInt <= decimal.lowestPlace(&q.*.d) {
        q.*.d.count = 0
        q.*.d.point = 0
        return
    }
    const mag = magnitude(q)
    if maxInt <= mag {
        // Drop the digits above place maxInt - 1.
        const drop = @intCast(usize, mag - maxInt + 1)
        var index: usize = 0
        while index + drop < q.*.d.count {
            q.*.d.digits[index] = q.*.d.digits[index + drop]
            index += 1
        }
        q.*.d.count -= drop
        q.*.d.point -= @intCast(i32, drop)
        // Leading zeros off.
        var lead: usize = 0
        while lead < q.*.d.count && q.*.d.digits[lead] == 0 { lead += 1 }
        if lead > 0 {
            index = 0
            while index + lead < q.*.d.count {
                q.*.d.digits[index] = q.*.d.digits[index + lead]
                index += 1
            }
            q.*.d.count -= lead
            q.*.d.point -= @intCast(i32, lead)
        }
        trim(q)
    }
}

pub fn adjustMagnitude(q: *Quantity, delta: i32) -> void {
    if q.*.d.count > 0 { q.*.d.point += delta }
}

// Whether digits other than zero lie below place PLACE.
fn hasDigitsBelow(q: *const Quantity, place: i32) -> bool {
    return q.*.d.count > 0 && decimal.lowestPlace(&q.*.d) < place
}

// Rounds to place PLACE in MODE; U_FORMAT_INEXACT_ERROR into STATUS (an
// i32 *) when MODE is unnecessary and digits would go.
pub fn roundToMagnitude(q: *Quantity, place: i32, mode: i32, status: *i32) -> void {
    if q.*.d.nan || q.*.d.infinite || place <= INT_MIN { return }
    if mode == decimal.UNNECESSARY {
        if hasDigitsBelow(q, place) { status.* = FORMAT_INEXACT_ERROR }
        return
    }
    decimal.roundAt(&q.*.d, place, mode)
}

// Rounds to a multiple of INCREMENT x 10^PLACE.
pub fn roundToIncrement(q: *Quantity, increment: u64, place: i32, mode: i32, status: *i32) -> void {
    if q.*.d.nan || q.*.d.infinite { return }
    if increment <= 1 {
        roundToMagnitude(q, place, mode, status)
        return
    }
    if mode == decimal.UNNECESSARY {
        // Inexact unless already a multiple.
        const before = m.alloc(@sizeOf(Quantity))
        const saved = at(before)
        copy(saved, q)
        decimal.roundToIncrement(&saved.*.d, increment, place, decimal.DOWN)
        if !sameValue(saved, q) { status.* = FORMAT_INEXACT_ERROR }
        m.release(before)
        return
    }
    decimal.roundToIncrement(&q.*.d, increment, place, mode)
}

fn sameValue(a: *const Quantity, b: *const Quantity) -> bool {
    if a.*.d.count != b.*.d.count || a.*.d.point != b.*.d.point { return false }
    var index: usize = 0
    while index < a.*.d.count {
        if a.*.d.digits[index] != b.*.d.digits[index] { return false }
        index += 1
    }
    return true
}

// ICU's operator== on quantities (after rounding): the same digits, sign,
// minimum digits.
pub fn equals(a: *const Quantity, b: *const Quantity) -> bool {
    if a.*.d.nan != b.*.d.nan || a.*.d.infinite != b.*.d.infinite || a.*.d.negative != b.*.d.negative { return false }
    if a.*.minInt != b.*.minInt || a.*.minFrac != b.*.minFrac { return false }
    return sameValue(a, b)
}

// ---------------------------------------------------------------------------
// The rounder (ICU's RoundingImpl), from the formatter's settings; the
// currency precision resolved to the currency's digits and increment.

pub const Rounder = struct {
    precision: i32
    minFrac: i32
    maxFrac: i32
    minSig: i32
    maxSig: i32
    priority: i32
    retain: bool
    increment: u64
    incrementMagnitude: i32
    incrementMinFrac: i32
    trailingZeroHide: bool
    mode: i32
    passThrough: bool
}

pub fn rounderOf(s: *const sk.Settings) -> Rounder {
    return Rounder.{
        .precision = s.*.precision,
        .minFrac = s.*.minFrac,
        .maxFrac = s.*.maxFrac,
        .minSig = s.*.minSig,
        .maxSig = s.*.maxSig,
        .priority = s.*.priority,
        .retain = s.*.retain,
        .increment = s.*.increment,
        .incrementMagnitude = s.*.incrementMagnitude,
        .incrementMinFrac = s.*.incrementMinFrac,
        .trailingZeroHide = s.*.trailingZeroHide,
        .mode = s.*.roundingMode,
        .passThrough = false,
    }
}

const INT_MIN: i32 = -2147483647
const INT_MAX: i32 = 2147483647

fn roundingMagnitudeFraction(maxFrac: i32) -> i32 { return if maxFrac == -1 { INT_MIN } else { -maxFrac } }

fn roundingMagnitudeSignificant(q: *const Quantity, maxSig: i32) -> i32 {
    if maxSig == -1 { return INT_MIN }
    const mag = if isZeroish(q) { 0 } else { magnitude(q) }
    return mag - maxSig + 1
}

fn displayMagnitudeFraction(minFrac: i32) -> i32 { return if minFrac == 0 { INT_MAX } else { -minFrac } }

fn displayMagnitudeSignificant(q: *const Quantity, minSig: i32) -> i32 {
    const mag = if isZeroish(q) { 0 } else { magnitude(q) }
    return mag - minSig + 1
}

fn maxOf(a: i32, b: i32) -> i32 { return if a > b { a } else { b } }
fn minOf(a: i32, b: i32) -> i32 { return if a < b { a } else { b } }

// The rounder's rounding of Q (and the fraction digits it shows).
pub fn apply(r: *const Rounder, q: *Quantity, status: *i32) -> void {
    if r.*.passThrough { return }
    var resolvedMinFraction: i32 = 0
    const p = r.*.precision
    if p == sk.PRECISION_NONE {
        // Nothing to round: the digits are exact.
    } else if p == sk.PRECISION_FRACTION {
        roundToMagnitude(q, roundingMagnitudeFraction(r.*.maxFrac), r.*.mode, status)
        resolvedMinFraction = maxOf(0, -displayMagnitudeFraction(r.*.minFrac))
    } else if p == sk.PRECISION_SIGNIFICANT {
        roundToMagnitude(q, roundingMagnitudeSignificant(q, r.*.maxSig), r.*.mode, status)
        resolvedMinFraction = maxOf(0, -displayMagnitudeSignificant(q, r.*.minSig))
        if isZeroish(q) && r.*.minSig > 0 { setMinInteger(q, 1) }
    } else if p == sk.PRECISION_FRACTION_SIGNIFICANT {
        const roundingMag1 = roundingMagnitudeFraction(r.*.maxFrac)
        var roundingMag2 = roundingMagnitudeSignificant(q, r.*.maxSig)
        const roundingMag = if r.*.priority == sk.PRIORITY_RELAXED { minOf(roundingMag1, roundingMag2) } else { maxOf(roundingMag1, roundingMag2) }
        if !isZeroish(q) {
            const upperMag = magnitude(q)
            roundToMagnitude(q, roundingMag, r.*.mode, status)
            if !isZeroish(q) && magnitude(q) != upperMag && roundingMag1 == roundingMag2 { roundingMag2 += 1 }
        }
        const displayMag1 = displayMagnitudeFraction(r.*.minFrac)
        const displayMag2 = displayMagnitudeSignificant(q, r.*.minSig)
        var displayMag: i32 = 0
        if r.*.retain {
            displayMag = minOf(displayMag1, displayMag2)
        } else if r.*.priority == sk.PRIORITY_RELAXED {
            displayMag = if roundingMag2 <= roundingMag1 { displayMag2 } else { displayMag1 }
        } else {
            displayMag = if roundingMag2 <= roundingMag1 { displayMag1 } else { displayMag2 }
        }
        resolvedMinFraction = maxOf(0, -displayMag)
    } else if p == sk.PRECISION_INCREMENT || p == sk.PRECISION_INCREMENT_FIVE {
        roundToIncrement(q, r.*.increment, r.*.incrementMagnitude, r.*.mode, status)
        resolvedMinFraction = r.*.incrementMinFrac
    } else if p == sk.PRECISION_INCREMENT_ONE {
        roundToMagnitude(q, r.*.incrementMagnitude, r.*.mode, status)
        resolvedMinFraction = r.*.incrementMinFrac
    }
    if !r.*.trailingZeroHide || fractionTrimmedNonZero(q) {
        setMinFraction(q, resolvedMinFraction)
    }
}

// Whether the number has fraction digits (ICU's plural operand t is not 0).
fn fractionTrimmedNonZero(q: *const Quantity) -> bool {
    return q.*.d.count > 0 && decimal.lowestPlace(&q.*.d) < -q.*.exponent
}

// The one use of the rounder with a minimum of integer digits: "00.000E0"
// for zero.
pub fn applyZeroWithMinInt(r: *const Rounder, q: *Quantity, minInt: i32) -> void {
    setMinFraction(q, r.*.minSig - minInt)
}

// What gives the multiplier (the power of ten taken out) for a
// magnitude: compact data's table or scientific notation's interval.
pub const Producer = struct {
    compact: bool
    // Compact: the multipliers by magnitude and the largest magnitude.
    multipliers: [20]i8
    largest: i32
    // Scientific: the engineering interval and whether the pattern
    // asks for its minimum integer digits.
    interval: i32
    requireMinInt: bool
}

pub fn multiplierOf(p: *const Producer, mag: i32) -> i32 {
    if p.*.compact {
        if mag < 0 { return 0 }
        const index = if mag > p.*.largest { p.*.largest } else { mag }
        return @intCast(i32, p.*.multipliers[@intCast(usize, index)])
    }
    var digitsShown: i32 = 1
    if p.*.requireMinInt {
        digitsShown = p.*.interval
    } else if p.*.interval <= 1 {
        digitsShown = 1
    } else {
        digitsShown = ((mag % p.*.interval + p.*.interval) % p.*.interval) + 1
    }
    return digitsShown - mag - 1
}

// ICU's chooseMultiplierAndApply: the multiplier for Q's magnitude
// applied and the rounding done; again with the next magnitude's
// multiplier when rounding carried Q to it (999.9 is 1K, not 1000).
pub fn chooseMultiplierAndApply(r: *const Rounder, q: *Quantity, p: *const Producer, status: *i32) -> i32 {
    const mag = magnitude(q)
    const multiplier = multiplierOf(p, mag)
    adjustMagnitude(q, multiplier)
    apply(r, q, status)
    if isZeroish(q) || status.* > 0 { return multiplier }
    if magnitude(q) == mag + multiplier { return multiplier }
    const next = multiplierOf(p, mag + 1)
    if multiplier == next { return multiplier }
    adjustMagnitude(q, next - multiplier)
    apply(r, q, status)
    return next
}

// ---------------------------------------------------------------------------
// Scale (ICU's Scale): times 10^MAGNITUDE and an arbitrary decimal.

pub fn multiply(q: *Quantity, by: *const decimal.Decimal) -> void {
    if q.*.d.count == 0 || q.*.d.nan || q.*.d.infinite {
        if by.*.negative { q.*.d.negative = !q.*.d.negative }
        return
    }
    if by.*.count == 0 {
        q.*.d.count = 0
        q.*.d.point = 0
        if by.*.negative { q.*.d.negative = !q.*.d.negative }
        return
    }
    // Schoolbook multiplication into a work area in C memory.
    const total = q.*.d.count + by.*.count
    const work = m.alloc(total * 4 + 4)
    var i = q.*.d.count
    while i > 0 {
        i -= 1
        var j = by.*.count
        while j > 0 {
            j -= 1
            const place = work + (i + j + 1) * 4
            m.put32(place, m.get32(place) + @intCast(u32, q.*.d.digits[i]) * @intCast(u32, by.*.digits[j]))
        }
    }
    var k = total
    var carry: u32 = 0
    while k > 0 {
        k -= 1
        const v = m.get32(work + k * 4) + carry
        m.put32(work + k * 4, v % 10)
        carry = v / 10
    }
    var count: usize = 0
    var index: usize = 0
    while index < total && count < decimal.MAX_DIGITS {
        q.*.d.digits[count] = @intCast(u8, m.get32(work + index * 4))
        count += 1
        index += 1
    }
    m.release(work)
    q.*.d.point = q.*.d.point + by.*.point
    q.*.d.count = count
    if by.*.negative { q.*.d.negative = !q.*.d.negative }
    // Leading and trailing zeros off.
    var lead: usize = 0
    while lead < q.*.d.count && q.*.d.digits[lead] == 0 { lead += 1 }
    if lead > 0 {
        index = 0
        while index + lead < q.*.d.count {
            q.*.d.digits[index] = q.*.d.digits[index + lead]
            index += 1
        }
        q.*.d.count -= lead
        q.*.d.point -= @intCast(i32, lead)
    }
    trim(q)
}

// ---------------------------------------------------------------------------
// The plural operands (ICU's getPluralOperand) and the plural keyword.

// The number as plural.mlx's operands take it: the value with its
// exponent in it, its integer part cut to its last 18 digits (ICU's
// toLong(true)), the fraction digits shown.
pub fn operandsOf(q: *const Quantity) -> plurals.Operands {
    var text = m.bytesBuffer()
    if q.*.d.nan || q.*.d.infinite {
        m.pushByte(&text, 48)
    } else {
        // Places of the integer part, at most 18.
        var top = q.*.d.point + q.*.exponent - 1
        if top > 17 { top = 17 }
        var place = top
        if place < 0 { m.pushByte(&text, 48) }
        while place >= 0 {
            m.pushByte(&text, 48 + decimal.digitAt(&q.*.d, place - q.*.exponent))
            place -= 1
        }
        const low = lowerDisplay(q) + q.*.exponent
        if low < 0 {
            m.pushByte(&text, 46)
            place = -1
            while place >= low {
                m.pushByte(&text, 48 + decimal.digitAt(&q.*.d, place - q.*.exponent))
                place -= 1
            }
        }
    }
    // A negative exponent (scientific 1.2E-3) is not 0..5 for the rules.
    const e: u32 = if q.*.exponent >= 0 { @intCast(u32, q.*.exponent) } else { 1000000 }
    const o = plurals.operands(m.bytesText(&text), e)
    m.disposeBytes(&text)
    return o
}

// ---------------------------------------------------------------------------
// The decimal text of a result (ICU's DecNum: unumf_resultToDecimalNumber):
// the digits without the exponent, plain when the exponent of the last
// digit is at most 0 and the number is not below 1e-6, else with "E+n" or
// "E-n" after the first digit; 0 for zero, NaN and infinity.

pub fn decimalText(q: *const Quantity, out: *m.Bytes) -> void {
    const d = &q.*.d
    if d.*.count == 0 || d.*.nan || d.*.infinite {
        m.pushByte(out, 48)
        return
    }
    if d.*.negative { m.pushByte(out, 45) }
    const exponent = d.*.point - @intCast(i32, d.*.count)
    const adjusted = d.*.point - 1
    if exponent <= 0 && adjusted >= -6 {
        if d.*.point <= 0 {
            m.pushText(out, "0.")
            var zeros = -d.*.point
            while zeros > 0 {
                m.pushByte(out, 48)
                zeros -= 1
            }
            var index: usize = 0
            while index < d.*.count {
                m.pushByte(out, 48 + d.*.digits[index])
                index += 1
            }
        } else {
            var index: usize = 0
            while index < d.*.count {
                if index == @intCast(usize, d.*.point) { m.pushByte(out, 46) }
                m.pushByte(out, 48 + d.*.digits[index])
                index += 1
            }
        }
        return
    }
    m.pushByte(out, 48 + d.*.digits[0])
    if d.*.count > 1 {
        m.pushByte(out, 46)
        var index: usize = 1
        while index < d.*.count {
            m.pushByte(out, 48 + d.*.digits[index])
            index += 1
        }
    }
    m.pushByte(out, 69)
    m.pushByte(out, if adjusted < 0 { 45 } else { 43 })
    var value: u32 = @intCast(u32, if adjusted < 0 { -adjusted } else { adjusted })
    var reversed: [12]u8 = undefined
    var count: usize = 0
    while true {
        reversed[count] = 48 + @intCast(u8, value % 10)
        count += 1
        value /= 10
        if value == 0 { break }
    }
    while count > 0 {
        count -= 1
        m.pushByte(out, reversed[count])
    }
}
