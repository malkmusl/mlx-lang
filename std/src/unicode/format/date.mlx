// Date and time formatting (udat.h, udatpg.h, udateintervalformat.h), as
// ICU formats dates, over CLDR's data of each calendar, the time zone
// names and the calendars of calendar.mlx (ucal.h). The parts:
//     simpledateformat.mlx   udat.h: UDateFormat (SimpleDateFormat and
//                            RelativeDateFormat)
//     patterngenerator.mlx   udatpg.h: DateTimePatternGenerator, the
//                            patterns of skeletons and of styles
//     dateintervals.mlx      udateintervalformat.h: DateIntervalFormat
//     datepatterns.mlx       formatting by a pattern, field by field
//     dateparse.mlx          parsing by a pattern
//     datesymbols.mlx        the locale's symbols, keywords, digits and
//                            day period rules
//     timezonenames.mlx      the names of time zones
//     datetext.mlx           UTF-16 text and SimpleFormatter
const simpledateformat = @import("std.unicode.format.date.simple")
const patterngenerator = @import("std.unicode.format.date.generator")
const dateintervals = @import("std.unicode.format.date.intervals")
const unicode = @import("std.unicode")
const utf = @import("std.unicode.utf")

// ---------------------------------------------------------------------------
// The native API (std.unicode: UTF-8 text, results from the allocator
// given, failures as unicode.Error).

const DateJob = struct {
    format: usize
    millis: f64
}

fn formatWith(dest: usize, capacity: i32, context: usize, status: usize) -> i32 {
    var job: *const DateJob = undefined
    unsafe { job = @ptrFromInt(*const DateJob, context) }
    return simpledateformat.udat_format(job.*.format, job.*.millis, dest, capacity, 0, status)
}

// `millis` (milliseconds since 1970, UTC) formatted in `locale` by the
// best pattern CLDR has for `skeleton` (UTS #35's fields: "yMMMd",
// "jm", "EEEEdMMMMy", "yMMMdjmszzzz"), in the zone `zone` ("" for the
// default zone) and the locale's calendar.
pub fn formatSkeleton(allocator: utf.Allocator, locale: []const u8, skeleton: []const u8, zone: []const u8, millis: f64) -> unicode.Error![]u8 {
    var name: [160]u8 = undefined
    const id = try unicode.cName(locale, &name)
    var skeletonUnits: [160]u16 = undefined
    const skeletonLength = try unicode.asciiUnits(skeleton, &skeletonUnits)
    var status: i32 = 0
    const patterns = patterngenerator.udatpg_open(id, @intFromPtr(&status))
    try unicode.check(status)
    defer patterngenerator.udatpg_close(patterns)
    var pattern = try unicode.units(allocator, 64)
    defer unicode.freeUnits(&pattern)
    var length = patterngenerator.udatpg_getBestPattern(patterns, @intFromPtr(&skeletonUnits), skeletonLength, unicode.address(&pattern), unicode.capacityOf(&pattern), @intFromPtr(&status))
    if status == unicode.BUFFER_OVERFLOW_ERROR && length > 0 {
        try unicode.reserve(&pattern, @intCast(usize, length))
        status = 0
        length = patterngenerator.udatpg_getBestPattern(patterns, @intFromPtr(&skeletonUnits), skeletonLength, unicode.address(&pattern), unicode.capacityOf(&pattern), @intFromPtr(&status))
    }
    try unicode.check(status)
    return formatByPattern(allocator, id, unicode.address(&pattern), length, zone, millis)
}

// `millis` formatted by a pattern of UTS #35 ("d MMMM y, HH:mm").
pub fn formatPattern(allocator: utf.Allocator, locale: []const u8, pattern: []const u8, zone: []const u8, millis: f64) -> unicode.Error![]u8 {
    var name: [160]u8 = undefined
    const id = try unicode.cName(locale, &name)
    const units = try utf.toUtf16(allocator, pattern)
    defer utf.free16(allocator, units)
    return formatByPattern(allocator, id, @intFromPtr(units.pointer), @intCast(i32, units.length), zone, millis)
}

fn formatByPattern(allocator: utf.Allocator, id: usize, pattern: usize, length: i32, zone: []const u8, millis: f64) -> unicode.Error![]u8 {
    var zoneUnits: [160]u16 = undefined
    const zoneLength = try unicode.asciiUnits(zone, &zoneUnits)
    var status: i32 = 0
    // UDAT_PATTERN for both styles: the pattern given.
    const format = simpledateformat.udat_open(-2, -2, id, if zoneLength > 0 { @intFromPtr(&zoneUnits) } else { 0 }, if zoneLength > 0 { zoneLength } else { -1 }, pattern, length, @intFromPtr(&status))
    try unicode.check(status)
    defer simpledateformat.udat_close(format)
    var job = DateJob.{ .format = format, .millis = millis }
    return unicode.produce(allocator, formatWith, @intFromPtr(&job))
}
