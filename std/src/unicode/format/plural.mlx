// Plural rules (upluralrules.h) over plurals.mlx: a locale's cardinal or
// ordinal rules (CLDR's plurals and ordinals), the keyword of a double (as
// ICU's FixedDecimal sees it: the fraction digits it shows at 16
// significant digits), of a formatted number (its operands as formatted,
// numberquantity.mlx: "1.00" is not "1") and of a formatted range (CLDR's
// plural ranges of the language, "other" when they say nothing), and the
// keywords of the rules in ICU's order (alphabetical, "other" last).
// ICU tries the rules in that order too (its resource table's): where
// rules overlap (French "many" for exponents, "e != 0..5", and "one" for
// 0 and 1) the first in that order wins. NaN and the infinities are
// "other" by any rules.
const m = @import("std.unicode.memory")
const resources = @import("std.unicode.locale.resources")
const enumeration = @import("std.unicode.enumeration")
const plurals = @import("std.unicode.format.plural.rules")
const locale = @import("std.unicode.locale.defaults")
const decimal = @import("std.unicode.format.number.decimal")
const nd = @import("std.unicode.format.number.data")
const nq = @import("std.unicode.format.number.quantity")
const nf = @import("std.unicode.format.number")
const numberrange = @import("std.unicode.format.number.range")
const unicode = @import("std.unicode")
const utf = @import("std.unicode.utf")

// "UPLR"
const MAGIC: u32 = 1431324754

// A rules object:
//     0 u32 magic, u32 type, 8 the rules' name (64 bytes), 72 its
//     length, 80 the language (16 bytes), 96 its length
const SIZE: usize = 104

fn rulesName(handle: usize) -> []const u8 { return m.bytes(handle + 8, m.getWord(handle + 72)) }
fn kind(handle: usize) -> u32 { return m.get32(handle + 4) }

pub fn languageOf(id: []const u8, into: *[16]u8) -> usize {
    var length: usize = 0
    for byte in id {
        if byte == 95 || byte == 45 || byte == 64 || length == 15 { break }
        into.*[length] = nd.lower(byte)
        length += 1
    }
    return length
}

pub fn uplrules_openForType(localeId: usize, type_: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if type_ < 0 || type_ >= 2 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    if !resources.available() {
        m.setError(status, m.MISSING_RESOURCE_ERROR)
        return 0
    }
    const handle = m.alloc(SIZE)
    if handle == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    m.put32(handle, MAGIC)
    m.put32(handle + 4, @intCast(u32, type_))
    const id = if localeId == 0 { locale.defaultLocale() } else { m.cSlice(localeId) }
    var name: [64]u8 = undefined
    const length = plurals.rulesLocale(id, @intCast(u32, type_), &name)
    var index: usize = 0
    while index < length {
        m.put8(handle + 8 + index, name[index])
        index += 1
    }
    m.putWord(handle + 72, length)
    var language: [16]u8 = undefined
    const languageLength = languageOf(id, &language)
    index = 0
    while index < languageLength {
        m.put8(handle + 80 + index, language[index])
        index += 1
    }
    m.putWord(handle + 96, languageLength)
    return handle
}

pub fn uplrules_open(localeId: usize, status: usize) -> usize { return uplrules_openForType(localeId, 0, status) }

pub fn uplrules_close(uplrules: usize) -> void {
    if uplrules == 0 || m.get32(uplrules) != MAGIC { return }
    m.put32(uplrules, 0)
    m.release(uplrules)
}

fn giveKeyword(keyword: []const u8, dest: usize, capacity: i32, status: usize) -> i32 { return nd.give16(keyword, dest, capacity, status) }

fn validOutput(keyword: usize, capacity: i32, status: usize) -> bool {
    if m.failed(status) { return false }
    if (keyword == 0 && capacity != 0) || (keyword != 0 && capacity < 0) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    return true
}

// The keyword O takes by the rules under NAME, tried in ICU's order.
const ORDER = [5]usize{ 3, 4, 1, 2, 0 }

pub fn select(name: []const u8, type_: u32, o: *const plurals.Operands) -> []const u8 {
    if name.length == 0 { return "other" }
    for index in ORDER {
        const r = plurals.rule(name, type_, plurals.KEYWORDS[index])
        if r.length > 0 && plurals.holds(r, o) { return plurals.KEYWORDS[index] }
    }
    return "other"
}

// The keyword of a double as ICU's FixedDecimal(double) has it.
pub fn selectDouble(name: []const u8, type_: u32, number: f64) -> []const u8 {
    if number != number || number - number != number - number { return "other" }
    const absolute = if number < 0.0 { -number } else { number }
    var d = decimal.fromDouble(absolute)
    // printf's %1.15e: sixteen significant digits.
    if d.count > 16 { decimal.roundAt(&d, d.point - 16, decimal.HALF_EVEN) }
    var text = m.bytesBuffer()
    var place: i32 = if d.point > 1 { d.point - 1 } else { 0 }
    while place >= 0 {
        m.pushByte(&text, 48 + decimal.digitAt(&d, place))
        place -= 1
    }
    const lowest = decimal.lowestPlace(&d)
    if lowest < 0 {
        m.pushByte(&text, 46)
        place = -1
        while place >= lowest {
            m.pushByte(&text, 48 + decimal.digitAt(&d, place))
            place -= 1
        }
    }
    const o = plurals.operands(m.bytesText(&text), 0)
    m.disposeBytes(&text)
    return select(name, type_, &o)
}

pub fn uplrules_select(uplrules: usize, number: f64, keyword: usize, capacity: i32, status: usize) -> i32 {
    if !validOutput(keyword, capacity, status) { return 0 }
    if uplrules == 0 || m.get32(uplrules) != MAGIC {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    return giveKeyword(selectDouble(rulesName(uplrules), kind(uplrules), number), keyword, capacity, status)
}

// The keyword of a quantity (a formatted number's).
pub fn selectQuantity(name: []const u8, type_: u32, q: *const nq.Quantity) -> []const u8 {
    if q.*.d.nan || q.*.d.infinite { return "other" }
    const o = nq.operandsOf(q)
    return select(name, type_, &o)
}

pub fn uplrules_selectFormatted(uplrules: usize, number: usize, keyword: usize, capacity: i32, status: usize) -> i32 {
    if !validOutput(keyword, capacity, status) { return 0 }
    if !nf.validResult(number, status) { return 0 }
    if uplrules == 0 || m.get32(uplrules) != MAGIC {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const result = selectQuantity(rulesName(uplrules), kind(uplrules), nf.resultQuantity(number))
    return giveKeyword(result, keyword, capacity, status)
}

// The plural form of a range from the forms of its ends: CLDR's plural
// ranges of LANGUAGE, "other" when they do not say (ICU's
// StandardPluralRanges::resolve).
pub fn rangeForm(language: []const u8, first: usize, second: usize) -> usize {
    var k = nd.key("plurals/")
    nd.add(&k, language)
    nd.add(&k, "/pluralRange-start-")
    nd.add(&k, nf.PLURAL_NAMES[first])
    nd.add(&k, "-end-")
    nd.add(&k, nf.PLURAL_NAMES[second])
    const value = nd.supplemental(&k)
    if value.length == 0 { return nf.PLURAL_OTHER }
    return nf.pluralIndex(value)
}

pub fn uplrules_selectForRange(uplrules: usize, urange: usize, keyword: usize, capacity: i32, status: usize) -> i32 {
    if !validOutput(keyword, capacity, status) { return 0 }
    if !numberrange.validResult(urange, status) { return 0 }
    if uplrules == 0 || m.get32(uplrules) != MAGIC {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const name = rulesName(uplrules)
    const first = nf.pluralIndex(selectQuantity(name, kind(uplrules), numberrange.firstQuantity(urange)))
    const second = nf.pluralIndex(selectQuantity(name, kind(uplrules), numberrange.secondQuantity(urange)))
    const language = m.bytes(uplrules + 80, m.getWord(uplrules + 96))
    const form = rangeForm(language, first, second)
    return giveKeyword(nf.PLURAL_NAMES[form], keyword, capacity, status)
}

// The keywords of the rules: those the rules name, in alphabetical order,
// then "other".
pub fn uplrules_getKeywords(uplrules: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if uplrules == 0 || m.get32(uplrules) != MAGIC {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const name = rulesName(uplrules)
    var lines = m.bytesBuffer()
    for index in ORDER {
        if name.length > 0 && plurals.hasKeyword(name, kind(uplrules), plurals.KEYWORDS[index]) {
            m.pushText(&lines, plurals.KEYWORDS[index])
            m.pushByte(&lines, 10)
        }
    }
    m.pushText(&lines, "other\n")
    const en = enumeration.ofLines(m.bytesText(&lines), status)
    m.disposeBytes(&lines)
    return en
}

// ---------------------------------------------------------------------------
// The native API (std.unicode: UTF-8 text, results from the allocator
// given, failures as unicode.Error).

// CLDR's plural categories.
pub const Category = enum(u8) {
    zero,
    one,
    two,
    few,
    many,
    other,
}

// The plural category `number` takes in `locale` (cardinal, or the
// ordinal "1st, 2nd..." ones).
pub fn category(locale: []const u8, number: f64, ordinal: bool) -> unicode.Error!Category {
    var name: [160]u8 = undefined
    const id = try unicode.cName(locale, &name)
    var status: i32 = 0
    const rules = uplrules_openForType(id, if ordinal { 1 } else { 0 }, @intFromPtr(&status))
    try unicode.check(status)
    defer uplrules_close(rules)
    var keyword: [16]u16 = undefined
    const length = uplrules_select(rules, number, @intFromPtr(&keyword), 16, @intFromPtr(&status))
    try unicode.check(status)
    if length == 4 && keyword[0] == 122 { return Category.zero }
    if length == 3 && keyword[0] == 111 && keyword[1] == 110 { return Category.one }
    if length == 3 && keyword[0] == 116 { return Category.two }
    if length == 3 && keyword[0] == 102 { return Category.few }
    if length == 4 && keyword[0] == 109 { return Category.many }
    return Category.other
}
