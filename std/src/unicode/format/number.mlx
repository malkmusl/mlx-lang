// Number formatting (unumberformatter.h, uformattednumber.h): ICU 74's
// NumberFormatter over CLDR's data, a formatter made of a skeleton
// (numberskeleton.mlx) and a locale. Its locale gives the numbering
// system (numbersystems.mlx), the symbols (numbers/symbols-numberSystem-
// NS/..., latn's for what NS lacks), the pattern of its style (decimal,
// percent, currency or accounting: numbers/STYLEFormats-numberSystem-NS/
// standard, latn's when NS has none), the minimum grouping digits, the
// currency's symbols and names (currency.mlx) with the currency spacing,
// the compact patterns by magnitude and plural form, and the plural rules
// (plurals.mlx). The pipeline is ICU's (NumberFormatterImpl): scale,
// scientific notation, the currency's long name, compact notation,
// rounding (numberquantity.mlx), the pattern's affixes with the sign
// display (numberpattern.mlx), integer width; then the digits with
// grouping and the decimal separator, the exponent, the affixes and the
// long name around them, each with its field (numberbuilder.mlx), the
// fields' spans in ICU's order (UFIELD_CATEGORY_NUMBER).
//
// Measure units (measure-unit/ with per-measure-unit/, unit/, and
// percent or permille as units: with unit-width-full-name or compact
// notation) are ICU's "CLDR units": measureunits.mlx makes their
// patterns of CLDR's unit data by plural form, put around the number as
// the outer modifier (its fields UNUM_MEASURE_UNIT_FIELD), the plural
// form as the rounding makes the number. Mixed units and usages are
// U_UNSUPPORTED_ERROR.
//
// The other families of numbers are reached from here: numberrange.mlx
// (unumberrangeformatter.h), decimalformat.mlx (unum.h, uformattable.h),
// pluralrules.mlx (upluralrules.h), reltime.mlx (ureldatefmt.h),
// currency.mlx (ucurr.h), numbersystems.mlx (unumsys.h).
const m = @import("std.unicode.memory")
const resources = @import("std.unicode.locale.resources")
const formatted = @import("std.unicode.format")
const decimal = @import("std.unicode.format.number.decimal")
const plurals = @import("std.unicode.format.plural.rules")
const properties = @import("std.unicode.properties")
const locale = @import("std.unicode.locale.defaults")
const numbersystems = @import("std.unicode.format.number.systems")
const currency = @import("std.unicode.format.number.currency")
const nd = @import("std.unicode.format.number.data")
const sk = @import("std.unicode.format.number.skeleton")
const nq = @import("std.unicode.format.number.quantity")
const np = @import("std.unicode.format.number.pattern")
const nb = @import("std.unicode.format.number.builder")
const numberrange = @import("std.unicode.format.number.range")
const decimalformat = @import("std.unicode.format.number.decimalformat")
const pluralrules = @import("std.unicode.format.plural")
const reltime = @import("std.unicode.format.reltime")
const mu = @import("std.unicode.format.number.units")

// "UNF\0" (ICU's UNumberFormatter magic) and "FDN\0" (UFormattedNumber's).
const MAGIC: u32 = 1314211072
pub const RESULT_KIND: u32 = 1178881536

pub const INVALID_FORMAT_ERROR: i32 = 3
pub const DECIMAL_NUMBER_SYNTAX_ERROR: i32 = 65808

// The plural forms (ICU's StandardPlural, then =0 and =1).
pub const PLURAL_ZERO: usize = 0
pub const PLURAL_ONE: usize = 1
pub const PLURAL_OTHER: usize = 5
pub const PLURAL_EQ0: usize = 6
pub const PLURAL_EQ1: usize = 7
pub const PLURAL_NAMES = [6][]const u8{ "zero", "one", "two", "few", "many", "other" }

pub fn pluralIndex(keyword: []const u8) -> usize {
    var index: usize = 0
    while index < 6 {
        if m.same(PLURAL_NAMES[index], keyword) { return index }
        index += 1
    }
    return PLURAL_OTHER
}

// CLDR pattern styles.
pub const STYLE_DECIMAL: i32 = 0
pub const STYLE_CURRENCY: i32 = 1
pub const STYLE_ACCOUNTING: i32 = 2
pub const STYLE_PERCENT: i32 = 3
pub const STYLE_SCIENTIFIC: i32 = 4

// The compact data of a formatter: by magnitude (0..19), the multiplier
// and the patterns of each plural form ("" none, USE_FALLBACK for CLDR's
// "0").
pub const MAX_COMPACT: usize = 20

pub const Formatter = struct {
    magic: u32
    settings: sk.Settings
    // An error to give when formatting (a skeleton's value out of bounds,
    // a numbering system that does not exist, data missing...).
    fault: i32
    localeId: [160]u8
    localeLength: usize
    data: u32
    exact: bool
    ns: [16]u8
    nsLength: usize
    // The numbering system of the symbols (latn for algorithmic ones).
    digits: [10]u32
    decimalSymbol: []const u8
    groupSymbol: []const u8
    monetaryDecimal: []const u8
    monetaryGroup: []const u8
    minusSign: []const u8
    plusSign: []const u8
    percentSign: []const u8
    permilleSign: []const u8
    exponential: []const u8
    infinity: []const u8
    nanSymbol: []const u8
    approximatelySign: []const u8
    superscripting: []const u8
    patternSeparator: []const u8
    spacingBefore: []const u8
    spacingAfter: []const u8
    // The pattern and its affixes.
    pattern: []const u8
    info: np.Info
    affixes: np.Affixes
    isCurrency: bool
    isPercent: bool
    isPermille: bool
    isCompact: bool
    isAccounting: bool
    isCldrUnit: bool
    unitWidth: i32
    code: currency.Code
    currencySymbol: []const u8
    currencyIso: [4]u8
    pluralNames: [6][]const u8
    longNames: bool
    // The currency's long name patterns ("{0} {1}"), or a measure unit's
    // (unitNames: "{0} km/h", in unitBlock, the formatter's).
    unitPatterns: [6][]const u8
    unitNames: bool
    unitBlock: usize
    rounder: nq.Rounder
    grouping1: i32
    grouping2: i32
    minGrouping: i32
    minInt: i32
    maxInt: i32
    sign: i32
    decimalAlways: bool
    scaleMagnitude: i32
    scale: usize
    scientific: bool
    scientificProducer: nq.Producer
    compactProducer: nq.Producer
    compactPatterns: [20][8][]const u8
    pluralRules: [64]u8
    pluralRulesLength: usize
    // DecimalFormat's padding: the width, the pad (UTF-8), its position.
    padWidth: i32
    padText: [16]u8
    padLength: usize
    padPosition: i32
    // DecimalFormat's: fail for more integer digits than the maximum, the
    // international currency symbol (the ISO code or its own).
    failIfMoreThanMaxDigits: bool
    intlSymbol: []const u8
}

const USE_FALLBACK: []const u8 = "\x01"

fn isFallback(pattern: []const u8) -> bool { return pattern.length == 1 && pattern[0] == 1 }

pub fn formatterAt(address: usize) -> *Formatter { unsafe { return @ptrFromInt(*Formatter, address) } }

pub fn isFormatter(address: usize) -> bool { return address != 0 && m.get32(address) == MAGIC }

fn localeText(f: *const Formatter) -> []const u8 { return f.*.localeId[0..f.*.localeLength] }

// ---------------------------------------------------------------------------
// Locale data.

// The symbol NAME of the formatter's numbering system, latn's when it has
// none ("" when neither has it).
fn symbol(f: *Formatter, name: []const u8) -> []const u8 {
    const ns = symbolSystem(f)
    if !m.same(ns, "latn") {
        var k = nd.key("numbers/symbols-numberSystem-")
        nd.add(&k, ns)
        nd.addByte(&k, 47)
        nd.add(&k, name)
        var value: []const u8 = ""
        if nd.lookup(f.*.data, &k, &value) { return value }
    }
    var k = nd.key("numbers/symbols-numberSystem-latn/")
    nd.add(&k, name)
    return nd.get(f.*.data, &k)
}

// The system the symbols and digits come from.
fn symbolSystem(f: *const Formatter) -> []const u8 {
    const name = f.*.ns[0..f.*.nsLength]
    if f.*.nsLength == 0 || numbersystems.isAlgorithmic(name) || numbersystems.digitsOf(name).length == 0 { return "latn" }
    return name
}

// The pattern of STYLE for the formatter's numbering system, latn's when
// it has none.
pub fn patternFor(data: u32, ns: []const u8, style: i32) -> []const u8 {
    const kind = if style == STYLE_DECIMAL { "decimalFormats" } else if style == STYLE_PERCENT { "percentFormats" } else if style == STYLE_SCIENTIFIC { "scientificFormats" } else { "currencyFormats" }
    const which = if style == STYLE_ACCOUNTING { "accounting" } else { "standard" }
    var k = nd.key("numbers/")
    nd.add(&k, kind)
    nd.add(&k, "-numberSystem-")
    nd.add(&k, ns)
    nd.addByte(&k, 47)
    nd.add(&k, which)
    var value: []const u8 = ""
    if nd.lookup(data, &k, &value) { return value }
    k = nd.key("numbers/")
    nd.add(&k, kind)
    nd.add(&k, "-numberSystem-latn/")
    nd.add(&k, which)
    return nd.get(data, &k)
}

fn loadSymbols(f: *Formatter) -> void {
    const ns = symbolSystem(f)
    const digits = numbersystems.digitsOf(ns)
    var at: usize = 0
    var index: usize = 0
    while index < 10 {
        if at < digits.length {
            f.*.digits[index] = nd.decode(digits, &at)
        } else {
            f.*.digits[index] = 48 + @intCast(u32, index)
        }
        index += 1
    }
    f.*.decimalSymbol = orDefault(symbol(f, "decimal"), ".")
    f.*.groupSymbol = orDefault(symbol(f, "group"), ",")
    f.*.monetaryDecimal = orDefault(symbol(f, "currencyDecimal"), f.*.decimalSymbol)
    f.*.monetaryGroup = orDefault(symbol(f, "currencyGroup"), f.*.groupSymbol)
    f.*.minusSign = orDefault(symbol(f, "minusSign"), "-")
    f.*.plusSign = orDefault(symbol(f, "plusSign"), "+")
    f.*.percentSign = orDefault(symbol(f, "percentSign"), "%")
    f.*.permilleSign = orDefault(symbol(f, "perMille"), "\u{2030}")
    f.*.exponential = orDefault(symbol(f, "exponential"), "E")
    f.*.infinity = orDefault(symbol(f, "infinity"), "\u{221E}")
    f.*.nanSymbol = orDefault(symbol(f, "nan"), "NaN")
    f.*.approximatelySign = orDefault(symbol(f, "approximatelySign"), "~")
    f.*.superscripting = orDefault(symbol(f, "superscriptingExponent"), "\u{D7}")
    f.*.patternSeparator = ";"
    f.*.spacingBefore = spacing(f, "beforeCurrency")
    f.*.spacingAfter = spacing(f, "afterCurrency")
}

fn orDefault(value: []const u8, fallback: []const u8) -> []const u8 { return if value.length > 0 { value } else { fallback } }

fn spacing(f: *Formatter, side: []const u8) -> []const u8 {
    const ns = symbolSystem(f)
    var k = nd.key("numbers/currencyFormats-numberSystem-")
    nd.add(&k, ns)
    nd.add(&k, "/currencySpacing/")
    nd.add(&k, side)
    nd.add(&k, "/insertBetween")
    var value: []const u8 = ""
    if nd.lookup(f.*.data, &k, &value) { return value }
    k = nd.key("numbers/currencyFormats-numberSystem-latn/currencySpacing/")
    nd.add(&k, side)
    nd.add(&k, "/insertBetween")
    return orDefault(nd.get(f.*.data, &k), "\u{A0}")
}

// The minimum grouping digits of the locale (numbers/minimumGroupingDigits).
fn minGroupingOf(data: u32) -> i32 {
    var k = nd.key("numbers/minimumGroupingDigits")
    const value = nd.get(data, &k)
    if value.length != 1 || value[0] < 48 || value[0] > 57 { return 1 }
    return @intCast(i32, value[0] - 48)
}

// The compact data for STYLE (short, long) and TYPE (decimalFormat,
// currencyFormat) with ICU's fallbacks: latn, then short.
fn loadCompact(f: *Formatter) -> void {
    var index: usize = 0
    while index < MAX_COMPACT {
        f.*.compactProducer.multipliers[index] = 0
        var k: usize = 0
        while k < 8 {
            f.*.compactPatterns[index][k] = ""
            k += 1
        }
        index += 1
    }
    f.*.compactProducer.compact = true
    f.*.compactProducer.largest = 0
    f.*.compactProducer.interval = 1
    f.*.compactProducer.requireMinInt = false
    const isShort = f.*.settings.notation == sk.NOTATION_COMPACT_SHORT
    const currencyType = f.*.isCurrency && f.*.unitWidth != sk.WIDTH_FULL_NAME
    const ns = f.*.ns[0..f.*.nsLength]
    const isLatn = m.same(ns, "latn")
    var found = compactFrom(f, ns, isShort, currencyType)
    if !found && !isLatn { found = compactFrom(f, "latn", isShort, currencyType) }
    if !found && !isShort { found = compactFrom(f, ns, true, currencyType) }
    if !found && !isLatn && !isShort { found = compactFrom(f, "latn", true, currencyType) }
    if !found { f.*.fault = m.INTERNAL_PROGRAM_ERROR }
}

fn compactFrom(f: *Formatter, ns: []const u8, isShort: bool, currencyType: bool) -> bool {
    var k = nd.key("numbers/")
    nd.add(&k, if currencyType { "currencyFormats-numberSystem-" } else { "decimalFormats-numberSystem-" })
    nd.add(&k, ns)
    nd.add(&k, if isShort { "/short/" } else { "/long/" })
    nd.add(&k, if currencyType { "standard" } else { "decimalFormat" })
    var first: u32 = 0
    var end: u32 = 0
    nd.below(&k, &first, &end)
    const prefixLength = k.length
    var any = false
    var key = first
    while key < end {
        const id = resources.valueOf(f.*.data, key)
        if id == resources.NONE {
            key += 1
            continue
        }
        // "1000-count-one": the magnitude is the length of the power less one.
        const name = resources.keyName(key)
        const rest = name[prefixLength + 1..name.length]
        key += 1
        var digitsEnd: usize = 0
        while digitsEnd < rest.length && rest[digitsEnd] >= 48 && rest[digitsEnd] <= 57 { digitsEnd += 1 }
        if digitsEnd == 0 || digitsEnd > MAX_COMPACT || !nd.startsWith(rest[digitsEnd..rest.length], "-count-") { continue }
        const form = rest[digitsEnd + 7..rest.length]
        var plural: usize = 8
        if m.same(form, "0") {
            plural = PLURAL_EQ0
        } else if m.same(form, "1") {
            plural = PLURAL_EQ1
        } else {
            var p: usize = 0
            while p < 6 {
                if m.same(PLURAL_NAMES[p], form) { plural = p }
                p += 1
            }
        }
        if plural == 8 { continue }
        const mag = digitsEnd - 1
        var pattern = resources.string(id)
        if m.same(pattern, "0") { pattern = USE_FALLBACK }
        if f.*.compactPatterns[mag][plural].length == 0 { f.*.compactPatterns[mag][plural] = pattern }
        if f.*.compactProducer.multipliers[mag] == 0 && !isFallback(pattern) {
            var zeros: i32 = 0
            for byte in pattern {
                if byte == 48 {
                    zeros += 1
                } else if zeros > 0 {
                    break
                }
            }
            if zeros > 0 {
                f.*.compactProducer.multipliers[mag] = @intCast(i8, zeros - @intCast(i32, mag) - 1)
                if @intCast(i32, mag) > f.*.compactProducer.largest { f.*.compactProducer.largest = @intCast(i32, mag) }
                any = true
            }
        }
    }
    return any
}

// The compact pattern for MAGNITUDE and Q (ICU's CompactData::getPattern),
// "" for none.
fn compactPattern(f: *Formatter, magnitude: i32, q: *const nq.Quantity) -> []const u8 {
    if magnitude < 0 { return "" }
    const mag = @intCast(usize, if magnitude > f.*.compactProducer.largest { f.*.compactProducer.largest } else { magnitude })
    var pattern: []const u8 = ""
    if decimal.lowestPlace(&q.*.d) >= 0 && !q.*.d.nan && !q.*.d.infinite {
        // An integer: =0 and =1 first.
        if q.*.d.count == 0 {
            pattern = f.*.compactPatterns[mag][PLURAL_EQ0]
        } else if q.*.d.count == 1 && q.*.d.point == 1 && q.*.d.digits[0] == 1 && !q.*.d.negative {
            pattern = f.*.compactPatterns[mag][PLURAL_EQ1]
        }
        if pattern.length > 0 && !isFallback(pattern) { return pattern }
    }
    const plural = pluralOf(f, q)
    pattern = f.*.compactPatterns[mag][plural]
    if pattern.length == 0 && plural != PLURAL_OTHER { pattern = f.*.compactPatterns[mag][PLURAL_OTHER] }
    if isFallback(pattern) { return "" }
    return pattern
}

// The plural form of Q by the formatter's plural rules.
pub fn pluralOf(f: *const Formatter, q: *const nq.Quantity) -> usize {
    // NaN and the infinities are "other" by any rules.
    if q.*.d.nan || q.*.d.infinite { return PLURAL_OTHER }
    const o = nq.operandsOf(q)
    const keyword = pluralrules.select(f.*.pluralRules[0..f.*.pluralRulesLength], plurals.CARDINAL, &o)
    return pluralIndex(keyword)
}

// ICU's getPluralSafe: the plural form of Q as the rounder would round it.
fn pluralSafe(f: *const Formatter, r: *const nq.Rounder, q: *const nq.Quantity) -> usize {
    const copy = nq.create()
    const c = nq.at(copy)
    nq.copy(c, q)
    var status: i32 = 0
    nq.apply(r, c, &status)
    const plural = if status > 0 { PLURAL_OTHER } else { pluralOf(f, c) }
    nq.destroy(copy)
    return plural
}

// ---------------------------------------------------------------------------
// Making a formatter of its settings.

// The locale ID of a C string (the default when 0) into F.
pub fn setLocale(f: *Formatter, id: []const u8) -> void {
    var length: usize = 0
    while length < id.length && length < 159 {
        f.*.localeId[length] = id[length]
        length += 1
    }
    f.*.localeLength = length
}

// Works out what F formats with of its settings and locale (ICU's
// macrosToMicroGenerator). AFFIXES: the DecimalFormat's own (0 for the
// pattern's).
pub fn resolve(f: *Formatter, custom: *const np.Affixes, useCustom: bool) -> void {
    const s = &f.*.settings
    if !resources.available() {
        f.*.fault = m.MISSING_RESOURCE_ERROR
        return
    }
    if s.*.fault != 0 && f.*.fault == 0 { f.*.fault = s.*.fault }
    const id = localeText(f)
    f.*.data = resources.find(id)
    f.*.exact = nd.isExactly(id, f.*.data)
    f.*.isCurrency = s.*.unit == sk.UNIT_CURRENCY
    // The unit: percent and permille (the stems', and the measure units
    // of those subtypes) have their own pattern unless they are CLDR
    // units.
    var unit = mu.none()
    if s.*.unit == sk.UNIT_MEASURE {
        const text = s.*.unitId[0..s.*.unitIdLength]
        unit = if s.*.unitBuiltIn { mu.ofBuiltIn(text) } else { mu.ofIdentifier(text) }
    } else if s.*.unit == sk.UNIT_PERCENT {
        unit = mu.ofBuiltIn("concentr-percent")
    } else if s.*.unit == sk.UNIT_PERMILLE {
        unit = mu.ofBuiltIn("concentr-permille")
    }
    f.*.isPercent = mu.isSubtype(&unit, "percent")
    f.*.isPermille = mu.isSubtype(&unit, "permille")
    f.*.isCompact = s.*.notation == sk.NOTATION_COMPACT_SHORT || s.*.notation == sk.NOTATION_COMPACT_LONG
    const sign = s.*.sign
    f.*.isAccounting = sign == sk.SIGN_ACCOUNTING || sign == sk.SIGN_ACCOUNTING_ALWAYS || sign == sk.SIGN_ACCOUNTING_EXCEPT_ZERO || sign == sk.SIGN_ACCOUNTING_NEGATIVE
    f.*.unitWidth = if s.*.unitWidth == sk.UNSET { sk.WIDTH_SHORT } else { s.*.unitWidth }
    const isBase = s.*.unit == sk.UNIT_NONE
    // (A per-unit alone is no unit: the number is formatted as it is.)
    f.*.isCldrUnit = !f.*.isCurrency && !isBase && (f.*.unitWidth == sk.WIDTH_FULL_NAME || !(f.*.isPercent || f.*.isPermille) || f.*.isCompact)
    f.*.unitNames = false
    f.*.unitBlock = 0
    if s.*.hasUsage {
        // Unit preferences (and the conversions they make) are not here.
        if f.*.fault == 0 { f.*.fault = if !f.*.isCldrUnit { m.ILLEGAL_ARGUMENT_ERROR } else { m.UNSUPPORTED_ERROR } }
    } else if f.*.isCldrUnit && resources.available() {
        if s.*.perUnitIdLength > 0 {
            const perUnit = mu.ofBuiltIn(s.*.perUnitId[0..s.*.perUnitIdLength])
            unit = mu.per(&unit, &perUnit)
        }
        const c = mu.context(f.*.data, id)
        const result = mu.load(&c, &unit, f.*.unitWidth, &f.*.unitPatterns, &f.*.unitBlock)
        if result != 0 {
            if f.*.fault == 0 { f.*.fault = result }
        } else {
            f.*.unitNames = true
        }
    }
    // The numbering system.
    if s.*.numberingSystemLength > 0 {
        var index: usize = 0
        while index < s.*.numberingSystemLength {
            f.*.ns[index] = s.*.numberingSystem[index]
            index += 1
        }
        f.*.nsLength = s.*.numberingSystemLength
    } else {
        var result: i32 = 0
        f.*.nsLength = numbersystems.forLocale(id, &f.*.ns, &result)
        if result > 0 {
            if f.*.fault == 0 { f.*.fault = result }
            var index: usize = 0
            while index < 4 {
                f.*.ns[index] = "latn"[index]
                index += 1
            }
            f.*.nsLength = 4
        }
    }
    loadSymbols(f)
    // The currency, its symbols and its own pattern and separators.
    // (A formatter of no currency has XXX's names for the currency signs.)
    f.*.code = currency.Code.{ .bytes = [4]u8{ 88, 88, 88, 0 }, .length = 3 }
    if f.*.isCurrency {
        var index: usize = 0
        while index < 3 {
            f.*.code.bytes[index] = s.*.currency[index]
            index += 1
        }
    }
    var index: usize = 0
    while index < 3 {
        f.*.currencyIso[index] = f.*.code.bytes[index]
        index += 1
    }
    f.*.currencyIso[3] = 0
    const currencyPattern = setCurrency(f, f.*.isCurrency)
    // The pattern: for grouping and the affixes.
    var style = STYLE_DECIMAL
    if f.*.isCldrUnit {
        style = STYLE_DECIMAL
    } else if f.*.isPercent || f.*.isPermille {
        style = STYLE_PERCENT
    } else if !f.*.isCurrency || f.*.unitWidth == sk.WIDTH_FULL_NAME {
        style = STYLE_DECIMAL
    } else if f.*.isAccounting {
        style = STYLE_ACCOUNTING
    } else {
        style = STYLE_CURRENCY
    }
    f.*.pattern = if currencyPattern.length > 0 { currencyPattern } else { patternFor(f.*.data, f.*.ns[0..f.*.nsLength], style) }
    if f.*.pattern.length == 0 { f.*.pattern = "#,##0.###" }
    np.parse(f.*.pattern, &f.*.info)
    if f.*.info.fault != 0 && f.*.fault == 0 { f.*.fault = f.*.info.fault }
    f.*.affixes = if useCustom && (!f.*.isCompact || f.*.isCurrency == custom.*.hasCurrencySign) { custom.* } else { np.affixesOf(&f.*.info) }
    // Rounding.
    f.*.rounder = nq.rounderOf(s)
    if s.*.precision == sk.PRECISION_BOGUS {
        if f.*.isCompact {
            f.*.rounder.precision = sk.PRECISION_FRACTION_SIGNIFICANT
            f.*.rounder.minFrac = 0
            f.*.rounder.maxFrac = 0
            f.*.rounder.minSig = 1
            f.*.rounder.maxSig = 2
            f.*.rounder.priority = sk.PRIORITY_RELAXED
            f.*.rounder.retain = true
        } else if f.*.isCurrency {
            f.*.rounder.precision = sk.PRECISION_CURRENCY
        } else {
            f.*.rounder.precision = sk.PRECISION_FRACTION
            f.*.rounder.minFrac = 0
            f.*.rounder.maxFrac = 6
        }
    }
    if f.*.rounder.precision == sk.PRECISION_CURRENCY { resolveCurrencyPrecision(f, s.*.precision == sk.PRECISION_CURRENCY && s.*.currencyUsage == 1) }
    // Grouping.
    var strategy = s.*.grouping
    if strategy == sk.UNSET { strategy = if f.*.isCompact { sk.GROUPING_MIN2 } else { sk.GROUPING_AUTO } }
    setGrouping(f, strategy)
    // Integer width, sign, decimal.
    f.*.minInt = if s.*.hasIntegerWidth { s.*.minInt } else { 1 }
    f.*.maxInt = if s.*.hasIntegerWidth { s.*.maxInt } else { -1 }
    f.*.sign = if sign == sk.UNSET { sk.SIGN_AUTO } else { sign }
    f.*.decimalAlways = s.*.decimal == 1
    // Scale.
    f.*.scaleMagnitude = s.*.scaleMagnitude
    f.*.scale = 0
    if s.*.scaleTextLength > 0 {
        f.*.scale = m.alloc(@sizeOf(decimal.Decimal))
        const d: *decimal.Decimal = unsafe { @ptrFromInt(*decimal.Decimal, f.*.scale) }
        _ = decimal.fromText(s.*.scaleText[0..s.*.scaleTextLength], d)
    }
    // Scientific notation.
    f.*.scientific = s.*.notation == sk.NOTATION_SCIENTIFIC
    f.*.scientificProducer.compact = false
    f.*.scientificProducer.interval = s.*.engineering
    f.*.scientificProducer.requireMinInt = s.*.requireMinInt
    f.*.scientificProducer.largest = 0
    // Plural rules.
    var rulesName: [64]u8 = undefined
    f.*.pluralRulesLength = plurals.rulesLocale(id, plurals.CARDINAL, &rulesName)
    var r: usize = 0
    while r < f.*.pluralRulesLength {
        f.*.pluralRules[r] = rulesName[r]
        r += 1
    }
    // Currency long names.
    f.*.longNames = f.*.isCurrency && f.*.unitWidth == sk.WIDTH_FULL_NAME
    if f.*.longNames { loadLongNames(f) }
    if f.*.isCompact { loadCompact(f) }
    f.*.padWidth = -1
    f.*.padLength = 0
    f.*.padPosition = 0
    f.*.failIfMoreThanMaxDigits = false
    f.*.intlSymbol = f.*.currencyIso[0..3]
}

// The currency's symbol for the unit width, its plural names; the
// currency's own pattern and separators when the locale has them
// (DecimalFormatSymbols::setCurrency): the pattern, "" when none.
fn setCurrency(f: *Formatter, separators: bool) -> []const u8 {
    const look = currency.Lookup.{ .data = f.*.data, .exact = f.*.exact }
    var found: i32 = 0
    const w = f.*.unitWidth
    if w == sk.WIDTH_NARROW {
        f.*.currencySymbol = currency.name(look, &f.*.code, currency.NARROW_SYMBOL_NAME, &found)
    } else if w == sk.WIDTH_ISO_CODE {
        f.*.currencySymbol = ""
    } else if w == sk.WIDTH_FORMAL {
        f.*.currencySymbol = currency.name(look, &f.*.code, currency.FORMAL_SYMBOL_NAME, &found)
    } else if w == sk.WIDTH_VARIANT {
        f.*.currencySymbol = currency.name(look, &f.*.code, currency.VARIANT_SYMBOL_NAME, &found)
    } else if w == sk.WIDTH_HIDDEN {
        f.*.currencySymbol = ""
    } else {
        f.*.currencySymbol = currency.name(look, &f.*.code, currency.SYMBOL_NAME, &found)
    }
    if found == -1 { f.*.currencySymbol = "" }
    var index: usize = 0
    while index < 6 {
        f.*.pluralNames[index] = currency.pluralName(look, &f.*.code, PLURAL_NAMES[index], &found)
        if found == -1 { f.*.pluralNames[index] = "" }
        index += 1
    }
    if !separators { return "" }
    var k = nd.key("numbers/currencies/")
    nd.add(&k, currency.codeText(&f.*.code))
    const base = k.length
    nd.add(&k, "/decimal")
    const decimalSep = nd.get(f.*.data, &k)
    k.length = base
    nd.add(&k, "/group")
    const groupSep = nd.get(f.*.data, &k)
    k.length = base
    nd.add(&k, "/pattern")
    var pattern = nd.get(f.*.data, &k)
    if decimalSep.length > 0 || groupSep.length > 0 || pattern.length > 0 {
        if decimalSep.length > 0 { f.*.monetaryDecimal = decimalSep }
        if groupSep.length > 0 { f.*.monetaryGroup = groupSep }
        if pattern.length == 0 { pattern = patternFor(f.*.data, f.*.ns[0..f.*.nsLength], STYLE_CURRENCY) }
        return pattern
    }
    return ""
}

// The currency precision: the currency's increment, else its digits.
fn resolveCurrencyPrecision(f: *Formatter, cash: bool) -> void {
    const usage = if cash { currency.USAGE_CASH } else { currency.USAGE_STANDARD }
    const digits = currency.fractionDigits(&f.*.code, usage)
    const units = currency.roundingUnits(&f.*.code, usage)
    if units >= 2 {
        // increment / 10^digits: mantissa and magnitude without trailing zeros.
        var mantissa = @intCast(u64, units)
        var magnitude = -digits
        while mantissa % 10 == 0 {
            mantissa /= 10
            magnitude += 1
        }
        f.*.rounder.increment = mantissa
        f.*.rounder.incrementMagnitude = magnitude
        f.*.rounder.incrementMinFrac = if magnitude > 0 { 0 } else { -magnitude }
        f.*.rounder.precision = if mantissa == 1 { sk.PRECISION_INCREMENT_ONE } else if mantissa == 5 { sk.PRECISION_INCREMENT_FIVE } else { sk.PRECISION_INCREMENT }
    } else {
        f.*.rounder.precision = sk.PRECISION_FRACTION
        f.*.rounder.minFrac = digits
        f.*.rounder.maxFrac = digits
    }
}

// The grouping of STRATEGY over the pattern's sizes and the locale's
// minimum grouping digits (ICU's Grouper).
pub fn setGrouping(f: *Formatter, strategy: i32) -> void {
    var g1: i32 = -2
    var g2: i32 = -2
    var minGrouping: i32 = -2
    if strategy == sk.GROUPING_OFF {
        g1 = -1
        g2 = -1
        minGrouping = -2
    } else if strategy == sk.GROUPING_MIN2 {
        minGrouping = -3
    } else if strategy == sk.GROUPING_ON_ALIGNED {
        g1 = -4
        g2 = -4
        minGrouping = 1
    } else if strategy == sk.GROUPING_THOUSANDS {
        g1 = 3
        g2 = 3
        minGrouping = 1
    } else if strategy == sk.GROUPING_PROPERTIES {
        g1 = f.*.settings.grouping1
        g2 = f.*.settings.grouping2
        minGrouping = f.*.settings.minGrouping
    }
    if minGrouping == -2 {
        minGrouping = minGroupingOf(f.*.data)
    } else if minGrouping == -3 {
        minGrouping = maxOf(2, minGroupingOf(f.*.data))
    }
    if g1 == -2 || g2 == -4 {
        var p1 = np.grouping(&f.*.info.positive, 0)
        var p2 = np.grouping(&f.*.info.positive, 1)
        const p3 = np.grouping(&f.*.info.positive, 2)
        if p2 == -1 { p1 = if g1 == -4 { 3 } else { -1 } }
        if p3 == -1 { p2 = p1 }
        g1 = p1
        g2 = p2
    }
    f.*.grouping1 = g1
    f.*.grouping2 = g2
    f.*.minGrouping = minGrouping
}

fn maxOf(a: i32, b: i32) -> i32 { return if a > b { a } else { b } }

// The long names of the currency: "{0} {1}" by plural form, {1} its
// plural name (ICU's CurrencyUnitPatterns).
fn loadLongNames(f: *Formatter) -> void {
    var index: usize = 0
    while index < 6 {
        var k = nd.key("numbers/currencyFormats-numberSystem-latn/unitPattern-count-")
        nd.add(&k, PLURAL_NAMES[index])
        f.*.unitPatterns[index] = nd.get(f.*.data, &k)
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Formatting.

// What the pipeline decides for a number (ICU's MicroProps).
pub const Micros = struct {
    rounder: nq.Rounder
    scientific: bool
    exponent: i32
    // The middle modifier: the pattern's affixes or a compact pattern's,
    // the sign type and the plural form for ¤¤¤ (6 for none).
    compact: bool
    compactPattern: []const u8
    signType: i32
    plural: usize
    // The outer modifier: the long name's plural form (6 for none).
    outerPlural: usize
    approximately: bool
}

// Q's way through the pipeline (ICU's preProcess). STATUS an i32 *.
pub fn preProcess(f: *Formatter, q: *nq.Quantity, micros: *Micros, approximately: bool, status: *i32) -> void {
    micros.*.rounder = f.*.rounder
    micros.*.scientific = false
    micros.*.exponent = 0
    micros.*.compact = false
    micros.*.compactPattern = ""
    micros.*.plural = 6
    micros.*.outerPlural = 6
    micros.*.approximately = approximately
    if f.*.fault != 0 {
        status.* = f.*.fault
        return
    }
    // Scale.
    if f.*.scaleMagnitude != 0 { nq.adjustMagnitude(q, f.*.scaleMagnitude) }
    if f.*.scale != 0 {
        const d: *const decimal.Decimal = unsafe { @ptrFromInt(*const decimal.Decimal, f.*.scale) }
        nq.multiply(q, d)
    }
    // Scientific notation.
    if f.*.scientific && !q.*.d.infinite && !q.*.d.nan {
        var exponent: i32 = 0
        if nq.isZeroish(q) {
            if f.*.scientificProducer.requireMinInt && micros.*.rounder.precision == sk.PRECISION_SIGNIFICANT {
                nq.applyZeroWithMinInt(&micros.*.rounder, q, f.*.scientificProducer.interval)
            } else {
                nq.apply(&micros.*.rounder, q, status)
            }
        } else {
            exponent = -nq.chooseMultiplierAndApply(&micros.*.rounder, q, &f.*.scientificProducer, status)
        }
        micros.*.scientific = true
        micros.*.exponent = exponent
        q.*.exponent += exponent
        micros.*.rounder.passThrough = true
    }
    // The currency's long name.
    if f.*.longNames || f.*.unitNames { micros.*.outerPlural = pluralSafe(f, &micros.*.rounder, q) }
    // Compact notation.
    if f.*.isCompact {
        var magnitude: i32 = 0
        var multiplier: i32 = 0
        if nq.isZeroish(q) {
            nq.apply(&micros.*.rounder, q, status)
        } else {
            multiplier = nq.chooseMultiplierAndApply(&micros.*.rounder, q, &f.*.compactProducer, status)
            magnitude = (if nq.isZeroish(q) { 0 } else { nq.magnitude(q) }) - multiplier
        }
        const pattern = compactPattern(f, magnitude, q)
        if pattern.length > 0 {
            micros.*.compact = true
            micros.*.compactPattern = pattern
            micros.*.signType = np.resolveSign(f.*.sign, nq.signum(q))
        }
        q.*.exponent -= multiplier
        micros.*.rounder.passThrough = true
    }
    // The pattern's affixes.
    nq.apply(&micros.*.rounder, q, status)
    if !micros.*.compact {
        micros.*.signType = np.resolveSign(f.*.sign, nq.signum(q))
        if f.*.affixes.needsPlurals { micros.*.plural = pluralSafe(f, &micros.*.rounder, q) }
    }
    // Integer width (DecimalFormat may fail for more digits than the
    // maximum: ICU compares the maximum with the magnitude).
    if f.*.maxInt != -1 && f.*.failIfMoreThanMaxDigits {
        const mag = if nq.isZeroish(q) { -1 } else { nq.magnitude(q) }
        if f.*.maxInt < mag && status.* <= 0 { status.* = m.ILLEGAL_ARGUMENT_ERROR }
    }
    nq.setMinInteger(q, f.*.minInt)
    if f.*.maxInt != -1 { nq.applyMaxInteger(q, f.*.maxInt) }
}

fn insertDigit(f: *const Formatter, b: *nb.Builder, index: usize, digit: u8, field: u8) -> usize {
    return nb.insertCodePoint(b, index, f.*.digits[@intCast(usize, digit)], field)
}

fn groupAt(f: *const Formatter, position: i32, q: *const nq.Quantity) -> bool {
    if f.*.grouping1 == -1 || f.*.grouping1 == 0 { return false }
    const p = position - f.*.grouping1
    return p >= 0 && f.*.grouping2 > 0 && (p % f.*.grouping2) == 0 && nq.upperDisplay(q) - f.*.grouping1 + 1 >= f.*.minGrouping
}

// The number's digits, separators and decimal point at INDEX; their units.
pub fn writeNumber(f: *const Formatter, q: *const nq.Quantity, b: *nb.Builder, index: usize) -> usize {
    var length: usize = 0
    if q.*.d.infinite {
        return nb.insertText(b, index, f.*.infinity, nb.numberField(nb.INTEGER))
    }
    if q.*.d.nan {
        return nb.insertText(b, index, f.*.nanSymbol, nb.numberField(nb.INTEGER))
    }
    const integerCount = nq.upperDisplay(q) + 1
    var i: i32 = 0
    while i < integerCount {
        if groupAt(f, i, q) {
            length += nb.insertText(b, index, if f.*.isCurrency { f.*.monetaryGroup } else { f.*.groupSymbol }, nb.numberField(nb.GROUPING_SEPARATOR))
        }
        length += insertDigit(f, b, index, nq.digit(q, i), nb.numberField(nb.INTEGER))
        i += 1
    }
    if nq.lowerDisplay(q) < 0 || f.*.decimalAlways {
        if f.*.affixes.currencyAsDecimal {
            length += nb.insertText(b, index + length, currencySymbolText(f), nb.numberField(nb.CURRENCY))
        } else {
            length += nb.insertText(b, index + length, if f.*.isCurrency { f.*.monetaryDecimal } else { f.*.decimalSymbol }, nb.numberField(nb.DECIMAL_SEPARATOR))
        }
    }
    const fractionCount = -nq.lowerDisplay(q)
    var k: i32 = 0
    while k < fractionCount {
        length += insertDigit(f, b, index + length, nq.digit(q, -k - 1), nb.numberField(nb.FRACTION))
        k += 1
    }
    if length == 0 { length += insertDigit(f, b, index, 0, nb.numberField(nb.INTEGER)) }
    return length
}

// The single currency sign's text for the unit width.
fn currencySymbolText(f: *const Formatter) -> []const u8 {
    if f.*.unitWidth == sk.WIDTH_ISO_CODE { return f.*.currencyIso[0..3] }
    if f.*.unitWidth == sk.WIDTH_HIDDEN { return "" }
    if f.*.currencySymbol.length == 0 && f.*.isCurrency { return f.*.currencyIso[0..3] }
    return f.*.currencySymbol
}

// The scientific modifier: the exponent after the number at RIGHT.
pub fn applyExponent(f: *const Formatter, exponent: i32, b: *nb.Builder, right: usize) -> usize {
    var i = right
    i += nb.insertText(b, i, f.*.exponential, nb.numberField(nb.EXPONENT_SYMBOL))
    const s = f.*.settings.exponentSign
    if exponent < 0 && s != sk.SIGN_NEVER {
        i += nb.insertText(b, i, f.*.minusSign, nb.numberField(nb.EXPONENT_SIGN))
    } else if exponent >= 0 && s == sk.SIGN_ALWAYS {
        i += nb.insertText(b, i, f.*.plusSign, nb.numberField(nb.EXPONENT_SIGN))
    }
    var value = if exponent < 0 { -exponent } else { exponent }
    var j: i32 = 0
    while j < f.*.settings.minExponentDigits || value > 0 {
        i += insertDigit(f, b, i - @intCast(usize, j), @intCast(u8, value % 10), nb.numberField(nb.EXPONENT))
        value /= 10
        j += 1
    }
    return i - right
}

// The symbols the affixes take, for PLURAL (¤¤¤).
fn symbolTexts(f: *const Formatter, plural: usize) -> np.SymbolText {
    return np.SymbolText.{
        .minus = f.*.minusSign,
        .plus = f.*.plusSign,
        .approximately = f.*.approximatelySign,
        .percent = f.*.percentSign,
        .permille = f.*.permilleSign,
        .currencySingle = currencySymbolText(f),
        .currencyDouble = f.*.intlSymbol,
        .currencyTriple = if plural < 6 { f.*.pluralNames[plural] } else { f.*.pluralNames[PLURAL_OTHER] },
    }
}

// The middle modifier's affixes of MICROS.
pub fn middleAffixes(f: *const Formatter, micros: *const Micros, out: *np.Affixes) -> void {
    if micros.*.compact {
        var info: np.Info = undefined
        np.parse(micros.*.compactPattern, &info)
        out.* = np.affixesOf(&info)
    } else {
        out.* = f.*.affixes
    }
}

// The middle modifier's prefix (IS_PREFIX) or suffix into B at INDEX.
pub fn insertAffix(f: *const Formatter, micros: *const Micros, affixes: *const np.Affixes, isPrefix: bool, b: *nb.Builder, index: usize) -> usize {
    var pattern = m.bytesBuffer()
    np.affixPattern(affixes, isPrefix, micros.*.signType, micros.*.approximately, f.*.isPermille, &pattern)
    const symbols = symbolTexts(f, micros.*.plural)
    const field = if micros.*.compact { nb.numberField(nb.COMPACT) } else { nb.NONE }
    const length = np.render(m.bytesText(&pattern), &symbols, b, index, field)
    m.disposeBytes(&pattern)
    return length
}

// The middle modifier around [LEFT, RIGHT) (ICU's
// MutablePatternModifier::apply): prefix, suffix, the number taken out
// when the pattern has none, currency spacing.
pub fn applyMiddle(f: *const Formatter, micros: *const Micros, b: *nb.Builder, left: usize, right: usize) -> i32 {
    var prefix: usize = 0
    return applyMiddlePrefix(f, micros, b, left, right, &prefix)
}

// The same, the prefix's length into PREFIX.
pub fn applyMiddlePrefix(f: *const Formatter, micros: *const Micros, b: *nb.Builder, left: usize, right: usize, prefix: *usize) -> i32 {
    var affixes: np.Affixes = undefined
    middleAffixes(f, micros, &affixes)
    const prefixLength = insertAffix(f, micros, &affixes, true, b, left)
    prefix.* = prefixLength
    const suffixLength = insertAffix(f, micros, &affixes, false, b, right + prefixLength)
    var overwrite: i32 = 0
    if !affixes.hasBody {
        overwrite = nb.remove(b, left + prefixLength, right + prefixLength)
    }
    const spaced = applyCurrencySpacing(f, b, left, prefixLength, @intCast(usize, @intCast(i32, right + prefixLength) + overwrite), suffixLength)
    return @intCast(i32, prefixLength + suffixLength) + overwrite + @intCast(i32, spaced)
}

fn isDigitChar(c: u32) -> bool { return properties.category(@intCast(i32, c)) == 9 }

fn isNotSymbolOrSeparator(c: u32) -> bool {
    const g = properties.category(@intCast(i32, c))
    return !(g == 18 || g == 25 || g == 26 || g == 27 || g == 12 || g == 13 || g == 14)
}

fn applyCurrencySpacing(f: *const Formatter, b: *nb.Builder, prefixStart: usize, prefixLength: usize, suffixStart: usize, suffixLength: usize) -> usize {
    var length: usize = 0
    const hasNumber = suffixStart > prefixStart + prefixLength
    if prefixLength > 0 && hasNumber { length += spacingAffix(f, b, prefixStart + prefixLength, true) }
    if suffixLength > 0 && hasNumber { length += spacingAffix(f, b, suffixStart + length, false) }
    return length
}

fn spacingAffix(f: *const Formatter, b: *nb.Builder, index: usize, isPrefix: bool) -> usize {
    if isPrefix && index == 0 { return 0 }
    if !isPrefix && index >= b.*.length { return 0 }
    const field = if isPrefix { nb.fieldAt(b, index - 1) } else { nb.fieldAt(b, index) }
    if field != nb.numberField(nb.CURRENCY) { return 0 }
    const affixChar = if isPrefix { nb.codePointBefore(b, index) } else { nb.codePointAt(b, index) }
    if !isNotSymbolOrSeparator(affixChar) { return 0 }
    const numberChar = if isPrefix { nb.codePointAt(b, index) } else { nb.codePointBefore(b, index) }
    if !isDigitChar(numberChar) { return 0 }
    return nb.insertText(b, index, if isPrefix { f.*.spacingAfter } else { f.*.spacingBefore }, nb.NONE)
}

// The outer modifier: the currency's long name for PLURAL around
// [LEFT, RIGHT) (a SimpleModifier of "{0} US dollars").
pub fn applyOuter(f: *const Formatter, plural: usize, b: *nb.Builder, left: usize, right: usize) -> i32 {
    var prefix: usize = 0
    return applyOuterPrefix(f, plural, b, left, right, &prefix)
}

// The same, the prefix's length into PREFIX.
pub fn applyOuterPrefix(f: *const Formatter, plural: usize, b: *nb.Builder, left: usize, right: usize, prefixOut: *usize) -> i32 {
    prefixOut.* = 0
    if plural >= 6 { return 0 }
    if f.*.unitNames { return applyUnit(f, plural, b, left, right, prefixOut) }
    var pattern = f.*.unitPatterns[plural]
    if pattern.length == 0 { pattern = f.*.unitPatterns[PLURAL_OTHER] }
    if pattern.length == 0 { pattern = "{0} {1}" }
    const name = f.*.pluralNames[plural]
    // The text before and after {0}, with {1} the name.
    var prefix = m.bytesBuffer()
    var suffix = m.bytesBuffer()
    var hasArgument = false
    var at: usize = 0
    while at < pattern.length {
        const target = if hasArgument { &suffix } else { &prefix }
        if pattern[at] == 123 && at + 2 < pattern.length && pattern[at + 2] == 125 {
            if pattern[at + 1] == 48 {
                hasArgument = true
                at += 3
                continue
            }
            if pattern[at + 1] == 49 {
                m.pushText(target, if name.length > 0 { name } else { currency.codeText(&f.*.code) })
                at += 3
                continue
            }
        }
        if pattern[at] == 39 && at + 1 < pattern.length && pattern[at + 1] == 39 {
            m.pushByte(target, 39)
            at += 2
            continue
        }
        m.pushByte(target, pattern[at])
        at += 1
    }
    const field = nb.numberField(nb.CURRENCY)
    var length: i32 = 0
    if !hasArgument {
        length = nb.remove(b, left, right)
        const inserted = nb.insertText(b, left, m.bytesText(&prefix), field)
        prefixOut.* = inserted
        length += @intCast(i32, inserted)
    } else {
        const before = nb.insertText(b, left, m.bytesText(&prefix), field)
        const after = nb.insertText(b, right + before, m.bytesText(&suffix), field)
        prefixOut.* = before
        length = @intCast(i32, before + after)
    }
    m.disposeBytes(&prefix)
    m.disposeBytes(&suffix)
    return length
}

// A measure unit's pattern for PLURAL around [LEFT, RIGHT) (ICU's
// SimpleModifier of the LongNameHandler): the text before its argument
// and after it, the number taken out when it has none.
fn applyUnit(f: *const Formatter, plural: usize, b: *nb.Builder, left: usize, right: usize, prefixOut: *usize) -> i32 {
    var prefix = m.bytesBuffer()
    var suffix = m.bytesBuffer()
    const hasArgument = mu.split(f.*.unitPatterns[plural], &prefix, &suffix)
    const field = nb.numberField(nb.MEASURE_UNIT)
    var length: i32 = 0
    if !hasArgument {
        length = nb.remove(b, left, right)
        const inserted = nb.insertText(b, left, m.bytesText(&prefix), field)
        prefixOut.* = inserted
        length += @intCast(i32, inserted)
    } else {
        const before = nb.insertText(b, left, m.bytesText(&prefix), field)
        const after = nb.insertText(b, right + before, m.bytesText(&suffix), field)
        prefixOut.* = before
        length = @intCast(i32, before + after)
    }
    m.disposeBytes(&prefix)
    m.disposeBytes(&suffix)
    return length
}

// The middle modifier's prefix and suffix on their own (for comparing
// two numbers' modifiers), and whether its pattern has a number.
pub fn middleParts(f: *const Formatter, micros: *const Micros, prefix: *nb.Builder, suffix: *nb.Builder) -> bool {
    var affixes: np.Affixes = undefined
    middleAffixes(f, micros, &affixes)
    _ = insertAffix(f, micros, &affixes, true, prefix, 0)
    _ = insertAffix(f, micros, &affixes, false, suffix, 0)
    return affixes.hasBody
}

// The code points of the outer modifier (the long name's text).
pub fn outerCodePoints(f: *const Formatter, plural: usize) -> usize {
    if plural >= 6 { return 0 }
    var b = nb.builder()
    _ = applyOuter(f, plural, &b, 0, 0)
    const count = nb.codePointCount(&b)
    nb.dispose(&b)
    return count
}

// DecimalFormat's padding around the middle and outer modifiers.
fn applyPadding(f: *const Formatter, micros: *const Micros, b: *nb.Builder, left: usize, right: usize) -> i32 {
    // The widths of the modifiers and the number.
    var middle = nb.builder()
    _ = applyMiddle(f, micros, &middle, 0, 0)
    const affixCount = nb.codePointCount(&middle)
    nb.dispose(&middle)
    var numberCount: usize = 0
    var at = left
    while at < right {
        _ = nd.decode16(b.*.units, right, &at)
        numberCount += 1
    }
    const width = f.*.padWidth
    var padding = width - @intCast(i32, affixCount + numberCount)
    var length: i32 = 0
    if padding > 0 && f.*.padPosition == 1 {
        var p = padding
        while p > 0 {
            length += @intCast(i32, nb.insertText(b, left, f.*.padText[0..f.*.padLength], nb.NONE))
            p -= 1
        }
        padding = 0
    }
    if padding > 0 && f.*.padPosition == 2 {
        var p = padding
        while p > 0 {
            length += @intCast(i32, nb.insertText(b, @intCast(usize, @intCast(i32, right) + length), f.*.padText[0..f.*.padLength], nb.NONE))
            p -= 1
        }
        padding = 0
    }
    length += applyMiddle(f, micros, b, left, @intCast(usize, @intCast(i32, right) + length))
    length += applyOuter(f, micros.*.outerPlural, b, left, @intCast(usize, @intCast(i32, right) + length))
    if padding > 0 {
        var p = padding
        while p > 0 {
            if f.*.padPosition == 0 {
                length += @intCast(i32, nb.insertText(b, left, f.*.padText[0..f.*.padLength], nb.NONE))
            } else {
                length += @intCast(i32, nb.insertText(b, @intCast(usize, @intCast(i32, right) + length), f.*.padText[0..f.*.padLength], nb.NONE))
            }
            p -= 1
        }
    }
    return length
}

// The modifiers around the number [START, END) (ICU's writeAffixes).
pub fn writeAffixes(f: *const Formatter, micros: *const Micros, b: *nb.Builder, start: usize, end: usize) -> i32 {
    var length: i32 = 0
    if micros.*.scientific { length = @intCast(i32, applyExponent(f, micros.*.exponent, b, end)) }
    if f.*.padWidth > 0 && f.*.padLength > 0 {
        return length + applyPadding(f, micros, b, start, @intCast(usize, @intCast(i32, end) + length))
    }
    length += applyMiddle(f, micros, b, start, @intCast(usize, @intCast(i32, end) + length))
    length += applyOuter(f, micros.*.outerPlural, b, start, @intCast(usize, @intCast(i32, end) + length))
    return length
}

// Q formatted into B (cleared first): STATUS an i32 *.
pub fn format(f: *Formatter, q: *nq.Quantity, b: *nb.Builder, status: *i32) -> void {
    nb.clear(b)
    var micros: Micros = undefined
    preProcess(f, q, &micros, false, status)
    if status.* > 0 { return }
    const length = writeNumber(f, q, b, 0)
    _ = writeAffixes(f, &micros, b, 0, length)
}

// ---------------------------------------------------------------------------
// The C API: UNumberFormatter.

fn copyUtf16Locale(f: *Formatter, localeId: usize) -> void {
    if localeId == 0 {
        setLocale(f, locale.defaultLocale())
    } else {
        setLocale(f, m.cSlice(localeId))
    }
}

// A formatter of a parsed skeleton for LOCALE (C string, 0 for the
// default): its address.
pub fn create(s: *const sk.Settings, localeId: usize, status: usize) -> usize {
    var none: np.Affixes = undefined
    return createWith(s, localeId, &none, false, status)
}

// The same with a DecimalFormat's affixes (CUSTOM, when USE_CUSTOM).
pub fn createWith(s: *const sk.Settings, localeId: usize, custom: *const np.Affixes, useCustom: bool, status: usize) -> usize {
    const address = m.alloc(@sizeOf(Formatter))
    if address == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    const f = formatterAt(address)
    f.*.magic = MAGIC
    f.*.settings = s.*
    f.*.fault = 0
    copyUtf16Locale(f, localeId)
    resolve(f, custom, useCustom)
    return address
}

pub fn destroy(address: usize) -> void {
    if !isFormatter(address) { return }
    const f = formatterAt(address)
    if f.*.scale != 0 { m.release(f.*.scale) }
    if f.*.unitBlock != 0 { m.release(f.*.unitBlock) }
    f.*.magic = 0
    m.release(address)
}

fn openForSkeleton(skeleton: usize, skeletonLen: i32, localeId: usize, perror: usize, ec: usize) -> usize {
    if m.failed(ec) { return 0 }
    if perror != 0 {
        m.putI32(perror, 0)
        m.putI32(perror + 4, -1)
        m.put16(perror + 8, 0)
        m.put16(perror + 40, 0)
    }
    const length = if skeleton == 0 { 0 } else { m.units(skeleton, skeletonLen) }
    const address = m.alloc(@sizeOf(sk.Settings))
    const s: *sk.Settings = unsafe { @ptrFromInt(*sk.Settings, address) }
    var offset: i32 = 0
    const result = sk.parse(skeleton, length, s, &offset)
    if result != 0 {
        m.setError(ec, result)
        if perror != 0 { parseErrorContext(perror, skeleton, length, offset) }
    }
    const f = create(s, localeId, ec)
    m.release(address)
    return f
}

// The offset and the text around it in a UParseError (ICU's 16 units of
// context each side, the last one the NUL).
pub fn parseErrorContext(perror: usize, text: usize, length: usize, offset: i32) -> void {
    m.putI32(perror + 4, offset)
    const at = @intCast(usize, offset)
    const start = if at >= 15 { at - 15 } else { 0 }
    var k: usize = 0
    while start + k < at {
        m.put16(perror + 8 + k * 2, m.get16(text + (start + k) * 2))
        k += 1
    }
    m.put16(perror + 8 + k * 2, 0)
    const end = if at + 15 < length { at + 15 } else { length }
    k = 0
    while at + k < end {
        m.put16(perror + 40 + k * 2, m.get16(text + (at + k) * 2))
        k += 1
    }
    m.put16(perror + 40 + k * 2, 0)
}

pub fn unumf_openForSkeletonAndLocale(skeleton: usize, skeletonLen: i32, localeId: usize, ec: usize) -> usize {
    return openForSkeleton(skeleton, skeletonLen, localeId, 0, ec)
}

pub fn unumf_openForSkeletonAndLocaleWithError(skeleton: usize, skeletonLen: i32, localeId: usize, perror: usize, ec: usize) -> usize {
    return openForSkeleton(skeleton, skeletonLen, localeId, perror, ec)
}

pub fn unumf_close(uformatter: usize) -> void { destroy(uformatter) }

// UFormattedNumber: a formatted value (formatted.mlx) keeping the
// quantity formatted (its address).
pub fn openResult(ec: usize) -> usize {
    if m.failed(ec) { return 0 }
    const value = formatted.create(RESULT_KIND, 8)
    if value == 0 {
        m.setError(ec, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    m.putWord(formatted.extra(value), nq.create())
    return value
}

pub fn resultQuantity(result: usize) -> *nq.Quantity { return nq.at(m.getWord(formatted.extra(result))) }

pub fn unumf_openResult(ec: usize) -> usize { return openResult(ec) }

pub fn unumf_closeResult(uresult: usize) -> void {
    if !formatted.isKind(uresult, RESULT_KIND) { return }
    nq.destroy(m.getWord(formatted.extra(uresult)))
    formatted.destroy(uresult)
}

// Checks a formatter and a result as ICU's C API does.
pub fn validResult(uresult: usize, ec: usize) -> bool {
    if m.failed(ec) { return false }
    if uresult == 0 {
        m.setError(ec, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    if !formatted.isKind(uresult, RESULT_KIND) {
        m.setError(ec, INVALID_FORMAT_ERROR)
        return false
    }
    return true
}

fn validFormatter(uformatter: usize, ec: usize) -> bool {
    if m.failed(ec) { return false }
    if uformatter == 0 {
        m.setError(ec, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    if !isFormatter(uformatter) {
        m.setError(ec, INVALID_FORMAT_ERROR)
        return false
    }
    return true
}

// Formats the result's quantity (set by the caller) into the result.
pub fn formatResult(uformatter: usize, uresult: usize, ec: usize) -> void {
    const f = formatterAt(uformatter)
    const q = resultQuantity(uresult)
    var b = nb.builder()
    var status: i32 = 0
    format(f, q, &b, &status)
    if status > 0 {
        formatted.clear(uresult)
        m.setError(ec, status)
        nb.dispose(&b)
        return
    }
    var none: [1]nb.SpanInfo = undefined
    nb.toValue(&b, uresult, 0, &none, 0)
    nb.dispose(&b)
}

pub fn unumf_formatInt(uformatter: usize, value: i64, uresult: usize, ec: usize) -> void {
    if !validFormatter(uformatter, ec) { return }
    if !validResult(uresult, ec) { return }
    nq.setInt(resultQuantity(uresult), value)
    formatResult(uformatter, uresult, ec)
}

pub fn unumf_formatDouble(uformatter: usize, value: f64, uresult: usize, ec: usize) -> void {
    if !validFormatter(uformatter, ec) { return }
    if !validResult(uresult, ec) { return }
    setDoubleWithSign(resultQuantity(uresult), value)
    formatResult(uformatter, uresult, ec)
}

// A double as ICU's DecimalQuantity takes it (NaN keeps its sign).
pub fn setDoubleWithSign(q: *nq.Quantity, value: f64) -> void {
    nq.setDouble(q, value)
    if value != value { q.*.d.negative = (@bitCast(u64, value) >> 63) != 0 }
}

// Decimal text (VALUE, LENGTH bytes, -1 for a C string) into Q; false when
// it is not a number.
pub fn setDecimalText(q: *nq.Quantity, value: usize, valueLen: i32) -> bool {
    if value == 0 { return false }
    const length = if valueLen < 0 { m.cLength(value) } else { @intCast(usize, valueLen) }
    return nq.setText(q, m.bytes(value, length))
}

pub fn unumf_formatDecimal(uformatter: usize, value: usize, valueLen: i32, uresult: usize, ec: usize) -> void {
    if !validFormatter(uformatter, ec) { return }
    if !validResult(uresult, ec) { return }
    formatted.clear(uresult)
    if !setDecimalText(resultQuantity(uresult), value, valueLen) {
        m.setError(ec, DECIMAL_NUMBER_SYNTAX_ERROR)
        return
    }
    formatResult(uformatter, uresult, ec)
}

pub fn unumf_resultAsValue(uresult: usize, ec: usize) -> usize {
    if !validResult(uresult, ec) { return 0 }
    return uresult
}

pub fn unumf_resultToString(uresult: usize, buffer: usize, bufferCapacity: i32, ec: usize) -> i32 {
    if !validResult(uresult, ec) { return 0 }
    if (buffer == 0 && bufferCapacity != 0) || (buffer != 0 && bufferCapacity < 0) {
        m.setError(ec, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    return formatted.extract(uresult, buffer, bufferCapacity, ec)
}

// The next position of UFieldPosition UFPOS's field after its end (ICU's
// nextFieldPosition); a missing fraction is put after the integer.
pub fn unumf_resultNextFieldPosition(uresult: usize, ufpos: usize, ec: usize) -> bool {
    if !validResult(uresult, ec) { return false }
    if ufpos == 0 {
        m.setError(ec, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    return nextFieldPosition(uresult, ufpos, ec)
}

pub fn nextFieldPosition(value: usize, ufpos: usize, ec: usize) -> bool {
    const field = m.getI32(ufpos)
    if field == -1 { return false }
    if field < 0 || field >= 14 {
        m.setError(ec, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    const endIndex = m.getI32(ufpos + 8)
    var s: usize = 0
    while s < formatted.spanCount(value) {
        const span = formatted.spanAddress(value, s)
        if m.getI32(span) == 2 && m.getI32(span + 4) == field && m.getI32(span + 8) >= endIndex {
            m.putI32(ufpos + 4, m.getI32(span + 8))
            m.putI32(ufpos + 8, m.getI32(span + 12))
            return true
        }
        s += 1
    }
    // No fraction: the position after the integer (and its decimal point).
    if field == 1 && endIndex == 0 {
        var inside = false
        var i: usize = 0
        const length = formatted.length(value)
        const spansText = value
        while i < length {
            if insideNumber(spansText, i) {
                inside = true
            } else if inside {
                break
            }
            i += 1
        }
        m.putI32(ufpos + 4, @intCast(i32, i))
        m.putI32(ufpos + 8, @intCast(i32, i))
    }
    return false
}

// Whether unit I of a result is in its integer, a grouping separator or
// the decimal separator.
fn insideNumber(value: usize, i: usize) -> bool {
    var s: usize = 0
    while s < formatted.spanCount(value) {
        const span = formatted.spanAddress(value, s)
        const f = m.getI32(span + 4)
        if m.getI32(span) == 2 && (f == 0 || f == 6 || f == 2) && @intCast(i32, i) >= m.getI32(span + 8) && @intCast(i32, i) < m.getI32(span + 12) { return true }
        s += 1
    }
    return false
}

pub fn unumf_resultGetAllFieldPositions(uresult: usize, ufpositer: usize, ec: usize) -> void {
    if !validResult(uresult, ec) { return }
    if ufpositer == 0 {
        m.setError(ec, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    formatted.fillIterator(ufpositer, uresult, 2)
}

pub fn unumf_resultToDecimalNumber(uresult: usize, dest: usize, destCapacity: i32, ec: usize) -> i32 {
    if !validResult(uresult, ec) { return 0 }
    var text = m.bytesBuffer()
    nq.decimalText(resultQuantity(uresult), &text)
    const length = m.give(m.bytesText(&text), dest, destCapacity, ec)
    m.disposeBytes(&text)
    return length
}
