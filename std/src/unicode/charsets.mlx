// Charset detection (ucsdet.h): each charset known here rates the bytes
// from 0 to 100 and the matches come sorted by their rating:
//
//   - UTF-8, UTF-16, UTF-32: a byte order mark, and how many sequences
//     are valid and invalid (the ways ICU rates them);
//   - ISO-2022-JP, -KR, -CN: their escape sequences, recognized and not;
//   - Shift_JIS, EUC-JP, EUC-KR, GB18030, Big5: their byte structure,
//     double-byte characters against bad ones, with a share of kana or
//     hangul as a hint between the Japanese and Korean ones;
//   - ISO-8859-1 and windows-1252 (for the bytes 0x80 to 0x9F): text
//     without control characters.
//
// Markup (`<...>`) is left out of the rating when the input filter is on
// and the text has enough of it.
const m = @import("std.unicode.memory")
const enumeration = @import("std.unicode.enumeration")

const UTF_8: usize = 0
const UTF_16BE: usize = 1
const UTF_16LE: usize = 2
const UTF_32BE: usize = 3
const UTF_32LE: usize = 4
const ISO_2022_JP: usize = 5
const ISO_2022_KR: usize = 6
const ISO_2022_CN: usize = 7
const SHIFT_JIS: usize = 8
const EUC_JP: usize = 9
const EUC_KR: usize = 10
const GB18030: usize = 11
const BIG5: usize = 12
const ISO_8859_1: usize = 13
const WINDOWS_1252: usize = 14
const COUNT: usize = 15

fn nameOf(charset: usize) -> []const u8 {
    if charset == UTF_8 { return "UTF-8" }
    if charset == UTF_16BE { return "UTF-16BE" }
    if charset == UTF_16LE { return "UTF-16LE" }
    if charset == UTF_32BE { return "UTF-32BE" }
    if charset == UTF_32LE { return "UTF-32LE" }
    if charset == ISO_2022_JP { return "ISO-2022-JP" }
    if charset == ISO_2022_KR { return "ISO-2022-KR" }
    if charset == ISO_2022_CN { return "ISO-2022-CN" }
    if charset == SHIFT_JIS { return "Shift_JIS" }
    if charset == EUC_JP { return "EUC-JP" }
    if charset == EUC_KR { return "EUC-KR" }
    if charset == GB18030 { return "GB18030" }
    if charset == BIG5 { return "Big5" }
    if charset == ISO_8859_1 { return "ISO-8859-1" }
    return "windows-1252"
}

fn languageOf(charset: usize) -> []const u8 {
    if charset == ISO_2022_JP || charset == SHIFT_JIS || charset == EUC_JP { return "ja" }
    if charset == ISO_2022_KR || charset == EUC_KR { return "ko" }
    if charset == ISO_2022_CN || charset == GB18030 || charset == BIG5 { return "zh" }
    return ""
}

const Match = struct {
    charset: usize
    confidence: i32
    detector: usize
}

const Detector = struct {
    text: usize
    length: usize
    // The bytes rated: the text, or the text without its markup.
    rated: usize
    ratedLength: usize
    filter: bool
    disabled: u32
    matches: [15]Match
    pointers: [15]usize
    matchCount: usize
}

fn detector(address: usize) -> *Detector { unsafe { return @ptrFromInt(*Detector, address) } }

fn byteAt(d: *Detector, index: usize) -> u32 { return @intCast(u32, m.get8(d.*.rated + index)) }

// ---------------------------------------------------------------------------
// The Unicode forms

fn rateUTF8(d: *Detector) -> i32 {
    const length = d.*.ratedLength
    const hasBOM = length >= 3 && byteAt(d, 0) == 239 && byteAt(d, 1) == 187 && byteAt(d, 2) == 191
    var valid: i32 = 0
    var invalid: i32 = 0
    var i: usize = 0
    while i < length {
        const b = byteAt(d, i)
        if (b & 128) != 0 {
            var trail: usize = 0
            if (b & 224) == 192 {
                trail = 1
            } else if (b & 240) == 224 {
                trail = 2
            } else if (b & 248) == 240 {
                trail = 3
            } else {
                invalid += 1
                i += 1
                continue
            }
            while true {
                i += 1
                if i >= length { break }
                if (byteAt(d, i) & 192) != 128 {
                    invalid += 1
                    break
                }
                trail -= 1
                if trail == 0 {
                    valid += 1
                    break
                }
            }
        }
        i += 1
    }
    if hasBOM && invalid == 0 { return 100 }
    if hasBOM && valid > invalid * 10 { return 80 }
    if valid > 3 && invalid == 0 { return 100 }
    if valid > 0 && invalid == 0 { return 80 }
    if valid == 0 && invalid == 0 { return 15 }
    if valid > invalid * 10 { return 25 }
    return 0
}

fn adjustConfidence(unit: u32, confidence: i32) -> i32 {
    var result = confidence
    if unit == 0 {
        result -= 10
    } else if (unit >= 32 && unit <= 255) || unit == 10 {
        result += 10
    }
    if result < 0 { result = 0 }
    if result > 100 { result = 100 }
    return result
}

fn rateUTF16(d: *Detector, bigEndian: bool) -> i32 {
    const length = d.*.ratedLength
    var confidence: i32 = 10
    const check = if length > 30 { 30 } else { length }
    var i: usize = 0
    while i + 1 < check {
        const unit = if bigEndian { (byteAt(d, i) << 8) | byteAt(d, i + 1) } else { (byteAt(d, i + 1) << 8) | byteAt(d, i) }
        if i == 0 && unit == 65279 {
            // FF FE 00 00 is UTF-32LE's mark.
            if !bigEndian && length >= 4 && byteAt(d, 2) == 0 && byteAt(d, 3) == 0 {
                confidence = 10
            } else {
                confidence = 100
                break
            }
        }
        confidence = adjustConfidence(unit, confidence)
        if confidence == 0 || confidence == 100 { break }
        i += 2
    }
    if check < 4 && confidence < 100 { confidence = 0 }
    return confidence
}

fn rateUTF32(d: *Detector, bigEndian: bool) -> i32 {
    const limit = d.*.ratedLength / 4 * 4
    if limit == 0 { return 0 }
    var valid: i32 = 0
    var invalid: i32 = 0
    var hasBOM = false
    var i: usize = 0
    while i < limit {
        const c = if bigEndian { (byteAt(d, i) << 24) | (byteAt(d, i + 1) << 16) | (byteAt(d, i + 2) << 8) | byteAt(d, i + 3) } else { (byteAt(d, i + 3) << 24) | (byteAt(d, i + 2) << 16) | (byteAt(d, i + 1) << 8) | byteAt(d, i) }
        if i == 0 && c == 65279 { hasBOM = true }
        if c >= 1114111 || (c >= 55296 && c <= 57343) { invalid += 1 } else { valid += 1 }
        i += 4
    }
    if hasBOM && invalid == 0 { return 100 }
    if hasBOM && valid > invalid * 10 { return 80 }
    if valid > 3 && invalid == 0 { return 100 }
    if valid > 0 && invalid == 0 { return 80 }
    if valid > invalid * 10 { return 25 }
    return 0
}

// ---------------------------------------------------------------------------
// ISO-2022: the escape sequences of each (after ESC), "|"-separated.

const ESCAPES_JP: []const u8 = "$(C|$(D|$@|$A|$B|&@|(B|(H|(I|(J|.A|.F|"
const ESCAPES_KR: []const u8 = "$)C|"
const ESCAPES_CN: []const u8 = "$)A|$)G|$*H|$)E|$+I|$+J|$+K|$+L|$+M|N|O|"

// The length of the escape at `at` (after the ESC) in `escapes`; 0.
fn escapeAt(d: *Detector, at: usize, escapes: []const u8) -> usize {
    var start: usize = 0
    var index: usize = 0
    while index < escapes.length {
        if escapes[index] == 124 {
            const count = index - start
            if at + count <= d.*.ratedLength {
                var k: usize = 0
                var same = true
                while k < count {
                    if byteAt(d, at + k) != @intCast(u32, escapes[start + k]) { same = false }
                    k += 1
                }
                if same { return count }
            }
            start = index + 1
        }
        index += 1
    }
    return 0
}

fn rate2022(d: *Detector, escapes: []const u8) -> i32 {
    var hits: i32 = 0
    var misses: i32 = 0
    var shifts: i32 = 0
    var i: usize = 0
    while i < d.*.ratedLength {
        const b = byteAt(d, i)
        if b == 27 {
            const count = escapeAt(d, i + 1, escapes)
            if count > 0 {
                hits += 1
                i += count + 1
                continue
            }
            misses += 1
        }
        if b == 14 || b == 15 { shifts += 1 }
        i += 1
    }
    if hits == 0 { return 0 }
    var quality = (100 * hits - 100 * misses) / (hits + misses)
    if hits + shifts < 5 { quality -= (5 - (hits + shifts)) * 10 }
    return if quality < 0 { 0 } else { quality }
}

// ---------------------------------------------------------------------------
// The multi-byte charsets: characters read by their structure.

const Counts = struct {
    single: i32
    double: i32
    bad: i32
    hint: i32
}

// The bytes of the character at `at` (0 at the end), bad ones counted.
fn nextChar(d: *Detector, charset: usize, at: usize, counts: *Counts) -> usize {
    const length = d.*.ratedLength
    if at >= length { return 0 }
    const b = byteAt(d, at)
    if b < 128 {
        counts.*.single += 1
        return 1
    }
    const second = if at + 1 < length { byteAt(d, at + 1) } else { 256 }
    if charset == SHIFT_JIS {
        if b >= 161 && b <= 223 {
            counts.*.single += 1
            return 1
        }
        if ((b >= 129 && b <= 159) || (b >= 224 && b <= 252)) && ((second >= 64 && second <= 126) || (second >= 128 && second <= 252)) {
            counts.*.double += 1
            if b == 130 || b == 131 { counts.*.hint += 1 }
            return 2
        }
    } else if charset == EUC_JP || charset == EUC_KR {
        if charset == EUC_JP && b == 142 && second >= 161 && second <= 223 {
            counts.*.double += 1
            return 2
        }
        if charset == EUC_JP && b == 143 && at + 2 < length && second >= 161 && second <= 254 && byteAt(d, at + 2) >= 161 && byteAt(d, at + 2) <= 254 {
            counts.*.double += 1
            return 3
        }
        if b >= 161 && b <= 254 && second >= 161 && second <= 254 {
            counts.*.double += 1
            if charset == EUC_JP && (b == 164 || b == 165) { counts.*.hint += 1 }
            if charset == EUC_KR && b >= 176 && b <= 200 { counts.*.hint += 1 }
            return 2
        }
    } else if charset == GB18030 {
        if b >= 129 && b <= 254 {
            if (second >= 64 && second <= 126) || (second >= 128 && second <= 254) {
                counts.*.double += 1
                return 2
            }
            if second >= 48 && second <= 57 && at + 3 < length {
                const third = byteAt(d, at + 2)
                const fourth = byteAt(d, at + 3)
                if third >= 129 && third <= 254 && fourth >= 48 && fourth <= 57 {
                    counts.*.double += 1
                    return 4
                }
            }
        }
    } else if charset == BIG5 {
        if b >= 129 && b <= 254 && ((second >= 64 && second <= 126) || (second >= 161 && second <= 254)) {
            counts.*.double += 1
            return 2
        }
    }
    counts.*.bad += 1
    return 1
}

fn rateMultiByte(d: *Detector, charset: usize) -> i32 {
    var counts = Counts.{ .single = 0, .double = 0, .bad = 0, .hint = 0 }
    var at: usize = 0
    while true {
        const used = nextChar(d, charset, at, &counts)
        if used == 0 { break }
        at += used
    }
    const total = counts.single + counts.double + counts.bad
    if counts.double <= 10 && counts.bad == 0 {
        if counts.double == 0 && total < 10 { return 0 }
        return 10
    }
    if counts.double < 20 * counts.bad { return 0 }
    var confidence = 30 + counts.double - 20 * counts.bad
    // Kana in Japanese text, the hangul syllables in Korean.
    if (charset == SHIFT_JIS || charset == EUC_JP) && counts.hint * 10 >= counts.double * 3 { confidence += 20 }
    if charset == EUC_KR && counts.hint * 10 >= counts.double * 7 { confidence += 20 }
    return if confidence > 100 { 100 } else { confidence }
}

// ---------------------------------------------------------------------------
// Latin-1 and windows-1252

fn rateLatin(d: *Detector, windows: bool) -> i32 {
    var c1Controls: i32 = 0
    var high: i32 = 0
    var letters: i32 = 0
    var i: usize = 0
    while i < d.*.ratedLength {
        const b = byteAt(d, i)
        if b < 32 && b != 9 && b != 10 && b != 13 && b != 12 { return 0 }
        if b == 127 { return 0 }
        if b >= 128 && b <= 159 {
            if b == 129 || b == 141 || b == 143 || b == 144 || b == 157 { return 0 }
            c1Controls += 1
        }
        if b >= 160 { high += 1 }
        if b >= 192 && b != 215 && b != 247 { letters += 1 }
        i += 1
    }
    if windows != (c1Controls > 0) { return 0 }
    if high + c1Controls == 0 { return 40 }
    return if letters * 2 >= high { 50 } else { 30 }
}

// ---------------------------------------------------------------------------
// Markup

fn applyFilter(d: *Detector) -> void {
    d.*.rated = d.*.text
    d.*.ratedLength = d.*.length
    if !d.*.filter || d.*.length == 0 { return }
    const out = m.alloc(d.*.length)
    var length: usize = 0
    var inMarkup = false
    var openTags: i32 = 0
    var badTags: i32 = 0
    var i: usize = 0
    while i < d.*.length {
        const b = m.get8(d.*.text + i)
        if b == 60 {
            if inMarkup { badTags += 1 }
            inMarkup = true
            openTags += 1
        }
        if !inMarkup {
            m.put8(out + length, b)
            length += 1
        }
        if b == 62 { inMarkup = false }
        i += 1
    }
    if openTags < 5 || openTags / 5 < badTags || (length < 100 && d.*.length > 600) {
        m.release(out)
        return
    }
    d.*.rated = out
    d.*.ratedLength = length
}

fn ownsRated(d: *Detector) -> bool { return d.*.rated != d.*.text && d.*.rated != 0 }

// ---------------------------------------------------------------------------
// The C API

pub fn ucsdet_open(status: usize) -> usize {
    if m.failed(status) { return 0 }
    const address = m.alloc(@sizeOf(Detector))
    if address == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    return address
}

pub fn ucsdet_close(ucsd: usize) -> void {
    if ucsd == 0 { return }
    var d = detector(ucsd)
    if ownsRated(d) { m.release(d.*.rated) }
    m.release(ucsd)
}

pub fn ucsdet_setText(ucsd: usize, textIn: usize, len: i32, status: usize) -> void {
    if m.failed(status) { return }
    var d = detector(ucsd)
    if ownsRated(d) { m.release(d.*.rated) }
    d.*.rated = 0
    d.*.text = textIn
    d.*.length = if len < 0 { m.cLength(textIn) } else { @intCast(usize, len) }
    d.*.matchCount = 0
}

pub fn ucsdet_setDeclaredEncoding(ucsd: usize, encoding: usize, length: i32, status: usize) -> void {}

pub fn ucsdet_detectAll(ucsd: usize, matchesFound: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    var d = detector(ucsd)
    if ownsRated(d) { m.release(d.*.rated) }
    d.*.rated = 0
    applyFilter(d)
    d.*.matchCount = 0
    var charset: usize = 0
    while charset < COUNT {
        if (d.*.disabled & (@intCast(u32, 1) << @intCast(u5, charset))) == 0 {
            var confidence: i32 = 0
            if charset == UTF_8 {
                confidence = rateUTF8(d)
            } else if charset == UTF_16BE || charset == UTF_16LE {
                confidence = rateUTF16(d, charset == UTF_16BE)
            } else if charset == UTF_32BE || charset == UTF_32LE {
                confidence = rateUTF32(d, charset == UTF_32BE)
            } else if charset == ISO_2022_JP {
                confidence = rate2022(d, ESCAPES_JP)
            } else if charset == ISO_2022_KR {
                confidence = rate2022(d, ESCAPES_KR)
            } else if charset == ISO_2022_CN {
                confidence = rate2022(d, ESCAPES_CN)
            } else if charset == ISO_8859_1 || charset == WINDOWS_1252 {
                confidence = rateLatin(d, charset == WINDOWS_1252)
            } else {
                confidence = rateMultiByte(d, charset)
            }
            if confidence > 0 {
                // Sorted by confidence, the earlier charset first on a tie.
                var place = d.*.matchCount
                while place > 0 && d.*.matches[place - 1].confidence < confidence {
                    d.*.matches[place] = d.*.matches[place - 1]
                    place -= 1
                }
                d.*.matches[place] = Match.{ .charset = charset, .confidence = confidence, .detector = ucsd }
                d.*.matchCount += 1
            }
        }
        charset += 1
    }
    var index: usize = 0
    while index < d.*.matchCount {
        d.*.pointers[index] = @intFromPtr(&d.*.matches[index])
        index += 1
    }
    if matchesFound != 0 { m.putI32(matchesFound, @intCast(i32, d.*.matchCount)) }
    return @intFromPtr(&d.*.pointers)
}

pub fn ucsdet_detect(ucsd: usize, status: usize) -> usize {
    var found: i32 = 0
    const all = ucsdet_detectAll(ucsd, @intFromPtr(&found), status)
    if all == 0 || found == 0 { return 0 }
    return m.getWord(all)
}

fn matchAt(address: usize) -> *Match { unsafe { return @ptrFromInt(*Match, address) } }

pub fn ucsdet_getName(ucsm: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    return m.literal(nameOf(matchAt(ucsm).*.charset))
}

pub fn ucsdet_getConfidence(ucsm: usize, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    return matchAt(ucsm).*.confidence
}

pub fn ucsdet_getLanguage(ucsm: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    return m.literal(languageOf(matchAt(ucsm).*.charset))
}

var WINDOWS_1252_HIGH: [32]u16 = [32]u16{
    8364, 129, 8218, 402, 8222, 8230, 8224, 8225, 710, 8240, 352, 8249, 338, 141, 381, 143,
    144, 8216, 8217, 8220, 8221, 8226, 8211, 8212, 732, 8482, 353, 8250, 339, 157, 382, 376,
}

// The text as UTF-16 by the match's charset (the Unicode forms, Latin-1
// and windows-1252; the others are not converted here).
pub fn ucsdet_getUChars(ucsm: usize, buf: usize, cap: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    const found = matchAt(ucsm)
    const d = detector(found.*.detector)
    const charset = found.*.charset
    var codes = m.buffer()
    var i: usize = 0
    const text = d.*.text
    const length = d.*.length
    if charset == UTF_8 {
        var start: usize = 0
        if length >= 3 && m.get8(text) == 239 && m.get8(text + 1) == 187 && m.get8(text + 2) == 191 { start = 3 }
        i = start
        while i < length {
            const b0 = @intCast(u32, m.get8(text + i))
            var c: u32 = 65533
            var used: usize = 1
            if b0 < 128 {
                c = b0
            } else if b0 >= 194 && b0 <= 223 && i + 1 < length && (m.get8(text + i + 1) & 192) == 128 {
                c = ((b0 & 31) << 6) | (@intCast(u32, m.get8(text + i + 1)) & 63)
                used = 2
            } else if b0 >= 224 && b0 <= 239 && i + 2 < length && (m.get8(text + i + 1) & 192) == 128 && (m.get8(text + i + 2) & 192) == 128 {
                c = ((b0 & 15) << 12) | ((@intCast(u32, m.get8(text + i + 1)) & 63) << 6) | (@intCast(u32, m.get8(text + i + 2)) & 63)
                if c < 2048 || (c >= 55296 && c <= 57343) { c = 65533 } else { used = 3 }
            } else if b0 >= 240 && b0 <= 244 && i + 3 < length && (m.get8(text + i + 1) & 192) == 128 && (m.get8(text + i + 2) & 192) == 128 && (m.get8(text + i + 3) & 192) == 128 {
                c = ((b0 & 7) << 18) | ((@intCast(u32, m.get8(text + i + 1)) & 63) << 12) | ((@intCast(u32, m.get8(text + i + 2)) & 63) << 6) | (@intCast(u32, m.get8(text + i + 3)) & 63)
                if c < 65536 || c > 1114111 { c = 65533 } else { used = 4 }
            }
            m.push(&codes, c)
            i += used
        }
    } else if charset == UTF_16BE || charset == UTF_16LE {
        const big = charset == UTF_16BE
        while i + 1 < length {
            const a = @intCast(u32, m.get8(text + i))
            const b = @intCast(u32, m.get8(text + i + 1))
            const unit = if big { (a << 8) | b } else { (b << 8) | a }
            if !(i == 0 && unit == 65279) { m.push(&codes, unit) }
            i += 2
        }
    } else if charset == UTF_32BE || charset == UTF_32LE {
        const big = charset == UTF_32BE
        while i + 3 < length {
            const b0 = @intCast(u32, m.get8(text + i))
            const b1 = @intCast(u32, m.get8(text + i + 1))
            const b2 = @intCast(u32, m.get8(text + i + 2))
            const b3 = @intCast(u32, m.get8(text + i + 3))
            var c = if big { (b0 << 24) | (b1 << 16) | (b2 << 8) | b3 } else { (b3 << 24) | (b2 << 16) | (b1 << 8) | b0 }
            if c > 1114111 || (c >= 55296 && c <= 57343) { c = 65533 }
            if !(i == 0 && c == 65279) {
                if c >= 65536 {
                    m.push(&codes, (c >> 10) + 55232)
                    m.push(&codes, (c & 1023) | 56320)
                } else {
                    m.push(&codes, c)
                }
            }
            i += 4
        }
    } else if charset == ISO_8859_1 || charset == WINDOWS_1252 {
        while i < length {
            const b = @intCast(u32, m.get8(text + i))
            if charset == WINDOWS_1252 && b >= 128 && b <= 159 {
                m.push(&codes, @intCast(u32, WINDOWS_1252_HIGH[b - 128]))
            } else {
                m.push(&codes, b)
            }
            i += 1
        }
    } else {
        m.dispose(&codes)
        m.setError(status, m.UNSUPPORTED_ERROR)
        return 0
    }
    // UTF-8's code points to UTF-16; the others are units already.
    var length16: usize = 0
    const room = if cap > 0 { @intCast(usize, cap) } else { 0 }
    i = 0
    while i < codes.length {
        const c = m.at(&codes, i)
        if charset == UTF_8 && c >= 65536 {
            if length16 + 1 < room {
                m.put16(buf + length16 * 2, @intCast(u16, (c >> 10) + 55232))
                m.put16(buf + length16 * 2 + 2, @intCast(u16, (c & 1023) | 56320))
            }
            length16 += 2
        } else {
            if length16 < room { m.put16(buf + length16 * 2, @intCast(u16, c)) }
            length16 += 1
        }
        i += 1
    }
    m.dispose(&codes)
    return m.terminate(buf, length16, cap, status)
}

fn charsetList(d: *Detector, onlyEnabled: bool, status: usize) -> usize {
    var text = m.bytesBuffer()
    var charset: usize = 0
    while charset < COUNT {
        if !onlyEnabled || (d.*.disabled & (@intCast(u32, 1) << @intCast(u5, charset))) == 0 {
            m.pushText(&text, nameOf(charset))
            m.pushByte(&text, 10)
        }
        charset += 1
    }
    const en = enumeration.ofLines(m.bytesText(&text), status)
    m.disposeBytes(&text)
    return en
}

pub fn ucsdet_getAllDetectableCharsets(ucsd: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    return charsetList(detector(ucsd), false, status)
}

pub fn ucsdet_getDetectableCharsets(ucsd: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    return charsetList(detector(ucsd), true, status)
}

pub fn ucsdet_setDetectableCharset(ucsd: usize, encoding: usize, enabled: u8, status: usize) -> void {
    if m.failed(status) { return }
    var d = detector(ucsd)
    const name = m.cSlice(encoding)
    var charset: usize = 0
    while charset < COUNT {
        if m.same(nameOf(charset), name) {
            const bit = @intCast(u32, 1) << @intCast(u5, charset)
            if enabled != 0 { d.*.disabled &= ~bit } else { d.*.disabled |= bit }
            return
        }
        charset += 1
    }
    m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
}

pub fn ucsdet_isInputFilterEnabled(ucsd: usize) -> u8 {
    if ucsd == 0 { return 0 }
    return if detector(ucsd).*.filter { 1 } else { 0 }
}

pub fn ucsdet_enableInputFilter(ucsd: usize, filter: u8) -> u8 {
    if ucsd == 0 { return 0 }
    var d = detector(ucsd)
    const previous: u8 = if d.*.filter { 1 } else { 0 }
    d.*.filter = filter != 0
    return previous
}
