// What the formatters make (uformattedvalue.h, ufieldpositer.h): the text,
// UTF-16 and NUL-terminated, with the spans of its fields (a category, a
// field, where it starts and ends), in the order ufmtval_nextPosition
// gives them (each formatter adds them in ICU's order). A formatter's
// result (UFormattedNumber, UFormattedList...) is a Value with room for
// what else it keeps after it: the value of a result is the result.
//
// UConstrainedFieldPosition is the cursor over the spans: the field it is
// at, what it is constrained to (a category, or a category and a field),
// and its iteration context (the index of the next span).
const m = @import("std.unicode.memory")

// "FVAL": a Value; ufmtval_* check it.
pub const MAGIC: u32 = 1179402572
// "FPOS"
const POSITION_MAGIC: u32 = 1179668307

// A Value at an address:
//     0  u32 the magic, u32 the kind (the result type's own magic)
//     8  the text: its address, length, capacity (UTF-16 units)
//     32 the spans: their address, count, capacity (16 bytes each:
//        i32 category, field, start, limit)
//     56 what the result type keeps
pub const HEADER: usize = 56

pub fn create(kind: u32, extra: usize) -> usize {
    const value = m.alloc(HEADER + extra)
    if value == 0 { return 0 }
    m.put32(value, MAGIC)
    m.put32(value + 4, kind)
    return value
}

pub fn isValue(value: usize) -> bool { return value != 0 && m.get32(value) == MAGIC }
pub fn isKind(value: usize, kind: u32) -> bool { return isValue(value) && m.get32(value + 4) == kind }

// The text and spans off (the result reused for another, or begun: a
// formatted result has a text, empty perhaps).
pub fn clear(value: usize) -> void {
    m.putWord(value + 16, 0)
    m.putWord(value + 40, 0)
    reserve(value, 0)
    m.put16(text(value), 0)
}

pub fn destroy(value: usize) -> void {
    if value == 0 { return }
    if m.getWord(value + 8) != 0 { m.release(m.getWord(value + 8)) }
    if m.getWord(value + 32) != 0 { m.release(m.getWord(value + 32)) }
    m.put32(value, 0)
    m.release(value)
}

pub fn extra(value: usize) -> usize { return value + HEADER }

// ---------------------------------------------------------------------------
// The text.

pub fn length(value: usize) -> usize { return m.getWord(value + 16) }
pub fn text(value: usize) -> usize { return m.getWord(value + 8) }
pub fn unitAt(value: usize, index: usize) -> u16 { return m.get16(text(value) + index * 2) }

fn reserve(value: usize, units: usize) -> void {
    const used = length(value)
    const capacity = m.getWord(value + 24)
    if used + units + 1 <= capacity { return }
    var grown = if capacity < 32 { 32 } else { capacity * 2 }
    while grown < used + units + 1 { grown *= 2 }
    const address = m.grow(m.getWord(value + 8), grown * 2)
    m.putWord(value + 8, address)
    m.putWord(value + 24, grown)
}

pub fn appendUnit(value: usize, unit: u16) -> void {
    reserve(value, 1)
    const used = length(value)
    m.put16(text(value) + used * 2, unit)
    m.put16(text(value) + used * 2 + 2, 0)
    m.putWord(value + 16, used + 1)
}

pub fn appendCodePoint(value: usize, c: u32) -> void {
    if c < 65536 {
        appendUnit(value, @intCast(u16, c))
    } else {
        const v = c - 65536
        appendUnit(value, @intCast(u16, 55296 + (v >> 10)))
        appendUnit(value, @intCast(u16, 56320 + (v & 1023)))
    }
}

// UTF-8 TEXT appended as UTF-16.
pub fn appendText(value: usize, utf8: []const u8) -> void {
    var at: usize = 0
    while at < utf8.length {
        const b = utf8[at]
        var c: u32 = 0
        var extraBytes: usize = 0
        if b < 128 {
            c = @intCast(u32, b)
        } else if b >= 240 {
            c = @intCast(u32, b & 7)
            extraBytes = 3
        } else if b >= 224 {
            c = @intCast(u32, b & 15)
            extraBytes = 2
        } else {
            c = @intCast(u32, b & 31)
            extraBytes = 1
        }
        var k: usize = 0
        while k < extraBytes && at + 1 + k < utf8.length {
            c = (c << 6) | @intCast(u32, utf8[at + 1 + k] & 63)
            k += 1
        }
        appendCodePoint(value, c)
        at += 1 + extraBytes
    }
}

// UTF-16 units of another text appended.
pub fn appendUnits(value: usize, units: usize, count: usize) -> void {
    reserve(value, count)
    var index: usize = 0
    while index < count {
        appendUnit(value, m.get16(units + index * 2))
        index += 1
    }
}

// INSERT (UTF-8) put in at unit AT, the spans after it moved.
pub fn insertText(value: usize, at: usize, utf8: []const u8) -> usize {
    const before = length(value)
    appendText(value, utf8)
    const added = length(value) - before
    if added == 0 { return 0 }
    // Rotate the added units into place.
    const base = text(value)
    var index = before
    var moved: [512]u16 = undefined
    var k: usize = 0
    while k < added && k < 512 {
        moved[k] = m.get16(base + (before + k) * 2)
        k += 1
    }
    index = before
    while index > at {
        index -= 1
        m.put16(base + (index + added) * 2, m.get16(base + index * 2))
    }
    k = 0
    while k < added && k < 512 {
        m.put16(base + (at + k) * 2, moved[k])
        k += 1
    }
    // Spans at or after AT shift; those around it grow.
    var s: usize = 0
    while s < spanCount(value) {
        const span = spanAddress(value, s)
        const start = m.getI32(span + 8)
        const limit = m.getI32(span + 12)
        if start >= @intCast(i32, at) { m.putI32(span + 8, start + @intCast(i32, added)) }
        if limit > @intCast(i32, at) || (limit == @intCast(i32, at) && start >= @intCast(i32, at)) { m.putI32(span + 12, limit + @intCast(i32, added)) }
        s += 1
    }
    return added
}

// ---------------------------------------------------------------------------
// The spans.

pub fn spanCount(value: usize) -> usize { return m.getWord(value + 40) }
pub fn spanAddress(value: usize, index: usize) -> usize { return m.getWord(value + 32) + index * 16 }

pub fn addSpan(value: usize, category: i32, field: i32, start: usize, limit: usize) -> void {
    const count = spanCount(value)
    const capacity = m.getWord(value + 48)
    if count == capacity {
        const grown = if capacity < 8 { 8 } else { capacity * 2 }
        m.putWord(value + 32, m.grow(m.getWord(value + 32), grown * 16))
        m.putWord(value + 48, grown)
    }
    const span = spanAddress(value, count)
    m.putI32(span, category)
    m.putI32(span + 4, field)
    m.putI32(span + 8, @intCast(i32, start))
    m.putI32(span + 12, @intCast(i32, limit))
    m.putWord(value + 40, count + 1)
}

// Span INDEX put at position TO (the ones between moved up).
pub fn moveSpan(value: usize, index: usize, to: usize) -> void {
    if index == to { return }
    var saved: [4]i32 = undefined
    const from = spanAddress(value, index)
    var k: usize = 0
    while k < 4 {
        saved[k] = m.getI32(from + k * 4)
        k += 1
    }
    var at = index
    while at > to {
        m.copy(spanAddress(value, at), spanAddress(value, at - 1), 16)
        at -= 1
    }
    while at < to {
        m.copy(spanAddress(value, at), spanAddress(value, at + 1), 16)
        at += 1
    }
    k = 0
    while k < 4 {
        m.putI32(spanAddress(value, to) + k * 4, saved[k])
        k += 1
    }
}

// ---------------------------------------------------------------------------
// UConstrainedFieldPosition:
//     0 u32 magic, i32 constraint (0 none, 1 category, 2 field)
//     8 i32 constrained category, field
//     16 i32 category, field, start, limit
//     32 i64 the iteration context

fn position(ucfpos: usize, status: usize) -> bool {
    if m.failed(status) { return false }
    if ucfpos == 0 || m.get32(ucfpos) != POSITION_MAGIC {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    return true
}

pub fn ucfpos_open(ec: usize) -> usize {
    if m.failed(ec) { return 0 }
    const p = m.alloc(40)
    if p == 0 {
        m.setError(ec, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    m.put32(p, POSITION_MAGIC)
    return p
}

pub fn ucfpos_reset(ucfpos: usize, ec: usize) -> void {
    if !position(ucfpos, ec) { return }
    m.zero(ucfpos + 4, 36)
}

pub fn ucfpos_close(ucfpos: usize) -> void {
    if ucfpos == 0 { return }
    m.put32(ucfpos, 0)
    m.release(ucfpos)
}

pub fn ucfpos_constrainCategory(ucfpos: usize, category: i32, ec: usize) -> void {
    if !position(ucfpos, ec) { return }
    m.putI32(ucfpos + 4, 1)
    m.putI32(ucfpos + 8, category)
}

pub fn ucfpos_constrainField(ucfpos: usize, category: i32, field: i32, ec: usize) -> void {
    if !position(ucfpos, ec) { return }
    m.putI32(ucfpos + 4, 2)
    m.putI32(ucfpos + 8, category)
    m.putI32(ucfpos + 12, field)
}

pub fn ucfpos_getCategory(ucfpos: usize, ec: usize) -> i32 {
    if !position(ucfpos, ec) { return 0 }
    return m.getI32(ucfpos + 16)
}

pub fn ucfpos_getField(ucfpos: usize, ec: usize) -> i32 {
    if !position(ucfpos, ec) { return 0 }
    return m.getI32(ucfpos + 20)
}

pub fn ucfpos_getIndexes(ucfpos: usize, pStart: usize, pLimit: usize, ec: usize) -> void {
    if !position(ucfpos, ec) { return }
    m.putI32(pStart, m.getI32(ucfpos + 24))
    m.putI32(pLimit, m.getI32(ucfpos + 28))
}

pub fn ucfpos_getInt64IterationContext(ucfpos: usize, ec: usize) -> i64 {
    if !position(ucfpos, ec) { return 0 }
    return m.getI64(ucfpos + 32)
}

pub fn ucfpos_setInt64IterationContext(ucfpos: usize, context: i64, ec: usize) -> void {
    if !position(ucfpos, ec) { return }
    m.putI64(ucfpos + 32, context)
}

fn matches(ucfpos: usize, category: i32, field: i32) -> bool {
    const constraint = m.getI32(ucfpos + 4)
    if constraint == 1 { return category == m.getI32(ucfpos + 8) }
    if constraint == 2 { return category == m.getI32(ucfpos + 8) && field == m.getI32(ucfpos + 12) }
    return true
}

pub fn ucfpos_matchesField(ucfpos: usize, category: i32, field: i32, ec: usize) -> bool {
    if !position(ucfpos, ec) { return false }
    return matches(ucfpos, category, field)
}

pub fn ucfpos_setState(ucfpos: usize, category: i32, field: i32, start: i32, limit: i32, ec: usize) -> void {
    if !position(ucfpos, ec) { return }
    m.putI32(ucfpos + 16, category)
    m.putI32(ucfpos + 20, field)
    m.putI32(ucfpos + 24, start)
    m.putI32(ucfpos + 28, limit)
}

// ---------------------------------------------------------------------------
// UFormattedValue.

fn checked(value: usize, status: usize) -> bool {
    if m.failed(status) { return false }
    if !isValue(value) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    return true
}

pub fn ufmtval_getString(ufmtval: usize, pLength: usize, ec: usize) -> usize {
    if !checked(ufmtval, ec) { return 0 }
    // A result never formatted has no text (U_INVALID_STATE_ERROR).
    if text(ufmtval) == 0 {
        m.setError(ec, 27)
        return 0
    }
    if pLength != 0 { m.putI32(pLength, @intCast(i32, length(ufmtval))) }
    return text(ufmtval)
}

// The next span the constraints allow, after the one the context names.
pub fn ufmtval_nextPosition(ufmtval: usize, ucfpos: usize, ec: usize) -> bool {
    if !checked(ufmtval, ec) || !position(ucfpos, ec) { return false }
    var index = m.getI64(ucfpos + 32)
    while index >= 0 && @intCast(usize, index) < spanCount(ufmtval) {
        const span = spanAddress(ufmtval, @intCast(usize, index))
        index += 1
        if matches(ucfpos, m.getI32(span), m.getI32(span + 4)) {
            m.putI32(ucfpos + 16, m.getI32(span))
            m.putI32(ucfpos + 20, m.getI32(span + 4))
            m.putI32(ucfpos + 24, m.getI32(span + 8))
            m.putI32(ucfpos + 28, m.getI32(span + 12))
            m.putI64(ucfpos + 32, index)
            return true
        }
    }
    m.putI64(ucfpos + 32, index)
    return false
}

// ---------------------------------------------------------------------------
// UFieldPositionIterator: the spans of one category of a result, as
// (field, begin, end), for the older APIs (udat_formatForFields,
// unum_formatDoubleForFields). It holds its own copy.
//     0 u32 magic "FPIT", 8 the spans' address, 16 count, 24 next

const ITERATOR_MAGIC: u32 = 1179666772

pub fn ufieldpositer_open(status: usize) -> usize {
    if m.failed(status) { return 0 }
    const it = m.alloc(32)
    if it == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    m.put32(it, ITERATOR_MAGIC)
    return it
}

pub fn ufieldpositer_close(fpositer: usize) -> void {
    if fpositer == 0 { return }
    if m.getWord(fpositer + 8) != 0 { m.release(m.getWord(fpositer + 8)) }
    m.put32(fpositer, 0)
    m.release(fpositer)
}

pub fn ufieldpositer_next(fpositer: usize, beginIndex: usize, endIndex: usize) -> i32 {
    if fpositer == 0 { return -1 }
    const next = m.getWord(fpositer + 24)
    if next >= m.getWord(fpositer + 16) { return -1 }
    const span = m.getWord(fpositer + 8) + next * 12
    m.putWord(fpositer + 24, next + 1)
    if beginIndex != 0 { m.putI32(beginIndex, m.getI32(span + 4)) }
    if endIndex != 0 { m.putI32(endIndex, m.getI32(span + 8)) }
    return m.getI32(span)
}

// The spans of CATEGORY in VALUE given to iterator IT (none when IT is 0).
pub fn fillIterator(it: usize, value: usize, category: i32) -> void {
    if it == 0 || m.get32(it) != ITERATOR_MAGIC { return }
    if m.getWord(it + 8) != 0 { m.release(m.getWord(it + 8)) }
    var count: usize = 0
    var s: usize = 0
    while s < spanCount(value) {
        if m.getI32(spanAddress(value, s)) == category { count += 1 }
        s += 1
    }
    const spans = m.alloc(count * 12 + 12)
    var w: usize = 0
    s = 0
    while s < spanCount(value) {
        const span = spanAddress(value, s)
        if m.getI32(span) == category {
            m.putI32(spans + w * 12, m.getI32(span + 4))
            m.putI32(spans + w * 12 + 4, m.getI32(span + 8))
            m.putI32(spans + w * 12 + 8, m.getI32(span + 12))
            w += 1
        }
        s += 1
    }
    m.putWord(it + 8, spans)
    m.putWord(it + 16, count)
    m.putWord(it + 24, 0)
}

// The text of VALUE into DEST (CAPACITY units), as C's results are.
pub fn extract(value: usize, dest: usize, capacity: i32, status: usize) -> i32 {
    const count = length(value)
    if dest != 0 && capacity > 0 {
        const fit = if count < @intCast(usize, capacity) { count } else { @intCast(usize, capacity) }
        m.copy(dest, text(value), fit * 2)
    }
    return m.terminate(dest, count, capacity, status)
}

// A UTF-16 copy of UTF-8 TEXT, NUL-terminated (released with m.release),
// its length into COUNT.
pub fn utf16Copy(utf8: []const u8, count: *usize) -> usize {
    const value = create(0, 0)
    appendText(value, utf8)
    if text(value) == 0 {
        reserve(value, 0)
        m.put16(text(value), 0)
    }
    count.* = length(value)
    const copy = text(value)
    if m.getWord(value + 32) != 0 { m.release(m.getWord(value + 32)) }
    m.release(value)
    return copy
}
