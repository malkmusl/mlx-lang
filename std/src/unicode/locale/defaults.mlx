// Locales as the calendars need them: the default locale (from the
// environment, as POSIX gives it), a locale's language and region (its
// own, a `rg` keyword's, or the region its language is most likely
// spoken in), its keywords, and the region's week (CLDR's week data).
const m = @import("std.unicode.memory")
const data = @import("std.unicode.locale.data")

extern("c") fn getenv(name: usize) -> usize

// ---------------------------------------------------------------------------
// The default locale: LC_ALL, LC_MESSAGES, LANG (as `ll_CC.charset@mod`),
// "en_US_POSIX" for C and POSIX; set by uloc_setDefault.

var defaultText: [160]u8 = undefined
var defaultLength: usize = 0
var defaultKnown = false

fn environment(name: []const u8) -> []const u8 {
    const value = getenv(m.literal(name))
    if value == 0 { return "" }
    return m.cSlice(value)
}

fn setDefaultText(text: []const u8) -> void {
    var length: usize = 0
    while length < text.length && length < 159 {
        defaultText[length] = text[length]
        length += 1
    }
    defaultText[length] = 0
    defaultLength = length
    defaultKnown = true
}

pub fn defaultLocale() -> []const u8 {
    if !defaultKnown {
        var posix = environment("LC_ALL")
        if posix.length == 0 { posix = environment("LC_MESSAGES") }
        if posix.length == 0 { posix = environment("LANG") }
        // ll_CC.charset@modifier: the charset and modifier are not the
        // locale's.
        var end: usize = 0
        while end < posix.length && posix[end] != 46 && posix[end] != 64 { end += 1 }
        const name = posix[0..end]
        if name.length == 0 || m.same(name, "C") || m.same(name, "POSIX") {
            setDefaultText("en_US_POSIX")
        } else {
            setDefaultText(name)
        }
    }
    const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &defaultText) }
    return view[0..defaultLength]
}

pub fn defaultAddress() -> usize {
    _ = defaultLocale()
    return @intFromPtr(&defaultText)
}

pub fn setDefault(text: []const u8) -> void { setDefaultText(text) }

// The default from the environment again.
pub fn resetDefault() -> void { defaultKnown = false }

// ---------------------------------------------------------------------------
// The parts of a locale ID (`ll_Ssss_CC_VARIANT@key=value;...`, or a
// language tag with `-`).

fn isLetter(byte: u8) -> bool { return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) }
fn isDigit(byte: u8) -> bool { return byte >= 48 && byte <= 57 }
fn upper(byte: u8) -> u8 { return if byte >= 97 && byte <= 122 { byte - 32 } else { byte } }
fn lower(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }

// The ID without its keywords.
fn base(locale: []const u8) -> []const u8 {
    var end: usize = 0
    while end < locale.length && locale[end] != 64 { end += 1 }
    return locale[0..end]
}

// Subtag `index` of the base (split at `_` and `-`).
fn subtag(locale: []const u8, index: usize) -> []const u8 {
    const text = base(locale)
    var at: usize = 0
    var count: usize = 0
    while at <= text.length {
        const start = at
        while at < text.length && text[at] != 95 && text[at] != 45 { at += 1 }
        if count == index { return text[start..at] }
        count += 1
        at += 1
    }
    return ""
}

// The language, lower case, into `into` (8 bytes); its length.
pub fn language(locale: []const u8, into: *[8]u8) -> usize {
    const first = subtag(locale, 0)
    if first.length < 2 || first.length > 8 { return 0 }
    var index: usize = 0
    while index < first.length {
        if !isLetter(first[index]) { return 0 }
        into.*[index] = lower(first[index])
        index += 1
    }
    if first.length == 3 && into.*[0] == 117 && into.*[1] == 110 && into.*[2] == 100 { return 0 }
    return first.length
}

// The value of keyword `key` (`@key=value;...`).
pub fn keyword(locale: []const u8, key: []const u8) -> []const u8 {
    var at: usize = 0
    while at < locale.length && locale[at] != 64 { at += 1 }
    at += 1
    while at < locale.length {
        const start = at
        while at < locale.length && locale[at] != 61 && locale[at] != 59 { at += 1 }
        const name = locale[start..at]
        if at < locale.length && locale[at] == 61 { at += 1 }
        const valueStart = at
        while at < locale.length && locale[at] != 59 { at += 1 }
        if name.length == key.length {
            var same = true
            var index: usize = 0
            while index < key.length {
                if lower(name[index]) != lower(key[index]) { same = false }
                index += 1
            }
            if same { return locale[valueStart..at] }
        }
        at += 1
    }
    // A language tag's Unicode extension: -u-key-value.
    const text = base(locale)
    var index: usize = 0
    while index + 2 < text.length {
        if (text[index] == 45 || text[index] == 95) && lower(text[index + 1]) == 117 && (text[index + 2] == 45 || text[index + 2] == 95) {
            var place = index + 3
            while place < text.length {
                const start = place
                while place < text.length && text[place] != 45 && text[place] != 95 { place += 1 }
                const part = text[start..place]
                place += 1
                if part.length == key.length && part.length == 2 && lower(part[0]) == lower(key[0]) && lower(part[1]) == lower(key[1]) {
                    const valueStart = place
                    while place < text.length && text[place] != 45 && text[place] != 95 { place += 1 }
                    return text[valueStart..place]
                }
            }
            break
        }
        index += 1
    }
    return ""
}

// The region (two letters, upper case, the first in the high byte): the
// `rg` keyword's, the locale's own, or its language's likely one; 0 when
// none is known (the world, 001).
pub fn region(locale: []const u8) -> u16 {
    const rg = keyword(locale, "rg")
    if rg.length >= 2 && isLetter(rg[0]) && isLetter(rg[1]) { return (@intCast(u16, upper(rg[0])) << 8) | @intCast(u16, upper(rg[1])) }
    var index: usize = 1
    while index < 4 {
        const part = subtag(locale, index)
        if part.length == 2 && isLetter(part[0]) && isLetter(part[1]) { return (@intCast(u16, upper(part[0])) << 8) | @intCast(u16, upper(part[1])) }
        if part.length == 0 { break }
        index += 1
    }
    var name: [8]u8 = undefined
    const length = language(locale, &name)
    if length == 0 { return code("US") }
    const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &name) }
    return likelyRegion(view[0..length])
}

fn code(text: []const u8) -> u16 { return (@intCast(u16, text[0]) << 8) | @intCast(u16, text[1]) }

// The region a language is most likely spoken in: CLDR's likely
// subtags (lang -> lang_Scrp_RR); 0 for none (the world).
fn likelyRegion(name: []const u8) -> u16 {
    var low: usize = 0
    var high = data.LIKELY_COUNT
    while low < high {
        const middle = (low + high) / 2
        const start = @intCast(usize, data.LIKELY_KEYS_STARTS[middle])
        const end = @intCast(usize, data.LIKELY_KEYS_STARTS[middle + 1]) - 1
        const key = data.LIKELY_KEYS[start..end]
        var order: i32 = 0
        var i: usize = 0
        while i < key.length && i < name.length && order == 0 {
            if key[i] != name[i] { order = if key[i] < name[i] { -1 } else { 1 } }
            i += 1
        }
        if order == 0 && key.length != name.length { order = if key.length < name.length { -1 } else { 1 } }
        if order == 0 {
            const valueStart = @intCast(usize, data.LIKELY_VALUES_STARTS[middle])
            const valueEnd = @intCast(usize, data.LIKELY_VALUES_STARTS[middle + 1]) - 1
            const value = data.LIKELY_VALUES[valueStart..valueEnd]
            // The last subtag, when it is a region of two letters.
            var cut = value.length
            while cut > 0 && value[cut - 1] != 95 { cut -= 1 }
            const region = value[cut..value.length]
            return if region.length == 2 { code(region) } else { 0 }
        }
        if order < 0 { low = middle + 1 } else { high = middle }
    }
    return 0
}

// ---------------------------------------------------------------------------
// Weeks (CLDR's week data): the first day (1 Sunday to 7 Saturday), the
// days in the first week at least, the weekend's first and last days.

const MONDAY_FIRST: []const u8 = "AD AI AL AM AN AR AT AU AX AZ BA BE BG BM BN BY CH CL CM CN CR CY CZ DE DK EC EE ES FI FJ FO FR GB GE GF GP GR HR HU IE IS IT KG KZ LB LI LK LT LU LV MC MD ME MK MN MQ MY NL NO NZ PL RE RO RS RU SE SI SK SM TJ TM TR UA UY UZ VA VN XK "
const FRIDAY_FIRST: []const u8 = "MV "
const SATURDAY_FIRST: []const u8 = "AE AF BH DJ DZ EG IQ IR JO KW LY OM QA SD SY "
const SUNDAY_FIRST: []const u8 = "AG AS BD BR BS BT BW BZ CA CO DM DO ET GT GU HK HN ID IL IN JM JP KE KH KR LA MH MM MO MT MX MZ NI NP PA PE PH PK PR PT PY SA SG SV TH TT TW UM US VE VI WS YE ZA ZW "
const FOUR_DAYS: []const u8 = "AD AN AT AX BE BG CH CZ DE DK EE ES FI FJ FO FR GB GF GG GI GP GR HU IE IM IS IT JE LI LT LU MC MQ NL NO PL PT RE RU SE SJ SK SM VA "
const WEEKEND_THURSDAY: []const u8 = "AF "
const WEEKEND_FRIDAY: []const u8 = "AE BH DZ EG IL IQ IR JO KW LY OM QA SA SD SY YE "
const WEEKEND_SUNDAY: []const u8 = "IN UG "
const WEEKEND_END_FRIDAY: []const u8 = "AF IR "
const WEEKEND_END_SATURDAY: []const u8 = "AE BH DZ EG IL IQ JO KW LY OM QA SA SD SY YE "

fn listed(list: []const u8, wanted: u16) -> bool {
    if wanted == 0 { return false }
    var at: usize = 0
    while at + 1 < list.length {
        if code(list[at..at + 2]) == wanted { return true }
        at += 3
    }
    return false
}

pub const Week = struct {
    firstDay: i32
    minimalDays: i32
    weekendOnset: i32
    weekendCease: i32
}

const DAYS: []const u8 = "sunmontuewedthufrisat"

pub fn week(locale: []const u8) -> Week {
    const where = region(locale)
    var result = Week.{ .firstDay = 2, .minimalDays = 1, .weekendOnset = 7, .weekendCease = 1 }
    if listed(SUNDAY_FIRST, where) { result.firstDay = 1 }
    if listed(SATURDAY_FIRST, where) { result.firstDay = 7 }
    if listed(FRIDAY_FIRST, where) { result.firstDay = 6 }
    if listed(FOUR_DAYS, where) { result.minimalDays = 4 }
    if listed(WEEKEND_THURSDAY, where) { result.weekendOnset = 5 }
    if listed(WEEKEND_FRIDAY, where) { result.weekendOnset = 6 }
    if listed(WEEKEND_SUNDAY, where) { result.weekendOnset = 1 }
    if listed(WEEKEND_END_FRIDAY, where) { result.weekendCease = 6 }
    if listed(WEEKEND_END_SATURDAY, where) { result.weekendCease = 7 }
    if listed(WEEKEND_SUNDAY, where) { result.weekendCease = 1 }
    // The `fw` keyword: the first day asked for.
    const fw = keyword(locale, "fw")
    if fw.length == 3 {
        const days = DAYS
        var day: usize = 0
        while day < 7 {
            if lower(fw[0]) == days[day * 3] && lower(fw[1]) == days[day * 3 + 1] && lower(fw[2]) == days[day * 3 + 2] { result.firstDay = @intCast(i32, day + 1) }
            day += 1
        }
    }
    return result
}

// ---------------------------------------------------------------------------
// The locales with data here (what ucal_getAvailable lists).

pub fn availableCount() -> usize { return 3 }

// Locale `index` of them as a C string; 0.
pub fn availableAt(index: usize) -> usize {
    if index == 0 { return m.literal("en") }
    if index == 1 { return m.literal("en_US") }
    if index == 2 { return m.literal("en_US_POSIX") }
    return 0
}
