// uldnames.h: the names of locales, languages, scripts, regions, variants
// and keywords in a locale, from CLDR's localeDisplayNames (cldr.dat:
// localeDisplayNames/languages, scripts, territories, variants, keys,
// types, localeDisplayPattern; the -alt-short names for the short
// length), composed as ICU's LocaleDisplayNamesImpl composes them:
// dialect names ("British English" for en_GB), the script, region,
// variant and keywords after the language in the locale pattern,
// parentheses in them made brackets, the names capitalized for the
// context as contextTransforms says (casing.mlx titlecases).
//
// Also the display names of uloc.h (uloc_getDisplayLanguage...) as ICU's
// locdispnames.cpp makes them, for locale.mlx's exports to call
// (displayLanguage, displayScript, displayCountry, displayVariant,
// displayName, displayKeyword, displayKeywordValue below), and the
// {0}/{1} patterns of ICU's SimpleFormatter the list formatter uses too.
//
// Locale IDs are read with uloc.h's own functions (locale.mlx's
// exports, called through C).
const m = @import("std.unicode.memory")
const resources = @import("std.unicode.locale.resources")
const formatted = @import("std.unicode.format")
const casing = @import("std.unicode.casing")
const p = @import("std.unicode.properties")
const locale = @import("std.unicode.locale.defaults")
const uloc = @import("std.unicode.locale")
const uscript = @import("std.unicode.properties")
const unicode = @import("std.unicode")
const utf = @import("std.unicode.utf")

// ---------------------------------------------------------------------------
// Text: UTF-8 in m.Bytes; C strings for uloc.

fn text(b: *m.Bytes) -> []const u8 { return m.bytesText(b) }

fn setText(b: *m.Bytes, value: []const u8) -> void {
    b.*.length = 0
    if b.*.address != 0 { m.put8(b.*.address, 0) }
    m.pushText(b, value)
}

// The address of B's text as a C string.
fn cString(b: *m.Bytes) -> usize {
    if b.*.address == 0 { return m.literal("\x00") }
    return b.*.address
}

const PART_NAME: u32 = 0
const PART_LANGUAGE: u32 = 1
const PART_SCRIPT: u32 = 2
const PART_COUNTRY: u32 = 3
const PART_VARIANT: u32 = 4
const PART_CANONICAL: u32 = 5
const PART_BASE: u32 = 6

// What a uloc getter gives of the C string ID, into OUT (replacing it);
// false when it fails.
fn part(which: u32, id: usize, out: *m.Bytes) -> bool {
    var buffer: [512]u8 = undefined
    var status: i32 = 0
    const at = @intFromPtr(&buffer)
    const s = @intFromPtr(&status)
    var length: i32 = 0
    if which == PART_NAME {
        length = uloc.uloc_getName(id, at, 512, s)
    } else if which == PART_LANGUAGE {
        length = uloc.uloc_getLanguage(id, at, 512, s)
    } else if which == PART_SCRIPT {
        length = uloc.uloc_getScript(id, at, 512, s)
    } else if which == PART_COUNTRY {
        length = uloc.uloc_getCountry(id, at, 512, s)
    } else if which == PART_VARIANT {
        length = uloc.uloc_getVariant(id, at, 512, s)
    } else if which == PART_CANONICAL {
        length = uloc.uloc_canonicalize(id, at, 512, s)
    } else {
        length = uloc.uloc_getBaseName(id, at, 512, s)
    }
    setText(out, "")
    if status > 0 || length < 0 || length >= 512 { return false }
    m.pushText(out, m.bytes(at, @intCast(usize, length)))
    return true
}

fn partOf(which: u32, id: []const u8, out: *m.Bytes) -> bool {
    var c = m.bytesBuffer()
    m.pushText(&c, id)
    const ok = part(which, cString(&c), out)
    m.disposeBytes(&c)
    return ok
}

fn contains(s: []const u8, byte: u8) -> bool {
    for c in s {
        if c == byte { return true }
    }
    return false
}

fn upperAscii(c: u8) -> u8 { return if c >= 97 && c <= 122 { c - 32 } else { c } }
fn lowerAscii(c: u8) -> u8 { return if c >= 65 && c <= 90 { c + 32 } else { c } }

// UTF-8: the code point at AT (its length into SIZE).
fn decodeAt(s: []const u8, at: usize, size: *usize) -> u32 {
    const b = s[at]
    var c: u32 = 0
    var extra: usize = 0
    if b < 128 {
        c = @intCast(u32, b)
    } else if b >= 240 {
        c = @intCast(u32, b & 7)
        extra = 3
    } else if b >= 224 {
        c = @intCast(u32, b & 15)
        extra = 2
    } else {
        c = @intCast(u32, b & 31)
        extra = 1
    }
    var k: usize = 0
    while k < extra && at + 1 + k < s.length {
        c = (c << 6) | @intCast(u32, s[at + 1 + k] & 63)
        k += 1
    }
    size.* = 1 + k
    return c
}

fn pushCodePoint(b: *m.Bytes, c: u32) -> void {
    if c < 128 {
        m.pushByte(b, @intCast(u8, c))
    } else if c < 2048 {
        m.pushByte(b, @intCast(u8, 192 | (c >> 6)))
        m.pushByte(b, @intCast(u8, 128 | (c & 63)))
    } else if c < 65536 {
        m.pushByte(b, @intCast(u8, 224 | (c >> 12)))
        m.pushByte(b, @intCast(u8, 128 | ((c >> 6) & 63)))
        m.pushByte(b, @intCast(u8, 128 | (c & 63)))
    } else {
        m.pushByte(b, @intCast(u8, 240 | (c >> 18)))
        m.pushByte(b, @intCast(u8, 128 | ((c >> 12) & 63)))
        m.pushByte(b, @intCast(u8, 128 | ((c >> 6) & 63)))
        m.pushByte(b, @intCast(u8, 128 | (c & 63)))
    }
}

// UTF-8 TEXT into C's UTF-16 buffer DEST of CAPACITY units, with the NUL
// and the status as C's results have them; the length in units.
pub fn give16(utf8: []const u8, dest: usize, capacity: i32, status: usize) -> i32 {
    var count: usize = 0
    const copy = formatted.utf16Copy(utf8, &count)
    const room = if capacity > 0 { @intCast(usize, capacity) } else { 0 }
    if dest != 0 {
        m.copy(dest, copy, (if count < room { count } else { room }) * 2)
    }
    m.release(copy)
    return m.terminate(dest, count, capacity, status)
}

// Every FROM (a code point) in B made TO.
fn replaceAll(b: *m.Bytes, from: u32, to: u32) -> void {
    const s = text(b)
    var hit = false
    var at: usize = 0
    while at < s.length {
        var size: usize = 0
        if decodeAt(s, at, &size) == from { hit = true }
        at += size
    }
    if !hit { return }
    var out = m.bytesBuffer()
    at = 0
    while at < s.length {
        var size: usize = 0
        const c = decodeAt(s, at, &size)
        pushCodePoint(&out, if c == from { to } else { c })
        at += size
    }
    setText(b, text(&out))
    m.disposeBytes(&out)
}

// ---------------------------------------------------------------------------
// ICU's SimpleFormatter patterns of two arguments: {0} and {1}, an
// apostrophe quoting ('{' and '}' after one, until the next; two are one).

// PATTERN with {0} as FIRST and {1} as SECOND, appended to OUT.
pub fn applyPattern(pattern: []const u8, first: []const u8, second: []const u8, out: *m.Bytes) -> void {
    var quoted = false
    var i: usize = 0
    while i < pattern.length {
        const c = pattern[i]
        if c == 39 {
            if i + 1 < pattern.length && pattern[i + 1] == 39 {
                m.pushByte(out, 39)
                i += 2
            } else if quoted {
                quoted = false
                i += 1
            } else if i + 1 < pattern.length && (pattern[i + 1] == 123 || pattern[i + 1] == 125) {
                m.pushByte(out, pattern[i + 1])
                quoted = true
                i += 2
            } else {
                m.pushByte(out, 39)
                i += 1
            }
        } else if !quoted && c == 123 && i + 2 < pattern.length && (pattern[i + 1] == 48 || pattern[i + 1] == 49) && pattern[i + 2] == 125 {
            m.pushText(out, if pattern[i + 1] == 48 { first } else { second })
            i += 3
        } else {
            m.pushByte(out, c)
            i += 1
        }
    }
}

// The text of PATTERN around its arguments: PARTS[0] before the first,
// PARTS[1] between, PARTS[2] after the second; whether {1} comes first.
// False when the pattern does not have {0} and {1} once each.
pub fn splitPattern(pattern: []const u8, parts: *[3]m.Bytes, reversed: *bool) -> bool {
    var quoted = false
    var seen: usize = 0
    var firstArgument: u8 = 0
    var i: usize = 0
    while i < pattern.length {
        const c = pattern[i]
        if c == 39 {
            if i + 1 < pattern.length && pattern[i + 1] == 39 {
                m.pushByte(&parts.*[seen], 39)
                i += 2
            } else if quoted {
                quoted = false
                i += 1
            } else if i + 1 < pattern.length && (pattern[i + 1] == 123 || pattern[i + 1] == 125) {
                m.pushByte(&parts.*[seen], pattern[i + 1])
                quoted = true
                i += 2
            } else {
                m.pushByte(&parts.*[seen], 39)
                i += 1
            }
        } else if !quoted && c == 123 && i + 2 < pattern.length && (pattern[i + 1] == 48 || pattern[i + 1] == 49) && pattern[i + 2] == 125 {
            if seen == 2 { return false }
            if seen == 1 && pattern[i + 1] == firstArgument { return false }
            if seen == 0 { firstArgument = pattern[i + 1] }
            seen += 1
            i += 3
        } else {
            m.pushByte(&parts.*[seen], c)
            i += 1
        }
    }
    reversed.* = firstArgument == 49
    return seen == 2
}

// ---------------------------------------------------------------------------
// The data.

// The data locale of a locale ID as ICU opens its bundles: the deprecated
// language codes are their replacements' (iw is he), and an ID that has
// nothing but the root (xx, und_DE) falls back to the default locale
// first.
pub fn dataLocale(id: []const u8) -> u32 {
    var end: usize = 0
    while end < id.length && id[end] != 95 && id[end] != 45 && id[end] != 64 { end += 1 }
    var name = m.bytesBuffer()
    var language = m.bytesBuffer()
    for c in id[0..end] { m.pushByte(&language, lowerAscii(c)) }
    const lang = text(&language)
    const replacement = if m.same(lang, "in") { "id" } else if m.same(lang, "iw") { "he" } else if m.same(lang, "ji") { "yi" } else if m.same(lang, "jw") { "jv" } else if m.same(lang, "mo") { "ro" } else if m.same(lang, "sh") { "sr_Latn" } else if m.same(lang, "tl") { "fil" } else { lang }
    m.pushText(&name, replacement)
    m.pushText(&name, id[end..id.length])
    var found = resources.find(text(&name))
    // "und" alone is the root too ("und_DE" is not).
    const alone = end == id.length || id[end] == 64
    const rootless = lang.length == 0 || m.same(lang, "root") || (m.same(lang, "und") && alone)
    if found == resources.root() && !rootless && resources.available() {
        const fallback = locale.defaultLocale()
        if !m.same(fallback, id) { found = resources.find(fallback) }
    }
    m.disposeBytes(&name)
    m.disposeBytes(&language)
    return found
}

// The value of localeDisplayNames/TABLE/ITEM+ALT (ITEM's '_' made '-'),
// the locale's or its parents'.
fn entry(data: u32, table: []const u8, item: []const u8, alt: []const u8, value: *[]const u8) -> bool {
    if data == resources.NONE || item.length == 0 { return false }
    var key = m.bytesBuffer()
    m.pushText(&key, "localeDisplayNames/")
    m.pushText(&key, table)
    m.pushByte(&key, 47)
    for c in item {
        // A slash would reach another key.
        if c == 47 {
            m.disposeBytes(&key)
            return false
        }
        m.pushByte(&key, if c == 95 { 45 } else { c })
    }
    m.pushText(&key, alt)
    const found = resources.lookup(data, text(&key), value)
    m.disposeBytes(&key)
    return found
}

// ICU's deprecated codes, looked for when the code itself is not
// (uloc_getCurrentLanguageID, uloc_getCurrentCountryID).
fn currentLanguage(code: []const u8) -> []const u8 {
    if m.same(code, "in") { return "id" }
    if m.same(code, "iw") { return "he" }
    if m.same(code, "ji") { return "yi" }
    if m.same(code, "jw") { return "jv" }
    if m.same(code, "mo") { return "ro" }
    return code
}

const OLD_COUNTRIES: []const u8 = "AN BU CS DD DY FX HV NH RH SU TP UK VD YD YU ZR "
const NEW_COUNTRIES: []const u8 = "CW MM RS DE BJ FR BF VU ZW RU TL GB VN YE RS CD "

fn currentCountry(code: []const u8) -> []const u8 {
    if code.length != 2 { return code }
    var at: usize = 0
    while at + 2 < OLD_COUNTRIES.length {
        if OLD_COUNTRIES[at] == code[0] && OLD_COUNTRIES[at + 1] == code[1] { return NEW_COUNTRIES[at..at + 2] }
        at += 3
    }
    return code
}

// The "Languages" table (with the deprecated codes), "Languages%short".
fn languageEntry(data: u32, code: []const u8, short: bool, value: *[]const u8) -> bool {
    if short { return entry(data, "languages", code, "-alt-short", value) }
    if entry(data, "languages", code, "", value) { return true }
    const current = currentLanguage(code)
    return !m.same(current, code) && entry(data, "languages", current, "", value)
}

fn countryEntry(data: u32, code: []const u8, short: bool, value: *[]const u8) -> bool {
    if short { return entry(data, "territories", code, "-alt-short", value) }
    if entry(data, "territories", code, "", value) { return true }
    const current = currentCountry(code)
    return !m.same(current, code) && entry(data, "territories", current, "", value)
}

// The long name of currency CODE (its first three letters, upper case),
// as ucurr_getName gives it.
fn currencyName(data: u32, code: []const u8, value: *[]const u8) -> bool {
    if data == resources.NONE { return false }
    var key = m.bytesBuffer()
    m.pushText(&key, "numbers/currencies/")
    var k: usize = 0
    while k < code.length && k < 3 {
        if code[k] == 47 {
            m.disposeBytes(&key)
            return false
        }
        m.pushByte(&key, upperAscii(code[k]))
        k += 1
    }
    m.pushText(&key, "/displayName")
    const found = resources.lookup(data, text(&key), value)
    m.disposeBytes(&key)
    return found
}

// ---------------------------------------------------------------------------
// ULocaleDisplayNames

// "ULDN"
const MAGIC: u32 = 1431061582

const DIALECT_NAMES: i32 = 1
const CAPITALIZATION_NONE: i32 = 256
const CAPITALIZATION_MIDDLE: i32 = 257
const CAPITALIZATION_BEGINNING: i32 = 258
const CAPITALIZATION_MENU: i32 = 259
const CAPITALIZATION_STANDALONE: i32 = 260
const LENGTH_FULL: i32 = 512
const LENGTH_SHORT: i32 = 513
const SUBSTITUTE: i32 = 768
const NO_SUBSTITUTE: i32 = 769

// The usages contextTransforms capitalizes for.
const USAGE_LANGUAGE: usize = 0
const USAGE_SCRIPT: usize = 1
const USAGE_TERRITORY: usize = 2
const USAGE_VARIANT: usize = 3
const USAGE_KEY: usize = 4
const USAGE_KEY_VALUE: usize = 5

const Names = struct {
    magic: u32
    dialect: i32
    capitalization: i32
    nameLength: i32
    substitute: i32
    data: u32
    // The locale's ICU name (C string), for uldn_getLocale.
    name: usize
    casingLanguage: u32
    titlecase: [6]bool
    fullwidth: bool
    // The separator, locale and key-type patterns (UTF-8).
    separatorAt: usize
    separatorLength: usize
    patternAt: usize
    patternLength: usize
    keyTypeAt: usize
    keyTypeLength: usize
}

fn names(handle: usize) -> *Names { unsafe { return @ptrFromInt(*Names, handle) } }

fn isNames(handle: usize) -> bool { return handle != 0 && m.get32(handle) == MAGIC }

fn separator(n: *Names) -> []const u8 { return m.bytes(n.*.separatorAt, n.*.separatorLength) }
fn localePattern(n: *Names) -> []const u8 { return m.bytes(n.*.patternAt, n.*.patternLength) }
fn keyTypePattern(n: *Names) -> []const u8 { return m.bytes(n.*.keyTypeAt, n.*.keyTypeLength) }

fn localeData(data: u32, item: []const u8, value: *[]const u8) -> bool {
    if data == resources.NONE { return false }
    var key = m.bytesBuffer()
    m.pushText(&key, "localeDisplayNames/localeDisplayPattern/")
    m.pushText(&key, item)
    const found = resources.lookup(data, text(&key), value)
    m.disposeBytes(&key)
    return found
}

fn contextTransform(data: u32, usage: []const u8, context: []const u8) -> bool {
    if data == resources.NONE { return false }
    var key = m.bytesBuffer()
    m.pushText(&key, "contextTransforms/")
    m.pushText(&key, usage)
    m.pushByte(&key, 47)
    m.pushText(&key, context)
    var value: []const u8 = ""
    const found = resources.lookup(data, text(&key), &value)
    m.disposeBytes(&key)
    return found && m.same(value, "titlecase-firstword")
}

fn open(localeID: usize, dialect: i32, capitalization: i32, nameLength: i32, substitute: i32, status: usize) -> usize {
    const handle = m.alloc(@sizeOf(Names))
    if handle == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    var n = names(handle)
    n.*.magic = MAGIC
    n.*.dialect = dialect
    n.*.capitalization = capitalization
    n.*.nameLength = nameLength
    n.*.substitute = substitute
    const id = if localeID == 0 { uloc.uloc_getDefault() } else { localeID }
    var name = m.bytesBuffer()
    _ = part(PART_NAME, id, &name)
    const copy = m.alloc(name.length + 1)
    if name.length > 0 { m.copy(copy, name.address, name.length) }
    n.*.name = copy
    m.disposeBytes(&name)
    n.*.data = dataLocale(m.cSlice(copy))
    n.*.casingLanguage = casing.language(copy)
    var value: []const u8 = ""
    var sep: []const u8 = "{0}, {1}"
    if localeData(n.*.data, "localeSeparator", &value) { sep = value }
    n.*.separatorAt = @intFromPtr(sep.pointer)
    n.*.separatorLength = sep.length
    var pattern: []const u8 = "{0} ({1})"
    if localeData(n.*.data, "localePattern", &value) { pattern = value }
    n.*.patternAt = @intFromPtr(pattern.pointer)
    n.*.patternLength = pattern.length
    // U+FF08, the full-width parenthesis.
    n.*.fullwidth = false
    var at: usize = 0
    while at < pattern.length {
        var size: usize = 0
        if decodeAt(pattern, at, &size) == 65288 { n.*.fullwidth = true }
        at += size
    }
    var keyType: []const u8 = "keyTypePattern"
    if localeData(n.*.data, "localeKeyTypePattern", &value) { keyType = value }
    n.*.keyTypeAt = @intFromPtr(keyType.pointer)
    n.*.keyTypeLength = keyType.length
    // contextTransforms: [uiListOrMenu, stand-alone] of each usage.
    var k: usize = 0
    while k < 6 {
        n.*.titlecase[k] = false
        k += 1
    }
    if capitalization == CAPITALIZATION_MENU || capitalization == CAPITALIZATION_STANDALONE {
        const context = if capitalization == CAPITALIZATION_MENU { "uiListOrMenu" } else { "stand-alone" }
        n.*.titlecase[USAGE_LANGUAGE] = contextTransform(n.*.data, "languages", context)
        n.*.titlecase[USAGE_SCRIPT] = contextTransform(n.*.data, "script", context)
        n.*.titlecase[USAGE_TERRITORY] = contextTransform(n.*.data, "territory", context)
        n.*.titlecase[USAGE_VARIANT] = contextTransform(n.*.data, "variant", context)
        n.*.titlecase[USAGE_KEY] = contextTransform(n.*.data, "key", context)
        n.*.titlecase[USAGE_KEY_VALUE] = contextTransform(n.*.data, "keyValue", context)
    }
    return handle
}

// RESULT titlecased (its first letter) when the context and the usage
// want it and it starts with a lower case letter.
fn adjust(n: *Names, usage: usize, result: *m.Bytes) -> void {
    const s = text(result)
    if s.length == 0 { return }
    if !(n.*.capitalization == CAPITALIZATION_BEGINNING || n.*.titlecase[usage]) { return }
    var size: usize = 0
    const first = decodeAt(s, 0, &size)
    if p.category(@intCast(i32, first)) != 2 { return }
    var points = m.buffer()
    var at: usize = 0
    while at < s.length {
        var length: usize = 0
        m.push(&points, decodeAt(s, at, &length))
        at += length
    }
    var title = m.buffer()
    casing.upperAt(&title, &points, 0, n.*.casingLanguage, true)
    var out = m.bytesBuffer()
    var k: usize = 0
    while k < title.length {
        pushCodePoint(&out, m.at(&title, k))
        k += 1
    }
    var rest: usize = 1
    // Dutch: "ij" at the start is "IJ".
    if n.*.casingLanguage == casing.DUTCH && first == 105 && points.length > 1 && m.at(&points, 1) == 106 {
        m.pushByte(&out, 74)
        rest = 2
    }
    while rest < points.length {
        pushCodePoint(&out, m.at(&points, rest))
        rest += 1
    }
    setText(result, text(&out))
    m.disposeBytes(&out)
    m.dispose(&title)
    m.dispose(&points)
}

// The name of language (or locale ID) ID, or none when SUBSTITUTE is
// false and there is none (ICU's localeIdName).
fn localeIdName(n: *Names, id: []const u8, substitute: bool, out: *m.Bytes) -> bool {
    const short = n.*.nameLength == LENGTH_SHORT
    var value: []const u8 = ""
    if short && languageEntry(n.*.data, id, true, &value) {
        setText(out, value)
        return true
    }
    if languageEntry(n.*.data, id, false, &value) {
        setText(out, value)
        return true
    }
    if !contains(id, 95) {
        var canonical = m.bytesBuffer()
        _ = partOf(PART_CANONICAL, id, &canonical)
        const c = text(&canonical)
        var found = false
        if short && languageEntry(n.*.data, c, true, &value) {
            found = true
        } else if languageEntry(n.*.data, c, false, &value) {
            found = true
        }
        m.disposeBytes(&canonical)
        if found {
            setText(out, value)
            return true
        }
    }
    if substitute {
        setText(out, id)
        return true
    }
    return false
}

fn languageNameInto(n: *Names, lang: []const u8, out: *m.Bytes) -> bool {
    if m.same(lang, "root") || contains(lang, 95) {
        setText(out, lang)
        return true
    }
    const short = n.*.nameLength == LENGTH_SHORT
    var value: []const u8 = ""
    var found = false
    if short && languageEntry(n.*.data, lang, true, &value) {
        found = true
    } else if languageEntry(n.*.data, lang, false, &value) {
        found = true
    } else {
        var canonical = m.bytesBuffer()
        _ = partOf(PART_CANONICAL, lang, &canonical)
        const c = text(&canonical)
        if short && languageEntry(n.*.data, c, true, &value) {
            found = true
        } else if languageEntry(n.*.data, c, false, &value) {
            found = true
        }
        // The value is the data's, not the canonical form's.
        m.disposeBytes(&canonical)
    }
    if found {
        setText(out, value)
    } else if n.*.substitute == SUBSTITUTE {
        setText(out, lang)
    } else {
        return false
    }
    adjust(n, USAGE_LANGUAGE, out)
    return true
}

fn scriptNameInto(n: *Names, script: []const u8, out: *m.Bytes, skipAdjust: bool) -> bool {
    var value: []const u8 = ""
    if n.*.nameLength == LENGTH_SHORT && entry(n.*.data, "scripts", script, "-alt-short", &value) {
        setText(out, value)
    } else if entry(n.*.data, "scripts", script, "", &value) {
        setText(out, value)
    } else if n.*.substitute == SUBSTITUTE {
        setText(out, script)
    } else {
        return false
    }
    if !skipAdjust { adjust(n, USAGE_SCRIPT, out) }
    return true
}

fn regionNameInto(n: *Names, region: []const u8, out: *m.Bytes, skipAdjust: bool) -> bool {
    var value: []const u8 = ""
    if n.*.nameLength == LENGTH_SHORT && countryEntry(n.*.data, region, true, &value) {
        setText(out, value)
    } else if countryEntry(n.*.data, region, false, &value) {
        setText(out, value)
    } else if n.*.substitute == SUBSTITUTE {
        setText(out, region)
    } else {
        return false
    }
    if !skipAdjust { adjust(n, USAGE_TERRITORY, out) }
    return true
}

fn variantName(n: *Names, variant: []const u8, out: *m.Bytes, skipAdjust: bool) -> bool {
    var value: []const u8 = ""
    if entry(n.*.data, "variants", variant, "", &value) {
        setText(out, value)
    } else if n.*.substitute == SUBSTITUTE {
        setText(out, variant)
    } else {
        return false
    }
    if !skipAdjust { adjust(n, USAGE_VARIANT, out) }
    return true
}

fn keyName(n: *Names, key: []const u8, out: *m.Bytes, skipAdjust: bool) -> bool {
    var value: []const u8 = ""
    if entry(n.*.data, "keys", key, "", &value) {
        setText(out, value)
    } else if n.*.substitute == SUBSTITUTE {
        setText(out, key)
    } else {
        return false
    }
    if !skipAdjust { adjust(n, USAGE_KEY, out) }
    return true
}

fn keyValueName(n: *Names, key: []const u8, value: []const u8, out: *m.Bytes, skipAdjust: bool) -> bool {
    var found: []const u8 = ""
    if m.same(key, "currency") {
        // ucurr_getName's long name in the locale (its base name), else
        // the code as it is.
        var base = m.bytesBuffer()
        _ = part(PART_BASE, n.*.name, &base)
        const data = dataLocale(text(&base))
        m.disposeBytes(&base)
        if !currencyName(data, value, &found) {
            setText(out, value)
            return true
        }
        setText(out, found)
        if !skipAdjust { adjust(n, USAGE_KEY_VALUE, out) }
        return true
    }
    var table = m.bytesBuffer()
    m.pushText(&table, "types/")
    m.pushText(&table, key)
    const ok = !contains(key, 47)
    if ok && n.*.nameLength == LENGTH_SHORT && entry(n.*.data, text(&table), value, "-alt-short", &found) {
        setText(out, found)
    } else if ok && entry(n.*.data, text(&table), value, "", &found) {
        setText(out, found)
    } else if n.*.substitute == SUBSTITUTE {
        setText(out, value)
    } else {
        m.disposeBytes(&table)
        return false
    }
    m.disposeBytes(&table)
    if !skipAdjust { adjust(n, USAGE_KEY_VALUE, out) }
    return true
}

// BUFFER, then SRC after the separator.
fn appendWithSeparator(n: *Names, buffer: *m.Bytes, src: []const u8) -> void {
    if buffer.*.length == 0 {
        setText(buffer, src)
        return
    }
    var joined = m.bytesBuffer()
    applyPattern(separator(n), text(buffer), src, &joined)
    setText(buffer, text(&joined))
    m.disposeBytes(&joined)
}

fn replaceParentheses(n: *Names, b: *m.Bytes) -> void {
    if n.*.fullwidth {
        replaceAll(b, 65288, 65339)
        replaceAll(b, 65289, 65341)
    } else {
        replaceAll(b, 40, 91)
        replaceAll(b, 41, 93)
    }
}

// The keywords of an ICU name ("@a=1;b=2"): the next key and value from
// AT, AT moved past them.
fn nextKeyword(name: []const u8, at: *usize, key: *[]const u8, value: *[]const u8) -> bool {
    var i = at.*
    if i >= name.length { return false }
    var keyEnd = i
    while keyEnd < name.length && name[keyEnd] != 61 && name[keyEnd] != 59 { keyEnd += 1 }
    var valueEnd = keyEnd
    if valueEnd < name.length && name[valueEnd] == 61 { valueEnd += 1 }
    const valueStart = valueEnd
    while valueEnd < name.length && name[valueEnd] != 59 { valueEnd += 1 }
    key.* = name[i..keyEnd]
    value.* = name[valueStart..valueEnd]
    at.* = valueEnd + 1
    return true
}

// LocaleDisplayNamesImpl::localeDisplayName.
fn localeName(n: *Names, id: usize, result: *m.Bytes) -> bool {
    var name = m.bytesBuffer()
    if !part(PART_NAME, id, &name) {
        m.disposeBytes(&name)
        return false
    }
    var language = m.bytesBuffer()
    var script = m.bytesBuffer()
    var country = m.bytesBuffer()
    var variant = m.bytesBuffer()
    _ = part(PART_LANGUAGE, cString(&name), &language)
    _ = part(PART_SCRIPT, cString(&name), &script)
    _ = part(PART_COUNTRY, cString(&name), &country)
    _ = part(PART_VARIANT, cString(&name), &variant)
    if language.length == 0 { setText(&language, "root") }
    const lang = text(&language)
    var hasScript = script.length > 0
    var hasCountry = country.length > 0
    const hasVariant = variant.length > 0
    var resultName = m.bytesBuffer()
    var haveName = false
    var temp = m.bytesBuffer()
    if n.*.dialect == DIALECT_NAMES {
        if hasScript && hasCountry {
            setText(&temp, lang)
            m.pushByte(&temp, 95)
            m.pushText(&temp, text(&script))
            m.pushByte(&temp, 95)
            m.pushText(&temp, text(&country))
            if localeIdName(n, text(&temp), false, &resultName) {
                haveName = true
                hasScript = false
                hasCountry = false
            }
        }
        if !haveName && hasScript {
            setText(&temp, lang)
            m.pushByte(&temp, 95)
            m.pushText(&temp, text(&script))
            if localeIdName(n, text(&temp), false, &resultName) {
                haveName = true
                hasScript = false
            }
        }
        if !haveName && hasCountry {
            setText(&temp, lang)
            m.pushByte(&temp, 95)
            m.pushText(&temp, text(&country))
            if localeIdName(n, text(&temp), false, &resultName) {
                haveName = true
                hasCountry = false
            }
        }
    }
    var ok = true
    if !haveName || resultName.length == 0 {
        ok = localeIdName(n, lang, n.*.substitute == SUBSTITUTE, &resultName)
    }
    var remainder = m.bytesBuffer()
    if ok && hasScript {
        ok = scriptNameInto(n, text(&script), &temp, true)
        if ok { m.pushText(&remainder, text(&temp)) }
    }
    if ok && hasCountry {
        ok = regionNameInto(n, text(&country), &temp, true)
        if ok { appendWithSeparator(n, &remainder, text(&temp)) }
    }
    if ok && hasVariant {
        ok = variantName(n, text(&variant), &temp, true)
        if ok { appendWithSeparator(n, &remainder, text(&temp)) }
    }
    if ok {
        replaceParentheses(n, &remainder)
        // The keywords, in the order of the name.
        const full = text(&name)
        var at: usize = 0
        while at < full.length && full[at] != 64 { at += 1 }
        at += 1
        var key: []const u8 = ""
        var value: []const u8 = ""
        var keyText = m.bytesBuffer()
        var valueText = m.bytesBuffer()
        while nextKeyword(full, &at, &key, &value) {
            const haveKey = keyName(n, key, &keyText, true)
            if haveKey { replaceParentheses(n, &keyText) }
            const haveValue = keyValueName(n, key, value, &valueText, true)
            if haveValue { replaceParentheses(n, &valueText) }
            if !haveValue {
                // No name (no substitution): ICU appends its empty text.
                appendWithSeparator(n, &remainder, "")
            } else if !m.same(text(&valueText), value) {
                appendWithSeparator(n, &remainder, text(&valueText))
            } else if haveKey && !m.same(text(&keyText), key) {
                var pair = m.bytesBuffer()
                applyPattern(keyTypePattern(n), text(&keyText), text(&valueText), &pair)
                appendWithSeparator(n, &remainder, text(&pair))
                m.disposeBytes(&pair)
            } else {
                appendWithSeparator(n, &remainder, if haveKey { text(&keyText) } else { "" })
                m.pushByte(&remainder, 61)
                m.pushText(&remainder, text(&valueText))
            }
        }
        m.disposeBytes(&keyText)
        m.disposeBytes(&valueText)
        setText(result, "")
        if remainder.length > 0 {
            applyPattern(localePattern(n), text(&resultName), text(&remainder), result)
        } else {
            m.pushText(result, text(&resultName))
        }
        adjust(n, USAGE_LANGUAGE, result)
    }
    m.disposeBytes(&remainder)
    m.disposeBytes(&temp)
    m.disposeBytes(&resultName)
    m.disposeBytes(&variant)
    m.disposeBytes(&country)
    m.disposeBytes(&script)
    m.disposeBytes(&language)
    m.disposeBytes(&name)
    return ok
}

// ---------------------------------------------------------------------------
// The C API (uldnames.h)

pub fn uldn_open(localeID: usize, dialectHandling: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    return open(localeID, dialectHandling, CAPITALIZATION_NONE, LENGTH_FULL, SUBSTITUTE, status)
}

pub fn uldn_openForContext(localeID: usize, contexts: usize, length: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    var dialect: i32 = 0
    var capitalization = CAPITALIZATION_NONE
    var nameLength = LENGTH_FULL
    var substitute = SUBSTITUTE
    var k: i32 = 0
    while contexts != 0 && k < length {
        const value = m.getI32(contexts + @intCast(usize, k) * 4)
        const selector = @bitCast(u32, value) >> 8
        if selector == 0 {
            dialect = value
        } else if selector == 1 {
            capitalization = value
        } else if selector == 2 {
            nameLength = value
        } else if selector == 3 {
            substitute = value
        }
        k += 1
    }
    return open(localeID, dialect, capitalization, nameLength, substitute, status)
}

pub fn uldn_close(ldn: usize) -> void {
    if !isNames(ldn) { return }
    var n = names(ldn)
    m.release(n.*.name)
    n.*.magic = 0
    m.release(ldn)
}

pub fn uldn_getLocale(ldn: usize) -> usize {
    if !isNames(ldn) { return 0 }
    return names(ldn).*.name
}

pub fn uldn_getDialectHandling(ldn: usize) -> i32 {
    if !isNames(ldn) { return 0 }
    return names(ldn).*.dialect
}

pub fn uldn_getContext(ldn: usize, kind: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    if !isNames(ldn) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const n = names(ldn)
    if kind == 0 { return n.*.dialect }
    if kind == 1 { return n.*.capitalization }
    if kind == 2 { return n.*.nameLength }
    if kind == 3 { return n.*.substitute }
    return 0
}

// The checks of every uldn_*DisplayName.
fn arguments(ldn: usize, code: usize, result: usize, capacity: i32, status: usize) -> bool {
    if m.failed(status) { return false }
    if !isNames(ldn) || code == 0 || (result == 0 && capacity > 0) || capacity < 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    return true
}

// OUT to C, or the error of a name there is none of.
fn finish(found: bool, out: *m.Bytes, result: usize, capacity: i32, status: usize) -> i32 {
    var length: i32 = 0
    if found {
        length = give16(text(out), result, capacity, status)
    } else {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
    }
    m.disposeBytes(out)
    return length
}

pub fn uldn_localeDisplayName(ldn: usize, localeID: usize, result: usize, capacity: i32, status: usize) -> i32 {
    if !arguments(ldn, localeID, result, capacity, status) { return 0 }
    var out = m.bytesBuffer()
    const found = localeName(names(ldn), localeID, &out)
    return finish(found, &out, result, capacity, status)
}

pub fn uldn_languageDisplayName(ldn: usize, lang: usize, result: usize, capacity: i32, status: usize) -> i32 {
    if !arguments(ldn, lang, result, capacity, status) { return 0 }
    var out = m.bytesBuffer()
    const found = languageNameInto(names(ldn), m.cSlice(lang), &out)
    return finish(found, &out, result, capacity, status)
}

pub fn uldn_scriptDisplayName(ldn: usize, script: usize, result: usize, capacity: i32, status: usize) -> i32 {
    if !arguments(ldn, script, result, capacity, status) { return 0 }
    var out = m.bytesBuffer()
    const found = scriptNameInto(names(ldn), m.cSlice(script), &out, false)
    return finish(found, &out, result, capacity, status)
}

// The script's long name (uscript_getName) is what is looked up, as ICU
// does.
pub fn uldn_scriptCodeDisplayName(ldn: usize, scriptCode: i32, result: usize, capacity: i32, status: usize) -> i32 {
    return uldn_scriptDisplayName(ldn, uscript.uscript_getName(scriptCode), result, capacity, status)
}

pub fn uldn_regionDisplayName(ldn: usize, region: usize, result: usize, capacity: i32, status: usize) -> i32 {
    if !arguments(ldn, region, result, capacity, status) { return 0 }
    var out = m.bytesBuffer()
    const found = regionNameInto(names(ldn), m.cSlice(region), &out, false)
    return finish(found, &out, result, capacity, status)
}

pub fn uldn_variantDisplayName(ldn: usize, variant: usize, result: usize, capacity: i32, status: usize) -> i32 {
    if !arguments(ldn, variant, result, capacity, status) { return 0 }
    var out = m.bytesBuffer()
    const found = variantName(names(ldn), m.cSlice(variant), &out, false)
    return finish(found, &out, result, capacity, status)
}

pub fn uldn_keyDisplayName(ldn: usize, key: usize, result: usize, capacity: i32, status: usize) -> i32 {
    if !arguments(ldn, key, result, capacity, status) { return 0 }
    var out = m.bytesBuffer()
    const found = keyName(names(ldn), m.cSlice(key), &out, false)
    return finish(found, &out, result, capacity, status)
}

pub fn uldn_keyValueDisplayName(ldn: usize, key: usize, value: usize, result: usize, capacity: i32, status: usize) -> i32 {
    if !arguments(ldn, key, result, capacity, status) { return 0 }
    if value == 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    var out = m.bytesBuffer()
    const found = keyValueName(names(ldn), m.cSlice(key), m.cSlice(value), &out, false)
    return finish(found, &out, result, capacity, status)
}

// ---------------------------------------------------------------------------
// uloc.h's display names (locdispnames.cpp), for locale.mlx: each
// takes and gives what its uloc_ function does. A name not in the data
// is the code itself, with U_USING_DEFAULT_WARNING.

const TABLE_LANGUAGES: u32 = 0
const TABLE_SCRIPTS: u32 = 1
const TABLE_SCRIPTS_STAND_ALONE: u32 = 2
const TABLE_COUNTRIES: u32 = 3
const TABLE_VARIANTS: u32 = 4
const TABLE_KEYS: u32 = 5

// Whether C's strtol makes something not 0 of S.
fn numeric(s: []const u8) -> bool {
    var i: usize = 0
    while i < s.length && (s[i] == 32 || (s[i] >= 9 && s[i] <= 13)) { i += 1 }
    if i < s.length && (s[i] == 43 || s[i] == 45) { i += 1 }
    while i < s.length && s[i] >= 48 && s[i] <= 57 {
        if s[i] != 48 { return true }
        i += 1
    }
    return false
}

fn tableEntry(data: u32, table: u32, item: []const u8, value: *[]const u8) -> bool {
    if table == TABLE_LANGUAGES { return languageEntry(data, item, false, value) }
    if table == TABLE_SCRIPTS { return entry(data, "scripts", item, "", value) }
    if table == TABLE_SCRIPTS_STAND_ALONE { return entry(data, "scripts", item, "-alt-stand-alone", value) }
    if table == TABLE_COUNTRIES { return countryEntry(data, item, false, value) }
    if table == TABLE_VARIANTS { return entry(data, "variants", item, "", value) }
    return entry(data, "keys", item, "", value)
}

// ICU's _getStringOrCopyKey: ITEM's name in TABLE of DISPLAY into OUT;
// false (OUT the item itself) when there is none.
fn nameOrCode(display: usize, table: u32, item: []const u8, out: *m.Bytes) -> bool {
    const data = dataLocale(if display == 0 { locale.defaultLocale() } else { m.cSlice(display) })
    var value: []const u8 = ""
    var found = false
    if table == TABLE_LANGUAGES && numeric(item) {
        found = false
    } else if tableEntry(data, table, item, &value) {
        found = true
    } else if table == TABLE_LANGUAGES {
        var canonical = m.bytesBuffer()
        _ = partOf(PART_CANONICAL, item, &canonical)
        found = tableEntry(data, table, text(&canonical), &value)
        m.disposeBytes(&canonical)
    }
    setText(out, if found { value } else { item })
    return found
}

fn checkedDisplay(dest: usize, capacity: i32, status: usize) -> bool {
    if m.failed(status) { return false }
    if capacity < 0 || (capacity > 0 && dest == 0) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    return true
}

// A component's name (_getDisplayNameForComponent), as UTF-8 into OUT;
// its status: 0, U_USING_DEFAULT_WARNING, or an error.
fn component(localeID: usize, display: usize, which: u32, table: u32, out: *m.Bytes) -> i32 {
    var code = m.bytesBuffer()
    const id = if localeID == 0 { uloc.uloc_getDefault() } else { localeID }
    if !part(which, id, &code) {
        m.disposeBytes(&code)
        return m.ILLEGAL_ARGUMENT_ERROR
    }
    if code.length == 0 {
        if which != PART_LANGUAGE {
            m.disposeBytes(&code)
            setText(out, "")
            return 0
        }
        // The unknown language (ICU-20273).
        setText(&code, "und")
    }
    const found = nameOrCode(display, table, text(&code), out)
    m.disposeBytes(&code)
    return if found { 0 } else { m.USING_DEFAULT_WARNING }
}

fn giveComponent(code: i32, out: *m.Bytes, dest: usize, capacity: i32, status: usize) -> i32 {
    if code > 0 {
        m.disposeBytes(out)
        m.setError(status, code)
        return 0
    }
    if code != 0 { m.setError(status, code) }
    const length = give16(text(out), dest, capacity, status)
    m.disposeBytes(out)
    return length
}

pub fn displayLanguage(localeID: usize, displayLocale: usize, dest: usize, capacity: i32, status: usize) -> i32 {
    if !checkedDisplay(dest, capacity, status) { return 0 }
    var out = m.bytesBuffer()
    return giveComponent(component(localeID, displayLocale, PART_LANGUAGE, TABLE_LANGUAGES, &out), &out, dest, capacity, status)
}

// The stand-alone name of the script, else its name.
pub fn displayScript(localeID: usize, displayLocale: usize, dest: usize, capacity: i32, status: usize) -> i32 {
    if !checkedDisplay(dest, capacity, status) { return 0 }
    var out = m.bytesBuffer()
    var code = component(localeID, displayLocale, PART_SCRIPT, TABLE_SCRIPTS_STAND_ALONE, &out)
    if code == m.USING_DEFAULT_WARNING {
        code = component(localeID, displayLocale, PART_SCRIPT, TABLE_SCRIPTS, &out)
    }
    return giveComponent(code, &out, dest, capacity, status)
}

pub fn displayCountry(localeID: usize, displayLocale: usize, dest: usize, capacity: i32, status: usize) -> i32 {
    if !checkedDisplay(dest, capacity, status) { return 0 }
    var out = m.bytesBuffer()
    return giveComponent(component(localeID, displayLocale, PART_COUNTRY, TABLE_COUNTRIES, &out), &out, dest, capacity, status)
}

pub fn displayVariant(localeID: usize, displayLocale: usize, dest: usize, capacity: i32, status: usize) -> i32 {
    if !checkedDisplay(dest, capacity, status) { return 0 }
    var out = m.bytesBuffer()
    return giveComponent(component(localeID, displayLocale, PART_VARIANT, TABLE_VARIANTS, &out), &out, dest, capacity, status)
}

pub fn displayKeyword(keyword: usize, displayLocale: usize, dest: usize, capacity: i32, status: usize) -> i32 {
    if !checkedDisplay(dest, capacity, status) { return 0 }
    var out = m.bytesBuffer()
    const found = nameOrCode(displayLocale, TABLE_KEYS, m.cSlice(keyword), &out)
    return giveComponent(if found { 0 } else { m.USING_DEFAULT_WARNING }, &out, dest, capacity, status)
}

// The value of KEYWORD in the locale: its currency's name (from the
// display locale's own currencies), or its type's name.
fn keywordValueName(localeID: usize, keyword: []const u8, displayLocale: usize, out: *m.Bytes) -> i32 {
    var value = m.bytesBuffer()
    var key = m.bytesBuffer()
    m.pushText(&key, keyword)
    var buffer: [256]u8 = undefined
    var s: i32 = 0
    const id = if localeID == 0 { uloc.uloc_getDefault() } else { localeID }
    const length = uloc.uloc_getKeywordValue(id, cString(&key), @intFromPtr(&buffer), 256, @intFromPtr(&s))
    m.disposeBytes(&key)
    if s > 0 {
        m.disposeBytes(&value)
        return s
    }
    if length > 0 && length < 256 { m.pushText(&value, m.bytes(@intFromPtr(&buffer), @intCast(usize, length))) }
    var code: i32 = 0
    var lowered = m.bytesBuffer()
    for c in keyword { m.pushByte(&lowered, lowerAscii(c)) }
    const data = dataLocale(if displayLocale == 0 { locale.defaultLocale() } else { m.cSlice(displayLocale) })
    var found: []const u8 = ""
    if m.same(text(&lowered), "currency") {
        // ures_getByKeyWithFallback: the code as it is, upper case.
        var exact = true
        for c in text(&value) {
            if c >= 97 && c <= 122 { exact = false }
        }
        if value.length == 0 {
            // ICU finds no name and no error for no value.
            setText(out, "")
        } else if exact && value.length == 3 && currencyName(data, text(&value), &found) {
            setText(out, found)
        } else {
            setText(out, text(&value))
            code = m.USING_DEFAULT_WARNING
        }
    } else {
        var table = m.bytesBuffer()
        m.pushText(&table, "types/")
        m.pushText(&table, keyword)
        if !contains(keyword, 47) && entry(data, text(&table), text(&value), "", &found) {
            setText(out, found)
        } else {
            setText(out, text(&value))
            code = m.USING_DEFAULT_WARNING
        }
        m.disposeBytes(&table)
    }
    m.disposeBytes(&lowered)
    m.disposeBytes(&value)
    return code
}

pub fn displayKeywordValue(localeID: usize, keyword: usize, displayLocale: usize, dest: usize, capacity: i32, status: usize) -> i32 {
    if !checkedDisplay(dest, capacity, status) { return 0 }
    var out = m.bytesBuffer()
    const code = keywordValueName(localeID, m.cSlice(keyword), displayLocale, &out)
    return giveComponent(code, &out, dest, capacity, status)
}

// The text of PATTERN between its {0} and {1} (the separator as ICU's
// uloc_getDisplayName uses it), or false.
fn between(pattern: []const u8, out: *m.Bytes) -> bool {
    var zero = pattern.length
    var one = pattern.length
    var i: usize = 0
    while i + 2 < pattern.length {
        if pattern[i] == 123 && pattern[i + 2] == 125 {
            if pattern[i + 1] == 48 && zero == pattern.length { zero = i }
            if pattern[i + 1] == 49 && one == pattern.length { one = i }
        }
        i += 1
    }
    if zero == pattern.length || one == pattern.length || one < zero { return false }
    setText(out, pattern[zero + 3..one])
    return true
}

// uloc_getDisplayName: the language, then the script, region, variant
// and keywords ("key=value") joined by the separator in the locale
// pattern; their parentheses made brackets.
pub fn displayName(localeID: usize, displayLocale: usize, dest: usize, capacity: i32, status: usize) -> i32 {
    if !checkedDisplay(dest, capacity, status) { return 0 }
    const display = if displayLocale == 0 { locale.defaultLocale() } else { m.cSlice(displayLocale) }
    const data = dataLocale(display)
    var value: []const u8 = ""
    var sep = m.bytesBuffer()
    const separatorPattern = if localeData(data, "localeSeparator", &value) && value.length > 0 { value } else { "{0}, {1}" }
    if !between(separatorPattern, &sep) {
        m.disposeBytes(&sep)
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    var pattern: []const u8 = "{0} ({1})"
    if localeData(data, "localePattern", &value) && value.length > 0 { pattern = value }
    var zero = pattern.length
    var one = pattern.length
    var i: usize = 0
    while i + 2 < pattern.length {
        if pattern[i] == 123 && pattern[i + 2] == 125 {
            if pattern[i + 1] == 48 && zero == pattern.length { zero = i }
            if pattern[i + 1] == 49 && one == pattern.length { one = i }
        }
        i += 1
    }
    if zero == pattern.length || one == pattern.length {
        m.disposeBytes(&sep)
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    var fullwidth = false
    var at: usize = 0
    while at < pattern.length {
        var size: usize = 0
        if decodeAt(pattern, at, &size) == 65288 { fullwidth = true }
        at += size
    }
    const id = if localeID == 0 { uloc.uloc_getDefault() } else { localeID }
    var warning = false
    var lang = m.bytesBuffer()
    var code = component(id, displayLocale, PART_LANGUAGE, TABLE_LANGUAGES, &lang)
    if code > 0 {
        m.disposeBytes(&lang)
        m.disposeBytes(&sep)
        m.setError(status, code)
        return 0
    }
    if code != 0 { warning = true }
    // The rest: script, region, variant, then the keywords.
    var rest = m.bytesBuffer()
    var piece = m.bytesBuffer()
    var k: u32 = 0
    while k < 3 {
        if k == 0 {
            code = component(id, displayLocale, PART_SCRIPT, TABLE_SCRIPTS, &piece)
        } else if k == 1 {
            code = component(id, displayLocale, PART_COUNTRY, TABLE_COUNTRIES, &piece)
        } else {
            code = component(id, displayLocale, PART_VARIANT, TABLE_VARIANTS, &piece)
        }
        if code > 0 { setText(&piece, "") }
        if code == m.USING_DEFAULT_WARNING { warning = true }
        if piece.length > 0 {
            if rest.length > 0 { m.pushText(&rest, text(&sep)) }
            if fullwidth {
                replaceAll(&piece, 65288, 65339)
                replaceAll(&piece, 65289, 65341)
            } else {
                replaceAll(&piece, 40, 91)
                replaceAll(&piece, 41, 93)
            }
            m.pushText(&rest, text(&piece))
        }
        k += 1
    }
    var name = m.bytesBuffer()
    _ = part(PART_NAME, id, &name)
    const full = text(&name)
    at = 0
    while at < full.length && full[at] != 64 { at += 1 }
    at += 1
    var key: []const u8 = ""
    var keyValue: []const u8 = ""
    var keyText = m.bytesBuffer()
    while nextKeyword(full, &at, &key, &keyValue) {
        if !nameOrCode(displayLocale, TABLE_KEYS, key, &piece) { warning = true }
        code = keywordValueName(id, key, displayLocale, &keyText)
        if code == m.USING_DEFAULT_WARNING { warning = true }
        if code > 0 { setText(&keyText, "") }
        if piece.length > 0 && keyText.length > 0 { m.pushByte(&piece, 61) }
        m.pushText(&piece, text(&keyText))
        if piece.length > 0 {
            if rest.length > 0 { m.pushText(&rest, text(&sep)) }
            if fullwidth {
                replaceAll(&piece, 65288, 65339)
                replaceAll(&piece, 65289, 65341)
            } else {
                replaceAll(&piece, 40, 91)
                replaceAll(&piece, 41, 93)
            }
            m.pushText(&rest, text(&piece))
        }
    }
    var out = m.bytesBuffer()
    if lang.length > 0 && rest.length > 0 {
        // The pattern's text around {0} (the language) and {1} (the rest).
        const reversed = one < zero
        const first = if reversed { one } else { zero }
        const second = if reversed { zero } else { one }
        m.pushText(&out, pattern[0..first])
        m.pushText(&out, if reversed { text(&rest) } else { text(&lang) })
        m.pushText(&out, pattern[first + 3..second])
        m.pushText(&out, if reversed { text(&lang) } else { text(&rest) })
        m.pushText(&out, pattern[second + 3..pattern.length])
    } else if lang.length > 0 {
        m.pushText(&out, text(&lang))
    } else {
        m.pushText(&out, text(&rest))
    }
    if warning { m.setError(status, m.USING_DEFAULT_WARNING) }
    const length = give16(text(&out), dest, capacity, status)
    m.disposeBytes(&out)
    m.disposeBytes(&keyText)
    m.disposeBytes(&name)
    m.disposeBytes(&piece)
    m.disposeBytes(&rest)
    m.disposeBytes(&lang)
    m.disposeBytes(&sep)
    return length
}

// ---------------------------------------------------------------------------
// The native API (std.unicode: UTF-8 text, results from the allocator
// given, failures as unicode.Error).

fn nativeName(allocator: utf.Allocator, displayLocale: []const u8, code: []const u8, which: u8) -> unicode.Error![]u8 {
    var name: [160]u8 = undefined
    const id = try unicode.cName(displayLocale, &name)
    var codeName: [160]u8 = undefined
    const codeId = try unicode.cName(code, &codeName)
    var status: i32 = 0
    const names = uldn_open(id, 0, @intFromPtr(&status))
    try unicode.check(status)
    defer uldn_close(names)
    var out = try unicode.units(allocator, 64)
    defer unicode.freeUnits(&out)
    var length: i32 = 0
    var tries: usize = 0
    while tries < 2 {
        status = 0
        if which == 0 { length = uldn_languageDisplayName(names, codeId, unicode.address(&out), unicode.capacityOf(&out), @intFromPtr(&status)) }
        if which == 1 { length = uldn_scriptDisplayName(names, codeId, unicode.address(&out), unicode.capacityOf(&out), @intFromPtr(&status)) }
        if which == 2 { length = uldn_regionDisplayName(names, codeId, unicode.address(&out), unicode.capacityOf(&out), @intFromPtr(&status)) }
        if status != unicode.BUFFER_OVERFLOW_ERROR || length <= 0 { break }
        try unicode.reserve(&out, @intCast(usize, length))
        tries += 1
    }
    try unicode.check(status)
    return unicode.utf8Of(&out, length)
}

// A language's name ("de", "en_GB") in `displayLocale` ("Deutsch",
// "British English" in "en"); the code itself when CLDR has no name.
pub fn languageName(allocator: utf.Allocator, displayLocale: []const u8, language: []const u8) -> unicode.Error![]u8 { return nativeName(allocator, displayLocale, language, 0) }

// A script's name ("Cyrl") in `displayLocale`.
pub fn scriptName(allocator: utf.Allocator, displayLocale: []const u8, script: []const u8) -> unicode.Error![]u8 { return nativeName(allocator, displayLocale, script, 1) }

// A region's name ("JP", "419") in `displayLocale`.
pub fn regionName(allocator: utf.Allocator, displayLocale: []const u8, region: []const u8) -> unicode.Error![]u8 { return nativeName(allocator, displayLocale, region, 2) }
