// mlx-unicode's locale data: cldr.dat, made of CLDR by cldr-data
// (cldrdata.mlx describes the file), mapped at its first use and looked
// up by locale and key ("numbers/symbols-numberSystem-latn/decimal"),
// a locale's parents after it, as ICU looks up its resource bundles.
//
// The file is MLX_UNICODE_DATA when that is set, else
// ../share/mlx-unicode/cldr.dat beside the directory of the library
// (mlx-out/lib/libmlxunicode.so finds mlx-out/share/...), else
// /usr/share/mlx-unicode/cldr.dat. Without it there is no data: lookups
// find nothing and the formatters say so (U_MISSING_RESOURCE_ERROR).
const m = @import("std.unicode.memory")
const localeid = @import("std.unicode.locale")

extern("c") fn getenv(name: usize) -> usize
extern("c") fn open(path: usize, flags: i32, mode: u32) -> i32
extern("c") fn close(descriptor: i32) -> i32
extern("c") fn read(descriptor: i32, buffer: usize, count: usize) -> isize
extern("c") fn lseek(descriptor: i32, offset: i64, whence: i32) -> i64
extern("c") fn mmap(address: usize, length: usize, protection: i32, flags: i32, descriptor: i32, offset: i64) -> usize

pub const NONE: u32 = 4294967295

// The mapped file (0 when it is not), and whether it was looked for.
var base: usize = 0
var tried: bool = false
var localeCount: u32 = 0
var keyCount: u32 = 0
var localeTable: usize = 0
var keyTable: usize = 0
var entryTable: usize = 0
var stringOffsets: usize = 0
var stringBytes: usize = 0

fn mapFile(path: usize) -> bool {
    const descriptor = open(path, 0, 0)
    if descriptor < 0 { return false }
    const size = lseek(descriptor, 0, 2)
    if size < 64 {
        _ = close(descriptor)
        return false
    }
    // PROT_READ, MAP_PRIVATE.
    const address = mmap(0, @intCast(usize, size), 1, 2, descriptor, 0)
    _ = close(descriptor)
    if address == 18446744073709551615 || address == 0 { return false }
    if !m.same(m.bytes(address, 8), "MLXCLDR\x00") || m.get32(address + 8) != 1 { return false }
    localeCount = m.get32(address + 12)
    keyCount = m.get32(address + 16)
    localeTable = address + @intCast(usize, m.get32(address + 28))
    keyTable = address + @intCast(usize, m.get32(address + 32))
    entryTable = address + @intCast(usize, m.get32(address + 36))
    stringOffsets = address + @intCast(usize, m.get32(address + 40))
    stringBytes = address + @intCast(usize, m.get32(address + 44))
    base = address
    return true
}

// The directory of the library, from /proc/self/maps: where the file
// that maps it is (libmlxunicode.so...), "" when it is not found.
fn libraryDirectory(into: [*]u8, capacity: usize) -> usize {
    const descriptor = open(m.literal("/proc/self/maps\x00"), 0, 0)
    if descriptor < 0 { return 0 }
    const size: usize = 1048576
    const buffer = m.alloc(size)
    var length: usize = 0
    while length < size - 1 {
        const count = read(descriptor, buffer + length, size - 1 - length)
        if count <= 0 { break }
        length += @intCast(usize, count)
    }
    _ = close(descriptor)
    const maps = m.bytes(buffer, length)
    var found: usize = 0
    var at: usize = 0
    while at < maps.length && found == 0 {
        var end = at
        while end < maps.length && maps[end] != 10 { end += 1 }
        const line = maps[at..end]
        // The path is the line's last field, from its first slash.
        var slash: usize = 0
        while slash < line.length && line[slash] != 47 { slash += 1 }
        const path = line[slash..line.length]
        var name = path.length
        while name > 0 && path[name - 1] != 47 { name -= 1 }
        const file = path[name..path.length]
        if file.length >= 16 && m.same(file[0..16], "libmlxunicode.so") && name > 0 && name - 1 < capacity {
            var index: usize = 0
            while index < name - 1 {
                into[index] = path[index]
                index += 1
            }
            found = name - 1
        }
        at = end + 1
    }
    m.release(buffer)
    return found
}

// Whether the file is mapped (looked for once; threads that look at the
// same time may each map it, which costs only the mapping).
fn ready() -> bool {
    if base != 0 { return true }
    if tried { return false }
    const mapped = search()
    tried = true
    return mapped
}

fn search() -> bool {
    const given = getenv(m.literal("MLX_UNICODE_DATA\x00"))
    if given != 0 { return mapFile(given) }
    var path: [4096]u8 = undefined
    const bytes: [*]u8 = unsafe { @ptrCast([*]u8, &path) }
    const directory = libraryDirectory(bytes, 4000)
    if directory > 0 {
        const rest = "/../share/mlx-unicode/cldr.dat\x00"
        var index: usize = 0
        while index < rest.length {
            bytes[directory + index] = rest[index]
            index += 1
        }
        if mapFile(@intFromPtr(bytes)) { return true }
    }
    return mapFile(m.literal("/usr/share/mlx-unicode/cldr.dat\x00"))
}

// Whether there is data.
pub fn available() -> bool { return ready() }

// String ID of the file.
pub fn string(id: u32) -> []const u8 {
    const start = m.get32(stringOffsets + @intCast(usize, id) * 4)
    const end = m.get32(stringOffsets + @intCast(usize, id) * 4 + 4)
    return m.bytes(stringBytes + @intCast(usize, start), @intCast(usize, end - start - 1))
}

// The address of string ID (it ends in NUL), for C.
pub fn stringAddress(id: u32) -> usize { return stringBytes + @intCast(usize, m.get32(stringOffsets + @intCast(usize, id) * 4)) }

// The address (C string) of the data's string TEXT is when TEXT is one of
// its key's names: TEXT itself when it is in the data, which key parts
// are not as such; so a copy, kept.
pub fn stringAddressOf(text: []const u8) -> usize {
    const copy = m.alloc(text.length + 1)
    m.copy(copy, @intFromPtr(text.pointer), text.length)
    return copy
}

fn order(a: []const u8, b: []const u8) -> i32 {
    var k: usize = 0
    while k < a.length && k < b.length {
        if a[k] != b[k] { return if a[k] < b[k] { -1 } else { 1 } }
        k += 1
    }
    if a.length == b.length { return 0 }
    return if a.length < b.length { -1 } else { 1 }
}

// ---------------------------------------------------------------------------
// Locales.

pub fn localeName(index: u32) -> []const u8 { return string(m.get32(localeTable + @intCast(usize, index) * 16)) }
pub fn parent(index: u32) -> u32 { return m.get32(localeTable + @intCast(usize, index) * 16 + 4) }
pub fn count() -> u32 { return if ready() { localeCount } else { 0 } }

// The locale named NAME exactly (CLDR's form: "de-AT"), or NONE.
pub fn exact(name: []const u8) -> u32 {
    if !ready() { return NONE }
    var low: u32 = 0
    var high = localeCount
    while low < high {
        const middle = low + (high - low) / 2
        const c = order(localeName(middle), name)
        if c == 0 { return middle }
        if c < 0 { low = middle + 1 } else { high = middle }
    }
    return NONE
}

pub fn root() -> u32 { return exact("und") }
pub fn supplemental() -> u32 { return exact("@supplemental") }

fn isLetters(text: []const u8, length: usize) -> bool {
    if text.length != length { return false }
    for byte in text {
        if !((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)) { return false }
    }
    return true
}

// The script subtag of an ID ("_" or "-" separated), "" when none.
fn scriptOf(id: []const u8) -> []const u8 {
    var at: usize = 0
    var start: usize = 0
    var part: usize = 0
    while at <= id.length {
        if at == id.length || id[at] == 95 || id[at] == 45 {
            if part == 1 && isLetters(id[start..at], 4) { return id[start..at] }
            part += 1
            start = at + 1
        }
        at += 1
    }
    return ""
}

// The longest locale with data that ID (an ICU ID or a BCP 47 tag)
// names, or what it falls back to: the ID itself, then with the script
// it implies when that is not its language's own (zh_TW is zh_Hant_TW),
// then shorter by a subtag at a time; und at the end.
pub fn find(id: []const u8) -> u32 {
    if !ready() { return NONE }
    var name: [160]u8 = undefined
    const bytes: [*]u8 = unsafe { @ptrCast([*]u8, &name) }
    var length: usize = 0
    for byte in id {
        if byte == 64 || length == 150 { break }
        bytes[length] = if byte == 95 { 45 } else { byte }
        length += 1
    }
    if length == 0 || m.same(bytes[0..length], "root") { return root() }
    var found = exact(bytes[0..length])
    if found != NONE { return found }
    // The script the ID implies, against its language's.
    var likely: [160]u8 = undefined
    const likelyBytes: [*]u8 = unsafe { @ptrCast([*]u8, &likely) }
    const likelyLength = localeid.likelyInto(id, likelyBytes, 150)
    var languageEnd: usize = 0
    while languageEnd < length && bytes[languageEnd] != 45 { languageEnd += 1 }
    var own: [160]u8 = undefined
    const ownBytes: [*]u8 = unsafe { @ptrCast([*]u8, &own) }
    const ownLength = localeid.likelyInto(bytes[0..languageEnd], ownBytes, 150)
    if likelyLength > 0 && ownLength > 0 && scriptOf(bytes[0..length]).length == 0 {
        const script = scriptOf(likelyBytes[0..likelyLength])
        if script.length > 0 && !m.same(script, scriptOf(ownBytes[0..ownLength])) {
            // language-Script and the rest of the ID.
            var with: [170]u8 = undefined
            const withBytes: [*]u8 = unsafe { @ptrCast([*]u8, &with) }
            var w: usize = 0
            var index: usize = 0
            while index < languageEnd {
                withBytes[w] = bytes[index]
                w += 1
                index += 1
            }
            withBytes[w] = 45
            w += 1
            for byte in script {
                withBytes[w] = byte
                w += 1
            }
            while index < length {
                withBytes[w] = bytes[index]
                w += 1
                index += 1
            }
            found = shortened(withBytes[0..w], languageEnd)
            if found != NONE { return found }
        }
    }
    found = shortened(bytes[0..length], languageEnd)
    if found != NONE { return found }
    return root()
}

// NAME, else NAME without its last subtags, down to its first KEEP bytes.
fn shortened(name: []const u8, keep: usize) -> u32 {
    var end = name.length
    while end >= keep && end > 0 {
        const found = exact(name[0..end])
        if found != NONE { return found }
        if end == keep { break }
        end -= 1
        while end > keep && name[end] != 45 { end -= 1 }
    }
    return NONE
}

// ---------------------------------------------------------------------------
// Keys and values.

pub fn keyName(index: u32) -> []const u8 { return string(m.get32(keyTable + @intCast(usize, index) * 4)) }
pub fn keys() -> u32 { return if ready() { keyCount } else { 0 } }

// The index of key PATH, or NONE.
pub fn key(path: []const u8) -> u32 {
    if !ready() { return NONE }
    const at = lowerBound(path)
    if at < keyCount && m.same(keyName(at), path) { return at }
    return NONE
}

// The first key not before TEXT.
pub fn lowerBound(text: []const u8) -> u32 {
    var low: u32 = 0
    var high = keyCount
    while low < high {
        const middle = low + (high - low) / 2
        if order(keyName(middle), text) < 0 { low = middle + 1 } else { high = middle }
    }
    return low
}

// The value of key KEY in LOCALE alone (no parents): its string, or NONE.
pub fn own(locale: u32, keyIndex: u32) -> u32 {
    const row = localeTable + @intCast(usize, locale) * 16
    var low = m.get32(row + 8)
    var high = low + m.get32(row + 12)
    while low < high {
        const middle = low + (high - low) / 2
        const k = m.get32(entryTable + @intCast(usize, middle) * 8)
        if k == keyIndex { return m.get32(entryTable + @intCast(usize, middle) * 8 + 4) }
        if k < keyIndex { low = middle + 1 } else { high = middle }
    }
    return NONE
}

// The value of key KEY for LOCALE: its own, else its parents' (a string
// ID, or NONE).
pub fn valueOf(locale: u32, keyIndex: u32) -> u32 {
    if keyIndex == NONE { return NONE }
    var at = locale
    while at != NONE {
        const found = own(at, keyIndex)
        if found != NONE {
            // A locale without what its parent has (CLDR's ∅∅∅).
            if isAbsent(found) { return NONE }
            return found
        }
        at = parent(at)
    }
    return NONE
}

// Whether string ID is the marker of a value a locale does not have.
fn isAbsent(id: u32) -> bool {
    const text = string(id)
    return text.length == 9 && m.same(text, "\xe2\x88\x85\xe2\x88\x85\xe2\x88\x85")
}

// The value of PATH for LOCALE ("" when there is none).
pub fn get(locale: u32, path: []const u8) -> []const u8 {
    if locale == NONE { return "" }
    const found = valueOf(locale, key(path))
    return if found == NONE { "" } else { string(found) }
}

// Whether PATH has a value for LOCALE, into VALUE.
pub fn lookup(locale: u32, path: []const u8, value: *[]const u8) -> bool {
    if locale == NONE { return false }
    const found = valueOf(locale, key(path))
    if found == NONE { return false }
    value.* = string(found)
    return true
}

// The keys below PREFIX ("a/b" for "a/b/..."): the range [first, end) of
// key indexes.
pub fn below(prefix: []const u8, first: *u32, end: *u32) -> void {
    if !ready() {
        first.* = 0
        end.* = 0
        return
    }
    var with: [512]u8 = undefined
    const bytes: [*]u8 = unsafe { @ptrCast([*]u8, &with) }
    var length: usize = 0
    for byte in prefix {
        if length < 510 {
            bytes[length] = byte
            length += 1
        }
    }
    bytes[length] = 47
    first.* = lowerBound(bytes[0..length + 1])
    // '/' + 1 is '0': the end of what starts PREFIX/.
    bytes[length] = 48
    end.* = lowerBound(bytes[0..length + 1])
}

// The part of key KEY after PREFIX/ up to its next slash.
pub fn childName(keyIndex: u32, prefixLength: usize) -> []const u8 {
    const name = keyName(keyIndex)
    var end = prefixLength + 1
    while end < name.length && name[end] != 47 { end += 1 }
    return name[prefixLength + 1..end]
}
