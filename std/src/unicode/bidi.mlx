// std.unicode.bidi: the Unicode Bidirectional Algorithm (UAX #9, Unicode
// 16) and ICU's ubidi.h over it.
//
// The algorithm, paragraph by paragraph (P1: a B ends one, CR LF is one
// B): the paragraph level (P2, P3, skipping isolates, or given), the
// explicit levels with the directional status stack of 125 levels and its
// overflow counters (X1-X8, isolates included), the characters X9 removes
// (BN and the embedding controls, kept in place), the isolating run
// sequences (X10, with their sos and eos), the weak types (W1-W7), the
// paired brackets (N0, BD16 with a stack of 63 and the canonical
// equivalents of U+2329 and U+232A), the neutrals (N1, N2), the implicit
// levels (I1, I2), and the levels of whitespace at the ends of lines (L1);
// reordering (L2) by the levels. The classes, mirrored glyphs and paired
// brackets are the UCD's, from std.unicode.properties.
//
// ICU's API follows ICU's own conventions where the algorithm leaves the
// choice to the implementation, so that a program sees what it would with
// ICU: text is UTF-16 and the levels are a level per code unit (a
// supplementary character's lead surrogate is taken as BN); a character X9
// removes gets the level of the character after it, or the paragraph's
// at the end of a line; text whose only strong direction is the
// paragraph's is reported as that direction (UBIDI_LTR or UBIDI_RTL) with
// all its levels the paragraph's, as ICU reports it (the order is the
// same); a line (ubidi_setLine) takes its levels from its paragraph, with
// L1 for its own end. Not done: the reordering modes other than
// UBIDI_REORDER_DEFAULT and the inverse algorithm (the mode is kept, the
// default algorithm runs), the options that insert marks
// (UBIDI_OPTION_INSERT_MARKS, UBIDI_INSERT_LRM_FOR_NUMERIC) and streaming;
// ubidi_setContext's text is kept but does not take part.
//
// The native API, for Mlx: `resolveLevels` gives the level of each code
// point of UTF-8 text, `visualOrder` the visual order of levels (L2),
// `baseDirection` the first strong direction.
const m = @import("std.unicode.memory")
const p = @import("std.unicode.properties")
const unicode = @import("std.unicode")
const utf = @import("std.unicode.utf")

// The classes, as UCharDirection numbers them.
pub const L: u8 = 0
pub const R: u8 = 1
pub const EN: u8 = 2
pub const ES: u8 = 3
pub const ET: u8 = 4
pub const AN: u8 = 5
pub const CS: u8 = 6
pub const B: u8 = 7
pub const S: u8 = 8
pub const WS: u8 = 9
pub const ON: u8 = 10
pub const LRE: u8 = 11
pub const LRO: u8 = 12
pub const AL: u8 = 13
pub const RLE: u8 = 14
pub const RLO: u8 = 15
pub const PDF: u8 = 16
pub const NSM: u8 = 17
pub const BN: u8 = 18
pub const FSI: u8 = 19
pub const LRI: u8 = 20
pub const RLI: u8 = 21
pub const PDI: u8 = 22
// UBIDI_CLASS_DEFAULT: what a class callback answers to leave a code
// point's class as it is.
pub const CLASS_DEFAULT: i32 = 23

// UBiDiDirection.
pub const DIRECTION_LTR: i32 = 0
pub const DIRECTION_RTL: i32 = 1
pub const DIRECTION_MIXED: i32 = 2
pub const DIRECTION_NEUTRAL: i32 = 3

pub const DEFAULT_LTR: u8 = 254
pub const DEFAULT_RTL: u8 = 255
pub const MAX_EXPLICIT_LEVEL: u8 = 125
pub const LEVEL_OVERRIDE: u8 = 128
pub const MAP_NOWHERE: i32 = -1

// The options of ubidi_writeReordered.
pub const KEEP_BASE_COMBINING: u32 = 1
pub const DO_MIRRORING: u32 = 2
pub const INSERT_LRM_FOR_NUMERIC: u32 = 4
pub const REMOVE_BIDI_CONTROLS: u32 = 8
pub const OUTPUT_REVERSE: u32 = 16

// The reordering options (ubidi_setReorderingOptions).
pub const OPTION_INSERT_MARKS: u32 = 1
pub const OPTION_REMOVE_CONTROLS: u32 = 2
pub const OPTION_STREAMING: u32 = 4

const MAX_DEPTH: usize = 125
const BRACKET_STACK: usize = 63

fn bit(c: u8) -> u32 { return @intCast(u32, 1) << @intCast(u5, c) }

// Removed by X9 (kept in place, skipped by the rules after it).
fn isRemoved(c: u8) -> bool { return c == BN || c == LRE || c == RLE || c == LRO || c == RLO || c == PDF }
fn isIsolateInitiator(c: u8) -> bool { return c == LRI || c == RLI || c == FSI }
fn isStrong(c: u8) -> bool { return c == L || c == R || c == AL }
// The neutral and isolate types of N1 and N2 (NI).
fn isNeutral(c: u8) -> bool { return c == B || c == S || c == WS || c == ON || c == LRI || c == RLI || c == FSI || c == PDI }

// ICU's MASK_WS: what L1 sets to the paragraph level at the end of a
// line (with the removed characters).
fn isTrailing(c: u8) -> bool { return c == B || c == S || c == WS || isRemoved(c) || isIsolateInitiator(c) || c == PDI }

// ---------------------------------------------------------------------------
// The UBiDi object (C memory): the text (the caller's, not copied), its
// classes and levels, the paragraphs (each its limit and level, 8 bytes),
// the runs (computed when first asked for: each its logical start, visual
// limit and level, 16 bytes), the settings.

const O_TEXT: usize = 0
const O_LENGTH: usize = 8
const O_REQUESTED: usize = 16
const O_PARA_LEVEL: usize = 17
const O_DIRECTION: usize = 20
const O_LEVELS: usize = 24
const O_CLASSES: usize = 32
const O_CAPACITY: usize = 40
const O_PARAS: usize = 48
const O_PARA_COUNT: usize = 56
const O_RUNS: usize = 64
const O_RUN_COUNT: usize = 72
const O_INVERSE: usize = 88
const O_ORDER_LTR: usize = 89
const O_SET: usize = 90
const O_IS_LINE: usize = 91
const O_MODE: usize = 92
const O_OPTIONS: usize = 96
const O_CALLBACK: usize = 104
const O_CONTEXT: usize = 112
const O_PROLOGUE: usize = 120
const O_PROLOGUE_LENGTH: usize = 128
const O_EPILOGUE: usize = 136
const O_EPILOGUE_LENGTH: usize = 144
const O_SIZE: usize = 160

pub const ClassCallback = fn(usize, i32) -> i32

fn length(b: usize) -> usize { return m.getWord(b + O_LENGTH) }
fn levelAt(b: usize, i: usize) -> u8 { return m.get8(m.getWord(b + O_LEVELS) + i) }
fn classAt(b: usize, i: usize) -> u8 { return m.get8(m.getWord(b + O_CLASSES) + i) }

pub fn ubidi_open() -> usize { return m.alloc(O_SIZE) }

pub fn ubidi_openSized(maxLength: i32, maxRunCount: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if maxLength < 0 || maxRunCount < 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const b = ubidi_open()
    if b == 0 { m.setError(status, m.MEMORY_ALLOCATION_ERROR) }
    return b
}

fn releaseArrays(b: usize) -> void {
    m.release(m.getWord(b + O_LEVELS))
    m.release(m.getWord(b + O_CLASSES))
    m.release(m.getWord(b + O_PARAS))
    m.release(m.getWord(b + O_RUNS))
    m.putWord(b + O_LEVELS, 0)
    m.putWord(b + O_CLASSES, 0)
    m.putWord(b + O_PARAS, 0)
    m.putWord(b + O_RUNS, 0)
}

pub fn ubidi_close(b: usize) -> void {
    if b == 0 { return }
    releaseArrays(b)
    m.release(b)
}

pub fn ubidi_setInverse(b: usize, isInverse: u8) -> void {
    if b == 0 { return }
    m.put8(b + O_INVERSE, if isInverse != 0 { 1 } else { 0 })
    m.putI32(b + O_MODE, if isInverse != 0 { 4 } else { 0 })
}
pub fn ubidi_isInverse(b: usize) -> u8 { return if b != 0 { m.get8(b + O_INVERSE) } else { 0 } }
pub fn ubidi_orderParagraphsLTR(b: usize, orderParagraphsLTR: u8) -> void { if b != 0 { m.put8(b + O_ORDER_LTR, if orderParagraphsLTR != 0 { 1 } else { 0 }) } }
pub fn ubidi_isOrderParagraphsLTR(b: usize) -> u8 { return if b != 0 { m.get8(b + O_ORDER_LTR) } else { 0 } }

// UBiDiReorderingMode: 0 (UBIDI_REORDER_DEFAULT) to 6; kept, but only
// the default algorithm runs.
pub fn ubidi_setReorderingMode(b: usize, mode: i32) -> void {
    if b == 0 || mode < 0 || mode > 6 { return }
    m.putI32(b + O_MODE, mode)
    m.put8(b + O_INVERSE, if mode == 4 { 1 } else { 0 })
}
pub fn ubidi_getReorderingMode(b: usize) -> i32 { return if b != 0 { m.getI32(b + O_MODE) } else { -1 } }
pub fn ubidi_setReorderingOptions(b: usize, options: u32) -> void {
    if b == 0 { return }
    // (ICU: removing controls and inserting marks exclude each other.)
    m.put32(b + O_OPTIONS, if (options & OPTION_REMOVE_CONTROLS) != 0 { options & ~OPTION_INSERT_MARKS } else { options })
}
pub fn ubidi_getReorderingOptions(b: usize) -> u32 { return if b != 0 { m.get32(b + O_OPTIONS) } else { 0 } }

pub fn ubidi_setContext(b: usize, prologue: usize, proLength: i32, epilogue: usize, epiLength: i32, status: usize) -> void {
    if m.failed(status) { return }
    if b == 0 || proLength < -1 || epiLength < -1 || (prologue == 0 && proLength != 0) || (epilogue == 0 && epiLength != 0) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    m.putWord(b + O_PROLOGUE, prologue)
    m.putWord(b + O_PROLOGUE_LENGTH, if prologue != 0 { m.units(prologue, proLength) } else { 0 })
    m.putWord(b + O_EPILOGUE, epilogue)
    m.putWord(b + O_EPILOGUE_LENGTH, if epilogue != 0 { m.units(epilogue, epiLength) } else { 0 })
}

pub fn ubidi_setClassCallback(b: usize, newFn: usize, newContext: usize, oldFn: usize, oldContext: usize, status: usize) -> void {
    if m.failed(status) { return }
    if b == 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    if oldFn != 0 { m.putWord(oldFn, m.getWord(b + O_CALLBACK)) }
    if oldContext != 0 { m.putWord(oldContext, m.getWord(b + O_CONTEXT)) }
    m.putWord(b + O_CALLBACK, newFn)
    m.putWord(b + O_CONTEXT, newContext)
}

pub fn ubidi_getClassCallback(b: usize, callback: usize, context: usize) -> void {
    if b == 0 { return }
    if callback != 0 { m.putWord(callback, m.getWord(b + O_CALLBACK)) }
    if context != 0 { m.putWord(context, m.getWord(b + O_CONTEXT)) }
}

pub fn ubidi_getCustomizedClass(b: usize, c: i32) -> i32 {
    if b != 0 && m.getWord(b + O_CALLBACK) != 0 {
        const call: ClassCallback = unsafe { @ptrFromInt(ClassCallback, m.getWord(b + O_CALLBACK)) }
        const answer = call(m.getWord(b + O_CONTEXT), c)
        if answer >= 0 && answer < CLASS_DEFAULT { return answer }
    }
    return p.u_charDirection(c)
}

// ---------------------------------------------------------------------------
// The algorithm, on arrays in C memory: `cls` the classes (u8), `t` the
// working types (u8), `lv` the levels (u8), all `count` long.

// What resolving one paragraph works with.
const Work = struct {
    text: usize
    cls: usize
    t: usize
    lv: usize
    // For each isolate initiator, the index of its matching PDI + 1 (0:
    // none); for each PDI, its initiator's + 1 (u32 each).
    pairing: usize
    // Whether the directional override was on at each character (u8).
    over: usize
    // The explicit levels (X1-X9), which sos and eos are of (u8).
    explicit: usize
    // What explicitLevels says of each isolate initiator and PDI (u8).
    info: usize
    // The length of the whole text.
    count: usize
    // Whether W7 and N0 take the paragraph before's level (see
    // resolveSequence), and that level.
    carried: bool
    carriedLevel: u8
    // The isolating run sequence being resolved: its indices (u32 each).
    sequence: usize
    start: usize
    limit: usize
    paraLevel: u8
}

fn t(w: *Work, i: usize) -> u8 { return m.get8(w.*.t + i) }
fn setT(w: *Work, i: usize, value: u8) -> void { m.put8(w.*.t + i, value) }
fn lv(w: *Work, i: usize) -> u8 { return m.get8(w.*.lv + i) }
fn explicitLevel(w: *Work, i: usize) -> u8 { return m.get8(w.*.explicit + i) }
fn cls(w: *Work, i: usize) -> u8 { return m.get8(w.*.cls + i) }
fn matchOf(w: *Work, i: usize) -> usize { return @intCast(usize, m.get32(w.*.pairing + i * 4)) }
fn seq(w: *Work, k: usize) -> usize { return @intCast(usize, m.get32(w.*.sequence + k * 4)) }

// BD9: the matching PDI of each isolate initiator of [start, limit).
fn matchIsolates(w: *Work) -> void {
    var stack = m.buffer()
    var i = w.*.start
    while i < w.*.limit {
        m.put32(w.*.pairing + i * 4, 0)
        const c = cls(w, i)
        if isIsolateInitiator(c) {
            m.push(&stack, @intCast(u32, i))
        } else if c == PDI && stack.length > 0 {
            const opener = @intCast(usize, m.at(&stack, stack.length - 1))
            stack.length -= 1
            m.put32(w.*.pairing + opener * 4, @intCast(u32, i + 1))
            m.put32(w.*.pairing + i * 4, @intCast(u32, opener + 1))
        }
        i += 1
    }
    m.dispose(&stack)
}

// P2, P3: the first strong class of [from, to), skipping isolates (to
// their matching PDI, or to the end), and stopping at a PDI that closes
// an isolate begun before `from` (for FSI); 2 when there is none.
fn firstStrong(w: *Work, from: usize, to: usize) -> u8 {
    var i = from
    while i < to {
        const c = cls(w, i)
        if c == L { return 0 }
        if c == R || c == AL { return 1 }
        if isIsolateInitiator(c) {
            const closing = matchOf(w, i)
            if closing == 0 { return 2 }
            i = closing - 1
        } else if c == PDI && from > w.*.start {
            return 2
        }
        i += 1
    }
    return 2
}

fn nextOdd(level: u8) -> u8 { return if (level & 1) == 0 { level + 1 } else { level + 2 } }
fn nextEven(level: u8) -> u8 { return if (level & 1) == 0 { level + 2 } else { level + 1 } }

// X1-X8: the explicit levels, and the overrides on the types.
fn explicitLevels(w: *Work) -> void {
    // The stack: a level (bits 0-6), an override (bit 7: on; bit 8: R),
    // an isolate (bit 9), a u32 an entry.
    var stack: [128]u32 = undefined
    var depth: usize = 1
    stack[0] = @intCast(u32, w.*.paraLevel)
    var overflowIsolates: usize = 0
    var overflowEmbeddings: usize = 0
    var validIsolates: usize = 0
    var i = w.*.start
    while i < w.*.limit {
        const c = cls(w, i)
        const top = stack[depth - 1]
        const level = @intCast(u8, top & 127)
        if c == RLE || c == LRE || c == RLO || c == LRO {
            const next = if c == RLE || c == RLO { nextOdd(level) } else { nextEven(level) }
            if next <= MAX_EXPLICIT_LEVEL && overflowIsolates == 0 && overflowEmbeddings == 0 {
                var entry = @intCast(u32, next)
                if c == RLO { entry = entry | 384 }
                if c == LRO { entry = entry | 128 }
                stack[depth] = entry
                depth += 1
            } else if overflowIsolates == 0 {
                overflowEmbeddings += 1
            }
            m.put8(w.*.lv + i, level)
        } else if isIsolateInitiator(c) {
            m.put8(w.*.lv + i, level)
            m.put8(w.*.over + i, if (top & 128) != 0 { 1 } else { 0 })
            if (top & 128) != 0 { setT(w, i, if (top & 256) != 0 { R } else { L }) }
            var rtl = c == RLI
            var found = false
            if c == FSI {
                const closing = matchOf(w, i)
                const strong = firstStrong(w, i + 1, if closing != 0 { closing - 1 } else { w.*.limit })
                rtl = strong == 1
                found = strong != 2
            }
            const next = if rtl { nextOdd(level) } else { nextEven(level) }
            var info: u8 = if rtl { ISOLATE_RTL } else { 0 }
            if found { info = info | ISOLATE_FOUND }
            if next <= MAX_EXPLICIT_LEVEL && overflowIsolates == 0 && overflowEmbeddings == 0 {
                validIsolates += 1
                stack[depth] = @intCast(u32, next) | 512
                depth += 1
                info = info | ISOLATE_VALID
            } else {
                overflowIsolates += 1
            }
            m.put8(w.*.info + i, info)
        } else if c == PDI {
            m.put8(w.*.info + i, 0)
            if overflowIsolates > 0 {
                overflowIsolates -= 1
            } else if validIsolates > 0 {
                overflowEmbeddings = 0
                while (stack[depth - 1] & 512) == 0 { depth -= 1 }
                depth -= 1
                validIsolates -= 1
                m.put8(w.*.info + i, ISOLATE_VALID)
            }
            const now = stack[depth - 1]
            m.put8(w.*.lv + i, @intCast(u8, now & 127))
            m.put8(w.*.over + i, if (now & 128) != 0 { 1 } else { 0 })
            if (now & 128) != 0 { setT(w, i, if (now & 256) != 0 { R } else { L }) }
        } else if c == PDF {
            if overflowIsolates == 0 {
                if overflowEmbeddings > 0 {
                    overflowEmbeddings -= 1
                } else if (top & 512) == 0 && depth >= 2 {
                    depth -= 1
                }
            }
            m.put8(w.*.lv + i, level)
        } else if c == B {
            m.put8(w.*.lv + i, w.*.paraLevel)
        } else {
            m.put8(w.*.lv + i, level)
            m.put8(w.*.over + i, if (top & 128) != 0 { 1 } else { 0 })
            if c != BN && (top & 128) != 0 { setT(w, i, if (top & 256) != 0 { R } else { L }) }
        }
        i += 1
    }
}

// The previous index of the isolating run sequence that is not removed
// (positions in the sequence: the sequence holds no removed characters).

// W1-W7 on the sequence of `n` indices, with its sos and eos.
// (`w7sos` is the sos W7 starts from; see resolveSequence.)
fn weakTypes(w: *Work, n: usize, sos: u8, w7sos: u8) -> void {
    // W1: NSM.
    var k: usize = 0
    while k < n {
        const i = seq(w, k)
        if t(w, i) == NSM {
            if k == 0 {
                setT(w, i, sos)
            } else {
                const before = t(w, seq(w, k - 1))
                setT(w, i, if isIsolateInitiator(before) || before == PDI { ON } else { before })
            }
        }
        k += 1
    }
    // W2: EN after AL is AN; W3: AL is R.
    var lastStrong = sos
    k = 0
    while k < n {
        const i = seq(w, k)
        const c = t(w, i)
        if c == L || c == R || c == AL { lastStrong = c }
        if c == EN && lastStrong == AL { setT(w, i, AN) }
        k += 1
    }
    k = 0
    while k < n {
        const i = seq(w, k)
        if t(w, i) == AL { setT(w, i, R) }
        k += 1
    }
    // W4: one ES between ENs, one CS between ENs or ANs.
    k = 1
    while k + 1 < n {
        const i = seq(w, k)
        const c = t(w, i)
        const before = t(w, seq(w, k - 1))
        const after = t(w, seq(w, k + 1))
        if c == ES && before == EN && after == EN { setT(w, i, EN) }
        if c == CS && before == EN && after == EN { setT(w, i, EN) }
        if c == CS && before == AN && after == AN { setT(w, i, AN) }
        k += 1
    }
    // W5: ETs next to EN are EN.
    k = 0
    while k < n {
        if t(w, seq(w, k)) == ET {
            var end = k
            while end < n && t(w, seq(w, end)) == ET { end += 1 }
            const touches = (k > 0 && t(w, seq(w, k - 1)) == EN) || (end < n && t(w, seq(w, end)) == EN)
            if touches {
                var j = k
                while j < end {
                    setT(w, seq(w, j), EN)
                    j += 1
                }
            }
            k = end
        } else {
            k += 1
        }
    }
    // W6: the separators and terminators left are ON.
    k = 0
    while k < n {
        const i = seq(w, k)
        const c = t(w, i)
        if c == ES || c == ET || c == CS { setT(w, i, ON) }
        k += 1
    }
    // W7: EN after L (or an L sos) is L.
    lastStrong = w7sos
    k = 0
    while k < n {
        const i = seq(w, k)
        const c = t(w, i)
        if c == L || c == R { lastStrong = c }
        if c == EN && lastStrong == L { setT(w, i, L) }
        k += 1
    }
}

// The strong direction a type counts as in N0 and N1 (EN and AN as R),
// or 2 for none.
fn strongOf(c: u8) -> u8 {
    if c == L { return L }
    if c == R || c == AL || c == EN || c == AN { return R }
    return 2
}

// A bracket's code point as N0 compares it: U+2329 and U+232A are
// U+3008 and U+3009 (canonically equivalent).
fn bracketKey(c: i32) -> i32 {
    if c == 9001 { return 12296 }
    if c == 9002 { return 12297 }
    return c
}

// The code point at unit `i` of the text (a BMP code point, or the
// supplementary character whose trail is at `i`).
fn codePointAt(w: *Work, i: usize) -> i32 {
    const unit = @intCast(i32, m.get16(w.*.text + i * 2))
    if unit >= 56320 && unit <= 57343 && i > w.*.start {
        const lead = @intCast(i32, m.get16(w.*.text + (i - 1) * 2))
        if lead >= 55296 && lead <= 56319 { return (lead << 10) + unit - 56613888 }
    }
    return unit
}

// N0: the paired brackets of the sequence (BD16), each pair taking the
// embedding direction, or the other one from the context, by the strong
// types inside and before it.
fn brackets(w: *Work, n: usize, sos: u8, level: u8) -> void {
    if w.*.text == 0 { return }
    // BD16: the pairs, as positions in the sequence (opening, closing).
    var openers: [63]u32 = undefined
    var keys: [63]i32 = undefined
    var depth: usize = 0
    var pairs = m.buffer()
    var k: usize = 0
    while k < n {
        const i = seq(w, k)
        if t(w, i) == ON {
            const c = codePointAt(w, i)
            const kind = p.bracketType(c)
            if kind == 1 {
                if depth == BRACKET_STACK { break }
                openers[depth] = @intCast(u32, k)
                keys[depth] = bracketKey(p.u_getBidiPairedBracket(c))
                depth += 1
            } else if kind == 2 {
                const key = bracketKey(c)
                var at = depth
                while at > 0 {
                    if keys[at - 1] == key {
                        m.push(&pairs, openers[at - 1])
                        m.push(&pairs, @intCast(u32, k))
                        depth = at - 1
                        break
                    }
                    at -= 1
                }
            }
        }
        k += 1
    }
    // In the order of the opening brackets.
    const count = pairs.length / 2
    var a: usize = 1
    while a < count {
        var b = a
        while b > 0 && m.at(&pairs, (b - 1) * 2) > m.at(&pairs, b * 2) {
            const open = m.at(&pairs, b * 2)
            const close = m.at(&pairs, b * 2 + 1)
            m.setAt(&pairs, b * 2, m.at(&pairs, (b - 1) * 2))
            m.setAt(&pairs, b * 2 + 1, m.at(&pairs, (b - 1) * 2 + 1))
            m.setAt(&pairs, (b - 1) * 2, open)
            m.setAt(&pairs, (b - 1) * 2 + 1, close)
            b -= 1
        }
        a += 1
    }
    const embedding = if (level & 1) == 0 { L } else { R }
    var pair: usize = 0
    while pair < count {
        const open = @intCast(usize, m.at(&pairs, pair * 2))
        const close = @intCast(usize, m.at(&pairs, pair * 2 + 1))
        var sameFound = false
        var otherFound = false
        var j = open + 1
        while j < close {
            const s = strongOf(t(w, seq(w, j)))
            if s == embedding { sameFound = true }
            if s != 2 && s != embedding { otherFound = true }
            j += 1
        }
        var resolved: u8 = 2
        if sameFound {
            resolved = embedding
        } else if otherFound {
            // The context before the opening bracket.
            var before = sos
            var back = open
            while back > 0 {
                back -= 1
                const s = strongOf(t(w, seq(w, back)))
                if s != 2 {
                    before = s
                    break
                }
            }
            resolved = if before != embedding { before } else { embedding }
        }
        if resolved != 2 {
            setT(w, seq(w, open), resolved)
            setT(w, seq(w, close), resolved)
            // NSMs (as they were before W1) after each bracket take its type.
            var after = open + 1
            while after < n && cls(w, seq(w, after)) == NSM {
                setT(w, seq(w, after), resolved)
                after += 1
            }
            after = close + 1
            while after < n && cls(w, seq(w, after)) == NSM {
                setT(w, seq(w, after), resolved)
                after += 1
            }
        }
        pair += 1
    }
    m.dispose(&pairs)
}

// N1, N2: runs of neutrals take the direction around them when both sides
// agree, else the embedding direction.
fn neutrals(w: *Work, n: usize, sos: u8, eos: u8, level: u8) -> void {
    const embedding = if (level & 1) == 0 { L } else { R }
    var k: usize = 0
    while k < n {
        if !isNeutral(t(w, seq(w, k))) {
            k += 1
            continue
        }
        var end = k
        while end < n && isNeutral(t(w, seq(w, end))) { end += 1 }
        const before = if k == 0 { sos } else { strongOf(t(w, seq(w, k - 1))) }
        const after = if end == n { eos } else { strongOf(t(w, seq(w, end))) }
        const resolved = if before == after && before != 2 { before } else { embedding }
        var j = k
        while j < end {
            setT(w, seq(w, j), resolved)
            j += 1
        }
        k = end
    }
}

// I1, I2.
fn implicitLevels(w: *Work, n: usize) -> void {
    var k: usize = 0
    while k < n {
        const i = seq(w, k)
        const c = t(w, i)
        const level = lv(w, i)
        if (level & 1) == 0 {
            if c == R { m.put8(w.*.lv + i, level + 1) }
            if c == AN || c == EN { m.put8(w.*.lv + i, level + 2) }
        } else if c == L || c == EN || c == AN {
            m.put8(w.*.lv + i, level + 1)
        }
        k += 1
    }
}

// X10: the isolating run sequences of the paragraph, each resolved by the
// rules after it. A level run is a maximal run of characters X9 keeps at
// one level; a sequence chains the level runs an isolate initiator and its
// matching PDI join.
fn resolveSequences(w: *Work) -> void {
    const start = w.*.start
    const limit = w.*.limit
    // Where each kept character's level run starts (marks: 1 a run starts
    // here), in a byte array.
    const runStart = m.alloc(limit - start + 1)
    var previous: i32 = -1
    var i = start
    while i < limit {
        if !isRemoved(cls(w, i)) {
            if previous < 0 || lv(w, @intCast(usize, previous)) != lv(w, i) { m.put8(runStart + (i - start), 1) }
            previous = @intCast(i32, i)
        }
        i += 1
    }
    i = start
    while i < limit {
        // A sequence begins at each level run that does not begin with a
        // PDI matching an initiator.
        if m.get8(runStart + (i - start)) == 1 && !(cls(w, i) == PDI && matchOf(w, i) != 0) {
            var n: usize = 0
            var at = i
            while true {
                // The level run from `at`.
                var j = at
                var last = at
                while j < limit {
                    if !isRemoved(cls(w, j)) {
                        if j > at && m.get8(runStart + (j - start)) == 1 { break }
                        m.put32(w.*.sequence + n * 4, @intCast(u32, j))
                        n += 1
                        last = j
                    }
                    j += 1
                }
                if isIsolateInitiator(cls(w, last)) && matchOf(w, last) != 0 {
                    at = matchOf(w, last) - 1
                } else {
                    break
                }
            }
            resolveSequence(w, n)
        }
        i += 1
    }
    m.release(runStart)
}

// The levels around a sequence for its sos and eos: of the kept
// character before its first (else the paragraph's), and after its last
// (else, or when the last is an isolate initiator, the paragraph's).
fn resolveSequence(w: *Work, n: usize) -> void {
    const first = seq(w, 0)
    const last = seq(w, n - 1)
    const level = explicitLevel(w, first)
    var before = w.*.paraLevel
    var j = first
    while j > w.*.start {
        j -= 1
        if !isRemoved(cls(w, j)) {
            before = explicitLevel(w, j)
            break
        }
    }
    var after = w.*.paraLevel
    if !isIsolateInitiator(cls(w, last)) {
        j = last + 1
        while j < w.*.limit {
            if !isRemoved(cls(w, j)) {
                after = explicitLevel(w, j)
                break
            }
            j += 1
        }
    }
    const sos = if ((if before > level { before } else { level }) & 1) == 0 { L } else { R }
    const eos = if ((if after > level { after } else { level }) & 1) == 0 { L } else { R }
    // ICU's bracket pass (which also makes W7's choice) begins a
    // paragraph after the first, in text without explicit controls or
    // isolates, at the level of the paragraph before it: so do W7 and N0
    // here, as ICU's results have them.
    const bracketLevel = if w.*.carried { w.*.carriedLevel } else { level }
    const bracketSos = if w.*.carried { (if (w.*.carriedLevel & 1) == 0 { L } else { R }) } else { sos }
    weakTypes(w, n, sos, bracketSos)
    brackets(w, n, bracketSos, bracketLevel)
    neutrals(w, n, sos, eos, level)
    implicitLevels(w, n)
}

// ICU's adjustWSLevels (L1 and the levels of what X9 removed), over
// [0, count): from the end, each run of S, B, WS, isolates and removed
// characters before a B or S or the end of the text takes its paragraph's
// level; before that, each removed character takes the level of the
// character after it.
fn adjustLevels(cl: usize, levels: usize, count: usize, paraLevelOf: usize, orderLTR: bool) -> void {
    var i = count
    while i > 0 {
        while i > 0 && isTrailing(m.get8(cl + i - 1)) {
            i -= 1
            m.put8(levels + i, if orderLTR && m.get8(cl + i) == B { 0 } else { m.get8(paraLevelOf + i) })
        }
        while i > 0 {
            i -= 1
            const c = m.get8(cl + i)
            if isRemoved(c) {
                m.put8(levels + i, m.get8(levels + i + 1))
            } else if c == B || c == S {
                m.put8(levels + i, if orderLTR && c == B { 0 } else { m.get8(paraLevelOf + i) })
                break
            }
        }
    }
}

// ICU's direction of the text by what it holds (directionFromFlags,
// over flags of classes ICU gathers twice: of the text's classes, then
// of what its explicit levels make of them): LTR when nothing is
// right-to-left (and no AN with neutrals that could become so), RTL
// when nothing is left-to-right, else mixed. ICU resolves the levels
// only of mixed text; the rest is at its paragraphs' levels.
const MASK_LTR: u32 = 1 | 4 | 32 | 2048 | 4096 | 1048576
const MASK_RTL: u32 = 2 | 8192 | 16384 | 32768 | 2097152
const MASK_EXPLICIT_ISO: u32 = 2048 | 4096 | 16384 | 32768 | 65536 | 524288 | 1048576 | 2097152 | 4194304
const MASK_POSSIBLE_N: u32 = 1024 | 64 | 8 | 16 | 128 | 256 | 512 | 262144 | 2048 | 4096 | 16384 | 32768 | 65536 | 524288 | 1048576 | 2097152 | 4194304
const MASK_EMBEDDING: u32 = MASK_POSSIBLE_N | 131072

fn directionOf(flags: u32) -> i32 {
    if !((flags & MASK_RTL) != 0 || ((flags & bit(AN)) != 0 && (flags & MASK_POSSIBLE_N) != 0)) { return DIRECTION_LTR }
    if (flags & MASK_LTR) == 0 { return DIRECTION_RTL }
    return DIRECTION_MIXED
}

fn flagLR(level: u8) -> u32 { return if (level & 1) == 0 { bit(L) } else { bit(R) } }

// What explicitLevels says of an isolate initiator (and a PDI): it took
// effect (not an overflow; for a PDI, it closed one), and for an FSI that
// it is right-to-left.
const ISOLATE_VALID: u8 = 1
const ISOLATE_RTL: u8 = 2
// (An FSI whose direction a strong character decided.)
const ISOLATE_FOUND: u8 = 4

// ICU's first flags for [start, limit): the classes, and an FSI also as
// the isolate it resolves to where ICU's first pass resolves it: by a
// strong character, by its PDI, or at the end of the text (not at the end
// of a paragraph before it).
fn classFlags(w: *Work) -> u32 {
    var flags: u32 = flagLR(w.*.paraLevel)
    var i = w.*.start
    while i < w.*.limit {
        const c = cls(w, i)
        flags = flags | bit(c)
        if c == FSI {
            const info = m.get8(w.*.info + i)
            if (info & ISOLATE_FOUND) != 0 {
                flags = flags | (if (info & ISOLATE_RTL) != 0 { bit(RLI) } else { bit(LRI) })
            } else if matchOf(w, i) != 0 || w.*.limit == w.*.count {
                flags = flags | bit(LRI)
            }
        }
        i += 1
    }
    return flags
}

// ICU's second flags (resolveExplicitLevels) for [start, limit): BN for
// what X9 removes; ON and the direction of the level for isolates and
// PDIs, and their own class when they took effect; for the others an
// embedding (or override) flag where the level is not the one before,
// and their class, or under an override the override's direction (but
// for S, WS and ON).
fn explicitFlags(w: *Work) -> u32 {
    var flags: u32 = 0
    var previous = w.*.paraLevel
    var i = w.*.start
    while i < w.*.limit {
        const c = cls(w, i)
        const level = explicitLevel(w, i)
        const over = m.get8(w.*.over + i) != 0
        if isRemoved(c) {
            flags = flags | bit(BN)
        } else if isIsolateInitiator(c) {
            flags = flags | bit(ON) | flagLR(level)
            previous = level
            const info = m.get8(w.*.info + i)
            if (info & ISOLATE_VALID) != 0 { flags = flags | (if c == RLI || (info & ISOLATE_RTL) != 0 { bit(RLI) } else { bit(LRI) }) }
        } else if c == PDI {
            flags = flags | bit(ON) | flagLR(level)
            if (m.get8(w.*.info + i) & ISOLATE_VALID) != 0 { flags = flags | bit(PDI) }
            previous = level
        } else if c == B {
            flags = flags | bit(B)
        } else {
            if level != previous {
                if over {
                    flags = flags | (if (level & 1) == 0 { bit(LRO) } else { bit(RLO) })
                } else {
                    flags = flags | (if (level & 1) == 0 { bit(LRE) } else { bit(RLE) })
                }
            }
            previous = level
            if over && c != S && c != WS && c != ON {
                flags = flags | flagLR(level)
            } else {
                flags = flags | bit(c)
            }
        }
        i += 1
    }
    return flags
}

// The classes of the text's units: by the class callback or the UCD; a
// supplementary character's lead surrogate is BN, its trail its class.
fn classify(b: usize, text: usize, count: usize, cl: usize) -> void {
    var i: usize = 0
    while i < count {
        const unit = @intCast(i32, m.get16(text + i * 2))
        if unit >= 55296 && unit <= 56319 && i + 1 < count {
            const trail = @intCast(i32, m.get16(text + (i + 1) * 2))
            if trail >= 56320 && trail <= 57343 {
                m.put8(cl + i, BN)
                m.put8(cl + i + 1, @intCast(u8, ubidi_getCustomizedClass(b, (unit << 10) + trail - 56613888)))
                i += 2
                continue
            }
        }
        m.put8(cl + i, @intCast(u8, ubidi_getCustomizedClass(b, unit)))
        i += 1
    }
}

pub fn ubidi_setPara(b: usize, text: usize, textLength: i32, paraLevel: u8, embeddingLevels: usize, status: usize) -> void {
    if m.failed(status) { return }
    if b == 0 || text == 0 || textLength < -1 || (paraLevel > MAX_EXPLICIT_LEVEL && paraLevel < DEFAULT_LTR) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    const count = m.units(text, textLength)
    releaseArrays(b)
    m.putWord(b + O_TEXT, text)
    m.putWord(b + O_LENGTH, count)
    m.put8(b + O_REQUESTED, paraLevel)
    m.put8(b + O_IS_LINE, 0)
    m.putI32(b + O_RUN_COUNT, -1)
    if count == 0 {
        // Empty text: no paragraph, no run, the level asked for (a
        // default one's direction).
        const level = if paraLevel >= DEFAULT_LTR { paraLevel & 1 } else { paraLevel }
        m.put8(b + O_PARA_LEVEL, level)
        m.putI32(b + O_DIRECTION, @intCast(i32, level & 1))
        m.putWord(b + O_LEVELS, m.alloc(1))
        m.putWord(b + O_CLASSES, m.alloc(1))
        m.putWord(b + O_PARAS, m.alloc(8))
        m.putWord(b + O_PARA_COUNT, 0)
        m.put8(b + O_SET, 1)
        return
    }
    const cl = m.alloc(count)
    const levels = m.alloc(count)
    const work = m.alloc(count)
    const explicit = m.alloc(count)
    const overridden = m.alloc(count)
    const info = m.alloc(count)
    const paraOf = m.alloc(count)
    const pairing = m.alloc(count * 4)
    const sequence = m.alloc(count * 4)
    var paras = m.buffer()
    if cl == 0 || levels == 0 || work == 0 || explicit == 0 || overridden == 0 || info == 0 || paraOf == 0 || pairing == 0 || sequence == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return
    }
    classify(b, text, count, cl)
    var w = Work.{ .text = text, .cls = cl, .t = work, .lv = levels, .pairing = pairing, .over = overridden, .explicit = explicit, .info = info, .count = count, .carried = false, .carriedLevel = 0, .sequence = sequence, .start = 0, .limit = 0, .paraLevel = 0 }
    var controls = false
    var i: usize = 0
    while i < count {
        m.put8(work + i, m.get8(cl + i))
        if (bit(m.get8(cl + i)) & MASK_EXPLICIT_ISO) != 0 { controls = true }
        i += 1
    }
    var classFlagsAll: u32 = 0
    var explicitFlagsAll: u32 = 0
    var firstLevel: u8 = 0
    var start: usize = 0
    while start < count {
        // P1: the paragraph ends after a B (CR LF together).
        var limit = start
        while limit < count {
            const c = m.get8(cl + limit)
            limit += 1
            if c == B {
                if m.get16(text + (limit - 1) * 2) == 13 && limit < count && m.get16(text + limit * 2) == 10 { limit += 1 }
                break
            }
        }
        w.start = start
        w.limit = limit
        matchIsolates(&w)
        var level = paraLevel
        if paraLevel >= DEFAULT_LTR {
            const strong = firstStrong(&w, start, limit)
            level = if strong == 2 { paraLevel & 1 } else { strong }
        }
        w.carried = start > 0 && !controls && embeddingLevels == 0
        w.carriedLevel = w.paraLevel
        w.paraLevel = level
        if start == 0 { firstLevel = level }
        m.push(&paras, @intCast(u32, limit))
        m.push(&paras, @intCast(u32, level))
        i = start
        while i < limit {
            m.put8(paraOf + i, level)
            i += 1
        }
        if embeddingLevels != 0 {
            // The levels given: a level (and the override bit) a unit; the
            // embedding controls are BN.
            i = start
            while i < limit {
                const given = m.get8(embeddingLevels + i)
                var value = given & 127
                if value < level { value = level }
                m.put8(levels + i, if m.get8(cl + i) == B { level } else { value })
                if isRemoved(m.get8(cl + i)) { m.put8(cl + i, BN) }
                if (given & LEVEL_OVERRIDE) != 0 && !isRemoved(m.get8(cl + i)) {
                    m.put8(work + i, if (value & 1) == 0 { L } else { R })
                    m.put8(overridden + i, 1)
                }
                i += 1
            }
        } else {
            explicitLevels(&w)
        }
        i = start
        while i < limit {
            m.put8(explicit + i, m.get8(levels + i))
            i += 1
        }
        classFlagsAll = classFlagsAll | classFlags(&w)
        explicitFlagsAll = explicitFlagsAll | explicitFlags(&w)
        resolveSequences(&w)
        start = limit
    }
    const orderLTR = m.get8(b + O_ORDER_LTR) != 0
    adjustLevels(cl, levels, count, paraOf, orderLTR)
    // ICU's direction: of the classes; if mixed, and the text has
    // explicit controls, of what the explicit levels make of them.
    if orderLTR && (classFlagsAll & bit(B)) != 0 { classFlagsAll = classFlagsAll | bit(L) }
    var direction = directionOf(classFlagsAll)
    if direction == DIRECTION_MIXED && embeddingLevels == 0 && (classFlagsAll & MASK_EXPLICIT_ISO) != 0 {
        if (explicitFlagsAll & MASK_EMBEDDING) != 0 { explicitFlagsAll = explicitFlagsAll | flagLR(firstLevel) }
        if orderLTR && (explicitFlagsAll & bit(B)) != 0 { explicitFlagsAll = explicitFlagsAll | bit(L) }
        direction = directionOf(explicitFlagsAll)
    }
    // Text of one direction is at its paragraphs' levels: ubidi_getLevels
    // has them all at the first paragraph's (ICU's single run),
    // ubidi_getLevelAt each at its own.
    if direction != DIRECTION_MIXED {
        i = 0
        while i < count {
            m.put8(levels + i, firstLevel)
            i += 1
        }
    }
    m.putI32(b + O_DIRECTION, direction)
    m.put8(b + O_PARA_LEVEL, firstLevel)
    m.putWord(b + O_LEVELS, levels)
    m.putWord(b + O_CLASSES, cl)
    m.putWord(b + O_PARAS, paras.address)
    m.putWord(b + O_PARA_COUNT, paras.length / 2)
    m.put8(b + O_SET, 1)
    m.release(work)
    m.release(explicit)
    m.release(overridden)
    m.release(info)
    m.release(paraOf)
    m.release(pairing)
    m.release(sequence)
}

// A line of a paragraph object: [start, limit) of its text, levels and
// classes, with L1 at its own end (ICU's setTrailingWSStart: the
// trailing whitespace, isolates and removed characters, unless the line
// ends with a B, at the paragraph level, and so is the run before them
// that is already at it).
pub fn ubidi_setLine(para: usize, start: i32, limit: i32, line: usize, status: usize) -> void {
    if m.failed(status) { return }
    if para == 0 || line == 0 || m.get8(para + O_SET) == 0 || m.get8(para + O_IS_LINE) != 0 {
        m.setError(status, m.INVALID_STATE_ERROR)
        return
    }
    if start < 0 || limit <= start || @intCast(usize, limit) > length(para) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    const from = @intCast(usize, start)
    const to = @intCast(usize, limit)
    if paragraphIndex(para, from) != paragraphIndex(para, to - 1) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    const count = to - from
    releaseArrays(line)
    const levels = m.alloc(count)
    const cl = m.alloc(count)
    const paras = m.alloc(8)
    m.copy(levels, m.getWord(para + O_LEVELS) + from, count)
    m.copy(cl, m.getWord(para + O_CLASSES) + from, count)
    const level = paragraphLevel(para, from)
    m.put32(paras, @intCast(u32, count))
    m.put32(paras + 4, @intCast(u32, level))
    var direction = m.getI32(para + O_DIRECTION)
    if direction == DIRECTION_MIXED && m.get8(cl + count - 1) != B {
        var trailing = count
        while trailing > 0 && isTrailing(m.get8(cl + trailing - 1)) { trailing -= 1 }
        while trailing > 0 && m.get8(levels + trailing - 1) == level { trailing -= 1 }
        var i = trailing
        while i < count {
            m.put8(levels + i, level)
            i += 1
        }
    }
    var lineLevel = level
    if direction == DIRECTION_MIXED {
        // The line's own: one direction when its levels' parities agree;
        // then, as ICU's, its paragraph level is made of that parity (the
        // next even level, or odd) and all its levels are it.
        const first = m.get8(levels) & 1
        var same = true
        var i: usize = 0
        while i < count {
            if (m.get8(levels + i) & 1) != first { same = false }
            i += 1
        }
        if same {
            direction = @intCast(i32, first)
            lineLevel = if first == 0 { (level + 1) & 254 } else { level | 1 }
            i = 0
            while i < count {
                m.put8(levels + i, lineLevel)
                i += 1
            }
            m.put32(paras + 4, @intCast(u32, lineLevel))
        }
    }
    m.copy(line + O_INVERSE, para + O_INVERSE, O_SIZE - O_INVERSE)
    m.putWord(line + O_TEXT, m.getWord(para + O_TEXT) + from * 2)
    m.putWord(line + O_LENGTH, count)
    m.put8(line + O_REQUESTED, m.get8(para + O_REQUESTED))
    m.put8(line + O_PARA_LEVEL, lineLevel)
    m.putI32(line + O_DIRECTION, direction)
    m.putWord(line + O_LEVELS, levels)
    m.putWord(line + O_CLASSES, cl)
    m.putWord(line + O_PARAS, paras)
    m.putWord(line + O_PARA_COUNT, 1)
    m.putWord(line + O_RUNS, 0)
    m.putI32(line + O_RUN_COUNT, -1)
    m.put8(line + O_SET, 1)
    m.put8(line + O_IS_LINE, 1)
}

// ---------------------------------------------------------------------------
// What a paragraph object answers

fn ready(b: usize, status: usize) -> bool {
    if m.failed(status) { return false }
    if b == 0 || m.get8(b + O_SET) == 0 {
        m.setError(status, m.INVALID_STATE_ERROR)
        return false
    }
    return true
}

fn paragraphLimit(b: usize, k: usize) -> usize { return @intCast(usize, m.get32(m.getWord(b + O_PARAS) + k * 8)) }

fn paragraphLevel(b: usize, i: usize) -> u8 { return @intCast(u8, m.get32(m.getWord(b + O_PARAS) + paragraphIndex(b, i) * 8 + 4)) }

fn paragraphIndex(b: usize, i: usize) -> usize {
    const count = m.getWord(b + O_PARA_COUNT)
    var k: usize = 0
    while k + 1 < count && paragraphLimit(b, k) <= i { k += 1 }
    return k
}

pub fn ubidi_getDirection(b: usize) -> i32 {
    if b == 0 || m.get8(b + O_SET) == 0 { return DIRECTION_LTR }
    return m.getI32(b + O_DIRECTION)
}

// The direction of the first strong character (no isolates skipped, as
// ICU's).
pub fn ubidi_getBaseDirection(text: usize, textLength: i32) -> i32 {
    if text == 0 || textLength < -1 { return DIRECTION_NEUTRAL }
    const count = m.units(text, textLength)
    var i: usize = 0
    while i < count {
        var c = @intCast(i32, m.get16(text + i * 2))
        i += 1
        if c >= 55296 && c <= 56319 && i < count {
            const trail = @intCast(i32, m.get16(text + i * 2))
            if trail >= 56320 && trail <= 57343 {
                c = (c << 10) + trail - 56613888
                i += 1
            }
        }
        const d = p.u_charDirection(c)
        if d == 0 { return DIRECTION_LTR }
        if d == 1 || d == 13 { return DIRECTION_RTL }
    }
    return DIRECTION_NEUTRAL
}

pub fn ubidi_getText(b: usize) -> usize { return if b != 0 && m.get8(b + O_SET) != 0 { m.getWord(b + O_TEXT) } else { 0 } }
pub fn ubidi_getLength(b: usize) -> i32 { return if b != 0 && m.get8(b + O_SET) != 0 { @intCast(i32, length(b)) } else { 0 } }
pub fn ubidi_getProcessedLength(b: usize) -> i32 { return ubidi_getLength(b) }

pub fn ubidi_getResultLength(b: usize, status: usize) -> i32 {
    if !ready(b, status) { return 0 }
    if (m.get32(b + O_OPTIONS) & OPTION_REMOVE_CONTROLS) == 0 { return @intCast(i32, length(b)) }
    var count: usize = 0
    var i: usize = 0
    while i < length(b) {
        if !isBidiControl(@intCast(i32, m.get16(m.getWord(b + O_TEXT) + i * 2))) { count += 1 }
        i += 1
    }
    return @intCast(i32, count)
}

pub fn ubidi_getParaLevel(b: usize) -> u8 { return if b != 0 && m.get8(b + O_SET) != 0 { m.get8(b + O_PARA_LEVEL) } else { 0 } }

pub fn ubidi_countParagraphs(b: usize) -> i32 { return if b != 0 && m.get8(b + O_SET) != 0 { @intCast(i32, m.getWord(b + O_PARA_COUNT)) } else { 0 } }

pub fn ubidi_getParagraphByIndex(b: usize, paraIndex: i32, paraStart: usize, paraLimit: usize, paraLevel: usize, status: usize) -> void {
    if !ready(b, status) { return }
    if paraIndex < 0 || @intCast(usize, paraIndex) >= m.getWord(b + O_PARA_COUNT) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    const k = @intCast(usize, paraIndex)
    if paraStart != 0 { m.putI32(paraStart, if k == 0 { 0 } else { @intCast(i32, paragraphLimit(b, k - 1)) }) }
    if paraLimit != 0 { m.putI32(paraLimit, @intCast(i32, paragraphLimit(b, k))) }
    if paraLevel != 0 { m.put8(paraLevel, @intCast(u8, m.get32(m.getWord(b + O_PARAS) + k * 8 + 4))) }
}

pub fn ubidi_getParagraph(b: usize, charIndex: i32, paraStart: usize, paraLimit: usize, paraLevel: usize, status: usize) -> i32 {
    if !ready(b, status) { return -1 }
    if charIndex < 0 || @intCast(usize, charIndex) >= length(b) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return -1
    }
    const k = paragraphIndex(b, @intCast(usize, charIndex))
    ubidi_getParagraphByIndex(b, @intCast(i32, k), paraStart, paraLimit, paraLevel, status)
    return @intCast(i32, k)
}

// A level as ubidi_getLevelAt answers it: in text of one direction, the
// paragraph's.
fn reportedLevel(b: usize, i: usize) -> u8 {
    if m.getI32(b + O_DIRECTION) != DIRECTION_MIXED { return paragraphLevel(b, i) }
    return levelAt(b, i)
}

pub fn ubidi_getLevelAt(b: usize, charIndex: i32) -> u8 {
    if b == 0 || m.get8(b + O_SET) == 0 || charIndex < 0 || @intCast(usize, charIndex) >= length(b) { return 0 }
    return reportedLevel(b, @intCast(usize, charIndex))
}

pub fn ubidi_getLevels(b: usize, status: usize) -> usize {
    if !ready(b, status) { return 0 }
    if length(b) == 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    return m.getWord(b + O_LEVELS)
}

// ---------------------------------------------------------------------------
// Runs and maps (L2)

// L2 on `count` levels: `order` (u32 each) the logical index of each
// visual position.
fn reorder(levels: usize, count: usize, order: usize) -> void {
    var highest: u8 = 0
    var lowestOdd: u8 = 255
    var i: usize = 0
    while i < count {
        const level = m.get8(levels + i)
        m.put32(order + i * 4, @intCast(u32, i))
        if level > highest { highest = level }
        if (level & 1) != 0 && level < lowestOdd { lowestOdd = level }
        i += 1
    }
    var level = highest
    while level >= lowestOdd && level > 0 {
        i = 0
        while i < count {
            if m.get8(levels + @intCast(usize, m.get32(order + i * 4))) >= level {
                // (The levels are read through the order: the runs at this
                // level are reversed in place.)
                var end = i
                while end < count && m.get8(levels + @intCast(usize, m.get32(order + end * 4))) >= level { end += 1 }
                var a = i
                var z = end - 1
                while a < z {
                    const keep = m.get32(order + a * 4)
                    m.put32(order + a * 4, m.get32(order + z * 4))
                    m.put32(order + z * 4, keep)
                    a += 1
                    z -= 1
                }
                i = end
            } else {
                i += 1
            }
        }
        level -= 1
    }
}

// The runs: each maximal run of one level, in visual order (L2 on the
// runs), as ICU's getRuns makes them; one run when the text has one
// direction.
fn ensureRuns(b: usize) -> void {
    if m.getI32(b + O_RUN_COUNT) >= 0 { return }
    const count = length(b)
    var starts = m.buffer()
    var i: usize = 0
    while i < count {
        if i == 0 || (m.getI32(b + O_DIRECTION) == DIRECTION_MIXED && levelAt(b, i) != levelAt(b, i - 1)) { m.push(&starts, @intCast(u32, i)) }
        i += 1
    }
    const runCount = starts.length
    const runLevels = m.alloc(runCount + 1)
    const order = m.alloc(runCount * 4 + 4)
    var k: usize = 0
    while k < runCount {
        m.put8(runLevels + k, levelAt(b, @intCast(usize, m.at(&starts, k))))
        k += 1
    }
    reorder(runLevels, runCount, order)
    const runs = m.alloc(runCount * 16 + 16)
    var visualLimit: usize = 0
    k = 0
    while k < runCount {
        const logical = @intCast(usize, m.get32(order + k * 4))
        const runStart = @intCast(usize, m.at(&starts, logical))
        const runEnd = if logical + 1 < runCount { @intCast(usize, m.at(&starts, logical + 1)) } else { count }
        visualLimit += runEnd - runStart
        m.put32(runs + k * 16, @intCast(u32, runStart))
        m.put32(runs + k * 16 + 4, @intCast(u32, visualLimit))
        m.put32(runs + k * 16 + 8, @intCast(u32, m.get8(runLevels + logical)))
        k += 1
    }
    m.release(runLevels)
    m.release(order)
    m.dispose(&starts)
    m.release(m.getWord(b + O_RUNS))
    m.putWord(b + O_RUNS, runs)
    m.putI32(b + O_RUN_COUNT, @intCast(i32, runCount))
}

fn runStart(b: usize, k: usize) -> usize { return @intCast(usize, m.get32(m.getWord(b + O_RUNS) + k * 16)) }
fn runVisualLimit(b: usize, k: usize) -> usize { return @intCast(usize, m.get32(m.getWord(b + O_RUNS) + k * 16 + 4)) }
fn runLevel(b: usize, k: usize) -> u8 { return @intCast(u8, m.get32(m.getWord(b + O_RUNS) + k * 16 + 8)) }
fn runLength(b: usize, k: usize) -> usize { return runVisualLimit(b, k) - (if k == 0 { 0 } else { runVisualLimit(b, k - 1) }) }

pub fn ubidi_countRuns(b: usize, status: usize) -> i32 {
    if !ready(b, status) { return -1 }
    ensureRuns(b)
    return m.getI32(b + O_RUN_COUNT)
}

pub fn ubidi_getVisualRun(b: usize, runIndex: i32, logicalStart: usize, runLengthOut: usize) -> i32 {
    if b == 0 || m.get8(b + O_SET) == 0 { return DIRECTION_LTR }
    ensureRuns(b)
    if runIndex < 0 || runIndex >= m.getI32(b + O_RUN_COUNT) { return DIRECTION_LTR }
    const k = @intCast(usize, runIndex)
    if logicalStart != 0 { m.putI32(logicalStart, @intCast(i32, runStart(b, k))) }
    if runLengthOut != 0 { m.putI32(runLengthOut, @intCast(i32, runLength(b, k))) }
    return if (runLevel(b, k) & 1) == 0 { DIRECTION_LTR } else { DIRECTION_RTL }
}

pub fn ubidi_getLogicalRun(b: usize, logicalPosition: i32, logicalLimit: usize, level: usize) -> void {
    if b == 0 || m.get8(b + O_SET) == 0 || logicalPosition < 0 || @intCast(usize, logicalPosition) >= length(b) { return }
    ensureRuns(b)
    const position = @intCast(usize, logicalPosition)
    const count = @intCast(usize, m.getI32(b + O_RUN_COUNT))
    var k: usize = 0
    while k < count {
        const first = runStart(b, k)
        if position >= first && position < first + runLength(b, k) {
            if logicalLimit != 0 { m.putI32(logicalLimit, @intCast(i32, first + runLength(b, k))) }
            if level != 0 { m.put8(level, reportedLevel(b, position)) }
            return
        }
        k += 1
    }
}

// The visual position of each logical index (u32 each, into `map`).
fn logicalToVisual(b: usize, map: usize) -> void {
    ensureRuns(b)
    const count = @intCast(usize, m.getI32(b + O_RUN_COUNT))
    var visual: usize = 0
    var k: usize = 0
    while k < count {
        const first = runStart(b, k)
        const n = runLength(b, k)
        const rtl = (runLevel(b, k) & 1) != 0
        var j: usize = 0
        while j < n {
            const logical = if rtl { first + n - 1 - j } else { first + j }
            m.putI32(map + logical * 4, @intCast(i32, visual))
            visual += 1
            j += 1
        }
        k += 1
    }
}

pub fn ubidi_getLogicalMap(b: usize, indexMap: usize, status: usize) -> void {
    if !ready(b, status) { return }
    if indexMap == 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    logicalToVisual(b, indexMap)
}

pub fn ubidi_getVisualMap(b: usize, indexMap: usize, status: usize) -> void {
    if !ready(b, status) { return }
    if indexMap == 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    ensureRuns(b)
    const count = @intCast(usize, m.getI32(b + O_RUN_COUNT))
    var visual: usize = 0
    var k: usize = 0
    while k < count {
        const first = runStart(b, k)
        const n = runLength(b, k)
        const rtl = (runLevel(b, k) & 1) != 0
        var j: usize = 0
        while j < n {
            m.putI32(indexMap + visual * 4, @intCast(i32, if rtl { first + n - 1 - j } else { first + j }))
            visual += 1
            j += 1
        }
        k += 1
    }
}

pub fn ubidi_getVisualIndex(b: usize, logicalIndex: i32, status: usize) -> i32 {
    if !ready(b, status) { return -1 }
    if logicalIndex < 0 || @intCast(usize, logicalIndex) >= length(b) {
        m.setError(status, m.INDEX_OUTOFBOUNDS_ERROR)
        return -1
    }
    const map = m.alloc(length(b) * 4)
    logicalToVisual(b, map)
    const result = m.getI32(map + @intCast(usize, logicalIndex) * 4)
    m.release(map)
    return result
}

pub fn ubidi_getLogicalIndex(b: usize, visualIndex: i32, status: usize) -> i32 {
    if !ready(b, status) { return -1 }
    if visualIndex < 0 || @intCast(usize, visualIndex) >= length(b) {
        m.setError(status, m.INDEX_OUTOFBOUNDS_ERROR)
        return -1
    }
    const map = m.alloc(length(b) * 4)
    ubidi_getVisualMap(b, map, status)
    const result = m.getI32(map + @intCast(usize, visualIndex) * 4)
    m.release(map)
    return result
}

// Levels a caller gives (ubidi_reorderLogical, ubidi_reorderVisual) are
// taken only when none is above 126, as ICU's.
fn validLevels(levels: usize, count: usize) -> bool {
    var i: usize = 0
    while i < count {
        if m.get8(levels + i) > MAX_EXPLICIT_LEVEL + 1 { return false }
        i += 1
    }
    return true
}

pub fn ubidi_reorderVisual(levels: usize, count: i32, indexMap: usize) -> void {
    if levels == 0 || indexMap == 0 || count <= 0 || !validLevels(levels, @intCast(usize, count)) { return }
    const order = m.alloc(@intCast(usize, count) * 4)
    reorder(levels, @intCast(usize, count), order)
    m.copy(indexMap, order, @intCast(usize, count) * 4)
    m.release(order)
}

pub fn ubidi_reorderLogical(levels: usize, count: i32, indexMap: usize) -> void {
    if levels == 0 || indexMap == 0 || count <= 0 || !validLevels(levels, @intCast(usize, count)) { return }
    const n = @intCast(usize, count)
    const order = m.alloc(n * 4)
    reorder(levels, n, order)
    var visual: usize = 0
    while visual < n {
        m.putI32(indexMap + @intCast(usize, m.get32(order + visual * 4)) * 4, @intCast(i32, visual))
        visual += 1
    }
    m.release(order)
}

pub fn ubidi_invertMap(srcMap: usize, destMap: usize, count: i32) -> void {
    if srcMap == 0 || destMap == 0 || count <= 0 { return }
    const n = @intCast(usize, count)
    var destLength: i32 = -1
    var i: usize = 0
    while i < n {
        if m.getI32(srcMap + i * 4) > destLength { destLength = m.getI32(srcMap + i * 4) }
        i += 1
    }
    destLength += 1
    i = 0
    while i < @intCast(usize, destLength) {
        m.putI32(destMap + i * 4, MAP_NOWHERE)
        i += 1
    }
    i = 0
    while i < n {
        const target = m.getI32(srcMap + i * 4)
        if target >= 0 { m.putI32(destMap + @intCast(usize, target) * 4, @intCast(i32, i)) }
        i += 1
    }
}

// ---------------------------------------------------------------------------
// Writing the text in visual order

// ICU's IS_BIDI_CONTROL_CHAR: ZWNJ, ZWJ, LRM, RLM, the embedding and
// override controls and the isolates.
fn isBidiControl(c: i32) -> bool { return (c >= 8204 && c <= 8207) || (c >= 8234 && c <= 8238) || (c >= 8294 && c <= 8297) }

fn isCombining(c: i32) -> bool {
    const category = p.category(c)
    return category == 6 || category == 7 || category == 8
}

// The code point at unit `i` of `units` and how many units it takes.
fn readAt(text: usize, i: usize, count: usize) -> u64 {
    const unit = @intCast(i32, m.get16(text + i * 2))
    if unit >= 55296 && unit <= 56319 && i + 1 < count {
        const trail = @intCast(i32, m.get16(text + (i + 1) * 2))
        if trail >= 56320 && trail <= 57343 { return (@intCast(u64, @bitCast(u32, (unit << 10) + trail - 56613888)) << 8) | 2 }
    }
    return (@intCast(u64, @bitCast(u32, unit)) << 8) | 1
}

fn writeUnit(dest: usize, capacity: usize, at: *usize, unit: u32) -> void {
    if at.* < capacity { m.put16(dest + at.* * 2, @intCast(u16, unit)) }
    at.* += 1
}

fn writeCodePoint(dest: usize, capacity: usize, at: *usize, c: i32) -> void {
    if c < 65536 {
        writeUnit(dest, capacity, at, @intCast(u32, c))
    } else {
        writeUnit(dest, capacity, at, @intCast(u32, (c >> 10) + 55232))
        writeUnit(dest, capacity, at, @intCast(u32, (c & 1023) | 56320))
    }
}

// ICU's doWriteForward: the text as it is, mirrored, without the bidi
// controls, as the options say.
fn writeForward(text: usize, count: usize, dest: usize, capacity: usize, at: *usize, options: u32) -> void {
    var i: usize = 0
    while i < count {
        const read = readAt(text, i, count)
        const c = @bitCast(i32, @intCast(u32, read >> 8))
        i += @intCast(usize, read & 255)
        if (options & REMOVE_BIDI_CONTROLS) != 0 && isBidiControl(c) { continue }
        writeCodePoint(dest, capacity, at, if (options & DO_MIRRORING) != 0 { p.u_charMirror(c) } else { c })
    }
}

// ICU's doWriteReverse: the code points backwards, a base character
// with the combining marks after it kept together when the options say.
fn writeReverse(text: usize, count: usize, dest: usize, capacity: usize, at: *usize, options: u32) -> void {
    var end = count
    while end > 0 {
        // The code point (or cluster) ending at `end`.
        var start = end - 1
        if start > 0 {
            const unit = m.get16(text + start * 2)
            const before = m.get16(text + (start - 1) * 2)
            if unit >= 56320 && unit <= 57343 && before >= 55296 && before <= 56319 { start -= 1 }
        }
        if (options & KEEP_BASE_COMBINING) != 0 {
            while start > 0 && isCombining(@bitCast(i32, @intCast(u32, readAt(text, start, count) >> 8))) {
                start -= 1
                if start > 0 {
                    const unit = m.get16(text + start * 2)
                    const before = m.get16(text + (start - 1) * 2)
                    if unit >= 56320 && unit <= 57343 && before >= 55296 && before <= 56319 { start -= 1 }
                }
            }
        }
        var i = start
        var first = true
        while i < end {
            const read = readAt(text, i, end)
            var c = @bitCast(i32, @intCast(u32, read >> 8))
            i += @intCast(usize, read & 255)
            if (options & REMOVE_BIDI_CONTROLS) != 0 && isBidiControl(c) { continue }
            // (Only the base character is mirrored.)
            if first && (options & DO_MIRRORING) != 0 { c = p.u_charMirror(c) }
            first = false
            writeCodePoint(dest, capacity, at, c)
        }
        end = start
    }
}

pub fn ubidi_writeReverse(src: usize, srcLength: i32, dest: usize, destSize: i32, options: u16, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    if src == 0 || srcLength < -1 || destSize < 0 || (destSize > 0 && dest == 0) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const count = m.units(src, srcLength)
    var at: usize = 0
    writeReverse(src, count, dest, @intCast(usize, destSize), &at, @intCast(u32, options))
    return m.terminate(dest, at, destSize, status)
}

pub fn ubidi_writeReordered(b: usize, dest: usize, destSize: i32, options: u16, status: usize) -> i32 {
    if !ready(b, status) { return 0 }
    if destSize < 0 || (destSize > 0 && dest == 0) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    var flags = @intCast(u32, options)
    if (m.get32(b + O_OPTIONS) & OPTION_REMOVE_CONTROLS) != 0 { flags = (flags | REMOVE_BIDI_CONTROLS) & ~INSERT_LRM_FOR_NUMERIC }
    ensureRuns(b)
    const text = m.getWord(b + O_TEXT)
    const count = @intCast(usize, m.getI32(b + O_RUN_COUNT))
    const capacity = @intCast(usize, destSize)
    var at: usize = 0
    var k: usize = 0
    while k < count {
        const run = if (flags & OUTPUT_REVERSE) != 0 { count - 1 - k } else { k }
        const first = runStart(b, run)
        const n = runLength(b, run)
        const ltr = (runLevel(b, run) & 1) == 0
        if ltr == ((flags & OUTPUT_REVERSE) == 0) {
            if ltr {
                writeForward(text + first * 2, n, dest, capacity, &at, flags & ~DO_MIRRORING)
            } else {
                writeForward(text + first * 2, n, dest, capacity, &at, flags)
            }
        } else if ltr {
            writeReverse(text + first * 2, n, dest, capacity, &at, flags & ~DO_MIRRORING)
        } else {
            writeReverse(text + first * 2, n, dest, capacity, &at, flags)
        }
        k += 1
    }
    return m.terminate(dest, at, destSize, status)
}

// ---------------------------------------------------------------------------
// The native API

pub const Direction = enum(u8) { ltr, rtl, mixed, neutral }

// The direction of the first strong character of UTF-8 text (L: ltr; R
// or AL: rtl), neutral when it has none.
pub fn baseDirection(text: []const u8) -> Direction {
    var at: usize = 0
    while at < text.length {
        const next = utf.decode8(text, at)
        at += next.length
        const d = p.bidiClass(@intCast(i32, next.codepoint))
        if d == 0 { return Direction.ltr }
        if d == 1 || d == 13 { return Direction.rtl }
    }
    return Direction.neutral
}

// The resolved level of each code point of UTF-8 text in paragraphs of
// `paragraphLevel` (0 or 1, or DEFAULT_LTR or DEFAULT_RTL for the
// paragraphs' own direction, P2 and P3), in memory from `allocator`
// (free it with allocator.free(result.pointer, result.length, 1)).
pub fn resolveLevels(allocator: utf.Allocator, text: []const u8, paragraphLevel: u8) -> unicode.Error![]u8 {
    const units = try utf.toUtf16(allocator, text)
    defer utf.free16(allocator, units)
    const count = utf.count8(text)
    const memory = allocator.alloc(if count == 0 { 1 } else { count }, 1)
    if memory == null { return unicode.Error.OutOfMemory }
    const result = memory.?
    const b = ubidi_open()
    if b == 0 { return unicode.Error.OutOfMemory }
    var status: i32 = 0
    ubidi_setPara(b, @intFromPtr(units.pointer), @intCast(i32, units.length), paragraphLevel, 0, @intFromPtr(&status))
    if status > 0 {
        ubidi_close(b)
        allocator.free(result, if count == 0 { 1 } else { count }, 1)
        return unicode.Error.InvalidArgument
    }
    // A code point's level is its last unit's.
    var unit: usize = 0
    var index: usize = 0
    var at: usize = 0
    while at < text.length {
        const next = utf.decode8(text, at)
        at += next.length
        unit += utf.length16(next.codepoint)
        result[index] = levelAt(b, unit - 1)
        index += 1
    }
    ubidi_close(b)
    return result[0..count]
}

// L2: the index of the code point at each visual position of a line with
// these levels, in memory from `allocator` (free it with
// allocator.free(@ptrCast([*]u8, result.pointer), result.length * 8, 8)).
pub fn visualOrder(allocator: utf.Allocator, levels: []const u8) -> unicode.Error![]usize {
    const count = levels.length
    const memory = allocator.alloc(if count == 0 { 8 } else { count * 8 }, 8)
    if memory == null { return unicode.Error.OutOfMemory }
    var result: [*]usize = undefined
    unsafe { result = @ptrCast([*]usize, memory.?) }
    const order = m.alloc(count * 4 + 4)
    if order == 0 { return unicode.Error.OutOfMemory }
    reorder(@intFromPtr(levels.pointer), count, order)
    var i: usize = 0
    while i < count {
        result[i] = @intCast(usize, m.get32(order + i * 4))
        i += 1
    }
    m.release(order)
    return result[0..count]
}
