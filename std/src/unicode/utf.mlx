// std.unicode.utf: the encoding forms, UTF-8 and UTF-16: a code point
// read from text or written into it, validity, lengths, and whole texts
// converted from one form to the other into memory from an allocator.
// No tables and no C library: any program may import it.
//
//     var at: usize = 0
//     while at < text.length {
//         const next = utf.decode8(text, at)   // U+FFFD for an ill-formed sequence
//         at += next.length
//     }
//     const units = try utf.toUtf16(allocator, "grüße")
//     defer allocator.free(@ptrCast([*]u8, units.pointer), units.length * 2, 2)
//
// An ill-formed UTF-8 sequence reads as U+FFFD for its maximal subpart
// (Unicode's chapter 3, "U+FFFD Substitution of Maximal Subparts", as
// ICU and the WHATWG Encoding Standard do it); an unpaired surrogate in
// UTF-16 reads as U+FFFD for its one unit.
const allocator_module = @import("../../bootstrap/allocator.mlx")

pub const Allocator = allocator_module.Allocator

pub const REPLACEMENT: u32 = 65533
pub const MAX: u32 = 1114111

pub const Error = error { OutOfMemory }

// A code point and how many bytes (UTF-8) or units (UTF-16) it took.
pub const Decoded = struct {
    codepoint: u32
    length: usize
}

pub fn isSurrogate(codepoint: u32) -> bool { return codepoint >= 55296 && codepoint <= 57343 }

// Whether `codepoint` is a Unicode scalar value (a code point but not a
// surrogate): what UTF-8 and UTF-16 can encode.
pub fn isScalar(codepoint: u32) -> bool { return codepoint <= MAX && !isSurrogate(codepoint) }

// ---------------------------------------------------------------------------
// UTF-8

// The bytes UTF-8 takes for `codepoint` (3 for what it cannot encode,
// which is written as U+FFFD).
pub fn length8(codepoint: u32) -> usize {
    if codepoint < 128 { return 1 }
    if codepoint < 2048 { return 2 }
    if codepoint < 65536 || !isScalar(codepoint) { return 3 }
    return 4
}

// Writes `codepoint` (U+FFFD for a surrogate or past U+10FFFF) at
// `into`, which has room for four bytes; the bytes written.
pub fn encode8(codepoint: u32, into: [*]u8) -> usize {
    const value = if isScalar(codepoint) { codepoint } else { REPLACEMENT }
    if value < 128 {
        into[0] = @intCast(u8, value)
        return 1
    }
    if value < 2048 {
        into[0] = @intCast(u8, 192 | (value >> 6))
        into[1] = @intCast(u8, 128 | (value & 63))
        return 2
    }
    if value < 65536 {
        into[0] = @intCast(u8, 224 | (value >> 12))
        into[1] = @intCast(u8, 128 | ((value >> 6) & 63))
        into[2] = @intCast(u8, 128 | (value & 63))
        return 3
    }
    into[0] = @intCast(u8, 240 | (value >> 18))
    into[1] = @intCast(u8, 128 | ((value >> 12) & 63))
    into[2] = @intCast(u8, 128 | ((value >> 6) & 63))
    into[3] = @intCast(u8, 128 | (value & 63))
    return 4
}

fn isTrail(byte: u8) -> bool { return byte >= 128 && byte <= 191 }

// The code point at `at` in `text` (which `at` is inside) and its length.
pub fn decode8(text: []const u8, at: usize) -> Decoded {
    const lead = text[at]
    if lead < 128 { return Decoded.{ .codepoint = @intCast(u32, lead), .length = 1 } }
    const bad = Decoded.{ .codepoint = REPLACEMENT, .length = 1 }
    if lead < 194 || lead > 244 { return bad }
    const rest = text.length - at - 1
    if rest == 0 { return bad }
    const second = text[at + 1]
    // The second byte's range depends on the lead (no overlong forms, no
    // surrogates, nothing past U+10FFFF).
    var low: u8 = 128
    var high: u8 = 191
    if lead == 224 { low = 160 }
    if lead == 237 { high = 159 }
    if lead == 240 { low = 144 }
    if lead == 244 { high = 143 }
    if second < low || second > high { return bad }
    if lead < 224 {
        return Decoded.{ .codepoint = ((@intCast(u32, lead) & 31) << 6) | (@intCast(u32, second) & 63), .length = 2 }
    }
    if rest < 2 || !isTrail(text[at + 2]) { return Decoded.{ .codepoint = REPLACEMENT, .length = 2 } }
    const third = text[at + 2]
    if lead < 240 {
        return Decoded.{ .codepoint = ((@intCast(u32, lead) & 15) << 12) | ((@intCast(u32, second) & 63) << 6) | (@intCast(u32, third) & 63), .length = 3 }
    }
    if rest < 3 || !isTrail(text[at + 3]) { return Decoded.{ .codepoint = REPLACEMENT, .length = 3 } }
    const fourth = text[at + 3]
    const value = ((@intCast(u32, lead) & 7) << 18) | ((@intCast(u32, second) & 63) << 12) | ((@intCast(u32, third) & 63) << 6) | (@intCast(u32, fourth) & 63)
    return Decoded.{ .codepoint = value, .length = 4 }
}

// Whether `text` is well-formed UTF-8.
pub fn valid8(text: []const u8) -> bool {
    var at: usize = 0
    while at < text.length {
        const next = decode8(text, at)
        if next.codepoint == REPLACEMENT && !(next.length == 3 && text[at] == 239 && text[at + 1] == 191 && text[at + 2] == 189) { return false }
        at += next.length
    }
    return true
}

// How many code points `text` has (each ill-formed sequence one).
pub fn count8(text: []const u8) -> usize {
    var count: usize = 0
    var at: usize = 0
    while at < text.length {
        at += decode8(text, at).length
        count += 1
    }
    return count
}

// ---------------------------------------------------------------------------
// UTF-16

// The units UTF-16 takes for `codepoint`.
pub fn length16(codepoint: u32) -> usize { return if codepoint >= 65536 && codepoint <= MAX { 2 } else { 1 } }

// Writes `codepoint` (U+FFFD for what UTF-16 cannot encode) at `into`,
// which has room for two units; the units written.
pub fn encode16(codepoint: u32, into: [*]u16) -> usize {
    if codepoint >= 65536 && codepoint <= MAX {
        const offset = codepoint - 65536
        into[0] = @intCast(u16, 55296 + (offset >> 10))
        into[1] = @intCast(u16, 56320 + (offset & 1023))
        return 2
    }
    into[0] = @intCast(u16, if isSurrogate(codepoint) || codepoint > MAX { REPLACEMENT } else { codepoint })
    return 1
}

// The code point at `at` in `units` and its length.
pub fn decode16(units: []const u16, at: usize) -> Decoded {
    const first = @intCast(u32, units[at])
    if first >= 55296 && first <= 56319 && at + 1 < units.length {
        const second = @intCast(u32, units[at + 1])
        if second >= 56320 && second <= 57343 {
            return Decoded.{ .codepoint = 65536 + ((first - 55296) << 10) + (second - 56320), .length = 2 }
        }
    }
    if isSurrogate(first) { return Decoded.{ .codepoint = REPLACEMENT, .length = 1 } }
    return Decoded.{ .codepoint = first, .length = 1 }
}

// ---------------------------------------------------------------------------
// Whole texts

// The UTF-16 units `text` (UTF-8) takes.
pub fn units16Of(text: []const u8) -> usize {
    var count: usize = 0
    var at: usize = 0
    while at < text.length {
        const next = decode8(text, at)
        count += length16(next.codepoint)
        at += next.length
    }
    return count
}

// The UTF-8 bytes `units` (UTF-16) take.
pub fn bytes8Of(units: []const u16) -> usize {
    var count: usize = 0
    var at: usize = 0
    while at < units.length {
        const next = decode16(units, at)
        count += length8(next.codepoint)
        at += next.length
    }
    return count
}

// `text` as UTF-16, in memory from `allocator` (free it with
// allocator.free(@ptrCast([*]u8, result.pointer), result.length * 2, 2));
// ill-formed sequences become U+FFFD.
pub fn toUtf16(allocator: Allocator, text: []const u8) -> Error![]u16 {
    const count = units16Of(text)
    const memory = allocator.alloc(if count == 0 { 2 } else { count * 2 }, 2)
    if memory == null { return Error.OutOfMemory }
    var units: [*]u16 = undefined
    unsafe { units = @ptrCast([*]u16, memory.?) }
    var length: usize = 0
    var at: usize = 0
    while at < text.length {
        const next = decode8(text, at)
        length += encode16(next.codepoint, units + length)
        at += next.length
    }
    return units[0..length]
}

// `units` as UTF-8, in memory from `allocator` (free it with
// allocator.free(result.pointer, result.length, 1)); unpaired
// surrogates become U+FFFD.
pub fn toUtf8(allocator: Allocator, units: []const u16) -> Error![]u8 {
    const count = bytes8Of(units)
    const memory = allocator.alloc(if count == 0 { 1 } else { count }, 1)
    if memory == null { return Error.OutOfMemory }
    const bytes = memory.?
    var length: usize = 0
    var at: usize = 0
    while at < units.length {
        const next = decode16(units, at)
        length += encode8(next.codepoint, bytes + length)
        at += next.length
    }
    return bytes[0..length]
}

// A copy of `text` in memory from `allocator`.
pub fn copy(allocator: Allocator, text: []const u8) -> Error![]u8 {
    const memory = allocator.alloc(if text.length == 0 { 1 } else { text.length }, 1)
    if memory == null { return Error.OutOfMemory }
    const bytes = memory.?
    var index: usize = 0
    while index < text.length {
        bytes[index] = text[index]
        index += 1
    }
    return bytes[0..text.length]
}

// Frees what toUtf8 or copy gave.
pub fn free8(allocator: Allocator, text: []const u8) -> void {
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, text.pointer) }
    allocator.free(bytes, if text.length == 0 { 1 } else { text.length }, 1)
}

// Frees what toUtf16 gave.
pub fn free16(allocator: Allocator, units: []const u16) -> void {
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, units.pointer) }
    allocator.free(bytes, if units.length == 0 { 2 } else { units.length * 2 }, 2)
}
