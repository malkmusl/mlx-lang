// Normalization (unorm2.h, UAX #15): decomposition (Hangul syllables by
// rule, the rest by UnicodeData.txt's mappings), canonical ordering, and
// canonical composition (by the pairs of tables.mlx, without the
// composition exclusions).
const tables = @import("std.unicode.tables")
const m = @import("std.unicode.memory")
const p = @import("std.unicode.properties")
const casing = @import("std.unicode.casing")

// The forms; C sees them as the addresses of these words, never read.
pub const NFC: u32 = 1
pub const NFD: u32 = 2
pub const NFKC: u32 = 3
pub const NFKD: u32 = 4
pub const NFKC_CASEFOLD: u32 = 5

pub var instances: [6]u64 = [6]u64{ 0, 1, 2, 3, 4, 5 }

fn instance(form: u32) -> usize { return @intFromPtr(&instances) + @intCast(usize, form) * 8 }

fn formOf(norm: usize) -> u32 {
    const base = @intFromPtr(&instances)
    if norm <= base || norm > base + 40 { return NFC }
    return @intCast(u32, (norm - base) / 8)
}

fn compatible(form: u32) -> bool { return form == NFKC || form == NFKD || form == NFKC_CASEFOLD }
fn composed(form: u32) -> bool { return form == NFC || form == NFKC || form == NFKC_CASEFOLD }

// Hangul: syllables are L V (T), by rule.
const S_BASE: i32 = 44032
const L_BASE: i32 = 4352
const V_BASE: i32 = 4449
const T_BASE: i32 = 4519
const L_COUNT: i32 = 19
const V_COUNT: i32 = 21
const T_COUNT: i32 = 28
const N_COUNT: i32 = 588
const S_COUNT: i32 = 11172

// The index + 1 of the decomposition of `c` of the kind `compat` allows
// (0: none).
fn decompositionOf(c: i32, compat: bool) -> usize {
    if c < 0 || c > 1114111 { return 0 }
    const code = @intCast(u32, c)
    var low: usize = 0
    var high: usize = tables.DECOMPOSITION_CODES.length
    while low < high {
        const middle = (low + high) / 2
        const found = tables.DECOMPOSITION_CODES[middle]
        if found == code {
            if !compat && (tables.DECOMPOSITION_INFO[middle] & 2147483648) != 0 { return 0 }
            return middle + 1
        }
        if found < code { low = middle + 1 } else { high = middle }
    }
    return 0
}

// Appends the full decomposition of `c`.
pub fn decompose(out: *m.Buffer, c: i32, compat: bool) -> void {
    if c >= S_BASE && c < S_BASE + S_COUNT {
        const s = c - S_BASE
        m.push(out, @intCast(u32, L_BASE + s / N_COUNT))
        m.push(out, @intCast(u32, V_BASE + (s % N_COUNT) / T_COUNT))
        if s % T_COUNT != 0 { m.push(out, @intCast(u32, T_BASE + s % T_COUNT)) }
        return
    }
    const found = decompositionOf(c, compat)
    if found == 0 {
        m.push(out, @intCast(u32, c))
        return
    }
    const info = tables.DECOMPOSITION_INFO[found - 1]
    const offset = @intCast(usize, info & 16777215)
    const count = @intCast(usize, (info >> 24) & 127)
    var index: usize = 0
    while index < count {
        decompose(out, @intCast(i32, tables.DECOMPOSITION_DATA[offset + index]), compat)
        index += 1
    }
}

// Sorts each run of non-starters by combining class (stably).
fn reorder(text: *m.Buffer) -> void {
    var index: usize = 1
    while index < text.*.length {
        const ccc = p.combiningClass(@intCast(i32, m.at(text, index)))
        if ccc != 0 {
            var place = index
            while place > 0 {
                const before = p.combiningClass(@intCast(i32, m.at(text, place - 1)))
                if before <= ccc || before == 0 { break }
                const value = m.at(text, place)
                m.setAt(text, place, m.at(text, place - 1))
                m.setAt(text, place - 1, value)
                place -= 1
            }
        }
        index += 1
    }
}

// The primary composite of `a` and `b` (-1: none).
pub fn composePair(a: i32, b: i32) -> i32 {
    if a >= L_BASE && a < L_BASE + L_COUNT && b >= V_BASE && b < V_BASE + V_COUNT {
        return S_BASE + ((a - L_BASE) * V_COUNT + (b - V_BASE)) * T_COUNT
    }
    if a >= S_BASE && a < S_BASE + S_COUNT && (a - S_BASE) % T_COUNT == 0 && b > T_BASE && b < T_BASE + T_COUNT {
        return a + (b - T_BASE)
    }
    if a < 0 || b < 0 { return -1 }
    const key = (@intCast(u64, a) << 21) | @intCast(u64, b)
    var low: usize = 0
    var high: usize = tables.COMPOSITION_KEYS.length
    while low < high {
        const middle = (low + high) / 2
        const found = tables.COMPOSITION_KEYS[middle]
        if found == key { return @intCast(i32, tables.COMPOSITION_VALUES[middle]) }
        if found < key { low = middle + 1 } else { high = middle }
    }
    return -1
}

// Canonical composition, in place.
fn compose(text: *m.Buffer) -> void {
    if text.*.length == 0 { return }
    var starter: usize = 0
    var haveStarter = p.combiningClass(@intCast(i32, m.at(text, 0))) == 0
    var lastClass: u32 = if haveStarter { 0 } else { 256 }
    var written: usize = 1
    var index: usize = 1
    while index < text.*.length {
        const c = @intCast(i32, m.at(text, index))
        const ccc = p.combiningClass(c)
        var combined = false
        if haveStarter && (lastClass < ccc || (lastClass == 0 && written == starter + 1)) {
            const composite = composePair(@intCast(i32, m.at(text, starter)), c)
            if composite >= 0 {
                m.setAt(text, starter, @intCast(u32, composite))
                combined = true
            }
        }
        if !combined {
            if ccc == 0 {
                starter = written
                haveStarter = true
                lastClass = 0
            } else {
                lastClass = ccc
            }
            m.setAt(text, written, @intCast(u32, c))
            written += 1
        }
        index += 1
    }
    text.*.length = written
}

// The normalization of the code points of `source` into `out`.
pub fn normalizeCodes(out: *m.Buffer, source: *m.Buffer, form: u32) -> void {
    var input = source.*
    var folded = m.buffer()
    if form == NFKC_CASEFOLD {
        // NFKC_Casefold: NFKC of the case folding of NFKD, without the
        // default ignorables.
        var first = m.buffer()
        var index: usize = 0
        while index < source.*.length {
            decompose(&first, @intCast(i32, m.at(source, index)), true)
            index += 1
        }
        index = 0
        while index < first.length {
            const c = @intCast(i32, m.at(&first, index))
            if !p.binary(c, 5) { casing.foldAt(&folded, c, 0) }
            index += 1
        }
        m.dispose(&first)
        input = folded
    }
    var index: usize = 0
    while index < input.length {
        decompose(out, @intCast(i32, m.at(&input, index)), compatible(form))
        index += 1
    }
    reorder(out)
    if composed(form) { compose(out) }
    m.dispose(&folded)
}

// ---------------------------------------------------------------------------
// C

pub fn unorm2_getNFCInstance(status: usize) -> usize { return if m.failed(status) { 0 } else { instance(NFC) } }
pub fn unorm2_getNFDInstance(status: usize) -> usize { return if m.failed(status) { 0 } else { instance(NFD) } }
pub fn unorm2_getNFKCInstance(status: usize) -> usize { return if m.failed(status) { 0 } else { instance(NFKC) } }
pub fn unorm2_getNFKDInstance(status: usize) -> usize { return if m.failed(status) { 0 } else { instance(NFKD) } }
pub fn unorm2_getNFKCCasefoldInstance(status: usize) -> usize { return if m.failed(status) { 0 } else { instance(NFKC_CASEFOLD) } }

pub fn unorm2_getInstance(package: usize, name: usize, mode: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if package != 0 || name == 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const text = m.cSlice(name)
    const decompose_ = mode == 1
    if p.looselySame(text, "nfc") { return instance(if decompose_ { NFD } else { NFC }) }
    if p.looselySame(text, "nfkc") { return instance(if decompose_ { NFKD } else { NFKC }) }
    if p.looselySame(text, "nfkc_cf") || p.looselySame(text, "nfkc_scf") { return instance(NFKC_CASEFOLD) }
    m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
    return 0
}

pub fn unorm2_close(norm: usize) -> void {}

fn normalizeInto(form: u32, src: usize, count: usize, dest: usize, capacity: i32, status: usize) -> i32 {
    var source = m.buffer()
    m.decode16(&source, src, count)
    var out = m.buffer()
    normalizeCodes(&out, &source, form)
    const written = m.encode16(&out, dest, @intCast(usize, capacity))
    m.dispose(&source)
    m.dispose(&out)
    return m.terminate(dest, written, capacity, status)
}

fn badString(s: usize, length: i32, status: usize) -> bool {
    if (s == 0 && length != 0) || length < -1 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return true
    }
    return false
}

pub fn unorm2_normalize(norm: usize, src: usize, length: i32, dest: usize, capacity: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    if badString(src, length, status) || capacity < 0 || (dest == 0 && capacity > 0) || (dest != 0 && dest == src) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    return normalizeInto(formOf(norm), src, if src == 0 { 0 } else { m.units(src, length) }, dest, capacity, status)
}

// `first` (its length and capacity) followed by `second`, normalized
// (or, for append, `second` only when `normalize` is false).
fn appendNormalized(norm: usize, first: usize, firstLength: i32, capacity: i32, second: usize, secondLength: i32, normalize: bool, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    if badString(first, firstLength, status) || badString(second, secondLength, status) || capacity < 0 || (first == 0 && capacity > 0) { return 0 }
    const a = if first == 0 { 0 } else { m.units(first, firstLength) }
    const b = if second == 0 { 0 } else { m.units(second, secondLength) }
    var source = m.buffer()
    m.decode16(&source, first, a)
    var tail = m.buffer()
    m.decode16(&tail, second, b)
    var index: usize = 0
    while index < tail.length {
        m.push(&source, m.at(&tail, index))
        index += 1
    }
    var out = m.buffer()
    normalizeCodes(&out, &source, formOf(norm))
    const written = m.encode16(&out, first, @intCast(usize, capacity))
    m.dispose(&source)
    m.dispose(&tail)
    m.dispose(&out)
    return m.terminate(first, written, capacity, status)
}

pub fn unorm2_normalizeSecondAndAppend(norm: usize, first: usize, firstLength: i32, capacity: i32, second: usize, secondLength: i32, status: usize) -> i32 {
    return appendNormalized(norm, first, firstLength, capacity, second, secondLength, true, status)
}

pub fn unorm2_append(norm: usize, first: usize, firstLength: i32, capacity: i32, second: usize, secondLength: i32, status: usize) -> i32 {
    return appendNormalized(norm, first, firstLength, capacity, second, secondLength, false, status)
}

// Whether `count` units at `s` are already in the form.
fn normalized(form: u32, s: usize, count: usize) -> bool {
    var source = m.buffer()
    m.decode16(&source, s, count)
    // (A string of code points that are inert and not Hangul jamo or
    // syllables in a composing form is normalized as it stands.)
    var quick = true
    var index: usize = 0
    while index < source.length {
        const c = @intCast(i32, m.at(&source, index))
        const inert = if form == NFD { 37 } else if form == NFKD { 38 } else if form == NFC { 39 } else { 40 }
        if c >= 128 && !p.binary(c, inert) {
            quick = false
            break
        }
        index += 1
    }
    if quick && form != NFKC_CASEFOLD {
        m.dispose(&source)
        return true
    }
    var out = m.buffer()
    normalizeCodes(&out, &source, form)
    var same = out.length == source.length
    index = 0
    while same && index < out.length {
        if m.at(&out, index) != m.at(&source, index) { same = false }
        index += 1
    }
    m.dispose(&source)
    m.dispose(&out)
    return same
}

pub fn unorm2_isNormalized(norm: usize, s: usize, length: i32, status: usize) -> u8 {
    if m.failed(status) || badString(s, length, status) { return 0 }
    return if normalized(formOf(norm), s, if s == 0 { 0 } else { m.units(s, length) }) { 1 } else { 0 }
}

pub fn unorm2_quickCheck(norm: usize, s: usize, length: i32, status: usize) -> i32 {
    if m.failed(status) || badString(s, length, status) { return 0 }
    return if normalized(formOf(norm), s, if s == 0 { 0 } else { m.units(s, length) }) { 1 } else { 0 }
}

// The length of the longest beginning of `s` that is normalized and
// ends before a code point that starts afresh.
pub fn unorm2_spanQuickCheckYes(norm: usize, s: usize, length: i32, status: usize) -> i32 {
    if m.failed(status) || badString(s, length, status) { return 0 }
    const count = if s == 0 { 0 } else { m.units(s, length) }
    const form = formOf(norm)
    if normalized(form, s, count) { return @intCast(i32, count) }
    // The segments between starters that compose with nothing before.
    var start: usize = 0
    var index: usize = 0
    while index < count {
        var c = @intCast(i32, m.get16(s + index * 2))
        var size: usize = 1
        if c >= 55296 && c <= 56319 && index + 1 < count {
            const trail = @intCast(i32, m.get16(s + index * 2 + 2))
            if trail >= 56320 && trail <= 57343 {
                c = (c << 10) + trail - 56613888
                size = 2
            }
        }
        if index > start && p.combiningClass(c) == 0 && p.nfcQuickCheck(c) == 0 {
            if !normalized(form, s + start * 2, index - start) { return @intCast(i32, start) }
            start = index
        }
        index += size
    }
    return @intCast(i32, start)
}

fn writeCodes(out: *m.Buffer, dest: usize, capacity: i32, status: usize) -> i32 {
    const written = m.encode16(out, dest, if capacity > 0 { @intCast(usize, capacity) } else { 0 })
    return m.terminate(dest, written, capacity, status)
}

pub fn unorm2_getDecomposition(norm: usize, c: i32, dest: usize, capacity: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    if capacity < 0 || (dest == 0 && capacity > 0) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const compat = compatible(formOf(norm))
    if !(c >= S_BASE && c < S_BASE + S_COUNT) && decompositionOf(c, compat) == 0 { return -1 }
    var out = m.buffer()
    decompose(&out, c, compat)
    const result = writeCodes(&out, dest, capacity, status)
    m.dispose(&out)
    return result
}

pub fn unorm2_getRawDecomposition(norm: usize, c: i32, dest: usize, capacity: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    if capacity < 0 || (dest == 0 && capacity > 0) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    var out = m.buffer()
    if c >= S_BASE && c < S_BASE + S_COUNT {
        const s = c - S_BASE
        if s % T_COUNT == 0 {
            m.push(&out, @intCast(u32, L_BASE + s / N_COUNT))
            m.push(&out, @intCast(u32, V_BASE + (s % N_COUNT) / T_COUNT))
        } else {
            m.push(&out, @intCast(u32, c - s % T_COUNT))
            m.push(&out, @intCast(u32, T_BASE + s % T_COUNT))
        }
    } else {
        const found = decompositionOf(c, compatible(formOf(norm)))
        if found == 0 { return -1 }
        const info = tables.DECOMPOSITION_INFO[found - 1]
        const offset = @intCast(usize, info & 16777215)
        var index: usize = 0
        while index < @intCast(usize, (info >> 24) & 127) {
            m.push(&out, tables.DECOMPOSITION_DATA[offset + index])
            index += 1
        }
    }
    const result = writeCodes(&out, dest, capacity, status)
    m.dispose(&out)
    return result
}

pub fn unorm2_composePair(norm: usize, a: i32, b: i32) -> i32 {
    if !composed(formOf(norm)) { return -1 }
    return composePair(a, b)
}

pub fn unorm2_getCombiningClass(norm: usize, c: i32) -> u8 { return @intCast(u8, p.combiningClass(c)) }

pub fn unorm2_hasBoundaryBefore(norm: usize, c: i32) -> u8 {
    const form = formOf(norm)
    if p.combiningClass(c) != 0 { return 0 }
    if composed(form) { return if p.nfcQuickCheck(c) == 0 && !(c >= 4449 && c <= 4546) { 1 } else { 0 } }
    return 1
}

pub fn unorm2_hasBoundaryAfter(norm: usize, c: i32) -> u8 { return unorm2_isInert(norm, c) }

pub fn unorm2_isInert(norm: usize, c: i32) -> u8 {
    const form = formOf(norm)
    const bit = if form == NFD { 37 } else if form == NFKD { 38 } else if form == NFC { 39 } else { 40 }
    return if p.binary(c, bit) { 1 } else { 0 }
}
