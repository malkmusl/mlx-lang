// std.unicode.charmaps: the single-byte charsets, each a byte to code
// point table above ASCII, as the Encoding Standard's indexes (and Apple's
// tables for the Mac OS charsets the web names beyond them) map them
// (std/registry/unicode/charsets, made into charmaps/tables.mlx by
// charset-generate). No C library and no allocator: mlx-unicode's
// converters (ucnv.h) and mlxlibc's iconv both stand on it.
//
//     var map: charmaps.Charmap = undefined
//     if charmaps.find("latin2", &map) {      // ISO-8859-2
//         const c = charmaps.decode(map, 161)  // U+0104
//         const byte = charmaps.encode(map, c) // 161
//     }
//
// (A byte or code point a charset does not have is NONE: the results are
// not optionals, which mlx4 takes for null when they are 0.)
//
// A charset is found by its name or any of its labels, compared as ICU
// compares converter names: letters without case, and only the letters
// and digits (`ISO_8859-2`, `iso88592` and `Latin-2` are one name).
// ISO-8859-1 and US-ASCII are not here: a converter does them by rule.
// Two charsets are another's table with the bytes 0x80 to 0x9F the C1
// controls, as the ISO standard has them: ISO-8859-9 (windows-1254) and
// ISO-8859-11 (windows-874; the Encoding Standard reads both labels as
// the Windows charset, as browsers do).
const tables = @import("std.unicode.charmaps.tables")

// A charset: its table (an index into tables.NAMES) and whether the
// bytes 0x80 to 0x9F are the C1 controls.
pub const Charmap = struct {
    table: usize
    c1: bool
}

pub const NONE: u32 = 4294967295

// Each entry: the charset's name (one of the tables', or a name then
// `=` and the table's name for a charset that reads another's table
// with C1 controls), then its labels, letters and digits only.
const ENTRIES = [32][]const u8{
    "IBM866 866 cp866 csibm866 ibm866",
    "ISO-8859-2 csisolatin2 isoir101 iso88592 iso885921987 l2 latin2",
    "ISO-8859-3 csisolatin3 isoir109 iso88593 iso885931988 l3 latin3",
    "ISO-8859-4 csisolatin4 isoir110 iso88594 iso885941988 l4 latin4",
    "ISO-8859-5 csisolatincyrillic cyrillic isoir144 iso88595 iso885951988",
    "ISO-8859-6 arabic asmo708 csiso88596e csiso88596i csisolatinarabic ecma114 iso88596 iso88596e iso88596i isoir127 iso885961987",
    "ISO-8859-7 csisolatingreek ecma118 elot928 greek greek8 iso88597 isoir126 iso885971987 suneugreek",
    "ISO-8859-8 csiso88598e csiso88598i csisolatinhebrew hebrew iso88598 iso88598e iso88598i isoir138 iso885981988 logical visual",
    "ISO-8859-10 csisolatin6 isoir157 iso885910 iso8859101992 l6 latin6",
    "ISO-8859-13 iso885913 l7 latin7",
    "ISO-8859-14 iso885914 isoceltic iso8859141998 isoir199 latin8 l8",
    "ISO-8859-15 csisolatin9 iso885915 l9 latin9",
    "ISO-8859-16 iso885916 isoir226 iso8859162001 l10 latin10",
    "KOI8-R cskoi8r koi koi8 koi8r",
    "KOI8-U koi8ru koi8u",
    "macintosh csmacintosh mac macintosh xmacroman macroman",
    "windows-874 dos874 windows874 cp874",
    "windows-1250 cp1250 windows1250 xcp1250 winlatin2",
    "windows-1251 cp1251 windows1251 xcp1251 wincyrillic",
    "windows-1252 cp1252 windows1252 xcp1252 mswindows1252",
    "windows-1253 cp1253 windows1253 xcp1253",
    "windows-1254 cp1254 windows1254 xcp1254 winturkish",
    "windows-1255 cp1255 windows1255 xcp1255",
    "windows-1256 cp1256 windows1256 xcp1256 winarabic",
    "windows-1257 cp1257 windows1257 xcp1257",
    "windows-1258 cp1258 windows1258 xcp1258 winvietnamese",
    "x-mac-cyrillic xmaccyrillic xmacukrainian maccyrillic windows10007 maccy xmacukraine",
    "x-mac-greek xmacgreek windows10006 macgr macgreek",
    "x-mac-centraleurroman xmaccentraleurroman windows10029 xmacce macce maccentraleurope xmaccentraleurope",
    "x-mac-turkish xmacturkish windows10081 mactr macturkish",
    "ISO-8859-9=windows-1254 csisolatin5 iso88599 isoir148 iso885991989 l5 latin5",
    "ISO-8859-11=windows-874 iso885911 tis620",
}

fn lower(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }

fn isAlphanumeric(byte: u8) -> bool { return (byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) }

// Whether `name` is `label` (letters and digits only, small letters)
// once its other characters are left out and its letters made small.
fn matches(name: []const u8, label: []const u8) -> bool {
    var at: usize = 0
    var index: usize = 0
    while index < name.length {
        const byte = name[index]
        index += 1
        if !isAlphanumeric(byte) { continue }
        if at >= label.length || lower(byte) != label[at] { return false }
        at += 1
    }
    return at == label.length
}

// The table named `name` (as tables.NAMES has it, case and all), or
// tables.COUNT.
fn tableNamed(name: []const u8) -> usize {
    var table: usize = 0
    var at: usize = 0
    while at < tables.NAMES.length {
        var end = at
        while end < tables.NAMES.length && tables.NAMES[end] != 10 { end += 1 }
        if sameText(tables.NAMES[at..end], name) { return table }
        table += 1
        at = end + 1
    }
    return tables.COUNT
}

fn sameText(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

// The entry's name (before the first space, and before `=`).
fn entryName(entry: []const u8) -> []const u8 {
    var end: usize = 0
    while end < entry.length && entry[end] != 32 && entry[end] != 61 { end += 1 }
    return entry[0..end]
}

// The charset of `entry` (its table tables.COUNT when the table it
// names is not there).
fn charmapOf(entry: []const u8) -> Charmap {
    var end: usize = 0
    while end < entry.length && entry[end] != 32 { end += 1 }
    const head = entry[0..end]
    var equals: usize = 0
    while equals < head.length && head[equals] != 61 { equals += 1 }
    if equals < head.length { return Charmap.{ .table = tableNamed(head[equals + 1..head.length]), .c1 = true } }
    return Charmap.{ .table = tableNamed(head), .c1 = false }
}

// Finds the charset `name` names (its name or a label) into `map`;
// false when there is none.
pub fn find(name: []const u8, map: *Charmap) -> bool {
    for entry in ENTRIES {
        // The name itself, then each label.
        var named = matches(name, entryName(entry))
        var at: usize = 0
        while at < entry.length && entry[at] != 32 { at += 1 }
        while !named && at < entry.length {
            at += 1
            var end = at
            while end < entry.length && entry[end] != 32 { end += 1 }
            named = matches(name, entry[at..end])
            at = end
        }
        if named {
            map.* = charmapOf(entry)
            return map.*.table < tables.COUNT
        }
    }
    return false
}

// The charset's name: the Encoding Standard's (or WebKit's, for the Mac
// OS ones), and ISO-8859-9 and ISO-8859-11 for the two with C1 controls.
pub fn nameOf(map: Charmap) -> []const u8 {
    for entry in ENTRIES {
        const found = charmapOf(entry)
        if found.table == map.table && found.c1 == map.c1 { return entryName(entry) }
    }
    return ""
}

// How many charsets there are (`at` takes 0 to this less one).
pub fn count() -> usize { return ENTRIES.length }

// The charset of entry `index`.
pub fn at(index: usize) -> Charmap { return charmapOf(ENTRIES[index]) }

// The code point of `byte`, or NONE where the charset has none.
pub fn decode(map: Charmap, byte: u8) -> u32 {
    if byte < 128 { return @intCast(u32, byte) }
    if map.c1 && byte < 160 { return @intCast(u32, byte) }
    const code = tables.UPPER[map.table * 128 + @intCast(usize, byte - 128)]
    if code == 0 { return NONE }
    return @intCast(u32, code)
}

// The byte of `codepoint`, or NONE where the charset has none.
pub fn encode(map: Charmap, codepoint: u32) -> u32 {
    if codepoint < 128 { return codepoint }
    if map.c1 && codepoint < 160 { return codepoint }
    if codepoint > 65535 { return NONE }
    const base = map.table * 128
    var index: usize = 0
    while index < 128 {
        // (With C1 controls the table's own 0x80 to 0x9F are not there.)
        if @intCast(u32, tables.UPPER[base + index]) == codepoint && !(map.c1 && index < 32) { return @intCast(u32, index + 128) }
        index += 1
    }
    return NONE
}
