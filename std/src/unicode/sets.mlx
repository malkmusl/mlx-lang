// Sets of code points (uset.h): ranges kept sorted and apart, made from
// ranges, code points, other sets and patterns (`[a-zà]`, `[:P:]`,
// `\p{WSpace}`, `[^...]`, nested sets united, white space ignored as
// ICU's USET_IGNORE_SPACE does). Not yet: strings in a set, the `&` and
// `-` operators between sets, variables.
const m = @import("std.unicode.memory")
const p = @import("std.unicode.properties")

const MAX: u32 = 1114111
const MALFORMED_SET: i32 = 65538
const GENERAL_CATEGORY: i32 = 4101
const SCRIPT: i32 = 4106
const GENERAL_CATEGORY_MASK: i32 = 8192
const BINARY_LIMIT: i32 = 76

// A set: the address of a block of three words, the m.Buffer of its
// ranges (start and end of each, in order).
fn ranges(set: usize) -> *m.Buffer {
    unsafe { return @ptrFromInt(*m.Buffer, set) }
}

fn rangeCount(set: usize) -> usize { return ranges(set).*.length / 2 }
fn startAt(set: usize, index: usize) -> u32 { return m.at(ranges(set), index * 2) }
fn endAt(set: usize, index: usize) -> u32 { return m.at(ranges(set), index * 2 + 1) }

pub fn uset_openEmpty() -> usize {
    const set = m.alloc(24)
    if set == 0 { return 0 }
    ranges(set).* = m.buffer()
    return set
}

pub fn uset_open(start: i32, end: i32) -> usize {
    const set = uset_openEmpty()
    if set != 0 { uset_addRange(set, start, end) }
    return set
}

pub fn uset_close(set: usize) -> void {
    if set == 0 { return }
    m.dispose(ranges(set))
    m.release(set)
}

pub fn uset_clear(set: usize) -> void { ranges(set).*.length = 0 }

// [start, end] added: after the last range (the common case, a set made
// in order), else the ranges rebuilt with it merged in.
pub fn uset_addRange(set: usize, first: i32, last: i32) -> void {
    if first > last || last < 0 || first > @intCast(i32, MAX) { return }
    const start = @intCast(u32, if first < 0 { 0 } else { first })
    const end = @intCast(u32, if last > @intCast(i32, MAX) { @intCast(i32, MAX) } else { last })
    const b = ranges(set)
    const count = rangeCount(set)
    if count == 0 || start > endAt(set, count - 1) + 1 {
        m.push(b, start)
        m.push(b, end)
        return
    }
    if start >= startAt(set, count - 1) {
        if end > endAt(set, count - 1) { m.setAt(b, count * 2 - 1, end) }
        return
    }
    var merged = m.buffer()
    var index: usize = 0
    var placed = false
    var newStart = start
    var newEnd = end
    while index < count {
        const s = startAt(set, index)
        const e = endAt(set, index)
        if e + 1 < newStart {
            m.push(&merged, s)
            m.push(&merged, e)
        } else if newEnd + 1 < s {
            if !placed {
                m.push(&merged, newStart)
                m.push(&merged, newEnd)
                placed = true
            }
            m.push(&merged, s)
            m.push(&merged, e)
        } else {
            if s < newStart { newStart = s }
            if e > newEnd { newEnd = e }
        }
        index += 1
    }
    if !placed {
        m.push(&merged, newStart)
        m.push(&merged, newEnd)
    }
    m.dispose(b)
    b.* = merged
}

pub fn uset_add(set: usize, c: i32) -> void { uset_addRange(set, c, c) }

pub fn uset_addAll(set: usize, other: usize) -> void {
    var index: usize = 0
    const count = rangeCount(other)
    while index < count {
        uset_addRange(set, @intCast(i32, startAt(other, index)), @intCast(i32, endAt(other, index)))
        index += 1
    }
}

pub fn uset_complement(set: usize) -> void {
    const b = ranges(set)
    var result = m.buffer()
    var next: u32 = 0
    var index: usize = 0
    const count = rangeCount(set)
    while index < count {
        const s = startAt(set, index)
        if s > next {
            m.push(&result, next)
            m.push(&result, s - 1)
        }
        next = endAt(set, index) + 1
        index += 1
    }
    if next <= MAX {
        m.push(&result, next)
        m.push(&result, MAX)
    }
    m.dispose(b)
    b.* = result
}

pub fn uset_contains(set: usize, c: i32) -> u8 {
    if set == 0 || c < 0 { return 0 }
    const code = @intCast(u32, c)
    var low: usize = 0
    var high = rangeCount(set)
    while low < high {
        const middle = (low + high) / 2
        if code < startAt(set, middle) {
            high = middle
        } else if code > endAt(set, middle) {
            low = middle + 1
        } else {
            return 1
        }
    }
    return 0
}

pub fn uset_isEmpty(set: usize) -> u8 { return if rangeCount(set) == 0 { 1 } else { 0 } }

pub fn uset_size(set: usize) -> i32 {
    var total: u32 = 0
    var index: usize = 0
    while index < rangeCount(set) {
        total += endAt(set, index) - startAt(set, index) + 1
        index += 1
    }
    return @intCast(i32, total)
}

pub fn uset_getRangeCount(set: usize) -> i32 { return @intCast(i32, rangeCount(set)) }

// ---------------------------------------------------------------------------
// Patterns

const Reader = struct {
    text: m.Buffer
    at: usize
    failed: bool
    // A property no name of which is known (ICU's illegal argument).
    unknown: bool
}

fn peek(r: *Reader) -> i32 {
    if r.*.at >= r.*.text.length { return -1 }
    return @intCast(i32, m.at(&r.*.text, r.*.at))
}

fn peekAt(r: *Reader, offset: usize) -> i32 {
    if r.*.at + offset >= r.*.text.length { return -1 }
    return @intCast(i32, m.at(&r.*.text, r.*.at + offset))
}

fn isSpace(c: i32) -> bool { return c == 32 || (c >= 9 && c <= 13) || c == 133 || c == 8206 || c == 8207 || c == 8232 || c == 8233 }

fn skipSpace(r: *Reader) -> void {
    while isSpace(peek(r)) { r.*.at += 1 }
}

fn hexValue(c: i32) -> i32 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    return -1
}

// `count` hex digits (up to `count` with `upTo`).
fn hexDigits(r: *Reader, count: usize, upTo: bool) -> i32 {
    var value: i32 = 0
    var read: usize = 0
    while read < count {
        const d = hexValue(peek(r))
        if d < 0 { break }
        value = value * 16 + d
        r.*.at += 1
        read += 1
    }
    if read == 0 || (!upTo && read != count) || value > @intCast(i32, MAX) {
        r.*.failed = true
        return 0
    }
    return value
}

// A code point after `\` (the backslash read).
fn escaped(r: *Reader) -> i32 {
    const c = peek(r)
    if c < 0 {
        r.*.failed = true
        return 0
    }
    r.*.at += 1
    if c == 117 { return hexDigits(r, 4, false) }
    if c == 85 { return hexDigits(r, 8, false) }
    if c == 120 {
        if peek(r) == 123 {
            r.*.at += 1
            const value = hexDigits(r, 6, true)
            if peek(r) != 125 { r.*.failed = true }
            r.*.at += 1
            return value
        }
        return hexDigits(r, 2, true)
    }
    if c == 116 { return 9 }
    if c == 110 { return 10 }
    if c == 114 { return 13 }
    if c == 102 { return 12 }
    if c == 118 { return 11 }
    if c == 97 { return 7 }
    if c == 101 { return 27 }
    return c
}

// The property name between `[:` and `:]` or `\p{` and `}`, as a C string.
fn propertyName(r: *Reader, close: i32, closeNext: i32) -> m.Bytes {
    var name = m.bytesBuffer()
    while true {
        const c = peek(r)
        if c < 0 {
            r.*.failed = true
            break
        }
        if c == close && (closeNext < 0 || peekAt(r, 1) == closeNext) {
            r.*.at += if closeNext < 0 { 1 } else { 2 }
            break
        }
        if c > 127 { r.*.failed = true }
        if !isSpace(c) { m.pushByte(&name, @intCast(u8, c & 127)) }
        r.*.at += 1
    }
    m.pushByte(&name, 0)
    return name
}

// The code points of a property (`P`, `WSpace`, `Han`, `gc=Zs`,
// `Script=Latin`, `Any`, `ASCII`, `Assigned`) added to `set`.
fn addProperty(set: usize, name: usize, negated: bool, r: *Reader) -> void {
    var kind: u32 = 0
    var which: i32 = 0
    var value: i32 = 0
    const text = m.cSlice(name)
    var equals: usize = 0
    while equals < text.length && text[equals] != 61 { equals += 1 }
    if equals < text.length {
        m.put8(name + equals, 0)
        which = p.u_getPropertyEnum(name)
        const valueName = name + equals + 1
        if which == GENERAL_CATEGORY || which == GENERAL_CATEGORY_MASK {
            kind = 1
            value = p.u_getPropertyValueEnum(GENERAL_CATEGORY_MASK, valueName)
        } else if which >= 0 {
            kind = 2
            value = p.u_getPropertyValueEnum(which, valueName)
        }
        if which < 0 || value < 0 { kind = 0 }
    } else if m.same(text, "Any") {
        kind = 3
    } else if m.same(text, "ASCII") {
        kind = 4
    } else if m.same(text, "Assigned") {
        kind = 5
    } else {
        value = p.u_getPropertyValueEnum(GENERAL_CATEGORY_MASK, name)
        if value > 0 {
            kind = 1
        } else {
            which = p.u_getPropertyEnum(name)
            if which >= 0 && which < BINARY_LIMIT {
                kind = 2
                value = 1
            } else {
                value = p.u_getPropertyValueEnum(SCRIPT, name)
                if value >= 0 {
                    kind = 2
                    which = SCRIPT
                }
            }
        }
    }
    if kind == 0 {
        r.*.failed = true
        r.*.unknown = true
        return
    }
    var c: i32 = 0
    var runStart: i32 = -1
    while c <= @intCast(i32, MAX) {
        var inside = false
        if kind == 1 {
            inside = (p.categoryMask(c) & @bitCast(u32, value)) != 0
        } else if kind == 2 {
            inside = p.intValue(c, which) == value
        } else if kind == 3 {
            inside = true
        } else if kind == 4 {
            inside = c < 128
        } else {
            inside = p.category(c) != 0
        }
        if negated { inside = !inside }
        if inside && runStart < 0 { runStart = c }
        if !inside && runStart >= 0 {
            uset_addRange(set, runStart, c - 1)
            runStart = -1
        }
        c += 1
    }
    if runStart >= 0 { uset_addRange(set, runStart, @intCast(i32, MAX)) }
}

// A set at the reader (`[...]`, `[:name:]`, `\p{name}`, `\P{name}`)
// added to `set`.
fn readSet(r: *Reader, set: usize) -> void {
    if peek(r) == 91 && peekAt(r, 1) == 58 {
        r.*.at += 2
        var negated = false
        if peek(r) == 94 {
            negated = true
            r.*.at += 1
        }
        var name = propertyName(r, 58, 93)
        addProperty(set, name.address, negated, r)
        m.release(name.address)
        return
    }
    if peek(r) == 92 && (peekAt(r, 1) == 112 || peekAt(r, 1) == 80) && peekAt(r, 2) == 123 {
        const negated = peekAt(r, 1) == 80
        r.*.at += 3
        var name = propertyName(r, 125, -1)
        addProperty(set, name.address, negated, r)
        m.release(name.address)
        return
    }
    if peek(r) != 91 {
        r.*.failed = true
        return
    }
    r.*.at += 1
    var negated = false
    if peek(r) == 94 {
        negated = true
        r.*.at += 1
    }
    const inner = uset_openEmpty()
    var previous: i32 = -1
    while !r.*.failed {
        skipSpace(r)
        const c = peek(r)
        if c < 0 {
            r.*.failed = true
            break
        }
        if c == 93 {
            r.*.at += 1
            break
        }
        if c == 91 || (c == 92 && (peekAt(r, 1) == 112 || peekAt(r, 1) == 80)) {
            readSet(r, inner)
            previous = -1
            continue
        }
        if c == 45 && previous >= 0 {
            r.*.at += 1
            skipSpace(r)
            const next = peek(r)
            if next == 93 {
                // A `-` before the end: itself.
                uset_add(inner, 45)
                continue
            }
            var last: i32 = 0
            if next == 92 {
                r.*.at += 1
                last = escaped(r)
            } else {
                last = next
                r.*.at += 1
            }
            if last < previous {
                r.*.failed = true
                break
            }
            uset_addRange(inner, previous, last)
            previous = -1
            continue
        }
        var code: i32 = c
        r.*.at += 1
        if c == 92 { code = escaped(r) }
        uset_add(inner, code)
        previous = code
    }
    if negated { uset_complement(inner) }
    uset_addAll(set, inner)
    uset_close(inner)
}

pub fn uset_openPattern(pattern: usize, length: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if pattern == 0 || length < -1 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    var r = Reader.{ .text = m.buffer(), .at = 0, .failed = false, .unknown = false }
    m.decode16(&r.text, pattern, m.units(pattern, length))
    const set = uset_openEmpty()
    if set == 0 {
        m.dispose(&r.text)
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    skipSpace(&r)
    readSet(&r, set)
    skipSpace(&r)
    if r.failed || r.at != r.text.length {
        m.dispose(&r.text)
        uset_close(set)
        m.setError(status, if r.unknown { m.ILLEGAL_ARGUMENT_ERROR } else { MALFORMED_SET })
        return 0
    }
    m.dispose(&r.text)
    return set
}
