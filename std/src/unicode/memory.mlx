// What std.unicode's ICU-level functions stand on (the C API of
// compiler/capi/icu is made of them): their working memory, and what
// they hand to C or C hands back, comes from C's allocator; the rest is
// memory by address and ICU's error codes.
extern("c") fn calloc(count: usize, size: usize) -> usize
extern("c") fn realloc(address: usize, size: usize) -> usize
extern("c") fn free(address: usize) -> void

// `size` zeroed bytes (0 when there is no memory).
pub fn alloc(size: usize) -> usize { return calloc(1, if size == 0 { 1 } else { size }) }

pub fn release(address: usize) -> void {
    if address != 0 { free(address) }
}

pub fn grow(address: usize, size: usize) -> usize { return realloc(address, size) }

pub fn get8(address: usize) -> u8 { unsafe { return @ptrFromInt(*u8, address).* } }
pub fn put8(address: usize, value: u8) -> void { unsafe { @ptrFromInt(*u8, address).* = value } }
pub fn get16(address: usize) -> u16 { unsafe { return @ptrFromInt(*u16, address).* } }
pub fn put16(address: usize, value: u16) -> void { unsafe { @ptrFromInt(*u16, address).* = value } }
pub fn get32(address: usize) -> u32 { unsafe { return @ptrFromInt(*u32, address).* } }
pub fn put32(address: usize, value: u32) -> void { unsafe { @ptrFromInt(*u32, address).* = value } }
pub fn get64(address: usize) -> u64 { unsafe { return @ptrFromInt(*u64, address).* } }
pub fn put64(address: usize, value: u64) -> void { unsafe { @ptrFromInt(*u64, address).* = value } }
pub fn getWord(address: usize) -> usize { unsafe { return @ptrFromInt(*usize, address).* } }
pub fn putWord(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*usize, address).* = value } }
pub fn getI32(address: usize) -> i32 { return @bitCast(i32, get32(address)) }
pub fn putI32(address: usize, value: i32) -> void { put32(address, @bitCast(u32, value)) }
pub fn getI64(address: usize) -> i64 { return @bitCast(i64, get64(address)) }
pub fn putI64(address: usize, value: i64) -> void { put64(address, @bitCast(u64, value)) }

pub fn copy(target: usize, source: usize, count: usize) -> void {
    if target == source { return }
    if target < source || target >= source + count {
        var index: usize = 0
        while index < count {
            put8(target + index, get8(source + index))
            index += 1
        }
    } else {
        var index = count
        while index > 0 {
            index -= 1
            put8(target + index, get8(source + index))
        }
    }
}

pub fn zero(target: usize, count: usize) -> void {
    var index: usize = 0
    while index < count {
        put8(target + index, 0)
        index += 1
    }
}

pub fn bytes(address: usize, length: usize) -> []const u8 {
    var view: [*]const u8 = undefined
    unsafe { view = @ptrFromInt([*]const u8, address) }
    return view[0..length]
}

// The address of a literal's bytes (a NUL follows them), for C.
pub fn literal(text: []const u8) -> usize { return @intFromPtr(text.pointer) }

pub fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

// A C string's length.
pub fn cLength(text: usize) -> usize {
    if text == 0 { return 0 }
    var count: usize = 0
    while get8(text + count) != 0 { count += 1 }
    return count
}

pub fn cSlice(text: usize) -> []const u8 { return bytes(text, cLength(text)) }

// ---------------------------------------------------------------------------
// C's error codes (UErrorCode).

pub const ZERO_ERROR: i32 = 0
pub const ILLEGAL_ARGUMENT_ERROR: i32 = 1
pub const MISSING_RESOURCE_ERROR: i32 = 2
pub const INTERNAL_PROGRAM_ERROR: i32 = 5
pub const MEMORY_ALLOCATION_ERROR: i32 = 7
pub const INDEX_OUTOFBOUNDS_ERROR: i32 = 8
pub const INVALID_CHAR_FOUND: i32 = 10
pub const BUFFER_OVERFLOW_ERROR: i32 = 15
pub const UNSUPPORTED_ERROR: i32 = 16
pub const RESOURCE_TYPE_MISMATCH: i32 = 17
pub const STRING_NOT_TERMINATED_WARNING: i32 = -124
pub const USING_DEFAULT_WARNING: i32 = -127

// Whether the code at `status` (an UErrorCode *) is already a failure.
pub fn failed(status: usize) -> bool { return status == 0 || getI32(status) > 0 }

pub fn setError(status: usize, code: i32) -> void {
    if status != 0 { putI32(status, code) }
}

// A string's length given C's (-1: up to its NUL), in UTF-16 units.
pub fn units(text: usize, length: i32) -> usize {
    if length >= 0 { return @intCast(usize, length) }
    var count: usize = 0
    while get16(text + count * 2) != 0 { count += 1 }
    return count
}

// Ends a result of `length` units written into `capacity`: a NUL when
// there is room, else the warning or the overflow; the length for C.
pub fn terminate(dest: usize, length: usize, capacity: i32, status: usize) -> i32 {
    const room = if capacity > 0 { @intCast(usize, capacity) } else { 0 }
    if length < room {
        put16(dest + length * 2, 0)
        if getI32(status) == STRING_NOT_TERMINATED_WARNING { putI32(status, ZERO_ERROR) }
    } else if length == room {
        if getI32(status) <= 0 { putI32(status, STRING_NOT_TERMINATED_WARNING) }
    } else {
        putI32(status, BUFFER_OVERFLOW_ERROR)
    }
    return @intCast(i32, length)
}

// The same for a string of bytes.
pub fn terminate8(dest: usize, length: usize, capacity: i32, status: usize) -> i32 {
    const room = if capacity > 0 { @intCast(usize, capacity) } else { 0 }
    if length < room {
        put8(dest + length, 0)
        if getI32(status) == STRING_NOT_TERMINATED_WARNING { putI32(status, ZERO_ERROR) }
    } else if length == room {
        if getI32(status) <= 0 { putI32(status, STRING_NOT_TERMINATED_WARNING) }
    } else {
        putI32(status, BUFFER_OVERFLOW_ERROR)
    }
    return @intCast(i32, length)
}

// ---------------------------------------------------------------------------
// A growing buffer of 32-bit values (code points) in C memory.

pub const Buffer = struct {
    address: usize
    length: usize
    capacity: usize
}

pub fn buffer() -> Buffer { return Buffer.{ .address = 0, .length = 0, .capacity = 0 } }

pub fn push(b: *Buffer, value: u32) -> void {
    if b.*.length == b.*.capacity {
        const larger = if b.*.capacity == 0 { 64 } else { b.*.capacity * 2 }
        const address = grow(b.*.address, larger * 4)
        if address == 0 { return }
        b.*.address = address
        b.*.capacity = larger
    }
    put32(b.*.address + b.*.length * 4, value)
    b.*.length += 1
}

pub fn at(b: *Buffer, index: usize) -> u32 { return get32(b.*.address + index * 4) }

pub fn setAt(b: *Buffer, index: usize, value: u32) -> void { put32(b.*.address + index * 4, value) }

pub fn dispose(b: *Buffer) -> void {
    release(b.*.address)
    b.*.address = 0
    b.*.length = 0
    b.*.capacity = 0
}

// Reads the code points of UTF-16 `text` (`length` units) into `b`.
pub fn decode16(b: *Buffer, text: usize, length: usize) -> void {
    var index: usize = 0
    while index < length {
        var c = @intCast(u32, get16(text + index * 2))
        index += 1
        if c >= 55296 && c <= 56319 && index < length {
            const trail = @intCast(u32, get16(text + index * 2))
            if trail >= 56320 && trail <= 57343 {
                c = (c << 10) + trail - 56613888
                index += 1
            }
        }
        push(b, c)
    }
}

// Writes the code points of `b` as UTF-16 into `dest` (up to `capacity`
// units); the units they take.
pub fn encode16(b: *Buffer, dest: usize, capacity: usize) -> usize {
    var length: usize = 0
    var index: usize = 0
    while index < b.*.length {
        const c = at(b, index)
        if c < 65536 {
            if length < capacity { put16(dest + length * 2, @intCast(u16, c)) }
            length += 1
        } else {
            if length + 1 < capacity {
                put16(dest + length * 2, @intCast(u16, (c >> 10) + 55232))
                put16(dest + length * 2 + 2, @intCast(u16, (c & 1023) | 56320))
            }
            length += 2
        }
        index += 1
    }
    return length
}

// ---------------------------------------------------------------------------
// Text built up byte by byte in C memory.

pub const Bytes = struct {
    address: usize
    length: usize
    capacity: usize
}

pub fn bytesBuffer() -> Bytes { return Bytes.{ .address = 0, .length = 0, .capacity = 0 } }

pub fn pushByte(b: *Bytes, value: u8) -> void {
    if b.*.length + 1 >= b.*.capacity {
        const larger = if b.*.capacity == 0 { 64 } else { b.*.capacity * 2 }
        const address = grow(b.*.address, larger)
        if address == 0 { return }
        b.*.address = address
        b.*.capacity = larger
    }
    put8(b.*.address + b.*.length, value)
    b.*.length += 1
    put8(b.*.address + b.*.length, 0)
}

pub fn pushText(b: *Bytes, text: []const u8) -> void {
    var index: usize = 0
    while index < text.length {
        pushByte(b, text[index])
        index += 1
    }
}

pub fn bytesText(b: *Bytes) -> []const u8 {
    if b.*.address == 0 { return "" }
    return bytes(b.*.address, b.*.length)
}

pub fn disposeBytes(b: *Bytes) -> void {
    release(b.*.address)
    b.*.address = 0
    b.*.length = 0
    b.*.capacity = 0
}

// Copies `text` into C's buffer `dest` of `capacity` bytes, with the
// NUL and the status as for strings; its length.
pub fn give(text: []const u8, dest: usize, capacity: i32, status: usize) -> i32 {
    const room = if capacity > 0 { @intCast(usize, capacity) } else { 0 }
    var index: usize = 0
    while index < text.length && index < room {
        put8(dest + index, text[index])
        index += 1
    }
    return terminate8(dest, text.length, capacity, status)
}
