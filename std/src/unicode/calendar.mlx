// UCalendarLimitType's MINIMUM to LEAST_MAXIMUM in the tables' order
// (minimum, greatest minimum, least maximum, maximum).
fn tableColumn(kind: i32) -> usize {
    if kind == MINIMUM { return 0 }
    if kind == GREATEST_MINIMUM { return 1 }
    if kind == LEAST_MAXIMUM { return 2 }
    return 3
}

fn limit(c: *Calendar, field: usize, kind: i32) -> i64 {
    if field == DAY_OF_WEEK || field == AM_PM || field == HOUR || field == HOUR_OF_DAY || field == MINUTE || field == SECOND || field == MILLISECOND || field == ZONE_OFFSET || field == DST_OFFSET || field == DOW_LOCAL || field == JULIAN_DAY || field == MILLISECONDS_IN_DAY || field == IS_LEAP_MONTH {
        return CALENDAR_LIMITS[field * 4 + tableColumn(kind)]
    }
    if field == WEEK_OF_MONTH {
        if kind == MINIMUM { return if c.*.minimalDays == 1 { 1 } else { 0 } }
        if kind == GREATEST_MINIMUM { return 1 }
        const daysInMonth = handleGetLimit(c, DATE, kind)
        if kind == LEAST_MAXIMUM { return (daysInMonth + (7 - c.*.minimalDays)) / 7 }
        return (daysInMonth + 6 + (7 - c.*.minimalDays)) / 7
    }
    return handleGetLimit(c, field, kind)
}

// A field's limit by the calendar's type (ICU's handleGetLimit).
fn handleGetLimit(c: *Calendar, field: usize, kind: i32) -> i64 {
    const k = c.*.kind
    const at = field * 4 + tableColumn(kind)
    const least = kind == MINIMUM || kind == GREATEST_MINIMUM
    if isGregorianFamily(c) {
        if field == ERA {
            if k == BUDDHIST { return 0 }
            if k == ROC { return if least { 0 } else { 1 } }
            if k == JAPANESE { return if least { 0 } else { @intCast(i64, eraCount()) - 1 } }
        }
        if field == YEAR && k == JAPANESE {
            if kind == MAXIMUM { return GREGORIAN_LIMITS[YEAR * 4 + 3] - eraStartYear(currentEra()) }
            return 1
        }
        return GREGORIAN_LIMITS[at]
    }
    if isChinese(c) { return CHINESE_LIMITS[at] }
    if k == HEBREW { return HEBREW_LIMITS[at] }
    if isIslamic(c) { return ISLAMIC_LIMITS[at] }
    if k == PERSIAN { return PERSIAN_LIMITS[at] }
    if k == INDIAN { return INDIAN_LIMITS[at] }
    if k == ETHIOPIC_AMETE_ALEM && field == ERA { return 0 }
    return CE_LIMITS[at]
}

// What a field may be at the calendar's moment.
fn prepareGetActual(c: *Calendar, field: usize, isMinimum: bool) -> void {
    set(c, MILLISECONDS_IN_DAY, 0)
    if field == YEAR || field == EXTENDED_YEAR {
        set(c, DAY_OF_YEAR, limit(c, DAY_OF_YEAR, GREATEST_MINIMUM))
    } else if field == YEAR_WOY {
        set(c, WEEK_OF_YEAR, limit(c, WEEK_OF_YEAR, GREATEST_MINIMUM))
        set(c, DATE, limit(c, DATE, GREATEST_MINIMUM))
    } else if field == MONTH {
        set(c, DATE, limit(c, DATE, GREATEST_MINIMUM))
    } else if field == DAY_OF_WEEK_IN_MONTH {
        set(c, DATE, 1)
        var ok = true
        set(c, DAY_OF_WEEK, get(c, DAY_OF_WEEK, &ok))
    } else if field == WEEK_OF_MONTH || field == WEEK_OF_YEAR {
        var dow = c.*.firstDayOfWeek
        if isMinimum {
            dow = (dow + 6) % 7
            if dow < 1 { dow += 7 }
        }
        set(c, DAY_OF_WEEK, dow)
    }
    set(c, field, limit(c, field, GREATEST_MINIMUM))
}

fn actualHelper(c: *Calendar, field: usize, startValue: i64, endValue: i64) -> i64 {
    if startValue == endValue { return startValue }
    const delta: i64 = if endValue > startValue { 1 } else { -1 }
    var work = c.*
    var ok = true
    _ = complete(&work)
    work.lenient = true
    prepareGetActual(&work, field, delta < 0)
    set(&work, field, startValue)
    var value = startValue
    var result = startValue
    if get(&work, field, &ok) != startValue && field != WEEK_OF_MONTH && delta > 0 { return result }
    while value != endValue {
        value += delta
        add(&work, field, delta, &ok)
        if get(&work, field, &ok) != value || !ok { break }
        result = value
    }
    return result
}

fn actualMaximum(c: *Calendar, field: usize) -> i64 {
    var ok = true
    if field == DATE {
        var work = c.*
        work.lenient = true
        prepareGetActual(&work, field, false)
        return monthLength(c, get(&work, EXTENDED_YEAR, &ok), get(&work, MONTH, &ok))
    }
    if field == DAY_OF_YEAR {
        var work = c.*
        work.lenient = true
        prepareGetActual(&work, field, false)
        return yearLength(c, get(&work, EXTENDED_YEAR, &ok))
    }
    if field == DAY_OF_WEEK || field == AM_PM || field == HOUR || field == HOUR_OF_DAY || field == MINUTE || field == SECOND || field == MILLISECOND || field == ZONE_OFFSET || field == DST_OFFSET || field == DOW_LOCAL || field == JULIAN_DAY || field == MILLISECONDS_IN_DAY {
        return limit(c, field, MAXIMUM)
    }
    if field == ORDINAL_MONTH { return if inTemporalLeapYear(c) { limit(c, field, MAXIMUM) } else { limit(c, field, LEAST_MAXIMUM) } }
    if field == YEAR && c.*.kind == JAPANESE {
        // The years of the era: to the next era's start.
        const era = get(c, ERA, &ok)
        if era >= @intCast(i64, eraCount()) - 1 { return handleGetLimit(c, YEAR, MAXIMUM) }
        const next = eraStart(era + 1)
        var maxYear = next.year - eraStartYear(era) + 1
        if next.month == 1 && next.day == 1 { maxYear -= 1 }
        return maxYear
    }
    if field == YEAR && isGregorianFamily(c) { return limit(c, YEAR, LEAST_MAXIMUM) }
    return actualHelper(c, field, limit(c, field, LEAST_MAXIMUM), limit(c, field, MAXIMUM))
}

// Whether the year has a leap month or day (ICU's inTemporalLeapYear).
fn inTemporalLeapYear(c: *Calendar) -> bool {
    if c.*.kind == HEBREW {
        var ok = true
        return systems.hebrewIsLeap(get(c, EXTENDED_YEAR, &ok))
    }
    const days = actualMaximum(c, DAY_OF_YEAR)
    if isChinese(c) { return days > 360 }
    if isIslamic(c) { return days == 355 }
    return days == 366
}

fn actualMinimum(c: *Calendar, field: usize) -> i64 {
    // The Gregorian calendar's are its minima.
    if isGregorianFamily(c) { return limit(c, field, MINIMUM) }
    var value = limit(c, field, GREATEST_MINIMUM)
    const end = limit(c, field, MINIMUM)
    if value == end { return value }
    var work = c.*
    var ok = true
    work.lenient = true
    var result = value
    while value >= end {
        set(&work, field, value)
        if get(&work, field, &ok) != value { break }
        result = value
        value -= 1
    }
    return result
}

fn pinField(c: *Calendar, field: usize) -> void {
    const max = actualMaximum(c, field)
    const min = actualMinimum(c, field)
    if c.*.fields[field] > max {
        set(c, field, max)
    } else if c.*.fields[field] < min {
        set(c, field, min)
    }
}

// ---------------------------------------------------------------------------
// add and roll

// Whether the years of era 0 count backwards (ICU checks the type:
// gregorian, roc and coptic).
fn yearsGoBackwardInEra0(c: *Calendar) -> bool { return c.*.kind == GREGORIAN || c.*.kind == ROC || c.*.kind == COPTIC }

fn add(c: *Calendar, field: usize, amount: i64, ok: *bool) -> void {
    if amount == 0 { return }
    if (field == MONTH || field == ORDINAL_MONTH) && isChinese(c) {
        // By new moons, a leap month counted.
        const dom = get(c, DATE, ok)
        const day = get(c, JULIAN_DAY, ok) - EPOCH_JULIAN_DAY
        chineseOffsetMonth(c, day - dom + 1, dom, amount, ok)
        return
    }
    if (field == MONTH || field == ORDINAL_MONTH) && c.*.kind == HEBREW {
        // Adar I skipped in a common year.
        var month = get(c, MONTH, ok)
        var year = get(c, YEAR, ok)
        var acrossAdar1 = false
        if amount > 0 {
            acrossAdar1 = month < systems.ADAR_1
            month += amount
            while true {
                if acrossAdar1 && month >= systems.ADAR_1 && !systems.hebrewIsLeap(year) { month += 1 }
                if month <= 12 { break }
                month -= 13
                year += 1
                acrossAdar1 = true
            }
        } else {
            acrossAdar1 = month > systems.ADAR_1
            month += amount
            while true {
                if acrossAdar1 && month <= systems.ADAR_1 && !systems.hebrewIsLeap(year) { month -= 1 }
                if month >= 0 { break }
                month += 13
                year -= 1
                acrossAdar1 = true
            }
        }
        set(c, MONTH, month)
        set(c, YEAR, year)
        pinField(c, DATE)
        return
    }
    var delta = amount
    var keepWallTime = true
    var count = amount
    if field == ERA {
        set(c, field, get(c, field, ok) + amount)
        pinField(c, ERA)
        return
    }
    if field == YEAR || field == YEAR_WOY || field == EXTENDED_YEAR || field == MONTH || field == ORDINAL_MONTH {
        if (field == YEAR || field == YEAR_WOY) && get(c, ERA, ok) == 0 && yearsGoBackwardInEra0(c) { count = -amount }
        const wasLenient = c.*.lenient
        c.*.lenient = true
        set(c, field, get(c, field, ok) + count)
        pinField(c, DATE)
        if !wasLenient {
            if !complete(c) { ok.* = false }
            c.*.lenient = wasLenient
        }
        return
    }
    if field == WEEK_OF_YEAR || field == WEEK_OF_MONTH || field == DAY_OF_WEEK_IN_MONTH {
        delta *= WEEK_MS
    } else if field == AM_PM {
        delta *= 12 * HOUR_MS
    } else if field == DATE || field == DAY_OF_YEAR || field == DAY_OF_WEEK || field == DOW_LOCAL || field == JULIAN_DAY {
        delta *= DAY_MS
    } else if field == HOUR_OF_DAY || field == HOUR {
        delta *= HOUR_MS
        keepWallTime = false
    } else if field == MINUTE {
        delta *= MINUTE_MS
        keepWallTime = false
    } else if field == SECOND {
        delta *= SECOND_MS
        keepWallTime = false
    } else if field == MILLISECOND || field == MILLISECONDS_IN_DAY {
        keepWallTime = false
    } else {
        ok.* = false
        return
    }
    var previousOffset: i64 = 0
    var previousWallTime: i64 = 0
    if keepWallTime {
        previousOffset = get(c, DST_OFFSET, ok) + get(c, ZONE_OFFSET, ok)
        previousWallTime = get(c, MILLISECONDS_IN_DAY, ok)
    }
    setTime(c, getTime(c, ok) + delta)
    if keepWallTime {
        var newWallTime = get(c, MILLISECONDS_IN_DAY, ok)
        if newWallTime != previousWallTime {
            const t = c.*.time
            const newOffset = get(c, DST_OFFSET, ok) + get(c, ZONE_OFFSET, ok)
            if newOffset != previousOffset {
                var adjust = previousOffset - newOffset
                adjust = if adjust >= 0 { adjust % DAY_MS } else { -((-adjust) % DAY_MS) }
                if adjust != 0 {
                    setTime(c, t + adjust)
                    newWallTime = get(c, MILLISECONDS_IN_DAY, ok)
                }
                if newWallTime != previousWallTime {
                    if c.*.skippedWallTime == WALLTIME_FIRST {
                        if adjust > 0 { setTime(c, t) }
                    } else if c.*.skippedWallTime == WALLTIME_LAST {
                        if adjust < 0 { setTime(c, t) }
                    } else {
                        const base = if adjust > 0 { c.*.time } else { t }
                        var transition: i64 = 0
                        if previousTransition(c, base, true, &transition) { setTime(c, transition) } else { ok.* = false }
                    }
                }
            }
        }
    }
}

fn roll(c: *Calendar, field: usize, amount: i64, ok: *bool) -> void {
    if (field == MONTH || field == ORDINAL_MONTH) && c.*.kind == HEBREW {
        // Through the months of the year, Adar I only in a leap year.
        const month = get(c, MONTH, ok)
        const year = get(c, YEAR, ok)
        const leap = systems.hebrewIsLeap(year)
        var newMonth = month + amount % systems.hebrewMonthsInYear(year)
        if !leap {
            if amount > 0 && month < systems.ADAR_1 && newMonth >= systems.ADAR_1 {
                newMonth += 1
            } else if amount < 0 && month > systems.ADAR_1 && newMonth <= systems.ADAR_1 {
                newMonth -= 1
            }
        }
        set(c, MONTH, (newMonth + 13) % 13)
        pinField(c, DATE)
        return
    }
    if (field == MONTH || field == ORDINAL_MONTH) && isChinese(c) {
        if amount != 0 { chineseRollMonth(c, amount, ok) }
        return
    }
    if amount == 0 { return }
    if !complete(c) {
        ok.* = false
        return
    }
    if field == DATE || field == AM_PM || field == MINUTE || field == SECOND || field == MILLISECOND || field == MILLISECONDS_IN_DAY || field == ERA {
        const min = actualMinimum(c, field)
        const max = actualMaximum(c, field)
        const gap = max - min + 1
        var value = (internalGet(c, field) + amount - min) % gap
        if value < 0 { value += gap }
        set(c, field, value + min)
        return
    }
    if field == HOUR || field == HOUR_OF_DAY {
        const start = getTime(c, ok)
        const oldHour = internalGet(c, field)
        const max = limit(c, field, MAXIMUM)
        var newHour = (oldHour + amount) % (max + 1)
        if newHour < 0 { newHour += max + 1 }
        setTime(c, start + HOUR_MS * (newHour - oldHour))
        return
    }
    if field == MONTH || field == ORDINAL_MONTH {
        const max = actualMaximum(c, MONTH) + 1
        var month = (internalGet(c, MONTH) + amount) % max
        if month < 0 { month += max }
        set(c, MONTH, month)
        pinField(c, DATE)
        return
    }
    if field == YEAR || field == YEAR_WOY {
        var count = amount
        var backwards = false
        const era = get(c, ERA, ok)
        if era == 0 && yearsGoBackwardInEra0(c) {
            count = -amount
            backwards = true
        }
        var year = internalGet(c, field) + count
        if era > 0 || year >= 1 {
            const maxYear = actualMaximum(c, field)
            if maxYear < 32768 {
                if year < 1 {
                    year = maxYear - ((-year) % maxYear)
                } else if year > maxYear {
                    year = ((year - 1) % maxYear) + 1
                }
            } else if year < 1 {
                year = 1
            }
        } else if backwards {
            year = 1
        }
        set(c, field, year)
        pinField(c, MONTH)
        pinField(c, DATE)
        return
    }
    if field == EXTENDED_YEAR {
        set(c, field, internalGet(c, field) + amount)
        pinField(c, MONTH)
        pinField(c, DATE)
        return
    }
    if field == WEEK_OF_MONTH {
        const dow = floorModulo(internalGet(c, DAY_OF_WEEK) - c.*.firstDayOfWeek, 7)
        const fdm = floorModulo(dow - internalGet(c, DATE) + 1, 7)
        const start = if 7 - fdm < c.*.minimalDays { 8 - fdm } else { 1 - fdm }
        const monthLen = actualMaximum(c, DATE)
        const ldm = (monthLen - internalGet(c, DATE) + dow) % 7
        const limitDay = monthLen + 7 - ldm
        const gap = limitDay - start
        if gap == 0 {
            ok.* = false
            return
        }
        var day = (internalGet(c, DATE) + amount * 7 - start) % gap
        if day < 0 { day += gap }
        day += start
        if day < 1 { day = 1 }
        if day > monthLen { day = monthLen }
        set(c, DATE, day)
        return
    }
    if field == WEEK_OF_YEAR && !isGregorianFamily(c) {
        // Calendar::roll's: by the day of the year, the month cleared.
        const dow = floorModulo(internalGet(c, DAY_OF_WEEK) - c.*.firstDayOfWeek, 7)
        const fdy = floorModulo(dow - internalGet(c, DAY_OF_YEAR) + 1, 7)
        const start = if 7 - fdy < c.*.minimalDays { 8 - fdy } else { 1 - fdy }
        const yearLen = actualMaximum(c, DAY_OF_YEAR)
        const ldy = (yearLen - internalGet(c, DAY_OF_YEAR) + dow) % 7
        const limitDay = yearLen + 7 - ldy
        const gap = limitDay - start
        if gap == 0 {
            ok.* = false
            return
        }
        var day = (internalGet(c, DAY_OF_YEAR) + amount * 7 - start) % gap
        if day < 0 { day += gap }
        day += start
        if day < 1 { day = 1 }
        if day > yearLen { day = yearLen }
        set(c, DAY_OF_YEAR, day)
        clearField(c, MONTH)
        clearField(c, ORDINAL_MONTH)
        return
    }
    if field == WEEK_OF_YEAR {
        var woy = get(c, WEEK_OF_YEAR, ok)
        const isoYear = get(c, YEAR_WOY, ok)
        var isoDoy = internalGet(c, DAY_OF_YEAR)
        if internalGet(c, MONTH) == 0 {
            if woy >= 52 { isoDoy += yearLength(c, isoYear) }
        } else {
            if woy == 1 { isoDoy -= yearLength(c, isoYear - 1) }
        }
        woy += amount
        if woy < 1 || woy > 52 {
            var lastDoy = yearLength(c, isoYear)
            const lastRelDow = floorModulo(lastDoy - isoDoy + internalGet(c, DAY_OF_WEEK) - c.*.firstDayOfWeek, 7)
            if 6 - lastRelDow >= c.*.minimalDays { lastDoy -= 7 }
            const lastWoy = weekNumberOf(c, lastDoy, lastDoy, lastRelDow + 1)
            woy = floorModulo(woy + lastWoy - 1, lastWoy) + 1
        }
        set(c, WEEK_OF_YEAR, woy)
        set(c, YEAR_WOY, isoYear)
        return
    }
    if field == DAY_OF_YEAR {
        const delta = amount * DAY_MS
        const min = c.*.time - (internalGet(c, DAY_OF_YEAR) - 1) * DAY_MS
        const oneYear = actualMaximum(c, DAY_OF_YEAR) * DAY_MS
        var time = (c.*.time + delta - min) % oneYear
        if time < 0 { time += oneYear }
        setTime(c, time + min)
        return
    }
    if field == DAY_OF_WEEK || field == DOW_LOCAL {
        const delta = amount * DAY_MS
        var lead = internalGet(c, field) - (if field == DAY_OF_WEEK { c.*.firstDayOfWeek } else { 1 })
        if lead < 0 { lead += 7 }
        const min = c.*.time - lead * DAY_MS
        var time = (c.*.time + delta - min) % WEEK_MS
        if time < 0 { time += WEEK_MS }
        setTime(c, time + min)
        return
    }
    if field == DAY_OF_WEEK_IN_MONTH {
        const delta = amount * WEEK_MS
        const preWeeks = (internalGet(c, DATE) - 1) / 7
        const postWeeks = (actualMaximum(c, DATE) - internalGet(c, DATE)) / 7
        const min = c.*.time - preWeeks * WEEK_MS
        const gap = WEEK_MS * (preWeeks + postWeeks + 1)
        var time = (c.*.time + delta - min) % gap
        if time < 0 { time += gap }
        setTime(c, time + min)
        return
    }
    if field == JULIAN_DAY {
        set(c, field, internalGet(c, field) + amount)
        return
    }
    ok.* = false
}

// The Chinese calendar's day DOM of the month DELTA months from the one
// that begins at day NEWMOON (the last day of a shorter month for a 30th).
fn chineseOffsetMonth(c: *Calendar, newMoonIn: i64, dom: i64, delta: i64, ok: *bool) -> void {
    const value = @floatFromInt(f64, newMoonIn) + 29.530588853 * (@floatFromInt(f64, delta) - 0.5)
    if value < -2147483648.0 || value > 2147483647.0 {
        ok.* = false
        return
    }
    var newMoon = @intFromFloat(i64, @trunc(value))
    newMoon = systems.newMoonNear(c.*.kind == DANGI, @floatFromInt(f64, newMoon), true)
    const julianDay = newMoon + EPOCH_JULIAN_DAY - 1 + dom
    if dom > 29 {
        set(c, JULIAN_DAY, julianDay - 1)
        if !complete(c) {
            ok.* = false
            return
        }
        if actualMaximum(c, DATE) >= dom { set(c, JULIAN_DAY, julianDay) }
    } else {
        set(c, JULIAN_DAY, julianDay)
    }
}

// The Chinese calendar's months rolled within the year (13 with a leap
// month).
fn chineseRollMonth(c: *Calendar, amount: i64, ok: *bool) -> void {
    const dom = get(c, DATE, ok)
    const day = get(c, JULIAN_DAY, ok) - EPOCH_JULIAN_DAY
    const moon = day - dom + 1
    var month = get(c, MONTH, ok)
    const korea = c.*.kind == DANGI
    if c.*.hasLeapMonth {
        if get(c, IS_LEAP_MONTH, ok) == 1 {
            month += 1
        } else {
            var moon1 = moon - @intFromFloat(i64, @trunc(29.530588853 * (@floatFromInt(f64, month) - 0.5)))
            moon1 = systems.newMoonNear(korea, @floatFromInt(f64, moon1), true)
            if systems.isLeapMonthBetween(korea, moon1, moon) { month += 1 }
        }
    }
    const count: i64 = if c.*.hasLeapMonth { 13 } else { 12 }
    var newMonth = (month + amount) % count
    if newMonth < 0 { newMonth += count }
    if newMonth != month { chineseOffsetMonth(c, moon, dom, newMonth - month, ok) }
}

// ---------------------------------------------------------------------------
// The Japanese calendar's eras (ICU's EraRules): their first days from
// CLDR's calendarData (cldr.dat's supplemental data), read once.

const MAX_ERAS: usize = 256

const EraDate = struct {
    year: i64
    month: i64
    day: i64
}

var eraStarts: [256]EraDate = undefined
var erasRead: u32 = 0
var erasCount: usize = 0
var erasCurrent: i64 = 0
var erasLock: u32 = 0

// "645-6-19", "-542-01-01".
fn parseEraDate(text: []const u8, into: *EraDate) -> bool {
    var parts: [3]i64 = [3]i64{ 0, 0, 0 }
    var part: usize = 0
    var at: usize = 0
    var negative = false
    if at < text.length && text[at] == 45 {
        negative = true
        at += 1
    }
    var digits: usize = 0
    while at < text.length {
        const ch = text[at]
        if ch == 45 {
            if digits == 0 || part == 2 { return false }
            part += 1
            digits = 0
        } else if ch >= 48 && ch <= 57 {
            parts[part] = parts[part] * 10 + @intCast(i64, ch - 48)
            digits += 1
        } else {
            return false
        }
        at += 1
    }
    if part != 2 || digits == 0 { return false }
    into.*.year = if negative { -parts[0] } else { parts[0] }
    into.*.month = parts[1]
    into.*.day = parts[2]
    return true
}

fn encodeEra(year: i64, month: i64, day: i64) -> i64 { return year * 65536 + month * 256 + day }

fn readEras() -> void {
    if @atomicLoad(u32, &erasRead, acquire) != 0 { return }
    while @atomicRmw(u32, &erasLock, xchg, 1, acquire) != 0 {}
    if erasRead == 0 {
        const data = resources.supplemental()
        var count: usize = 0
        while count < MAX_ERAS {
            var key = m.bytesBuffer()
            m.pushText(&key, "calendarData/japanese/eras/")
            pushNumber(&key, count)
            m.pushText(&key, "/_start")
            var value: []const u8 = ""
            const found = resources.lookup(data, m.bytesText(&key), &value)
            m.disposeBytes(&key)
            if !found || !parseEraDate(value, &eraStarts[count]) { break }
            count += 1
        }
        if count == 0 {
            // No data: the Gregorian years as one era.
            eraStarts[0] = EraDate.{ .year = 1, .month = 1, .day = 1 }
            count = 1
        }
        erasCount = count
        // The era of today (ICU's current era, by the date in UTC here).
        const today = systems.dayToFields(floorDivide(now(), DAY_MS))
        const encoded = encodeEra(today.year, today.month + 1, today.dayOfMonth)
        var era = @intCast(i64, count) - 1
        while era > 0 && encoded < encodeEra(eraStarts[@intCast(usize, era)].year, eraStarts[@intCast(usize, era)].month, eraStarts[@intCast(usize, era)].day) { era -= 1 }
        erasCurrent = era
        @atomicStore(u32, &erasRead, 1, release)
    }
    @atomicStore(u32, &erasLock, 0, release)
}

fn pushNumber(into: *m.Bytes, value: usize) -> void {
    if value >= 10 { pushNumber(into, value / 10) }
    m.pushByte(into, @intCast(u8, 48 + value % 10))
}

fn eraCount() -> usize {
    readEras()
    return erasCount
}

fn currentEra() -> i64 {
    readEras()
    return erasCurrent
}

fn eraStart(era: i64) -> EraDate {
    readEras()
    if era < 0 || era >= @intCast(i64, erasCount) { return EraDate.{ .year = 2147483647, .month = 1, .day = 1 } }
    return eraStarts[@intCast(usize, era)]
}

fn eraStartYear(era: i64) -> i64 { return eraStart(era).year }

// The era of a Gregorian date (month 1 to 12).
fn eraIndex(year: i64, month: i64, day: i64) -> i64 {
    readEras()
    const encoded = encodeEra(year, month, day)
    var high = @intCast(i64, erasCount)
    var low: i64 = 0
    const current = eraStarts[@intCast(usize, erasCurrent)]
    if encodeEra(current.year, current.month, current.day) <= encoded { low = erasCurrent }
    while low < high - 1 {
        const middle = (low + high) / 2
        const start = eraStarts[@intCast(usize, middle)]
        if encodeEra(start.year, start.month, start.day) <= encoded {
            low = middle
        } else {
            high = middle
        }
    }
    return low
}

// ---------------------------------------------------------------------------
// The calendar of a locale

// The type named NAME (ICU's names, any case), UNKNOWN_TYPE for none.
pub fn typeNamed(name: []const u8) -> u8 {
    var kind: u8 = 0
    while kind < TYPE_COUNT {
        const candidate = typeName(kind)
        if candidate.length == name.length {
            var same = true
            var k: usize = 0
            while k < name.length {
                var a = name[k]
                if a >= 65 && a <= 90 { a += 32 }
                if a != candidate[k] { same = false }
                k += 1
            }
            if same { return kind }
        }
        kind += 1
    }
    return UNKNOWN_TYPE
}

pub fn typeName(kind: u8) -> []const u8 {
    var at: usize = 1
    var index: u8 = 0
    while at < TYPE_NAMES.length {
        var end = at
        while end < TYPE_NAMES.length && TYPE_NAMES[end] != 10 { end += 1 }
        if index == kind { return TYPE_NAMES[at..end] }
        index += 1
        at = end + 1
    }
    return "gregorian"
}

// The legacy names of BCP 47's calendar types (-u-ca-gregory...).
fn legacyTypeName(name: []const u8) -> []const u8 {
    if m.same(name, "gregory") { return "gregorian" }
    if m.same(name, "ethioaa") { return "ethiopic-amete-alem" }
    return name
}

// The calendars CLDR prefers in a region (calendarPreferenceData), the
// world's (001) for a region it does not list: their types in order
// into LIST, their count.
fn preferredTypes(region: u16, list: *[18]u8) -> usize {
    const data = resources.supplemental()
    var count: usize = 0
    var round: usize = 0
    while round < 2 && count == 0 {
        var index: usize = 0
        while index < 18 {
            var key = m.bytesBuffer()
            m.pushText(&key, "calendarPreferenceData/")
            if round == 0 && region != 0 {
                m.pushByte(&key, @intCast(u8, region >> 8))
                m.pushByte(&key, @intCast(u8, region & 255))
            } else {
                m.pushText(&key, "001")
            }
            m.pushByte(&key, 47)
            pushNumber(&key, index)
            var value: []const u8 = ""
            const found = resources.lookup(data, m.bytesText(&key), &value)
            m.disposeBytes(&key)
            if !found { break }
            const kind = typeNamed(value)
            if kind != UNKNOWN_TYPE && count < 18 {
                list.*[count] = kind
                count += 1
            }
            index += 1
        }
        round += 1
    }
    if count == 0 {
        list.*[0] = GREGORIAN
        count = 1
    }
    return count
}

// The calendar of locale ID: its "calendar" keyword's (the BCP 47 type
// or ICU's name), else the region's first preference.
pub fn localeType(id: []const u8) -> u8 {
    const named = typeNamed(legacyTypeName(locale.keyword(id, "calendar")))
    if named != UNKNOWN_TYPE { return named }
    const fromTag = typeNamed(legacyTypeName(locale.keyword(id, "ca")))
    if fromTag != UNKNOWN_TYPE { return fromTag }
    var list: [18]u8 = undefined
    _ = preferredTypes(locale.region(id), &list)
    return list[0]
}

// The year a calendar's date is in by the Gregorian count (ICU's
// getRelatedYear: the 'r' of patterns).
fn relatedYearOf(c: *Calendar, extended: i64) -> i64 {
    const k = c.*.kind
    if k == CHINESE { return extended - 2637 }
    if k == DANGI { return extended - 2333 }
    if k == HEBREW { return extended - 3760 }
    if k == PERSIAN { return extended + 622 }
    if k == INDIAN { return extended + 79 }
    if k == COPTIC { return extended + 284 }
    if k == ETHIOPIC { return extended + 8 }
    if k == ETHIOPIC_AMETE_ALEM { return extended - 5492 }
    if isIslamic(c) {
        // The Gregorian year the Islamic one starts in.
        var shift: i64 = 0
        if extended >= 1397 {
            const cycle = (extended - 1397) / 67
            const offset = (extended - 1397) % 67
            shift = 2 * cycle + (if offset >= 33 { 1 } else { 0 })
        } else {
            const cycle = (extended - 1396) / 67 - 1
            const offset = -(extended - 1396) % 67
            shift = 2 * cycle + (if offset <= 33 { 1 } else { 0 })
        }
        return extended + 579 - shift
    }
    return extended
}

// For the formatters: a UCalendar's type and the related year of its
// moment.
pub fn typeOf(cal: usize) -> u8 { return calendar(cal).*.kind }

pub fn relatedYear(cal: usize, ok: *bool) -> i64 {
    var c = calendar(cal)
    return relatedYearOf(c, get(c, EXTENDED_YEAR, ok))
}

// Whether the Hebrew year of the calendar's moment is a leap year.
pub fn hebrewLeapYear(year: i64) -> bool { return systems.hebrewIsLeap(year) }

// ---------------------------------------------------------------------------
// Zone IDs

fn ascii(text: usize, length: i32, into: *[64]u8) -> usize {
    if text == 0 { return 0 }
    const count = m.units(text, length)
    if count > 63 { return 64 }
    var index: usize = 0
    while index < count {
        const unit = m.get16(text + index * 2)
        if unit == 0 || unit > 126 { return 64 }
        into.*[index] = @intCast(u8, unit)
        index += 1
    }
    return count
}

fn digitsAt(text: []const u8, at: usize) -> usize {
    var end = at
    while end < text.length && text[end] >= 48 && text[end] <= 57 { end += 1 }
    return end - at
}

fn number(text: []const u8, from: usize, count: usize) -> i64 {
    var value: i64 = 0
    var index: usize = 0
    while index < count {
        value = value * 10 + @intCast(i64, text[from + index] - 48)
        index += 1
    }
    return value
}

// A custom ID, GMT+h[h][[:]mm[[:]ss]], as its offset in milliseconds;
// false when it is not one.
fn customOffset(id: []const u8, offset: *i64) -> bool {
    if id.length < 5 { return false }
    if (id[0] | 32) != 103 || (id[1] | 32) != 109 || (id[2] | 32) != 116 { return false }
    const sign: i64 = if id[3] == 45 { -1 } else if id[3] == 43 { 1 } else { 0 }
    if sign == 0 { return false }
    var at: usize = 4
    var hours: i64 = 0
    var minutes: i64 = 0
    var seconds: i64 = 0
    const first = digitsAt(id, at)
    if first == 0 || first > 6 { return false }
    if at + first < id.length && id[at + first] == 58 {
        if first > 2 { return false }
        hours = number(id, at, first)
        at += first + 1
        if digitsAt(id, at) != 2 { return false }
        minutes = number(id, at, 2)
        at += 2
        if at < id.length {
            if id[at] != 58 || digitsAt(id, at + 1) != 2 { return false }
            seconds = number(id, at + 1, 2)
            at += 3
        }
    } else {
        if first <= 2 {
            hours = number(id, at, first)
        } else if first == 3 || first == 4 {
            hours = number(id, at, first - 2)
            minutes = number(id, at + first - 2, 2)
        } else {
            hours = number(id, at, first - 4)
            minutes = number(id, at + first - 4, 2)
            seconds = number(id, at + first - 2, 2)
        }
        at += first
    }
    if at != id.length || hours > 23 || minutes > 59 || seconds > 59 { return false }
    offset.* = sign * ((hours * 60 + minutes) * 60 + seconds) * 1000
    return true
}

fn pushTwo(text: *m.Bytes, value: i64) -> void {
    m.pushByte(text, @intCast(u8, 48 + value / 10))
    m.pushByte(text, @intCast(u8, 48 + value % 10))
}

// The normalized custom ID of an offset: GMT+hh:mm[:ss], GMT for 0.
fn customId(offset: i64, text: *m.Bytes) -> void {
    m.pushText(text, "GMT")
    if offset == 0 { return }
    m.pushByte(text, if offset < 0 { 45 } else { 43 })
    const total = (if offset < 0 { -offset } else { offset }) / 1000
    pushTwo(text, total / 3600)
    m.pushByte(text, 58)
    pushTwo(text, total / 60 % 60)
    if total % 60 != 0 {
        m.pushByte(text, 58)
        pushTwo(text, total % 60)
    }
}

fn setZoneId(c: *Calendar, id: []const u8) -> void {
    var length: usize = 0
    while length < id.length && length < 63 {
        c.*.zoneId[length] = id[length]
        length += 1
    }
    c.*.zoneId[length] = 0
    c.*.zoneIdLength = length
}

fn zoneIdOf(c: *Calendar) -> []const u8 {
    const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &c.*.zoneId) }
    return view[0..c.*.zoneIdLength]
}

// The calendar's zone from an ID: a zone of the database, a custom
// offset, or the unknown zone (UTC, "Etc/Unknown").
fn setZone(c: *Calendar, id: []const u8) -> void {
    const found = zones.find(id)
    if found != zones.NONE {
        c.*.zone = zones.zoneOf(found)
        c.*.fixedOffset = 0
        setZoneId(c, id)
        return
    }
    c.*.zone = zones.NONE
    var offset: i64 = 0
    if customOffset(id, &offset) {
        c.*.fixedOffset = offset
        var text = m.bytesBuffer()
        customId(offset, &text)
        setZoneId(c, m.bytesText(&text))
        m.disposeBytes(&text)
        return
    }
    c.*.fixedOffset = 0
    setZoneId(c, "Etc/Unknown")
}

// The default zone: the host's until ucal_setDefaultTimeZone.
var defaultZone: [64]u8 = undefined
var defaultZoneLength: usize = 0

fn environment(name: []const u8) -> []const u8 {
    const value = getenv(m.literal(name))
    if value == 0 { return "" }
    return m.cSlice(value)
}

// What follows "zoneinfo/" in a path, or the path.
fn afterZoneinfo(path: []const u8) -> []const u8 {
    var index: usize = 0
    while index + 9 <= path.length {
        if m.same(path[index..index + 9], "zoneinfo/") { return path[index + 9..path.length] }
        index += 1
    }
    return path
}

var hostBuffer: [512]u8 = undefined

// The host's zone: $TZ, /etc/localtime's link, /etc/timezone; else UTC.
fn hostZone() -> []const u8 {
    var given = environment("TZ")
    if given.length > 0 && given[0] == 58 { given = given[1..given.length] }
    if given.length > 0 {
        const name = afterZoneinfo(given)
        if zones.find(name) != zones.NONE { return name }
    }
    const length = readlink(m.literal("/etc/localtime"), @intFromPtr(&hostBuffer), 511)
    if length > 0 {
        const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &hostBuffer) }
        const name = afterZoneinfo(view[0..@intCast(usize, length)])
        if zones.find(name) != zones.NONE { return name }
    }
    const file = std.fs.open("/etc/timezone".pointer, 0, 0)
    if std.fs.isValid(file) {
        const count = std.fs.read(file, unsafe { @ptrCast([*]u8, &hostBuffer) }, 511)
        _ = std.fs.close(file)
        if count > 0 {
            var end: usize = 0
            while end < @intCast(usize, count) && hostBuffer[end] != 10 && hostBuffer[end] != 32 { end += 1 }
            const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &hostBuffer) }
            if zones.find(view[0..end]) != zones.NONE { return view[0..end] }
        }
    }
    return "UTC"
}

fn copyDefault(id: []const u8) -> void {
    var length: usize = 0
    while length < id.length && length < 63 {
        defaultZone[length] = id[length]
        length += 1
    }
    defaultZoneLength = length
}

fn defaultZoneId() -> []const u8 {
    if defaultZoneLength == 0 { copyDefault(hostZone()) }
    const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &defaultZone) }
    return view[0..defaultZoneLength]
}

// Writes an ASCII string as UTF-16 into C's buffer.
fn giveUnits(text: []const u8, dest: usize, capacity: i32, status: usize) -> i32 {
    const room = if capacity > 0 { @intCast(usize, capacity) } else { 0 }
    var index: usize = 0
    while index < text.length && index < room {
        m.put16(dest + index * 2, @intCast(u16, text[index]))
        index += 1
    }
    return m.terminate(dest, text.length, capacity, status)
}

// ---------------------------------------------------------------------------
// The C API

fn now() -> i64 {
    var time: [2]i64 = [2]i64{ 0, 0 }
    _ = clock_gettime(0, @intFromPtr(&time))
    return time[0] * 1000 + time[1] / 1000000
}

pub fn ucal_getNow() -> f64 { return dateOf(now()) }

pub fn ucal_open(zoneID: usize, len: i32, localeId: usize, kind: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    const address = m.alloc(@sizeOf(Calendar))
    if address == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    var c = calendar(address)
    const name = if localeId == 0 { locale.defaultLocale() } else { m.cSlice(localeId) }
    var length: usize = 0
    while length < name.length && length < 95 {
        c.*.localeId[length] = name[length]
        length += 1
    }
    c.*.localeId[length] = 0
    c.*.localeLength = length
    const week = locale.week(name)
    c.*.firstDayOfWeek = @intCast(i64, week.firstDay)
    c.*.minimalDays = @intCast(i64, week.minimalDays)
    c.*.weekendOnset = @intCast(i64, week.weekendOnset)
    c.*.weekendCease = @intCast(i64, week.weekendCease)
    c.*.lenient = true
    c.*.repeatedWallTime = WALLTIME_LAST
    c.*.skippedWallTime = WALLTIME_LAST
    c.*.cutover = DEFAULT_CUTOVER
    c.*.cutoverJulianDay = DEFAULT_CUTOVER_JULIAN_DAY
    c.*.cutoverYear = DEFAULT_CUTOVER_YEAR
    c.*.isGregorian = true
    c.*.invertGregorian = false
    c.*.nextStamp = MINIMUM_USER
    // UCAL_GREGORIAN (1) whatever the locale says.
    c.*.kind = if kind == 1 { GREGORIAN } else { localeType(name) }
    c.*.gregorianYear = 1970
    c.*.gregorianMonth = 0
    c.*.gregorianDayOfMonth = 1
    c.*.gregorianDayOfYear = 1
    c.*.hasLeapMonth = false
    if c.*.kind == ISO8601 {
        // ISO 8601's weeks: from Monday unless the locale asks otherwise
        // ("fw"), the first with four days.
        if locale.keyword(name, "fw").length == 0 { c.*.firstDayOfWeek = 2 }
        c.*.minimalDays = 4
    }
    var id: [64]u8 = undefined
    const idLength = ascii(zoneID, len, &id)
    if zoneID == 0 || idLength == 0 {
        setZone(c, defaultZoneId())
    } else if idLength > 63 {
        setZone(c, "Etc/Unknown")
    } else {
        const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &id) }
        setZone(c, view[0..idLength])
    }
    setTime(c, now())
    return address
}

pub fn ucal_close(cal: usize) -> void { m.release(cal) }

pub fn ucal_clone(cal: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    const address = m.alloc(@sizeOf(Calendar))
    if address == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    m.copy(address, cal, @sizeOf(Calendar))
    return address
}

pub fn ucal_setTimeZone(cal: usize, zoneID: usize, len: i32, status: usize) -> void {
    if m.failed(status) { return }
    var c = calendar(cal)
    // The moment stays; the fields are those of the new zone.
    var ok = true
    const time = getTime(c, &ok)
    var id: [64]u8 = undefined
    const idLength = ascii(zoneID, len, &id)
    if zoneID == 0 || idLength == 0 {
        setZone(c, defaultZoneId())
    } else if idLength > 63 {
        setZone(c, "Etc/Unknown")
    } else {
        const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &id) }
        setZone(c, view[0..idLength])
    }
    if ok { setTime(c, time) }
}

pub fn ucal_getTimeZoneID(cal: usize, result: usize, resultLength: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    return giveUnits(zoneIdOf(calendar(cal)), result, resultLength, status)
}

pub fn ucal_getDefaultTimeZone(result: usize, resultCapacity: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    return giveUnits(defaultZoneId(), result, resultCapacity, status)
}

pub fn ucal_setDefaultTimeZone(zoneID: usize, status: usize) -> void {
    if m.failed(status) { return }
    var id: [64]u8 = undefined
    const length = ascii(zoneID, -1, &id)
    if length == 0 || length > 63 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &id) }
    copyDefault(view[0..length])
}

pub fn ucal_getHostTimeZone(result: usize, resultCapacity: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    return giveUnits(hostZone(), result, resultCapacity, status)
}

pub fn ucal_getTZDataVersion(status: usize) -> usize {
    if m.failed(status) { return 0 }
    return m.literal(zones.version())
}

// The canonical ID: the zone's own name; a custom ID normalized.
fn canonical(id: usize, len: i32, result: usize, resultCapacity: i32, isSystemID: usize, status: usize, iana: bool) -> i32 {
    if m.failed(status) { return 0 }
    var name: [64]u8 = undefined
    const length = ascii(id, len, &name)
    if id == 0 || length == 0 || length > 63 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &name) }
    const text = view[0..length]
    const found = zones.find(text)
    if found != zones.NONE {
        if isSystemID != 0 { m.put8(isSystemID, 1) }
        return giveUnits(zones.idName(zones.zoneId(zones.zoneOf(found))), result, resultCapacity, status)
    }
    if isSystemID != 0 { m.put8(isSystemID, 0) }
    if m.same(text, "Etc/Unknown") && !iana { return giveUnits(text, result, resultCapacity, status) }
    var offset: i64 = 0
    if !iana && customOffset(text, &offset) {
        var custom = m.bytesBuffer()
        customId(offset, &custom)
        const written = giveUnits(m.bytesText(&custom), result, resultCapacity, status)
        m.disposeBytes(&custom)
        return written
    }
    m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
    return 0
}

pub fn ucal_getCanonicalTimeZoneID(id: usize, len: i32, result: usize, resultCapacity: i32, isSystemID: usize, status: usize) -> i32 {
    return canonical(id, len, result, resultCapacity, isSystemID, status, false)
}

pub fn ucal_getIanaTimeZoneID(id: usize, len: i32, result: usize, resultCapacity: i32, status: usize) -> i32 {
    return canonical(id, len, result, resultCapacity, 0, status, true)
}

// Windows' zone names come from CLDR's windowsZones, not here: no
// mapping, as for a zone Windows does not know.
pub fn ucal_getWindowsTimeZoneID(id: usize, len: i32, winid: usize, winidCapacity: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    return m.terminate(winid, 0, winidCapacity, status)
}

pub fn ucal_getTimeZoneIDForWindowsID(winid: usize, len: i32, region: usize, id: usize, idCapacity: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    return m.terminate(id, 0, idCapacity, status)
}

const ZONE_TYPE_ANY: i32 = 0
const ZONE_TYPE_CANONICAL: i32 = 1
const ZONE_TYPE_CANONICAL_LOCATION: i32 = 2

fn regionCode(text: usize) -> u16 {
    const name = m.cSlice(text)
    if name.length != 2 { return 65535 }
    return (@intCast(u16, name[0] & 223) << 8) | @intCast(u16, name[1] & 223)
}

fn zoneEnumeration(kind: i32, region: usize, rawOffset: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    var text = m.bytesBuffer()
    const wanted: u16 = if region == 0 { 0 } else { regionCode(region) }
    const instant = floorDivide(now(), 1000)
    var id: usize = 0
    while id < zones.idCount() {
        const name = zones.idName(id)
        var keep = !m.same(name, "Factory")
        if kind != ZONE_TYPE_ANY && !zones.isCanonical(id) { keep = false }
        if kind == ZONE_TYPE_CANONICAL_LOCATION && zones.region(id) == 0 { keep = false }
        if region != 0 && zones.region(id) != wanted { keep = false }
        if rawOffset != 0 && zones.offsetsAt(zones.zoneOf(id), instant).raw * 1000 != @intCast(i64, m.getI32(rawOffset)) { keep = false }
        if keep {
            m.pushText(&text, name)
            m.pushByte(&text, 10)
        }
        id += 1
    }
    const en = enumeration.ofLines(m.bytesText(&text), status)
    m.disposeBytes(&text)
    return en
}

pub fn ucal_openTimeZoneIDEnumeration(zoneType: i32, region: usize, rawOffset: usize, ec: usize) -> usize {
    return zoneEnumeration(zoneType, region, rawOffset, ec)
}

pub fn ucal_openTimeZones(ec: usize) -> usize { return zoneEnumeration(ZONE_TYPE_ANY, 0, 0, ec) }

pub fn ucal_openCountryTimeZones(country: usize, ec: usize) -> usize {
    if country != 0 { return zoneEnumeration(ZONE_TYPE_ANY, country, 0, ec) }
    // Zones of no country.
    if m.failed(ec) { return 0 }
    var text = m.bytesBuffer()
    var id: usize = 0
    while id < zones.idCount() {
        if zones.region(id) == 0 && !m.same(zones.idName(id), "Factory") {
            m.pushText(&text, zones.idName(id))
            m.pushByte(&text, 10)
        }
        id += 1
    }
    const en = enumeration.ofLines(m.bytesText(&text), ec)
    m.disposeBytes(&text)
    return en
}

// What daylight saving adds, the latest rules' (or this year's).
pub fn ucal_getDSTSavings(zoneID: usize, ec: usize) -> i32 {
    if m.failed(ec) { return 0 }
    var name: [64]u8 = undefined
    const length = ascii(zoneID, -1, &name)
    const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &name) }
    if length == 0 || length > 63 { return 0 }
    const found = zones.find(view[0..length])
    if found == zones.NONE { return 0 }
    const zone = zones.zoneOf(found)
    var at = floorDivide(now(), 1000) - 31556952
    var index: usize = 0
    while index < 8 {
        const next = zones.nextTransition(zone, at, false)
        if !next.found { break }
        const offsets = zones.offsetsAt(zone, next.time)
        if offsets.save != 0 { return @intCast(i32, offsets.save * 1000) }
        at = next.time
        index += 1
    }
    return 0
}

// What a zone's display names take of a calendar's zone (ICU's
// TimeZone::getRawOffset, useDaylightTime, getDSTSavings), now: its
// standard offset, whether daylight saving time is kept at some time
// this year, and what it adds.
pub const ZoneState = struct {
    raw: i64
    usesDaylight: bool
    savings: i64
}

pub fn zoneState(cal: usize) -> ZoneState {
    var c = calendar(cal)
    const moment = now()
    const offsets = zoneOffsets(c, moment)
    var result = ZoneState.{ .raw = offsets.raw, .usesDaylight = false, .savings = 0 }
    if c.*.zone == zones.NONE { return result }
    // DST at some time of this year (UTC): a transition this year into
    // or out of it.
    const year = systems.dayToFields(floorDivide(moment, DAY_MS)).year
    const start = systems.fieldsToDay(year, 0, 1) * 86400
    const limit = systems.fieldsToDay(year + 1, 0, 1) * 86400
    var at = start - 1
    var index: usize = 0
    while index < 64 {
        const next = zones.nextTransition(c.*.zone, at, false)
        if !next.found || next.time >= limit { break }
        const after = zones.offsetsAt(c.*.zone, next.time)
        const before = zones.offsetsAt(c.*.zone, next.time - 1)
        if after.save != 0 || (next.time > start && before.save != 0) {
            result.usesDaylight = true
            result.savings = if after.save != 0 { after.save * 1000 } else { before.save * 1000 }
            break
        }
        at = next.time
        index += 1
    }
    return result
}

// The calendar's zone ID.
pub fn zoneIdText(cal: usize) -> []const u8 { return zoneIdOf(calendar(cal)) }

pub fn ucal_inDaylightTime(cal: usize, status: usize) -> u8 {
    if m.failed(status) { return 0 }
    var c = calendar(cal)
    var ok = true
    const time = getTime(c, &ok)
    if !ok {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    return if zoneOffsets(c, time).save != 0 { 1 } else { 0 }
}

pub fn ucal_setGregorianChange(cal: usize, date: f64, status: usize) -> void {
    if m.failed(status) { return }
    var c = calendar(cal)
    // Only the Gregorian and ISO 8601 calendars (not the others made of
    // the Gregorian one).
    if c.*.kind != GREGORIAN && c.*.kind != ISO8601 {
        m.setError(status, m.UNSUPPORTED_ERROR)
        return
    }
    var days = floorDivide(millisOf(date), DAY_MS)
    if days < -2147483648 { days = -2147483648 }
    if days > 2147483647 { days = 2147483647 }
    c.*.cutover = millisOf(date)
    // As ICU keeps it: the change's day counted from 1970, though the
    // days it is compared with are Julian days (so a date before the
    // Julian day of that number is a Julian one, the years before the
    // change's leap years by the Julian rule).
    c.*.cutoverJulianDay = days
    // The change's year, counted by the calendar of before.
    var work = c.*
    work.cutover = DEFAULT_CUTOVER
    work.cutoverJulianDay = DEFAULT_CUTOVER_JULIAN_DAY
    work.cutoverYear = DEFAULT_CUTOVER_YEAR
    setTime(&work, c.*.cutover)
    var ok = true
    c.*.cutoverYear = get(&work, EXTENDED_YEAR, &ok)
    // The fields are those of the calendar now.
    var ok2 = true
    const time = getTime(c, &ok2)
    if ok2 { setTime(c, time) }
}

pub fn ucal_getGregorianChange(cal: usize, status: usize) -> f64 {
    if m.failed(status) { return 0.0 }
    const c = calendar(cal)
    if c.*.kind != GREGORIAN && c.*.kind != ISO8601 {
        m.setError(status, m.UNSUPPORTED_ERROR)
        return 0.0
    }
    return dateOf(c.*.cutover)
}

pub fn ucal_getAttribute(cal: usize, attr: i32) -> i32 {
    const c = calendar(cal)
    if attr == LENIENT { return if c.*.lenient { 1 } else { 0 } }
    if attr == FIRST_DAY_OF_WEEK { return @intCast(i32, c.*.firstDayOfWeek) }
    if attr == MINIMAL_DAYS_IN_FIRST_WEEK { return @intCast(i32, c.*.minimalDays) }
    if attr == REPEATED_WALL_TIME { return c.*.repeatedWallTime }
    if attr == SKIPPED_WALL_TIME { return c.*.skippedWallTime }
    return -1
}

pub fn ucal_setAttribute(cal: usize, attr: i32, newValue: i32) -> void {
    var c = calendar(cal)
    if attr == LENIENT {
        c.*.lenient = newValue != 0
    } else if attr == FIRST_DAY_OF_WEEK {
        if newValue >= 1 && newValue <= 7 && @intCast(i64, newValue) != c.*.firstDayOfWeek {
            c.*.firstDayOfWeek = @intCast(i64, newValue)
            c.*.areFieldsSet = false
        }
    } else if attr == MINIMAL_DAYS_IN_FIRST_WEEK {
        var value = newValue
        if value < 1 { value = 1 }
        if value > 7 { value = 7 }
        if @intCast(i64, value) != c.*.minimalDays {
            c.*.minimalDays = @intCast(i64, value)
            c.*.areFieldsSet = false
        }
    } else if attr == REPEATED_WALL_TIME {
        if newValue == WALLTIME_LAST || newValue == WALLTIME_FIRST { c.*.repeatedWallTime = newValue }
    } else if attr == SKIPPED_WALL_TIME {
        if newValue >= WALLTIME_LAST && newValue <= WALLTIME_NEXT_VALID { c.*.skippedWallTime = newValue }
    }
}

pub fn ucal_getAvailable(localeIndex: i32) -> usize {
    if localeIndex < 0 { return 0 }
    return locale.availableAt(@intCast(usize, localeIndex))
}

pub fn ucal_countAvailable() -> i32 { return @intCast(i32, locale.availableCount()) }

pub fn ucal_getMillis(cal: usize, status: usize) -> f64 {
    if m.failed(status) { return 0.0 }
    var ok = true
    const time = getTime(calendar(cal), &ok)
    if !ok {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0.0
    }
    return dateOf(time)
}

pub fn ucal_setMillis(cal: usize, dateTime: f64, status: usize) -> void {
    if m.failed(status) { return }
    var c = calendar(cal)
    const millis = millisOf(dateTime)
    if !c.*.lenient && (millis > MAX_MILLIS || millis < MIN_MILLIS || dateTime != dateTime) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    setTime(c, millis)
}

pub fn ucal_setDate(cal: usize, year: i32, month: i32, date: i32, status: usize) -> void {
    if m.failed(status) { return }
    var c = calendar(cal)
    set(c, YEAR, @intCast(i64, year))
    set(c, MONTH, @intCast(i64, month))
    set(c, DATE, @intCast(i64, date))
}

pub fn ucal_setDateTime(cal: usize, year: i32, month: i32, date: i32, hour: i32, minute: i32, second: i32, status: usize) -> void {
    if m.failed(status) { return }
    var c = calendar(cal)
    set(c, YEAR, @intCast(i64, year))
    set(c, MONTH, @intCast(i64, month))
    set(c, DATE, @intCast(i64, date))
    set(c, HOUR_OF_DAY, @intCast(i64, hour))
    set(c, MINUTE, @intCast(i64, minute))
    set(c, SECOND, @intCast(i64, second))
}

pub fn ucal_equivalentTo(cal1: usize, cal2: usize) -> u8 {
    const a = calendar(cal1)
    const b = calendar(cal2)
    if a.*.lenient != b.*.lenient || a.*.firstDayOfWeek != b.*.firstDayOfWeek || a.*.minimalDays != b.*.minimalDays { return 0 }
    if a.*.weekendOnset != b.*.weekendOnset || a.*.weekendCease != b.*.weekendCease { return 0 }
    if a.*.repeatedWallTime != b.*.repeatedWallTime || a.*.skippedWallTime != b.*.skippedWallTime || a.*.cutover != b.*.cutover { return 0 }
    if a.*.zone != b.*.zone || a.*.fixedOffset != b.*.fixedOffset || a.*.kind != b.*.kind { return 0 }
    return 1
}

fn validField(field: i32) -> bool { return field >= 0 && field < 24 }

pub fn ucal_add(cal: usize, field: i32, amount: i32, status: usize) -> void {
    if m.failed(status) { return }
    if !validField(field) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    var ok = true
    add(calendar(cal), @intCast(usize, field), @intCast(i64, amount), &ok)
    if !ok { m.setError(status, m.ILLEGAL_ARGUMENT_ERROR) }
}

pub fn ucal_roll(cal: usize, field: i32, amount: i32, status: usize) -> void {
    if m.failed(status) { return }
    if !validField(field) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    var ok = true
    roll(calendar(cal), @intCast(usize, field), @intCast(i64, amount), &ok)
    if !ok { m.setError(status, m.ILLEGAL_ARGUMENT_ERROR) }
}

pub fn ucal_get(cal: usize, field: i32, status: usize) -> i32 {
    if m.failed(status) { return -1 }
    if !validField(field) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return -1
    }
    var ok = true
    const value = get(calendar(cal), @intCast(usize, field), &ok)
    if !ok {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return -1
    }
    return @intCast(i32, value)
}

pub fn ucal_set(cal: usize, field: i32, value: i32) -> void {
    if !validField(field) { return }
    set(calendar(cal), @intCast(usize, field), @intCast(i64, value))
}

pub fn ucal_isSet(cal: usize, field: i32) -> u8 {
    if !validField(field) { return 0 }
    return if isSetInternally(calendar(cal), @intCast(usize, field)) { 1 } else { 0 }
}

pub fn ucal_clearField(cal: usize, field: i32) -> void {
    if !validField(field) { return }
    clearField(calendar(cal), @intCast(usize, field))
}

pub fn ucal_clear(calendar_: usize) -> void { clearAll(calendar(calendar_)) }

pub fn ucal_getLimit(cal: usize, field: i32, kind: i32, status: usize) -> i32 {
    if m.failed(status) { return -1 }
    if !validField(field) || kind < 0 || kind > 5 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return -1
    }
    var c = calendar(cal)
    const f = @intCast(usize, field)
    if kind == ACTUAL_MINIMUM { return @intCast(i32, actualMinimum(c, f)) }
    if kind == ACTUAL_MAXIMUM { return @intCast(i32, actualMaximum(c, f)) }
    return @intCast(i32, limit(c, f, kind))
}

pub fn ucal_getLocaleByType(cal: usize, kind: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if kind < 0 || kind > 1 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    return @intFromPtr(&calendar(cal).*.localeId)
}

pub fn ucal_getType(cal: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    return typeLiteral(calendar(cal).*.kind)
}

// The type's name as a C string.
pub fn typeLiteral(kind: u8) -> usize {
    if kind == JAPANESE { return m.literal("japanese") }
    if kind == BUDDHIST { return m.literal("buddhist") }
    if kind == ROC { return m.literal("roc") }
    if kind == PERSIAN { return m.literal("persian") }
    if kind == ISLAMIC_CIVIL { return m.literal("islamic-civil") }
    if kind == ISLAMIC { return m.literal("islamic") }
    if kind == HEBREW { return m.literal("hebrew") }
    if kind == CHINESE { return m.literal("chinese") }
    if kind == INDIAN { return m.literal("indian") }
    if kind == COPTIC { return m.literal("coptic") }
    if kind == ETHIOPIC { return m.literal("ethiopic") }
    if kind == ETHIOPIC_AMETE_ALEM { return m.literal("ethiopic-amete-alem") }
    if kind == ISO8601 { return m.literal("iso8601") }
    if kind == DANGI { return m.literal("dangi") }
    if kind == ISLAMIC_UMALQURA { return m.literal("islamic-umalqura") }
    if kind == ISLAMIC_TBLA { return m.literal("islamic-tbla") }
    if kind == ISLAMIC_RGSA { return m.literal("islamic-rgsa") }
    return m.literal("gregorian")
}

// The calendars of a locale: those its region prefers, then the others
// in ICU's order (only the preferred ones when COMMONLYUSED).
pub fn ucal_getKeywordValuesForLocale(key: usize, localeId: usize, commonlyUsed: u8, status: usize) -> usize {
    if m.failed(status) { return 0 }
    const name = if localeId == 0 { locale.defaultLocale() } else { m.cSlice(localeId) }
    var list: [18]u8 = undefined
    const count = preferredTypes(locale.region(name), &list)
    var text = m.bytesBuffer()
    var listed: [18]bool = undefined
    var k: usize = 0
    while k < 18 {
        listed[k] = false
        k += 1
    }
    k = 0
    while k < count {
        if !listed[list[k]] {
            m.pushText(&text, typeName(list[k]))
            m.pushByte(&text, 10)
            listed[list[k]] = true
        }
        k += 1
    }
    if commonlyUsed == 0 {
        var kind: u8 = 0
        while kind < TYPE_COUNT {
            if !listed[kind] {
                m.pushText(&text, typeName(kind))
                m.pushByte(&text, 10)
            }
            kind += 1
        }
    }
    const en = enumeration.ofLines(m.bytesText(&text), status)
    m.disposeBytes(&text)
    return en
}

const WEEKDAY: i32 = 0
const WEEKEND: i32 = 1

pub fn ucal_getDayOfWeekType(cal: usize, dayOfWeek: i32, status: usize) -> i32 {
    if m.failed(status) { return WEEKDAY }
    if dayOfWeek < 1 || dayOfWeek > 7 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return WEEKDAY
    }
    const c = calendar(cal)
    const day = @intCast(i64, dayOfWeek)
    const onset = c.*.weekendOnset
    const cease = c.*.weekendCease
    if onset == cease { return if day == onset { WEEKEND } else { WEEKDAY } }
    if onset < cease {
        if day < onset || day > cease { return WEEKDAY }
    } else {
        if day > cease && day < onset { return WEEKDAY }
    }
    return WEEKEND
}

// The weekends here begin and end at midnight: no transition within a day.
pub fn ucal_getWeekendTransition(cal: usize, dayOfWeek: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
    return 0
}

pub fn ucal_isWeekend(cal: usize, date: f64, status: usize) -> u8 {
    if m.failed(status) { return 0 }
    var work = calendar(cal).*
    setTime(&work, millisOf(date))
    var ok = true
    const day = get(&work, DAY_OF_WEEK, &ok)
    return if ucal_getDayOfWeekType(cal, @intCast(i32, day), status) == WEEKEND { 1 } else { 0 }
}

pub fn ucal_getFieldDifference(cal: usize, target: f64, field: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    if !validField(field) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    var c = calendar(cal)
    const f = @intCast(usize, field)
    const targetMs = millisOf(target)
    var ok = true
    var min: i64 = 0
    const startMs = getTime(c, &ok)
    if startMs < targetMs {
        var max: i64 = 1
        while ok {
            setTime(c, startMs)
            add(c, f, max, &ok)
            const ms = getTime(c, &ok)
            if ms == targetMs { return @intCast(i32, max) }
            if ms > targetMs { break }
            if max < 2147483647 {
                min = max
                max = max * 2
                if max > 2147483647 { max = 2147483647 }
            } else {
                ok = false
            }
        }
        while max - min > 1 && ok {
            const t = min + (max - min) / 2
            setTime(c, startMs)
            add(c, f, t, &ok)
            const ms = getTime(c, &ok)
            if ms == targetMs { return @intCast(i32, t) }
            if ms > targetMs { max = t } else { min = t }
        }
    } else if startMs > targetMs {
        var max: i64 = -1
        while ok {
            setTime(c, startMs)
            add(c, f, max, &ok)
            const ms = getTime(c, &ok)
            if ms == targetMs { return @intCast(i32, max) }
            if ms < targetMs { break }
            min = max
            max = max * 2
            if max < -2147483648 {
                ok = false
            }
        }
        while min - max > 1 && ok {
            const t = min + (max - min) / 2
            setTime(c, startMs)
            add(c, f, t, &ok)
            const ms = getTime(c, &ok)
            if ms == targetMs { return @intCast(i32, t) }
            if ms < targetMs { max = t } else { min = t }
        }
    }
    if !ok {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    setTime(c, startMs)
    add(c, f, min, &ok)
    return @intCast(i32, min)
}

pub fn ucal_getTimeZoneTransitionDate(cal: usize, kind: i32, transition: usize, status: usize) -> u8 {
    if m.failed(status) { return 0 }
    var c = calendar(cal)
    var ok = true
    const time = getTime(c, &ok)
    var found: i64 = 0
    var has = false
    if kind == 0 || kind == 1 {
        has = nextTransition(c, time, kind == 1, &found)
    } else {
        has = previousTransition(c, time, kind == 3, &found)
    }
    if has && transition != 0 { m.put64(transition, @bitCast(u64, dateOf(found))) }
    return if has { 1 } else { 0 }
}

pub fn ucal_getTimeZoneOffsetFromLocal(cal: usize, nonExistingTimeOpt: i32, duplicatedTimeOpt: i32, rawOffset: usize, dstOffset: usize, status: usize) -> void {
    if m.failed(status) { return }
    var c = calendar(cal)
    var ok = true
    const time = getTime(c, &ok)
    const offsets = offsetsFromLocal(c, time, nonExistingTimeOpt, duplicatedTimeOpt)
    m.putI32(rawOffset, @intCast(i32, offsets.raw))
    m.putI32(dstOffset, @intCast(i32, offsets.save))
}
