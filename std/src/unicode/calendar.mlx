// Calendars and time zones (ucal.h): the Gregorian calendar, Julian
// before its change (October 15, 1582 unless set otherwise), and the
// others ICU 74 has, over the time zones of zones.mlx. The calendar
// keeps a moment (milliseconds since 1970, UTC) and the fields of it
// (era, year, month, week, day, hour...) and goes from either to the
// other as ICU's Calendar does: fields set are stamped in order, and the
// moment is worked out from the newest of the ways of naming a day (the
// day of the month, of the year, a week and a day of the week...), the
// time of day and the zone's offsets at that wall-clock time (a time a
// transition skips or repeats taken as the calendar's options say).
//
// The calendar's type is the locale's "calendar" keyword, else the first
// CLDR prefers for its region (calendarPreferenceData: th_TH is
// buddhist, fa_IR persian). The Buddhist, Japanese (its eras from CLDR's
// calendarData), ROC and ISO 8601 calendars are the Gregorian one with
// other eras or weeks; the Hebrew, Islamic (five kinds), Persian, Indian,
// Coptic, Ethiopic (two eras or Amete Alem's), Chinese and Dangi ones
// are calendars.mlx's arithmetic in the same framework, with ICU's
// limits, defaults and ways of adding and rolling months of each.
const m = @import("std.unicode.memory")
const zones = @import("std.timezone.database")
const locale = @import("std.unicode.locale.defaults")
const enumeration = @import("std.unicode.enumeration")
const resources = @import("std.unicode.locale.resources")
const systems = @import("std.unicode.calendar.systems")
const std = @import("std")

extern("c") fn getenv(name: usize) -> usize
extern("c") fn readlink(path: usize, buffer: usize, size: usize) -> isize
extern("c") fn clock_gettime(clock: i32, time: usize) -> i32

// UCalendarDateFields
const ERA: usize = 0
const YEAR: usize = 1
const MONTH: usize = 2
const WEEK_OF_YEAR: usize = 3
const WEEK_OF_MONTH: usize = 4
const DATE: usize = 5
const DAY_OF_YEAR: usize = 6
const DAY_OF_WEEK: usize = 7
const DAY_OF_WEEK_IN_MONTH: usize = 8
const AM_PM: usize = 9
const HOUR: usize = 10
const HOUR_OF_DAY: usize = 11
const MINUTE: usize = 12
const SECOND: usize = 13
const MILLISECOND: usize = 14
const ZONE_OFFSET: usize = 15
const DST_OFFSET: usize = 16
const YEAR_WOY: usize = 17
const DOW_LOCAL: usize = 18
const EXTENDED_YEAR: usize = 19
const JULIAN_DAY: usize = 20
const MILLISECONDS_IN_DAY: usize = 21
const IS_LEAP_MONTH: usize = 22
const ORDINAL_MONTH: usize = 23
const FIELD_COUNT: usize = 24

// Field stamps: not set, set by the calendar, then those set from outside
// in order.
const UNSET: i32 = 0
const INTERNAL: i32 = 1
const MINIMUM_USER: i32 = 2

// UCalendarLimitType
const MINIMUM: i32 = 0
const MAXIMUM: i32 = 1
const GREATEST_MINIMUM: i32 = 2
const LEAST_MAXIMUM: i32 = 3
const ACTUAL_MINIMUM: i32 = 4
const ACTUAL_MAXIMUM: i32 = 5

// UCalendarAttribute
const LENIENT: i32 = 0
const FIRST_DAY_OF_WEEK: i32 = 1
const MINIMAL_DAYS_IN_FIRST_WEEK: i32 = 2
const REPEATED_WALL_TIME: i32 = 3
const SKIPPED_WALL_TIME: i32 = 4

// UCalendarWallTimeOption
const WALLTIME_LAST: i32 = 0
const WALLTIME_FIRST: i32 = 1
const WALLTIME_NEXT_VALID: i32 = 2

// UTimeZoneLocalOption
const LOCAL_FORMER: i32 = 4
const LOCAL_LATTER: i32 = 12
const LOCAL_STANDARD: i32 = 1
const LOCAL_DAYLIGHT: i32 = 3

const SECOND_MS: i64 = 1000
const MINUTE_MS: i64 = 60000
const HOUR_MS: i64 = 3600000
const DAY_MS: i64 = 86400000
const WEEK_MS: i64 = 604800000
const EPOCH_JULIAN_DAY: i64 = 2440588
const JAN_1_1_JULIAN_DAY: i64 = 1721426
const EPOCH_YEAR: i64 = 1970
// October 15, 1582.
const DEFAULT_CUTOVER: i64 = -12219292800000
const DEFAULT_CUTOVER_JULIAN_DAY: i64 = 2299161
const DEFAULT_CUTOVER_YEAR: i64 = 1582
const MIN_MILLIS: i64 = -184303902528000000
const MAX_MILLIS: i64 = 183882168921600000

// The calendars' types, in ICU's order (its gCalTypes).
pub const GREGORIAN: u8 = 0
pub const JAPANESE: u8 = 1
pub const BUDDHIST: u8 = 2
pub const ROC: u8 = 3
pub const PERSIAN: u8 = 4
pub const ISLAMIC_CIVIL: u8 = 5
pub const ISLAMIC: u8 = 6
pub const HEBREW: u8 = 7
pub const CHINESE: u8 = 8
pub const INDIAN: u8 = 9
pub const COPTIC: u8 = 10
pub const ETHIOPIC: u8 = 11
pub const ETHIOPIC_AMETE_ALEM: u8 = 12
pub const ISO8601: u8 = 13
pub const DANGI: u8 = 14
pub const ISLAMIC_UMALQURA: u8 = 15
pub const ISLAMIC_TBLA: u8 = 16
pub const ISLAMIC_RGSA: u8 = 17
pub const TYPE_COUNT: u8 = 18
pub const UNKNOWN_TYPE: u8 = 255

const TYPE_NAMES: []const u8 = "\ngregorian\njapanese\nbuddhist\nroc\npersian\nislamic-civil\nislamic\nhebrew\nchinese\nindian\ncoptic\nethiopic\nethiopic-amete-alem\niso8601\ndangi\nislamic-umalqura\nislamic-tbla\nislamic-rgsa\n"

const Calendar = struct {
    time: i64
    isTimeSet: bool
    areFieldsSet: bool
    areAllFieldsSet: bool
    areFieldsVirtuallySet: bool
    fields: [24]i64
    stamps: [24]i32
    nextStamp: i32
    lenient: bool
    firstDayOfWeek: i64
    minimalDays: i64
    weekendOnset: i64
    weekendCease: i64
    repeatedWallTime: i32
    skippedWallTime: i32
    cutover: i64
    cutoverJulianDay: i64
    cutoverYear: i64
    isGregorian: bool
    invertGregorian: bool
    // The zone (zones.NONE for an ID of a fixed offset or none known).
    zone: usize
    fixedOffset: i64
    zoneId: [64]u8
    zoneIdLength: usize
    localeId: [96]u8
    localeLength: usize
    // The calendar's type (GREGORIAN...).
    kind: u8
    // The proleptic Gregorian date of the Julian day last worked out
    // (ICU's gregorianYear...: what the Chinese calendar starts from).
    gregorianYear: i64
    gregorianMonth: i64
    gregorianDayOfMonth: i64
    gregorianDayOfYear: i64
    // Chinese and Dangi: whether the year between the winter solstices
    // around the date last worked out has 13 months.
    hasLeapMonth: bool
}

fn calendar(address: usize) -> *Calendar { unsafe { return @ptrFromInt(*Calendar, address) } }

// ---------------------------------------------------------------------------
// Arithmetic

fn floorDivide(value: i64, divisor: i64) -> i64 {
    const quotient = value / divisor
    return if value % divisor != 0 && (value < 0) != (divisor < 0) { quotient - 1 } else { quotient }
}

fn floorModulo(value: i64, divisor: i64) -> i64 { return value - floorDivide(value, divisor) * divisor }

fn millisOf(date: f64) -> i64 {
    if date != date { return 0 }
    if date <= -9.2e18 { return MIN_MILLIS }
    if date >= 9.2e18 { return MAX_MILLIS }
    return @intFromFloat(i64, @floor(date))
}

fn dateOf(millis: i64) -> f64 { return @floatFromInt(f64, millis) }

// ---------------------------------------------------------------------------
// The calendar's arithmetic (ICU's GregorianCalendar)

var MONTH_DAYS: [12]i64 = [12]i64{ 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 }
var DAYS_BEFORE: [12]i64 = [12]i64{ 0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334 }
var LEAP_DAYS_BEFORE: [12]i64 = [12]i64{ 0, 31, 60, 91, 121, 152, 182, 213, 244, 274, 305, 335 }

fn gregorianLeap(year: i64) -> bool { return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) }

fn isLeapYear(c: *Calendar, year: i64) -> bool {
    if year >= c.*.cutoverYear { return gregorianLeap(year) }
    return floorModulo(year, 4) == 0
}

fn gregorianMonthLength(c: *Calendar, extendedYear: i64, month: i64) -> i64 {
    const year = extendedYear + floorDivide(month, 12)
    const index = @intCast(usize, floorModulo(month, 12))
    if index == 1 { return if isLeapYear(c, year) { 29 } else { 28 } }
    return MONTH_DAYS[index]
}

fn gregorianShift(extendedYear: i64) -> i64 {
    const year = extendedYear - 1
    return floorDivide(year, 400) - floorDivide(year, 100) + 2
}

// The Julian day before the month begins (Gregorian or Julian as the
// year is before the change or not, unless inverted).
fn gregorianMonthStart(c: *Calendar, extendedYear: i64, month: i64) -> i64 {
    var year = extendedYear
    var index = month
    if index < 0 || index > 11 {
        year += floorDivide(index, 12)
        index = floorModulo(index, 12)
    }
    var leap = floorModulo(year, 4) == 0
    const prior = year - 1
    var julianDay = 365 * prior + floorDivide(prior, 4) + (JAN_1_1_JULIAN_DAY - 3)
    c.*.isGregorian = year >= c.*.cutoverYear
    if c.*.invertGregorian { c.*.isGregorian = !c.*.isGregorian }
    if c.*.isGregorian {
        leap = leap && (year % 100 != 0 || year % 400 == 0)
        julianDay += gregorianShift(year)
    }
    if index != 0 { julianDay += if leap { LEAP_DAYS_BEFORE[@intCast(usize, index)] } else { DAYS_BEFORE[@intCast(usize, index)] } }
    return julianDay
}

// ---------------------------------------------------------------------------
// The arithmetic of each type (ICU's handleComputeMonthStart,
// handleGetMonthLength, handleGetYearLength)

// The Gregorian calendar and those that are it with other eras or weeks.
fn isGregorianFamily(c: *Calendar) -> bool {
    const k = c.*.kind
    return k == GREGORIAN || k == JAPANESE || k == BUDDHIST || k == ROC || k == ISO8601
}

fn isChinese(c: *Calendar) -> bool { return c.*.kind == CHINESE || c.*.kind == DANGI }

fn isIslamic(c: *Calendar) -> bool {
    const k = c.*.kind
    return k == ISLAMIC || k == ISLAMIC_CIVIL || k == ISLAMIC_UMALQURA || k == ISLAMIC_TBLA || k == ISLAMIC_RGSA
}

fn islamicKind(c: *Calendar) -> u8 {
    const k = c.*.kind
    if k == ISLAMIC_CIVIL { return systems.ISLAMIC_CIVIL }
    if k == ISLAMIC_TBLA { return systems.ISLAMIC_TBLA }
    if k == ISLAMIC_UMALQURA { return systems.ISLAMIC_UMALQURA }
    return systems.ISLAMIC_ASTRONOMICAL
}

fn isEthiopicFamily(c: *Calendar) -> bool { return c.*.kind == COPTIC || c.*.kind == ETHIOPIC || c.*.kind == ETHIOPIC_AMETE_ALEM }

fn ceOffset(c: *Calendar) -> i64 { return if c.*.kind == COPTIC { systems.COPTIC_JD_EPOCH_OFFSET } else { systems.ETHIOPIC_JD_EPOCH_OFFSET } }

fn chineseEpochYear(c: *Calendar) -> i64 { return if c.*.kind == DANGI { systems.DANGI_EPOCH_YEAR } else { systems.CHINESE_EPOCH_YEAR } }

// The proleptic Gregorian date of a Julian day (ICU's
// computeGregorianFields).
fn computeGregorianFields(c: *Calendar, julianDay: i64) -> void {
    const date = systems.dayToFields(julianDay - EPOCH_JULIAN_DAY)
    c.*.gregorianYear = date.year
    c.*.gregorianMonth = date.month
    c.*.gregorianDayOfMonth = date.dayOfMonth
    c.*.gregorianDayOfYear = date.dayOfYear
}

// The Chinese month of EXTENDEDYEAR, MONTH (and the IS_LEAP_MONTH field
// when USEMONTH): the new moon about MONTH months after the new year,
// else the next one (a leap month before it).
fn chineseMonthStart(c: *Calendar, extendedYear: i64, monthIn: i64, useMonth: bool) -> i64 {
    var year = extendedYear
    var month = monthIn
    if month < 0 || month > 11 {
        year += floorDivide(month, 12)
        month = floorModulo(month, 12)
    }
    const korea = c.*.kind == DANGI
    const epochYear = chineseEpochYear(c)
    const gyear = year + epochYear - 1
    const theNewYear = systems.newYear(korea, gyear)
    var newMoon = systems.newMoonNear(korea, @floatFromInt(f64, theNewYear + month * 29), true)
    var julianDay = newMoon + EPOCH_JULIAN_DAY
    const saveMonth = c.*.fields[MONTH]
    const saveOrdinalMonth = c.*.fields[ORDINAL_MONTH]
    const saveIsLeapMonth = c.*.fields[IS_LEAP_MONTH]
    const isLeapMonth = if useMonth { saveIsLeapMonth } else { 0 }
    computeGregorianFields(c, julianDay)
    const date = systems.chineseFields(korea, epochYear, newMoon, c.*.gregorianYear, c.*.gregorianMonth)
    c.*.hasLeapMonth = date.hasLeapMonth
    if month != date.month || isLeapMonth != (if date.isLeapMonth { 1 } else { 0 }) {
        newMoon = systems.newMoonNear(korea, @floatFromInt(f64, newMoon) + 25.0, true)
        julianDay = newMoon + EPOCH_JULIAN_DAY
    }
    internalSet(c, MONTH, saveMonth)
    internalSet(c, ORDINAL_MONTH, saveOrdinalMonth)
    internalSet(c, IS_LEAP_MONTH, saveIsLeapMonth)
    return julianDay - 1
}

// The Julian day before month MONTH of EXTENDEDYEAR begins.
fn monthStart(c: *Calendar, extendedYear: i64, month: i64, useMonth: bool) -> i64 {
    const k = c.*.kind
    if isGregorianFamily(c) { return gregorianMonthStart(c, extendedYear, month) }
    if k == HEBREW { return systems.hebrewMonthStart(extendedYear, month) }
    if isIslamic(c) { return systems.islamicMonthStartJulian(islamicKind(c), extendedYear, month) }
    if k == PERSIAN { return systems.persianMonthStart(extendedYear, month) }
    if k == INDIAN { return systems.indianMonthStart(extendedYear, month) }
    if isEthiopicFamily(c) { return systems.ceToJD(extendedYear, month, 0, ceOffset(c)) }
    return chineseMonthStart(c, extendedYear, month, useMonth)
}

fn monthLength(c: *Calendar, extendedYear: i64, month: i64) -> i64 {
    const k = c.*.kind
    if isGregorianFamily(c) { return gregorianMonthLength(c, extendedYear, month) }
    if k == HEBREW { return systems.hebrewMonthLength(extendedYear, month) }
    if isIslamic(c) { return systems.islamicMonthLength(islamicKind(c), extendedYear, month) }
    if k == PERSIAN { return systems.persianMonthLength(extendedYear, month) }
    if k == INDIAN { return systems.indianMonthLength(extendedYear, month) }
    if isChinese(c) {
        const thisStart = monthStart(c, extendedYear, month, true) - EPOCH_JULIAN_DAY + 1
        const nextStart = systems.newMoonNear(c.*.kind == DANGI, @floatFromInt(f64, thisStart) + 25.0, true)
        return nextStart - thisStart
    }
    return monthStart(c, extendedYear, month + 1, true) - monthStart(c, extendedYear, month, true)
}

fn yearLength(c: *Calendar, year: i64) -> i64 {
    const k = c.*.kind
    if isGregorianFamily(c) { return if isLeapYear(c, year) { 366 } else { 365 } }
    if k == HEBREW { return systems.hebrewYearLength(year) }
    if isIslamic(c) { return systems.islamicYearLength(islamicKind(c), year) }
    if k == PERSIAN { return systems.persianYearLength(year) }
    if k == INDIAN { return systems.indianYearLength(year) }
    return monthStart(c, year + 1, 0, false) - monthStart(c, year, 0, false)
}

fn dayOfWeekOf(julianDay: i64) -> i64 { return floorModulo(julianDay + 1, 7) + 1 }

// ---------------------------------------------------------------------------
// Zones

const Offsets = struct {
    raw: i64
    save: i64
}

fn zoneOffsets(c: *Calendar, utc: i64) -> Offsets {
    if c.*.zone == zones.NONE { return Offsets.{ .raw = c.*.fixedOffset, .save = 0 } }
    const offsets = zones.offsetsAt(c.*.zone, floorDivide(utc, 1000))
    return Offsets.{ .raw = offsets.raw * 1000, .save = offsets.save * 1000 }
}

// The offsets for a wall-clock time (ICU's getOffsetFromLocal): from the
// latest transition back, the first whose threshold the time reaches,
// the threshold within a gap or an overlap set by the options.
fn offsetsFromLocal(c: *Calendar, wall: i64, nonExisting: i32, duplicated: i32) -> Offsets {
    if c.*.zone == zones.NONE { return Offsets.{ .raw = c.*.fixedOffset, .save = 0 } }
    const zone = c.*.zone
    const seconds = floorDivide(wall, 1000)
    var transition = zones.previousTransition(zone, seconds + 172800, true)
    while transition.found {
        const time = transition.time
        const before = zones.offsetsAt(zone, time - 1)
        const after = zones.offsetsAt(zone, time)
        const offsetBefore = before.raw + before.save
        const offsetAfter = after.raw + after.save
        const dstToStd = before.save != 0 && after.save == 0
        const stdToDst = before.save == 0 && after.save != 0
        var threshold = time
        if offsetAfter - offsetBefore >= 0 {
            const kind = nonExisting & 3
            if (kind == LOCAL_STANDARD && dstToStd) || (kind == LOCAL_DAYLIGHT && stdToDst) {
                threshold += offsetBefore
            } else if (kind == LOCAL_STANDARD && stdToDst) || (kind == LOCAL_DAYLIGHT && dstToStd) {
                threshold += offsetAfter
            } else if (nonExisting & 12) == LOCAL_LATTER {
                threshold += offsetBefore
            } else {
                threshold += offsetAfter
            }
        } else {
            const kind = duplicated & 3
            if (kind == LOCAL_STANDARD && dstToStd) || (kind == LOCAL_DAYLIGHT && stdToDst) {
                threshold += offsetAfter
            } else if (kind == LOCAL_STANDARD && stdToDst) || (kind == LOCAL_DAYLIGHT && dstToStd) {
                threshold += offsetBefore
            } else if (duplicated & 12) == LOCAL_FORMER {
                threshold += offsetBefore
            } else {
                threshold += offsetAfter
            }
        }
        if seconds >= threshold { return Offsets.{ .raw = after.raw * 1000, .save = after.save * 1000 } }
        transition = zones.previousTransition(zone, time, false)
    }
    const first = zones.offsetsAt(zone, -9223372036854775807)
    return Offsets.{ .raw = first.raw * 1000, .save = first.save * 1000 }
}

// The transition at or before `utc` (milliseconds); false without one.
fn previousTransition(c: *Calendar, utc: i64, inclusive: bool, into: *i64) -> bool {
    if c.*.zone == zones.NONE { return false }
    const seconds = floorDivide(utc, 1000)
    const exact = seconds * 1000 == utc
    const found = zones.previousTransition(c.*.zone, seconds, inclusive || !exact)
    if !found.found { return false }
    into.* = found.time * 1000
    return true
}

fn nextTransition(c: *Calendar, utc: i64, inclusive: bool, into: *i64) -> bool {
    if c.*.zone == zones.NONE { return false }
    const seconds = floorDivide(utc, 1000)
    const exact = seconds * 1000 == utc
    const found = zones.nextTransition(c.*.zone, seconds, inclusive && exact)
    if !found.found { return false }
    into.* = found.time * 1000
    return true
}

// ---------------------------------------------------------------------------
// Fields and stamps

fn internalGet(c: *Calendar, field: usize) -> i64 { return c.*.fields[field] }

fn internalGetOr(c: *Calendar, field: usize, otherwise: i64) -> i64 { return if c.*.stamps[field] > UNSET { c.*.fields[field] } else { otherwise } }

fn internalSet(c: *Calendar, field: usize, value: i64) -> void {
    c.*.fields[field] = value
    c.*.stamps[field] = INTERNAL
}

fn isSetInternally(c: *Calendar, field: usize) -> bool { return c.*.areFieldsVirtuallySet || c.*.stamps[field] != UNSET }

fn newerField(c: *Calendar, defaultField: usize, alternate: usize) -> usize {
    return if c.*.stamps[alternate] > c.*.stamps[defaultField] { alternate } else { defaultField }
}

fn newestStamp(c: *Calendar, first: usize, last: usize, best: i32) -> i32 {
    var result = best
    var field = first
    while field <= last {
        if c.*.stamps[field] > result { result = c.*.stamps[field] }
        field += 1
    }
    return result
}

// The stamp of a line of fields (all must be set), 0 otherwise.
fn lineStamp(c: *Calendar, first: usize, second: usize) -> i32 {
    const a = c.*.stamps[first]
    if a == UNSET { return UNSET }
    if second == FIELD_COUNT { return a }
    const b = c.*.stamps[second]
    if b == UNSET { return UNSET }
    return if a > b { a } else { b }
}

// ICU's kDatePrecedence, its two groups of lines: the fields of a line
// (24: none), the field it names (100 more: a remapped line, which
// counts for the field it names).
var DATE_LINES: [45]usize = [45]usize{
    5, 24, 5,
    3, 7, 3,
    4, 7, 4,
    8, 7, 8,
    3, 18, 3,
    4, 18, 4,
    8, 18, 8,
    6, 24, 6,
    1, 24, 105,
    17, 24, 103,
    3, 24, 3,
    4, 24, 4,
    8, 24, 8,
    7, 24, 108,
    18, 24, 108,
}

// The field that names the day, FIELD_COUNT for none. The Chinese
// calendars' table (ICU's CHINESE_DATE_PRECEDENCE) has the day of the
// month with IS_LEAP_MONTH in place of the two lines with years.
fn resolveDate(c: *Calendar) -> usize {
    var best = FIELD_COUNT
    var bestStamp = UNSET
    var index: usize = 0
    const lines: usize = if isChinese(c) { 9 } else { 10 }
    while index < lines {
        var first = DATE_LINES[index * 3]
        if index == 8 && lines == 9 { first = IS_LEAP_MONTH }
        const stamp = lineStamp(c, first, DATE_LINES[index * 3 + 1])
        if stamp > bestStamp {
            const named = DATE_LINES[index * 3 + 2]
            if named >= 100 {
                const field = named - 100
                if field != DATE || c.*.stamps[WEEK_OF_MONTH] < c.*.stamps[field] {
                    best = field
                    bestStamp = stamp
                }
            } else {
                best = named
                bestStamp = stamp
            }
        }
        index += 1
    }
    if best != FIELD_COUNT { return best }
    // The second group.
    bestStamp = UNSET
    index = 0
    while index < 5 {
        const stamp = lineStamp(c, DATE_LINES[30 + index * 3], DATE_LINES[30 + index * 3 + 1])
        if stamp > bestStamp {
            const named = DATE_LINES[30 + index * 3 + 2]
            best = if named >= 100 { named - 100 } else { named }
            bestStamp = stamp
        }
        index += 1
    }
    return best
}

// The newest of two single-field lines; FIELD_COUNT when neither is set.
fn resolveTwo(c: *Calendar, first: usize, second: usize) -> usize {
    const a = c.*.stamps[first]
    const b = c.*.stamps[second]
    if a == UNSET && b == UNSET { return FIELD_COUNT }
    return if b > a { second } else { first }
}

// ICU's kYearPrecedence.
fn resolveYear(c: *Calendar) -> usize {
    var best = FIELD_COUNT
    var bestStamp = UNSET
    if c.*.stamps[YEAR] > bestStamp {
        best = YEAR
        bestStamp = c.*.stamps[YEAR]
    }
    if c.*.stamps[EXTENDED_YEAR] > bestStamp {
        best = EXTENDED_YEAR
        bestStamp = c.*.stamps[EXTENDED_YEAR]
    }
    const woy = lineStamp(c, YEAR_WOY, WEEK_OF_YEAR)
    if woy > bestStamp { best = YEAR_WOY }
    return best
}

// The month the fields name: MONTH, or ORDINAL_MONTH when it is newer
// (the Hebrew calendar skips Adar I in a common year; the Chinese counts
// from the new year, a leap month too).
fn internalGetMonth(c: *Calendar) -> i64 {
    const field = resolveTwo(c, MONTH, ORDINAL_MONTH)
    if field == MONTH { return internalGet(c, MONTH) }
    if c.*.kind == HEBREW && field == ORDINAL_MONTH {
        const ordinal = internalGet(c, ORDINAL_MONTH)
        const year = handleGetExtendedYear(c)
        return ordinal + (if !systems.hebrewIsLeap(year) && ordinal > systems.ADAR_1 { 1 } else { 0 })
    }
    if isChinese(c) { return chineseMonthOfOrdinal(c) }
    return internalGet(c, ORDINAL_MONTH)
}

// ICU's ChineseCalendar::internalGetMonth: the first month of the year
// rolled by ORDINAL_MONTH, its MONTH and IS_LEAP_MONTH set here.
fn chineseMonthOfOrdinal(c: *Calendar) -> i64 {
    var work = c.*
    var ok = true
    set(&work, MONTH, 0)
    set(&work, IS_LEAP_MONTH, 0)
    set(&work, DATE, 1)
    roll(&work, ORDINAL_MONTH, internalGet(c, ORDINAL_MONTH), &ok)
    internalSet(c, IS_LEAP_MONTH, get(&work, IS_LEAP_MONTH, &ok))
    const month = get(&work, MONTH, &ok)
    internalSet(c, MONTH, month)
    return month
}

// ICU's internalGetMonth(defaultValue).
fn internalGetMonthOr(c: *Calendar, otherwise: i64) -> i64 {
    if resolveTwo(c, MONTH, ORDINAL_MONTH) == MONTH { return internalGetOr(c, MONTH, otherwise) }
    if isChinese(c) { return internalGetMonth(c) }
    return internalGet(c, ORDINAL_MONTH)
}

// The day of the week sought, 0 to 6 from the first day of the week.
fn localDayOfWeek(c: *Calendar) -> i64 {
    var value: i64 = 0
    const field = resolveTwo(c, DAY_OF_WEEK, DOW_LOCAL)
    if field == DAY_OF_WEEK { value = internalGet(c, DAY_OF_WEEK) - c.*.firstDayOfWeek }
    if field == DOW_LOCAL { value = internalGet(c, DOW_LOCAL) - 1 }
    return floorModulo(value, 7)
}

// ---------------------------------------------------------------------------
// From fields to the moment

// The Gregorian calendar's extended year (ICU's GregorianCalendar::
// handleGetExtendedYear).
fn extendedYear(c: *Calendar) -> i64 {
    var field = EXTENDED_YEAR
    if c.*.stamps[field] < c.*.stamps[YEAR] { field = YEAR }
    if c.*.stamps[field] < c.*.stamps[YEAR_WOY] { field = YEAR_WOY }
    if field == EXTENDED_YEAR { return internalGetOr(c, EXTENDED_YEAR, EPOCH_YEAR) }
    if field == YEAR {
        const era = internalGetOr(c, ERA, 1)
        if era == 0 { return 1 - internalGetOr(c, YEAR, 1) }
        return internalGetOr(c, YEAR, EPOCH_YEAR)
    }
    var yearWoy = internalGet(c, YEAR_WOY)
    if internalGetOr(c, ERA, 1) == 0 { yearWoy = 1 - yearWoy }
    return extendedYearFromWeekFields(c, yearWoy, internalGet(c, WEEK_OF_YEAR))
}

// The extended year the fields name, by the calendar's type.
fn handleGetExtendedYear(c: *Calendar) -> i64 {
    const k = c.*.kind
    if k == GREGORIAN || k == ISO8601 { return extendedYear(c) }
    if k == BUDDHIST {
        if newerField(c, EXTENDED_YEAR, YEAR) == EXTENDED_YEAR { return internalGetOr(c, EXTENDED_YEAR, EPOCH_YEAR) }
        return internalGetOr(c, YEAR, EPOCH_YEAR + 543) - 543
    }
    if k == ROC {
        if newerField(c, EXTENDED_YEAR, YEAR) == EXTENDED_YEAR && newerField(c, EXTENDED_YEAR, ERA) == EXTENDED_YEAR { return internalGetOr(c, EXTENDED_YEAR, EPOCH_YEAR) }
        const era = internalGetOr(c, ERA, 1)
        if era == 1 { return internalGetOr(c, YEAR, 1) + 1911 }
        if era == 0 { return 1 - internalGetOr(c, YEAR, 1) + 1911 }
        return EPOCH_YEAR
    }
    if k == JAPANESE {
        if newerField(c, EXTENDED_YEAR, YEAR) == EXTENDED_YEAR && newerField(c, EXTENDED_YEAR, ERA) == EXTENDED_YEAR { return internalGetOr(c, EXTENDED_YEAR, EPOCH_YEAR) }
        return internalGetOr(c, YEAR, 1) + eraStartYear(internalGetOr(c, ERA, currentEra())) - 1
    }
    if isChinese(c) {
        if newestStamp(c, ERA, YEAR, UNSET) <= c.*.stamps[EXTENDED_YEAR] { return internalGetOr(c, EXTENDED_YEAR, 1) }
        const cycle = internalGetOr(c, ERA, 1) - 1
        return cycle * 60 + internalGetOr(c, YEAR, 1) - (chineseEpochYear(c) - systems.CHINESE_EPOCH_YEAR)
    }
    if k == COPTIC {
        if newerField(c, EXTENDED_YEAR, YEAR) == EXTENDED_YEAR { return internalGetOr(c, EXTENDED_YEAR, 1) }
        if internalGetOr(c, ERA, 1) == 0 { return 1 - internalGetOr(c, YEAR, 1) }
        return internalGetOr(c, YEAR, 1)
    }
    if k == ETHIOPIC {
        if newerField(c, EXTENDED_YEAR, YEAR) == EXTENDED_YEAR { return internalGetOr(c, EXTENDED_YEAR, 1) }
        if internalGetOr(c, ERA, 1) == 1 { return internalGetOr(c, YEAR, 1) }
        return internalGetOr(c, YEAR, 1) - systems.AMETE_MIHRET_DELTA
    }
    if k == ETHIOPIC_AMETE_ALEM {
        if newerField(c, EXTENDED_YEAR, YEAR) == EXTENDED_YEAR { return internalGetOr(c, EXTENDED_YEAR, 1) }
        return internalGetOr(c, YEAR, 1 + systems.AMETE_MIHRET_DELTA) - systems.AMETE_MIHRET_DELTA
    }
    // Hebrew, Islamic, Persian, Indian.
    if newerField(c, EXTENDED_YEAR, YEAR) == EXTENDED_YEAR { return internalGetOr(c, EXTENDED_YEAR, 1) }
    return internalGetOr(c, YEAR, 1)
}

fn extendedYearFromWeekFields(c: *Calendar, yearWoy: i64, woy: i64) -> i64 {
    const best = resolveDate(c)
    const dowLocal = localDayOfWeek(c)
    const jan1Start = monthStart(c, yearWoy, 0, false)
    const nextJan1Start = monthStart(c, yearWoy + 1, 0, false)
    const first = floorModulo(dayOfWeekOf(jan1Start + 1) - c.*.firstDayOfWeek, 7)
    const jan1InPrevYear = 7 - first < c.*.minimalDays
    if best == WEEK_OF_YEAR {
        if woy == 1 {
            if jan1InPrevYear { return yearWoy }
            return if dowLocal < first { yearWoy - 1 } else { yearWoy }
        }
        if woy >= limit(c, WEEK_OF_YEAR, LEAST_MAXIMUM) {
            var julianDay = jan1Start + (7 - first) + (woy - 1) * 7 + dowLocal
            if !jan1InPrevYear { julianDay -= 7 }
            return if julianDay + 1 >= nextJan1Start { yearWoy + 1 } else { yearWoy }
        }
        return yearWoy
    }
    if best == DATE {
        if internalGet(c, MONTH) == 0 && woy >= limit(c, WEEK_OF_YEAR, LEAST_MAXIMUM) { return yearWoy + 1 }
        if woy == 1 { return if internalGet(c, MONTH) == 0 { yearWoy } else { yearWoy - 1 } }
        return yearWoy
    }
    return yearWoy
}

// ICU's Calendar::handleComputeJulianDay.
fn julianDayOfFields(c: *Calendar, best: usize) -> i64 {
    const useMonth = best == DATE || best == WEEK_OF_MONTH || best == DAY_OF_WEEK_IN_MONTH
    var year: i64 = 0
    if best == WEEK_OF_YEAR && newerField(c, YEAR_WOY, YEAR) == YEAR_WOY {
        year = internalGet(c, YEAR_WOY)
    } else {
        year = handleGetExtendedYear(c)
    }
    internalSet(c, EXTENDED_YEAR, year)
    var month: i64 = 0
    if isSetInternally(c, MONTH) || isSetInternally(c, ORDINAL_MONTH) {
        month = internalGetMonth(c)
    } else {
        month = defaultMonthInYear(c, year)
    }
    var julianDay = monthStart(c, year, if useMonth { month } else { 0 }, useMonth)
    if best == DATE {
        const day = if isSetInternally(c, DATE) { internalGetOr(c, DATE, 1) } else { defaultDayInMonth(c, year, month) }
        return julianDay + day
    }
    if best == DAY_OF_YEAR { return julianDay + internalGet(c, DAY_OF_YEAR) }
    const firstDay = c.*.firstDayOfWeek
    var first = floorModulo(dayOfWeekOf(julianDay + 1) - firstDay, 7)
    const dowLocal = localDayOfWeek(c)
    var date = 1 - first + dowLocal
    if best == DAY_OF_WEEK_IN_MONTH {
        if date < 1 { date += 7 }
        const dim = internalGetOr(c, DAY_OF_WEEK_IN_MONTH, 1)
        if dim >= 0 {
            date += 7 * (dim - 1)
        } else {
            const length = monthLength(c, year, internalGetMonthOr(c, 0))
            date += ((length - date) / 7 + dim + 1) * 7
        }
    } else {
        if best == WEEK_OF_YEAR {
            if !isSetInternally(c, YEAR_WOY) || (resolveYear(c) != YEAR_WOY && c.*.stamps[YEAR_WOY] != INTERNAL) {
                const woy = internalGet(c, best)
                const nextJulianDay = monthStart(c, year + 1, 0, false)
                const nextFirst = floorModulo(dayOfWeekOf(nextJulianDay + 1) - firstDay, 7)
                if woy == 1 {
                    if nextFirst > 0 && 7 - nextFirst >= c.*.minimalDays {
                        julianDay = nextJulianDay
                        first = floorModulo(dayOfWeekOf(julianDay + 1) - firstDay, 7)
                        date = 1 - first + dowLocal
                    }
                } else if woy >= limit(c, WEEK_OF_YEAR, LEAST_MAXIMUM) {
                    var testDate = date
                    if 7 - first < c.*.minimalDays { testDate += 7 }
                    testDate += 7 * (woy - 1)
                    if julianDay + testDate > nextJulianDay {
                        julianDay = monthStart(c, year - 1, 0, false)
                        first = floorModulo(dayOfWeekOf(julianDay + 1) - firstDay, 7)
                        date = 1 - first + dowLocal
                    }
                }
            }
        }
        if 7 - first < c.*.minimalDays { date += 7 }
        date += 7 * (internalGet(c, best) - 1)
    }
    return julianDay + date
}

// GregorianCalendar's: the year's change of calendar taken into account.
fn gregorianJulianDay(c: *Calendar, best: usize) -> i64 {
    c.*.invertGregorian = false
    var julianDay = julianDayOfFields(c, best)
    if best == WEEK_OF_YEAR && internalGet(c, EXTENDED_YEAR) == c.*.cutoverYear && julianDay >= c.*.cutoverJulianDay {
        c.*.invertGregorian = true
        return julianDayOfFields(c, best)
    }
    if c.*.isGregorian != (julianDay >= c.*.cutoverJulianDay) {
        c.*.invertGregorian = true
        julianDay = julianDayOfFields(c, best)
    }
    if c.*.isGregorian && internalGet(c, EXTENDED_YEAR) == c.*.cutoverYear {
        if best == DAY_OF_YEAR {
            julianDay -= gregorianShift(internalGet(c, EXTENDED_YEAR))
        } else if best == WEEK_OF_MONTH {
            julianDay += 14
        }
    }
    return julianDay
}

fn computeJulianDay(c: *Calendar) -> i64 {
    if c.*.stamps[JULIAN_DAY] >= MINIMUM_USER {
        var best = newestStamp(c, ERA, DAY_OF_WEEK_IN_MONTH, UNSET)
        best = newestStamp(c, YEAR_WOY, EXTENDED_YEAR, best)
        best = newestStamp(c, ORDINAL_MONTH, ORDINAL_MONTH, best)
        if best <= c.*.stamps[JULIAN_DAY] { return internalGet(c, JULIAN_DAY) }
    }
    var best = resolveDate(c)
    if best == FIELD_COUNT { best = DATE }
    if isGregorianFamily(c) { return gregorianJulianDay(c, best) }
    return julianDayOfFields(c, best)
}

// The month and the day the fields name when they name none: the first
// (the Japanese calendar's: the first of the era in its first year).
fn defaultMonthInYear(c: *Calendar, year: i64) -> i64 {
    if c.*.kind != JAPANESE { return 0 }
    const start = eraStart(internalGetOr(c, ERA, currentEra()))
    if year == start.year { return start.month - 1 }
    return 0
}

fn defaultDayInMonth(c: *Calendar, year: i64, month: i64) -> i64 {
    if c.*.kind != JAPANESE { return 1 }
    const start = eraStart(internalGetOr(c, ERA, currentEra()))
    if year == start.year && month == start.month - 1 { return start.day }
    return 1
}

fn computeMillisInDay(c: *Calendar) -> i64 {
    var millis: i64 = 0
    const hourOfDayStamp = c.*.stamps[HOUR_OF_DAY]
    const hourStamp = if c.*.stamps[HOUR] > c.*.stamps[AM_PM] { c.*.stamps[HOUR] } else { c.*.stamps[AM_PM] }
    const bestStamp = if hourStamp > hourOfDayStamp { hourStamp } else { hourOfDayStamp }
    if bestStamp != UNSET {
        if bestStamp == hourOfDayStamp {
            millis += internalGet(c, HOUR_OF_DAY)
        } else {
            millis += internalGet(c, HOUR) + 12 * internalGet(c, AM_PM)
        }
    }
    millis = millis * 60 + internalGet(c, MINUTE)
    millis = millis * 60 + internalGet(c, SECOND)
    return millis * 1000 + internalGet(c, MILLISECOND)
}

fn computeZoneOffset(c: *Calendar, millis: i64, millisInDay: i64) -> i64 {
    const wall = millis + millisInDay
    const duplicated = if c.*.repeatedWallTime == WALLTIME_FIRST { LOCAL_FORMER } else { LOCAL_LATTER }
    const nonExisting = if c.*.skippedWallTime == WALLTIME_FIRST { LOCAL_LATTER } else { LOCAL_FORMER }
    const offsets = offsetsFromLocal(c, wall, nonExisting, duplicated)
    var total = offsets.raw + offsets.save
    if c.*.skippedWallTime == WALLTIME_NEXT_VALID {
        const utc = wall - total
        const actual = zoneOffsets(c, utc)
        if actual.raw + actual.save != total {
            var transition: i64 = 0
            if previousTransition(c, utc, true, &transition) { total = wall - transition }
        }
    }
    return total
}

fn validateFields(c: *Calendar) -> bool {
    var field: usize = 0
    while field < FIELD_COUNT {
        if c.*.stamps[field] >= MINIMUM_USER {
            const value = internalGet(c, field)
            if c.*.kind == HEBREW && (field == MONTH || field == ORDINAL_MONTH) && !systems.hebrewIsLeap(handleGetExtendedYear(c)) && internalGetMonth(c) == systems.ADAR_1 { return false }
            if field == DATE {
                const year = handleGetExtendedYear(c)
                if value < 1 || value > monthLength(c, year, internalGetMonth(c)) { return false }
            } else if field == DAY_OF_YEAR {
                const year = handleGetExtendedYear(c)
                if value < 1 || value > yearLength(c, year) { return false }
            } else if field == DAY_OF_WEEK_IN_MONTH {
                if value == 0 { return false }
                if value < limit(c, field, MINIMUM) || value > limit(c, field, MAXIMUM) { return false }
            } else {
                if value < limit(c, field, MINIMUM) || value > limit(c, field, MAXIMUM) { return false }
            }
        }
        field += 1
    }
    return true
}

fn computeTime(c: *Calendar) -> bool {
    if !c.*.lenient && !validateFields(c) { return false }
    const julianDay = computeJulianDay(c)
    const millis = (julianDay - EPOCH_JULIAN_DAY) * DAY_MS
    var millisInDay: i64 = 0
    if c.*.stamps[MILLISECONDS_IN_DAY] >= MINIMUM_USER && newestStamp(c, AM_PM, MILLISECOND, UNSET) <= c.*.stamps[MILLISECONDS_IN_DAY] {
        millisInDay = internalGet(c, MILLISECONDS_IN_DAY)
    } else {
        millisInDay = computeMillisInDay(c)
    }
    var time: i64 = 0
    if c.*.stamps[ZONE_OFFSET] >= MINIMUM_USER || c.*.stamps[DST_OFFSET] >= MINIMUM_USER {
        time = millis + millisInDay - (internalGet(c, ZONE_OFFSET) + internalGet(c, DST_OFFSET))
    } else if !c.*.lenient || c.*.skippedWallTime == WALLTIME_NEXT_VALID {
        const offset = computeZoneOffset(c, millis, millisInDay)
        const candidate = millis + millisInDay - offset
        const actual = zoneOffsets(c, candidate)
        if offset != actual.raw + actual.save {
            if !c.*.lenient { return false }
            var transition: i64 = 0
            time = candidate
            if previousTransition(c, candidate, true, &transition) { time = transition }
        } else {
            time = candidate
        }
    } else {
        time = millis + millisInDay - computeZoneOffset(c, millis, millisInDay)
    }
    c.*.time = time
    return true
}

// ---------------------------------------------------------------------------
// From the moment to fields

fn weekNumberOf(c: *Calendar, desiredDay: i64, dayOfPeriod: i64, dayOfWeek: i64) -> i64 {
    const periodStart = floorModulo(dayOfWeek - c.*.firstDayOfWeek - dayOfPeriod + 1, 7)
    var week = (desiredDay + periodStart - 1) / 7
    if 7 - periodStart >= c.*.minimalDays { week += 1 }
    return week
}

fn computeWeekFields(c: *Calendar) -> void {
    const year = c.*.fields[EXTENDED_YEAR]
    const dayOfWeek = c.*.fields[DAY_OF_WEEK]
    const dayOfYear = c.*.fields[DAY_OF_YEAR]
    var yearOfWeek = year
    const relDow = (dayOfWeek + 7 - c.*.firstDayOfWeek) % 7
    const relDowJan1 = (dayOfWeek - dayOfYear + 7001 - c.*.firstDayOfWeek) % 7
    var woy = (dayOfYear - 1 + relDowJan1) / 7
    if 7 - relDowJan1 >= c.*.minimalDays { woy += 1 }
    if woy == 0 {
        const previousDoy = dayOfYear + yearLength(c, year - 1)
        woy = weekNumberOf(c, previousDoy, previousDoy, dayOfWeek)
        yearOfWeek -= 1
    } else {
        const lastDoy = yearLength(c, year)
        if dayOfYear >= lastDoy - 5 {
            const lastRelDow = floorModulo(relDow + lastDoy - dayOfYear, 7)
            if 6 - lastRelDow >= c.*.minimalDays && dayOfYear + 7 - relDow > lastDoy {
                woy = 1
                yearOfWeek += 1
            }
        }
    }
    c.*.fields[WEEK_OF_YEAR] = woy
    c.*.fields[YEAR_WOY] = yearOfWeek
    const dayOfMonth = c.*.fields[DATE]
    c.*.fields[WEEK_OF_MONTH] = weekNumberOf(c, dayOfMonth, dayOfMonth, dayOfWeek)
    c.*.fields[DAY_OF_WEEK_IN_MONTH] = (dayOfMonth - 1) / 7 + 1
}

fn computeFields(c: *Calendar) -> void {
    const offsets = zoneOffsets(c, c.*.time)
    const local = c.*.time + offsets.raw + offsets.save
    const days = floorDivide(local, DAY_MS)
    const julianDay = days + EPOCH_JULIAN_DAY
    var field: usize = 0
    while field < FIELD_COUNT {
        c.*.stamps[field] = INTERNAL
        field += 1
    }
    c.*.fields[JULIAN_DAY] = julianDay
    const dayOfWeek = dayOfWeekOf(julianDay)
    c.*.fields[DAY_OF_WEEK] = dayOfWeek
    var dowLocal = dayOfWeek - c.*.firstDayOfWeek + 1
    if dowLocal < 1 { dowLocal += 7 }
    c.*.fields[DOW_LOCAL] = dowLocal
    computeGregorianFields(c, julianDay)
    handleComputeFields(c, julianDay)
    computeWeekFields(c)
    var millisInDay = local - days * DAY_MS
    c.*.fields[MILLISECONDS_IN_DAY] = millisInDay
    c.*.fields[MILLISECOND] = millisInDay % 1000
    millisInDay = millisInDay / 1000
    c.*.fields[SECOND] = millisInDay % 60
    millisInDay = millisInDay / 60
    c.*.fields[MINUTE] = millisInDay % 60
    millisInDay = millisInDay / 60
    c.*.fields[HOUR_OF_DAY] = millisInDay
    c.*.fields[AM_PM] = millisInDay / 12
    c.*.fields[HOUR] = millisInDay % 12
    c.*.fields[ZONE_OFFSET] = offsets.raw
    c.*.fields[DST_OFFSET] = offsets.save
}

// The Gregorian date of a Julian day, Julian before the change (ICU's
// GregorianCalendar::handleComputeFields).
fn gregorianComputeFields(c: *Calendar, julianDay: i64) -> void {
    var year: i64 = 0
    var month: i64 = 0
    var dayOfMonth: i64 = 0
    var dayOfYear: i64 = 0
    if julianDay >= c.*.cutoverJulianDay {
        year = c.*.gregorianYear
        month = c.*.gregorianMonth
        dayOfMonth = c.*.gregorianDayOfMonth
        dayOfYear = c.*.gregorianDayOfYear
    } else {
        const epochDay = julianDay - (JAN_1_1_JULIAN_DAY - 2)
        year = floorDivide(4 * epochDay + 1464, 1461)
        const january1 = 365 * (year - 1) + floorDivide(year - 1, 4)
        dayOfYear = epochDay - january1
        const leap = floorModulo(year, 4) == 0
        var correction: i64 = 0
        const march1: i64 = if leap { 60 } else { 59 }
        if dayOfYear >= march1 { correction = if leap { 1 } else { 2 } }
        month = (12 * (dayOfYear + correction) + 6) / 367
        dayOfMonth = dayOfYear - (if leap { LEAP_DAYS_BEFORE[@intCast(usize, month)] } else { DAYS_BEFORE[@intCast(usize, month)] }) + 1
        dayOfYear += 1
    }
    if year == c.*.cutoverYear && julianDay >= c.*.cutoverJulianDay { dayOfYear += gregorianShift(year) }
    setDate(c, year, month, dayOfMonth, dayOfYear)
    if year < 1 {
        c.*.fields[ERA] = 0
        c.*.fields[YEAR] = 1 - year
    } else {
        c.*.fields[ERA] = 1
        c.*.fields[YEAR] = year
    }
}

fn setDate(c: *Calendar, extendedYear: i64, month: i64, dayOfMonth: i64, dayOfYear: i64) -> void {
    c.*.fields[EXTENDED_YEAR] = extendedYear
    c.*.fields[MONTH] = month
    c.*.fields[ORDINAL_MONTH] = month
    c.*.fields[DATE] = dayOfMonth
    c.*.fields[DAY_OF_YEAR] = dayOfYear
}

// The era, years, month and days of a Julian day by the calendar's type
// (ICU's handleComputeFields).
fn handleComputeFields(c: *Calendar, julianDay: i64) -> void {
    const k = c.*.kind
    if isGregorianFamily(c) {
        gregorianComputeFields(c, julianDay)
        const year = c.*.fields[EXTENDED_YEAR]
        if k == BUDDHIST {
            c.*.fields[ERA] = 0
            c.*.fields[YEAR] = year + 543
        } else if k == ROC {
            const y = year - 1911
            c.*.fields[ERA] = if y > 0 { 1 } else { 0 }
            c.*.fields[YEAR] = if y > 0 { y } else { 1 - y }
        } else if k == JAPANESE {
            const era = eraIndex(year, c.*.fields[MONTH] + 1, c.*.fields[DATE])
            c.*.fields[ERA] = era
            c.*.fields[YEAR] = year - eraStartYear(era) + 1
        }
        return
    }
    if k == HEBREW {
        const date = systems.hebrewFields(julianDay)
        setDate(c, date.year, date.month, date.dayOfMonth, date.dayOfYear)
        c.*.fields[ORDINAL_MONTH] = date.ordinalMonth
        c.*.fields[ERA] = 0
        c.*.fields[YEAR] = date.year
        return
    }
    if isChinese(c) {
        const date = systems.chineseFields(k == DANGI, chineseEpochYear(c), julianDay - EPOCH_JULIAN_DAY, c.*.gregorianYear, c.*.gregorianMonth)
        c.*.hasLeapMonth = date.hasLeapMonth
        setDate(c, date.extendedYear, date.month, date.dayOfMonth, date.dayOfYear)
        c.*.fields[ORDINAL_MONTH] = date.ordinalMonth
        c.*.fields[IS_LEAP_MONTH] = if date.isLeapMonth { 1 } else { 0 }
        c.*.fields[ERA] = date.era
        c.*.fields[YEAR] = date.year
        return
    }
    if isEthiopicFamily(c) {
        const date = systems.ceFields(julianDay, ceOffset(c))
        setDate(c, date.year, date.month, date.dayOfMonth, date.dayOfYear)
        if k == COPTIC {
            c.*.fields[ERA] = if date.year <= 0 { 0 } else { 1 }
            c.*.fields[YEAR] = if date.year <= 0 { 1 - date.year } else { date.year }
        } else if k == ETHIOPIC {
            c.*.fields[ERA] = if date.year > 0 { 1 } else { 0 }
            c.*.fields[YEAR] = if date.year > 0 { date.year } else { date.year + systems.AMETE_MIHRET_DELTA }
        } else {
            c.*.fields[ERA] = 0
            c.*.fields[YEAR] = date.year + systems.AMETE_MIHRET_DELTA
        }
        return
    }
    var date = systems.Ymd.{ .year = 0, .month = 0, .dayOfMonth = 0, .dayOfYear = 0 }
    if isIslamic(c) {
        date = systems.islamicFields(islamicKind(c), julianDay, dateOf(c.*.time))
    } else if k == PERSIAN {
        date = systems.persianFields(julianDay)
    } else {
        date = systems.indianFields(julianDay)
    }
    setDate(c, date.year, date.month, date.dayOfMonth, date.dayOfYear)
    c.*.fields[ERA] = 0
    c.*.fields[YEAR] = date.year
}

// ---------------------------------------------------------------------------
// The calendar's state (ICU's complete, set, get, clear)

fn setTime(c: *Calendar, millis: i64) -> void {
    var time = millis
    if time > MAX_MILLIS { time = MAX_MILLIS }
    if time < MIN_MILLIS { time = MIN_MILLIS }
    c.*.time = time
    c.*.areFieldsSet = false
    c.*.areAllFieldsSet = false
    c.*.isTimeSet = true
    c.*.areFieldsVirtuallySet = true
    var field: usize = 0
    while field < FIELD_COUNT {
        c.*.fields[field] = 0
        c.*.stamps[field] = UNSET
        field += 1
    }
}

fn updateTime(c: *Calendar) -> bool {
    if !computeTime(c) { return false }
    if c.*.lenient || !c.*.areAllFieldsSet { c.*.areFieldsSet = false }
    c.*.isTimeSet = true
    c.*.areFieldsVirtuallySet = false
    return true
}

fn complete(c: *Calendar) -> bool {
    if !c.*.isTimeSet {
        if !updateTime(c) { return false }
    }
    if !c.*.areFieldsSet {
        computeFields(c)
        c.*.areFieldsSet = true
        c.*.areAllFieldsSet = true
    }
    return true
}

fn getTime(c: *Calendar, ok: *bool) -> i64 {
    if !c.*.isTimeSet {
        if !updateTime(c) {
            ok.* = false
            return 0
        }
    }
    return c.*.time
}

fn get(c: *Calendar, field: usize, ok: *bool) -> i64 {
    if !complete(c) {
        ok.* = false
        return 0
    }
    return c.*.fields[field]
}

fn set(c: *Calendar, field: usize, value: i64) -> void {
    if c.*.areFieldsVirtuallySet { computeFields(c) }
    c.*.fields[field] = value
    c.*.stamps[field] = c.*.nextStamp
    c.*.nextStamp += 1
    if c.*.nextStamp > 2000000000 { restamp(c) }
    c.*.isTimeSet = false
    c.*.areFieldsSet = false
    c.*.areFieldsVirtuallySet = false
}

// The stamps renumbered from the least (when they near their limit).
fn restamp(c: *Calendar) -> void {
    c.*.nextStamp = MINIMUM_USER
    var round: usize = 0
    while round < FIELD_COUNT {
        var least: i32 = 2147483647
        var at = FIELD_COUNT
        var field: usize = 0
        while field < FIELD_COUNT {
            const stamp = c.*.stamps[field]
            if stamp >= c.*.nextStamp && stamp < least && stamp > 2000 {
                least = stamp
                at = field
            }
            field += 1
        }
        if at == FIELD_COUNT { break }
        c.*.stamps[at] = c.*.nextStamp
        c.*.nextStamp += 1
        round += 1
    }
}

fn clearAll(c: *Calendar) -> void {
    var field: usize = 0
    while field < FIELD_COUNT {
        c.*.fields[field] = 0
        c.*.stamps[field] = UNSET
        field += 1
    }
    c.*.isTimeSet = false
    c.*.areFieldsSet = false
    c.*.areAllFieldsSet = false
    c.*.areFieldsVirtuallySet = false
}

fn clearField(c: *Calendar, field: usize) -> void {
    if c.*.areFieldsVirtuallySet { computeFields(c) }
    c.*.fields[field] = 0
    c.*.stamps[field] = UNSET
    if field == MONTH {
        c.*.fields[ORDINAL_MONTH] = 0
        c.*.stamps[ORDINAL_MONTH] = UNSET
    }
    if field == ORDINAL_MONTH {
        c.*.fields[MONTH] = 0
        c.*.stamps[MONTH] = UNSET
    }
    c.*.isTimeSet = false
    c.*.areFieldsSet = false
    c.*.areAllFieldsSet = false
    c.*.areFieldsVirtuallySet = false
}

