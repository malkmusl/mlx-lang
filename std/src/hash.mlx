// std.hash: hashing for the containers (std.HashMap and the rest), and
// for anything else that wants a good 64-bit hash of bytes or of a value.
//
// `wyhash(bytes, seed)` is wyhash, final version 4.3 (Wang Yi; public
// domain), with its default secret: the hash the containers use for
// strings and for the bytes of a value. `hashWord` hashes one 64-bit
// word and `combine(seed, hash)` folds a hash into a running one, in
// order, with wyhash's mixing step.
//
// `autoHash(T, value)` and `autoEql(T, a, b)` derive a hash and an
// equality from the type by reflection: integers, bools, enums and
// floats by value, pointers by address, slices and arrays by content
// (bytes in one wyhash call, other element types element by element),
// optionals (null apart from any value), structs and tuples field by
// field. `StringContext` and `AutoContext(K)` are the contexts
// std.HashMap takes: a `hash(self, key)` and an `eql(self, a, b)`.
//
// The arithmetic is 64-bit and wrapping throughout (`*%`, `+%`, `<<%`);
// the 64 x 64 -> 128 multiply is done in 32-bit halves.

// The default secret of the final version.
pub const SECRET0: u64 = 3257665815644502181
pub const SECRET1: u64 = 10067880064238660809
pub const SECRET2: u64 = 5418857496715711651
pub const SECRET3: u64 = 5573817676018592327

const LOW32: u64 = 4294967295

// A 64 x 64 -> 128 multiply; `a` becomes the low word, `b` the high.
fn mum(a: *u64, b: *u64) -> void {
    const ha = a.* >> 32
    const hb = b.* >> 32
    const la = a.* & LOW32
    const lb = b.* & LOW32
    const rh = ha *% hb
    const rm0 = ha *% lb
    const rm1 = hb *% la
    const rl = la *% lb
    const t = rl +% (rm0 <<% 32)
    var carry: u64 = if t < rl { 1 } else { 0 }
    const lo = t +% (rm1 <<% 32)
    if lo < t { carry += 1 }
    const hi = rh +% (rm0 >> 32) +% (rm1 >> 32) +% carry
    a.* = lo
    b.* = hi
}

// wyhash's mixing step: the two halves of the product, xored.
pub fn mix(a: u64, b: u64) -> u64 {
    var low = a
    var high = b
    mum(&low, &high)
    return low ^ high
}

fn read8(bytes: [*]const u8, at: usize) -> u64 {
    unsafe { return @ptrCast(*const u64, bytes + at).* }
}

fn read4(bytes: [*]const u8, at: usize) -> u64 {
    unsafe { return @intCast(u64, @ptrCast(*const u32, bytes + at).*) }
}

fn read3(bytes: [*]const u8, length: usize) -> u64 {
    return (@intCast(u64, bytes[0]) << 16) | (@intCast(u64, bytes[length >> 1]) << 8) | @intCast(u64, bytes[length - 1])
}

// wyhash (final version 4.3) of `bytes` with `seed`, the default secret.
pub fn wyhash(bytes: []const u8, seed_value: u64) -> u64 {
    const length = bytes.length
    var p = bytes.pointer
    var seed = seed_value ^ mix(seed_value ^ SECRET0, SECRET1)
    var a: u64 = 0
    var b: u64 = 0
    if length <= 16 {
        if length >= 4 {
            const quarter = (length >> 3) << 2
            a = (read4(p, 0) << 32) | read4(p, quarter)
            b = (read4(p, length - 4) << 32) | read4(p, length - 4 - quarter)
        } else if length > 0 {
            a = read3(p, length)
        }
    } else {
        var left = length
        if left >= 48 {
            var see1 = seed
            var see2 = seed
            while left >= 48 {
                seed = mix(read8(p, 0) ^ SECRET1, read8(p, 8) ^ seed)
                see1 = mix(read8(p, 16) ^ SECRET2, read8(p, 24) ^ see1)
                see2 = mix(read8(p, 32) ^ SECRET3, read8(p, 40) ^ see2)
                p = p + 48
                left -= 48
            }
            seed ^= see1 ^ see2
        }
        while left > 16 {
            seed = mix(read8(p, 0) ^ SECRET1, read8(p, 8) ^ seed)
            left -= 16
            p = p + 16
        }
        a = read8(p, left - 16)
        b = read8(p, left - 8)
    }
    a ^= SECRET1
    b ^= seed
    mum(&a, &b)
    return mix(a ^ SECRET0 ^ @intCast(u64, length), b ^ SECRET1)
}

// The hash of `bytes` (seed 0).
pub fn hashBytes(bytes: []const u8) -> u64 { return wyhash(bytes, 0) }

// The hash of one 64-bit word.
pub fn hashWord(value: u64) -> u64 {
    return mix(value ^ SECRET0, SECRET1 ^ 8)
}

// `hash` folded into `seed`: the hash of a sequence, in order.
pub fn combine(seed: u64, hash: u64) -> u64 {
    return mix(seed ^ hash, SECRET1)
}

// ---------------------------------------------------------------------------
// By the type

// An integer of up to 64 bits as a word (signed ones sign-extended, so
// that -1 hashes alike as an i8 and as an i64). The bits above the
// integer's width are masked off by hand: a narrow value read out of a
// slice or cast down is not always cleared above its width.
fn wordOf(comptime T: type, value: T) -> u64 {
    const bits = @bitSizeOf(T)
    if bits >= 64 {
        if @isSigned(T) { return @bitCast(u64, value) }
        return @intCast(u64, value)
    }
    const mask: u64 = (@intCast(u64, 1) << @intCast(u6, bits)) - 1
    var word: u64 = 0
    if @isSigned(T) {
        word = @bitCast(u64, @intCast(i64, value)) & mask
        if (word >> @intCast(u6, bits - 1)) & 1 == 1 { word |= ~mask }
    } else {
        word = @intCast(u64, value) & mask
    }
    return word
}

// A type whose bytes are its value: hashed and compared as bytes when it
// is the element of a slice or an array.
fn isPlain(comptime T: type) -> bool {
    return @isInteger(T) || @isBool(T) || @isEnum(T) || @isFloat(T)
}

fn hashFields(comptime T: type, value: T, comptime index: usize, seed: u64) -> u64 {
    if index < @fieldCount(T) {
        const next = combine(seed, autoHash(@typeOf(@field(value, index)), @field(value, index)))
        return hashFields(T, value, index + 1, next)
    }
    return seed
}

// The hash of `value`, derived from its type.
pub fn autoHash(comptime T: type, value: T) -> u64 {
    if @isInteger(T) {
        return hashWord(wordOf(T, value))
    } else if @isBool(T) {
        return hashWord(if value { 1 } else { 0 })
    } else if @isEnum(T) {
        return hashWord(@intCast(u64, @intFromEnum(value)))
    } else if @isFloat(T) {
        if @bitSizeOf(T) == 32 {
            // (Masked: the high half of a 32-bit bit cast is not cleared.)
            const narrow = @bitCast(u32, value)
            return hashWord(@intCast(u64, narrow) & LOW32)
        }
        return hashWord(@bitCast(u64, value))
    } else if @isPointer(T) {
        return hashWord(@intCast(u64, @intFromPtr(value)))
    } else if @isOptional(T) {
        if value == null { return hashWord(0) ^ SECRET2 }
        return combine(1, autoHash(@childType(T), value.?))
    } else if @isSlice(T) {
        if isPlain(@childType(T)) {
            // Integers, bools, enums and floats: their bytes, in one
            // wyhash call (the same bytes as the array of them).
            var bytes: [*]const u8 = undefined
            unsafe { bytes = @ptrCast([*]const u8, value.pointer) }
            return wyhash(bytes[0..value.length * @sizeOf(@childType(T))], 0)
        }
        var seed: u64 = hashWord(@intCast(u64, value.length))
        for element in value {
            seed = combine(seed, autoHash(@childType(T), element))
        }
        return seed
    } else if @isArray(T) {
        if isPlain(@childType(T)) {
            var bytes: [*]const u8 = undefined
            unsafe { bytes = @ptrCast([*]const u8, &value) }
            return wyhash(bytes[0..@sizeOf(T)], 0)
        }
        var seed: u64 = hashWord(@intCast(u64, value.length))
        for element in value {
            seed = combine(seed, autoHash(@childType(T), element))
        }
        return seed
    } else if @isStruct(T) || @isTuple(T) {
        return hashFields(T, value, 0, SECRET3)
    } else {
        @compileError("std.hash.autoHash: no hash for this type (give the map a Context)")
    }
}

fn bytesEql(left: [*]const u8, right: [*]const u8, length: usize) -> bool {
    var at: usize = 0
    while at < length {
        if left[at] != right[at] { return false }
        at += 1
    }
    return true
}

fn eqlFields(comptime T: type, a: T, b: T, comptime index: usize) -> bool {
    if index < @fieldCount(T) {
        if !autoEql(@typeOf(@field(a, index)), @field(a, index), @field(b, index)) { return false }
        return eqlFields(T, a, b, index + 1)
    }
    return true
}

// Whether `a` and `b` are equal, derived from their type (what autoHash
// hashes alike).
pub fn autoEql(comptime T: type, a: T, b: T) -> bool {
    if @isInteger(T) {
        return wordOf(T, a) == wordOf(T, b)
    } else if @isBool(T) || @isEnum(T) || @isFloat(T) || @isPointer(T) {
        return a == b
    } else if @isOptional(T) {
        if a == null || b == null { return (a == null) == (b == null) }
        return autoEql(@childType(T), a.?, b.?)
    } else if @isSlice(T) {
        if a.length != b.length { return false }
        if isPlain(@childType(T)) {
            var left: [*]const u8 = undefined
            var right: [*]const u8 = undefined
            unsafe {
                left = @ptrCast([*]const u8, a.pointer)
                right = @ptrCast([*]const u8, b.pointer)
            }
            return bytesEql(left, right, a.length * @sizeOf(@childType(T)))
        }
        var at: usize = 0
        while at < a.length {
            if !autoEql(@childType(T), a[at], b[at]) { return false }
            at += 1
        }
        return true
    } else if @isArray(T) {
        if isPlain(@childType(T)) {
            var left: [*]const u8 = undefined
            var right: [*]const u8 = undefined
            unsafe {
                left = @ptrCast([*]const u8, &a)
                right = @ptrCast([*]const u8, &b)
            }
            return bytesEql(left, right, @sizeOf(T))
        }
        var at: usize = 0
        while at < a.length {
            if !autoEql(@childType(T), a[at], b[at]) { return false }
            at += 1
        }
        return true
    } else if @isStruct(T) || @isTuple(T) {
        return eqlFields(T, a, b, 0)
    } else {
        @compileError("std.hash.autoEql: no equality for this type (give the map a Context)")
    }
}

// ---------------------------------------------------------------------------
// Contexts

// Keys that are strings ([]const u8), by content.
pub const StringContext = struct {
    pub fn hash(self: Self, key: []const u8) -> u64 { return wyhash(key, 0) }

    pub fn eql(self: Self, a: []const u8, b: []const u8) -> bool {
        if a.length != b.length { return false }
        var at: usize = 0
        while at < a.length {
            if a[at] != b[at] { return false }
            at += 1
        }
        return true
    }
}

// Keys of type K, by autoHash and autoEql: `AutoContext(K)` is in
// std/src/containers/hash_map.mlx (std.AutoContext) until the compiler
// takes a struct type in a function body; it moves here then.
