// std.shaping: text shaping, HarfBuzz's way (HarfBuzz 8.3 is the model and
// what the tests compare with): fonts' OpenType tables (cmap, metrics,
// variations, GDEF, GSUB, GPOS), buffers of text that become glyphs with
// positions, and the shapers of the scripts. compiler/capi/harfbuzz makes
// HarfBuzz's C API of it (libmlxharfbuzz.so).
//
// The library's objects (blobs, faces, fonts, buffers, sets, maps, the
// function tables of fonts, Unicode, drawing and painting) are reached
// through their addresses (usize), reference counted, as in HarfBuzz; the
// submodules below hold their functions, named after HarfBuzz's without
// the hb_ prefix (hb_buffer_add_utf8 is buffer.bufferAddUtf8):
//
//     const shaping = @import("std.shaping")
//     const blob = shaping.blob.blobCreateFromFile(path)
//     const face = shaping.face.faceCreate(blob, 0)
//     const font = shaping.otfont.fontCreate(face)
//     const buffer = shaping.buffer.bufferCreate()
//     shaping.buffer.bufferAddUtf8(buffer, text, length, 0, length)
//     shaping.buffer.bufferGuessSegmentProperties(buffer)
//     shaping.shape.shape(font, buffer, 0, 0)
//     // (the glyphs: buffer.bufferGetGlyphInfos, bufferGetGlyphPositions)
//
// Beyond shaping, the modules read what HarfBuzz's hb-ot API reads of a
// font: outlines (glyf, CFF, CFF2) and their extents, color glyphs (CPAL,
// COLR layers and paint graphs, SVG, CBDT, sbix), names, style values,
// MATH, BASE, meta, the lookups' glyphs and their closures. Apple's AAT
// tables (morx, kerx, trak) are not read: such fonts shape with their
// OpenType tables, when they have them.
//
// Memory comes from a std allocator (memory.useAllocator), the page
// allocator by default.
pub const memory = @import("./shaping/memory.mlx")
pub const object = @import("./shaping/object.mlx")
pub const common = @import("./shaping/common.mlx")
