// std.displaymodes: a brixOS display's modes, for the program that draws
// on the screen (a compositor) and for a tool of the system's owner: the
// modes the display's monitor offers, the one that runs, another asked
// for, confirmed or taken back, and the word that the display has changed
// (spec/04-stdlib/os/brix.xml, <Displays>; calls 78 and 79).
//
// A display is its node, /devices/framebuffer (the main one) and
// /devices/framebuffer1 and on (std.displays shows the main one's picture
// on those). With a handle of the node:
//
//     var state: displaymodes.State = undefined
//     _ = displaymodes.state(handle, &state)       // what runs, what is pending
//     var modes: [displaymodes.MOST]displaymodes.Mode = undefined
//     const count = displaymodes.list(handle, modes[0..])
//     ... the person picks modes[k] (one with `can`) ...
//     if displaymodes.ask(handle, modes[k].width, modes[k].height, modes[k].millihertz) == 0 {
//         // The display runs it now, and the node's handle says CHANGED:
//         // read the state again, map the pixels anew (the size, the
//         // pitch and the memory are other ones), draw, and ask the
//         // person whether they see it. Then, within state.left:
//         _ = displaymodes.confirm(handle)         // it stays, also at the next boots
//         // or
//         _ = displaymodes.takeBack(handle)        // the mode before again
//     }
//
// A mode nobody confirms within fifteen seconds is taken back by the
// kernel itself: a mode the monitor does not show cannot be answered
// for. Each change of the display, whoever made it, shows as the CHANGED
// state of every handle of its node until that handle has read the node
// again (`changed`, or the one `wait` with brix.State.CHANGED among the
// program's other handles). A mapping of the old picture stays what it
// was, memory of the adapter that the display may show no more: it never
// faults, and it is to be unmapped and made anew.
//
// Who may ask, confirm and take back: a process of user 0, and the
// process that draws on the display (the last that mapped its pixels)
// when the display's node is its user's. Everyone may read.
const std = @import("std")

const brix = std.os.brix

// The most modes a display has.
pub const MOST: usize = 96

// Why a mode cannot be set (Mode.why; 0: it can).
pub const Why = struct {
    pub const NONE: u32 = 0
    pub const NO_DRIVER: u32 = 1
    pub const OUTPUT: u32 = 2
    pub const TOO_FAST: u32 = 3
    pub const TOO_SLOW: u32 = 4
    pub const INTERLACED: u32 = 5
    pub const DOUBLED: u32 = 6
    pub const STEREO: u32 = 7
    pub const NO_TIMING: u32 = 8
    pub const MEMORY: u32 = 9
    pub const SIZE: u32 = 10
    pub const SAME_SIZE: u32 = 11
    pub const CARD: u32 = 12
}

// The reason in plain words.
pub fn whyText(why: u32) -> []const u8 {
    if why == Why.NO_DRIVER { return "this display is as the firmware left it, and no driver of this system sets its mode" }
    if why == Why.OUTPUT { return "the display's driver changes the mode of an HDMI or DVI output only" }
    if why == Why.TOO_FAST { return "more than this output carries" }
    if why == Why.TOO_SLOW { return "less than this output sends" }
    if why == Why.INTERLACED { return "an interlaced picture, which is not built" }
    if why == Why.DOUBLED { return "a picture whose pixels are sent twice, which is not built" }
    if why == Why.STEREO { return "a picture for stereo glasses, which is not built" }
    if why == Why.NO_TIMING { return "the monitor names it by size and rate alone, and the standard's table has no timing for it" }
    if why == Why.MEMORY { return "more than the adapter's memory holds" }
    if why == Why.SIZE { return "not a size this adapter makes" }
    if why == Why.SAME_SIZE { return "another rate of the size that runs, which this driver does not set" }
    if why == Why.CARD { return "the card is not in a state its driver changes a mode from (the kernel's log says what is missing)" }
    return "it can be set"
}

// Where a mode is from (Mode.source).
pub const Source = struct {
    pub const DETAILED: u32 = 1
    pub const ESTABLISHED: u32 = 2
    pub const STANDARD: u32 = 3
    pub const VIDEO_CODE: u32 = 4
    pub const ASKED: u32 = 5
    pub const RUNNING: u32 = 6
}

// One mode, as its record has it.
pub const Mode = struct {
    width: u32
    height: u32
    // Frames in a thousand seconds (an interlaced picture's fields); 0:
    // not known.
    millihertz: u32
    // It runs now; it is the monitor's own; the display's driver can set
    // it; it is the one the next boots set; while a change is pending,
    // the mode before, which comes back.
    runs: bool
    own: bool
    can: bool
    kept: bool
    before: bool
    interlaced: bool
    doubled: bool
    // Why it cannot be set (Why), and where it is from (Source).
    why: u32
    source: u32
    // Its timing (0 throughout when it has none): the pixel clock in
    // kHz; across the total, the front porch and the sync pulse; down
    // the same; whether each pulse is the high one.
    clock: u32
    hTotal: u32
    hFront: u32
    hSync: u32
    vTotal: u32
    vFront: u32
    vSync: u32
    hPositive: bool
    vPositive: bool
    // The output's most in kHz, where the mode is more than it carries.
    limit: u32
}

// The kinds of driver (State.driver).
pub const Driver = struct {
    pub const FIRMWARE: usize = 0
    pub const QEMU: usize = 1
    pub const RADEON_TMDS: usize = 2
    pub const RADEON_OTHER: usize = 3
}

// What the last request came to (State.last).
pub const Last = struct {
    pub const NONE: usize = 0
    pub const CHANGED: usize = 1
    pub const ALREADY: usize = 2
    pub const CONFIRMED: usize = 3
    pub const TAKEN_BACK: usize = 4
    // Taken back by the kernel: nobody confirmed in time.
    pub const TIMED_OUT: usize = 5
    pub const BUSY: usize = 6
    pub const NOTHING_PENDING: usize = 7
    pub const NOT_LISTED: usize = 8
    // The mode cannot be set (State.lastWhy); nothing was written.
    pub const REFUSED: usize = 9
    // The change failed on the way: the mode before is back, or what the
    // display shows is not known.
    pub const FAILED_BACK: usize = 10
    pub const FAILED_LOST: usize = 11
}

// A display as its node says it: the picture (its size, the bytes from
// row to row, the pixels' order: 1 blue first, 2 red first), the shape of
// the screen it is shown on, which display it is of how many, its
// adapter; then its mode's state.
pub const State = struct {
    width: usize
    height: usize
    pitch: usize
    format: usize
    shapeWidth: usize
    shapeHeight: usize
    number: usize
    count: usize
    vendor: usize
    device: usize
    // How often the display's picture changed since the boot.
    changes: usize
    // A change waits to be confirmed, and for how many nanoseconds more.
    pending: bool
    left: usize
    // The display has a driver that changes modes; it makes sizes that
    // are not listed; a mode is remembered for the next boots.
    settable: bool
    anySize: bool
    remembered: bool
    // The rate that runs (frames in a thousand seconds; 0: not known),
    // the driver's kind, what the last request came to and why a mode was
    // refused.
    millihertz: usize
    driver: usize
    last: usize
    lastWhy: u32
}

// The node of display `number` (0: the main one) opened to read and to
// ask; a handle, or a status.
pub fn open(number: usize) -> isize {
    var path: [24]u8 = undefined
    const stem = "/devices/framebuffer"
    var length: usize = 0
    while length < stem.length {
        path[length] = stem[length]
        length += 1
    }
    if number != 0 {
        path[length] = @intCast(u8, 48 + number % 10)
        length += 1
    }
    return brix.open(0, path[0..length], brix.Open.READ | brix.Open.WRITE, 0)
}

fn word(bytes: [*]const u8, at: usize, count: usize) -> usize {
    var value: usize = 0
    var k: usize = count
    while k > 0 {
        k -= 1
        value = (value << 8) | @intCast(usize, bytes[at + k])
    }
    return value
}

// The display's state read from its node (which also takes the handle's
// CHANGED away); false when the node does not say it (not a display's
// node, or a kernel from before a display had modes).
pub fn state(display: brix.Handle, into: *State) -> bool {
    var record: [128]u8 = undefined
    if brix.read(display, record[0..128], 0) != 128 { return false }
    const bytes: [*]const u8 = &record
    into.*.width = word(bytes, 0, 8)
    into.*.height = word(bytes, 8, 8)
    into.*.pitch = word(bytes, 16, 8)
    into.*.format = word(bytes, 24, 8)
    into.*.shapeWidth = word(bytes, 32, 8)
    into.*.shapeHeight = word(bytes, 40, 8)
    into.*.number = word(bytes, 48, 8)
    into.*.count = word(bytes, 56, 8)
    into.*.vendor = word(bytes, 64, 8)
    into.*.device = word(bytes, 72, 8)
    into.*.changes = word(bytes, 80, 8)
    const bits = word(bytes, 88, 8)
    into.*.pending = bits & 1 != 0
    into.*.settable = bits & 2 != 0
    into.*.anySize = bits & 4 != 0
    into.*.remembered = bits & 8 != 0
    into.*.left = word(bytes, 96, 8)
    into.*.millihertz = word(bytes, 104, 8)
    into.*.driver = word(bytes, 112, 8)
    const last = word(bytes, 120, 8)
    into.*.last = last & 0xFF
    into.*.lastWhy = @intCast(u32, (last >> 8) & 0xFFFFFF)
    return true
}

// The display's modes into `into`, the largest first; how many were
// written (0: none, or no display's node).
pub fn list(display: brix.Handle, into: []Mode) -> usize {
    var records: [MOST * brix.DISPLAY_MODE_RECORD]u8 = undefined
    const all = brix.displayModes(display, records[0..])
    if all <= 0 { return 0 }
    var count = @bitCast(usize, all)
    if count > MOST { count = MOST }
    if count > into.length { count = into.length }
    const bytes: [*]const u8 = &records
    var k: usize = 0
    while k < count {
        const at = k * brix.DISPLAY_MODE_RECORD
        const flags = word(bytes, at + 12, 4)
        const polarity = word(bytes, at + 52, 4)
        into[k] = Mode.{
            .width = @intCast(u32, word(bytes, at, 4)),
            .height = @intCast(u32, word(bytes, at + 4, 4)),
            .millihertz = @intCast(u32, word(bytes, at + 8, 4)),
            .runs = flags & 0x1 != 0,
            .own = flags & 0x2 != 0,
            .can = flags & 0x4 != 0,
            .interlaced = flags & 0x8 != 0,
            .kept = flags & 0x10 != 0,
            .before = flags & 0x20 != 0,
            .doubled = flags & 0x40 != 0,
            .why = @intCast(u32, word(bytes, at + 16, 4)),
            .source = @intCast(u32, word(bytes, at + 20, 4)),
            .clock = @intCast(u32, word(bytes, at + 24, 4)),
            .hTotal = @intCast(u32, word(bytes, at + 28, 4)),
            .hFront = @intCast(u32, word(bytes, at + 32, 4)),
            .hSync = @intCast(u32, word(bytes, at + 36, 4)),
            .vTotal = @intCast(u32, word(bytes, at + 40, 4)),
            .vFront = @intCast(u32, word(bytes, at + 44, 4)),
            .vSync = @intCast(u32, word(bytes, at + 48, 4)),
            .hPositive = polarity & 1 != 0,
            .vPositive = polarity & 2 != 0,
            .limit = @intCast(u32, word(bytes, at + 56, 4)),
        }
        k += 1
    }
    return count
}

// The mode of `width` by `height` at `millihertz` (0: at any rate; of a
// display whose driver makes any size, a size that is not listed) asked
// for. 0: it runs now and waits to be confirmed (or it ran already:
// State.pending tells). Else minus a brix.Status: no_right (the head says
// who may), busy (a mode is pending: confirm it or take it back first),
// not_found (the display has no such mode), unsupported (it cannot be
// set: State.lastWhy, or the mode's own `why`), io_error (the change
// failed on the way: State.last says whether the mode before is back).
pub fn ask(display: brix.Handle, width: usize, height: usize, millihertz: usize) -> isize { return brix.displayMode(display, brix.DisplayWhat.ASK, width, height, millihertz) }

// The pending mode stays, and is what the next boots set. not_found:
// none is pending (the kernel may have taken it back).
pub fn confirm(display: brix.Handle) -> isize { return brix.displayMode(display, brix.DisplayWhat.CONFIRM, 0, 0, 0) }

// The pending mode taken back: the mode before runs again.
pub fn takeBack(display: brix.Handle) -> isize { return brix.displayMode(display, brix.DisplayWhat.TAKE_BACK, 0, 0, 0) }

// Whether the display has changed since this handle last read its node.
pub fn changed(display: brix.Handle) -> bool {
    var info: brix.Info = undefined
    if brix.info(display, &info) < 0 { return false }
    return info.state & brix.State.CHANGED != 0
}

// Waits until the display has changed or the monotonic clock says
// `deadline` (brix.FOREVER: without one); whether it has.
pub fn waitChanged(display: brix.Handle, deadline: usize) -> bool {
    var items: [1]brix.WaitItem = undefined
    items[0] = brix.WaitItem.{ .handle = display, .want = brix.State.CHANGED, .seen = 0, .reserved = 0 }
    _ = brix.wait(items[0..1], deadline)
    return items[0].seen & brix.State.CHANGED != 0
}
