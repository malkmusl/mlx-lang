// std.truetype: fonts in Mlx, without a C library: TrueType and OpenType
// (glyf and CFF/CFF2 outlines) fonts and their collections, variable
// fonts, color fonts (COLR, CPAL, embedded bitmaps), read and rendered as
// FreeType 2.13 reads and renders them, to the bit.
//
//     const tt = @import("std.truetype")
//
//     var font: tt.Font = undefined
//     if tt.loadFile(&font, path, allocator) != tt.Status.ok { ... }
//     var atlas: tt.Atlas = undefined
//     if !tt.initAtlas(&atlas, &font, 20, 512, 512, allocator) { ... }
//     var run: tt.Run = undefined
//     if !tt.initRun(&run, 128, allocator) { ... }
//     tt.layout(&atlas, "Hello, Mlx", &run)
//     tt.drawRun(&atlas, &run, pixels, width, height, width, x, baseline, 0xFFFFFFFF, 0)
//
// Two levels. A Font, its Atlas and Runs are the simple one: glyphs of
// the font's Unicode charmap rendered unhinted into 8-bit coverage at a
// scale, packed into an atlas, laid out on a line (advances and the
// `kern` table's kerning) and blended into 0xAARRGGBB pixels. drawRun()
// blends a run as the Vulkan examples' `text` compute shader
// (std/src/gpu/shaders.mlx) does on the GPU, with the same integer
// arithmetic, so both produce identical pixels.
//
// The engine under it is the other (the modules re-exported below, in
// std/src/truetype/): a Library (its memory, LCD filter, CFF driver's
// properties) opens Faces (face.newFace and face.openFace); a face has
// sizes (face.setPixelSizes, face.requestSize...), charmaps
// (load.charIndex, info), its tables (objects.table, sfnt), a glyph
// slot glyphs are loaded into (load.loadGlyph: outlines, metrics,
// embedded bitmaps) and rendered in (render.renderGlyph: gray, LCD and
// monochrome bitmaps, as FreeType's rasterizers); outlines, bitmaps,
// variations (named instances, design or normalized coordinates) and
// colors (palettes, COLR layers and paints) have modules of their own.
// Its records are reached by their addresses; its errors are FreeType's
// numbers (records.ERR_...). compiler/libc/freetype makes FreeType's C
// API of it.

const allocator_module = @import("../bootstrap/allocator.mlx")
const heap = @import("std.heap")
const fs = @import("../bootstrap/fs.mlx")

pub const memory = @import("./truetype/memory.mlx")
pub const records = @import("./truetype/records.mlx")
pub const objects = @import("./truetype/objects.mlx")
pub const library = @import("./truetype/library.mlx")
pub const calc = @import("./truetype/calc.mlx")
pub const faces = @import("./truetype/face.mlx")
pub const sfnt = @import("./truetype/sfnt.mlx")
pub const cmap = @import("./truetype/cmap.mlx")
pub const info = @import("./truetype/info.mlx")
pub const load = @import("./truetype/load.mlx")
pub const render = @import("./truetype/render.mlx")
pub const outlines = @import("./truetype/outlines.mlx")
pub const bitmaps = @import("./truetype/bitmap.mlx")
pub const variations = @import("./truetype/variations.mlx")
pub const color = @import("./truetype/color.mlx")
pub const psnames = @import("./truetype/psnames.mlx")
pub const glyf = @import("./truetype/glyf.mlx")
pub const cffload = @import("./truetype/cffload.mlx")
pub const cf2 = @import("./truetype/cf2.mlx")
pub const cff = @import("./truetype/cff.mlx")
pub const sbit = @import("./truetype/sbit.mlx")
pub const raster = @import("./truetype/raster.mlx")

pub const Allocator = allocator_module.Allocator
pub const Library = library.Library
pub const Memory = memory.Memory
pub const Face = objects.Face
pub const Size = objects.Size
pub const Slot = objects.Slot
pub const CharMap = objects.CharMap
pub const Vector = records.Vector
pub const Matrix = records.Matrix
pub const BBox = records.BBox
pub const GlyphMetrics = records.GlyphMetrics
pub const Outline = records.Outline
pub const SizeRequest = records.SizeRequest

// The engine's records of an address.
pub fn face(address: usize) -> *Face { return objects.faceRecord(address) }
pub fn slot(address: usize) -> *Slot { return objects.slotRecord(address) }
pub fn size(address: usize) -> *Size { return objects.sizeRecord(address) }

// A library of the engine whose memory is an allocator's: `engine` holds
// the allocator, the Memory record and the library (and must stay where
// it is while the library is used).
pub const Engine = struct {
    allocator: Allocator
    memory: Memory
    library: Library
    // The scale the face of a Font was last set to (16.16; 0 none).
    scale: i64
}

pub fn initEngine(engine: *Engine, allocator: Allocator) -> void {
    engine.*.allocator = allocator
    memory.useAllocator(&engine.*.memory, &engine.*.allocator)
    library.init(&engine.*.library, @intFromPtr(&engine.*.memory))
    _ = library.setLcdFilter(&engine.*.library, 1)
    engine.*.scale = 0
}

// The engine's library of an Engine, by address.
pub fn libraryOf(engine: *Engine) -> usize { return @intFromPtr(&engine.*.library) }

// ---------------------------------------------------------------------------
// What a shaper reads of a face (std.shaping): its tables, the advances
// and extents of its glyphs, its variation coordinates.

// The face's font file: its bytes and their number.
pub fn fontData(face_: usize) -> [*]const u8 { unsafe { return @ptrFromInt([*]const u8, objects.faceRecord(face_).*.data) } }
pub fn fontSize(face_: usize) -> usize { return @intCast(usize, objects.faceRecord(face_).*.size) }

// A table of the face's font (its tag as four bytes big-endian, e.g.
// 0x47535542 for `GSUB`): its offset in the font file and its length (0
// when the font has none).
pub fn table(face_: usize, tag: u32) -> (u64, u64) { return objects.table(objects.faceRecord(face_), tag) }

// The advance of a glyph in font units, varied by the face's coordinates
// (vertical: from `vmtx`, or made up as FreeType does), or 0 when the
// glyph is not the face's.
pub fn glyphAdvance(face_: usize, glyph: u32, vertical: bool) -> i64 {
    var advance: i64 = 0
    const flags = records.LOAD_NO_SCALE | (if vertical { records.LOAD_VERTICAL_LAYOUT } else { 0 })
    if load.getAdvances(face_, @intCast(i64, glyph), 1, flags, @intFromPtr(&advance)) != records.OK { return 0 }
    return advance
}

// A glyph's extents in font units (its box: left bearing, top, width and
// height in its metrics), loaded unscaled into the face's glyph slot;
// false when it does not load.
pub fn glyphExtents(face_: usize, glyph: u32, metrics: *GlyphMetrics) -> bool {
    if load.loadGlyph(face_, @intCast(i64, glyph), records.LOAD_NO_SCALE) != records.OK { return false }
    const s = objects.slotRecord(objects.faceRecord(face_).*.glyph)
    metrics.* = s.*.metrics
    return true
}

// The face's normalized variation coordinates (16.16, one an axis): their
// number and address (0 and 0 for a face that does not vary).
pub fn variationCoordinates(face_: usize) -> (u64, usize) { return variations.normalizedCoords(face_) }

// ---------------------------------------------------------------------------
// Fonts

pub const Status = enum(u8) {
    ok,
    unreadable,
    truncated,
    notTrueType,
    missingTable,
    noUnicodeMap,
    outOfMemory,
}

pub fn statusMessage(status: Status) -> []const u8 {
    return match status {
        Status.ok => "ok",
        Status.unreadable => "the font file cannot be read",
        Status.truncated => "the font file is truncated or damaged",
        Status.notTrueType => "not a scalable TrueType or OpenType font",
        Status.missingTable => "a required table (head, maxp, hhea, hmtx, cmap, loca, glyf or CFF) is missing",
        Status.noUnicodeMap => "the font has no Unicode character map",
        else => "out of memory",
    }
}

// A font of the engine with its Unicode charmap selected; its values
// (in font units) are read once.
pub const Font = struct {
    data: [*]const u8
    size: usize
    // Owned by the font when it was loaded from a file (loadFile).
    owned: bool
    ownedCapacity: usize
    allocator: Allocator
    unitsPerEm: u32
    numGlyphs: u32
    // Whether `loca` has long offsets (TrueType outlines).
    longLoca: bool
    // Vertical metrics (hhea): descender is negative.
    ascender: i32
    descender: i32
    lineGap: i32
    // The format of the Unicode charmap.
    cmapFormat: u32
    // The kerning pairs of the `kern` table (its horizontal subtables).
    kernCount: u32
    // The engine (an Engine of `allocator`) and the face.
    engine: usize
    face: usize
}

fn engineOf(font: *const Font) -> *Engine { unsafe { return @ptrFromInt(*Engine, font.*.engine) } }

fn statusOf(err: i32) -> Status {
    if err == records.OK { return Status.ok }
    if err == records.ERR_CANNOT_OPEN_RESOURCE || err == records.ERR_CANNOT_OPEN_STREAM { return Status.unreadable }
    if err == records.ERR_UNKNOWN_FILE_FORMAT || err == records.ERR_INVALID_FILE_FORMAT { return Status.notTrueType }
    if err == records.ERR_TABLE_MISSING || err == records.ERR_HORIZ_HEADER_MISSING || err == records.ERR_LOCATIONS_MISSING || err == records.ERR_NAME_TABLE_MISSING || err == records.ERR_HMTX_TABLE_MISSING { return Status.missingTable }
    if err == records.ERR_OUT_OF_MEMORY { return Status.outOfMemory }
    return Status.truncated
}

// The pairs of the `kern` table's horizontal format 0 subtables.
fn kernPairs(f: *Face) -> u32 {
    if f.*.kernOffset == 0 { return 0 }
    var count: u32 = 0
    var p = f.*.kernOffset + 4
    const limit = f.*.kernOffset + f.*.kernSize
    var mask: u64 = 1
    var n = f.*.kernTables
    while n > 0 && p + 6 <= limit {
        const length = @intCast(u64, objects.u16At(f, p + 2))
        if (f.*.kernAvailBits & mask) != 0 { count += @intCast(u32, objects.u16At(f, p + 6)) }
        p += length
        mask <<= 1
        n -= 1
    }
    return count
}

// Reads `data[0 .. size]` (which must outlive the font) with an engine of
// `allocator`.
pub fn initWith(font: *Font, data: [*]const u8, size_: usize, allocator: Allocator) -> Status {
    font.*.data = data
    font.*.size = size_
    font.*.owned = false
    font.*.ownedCapacity = 0
    font.*.allocator = allocator
    font.*.face = 0
    font.*.engine = 0
    if size_ >= 4 {
        // (Bytes that are no SFNT and no collection of them.)
        const tag = (@intCast(u32, data[0]) << 24) | (@intCast(u32, data[1]) << 16) | (@intCast(u32, data[2]) << 8) | @intCast(u32, data[3])
        if tag != 0x00010000 && tag != 0x00020000 && tag != 0x74727565 && tag != 0x4F54544F && tag != 0x74746366 { return Status.notTrueType }
    }
    const block = allocator.alloc(@sizeOf(Engine), 16)
    if block == null { return Status.outOfMemory }
    font.*.engine = @intFromPtr(block.?)
    const engine = engineOf(font)
    initEngine(engine, allocator)
    const opened = faces.newFace(libraryOf(engine), faces.SOURCE_MEMORY, @intFromPtr(data), @intCast(u64, size_), 0)
    var err = opened.0
    if err == records.OK {
        err = faces.openFace(opened.1, 0, 0, 2)
        if err == records.OK { font.*.face = opened.1 }
    }
    if err != records.OK {
        freeEngine(font)
        return statusOf(err)
    }
    const f = objects.faceRecord(font.*.face)
    if (f.*.faceFlags & records.FACE_SCALABLE) == 0 {
        close(font)
        return Status.notTrueType
    }
    if f.*.charmap == 0 || objects.charMap(f.*.charmap).*.encoding != records.ENCODING_UNICODE {
        close(font)
        return Status.noUnicodeMap
    }
    font.*.unitsPerEm = @intCast(u32, f.*.unitsPerEm)
    font.*.numGlyphs = @intCast(u32, f.*.numGlyphs)
    font.*.longLoca = f.*.outlines == objects.OUTLINES_GLYF && sfnt.indexToLocFormat(f) != 0
    font.*.ascender = @intCast(i32, sfnt.ascender(f))
    font.*.descender = @intCast(i32, sfnt.descender(f))
    font.*.lineGap = @intCast(i32, sfnt.lineGap(f))
    const format = cmap.format(f.*.charmap)
    font.*.cmapFormat = if format < 0 { 0 } else { @intCast(u32, format) }
    font.*.kernCount = kernPairs(f)
    return Status.ok
}

// Reads `data[0 .. size]` (which must outlive the font).
pub fn init(font: *Font, data: [*]const u8, size_: usize) -> Status { return initWith(font, data, size_, heap.allocator()) }

// Reads the font at `path`; the font owns the file's contents (close()).
pub fn loadFile(font: *Font, path: [*]const u8, allocator: Allocator) -> Status {
    font.*.owned = false
    font.*.engine = 0
    font.*.face = 0
    const loaded = fs.readFileAlloc(path, allocator)
    if loaded == null { return Status.unreadable }
    const contents = loaded.?
    if contents.length == 0 {
        fs.ArrayList.deinit(contents)
        return Status.unreadable
    }
    const data: [*]const u8 = unsafe { @ptrCast([*]const u8, contents.items) }
    const status = initWith(font, data, contents.length, allocator)
    font.*.owned = true
    font.*.ownedCapacity = contents.capacity
    font.*.data = data
    if status != Status.ok { close(font) }
    return status
}

fn freeEngine(font: *Font) -> void {
    if font.*.engine != 0 {
        unsafe { font.*.allocator.free(@ptrFromInt([*]u8, font.*.engine), @sizeOf(Engine), 16) }
        font.*.engine = 0
    }
}

pub fn close(font: *Font) -> void {
    if font.*.face != 0 {
        faces.doneFace(font.*.face)
        font.*.face = 0
    }
    freeEngine(font)
    if font.*.owned {
        unsafe { font.*.allocator.free(@ptrCast([*]u8, font.*.data), font.*.ownedCapacity, 1) }
        font.*.owned = false
    }
}

// ---------------------------------------------------------------------------
// Characters, metrics and kerning

// The glyph for a Unicode code point; 0 (.notdef) when the font has none.
pub fn glyphIndex(font: *const Font, codepoint: u32) -> u32 { return @intCast(u32, load.charIndex(font.*.face, @intCast(u64, codepoint))) }

// Horizontal advance in font units.
pub fn advanceWidth(font: *const Font, glyph: u32) -> i32 { return @intCast(i32, variations.glyphMetrics(font.*.face, false, @intCast(i64, glyph)).1) }

// Kerning between two glyphs in font units (the `kern` table).
pub fn kerning(font: *const Font, left: u32, right: u32) -> i32 { return @intCast(i32, sfnt.kerning(objects.faceRecord(font.*.face), @intCast(i64, left), @intCast(i64, right))) }

fn toInt(value: f64) -> i64 {
    const result: i64 = @intFromFloat(i64, value)
    return result
}

fn toFloat(value: i64) -> f64 {
    const result: f64 = @floatFromInt(f64, value)
    return result
}

// ---------------------------------------------------------------------------
// Rasterization

// A glyph's coverage bitmap: `width` x `height` bytes (0 to 255), placed
// `left` pixels right of the pen and `top` pixels below the baseline (top
// is negative for glyphs that rise above it).
pub const Bitmap = struct {
    pixels: [*]u8
    width: usize
    height: usize
    left: i32
    top: i32
}

// The pixels per font unit for a line `pixel_height` pixels tall
// (ascender to descender).
pub fn scaleForPixelHeight(font: *const Font, pixel_height: u32) -> f64 {
    const pixels: i64 = @intCast(i64, pixel_height)
    const units: i64 = @intCast(i64, font.*.ascender - font.*.descender)
    if units <= 0 { return 0.0 }
    return toFloat(pixels) / toFloat(units)
}

// Sets the size of the font's face to `scale` pixels per font unit (the
// 16.16 scale of font units to 26.6 pixels, rounded).
fn setScale(font: *const Font, scale: f64) -> bool {
    const fixed = toInt(@floor(scale * 4194304.0 + 0.5))
    const engine = engineOf(font)
    if engine.*.scale == fixed { return true }
    var request: SizeRequest = undefined
    request.kind = records.SIZE_REQUEST_SCALES
    request.width = fixed
    request.height = fixed
    request.horiResolution = 0
    request.vertResolution = 0
    if faces.requestSize(font.*.face, &request) != records.OK {
        engine.*.scale = 0
        return false
    }
    engine.*.scale = fixed
    return true
}

// Rasterizes `glyph` at `scale` (unhinted, anti-aliased: FreeType's
// rendering); the caller frees bitmap.pixels (width * height bytes) with
// `allocator`. An empty glyph has width 0.
pub fn rasterize(font: *const Font, glyph: u32, scale: f64, allocator: Allocator, bitmap: *Bitmap) -> bool {
    bitmap.*.width = 0
    bitmap.*.height = 0
    bitmap.*.left = 0
    bitmap.*.top = 0
    if glyph >= font.*.numGlyphs { return true }
    if !setScale(font, scale) { return true }
    if load.loadGlyph(font.*.face, @intCast(i64, glyph), records.LOAD_NO_HINTING | records.LOAD_NO_BITMAP | records.LOAD_RENDER) != records.OK { return true }
    const s = objects.slotRecord(objects.faceRecord(font.*.face).*.glyph)
    const width = @intCast(usize, s.*.bitmap.width)
    const height = @intCast(usize, s.*.bitmap.rows)
    if width == 0 || height == 0 || s.*.bitmap.pixelMode != records.PIXEL_GRAY { return true }
    const pixels_memory = allocator.alloc(width * height, 8)
    if pixels_memory == null { return false }
    const pixels = pixels_memory.?
    const pitch = s.*.bitmap.pitch
    var row: usize = 0
    while row < height {
        // (A negative pitch lists the rows from the bottom.)
        const from = if pitch >= 0 { s.*.bitmap.buffer + row * @intCast(usize, pitch) } else { s.*.bitmap.buffer + (height - 1 - row) * @intCast(usize, 0 - pitch) }
        var column: usize = 0
        while column < width {
            pixels[row * width + column] = memory.get8(from + column)
            column += 1
        }
        row += 1
    }
    bitmap.*.pixels = pixels
    bitmap.*.width = width
    bitmap.*.height = height
    bitmap.*.left = s.*.bitmapLeft
    bitmap.*.top = 0 - s.*.bitmapTop
    return true
}

// ---------------------------------------------------------------------------
// Atlas

pub const AtlasGlyph = struct {
    glyph: u32
    used: bool
    x: u32
    y: u32
    width: u32
    height: u32
    left: i32
    top: i32
}

pub const ATLAS_SLOTS: usize = 1024

// Rasterized glyphs of one font at one size, packed in rows into a
// `width` x `height` coverage image. `revision` changes whenever a glyph is
// added, so a GPU copy knows when to upload again.
pub const Atlas = struct {
    font: *const Font
    scale: f64
    pixelHeight: u32
    // Line metrics in pixels: baseline to top, to bottom, and line to line.
    ascent: i32
    descent: i32
    lineHeight: i32
    width: u32
    height: u32
    pixels: [*]u8
    cursorX: u32
    cursorY: u32
    rowHeight: u32
    revision: u32
    full: bool
    slots: [*]AtlasGlyph
    allocator: Allocator
    // ASCII looked up once: the glyphs, their advances and the kerning of
    // each pair (font units), so layout does no table searches for it.
    asciiGlyphs: [*]u32
    asciiAdvances: [*]i32
    asciiKerning: [*]i32
}

const ASCII: usize = 128
const ASCII_BYTES: usize = ASCII * 4 * 2 + ASCII * ASCII * 4

fn roundToInt(value: f64) -> i32 {
    const whole = toInt(@floor(value + 0.5))
    return @intCast(i32, whole)
}

// `width` must be a multiple of 4 (the GPU reads it as 32-bit words).
pub fn initAtlas(atlas: *Atlas, font: *const Font, pixel_height: u32, width: u32, height: u32, allocator: Allocator) -> bool {
    atlas.*.font = font
    atlas.*.scale = scaleForPixelHeight(font, pixel_height)
    atlas.*.pixelHeight = pixel_height
    const ascender: i64 = @intCast(i64, font.*.ascender)
    const descender: i64 = @intCast(i64, font.*.descender)
    const gap: i64 = @intCast(i64, font.*.lineGap)
    atlas.*.ascent = roundToInt(toFloat(ascender) * atlas.*.scale)
    atlas.*.descent = roundToInt(-toFloat(descender) * atlas.*.scale)
    atlas.*.lineHeight = roundToInt(toFloat(ascender - descender + gap) * atlas.*.scale)
    atlas.*.width = (width + 3) / 4 * 4
    atlas.*.height = height
    atlas.*.cursorX = 1
    atlas.*.cursorY = 1
    atlas.*.rowHeight = 0
    atlas.*.revision = 1
    atlas.*.full = false
    atlas.*.allocator = allocator
    const size_ = @intCast(usize, atlas.*.width) * @intCast(usize, height)
    const pixels = allocator.alloc(size_, 16)
    const slots = allocator.alloc(ATLAS_SLOTS * @sizeOf(AtlasGlyph), 16)
    const ascii = allocator.alloc(ASCII_BYTES, 16)
    if pixels == null || slots == null || ascii == null { return false }
    unsafe {
        atlas.*.asciiGlyphs = @ptrCast([*]u32, ascii.?)
        atlas.*.asciiAdvances = @ptrFromInt([*]i32, @intFromPtr(ascii.?) + ASCII * 4)
        atlas.*.asciiKerning = @ptrFromInt([*]i32, @intFromPtr(ascii.?) + ASCII * 8)
    }
    var code: usize = 0
    while code < ASCII {
        const glyph = glyphIndex(font, @intCast(u32, code))
        atlas.*.asciiGlyphs[code] = glyph
        atlas.*.asciiAdvances[code] = advanceWidth(font, glyph)
        code += 1
    }
    var left: usize = 0
    while left < ASCII {
        var right: usize = 0
        while right < ASCII {
            atlas.*.asciiKerning[left * ASCII + right] = kerning(font, atlas.*.asciiGlyphs[left], atlas.*.asciiGlyphs[right])
            right += 1
        }
        left += 1
    }
    atlas.*.pixels = pixels.?
    var index: usize = 0
    while index < size_ {
        atlas.*.pixels[index] = 0
        index += 1
    }
    unsafe { atlas.*.slots = @ptrCast([*]AtlasGlyph, slots.?) }
    index = 0
    while index < ATLAS_SLOTS {
        slotAt(atlas, index).*.used = false
        index += 1
    }
    return true
}

pub fn deinitAtlas(atlas: *Atlas) -> void {
    const size_ = @intCast(usize, atlas.*.width) * @intCast(usize, atlas.*.height)
    atlas.*.allocator.free(atlas.*.pixels, size_, 16)
    unsafe { atlas.*.allocator.free(@ptrCast([*]u8, atlas.*.slots), ATLAS_SLOTS * @sizeOf(AtlasGlyph), 16) }
    unsafe { atlas.*.allocator.free(@ptrCast([*]u8, atlas.*.asciiGlyphs), ASCII_BYTES, 16) }
}

fn slotAt(atlas: *Atlas, index: usize) -> *AtlasGlyph {
    unsafe { return @ptrFromInt(*AtlasGlyph, @intFromPtr(atlas.*.slots) + index * @sizeOf(AtlasGlyph)) }
}

// A glyph's place in the atlas, rasterizing and packing it on first use;
// null when the atlas is full (or out of memory).
pub fn atlasGlyph(atlas: *Atlas, glyph: u32) -> ?*AtlasGlyph {
    var index = @intCast(usize, (glyph *% 2654435761) >> 22) % ATLAS_SLOTS
    var probes: usize = 0
    while probes < ATLAS_SLOTS {
        const slot_ = slotAt(atlas, index)
        if !slot_.*.used { break }
        if slot_.*.glyph == glyph { return slot_ }
        index = (index + 1) % ATLAS_SLOTS
        probes += 1
    }
    if probes >= ATLAS_SLOTS || atlas.*.full { return null }
    var bitmap: Bitmap = undefined
    if !rasterize(atlas.*.font, glyph, atlas.*.scale, atlas.*.allocator, &bitmap) { return null }
    const width = @intCast(u32, bitmap.width)
    const height = @intCast(u32, bitmap.height)
    // Shelf packing with a 1-pixel gap.
    if atlas.*.cursorX + width + 1 > atlas.*.width {
        atlas.*.cursorX = 1
        atlas.*.cursorY += atlas.*.rowHeight + 1
        atlas.*.rowHeight = 0
    }
    if atlas.*.cursorY + height + 1 > atlas.*.height || width + 2 > atlas.*.width {
        atlas.*.full = true
        if bitmap.width > 0 { atlas.*.allocator.free(bitmap.pixels, bitmap.width * bitmap.height, 8) }
        return null
    }
    const slot_ = slotAt(atlas, index)
    slot_.*.glyph = glyph
    slot_.*.used = true
    slot_.*.x = atlas.*.cursorX
    slot_.*.y = atlas.*.cursorY
    slot_.*.width = width
    slot_.*.height = height
    slot_.*.left = bitmap.left
    slot_.*.top = bitmap.top
    var row: usize = 0
    while row < bitmap.height {
        var column: usize = 0
        const target = (@intCast(usize, slot_.*.y) + row) * @intCast(usize, atlas.*.width) + @intCast(usize, slot_.*.x)
        while column < bitmap.width {
            atlas.*.pixels[target + column] = bitmap.pixels[row * bitmap.width + column]
            column += 1
        }
        row += 1
    }
    if bitmap.width > 0 { atlas.*.allocator.free(bitmap.pixels, bitmap.width * bitmap.height, 8) }
    atlas.*.cursorX += width + 1
    if height > atlas.*.rowHeight { atlas.*.rowHeight = height }
    atlas.*.revision += 1
    return slot_
}

// ---------------------------------------------------------------------------
// Layout

// One glyph of a run: its atlas rectangle, and its top-left corner relative
// to the run's origin (the pen start on the baseline).
pub const Quad = struct {
    atlasX: u32
    atlasY: u32
    width: u32
    height: u32
    x: i32
    y: i32
}

// Laid-out text: quads, the bounding box of their pixels relative to the
// origin (left/top inclusive, right/bottom exclusive) and the advance.
pub const Run = struct {
    quads: [*]Quad
    count: usize
    capacity: usize
    left: i32
    top: i32
    right: i32
    bottom: i32
    advance: i32
    allocator: Allocator
}

pub fn initRun(run: *Run, capacity: usize, allocator: Allocator) -> bool {
    const block = allocator.alloc(capacity * @sizeOf(Quad), 16)
    if block == null { return false }
    unsafe { run.*.quads = @ptrCast([*]Quad, block.?) }
    run.*.capacity = capacity
    run.*.count = 0
    run.*.allocator = allocator
    return true
}

pub fn deinitRun(run: *Run) -> void {
    unsafe { run.*.allocator.free(@ptrCast([*]u8, run.*.quads), run.*.capacity * @sizeOf(Quad), 16) }
}

// Decodes the UTF-8 sequence at text[index]; returns the code point
// (U+FFFD for malformed input) and stores the sequence length.
pub fn decodeUtf8(text: [*]const u8, length: usize, index: usize, consumed: *usize) -> u32 {
    const first = @intCast(u32, text[index])
    consumed.* = 1
    if first < 128 { return first }
    var extra: usize = 0
    var value: u32 = 0
    if first & 224 == 192 {
        extra = 1
        value = first & 31
    } else if first & 240 == 224 {
        extra = 2
        value = first & 15
    } else if first & 248 == 240 {
        extra = 3
        value = first & 7
    } else {
        return 65533
    }
    if index + extra >= length { return 65533 }
    var step: usize = 1
    while step <= extra {
        const next = @intCast(u32, text[index + step])
        if next & 192 != 128 { return 65533 }
        value = (value << 6) | (next & 63)
        step += 1
    }
    consumed.* = extra + 1
    return value
}

fn textLength(text: []const u8) -> usize {
    var length: usize = 0
    length += text.length
    return length
}

// Lays out `text` (UTF-8, one line) into `run`, replacing its contents.
// Glyphs beyond the run's capacity, or that no longer fit in the atlas,
// are skipped (their advance still counts).
pub fn layout(atlas: *Atlas, text: []const u8, run: *Run) -> void {
    const pointer: [*]const u8 = text.pointer
    layoutBytes(atlas, pointer, textLength(text), run)
}

pub fn layoutBytes(atlas: *Atlas, text: [*]const u8, length: usize, run: *Run) -> void {
    const font = atlas.*.font
    run.*.count = 0
    run.*.left = 0
    run.*.top = 0
    run.*.right = 0
    run.*.bottom = 0
    var first = true
    var pen: f64 = 0.0
    var previous: u32 = 0
    var previous_code: u32 = 0
    var index: usize = 0
    while index < length {
        var consumed: usize = 1
        const codepoint = decodeUtf8(text, length, index, &consumed)
        index += consumed
        const ascii = codepoint < @intCast(u32, ASCII)
        const glyph = if ascii { atlas.*.asciiGlyphs[@intCast(usize, codepoint)] } else { glyphIndex(font, codepoint) }
        if previous != 0 {
            const pair = if ascii && previous_code < @intCast(u32, ASCII) { atlas.*.asciiKerning[@intCast(usize, previous_code) * ASCII + @intCast(usize, codepoint)] } else { kerning(font, previous, glyph) }
            if pair != 0 {
                const kern: i64 = @intCast(i64, pair)
                pen += toFloat(kern) * atlas.*.scale
            }
        }
        const placed = atlasGlyph(atlas, glyph)
        if placed != null && run.*.count < run.*.capacity {
            const slot_ = placed.?
            if slot_.*.width > 0 {
                const x = roundToInt(pen) + slot_.*.left
                const y = slot_.*.top
                run.*.quads[run.*.count] = Quad.{ .atlasX = slot_.*.x, .atlasY = slot_.*.y, .width = slot_.*.width, .height = slot_.*.height, .x = x, .y = y }
                run.*.count += 1
                const right = x + @intCast(i32, slot_.*.width)
                const bottom = y + @intCast(i32, slot_.*.height)
                if first || x < run.*.left { run.*.left = x }
                if first || y < run.*.top { run.*.top = y }
                if first || right > run.*.right { run.*.right = right }
                if first || bottom > run.*.bottom { run.*.bottom = bottom }
                first = false
            }
        }
        const advance: i64 = @intCast(i64, if ascii { atlas.*.asciiAdvances[@intCast(usize, codepoint)] } else { advanceWidth(font, glyph) })
        pen += toFloat(advance) * atlas.*.scale
        previous = glyph
        previous_code = codepoint
    }
    run.*.advance = roundToInt(pen)
}

// The coverage (0-255) of the run's pixel (x, y) relative to its origin:
// the largest over the glyphs covering it.
pub fn runCoverage(atlas: *const Atlas, run: *const Run, x: i32, y: i32) -> u32 {
    var coverage: u32 = 0
    var index: usize = 0
    while index < run.*.count {
        const quad = run.*.quads[index]
        const local_x = x - quad.x
        const local_y = y - quad.y
        if local_x >= 0 && local_y >= 0 && local_x < @intCast(i32, quad.width) && local_y < @intCast(i32, quad.height) {
            const at = (@intCast(usize, quad.atlasY) + @intCast(usize, local_y)) * @intCast(usize, atlas.*.width) + @intCast(usize, quad.atlasX) + @intCast(usize, local_x)
            const value = @intCast(u32, atlas.*.pixels[at])
            if value > coverage { coverage = value }
        }
        index += 1
    }
    return coverage
}

// runCoverage for a whole row: `count` pixels from x = `from` of row `y`
// into `into` (the largest over the glyphs covering each), going through
// the glyphs once instead of once a pixel.
pub fn runRowCoverage(atlas: *const Atlas, run: *const Run, y: i32, from: i32, count: usize, into: [*]u8) -> void {
    var at: usize = 0
    while at < count {
        into[at] = 0
        at += 1
    }
    var index: usize = 0
    while index < run.*.count {
        const quad = run.*.quads[index]
        const local_y = y - quad.y
        if local_y >= 0 && local_y < @intCast(i32, quad.height) {
            // The quad's columns within [from, from + count).
            var start = quad.x
            if start < from { start = from }
            var end = quad.x + @intCast(i32, quad.width)
            if end > from + @intCast(i32, count) { end = from + @intCast(i32, count) }
            const line = (@intCast(usize, quad.atlasY) + @intCast(usize, local_y)) * @intCast(usize, atlas.*.width) + @intCast(usize, quad.atlasX)
            var column = start
            while column < end {
                const value = atlas.*.pixels[line + @intCast(usize, column - quad.x)]
                const slot_ = @intCast(usize, column - from)
                if value > into[slot_] { into[slot_] = value }
                column += 1
            }
        }
        index += 1
    }
}

// Blends `color` (0xAARRGGBB, straight alpha) at `coverage` over `under`
// (an opaque 0xAARRGGBB pixel). The Vulkan `text` shader does exactly this.
pub fn blendCoverage(under: u32, color_: u32, coverage: u32) -> u32 {
    const alpha = (coverage * (color_ >> 24) + 127) / 255
    const inverse = 255 - alpha
    var result: u32 = 4278190080
    var shift: u32 = 0
    while shift < 24 {
        const source = (color_ >> shift) & 255
        const target = (under >> shift) & 255
        const mixed = (source * alpha + target * inverse + 127) / 255
        result = result | (mixed << shift)
        shift += 8
    }
    return result
}

// FLAG_SWAP_RED_BLUE: the target stores 0xAABBGGRR (R8G8B8A8).
pub const FLAG_SWAP_RED_BLUE: u32 = 4

fn swapRedBlue(value: u32) -> u32 {
    return (value & 4278255360) | ((value & 255) << 16) | ((value >> 16) & 255)
}

// Draws `run` with its origin at (origin_x, origin_y) into `pixels`
// (`width` x `height`, `stride` pixels per row), clipped.
pub fn drawRun(atlas: *const Atlas, run: *const Run, pixels: [*]u32, width: usize, height: usize, stride: usize, origin_x: i32, origin_y: i32, color_: u32, flags: u32) -> void {
    var y = run.*.top
    while y < run.*.bottom {
        const target_y = origin_y + y
        if target_y >= 0 && target_y < @intCast(i32, height) {
            var x = run.*.left
            while x < run.*.right {
                const target_x = origin_x + x
                if target_x >= 0 && target_x < @intCast(i32, width) {
                    const coverage = runCoverage(atlas, run, x, y)
                    if coverage != 0 {
                        const at = @intCast(usize, target_y) * stride + @intCast(usize, target_x)
                        if flags & FLAG_SWAP_RED_BLUE != 0 {
                            pixels[at] = swapRedBlue(blendCoverage(swapRedBlue(pixels[at]), color_, coverage))
                        } else {
                            pixels[at] = blendCoverage(pixels[at], color_, coverage)
                        }
                    }
                }
                x += 1
            }
        }
        y += 1
    }
}
