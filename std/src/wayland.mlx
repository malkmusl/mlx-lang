// std.wayland: native Wayland client and server for Mlx.
//
// Everything here is ordinary Mlx. The protocol modules under
// wayland/generated were materialized from the canonical wayland.xml,
// xdg-shell.xml and linux-dmabuf-v1.xml (std/protocols/wayland) by std.wayland.materialize during
// the standard-library bootstrap; applications only write
//
//     const wl = @import("std.wayland")
//
// and use wl.client or wl.server with the per-interface namespaces below
// (wl.wl_compositor, wl.xdg_toplevel, ...). Each namespace provides the
// interface version, request/event opcodes and since-versions, enums with
// the exact XML values, the client `Proxy` and server `Resource` types, and
// `decodeEvent`/`decodeRequest`.

pub const wire = @import("./wayland/wire.mlx")
pub const protocol = @import("./wayland/protocol.mlx")
pub const materialize = @import("./wayland/materialize.mlx")
pub const transport = @import("./wayland/transport.mlx")
pub const flags = @import("./wayland/flags.mlx")
pub const client = @import("./wayland/client.mlx")
pub const server = @import("./wayland/server.mlx")
pub const interfaces = @import("./wayland/generated/interfaces.mlx")
pub const wayland = @import("./wayland/generated/wayland.mlx")
pub const xdg_shell = @import("./wayland/generated/xdg_shell.mlx")
pub const linux_dmabuf_v1 = @import("./wayland/generated/linux_dmabuf_v1.mlx")

pub const Interface = interfaces.Interface
pub const Fixed = wire.Fixed
pub const ArrayView = wire.ArrayView
pub const String = wire.String
pub const Handle = transport.Handle
pub const SharedMemory = transport.SharedMemory

// The typed wl_display proxy of a client connection (object id 1).
pub fn displayProxy(display: client.Display) -> wayland.types.wl_display_Proxy {
    return wayland.types.wl_display_Proxy.fromObject(client.displayObject(display))
}

// True when a decoded wire string is null (allow-null arguments).
pub fn isNull(value: String) -> bool { return wire.isNull(value) }

pub const wl_display = wayland.wl_display
pub const wl_registry = wayland.wl_registry
pub const wl_callback = wayland.wl_callback
pub const wl_compositor = wayland.wl_compositor
pub const wl_shm_pool = wayland.wl_shm_pool
pub const wl_shm = wayland.wl_shm
pub const wl_buffer = wayland.wl_buffer
pub const wl_data_offer = wayland.wl_data_offer
pub const wl_data_source = wayland.wl_data_source
pub const wl_data_device = wayland.wl_data_device
pub const wl_data_device_manager = wayland.wl_data_device_manager
pub const wl_shell = wayland.wl_shell
pub const wl_shell_surface = wayland.wl_shell_surface
pub const wl_surface = wayland.wl_surface
pub const wl_seat = wayland.wl_seat
pub const wl_pointer = wayland.wl_pointer
pub const wl_keyboard = wayland.wl_keyboard
pub const wl_touch = wayland.wl_touch
pub const wl_output = wayland.wl_output
pub const wl_region = wayland.wl_region
pub const wl_subcompositor = wayland.wl_subcompositor
pub const wl_subsurface = wayland.wl_subsurface
