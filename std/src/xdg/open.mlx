// std.xdg.open: a file opened with the desktop's application for it, as
// xdg-open opens one on a desktop that has no handler of its own: the
// file's MIME type (inode/directory for a folder, else std.http.mime's
// by its name), the default application of that type by the MIME
// Applications Associations specification (the [Default Applications]
// of mimeapps.list in $XDG_CONFIG_HOME, each of $XDG_CONFIG_DIRS,
// $XDG_DATA_HOME/applications and each of $XDG_DATA_DIRS' applications,
// the first entry there that exists), else the first desktop entry of an
// applications folder whose MimeType lists the type; then that entry's
// Exec line run with the file (%f and %F its path, %u and %U its file://
// URI, the other field codes dropped) by /bin/sh, in a session of its
// own, no child of the caller's.
//
//     open.open(environment, "/home/me/Downloads/report.pdf")
//     open.openWith(environment, "org.mlx.files.desktop", "/home/me/Downloads/report.pdf")
//
// `environment` is the program's NUL-terminated environment list.
const std = @import("std")
const xdg = @import("std.xdg")
const mime = @import("std.http.mime")
const spawn_module = @import("std.spawn")

const Bytes = std.ArrayList(u8)

// The most a desktop entry or mimeapps.list is read of.
const FILE_CAPACITY: usize = 65536

// The MIME type of the file at PATH: inode/directory for a folder, else
// the one its name gives (application/octet-stream for none).
pub fn mimeTypeOf(path: []const u8) -> []const u8 {
    var terminated = Bytes.init(std.heap.allocator())
    defer terminated.deinit()
    if terminated.appendSlice(path) && terminated.append(0) {
        var status: std.fs.Stat = undefined
        if std.fs.status(terminated.items().pointer, &status) == 0 && (status.mode & 0o170000) == 0o040000 { return "inode/directory" }
    }
    var uncertain = false
    return mime.byName(mime.baseName(path), &uncertain)
}

// The file at PATH (NUL-terminated in INTO) read into TEXT; false when it
// cannot be.
fn readFile(path: *Bytes, text: *Bytes) -> bool {
    text.clearRetainingCapacity()
    if !text.resize(FILE_CAPACITY) { return false }
    const length = std.fs.readFile(path.items().pointer, text.items().pointer, FILE_CAPACITY)
    _ = text.resize(length)
    return length > 0
}

// The next line of TEXT from AT (without its newline); false after the
// last.
fn nextLine(text: []const u8, at: *usize, line: *[]const u8) -> bool {
    if at.* >= text.length { return false }
    var end = at.*
    while end < text.length && text[end] != 10 { end += 1 }
    var stop = end
    if stop > at.* && text[stop - 1] == 13 { stop -= 1 }
    line.* = text[at.*..stop]
    at.* = end + 1
    return true
}

// Whether A sorts before B, byte by byte.
fn before(a: []const u8, b: []const u8) -> bool {
    var index: usize = 0
    while index < a.length && index < b.length {
        if a[index] != b[index] { return a[index] < b[index] }
        index += 1
    }
    return a.length < b.length
}

fn startsWith(text: []const u8, start: []const u8) -> bool {
    return text.length >= start.length && std.text.same(text[0..start.length], start)
}

// DIRECTORY with REST after it, NUL-terminated, into INTO.
fn joined(into: *Bytes, directory: []const u8, rest: []const u8, more: []const u8) -> bool {
    into.clearRetainingCapacity()
    return into.appendSlice(directory) && into.appendSlice(rest) && into.appendSlice(more) && into.append(0)
}

// The desktop entry of the desktop file id ID ("org.mlx.files.desktop"):
// its path, NUL-terminated, into INTO (the first applications folder of
// $XDG_DATA_HOME and $XDG_DATA_DIRS that has it); false when none has.
pub fn entryOf(environment: [*][*]const u8, id: []const u8, into: *Bytes) -> bool {
    var home: [4096]u8 = undefined
    const homeBytes: [*]u8 = &home
    const homeLength = xdg.home(environment, xdg.DATA, homeBytes, 4096)
    if homeLength > 0 && joined(into, homeBytes[0..homeLength], "/applications/", id) && std.fs.exists(into.items().pointer) { return true }
    const list = xdg.dataDirectories(environment)
    var at: usize = 0
    var directory: []const u8 = ""
    while xdg.nextDirectory(list, &at, &directory) {
        if joined(into, directory, "/applications/", id) && std.fs.exists(into.items().pointer) { return true }
    }
    return false
}

// In mimeapps.list's TEXT, the first id of [Default Applications]'s line
// for MIME whose entry exists, into ID.
fn defaultIn(environment: [*][*]const u8, text: []const u8, type_: []const u8, id: *Bytes) -> bool {
    var at: usize = 0
    var line: []const u8 = ""
    var inDefaults = false
    var entry = Bytes.init(std.heap.allocator())
    defer entry.deinit()
    while nextLine(text, &at, &line) {
        if line.length > 0 && line[0] == 91 {
            inDefaults = std.text.same(line, "[Default Applications]")
            continue
        }
        if !inDefaults || line.length <= type_.length || !startsWith(line, type_) || line[type_.length] != 61 { continue }
        const ids = line[type_.length + 1..line.length]
        var from: usize = 0
        while from < ids.length {
            var to = from
            while to < ids.length && ids[to] != 59 { to += 1 }
            const candidate = ids[from..to]
            from = to + 1
            if candidate.length == 0 { continue }
            if entryOf(environment, candidate, &entry) {
                id.clearRetainingCapacity()
                return id.appendSlice(candidate)
            }
        }
    }
    return false
}

// The value of KEY in a desktop entry's [Desktop Entry] group.
fn entryValue(text: []const u8, key: []const u8) -> []const u8 {
    var at: usize = 0
    var line: []const u8 = ""
    var inEntry = false
    while nextLine(text, &at, &line) {
        if line.length > 0 && line[0] == 91 {
            inEntry = std.text.same(line, "[Desktop Entry]")
            continue
        }
        if inEntry && line.length > key.length && startsWith(line, key) && line[key.length] == 61 { return line[key.length + 1..line.length] }
    }
    return ""
}

// Whether a MimeType value (types ;-separated) has TYPE.
fn listsType(types: []const u8, type_: []const u8) -> bool {
    var from: usize = 0
    while from < types.length {
        var to = from
        while to < types.length && types[to] != 59 { to += 1 }
        if std.text.same(types[from..to], type_) { return true }
        from = to + 1
    }
    return false
}

// The first desktop entry of DIRECTORY/applications whose MimeType lists
// TYPE (by name, for a choice that does not depend on the folder's
// order), into ID.
fn handlerIn(directory: []const u8, type_: []const u8, id: *Bytes) -> bool {
    var path = Bytes.init(std.heap.allocator())
    defer path.deinit()
    var text = Bytes.init(std.heap.allocator())
    defer text.deinit()
    if !joined(&path, directory, "/applications", "") { return false }
    const folder = std.fs.open(path.items().pointer, std.fs.READ_ONLY | std.fs.DIRECTORY, 0)
    if !std.fs.isValid(folder) { return false }
    var buffer: [8192]u8 = undefined
    const bytes: [*]u8 = &buffer
    var reader = std.fs.entries(folder, bytes, 8192)
    var found: std.fs.Entry = undefined
    var best = Bytes.init(std.heap.allocator())
    defer best.deinit()
    var any = false
    while std.fs.nextEntry(&reader, &found) {
        const name = found.name.pointer[0..found.name.length]
        if name.length < 9 || !std.text.same(name[name.length - 8..name.length], ".desktop") { continue }
        if !joined(&path, directory, "/applications/", name) || !readFile(&path, &text) { continue }
        if !listsType(entryValue(text.items(), "MimeType"), type_) || std.text.same(entryValue(text.items(), "NoDisplay"), "true") { continue }
        if any && !before(name, best.items()) { continue }
        best.clearRetainingCapacity()
        any = best.appendSlice(name)
    }
    _ = std.fs.close(folder)
    if !any { return false }
    id.clearRetainingCapacity()
    return id.appendSlice(best.items())
}

// The desktop file id of TYPE's application, into ID: mimeapps.list's
// default, else the first entry that says it takes the type.
pub fn defaultApplication(environment: [*][*]const u8, type_: []const u8, id: *Bytes) -> bool {
    var path = Bytes.init(std.heap.allocator())
    defer path.deinit()
    var text = Bytes.init(std.heap.allocator())
    defer text.deinit()
    var directory: [4096]u8 = undefined
    const directoryBytes: [*]u8 = &directory
    // The user's configuration, the system's, the user's data, the
    // system's data.
    var length = xdg.home(environment, xdg.CONFIG, directoryBytes, 4096)
    if length > 0 && joined(&path, directoryBytes[0..length], "/mimeapps.list", "") && readFile(&path, &text) && defaultIn(environment, text.items(), type_, id) { return true }
    var at: usize = 0
    var each: []const u8 = ""
    const configs = xdg.configDirectories(environment)
    while xdg.nextDirectory(configs, &at, &each) {
        if joined(&path, each, "/mimeapps.list", "") && readFile(&path, &text) && defaultIn(environment, text.items(), type_, id) { return true }
    }
    length = xdg.home(environment, xdg.DATA, directoryBytes, 4096)
    if length > 0 && joined(&path, directoryBytes[0..length], "/applications/mimeapps.list", "") && readFile(&path, &text) && defaultIn(environment, text.items(), type_, id) { return true }
    const datas = xdg.dataDirectories(environment)
    at = 0
    while xdg.nextDirectory(datas, &at, &each) {
        if joined(&path, each, "/applications/mimeapps.list", "") && readFile(&path, &text) && defaultIn(environment, text.items(), type_, id) { return true }
    }
    if length > 0 && handlerIn(directoryBytes[0..length], type_, id) { return true }
    at = 0
    while xdg.nextDirectory(datas, &at, &each) {
        if handlerIn(each, type_, id) { return true }
    }
    return false
}

// TEXT single-quoted for /bin/sh (a ' in it as '\'').
fn quoted(into: *Bytes, text: []const u8) -> bool {
    var ok = into.append(39)
    for byte in text {
        if byte == 39 { ok = ok && into.appendSlice("'\\''") } else { ok = ok && into.append(byte) }
    }
    return ok && into.append(39)
}

// PATH as a file:// URI (what is not unreserved percent-encoded, the
// slashes kept).
fn uriOf(into: *Bytes, path: []const u8) -> bool {
    const hex = "0123456789ABCDEF"
    var ok = into.appendSlice("file://")
    for byte in path {
        const plain = (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 45 || byte == 46 || byte == 95 || byte == 126 || byte == 47
        if plain { ok = ok && into.append(byte) } else { ok = ok && into.append(37) && into.append(hex[byte >> 4]) && into.append(hex[byte & 15]) }
    }
    return ok
}

// The shell command that opens PATH with the desktop entry ID (its Exec
// line, the field codes put in), into INTO, NUL-terminated.
pub fn command(environment: [*][*]const u8, id: []const u8, path: []const u8, into: *Bytes) -> bool {
    var entry = Bytes.init(std.heap.allocator())
    defer entry.deinit()
    var text = Bytes.init(std.heap.allocator())
    defer text.deinit()
    if !entryOf(environment, id, &entry) || !readFile(&entry, &text) { return false }
    const exec = entryValue(text.items(), "Exec")
    if exec.length == 0 { return false }
    into.clearRetainingCapacity()
    var ok = into.appendSlice("exec ")
    var given = false
    var index: usize = 0
    while index < exec.length {
        const byte = exec[index]
        if byte == 37 && index + 1 < exec.length {
            const code = exec[index + 1]
            index += 2
            if code == 37 {
                ok = ok && into.append(37)
            } else if code == 102 || code == 70 {
                ok = ok && quoted(into, path)
                given = true
            } else if code == 117 || code == 85 {
                var uri = Bytes.init(std.heap.allocator())
                defer uri.deinit()
                ok = ok && uriOf(&uri, path) && quoted(into, uri.items())
                given = true
            }
            continue
        }
        ok = ok && into.append(byte)
        index += 1
    }
    // (An Exec line without a field code takes the file at its end, as
    // xdg-open does.)
    if !given { ok = ok && into.append(32) && quoted(into, path) }
    return ok && into.append(0)
}

// Runs the shell command COMMAND (NUL-terminated) detached, in a session
// of its own.
fn run(environment: [*][*]const u8, line: [*]const u8) -> bool {
    var arguments: [4][*]const u8 = undefined
    arguments[0] = "/bin/sh".pointer
    arguments[1] = "-c".pointer
    arguments[2] = line
    arguments[3] = unsafe { @ptrFromInt([*]const u8, 0) }
    var options = spawn_module.options(arguments[0], &arguments, environment)
    options.newSession = true
    options.detach = true
    return spawn_module.start(&options) >= 0
}

// Opens PATH with the desktop entry ID; false when it has none or it
// could not be started.
pub fn openWith(environment: [*][*]const u8, id: []const u8, path: []const u8) -> bool {
    var line = Bytes.init(std.heap.allocator())
    defer line.deinit()
    if !command(environment, id, path, &line) { return false }
    return run(environment, line.items().pointer)
}

// Opens PATH with the application for its type; false when there is none
// or it could not be started.
pub fn open(environment: [*][*]const u8, path: []const u8) -> bool {
    var id = Bytes.init(std.heap.allocator())
    defer id.deinit()
    if !defaultApplication(environment, mimeTypeOf(path), &id) { return false }
    return openWith(environment, id.items(), path)
}
