// std.net: TCP over IPv4 and IPv6 for Mlx programs, on std.linux's socket
// calls: addresses read and written, connections made (with a timeout)
// and accepted, bytes sent and received, and names turned into
// addresses by std.net.dns (/etc/hosts, then the name servers of
// /etc/resolv.conf). Every descriptor is close-on-exec.
//
//     var address: net.Address = undefined
//     if net.parseAddress("127.0.0.1", 8080, &address) { ... }
//     const fd = net.connect(&address, 5000)          // or -errno
//     if fd >= 0 { ... net.send(fd, bytes) ... net.receive(fd, into, room) ... net.close(fd) }
//
//     var found: [8]net.Address = undefined
//     const count = net.resolve("example.com", 443, &found, 8, 5000)
const std = @import("std")
const socket = std.linux.socket
const event = std.linux.event
const dns = @import("./net/dns.mlx")

pub const Family = enum(u8) {
    ipv4,
    ipv6
}

pub const Address = struct {
    family: Family
    // 4 bytes for IPv4, 16 for IPv6.
    bytes: [16]u8
    port: u16
    // An IPv6 link-local address's interface.
    scope: u32
}

pub const EINTR: isize = -4
pub const EAGAIN: isize = -11
pub const EINPROGRESS: isize = -115
pub const ETIMEDOUT: isize = -110
pub const ECONNREFUSED: isize = -111
pub const EINVAL: isize = -22

fn isDigit(c: u8) -> bool { return c >= 48 && c <= 57 }
fn isHex(c: u8) -> bool { return isDigit(c) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70) }

fn hexValue(c: u8) -> u32 {
    if isDigit(c) { return @intCast(u32, c - 48) }
    if c >= 97 && c <= 102 { return @intCast(u32, c - 87) }
    return @intCast(u32, c - 55)
}

// An IPv4 literal ("192.0.2.1") as its bytes.
pub fn parseIpv4(text: []const u8, out: *[4]u8) -> bool {
    var at: usize = 0
    var octet: usize = 0
    while octet < 4 {
        var digits: usize = 0
        var value: u32 = 0
        while at < text.length && isDigit(text[at]) {
            value = value * 10 + @intCast(u32, text[at] - 48)
            if value > 255 { return false }
            digits += 1
            at += 1
        }
        if digits == 0 { return false }
        out.*[octet] = @intCast(u8, value)
        octet += 1
        if octet < 4 {
            if at >= text.length || text[at] != 46 { return false }
            at += 1
        }
    }
    return at == text.length
}

// An IPv6 literal ("2001:db8::1", "::ffff:192.0.2.1", with or without
// brackets, a "%scope" taken as a number) as its 16 bytes.
pub fn parseIpv6(textIn: []const u8, out: *[16]u8, scope: *u32) -> bool {
    var text = textIn
    scope.* = 0
    if text.length >= 2 && text[0] == 91 && text[text.length - 1] == 93 { text = text[1..text.length - 1] }
    var percent = text.length
    var i: usize = 0
    while i < text.length {
        if text[i] == 37 {
            percent = i
            break
        }
        i += 1
    }
    if percent < text.length {
        var value: u32 = 0
        for c in text[percent + 1..text.length] {
            if !isDigit(c) { return false }
            value = value * 10 + @intCast(u32, c - 48)
        }
        scope.* = value
        text = text[0..percent]
    }
    var groups: [8]u16 = [8]u16{ 0, 0, 0, 0, 0, 0, 0, 0 }
    var count: usize = 0
    var gap: usize = 8
    var at: usize = 0
    if text.length >= 2 && text[0] == 58 && text[1] == 58 {
        gap = 0
        at = 2
    } else if text.length > 0 && text[0] == 58 {
        return false
    }
    while at < text.length {
        // An IPv4 tail takes the last two groups.
        var dot = at
        while dot < text.length && text[dot] != 58 && text[dot] != 46 { dot += 1 }
        if dot < text.length && text[dot] == 46 {
            var v4: [4]u8 = undefined
            if count > 6 || !parseIpv4(text[at..text.length], &v4) { return false }
            groups[count] = (@intCast(u16, v4[0]) << 8) | @intCast(u16, v4[1])
            groups[count + 1] = (@intCast(u16, v4[2]) << 8) | @intCast(u16, v4[3])
            count += 2
            at = text.length
            break
        }
        var digits: usize = 0
        var value: u32 = 0
        while at < text.length && isHex(text[at]) {
            value = (value << 4) | hexValue(text[at])
            digits += 1
            at += 1
        }
        if digits == 0 || digits > 4 || count >= 8 { return false }
        groups[count] = @intCast(u16, value)
        count += 1
        if at == text.length { break }
        if text[at] != 58 { return false }
        at += 1
        if at < text.length && text[at] == 58 {
            if gap != 8 { return false }
            gap = count
            at += 1
        } else if at == text.length {
            return false
        }
    }
    if gap == 8 {
        if count != 8 { return false }
    } else {
        if count >= 8 { return false }
        // The groups after the gap move to the end.
        var tail = count
        var into: usize = 8
        while tail > gap {
            tail -= 1
            into -= 1
            groups[into] = groups[tail]
        }
        var fill = gap
        while fill < into {
            groups[fill] = 0
            fill += 1
        }
    }
    i = 0
    while i < 8 {
        out.*[i * 2] = @intCast(u8, groups[i] >> 8)
        out.*[i * 2 + 1] = @intCast(u8, groups[i] & 255)
        i += 1
    }
    return true
}

// An address literal of either family with `port`.
pub fn parseAddress(text: []const u8, port: u16, out: *Address) -> bool {
    out.*.port = port
    out.*.scope = 0
    var v4: [4]u8 = undefined
    if parseIpv4(text, &v4) {
        out.*.family = Family.ipv4
        var i: usize = 0
        while i < 16 {
            out.*.bytes[i] = if i < 4 { v4[i] } else { 0 }
            i += 1
        }
        return true
    }
    if parseIpv6(text, &out.*.bytes, &out.*.scope) {
        out.*.family = Family.ipv6
        return true
    }
    return false
}

pub fn ipv4(a: u8, b: u8, c: u8, d: u8, port: u16) -> Address {
    var address: Address = undefined
    address.family = Family.ipv4
    var i: usize = 0
    while i < 16 {
        address.bytes[i] = 0
        i += 1
    }
    address.bytes[0] = a
    address.bytes[1] = b
    address.bytes[2] = c
    address.bytes[3] = d
    address.port = port
    address.scope = 0
    return address
}

// The address as text ("192.0.2.1", "2001:db8::1" with the longest run
// of zero groups elided, as inet_ntop writes it), into `out` (46 bytes
// are enough); the length.
pub fn writeAddress(address: *const Address, out: []u8) -> usize {
    var n: usize = 0
    if address.*.family == Family.ipv4 {
        var i: usize = 0
        while i < 4 {
            if i > 0 {
                out[n] = 46
                n += 1
            }
            n = putDecimal(out, n, @intCast(u64, address.*.bytes[i]))
            i += 1
        }
        return n
    }
    var groups: [8]u16 = undefined
    var i: usize = 0
    while i < 8 {
        groups[i] = (@intCast(u16, address.*.bytes[i * 2]) << 8) | @intCast(u16, address.*.bytes[i * 2 + 1])
        i += 1
    }
    // The longest run of zeros (two or more) is written "::".
    var bestStart: usize = 8
    var bestLength: usize = 0
    i = 0
    while i < 8 {
        if groups[i] == 0 {
            var end = i
            while end < 8 && groups[end] == 0 { end += 1 }
            if end - i > bestLength {
                bestStart = i
                bestLength = end - i
            }
            i = end
        } else {
            i += 1
        }
    }
    if bestLength < 2 { bestStart = 8 }
    var needColon = false
    i = 0
    while i < 8 {
        if i == bestStart {
            out[n] = 58
            out[n + 1] = 58
            n += 2
            needColon = false
            i += bestLength
            continue
        }
        if needColon {
            out[n] = 58
            n += 1
        }
        n = putHex(out, n, groups[i])
        needColon = true
        i += 1
    }
    return n
}

fn putDecimal(out: []u8, at: usize, value: u64) -> usize {
    var digits: [20]u8 = undefined
    var count: usize = 0
    var v = value
    while true {
        digits[count] = @intCast(u8, 48 + v % 10)
        count += 1
        v = v / 10
        if v == 0 { break }
    }
    var n = at
    while count > 0 {
        count -= 1
        out[n] = digits[count]
        n += 1
    }
    return n
}

fn putHex(out: []u8, at: usize, value: u16) -> usize {
    const digits = "0123456789abcdef"
    var started = false
    var shift: u32 = 12
    var n = at
    while true {
        const d = (@intCast(u32, value) >> shift) & 15
        if d != 0 || started || shift == 0 {
            out[n] = digits[@intCast(usize, d)]
            n += 1
            started = true
        }
        if shift == 0 { break }
        shift -= 4
    }
    return n
}

// ---------------------------------------------------------------------------
// Socket addresses (sockaddr_in, sockaddr_in6)

// The sockaddr of an address into `raw` (28 bytes or more); its length.
pub fn sockaddr(address: *const Address, raw: [*]u8) -> usize {
    var i: usize = 0
    while i < 28 {
        raw[i] = 0
        i += 1
    }
    raw[2] = @intCast(u8, address.*.port >> 8)
    raw[3] = @intCast(u8, address.*.port & 255)
    if address.*.family == Family.ipv4 {
        raw[0] = 2
        i = 0
        while i < 4 {
            raw[4 + i] = address.*.bytes[i]
            i += 1
        }
        return 16
    }
    raw[0] = 10
    i = 0
    while i < 16 {
        raw[8 + i] = address.*.bytes[i]
        i += 1
    }
    raw[24] = @intCast(u8, address.*.scope & 255)
    raw[25] = @intCast(u8, (address.*.scope >> 8) & 255)
    raw[26] = @intCast(u8, (address.*.scope >> 16) & 255)
    raw[27] = @intCast(u8, (address.*.scope >> 24) & 255)
    return 28
}

// The address of a sockaddr (false for another family).
pub fn fromSockaddr(raw: [*]const u8, length: usize, out: *Address) -> bool {
    if length < 16 { return false }
    const family = @intCast(u32, raw[0]) | (@intCast(u32, raw[1]) << 8)
    out.*.port = (@intCast(u16, raw[2]) << 8) | @intCast(u16, raw[3])
    out.*.scope = 0
    var i: usize = 0
    while i < 16 {
        out.*.bytes[i] = 0
        i += 1
    }
    if family == 2 {
        out.*.family = Family.ipv4
        i = 0
        while i < 4 {
            out.*.bytes[i] = raw[4 + i]
            i += 1
        }
        return true
    }
    if family == 10 && length >= 28 {
        out.*.family = Family.ipv6
        i = 0
        while i < 16 {
            out.*.bytes[i] = raw[8 + i]
            i += 1
        }
        out.*.scope = @intCast(u32, raw[24]) | (@intCast(u32, raw[25]) << 8) | (@intCast(u32, raw[26]) << 16) | (@intCast(u32, raw[27]) << 24)
        return true
    }
    return false
}

fn familyOf(address: *const Address) -> usize { return if address.*.family == Family.ipv4 { socket.AF_INET } else { socket.AF_INET6 } }

// ---------------------------------------------------------------------------
// Connections

const SO_ERROR: usize = 4
const IPPROTO_TCP: usize = 6
const TCP_NODELAY: usize = 1

// A stream socket connected to `address`, waiting at most `timeoutMs`
// (negative: as long as it takes): its descriptor (blocking, close on
// exec), or -errno (ETIMEDOUT when the time ran out).
pub fn connect(address: *const Address, timeoutMs: isize) -> isize {
    const fd = socket.open(familyOf(address), socket.SOCK_STREAM | socket.SOCK_CLOEXEC | socket.SOCK_NONBLOCK, 0)
    if fd < 0 { return fd }
    var raw: [28]u8 = undefined
    const bytes: [*]u8 = &raw
    const length = sockaddr(address, bytes)
    var result = socket.connect(fd, @intFromPtr(bytes), length)
    while result == EINTR { result = socket.connect(fd, @intFromPtr(bytes), length) }
    if result < 0 && result != EINPROGRESS {
        _ = socket.close(fd)
        return result
    }
    if result == EINPROGRESS {
        const ready = event.waitReady(fd, true, timeoutMs)
        if ready == 0 {
            _ = socket.close(fd)
            return ETIMEDOUT
        }
        if ready < 0 {
            _ = socket.close(fd)
            return ready
        }
        var pending: u32 = 0
        var size: u32 = 4
        _ = socket.getOption(fd, socket.SOL_SOCKET, SO_ERROR, @intFromPtr(&pending), @intFromPtr(&size))
        if pending != 0 {
            _ = socket.close(fd)
            return 0 - @intCast(isize, pending)
        }
    }
    // Blocking from here on.
    const flags = socket.getFlags(fd)
    if flags >= 0 { _ = socket.setFlags(fd, @bitCast(usize, flags) & ~socket.O_NONBLOCK) }
    var one: u32 = 1
    _ = socket.setOption(fd, IPPROTO_TCP, TCP_NODELAY, @intFromPtr(&one), 4)
    return fd
}

// A socket listening on `address` (port 0: one the system picks; see
// localAddress): its descriptor, or -errno.
pub fn listen(address: *const Address, backlog: usize) -> isize {
    const fd = socket.open(familyOf(address), socket.SOCK_STREAM | socket.SOCK_CLOEXEC, 0)
    if fd < 0 { return fd }
    var one: u32 = 1
    _ = socket.setOption(fd, socket.SOL_SOCKET, socket.SO_REUSEADDR, @intFromPtr(&one), 4)
    var raw: [28]u8 = undefined
    const bytes: [*]u8 = &raw
    const length = sockaddr(address, bytes)
    var result = socket.bind(fd, @intFromPtr(bytes), length)
    if result < 0 {
        _ = socket.close(fd)
        return result
    }
    result = socket.listen(fd, backlog)
    if result < 0 {
        _ = socket.close(fd)
        return result
    }
    return fd
}

// The next connection of a listening socket: its descriptor (blocking,
// close on exec), or -errno; the peer's address in `peer`.
pub fn accept(listener: isize, peer: *Address) -> isize {
    var raw: [28]u8 = undefined
    const bytes: [*]u8 = &raw
    var length: u32 = 28
    var fd = socket.accept4(listener, @intFromPtr(bytes), @intFromPtr(&length), socket.SOCK_CLOEXEC)
    while fd == EINTR { fd = socket.accept4(listener, @intFromPtr(bytes), @intFromPtr(&length), socket.SOCK_CLOEXEC) }
    if fd >= 0 { _ = fromSockaddr(bytes, @intCast(usize, length), peer) }
    return fd
}

// The address a socket is bound to (its port once the system picked one).
pub fn localAddress(fd: isize, out: *Address) -> bool {
    var raw: [28]u8 = undefined
    const bytes: [*]u8 = &raw
    var length: u32 = 28
    if socket.getSocketName(fd, @intFromPtr(bytes), @intFromPtr(&length)) < 0 { return false }
    return fromSockaddr(bytes, @intCast(usize, length), out)
}

// Sends all of `data`; false when the connection failed.
pub fn send(fd: isize, data: []const u8) -> bool {
    var sent: usize = 0
    while sent < data.length {
        const from: [*]const u8 = unsafe { data.pointer + sent }
        const now = socket.send(fd, from, data.length - sent, socket.MSG_NOSIGNAL)
        if now == EINTR { continue }
        if now <= 0 { return false }
        sent += @intCast(usize, now)
    }
    return true
}

// Some bytes, at least one unless the peer closed (0) or the connection
// failed (-errno).
pub fn receive(fd: isize, into: [*]u8, room: usize) -> isize {
    var got = socket.receive(fd, into, room, 0)
    while got == EINTR { got = socket.receive(fd, into, room, 0) }
    return got
}

// Whether bytes can be received within `timeoutMs` (negative: wait).
pub fn readable(fd: isize, timeoutMs: isize) -> bool { return event.waitReady(fd, false, timeoutMs) > 0 }

pub fn close(fd: isize) -> void { _ = socket.close(fd) }

pub fn shutdownWrite(fd: isize) -> void { _ = socket.shutdown(fd, socket.SHUT_WR) }

// ---------------------------------------------------------------------------
// Names

// The addresses of `name` with `port`, up to `max` of them into `found`
// (an address literal and "localhost" answered at once; /etc/hosts
// next; then the name servers of /etc/resolv.conf asked for A and AAAA
// records, each within `timeoutMs`): how many were found, IPv4 first.
pub fn resolve(name: []const u8, port: u16, found: [*]Address, max: usize, timeoutMs: isize) -> usize {
    return dns.resolve(name, port, found, max, timeoutMs)
}
