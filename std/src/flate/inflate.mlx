// std.flate.inflate: decompression of raw deflate data, zlib streams and gzip
// members (or either, detected from the header), as a state machine that
// takes any amount of input and output at each call and goes on where
// the last call stopped.
//
// The decoding tables are zlib's (a root table indexed by the next bits
// with sub-tables for longer codes, each entry an operation, a bit count
// and a value), the sliding window is made only when it is needed, and
// a loop for the common case decodes while at least 6 bytes of input
// and 258 of output are at hand. The checks, the messages of damaged data
// and the return codes are zlib's.
const c = @import("./stream.mlx")
const checksum = @import("../crc.mlx")

pub const HEAD: usize = 16180
const FLAGS: usize = 16181
const TIME: usize = 16182
const OS: usize = 16183
const EXLEN: usize = 16184
const EXTRA: usize = 16185
const NAME: usize = 16186
const COMMENT: usize = 16187
const HCRC: usize = 16188
const DICTID: usize = 16189
const DICT: usize = 16190
pub const TYPE: usize = 16191
const TYPEDO: usize = 16192
const STORED: usize = 16193
const COPY_: usize = 16194
const COPY: usize = 16195
const TABLE: usize = 16196
const LENLENS: usize = 16197
const CODELENS: usize = 16198
const LEN_: usize = 16199
const LEN: usize = 16200
const LENEXT: usize = 16201
const DIST: usize = 16202
const DISTEXT: usize = 16203
const MATCH: usize = 16204
const LIT: usize = 16205
const CHECK: usize = 16206
const LENGTH: usize = 16207
pub const DONE: usize = 16208
pub const BAD: usize = 16209
const MEM: usize = 16210
const SYNC: usize = 16211

// A decoding table entry, a 32-bit word as zlib lays out its entries:
// op in the low byte (0 for a literal, 16 + extra bits for a length or
// distance base, 32 + 64 for the end of the block, 64 for an invalid
// code, the index bits of a sub-table for a link to one), bits next (the
// code's length, or the part of it this table takes), val in the high
// half (the literal, the base, or the sub-table's offset). Entries are
// handled as words, never as structures: a structure value read in the
// decoding loop would take room of the call's arena each time.
inline fn codeOf(op: usize, bits: usize, val: usize) -> u32 { return @intCast(u32, (op & 255) | ((bits & 255) << 8) | ((val & 0xffff) << 16)) }
inline fn opOf(code: usize) -> usize { return code & 255 }
inline fn bitsOf(code: usize) -> usize { return (code >> 8) & 255 }
inline fn valOf(code: usize) -> usize { return (code >> 16) & 0xffff }

const ENOUGH_LENS: usize = 852
const ENOUGH_DISTS: usize = 592
const ENOUGH: usize = 1444

const CODES: usize = 0
const LENS: usize = 1
const DISTS: usize = 2

pub const InflateState = struct {
    // The identity the stream must have (its owner, given at setup).
    owner: usize
    mode: usize
    last: usize
    wrap: usize
    havedict: usize
    flags: i64
    dmax: usize
    check: u64
    total: u64
    head: usize
    wbits: usize
    wsize: usize
    whave: usize
    wnext: usize
    window: usize
    windowBytes: usize
    hold: u64
    bits: usize
    length: usize
    offset: usize
    extra: usize
    lencode: [*]u32
    distcode: [*]u32
    lenbits: usize
    distbits: usize
    ncode: usize
    nlen: usize
    ndist: usize
    have: usize
    next: usize
    lens: [320]u16
    work: [288]u16
    codes: [1444]u32
    sane: usize
    back: i64
    was: usize
    // A word for the caller of these functions (the C API's inflateBack
    // keeps the caller's window there).
    client: usize
}

var LBASE: [31]u16 = [31]u16{ 3, 4, 5, 6, 7, 8, 9, 10, 11, 13, 15, 17, 19, 23, 27, 31, 35, 43, 51, 59, 67, 83, 99, 115, 131, 163, 195, 227, 258, 0, 0 }
var LEXT: [31]u16 = [31]u16{ 16, 16, 16, 16, 16, 16, 16, 16, 17, 17, 17, 17, 18, 18, 18, 18, 19, 19, 19, 19, 20, 20, 20, 20, 21, 21, 21, 21, 16, 203, 77 }
var DBASE: [32]u16 = [32]u16{ 1, 2, 3, 4, 5, 7, 9, 13, 17, 25, 33, 49, 65, 97, 129, 193, 257, 385, 513, 769, 1025, 1537, 2049, 3073, 4097, 6145, 8193, 12289, 16385, 24577, 0, 0 }
var DEXT: [32]u16 = [32]u16{ 16, 16, 16, 16, 17, 17, 18, 18, 19, 19, 20, 20, 21, 21, 22, 22, 23, 23, 24, 24, 25, 25, 26, 26, 27, 27, 28, 28, 29, 29, 64, 64 }
// The order the code length code lengths come in.
var ORDER: [19]usize = [19]usize{ 16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15 }

pub fn stateOf(strm: *c.Stream) -> *InflateState { return unsafe { @ptrFromInt(*InflateState, strm.*.state) } }

inline fn codes(address: usize) -> [*]u32 { return unsafe { @ptrFromInt([*]u32, address) } }

// ---------------------------------------------------------------------------
// Decoding tables

// Builds the table of the canonical code of the LENS[0..COUNT] code
// lengths at *TABLE (which moves past it), its root indexed by *BITS
// bits (or fewer when no code is that long, or more when none is that
// short); 0, -1 for lengths that are not a code, 1 when ENOUGH is short.
fn inflateTable(kind: usize, lens: [*]u16, count: usize, table: *usize, bits: *usize, work: [*]u16) -> i32 {
    var counts: [16]usize = undefined
    var offs: [16]usize = undefined
    var len: usize = 0
    while len <= 15 {
        counts[len] = 0
        len += 1
    }
    var sym: usize = 0
    while sym < count {
        counts[@intCast(usize, lens[sym])] += 1
        sym += 1
    }
    var root = bits.*
    var max: usize = 15
    while max >= 1 {
        if counts[max] != 0 { break }
        max -= 1
    }
    if root > max { root = max }
    const start = table.*
    if max == 0 {
        // No codes: a table that makes any code an error.
        const t = codes(start)
        t[0] = codeOf(64, 1, 0)
        t[1] = codeOf(64, 1, 0)
        table.* = start + 8
        bits.* = 1
        return 0
    }
    var min: usize = 1
    while min < max {
        if counts[min] != 0 { break }
        min += 1
    }
    if root < min { root = min }
    // Over-subscribed or incomplete.
    var left: i64 = 1
    len = 1
    while len <= 15 {
        left <<= 1
        left -= @intCast(i64, counts[len])
        if left < 0 { return -1 }
        len += 1
    }
    if left > 0 && (kind == CODES || max != 1) { return -1 }
    offs[1] = 0
    len = 1
    while len < 15 {
        offs[len + 1] = offs[len] + counts[len]
        len += 1
    }
    sym = 0
    while sym < count {
        if lens[sym] != 0 {
            const l = @intCast(usize, lens[sym])
            work[offs[l]] = @intCast(u16, sym)
            offs[l] += 1
        }
        sym += 1
    }
    var matchFrom: usize = 20
    if kind == LENS {
        matchFrom = 257
    } else if kind == DISTS {
        matchFrom = 0
    }
    var huff: usize = 0
    sym = 0
    len = min
    var next = codes(start)
    var nextAddress = start
    var curr = root
    var drop: usize = 0
    var low: usize = 0xffffffff
    var used = @intCast(usize, 1) << @intCast(u6, root)
    const mask = used - 1
    if (kind == LENS && used > ENOUGH_LENS) || (kind == DISTS && used > ENOUGH_DISTS) { return 1 }
    while true {
        var hereOp: usize = 0
        var hereVal: usize = 0
        const w = @intCast(usize, work[sym])
        if w + 1 < matchFrom {
            hereOp = 0
            hereVal = w
        } else if w >= matchFrom {
            if kind == LENS {
                hereOp = @intCast(usize, LEXT[w - matchFrom])
                hereVal = @intCast(usize, LBASE[w - matchFrom])
            } else {
                hereOp = @intCast(usize, DEXT[w - matchFrom])
                hereVal = @intCast(usize, DBASE[w - matchFrom])
            }
        } else {
            hereOp = 32 + 64
            hereVal = 0
        }
        const here = codeOf(hereOp, len - drop, hereVal)
        var incr = @intCast(usize, 1) << @intCast(u6, len - drop)
        var fill = @intCast(usize, 1) << @intCast(u6, curr)
        min = fill
        while true {
            fill -= incr
            next[(huff >> @intCast(u6, drop)) + fill] = here
            if fill == 0 { break }
        }
        incr = @intCast(usize, 1) << @intCast(u6, len - 1)
        while (huff & incr) != 0 { incr >>= 1 }
        if incr != 0 {
            huff &= incr - 1
            huff += incr
        } else {
            huff = 0
        }
        sym += 1
        counts[len] -= 1
        if counts[len] == 0 {
            if len == max { break }
            len = @intCast(usize, lens[@intCast(usize, work[sym])])
        }
        if len > root && (huff & mask) != low {
            if drop == 0 { drop = root }
            nextAddress += min * 4
            next = codes(nextAddress)
            curr = len - drop
            var room: i64 = @intCast(i64, 1) << @intCast(u6, curr)
            while curr + drop < max {
                room -= @intCast(i64, counts[curr + drop])
                if room <= 0 { break }
                curr += 1
                room <<= 1
            }
            used += @intCast(usize, 1) << @intCast(u6, curr)
            if (kind == LENS && used > ENOUGH_LENS) || (kind == DISTS && used > ENOUGH_DISTS) { return 1 }
            low = huff & mask
            const rootTable = codes(start)
            rootTable[low] = codeOf(curr, root, (nextAddress - start) / 4)
        }
    }
    if huff != 0 {
        next[huff] = codeOf(64, len - drop, 0)
    }
    table.* = start + used * 4
    bits.* = root
    return 0
}

// The tables of the fixed codes, made once.
var lenfix: [512]u32 = undefined
var distfix: [32]u32 = undefined
var fixedReady: u32 = 0

fn fixedTables(state: *InflateState) -> void {
    if @atomicLoad(u32, &fixedReady, acquire) == 0 {
        var lens: [288]u16 = undefined
        var work: [288]u16 = undefined
        var sym: usize = 0
        while sym < 288 {
            lens[sym] = if sym < 144 { 8 } else if sym < 256 { 9 } else if sym < 280 { 7 } else { 8 }
            sym += 1
        }
        var next = @intFromPtr(&lenfix)
        var bits: usize = 9
        _ = inflateTable(LENS, &lens, 288, &next, &bits, &work)
        sym = 0
        while sym < 32 {
            lens[sym] = 5
            sym += 1
        }
        next = @intFromPtr(&distfix)
        bits = 5
        _ = inflateTable(DISTS, &lens, 32, &next, &bits, &work)
        @atomicStore(u32, &fixedReady, 1, release)
    }
    state.*.lencode = &lenfix
    state.*.lenbits = 9
    state.*.distcode = &distfix
    state.*.distbits = 5
}

// ---------------------------------------------------------------------------
// Setting up

// Whether the stream is not one inflate set up (or has another owner).
fn stateCheck(strm: *c.Stream) -> bool {
    if strm.*.state == 0 { return true }
    const state = stateOf(strm)
    return state.*.owner != strm.*.owner || state.*.mode < HEAD || state.*.mode > SYNC
}

pub fn resetKeep(strm: *c.Stream) -> i32 {
    if stateCheck(strm) { return c.STREAM_ERROR }
    const state = stateOf(strm)
    strm.*.total_in = 0
    strm.*.total_out = 0
    state.*.total = 0
    strm.*.msg = 0
    if state.*.wrap != 0 { strm.*.adler = @intCast(u64, state.*.wrap & 1) }
    state.*.mode = HEAD
    state.*.last = 0
    state.*.havedict = 0
    state.*.flags = -1
    state.*.dmax = 32768
    state.*.head = 0
    state.*.hold = 0
    state.*.bits = 0
    state.*.lencode = &state.*.codes
    state.*.distcode = &state.*.codes
    state.*.next = @intFromPtr(&state.*.codes)
    state.*.sane = 1
    state.*.back = -1
    return c.OK
}

pub fn reset(strm: *c.Stream) -> i32 {
    if stateCheck(strm) { return c.STREAM_ERROR }
    const state = stateOf(strm)
    state.*.wsize = 0
    state.*.whave = 0
    state.*.wnext = 0
    return resetKeep(strm)
}

pub fn reset2(strm: *c.Stream, windowBits0: i32) -> i32 {
    if stateCheck(strm) { return c.STREAM_ERROR }
    const state = stateOf(strm)
    var windowBits = windowBits0
    var wrap: usize = 0
    if windowBits < 0 {
        if windowBits < -15 { return c.STREAM_ERROR }
        wrap = 0
        windowBits = -windowBits
    } else {
        wrap = @intCast(usize, (windowBits >> 4) + 5)
        if windowBits < 48 { windowBits &= 15 }
    }
    if windowBits != 0 && (windowBits < 8 || windowBits > 15) { return c.STREAM_ERROR }
    if state.*.window != 0 && state.*.wbits != @intCast(usize, windowBits) {
        c.release(strm, state.*.window, state.*.windowBytes)
        state.*.window = 0
    }
    state.*.wrap = wrap
    state.*.wbits = @intCast(usize, windowBits)
    return reset(strm)
}

// Sets up STRM for decompression: WINDOW_BITS 8 to 15 for a zlib stream
// (0 for the window its header names), -8 to -15 for raw deflate data,
// plus 16 for a gzip member or plus 32 for either, detected; its owner
// and allocator are the caller's.
pub fn init2(strm: *c.Stream, windowBits: i32) -> i32 {
    strm.*.msg = 0
    const address = c.allocate(strm, @sizeOf(InflateState))
    if address == 0 { return c.MEM_ERROR }
    strm.*.state = address
    const state = stateOf(strm)
    state.*.owner = strm.*.owner
    state.*.window = 0
    state.*.windowBytes = 0
    state.*.client = 0
    state.*.mode = HEAD
    const result = reset2(strm, windowBits)
    if result != c.OK {
        c.release(strm, address, @sizeOf(InflateState))
        strm.*.state = 0
    }
    return result
}

pub fn prime(strm: *c.Stream, bits: i32, value: i32) -> i32 {
    if stateCheck(strm) { return c.STREAM_ERROR }
    if bits == 0 { return c.OK }
    const state = stateOf(strm)
    if bits < 0 {
        state.*.hold = 0
        state.*.bits = 0
        return c.OK
    }
    if bits > 16 || state.*.bits + @intCast(usize, bits) > 32 { return c.STREAM_ERROR }
    const masked = @bitCast(u64, @intCast(i64, value)) & ((@intCast(u64, 1) << @intCast(u6, bits)) - 1)
    state.*.hold +%= (masked << @intCast(u6, state.*.bits)) & 0xffffffff
    state.*.bits += @intCast(usize, bits)
    return c.OK
}

// Keeps the last wsize bytes of output (ending at END, COPY of them new)
// in the circular window, making it the first time; true when there is
// no memory for it.
fn updateWindow(strm: *c.Stream, end: usize, copy0: usize) -> bool {
    const state = stateOf(strm)
    var copy = copy0
    if state.*.window == 0 {
        const size = @intCast(usize, 1) << @intCast(u6, state.*.wbits)
        state.*.window = c.allocate(strm, size)
        if state.*.window == 0 { return true }
        state.*.windowBytes = size
    }
    if state.*.wsize == 0 {
        state.*.wsize = @intCast(usize, 1) << @intCast(u6, state.*.wbits)
        state.*.wnext = 0
        state.*.whave = 0
    }
    if copy >= state.*.wsize {
        c.copy(state.*.window, end - state.*.wsize, state.*.wsize)
        state.*.wnext = 0
        state.*.whave = state.*.wsize
    } else {
        var dist = state.*.wsize - state.*.wnext
        if dist > copy { dist = copy }
        c.copy(state.*.window + state.*.wnext, end - copy, dist)
        copy -= dist
        if copy != 0 {
            c.copy(state.*.window, end - copy, copy)
            state.*.wnext = copy
            state.*.whave = state.*.wsize
        } else {
            state.*.wnext += dist
            if state.*.wnext == state.*.wsize { state.*.wnext = 0 }
            if state.*.whave < state.*.wsize { state.*.whave += dist }
        }
    }
    return false
}

fn updateCheck(state: *InflateState, check: u64, buffer: usize, length: usize) -> u64 {
    if state.*.flags != 0 { return checksum.crc32Update(check, buffer, length) }
    return checksum.adler32Update(check, buffer, length)
}

// The CRC of the low LENGTH bytes of WORD (the gzip header's fields).
fn crcWord(check: u64, word: u64, length: usize) -> u64 {
    var buffer: u64 = word
    return checksum.crc32Update(check, @intFromPtr(&buffer), length)
}

fn swap32(value: u64) -> u64 {
    return ((value >> 24) & 0xff) | ((value >> 8) & 0xff00) | ((value & 0xff00) << 8) | ((value & 0xff) << 24)
}

// ---------------------------------------------------------------------------
// The fast loop: decodes literals, lengths and distances while at least
// 6 bytes of input and 258 bytes of output remain (one code needs at most
// 48 bits of input and writes at most 258 bytes). START is the output
// space inflate() began with.

fn inflateFast(strm: *c.Stream, start: usize) -> void {
    const state = stateOf(strm)
    var input = strm.*.next_in
    const last = input + (@intCast(usize, strm.*.avail_in) - 5)
    var out = strm.*.next_out
    const beg = out - (start - @intCast(usize, strm.*.avail_out))
    const end = out + (@intCast(usize, strm.*.avail_out) - 257)
    const wsize = state.*.wsize
    const whave = state.*.whave
    const wnext = state.*.wnext
    const window = state.*.window
    var hold = state.*.hold
    var bits = state.*.bits
    const lcode = state.*.lencode
    const dcode = state.*.distcode
    const lmask = (@intCast(u64, 1) << @intCast(u6, state.*.lenbits)) - 1
    const dmask = (@intCast(u64, 1) << @intCast(u6, state.*.distbits)) - 1
    const inb = c.bytes(0)
    while true {
        if bits < 15 {
            hold += @intCast(u64, inb[input]) << @intCast(u6, bits)
            input += 1
            bits += 8
            hold += @intCast(u64, inb[input]) << @intCast(u6, bits)
            input += 1
            bits += 8
        }
        var index = @intCast(usize, hold & lmask)
        var table = lcode
        var stop = false
        while true {
            const here = @intCast(usize, table[index])
            var op = bitsOf(here)
            hold = hold >> @intCast(u6, op)
            bits -= op
            op = opOf(here)
            if op == 0 {
                inb[out] = @intCast(u8, valOf(here) & 255)
                out += 1
                break
            }
            if (op & 16) != 0 {
                var len = valOf(here)
                op &= 15
                if op != 0 {
                    if bits < op {
                        hold += @intCast(u64, inb[input]) << @intCast(u6, bits)
                        input += 1
                        bits += 8
                    }
                    len += @intCast(usize, hold & ((@intCast(u64, 1) << @intCast(u6, op)) - 1))
                    hold = hold >> @intCast(u6, op)
                    bits -= op
                }
                if bits < 15 {
                    hold += @intCast(u64, inb[input]) << @intCast(u6, bits)
                    input += 1
                    bits += 8
                    hold += @intCast(u64, inb[input]) << @intCast(u6, bits)
                    input += 1
                    bits += 8
                }
                var dindex = @intCast(usize, hold & dmask)
                var dtable = dcode
                while true {
                    const dhere = @intCast(usize, dtable[dindex])
                    op = bitsOf(dhere)
                    hold = hold >> @intCast(u6, op)
                    bits -= op
                    op = opOf(dhere)
                    if (op & 16) != 0 {
                        var dist = valOf(dhere)
                        op &= 15
                        if bits < op {
                            hold += @intCast(u64, inb[input]) << @intCast(u6, bits)
                            input += 1
                            bits += 8
                            if bits < op {
                                hold += @intCast(u64, inb[input]) << @intCast(u6, bits)
                                input += 1
                                bits += 8
                            }
                        }
                        dist += @intCast(usize, hold & ((@intCast(u64, 1) << @intCast(u6, op)) - 1))
                        hold = hold >> @intCast(u6, op)
                        bits -= op
                        op = out - beg
                        if dist > op {
                            // From the window, then perhaps the output.
                            op = dist - op
                            if op > whave {
                                if state.*.sane != 0 {
                                    strm.*.msg = c.literal("invalid distance too far back")
                                    state.*.mode = BAD
                                    stop = true
                                    break
                                }
                            }
                            var from = window
                            if wnext == 0 {
                                from += wsize - op
                                if op < len {
                                    len -= op
                                    while op != 0 {
                                        inb[out] = inb[from]
                                        out += 1
                                        from += 1
                                        op -= 1
                                    }
                                    from = out - dist
                                }
                            } else if wnext < op {
                                from += wsize + wnext - op
                                op -= wnext
                                if op < len {
                                    len -= op
                                    while op != 0 {
                                        inb[out] = inb[from]
                                        out += 1
                                        from += 1
                                        op -= 1
                                    }
                                    from = window
                                    if wnext < len {
                                        op = wnext
                                        len -= op
                                        while op != 0 {
                                            inb[out] = inb[from]
                                            out += 1
                                            from += 1
                                            op -= 1
                                        }
                                        from = out - dist
                                    }
                                }
                            } else {
                                from += wnext - op
                                if op < len {
                                    len -= op
                                    while op != 0 {
                                        inb[out] = inb[from]
                                        out += 1
                                        from += 1
                                        op -= 1
                                    }
                                    from = out - dist
                                }
                            }
                            while len != 0 {
                                inb[out] = inb[from]
                                out += 1
                                from += 1
                                len -= 1
                            }
                        } else {
                            var from = out - dist
                            while len != 0 {
                                inb[out] = inb[from]
                                out += 1
                                from += 1
                                len -= 1
                            }
                        }
                        break
                    }
                    if (op & 64) == 0 {
                        dindex = valOf(dhere) + @intCast(usize, hold & ((@intCast(u64, 1) << @intCast(u6, op)) - 1))
                        continue
                    }
                    strm.*.msg = c.literal("invalid distance code")
                    state.*.mode = BAD
                    stop = true
                    break
                }
                break
            }
            if (op & 64) == 0 {
                index = valOf(here) + @intCast(usize, hold & ((@intCast(u64, 1) << @intCast(u6, op)) - 1))
                continue
            }
            if (op & 32) != 0 {
                state.*.mode = TYPE
                stop = true
                break
            }
            strm.*.msg = c.literal("invalid literal/length code")
            state.*.mode = BAD
            stop = true
            break
        }
        if stop { break }
        if !(input < last && out < end) { break }
    }
    // Whole bytes not used go back to the input.
    const unused = bits >> 3
    input -= unused
    bits -= unused << 3
    hold &= (@intCast(u64, 1) << @intCast(u6, bits)) - 1
    strm.*.next_in = input
    strm.*.next_out = out
    strm.*.avail_in = @intCast(u32, if input < last { 5 + (last - input) } else { 5 - (input - last) })
    strm.*.avail_out = @intCast(u32, if out < end { 257 + (end - out) } else { 257 - (out - end) })
    state.*.hold = hold
    state.*.bits = bits
}

// ---------------------------------------------------------------------------
// inflate()

pub fn run(strm: *c.Stream, flush: i32) -> i32 {
    if stateCheck(strm) { return c.STREAM_ERROR }
    if strm.*.next_out == 0 || (strm.*.next_in == 0 && strm.*.avail_in != 0) { return c.STREAM_ERROR }
    const state = stateOf(strm)
    if state.*.mode == TYPE { state.*.mode = TYPEDO }
    const mem = c.bytes(0)
    var put = strm.*.next_out
    var left = @intCast(usize, strm.*.avail_out)
    var next = strm.*.next_in
    var have = @intCast(usize, strm.*.avail_in)
    var hold = state.*.hold
    var bits = state.*.bits
    const in0 = have
    var out = left
    var ret = c.OK
    machine: while true {
        const mode = state.*.mode
        if mode == HEAD {
            if state.*.wrap == 0 {
                state.*.mode = TYPEDO
                continue
            }
            while bits < 16 {
                if have == 0 { break :machine }
                have -= 1
                hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                next += 1
                bits += 8
            }
            if (state.*.wrap & 2) != 0 && hold == 0x8b1f {
                if state.*.wbits == 0 { state.*.wbits = 15 }
                state.*.check = checksum.crc32Update(0, 0, 0)
                state.*.check = crcWord(state.*.check, hold, 2)
                hold = 0
                bits = 0
                state.*.mode = FLAGS
                continue
            }
            if state.*.head != 0 { c.header(state.*.head).*.done = -1 }
            if (state.*.wrap & 1) == 0 || (((hold & 0xff) << 8) + (hold >> 8)) % 31 != 0 {
                strm.*.msg = c.literal("incorrect header check")
                state.*.mode = BAD
                continue
            }
            if (hold & 15) != 8 {
                strm.*.msg = c.literal("unknown compression method")
                state.*.mode = BAD
                continue
            }
            hold >>= 4
            bits -= 4
            const len = @intCast(usize, hold & 15) + 8
            if state.*.wbits == 0 { state.*.wbits = len }
            if len > 15 || len > state.*.wbits {
                strm.*.msg = c.literal("invalid window size")
                state.*.mode = BAD
                continue
            }
            state.*.dmax = @intCast(usize, 1) << @intCast(u6, len)
            state.*.flags = 0
            state.*.check = checksum.adler32Update(0, 0, 0)
            strm.*.adler = state.*.check
            state.*.mode = if (hold & 0x200) != 0 { DICTID } else { TYPE }
            hold = 0
            bits = 0
            continue
        }
        if mode == FLAGS {
            while bits < 16 {
                if have == 0 { break :machine }
                have -= 1
                hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                next += 1
                bits += 8
            }
            state.*.flags = @intCast(i64, hold)
            if (state.*.flags & 0xff) != 8 {
                strm.*.msg = c.literal("unknown compression method")
                state.*.mode = BAD
                continue
            }
            if (state.*.flags & 0xe000) != 0 {
                strm.*.msg = c.literal("unknown header flags set")
                state.*.mode = BAD
                continue
            }
            if state.*.head != 0 { c.header(state.*.head).*.text = @intCast(i32, (hold >> 8) & 1) }
            if (state.*.flags & 0x0200) != 0 && (state.*.wrap & 4) != 0 { state.*.check = crcWord(state.*.check, hold, 2) }
            hold = 0
            bits = 0
            state.*.mode = TIME
        }
        if state.*.mode == TIME {
            while bits < 32 {
                if have == 0 { break :machine }
                have -= 1
                hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                next += 1
                bits += 8
            }
            if state.*.head != 0 { c.header(state.*.head).*.time = hold }
            if (state.*.flags & 0x0200) != 0 && (state.*.wrap & 4) != 0 { state.*.check = crcWord(state.*.check, hold, 4) }
            hold = 0
            bits = 0
            state.*.mode = OS
        }
        if state.*.mode == OS {
            while bits < 16 {
                if have == 0 { break :machine }
                have -= 1
                hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                next += 1
                bits += 8
            }
            if state.*.head != 0 {
                c.header(state.*.head).*.xflags = @intCast(i32, hold & 0xff)
                c.header(state.*.head).*.os = @intCast(i32, hold >> 8)
            }
            if (state.*.flags & 0x0200) != 0 && (state.*.wrap & 4) != 0 { state.*.check = crcWord(state.*.check, hold, 2) }
            hold = 0
            bits = 0
            state.*.mode = EXLEN
        }
        if state.*.mode == EXLEN {
            if (state.*.flags & 0x0400) != 0 {
                while bits < 16 {
                    if have == 0 { break :machine }
                    have -= 1
                    hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                    next += 1
                    bits += 8
                }
                state.*.length = @intCast(usize, hold)
                if state.*.head != 0 { c.header(state.*.head).*.extra_len = @intCast(u32, hold) }
                if (state.*.flags & 0x0200) != 0 && (state.*.wrap & 4) != 0 { state.*.check = crcWord(state.*.check, hold, 2) }
                hold = 0
                bits = 0
            } else if state.*.head != 0 {
                c.header(state.*.head).*.extra = 0
            }
            state.*.mode = EXTRA
        }
        if state.*.mode == EXTRA {
            if (state.*.flags & 0x0400) != 0 {
                var copy = state.*.length
                if copy > have { copy = have }
                if copy != 0 {
                    if state.*.head != 0 {
                        const head = c.header(state.*.head)
                        if head.*.extra != 0 {
                            const len = (@intCast(usize, head.*.extra_len) -% state.*.length) & 0xffffffff
                            if len < @intCast(usize, head.*.extra_max) {
                                c.copy(head.*.extra + len, next, if len + copy > @intCast(usize, head.*.extra_max) { @intCast(usize, head.*.extra_max) - len } else { copy })
                            }
                        }
                    }
                    if (state.*.flags & 0x0200) != 0 && (state.*.wrap & 4) != 0 { state.*.check = checksum.crc32Update(state.*.check, next, copy) }
                    have -= copy
                    next += copy
                    state.*.length -= copy
                }
                if state.*.length != 0 { break :machine }
            }
            state.*.length = 0
            state.*.mode = NAME
        }
        if state.*.mode == NAME {
            if (state.*.flags & 0x0800) != 0 {
                if have == 0 { break :machine }
                var copy: usize = 0
                var len: usize = 0
                while true {
                    len = @intCast(usize, mem[next + copy])
                    copy += 1
                    if state.*.head != 0 {
                        const head = c.header(state.*.head)
                        if head.*.name != 0 && state.*.length < @intCast(usize, head.*.name_max) {
                            c.put8(head.*.name + state.*.length, len)
                            state.*.length += 1
                        }
                    }
                    if !(len != 0 && copy < have) { break }
                }
                if (state.*.flags & 0x0200) != 0 && (state.*.wrap & 4) != 0 { state.*.check = checksum.crc32Update(state.*.check, next, copy) }
                have -= copy
                next += copy
                if len != 0 { break :machine }
            } else if state.*.head != 0 {
                c.header(state.*.head).*.name = 0
            }
            state.*.length = 0
            state.*.mode = COMMENT
        }
        if state.*.mode == COMMENT {
            if (state.*.flags & 0x1000) != 0 {
                if have == 0 { break :machine }
                var copy: usize = 0
                var len: usize = 0
                while true {
                    len = @intCast(usize, mem[next + copy])
                    copy += 1
                    if state.*.head != 0 {
                        const head = c.header(state.*.head)
                        if head.*.comment != 0 && state.*.length < @intCast(usize, head.*.comm_max) {
                            c.put8(head.*.comment + state.*.length, len)
                            state.*.length += 1
                        }
                    }
                    if !(len != 0 && copy < have) { break }
                }
                if (state.*.flags & 0x0200) != 0 && (state.*.wrap & 4) != 0 { state.*.check = checksum.crc32Update(state.*.check, next, copy) }
                have -= copy
                next += copy
                if len != 0 { break :machine }
            } else if state.*.head != 0 {
                c.header(state.*.head).*.comment = 0
            }
            state.*.mode = HCRC
        }
        if state.*.mode == HCRC {
            if (state.*.flags & 0x0200) != 0 {
                while bits < 16 {
                    if have == 0 { break :machine }
                    have -= 1
                    hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                    next += 1
                    bits += 8
                }
                if (state.*.wrap & 4) != 0 && hold != (state.*.check & 0xffff) {
                    strm.*.msg = c.literal("header crc mismatch")
                    state.*.mode = BAD
                    continue
                }
                hold = 0
                bits = 0
            }
            if state.*.head != 0 {
                c.header(state.*.head).*.hcrc = @intCast(i32, (state.*.flags >> 9) & 1)
                c.header(state.*.head).*.done = 1
            }
            state.*.check = checksum.crc32Update(0, 0, 0)
            strm.*.adler = state.*.check
            state.*.mode = TYPE
            continue
        }
        if mode == DICTID {
            while bits < 32 {
                if have == 0 { break :machine }
                have -= 1
                hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                next += 1
                bits += 8
            }
            state.*.check = swap32(hold)
            strm.*.adler = state.*.check
            hold = 0
            bits = 0
            state.*.mode = DICT
        }
        if state.*.mode == DICT {
            if state.*.havedict == 0 {
                strm.*.next_out = put
                strm.*.avail_out = @intCast(u32, left)
                strm.*.next_in = next
                strm.*.avail_in = @intCast(u32, have)
                state.*.hold = hold
                state.*.bits = bits
                return c.NEED_DICT
            }
            state.*.check = checksum.adler32Update(0, 0, 0)
            strm.*.adler = state.*.check
            state.*.mode = TYPE
        }
        if state.*.mode == TYPE {
            if flush == c.BLOCK || flush == c.TREES { break :machine }
        }
        // (TYPE goes on here as itself: leaving for want of input, the
        // mode stays TYPE.)
        if state.*.mode == TYPEDO || state.*.mode == TYPE {
            if state.*.last != 0 {
                hold = hold >> @intCast(u6, bits & 7)
                bits -= bits & 7
                state.*.mode = CHECK
                continue
            }
            while bits < 3 {
                if have == 0 { break :machine }
                have -= 1
                hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                next += 1
                bits += 8
            }
            state.*.last = @intCast(usize, hold & 1)
            hold >>= 1
            bits -= 1
            const kind = hold & 3
            if kind == 0 {
                state.*.mode = STORED
            } else if kind == 1 {
                fixedTables(state)
                state.*.mode = LEN_
                if flush == c.TREES {
                    hold >>= 2
                    bits -= 2
                    break :machine
                }
            } else if kind == 2 {
                state.*.mode = TABLE
            } else {
                strm.*.msg = c.literal("invalid block type")
                state.*.mode = BAD
            }
            hold >>= 2
            bits -= 2
            continue
        }
        if mode == STORED {
            hold = hold >> @intCast(u6, bits & 7)
            bits -= bits & 7
            while bits < 32 {
                if have == 0 { break :machine }
                have -= 1
                hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                next += 1
                bits += 8
            }
            if (hold & 0xffff) != ((hold >> 16) ^ 0xffff) {
                strm.*.msg = c.literal("invalid stored block lengths")
                state.*.mode = BAD
                continue
            }
            state.*.length = @intCast(usize, hold & 0xffff)
            hold = 0
            bits = 0
            state.*.mode = COPY_
            if flush == c.TREES { break :machine }
        }
        if state.*.mode == COPY_ { state.*.mode = COPY }
        if state.*.mode == COPY {
            var copy = state.*.length
            if copy != 0 {
                if copy > have { copy = have }
                if copy > left { copy = left }
                if copy == 0 { break :machine }
                c.copy(put, next, copy)
                have -= copy
                next += copy
                left -= copy
                put += copy
                state.*.length -= copy
                continue
            }
            state.*.mode = TYPE
            continue
        }
        if mode == TABLE {
            while bits < 14 {
                if have == 0 { break :machine }
                have -= 1
                hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                next += 1
                bits += 8
            }
            state.*.nlen = @intCast(usize, hold & 31) + 257
            hold >>= 5
            bits -= 5
            state.*.ndist = @intCast(usize, hold & 31) + 1
            hold >>= 5
            bits -= 5
            state.*.ncode = @intCast(usize, hold & 15) + 4
            hold >>= 4
            bits -= 4
            if state.*.nlen > 286 || state.*.ndist > 30 {
                strm.*.msg = c.literal("too many length or distance symbols")
                state.*.mode = BAD
                continue
            }
            state.*.have = 0
            state.*.mode = LENLENS
        }
        if state.*.mode == LENLENS {
            while state.*.have < state.*.ncode {
                while bits < 3 {
                    if have == 0 { break :machine }
                    have -= 1
                    hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                    next += 1
                    bits += 8
                }
                state.*.lens[ORDER[state.*.have]] = @intCast(u16, hold & 7)
                state.*.have += 1
                hold >>= 3
                bits -= 3
            }
            while state.*.have < 19 {
                state.*.lens[ORDER[state.*.have]] = 0
                state.*.have += 1
            }
            state.*.next = @intFromPtr(&state.*.codes)
            state.*.lencode = codes(state.*.next)
            state.*.lenbits = 7
            const result = inflateTable(CODES, &state.*.lens, 19, &state.*.next, &state.*.lenbits, &state.*.work)
            if result != 0 {
                strm.*.msg = c.literal("invalid code lengths set")
                state.*.mode = BAD
                continue
            }
            state.*.have = 0
            state.*.mode = CODELENS
        }
        if state.*.mode == CODELENS {
            var failed = false
            while state.*.have < state.*.nlen + state.*.ndist {
                var here: usize = 0
                while true {
                    here = @intCast(usize, state.*.lencode[@intCast(usize, hold & ((@intCast(u64, 1) << @intCast(u6, state.*.lenbits)) - 1))])
                    if bitsOf(here) <= bits { break }
                    if have == 0 { break :machine }
                    have -= 1
                    hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                    next += 1
                    bits += 8
                }
                const hereBits = bitsOf(here)
                if valOf(here) < 16 {
                    hold = hold >> @intCast(u6, hereBits)
                    bits -= hereBits
                    state.*.lens[state.*.have] = @intCast(u16, valOf(here))
                    state.*.have += 1
                } else {
                    var len: usize = 0
                    var copy: usize = 0
                    if valOf(here) == 16 {
                        while bits < hereBits + 2 {
                            if have == 0 { break :machine }
                            have -= 1
                            hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                            next += 1
                            bits += 8
                        }
                        hold = hold >> @intCast(u6, hereBits)
                        bits -= hereBits
                        if state.*.have == 0 {
                            strm.*.msg = c.literal("invalid bit length repeat")
                            state.*.mode = BAD
                            failed = true
                            break
                        }
                        len = @intCast(usize, state.*.lens[state.*.have - 1])
                        copy = 3 + @intCast(usize, hold & 3)
                        hold >>= 2
                        bits -= 2
                    } else if valOf(here) == 17 {
                        while bits < hereBits + 3 {
                            if have == 0 { break :machine }
                            have -= 1
                            hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                            next += 1
                            bits += 8
                        }
                        hold = hold >> @intCast(u6, hereBits)
                        bits -= hereBits
                        len = 0
                        copy = 3 + @intCast(usize, hold & 7)
                        hold >>= 3
                        bits -= 3
                    } else {
                        while bits < hereBits + 7 {
                            if have == 0 { break :machine }
                            have -= 1
                            hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                            next += 1
                            bits += 8
                        }
                        hold = hold >> @intCast(u6, hereBits)
                        bits -= hereBits
                        len = 0
                        copy = 11 + @intCast(usize, hold & 127)
                        hold >>= 7
                        bits -= 7
                    }
                    if state.*.have + copy > state.*.nlen + state.*.ndist {
                        strm.*.msg = c.literal("invalid bit length repeat")
                        state.*.mode = BAD
                        failed = true
                        break
                    }
                    while copy != 0 {
                        state.*.lens[state.*.have] = @intCast(u16, len)
                        state.*.have += 1
                        copy -= 1
                    }
                }
            }
            if failed { continue }
            if state.*.lens[256] == 0 {
                strm.*.msg = c.literal("invalid code -- missing end-of-block")
                state.*.mode = BAD
                continue
            }
            state.*.next = @intFromPtr(&state.*.codes)
            state.*.lencode = codes(state.*.next)
            state.*.lenbits = 9
            var result = inflateTable(LENS, &state.*.lens, state.*.nlen, &state.*.next, &state.*.lenbits, &state.*.work)
            if result != 0 {
                strm.*.msg = c.literal("invalid literal/lengths set")
                state.*.mode = BAD
                continue
            }
            state.*.distcode = codes(state.*.next)
            state.*.distbits = 6
            result = inflateTable(DISTS, c.shorts(@intFromPtr(&state.*.lens) + state.*.nlen * 2), state.*.ndist, &state.*.next, &state.*.distbits, &state.*.work)
            if result != 0 {
                strm.*.msg = c.literal("invalid distances set")
                state.*.mode = BAD
                continue
            }
            state.*.mode = LEN_
            if flush == c.TREES { break :machine }
        }
        if state.*.mode == LEN_ { state.*.mode = LEN }
        if state.*.mode == LEN {
            if have >= 6 && left >= 258 {
                strm.*.next_out = put
                strm.*.avail_out = @intCast(u32, left)
                strm.*.next_in = next
                strm.*.avail_in = @intCast(u32, have)
                state.*.hold = hold
                state.*.bits = bits
                inflateFast(strm, out)
                put = strm.*.next_out
                left = @intCast(usize, strm.*.avail_out)
                next = strm.*.next_in
                have = @intCast(usize, strm.*.avail_in)
                hold = state.*.hold
                bits = state.*.bits
                if state.*.mode == TYPE { state.*.back = -1 }
                continue
            }
            state.*.back = 0
            var here: usize = 0
            while true {
                here = @intCast(usize, state.*.lencode[@intCast(usize, hold & ((@intCast(u64, 1) << @intCast(u6, state.*.lenbits)) - 1))])
                if bitsOf(here) <= bits { break }
                if have == 0 { break :machine }
                have -= 1
                hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                next += 1
                bits += 8
            }
            if opOf(here) != 0 && (opOf(here) & 0xf0) == 0 {
                const lastCode = here
                const lastBits = bitsOf(lastCode)
                while true {
                    const index = valOf(lastCode) + @intCast(usize, (hold & ((@intCast(u64, 1) << @intCast(u6, lastBits + opOf(lastCode))) - 1)) >> @intCast(u6, lastBits))
                    here = @intCast(usize, state.*.lencode[index])
                    if lastBits + bitsOf(here) <= bits { break }
                    if have == 0 { break :machine }
                    have -= 1
                    hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                    next += 1
                    bits += 8
                }
                hold = hold >> @intCast(u6, lastBits)
                bits -= lastBits
                state.*.back += @intCast(i64, lastBits)
            }
            hold = hold >> @intCast(u6, bitsOf(here))
            bits -= bitsOf(here)
            state.*.back += @intCast(i64, bitsOf(here))
            state.*.length = valOf(here)
            if opOf(here) == 0 {
                state.*.mode = LIT
                continue
            }
            if (opOf(here) & 32) != 0 {
                state.*.back = -1
                state.*.mode = TYPE
                continue
            }
            if (opOf(here) & 64) != 0 {
                strm.*.msg = c.literal("invalid literal/length code")
                state.*.mode = BAD
                continue
            }
            state.*.extra = @intCast(usize, opOf(here) & 15)
            state.*.mode = LENEXT
        }
        if state.*.mode == LENEXT {
            if state.*.extra != 0 {
                while bits < state.*.extra {
                    if have == 0 { break :machine }
                    have -= 1
                    hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                    next += 1
                    bits += 8
                }
                state.*.length += @intCast(usize, hold & ((@intCast(u64, 1) << @intCast(u6, state.*.extra)) - 1))
                hold = hold >> @intCast(u6, state.*.extra)
                bits -= state.*.extra
                state.*.back += @intCast(i64, state.*.extra)
            }
            state.*.was = state.*.length
            state.*.mode = DIST
        }
        if state.*.mode == DIST {
            var here: usize = 0
            while true {
                here = @intCast(usize, state.*.distcode[@intCast(usize, hold & ((@intCast(u64, 1) << @intCast(u6, state.*.distbits)) - 1))])
                if bitsOf(here) <= bits { break }
                if have == 0 { break :machine }
                have -= 1
                hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                next += 1
                bits += 8
            }
            if (opOf(here) & 0xf0) == 0 {
                const lastCode = here
                const lastBits = bitsOf(lastCode)
                while true {
                    const index = valOf(lastCode) + @intCast(usize, (hold & ((@intCast(u64, 1) << @intCast(u6, lastBits + opOf(lastCode))) - 1)) >> @intCast(u6, lastBits))
                    here = @intCast(usize, state.*.distcode[index])
                    if lastBits + bitsOf(here) <= bits { break }
                    if have == 0 { break :machine }
                    have -= 1
                    hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                    next += 1
                    bits += 8
                }
                hold = hold >> @intCast(u6, lastBits)
                bits -= lastBits
                state.*.back += @intCast(i64, lastBits)
            }
            hold = hold >> @intCast(u6, bitsOf(here))
            bits -= bitsOf(here)
            state.*.back += @intCast(i64, bitsOf(here))
            if (opOf(here) & 64) != 0 {
                strm.*.msg = c.literal("invalid distance code")
                state.*.mode = BAD
                continue
            }
            state.*.offset = valOf(here)
            state.*.extra = @intCast(usize, opOf(here) & 15)
            state.*.mode = DISTEXT
        }
        if state.*.mode == DISTEXT {
            if state.*.extra != 0 {
                while bits < state.*.extra {
                    if have == 0 { break :machine }
                    have -= 1
                    hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                    next += 1
                    bits += 8
                }
                state.*.offset += @intCast(usize, hold & ((@intCast(u64, 1) << @intCast(u6, state.*.extra)) - 1))
                hold = hold >> @intCast(u6, state.*.extra)
                bits -= state.*.extra
                state.*.back += @intCast(i64, state.*.extra)
            }
            state.*.mode = MATCH
        }
        if state.*.mode == MATCH {
            if left == 0 { break :machine }
            var copy = out - left
            var from: usize = 0
            if state.*.offset > copy {
                copy = state.*.offset - copy
                if copy > state.*.whave {
                    if state.*.sane != 0 {
                        strm.*.msg = c.literal("invalid distance too far back")
                        state.*.mode = BAD
                        continue
                    }
                }
                if copy > state.*.wnext {
                    copy -= state.*.wnext
                    from = state.*.window + (state.*.wsize - copy)
                } else {
                    from = state.*.window + (state.*.wnext - copy)
                }
                if copy > state.*.length { copy = state.*.length }
            } else {
                from = put - state.*.offset
                copy = state.*.length
            }
            if copy > left { copy = left }
            left -= copy
            state.*.length -= copy
            while copy != 0 {
                mem[put] = mem[from]
                put += 1
                from += 1
                copy -= 1
            }
            if state.*.length == 0 { state.*.mode = LEN }
            continue
        }
        if mode == LIT {
            if left == 0 { break :machine }
            mem[put] = @intCast(u8, state.*.length & 255)
            put += 1
            left -= 1
            state.*.mode = LEN
            continue
        }
        if mode == CHECK {
            if state.*.wrap != 0 {
                while bits < 32 {
                    if have == 0 { break :machine }
                    have -= 1
                    hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                    next += 1
                    bits += 8
                }
                out -= left
                strm.*.total_out +%= @intCast(u64, out)
                state.*.total +%= @intCast(u64, out)
                if (state.*.wrap & 4) != 0 && out != 0 {
                    state.*.check = updateCheck(state, state.*.check, put - out, out)
                    strm.*.adler = state.*.check
                }
                out = left
                const expected = if state.*.flags != 0 { hold } else { swap32(hold) }
                if (state.*.wrap & 4) != 0 && expected != state.*.check {
                    strm.*.msg = c.literal("incorrect data check")
                    state.*.mode = BAD
                    continue
                }
                hold = 0
                bits = 0
            }
            state.*.mode = LENGTH
        }
        if state.*.mode == LENGTH {
            if state.*.wrap != 0 && state.*.flags != 0 {
                while bits < 32 {
                    if have == 0 { break :machine }
                    have -= 1
                    hold += @intCast(u64, mem[next]) << @intCast(u6, bits)
                    next += 1
                    bits += 8
                }
                if (state.*.wrap & 4) != 0 && hold != (state.*.total & 0xffffffff) {
                    strm.*.msg = c.literal("incorrect length check")
                    state.*.mode = BAD
                    continue
                }
                hold = 0
                bits = 0
            }
            state.*.mode = DONE
        }
        if state.*.mode == DONE {
            ret = c.STREAM_END
            break :machine
        }
        if state.*.mode == BAD {
            ret = c.DATA_ERROR
            break :machine
        }
        if state.*.mode == MEM { return c.MEM_ERROR }
        return c.STREAM_ERROR
    }
    // Back to the stream: the counts, the window, the check value.
    strm.*.next_out = put
    strm.*.avail_out = @intCast(u32, left)
    strm.*.next_in = next
    strm.*.avail_in = @intCast(u32, have)
    state.*.hold = hold
    state.*.bits = bits
    if state.*.wsize != 0 || (out != @intCast(usize, strm.*.avail_out) && state.*.mode < BAD && (state.*.mode < CHECK || flush != c.FINISH)) {
        if updateWindow(strm, strm.*.next_out, out - @intCast(usize, strm.*.avail_out)) {
            state.*.mode = MEM
            return c.MEM_ERROR
        }
    }
    const inUsed = in0 - @intCast(usize, strm.*.avail_in)
    const outUsed = out - @intCast(usize, strm.*.avail_out)
    strm.*.total_in +%= @intCast(u64, inUsed)
    strm.*.total_out +%= @intCast(u64, outUsed)
    state.*.total +%= @intCast(u64, outUsed)
    if (state.*.wrap & 4) != 0 && outUsed != 0 {
        state.*.check = updateCheck(state, state.*.check, strm.*.next_out - outUsed, outUsed)
        strm.*.adler = state.*.check
    }
    var dataType = @intCast(i32, state.*.bits)
    if state.*.last != 0 { dataType += 64 }
    if state.*.mode == TYPE { dataType += 128 }
    if state.*.mode == LEN_ || state.*.mode == COPY_ { dataType += 256 }
    strm.*.data_type = dataType
    if ((inUsed == 0 && outUsed == 0) || flush == c.FINISH) && ret == c.OK { ret = c.BUF_ERROR }
    return ret
}

pub fn end(strm: *c.Stream) -> i32 {
    if stateCheck(strm) { return c.STREAM_ERROR }
    const state = stateOf(strm)
    c.release(strm, state.*.window, state.*.windowBytes)
    c.release(strm, strm.*.state, @sizeOf(InflateState))
    strm.*.state = 0
    return c.OK
}

pub fn getDictionary(strm: *c.Stream, dictionary: usize, dictLength: usize) -> i32 {
    if stateCheck(strm) { return c.STREAM_ERROR }
    const state = stateOf(strm)
    if state.*.whave != 0 && dictionary != 0 {
        c.copy(dictionary, state.*.window + state.*.wnext, state.*.whave - state.*.wnext)
        c.copy(dictionary + state.*.whave - state.*.wnext, state.*.window, state.*.wnext)
    }
    if dictLength != 0 { c.put32(dictLength, state.*.whave) }
    return c.OK
}

pub fn setDictionary(strm: *c.Stream, dictionary: usize, dictLength: usize) -> i32 {
    if stateCheck(strm) { return c.STREAM_ERROR }
    const state = stateOf(strm)
    if state.*.wrap != 0 && state.*.mode != DICT { return c.STREAM_ERROR }
    if state.*.mode == DICT {
        var dictid = checksum.adler32Update(0, 0, 0)
        dictid = checksum.adler32Update(dictid, dictionary, dictLength)
        if dictid != state.*.check { return c.DATA_ERROR }
    }
    if updateWindow(strm, dictionary + dictLength, dictLength) {
        state.*.mode = MEM
        return c.MEM_ERROR
    }
    state.*.havedict = 1
    return c.OK
}

pub fn getHeader(strm: *c.Stream, head: usize) -> i32 {
    if stateCheck(strm) { return c.STREAM_ERROR }
    const state = stateOf(strm)
    if (state.*.wrap & 2) == 0 { return c.STREAM_ERROR }
    state.*.head = head
    c.header(head).*.done = 0
    return c.OK
}

// Looks for the bytes 0, 0, 0xff, 0xff in LEN bytes at BUF, *HAVE of them
// found already; how many bytes were looked at.
fn syncSearch(have: *usize, buf: usize, len: usize) -> usize {
    var got = have.*
    var next: usize = 0
    while next < len && got < 4 {
        const byte = @intCast(usize, c.get8(buf + next))
        if byte == (if got < 2 { 0 } else { 0xff }) {
            got += 1
        } else if byte != 0 {
            got = 0
        } else {
            got = 4 - got
        }
        next += 1
    }
    have.* = got
    return next
}

pub fn sync(strm: *c.Stream) -> i32 {
    if stateCheck(strm) { return c.STREAM_ERROR }
    const state = stateOf(strm)
    if strm.*.avail_in == 0 && state.*.bits < 8 { return c.BUF_ERROR }
    if state.*.mode != SYNC {
        state.*.mode = SYNC
        state.*.hold = state.*.hold >> @intCast(u6, state.*.bits & 7)
        state.*.bits -= state.*.bits & 7
        var buf: [4]u8 = undefined
        var len: usize = 0
        while state.*.bits >= 8 {
            buf[len] = @intCast(u8, state.*.hold & 255)
            len += 1
            state.*.hold >>= 8
            state.*.bits -= 8
        }
        state.*.have = 0
        _ = syncSearch(&state.*.have, @intFromPtr(&buf), len)
    }
    const len = syncSearch(&state.*.have, strm.*.next_in, @intCast(usize, strm.*.avail_in))
    strm.*.avail_in = @intCast(u32, @intCast(usize, strm.*.avail_in) - len)
    strm.*.next_in += len
    strm.*.total_in +%= @intCast(u64, len)
    if state.*.have != 4 { return c.DATA_ERROR }
    if state.*.flags == -1 {
        state.*.wrap = 0
    } else {
        state.*.wrap &= ~@intCast(usize, 4)
    }
    const flags = state.*.flags
    const totalIn = strm.*.total_in
    const totalOut = strm.*.total_out
    _ = reset(strm)
    strm.*.total_in = totalIn
    strm.*.total_out = totalOut
    state.*.flags = flags
    state.*.mode = TYPE
    return c.OK
}

pub fn syncPoint(strm: *c.Stream) -> i32 {
    if stateCheck(strm) { return c.STREAM_ERROR }
    const state = stateOf(strm)
    return if state.*.mode == STORED && state.*.bits == 0 { 1 } else { 0 }
}

// Makes DEST a copy of SOURCE (all of the stream but DEST's owner, and a
// state of its own, from SOURCE's allocator).
pub fn copyStream(dest: *c.Stream, source: *c.Stream) -> i32 {
    if stateCheck(source) { return c.STREAM_ERROR }
    const state = stateOf(source)
    const copyAddress = c.allocate(source, @sizeOf(InflateState))
    if copyAddress == 0 { return c.MEM_ERROR }
    var window: usize = 0
    if state.*.window != 0 {
        window = c.allocate(source, state.*.windowBytes)
        if window == 0 {
            c.release(source, copyAddress, @sizeOf(InflateState))
            return c.MEM_ERROR
        }
    }
    const owner = dest.*.owner
    c.copy(@intFromPtr(dest), @intFromPtr(source), @sizeOf(c.Stream))
    dest.*.owner = owner
    c.copy(copyAddress, source.*.state, @sizeOf(InflateState))
    const copy: *InflateState = unsafe { @ptrFromInt(*InflateState, copyAddress) }
    copy.*.owner = owner
    const codesStart = @intFromPtr(&state.*.codes)
    const codesEnd = codesStart + (ENOUGH - 1) * 4
    const lencode = @intFromPtr(state.*.lencode)
    if lencode >= codesStart && lencode <= codesEnd {
        copy.*.lencode = codes(@intFromPtr(&copy.*.codes) + (lencode - codesStart))
        copy.*.distcode = codes(@intFromPtr(&copy.*.codes) + (@intFromPtr(state.*.distcode) - codesStart))
    }
    copy.*.next = @intFromPtr(&copy.*.codes) + (state.*.next - codesStart)
    if window != 0 { c.copy(window, state.*.window, state.*.windowBytes) }
    copy.*.window = window
    dest.*.state = copyAddress
    return c.OK
}

pub fn undermine(strm: *c.Stream, subvert: i32) -> i32 {
    if stateCheck(strm) { return c.STREAM_ERROR }
    stateOf(strm).*.sane = 1
    return c.DATA_ERROR
}

pub fn validate(strm: *c.Stream, check: i32) -> i32 {
    if stateCheck(strm) { return c.STREAM_ERROR }
    const state = stateOf(strm)
    if check != 0 && state.*.wrap != 0 {
        state.*.wrap |= 4
    } else {
        state.*.wrap &= ~@intCast(usize, 4)
    }
    return c.OK
}

pub fn mark(strm: *c.Stream) -> i64 {
    if stateCheck(strm) { return -65536 }
    const state = stateOf(strm)
    var extra: i64 = 0
    if state.*.mode == COPY {
        extra = @intCast(i64, state.*.length)
    } else if state.*.mode == MATCH {
        extra = @intCast(i64, state.*.was) - @intCast(i64, state.*.length)
    }
    return @bitCast(i64, @bitCast(u64, state.*.back) << 16) +% extra
}

pub fn codesUsed(strm: *c.Stream) -> u64 {
    if stateCheck(strm) { return 0xffffffffffffffff }
    const state = stateOf(strm)
    return @intCast(u64, (state.*.next - @intFromPtr(&state.*.codes)) / 4)
}
