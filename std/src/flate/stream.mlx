// std.flate.stream: what the parts of std.flate's compressor and
// decompressor share: the stream (zlib's z_stream as an Mlx structure,
// with an Allocator in place of zalloc and zfree), the gzip header, the
// return codes and their messages, the flush kinds, the strategies, and
// byte access by address.
//
// The engine works on addresses (usize) for its buffers, as zlib's C
// does on pointers; std.flate (flate.mlx) puts typed functions over it.
// The C API (compiler/capi/zlib) maps a C z_stream onto a Stream for
// each call.
//
// Arithmetic is done in 64-bit words (usize, u64, i64) and values are
// narrowed only where memory holds them narrower: a narrow integer in a
// register is not cut to its width by every operation, so a shifted or
// complemented u32 or u16 is masked before it is compared or stored.
const allocator_module = @import("../../bootstrap/allocator.mlx")
const mem = @import("../../bootstrap/mem.mlx")

pub const Allocator = allocator_module.Allocator

// A stream of input to output: zlib's z_stream, field for field, but the
// memory comes from `allocator`. `owner` is an identity the state is
// checked against at every call (0, or whatever the caller chooses: the
// C API gives its z_stream's address, so that a copied z_stream is
// refused as zlib refuses it).
pub const Stream = struct {
    // The next input byte's address and how many bytes are there.
    next_in: usize
    avail_in: u32
    total_in: u64
    // Where the next output byte goes and how much room is left.
    next_out: usize
    avail_out: u32
    total_out: u64
    // The address of the last error's message (NUL-terminated), or 0.
    msg: usize
    // The compressor's or decompressor's state (0 before it is set up).
    state: usize
    // Whether the data looks like text (the compressor's guess), or
    // where the decompressor stopped (inflate's bits).
    data_type: i32
    // The check value of the data so far (Adler-32 or CRC-32).
    adler: u64
    allocator: Allocator
    owner: usize
}

// The header of a gzip member (RFC 1952): zlib's gz_header, field for
// field, so that a C program's can be used as it is. Addresses of the
// caller's buffers: `extra` (extra_max bytes), `name` and `comment`
// (NUL-terminated, name_max and comm_max bytes when they are filled).
pub const Header = struct {
    text: i32
    time: u64
    xflags: i32
    os: i32
    extra: usize
    extra_len: u32
    extra_max: u32
    name: usize
    name_max: u32
    comment: usize
    comm_max: u32
    hcrc: i32
    done: i32
}

// What a call is to flush (zlib's Z_NO_FLUSH and the rest).
pub const NO_FLUSH: i32 = 0
pub const PARTIAL_FLUSH: i32 = 1
pub const SYNC_FLUSH: i32 = 2
pub const FULL_FLUSH: i32 = 3
pub const FINISH: i32 = 4
pub const BLOCK: i32 = 5
pub const TREES: i32 = 6

// The return codes (zlib's Z_OK and the rest).
pub const OK: i32 = 0
pub const STREAM_END: i32 = 1
pub const NEED_DICT: i32 = 2
pub const ERRNO: i32 = -1
pub const STREAM_ERROR: i32 = -2
pub const DATA_ERROR: i32 = -3
pub const MEM_ERROR: i32 = -4
pub const BUF_ERROR: i32 = -5
pub const VERSION_ERROR: i32 = -6

// The strategies.
pub const DEFAULT_STRATEGY: i32 = 0
pub const FILTERED: i32 = 1
pub const HUFFMAN_ONLY: i32 = 2
pub const RLE: i32 = 3
pub const FIXED: i32 = 4

// data_type.
pub const BINARY: i32 = 0
pub const TEXT: i32 = 1
pub const UNKNOWN: i32 = 2

// The one compression method.
pub const DEFLATED: i32 = 8

pub const MAX_WBITS: i32 = 15
pub const DEF_MEM_LEVEL: i32 = 8
// The operating system a gzip header names: Unix.
pub const OS_CODE: usize = 3

// The address of a literal's bytes (a NUL follows them).
pub fn literal(text: []const u8) -> usize { return @intFromPtr(text.pointer) }

// The message of a return code (the msg of a stream).
pub fn errorMessage(code: i32) -> usize {
    if code == NEED_DICT { return literal("need dictionary") }
    if code == STREAM_END { return literal("stream end") }
    if code == OK { return literal("") }
    if code == ERRNO { return literal("file error") }
    if code == STREAM_ERROR { return literal("stream error") }
    if code == DATA_ERROR { return literal("data error") }
    if code == MEM_ERROR { return literal("insufficient memory") }
    if code == BUF_ERROR { return literal("buffer error") }
    if code == VERSION_ERROR { return literal("incompatible version") }
    // (zlib indexes its table of messages with the code; outside it, as
    // here, the result is not a message.)
    return literal("")
}

pub inline fn header(address: usize) -> *Header { return unsafe { @ptrFromInt(*Header, address) } }
pub inline fn bytes(address: usize) -> [*]u8 { return unsafe { @ptrFromInt([*]u8, address) } }
pub inline fn shorts(address: usize) -> [*]u16 { return unsafe { @ptrFromInt([*]u16, address) } }

pub inline fn get8(address: usize) -> u8 { unsafe { return @ptrFromInt(*u8, address).* } }
pub inline fn put8(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*u8, address).* = @intCast(u8, value & 255) } }
pub inline fn get16(address: usize) -> u16 { unsafe { return @ptrFromInt(*u16, address).* } }
pub inline fn get32(address: usize) -> u32 { unsafe { return @ptrFromInt(*u32, address).* } }
pub inline fn get64(address: usize) -> u64 { unsafe { return @ptrFromInt(*u64, address).* } }
pub inline fn put32(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*u32, address).* = @intCast(u32, value & 0xffffffff) } }
pub inline fn putI32(address: usize, value: i32) -> void { unsafe { @ptrFromInt(*i32, address).* = value } }

pub fn copy(target: usize, source: usize, count: usize) -> void {
    if count != 0 { mem.copy(bytes(target), bytes(source), count) }
}

// A copy between places that may overlap.
pub fn move(target: usize, source: usize, count: usize) -> void {
    if count == 0 { return }
    if target <= source || target >= source + count {
        mem.copy(bytes(target), bytes(source), count)
    } else {
        mem.copyBackwards(bytes(target), bytes(source), count)
    }
}

pub fn zero(target: usize, count: usize) -> void {
    if count != 0 { mem.zero(bytes(target), count) }
}

// SIZE bytes of the stream's allocator, 16-byte aligned; 0 when there
// are none.
pub fn allocate(strm: *Stream, size: usize) -> usize {
    const memory = strm.*.allocator.alloc(size, 16)
    if memory == null { return 0 }
    return @intFromPtr(memory.?)
}

// Gives back what allocate gave (ADDRESS 0: nothing).
pub fn release(strm: *Stream, address: usize, size: usize) -> void {
    if address != 0 { strm.*.allocator.free(bytes(address), size, 16) }
}
