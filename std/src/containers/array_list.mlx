// std.ArrayList(T): a growing array of the standard library, generic over
// its element type, in an allocator's memory, freed by the language's
// drop when it goes out of scope (`@noncopy(struct)` with `deinit`).
//
//     var words = std.ArrayList([]const u8).init(std.heap.allocator())
//     _ = words.append("one")
//     for word in words.items() { ... }
//     // words.deinit() runs where `words` goes out of scope
//
// The elements lie in one block, `items()`, grown by half and a little
// more each time it fills (through the allocator's resize, in place
// where the allocator can). Out of memory is answered, not trapped:
// append, appendSlice, appendNTimes, insert, ensureTotalCapacity and
// resize say so (false).
const std = @import("std")

pub const Allocator = std.allocator.Allocator

pub fn ArrayList(comptime T: type) -> type {
    return @noncopy(struct) {
        pointer: [*]T
        length: usize
        capacity: usize
        allocator: Allocator

        pub fn init(allocator: Allocator) -> Self {
            var pointer: [*]T = undefined
            unsafe { pointer = @ptrFromInt([*]T, @alignOf(T)) }
            return Self.{ .pointer = pointer, .length = 0, .capacity = 0, .allocator = allocator }
        }

        // A list with room for `wanted` elements (none, without memory).
        pub fn initCapacity(allocator: Allocator, wanted: usize) -> Self {
            var list = Self.init(allocator)
            _ = list.ensureTotalCapacity(wanted)
            return list
        }

        // A list over a block the allocator gave (`slice` whole, as its
        // capacity and its length).
        pub fn fromOwnedSlice(allocator: Allocator, slice: []T) -> Self {
            return Self.{ .pointer = slice.pointer, .length = slice.length, .capacity = slice.length, .allocator = allocator }
        }

        pub fn deinit(self: *Self) -> void {
            self.*.clearAndFree()
        }

        // The elements, as a slice (valid until the list grows).
        pub fn items(self: *const Self) -> []T {
            return self.*.pointer[0..self.*.length]
        }

        pub fn count(self: *const Self) -> usize { return self.*.length }

        fn bytesOf(pointer: [*]T) -> [*]u8 {
            unsafe { return @ptrCast([*]u8, pointer) }
        }

        // Room for `wanted` elements in all; false without memory.
        pub fn ensureTotalCapacity(self: *Self, wanted: usize) -> bool {
            if wanted <= self.*.capacity { return true }
            var better = self.*.capacity
            while better < wanted { better = better + better / 2 + 8 }
            if self.*.capacity == 0 {
                const block = self.*.allocator.alloc(better * @sizeOf(T), @alignOf(T))
                if block == null { return false }
                unsafe { self.*.pointer = @ptrCast([*]T, block.?) }
            } else {
                const moved = self.*.allocator.resize(bytesOf(self.*.pointer), self.*.capacity * @sizeOf(T), better * @sizeOf(T), @alignOf(T))
                if moved == null { return false }
                unsafe { self.*.pointer = @ptrCast([*]T, moved.?) }
            }
            self.*.capacity = better
            return true
        }

        // Room for `more` elements beyond the length; false without memory.
        pub fn ensureUnusedCapacity(self: *Self, more: usize) -> bool {
            return self.*.ensureTotalCapacity(self.*.length + more)
        }

        pub fn append(self: *Self, value: T) -> bool {
            if !self.*.ensureUnusedCapacity(1) { return false }
            self.*.pointer[self.*.length] = value
            self.*.length += 1
            return true
        }

        pub fn appendSlice(self: *Self, values: []const T) -> bool {
            if !self.*.ensureUnusedCapacity(values.length) { return false }
            var at: usize = 0
            while at < values.length {
                self.*.pointer[self.*.length + at] = values[at]
                at += 1
            }
            self.*.length += values.length
            return true
        }

        // `value`, `times` over.
        pub fn appendNTimes(self: *Self, value: T, times: usize) -> bool {
            if !self.*.ensureUnusedCapacity(times) { return false }
            var at: usize = 0
            while at < times {
                self.*.pointer[self.*.length + at] = value
                at += 1
            }
            self.*.length += times
            return true
        }

        // `value` at `index` (at most the length), the rest moved up.
        pub fn insert(self: *Self, index: usize, value: T) -> bool {
            if index > self.*.length { return false }
            if !self.*.ensureUnusedCapacity(1) { return false }
            var at = self.*.length
            while at > index {
                self.*.pointer[at] = self.*.pointer[at - 1]
                at -= 1
            }
            self.*.pointer[index] = value
            self.*.length += 1
            return true
        }

        // The element at `index` taken out, the rest moved down.
        pub fn orderedRemove(self: *Self, index: usize) -> T {
            const value = self.*.pointer[index]
            var at = index
            while at + 1 < self.*.length {
                self.*.pointer[at] = self.*.pointer[at + 1]
                at += 1
            }
            self.*.length -= 1
            return value
        }

        // The element at `index` taken out, the last one put in its place.
        pub fn swapRemove(self: *Self, index: usize) -> T {
            const value = self.*.pointer[index]
            self.*.length -= 1
            if index < self.*.length { self.*.pointer[index] = self.*.pointer[self.*.length] }
            return value
        }

        // The last element taken out (null when there is none).
        pub fn pop(self: *Self) -> ?T {
            if self.*.length == 0 { return null }
            self.*.length -= 1
            return self.*.pointer[self.*.length]
        }

        // The last element, or null.
        pub fn last(self: *const Self) -> ?T {
            if self.*.length == 0 { return null }
            return self.*.pointer[self.*.length - 1]
        }

        // The length set to `new_length`: cut, or grown with elements
        // left undefined; false without memory.
        pub fn resize(self: *Self, new_length: usize) -> bool {
            if !self.*.ensureTotalCapacity(new_length) { return false }
            self.*.length = new_length
            return true
        }

        pub fn clearRetainingCapacity(self: *Self) -> void {
            self.*.length = 0
        }

        pub fn clearAndFree(self: *Self) -> void {
            if self.*.capacity > 0 {
                self.*.allocator.free(bytesOf(self.*.pointer), self.*.capacity * @sizeOf(T), @alignOf(T))
            }
            self.*.length = 0
            self.*.capacity = 0
        }

        // The elements as a block of exactly their size, the list's no
        // more (empty afterwards; the caller frees the slice with the
        // allocator, or makes a list of it again with fromOwnedSlice).
        pub fn toOwnedSlice(self: *Self) -> []T {
            if self.*.length == 0 {
                self.*.clearAndFree()
                return self.*.pointer[0..0]
            }
            if self.*.length < self.*.capacity {
                const shrunk = self.*.allocator.resize(bytesOf(self.*.pointer), self.*.capacity * @sizeOf(T), self.*.length * @sizeOf(T), @alignOf(T))
                if shrunk != null { unsafe { self.*.pointer = @ptrCast([*]T, shrunk.?) } }
            }
            const slice = self.*.pointer[0..self.*.length]
            self.*.length = 0
            self.*.capacity = 0
            return slice
        }
    }
}
