// SHA-crypt: the $5$ (SHA-256) and $6$ (SHA-512) hashes of /etc/shadow,
// as Ulrich Drepper specified them ("Unix crypt using SHA-256 and
// SHA-512", version 0.6) and glibc and libxcrypt write them. The rounds
// default to 5000 and a setting may ask for others ($6$rounds=N$SALT),
// between 1000 and 999999999. A setting that asks for another number is
// refused, as libxcrypt refuses it (the specification and glibc bring it
// into the range instead, but then write the number they used, so no
// stored hash holds one outside it).
//
// std.crypt calls this; it is the one that reads the setting's prefix.
const sha2 = @import("std.sha2")
const base64 = @import("std.crypt.base64")
const turns_module = @import("std.turns")

pub const ROUNDS_DEFAULT: u64 = 5000
pub const ROUNDS_LEAST: u64 = 1000
pub const ROUNDS_MOST: u64 = 999999999
// The salt is used up to this length, the password up to this one (as
// long as a passphrase gets; longer ones are refused rather than cut).
pub const SALT_MOST: usize = 16
pub const PASSWORD_MOST: usize = 512

// SHA-256 and SHA-512 as one digest: the caller keeps a state of each
// and `wide` says which of them is the one in use (an address inside a
// struct is not something Mlx hands out, so they travel as a pair).
fn digestSize(wide: bool) -> usize {
    return if wide { 64 } else { 32 }
}

fn digestInit(wide: bool, narrow: *sha2.Sha256, broad: *sha2.Sha512) -> void {
    if wide { sha2.sha512Init(broad) } else { sha2.sha256Init(narrow) }
}

fn digestAdd(wide: bool, narrow: *sha2.Sha256, broad: *sha2.Sha512, bytes: []const u8) -> void {
    if wide { sha2.sha512Update(broad, bytes) } else { sha2.sha256Update(narrow, bytes) }
}

// The digest into `into` (room for 64 bytes; 32 or 64 written).
fn digestFinish(wide: bool, narrow: *sha2.Sha256, broad: *sha2.Sha512, into: [*]u8) -> void {
    if wide {
        var bytes: [64]u8 = undefined
        sha2.sha512Final(broad, &bytes)
        var index: usize = 0
        while index < 64 {
            into[index] = bytes[index]
            bytes[index] = 0
            index += 1
        }
    } else {
        var bytes: [32]u8 = undefined
        sha2.sha256Final(narrow, &bytes)
        var index: usize = 0
        while index < 32 {
            into[index] = bytes[index]
            bytes[index] = 0
            index += 1
        }
    }
}

// `length` bytes into `into`, `source` (`size` bytes) repeated.
fn spread(into: [*]u8, length: usize, source: [*]const u8, size: usize) -> void {
    var index: usize = 0
    while index < length {
        into[index] = source[index % size]
        index += 1
    }
}

// The digest's bytes in the order the hash spells them out, three at a
// time; 255 stands for the byte zero the last group is short of. The
// character count of the last group is one less than three.
fn orderOf(wide: bool, group: usize, which: usize) -> u8 {
    var narrow: [33]u8 = [33]u8{
        0, 10, 20, 21, 1, 11, 12, 22, 2, 3, 13, 23, 24, 4, 14, 15, 25, 5,
        6, 16, 26, 27, 7, 17, 18, 28, 8, 9, 19, 29, 255, 31, 30 }
    var broad: [66]u8 = [66]u8{
        0, 21, 42, 22, 43, 1, 44, 2, 23, 3, 24, 45, 25, 46, 4, 47, 5, 26,
        6, 27, 48, 28, 49, 7, 50, 8, 29, 9, 30, 51, 31, 52, 10, 53, 11, 32,
        12, 33, 54, 34, 55, 13, 56, 14, 35, 15, 36, 57, 37, 58, 16, 59, 17, 38,
        18, 39, 60, 40, 61, 19, 62, 20, 41, 255, 255, 63 }
    if wide { return broad[group * 3 + which] }
    return narrow[group * 3 + which]
}

fn groupCount(wide: bool) -> usize {
    return if wide { 22 } else { 11 }
}

// How many characters the last group writes (the others write four).
fn lastGroupCharacters(wide: bool) -> usize {
    return if wide { 2 } else { 3 }
}

// The digest as the hash's characters at `at`, which moves on.
fn encode(out: [*]u8, capacity: usize, at: *usize, digest: [*]const u8, wide: bool) -> bool {
    const groups = groupCount(wide)
    var group: usize = 0
    while group < groups {
        var number: u32 = 0
        var which: usize = 0
        while which < 3 {
            const index = orderOf(wide, group, which)
            const byte: u32 = if index == 255 { 0 } else { @intCast(u32, digest[@intCast(usize, index)]) }
            number = (number << 8) | byte
            which += 1
        }
        var characters: usize = if group + 1 == groups { lastGroupCharacters(wide) } else { 4 }
        while characters > 0 {
            if at.* >= capacity { return false }
            out[at.*] = base64.ALPHABET[@intCast(usize, number & 63)]
            at.* += 1
            number = number >> 6
            characters -= 1
        }
        group += 1
    }
    return true
}

// The hash of `password` with `salt` in `rounds` rounds, into `digest`
// (64 bytes of room; 32 or 64 written). The steps are the
// specification's, numbered as there.
fn derive(password: []const u8, salt: []const u8, rounds: u64, wide: bool, digest: [*]u8) -> void {
    const size = digestSize(wide)
    // Digest A, and digest B next to it.
    var aNarrow: sha2.Sha256 = undefined
    var aBroad: sha2.Sha512 = undefined
    var bNarrow: sha2.Sha256 = undefined
    var bBroad: sha2.Sha512 = undefined
    // 1 to 3.
    digestInit(wide, &aNarrow, &aBroad)
    digestAdd(wide, &aNarrow, &aBroad, password)
    digestAdd(wide, &aNarrow, &aBroad, salt)
    // 4 to 8: digest B.
    digestInit(wide, &bNarrow, &bBroad)
    digestAdd(wide, &bNarrow, &bBroad, password)
    digestAdd(wide, &bNarrow, &bBroad, salt)
    digestAdd(wide, &bNarrow, &bBroad, password)
    var sum: [64]u8 = undefined
    var sumBytes: [*]u8 = undefined
    unsafe { sumBytes = @ptrCast([*]u8, &sum) }
    digestFinish(wide, &bNarrow, &bBroad, sumBytes)
    // 9 and 10: digest B, a digest's worth at a time, as long as the
    // password, into digest A. (The slices are made once and used again
    // every turn: one made inside a loop takes its own room.)
    const whole = sumBytes[0..size]
    var rest = password.length
    while rest > size {
        digestAdd(wide, &aNarrow, &aBroad, whole)
        rest -= size
    }
    digestAdd(wide, &aNarrow, &aBroad, sumBytes[0..rest])
    // 11: the password's length, bit by bit from the lowest.
    var bit = password.length
    while bit > 0 {
        if bit & 1 != 0 { digestAdd(wide, &aNarrow, &aBroad, whole) } else { digestAdd(wide, &aNarrow, &aBroad, password) }
        bit = bit >> 1
    }
    // 12.
    digestFinish(wide, &aNarrow, &aBroad, digest)
    // 13 to 16: the password's sequence P.
    digestInit(wide, &bNarrow, &bBroad)
    var count: usize = 0
    while count < password.length {
        digestAdd(wide, &bNarrow, &bBroad, password)
        count += 1
    }
    digestFinish(wide, &bNarrow, &bBroad, sumBytes)
    var passwordSpread: [PASSWORD_MOST]u8 = undefined
    var passwordBytes: [*]u8 = undefined
    unsafe { passwordBytes = @ptrCast([*]u8, &passwordSpread) }
    spread(passwordBytes, password.length, sumBytes, size)
    // 17 to 20: the salt's sequence S, from 16 + the first byte of A
    // rounds of the salt.
    digestInit(wide, &bNarrow, &bBroad)
    const times = 16 + @intCast(usize, digest[0])
    count = 0
    while count < times {
        digestAdd(wide, &bNarrow, &bBroad, salt)
        count += 1
    }
    digestFinish(wide, &bNarrow, &bBroad, sumBytes)
    var saltSpread: [SALT_MOST]u8 = undefined
    var saltBytes: [*]u8 = undefined
    unsafe { saltBytes = @ptrCast([*]u8, &saltSpread) }
    spread(saltBytes, salt.length, sumBytes, size)
    // 21: the rounds. Each turn gives back what it took from the value
    // arena (the digests' buffers): a hash asks for up to a billion
    // rounds, and the arena never shrinks on its own. Everything a turn
    // needs again is above, from before the loop.
    const passwordSequence = passwordBytes[0..password.length]
    const saltSequence = saltBytes[0..salt.length]
    const carried = digest[0..size]
    var turns: turns_module.Turns = undefined
    turns_module.begin(&turns, true, false)
    var round: u64 = 0
    while round < rounds {
        turns_module.turn(&turns)
        digestInit(wide, &aNarrow, &aBroad)
        if round & 1 != 0 { digestAdd(wide, &aNarrow, &aBroad, passwordSequence) } else { digestAdd(wide, &aNarrow, &aBroad, carried) }
        if round % 3 != 0 { digestAdd(wide, &aNarrow, &aBroad, saltSequence) }
        if round % 7 != 0 { digestAdd(wide, &aNarrow, &aBroad, passwordSequence) }
        if round & 1 != 0 { digestAdd(wide, &aNarrow, &aBroad, carried) } else { digestAdd(wide, &aNarrow, &aBroad, passwordSequence) }
        digestFinish(wide, &aNarrow, &aBroad, digest)
        round += 1
    }
    sha2.wipe(sumBytes, 64)
    sha2.wipe(passwordBytes, password.length)
    sha2.wipe(saltBytes, salt.length)
}

// The hash of `password` under `setting` ("$6$SALT" or
// "$6$rounds=N$SALT", a whole stored hash as well) into `out`: its
// length, or 0 when the setting is not one of these or does not fit.
// `wide` picks SHA-512 ($6$) over SHA-256 ($5$).
pub fn hash(password: []const u8, setting: []const u8, wide: bool, out: [*]u8, capacity: usize) -> usize {
    if password.length > PASSWORD_MOST { return 0 }
    if setting.length < 3 { return 0 }
    var rest = setting[3..setting.length]
    var rounds = ROUNDS_DEFAULT
    var custom = false
    if rest.length > 7 && rest[0] == 114 && rest[1] == 111 && rest[2] == 117 && rest[3] == 110 && rest[4] == 100 && rest[5] == 115 && rest[6] == 61 {
        var at: usize = 7
        var asked: u64 = 0
        while at < rest.length && rest[at] >= 48 && rest[at] <= 57 {
            if asked > ROUNDS_MOST { return 0 }
            asked = asked * 10 + @intCast(u64, rest[at] - 48)
            at += 1
        }
        if at <= 7 || at >= rest.length || rest[at] != 36 { return 0 }
        if asked < ROUNDS_LEAST || asked > ROUNDS_MOST { return 0 }
        rounds = asked
        custom = true
        rest = rest[at + 1 .. rest.length]
    }
    // The salt: up to the next '$', up to 16 characters.
    var saltLength: usize = 0
    while saltLength < rest.length && rest[saltLength] != 36 && saltLength < SALT_MOST {
        saltLength += 1
    }
    const salt = rest[0..saltLength]
    var digest: [64]u8 = undefined
    var digestBytes: [*]u8 = undefined
    unsafe { digestBytes = @ptrCast([*]u8, &digest) }
    derive(password, salt, rounds, wide, digestBytes)
    var at: usize = 0
    var written = true
    if at + 3 <= capacity {
        out[0] = 36
        out[1] = if wide { 54 } else { 53 }
        out[2] = 36
        at = 3
    } else {
        written = false
    }
    if written && custom {
        written = putRounds(out, capacity, &at, rounds)
    }
    var index: usize = 0
    while written && index < salt.length {
        if at >= capacity { written = false } else {
            out[at] = salt[index]
            at += 1
            index += 1
        }
    }
    if written {
        if at >= capacity { written = false } else {
            out[at] = 36
            at += 1
        }
    }
    if written { written = encode(out, capacity, &at, digestBytes, wide) }
    sha2.wipe(digestBytes, 64)
    if !written {
        sha2.wipe(out, capacity)
        return 0
    }
    return at
}

// "rounds=N$" at `at`, which moves on.
fn putRounds(out: [*]u8, capacity: usize, at: *usize, rounds: u64) -> bool {
    const text = "rounds="
    var index: usize = 0
    while index < text.length {
        if at.* >= capacity { return false }
        out[at.*] = text[index]
        at.* += 1
        index += 1
    }
    var digits: [12]u8 = undefined
    var count: usize = 0
    var value = rounds
    while true {
        digits[count] = @intCast(u8, 48 + value % 10)
        count += 1
        value = value / 10
        if value == 0 { break }
    }
    while count > 0 {
        count -= 1
        if at.* >= capacity { return false }
        out[at.*] = digits[count]
        at.* += 1
    }
    if at.* >= capacity { return false }
    out[at.*] = 36
    at.* += 1
    return true
}
