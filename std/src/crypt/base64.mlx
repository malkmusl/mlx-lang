// The base-64 alphabet of crypt(3) hashes ("./0-9A-Za-z", not RFC 4648's)
// and yescrypt's packing of it: 6-bit groups from the low end, and the
// variable-length numbers its settings are made of ($y$j9T: the flavor,
// log2 N and r). std.crypt.shacrypt packs the same alphabet its own way.
pub const ALPHABET: []const u8 = "./0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

// The value of a character, 64 when it is not one of the alphabet's.
pub fn value(byte: u8) -> u32 {
    if byte == 46 { return 0 }
    if byte == 47 { return 1 }
    if byte >= 48 && byte <= 57 { return @intCast(u32, byte - 48) + 2 }
    if byte >= 65 && byte <= 90 { return @intCast(u32, byte - 65) + 12 }
    if byte >= 97 && byte <= 122 { return @intCast(u32, byte - 97) + 38 }
    return 64
}

// `bits` worth of `number` as 6-bit characters at `at`, which moves on.
// False when the number does not fit in those bits.
pub fn encodeFixed(out: [*]u8, capacity: usize, at: *usize, number: u32, bits: usize) -> bool {
    var rest = number
    var written: usize = 0
    while written < bits {
        if at.* >= capacity { return false }
        out[at.*] = ALPHABET[@intCast(usize, rest & 63)]
        at.* += 1
        rest = rest >> 6
        written += 6
    }
    return rest == 0
}

// `length` bytes as characters (three bytes to four characters, the last
// group short), at `at`, which moves on.
pub fn encode(out: [*]u8, capacity: usize, at: *usize, bytes: [*]const u8, length: usize) -> bool {
    var index: usize = 0
    while index < length {
        var number: u32 = 0
        var bits: usize = 0
        while bits < 24 && index < length {
            number = number | (@intCast(u32, bytes[index]) << @intCast(u5, bits))
            index += 1
            bits += 8
        }
        if !encodeFixed(out, capacity, at, number, bits) { return false }
    }
    return true
}

// The bytes of `text` into `into` (at most `capacity`): how many, 0 when
// the text is not this encoding or does not fit.
pub fn decode(into: [*]u8, capacity: usize, text: []const u8) -> usize {
    var written: usize = 0
    var index: usize = 0
    while index < text.length {
        var number: u32 = 0
        var bits: usize = 0
        while index < text.length && bits < 24 {
            const got = value(text[index])
            if got > 63 { return 0 }
            index += 1
            number = number | (got << @intCast(u5, bits))
            bits += 6
        }
        // A group is at least two characters: one whole byte.
        if bits < 12 { return 0 }
        while bits >= 8 {
            if written >= capacity { return 0 }
            into[written] = @intCast(u8, number & 255)
            written += 1
            number = number >> 8
            bits -= 8
        }
        // What the last, short group leaves over has to be zero.
        if number != 0 { return 0 }
    }
    return written
}

// A variable-length number at `at` (which moves on), `least` its
// smallest value: whether it was one, and the number. yescrypt spends
// one character on small numbers and more on larger ones.
pub fn decodeNumber(text: []const u8, at: *usize, least: u32) -> (bool, u32) {
    if at.* >= text.length { return (false, 0) }
    var start: u32 = 0
    var end: u32 = 47
    var characters: usize = 1
    var bits: u5 = 0
    var got = value(text[at.*])
    at.* += 1
    if got > 63 { return (false, 0) }
    var number = least
    while got > end {
        number += (end + 1 - start) << bits
        start = end + 1
        end = start + (62 - end) / 2
        characters += 1
        bits += 6
    }
    number += (got - start) << bits
    while characters > 1 {
        characters -= 1
        if at.* >= text.length { return (false, 0) }
        got = value(text[at.*])
        at.* += 1
        if got > 63 { return (false, 0) }
        bits -= 6
        number += got << bits
    }
    return (true, number)
}
