// The platform a program is built for: Android (see platform.linux.mlx).
pub const NAME = "android"
pub const ANDROID = true
// The shell for `sh -c` commands (the system's, mksh with toybox).
pub const SHELL = "/system/bin/sh"
// The users and groups (passwd's and group's format).
pub const USERS = "/etc/passwd"
pub const GROUPS = "/etc/group"
// The name servers (resolv.conf's format) and the hosts file.
pub const RESOLV_CONF = "/etc/resolv.conf"
pub const HOSTS = "/etc/hosts"
// Where programs are when the environment has no PATH.
pub const PROGRAMS = "/usr/local/bin:/usr/bin:/bin"
