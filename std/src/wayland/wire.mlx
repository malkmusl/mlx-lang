// std.wayland.wire: the Wayland wire protocol.
//
// A message is a two-word header — the object id, then (size << 16) | opcode —
// followed by 32-bit aligned arguments in native (little-endian) byte order:
//
//   int, uint, fixed, object, new_id   one 32-bit word
//   string                             u32 length including the trailing NUL,
//                                      bytes, NUL, zero padding to 4 bytes;
//                                      length 0 encodes a null string
//   array                              u32 byte length, bytes, zero padding
//   fd                                 nothing in the payload; the handle
//                                      travels out of band, in message order
//
// Message signatures use the established libwayland metadata encoding: an
// optional since-version prefix, then one character per argument
// (i u f s o n a h), each optionally preceded by '?' for allow-null. A
// generic new_id (no interface) expands to "sun": interface name, version,
// new id.

const string = @import("../../bootstrap/string.mlx")

pub const String = string.String

pub const HEADER_SIZE: usize = 8
pub const MAX_MESSAGE_SIZE: usize = 4096
pub const MAX_HANDLES: usize = 28
pub const SERVER_ID_START: u32 = 4278190080
pub const MAX_CLIENT_ID: u32 = 4278190079

// Two's-complement reinterpretation between wire words and i32. Written
// arithmetically because the bootstrap backends do not yet sign-extend the
// result of @bitCast(i32, u32).
pub fn signedFromWord(word: u32) -> i32 {
    if word < 2147483648 { return @intCast(i32, word) }
    const magnitude = @intCast(i64, 4294967296 - @intCast(u64, word))
    const wide: i64 = 0 - magnitude
    return @intCast(i32, wide)
}

pub fn wordFromSigned(value: i32) -> u32 {
    if value >= 0 { return @intCast(u32, value) }
    const wide: i64 = @intCast(i64, value)
    return @intCast(u32, 4294967296 + wide)
}

// Signed 24.8 fixed-point number.
pub const Fixed = struct {
    raw: i32

    pub fn fromRaw(raw: i32) -> Self { return Self.{ .raw = raw } }
    pub fn fromInt(value: i32) -> Self { return Self.{ .raw = value * 256 } }
    // Truncates toward zero, like wl_fixed_to_int.
    pub fn toInt(self: Self) -> i32 { return self.raw / 256 }
}

// Raw byte payload of an `array` argument.
pub const ArrayView = struct {
    pointer: [*]const u8
    length: usize

    pub fn fromSlice(bytes: []const u8) -> Self {
        var length: usize = 0
        for byte in bytes { length += 1 }
        unsafe { return Self.{ .pointer = @ptrCast([*]const u8, bytes), .length = length } }
    }

    pub fn asSlice(self: Self) -> []const u8 { return self.pointer[0..self.length] }
}

pub fn padded(length: usize) -> usize {
    return ((length + 3) / 4) * 4
}

pub fn store32(bytes: [*]u8, offset: usize, value: u32) -> void {
    bytes[offset] = @intCast(u8, value & 255)
    bytes[offset + 1] = @intCast(u8, (value >> 8) & 255)
    bytes[offset + 2] = @intCast(u8, (value >> 16) & 255)
    bytes[offset + 3] = @intCast(u8, (value >> 24) & 255)
}

pub fn load32(bytes: [*]const u8, offset: usize) -> u32 {
    return @intCast(u32, bytes[offset]) | (@intCast(u32, bytes[offset + 1]) << 8) | (@intCast(u32, bytes[offset + 2]) << 16) | (@intCast(u32, bytes[offset + 3]) << 24)
}

// Header accessors for a complete message starting at `bytes`.
pub fn headerObject(bytes: [*]const u8) -> u32 { return load32(bytes, 0) }
pub fn headerOpcode(bytes: [*]const u8) -> u16 { return @intCast(u16, load32(bytes, 4) & 65535) }
pub fn headerSize(bytes: [*]const u8) -> usize { return @intCast(usize, load32(bytes, 4) >> 16) }

// ---------------------------------------------------------------------------
// Encoding

// Builds one message in fixed storage. Handles are collected in argument
// order and must be queued with the message bytes.
pub const Writer = struct {
    bytes: [4096]u8
    length: usize
    handles: [28]isize
    handleCount: usize
    overflow: bool
}

pub fn begin(writer: *Writer, object: u32, opcode: u16) -> void {
    writer.*.length = HEADER_SIZE
    writer.*.handleCount = 0
    writer.*.overflow = false
    store32Writer(writer, 0, object)
    store32Writer(writer, 4, @intCast(u32, opcode))
}

fn store32Writer(writer: *Writer, offset: usize, value: u32) -> void {
    writer.*.bytes[offset] = @intCast(u8, value & 255)
    writer.*.bytes[offset + 1] = @intCast(u8, (value >> 8) & 255)
    writer.*.bytes[offset + 2] = @intCast(u8, (value >> 16) & 255)
    writer.*.bytes[offset + 3] = @intCast(u8, (value >> 24) & 255)
}

fn reserve(writer: *Writer, amount: usize) -> bool {
    if writer.*.overflow { return false }
    if writer.*.length + amount > MAX_MESSAGE_SIZE {
        writer.*.overflow = true
        return false
    }
    return true
}

pub fn putUint(writer: *Writer, value: u32) -> void {
    if !reserve(writer, 4) { return }
    store32Writer(writer, writer.*.length, value)
    writer.*.length += 4
}

pub fn putInt(writer: *Writer, value: i32) -> void {
    putUint(writer, wordFromSigned(value))
}

pub fn putFixed(writer: *Writer, value: Fixed) -> void {
    putUint(writer, wordFromSigned(value.raw))
}

pub fn putObject(writer: *Writer, id: u32) -> void {
    putUint(writer, id)
}

pub fn putNewId(writer: *Writer, id: u32) -> void {
    putUint(writer, id)
}

fn putBytes(writer: *Writer, pointer: [*]const u8, length: usize, terminate: bool) -> void {
    const body = if terminate { length + 1 } else { length }
    if !reserve(writer, 4 + padded(body)) { return }
    store32Writer(writer, writer.*.length, @intCast(u32, body))
    writer.*.length += 4
    var index: usize = 0
    while index < length {
        writer.*.bytes[writer.*.length + index] = pointer[index]
        index += 1
    }
    while index < padded(body) {
        writer.*.bytes[writer.*.length + index] = 0
        index += 1
    }
    writer.*.length += padded(body)
}

pub fn putString(writer: *Writer, value: ?[]const u8) -> void {
    if value == null {
        putUint(writer, 0)
        return
    }
    putStringSlice(writer, value.?)
}

// Iterating an unwrapped optional slice directly miscounts under the
// bootstrap backends, so the length is taken from a plain slice parameter.
pub fn putStringSlice(writer: *Writer, value: []const u8) -> void {
    var length: usize = 0
    for byte in value { length += 1 }
    unsafe { putBytes(writer, @ptrCast([*]const u8, value), length, true) }
}

pub fn putStringParts(writer: *Writer, pointer: [*]const u8, length: usize) -> void {
    putBytes(writer, pointer, length, true)
}

pub fn putArray(writer: *Writer, value: ArrayView) -> void {
    putBytes(writer, value.pointer, value.length, false)
}

pub fn putHandle(writer: *Writer, descriptor: isize) -> void {
    if writer.*.handleCount >= MAX_HANDLES {
        writer.*.overflow = true
        return
    }
    writer.*.handles[writer.*.handleCount] = descriptor
    writer.*.handleCount += 1
}

// Patches the size into the header. Returns false when an argument did not
// fit into one Wayland message.
pub fn finish(writer: *Writer) -> bool {
    if writer.*.overflow { return false }
    const word = load32Writer(writer, 4) & 65535
    store32Writer(writer, 4, word | (@intCast(u32, writer.*.length) << 16))
    return true
}

fn load32Writer(writer: *Writer, offset: usize) -> u32 {
    return @intCast(u32, writer.*.bytes[offset]) | (@intCast(u32, writer.*.bytes[offset + 1]) << 8) | (@intCast(u32, writer.*.bytes[offset + 2]) << 16) | (@intCast(u32, writer.*.bytes[offset + 3]) << 24)
}

// Copies the finished message into `destination` (at least `length` bytes).
pub fn copyBytes(writer: *const Writer, destination: [*]u8) -> void {
    var index: usize = 0
    while index < writer.*.length {
        destination[index] = writer.*.bytes[index]
        index += 1
    }
}

pub fn handleAt(writer: *const Writer, index: usize) -> isize {
    return writer.*.handles[index]
}

// ---------------------------------------------------------------------------
// Decoding

// Reads the arguments of one received message. A failed read sets `failed`
// and returns a zero value; callers check `failed` once at the end.
pub const Reader = struct {
    bytes: [*]const u8
    length: usize
    position: usize
    handles: [*]const isize
    handleCount: usize
    handleIndex: usize
    failed: bool
}

pub fn initReader(reader: *Reader, bytes: [*]const u8, length: usize, handles: [*]const isize, handle_count: usize) -> void {
    reader.*.bytes = bytes
    reader.*.length = length
    reader.*.position = 0
    reader.*.handles = handles
    reader.*.handleCount = handle_count
    reader.*.handleIndex = 0
    reader.*.failed = false
}

pub fn getUint(reader: *Reader) -> u32 {
    if reader.*.position + 4 > reader.*.length {
        reader.*.failed = true
        return 0
    }
    const value = load32(reader.*.bytes, reader.*.position)
    reader.*.position += 4
    return value
}

pub fn getInt(reader: *Reader) -> i32 { return signedFromWord(getUint(reader)) }
pub fn getFixed(reader: *Reader) -> Fixed { return Fixed.fromRaw(signedFromWord(getUint(reader))) }
pub fn getObject(reader: *Reader) -> u32 { return getUint(reader) }
pub fn getNewId(reader: *Reader) -> u32 { return getUint(reader) }

// Decoded strings borrow the receive buffer and exclude the trailing NUL. A
// null string (wire length 0) is returned with a zero pointer and length;
// test it with `isNull`. (Optional slices built from received bytes are not
// yet lowered correctly by the bootstrap backends, so decoded strings use
// std.string.String.)
pub fn getString(reader: *Reader) -> String {
    const length = @intCast(usize, getUint(reader))
    if reader.*.failed || length == 0 { return nullString() }
    if reader.*.position + padded(length) > reader.*.length || reader.*.bytes[reader.*.position + length - 1] != 0 {
        reader.*.failed = true
        return nullString()
    }
    const start = reader.*.position
    reader.*.position += padded(length)
    unsafe { return string.fromParts(@ptrFromInt([*]const u8, @intFromPtr(reader.*.bytes) + start), length - 1) }
}

pub fn nullString() -> String {
    unsafe { return string.fromParts(@ptrFromInt([*]const u8, 0), 0) }
}

pub fn isNull(value: String) -> bool {
    return @intFromPtr(value.pointer) == 0
}

pub fn getArray(reader: *Reader) -> ArrayView {
    const length = @intCast(usize, getUint(reader))
    if reader.*.failed || reader.*.position + padded(length) > reader.*.length {
        reader.*.failed = true
        return ArrayView.{ .pointer = reader.*.bytes, .length = 0 }
    }
    const start = reader.*.position
    reader.*.position += padded(length)
    unsafe { return ArrayView.{ .pointer = @ptrFromInt([*]const u8, @intFromPtr(reader.*.bytes) + start), .length = length } }
}

pub fn getHandle(reader: *Reader) -> isize {
    if reader.*.handleIndex >= reader.*.handleCount {
        reader.*.failed = true
        return -1
    }
    const value = reader.*.handles[reader.*.handleIndex]
    reader.*.handleIndex += 1
    return value
}

pub fn readerFailed(reader: *const Reader) -> bool { return reader.*.failed }

// ---------------------------------------------------------------------------
// Signature metadata

fn signatureLength(signature: []const u8) -> usize {
    var length: usize = 0
    for byte in signature { length += 1 }
    return length
}

// The since-version prefix of a signature (1 when absent).
pub fn signatureSince(signature: []const u8) -> u32 {
    var value: u32 = 0
    for byte in signature {
        if byte < 48 || byte > 57 { break }
        value = value * 10 + @intCast(u32, byte - 48)
    }
    return if value == 0 { 1 } else { value }
}

// Number of arguments (argument type characters) in a signature.
pub fn signatureArgCount(signature: []const u8) -> usize {
    var count: usize = 0
    for byte in signature {
        if byte >= 97 && byte <= 122 { count += 1 }
    }
    return count
}

// Type character of argument `index`, or 0.
pub fn signatureArgType(signature: []const u8, index: usize) -> u8 {
    var count: usize = 0
    for byte in signature {
        if byte >= 97 && byte <= 122 {
            if count == index { return byte }
            count += 1
        }
    }
    return 0
}

// Whether argument `index` is marked '?' (allow-null).
pub fn signatureArgNullable(signature: []const u8, index: usize) -> bool {
    var count: usize = 0
    var nullable = false
    for byte in signature {
        if byte == 63 {
            nullable = true
        } else if byte >= 97 && byte <= 122 {
            if count == index { return nullable }
            count += 1
            nullable = false
        }
    }
    return false
}

// Number of out-of-band handles ('h' arguments) a message carries.
pub fn signatureHandleCount(signature: []const u8) -> usize {
    var count: usize = 0
    for byte in signature {
        if byte == 104 { count += 1 }
    }
    return count
}

// Checks that `payload` (the bytes after the header) is exactly a valid
// encoding of `signature` with `handle_count` handles available, and that
// non-nullable strings and objects are non-null. Typed decoders only run on
// messages that pass this check.
pub fn validate(signature: []const u8, payload: [*]const u8, length: usize, handle_count: usize) -> bool {
    var position: usize = 0
    var handles: usize = 0
    var nullable = false
    for byte in signature {
        if byte == 63 {
            nullable = true
        } else if byte == 105 || byte == 117 || byte == 102 {
            if position + 4 > length { return false }
            position += 4
            nullable = false
        } else if byte == 111 || byte == 110 {
            if position + 4 > length { return false }
            if load32(payload, position) == 0 && !nullable { return false }
            position += 4
            nullable = false
        } else if byte == 115 || byte == 97 {
            if position + 4 > length { return false }
            const size = @intCast(usize, load32(payload, position))
            position += 4
            if size > length || position + padded(size) > length { return false }
            if byte == 115 {
                if size == 0 && !nullable { return false }
                if size > 0 && payload[position + size - 1] != 0 { return false }
            }
            position += padded(size)
            nullable = false
        } else if byte == 104 {
            handles += 1
            nullable = false
        }
    }
    return position == length && handles <= handle_count
}
