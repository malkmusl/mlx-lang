// std.wayland.crash: a Wayland client's connection failing is kept like a
// crash (std.crash.fail), with the request or event that did it.
//
//     crash.install()
//     const display = wl.client.Display.connect(...)
//     wayland_crash.watch(display)
const std = @import("std")
const wl = @import("std.wayland")
const crash = @import("std.crash")

// Every Wayland client calls this on its connection right after
// connecting (tools/check_crash_report.sh holds every program to it): when
// the connection fails, because the compositor ended it over a protocol
// error or this program made a request on an object that is gone, the
// failure is said and kept like a crash (std.crash.fail), with the request or event
// that did it still on the stack, instead of the program just ending.
// The compositor going away is no failure of this program's.
pub fn watch(display: wl.client.Display) -> void {
    var context: *anyopaque = undefined
    unsafe { context = @ptrCast(*anyopaque, display.state) }
    display.setFailureHandler(connectionFailed, context)
}

fn connectionFailed(context: *anyopaque) -> void {
    var display: wl.client.Display = undefined
    unsafe { display = wl.client.Display.{ .state = @ptrCast(*wl.client.State, context) } }
    if display.disconnected() { return }
    var text: [900]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length: usize = 0
    const object = display.errorObjectId()
    const message = display.errorMessage()
    if message.length > 0 || object != 0 {
        length = std.text.append(bytes, 0, 880, "the compositor ended the connection: protocol error ")
        length = std.text.appendUnsigned(bytes, length, 880, @intCast(usize, display.errorCode()))
        length = std.text.append(bytes, length, 880, " on ")
        length = std.text.append(bytes, length, 880, display.interfaceNameOf(object))
        length = std.text.append(bytes, length, 880, " ")
        length = std.text.appendUnsigned(bytes, length, 880, @intCast(usize, object))
        length = std.text.append(bytes, length, 880, ": ")
        length = std.text.append(bytes, length, 880, message.pointer[0..message.length])
    } else {
        length = std.text.append(bytes, 0, 880, display.failureReason())
        if display.refusedObjectId() != 0 {
            length = std.text.append(bytes, length, 880, " (request ")
            length = std.text.appendUnsigned(bytes, length, 880, @intCast(usize, display.refusedOpcode()))
            length = std.text.append(bytes, length, 880, " of ")
            length = std.text.append(bytes, length, 880, display.refusedInterface())
            length = std.text.append(bytes, length, 880, " ")
            length = std.text.appendUnsigned(bytes, length, 880, @intCast(usize, display.refusedObjectId()))
            length = std.text.append(bytes, length, 880, ")")
        }
    }
    crash.fail(bytes[0..length])
}
