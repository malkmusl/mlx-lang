    pub fn sendWarp(self: Self, surface_x: wire.Fixed, surface_y: wire.Fixed) -> void {
        var message: wire.Writer = undefined
        if !server.beginEvent(self.object, 11, 11, &message) { return }
        wire.putFixed(&message, surface_x)
        wire.putFixed(&message, surface_y)
        server.endEvent(self.object, &message, false)
    }

}

