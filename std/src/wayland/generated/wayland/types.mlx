// wl_data_device resource (server side): one method per event.
pub const wl_data_device_Resource = struct {
    object: server.Object

    pub fn fromObject(object: server.Object) -> Self { return Self.{ .object = object } }
    pub fn id(self: Self) -> u32 { return self.object.id }
    pub fn version(self: Self) -> u32 { return server.objectVersion(self.object) }
    pub fn isNull(self: Self) -> bool { return self.object.id == 0 }
    pub fn client(self: Self) -> server.Client { return self.object.client }
    pub fn setHandler(self: Self, handler: server.RequestHandler, context: *anyopaque) -> void { server.setHandler(self.object, handler, context) }
    pub fn setDestroyHandler(self: Self, handler: server.DestroyHandler, context: *anyopaque) -> void { server.setDestroyHandler(self.object, handler, context) }
    pub fn postError(self: Self, code: u32, message: []const u8) -> void { server.postError(self.object, code, message) }
    pub fn destroy(self: Self) -> void { server.destroyObject(self.object) }

    pub fn sendDataOffer(self: Self) -> wl_data_offer_Resource {
        var message: wire.Writer = undefined
        if !server.beginEvent(self.object, 0, 1, &message) { return wl_data_offer_Resource.fromObject(server.nullObject(self.object)) }
        const created = server.createObject(self.object, Interface.wl_data_offer, server.objectVersion(self.object))
        wire.putNewId(&message, created.id)
        server.endEvent(self.object, &message, false)
        return wl_data_offer_Resource.fromObject(created)
    }

    pub fn sendEnter(self: Self, serial: u32, surface: wl_surface_Resource, x: wire.Fixed, y: wire.Fixed, id: ?*const wl_data_offer_Resource) -> void {
        var message: wire.Writer = undefined
        if !server.beginEvent(self.object, 1, 1, &message) { return }
        wire.putUint(&message, serial)
        server.putObject(self.object, &message, surface.object)
        wire.putFixed(&message, x)
        wire.putFixed(&message, y)
        var nullable_4: u32 = 0
        if id != null { nullable_4 = id.?.*.object.id }
        wire.putObject(&message, nullable_4)
        server.endEvent(self.object, &message, false)
    }

    pub fn sendLeave(self: Self) -> void {
        var message: wire.Writer = undefined
        if !server.beginEvent(self.object, 2, 1, &message) { return }
        server.endEvent(self.object, &message, false)
    }

    pub fn sendMotion(self: Self, time: u32, x: wire.Fixed, y: wire.Fixed) -> void {
        var message: wire.Writer = undefined
        if !server.beginEvent(self.object, 3, 1, &message) { return }
        wire.putUint(&message, time)
        wire.putFixed(&message, x)
        wire.putFixed(&message, y)
        server.endEvent(self.object, &message, false)
    }

    pub fn sendDrop(self: Self) -> void {
        var message: wire.Writer = undefined
        if !server.beginEvent(self.object, 4, 1, &message) { return }
        server.endEvent(self.object, &message, false)
    }

    pub fn sendSelection(self: Self, id: ?*const wl_data_offer_Resource) -> void {
        var message: wire.Writer = undefined
        if !server.beginEvent(self.object, 5, 1, &message) { return }
        var nullable_0: u32 = 0
        if id != null { nullable_0 = id.?.*.object.id }
        wire.putObject(&message, nullable_0)
        server.endEvent(self.object, &message, false)
    }

}

