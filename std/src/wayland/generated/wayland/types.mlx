    pub fn setDestroyHandler(self: Self, handler: server.DestroyHandler, context: *anyopaque) -> void { server.setDestroyHandler(self.object, handler, context) }
    pub fn postError(self: Self, code: u32, message: []const u8) -> void { server.postError(self.object, code, message) }
    pub fn destroy(self: Self) -> void { server.destroyObject(self.object) }

    pub fn sendKeymap(self: Self, format: u32, fd: server.Handle, size: u32) -> void {
        var message: wire.Writer = undefined
        if !server.beginEvent(self.object, 0, 1, &message) { return }
        wire.putUint(&message, format)
        server.putHandle(self.object, &message, fd)
        wire.putUint(&message, size)
        server.endEvent(self.object, &message, false)
    }

    pub fn sendEnter(self: Self, serial: u32, surface: wl_surface_Resource, keys: wire.ArrayView) -> void {
        var message: wire.Writer = undefined
        if !server.beginEvent(self.object, 1, 1, &message) { return }
        wire.putUint(&message, serial)
        server.putObject(self.object, &message, surface.object)
        wire.putArray(&message, keys)
        server.endEvent(self.object, &message, false)
    }

    pub fn sendLeave(self: Self, serial: u32, surface: wl_surface_Resource) -> void {
        var message: wire.Writer = undefined
        if !server.beginEvent(self.object, 2, 1, &message) { return }
        wire.putUint(&message, serial)
        server.putObject(self.object, &message, surface.object)
        server.endEvent(self.object, &message, false)
    }

    pub fn sendKey(self: Self, serial: u32, time: u32, key: u32, state: u32) -> void {
        var message: wire.Writer = undefined
        if !server.beginEvent(self.object, 3, 1, &message) { return }
        wire.putUint(&message, serial)
        wire.putUint(&message, time)
        wire.putUint(&message, key)
        wire.putUint(&message, state)
        server.endEvent(self.object, &message, false)
    }

    pub fn sendModifiers(self: Self, serial: u32, mods_depressed: u32, mods_latched: u32, mods_locked: u32, group: u32) -> void {
        var message: wire.Writer = undefined
        if !server.beginEvent(self.object, 4, 1, &message) { return }
        wire.putUint(&message, serial)
        wire.putUint(&message, mods_depressed)
        wire.putUint(&message, mods_latched)
        wire.putUint(&message, mods_locked)
        wire.putUint(&message, group)
        server.endEvent(self.object, &message, false)
    }

    pub fn sendRepeatInfo(self: Self, rate: i32, delay: i32) -> void {
        var message: wire.Writer = undefined
        if !server.beginEvent(self.object, 5, 4, &message) { return }
        wire.putInt(&message, rate)
        wire.putInt(&message, delay)
        server.endEvent(self.object, &message, false)
