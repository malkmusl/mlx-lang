    if opcode == 11 { return "set_fullscreen" }
    if opcode == 12 { return "unset_fullscreen" }
    if opcode == 13 { return "set_minimized" }
    return ""
}

fn xdg_toplevel_eventName(opcode: u16) -> []const u8 {
    if opcode == 0 { return "configure" }
    if opcode == 1 { return "close" }
    if opcode == 2 { return "configure_bounds" }
    if opcode == 3 { return "wm_capabilities" }
    return ""
}

