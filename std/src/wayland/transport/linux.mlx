// std.wayland transport: native Linux backend (std.linux, no libc).
//
// Implements spec/06-wayland/transport.xml on Linux x86_64:
//
// - Handle: an owned file descriptor.
// - Byte stream: AF_UNIX SOCK_STREAM sockets. Ancillary descriptors travel
//   with SCM_RIGHTS; received descriptors are queued in arrival order and
//   consumed by messages in order, which keeps them associated with their
//   arguments across partial reads and writes.
// - Buffering: every connection buffer is allocated from the caller's
//   explicit allocator and released by `deinit`.
// - Waiting: poll(2) for single connections and epoll(7) event loops that
//   watch any number of connections and listeners (std.linux.event's).
// - Shared memory: memfd_create(2) objects mapped with mmap(2) MAP_SHARED.
//
// The kernel's records (msghdr, cmsghdr, sockaddr_un, epoll_event, pollfd)
// are std.linux's to assemble.

const std = @import("std")
const allocator_module = @import("../../../bootstrap/allocator.mlx")
const string = @import("../../../bootstrap/string.mlx")
const mem = @import("../../../bootstrap/mem.mlx")
const wire = @import("../wire.mlx")

const linux = std.linux
const socket = std.linux.socket
const event = std.linux.event

pub const Allocator = allocator_module.Allocator
pub const String = string.String

pub const EAGAIN: isize = -11

pub const INPUT_CAPACITY: usize = 65536
pub const OUTPUT_CAPACITY: usize = 65536
pub const HANDLE_CAPACITY: usize = 1024

// Opaque transferable handle. On Linux it wraps an owned file descriptor.
pub const Handle = struct {
    descriptor: isize

    pub fn fromDescriptor(descriptor: isize) -> Self { return Self.{ .descriptor = descriptor } }
    pub fn invalid() -> Self { return Self.{ .descriptor = -1 } }
    pub fn isValid(self: Self) -> bool { return self.descriptor >= 0 }
    pub fn raw(self: Self) -> isize { return self.descriptor }

    pub fn close(self: Self) -> void { linux.close(self.descriptor) }

    // Duplicates the handle (close-on-exec). The copy is owned separately.
    pub fn duplicate(self: Self) -> Self {
        const result = linux.fcntl(self.descriptor, linux.F_DUPFD_CLOEXEC, 0)
        return Self.{ .descriptor = if result < 0 { -1 } else { result } }
    }
}

pub fn close(descriptor: isize) -> void { linux.close(descriptor) }

pub fn setNonBlocking(descriptor: isize) -> bool { return linux.setNonBlocking(descriptor) }

// ---------------------------------------------------------------------------
// Sockets

// Connects a non-blocking, close-on-exec stream socket to `path`. Returns
// the descriptor or a negative errno.
pub fn connectPath(path: [*]const u8, path_length: usize) -> isize {
    const descriptor = socket.connectUnix(path[0..path_length], false, socket.SOCK_CLOEXEC)
    if descriptor < 0 { return descriptor }
    if !linux.setNonBlocking(descriptor) {
        linux.close(descriptor)
        return linux.EPROTO
    }
    return descriptor
}

// Binds and listens on `path`. Returns the listening descriptor or a
// negative errno.
pub fn listenPath(path: [*]const u8, path_length: usize) -> isize {
    return socket.listenUnix(path[0..path_length], false, socket.SOCK_CLOEXEC | socket.SOCK_NONBLOCK, 128)
}

// Accepts one pending connection as a non-blocking, close-on-exec socket.
pub fn accept(listener: isize) -> isize {
    return socket.accept4(listener, 0, 0, socket.SOCK_CLOEXEC | socket.SOCK_NONBLOCK)
}

// Creates a connected pair of non-blocking stream sockets.
pub fn socketPair(first: *isize, second: *isize) -> bool {
    var descriptors: [2]i32 = [2]i32{ -1, -1 }
    if socket.socketPair(socket.AF_UNIX, socket.SOCK_STREAM | socket.SOCK_CLOEXEC | socket.SOCK_NONBLOCK, 0, &descriptors) < 0 { return false }
    first.* = @intCast(isize, descriptors[0])
    second.* = @intCast(isize, descriptors[1])
    return true
}

// Opens and exclusively locks `path` (the "<socket>.lock" convention shared
// with libwayland). Returns the lock descriptor or a negative errno.
pub fn lockPath(path: [*]const u8) -> isize {
    const descriptor = linux.open(path, linux.O_RDWR | linux.O_CREAT | linux.O_CLOEXEC, 432)
    if descriptor < 0 { return descriptor }
    const locked = linux.syscall2(linux.SYS_flock, @bitCast(usize, descriptor), linux.LOCK_EX | linux.LOCK_NB)
    if locked < 0 {
        linux.close(descriptor)
        return locked
    }
    return descriptor
}

pub fn unlinkPath(path: [*]const u8) -> void {
    _ = linux.unlink(path)
}

// Waits until `descriptor` is readable (or writable). Returns 1 when ready,
// 0 on timeout, or a negative errno. A negative timeout waits forever.
pub fn wait(descriptor: isize, writable: bool, timeout_milliseconds: isize) -> isize {
    return event.waitReady(descriptor, writable, timeout_milliseconds)
}

// Waits until any of `count` descriptors (at most 16) is readable.
// `ready[i]` is set for each readable (or hung-up) descriptor. Returns the
// number of ready descriptors, 0 on timeout, or a negative errno.
pub fn waitAny(descriptors: [*]const isize, count: usize, ready: [*]bool, timeout_milliseconds: isize) -> isize {
    if count > 16 { return linux.EMSGSIZE }
    var records: [128]u8 = undefined
    const bytes: [*]u8 = &records
    var index: usize = 0
    while index < count {
        event.pollSet(bytes, index, descriptors[index], event.POLLIN)
        ready[index] = false
        index += 1
    }
    var result: isize = linux.EINTR
    while result == linux.EINTR {
        result = event.poll(@intFromPtr(bytes), count, timeout_milliseconds)
    }
    if result <= 0 { return result }
    index = 0
    while index < count {
        ready[index] = event.pollResult(bytes, index) != 0
        index += 1
    }
    return result
}

// ---------------------------------------------------------------------------
// Connections

pub const Connection = struct {
    descriptor: isize
    allocator: Allocator
    input: [*]u8
    inputStart: usize
    inputEnd: usize
    inputHandles: [*]isize
    inputHandleStart: usize
    inputHandleEnd: usize
    output: [*]u8
    outputLength: usize
    outputHandles: [*]isize
    outputHandleCount: usize
    outputHandlesSent: bool
    closed: bool
}

// Takes ownership of `descriptor`. Returns false (leaving the descriptor
// open) when the buffers cannot be allocated.
pub fn init(connection: *Connection, allocator: Allocator, descriptor: isize) -> bool {
    const input = allocator.alloc(INPUT_CAPACITY, 16)
    if input == null { return false }
    const output = allocator.alloc(OUTPUT_CAPACITY, 16)
    if output == null {
        allocator.free(input.?, INPUT_CAPACITY, 16)
        return false
    }
    const input_handles = allocator.alloc(HANDLE_CAPACITY * 8, 8)
    if input_handles == null {
        allocator.free(input.?, INPUT_CAPACITY, 16)
        allocator.free(output.?, OUTPUT_CAPACITY, 16)
        return false
    }
    const output_handles = allocator.alloc(wire.MAX_HANDLES * 8, 8)
    if output_handles == null {
        allocator.free(input.?, INPUT_CAPACITY, 16)
        allocator.free(output.?, OUTPUT_CAPACITY, 16)
        allocator.free(input_handles.?, HANDLE_CAPACITY * 8, 8)
        return false
    }
    connection.*.descriptor = descriptor
    connection.*.allocator = allocator
    connection.*.input = input.?
    connection.*.inputStart = 0
    connection.*.inputEnd = 0
    unsafe { connection.*.inputHandles = @ptrCast([*]isize, input_handles.?) }
    connection.*.inputHandleStart = 0
    connection.*.inputHandleEnd = 0
    connection.*.output = output.?
    connection.*.outputLength = 0
    unsafe { connection.*.outputHandles = @ptrCast([*]isize, output_handles.?) }
    connection.*.outputHandleCount = 0
    connection.*.outputHandlesSent = false
    connection.*.closed = false
    return true
}

// Closes the socket and every handle still owned by the connection, then
// releases the buffers.
pub fn deinit(connection: *Connection) -> void {
    linux.close(connection.*.descriptor)
    connection.*.descriptor = -1
    var index = connection.*.inputHandleStart
    while index < connection.*.inputHandleEnd {
        linux.close(connection.*.inputHandles[index])
        index += 1
    }
    if !connection.*.outputHandlesSent {
        index = 0
        while index < connection.*.outputHandleCount {
            linux.close(connection.*.outputHandles[index])
            index += 1
        }
    }
    const allocator = connection.*.allocator
    allocator.free(connection.*.input, INPUT_CAPACITY, 16)
    allocator.free(connection.*.output, OUTPUT_CAPACITY, 16)
    unsafe {
        allocator.free(@ptrCast([*]u8, connection.*.inputHandles), HANDLE_CAPACITY * 8, 8)
        allocator.free(@ptrCast([*]u8, connection.*.outputHandles), wire.MAX_HANDLES * 8, 8)
    }
    connection.*.closed = true
}

pub fn pendingOutput(connection: *const Connection) -> usize { return connection.*.outputLength }

// Sends buffered bytes. Handles are attached to the first sendmsg that
// carries any of the buffered bytes, so they never arrive after the message
// that consumes them. Returns 0 once everything was sent, EAGAIN when the
// socket is full, or another negative errno.
pub fn flush(connection: *Connection) -> isize {
    while connection.*.outputLength > 0 {
        const handles = if connection.*.outputHandlesSent { 0 } else { connection.*.outputHandleCount }
        const sent = socket.sendWithDescriptors(connection.*.descriptor, connection.*.output, connection.*.outputLength, connection.*.outputHandles, handles, socket.MSG_DONTWAIT | socket.MSG_NOSIGNAL)
        if sent < 0 { return sent }
        var index: usize = 0
        if handles > 0 {
            // The kernel duplicated the descriptors into the message; the
            // connection's copies are released now.
            while index < handles {
                linux.close(connection.*.outputHandles[index])
                index += 1
            }
            connection.*.outputHandlesSent = true
        }
        const amount = @bitCast(usize, sent)
        const remaining = connection.*.outputLength - amount
        index = 0
        while index < remaining {
            connection.*.output[index] = connection.*.output[amount + index]
            index += 1
        }
        connection.*.outputLength = remaining
        if remaining == 0 {
            connection.*.outputHandleCount = 0
            connection.*.outputHandlesSent = false
        }
    }
    return 0
}

// Appends one finished message to the output buffer, flushing first when
// the bytes or handles would not fit. Ownership of the message's handles
// moves to the connection. Returns 0, EAGAIN (buffer full and the peer is
// not reading), or another negative errno.
pub fn queue(connection: *Connection, writer: *const wire.Writer) -> isize {
    const needs_room = connection.*.outputLength + writer.*.length > OUTPUT_CAPACITY
    const needs_handles = writer.*.handleCount > 0 && (connection.*.outputHandlesSent || connection.*.outputHandleCount + writer.*.handleCount > wire.MAX_HANDLES)
    if needs_room || needs_handles {
        const flushed = flush(connection)
        if flushed < 0 && flushed != EAGAIN { return flushed }
        if connection.*.outputLength + writer.*.length > OUTPUT_CAPACITY { return EAGAIN }
        if writer.*.handleCount > 0 && connection.*.outputLength > 0 { return EAGAIN }
    }
    wire.copyBytes(writer, connection.*.output + connection.*.outputLength)
    connection.*.outputLength += writer.*.length
    var index: usize = 0
    while index < writer.*.handleCount {
        connection.*.outputHandles[connection.*.outputHandleCount] = wire.handleAt(writer, index)
        connection.*.outputHandleCount += 1
        index += 1
    }
    return 0
}

// queue for bytes made elsewhere (std.dbus): `length` bytes and `count`
// descriptors, which the connection then owns.
pub fn queueBytes(connection: *Connection, bytes: [*]const u8, length: usize, descriptors: [*]const isize, count: usize) -> isize {
    if length > OUTPUT_CAPACITY || count > wire.MAX_HANDLES { return linux.EMSGSIZE }
    const needs_room = connection.*.outputLength + length > OUTPUT_CAPACITY
    const needs_handles = count > 0 && (connection.*.outputHandlesSent || connection.*.outputHandleCount + count > wire.MAX_HANDLES)
    if needs_room || needs_handles {
        const flushed = flush(connection)
        if flushed < 0 && flushed != EAGAIN { return flushed }
        if connection.*.outputLength + length > OUTPUT_CAPACITY { return EAGAIN }
        if count > 0 && connection.*.outputLength > 0 { return EAGAIN }
    }
    mem.copy(connection.*.output + connection.*.outputLength, bytes, length)
    connection.*.outputLength += length
    var index: usize = 0
    while index < count {
        connection.*.outputHandles[connection.*.outputHandleCount] = descriptors[index]
        connection.*.outputHandleCount += 1
        index += 1
    }
    return 0
}

fn compactInput(connection: *Connection) -> void {
    if connection.*.inputStart > 0 {
        const length = connection.*.inputEnd - connection.*.inputStart
        // Moved down: a forward word copy is right (std.mem.copy checks).
        const from: [*]const u8 = connection.*.input + connection.*.inputStart
        mem.copy(connection.*.input, from, length)
        connection.*.inputStart = 0
        connection.*.inputEnd = length
    }
    if connection.*.inputHandleStart > 0 {
        const count = connection.*.inputHandleEnd - connection.*.inputHandleStart
        var index: usize = 0
        while index < count {
            connection.*.inputHandles[index] = connection.*.inputHandles[connection.*.inputHandleStart + index]
            index += 1
        }
        connection.*.inputHandleStart = 0
        connection.*.inputHandleEnd = count
    }
}

// Reads whatever the socket has, queueing received handles in order.
// Returns the number of bytes read, 0 at end of stream, EAGAIN when nothing
// is available, or another negative errno.
pub fn receive(connection: *Connection) -> isize {
    compactInput(connection)
    const room = INPUT_CAPACITY - connection.*.inputEnd
    if room == 0 { return linux.EMSGSIZE }
    if connection.*.inputHandleEnd + wire.MAX_HANDLES > HANDLE_CAPACITY { return linux.EMSGSIZE }
    var handles: usize = 0
    const received = socket.receiveWithDescriptors(connection.*.descriptor, connection.*.input + connection.*.inputEnd, room, connection.*.inputHandles + connection.*.inputHandleEnd, HANDLE_CAPACITY - connection.*.inputHandleEnd, &handles, socket.MSG_DONTWAIT | socket.MSG_CMSG_CLOEXEC)
    connection.*.inputHandleEnd += handles
    if received < 0 { return received }
    connection.*.inputEnd += @bitCast(usize, received)
    return received
}

pub fn bufferedInput(connection: *const Connection) -> usize {
    return connection.*.inputEnd - connection.*.inputStart
}

pub fn bufferedHandles(connection: *const Connection) -> usize {
    return connection.*.inputHandleEnd - connection.*.inputHandleStart
}

// Start of the next buffered message (valid when at least HEADER_SIZE bytes
// are buffered).
pub fn inputPointer(connection: *const Connection) -> [*]const u8 {
    return connection.*.input + connection.*.inputStart
}

pub fn handlePointer(connection: *const Connection) -> [*]const isize {
    unsafe { return @ptrFromInt([*]const isize, @intFromPtr(connection.*.inputHandles) + connection.*.inputHandleStart * 8) }
}

// Drops a processed message and hands its `handles` leading queued handles
// to the consumer (who now owns them).
pub fn consume(connection: *Connection, size: usize, handles: usize) -> void {
    connection.*.inputStart += size
    connection.*.inputHandleStart += handles
    if connection.*.inputStart == connection.*.inputEnd {
        connection.*.inputStart = 0
        connection.*.inputEnd = 0
    }
}

// ---------------------------------------------------------------------------
// Event loop (epoll): std.linux.event's, whose records carry the caller's
// token with each descriptor's readiness.

pub const Events = event.Events

pub fn createEventLoop() -> isize { return event.createEventLoop() }

pub fn watch(event_loop: isize, descriptor: isize, token: usize, writable: bool) -> bool {
    return event.watch(event_loop, descriptor, token, writable)
}

pub fn rewatch(event_loop: isize, descriptor: isize, token: usize, writable: bool) -> bool {
    return event.rewatch(event_loop, descriptor, token, writable)
}

pub fn unwatch(event_loop: isize, descriptor: isize) -> bool { return event.unwatch(event_loop, descriptor) }

// Waits for readiness. Returns the number of records, 0 on timeout, or a
// negative errno. A negative timeout waits forever.
pub fn waitEvents(event_loop: isize, events: *Events, timeout_milliseconds: isize) -> isize {
    return event.waitEvents(event_loop, events, timeout_milliseconds)
}

pub fn eventFlags(events: *const Events, index: usize) -> u32 { return event.eventFlags(events, index) }

pub fn eventToken(events: *const Events, index: usize) -> usize { return event.eventToken(events, index) }

// ---------------------------------------------------------------------------
// Shared memory

// Creates an anonymous shared-memory object of `size` bytes. Returns the
// descriptor or a negative errno.
pub fn createSharedMemory(size: usize) -> isize {
    const name: []const u8 = "mlx-wayland-shm"
    const descriptor = linux.memfdCreate(name.pointer, linux.MFD_CLOEXEC | linux.MFD_ALLOW_SEALING)
    if descriptor < 0 { return descriptor }
    const truncated = linux.truncate(descriptor, size)
    if truncated < 0 {
        linux.close(descriptor)
        return truncated
    }
    return descriptor
}

// Maps `size` bytes of a shared-memory descriptor. Returns the address, or
// 0 on failure.
pub fn mapSharedMemory(descriptor: isize, size: usize, writable: bool) -> usize {
    return linux.mapShared(descriptor, size, writable)
}

pub fn unmapSharedMemory(address: usize, size: usize) -> void { linux.munmap(address, size) }

// ---------------------------------------------------------------------------
// Environment

// A snapshot of the process environment read from /proc/self/environ.
pub const Environment = struct {
    bytes: [*]u8
    length: usize
    capacity: usize
    allocator: Allocator
}

pub fn loadEnvironment(environment: *Environment, allocator: Allocator) -> bool {
    const path: []const u8 = "/proc/self/environ"
    const descriptor = linux.open(path.pointer, linux.O_CLOEXEC, 0)
    if descriptor < 0 { return false }
    var capacity: usize = 16384
    var memory = allocator.alloc(capacity, 1)
    if memory == null {
        linux.close(descriptor)
        return false
    }
    var bytes = memory.?
    var length: usize = 0
    while true {
        if length == capacity {
            const grown = allocator.resize(bytes, capacity, capacity * 2, 1)
            if grown == null {
                allocator.free(bytes, capacity, 1)
                linux.close(descriptor)
                return false
            }
            bytes = grown.?
            capacity *= 2
        }
        const amount = linux.read(descriptor, bytes + length, capacity - length)
        if amount == linux.EINTR { continue }
        if amount <= 0 { break }
        length += @bitCast(usize, amount)
    }
    linux.close(descriptor)
    environment.*.bytes = bytes
    environment.*.length = length
    environment.*.capacity = capacity
    environment.*.allocator = allocator
    return true
}

// Looks up `name`; the result borrows the snapshot. A missing variable is
// returned with a zero pointer (see wire.isNull).
pub fn lookupEnvironment(environment: *const Environment, name: []const u8) -> String {
    var name_length: usize = 0
    name_length += name.length
    var start: usize = 0
    while start < environment.*.length {
        var end = start
        while end < environment.*.length && environment.*.bytes[end] != 0 { end += 1 }
        if end - start > name_length && environment.*.bytes[start + name_length] == 61 {
            var matches = true
            var index: usize = 0
            for byte in name {
                if environment.*.bytes[start + index] != byte { matches = false }
                index += 1
            }
            if matches {
                return string.fromParts(environment.*.bytes + start + name_length + 1, end - start - name_length - 1)
            }
        }
        start = end + 1
    }
    return wire.nullString()
}

pub fn freeEnvironment(environment: *Environment) -> void {
    environment.*.allocator.free(environment.*.bytes, environment.*.capacity, 1)
}
