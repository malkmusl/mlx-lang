// std.wayland.transport: the platform transport behind std.wayland.
//
// The public Wayland API is identical on every target; this module selects
// the native backend. Linux (AF_UNIX + SCM_RIGHTS, epoll, memfd) is
// implemented in transport/linux.mlx. BSD and brixOS backends provide the
// same declarations when those targets are brought up.

const backend = @import("./transport/linux.mlx")

pub const Handle = backend.Handle

// A shared-memory object and its mapping. Create one with
// `createSharedMemory`, or map a received handle with `mapSharedMemory`.
pub const SharedMemory = struct {
    handle: Handle
    address: usize
    size: usize

    pub fn bytes(self: Self) -> [*]u8 {
        unsafe { return @ptrFromInt([*]u8, self.address) }
    }

    // Unmaps the memory and closes the handle.
    pub fn release(self: Self) -> void {
        if self.address != 0 { backend.unmapSharedMemory(self.address, self.size) }
        self.handle.close()
    }
}

// Creates and maps a writable anonymous shared-memory object.
pub fn createSharedMemory(memory: *SharedMemory, size: usize) -> bool {
    const descriptor = backend.createSharedMemory(size)
    if descriptor < 0 { return false }
    const address = backend.mapSharedMemory(descriptor, size, true)
    if address == 0 {
        backend.close(descriptor)
        return false
    }
    memory.*.handle = Handle.fromDescriptor(descriptor)
    memory.*.address = address
    memory.*.size = size
    return true
}

// Maps a shared-memory handle received from a peer. The mapping owns the
// handle afterwards.
pub fn mapSharedMemory(memory: *SharedMemory, handle: Handle, size: usize, writable: bool) -> bool {
    const address = backend.mapSharedMemory(handle.descriptor, size, writable)
    if address == 0 { return false }
    memory.*.handle = handle
    memory.*.address = address
    memory.*.size = size
    return true
}

// Waits until `handle` is readable (or writable). Returns 1 when ready, 0 on
// timeout, or a negative errno.
pub fn wait(handle: Handle, writable: bool, timeout_milliseconds: isize) -> isize {
    return backend.wait(handle.descriptor, writable, timeout_milliseconds)
}

// Creates a connected pair of stream sockets, for example to hand one end
// to a child process as WAYLAND_SOCKET or to Display.connectToHandle /
// server Display.addClient.
pub fn socketPair(first: *Handle, second: *Handle) -> bool {
    var left: isize = -1
    var right: isize = -1
    if !backend.socketPair(&left, &right) { return false }
    first.* = Handle.fromDescriptor(left)
    second.* = Handle.fromDescriptor(right)
    return true
}
