// std.wayland.protocol: Wayland protocol XML -> Protocol AST.
//
// Implements the `MlxWaylandProtocolAST` shape from
// spec/06-wayland/protocol-ast.xml on top of std.xml. Every string in the AST
// borrows the XML source, which must outlive the Protocol. Names are plain
// identifiers; summaries and description text are raw XML character data
// (decode them with std.xml `decode`/`decodeAlloc`).
//
// Validation mirrors upstream wayland-scanner's hard errors, and additionally
// rejects every element or attribute that the schema does not define. The
// only ignorable constructs are XML comments, whitespace between elements,
// and `<description>` inside `<arg>`/`<entry>` (documentation only).

const xml = @import("../xml.mlx")
const allocator_module = @import("../../bootstrap/allocator.mlx")
const string = @import("../../bootstrap/string.mlx")
const vector = @import("../../bootstrap/vector.mlx")

pub const Allocator = allocator_module.Allocator
pub const String = string.String
pub const Vector = vector.Vector

pub const ArgType = enum(u8) {
    int,
    uint,
    fixed,
    string,
    object,
    newId,
    array,
    fd
}

pub const Description = struct {
    present: bool
    summary: String
    text: String
}

pub const Arg = struct {
    name: String
    kind: ArgType
    interfaceName: String
    allowNull: bool
    enumName: String
    summary: String
    hasSummary: bool
    offset: usize
}

pub const Message = struct {
    name: String
    opcode: u16
    since: u32
    deprecatedSince: u32
    destructor: bool
    description: Description
    firstArg: usize
    argCount: usize
    interfaceIndex: usize
    offset: usize
}

pub const Entry = struct {
    name: String
    value: u32
    since: u32
    deprecatedSince: u32
    summary: String
    hasSummary: bool
    offset: usize
}

pub const Enum = struct {
    name: String
    since: u32
    bitfield: bool
    description: Description
    firstEntry: usize
    entryCount: usize
    offset: usize
}

pub const Interface = struct {
    name: String
    version: u32
    frozen: bool
    description: Description
    firstRequest: usize
    requestCount: usize
    firstEvent: usize
    eventCount: usize
    firstEnum: usize
    enumCount: usize
    offset: usize
}

pub const Protocol = struct {
    allocator: Allocator
    source: [*]const u8
    sourceLength: usize
    name: String
    copyright: String
    hasCopyright: bool
    description: Description
    interfaces: Vector
    requests: Vector
    events: Vector
    args: Vector
    enums: Vector
    entries: Vector
}

pub const ErrorKind = enum(u8) {
    none,
    xml,
    outOfMemory,
    unexpectedRoot,
    unknownElement,
    misplacedElement,
    duplicateElement,
    unknownAttribute,
    missingAttribute,
    invalidIdentifier,
    invalidInteger,
    invalidBoolean,
    invalidMessageType,
    sinceTooLarge,
    deprecatedSinceTooLarge,
    deprecatedSinceNotAfterSince,
    frozenVersion,
    destroyNotDestructor,
    unknownArgType,
    interfaceNotAllowed,
    allowNullNotAllowed,
    enumWrongType,
    bitfieldIntArgument,
    emptyEnum,
    descriptionWithoutSummary,
    duplicateName,
    unexpectedText,
    missingInterface,
    invalidEntryValue
}

pub const Diagnostic = struct {
    kind: ErrorKind
    xmlCode: xml.ErrorCode
    offset: usize
    line: usize
    column: usize
}

pub fn errorMessage(kind: ErrorKind) -> []const u8 {
    return match kind {
        .none => "no error",
        .xml => "malformed XML",
        .outOfMemory => "out of memory",
        .unexpectedRoot => "root element must be <protocol>",
        .unknownElement => "unknown protocol element",
        .misplacedElement => "element is not allowed here",
        .duplicateElement => "element may appear at most once here",
        .unknownAttribute => "unknown attribute",
        .missingAttribute => "required attribute is missing",
        .invalidIdentifier => "name is not a valid identifier",
        .invalidInteger => "invalid non-negative integer",
        .invalidBoolean => "boolean attribute must be \"true\" or \"false\"",
        .invalidMessageType => "message type must be \"destructor\"",
        .sinceTooLarge => "since is larger than the interface version",
        .deprecatedSinceTooLarge => "deprecated-since is larger than the interface version",
        .deprecatedSinceNotAfterSince => "deprecated-since must be larger than since",
        .frozenVersion => "frozen interface must have version 1",
        .destroyNotDestructor => "destroy request should be destructor type",
        .unknownArgType => "unknown argument type",
        .interfaceNotAllowed => "interface attribute is only allowed for object and new_id",
        .allowNullNotAllowed => "allow-null is only valid for objects and strings",
        .enumWrongType => "enumeration-style argument must be int or uint",
        .bitfieldIntArgument => "bitfield-style enum must only be referenced by uint",
        .emptyEnum => "enumeration has no entries",
        .descriptionWithoutSummary => "description without summary",
        .duplicateName => "duplicate name",
        .unexpectedText => "character data is not allowed here",
        .missingInterface => "protocol declares no interface",
        .invalidEntryValue => "entry value is not a 32-bit integer"
    }
}

pub fn argTypeName(kind: ArgType) -> []const u8 {
    return match kind {
        .int => "int",
        .uint => "uint",
        .fixed => "fixed",
        .string => "string",
        .object => "object",
        .newId => "new_id",
        .array => "array",
        .fd => "fd"
    }
}

// ---------------------------------------------------------------------------
// AST access

pub fn interfaceCount(protocol: *const Protocol) -> usize { return protocol.*.interfaces.length }

pub fn interfaceAt(protocol: *const Protocol, index: usize) -> *Interface {
    unsafe { return @ptrCast(*Interface, protocol.*.interfaces.at(index)) }
}

pub fn requestAt(protocol: *const Protocol, interface: *const Interface, opcode: usize) -> *Message {
    unsafe { return @ptrCast(*Message, protocol.*.requests.at(interface.*.firstRequest + opcode)) }
}

pub fn eventAt(protocol: *const Protocol, interface: *const Interface, opcode: usize) -> *Message {
    unsafe { return @ptrCast(*Message, protocol.*.events.at(interface.*.firstEvent + opcode)) }
}

pub fn enumAt(protocol: *const Protocol, interface: *const Interface, index: usize) -> *Enum {
    unsafe { return @ptrCast(*Enum, protocol.*.enums.at(interface.*.firstEnum + index)) }
}

pub fn argAt(protocol: *const Protocol, message: *const Message, index: usize) -> *Arg {
    unsafe { return @ptrCast(*Arg, protocol.*.args.at(message.*.firstArg + index)) }
}

pub fn entryAt(protocol: *const Protocol, enumeration: *const Enum, index: usize) -> *Entry {
    unsafe { return @ptrCast(*Entry, protocol.*.entries.at(enumeration.*.firstEntry + index)) }
}

pub fn findInterface(protocol: *const Protocol, name: String) -> ?*Interface {
    var index: usize = 0
    while index < interfaceCount(protocol) {
        const interface = interfaceAt(protocol, index)
        if string.eql(interface.*.name, name) { return interface }
        index += 1
    }
    return null
}

pub fn findEnum(protocol: *const Protocol, interface: *const Interface, name: String) -> ?*Enum {
    var index: usize = 0
    while index < interface.*.enumCount {
        const enumeration = enumAt(protocol, interface, index)
        if string.eql(enumeration.*.name, name) { return enumeration }
        index += 1
    }
    return null
}

// Splits an `enum` attribute into its interface part (empty when the
// reference is local) and enum name, exactly like wayland-scanner: the last
// '.' that is not the final byte separates the two.
pub fn splitEnumReference(reference: String, interface_part: *String, enum_part: *String) -> void {
    var separator: usize = 0
    var index: usize = 0
    while index + 1 < reference.length {
        if reference.pointer[index] == 46 { separator = index }
        index += 1
    }
    if separator > 0 {
        interface_part.* = string.slice(reference, 0, separator)
        enum_part.* = string.slice(reference, separator + 1, reference.length)
    } else {
        interface_part.* = string.slice(reference, 0, 0)
        enum_part.* = reference
    }
}

pub fn deinit(protocol: *Protocol) -> void {
    protocol.*.interfaces.deinit()
    protocol.*.requests.deinit()
    protocol.*.events.deinit()
    protocol.*.args.deinit()
    protocol.*.enums.deinit()
    protocol.*.entries.deinit()
}

// ---------------------------------------------------------------------------
// Parser

// The tokenizer and current token live in `parse`'s frame; the parser holds
// pointers to them because the bootstrap compilers do not yet lower
// `&value.field`.
const Parser = struct {
    tokenizer: *xml.Tokenizer
    token: *xml.Token
    protocol: *Protocol
    diagnostic: *Diagnostic
}

const TABLE_INTERFACES: u8 = 0
const TABLE_REQUESTS: u8 = 1
const TABLE_EVENTS: u8 = 2
const TABLE_ARGS: u8 = 3
const TABLE_ENUMS: u8 = 4
const TABLE_ENTRIES: u8 = 5

fn emptyDescription(protocol: *const Protocol) -> Description {
    return Description.{
        .present = false,
        .summary = string.fromParts(protocol.*.source, 0),
        .text = string.fromParts(protocol.*.source, 0),
    }
}

fn report(parser: *Parser, kind: ErrorKind, offset: usize) -> bool {
    if parser.*.diagnostic.*.kind != ErrorKind.none { return false }
    parser.*.diagnostic.*.kind = kind
    parser.*.diagnostic.*.offset = offset
    parser.*.diagnostic.*.line = xml.lineOf(parser.*.tokenizer, offset)
    parser.*.diagnostic.*.column = xml.columnOf(parser.*.tokenizer, offset)
    return false
}

fn advance(parser: *Parser) -> bool {
    if xml.next(parser.*.tokenizer, parser.*.token) { return true }
    if parser.*.token.*.kind == xml.TokenKind.invalid {
        parser.*.diagnostic.*.xmlCode = xml.errorCode(parser.*.tokenizer)
        return report(parser, ErrorKind.xml, xml.errorOffset(parser.*.tokenizer))
    }
    return true
}

fn isAlpha(byte: u8) -> bool {
    return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90)
}

fn isDigit(byte: u8) -> bool {
    return byte >= 48 && byte <= 57
}

// wayland-scanner `validate_identifier`: [_0-9a-zA-Z]+, and a standalone
// identifier (not trailing) may not start with a digit.
pub fn isIdentifier(value: String, trailing: bool) -> bool {
    if value.length == 0 { return false }
    var index: usize = 0
    while index < value.length {
        const byte = value.pointer[index]
        const leading = index == 0 && !trailing
        if !(isAlpha(byte) || byte == 95 || (!leading && isDigit(byte))) { return false }
        index += 1
    }
    return true
}

// wayland-scanner `strtouint`: decimal digits only, 0..INT_MAX.
fn parseVersion(value: String, result: *u32) -> bool {
    if value.length == 0 { return false }
    var total: usize = 0
    var index: usize = 0
    while index < value.length {
        const byte = value.pointer[index]
        if !isDigit(byte) { return false }
        total = total * 10 + @intCast(usize, byte - 48)
        if total > 2147483647 { return false }
        index += 1
    }
    result.* = @intCast(u32, total)
    return true
}

// Entry values are C integer constants: decimal, 0x/0X hexadecimal, or
// 0-prefixed octal, and must fit in 32 bits.
pub fn parseEntryValue(value: String, result: *u32) -> bool {
    if value.length == 0 { return false }
    var base: usize = 10
    var index: usize = 0
    if value.length > 2 && value.pointer[0] == 48 && (value.pointer[1] == 120 || value.pointer[1] == 88) {
        base = 16
        index = 2
    } else if value.length > 1 && value.pointer[0] == 48 {
        base = 8
        index = 1
    }
    var total: usize = 0
    while index < value.length {
        const byte = value.pointer[index]
        var digit: usize = 99
        if isDigit(byte) { digit = @intCast(usize, byte - 48) }
        if byte >= 97 && byte <= 102 { digit = @intCast(usize, byte - 87) }
        if byte >= 65 && byte <= 70 { digit = @intCast(usize, byte - 55) }
        if digit >= base { return false }
        total = total * base + digit
        if total > 4294967295 { return false }
        index += 1
    }
    result.* = @intCast(u32, total)
    return true
}

fn parseBoolean(value: String, result: *bool) -> bool {
    if xml.equals(value, "true") {
        result.* = true
        return true
    }
    if xml.equals(value, "false") {
        result.* = false
        return true
    }
    return false
}

fn parseArgType(value: String, result: *ArgType) -> bool {
    if xml.equals(value, "int") { result.* = ArgType.int } else if xml.equals(value, "uint") { result.* = ArgType.uint } else if xml.equals(value, "fixed") { result.* = ArgType.fixed } else if xml.equals(value, "string") { result.* = ArgType.string } else if xml.equals(value, "object") { result.* = ArgType.object } else if xml.equals(value, "new_id") { result.* = ArgType.newId } else if xml.equals(value, "array") { result.* = ArgType.array } else if xml.equals(value, "fd") { result.* = ArgType.fd } else { return false }
    return true
}

fn append(parser: *Parser, table: u8, record: [*]const u8) -> bool {
    const protocol = parser.*.protocol
    var list: Vector = protocol.*.interfaces
    if table == TABLE_REQUESTS { list = protocol.*.requests }
    if table == TABLE_EVENTS { list = protocol.*.events }
    if table == TABLE_ARGS { list = protocol.*.args }
    if table == TABLE_ENUMS { list = protocol.*.enums }
    if table == TABLE_ENTRIES { list = protocol.*.entries }
    const appended = Vector.appendAt(&list, record)
    if table == TABLE_INTERFACES { protocol.*.interfaces = list }
    if table == TABLE_REQUESTS { protocol.*.requests = list }
    if table == TABLE_EVENTS { protocol.*.events = list }
    if table == TABLE_ARGS { protocol.*.args = list }
    if table == TABLE_ENUMS { protocol.*.enums = list }
    if table == TABLE_ENTRIES { protocol.*.entries = list }
    if appended { return true }
    return report(parser, ErrorKind.outOfMemory, parser.*.token.*.offset)
}

// Consumes the attribute tokens of the current start tag. On return the
// parser's token is the first token after the start tag. `handler` values:
// each element parser inspects attributes itself through `readAttributes`.
const AttributeSet = struct {
    name: String
    hasName: bool
    version: String
    hasVersion: bool
    kind: String
    hasKind: bool
    value: String
    hasValue: bool
    interface: String
    hasInterface: bool
    summary: String
    hasSummary: bool
    since: String
    hasSince: bool
    deprecatedSince: String
    hasDeprecatedSince: bool
    allowNull: String
    hasAllowNull: bool
    enumName: String
    hasEnumName: bool
    bitfield: String
    hasBitfield: bool
    frozen: String
    hasFrozen: bool
    nameOffset: usize
}

// Attribute masks: which attributes an element accepts.
const A_NAME: u32 = 1
const A_VERSION: u32 = 2
const A_TYPE: u32 = 4
const A_VALUE: u32 = 8
const A_INTERFACE: u32 = 16
const A_SUMMARY: u32 = 32
const A_SINCE: u32 = 64
const A_DEPRECATED: u32 = 128
const A_ALLOW_NULL: u32 = 256
const A_ENUM: u32 = 512
const A_BITFIELD: u32 = 1024
const A_FROZEN: u32 = 2048

fn clearAttributes(parser: *Parser, set: *AttributeSet) -> void {
    const empty = string.fromParts(parser.*.protocol.*.source, 0)
    set.*.name = empty
    set.*.hasName = false
    set.*.version = empty
    set.*.hasVersion = false
    set.*.kind = empty
    set.*.hasKind = false
    set.*.value = empty
    set.*.hasValue = false
    set.*.interface = empty
    set.*.hasInterface = false
    set.*.summary = empty
    set.*.hasSummary = false
    set.*.since = empty
    set.*.hasSince = false
    set.*.deprecatedSince = empty
    set.*.hasDeprecatedSince = false
    set.*.allowNull = empty
    set.*.hasAllowNull = false
    set.*.enumName = empty
    set.*.hasEnumName = false
    set.*.bitfield = empty
    set.*.hasBitfield = false
    set.*.frozen = empty
    set.*.hasFrozen = false
    set.*.nameOffset = parser.*.token.*.offset
}

fn readAttributes(parser: *Parser, set: *AttributeSet, allowed: u32) -> bool {
    clearAttributes(parser, set)
    while true {
        if !advance(parser) { return false }
        if parser.*.token.*.kind != xml.TokenKind.attribute { return true }
        const name = parser.*.token.*.name
        const value = parser.*.token.*.value
        var bit: u32 = 0
        if xml.equals(name, "name") {
            bit = A_NAME
            set.*.name = value
            set.*.hasName = true
            set.*.nameOffset = parser.*.token.*.offset
        } else if xml.equals(name, "version") {
            bit = A_VERSION
            set.*.version = value
            set.*.hasVersion = true
        } else if xml.equals(name, "type") {
            bit = A_TYPE
            set.*.kind = value
            set.*.hasKind = true
        } else if xml.equals(name, "value") {
            bit = A_VALUE
            set.*.value = value
            set.*.hasValue = true
        } else if xml.equals(name, "interface") {
            bit = A_INTERFACE
            set.*.interface = value
            set.*.hasInterface = true
        } else if xml.equals(name, "summary") {
            bit = A_SUMMARY
            set.*.summary = value
            set.*.hasSummary = true
        } else if xml.equals(name, "since") {
            bit = A_SINCE
            set.*.since = value
            set.*.hasSince = true
        } else if xml.equals(name, "deprecated-since") {
            bit = A_DEPRECATED
            set.*.deprecatedSince = value
            set.*.hasDeprecatedSince = true
        } else if xml.equals(name, "allow-null") {
            bit = A_ALLOW_NULL
            set.*.allowNull = value
            set.*.hasAllowNull = true
        } else if xml.equals(name, "enum") {
            bit = A_ENUM
            set.*.enumName = value
            set.*.hasEnumName = true
        } else if xml.equals(name, "bitfield") {
            bit = A_BITFIELD
            set.*.bitfield = value
            set.*.hasBitfield = true
        } else if xml.equals(name, "frozen") {
            bit = A_FROZEN
            set.*.frozen = value
            set.*.hasFrozen = true
        }
        if bit == 0 || (allowed & bit) == 0 { return report(parser, ErrorKind.unknownAttribute, parser.*.token.*.offset) }
    }
    return true
}

// Skips whitespace, comments and CDATA-free whitespace until the next
// element start or end. Any other character data is an error.
fn skipMisc(parser: *Parser) -> bool {
    while true {
        const kind = parser.*.token.*.kind
        if kind == xml.TokenKind.comment {
            if !advance(parser) { return false }
        } else if kind == xml.TokenKind.text {
            if !xml.isBlank(parser.*.token.*.value) { return report(parser, ErrorKind.unexpectedText, parser.*.token.*.offset) }
            if !advance(parser) { return false }
        } else if kind == xml.TokenKind.cdata || kind == xml.TokenKind.processingInstruction {
            return report(parser, ErrorKind.unexpectedText, parser.*.token.*.offset)
        } else {
            return true
        }
    }
    return true
}

// Reads the raw character content of a text-only element (copyright,
// description) whose start tag has already been consumed. The parser's
// token must be the first token after the start tag.
fn readTextContent(parser: *Parser, result: *String) -> bool {
    var start: usize = parser.*.token.*.offset
    var saw_content = false
    while parser.*.token.*.kind != xml.TokenKind.elementEnd {
        const kind = parser.*.token.*.kind
        if kind == xml.TokenKind.elementStart { return report(parser, ErrorKind.misplacedElement, parser.*.token.*.offset) }
        if kind == xml.TokenKind.endOfDocument { return report(parser, ErrorKind.xml, parser.*.token.*.offset) }
        if kind != xml.TokenKind.text && kind != xml.TokenKind.cdata && kind != xml.TokenKind.comment {
            return report(parser, ErrorKind.unexpectedText, parser.*.token.*.offset)
        }
        if !saw_content {
            start = parser.*.token.*.offset
            saw_content = true
        }
        if !advance(parser) { return false }
    }
    const end = parser.*.token.*.offset
    if !saw_content { start = end }
    unsafe { result.* = string.fromParts(@ptrFromInt([*]const u8, @intFromPtr(parser.*.protocol.*.source) + start), end - start) }
    return true
}

fn parseDescription(parser: *Parser, description: *Description) -> bool {
    if description.*.present { return report(parser, ErrorKind.duplicateElement, parser.*.token.*.offset) }
    const offset = parser.*.token.*.offset
    var set: AttributeSet = undefined
    if !readAttributes(parser, &set, A_SUMMARY) { return false }
    if !set.hasSummary { return report(parser, ErrorKind.descriptionWithoutSummary, offset) }
    description.*.present = true
    description.*.summary = set.summary
    var text: String = undefined
    if !readTextContent(parser, &text) { return false }
    description.*.text = text
    return advance(parser)
}

fn checkName(parser: *Parser, set: *const AttributeSet, trailing: bool, offset: usize) -> bool {
    if !set.*.hasName { return report(parser, ErrorKind.missingAttribute, offset) }
    if !isIdentifier(set.*.name, trailing) { return report(parser, ErrorKind.invalidIdentifier, set.*.nameOffset) }
    return true
}

fn sinceValue(parser: *Parser, set: *const AttributeSet, interface_version: u32, since: *u32, deprecated_since: *u32, offset: usize) -> bool {
    since.* = 1
    deprecated_since.* = 0
    if set.*.hasSince {
        if !parseVersion(set.*.since, since) { return report(parser, ErrorKind.invalidInteger, offset) }
        if since.* > interface_version { return report(parser, ErrorKind.sinceTooLarge, offset) }
    }
    if set.*.hasDeprecatedSince {
        if !parseVersion(set.*.deprecatedSince, deprecated_since) { return report(parser, ErrorKind.invalidInteger, offset) }
        if deprecated_since.* > interface_version { return report(parser, ErrorKind.deprecatedSinceTooLarge, offset) }
        if deprecated_since.* > 0 && deprecated_since.* <= since.* { return report(parser, ErrorKind.deprecatedSinceNotAfterSince, offset) }
    }
    return true
}

fn parseArg(parser: *Parser, message: *Message) -> bool {
    const offset = parser.*.token.*.offset
    var set: AttributeSet = undefined
    if !readAttributes(parser, &set, A_NAME | A_TYPE | A_INTERFACE | A_SUMMARY | A_ALLOW_NULL | A_ENUM) { return false }
    if !checkName(parser, &set, false, offset) { return false }
    var arg: Arg = undefined
    arg.name = set.name
    arg.offset = offset
    if !set.hasKind { return report(parser, ErrorKind.unknownArgType, offset) }
    var kind = ArgType.int
    if !parseArgType(set.kind, &kind) { return report(parser, ErrorKind.unknownArgType, offset) }
    arg.kind = kind
    arg.interfaceName = string.fromParts(parser.*.protocol.*.source, 0)
    if set.hasInterface {
        if arg.kind != ArgType.object && arg.kind != ArgType.newId { return report(parser, ErrorKind.interfaceNotAllowed, offset) }
        if !isIdentifier(set.interface, false) { return report(parser, ErrorKind.invalidIdentifier, offset) }
        arg.interfaceName = set.interface
    }
    var allow_null = false
    if set.hasAllowNull {
        if !parseBoolean(set.allowNull, &allow_null) { return report(parser, ErrorKind.invalidBoolean, offset) }
        if arg.kind != ArgType.string && arg.kind != ArgType.object { return report(parser, ErrorKind.allowNullNotAllowed, offset) }
    }
    arg.allowNull = allow_null
    arg.enumName = string.fromParts(parser.*.protocol.*.source, 0)
    if set.hasEnumName && set.enumName.length > 0 {
        if arg.kind != ArgType.int && arg.kind != ArgType.uint { return report(parser, ErrorKind.enumWrongType, offset) }
        arg.enumName = set.enumName
    }
    arg.summary = set.summary
    arg.hasSummary = set.hasSummary
    // Argument names are unique within a message.
    var index: usize = 0
    while index < message.*.argCount {
        if string.eql(argAt(parser.*.protocol, message, index).*.name, arg.name) { return report(parser, ErrorKind.duplicateName, offset) }
        index += 1
    }
    unsafe {
        if !append(parser, TABLE_ARGS, @ptrCast([*]const u8, &arg)) { return false }
    }
    message.*.argCount += 1
    // <arg> may only carry a documentation-only <description>.
    var ignored = emptyDescription(parser.*.protocol)
    while true {
        if !skipMisc(parser) { return false }
        if parser.*.token.*.kind == xml.TokenKind.elementEnd { return advance(parser) }
        if parser.*.token.*.kind != xml.TokenKind.elementStart { return report(parser, ErrorKind.xml, parser.*.token.*.offset) }
        if !xml.equals(parser.*.token.*.name, "description") { return reportElement(parser) }
        if !parseDescription(parser, &ignored) { return false }
    }
    return true
}

fn reportElement(parser: *Parser) -> bool {
    const name = parser.*.token.*.name
    if xml.equals(name, "protocol") || xml.equals(name, "copyright") || xml.equals(name, "description") || xml.equals(name, "interface") || xml.equals(name, "request") || xml.equals(name, "event") || xml.equals(name, "arg") || xml.equals(name, "enum") || xml.equals(name, "entry") {
        return report(parser, ErrorKind.misplacedElement, parser.*.token.*.offset)
    }
    return report(parser, ErrorKind.unknownElement, parser.*.token.*.offset)
}

fn parseMessage(parser: *Parser, interface: *Interface, interface_index: usize, is_event: bool) -> bool {
    const offset = parser.*.token.*.offset
    var set: AttributeSet = undefined
    if !readAttributes(parser, &set, A_NAME | A_TYPE | A_SINCE | A_DEPRECATED) { return false }
    if !checkName(parser, &set, false, offset) { return false }
    var message: Message = undefined
    message.name = set.name
    message.offset = offset
    message.interfaceIndex = interface_index
    message.destructor = false
    if set.hasKind {
        if !xml.equals(set.kind, "destructor") { return report(parser, ErrorKind.invalidMessageType, offset) }
        message.destructor = true
    }
    var since: u32 = 1
    var deprecated_since: u32 = 0
    if !sinceValue(parser, &set, interface.*.version, &since, &deprecated_since, offset) { return false }
    message.since = since
    message.deprecatedSince = deprecated_since
    if !is_event && xml.equals(set.name, "destroy") && !message.destructor { return report(parser, ErrorKind.destroyNotDestructor, offset) }
    message.description = emptyDescription(parser.*.protocol)
    message.firstArg = parser.*.protocol.*.args.length
    message.argCount = 0
    const count = if is_event { interface.*.eventCount } else { interface.*.requestCount }
    message.opcode = @intCast(u16, count)
    var index: usize = 0
    while index < count {
        const other = if is_event { eventAt(parser.*.protocol, interface, index) } else { requestAt(parser.*.protocol, interface, index) }
        if string.eql(other.*.name, message.name) { return report(parser, ErrorKind.duplicateName, offset) }
        index += 1
    }
    while true {
        if !skipMisc(parser) { return false }
        if parser.*.token.*.kind == xml.TokenKind.elementEnd { break }
        if parser.*.token.*.kind != xml.TokenKind.elementStart { return report(parser, ErrorKind.xml, parser.*.token.*.offset) }
        if xml.equals(parser.*.token.*.name, "description") {
            if message.argCount > 0 { return report(parser, ErrorKind.misplacedElement, parser.*.token.*.offset) }
            var description = message.description
            if !parseDescription(parser, &description) { return false }
            message.description = description
        } else if xml.equals(parser.*.token.*.name, "arg") {
            if !parseArg(parser, &message) { return false }
        } else {
            return reportElement(parser)
        }
    }
    if is_event {
        unsafe {
            if !append(parser, TABLE_EVENTS, @ptrCast([*]const u8, &message)) { return false }
        }
        interface.*.eventCount += 1
    } else {
        unsafe {
            if !append(parser, TABLE_REQUESTS, @ptrCast([*]const u8, &message)) { return false }
        }
        interface.*.requestCount += 1
    }
    return advance(parser)
}

fn parseEntry(parser: *Parser, interface: *Interface, enumeration: *Enum) -> bool {
    const offset = parser.*.token.*.offset
    var set: AttributeSet = undefined
    if !readAttributes(parser, &set, A_NAME | A_VALUE | A_SUMMARY | A_SINCE | A_DEPRECATED) { return false }
    if !checkName(parser, &set, true, offset) { return false }
    var entry: Entry = undefined
    entry.name = set.name
    entry.offset = offset
    if !set.hasValue { return report(parser, ErrorKind.missingAttribute, offset) }
    var value: u32 = 0
    if !parseEntryValue(set.value, &value) { return report(parser, ErrorKind.invalidEntryValue, offset) }
    entry.value = value
    var since: u32 = 1
    var deprecated_since: u32 = 0
    if !sinceValue(parser, &set, interface.*.version, &since, &deprecated_since, offset) { return false }
    entry.since = since
    entry.deprecatedSince = deprecated_since
    entry.summary = set.summary
    entry.hasSummary = set.hasSummary
    var index: usize = 0
    while index < enumeration.*.entryCount {
        if string.eql(entryAt(parser.*.protocol, enumeration, index).*.name, entry.name) { return report(parser, ErrorKind.duplicateName, offset) }
        index += 1
    }
    unsafe {
        if !append(parser, TABLE_ENTRIES, @ptrCast([*]const u8, &entry)) { return false }
    }
    enumeration.*.entryCount += 1
    var ignored = emptyDescription(parser.*.protocol)
    while true {
        if !skipMisc(parser) { return false }
        if parser.*.token.*.kind == xml.TokenKind.elementEnd { return advance(parser) }
        if parser.*.token.*.kind != xml.TokenKind.elementStart { return report(parser, ErrorKind.xml, parser.*.token.*.offset) }
        if !xml.equals(parser.*.token.*.name, "description") { return reportElement(parser) }
        if !parseDescription(parser, &ignored) { return false }
    }
    return true
}

fn parseEnum(parser: *Parser, interface: *Interface) -> bool {
    const offset = parser.*.token.*.offset
    var set: AttributeSet = undefined
    if !readAttributes(parser, &set, A_NAME | A_SINCE | A_BITFIELD) { return false }
    if !checkName(parser, &set, true, offset) { return false }
    var enumeration: Enum = undefined
    enumeration.name = set.name
    enumeration.offset = offset
    var bitfield = false
    if set.hasBitfield {
        if !parseBoolean(set.bitfield, &bitfield) { return report(parser, ErrorKind.invalidBoolean, offset) }
    }
    enumeration.bitfield = bitfield
    var since: u32 = 1
    var ignored_deprecation: u32 = 0
    if !sinceValue(parser, &set, interface.*.version, &since, &ignored_deprecation, offset) { return false }
    enumeration.since = since
    enumeration.description = emptyDescription(parser.*.protocol)
    enumeration.firstEntry = parser.*.protocol.*.entries.length
    enumeration.entryCount = 0
    var index: usize = 0
    while index < interface.*.enumCount {
        if string.eql(enumAt(parser.*.protocol, interface, index).*.name, enumeration.name) { return report(parser, ErrorKind.duplicateName, offset) }
        index += 1
    }
    while true {
        if !skipMisc(parser) { return false }
        if parser.*.token.*.kind == xml.TokenKind.elementEnd { break }
        if parser.*.token.*.kind != xml.TokenKind.elementStart { return report(parser, ErrorKind.xml, parser.*.token.*.offset) }
        if xml.equals(parser.*.token.*.name, "description") {
            if enumeration.entryCount > 0 { return report(parser, ErrorKind.misplacedElement, parser.*.token.*.offset) }
            var description = enumeration.description
            if !parseDescription(parser, &description) { return false }
            enumeration.description = description
        } else if xml.equals(parser.*.token.*.name, "entry") {
            if !parseEntry(parser, interface, &enumeration) { return false }
        } else {
            return reportElement(parser)
        }
    }
    if enumeration.entryCount == 0 { return report(parser, ErrorKind.emptyEnum, offset) }
    unsafe {
        if !append(parser, TABLE_ENUMS, @ptrCast([*]const u8, &enumeration)) { return false }
    }
    interface.*.enumCount += 1
    return advance(parser)
}

fn parseInterface(parser: *Parser) -> bool {
    const offset = parser.*.token.*.offset
    var set: AttributeSet = undefined
    if !readAttributes(parser, &set, A_NAME | A_VERSION | A_FROZEN) { return false }
    if !checkName(parser, &set, false, offset) { return false }
    var interface: Interface = undefined
    interface.name = set.name
    interface.offset = offset
    if !set.hasVersion { return report(parser, ErrorKind.missingAttribute, offset) }
    var version: u32 = 0
    if !parseVersion(set.version, &version) { return report(parser, ErrorKind.invalidInteger, offset) }
    if version == 0 { return report(parser, ErrorKind.missingAttribute, offset) }
    interface.version = version
    var frozen = false
    if set.hasFrozen {
        if !parseBoolean(set.frozen, &frozen) { return report(parser, ErrorKind.invalidBoolean, offset) }
        if frozen && version != 1 { return report(parser, ErrorKind.frozenVersion, offset) }
    }
    interface.frozen = frozen
    if findInterface(parser.*.protocol, interface.name) != null { return report(parser, ErrorKind.duplicateName, offset) }
    interface.description = emptyDescription(parser.*.protocol)
    interface.firstRequest = parser.*.protocol.*.requests.length
    interface.requestCount = 0
    interface.firstEvent = parser.*.protocol.*.events.length
    interface.eventCount = 0
    interface.firstEnum = parser.*.protocol.*.enums.length
    interface.enumCount = 0
    const interface_index = parser.*.protocol.*.interfaces.length
    var saw_member = false
    while true {
        if !skipMisc(parser) { return false }
        if parser.*.token.*.kind == xml.TokenKind.elementEnd { break }
        if parser.*.token.*.kind != xml.TokenKind.elementStart { return report(parser, ErrorKind.xml, parser.*.token.*.offset) }
        const name = parser.*.token.*.name
        if xml.equals(name, "description") {
            if saw_member { return report(parser, ErrorKind.misplacedElement, parser.*.token.*.offset) }
            var description = interface.description
            if !parseDescription(parser, &description) { return false }
            interface.description = description
        } else if xml.equals(name, "request") {
            saw_member = true
            if !parseMessage(parser, &interface, interface_index, false) { return false }
        } else if xml.equals(name, "event") {
            saw_member = true
            if !parseMessage(parser, &interface, interface_index, true) { return false }
        } else if xml.equals(name, "enum") {
            saw_member = true
            if !parseEnum(parser, &interface) { return false }
        } else {
            return reportElement(parser)
        }
    }
    unsafe {
        if !append(parser, TABLE_INTERFACES, @ptrCast([*]const u8, &interface)) { return false }
    }
    return advance(parser)
}

fn parseRoot(parser: *Parser) -> bool {
    const offset = parser.*.token.*.offset
    if !xml.equals(parser.*.token.*.name, "protocol") { return report(parser, ErrorKind.unexpectedRoot, offset) }
    var set: AttributeSet = undefined
    if !readAttributes(parser, &set, A_NAME) { return false }
    if !checkName(parser, &set, false, offset) { return false }
    parser.*.protocol.*.name = set.name
    var saw_interface = false
    while true {
        if !skipMisc(parser) { return false }
        if parser.*.token.*.kind == xml.TokenKind.elementEnd { break }
        if parser.*.token.*.kind != xml.TokenKind.elementStart { return report(parser, ErrorKind.xml, parser.*.token.*.offset) }
        const name = parser.*.token.*.name
        if xml.equals(name, "copyright") {
            if saw_interface || parser.*.protocol.*.description.present { return report(parser, ErrorKind.misplacedElement, parser.*.token.*.offset) }
            if parser.*.protocol.*.hasCopyright { return report(parser, ErrorKind.duplicateElement, parser.*.token.*.offset) }
            var copyright_set: AttributeSet = undefined
            if !readAttributes(parser, &copyright_set, 0) { return false }
            var copyright: String = undefined
            if !readTextContent(parser, &copyright) { return false }
            parser.*.protocol.*.copyright = copyright
            parser.*.protocol.*.hasCopyright = true
            if !advance(parser) { return false }
        } else if xml.equals(name, "description") {
            if saw_interface { return report(parser, ErrorKind.misplacedElement, parser.*.token.*.offset) }
            var description = parser.*.protocol.*.description
            if !parseDescription(parser, &description) { return false }
            parser.*.protocol.*.description = description
        } else if xml.equals(name, "interface") {
            saw_interface = true
            if !parseInterface(parser) { return false }
        } else {
            return reportElement(parser)
        }
    }
    if !saw_interface { return report(parser, ErrorKind.missingInterface, offset) }
    return advance(parser)
}

// Cross-checks performed after the document is complete, as in
// wayland-scanner `verify_arguments`: enum-typed arguments must be int or
// uint, and a bitfield enum resolvable inside this protocol must be
// referenced by uint.
fn verify(parser: *Parser) -> bool {
    const protocol = parser.*.protocol
    var index: usize = 0
    while index < protocol.*.args.length {
        var arg: *Arg = undefined
        unsafe { arg = @ptrCast(*Arg, protocol.*.args.at(index)) }
        if arg.*.enumName.length > 0 && arg.*.kind == ArgType.int {
            var interface_part: String = undefined
            var enum_part: String = undefined
            splitEnumReference(arg.*.enumName, &interface_part, &enum_part)
            var owner: ?*Interface = null
            if interface_part.length > 0 {
                owner = findInterface(protocol, interface_part)
            } else {
                owner = ownerOfArg(protocol, index)
            }
            if owner != null {
                const enumeration = findEnum(protocol, owner.?, enum_part)
                if enumeration != null && enumeration.?.*.bitfield { return report(parser, ErrorKind.bitfieldIntArgument, arg.*.offset) }
            }
        }
        index += 1
    }
    return true
}

// The interface that owns the argument at `arg_index`.
pub fn ownerOfArg(protocol: *const Protocol, arg_index: usize) -> ?*Interface {
    var index: usize = 0
    while index < interfaceCount(protocol) {
        const interface = interfaceAt(protocol, index)
        var request: usize = 0
        while request < interface.*.requestCount {
            const message = requestAt(protocol, interface, request)
            if arg_index >= message.*.firstArg && arg_index < message.*.firstArg + message.*.argCount { return interface }
            request += 1
        }
        var event: usize = 0
        while event < interface.*.eventCount {
            const message = eventAt(protocol, interface, event)
            if arg_index >= message.*.firstArg && arg_index < message.*.firstArg + message.*.argCount { return interface }
            event += 1
        }
        index += 1
    }
    return null
}

fn initProtocol(protocol: *Protocol, allocator: Allocator, source: [*]const u8, length: usize) -> void {
    protocol.*.allocator = allocator
    protocol.*.source = source
    protocol.*.sourceLength = length
    protocol.*.name = string.fromParts(source, 0)
    protocol.*.copyright = string.fromParts(source, 0)
    protocol.*.hasCopyright = false
    protocol.*.description = emptyDescription(protocol)
    var interfaces: Vector = undefined
    Vector.initAt(&interfaces, allocator, @sizeOf(Interface), @alignOf(Interface), 32)
    var requests: Vector = undefined
    Vector.initAt(&requests, allocator, @sizeOf(Message), @alignOf(Message), 128)
    var events: Vector = undefined
    Vector.initAt(&events, allocator, @sizeOf(Message), @alignOf(Message), 128)
    var args: Vector = undefined
    Vector.initAt(&args, allocator, @sizeOf(Arg), @alignOf(Arg), 256)
    var enums: Vector = undefined
    Vector.initAt(&enums, allocator, @sizeOf(Enum), @alignOf(Enum), 64)
    var entries: Vector = undefined
    Vector.initAt(&entries, allocator, @sizeOf(Entry), @alignOf(Entry), 256)
    protocol.*.interfaces = interfaces
    protocol.*.requests = requests
    protocol.*.events = events
    protocol.*.args = args
    protocol.*.enums = enums
    protocol.*.entries = entries
}

// Parses and validates one protocol document. On success `protocol` owns
// allocator-backed tables that `deinit` releases; on failure the tables are
// released and `diagnostic` describes the first error.
pub fn parse(protocol: *Protocol, allocator: Allocator, source: [*]const u8, length: usize, diagnostic: *Diagnostic) -> bool {
    diagnostic.*.kind = ErrorKind.none
    diagnostic.*.xmlCode = xml.ErrorCode.none
    diagnostic.*.offset = 0
    diagnostic.*.line = 0
    diagnostic.*.column = 0
    initProtocol(protocol, allocator, source, length)
    var tokenizer: xml.Tokenizer = undefined
    var token: xml.Token = undefined
    xml.initAt(&tokenizer, source, length)
    var parser: Parser = undefined
    parser.tokenizer = &tokenizer
    parser.token = &token
    parser.protocol = protocol
    parser.diagnostic = diagnostic
    var ok = advance(&parser)
    if ok {
        // Prolog: XML declaration, comments, doctype and whitespace.
        while ok && parser.token.*.kind != xml.TokenKind.elementStart && parser.token.*.kind != xml.TokenKind.endOfDocument && parser.token.*.kind != xml.TokenKind.invalid {
            if parser.token.*.kind == xml.TokenKind.text && !xml.isBlank(parser.token.*.value) {
                ok = report(&parser, ErrorKind.unexpectedText, parser.token.*.offset)
            } else {
                ok = advance(&parser)
            }
        }
    }
    if ok && parser.token.*.kind != xml.TokenKind.elementStart { ok = report(&parser, ErrorKind.unexpectedRoot, parser.token.*.offset) }
    if ok { ok = parseRoot(&parser) }
    // Epilog: only comments, processing instructions and whitespace.
    while ok && parser.token.*.kind != xml.TokenKind.endOfDocument {
        ok = advance(&parser)
    }
    if ok { ok = verify(&parser) }
    if !ok {
        deinit(protocol)
        return false
    }
    return true
}
