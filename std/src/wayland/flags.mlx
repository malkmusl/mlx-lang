// std.wayland.flags: helpers for bitfield enums.
//
// Generated bitfield enums (for example wl_seat.Capability) carry the exact
// XML bit values with u32 backing. Mlx has no operator overloading, so sets
// of flags are plain u32 masks combined with these helpers:
//
//     const mask = flags.with(0, @intFromEnum(wl.wl_seat.Capability.pointer))
//     if flags.has(capabilities, @intFromEnum(wl.wl_seat.Capability.keyboard)) { ... }

pub fn has(mask: u32, flag: u32) -> bool { return (mask & flag) == flag }
pub fn any(mask: u32, flags: u32) -> bool { return (mask & flags) != 0 }
pub fn with(mask: u32, flag: u32) -> u32 { return mask | flag }
pub fn without(mask: u32, flag: u32) -> u32 { return mask & (4294967295 ^ flag) }
pub fn combine(first: u32, second: u32) -> u32 { return first | second }
