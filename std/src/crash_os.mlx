// What std.crash asks of the operating system: Linux's here (signals,
// /proc/self); crash_os.brixos.mlx has brixOS's own (the fault event
// through the one upcall, process_self, node calls), which the compiler
// takes for --target=x86_64-brixos. The report itself is std.crash's.
const linux = @import("../bootstrap/os/linux.mlx")
const fs = @import("../bootstrap/fs.mlx")

// The handler std.crash gives: (signal, siginfo_t*, ucontext_t*), as a
// signal handler takes them.
pub const Crashed = fn(signal: i32, info: usize, context: usize) -> void

// What fail() sends itself.
pub const FAIL_SIGNAL: usize = 12

const SA_SIGINFO: usize = 4
const SA_ONSTACK: usize = 134217728
const SA_RESTORER: usize = 67108864
// A fault in the handler runs it again (it knows it is in there: the
// second time it says what it had and ends).
const SA_NODEFER: usize = 1073741824

const SignalAction = struct {
    handler: usize
    flags: usize
    restorer: usize
    mask: usize
}

pub fn threadId() -> u32 { return @intCast(u32, linux.syscall0(linux.SYS_gettid)) }

pub fn processId() -> usize { return @bitCast(usize, linux.getpid()) }

// A second waits (another thread says its crash and ends the process).
pub fn idle() -> void { linux.sleepMilliseconds(1000) }

pub fn exit(code: usize) -> void { linux.exitGroup(code) }

pub fn mapMemory(size: usize) -> usize { return linux.mapAnonymous(size) }

pub fn unmapMemory(address: usize, size: usize) -> void { linux.munmap(address, size) }

// Whether the page holding `address` is mapped (the stack ends somewhere
// above the frame that crashed).
pub fn pageMapped(address: usize) -> bool {
    var residency: [1]u8 = [1]u8{ 0 }
    return linux.syscall3(linux.SYS_mincore, address & 18446744073709547520, 4096, @intFromPtr(&residency)) == 0
}

// The process's mappings as /proc/self/maps lists them; 0 bytes where the
// kernel has no such file (std.crash reads the program's file instead).
pub fn processMaps(into: [*]u8, capacity: usize) -> usize { return fs.readFile("/proc/self/maps".pointer, into, capacity) }

// The program's own file, opened (by the link itself: the path it names
// may be another file by now); its path into `into`.
pub fn openOwnImage() -> isize { return linux.syscall3(linux.SYS_open, @intFromPtr("/proc/self/exe".pointer), 0, 0) }

pub fn ownImagePath(into: [*]u8, capacity: usize) -> usize {
    const linked = linux.syscall3(linux.SYS_readlink, @intFromPtr("/proc/self/exe".pointer), @intFromPtr(into), capacity)
    return if linked > 0 { @bitCast(usize, linked) } else { 0 }
}

pub fn openFile(path: [*]const u8) -> isize {
    var descriptor_path: [32]u8 = undefined
    var opened = path
    if memfdPath(path, &descriptor_path) { opened = &descriptor_path }
    return linux.syscall3(linux.SYS_open, @intFromPtr(opened), 0, 0)
}

pub fn fileSize(file: isize) -> isize { return linux.syscall3(linux.SYS_lseek, @bitCast(usize, file), 0, 2) }

// The file mapped read-only (private): its address, or below 0.
pub fn mapFile(file: isize, size: usize) -> isize { return linux.syscall6(linux.SYS_mmap, 0, size, 1, 2, @bitCast(usize, file), 0) }

// Up to `count` bytes of `file` from `offset` to `address`: how many, 0
// at its end, below 0 on an error (-4: interrupted).
pub fn readAt(file: isize, address: usize, count: usize, offset: usize) -> isize {
    return linux.syscall4(linux.SYS_pread64, @bitCast(usize, file), address, count, offset)
}

pub fn closeFile(file: isize) -> void { linux.close(file) }

// fail()'s signal with its siginfo (the reason as its value), queued to
// this thread; false when it cannot be.
pub fn queueFailure(info: usize) -> bool {
    return linux.syscall4(linux.SYS_rt_tgsigqueueinfo, @bitCast(usize, linux.getpid()), @bitCast(usize, linux.syscall0(linux.SYS_gettid)), linux.SIGUSR2, info) == 0
}

// The kernel insists on a return path for the handler (SA_RESTORER) even
// though ours never returns.
export fn mlxCompositorSignalReturn() -> void {
    _ = linux.syscall0(linux.SYS_rt_sigreturn)
}

// `crashed` for the fatal signals and fail()'s, on a stack of its own
// (`stack`, `size` bytes); false when the kernel refused one.
pub fn install(crashed: Crashed, stack: usize, size: usize) -> bool {
    // The alternate stack (stack_t: sp, flags, size).
    var alternate: [3]usize = [3]usize{ stack, 0, size }
    if linux.syscall2(linux.SYS_sigaltstack, @intFromPtr(&alternate), 0) != 0 { return false }
    var restorer: usize = 0
    unsafe { restorer = @intFromPtr(mlxCompositorSignalReturn) }
    // SA_NODEFER: a handler that faults runs again, and knows it.
    var action = SignalAction.{ .handler = @intFromPtr(crashed), .flags = SA_SIGINFO | SA_ONSTACK | SA_RESTORER | SA_NODEFER, .restorer = restorer, .mask = 0 }
    var ok = true
    const signals: [7]usize = [7]usize{ linux.SIGILL, linux.SIGSEGV, linux.SIGBUS, linux.SIGFPE, linux.SIGABRT, linux.SIGTRAP, linux.SIGUSR2 }
    for signal in signals {
        if linux.syscall4(linux.SYS_rt_sigaction, signal, @intFromPtr(&action), 0, 8) != 0 { ok = false }
    }
    return ok
}

fn appendText(into: [*]u8, at: *usize, text: []const u8) -> void {
    for byte in text {
        into[at.*] = byte
        at.* += 1
    }
}

// "/memfd:NAME (deleted)" in /proc/self/maps, which cannot be opened by
// that name; the descriptor the program keeps for it can, as
// /proc/self/fd/N. Finds that N by its link; the path "/proc/self/fd/N"
// goes into `into` (32 bytes).
fn memfdPath(path: [*]const u8, into: [*]u8) -> bool {
    var is_memfd = true
    const prefix = "/memfd:"
    var index: usize = 0
    while index < prefix.length {
        if path[index] != prefix[index] { is_memfd = false }
        index += 1
    }
    if !is_memfd { return false }
    var path_length: usize = 0
    while path[path_length] != 0 { path_length += 1 }
    var directory_name: [14]u8 = [14]u8{ 47, 112, 114, 111, 99, 47, 115, 101, 108, 102, 47, 102, 100, 0 }
    const directory = linux.syscall3(linux.SYS_open, @intFromPtr(&directory_name), 65536, 0)
    if directory < 0 { return false }
    var entries: [2048]u8 = undefined
    var link: [512]u8 = undefined
    var found = false
    var more = true
    while more && !found {
        const got = linux.syscall3(linux.SYS_getdents64, @bitCast(usize, directory), @intFromPtr(&entries), 2048)
        if got <= 0 {
            more = false
        } else {
            // struct linux_dirent64: d_ino (8), d_off (8), d_reclen (2),
            // d_type (1), the name.
            var at: usize = 0
            while at + 19 < @bitCast(usize, got) && !found {
                const record_length = @intCast(usize, entries[at + 16]) | (@intCast(usize, entries[at + 17]) << 8)
                if record_length == 0 { break }
                var name_length: usize = 0
                var numeric = true
                while entries[at + 19 + name_length] != 0 {
                    const byte = entries[at + 19 + name_length]
                    if byte < 48 || byte > 57 { numeric = false }
                    name_length += 1
                }
                if numeric && name_length > 0 && name_length < 12 {
                    var candidate: usize = 0
                    appendText(into, &candidate, "/proc/self/fd/")
                    var k: usize = 0
                    while k < name_length {
                        into[candidate] = entries[at + 19 + k]
                        candidate += 1
                        k += 1
                    }
                    into[candidate] = 0
                    const linked = linux.syscall3(linux.SYS_readlink, @intFromPtr(into), @intFromPtr(&link), 511)
                    if linked > 0 && @bitCast(usize, linked) == path_length {
                        var same = true
                        var byte_index: usize = 0
                        while byte_index < path_length {
                            if link[byte_index] != path[byte_index] { same = false }
                            byte_index += 1
                        }
                        if same { found = true }
                    }
                }
                at += record_length
            }
        }
    }
    linux.close(directory)
    return found
}
