// std.sha2: SHA-256 and SHA-512 (FIPS 180-4), HMAC-SHA256 (RFC 2104) and
// PBKDF2-HMAC-SHA256 (RFC 8018).
//
//     var hashing: sha2.Sha256 = undefined
//     sha2.sha256Init(&hashing)
//     sha2.sha256Update(&hashing, bytes)
//     var digest: [32]u8 = undefined
//     sha2.sha256Final(&hashing, &digest)       // wipes the state
//
//     sha2.hmacSha256(key, message, &digest)
//     sha2.pbkdf2Sha256(password, salt, rounds, out, length)
//
// The states are wiped when they are finished: they hold what was
// hashed.

const linux = @import("../bootstrap/os/linux.mlx")

const MASK32: u32 = 4294967295

pub const Sha256 = struct {
    state: [8]u32
    block: [64]u8
    filled: usize
    total: u64
}

pub const Sha512 = struct {
    state: [8]u64
    block: [128]u8
    filled: usize
    total: u64
}

fn rotate32(value: u32, count: u32) -> u32 {
    return (value >> count) | ((value << (32 - count)) & MASK32)
}

fn rotate64(value: u64, count: u64) -> u64 {
    return (value >> count) | (value << (64 - count))
}

fn load32(bytes: [*]const u8, at: usize) -> u32 {
    return (@intCast(u32, bytes[at]) << 24) | (@intCast(u32, bytes[at + 1]) << 16) | (@intCast(u32, bytes[at + 2]) << 8) | @intCast(u32, bytes[at + 3])
}

fn load64(bytes: [*]const u8, at: usize) -> u64 {
    return (@intCast(u64, load32(bytes, at)) << 32) | @intCast(u64, load32(bytes, at + 4))
}

fn store32(bytes: [*]u8, at: usize, value: u32) -> void {
    bytes[at] = @intCast(u8, (value >> 24) & 255)
    bytes[at + 1] = @intCast(u8, (value >> 16) & 255)
    bytes[at + 2] = @intCast(u8, (value >> 8) & 255)
    bytes[at + 3] = @intCast(u8, value & 255)
}

fn store64(bytes: [*]u8, at: usize, value: u64) -> void {
    store32(bytes, at, @intCast(u32, value >> 32))
    store32(bytes, at + 4, @intCast(u32, value & 4294967295))
}

// Zeroes `length` bytes (what a password left behind).
pub fn wipe(bytes: [*]u8, length: usize) -> void {
    var index: usize = 0
    while index < length {
        bytes[index] = 0
        index += 1
    }
}

fn compress256(hashing: *Sha256) -> void {
    var block: [*]const u8 = undefined
    unsafe { block = @ptrCast([*]const u8, &hashing.*.block) }
    var k: [64]u32 = [64]u32{ 1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221, 3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580, 3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986, 2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037, 2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344, 430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779, 1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298 }
    var w: [64]u32 = undefined
    var index: usize = 0
    while index < 16 {
        w[index] = load32(block, index * 4)
        index += 1
    }
    while index < 64 {
        const x = w[index - 15]
        const y = w[index - 2]
        const s0 = rotate32(x, 7) ^ rotate32(x, 18) ^ (x >> 3)
        const s1 = rotate32(y, 17) ^ rotate32(y, 19) ^ (y >> 10)
        w[index] = w[index - 16] +% s0 +% w[index - 7] +% s1
        index += 1
    }
    var a = hashing.*.state[0]
    var b = hashing.*.state[1]
    var c = hashing.*.state[2]
    var d = hashing.*.state[3]
    var e = hashing.*.state[4]
    var f = hashing.*.state[5]
    var g = hashing.*.state[6]
    var h = hashing.*.state[7]
    index = 0
    while index < 64 {
        const sum1 = rotate32(e, 6) ^ rotate32(e, 11) ^ rotate32(e, 25)
        const choice = (e & f) ^ ((e ^ MASK32) & g)
        const first = h +% sum1 +% choice +% k[index] +% w[index]
        const sum0 = rotate32(a, 2) ^ rotate32(a, 13) ^ rotate32(a, 22)
        const majority = (a & b) ^ (a & c) ^ (b & c)
        const second = sum0 +% majority
        h = g
        g = f
        f = e
        e = d +% first
        d = c
        c = b
        b = a
        a = first +% second
        index += 1
    }
    hashing.*.state[0] = hashing.*.state[0] +% a
    hashing.*.state[1] = hashing.*.state[1] +% b
    hashing.*.state[2] = hashing.*.state[2] +% c
    hashing.*.state[3] = hashing.*.state[3] +% d
    hashing.*.state[4] = hashing.*.state[4] +% e
    hashing.*.state[5] = hashing.*.state[5] +% f
    hashing.*.state[6] = hashing.*.state[6] +% g
    hashing.*.state[7] = hashing.*.state[7] +% h
    var words: [*]u8 = undefined
    unsafe { words = @ptrCast([*]u8, &w) }
    wipe(words, 256)
}

pub fn sha256Init(hashing: *Sha256) -> void {
    hashing.*.state = [8]u32{ 1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225 }
    hashing.*.filled = 0
    hashing.*.total = 0
}

pub fn sha256Update(hashing: *Sha256, bytes: []const u8) -> void {
    var index: usize = 0
    while index < bytes.length {
        hashing.*.block[hashing.*.filled] = bytes[index]
        hashing.*.filled += 1
        if hashing.*.filled == 64 {
            compress256(hashing)
            hashing.*.filled = 0
        }
        index += 1
    }
    hashing.*.total +%= @intCast(u64, bytes.length)
}

pub fn sha256Final(hashing: *Sha256, digest: *[32]u8) -> void {
    const bits = hashing.*.total *% 8
    var padding: [72]u8 = undefined
    padding[0] = 128
    var length: usize = 1
    while (hashing.*.filled + length) % 64 != 56 {
        padding[length] = 0
        length += 1
    }
    var tail: [*]u8 = undefined
    unsafe { tail = @ptrCast([*]u8, &padding) }
    store64(tail, length, bits)
    sha256Update(hashing, tail[0 .. length + 8])
    var out: [*]u8 = undefined
    unsafe { out = @ptrCast([*]u8, digest) }
    var index: usize = 0
    while index < 8 {
        store32(out, index * 4, hashing.*.state[index])
        index += 1
    }
    var everything: [*]u8 = undefined
    unsafe { everything = @ptrCast([*]u8, hashing) }
    wipe(everything, 112)
}

pub fn sha256(bytes: []const u8, digest: *[32]u8) -> void {
    var hashing: Sha256 = undefined
    sha256Init(&hashing)
    sha256Update(&hashing, bytes)
    sha256Final(&hashing, digest)
}

fn compress512(hashing: *Sha512) -> void {
    var block: [*]const u8 = undefined
    unsafe { block = @ptrCast([*]const u8, &hashing.*.block) }
    var k: [80]u64 = [80]u64{ 4794697086780616226, 8158064640168781261, 13096744586834688815, 16840607885511220156, 4131703408338449720, 6480981068601479193, 10538285296894168987, 12329834152419229976, 15566598209576043074, 1334009975649890238, 2608012711638119052, 6128411473006802146, 8268148722764581231, 9286055187155687089, 11230858885718282805, 13951009754708518548, 16472876342353939154, 17275323862435702243, 1135362057144423861, 2597628984639134821, 3308224258029322869, 5365058923640841347, 6679025012923562964, 8573033837759648693, 10970295158949994411, 12119686244451234320, 12683024718118986047, 13788192230050041572, 14330467153632333762, 15395433587784984357, 489312712824947311, 1452737877330783856, 2861767655752347644, 3322285676063803686, 5560940570517711597, 5996557281743188959, 7280758554555802590, 8532644243296465576, 9350256976987008742, 10552545826968843579, 11727347734174303076, 12113106623233404929, 14000437183269869457, 14369950271660146224, 15101387698204529176, 15463397548674623760, 17586052441742319658, 1182934255886127544, 1847814050463011016, 2177327727835720531, 2830643537854262169, 3796741975233480872, 4115178125766777443, 5681478168544905931, 6601373596472566643, 7507060721942968483, 8399075790359081724, 8693463985226723168, 9568029438360202098, 10144078919501101548, 10430055236837252648, 11840083180663258601, 13761210420658862357, 14299343276471374635, 14566680578165727644, 15097957966210449927, 16922976911328602910, 17689382322260857208, 500013540394364858, 748580250866718886, 1242879168328830382, 1977374033974150939, 2944078676154940804, 3659926193048069267, 4368137639120453308, 4836135668995329356, 5532061633213252278, 6448918945643986474, 6902733635092675308, 7801388544844847127 }
    var w: [80]u64 = undefined
    var index: usize = 0
    while index < 16 {
        w[index] = load64(block, index * 8)
        index += 1
    }
    while index < 80 {
        const x = w[index - 15]
        const y = w[index - 2]
        const s0 = rotate64(x, 1) ^ rotate64(x, 8) ^ (x >> 7)
        const s1 = rotate64(y, 19) ^ rotate64(y, 61) ^ (y >> 6)
        w[index] = w[index - 16] +% s0 +% w[index - 7] +% s1
        index += 1
    }
    var a = hashing.*.state[0]
    var b = hashing.*.state[1]
    var c = hashing.*.state[2]
    var d = hashing.*.state[3]
    var e = hashing.*.state[4]
    var f = hashing.*.state[5]
    var g = hashing.*.state[6]
    var h = hashing.*.state[7]
    index = 0
    while index < 80 {
        const sum1 = rotate64(e, 14) ^ rotate64(e, 18) ^ rotate64(e, 41)
        const choice = (e & f) ^ (~e & g)
        const first = h +% sum1 +% choice +% k[index] +% w[index]
        const sum0 = rotate64(a, 28) ^ rotate64(a, 34) ^ rotate64(a, 39)
        const majority = (a & b) ^ (a & c) ^ (b & c)
        const second = sum0 +% majority
        h = g
        g = f
        f = e
        e = d +% first
        d = c
        c = b
        b = a
        a = first +% second
        index += 1
    }
    hashing.*.state[0] = hashing.*.state[0] +% a
    hashing.*.state[1] = hashing.*.state[1] +% b
    hashing.*.state[2] = hashing.*.state[2] +% c
    hashing.*.state[3] = hashing.*.state[3] +% d
    hashing.*.state[4] = hashing.*.state[4] +% e
    hashing.*.state[5] = hashing.*.state[5] +% f
    hashing.*.state[6] = hashing.*.state[6] +% g
    hashing.*.state[7] = hashing.*.state[7] +% h
    var words: [*]u8 = undefined
    unsafe { words = @ptrCast([*]u8, &w) }
    wipe(words, 640)
}

pub fn sha512Init(hashing: *Sha512) -> void {
    hashing.*.state = [8]u64{ 7640891576956012808, 13503953896175478587, 4354685564936845355, 11912009170470909681, 5840696475078001361, 11170449401992604703, 2270897969802886507, 6620516959819538809 }
    hashing.*.filled = 0
    hashing.*.total = 0
}

pub fn sha512Update(hashing: *Sha512, bytes: []const u8) -> void {
    var index: usize = 0
    while index < bytes.length {
        hashing.*.block[hashing.*.filled] = bytes[index]
        hashing.*.filled += 1
        if hashing.*.filled == 128 {
            compress512(hashing)
            hashing.*.filled = 0
        }
        index += 1
    }
    hashing.*.total +%= @intCast(u64, bytes.length)
}

pub fn sha512Final(hashing: *Sha512, digest: *[64]u8) -> void {
    const bits = hashing.*.total *% 8
    var padding: [144]u8 = undefined
    padding[0] = 128
    var length: usize = 1
    while (hashing.*.filled + length) % 128 != 112 {
        padding[length] = 0
        length += 1
    }
    var tail: [*]u8 = undefined
    unsafe { tail = @ptrCast([*]u8, &padding) }
    // The length is 128 bits; its upper half is 0.
    store64(tail, length, 0)
    store64(tail, length + 8, bits)
    sha512Update(hashing, tail[0 .. length + 16])
    var out: [*]u8 = undefined
    unsafe { out = @ptrCast([*]u8, digest) }
    var index: usize = 0
    while index < 8 {
        store64(out, index * 8, hashing.*.state[index])
        index += 1
    }
    var everything: [*]u8 = undefined
    unsafe { everything = @ptrCast([*]u8, hashing) }
    wipe(everything, 208)
}

pub fn sha512(bytes: []const u8, digest: *[64]u8) -> void {
    var hashing: Sha512 = undefined
    sha512Init(&hashing)
    sha512Update(&hashing, bytes)
    sha512Final(&hashing, digest)
}

// HMAC-SHA256 of `message` under `key`.
pub fn hmacSha256(key: []const u8, message: []const u8, digest: *[32]u8) -> void {
    var block: [64]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &block) }
    wipe(bytes, 64)
    if key.length > 64 {
        var short: [32]u8 = undefined
        sha256(key, &short)
        var index: usize = 0
        while index < 32 {
            block[index] = short[index]
            index += 1
        }
        var shortBytes: [*]u8 = undefined
        unsafe { shortBytes = @ptrCast([*]u8, &short) }
        wipe(shortBytes, 32)
    } else {
        var index: usize = 0
        while index < key.length {
            block[index] = key[index]
            index += 1
        }
    }
    var pad: [64]u8 = undefined
    var padBytes: [*]u8 = undefined
    unsafe { padBytes = @ptrCast([*]u8, &pad) }
    var index: usize = 0
    while index < 64 {
        pad[index] = block[index] ^ 54
        index += 1
    }
    var inner: Sha256 = undefined
    sha256Init(&inner)
    sha256Update(&inner, padBytes[0..64])
    sha256Update(&inner, message)
    var innerDigest: [32]u8 = undefined
    sha256Final(&inner, &innerDigest)
    index = 0
    while index < 64 {
        pad[index] = block[index] ^ 92
        index += 1
    }
    var innerBytes: [*]u8 = undefined
    unsafe { innerBytes = @ptrCast([*]u8, &innerDigest) }
    var outer: Sha256 = undefined
    sha256Init(&outer)
    sha256Update(&outer, padBytes[0..64])
    sha256Update(&outer, innerBytes[0..32])
    sha256Final(&outer, digest)
    wipe(bytes, 64)
    wipe(padBytes, 64)
    wipe(innerBytes, 32)
}

// PBKDF2 with HMAC-SHA256: `length` bytes from `password` and `salt` in
// `rounds` iterations, into `out`.
pub fn pbkdf2Sha256(password: []const u8, salt: []const u8, rounds: u64, out: [*]u8, length: usize) -> void {
    // The salt and the block's number, for the first iteration.
    var salted: [*]u8 = undefined
    const mapped = linux.syscall6(9, 0, salt.length + 4, 3, 34, 18446744073709551615, 0)
    if mapped < 0 { return }
    unsafe { salted = @ptrFromInt([*]u8, @bitCast(usize, mapped)) }
    var index: usize = 0
    while index < salt.length {
        salted[index] = salt[index]
        index += 1
    }
    var block: u32 = 1
    var done: usize = 0
    var u: [32]u8 = undefined
    var t: [32]u8 = undefined
    var uBytes: [*]u8 = undefined
    unsafe { uBytes = @ptrCast([*]u8, &u) }
    while done < length {
        store32(salted, salt.length, block)
        hmacSha256(password, salted[0 .. salt.length + 4], &u)
        index = 0
        while index < 32 {
            t[index] = u[index]
            index += 1
        }
        var round: u64 = 1
        while round < rounds {
            var next: [32]u8 = undefined
            hmacSha256(password, uBytes[0..32], &next)
            index = 0
            while index < 32 {
                u[index] = next[index]
                t[index] = t[index] ^ next[index]
                index += 1
            }
            round += 1
        }
        index = 0
        while index < 32 && done < length {
            out[done] = t[index]
            done += 1
            index += 1
        }
        block += 1
    }
    wipe(uBytes, 32)
    var tBytes: [*]u8 = undefined
    unsafe { tBytes = @ptrCast([*]u8, &t) }
    wipe(tBytes, 32)
    wipe(salted, salt.length + 4)
    const unmapped = linux.syscall2(11, @bitCast(usize, mapped), salt.length + 4)
}

