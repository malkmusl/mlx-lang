// std.heap: the program's heap. One general-purpose allocator
// (std.general_purpose_allocator: size classes carved out of slabs, free
// lists, one lock) over the page allocator, made on first use, that a
// program takes wherever it needs memory and passes to what it makes:
//
//     const allocator = std.heap.allocator()
//     var names = std.StringHashMap(u32).init(allocator)
//
// There is one heap for the process, not one per image: its state lives
// in the tiny-page region's header page (std.tinypage_allocator.shared()),
// which the program and every shared object and plugin it loads find at
// the same address, so that a block taken in one image is freed in
// another (the compositor's shell module hands its lists to the next
// version of itself). Where the region cannot be had, each image has a
// heap of its own, and a block given back to another image's heap goes
// on that heap's free list of the same size class, which is harmless.
//
// Under MLX_LEAK_CHECK, std.leaks wraps the heap in the debug allocator
// (watch): allocator() then hands out the debug allocator over the heap,
// so every block is seen with the functions that asked for it and the
// size class it took, and the heap's slabs (page_allocator.backing) are
// not blocks of the program's. deinit() gives the slabs back where a
// program ends on purpose; the operating system takes them otherwise.
const std = @import("std")

const gpa = std.general_purpose_allocator
const tiny = std.tinypage_allocator
const debug = std.debug_allocator
const pages = std.page_allocator

pub const Allocator = std.allocator.Allocator
pub const Heap = gpa.Heap

// The shared part of the header page: a state word (0 not made, 1 being
// made, 2 ready), the debug allocator watching the heap (0: none), the
// heap itself from HEAP_AT on.
const STATE_AT: usize = 0
const WATCH_AT: usize = 8
const HEAP_AT: usize = 64

// This image's own heap, where the region cannot be had.
var own: Heap = undefined
var ownState: u32 = 0
var ownWatch: usize = 0

// Found: the heap's address and the words' (0: this image's own).
var heap: usize = 0
var words: usize = 0

fn heapAt(address: usize) -> *Heap {
    unsafe { return @ptrFromInt(*Heap, address) }
}

fn wordAt(address: usize) -> *usize {
    unsafe { return @ptrFromInt(*usize, address) }
}

// Finds the heap, making it when this is the first to look (the others
// wait for it to be ready).
fn make() -> void {
    if heap != 0 { return }
    const shared = tiny.shared()
    var state: *u32 = &ownState
    var address = @intFromPtr(&own)
    if shared != 0 {
        unsafe { state = @ptrFromInt(*u32, shared + STATE_AT) }
        address = shared + HEAP_AT
    }
    const won = @cmpxchgStrong(u32, state, 0, 1, acquire, monotonic)
    if won.0 {
        heapAt(address).* = gpa.init(pages.backing())
        @atomicStore(u32, state, 2, release)
    } else {
        while @atomicLoad(u32, state, acquire) != 2 { _ = std.linux.thread.yield() }
    }
    words = shared
    heap = address
}

fn watchWord() -> *usize {
    if words == 0 { return &ownWatch }
    return wordAt(words + WATCH_AT)
}

// The heap itself.
pub fn pointer() -> *Heap {
    make()
    return heapAt(heap)
}

// The heap's blocks come zeroed, as the page allocator's do (a block
// the free list gives back again is cleared, and what a resize adds):
// the programs were written over zeroed pages.
fn zeroedAlloc(context: *anyopaque, length: usize, alignment: usize) -> ?[*]u8 {
    const inner = gpa.interface(heapOf(context))
    const block = inner.rawAlloc(length, alignment)
    if block != null { std.mem.zero(block.?, length) }
    return block
}

fn zeroedResize(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, new_length: usize) -> bool {
    const inner = gpa.interface(heapOf(context))
    if !inner.rawResize(memory, length, alignment, new_length) { return false }
    if new_length > length { std.mem.zero(memory + length, new_length - length) }
    return true
}

fn zeroedRemap(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, new_length: usize) -> ?[*]u8 {
    const inner = gpa.interface(heapOf(context))
    const moved = inner.rawRemap(memory, length, alignment, new_length)
    if moved != null && new_length > length { std.mem.zero(moved.? + length, new_length - length) }
    return moved
}

fn zeroedFree(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize) -> void {
    const inner = gpa.interface(heapOf(context))
    inner.rawFree(memory, length, alignment)
}

fn heapOf(context: *anyopaque) -> *Heap {
    unsafe { return @ptrCast(*Heap, context) }
}

fn zeroed(address: usize) -> Allocator {
    unsafe {
        return Allocator.{
            .context = @ptrCast(*anyopaque, heapAt(address)),
            .allocFn = zeroedAlloc,
            .resizeFn = zeroedResize,
            .remapFn = zeroedRemap,
            .freeFn = zeroedFree,
        }
    }
}

// The program's allocator: the heap, or under the leak check the debug
// allocator over it.
pub fn allocator() -> Allocator {
    make()
    const watching = @atomicLoad(usize, watchWord(), acquire)
    if watching != 0 {
        unsafe { return debug.interface(@ptrFromInt(*debug.DebugAllocator, watching)) }
    }
    return zeroed(heap)
}

// The heap's own interface, unwatched: what the debug allocator wraps.
pub fn raw() -> Allocator {
    make()
    return zeroed(heap)
}

// From now on allocator() is `state` over the heap (std.leaks); `state`
// must have been made with raw() as its child.
pub fn watch(state: *debug.DebugAllocator) -> void {
    make()
    @atomicStore(usize, watchWord(), @intFromPtr(state), release)
}

pub fn unwatch() -> void {
    make()
    @atomicStore(usize, watchWord(), 0, release)
}

// Whether the heap is the process's (in the shared region), not this
// image's alone.
pub fn isShared() -> bool {
    make()
    return words != 0
}

// Whether `address` is a class block of the heap's (in one of its slabs).
pub fn owns(address: usize) -> bool {
    make()
    return gpa.inSlab(heapAt(heap), address)
}

// What a block of the heap takes: its class size, or its pages.
pub fn footprint(address: usize, length: usize, alignment: usize) -> usize {
    make()
    return gpa.footprint(heapAt(heap), address, length, alignment)
}

// The bytes the program holds through the heap, its slabs and its large
// blocks out.
pub fn liveBytes() -> usize {
    make()
    return gpa.liveBytes(heapAt(heap))
}

pub fn slabCount() -> usize {
    make()
    return gpa.slabCount(heapAt(heap))
}

pub fn largeCount() -> usize {
    make()
    return gpa.largeCount(heapAt(heap))
}

// Gives the slabs back (large blocks still out stay the program's to
// free); the heap is empty afterwards and usable again.
pub fn deinit() -> void {
    make()
    gpa.deinit(heapAt(heap))
}
