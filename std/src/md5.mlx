// std.md5: MD5 (RFC 1321). MD5 is broken for collisions; it is here for
// the formats that still name files and check downloads by it (md5sum,
// the freedesktop thumbnail cache, GChecksum), not for anything that has
// to resist an attacker.
//
//     var hashing: md5.Md5 = undefined
//     md5.md5Init(&hashing)
//     md5.md5Update(&hashing, bytes)
//     var digest: [16]u8 = undefined
//     md5.md5Final(&hashing, &digest)          // wipes the state
//
//     md5.md5(bytes, &digest)
//     var text: [32]u8 = undefined
//     md5.md5Hex(bytes, &text)                 // 32 lower-case hex digits
const base64 = @import("std.base64")

const MASK32: u32 = 4294967295

pub const Md5 = struct {
    state: [4]u32
    block: [64]u8
    filled: usize
    total: u64
}

// The constants of the 64 steps (the integer part of 2^32 |sin(i)|) and
// each step's rotation.
const STEPS: [64]u32 = [64]u32{
    3614090360, 3905402710, 606105819, 3250441966, 4118548399, 1200080426, 2821735955, 4249261313,
    1770035416, 2336552879, 4294925233, 2304563134, 1804603682, 4254626195, 2792965006, 1236535329,
    4129170786, 3225465664, 643717713, 3921069994, 3593408605, 38016083, 3634488961, 3889429448,
    568446438, 3275163606, 4107603335, 1163531501, 2850285829, 4243563512, 1735328473, 2368359562,
    4294588738, 2272392833, 1839030562, 4259657740, 2763975236, 1272893353, 4139469664, 3200236656,
    681279174, 3936430074, 3572445317, 76029189, 3654602809, 3873151461, 530742520, 3299628645,
    4096336452, 1126891415, 2878612391, 4237533241, 1700485571, 2399980690, 4293915773, 2240044497,
    1873313359, 4264355552, 2734768916, 1309151649, 4149444226, 3174756917, 718787259, 3951481745,
}

const SHIFTS: [16]u32 = [16]u32{ 7, 12, 17, 22, 5, 9, 14, 20, 4, 11, 16, 23, 6, 10, 15, 21 }

fn rotate(value: u32, count: u32) -> u32 {
    return ((value << count) & MASK32) | (value >> (32 - count))
}

// A little-endian word.
fn load32(bytes: [*]const u8, at: usize) -> u32 {
    return @intCast(u32, bytes[at]) | (@intCast(u32, bytes[at + 1]) << 8) | (@intCast(u32, bytes[at + 2]) << 16) | (@intCast(u32, bytes[at + 3]) << 24)
}

fn store32(bytes: [*]u8, at: usize, value: u32) -> void {
    bytes[at] = @intCast(u8, value & 255)
    bytes[at + 1] = @intCast(u8, (value >> 8) & 255)
    bytes[at + 2] = @intCast(u8, (value >> 16) & 255)
    bytes[at + 3] = @intCast(u8, (value >> 24) & 255)
}

fn compress(hashing: *Md5) -> void {
    const block: [*]const u8 = &hashing.*.block
    var a = hashing.*.state[0]
    var b = hashing.*.state[1]
    var c = hashing.*.state[2]
    var d = hashing.*.state[3]
    var step: usize = 0
    while step < 64 {
        var f: u32 = 0
        var word: usize = 0
        if step < 16 {
            f = (b & c) | ((b ^ MASK32) & d)
            word = step
        } else if step < 32 {
            f = (d & b) | ((d ^ MASK32) & c)
            word = (5 * step + 1) % 16
        } else if step < 48 {
            f = b ^ c ^ d
            word = (3 * step + 5) % 16
        } else {
            f = c ^ (b | (d ^ MASK32))
            word = (7 * step) % 16
        }
        const sum = f +% a +% STEPS[step] +% load32(block, word * 4)
        a = d
        d = c
        c = b
        b = b +% rotate(sum, SHIFTS[(step / 16) * 4 + step % 4])
        step += 1
    }
    hashing.*.state[0] = hashing.*.state[0] +% a
    hashing.*.state[1] = hashing.*.state[1] +% b
    hashing.*.state[2] = hashing.*.state[2] +% c
    hashing.*.state[3] = hashing.*.state[3] +% d
}

pub fn md5Init(hashing: *Md5) -> void {
    hashing.*.state = [4]u32{ 1732584193, 4023233417, 2562383102, 271733878 }
    hashing.*.filled = 0
    hashing.*.total = 0
}

pub fn md5Update(hashing: *Md5, bytes: []const u8) -> void {
    var index: usize = 0
    while index < bytes.length {
        hashing.*.block[hashing.*.filled] = bytes[index]
        hashing.*.filled += 1
        if hashing.*.filled == 64 {
            compress(hashing)
            hashing.*.filled = 0
        }
        index += 1
    }
    hashing.*.total +%= bytes.length
}

pub fn md5Final(hashing: *Md5, digest: *[16]u8) -> void {
    const bits = hashing.*.total *% 8
    var padding: [72]u8 = undefined
    padding[0] = 128
    var length: usize = 1
    while (hashing.*.filled + length) % 64 != 56 {
        padding[length] = 0
        length += 1
    }
    const tail: [*]u8 = &padding
    // The length in bits, little-endian.
    store32(tail, length, @intCast(u32, bits & 4294967295))
    store32(tail, length + 4, @intCast(u32, bits >> 32))
    md5Update(hashing, tail[0 .. length + 8])
    const out: [*]u8 = unsafe { @ptrCast([*]u8, digest) }
    var index: usize = 0
    while index < 4 {
        store32(out, index * 4, hashing.*.state[index])
        index += 1
    }
    clear(hashing)
}

// The state zeroed, field by field: it holds what was hashed.
fn clear(hashing: *Md5) -> void {
    hashing.*.state = [4]u32{ 0, 0, 0, 0 }
    var index: usize = 0
    while index < 64 {
        hashing.*.block[index] = 0
        index += 1
    }
    hashing.*.filled = 0
    hashing.*.total = 0
}

pub fn md5(bytes: []const u8, digest: *[16]u8) -> void {
    var hashing: Md5 = undefined
    md5Init(&hashing)
    md5Update(&hashing, bytes)
    md5Final(&hashing, digest)
}

// The MD5 of `bytes` as 32 lower-case hex digits.
pub fn md5Hex(bytes: []const u8, text: *[32]u8) -> void {
    var digest: [16]u8 = undefined
    md5(bytes, &digest)
    const digestBytes: [*]const u8 = &digest
    const out: [*]u8 = unsafe { @ptrCast([*]u8, text) }
    _ = base64.hexEncode(digestBytes[0..16], out)
}
