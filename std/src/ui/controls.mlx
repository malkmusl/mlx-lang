// std.ui.controls: the everyday widgets of std.ui (std.ui.view has how
// they work): buttons, check boxes, radio buttons, switches, a section
// heading that folds, segments of a choice, labels, pills, a progress bar
// and a sparkline. Each takes the context, its id and where it goes (a
// ui.Rect, or a corner for fixed-size marks), draws itself in the
// context's theme and says whether it was clicked.
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const glyphs = @import("std.ui.glyphs")

const Ui = view.Ui
const Text = text_module.Text

// Check box states.
pub const CHECK_OFF: u8 = 0
pub const CHECK_ON: u8 = 1
// Some of what it stands for is on.
pub const CHECK_MIXED: u8 = 2

// Button kinds: only a background under the pointer (toolbar icons),
// a filled one, the primary action.
pub const BUTTON_PLAIN: u8 = 0
pub const BUTTON_NORMAL: u8 = 1
pub const BUTTON_PRIMARY: u8 = 2

pub const SWITCH_WIDTH: i32 = 44
pub const SWITCH_HEIGHT: i32 = 24

// The y at which `font`'s text is centred in a box `height` tall at y.
pub fn textTop(font: *Text, y: i32, height: i32) -> i32 {
    return y + (height - font.*.ascent * 3 / 2) / 2
}

// `string` in `font` at (x, y), cut at `limit` pixels wide (0: whole).
pub fn label(context: *Ui, font: *Text, string: []const u8, x: i32, y: i32, color: u32, limit: i32) -> void {
    text_module.drawText(context.*.canvas, font, string, x, y, color, limit)
}

// `string` centred in `area`.
pub fn centeredLabel(context: *Ui, font: *Text, string: []const u8, area: ui.Rect, color: u32) -> void {
    const width = text_module.measure(font, string)
    text_module.drawText(context.*.canvas, font, string, area.x + (area.width - width) / 2, textTop(font, area.y, area.height), color, 0)
}

// The width a button with `string` takes in `font`.
pub fn buttonWidth(context: *Ui, font: *Text, string: []const u8) -> i32 {
    return text_module.measure(font, string) + context.*.theme.*.padding * 2 + 4
}

fn buttonFill(context: *Ui, kind: u8, lit: bool, enabled: bool) -> u32 {
    const theme = context.*.theme
    if kind == BUTTON_PRIMARY && enabled { return if lit { theme.*.primaryHover } else { theme.*.primary } }
    if kind == BUTTON_PLAIN { return if lit { theme.*.selected } else { 0 } }
    return if lit { theme.*.buttonHover } else { theme.*.button }
}

// A button: `string` centred on it; true when clicked. A disabled one is
// drawn dim and takes no clicks.
pub fn button(context: *Ui, button_id: u64, area: ui.Rect, string: []const u8, kind: u8, enabled: bool) -> bool {
    if enabled { view.region(context, button_id, area) }
    const lit = enabled && (view.isHover(context, button_id) || view.isPressed(context, button_id))
    const fill = buttonFill(context, kind, lit, enabled)
    if fill != 0 { canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, context.*.theme.*.radius, fill) }
    if string.length > 0 { centeredLabel(context, context.*.body, string, area, if enabled { context.*.theme.*.text } else { context.*.theme.*.dim }) }
    return enabled && view.takeClick(context, button_id)
}

// A small button (`string` in the small font, the button's own fill): lit
// under the pointer only when `enabled` (still shown, dim, when not).
pub fn smallButton(context: *Ui, button_id: u64, area: ui.Rect, string: []const u8, enabled: bool) -> bool {
    view.region(context, button_id, area)
    const theme = context.*.theme
    const lit = enabled && (view.isHover(context, button_id) || view.isPressed(context, button_id))
    canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, theme.*.radius - 2, if lit { theme.*.buttonHover } else { theme.*.raised })
    centeredLabel(context, context.*.small, string, area, if enabled { theme.*.text } else { theme.*.dim })
    return enabled && view.takeClick(context, button_id)
}

// A button lit while `active` (its menu open) as under the pointer; the
// app draws its content. True when clicked.
pub fn toggleButton(context: *Ui, button_id: u64, area: ui.Rect, active: bool) -> bool {
    view.region(context, button_id, area)
    const theme = context.*.theme
    const lit = active || view.isHover(context, button_id) || view.isPressed(context, button_id)
    canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, theme.*.radius - 1, if lit { theme.*.buttonHover } else { theme.*.button })
    return view.takeClick(context, button_id)
}

// A small square button in a row (the app draws its icon), lit under
// the pointer; true when clicked.
pub fn miniButton(context: *Ui, button_id: u64, area: ui.Rect) -> bool {
    view.region(context, button_id, area)
    if view.isHover(context, button_id) { canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, context.*.theme.*.smallRadius + 1, context.*.theme.*.buttonHover) }
    return view.takeClick(context, button_id)
}

// A button the app draws an icon on: its background under the pointer
// (plain) or always (normal); true when clicked.
pub fn iconButton(context: *Ui, button_id: u64, area: ui.Rect, kind: u8) -> bool {
    return button(context, button_id, area, "", kind, true)
}

// A round button with a cross (closing a panel); true when clicked.
pub fn closeButton(context: *Ui, button_id: u64, area: ui.Rect) -> bool {
    view.region(context, button_id, area)
    const theme = context.*.theme
    const canvas = context.*.canvas
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, area.height / 2, if view.isHover(context, button_id) { theme.*.buttonHover } else { theme.*.raised })
    const size = area.width * 5 / 14
    const x = area.x + (area.width - size - 2) / 2
    const y = area.y + (area.height - size - 2) / 2
    var step: i32 = 0
    while step < size {
        canvas_module.fillRect(canvas, x + step, y + step, 2, 2, theme.*.text)
        canvas_module.fillRect(canvas, x + size - 1 - step, y + step, 2, 2, theme.*.text)
        step += 1
    }
    return view.takeClick(context, button_id)
}

// Back (`left`) or forward: a chevron, dim and taking no clicks when not
// `enabled`; true when clicked.
pub fn chevronButton(context: *Ui, button_id: u64, area: ui.Rect, left: bool, enabled: bool) -> bool {
    const clicked = button(context, button_id, area, "", BUTTON_PLAIN, enabled)
    const theme = context.*.theme
    const s = theme.*.scale
    glyphs.chevron(context.*.canvas, area.x + (area.width - 9 * s) / 2 + (if left { 0 } else { s }), area.y + (area.height - 13 * s) / 2, left, if enabled { theme.*.text } else { theme.*.disabled }, 13 * s, 3 * s)
    return clicked
}

// A button that opens a list (the app draws what is in it, and the list):
// lit under the pointer or while `open`, an arrow at its right; true when
// clicked.
pub fn menuButton(context: *Ui, button_id: u64, area: ui.Rect, open: bool) -> bool {
    view.region(context, button_id, area)
    const theme = context.*.theme
    const lit = open || view.isHover(context, button_id)
    canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, theme.*.radius, if lit { theme.*.buttonHover } else { theme.*.button })
    const s = theme.*.scale
    glyphs.arrowScaled(context.*.canvas, ui.right(area) - 16 * s, area.y + (area.height - 10 * s) / 2, true, theme.*.dim, s)
    return view.takeClick(context, button_id)
}

// What a split button's click was: none, its action, its list.
pub const SPLIT_NONE: u8 = 0
pub const SPLIT_MAIN: u8 = 1
pub const SPLIT_MENU: u8 = 2

// A button with an action and, `arrow_width` wide at its right, an arrow
// opening a list (lit while `open`); `fill` is its background (a busy
// one's colour). The app draws the action's icon and label.
pub fn splitButton(context: *Ui, main_id: u64, menu_id: u64, area: ui.Rect, arrow_width: i32, open: bool, fill: u32) -> u8 {
    const theme = context.*.theme
    const canvas = context.*.canvas
    const main = ui.rect(area.x, area.y, area.width - arrow_width, area.height)
    const menu = ui.rect(ui.right(area) - arrow_width, area.y, arrow_width, area.height)
    view.region(context, main_id, main)
    view.region(context, menu_id, menu)
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.radius, fill)
    if view.isHover(context, main_id) { canvas_module.fillRoundedRect(canvas, main.x, main.y, main.width, main.height, theme.*.radius, theme.*.buttonHover) }
    if open || view.isHover(context, menu_id) { canvas_module.fillRoundedRect(canvas, menu.x, menu.y, menu.width, menu.height, theme.*.radius, theme.*.buttonHover) }
    const s = theme.*.scale
    canvas_module.fillRect(canvas, menu.x, area.y + 6 * s, s, area.height - 12 * s, theme.*.border)
    glyphs.arrowScaled(canvas, menu.x + (arrow_width - 8 * s) / 2, area.y + (area.height - 10 * s) / 2, true, theme.*.dim, s)
    if view.takeClick(context, main_id) { return SPLIT_MAIN }
    if view.takeClick(context, menu_id) { return SPLIT_MENU }
    return SPLIT_NONE
}

// A 14 x 14 check box at (x, y) in `color` when on (drawing only).
pub fn drawCheckBox(context: *Ui, x: i32, y: i32, state: u8, color: u32) -> void {
    const canvas = context.*.canvas
    const theme = context.*.theme
    const s = theme.*.scale
    if state == CHECK_OFF {
        canvas_module.fillRoundedRect(canvas, x, y, 14 * s, 14 * s, 4 * s, theme.*.control)
        canvas_module.fillRoundedRect(canvas, x + s, y + s, 12 * s, 12 * s, 3 * s, theme.*.controlInner)
        return
    }
    canvas_module.fillRoundedRect(canvas, x, y, 14 * s, 14 * s, 4 * s, color)
    if state == CHECK_MIXED { glyphs.dashScaled(canvas, x, y, theme.*.onAccent, s) } else { glyphs.checkScaled(canvas, x, y, theme.*.onAccent, s) }
}

// A check box alone (its square and a little around it); true when
// clicked.
pub fn checkBox(context: *Ui, box_id: u64, x: i32, y: i32, state: u8, color: u32) -> bool {
    view.region(context, box_id, ui.rect(x - 3, y - 3, 20, 20))
    drawCheckBox(context, x, y, state, color)
    return view.takeClick(context, box_id)
}

// A row with a check box and `string` after it, lit under the pointer;
// true when clicked.
pub fn checkRow(context: *Ui, row_id: u64, area: ui.Rect, string: []const u8, state: u8) -> bool {
    return checkRowIn(context, row_id, area, string, state, context.*.theme.*.accent)
}

// A check row whose box is `color` when on (what it stands for: a kind's
// colour).
pub fn checkRowIn(context: *Ui, row_id: u64, area: ui.Rect, string: []const u8, state: u8, color: u32) -> bool {
    view.region(context, row_id, area)
    const theme = context.*.theme
    if view.isHover(context, row_id) { canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius + 1, theme.*.hover) }
    const s = theme.*.scale
    const box_y = area.y + (area.height - 14 * s) / 2
    drawCheckBox(context, area.x + 4 * s, box_y, state, color)
    label(context, context.*.small, string, area.x + 23 * s, textTop(context.*.small, area.y, area.height), if state != CHECK_OFF { theme.*.text } else { theme.*.dim }, area.width - 27 * s)
    return view.takeClick(context, row_id)
}

// A 14 x 14 radio button at (x, y) (drawing only).
pub fn drawRadio(context: *Ui, x: i32, y: i32, chosen: bool) -> void {
    const canvas = context.*.canvas
    const theme = context.*.theme
    const s = theme.*.scale
    canvas_module.fillRoundedRect(canvas, x, y, 14 * s, 14 * s, 7 * s, if chosen { theme.*.accent } else { theme.*.control })
    if chosen {
        canvas_module.fillRoundedRect(canvas, x + 4 * s, y + 4 * s, 6 * s, 6 * s, 3 * s, theme.*.onAccent)
    } else {
        canvas_module.fillRoundedRect(canvas, x + s, y + s, 12 * s, 12 * s, 6 * s, theme.*.controlInner)
    }
}

// A row with a radio button and `string`; true when clicked.
pub fn radioRow(context: *Ui, row_id: u64, area: ui.Rect, string: []const u8, chosen: bool) -> bool {
    view.region(context, row_id, area)
    const theme = context.*.theme
    if view.isHover(context, row_id) { canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius + 1, theme.*.hover) }
    const s = theme.*.scale
    drawRadio(context, area.x + 4 * s, area.y + (area.height - 14 * s) / 2, chosen)
    label(context, context.*.small, string, area.x + 23 * s, textTop(context.*.small, area.y, area.height), if chosen { theme.*.text } else { theme.*.dim }, area.width - 27 * s)
    return view.takeClick(context, row_id)
}

// A switch (SWITCH_WIDTH x SWITCH_HEIGHT at x, y) drawn on or off, lit
// when `lit` (drawing only: a settings row is what takes the click).
pub fn drawSwitch(context: *Ui, x: i32, y: i32, on: bool, lit: bool) -> void {
    const theme = context.*.theme
    const track = if on { theme.*.accent } else if lit { theme.*.switchOffHover } else { theme.*.switchOff }
    const s = theme.*.scale
    const width = SWITCH_WIDTH * s
    const height = SWITCH_HEIGHT * s
    canvas_module.fillRoundedRect(context.*.canvas, x, y, width, height, height / 2, track)
    const knob_x = if on { x + width - height + 3 * s } else { x + 3 * s }
    canvas_module.fillRoundedRect(context.*.canvas, knob_x, y + 3 * s, height - 6 * s, height - 6 * s, (height - 6 * s) / 2, theme.*.knob)
}

// A switch alone; true when clicked.
pub fn switchToggle(context: *Ui, switch_id: u64, x: i32, y: i32, on: bool) -> bool {
    view.region(context, switch_id, ui.rect(x, y, SWITCH_WIDTH * context.*.theme.*.scale, SWITCH_HEIGHT * context.*.theme.*.scale))
    drawSwitch(context, x, y, on, view.isHover(context, switch_id))
    return view.takeClick(context, switch_id)
}

// A settings row: `title`, `note` under it, a switch on the right; the
// whole row takes the click.
pub fn switchRow(context: *Ui, row_id: u64, area: ui.Rect, title: []const u8, note: []const u8, on: bool) -> bool {
    view.region(context, row_id, area)
    const theme = context.*.theme
    const lit = view.isHover(context, row_id)
    if lit { canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, theme.*.radius + 2, theme.*.hover) }
    const s = theme.*.scale
    const left = area.x + 8 * s
    const room = area.width - (SWITCH_WIDTH + 24) * s
    if note.length > 0 {
        label(context, context.*.body, title, left, area.y + 2 * s, theme.*.text, room)
        label(context, context.*.small, note, left, area.y + 22 * s, theme.*.dim, room)
    } else {
        label(context, context.*.body, title, left, textTop(context.*.body, area.y, area.height), theme.*.text, room)
    }
    drawSwitch(context, ui.right(area) - (8 + SWITCH_WIDTH) * s, area.y + (area.height - SWITCH_HEIGHT * s) / 2, on, lit)
    return view.takeClick(context, row_id)
}

// A slider across `area` for a value from 0 to `most`: dragged (or
// clicked) along, or turned with the wheel (a twentieth a step, down
// lowers it). Returns the value it has now.
pub fn slider(context: *Ui, slider_id: u64, area: ui.Rect, value: u32, most: u32) -> u32 {
    view.region(context, slider_id, area)
    const theme = context.*.theme
    const canvas = context.*.canvas
    const s = theme.*.scale
    const knob = 18 * s
    const usable = area.width - knob
    var current = if value > most { most } else { value }
    if view.isPressed(context, slider_id) && context.*.pointerDown && usable > 0 {
        var x = context.*.pointerX - area.x - knob / 2
        if x < 0 { x = 0 }
        if x > usable { x = usable }
        current = @intCast(u32, @intCast(i64, x) * @intCast(i64, most) / @intCast(i64, usable))
    }
    const steps = view.takeWheel(context, slider_id)
    if steps != 0 {
        const step = @intCast(i64, most) / 20
        var next = @intCast(i64, current) - @intCast(i64, steps) * step
        if next < 0 { next = 0 }
        if next > @intCast(i64, most) { next = @intCast(i64, most) }
        current = @intCast(u32, next)
    }
    const lit = view.isHover(context, slider_id) || view.isPressed(context, slider_id)
    const track = 4 * s
    const middle = area.y + area.height / 2
    const filled = if most == 0 { 0 } else { @intCast(i32, @intCast(i64, current) * @intCast(i64, usable) / @intCast(i64, most)) }
    canvas_module.fillRoundedRect(canvas, area.x + knob / 2, middle - track / 2, usable, track, track / 2, if lit { theme.*.switchOffHover } else { theme.*.switchOff })
    if filled > 0 { canvas_module.fillRoundedRect(canvas, area.x + knob / 2, middle - track / 2, filled, track, track / 2, theme.*.accent) }
    canvas_module.fillRoundedRect(canvas, area.x + filled, middle - knob / 2, knob, knob, knob / 2, theme.*.knob)
    return current
}

// A colour to choose: a disc `size` across at (x, y), ringed in the text
// colour when `chosen`, more faintly under the pointer; true when clicked.
pub fn swatch(context: *Ui, swatch_id: u64, x: i32, y: i32, size: i32, color: u32, chosen: bool) -> bool {
    view.region(context, swatch_id, ui.rect(x, y, size, size))
    const theme = context.*.theme
    const canvas = context.*.canvas
    if chosen {
        canvas_module.fillRoundedRect(canvas, x - 4, y - 4, size + 8, size + 8, (size + 8) / 2, theme.*.knob)
        canvas_module.fillRoundedRect(canvas, x - 2, y - 2, size + 4, size + 4, (size + 4) / 2, theme.*.panel)
    } else if view.isHover(context, swatch_id) {
        canvas_module.fillRoundedRect(canvas, x - 3, y - 3, size + 6, size + 6, (size + 6) / 2, theme.*.border)
        canvas_module.fillRoundedRect(canvas, x - 1, y - 1, size + 2, size + 2, (size + 2) / 2, theme.*.panel)
    }
    canvas_module.fillRoundedRect(canvas, x, y, size, size, size / 2, color)
    return view.takeClick(context, swatch_id)
}

// A row with `title` and, `box_width` wide at its right, a box with
// `value` (a key binding, a choice), in the accent while `active` (being
// set); lit under the pointer; true when clicked.
pub fn valueRow(context: *Ui, row_id: u64, area: ui.Rect, title: []const u8, value: []const u8, box_width: i32, active: bool) -> bool {
    view.region(context, row_id, area)
    const theme = context.*.theme
    const canvas = context.*.canvas
    if view.isHover(context, row_id) { canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.radius + 2, theme.*.hover) }
    label(context, context.*.body, title, area.x + 8, textTop(context.*.body, area.y, area.height), theme.*.text, area.width - box_width - 24)
    const box = ui.rect(ui.right(area) - 8 - box_width, area.y + 3, box_width, area.height - 6)
    canvas_module.fillRoundedRect(canvas, box.x, box.y, box.width, box.height, theme.*.radius, if active { theme.*.accent } else { theme.*.button })
    label(context, context.*.small, value, box.x + 10, textTop(context.*.small, box.y, box.height), if active { theme.*.onAccent } else { theme.*.text }, box.width - 20)
    return view.takeClick(context, row_id)
}

// A section's heading: its name and an arrow (down: open, right: folded
// up); true when clicked (fold or open it).
pub fn heading(context: *Ui, heading_id: u64, area: ui.Rect, string: []const u8, open: bool) -> bool {
    view.region(context, heading_id, area)
    const theme = context.*.theme
    const lit = view.isHover(context, heading_id)
    if lit { canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, theme.*.radius - 2, theme.*.hover) }
    const color = if lit { theme.*.text } else { theme.*.dim }
    const s = theme.*.scale
    label(context, context.*.small, string, area.x + 10 * s, area.y + (area.height - 12 * s) / 2, color, area.width - 40 * s)
    glyphs.arrowScaled(context.*.canvas, ui.right(area) - 20 * s, area.y + (area.height - 10 * s) / 2, open, color, s)
    return view.takeClick(context, heading_id)
}

// The frame of a choice of segments (drawn under them).
pub fn segmentsFrame(context: *Ui, area: ui.Rect) -> void {
    canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, context.*.theme.*.radius, context.*.theme.*.divider)
}

// One segment of a choice (in a segmentsFrame, 2 pixels in); true when
// clicked. The app draws an icon in it when it wants; the label is
// centred (or after the icon's `icon_width`).
pub fn segment(context: *Ui, segment_id: u64, area: ui.Rect, string: []const u8, chosen: bool, icon_width: i32) -> bool {
    view.region(context, segment_id, area)
    const theme = context.*.theme
    if chosen {
        canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, theme.*.radius - 1, theme.*.pressed)
    } else if view.isHover(context, segment_id) {
        canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, theme.*.radius - 1, theme.*.raised)
    }
    const width = text_module.measure(context.*.body, string)
    const x = area.x + (area.width - width - icon_width) / 2 + icon_width
    label(context, context.*.body, string, x, textTop(context.*.body, area.y, area.height), if chosen { theme.*.text } else { theme.*.dim }, 0)
    return view.takeClick(context, segment_id)
}

// Where a segment's icon goes (its left edge), for the same arguments.
pub fn segmentIconX(context: *Ui, area: ui.Rect, string: []const u8, icon_width: i32) -> i32 {
    return area.x + (area.width - text_module.measure(context.*.body, string) - icon_width) / 2
}

// A pill: `string` on a rounded `fill` (drawing only); its width.
pub fn pill(context: *Ui, font: *Text, string: []const u8, x: i32, y: i32, height: i32, fill: u32, color: u32) -> i32 {
    const width = text_module.measure(font, string) + 16
    canvas_module.fillRoundedRect(context.*.canvas, x, y, width, height, height / 2, fill)
    label(context, font, string, x + 8, textTop(font, y, height), color, 0)
    return width
}

// `string` in `font` as a link, centred in `area` (where it takes the
// pointer): in `color`, underlined in the text colour under the pointer;
// true when clicked.
pub fn link(context: *Ui, link_id: u64, area: ui.Rect, font: *Text, string: []const u8, color: u32) -> bool {
    view.region(context, link_id, area)
    const lit = view.isHover(context, link_id)
    const width = text_module.measure(font, string)
    const x = area.x + (area.width - width) / 2
    label(context, font, string, x, textTop(font, area.y, area.height), if lit { context.*.theme.*.text } else { color }, 0)
    if lit { canvas_module.fillRect(context.*.canvas, x, ui.bottom(area) - 3, width, 1, context.*.theme.*.text) }
    return view.takeClick(context, link_id)
}

// A chip: `string` in `font` centred on a small rounded `fill` (`lit`
// under the pointer), as in a line of text; true when clicked.
pub fn chip(context: *Ui, chip_id: u64, area: ui.Rect, font: *Text, string: []const u8, fill: u32, lit: u32, color: u32) -> bool {
    view.region(context, chip_id, area)
    canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, context.*.theme.*.smallRadius + 1, if view.isHover(context, chip_id) { lit } else { fill })
    centeredLabel(context, font, string, area, color)
    return view.takeClick(context, chip_id)
}

// One step of a path (a breadcrumb): `string` in `font`, the last one
// (`current`) in the text colour, the others dim; lit under the pointer;
// true when clicked.
pub fn crumb(context: *Ui, crumb_id: u64, area: ui.Rect, font: *Text, string: []const u8, current: bool) -> bool {
    view.region(context, crumb_id, area)
    const theme = context.*.theme
    if view.isHover(context, crumb_id) { canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius + 2, theme.*.button) }
    centeredLabel(context, font, string, area, if current { theme.*.text } else { theme.*.dim })
    return view.takeClick(context, crumb_id)
}

// A bar `permille` / 1000 full in `color`.
pub fn progress(context: *Ui, area: ui.Rect, permille: u32, color: u32) -> void {
    const canvas = context.*.canvas
    const radius = area.height / 2
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, radius, context.*.theme.*.track)
    const filled = area.width * @intCast(i32, if permille > 1000 { 1000 } else { permille }) / 1000
    if filled > 0 { canvas_module.fillRoundedRect(canvas, area.x, area.y, filled, area.height, radius, color) }
}

// `count` values as bars from the bottom of `area`, the largest full
// height; false when there is nothing to draw.
pub fn sparkline(context: *Ui, area: ui.Rect, values: [*]const u32, count: usize, color: u32) -> bool {
    if count == 0 || area.width <= 0 { return false }
    var largest: u32 = 0
    var index: usize = 0
    while index < count {
        if values[index] > largest { largest = values[index] }
        index += 1
    }
    if largest == 0 { return false }
    const step = area.width / @intCast(i32, count)
    const bar = if step > 1 { step - 1 } else { 1 }
    index = 0
    while index < count {
        const height = @intCast(i32, (@intCast(u64, values[index]) * @intCast(u64, area.height) + @intCast(u64, largest) - 1) / @intCast(u64, largest))
        if height > 0 { canvas_module.fillRect(context.*.canvas, area.x + @intCast(i32, index) * step, ui.bottom(area) - height, bar, height, color) }
        index += 1
    }
    return true
}
