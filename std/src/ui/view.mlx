// std.ui.view: the context std.ui's widgets draw in and take input
// through, on any platform. Widgets are functions called each frame; each
// draws itself and names the rectangle it takes with an id (a u64 the app
// picks: view.id("save"), view.idOf(base, row), or its own numbers). The
// ids under the pointer come from those rectangles (the last one named on
// top), so an app never tests the pointer against its layout itself:
//
//     view.begin(&ui, &canvas)
//     if controls.button(&ui, view.id("save"), save_rect, "Save") { save() }
//     view.end(&ui)                      // false: nothing to draw again
//
//     // From the platform (std.ui.input does this from its events):
//     if view.pointerMove(&ui, x, y) { redraw() }
//     const hit = view.pointerButton(&ui, true)   // the id pressed
//
// A click (pressed and let go on the same id) is kept until the widget of
// that id asks for it (controls.button returns it) or the next press.
const std = @import("std")
const ui = @import("std.ui")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")

pub const Canvas = canvas_module.Canvas
pub const Text = text_module.Text
pub const Theme = theme_module.Theme

pub const MAX_REGIONS: usize = 2048
pub const MAX_CLIPS: usize = 8
// No id: nothing under the pointer, nothing pressed.
pub const NONE: u64 = 0

pub const Region = struct {
    area: ui.Rect
    id: u64
}

pub const Ui = struct {
    canvas: *Canvas
    theme: *Theme
    // Fonts: the body text, smaller labels, code.
    body: *Text
    small: *Text
    mono: *Text
    // The pointer in surface pixels, whether it is over the surface and
    // whether a button is down.
    pointerX: i32
    pointerY: i32
    pointerInside: bool
    pointerDown: bool
    // Where the pointer went down (for drags).
    pressX: i32
    pressY: i32
    // The id under the pointer, the one a button went down on, the one
    // clicked (until taken), the one taking keys.
    hover: u64
    pressed: u64
    clicked: u64
    focus: u64
    // Wheel steps over `wheelId` not taken yet (positive: down).
    wheel: i32
    wheelId: u64
    // Milliseconds, for animations (the app sets it each frame).
    time: u64
    // The regions named this frame and those of the last one (what the
    // pointer is tested against between frames).
    regions: [2048]Region
    regionCount: usize
    shown: [2048]Region
    shownCount: usize
    // Regions are clipped to the innermost clip (scrolled lists).
    clips: [8]ui.Rect
    clipCount: usize
    // A widget took a click, the wheel or the focus this frame: what it
    // changed shows in the next one.
    changed: bool
}

// Prepares a context for `theme` and three fonts (the same font may serve
// as all three).
pub fn init(context: *Ui, theme: *Theme, body: *Text, small: *Text, mono: *Text) -> void {
    context.*.theme = theme
    context.*.body = body
    context.*.small = small
    context.*.mono = mono
    context.*.pointerX = -1
    context.*.pointerY = -1
    context.*.pointerInside = false
    context.*.pointerDown = false
    context.*.pressX = 0
    context.*.pressY = 0
    context.*.hover = NONE
    context.*.pressed = NONE
    context.*.clicked = NONE
    context.*.focus = NONE
    context.*.wheel = 0
    context.*.wheelId = NONE
    context.*.time = 0
    context.*.regionCount = 0
    context.*.shownCount = 0
    context.*.clipCount = 0
    context.*.changed = false
}

// ---------------------------------------------------------------------------
// Ids

// An id from a name (FNV-1a; never NONE).
pub fn id(name: []const u8) -> u64 {
    var hash: u64 = 14695981039346656037
    for byte in name {
        hash = (hash ^ @intCast(u64, byte)) *% 1099511628211
    }
    return if hash == NONE { 1 } else { hash }
}

// The id of item `index` of `base` (a list's rows, tabs).
pub fn idOf(base: u64, index: usize) -> u64 {
    var hash = (base ^ (@intCast(u64, index) +% 40503)) *% 1099511628211
    hash = hash ^ (hash >> 29)
    return if hash == NONE { 1 } else { hash }
}

// ---------------------------------------------------------------------------
// Frames

fn regionAt(context: *Ui, index: usize) -> *Region {
    unsafe { return @ptrFromInt(*Region, @intFromPtr(context) + @offsetOf(Ui, "regions") + index * @sizeOf(Region)) }
}

fn shownAt(context: *Ui, index: usize) -> *Region {
    unsafe { return @ptrFromInt(*Region, @intFromPtr(context) + @offsetOf(Ui, "shown") + index * @sizeOf(Region)) }
}

fn clipAt(context: *Ui, index: usize) -> *ui.Rect {
    unsafe { return @ptrFromInt(*ui.Rect, @intFromPtr(context) + @offsetOf(Ui, "clips") + index * @sizeOf(ui.Rect)) }
}

// Starts a frame drawn on `canvas`.
pub fn begin(context: *Ui, canvas: *Canvas) -> void {
    context.*.canvas = canvas
    context.*.regionCount = 0
    context.*.clipCount = 0
    context.*.changed = false
}

// Ends a frame: its regions are what the pointer is tested against from
// now on. True when the app should draw again: what is under the pointer
// changed with the new layout, or a widget took input whose effect shows
// only now.
pub fn end(context: *Ui) -> bool {
    var index: usize = 0
    while index < context.*.regionCount {
        shownAt(context, index).* = regionAt(context, index).*
        index += 1
    }
    context.*.shownCount = context.*.regionCount
    const before = context.*.hover
    context.*.hover = hitAt(context, context.*.pointerX, context.*.pointerY)
    return context.*.hover != before || context.*.changed
}

// Names `area` as `region_id`'s (clipped to the current clip); later
// regions lie over earlier ones.
pub fn region(context: *Ui, region_id: u64, area: ui.Rect) -> void {
    if context.*.regionCount >= MAX_REGIONS || region_id == NONE { return }
    var clipped = area
    if context.*.clipCount > 0 { clipped = ui.intersect(area, clipAt(context, context.*.clipCount - 1).*) }
    if ui.isEmpty(clipped) { return }
    const entry = regionAt(context, context.*.regionCount)
    entry.*.area = clipped
    entry.*.id = region_id
    context.*.regionCount += 1
}

// Regions from here on are cut to `area` (inside the clip there is),
// until popClip.
pub fn pushClip(context: *Ui, area: ui.Rect) -> void {
    if context.*.clipCount >= MAX_CLIPS { return }
    var clipped = area
    if context.*.clipCount > 0 { clipped = ui.intersect(area, clipAt(context, context.*.clipCount - 1).*) }
    clipAt(context, context.*.clipCount).* = clipped
    context.*.clipCount += 1
}

pub fn popClip(context: *Ui) -> void {
    if context.*.clipCount > 0 { context.*.clipCount -= 1 }
}

// The id at (x, y) in the last frame (NONE: none).
pub fn hitAt(context: *Ui, x: i32, y: i32) -> u64 {
    if !context.*.pointerInside { return NONE }
    var index = context.*.shownCount
    while index > 0 {
        index -= 1
        const entry = shownAt(context, index)
        if ui.contains(entry.*.area, x, y) { return entry.*.id }
    }
    return NONE
}

// Where `region_id` was in the last frame (an empty rectangle when it was
// not there).
pub fn areaOf(context: *Ui, region_id: u64) -> ui.Rect {
    var index: usize = 0
    while index < context.*.shownCount {
        const entry = shownAt(context, index)
        if entry.*.id == region_id { return entry.*.area }
        index += 1
    }
    return ui.rect(0, 0, 0, 0)
}

// ---------------------------------------------------------------------------
// Input (from the platform)

// The pointer moved to (x, y). True when another id is under it.
pub fn pointerMove(context: *Ui, x: i32, y: i32) -> bool {
    context.*.pointerX = x
    context.*.pointerY = y
    context.*.pointerInside = true
    const before = context.*.hover
    context.*.hover = hitAt(context, x, y)
    return context.*.hover != before
}

// The pointer left the surface. True when something was under it.
pub fn pointerLeave(context: *Ui) -> bool {
    context.*.pointerInside = false
    const before = context.*.hover
    context.*.hover = NONE
    return before != NONE
}

// The (primary) button went down or up. Down: the id under the pointer is
// pressed (and returned). Up: when it is still the one under the pointer,
// it is clicked (and returned); NONE otherwise.
pub fn pointerButton(context: *Ui, down: bool) -> u64 {
    if down {
        context.*.pointerDown = true
        context.*.pressX = context.*.pointerX
        context.*.pressY = context.*.pointerY
        context.*.pressed = context.*.hover
        context.*.clicked = NONE
        return context.*.pressed
    }
    context.*.pointerDown = false
    const pressed = context.*.pressed
    context.*.pressed = NONE
    if pressed != NONE && pressed == context.*.hover {
        context.*.clicked = pressed
        return pressed
    }
    return NONE
}

// The wheel turned `steps` (positive: down, toward the end) over what is
// under the pointer.
pub fn wheel(context: *Ui, steps: i32) -> u64 {
    context.*.wheel += steps
    context.*.wheelId = context.*.hover
    return context.*.hover
}

// ---------------------------------------------------------------------------
// For widgets

pub fn isHover(context: *Ui, region_id: u64) -> bool { return context.*.hover == region_id && region_id != NONE }

pub fn isPressed(context: *Ui, region_id: u64) -> bool { return context.*.pressed == region_id && region_id != NONE }

pub fn hasFocus(context: *Ui, region_id: u64) -> bool { return context.*.focus == region_id && region_id != NONE }

pub fn setFocus(context: *Ui, region_id: u64) -> void {
    if context.*.focus != region_id { context.*.changed = true }
    context.*.focus = region_id
}

// Whether `region_id` was clicked; the click is taken.
pub fn takeClick(context: *Ui, region_id: u64) -> bool {
    if context.*.clicked != region_id || region_id == NONE { return false }
    context.*.clicked = NONE
    context.*.changed = true
    return true
}

// The wheel steps over `region_id` not taken yet; they are taken.
pub fn takeWheel(context: *Ui, region_id: u64) -> i32 {
    if context.*.wheel == 0 || context.*.wheelId != region_id { return 0 }
    const steps = context.*.wheel
    context.*.wheel = 0
    context.*.changed = true
    return steps
}

// The wheel steps with the pointer in `area` (a scrolled list, whatever
// row is under it) not taken yet; they are taken.
pub fn takeWheelIn(context: *Ui, area: ui.Rect) -> i32 {
    if context.*.wheel == 0 || !ui.contains(area, context.*.pointerX, context.*.pointerY) { return 0 }
    const steps = context.*.wheel
    context.*.wheel = 0
    context.*.changed = true
    return steps
}

// While `region_id` is held down: how far the pointer moved since it went
// down.
pub fn dragX(context: *Ui) -> i32 { return context.*.pointerX - context.*.pressX }
pub fn dragY(context: *Ui) -> i32 { return context.*.pointerY - context.*.pressY }

pub fn canvasOf(context: *Ui) -> *Canvas { return context.*.canvas }

// A canvas of no pixels: a frame drawn on it only lays out (its widgets
// name their regions, nothing is drawn). An app runs one when input
// changed what shows and the next input must meet the new layout before
// the next frame is drawn (a click on a list just opened).
pub fn layoutCanvas() -> Canvas {
    var nowhere: Canvas = undefined
    unsafe { nowhere.pixels = @ptrFromInt([*]u32, 16) }
    nowhere.width = 0
    nowhere.height = 0
    nowhere.device = 0
    nowhere.stride = 0
    nowhere.swapRedBlue = false
    nowhere.opacity = 255
    return nowhere
}
