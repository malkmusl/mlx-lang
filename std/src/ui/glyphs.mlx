// std.ui.glyphs: the small marks widgets draw (a check mark, arrows,
// chevrons, a close cross, a dot, a magnifier, a plus, a circular arrow
// for reloading, a download's arrow, a progress ring, files' marks by
// their kind), drawn with std.ui.canvas at any position, in any colour.
const canvas_module = @import("std.ui.canvas")
const math_module = @import("std.math")

const Canvas = canvas_module.Canvas

// The marks are sized for a logical pixel; the *Scaled ones draw them
// `scale` pixels to one (a screen's density, the theme's scale).

// A check mark in a 14 x 14 box at (x, y).
pub fn check(canvas: *Canvas, x: i32, y: i32, color: u32) -> void { checkScaled(canvas, x, y, color, 1) }

pub fn checkScaled(canvas: *Canvas, x: i32, y: i32, color: u32, scale: i32) -> void {
    var step: i32 = 0
    while step < 3 {
        canvas_module.fillRect(canvas, x + (3 + step) * scale, y + (6 + step) * scale, 2 * scale, 2 * scale, color)
        step += 1
    }
    step = 0
    while step < 6 {
        canvas_module.fillRect(canvas, x + (5 + step) * scale, y + (8 - step) * scale, 2 * scale, 2 * scale, color)
        step += 1
    }
}

// A dash in a 14 x 14 box (a check box partly on).
pub fn dash(canvas: *Canvas, x: i32, y: i32, color: u32) -> void { dashScaled(canvas, x, y, color, 1) }

pub fn dashScaled(canvas: *Canvas, x: i32, y: i32, color: u32, scale: i32) -> void {
    canvas_module.fillRect(canvas, x + 3 * scale, y + 6 * scale, 8 * scale, 2 * scale, color)
}

// A small arrow 8 wide: down (open) or right (folded up).
pub fn arrow(canvas: *Canvas, x: i32, y: i32, down: bool, color: u32) -> void { arrowScaled(canvas, x, y, down, color, 1) }

pub fn arrowScaled(canvas: *Canvas, x: i32, y: i32, down: bool, color: u32, scale: i32) -> void {
    var step: i32 = 0
    while step < 4 {
        if down {
            canvas_module.fillRect(canvas, x + step * scale, y + (3 + step) * scale, (8 - 2 * step) * scale, scale, color)
        } else {
            canvas_module.fillRect(canvas, x + (2 + step) * scale, y + (2 + step) * scale, scale, (8 - 2 * step) * scale, color)
        }
        step += 1
    }
}

// A chevron `size` tall, its strokes `thickness` wide, pointing left or
// right (back and forward buttons, list arrows).
pub fn chevron(canvas: *Canvas, x: i32, y: i32, left: bool, color: u32, size: i32, thickness: i32) -> void {
    const half = size / 2
    var row: i32 = 0
    while row < size {
        const offset = if row < half { half - row } else { row - half }
        const column = if left { x + offset } else { x + half - offset }
        canvas_module.fillRect(canvas, column, y + row, thickness, 1, color)
        row += 1
    }
}

// A magnifier: a ring and its handle (a search field), 13 across.
pub fn magnifier(canvas: *Canvas, x: i32, y: i32, color: u32) -> void { magnifierScaled(canvas, x, y, color, 1) }

pub fn magnifierScaled(canvas: *Canvas, x: i32, y: i32, color: u32, scale: i32) -> void {
    canvas_module.strokeRoundedRect(canvas, x, y, 11 * scale, 11 * scale, 5 * scale, 2 * scale, color)
    var step: i32 = 0
    while step < 5 {
        canvas_module.fillRect(canvas, x + (9 + step) * scale, y + (9 + step) * scale, 2 * scale, 2 * scale, color)
        step += 1
    }
}

// A cross in an 8 x 8 square at (x, y) (close).
pub fn cross(canvas: *Canvas, x: i32, y: i32, color: u32) -> void { crossScaled(canvas, x, y, color, 1) }

pub fn crossScaled(canvas: *Canvas, x: i32, y: i32, color: u32, scale: i32) -> void {
    var step: i32 = 0
    while step < 8 {
        canvas_module.fillRect(canvas, x + step * scale, y + step * scale, 2 * scale, scale, color)
        canvas_module.fillRect(canvas, x + (7 - step) * scale, y + step * scale, 2 * scale, scale, color)
        step += 1
    }
}

// A filled circle `size` across at (x, y).
pub fn dot(canvas: *Canvas, x: i32, y: i32, size: i32, color: u32) -> void {
    canvas_module.fillRoundedRect(canvas, x, y, size, size, size / 2, color)
}

// A plus `size` across, its strokes `thickness` wide.
pub fn plus(canvas: *Canvas, x: i32, y: i32, size: i32, thickness: i32, color: u32) -> void {
    canvas_module.fillRect(canvas, x, y + (size - thickness) / 2, size, thickness, color)
    canvas_module.fillRect(canvas, x + (size - thickness) / 2, y, thickness, size, color)
}

// A circular arrow (reload) in a 14 x 14 box at (x, y): a ring open at
// its upper right, its upper end an arrowhead going clockwise.
pub fn reloadScaled(canvas: *Canvas, x: i32, y: i32, color: u32, scale: i32) -> void {
    // In half pixels from the centre: the ring between radius 4 and 6.
    const size = 14 * scale
    const outer = 12 * scale
    const inner = 8 * scale
    var row: i32 = 0
    while row < size {
        const dy = 2 * row + 1 - size
        var column: i32 = 0
        var start: i32 = -1
        while column <= size {
            const dx = 2 * column + 1 - size
            const distance = dx * dx + dy * dy
            // (The gap: up and right of the centre, under 60 degrees.)
            const gap = dx > 0 && dy < 0 && 0 - dy * 4 < dx * 7
            const on = column < size && distance <= outer * outer && distance >= inner * inner && !gap
            if on && start < 0 { start = column }
            if !on && start >= 0 {
                canvas_module.fillRect(canvas, x + start, y + row, column - start, 1, color)
                start = -1
            }
            column += 1
        }
        row += 1
    }
    // The arrowhead: a triangle pointing right at the ring's upper end.
    var step: i32 = 0
    while step < 3 * scale {
        canvas_module.fillRect(canvas, x + 8 * scale + step, y - scale + step, 1, 6 * scale - 2 * step, color)
        step += 1
    }
}

// A download's mark in a 16 x 16 box at (x, y): an arrow down onto a
// tray (the toolbar's downloads button, std.ui's lists of downloads).
pub fn downloadScaled(canvas: *Canvas, x: i32, y: i32, color: u32, scale: i32) -> void {
    const s = scale
    canvas_module.fillRect(canvas, x + 7 * s, y + s, 2 * s, 9 * s, color)
    var step: i32 = 0
    while step < 4 {
        canvas_module.fillRect(canvas, x + (4 + step) * s, y + (7 + step) * s, (8 - 2 * step) * s, s, color)
        step += 1
    }
    canvas_module.fillRect(canvas, x + s, y + 11 * s, 2 * s, 4 * s, color)
    canvas_module.fillRect(canvas, x + 13 * s, y + 11 * s, 2 * s, 4 * s, color)
    canvas_module.fillRect(canvas, x + s, y + 13 * s, 14 * s, 2 * s, color)
}

// A ring around the centre (cx, cy), `radius` pixels out and
// `thickness` wide: `track` all round, `color` over the part `permille`
// thousandths of a turn from the top, clockwise (a progress ring),
// its edges smoothed (sixteen samples a pixel).
pub fn ring(canvas: *Canvas, cx: i32, cy: i32, radius: i32, thickness: i32, permille: u32, color: u32, track: u32) -> void {
    const done = if permille > 1000 { 1000 } else { permille }
    if canvas.*.device != 0 {
        // (The GPU's canvas blends no pixel: the track alone.)
        canvas_module.strokeRoundedRect(canvas, cx - radius, cy - radius, radius * 2, radius * 2, radius, thickness, track)
        return
    }
    // The arc's end as a direction (sin, -cos of its angle), in 1024ths.
    const angle = @floatFromInt(f64, done) * 6.283185307179586 / 1000.0
    const ex = @intFromFloat(i64, math_module.sin(angle) * 1024.0)
    const ey = @intFromFloat(i64, 0.0 - math_module.cos(angle) * 1024.0)
    const outer = @intCast(i64, radius) * 4
    const inner = @intCast(i64, radius - thickness) * 4
    var row = cy - radius - 1
    while row <= cy + radius + 1 {
        var column = cx - radius - 1
        while column <= cx + radius + 1 {
            var onArc: u32 = 0
            var onTrack: u32 = 0
            var sy: i64 = 0
            while sy < 4 {
                var sx: i64 = 0
                while sx < 4 {
                    // (In quarter pixels from the centre.)
                    const dx = @intCast(i64, column - cx) * 4 + sx * 2 - 3 + 2
                    const dy = @intCast(i64, row - cy) * 4 + sy * 2 - 3 + 2
                    const distance = dx * dx + dy * dy
                    if distance <= outer * outer && distance >= inner * inner {
                        if done >= 1000 || inArc(dx, dy, ex, ey, done) { onArc += 1 } else { onTrack += 1 }
                    }
                    sx += 1
                }
                sy += 1
            }
            if onTrack > 0 { canvas_module.blend(canvas, column, row, track, onTrack * 255 / 16) }
            if onArc > 0 { canvas_module.blend(canvas, column, row, color, onArc * 255 / 16) }
            column += 1
        }
        row += 1
    }
}

// Whether the direction (dx, dy) (y down) is less than the arc's angle
// clockwise from the top: between the top and its end (ex, ey).
fn inArc(dx: i64, dy: i64, ex: i64, ey: i64, permille: u32) -> bool {
    if permille == 0 { return false }
    // (a x b > 0: b clockwise from a, the y axis down.)
    const fromTop = dx >= 0 && !(dx == 0 && dy > 0)
    const beforeEnd = dx * ey - dy * ex > 0
    if permille <= 500 { return fromTop && beforeEnd }
    // Past half a turn: all but what lies between the end and the top.
    const afterEnd = ex * dy - ey * dx > 0
    const beforeTop = !fromTop
    return !(afterEnd && beforeTop)
}

// The kinds of file a file's mark shows (fileKind).
pub const FILE_GENERIC: u8 = 0
pub const FILE_TEXT: u8 = 1
pub const FILE_DOCUMENT: u8 = 2
pub const FILE_IMAGE: u8 = 3
pub const FILE_AUDIO: u8 = 4
pub const FILE_VIDEO: u8 = 5
pub const FILE_ARCHIVE: u8 = 6
pub const FILE_CODE: u8 = 7
pub const FILE_FOLDER: u8 = 8

fn lowered(c: u8) -> u8 { return if c >= 65 && c <= 90 { c + 32 } else { c } }

fn startsWithLowered(text: []const u8, start: []const u8) -> bool {
    if text.length < start.length { return false }
    var index: usize = 0
    while index < start.length {
        if lowered(text[index]) != start[index] { return false }
        index += 1
    }
    return true
}

// Whether NAME's extension (after its last dot, its case aside) is one
// of LIST's (space-separated, lower case).
fn extensionIn(name: []const u8, list: []const u8) -> bool {
    var dot = name.length
    while dot > 0 && name[dot - 1] != 46 { dot -= 1 }
    if dot == 0 || dot == name.length { return false }
    const extension = name[dot..name.length]
    var from: usize = 0
    while from < list.length {
        var to = from
        while to < list.length && list[to] != 32 { to += 1 }
        if to - from == extension.length {
            var same = true
            var index: usize = 0
            while index < extension.length {
                if lowered(extension[index]) != list[from + index] { same = false }
                index += 1
            }
            if same { return true }
        }
        from = to + 1
    }
    return false
}

// The kind of a file by its MIME type (when known), else its name's
// extension.
pub fn fileKind(name: []const u8, mime: []const u8) -> u8 {
    if startsWithLowered(mime, "inode/directory") { return FILE_FOLDER }
    if startsWithLowered(mime, "image/") { return FILE_IMAGE }
    if startsWithLowered(mime, "audio/") { return FILE_AUDIO }
    if startsWithLowered(mime, "video/") { return FILE_VIDEO }
    if extensionIn(name, "zip gz tgz bz2 xz zst tar 7z rar deb rpm jar iso dmg") || startsWithLowered(mime, "application/zip") || startsWithLowered(mime, "application/gzip") || startsWithLowered(mime, "application/x-tar") { return FILE_ARCHIVE }
    if extensionIn(name, "png jpg jpeg gif webp bmp svg ico avif tif tiff heic") { return FILE_IMAGE }
    if extensionIn(name, "mp3 ogg oga opus wav flac m4a aac") { return FILE_AUDIO }
    if extensionIn(name, "mp4 webm mkv ogv mov avi m4v") { return FILE_VIDEO }
    if extensionIn(name, "pdf doc docx odt rtf epub xls xlsx ods ppt pptx odp") || startsWithLowered(mime, "application/pdf") { return FILE_DOCUMENT }
    if extensionIn(name, "c h cpp hpp cc rs py js ts mjs json xml html htm css sh mlx go java rb lua toml yaml yml") || startsWithLowered(mime, "text/html") || startsWithLowered(mime, "application/json") { return FILE_CODE }
    if extensionIn(name, "txt text md log csv ini conf") || startsWithLowered(mime, "text/") { return FILE_TEXT }
    return FILE_GENERIC
}

// A file's mark of KIND in a 16 x 20 box at (x, y): a page with a corner
// folded (a folder's tab and body for FILE_FOLDER) in COLOR, and on it
// what the kind is in ACCENT: lines of text, a document's band, a
// picture's hill and sun, a note, a play triangle, a zip's teeth, a
// pair of brackets.
pub fn fileScaled(canvas: *Canvas, x: i32, y: i32, kind: u8, color: u32, accent: u32, scale: i32) -> void {
    const s = scale
    if kind == FILE_FOLDER {
        canvas_module.fillRoundedRect(canvas, x, y + 5 * s, 16 * s, 12 * s, 2 * s, color)
        canvas_module.fillRoundedRect(canvas, x, y + 3 * s, 7 * s, 4 * s, s, color)
        return
    }
    // The page: its outline, the corner cut and folded.
    canvas_module.fillRect(canvas, x + s, y, 10 * s, s, color)
    canvas_module.fillRect(canvas, x + s, y, s, 20 * s, color)
    canvas_module.fillRect(canvas, x + s, y + 19 * s, 14 * s, s, color)
    canvas_module.fillRect(canvas, x + 14 * s, y + 5 * s, s, 15 * s, color)
    var step: i32 = 0
    while step < 5 {
        canvas_module.fillRect(canvas, x + (10 + step) * s, y + step * s, s, s, color)
        step += 1
    }
    canvas_module.fillRect(canvas, x + 10 * s, y, s, 5 * s, color)
    canvas_module.fillRect(canvas, x + 10 * s, y + 4 * s, 5 * s, s, color)
    if kind == FILE_TEXT {
        var line: i32 = 0
        while line < 4 {
            canvas_module.fillRect(canvas, x + 4 * s, y + (8 + 3 * line) * s, (if line == 3 { 5 } else { 8 }) * s, s, accent)
            line += 1
        }
    } else if kind == FILE_DOCUMENT {
        canvas_module.fillRect(canvas, x + 4 * s, y + 7 * s, 8 * s, 3 * s, accent)
        canvas_module.fillRect(canvas, x + 4 * s, y + 12 * s, 8 * s, s, accent)
        canvas_module.fillRect(canvas, x + 4 * s, y + 15 * s, 6 * s, s, accent)
    } else if kind == FILE_IMAGE {
        dot(canvas, x + 9 * s, y + 7 * s, 3 * s, accent)
        var hill: i32 = 0
        while hill < 5 {
            canvas_module.fillRect(canvas, x + (8 - hill) * s, y + (12 + hill) * s, (2 + 2 * hill) * s, s, accent)
            hill += 1
        }
    } else if kind == FILE_AUDIO {
        dot(canvas, x + 4 * s, y + 13 * s, 4 * s, accent)
        canvas_module.fillRect(canvas, x + 7 * s, y + 7 * s, s, 8 * s, accent)
        canvas_module.fillRect(canvas, x + 7 * s, y + 7 * s, 4 * s, s, accent)
    } else if kind == FILE_VIDEO {
        var wedge: i32 = 0
        while wedge < 4 {
            canvas_module.fillRect(canvas, x + (6 + wedge) * s, y + (9 + wedge / 2) * s, s, (7 - wedge) * s, accent)
            wedge += 1
        }
    } else if kind == FILE_ARCHIVE {
        var tooth: i32 = 0
        while tooth < 6 {
            canvas_module.fillRect(canvas, x + (if tooth % 2 == 0 { 6 } else { 8 }) * s, y + (2 + 2 * tooth) * s, 2 * s, s, accent)
            tooth += 1
        }
        canvas_module.fillRoundedRect(canvas, x + 6 * s, y + 14 * s, 4 * s, 3 * s, s, accent)
    } else if kind == FILE_CODE {
        var arm: i32 = 0
        while arm < 3 {
            canvas_module.fillRect(canvas, x + (6 - arm) * s, y + (10 + arm) * s, s, s, accent)
            canvas_module.fillRect(canvas, x + (6 - arm) * s, y + (14 - arm) * s, s, s, accent)
            canvas_module.fillRect(canvas, x + (9 + arm) * s, y + (10 + arm) * s, s, s, accent)
            canvas_module.fillRect(canvas, x + (9 + arm) * s, y + (14 - arm) * s, s, s, accent)
            arm += 1
        }
    }
}
