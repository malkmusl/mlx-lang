// std.ui.surface: the surfaces the Mlx look is made of (see
// docs/reference/design.md): a raised surface floating on a soft shadow
// with a hairline of light along its top, a glow around what is on, a
// card grouping rows on a page, and a glass panel the compositor blurs
// what is behind. Widgets (std.ui.controls and the modules after it) draw
// themselves with these; an app draws its own panels with them too.
//
//     surface.card(&ui, area)                       // rows go inside
//     surface.raised(&ui, area, radius, theme.raised, theme.elevation)
//     surface.glow(&ui, area, radius, 6 * s)       // around a focused field
//     surface.glass(&ui, area)                      // a side bar, blurred behind
//     host.applyBlur(host, &ui)                     // after the frame
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")

const Ui = view.Ui

// The radius that makes `area` a capsule.
pub fn capsule(area: ui.Rect) -> i32 { return (if area.height < area.width { area.height } else { area.width }) / 2 }

// A surface floating `elevation` pixels over the page: its shadow (offset
// downward by a third of that), `fill` with corners of `radius`, and the
// hairline of light along its top.
pub fn raised(context: *Ui, area: ui.Rect, radius: i32, fill: u32, elevation: i32) -> void {
    const theme = context.*.theme
    const canvas = context.*.canvas
    if elevation > 0 { canvas_module.shadow(canvas, area.x, area.y + elevation / 3, area.width, area.height, radius, elevation, theme.*.shadow) }
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, radius, fill)
    hairline(context, area, radius)
}

// The hairline of light along the top edge of a surface of `radius`.
pub fn hairline(context: *Ui, area: ui.Rect, radius: i32) -> void {
    canvas_module.topHighlight(context.*.canvas, area.x, area.y, area.width, radius, context.*.theme.*.scale, context.*.theme.*.highlight)
}

// The accent's glow `reach` pixels around a surface of `radius` (draw it
// before the surface): a control that is on, a field with the focus.
pub fn glow(context: *Ui, area: ui.Rect, radius: i32, reach: i32) -> void {
    glowIn(context, area, radius, reach, context.*.theme.*.glow)
}

// A glow in a colour of its own (a kind's colour).
pub fn glowIn(context: *Ui, area: ui.Rect, radius: i32, reach: i32, color: u32) -> void {
    canvas_module.shadow(context.*.canvas, area.x, area.y, area.width, area.height, radius, reach, color)
}

// A card: a group of rows floating on the page (the theme's card tint,
// large corners, the theme's elevation).
pub fn card(context: *Ui, area: ui.Rect) -> void {
    const theme = context.*.theme
    raised(context, area, theme.*.largeRadius, theme.*.card, theme.*.elevation)
}

// A glass panel: the theme's translucent tint, and the area named as
// glass (std.ui.view.blurRegion) so the compositor blurs what is behind
// the window there once the app hands the frame's glass on
// (std.ui.host.applyBlur). The window must be clear (alpha 0) under it:
// clear the canvas to 0 and paint the opaque parts over it.
pub fn glass(context: *Ui, area: ui.Rect) -> void {
    canvas_module.fillRect(context.*.canvas, area.x, area.y, area.width, area.height, context.*.theme.*.glass)
    view.blurRegion(context, area)
}

// A bar (a header, a toolbar) along the window's edge: glass, casting
// its shadow down onto the content below it (the content stops at the
// bar: what is behind the bar is the desktop, not the content).
pub fn bar(context: *Ui, area: ui.Rect) -> void {
    const theme = context.*.theme
    glass(context, area)
    canvas_module.shadowBelow(context.*.canvas, area.x, ui.bottom(area), area.width, theme.*.elevation, theme.*.shadow)
}

// A panel at the left of the content (a side bar) casting its shadow onto
// the content beside it.
pub fn sidePanel(context: *Ui, area: ui.Rect) -> void {
    const theme = context.*.theme
    glass(context, area)
    canvas_module.shadowRightOf(context.*.canvas, ui.right(area), area.y, area.height, theme.*.elevation, theme.*.shadow)
}
