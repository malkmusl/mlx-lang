// std.ui.widgets: the widgets of std.ui.controls (and a text field) as
// rows of a std.ui.flow.Flow that keep the app's state themselves: a
// toggle flips the bool it is given, a slider moves the value, a segment
// sets the choice. Each returns true when it changed something (or was
// clicked), takes its id from its label (see std.ui.flow) and its sizes
// in logical pixels. Rows group in cards floating on the page.
//
//     var page = flow.begin(&ui, area, scale)
//     widgets.section(&page, "Appearance")
//     widgets.cardBegin(&page, "appearance")
//     if widgets.toggle(&page, "Dark look", "The desktop apps' colours", &state.dark) { ... }
//     if widgets.slider(&page, "Brightness", &state.brightness, 100) { ... }
//     var choice = widgets.segments(&page, 3)
//     _ = widgets.segment(&page, &choice, "Small", &state.size)
//     _ = widgets.segment(&page, &choice, "Medium", &state.size)
//     _ = widgets.segment(&page, &choice, "Large", &state.size)
//     widgets.cardEnd(&page)
//     if widgets.wideButton(&page, "Apply", controls.BUTTON_PRIMARY) { apply() }
//
// A card draws its background before the rows in it: as tall as it was in
// the last frame (std.ui.view.measured). The first frame that shows a
// card, or one whose rows changed, is drawn again at once (view.end says
// so); an app that lays out before it first draws (as std.ui.app
// recommends) never shows one without.
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const controls = @import("std.ui.controls")
const field_module = @import("std.ui.field")
const popup = @import("std.ui.popup")
const surface = @import("std.ui.surface")
const flow_module = @import("std.ui.flow")

const Flow = flow_module.Flow

// Row heights (logical pixels): a switch row with a note, one without
// (and a check, radio or value row), a button, a field, a section's
// heading, a line of text.
pub const ROW: i32 = 52
pub const SHORT_ROW: i32 = 40
pub const BUTTON: i32 = 36
pub const FIELD: i32 = 36
pub const SECTION: i32 = 32
pub const LINE: i32 = 24
// A card's inner padding and the space between the cards; text starts
// TEXT_INSET in from the rows' edge (a card's padding and the control's
// own padding add up to it).
pub const CARD_PADDING: i32 = 8
pub const CARD_GAP: i32 = 16
pub const TEXT_INSET: i32 = 16

fn px(flow: *const Flow, logical: i32) -> i32 { return flow_module.px(flow, logical) }

// ---------------------------------------------------------------------------
// Text

// Where text starts in a row at `area` (the alignment edge).
fn textX(flow: *const Flow, area: ui.Rect) -> i32 { return area.x + px(flow, TEXT_INSET) - flow.*.inset }

// A section's name, bold and dim, above its rows.
pub fn section(flow: *Flow, name: []const u8) -> void {
    const context = flow.*.ui
    const area = flow_module.row(flow, SECTION)
    const font = context.*.bold
    controls.label(context, font, name, textX(flow, area), area.y + area.height - font.*.ascent * 3 / 2 - px(flow, 4), context.*.theme.*.dim, area.width)
}

// A line of body text.
pub fn line(flow: *Flow, text: []const u8) -> void {
    const context = flow.*.ui
    const area = flow_module.row(flow, LINE)
    controls.label(context, context.*.body, text, textX(flow, area), controls.textTop(context.*.body, area.y, area.height), context.*.theme.*.text, area.width - px(flow, 8))
}

// A note: small dim text wrapped to the width (at most eight lines).
pub fn note(flow: *Flow, text: []const u8) -> void {
    const context = flow.*.ui
    const font = context.*.small
    const line_height = font.*.ascent * 3 / 2 + 2 * flow.*.scale
    const width = flow_module.width(flow) - px(flow, TEXT_INSET) * 2
    var height = popup.wrappedHeight(font, text, width, line_height, 8)
    if height < line_height { height = line_height }
    const area = flow_module.rowPixels(flow, height + px(flow, 4))
    _ = popup.wrapped(context, font, text, textX(flow, area), area.y + px(flow, 2), width, line_height, 8, context.*.theme.*.dim)
}

// A row with `name` dim at the left and `value` after it (read only).
pub fn infoRow(flow: *Flow, name: []const u8, value: []const u8) -> void {
    const context = flow.*.ui
    const area = flow_module.row(flow, SHORT_ROW)
    const half = area.width * 2 / 5
    const top = controls.textTop(context.*.body, area.y, area.height)
    const left = textX(flow, area)
    controls.label(context, context.*.body, name, left, top, context.*.theme.*.dim, half - px(flow, 8))
    controls.label(context, context.*.body, value, area.x + half, top, context.*.theme.*.text, area.width - half - px(flow, 4))
}

// ---------------------------------------------------------------------------
// Rows that keep state

// A switch row: `title`, `note` under it (none: a shorter row), the
// switch at the right. A click flips `on`; true then.
pub fn toggle(flow: *Flow, title: []const u8, note_text: []const u8, on: *bool) -> bool {
    const area = flow_module.row(flow, if note_text.length > 0 { ROW } else { SHORT_ROW })
    if controls.switchRow(flow.*.ui, flow_module.idFor(flow, title), area, title, note_text, on.*) {
        on.* = !on.*
        return true
    }
    return false
}

// A row with a check box and `label`; a click flips `on`; true then.
pub fn check(flow: *Flow, label: []const u8, on: *bool) -> bool {
    const area = flow_module.row(flow, SHORT_ROW)
    if controls.checkRow(flow.*.ui, flow_module.idFor(flow, label), area, label, if on.* { controls.CHECK_ON } else { controls.CHECK_OFF }) {
        on.* = !on.*
        return true
    }
    return false
}

// A row with a radio button and `label`, chosen while `choice` is
// `value`; a click makes it so; true when that changed the choice.
pub fn radio(flow: *Flow, label: []const u8, choice: *usize, value: usize) -> bool {
    const area = flow_module.row(flow, SHORT_ROW)
    if controls.radioRow(flow.*.ui, flow_module.idFor(flow, label), area, label, choice.* == value) {
        if choice.* == value { return false }
        choice.* = value
        return true
    }
    return false
}

// A choice of `count` segments in one row: segments() takes the row and
// draws the trough, then one segment() per choice, in order.
pub const Segments = struct {
    area: ui.Rect
    count: usize
    next: usize
}

pub fn segments(flow: *Flow, count: usize) -> Segments {
    const area = flow_module.row(flow, SHORT_ROW)
    controls.segmentsFrame(flow.*.ui, area)
    return Segments.{ .area = area, .count = if count > 0 { count } else { 1 }, .next = 0 }
}

// The next segment, `label`: chosen while `choice` is its index; a click
// makes it so; true when that changed the choice.
pub fn segment(flow: *Flow, choice_row: *Segments, label: []const u8, choice: *usize) -> bool {
    const index = choice_row.*.next
    choice_row.*.next += 1
    const s = flow.*.scale
    const inner = ui.inset(choice_row.*.area, ui.uniform(2 * s))
    const step = inner.width / @intCast(i32, choice_row.*.count)
    const area = ui.rect(inner.x + @intCast(i32, index) * step, inner.y, step, inner.height)
    if controls.segment(flow.*.ui, flow_module.idFor(flow, label), area, label, choice.* == index, 0) {
        if choice.* == index { return false }
        choice.* = index
        return true
    }
    return false
}

// A slider row: `label` at the left, the slider, the value as a percentage
// of `most` at the right. Dragging, a click or the wheel over it moves
// `value`; true when it changed.
pub fn slider(flow: *Flow, label: []const u8, value: *u32, most: u32) -> bool {
    const context = flow.*.ui
    const area = flow_module.row(flow, SHORT_ROW)
    const label_width = area.width * 2 / 5
    const number_width = px(flow, 56)
    const top = controls.textTop(context.*.body, area.y, area.height)
    controls.label(context, context.*.body, label, textX(flow, area), top, context.*.theme.*.text, label_width - px(flow, 12))
    const track = ui.rect(area.x + label_width, area.y + px(flow, 6), area.width - label_width - number_width - px(flow, 8), area.height - px(flow, 12))
    const now = controls.slider(context, flow_module.idFor(flow, label), track, value.*, most)
    var digits: [12]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &digits) }
    var percent: u32 = 0
    if most != 0 { percent = (now * 100 + most / 2) / most }
    var length = decimal(percent, bytes)
    bytes[length] = 37
    length += 1
    controls.label(context, context.*.body, bytes[0..length], ui.right(area) - number_width + px(flow, 10), top, context.*.theme.*.dim, number_width)
    if now == value.* { return false }
    value.* = now
    return true
}

// `value` in decimal into `bytes` (room for 10 digits); how many.
fn decimal(value: u32, bytes: [*]u8) -> usize {
    var reversed: [10]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        reversed[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var length: usize = 0
    while count > 0 {
        count -= 1
        bytes[length] = reversed[count]
        length += 1
    }
    return length
}

// A row with `title` and `value` in a capsule at its right (a choice that
// changes on a click, a key binding being recorded while `active`); true
// when clicked.
pub fn valueRow(flow: *Flow, title: []const u8, value: []const u8, active: bool) -> bool {
    const area = flow_module.row(flow, SHORT_ROW)
    const box = if area.width > px(flow, 380) { px(flow, 150) } else { area.width / 3 }
    return controls.valueRow(flow.*.ui, flow_module.idFor(flow, title), area, title, value, box, active)
}

// A one-line text field (std.ui.field) the whole width; true when
// clicked (it takes the focus itself).
pub fn textField(flow: *Flow, placeholder: []const u8, field: *field_module.Field, search: bool) -> bool {
    const area = flow_module.row(flow, FIELD)
    return field_module.textField(flow.*.ui, flow_module.idFor(flow, placeholder), area, field, placeholder, search)
}

// ---------------------------------------------------------------------------
// Buttons

// A button at the row's left, as wide as its label needs; true when
// clicked. `kind` is controls.BUTTON_NORMAL or BUTTON_PRIMARY.
pub fn button(flow: *Flow, label: []const u8, kind: u8) -> bool {
    const context = flow.*.ui
    const area = flow_module.row(flow, BUTTON)
    var width = controls.buttonWidth(context, context.*.body, label) + px(flow, 12)
    if width > area.width { width = area.width }
    return controls.button(context, flow_module.idFor(flow, label), ui.rect(textX(flow, area) - px(flow, 8), area.y, width, area.height), label, kind, true)
}

// A button across the whole row (a phone's main action).
pub fn wideButton(flow: *Flow, label: []const u8, kind: u8) -> bool {
    const area = flow_module.row(flow, BUTTON)
    return controls.button(flow.*.ui, flow_module.idFor(flow, label), area, label, kind, true)
}

// ---------------------------------------------------------------------------
// Cards

// Opens a card named `name`: its background (as tall as last time) and
// an inset for the rows until cardEnd.
pub fn cardBegin(flow: *Flow, name: []const u8) -> void {
    const context = flow.*.ui
    const card_id = flow_module.idFor(flow, name)
    const height = view.measured(context, card_id)
    if height > 0 { surface.card(context, ui.rect(flow_module.left(flow), flow.*.y, flow_module.width(flow), height)) }
    flow.*.cardId = card_id
    flow.*.cardTop = flow.*.y
    flow.*.inset += px(flow, CARD_PADDING)
    flow.*.y += px(flow, CARD_PADDING)
}

// Closes the card: remembers how tall it came out, for the next frame.
pub fn cardEnd(flow: *Flow) -> void {
    if flow.*.cardId == view.NONE { return }
    // Back over the gap after the last row, then the padding.
    flow.*.y += px(flow, CARD_PADDING) - px(flow, flow.*.gap)
    view.setMeasured(flow.*.ui, flow.*.cardId, flow.*.y - flow.*.cardTop)
    flow.*.inset -= px(flow, CARD_PADDING)
    if flow.*.inset < 0 { flow.*.inset = 0 }
    flow.*.cardId = view.NONE
    flow.*.y += px(flow, CARD_GAP)
}
