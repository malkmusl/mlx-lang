// std.ui.chooser: a file chooser drawn in an app's own window, over what
// it covers (a popup's frame): a button up to the folder above, the path
// field (std.ui.field: the folder's path, or one typed or pasted: Tab
// completes a name as far as the folder's entries agree, a folder's with
// its slash; Enter goes to a folder, or opens a file; "/" or "~" typed
// over the list starts a path there), the places on the left (Home and
// the user's folders that exist: Desktop, Documents, Downloads, Pictures,
// Music, Videos, by std.xdg's user-dirs; then "/", the root), the folder's
// entries (folders first, then files, each by name; hidden ones left
// out), Cancel and Open. A click on a folder goes into it; a click on a
// file chooses it (with `multiple`, it is added to or taken from those
// chosen); files the chooser does not accept (its `accept` list, as
// <input accept> has it: extensions and MIME types, "image/*" among
// them) are dim and not chosen. Keys: Up and Down move the one chosen,
// Enter goes into a folder or opens what is chosen, Backspace goes up,
// Escape cancels (or leaves the path field). Started for an app
// (startFor), it opens in the folder the app last chose in (kept in
// $XDG_STATE_HOME/mlx/chooser/APP_ID, written when files are chosen).
//
//     var files = chooser.Chooser.init()
//     chooser.startFor(&files, environment, "org.mlx.voyager", home, multiple, ".txt,image/*")
//     // each frame, over the area it covers:
//     const result = chooser.draw(&files, &ui, area)
//     if result == chooser.CHOSEN { chooser.paths(&files, &list) }   // a path a line
//     if result != chooser.WAITING { ... closed ... }
//     // a key while it is shown (what it typed, for the path field):
//     chooser.keyTyped(&files, code, modifiers, typed)
//     files.deinit()
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const controls = @import("std.ui.controls")
const lists = @import("std.ui.lists")
const popup = @import("std.ui.popup")
const scroll_module = @import("std.ui.scroll")
const glyphs = @import("std.ui.glyphs")
const text_module = @import("std.ui.text")
const field_module = @import("std.ui.field")
const keys = @import("std.ui.keys")
const xdg = @import("std.xdg")

const Ui = view.Ui

// What draw answers.
pub const WAITING: u8 = 0
pub const CHOSEN: u8 = 1
pub const CANCELLED: u8 = 2

// Linux's key codes the chooser takes.
pub const KEY_ESCAPE: u32 = 1
pub const KEY_BACKSPACE: u32 = 14
pub const KEY_ENTER: u32 = 28
pub const KEY_TAB: u32 = 15
pub const KEY_UP: u32 = 103
pub const KEY_DOWN: u32 = 108

const ROW: i32 = 28
const HEADER: i32 = 44
const FOOTER: i32 = 52
const WIDTH: i32 = 720
const HEIGHT: i32 = 440
// The places' column.
const PLACES: i32 = 150
const PATH_CAPACITY: usize = 4096

const Entry = struct {
    // The name's bytes in the chooser's names.
    at: usize
    length: usize
    isFolder: bool
    accepted: bool
    chosen: bool
    size: u64
}

// A place on the left: its name and path in the chooser's placeNames.
const Place = struct {
    nameAt: usize
    nameLength: usize
    pathAt: usize
    pathLength: usize
}

pub const Chooser = @noncopy(struct) {
    // The folder shown (no slash at its end but for "/").
    folder: std.ArrayList(u8)
    names: std.ArrayList(u8)
    entries: std.ArrayList(Entry)
    // The entry the keys move (the list's length: none).
    current: usize
    multiple: bool
    accept: std.ArrayList(u8)
    list: scroll_module.Scroll
    // A key's result for the next draw (WAITING: none).
    pending: u8
    // The path field, whether it has the keys (as last drawn), and what
    // the next draw does with its focus (0: nothing, 1: takes it, 2:
    // gives it up).
    location: field_module.Field
    editing: bool
    focusChange: u8
    // The places, and the app whose last folder is kept (none: not kept)
    // with the file it is kept in.
    places: std.ArrayList(Place)
    placeNames: std.ArrayList(u8)
    kept: std.ArrayList(u8)

    pub fn init() -> Self {
        var made = Self.{
            .folder = std.ArrayList(u8).init(std.heap.allocator()),
            .names = std.ArrayList(u8).init(std.heap.allocator()),
            .entries = std.ArrayList(Entry).init(std.heap.allocator()),
            .current = 0,
            .multiple = false,
            .accept = std.ArrayList(u8).init(std.heap.allocator()),
            .list = undefined,
            .pending = WAITING,
            .location = undefined,
            .editing = false,
            .focusChange = 0,
            .places = std.ArrayList(Place).init(std.heap.allocator()),
            .placeNames = std.ArrayList(u8).init(std.heap.allocator()),
            .kept = std.ArrayList(u8).init(std.heap.allocator()),
        }
        scroll_module.init(&made.list)
        field_module.init(&made.location)
        return @move(made)
    }

    pub fn deinit(self: *Self) -> void {
        self.*.folder.deinit()
        self.*.names.deinit()
        self.*.entries.deinit()
        self.*.accept.deinit()
        field_module.deinit(&self.*.location)
        self.*.places.deinit()
        self.*.placeNames.deinit()
        self.*.kept.deinit()
    }
}

fn lower(c: u8) -> u8 { return if c >= 65 && c <= 90 { c + 32 } else { c } }

fn sameIgnoringCase(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if lower(a[index]) != lower(b[index]) { return false }
        index += 1
    }
    return true
}

fn endsWithIgnoringCase(text: []const u8, end: []const u8) -> bool {
    return text.length >= end.length && sameIgnoringCase(text[text.length - end.length..text.length], end)
}

// The extensions a MIME type (or a "type/*") stands for, space-separated
// and each with its dot.
fn extensionsOf(kind: []const u8) -> []const u8 {
    if sameIgnoringCase(kind, "image/*") { return ".png .jpg .jpeg .gif .webp .bmp .svg .ico .avif" }
    if sameIgnoringCase(kind, "text/*") { return ".txt .text .html .htm .css .csv .md .xml .js" }
    if sameIgnoringCase(kind, "audio/*") { return ".mp3 .ogg .oga .opus .wav .flac .m4a .webm" }
    if sameIgnoringCase(kind, "video/*") { return ".mp4 .webm .mkv .ogv .mov" }
    if sameIgnoringCase(kind, "text/plain") { return ".txt .text" }
    if sameIgnoringCase(kind, "text/html") { return ".html .htm" }
    if sameIgnoringCase(kind, "text/css") { return ".css" }
    if sameIgnoringCase(kind, "text/csv") { return ".csv" }
    if sameIgnoringCase(kind, "application/json") { return ".json" }
    if sameIgnoringCase(kind, "application/pdf") { return ".pdf" }
    if sameIgnoringCase(kind, "application/zip") { return ".zip" }
    if sameIgnoringCase(kind, "image/png") { return ".png" }
    if sameIgnoringCase(kind, "image/jpeg") { return ".jpg .jpeg" }
    if sameIgnoringCase(kind, "image/gif") { return ".gif" }
    if sameIgnoringCase(kind, "image/webp") { return ".webp" }
    if sameIgnoringCase(kind, "image/svg+xml") { return ".svg" }
    return ""
}

// Whether a file NAME is one ACCEPT (comma-separated extensions and MIME
// types; empty: any) takes.
pub fn accepts(accept: []const u8, name: []const u8) -> bool {
    var at: usize = 0
    var any = false
    while at < accept.length {
        var end = at
        while end < accept.length && accept[end] != 44 { end += 1 }
        var start = at
        while start < end && accept[start] == 32 { start += 1 }
        var stop = end
        while stop > start && accept[stop - 1] == 32 { stop -= 1 }
        const token = accept[start..stop]
        at = end + 1
        if token.length == 0 { continue }
        any = true
        if token[0] == 46 {
            if endsWithIgnoringCase(name, token) { return true }
            continue
        }
        const list = extensionsOf(token)
        var from: usize = 0
        while from < list.length {
            var to = from
            while to < list.length && list[to] != 32 { to += 1 }
            if endsWithIgnoringCase(name, list[from..to]) { return true }
            from = to + 1
        }
    }
    return !any
}

fn nameOf(chooser: *Chooser, entry: Entry) -> []const u8 { return chooser.*.names.items()[entry.at..entry.at + entry.length] }

// Whether entry A comes before B: folders first, then by name (letters'
// case aside).
fn before(chooser: *Chooser, a: Entry, b: Entry) -> bool {
    if a.isFolder != b.isFolder { return a.isFolder }
    const x = nameOf(chooser, a)
    const y = nameOf(chooser, b)
    var index: usize = 0
    while index < x.length && index < y.length {
        if lower(x[index]) != lower(y[index]) { return lower(x[index]) < lower(y[index]) }
        index += 1
    }
    return x.length < y.length
}

// The folder's path with NAME after it, NUL-terminated, into INTO.
fn childPath(chooser: *Chooser, name: []const u8, into: *std.ArrayList(u8)) -> bool {
    into.clearRetainingCapacity()
    const folder = chooser.*.folder.items()
    var ok = into.appendSlice(folder)
    if folder.length == 0 || folder[folder.length - 1] != 47 { ok = ok && into.append(47) }
    return ok && into.appendSlice(name) && into.append(0)
}

// The folder's entries read again (sorted, the first one current).
fn readFolder(chooser: *Chooser) -> void {
    chooser.*.names.clearRetainingCapacity()
    chooser.*.entries.clearRetainingCapacity()
    chooser.*.current = 0
    chooser.*.list.offset = 0
    var path = std.ArrayList(u8).init(std.heap.allocator())
    defer path.deinit()
    if !path.appendSlice(chooser.*.folder.items()) || !path.append(0) { return }
    const folder = std.fs.open(path.items().pointer, std.fs.READ_ONLY | std.fs.DIRECTORY, 0)
    if !std.fs.isValid(folder) { return }
    var buffer: [8192]u8 = undefined
    const bytes: [*]u8 = &buffer
    var reader = std.fs.entries(folder, bytes, 8192)
    var found: std.fs.Entry = undefined
    var child = std.ArrayList(u8).init(std.heap.allocator())
    defer child.deinit()
    while std.fs.nextEntry(&reader, &found) {
        const name = found.name.pointer[0..found.name.length]
        // (Hidden ones, "." and ".." among them, left out.)
        if name.length == 0 || name[0] == 46 { continue }
        var isFolder = found.kind == std.fs.ENTRY_DIRECTORY
        var size: u64 = 0
        if found.kind == std.fs.ENTRY_UNKNOWN || found.kind == std.fs.ENTRY_SYMBOLIC_LINK || found.kind == std.fs.ENTRY_FILE {
            var status: std.fs.Stat = undefined
            if childPath(chooser, name, &child) && std.fs.status(child.items().pointer, &status) == 0 {
                isFolder = (status.mode & 0o170000) == 0o040000
                size = @intCast(u64, status.size)
            }
        }
        const entry = Entry.{ .at = chooser.*.names.count(), .length = name.length, .isFolder = isFolder, .accepted = isFolder || accepts(chooser.*.accept.items(), name), .chosen = false, .size = size }
        if !chooser.*.names.appendSlice(name) || !chooser.*.entries.append(entry) { break }
    }
    _ = std.fs.close(folder)
    showFolder(chooser)
    // (Insertion sort: a folder of a few hundred entries.)
    const items = chooser.*.entries.items()
    var index: usize = 1
    while index < items.length {
        const moving = items[index]
        var at = index
        while at > 0 && before(chooser, moving, items[at - 1]) {
            items[at] = items[at - 1]
            at -= 1
        }
        items[at] = moving
        index += 1
    }
}

// The path field shows the folder (with a slash after it, ready for a
// name).
fn showFolder(chooser: *Chooser) -> void {
    var shown = std.ArrayList(u8).init(std.heap.allocator())
    defer shown.deinit()
    const path = chooser.*.folder.items()
    _ = shown.appendSlice(path)
    if path.length == 0 || path[path.length - 1] != 47 { _ = shown.append(47) }
    field_module.set(&chooser.*.location, shown.items())
}

// Whether PATH (no NUL) is a folder.
fn isFolder(path: []const u8) -> bool {
    var terminated = std.ArrayList(u8).init(std.heap.allocator())
    defer terminated.deinit()
    if !terminated.appendSlice(path) || !terminated.append(0) { return false }
    var status: std.fs.Stat = undefined
    return std.fs.status(terminated.items().pointer, &status) == 0 && (status.mode & 0o170000) == 0o040000
}

fn addPlace(chooser: *Chooser, name: []const u8, path: []const u8) -> void {
    const place = Place.{ .nameAt = chooser.*.placeNames.count(), .nameLength = name.length, .pathAt = chooser.*.placeNames.count() + name.length, .pathLength = path.length }
    if chooser.*.placeNames.appendSlice(name) && chooser.*.placeNames.appendSlice(path) { _ = chooser.*.places.append(place) }
}

fn placeName(chooser: *Chooser, place: Place) -> []const u8 { return chooser.*.placeNames.items()[place.nameAt..place.nameAt + place.nameLength] }
fn placePath(chooser: *Chooser, place: Place) -> []const u8 { return chooser.*.placeNames.items()[place.pathAt..place.pathAt + place.pathLength] }

// The places of ENVIRONMENT: Home, the user's folders that exist (and
// are not the home itself), the root.
pub fn findPlaces(chooser: *Chooser, environment: [*][*]const u8) -> void {
    chooser.*.places.clearRetainingCapacity()
    chooser.*.placeNames.clearRetainingCapacity()
    const home = xdg.absolute(environment, "HOME")
    if home.length > 0 && isFolder(home) { addPlace(chooser, "Home", home) }
    const names: [6][]const u8 = [6][]const u8{ "Desktop", "Documents", "Downloads", "Pictures", "Music", "Videos" }
    const keysOf: [6][]const u8 = [6][]const u8{ "DESKTOP", "DOCUMENTS", "DOWNLOAD", "PICTURES", "MUSIC", "VIDEOS" }
    var index: usize = 0
    while index < 6 {
        var fallback = std.ArrayList(u8).init(std.heap.allocator())
        defer fallback.deinit()
        _ = fallback.append(47)
        _ = fallback.appendSlice(names[index])
        var found: [4096]u8 = undefined
        const foundBytes: [*]u8 = &found
        const length = xdg.userDirectory(environment, keysOf[index], fallback.items(), foundBytes, 4096)
        if length > 0 && !std.text.same(foundBytes[0..length], home) && isFolder(foundBytes[0..length]) { addPlace(chooser, names[index], foundBytes[0..length]) }
        index += 1
    }
    addPlace(chooser, "/", "/")
}

// The file the last folder of APP_ID is kept in, NUL-terminated, into
// the chooser's kept (empty: none).
fn keptFile(chooser: *Chooser, environment: [*][*]const u8, appId: []const u8) -> void {
    chooser.*.kept.clearRetainingCapacity()
    if appId.length == 0 { return }
    for c in appId {
        if c == 47 || c == 0 { return }
    }
    var state: [4096]u8 = undefined
    const stateBytes: [*]u8 = &state
    const length = xdg.home(environment, xdg.STATE, stateBytes, 4096)
    if length == 0 { return }
    _ = chooser.*.kept.appendSlice(stateBytes[0..length])
    _ = chooser.*.kept.appendSlice("/mlx/chooser/")
    _ = chooser.*.kept.appendSlice(appId)
    _ = chooser.*.kept.append(0)
}

// The folder APP_ID last chose in, into INTO (empty: none kept, or gone).
pub fn rememberedFolder(chooser: *Chooser, environment: [*][*]const u8, appId: []const u8, into: *std.ArrayList(u8)) -> bool {
    into.clearRetainingCapacity()
    keptFile(chooser, environment, appId)
    if chooser.*.kept.count() == 0 { return false }
    var text: [4096]u8 = undefined
    const length = std.fs.readFile(chooser.*.kept.items().pointer, &text, 4095)
    var end = length
    while end > 0 && (text[end - 1] == 10 || text[end - 1] == 0) { end -= 1 }
    if end == 0 || text[0] != 47 || !isFolder(text[0..end]) { return false }
    return into.appendSlice(text[0..end])
}

// The folder files were chosen in, kept for the app (startFor's).
fn remember(chooser: *Chooser) -> void {
    const file = chooser.*.kept.items()
    if file.length < 2 { return }
    var at = file.length - 1
    while at > 0 && file[at] != 47 { at -= 1 }
    if at == 0 { return }
    _ = std.fs.makeDirectories(file[0..at], 0o755)
    const opened = std.fs.open(file.pointer, std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE, 0o600)
    if !std.fs.isValid(opened) { return }
    const folder = chooser.*.folder.items()
    _ = std.fs.writeAllBytes(opened, folder.pointer, folder.length)
    _ = std.fs.writeAllBytes(opened, "\n".pointer, 1)
    _ = std.fs.close(opened)
}

// start for an app: in the folder APP_ID last chose in (else FOLDER),
// with the places of ENVIRONMENT; the folder chosen in is kept for it.
pub fn startFor(chooser: *Chooser, environment: [*][*]const u8, appId: []const u8, folder: []const u8, multiple: bool, accept: []const u8) -> void {
    findPlaces(chooser, environment)
    var remembered = std.ArrayList(u8).init(std.heap.allocator())
    defer remembered.deinit()
    const found = rememberedFolder(chooser, environment, appId, &remembered)
    start(chooser, if found { remembered.items() } else { folder }, multiple, accept)
}

// Shows FOLDER's files (an absolute path; "/" when it cannot be read),
// MULTIPLE files to be chosen or one, those ACCEPT takes.
pub fn start(chooser: *Chooser, folder: []const u8, multiple: bool, accept: []const u8) -> void {
    chooser.*.folder.clearRetainingCapacity()
    _ = chooser.*.folder.appendSlice(if folder.length > 0 { folder } else { "/" })
    while chooser.*.folder.count() > 1 && chooser.*.folder.items()[chooser.*.folder.count() - 1] == 47 { _ = chooser.*.folder.pop() }
    chooser.*.multiple = multiple
    chooser.*.accept.clearRetainingCapacity()
    _ = chooser.*.accept.appendSlice(accept)
    chooser.*.pending = WAITING
    chooser.*.editing = false
    chooser.*.focusChange = 2
    readFolder(chooser)
}

// The folder shown now.
pub fn folder(chooser: *Chooser) -> []const u8 { return chooser.*.folder.items() }

fn goUp(chooser: *Chooser) -> void {
    const path = chooser.*.folder.items()
    var end = path.length
    while end > 0 && path[end - 1] != 47 { end -= 1 }
    if end <= 1 { end = 1 } else { end -= 1 }
    _ = chooser.*.folder.resize(end)
    readFolder(chooser)
}

// Goes to FOLDER (an absolute path; its slashes at the end dropped).
pub fn goTo(chooser: *Chooser, folder: []const u8) -> void {
    chooser.*.folder.clearRetainingCapacity()
    _ = chooser.*.folder.appendSlice(if folder.length > 0 { folder } else { "/" })
    while chooser.*.folder.count() > 1 && chooser.*.folder.items()[chooser.*.folder.count() - 1] == 47 { _ = chooser.*.folder.pop() }
    readFolder(chooser)
}

// The path field's text as an absolute path into INTO: "~" as the home
// (the folder of the user's places' first), a relative one under the
// folder shown.
fn typedPath(chooser: *Chooser, into: *std.ArrayList(u8)) -> void {
    into.clearRetainingCapacity()
    const typed = field_module.text(&chooser.*.location)
    if typed.length > 0 && typed[0] == 126 && (typed.length == 1 || typed[1] == 47) {
        var home: []const u8 = ""
        for place in chooser.*.places.items() {
            if std.text.same(placeName(chooser, place), "Home") { home = placePath(chooser, place) }
        }
        _ = into.appendSlice(home)
        _ = into.appendSlice(typed[1..typed.length])
        return
    }
    if typed.length == 0 || typed[0] != 47 {
        _ = into.appendSlice(chooser.*.folder.items())
        if chooser.*.folder.count() == 0 || chooser.*.folder.items()[chooser.*.folder.count() - 1] != 47 { _ = into.append(47) }
    }
    _ = into.appendSlice(typed)
}

// Tab in the path field: the name after its last slash completed as far
// as the entries of the folder before it agree (a folder's alone with
// its slash after it); whether anything was added.
pub fn complete(chooser: *Chooser) -> bool {
    var path = std.ArrayList(u8).init(std.heap.allocator())
    defer path.deinit()
    typedPath(chooser, &path)
    const whole = path.items()
    var slash = whole.length
    while slash > 0 && whole[slash - 1] != 47 { slash -= 1 }
    if slash == 0 { return false }
    const partial = whole[slash..whole.length]
    var folderPath = std.ArrayList(u8).init(std.heap.allocator())
    defer folderPath.deinit()
    if !folderPath.appendSlice(whole[0..slash]) || !folderPath.append(0) { return false }
    const folder = std.fs.open(folderPath.items().pointer, std.fs.READ_ONLY | std.fs.DIRECTORY, 0)
    if !std.fs.isValid(folder) { return false }
    var buffer: [8192]u8 = undefined
    const bytes: [*]u8 = &buffer
    var reader = std.fs.entries(folder, bytes, 8192)
    var found: std.fs.Entry = undefined
    var common = std.ArrayList(u8).init(std.heap.allocator())
    defer common.deinit()
    var matches: usize = 0
    var onlyFolder = false
    while std.fs.nextEntry(&reader, &found) {
        const name = found.name.pointer[0..found.name.length]
        if std.text.same(name, ".") || std.text.same(name, "..") { continue }
        if name.length > 0 && name[0] == 46 && (partial.length == 0 || partial[0] != 46) { continue }
        if name.length < partial.length || !std.text.same(name[0..partial.length], partial) { continue }
        if matches == 0 {
            _ = common.appendSlice(name)
        } else {
            var agree: usize = 0
            const so = common.items()
            while agree < so.length && agree < name.length && so[agree] == name[agree] { agree += 1 }
            _ = common.resize(agree)
        }
        matches += 1
        if matches == 1 {
            var child = std.ArrayList(u8).init(std.heap.allocator())
            defer child.deinit()
            _ = child.appendSlice(whole[0..slash])
            _ = child.appendSlice(name)
            onlyFolder = isFolder(child.items())
        }
    }
    _ = std.fs.close(folder)
    if matches == 0 || common.count() < partial.length { return false }
    const added = common.items()[partial.length..common.count()]
    const location = &chooser.*.location
    // (The caret to the end, what is added after it.)
    location.*.cursor = location.*.length
    location.*.anchor = location.*.length
    var more = std.ArrayList(u8).init(std.heap.allocator())
    defer more.deinit()
    _ = more.appendSlice(added)
    if matches == 1 && onlyFolder { _ = more.append(47) }
    if more.count() == 0 { return false }
    field_module.insert(location, more.items())
    return true
}

// Enter in the path field: a folder gone to, a file there (one the
// chooser accepts) chosen and opened; false when the path is neither.
pub fn submit(chooser: *Chooser) -> bool {
    var path = std.ArrayList(u8).init(std.heap.allocator())
    defer path.deinit()
    typedPath(chooser, &path)
    if isFolder(path.items()) {
        goTo(chooser, path.items())
        chooser.*.focusChange = 2
        return true
    }
    const whole = path.items()
    var slash = whole.length
    while slash > 0 && whole[slash - 1] != 47 { slash -= 1 }
    if slash == 0 || slash == whole.length { return false }
    var name = std.ArrayList(u8).init(std.heap.allocator())
    defer name.deinit()
    if !name.appendSlice(whole[slash..whole.length]) { return false }
    var terminated = std.ArrayList(u8).init(std.heap.allocator())
    defer terminated.deinit()
    if !terminated.appendSlice(whole) || !terminated.append(0) || !std.fs.exists(terminated.items().pointer) { return false }
    goTo(chooser, whole[0..slash])
    var index: usize = 0
    for entry in chooser.*.entries.items() {
        if !entry.isFolder && std.text.same(nameOf(chooser, entry), name.items()) {
            if !entry.accepted { return false }
            chooser.*.current = index
            toggle(chooser, index)
            if !chooser.*.entries.items()[index].chosen { toggle(chooser, index) }
            chooser.*.pending = CHOSEN
            remember(chooser)
            return true
        }
        index += 1
    }
    return false
}

fn goInto(chooser: *Chooser, index: usize) -> void {
    const entry = chooser.*.entries.items()[index]
    var name = std.ArrayList(u8).init(std.heap.allocator())
    defer name.deinit()
    if !name.appendSlice(nameOf(chooser, entry)) { return }
    const folderPath = chooser.*.folder.items()
    if folderPath.length == 0 || folderPath[folderPath.length - 1] != 47 { _ = chooser.*.folder.append(47) }
    _ = chooser.*.folder.appendSlice(name.items())
    readFolder(chooser)
}

fn chosenCount(chooser: *Chooser) -> usize {
    var count: usize = 0
    for entry in chooser.*.entries.items() {
        if entry.chosen { count += 1 }
    }
    return count
}

// A file clicked (or Enter on it): chosen, added to or taken from those
// chosen when several may be.
fn toggle(chooser: *Chooser, index: usize) -> void {
    const items = chooser.*.entries.items()
    if !items[index].accepted { return }
    if !chooser.*.multiple {
        var other: usize = 0
        while other < items.length {
            items[other].chosen = false
            other += 1
        }
        items[index].chosen = true
        return
    }
    items[index].chosen = !items[index].chosen
}

// The chosen files' paths, a line each, into INTO.
pub fn paths(chooser: *Chooser, into: *std.ArrayList(u8)) -> void {
    into.clearRetainingCapacity()
    var path = std.ArrayList(u8).init(std.heap.allocator())
    defer path.deinit()
    for entry in chooser.*.entries.items() {
        if !entry.chosen { continue }
        if !childPath(chooser, nameOf(chooser, entry), &path) { continue }
        _ = into.appendSlice(path.items()[0..path.count() - 1])
        _ = into.append(10)
    }
}

// A key (Linux's code) while the chooser is shown; whether it took it.
pub fn key(chooser: *Chooser, code: u32) -> bool { return keyTyped(chooser, code, 0, "") }

// A key with the modifiers held and what it typed (the path field takes
// it while it has the keys); whether it took it.
pub fn keyTyped(chooser: *Chooser, code: u32, modifiers: u32, typed: []const u8) -> bool {
    if chooser.*.editing {
        if code == KEY_TAB {
            _ = complete(chooser)
            return true
        }
        if code == KEY_ESCAPE {
            showFolder(chooser)
            chooser.*.focusChange = 2
            chooser.*.editing = false
            return true
        }
        const result = field_module.fieldKey(&chooser.*.location, code, modifiers, typed)
        if result == field_module.KEY_SUBMIT { _ = submit(chooser) }
        return true
    }
    // ("/" or "~" over the list: a path typed from there.)
    if typed.length == 1 && (typed[0] == 47 || typed[0] == 126) && modifiers & keys.CONTROL == 0 {
        field_module.set(&chooser.*.location, typed)
        chooser.*.focusChange = 1
        chooser.*.editing = true
        return true
    }
    const count = chooser.*.entries.count()
    if code == KEY_ESCAPE {
        chooser.*.pending = CANCELLED
        return true
    }
    if code == KEY_BACKSPACE {
        goUp(chooser)
        return true
    }
    if code == KEY_DOWN {
        if count > 0 { chooser.*.current = if chooser.*.current + 1 < count { chooser.*.current + 1 } else { count - 1 } }
        if count > 0 && !chooser.*.multiple && !chooser.*.entries.items()[chooser.*.current].isFolder { toggle(chooser, chooser.*.current) }
        scroll_module.reveal(&chooser.*.list, @intCast(i32, chooser.*.current) * ROW, ROW)
        return true
    }
    if code == KEY_UP {
        if chooser.*.current > 0 { chooser.*.current -= 1 }
        if count > 0 && !chooser.*.multiple && !chooser.*.entries.items()[chooser.*.current].isFolder { toggle(chooser, chooser.*.current) }
        scroll_module.reveal(&chooser.*.list, @intCast(i32, chooser.*.current) * ROW, ROW)
        return true
    }
    if code == KEY_ENTER {
        if chooser.*.current < count && chooser.*.entries.items()[chooser.*.current].isFolder {
            goInto(chooser, chooser.*.current)
        } else {
            if chooser.*.current < count && chosenCount(chooser) == 0 { toggle(chooser, chooser.*.current) }
            if chosenCount(chooser) > 0 {
                chooser.*.pending = CHOSEN
                remember(chooser)
            }
        }
        return true
    }
    return false
}

fn sizeText(size: u64, into: *[24]u8) -> []const u8 {
    var value = size
    var unit: []const u8 = " B"
    if size >= 1048576 {
        value = (size + 524288) / 1048576
        unit = " MB"
    } else if size >= 1024 {
        value = (size + 512) / 1024
        unit = " kB"
    }
    var digits: [20]u8 = undefined
    var count: usize = 0
    while true {
        digits[19 - count] = @intCast(u8, 48 + value % 10)
        count += 1
        value = value / 10
        if value == 0 { break }
    }
    var length: usize = 0
    for c in digits[20 - count..20] {
        into.*[length] = c
        length += 1
    }
    for c in unit {
        into.*[length] = c
        length += 1
    }
    return into.*[0..length]
}

// The chooser over AREA (it takes the middle of it, at most its own
// size): WAITING while it is shown, CHOSEN or CANCELLED when it closes.
pub fn draw(chooser: *Chooser, context: *Ui, area: ui.Rect) -> u8 {
    const theme = context.*.theme
    const canvas = context.*.canvas
    const s = theme.*.scale
    const width = if area.width - 32 * s < WIDTH * s { area.width - 32 * s } else { WIDTH * s }
    const height = if area.height - 32 * s < HEIGHT * s { area.height - 32 * s } else { HEIGHT * s }
    if width <= 0 || height <= 0 { return chooser.*.pending }
    const box = ui.rect(area.x + (area.width - width) / 2, area.y + (area.height - height) / 2, width, height)
    // What it covers, dimmed; its frame.
    canvas_module.fillRect(canvas, area.x, area.y, area.width, area.height, canvas_module.color(96, 0, 0, 0))
    popup.frame(context, view.id("chooser"), box)
    // The folder: up, the path field.
    const pad = 12 * s
    const up = ui.rect(box.x + pad, box.y + (HEADER * s - 28 * s) / 2, 28 * s, 28 * s)
    if controls.chevronButton(context, view.id("chooser-up"), up, true, chooser.*.folder.count() > 1) { goUp(chooser) }
    const title = if chooser.*.multiple { "Choose files" } else { "Choose a file" }
    const titleWidth = text_module.measure(context.*.body, title)
    controls.label(context, context.*.body, title, ui.right(box) - pad - titleWidth, controls.textTop(context.*.body, box.y, HEADER * s), theme.*.dim, 0)
    const pathLeft = ui.right(up) + 8 * s
    const locationId = view.id("chooser-location")
    if chooser.*.focusChange == 1 { view.setFocus(context, locationId) }
    if chooser.*.focusChange == 2 && view.hasFocus(context, locationId) { view.setFocus(context, view.NONE) }
    chooser.*.focusChange = 0
    _ = field_module.textField(context, locationId, ui.rect(pathLeft, box.y + (HEADER * s - 30 * s) / 2, ui.right(box) - pad - titleWidth - 12 * s - pathLeft, 30 * s), &chooser.*.location, "Path", false)
    chooser.*.editing = view.hasFocus(context, locationId)
    lists.divider(context, box.x, box.y + HEADER * s, box.width)
    // The places.
    const placesArea = ui.rect(box.x, box.y + HEADER * s + 1, PLACES * s, box.height - HEADER * s - FOOTER * s - 1)
    canvas_module.fillRect(canvas, placesArea.x + s, placesArea.y, placesArea.width - s, placesArea.height, theme.*.raised)
    canvas_module.fillRect(canvas, ui.right(placesArea) - s, placesArea.y, s, placesArea.height, theme.*.divider)
    var placeTop = placesArea.y + 6 * s
    var placeIndex: usize = 0
    var wentTo: usize = chooser.*.places.count()
    while placeIndex < chooser.*.places.count() && placeTop + ROW * s <= ui.bottom(placesArea) {
        const place = chooser.*.places.items()[placeIndex]
        const placeRow = ui.rect(placesArea.x + 6 * s, placeTop, placesArea.width - 12 * s, ROW * s)
        const here = std.text.same(placePath(chooser, place), chooser.*.folder.items())
        if lists.rowBackground(context, view.idOf(view.id("chooser-place"), placeIndex), placeRow, here, false) { wentTo = placeIndex }
        const markX = placeRow.x + 6 * s
        const markY = placeRow.y + (placeRow.height - 14 * s) / 2
        canvas_module.fillRoundedRect(canvas, markX, markY + 2 * s, 16 * s, 11 * s, 2 * s, theme.*.accent)
        canvas_module.fillRect(canvas, markX, markY, 7 * s, 4 * s, theme.*.accent)
        controls.label(context, context.*.body, placeName(chooser, place), markX + 24 * s, controls.textTop(context.*.body, placeRow.y, placeRow.height), theme.*.text, ui.right(placeRow) - markX - 28 * s)
        placeTop += ROW * s
        placeIndex += 1
    }
    // The entries.
    const listLeft = if chooser.*.places.count() > 0 { ui.right(placesArea) + 6 * s } else { box.x + 6 * s }
    const listArea = ui.rect(listLeft, box.y + HEADER * s + 4 * s, ui.right(box) - 6 * s - listLeft, box.height - HEADER * s - FOOTER * s - 8 * s)
    const count = chooser.*.entries.count()
    scroll_module.setSize(&chooser.*.list, @intCast(i32, count) * ROW * s, listArea.height)
    _ = scroll_module.wheelIn(context, &chooser.*.list, listArea, ROW * s * 3)
    view.pushClip(context, listArea)
    var entered: usize = count
    var clicked: usize = count
    var row = scroll_module.firstRow(&chooser.*.list, ROW * s)
    const rows = ui.rect(listArea.x, listArea.y, listArea.width - scroll_module.BAR, listArea.height)
    while row < scroll_module.endRow(&chooser.*.list, ROW * s, count) {
        const entry = chooser.*.entries.items()[row]
        const rowArea = ui.rect(rows.x, scroll_module.rowTop(&chooser.*.list, rows, ROW * s, row), rows.width, ROW * s)
        var sizeBytes: [24]u8 = undefined
        const note = if entry.isFolder { "Folder" } else { sizeText(entry.size, &sizeBytes) }
        const rowId = view.idOf(view.id("chooser-entry"), row)
        const lit = entry.chosen || (row == chooser.*.current && view.isHover(context, rowId))
        if lists.rowBackground(context, rowId, rowArea, entry.chosen, lit) {
            if entry.isFolder { entered = row } else { clicked = row }
        }
        // Its mark: a folder's tab, a file's page.
        const markX = rowArea.x + 10 * s
        const markY = rowArea.y + (rowArea.height - 14 * s) / 2
        const markColor = if entry.accepted { theme.*.accent } else { theme.*.disabled }
        if entry.isFolder {
            canvas_module.fillRoundedRect(canvas, markX, markY + 2 * s, 18 * s, 12 * s, 2 * s, markColor)
            canvas_module.fillRect(canvas, markX, markY, 8 * s, 4 * s, markColor)
        } else {
            canvas_module.strokeRoundedRect(canvas, markX + 3 * s, markY, 12 * s, 14 * s, 2 * s, s, markColor)
        }
        const left = markX + 26 * s
        const noteWidth = text_module.measure(context.*.small, note) + 8 * s
        controls.label(context, context.*.body, nameOf(chooser, entry), left, controls.textTop(context.*.body, rowArea.y, rowArea.height), if entry.accepted { theme.*.text } else { theme.*.disabled }, ui.right(rowArea) - noteWidth - left - 4 * s)
        controls.label(context, context.*.small, note, ui.right(rowArea) - noteWidth, controls.textTop(context.*.small, rowArea.y, rowArea.height), theme.*.dim, 0)
        row += 1
    }
    view.popClip(context)
    _ = scroll_module.bar(context, view.id("chooser-bar"), scroll_module.barArea(listArea), &chooser.*.list)
    if count == 0 {
        controls.centeredLabel(context, context.*.body, "Nothing here", listArea, theme.*.dim)
    }
    // Cancel, Open.
    lists.divider(context, box.x, ui.bottom(box) - FOOTER * s, box.width)
    const buttonWidth = 96 * s
    const buttonHeight = 32 * s
    const buttonY = ui.bottom(box) - (FOOTER * s + buttonHeight) / 2
    const open = ui.rect(ui.right(box) - pad - buttonWidth, buttonY, buttonWidth, buttonHeight)
    const cancel = ui.rect(open.x - 8 * s - buttonWidth, buttonY, buttonWidth, buttonHeight)
    const chosen = chosenCount(chooser)
    var result = chooser.*.pending
    if controls.button(context, view.id("chooser-cancel"), cancel, "Cancel", controls.BUTTON_NORMAL, true) { result = CANCELLED }
    if controls.button(context, view.id("chooser-open"), open, "Open", controls.BUTTON_PRIMARY, chosen > 0) { result = CHOSEN }
    if chosen > 0 {
        var countBytes: [24]u8 = undefined
        const what = if chosen == 1 { "1 file chosen" } else { "files chosen" }
        const shown = if chosen == 1 { what } else { sizeTextPlain(chosen, &countBytes, " files chosen") }
        controls.label(context, context.*.small, shown, box.x + pad, controls.textTop(context.*.small, buttonY, buttonHeight), theme.*.dim, cancel.x - box.x - 2 * pad)
    }
    if result == CHOSEN { remember(chooser) }
    if wentTo < chooser.*.places.count() {
        var path = std.ArrayList(u8).init(std.heap.allocator())
        defer path.deinit()
        _ = path.appendSlice(placePath(chooser, chooser.*.places.items()[wentTo]))
        goTo(chooser, path.items())
        chooser.*.focusChange = 2
    } else if entered < count {
        chooser.*.current = entered
        goInto(chooser, entered)
    } else if clicked < count {
        chooser.*.current = clicked
        toggle(chooser, clicked)
    }
    chooser.*.pending = WAITING
    return result
}

// COUNT and TEXT after it ("3 files chosen").
fn sizeTextPlain(count: usize, into: *[24]u8, text: []const u8) -> []const u8 {
    var digits: [20]u8 = undefined
    var length: usize = 0
    var value = count
    while true {
        digits[19 - length] = @intCast(u8, 48 + value % 10)
        length += 1
        value = value / 10
        if value == 0 { break }
    }
    var at: usize = 0
    for c in digits[20 - length..20] {
        into.*[at] = c
        at += 1
    }
    for c in text {
        if at < 24 {
            into.*[at] = c
            at += 1
        }
    }
    return into.*[0..at]
}
