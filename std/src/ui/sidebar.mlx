// std.ui.sidebar: the desktop apps' sidebar (mlx-files, MLX Observatory,
// mlx-settings): a glass panel (the theme's translucent tint; the
// compositor blurs what is behind through it, std.ui.host.setBlur over its
// area) casting a soft shadow onto the content beside it, small headings,
// and rows with a glyph at the left and a label after it.
//
//     sidebar.background(context, area)
//     sidebar.heading(context, "Favorites", area.x, area.y + 22 * s, area.width)
//     if sidebar.item(context, id, sidebar.rowArea(context, area, y), "Home", chosen) { ... }
//     // the glyph (20 logical pixels square) at sidebar.glyphX(row), row.y + ...
//
// Sizes are logical pixels (times the theme's scale).
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const controls = @import("std.ui.controls")
const lists = @import("std.ui.lists")
const surface = @import("std.ui.surface")

const Ui = view.Ui

// The dark look's tint and edge, for apps that paint a sidebar without a
// std.ui.view.Ui (background() takes the theme's glass).
pub fn tint() -> u32 { return canvas_module.color(216, 18, 19, 30) }
pub fn edge() -> u32 { return canvas_module.color(255, 12, 13, 20) }

// A row's height, where its rows start below a heading, and the glyph's
// box.
pub const ROW: i32 = 28
pub const GLYPH: i32 = 20

pub fn background(context: *Ui, area: ui.Rect) -> void {
    surface.sidePanel(context, area)
}

// A heading (small, dim) with its text's top at y.
pub fn heading(context: *Ui, label: []const u8, x: i32, y: i32, width: i32) -> void {
    const s = context.*.theme.*.scale
    controls.label(context, context.*.small, label, x + 18 * s, y, context.*.theme.*.dim, width - 26 * s)
}

// The row at y of a sidebar in `area` (8 logical pixels in from its sides).
pub fn rowArea(context: *Ui, area: ui.Rect, y: i32) -> ui.Rect {
    const s = context.*.theme.*.scale
    return ui.rect(area.x + 8 * s, y, area.width - 16 * s, ROW * s)
}

// Where a row's glyph goes (its box GLYPH square, centred in the row's
// height).
pub fn glyphX(context: *Ui, row: ui.Rect) -> i32 { return row.x + 8 * context.*.theme.*.scale }

pub fn glyphY(context: *Ui, row: ui.Rect) -> i32 { return row.y + (row.height - GLYPH * context.*.theme.*.scale) / 2 }

// A row: lit when chosen or under the pointer, its label after the glyph's
// place; true when clicked. `with_label` false: only the glyph (a rail).
pub fn item(context: *Ui, item_id: u64, row: ui.Rect, label: []const u8, chosen: bool, with_label: bool) -> bool {
    const clicked = lists.rowBackground(context, item_id, row, chosen, false)
    if with_label {
        const s = context.*.theme.*.scale
        const left = row.x + 36 * s
        controls.label(context, context.*.body, label, left, controls.textTop(context.*.body, row.y, row.height), context.*.theme.*.text, ui.right(row) - left - 4 * s)
    }
    return clicked
}
