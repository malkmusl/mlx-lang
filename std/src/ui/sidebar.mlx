// std.ui.sidebar: the desktop apps' sidebar (polaris, MLX Observatory,
// control): a translucent tint the compositor blurs what is behind
// through (std.ui.host.setBlur over its area), an edge at its right, small
// headings, and rows with a glyph at the left and a label after it.
//
//     sidebar.background(context, area)
//     sidebar.heading(context, "Favorites", area.x, area.y + 22 * s, area.width)
//     if sidebar.item(context, id, sidebar.rowArea(context, area, y), "Home", chosen) { ... }
//     // the glyph (20 logical pixels square) at sidebar.glyphX(row), row.y + ...
//
// Sizes are logical pixels (times the theme's scale).
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const controls = @import("std.ui.controls")
const lists = @import("std.ui.lists")
const theme_module = @import("std.ui.theme")

const Ui = view.Ui

// The tint: the theme's glass (the desktop's, which the compositor's title
// bars are too, so a window's title bar, sidebar and header are one
// surface: std.ui.scheme.glass), and the edge, faint so they run on;
// tint() and edge() are the dark look's.
pub fn tintFor(theme: *const theme_module.Theme) -> u32 { return theme.*.glass }
pub fn edgeFor(theme: *const theme_module.Theme) -> u32 {
    const color = theme.*.divider
    return canvas_module.color(110, (color >> 16) & 255, (color >> 8) & 255, color & 255)
}

// The window's glass over `area` alone, without an edge: a sidebar or a
// header that runs on into the title bar and into each other.
pub fn glass(context: *Ui, area: ui.Rect) -> void {
    canvas_module.fillRect(context.*.canvas, area.x, area.y, area.width, area.height, tintFor(context.*.theme))
}

// The content set into the glass: the theme's surface, its top left corner
// rounded (the others go past the window's edges, which cut them), with a
// faint edge along its top and left.
pub fn card(context: *Ui, area: ui.Rect) -> void {
    const s = context.*.theme.*.scale
    const radius = 12 * s
    const canvas = context.*.canvas
    // The glass behind the rounded corner.
    canvas_module.fillRect(canvas, area.x, area.y, radius, radius, tintFor(context.*.theme))
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width + radius, area.height + radius, radius, context.*.theme.*.surface)
    canvas_module.strokeRoundedRect(canvas, area.x, area.y, area.width + radius * 2, area.height + radius * 2, radius, s, edgeFor(context.*.theme))
}

// A window's header (its toolbar under the title bar): the same glass,
// with a faint line below it.
pub fn header(context: *Ui, area: ui.Rect) -> void {
    const s = context.*.theme.*.scale
    canvas_module.fillRect(context.*.canvas, area.x, area.y, area.width, area.height, tintFor(context.*.theme))
    canvas_module.fillRect(context.*.canvas, area.x, ui.bottom(area) - s, area.width, s, edgeFor(context.*.theme))
}
pub fn tint() -> u32 { return canvas_module.color(214, 26, 28, 36) }
pub fn edge() -> u32 { return canvas_module.color(255, 18, 19, 25) }

// A row's height, where its rows start below a heading, and the glyph's
// box.
pub const ROW: i32 = 26
pub const GLYPH: i32 = 20

pub fn background(context: *Ui, area: ui.Rect) -> void {
    const s = context.*.theme.*.scale
    canvas_module.fillRect(context.*.canvas, area.x, area.y, area.width, area.height, tintFor(context.*.theme))
    canvas_module.fillRect(context.*.canvas, ui.right(area) - s, area.y, s, area.height, edgeFor(context.*.theme))
}

// A heading (small, dim) with its text's top at y.
pub fn heading(context: *Ui, label: []const u8, x: i32, y: i32, width: i32) -> void {
    const s = context.*.theme.*.scale
    controls.label(context, context.*.small, label, x + 18 * s, y, context.*.theme.*.dim, width - 26 * s)
}

// The row at y of a sidebar in `area` (8 logical pixels in from its sides).
pub fn rowArea(context: *Ui, area: ui.Rect, y: i32) -> ui.Rect {
    const s = context.*.theme.*.scale
    return ui.rect(area.x + 8 * s, y, area.width - 16 * s, ROW * s)
}

// Where a row's glyph goes (its box GLYPH square, centred in the row's
// height).
pub fn glyphX(context: *Ui, row: ui.Rect) -> i32 { return row.x + 8 * context.*.theme.*.scale }

pub fn glyphY(context: *Ui, row: ui.Rect) -> i32 { return row.y + (row.height - GLYPH * context.*.theme.*.scale) / 2 }

// A row: lit when chosen or under the pointer, its label after the glyph's
// place; true when clicked. `with_label` false: only the glyph (a rail).
pub fn item(context: *Ui, item_id: u64, row: ui.Rect, label: []const u8, chosen: bool, with_label: bool) -> bool {
    const clicked = lists.rowBackground(context, item_id, row, chosen, false)
    if with_label {
        const s = context.*.theme.*.scale
        const left = row.x + 36 * s
        controls.label(context, context.*.body, label, left, controls.textTop(context.*.body, row.y, row.height), context.*.theme.*.text, ui.right(row) - left - 4 * s)
    }
    return clicked
}
