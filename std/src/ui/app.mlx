// What an app built on std.ui needs from a platform, whatever it is (a
// Wayland window or an Android activity: std.ui.host, the same calls on
// both): the platform calls the app's `Draw` with a
// std.ui.canvas.Canvas when a frame is due and its `Handler` with each
// event as (kind, a, b) below. `feed` hands the pointer events to a
// std.ui.view.Ui, so the widgets see them:
//
//     fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
//         const state = stateOf(context)
//         if app.pressing(kind, a, b) { layOut(context) }    // see below
//         if app.feed(&state.*.ui, kind, a, b) == app.FEED_CLICK {
//             layOut(context)                         // the click is taken now
//         }
//         ...
//     }
//
//     fn layOut(context: *anyopaque) -> void {
//         var nowhere = view.layoutCanvas()
//         draw(context, &nowhere)
//     }
//
// Laid out before a press, the widgets are where the app's state puts
// them now, even when the press comes before the first frame or after a
// change not drawn yet.
//
// A touch screen is a pointer whose left button is the finger: down is a
// motion and a press, up a release and a leave.
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")

const Ui = view.Ui
pub const Canvas = canvas_module.Canvas

// The pointer moved: a is x (an i32's bits), b is y.
pub const EVENT_MOTION: u32 = 0
// The pointer left the window (a lifted finger).
pub const EVENT_LEAVE: u32 = 1
// A button: a is its Linux code (BUTTON_LEFT ...), b 1 pressed, 0 let go.
pub const EVENT_BUTTON: u32 = 2
// The wheel: a is the axis (0 vertical, 1 horizontal), b the notches
// (positive: down or right).
pub const EVENT_WHEEL: u32 = 3
// A key: a is its Linux key code (std.ui.keys), b 1 pressed, 0 released,
// 2 repeated; what it types the platform keeps.
pub const EVENT_KEY: u32 = 4
// The window got its size (or a new one): a is its width, b its height.
// Lay out from these, not from the canvas: a layout pass's is 0 x 0.
pub const EVENT_CONFIGURED: u32 = 6
// The window is to close.
pub const EVENT_CLOSED: u32 = 7
// The descriptor the app watches (std.ui.host.watchDescriptor) is readable.
pub const EVENT_WATCH: u32 = 8
// A timer tick the app asked for.
pub const EVENT_TICK: u32 = 9
// Only where the platform has them (the desktop): something of a kind the
// app accepts dragged over the window (a: x, b: y), off it, dropped
// (a: x, b: y; the data: std.ui.host.dropData), and a drag the app
// started ended (a: 1 dropped, 0 cancelled); the keyboard went elsewhere.
pub const EVENT_DRAG_MOTION: u32 = 14
pub const EVENT_DRAG_LEAVE: u32 = 15
pub const EVENT_DROP: u32 = 16
pub const EVENT_DRAG_END: u32 = 17
pub const EVENT_KEYBOARD_LEAVE: u32 = 19

// Linux's button codes (input-event-codes.h).
pub const BUTTON_LEFT: u32 = 272
pub const BUTTON_RIGHT: u32 = 273
pub const BUTTON_MIDDLE: u32 = 274

pub const Draw = fn(context: *anyopaque, canvas: *Canvas) -> void
pub const Handler = fn(context: *anyopaque, kind: u32, a: u32, b: i32) -> void
// A size rule (std.ui.host.setSizeRule): given the size the compositor
// configured, the app changes it to what it draws (a terminal: whole
// cells); 0 for either means the app picks.
pub const SizeRule = fn(context: *anyopaque, width: *u32, height: *u32) -> void

// What `feed` saw: nothing for the widgets, something to draw again (the
// pointer over another widget, a press), a click a widget is to take.
pub const FEED_NONE: u8 = 0
pub const FEED_REDRAW: u8 = 1
pub const FEED_CLICK: u8 = 2

// Whether the event presses the left button (lay the widgets out first).
pub fn pressing(kind: u32, a: u32, b: i32) -> bool { return kind == EVENT_BUTTON && a == BUTTON_LEFT && b == 1 }

// Hands a pointer event to the widgets (other events are the app's). A
// press finds what is under the pointer in the last frame's (or layout
// pass's) regions.
pub fn feed(context: *Ui, kind: u32, a: u32, b: i32) -> u8 {
    if kind == EVENT_MOTION {
        return if view.pointerMove(context, @bitCast(i32, a), b) { FEED_REDRAW } else { FEED_NONE }
    }
    if kind == EVENT_LEAVE {
        return if view.pointerLeave(context) { FEED_REDRAW } else { FEED_NONE }
    }
    if kind == EVENT_BUTTON && a == BUTTON_LEFT {
        if b == 1 && context.*.pointerInside {
            // Under the pointer as laid out now.
            const moved = view.pointerMove(context, context.*.pointerX, context.*.pointerY)
        }
        const id = view.pointerButton(context, b == 1)
        if b == 0 && id != view.NONE { return FEED_CLICK }
        return FEED_REDRAW
    }
    if kind == EVENT_WHEEL && a == 0 && b != 0 {
        const over = view.wheel(context, b)
        return FEED_REDRAW
    }
    return FEED_NONE
}
