// std.ui.keys: keys as std.ui's widgets take them, the same on every
// platform: Linux input key codes (what Wayland and evdev give; an Android
// runtime maps its key codes to these) and modifier bits.
pub const SHIFT: u32 = 1
pub const CONTROL: u32 = 2
pub const ALT: u32 = 4
pub const SUPER: u32 = 8

pub const ESCAPE: u32 = 1
pub const BACKSPACE: u32 = 14
pub const TAB: u32 = 15
pub const ENTER: u32 = 28
pub const A: u32 = 30
pub const C: u32 = 46
pub const V: u32 = 47
pub const X: u32 = 45
pub const Z: u32 = 44
pub const KEYPAD_ENTER: u32 = 96
pub const HOME: u32 = 102
pub const UP: u32 = 103
pub const PAGE_UP: u32 = 104
pub const LEFT: u32 = 105
pub const RIGHT: u32 = 106
pub const END: u32 = 107
pub const DOWN: u32 = 108
pub const PAGE_DOWN: u32 = 109
pub const DELETE: u32 = 111

pub fn isEnter(key: u32) -> bool { return key == ENTER || key == KEYPAD_ENTER }
