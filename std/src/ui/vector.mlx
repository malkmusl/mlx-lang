// std.ui.vector: shapes drawn smooth (anti-aliased) into a std.png Image:
// paths of lines and curves filled by how much of each pixel they cover
// (the signed area accumulation std.truetype draws glyphs with, after
// font-rs), and on them rectangles, rounded rectangles, circles, rings,
// arcs and lines with round ends. An icon is drawn once into an image at
// the size it is shown and then drawn as an image on any canvas (on the
// CPU or the GPU).
//
//     var shape: vector.Shape = undefined
//     if vector.begin(&shape, 24, 24, allocator) {
//         vector.circle(&shape, 12.0, 12.0, 8.0)
//         vector.paint(&shape, &image, color)      fills it; the shape is empty again
//         vector.end(&shape)
//     }
//
// Coordinates are pixels of the image, y down; a pixel's centre is at
// (x + 0.5, y + 0.5). Shapes that overlap add up to a full pixel; a ring's
// inner circle goes the other way round and cuts it out.
const std = @import("std")
const math = @import("std.math")
const png = @import("std.png")

pub const Allocator = std.allocator.Allocator

pub const Shape = struct {
    // The signed area per pixel, a row of width + 2 per line.
    accumulation: [*]f64
    width: usize
    height: usize
    stride: usize
    // The current point and where the contour started.
    x: f64
    y: f64
    startX: f64
    startY: f64
    allocator: Allocator
}

// ---------------------------------------------------------------------------
// Numbers (sines and pi are std.math's; floor, ceil and the square root
// are @floor, @ceil and @sqrt, one instruction each, the root 0 below
// zero)

fn toInt(value: f64) -> i64 {
    const result: i64 = @intFromFloat(i64, value)
    return result
}

pub fn toFloat(value: i64) -> f64 {
    const result: f64 = @floatFromInt(f64, value)
    return result
}

pub fn sqrt(value: f64) -> f64 {
    if value <= 0.0 { return 0.0 }
    return @sqrt(value)
}

fn minimum(a: f64, b: f64) -> f64 { return if a < b { a } else { b } }
fn maximum(a: f64, b: f64) -> f64 { return if a > b { a } else { b } }
fn absolute(a: f64) -> f64 { return if a < 0.0 { -a } else { a } }

// ---------------------------------------------------------------------------
// The shape

// A shape `width` x `height` pixels; false without memory.
pub fn begin(shape: *Shape, width: usize, height: usize, allocator: Allocator) -> bool {
    shape.*.width = width
    shape.*.height = height
    shape.*.stride = width + 2
    shape.*.allocator = allocator
    shape.*.x = 0.0
    shape.*.y = 0.0
    shape.*.startX = 0.0
    shape.*.startY = 0.0
    const cells = shape.*.stride * height + 4
    const memory = allocator.alloc(cells * 8, 8)
    if memory == null { return false }
    unsafe { shape.*.accumulation = @ptrCast([*]f64, memory.?) }
    clear(shape)
    return true
}

pub fn end(shape: *Shape) -> void {
    const cells = shape.*.stride * shape.*.height + 4
    unsafe { shape.*.allocator.free(@ptrCast([*]u8, shape.*.accumulation), cells * 8, 8) }
}

// Nothing drawn.
pub fn clear(shape: *Shape) -> void {
    const cells = shape.*.stride * shape.*.height + 4
    var index: usize = 0
    while index < cells {
        shape.*.accumulation[index] = 0.0
        index += 1
    }
}

// One line's signed area and cover into the rows it crosses.
fn edge(shape: *Shape, ax: f64, ay: f64, bx: f64, by: f64) -> void {
    if ay == by { return }
    var direction: f64 = 1.0
    var x0 = ax
    var y0 = ay
    var x1 = bx
    var y1 = by
    if ay > by {
        direction = -1.0
        x0 = bx
        y0 = by
        x1 = ax
        y1 = ay
    }
    const height_f = toFloat(@intCast(i64, shape.*.height))
    if y1 <= 0.0 || y0 >= height_f { return }
    const limit = toFloat(@intCast(i64, shape.*.stride)) - 1.0
    const dxdy = (x1 - x0) / (y1 - y0)
    var x = x0
    var row = @floor(y0)
    if y0 < 0.0 {
        x -= y0 * dxdy
        row = 0.0
    }
    const row_end = minimum(height_f, @ceil(y1))
    const buffer = shape.*.accumulation
    while row < row_end {
        const line_start = @intCast(usize, toInt(row)) * shape.*.stride
        const dy = minimum(row + 1.0, y1) - maximum(row, y0)
        const x_next = x + dxdy * dy
        const d = dy * direction
        var left = x
        var right = x_next
        if x_next < x {
            left = x_next
            right = x
        }
        left = maximum(0.0, minimum(left, limit))
        right = maximum(0.0, minimum(right, limit))
        const left_floor = @floor(left)
        const left_index = @intCast(usize, toInt(left_floor))
        const right_ceil = @ceil(right)
        const right_index = @intCast(usize, toInt(right_ceil))
        if right_index <= left_index + 1 {
            const middle = 0.5 * (left + right) - left_floor
            const clamped = maximum(0.0, minimum(middle, 1.0))
            buffer[line_start + left_index] += d - d * clamped
            buffer[line_start + left_index + 1] += d * clamped
        } else {
            const s = 1.0 / (right - left)
            const left_fraction = left - left_floor
            const a0 = 0.5 * s * (1.0 - left_fraction) * (1.0 - left_fraction)
            const right_fraction = right - right_ceil + 1.0
            const am = 0.5 * s * right_fraction * right_fraction
            buffer[line_start + left_index] += d * a0
            if right_index == left_index + 2 {
                buffer[line_start + left_index + 1] += d * (1.0 - a0 - am)
            } else {
                const a1 = s * (1.5 - left_fraction)
                buffer[line_start + left_index + 1] += d * (a1 - a0)
                var column = left_index + 2
                while column < right_index - 1 {
                    buffer[line_start + column] += d * s
                    column += 1
                }
                const middle_count = toFloat(@intCast(i64, right_index - left_index - 3))
                const a2 = a1 + middle_count * s
                buffer[line_start + right_index - 1] += d * (1.0 - a2 - am)
            }
            buffer[line_start + right_index] += d * am
        }
        x = x_next
        row += 1.0
    }
}

pub fn moveTo(shape: *Shape, x: f64, y: f64) -> void {
    shape.*.x = x
    shape.*.y = y
    shape.*.startX = x
    shape.*.startY = y
}

pub fn lineTo(shape: *Shape, x: f64, y: f64) -> void {
    edge(shape, shape.*.x, shape.*.y, x, y)
    shape.*.x = x
    shape.*.y = y
}

// Back to where the contour started.
pub fn close(shape: *Shape) -> void { lineTo(shape, shape.*.startX, shape.*.startY) }

// A quadratic curve, in segments (fewer when it is flat).
pub fn quadTo(shape: *Shape, cx: f64, cy: f64, x: f64, y: f64) -> void {
    const x0 = shape.*.x
    const y0 = shape.*.y
    const deviation_x = x0 - 2.0 * cx + x
    const deviation_y = y0 - 2.0 * cy + y
    const deviation = deviation_x * deviation_x + deviation_y * deviation_y
    if deviation < 0.0001 {
        lineTo(shape, x, y)
        return
    }
    const count = 1 + toInt(@floor(sqrt(sqrt(768.0 * deviation))))
    const count_f = toFloat(count)
    var step: i64 = 1
    while step < count {
        const t = toFloat(step) / count_f
        const u = 1.0 - t
        lineTo(shape, u * u * x0 + 2.0 * u * t * cx + t * t * x, u * u * y0 + 2.0 * u * t * cy + t * t * y)
        step += 1
    }
    lineTo(shape, x, y)
}

// A cubic curve, in 16 segments.
pub fn cubicTo(shape: *Shape, ax: f64, ay: f64, bx: f64, by: f64, x: f64, y: f64) -> void {
    const x0 = shape.*.x
    const y0 = shape.*.y
    var step: i64 = 1
    while step < 16 {
        const t = toFloat(step) / 16.0
        const u = 1.0 - t
        const px = u * u * u * x0 + 3.0 * u * u * t * ax + 3.0 * u * t * t * bx + t * t * t * x
        const py = u * u * u * y0 + 3.0 * u * u * t * ay + 3.0 * u * t * t * by + t * t * t * y
        lineTo(shape, px, py)
        step += 1
    }
    lineTo(shape, x, y)
}

// ---------------------------------------------------------------------------
// Figures

pub fn rect(shape: *Shape, x: f64, y: f64, width: f64, height: f64) -> void {
    moveTo(shape, x, y)
    lineTo(shape, x + width, y)
    lineTo(shape, x + width, y + height)
    lineTo(shape, x, y + height)
    close(shape)
}

// The corners' curves are quarter circles drawn as cubics: their control
// points this far along the tangents (times the radius).
fn kappa() -> f64 { return 0.5522847498 }

pub fn roundedRect(shape: *Shape, x: f64, y: f64, width: f64, height: f64, given: f64) -> void {
    var radius = given
    if radius > width / 2.0 { radius = width / 2.0 }
    if radius > height / 2.0 { radius = height / 2.0 }
    if radius <= 0.0 {
        rect(shape, x, y, width, height)
        return
    }
    const k = radius * kappa()
    const right = x + width
    const bottom = y + height
    moveTo(shape, x + radius, y)
    lineTo(shape, right - radius, y)
    cubicTo(shape, right - radius + k, y, right, y + radius - k, right, y + radius)
    lineTo(shape, right, bottom - radius)
    cubicTo(shape, right, bottom - radius + k, right - radius + k, bottom, right - radius, bottom)
    lineTo(shape, x + radius, bottom)
    cubicTo(shape, x + radius - k, bottom, x, bottom - radius + k, x, bottom - radius)
    lineTo(shape, x, y + radius)
    cubicTo(shape, x, y + radius - k, x + radius - k, y, x + radius, y)
    close(shape)
}

// An ellipse; `backwards` goes the other way round (to cut a hole).
pub fn ellipse(shape: *Shape, cx: f64, cy: f64, rx: f64, ry: f64, backwards: bool) -> void {
    const kx = rx * kappa()
    const ky = ry * kappa()
    moveTo(shape, cx + rx, cy)
    if backwards {
        cubicTo(shape, cx + rx, cy - ky, cx + kx, cy - ry, cx, cy - ry)
        cubicTo(shape, cx - kx, cy - ry, cx - rx, cy - ky, cx - rx, cy)
        cubicTo(shape, cx - rx, cy + ky, cx - kx, cy + ry, cx, cy + ry)
        cubicTo(shape, cx + kx, cy + ry, cx + rx, cy + ky, cx + rx, cy)
    } else {
        cubicTo(shape, cx + rx, cy + ky, cx + kx, cy + ry, cx, cy + ry)
        cubicTo(shape, cx - kx, cy + ry, cx - rx, cy + ky, cx - rx, cy)
        cubicTo(shape, cx - rx, cy - ky, cx - kx, cy - ry, cx, cy - ry)
        cubicTo(shape, cx + kx, cy - ry, cx + rx, cy - ky, cx + rx, cy)
    }
    close(shape)
}

pub fn circle(shape: *Shape, cx: f64, cy: f64, radius: f64) -> void { ellipse(shape, cx, cy, radius, radius, false) }

// A circle's outline `thickness` wide (on the circle's radius inwards).
pub fn ring(shape: *Shape, cx: f64, cy: f64, radius: f64, thickness: f64) -> void {
    ellipse(shape, cx, cy, radius, radius, false)
    ellipse(shape, cx, cy, radius - thickness, radius - thickness, true)
}

// A rounded rectangle's outline `thickness` wide (inwards).
pub fn roundedFrame(shape: *Shape, x: f64, y: f64, width: f64, height: f64, radius: f64, thickness: f64) -> void {
    roundedRect(shape, x, y, width, height, radius)
    // The inner one the other way round: drawn mirrored left to right.
    const inner_radius = if radius > thickness { radius - thickness } else { 0.0 }
    const ix = x + thickness
    const iy = y + thickness
    const iw = width - 2.0 * thickness
    const ih = height - 2.0 * thickness
    if iw <= 0.0 || ih <= 0.0 { return }
    var r = inner_radius
    if r > iw / 2.0 { r = iw / 2.0 }
    if r > ih / 2.0 { r = ih / 2.0 }
    const k = r * kappa()
    const right = ix + iw
    const bottom = iy + ih
    moveTo(shape, ix + r, iy)
    cubicTo(shape, ix + r - k, iy, ix, iy + r - k, ix, iy + r)
    lineTo(shape, ix, bottom - r)
    cubicTo(shape, ix, bottom - r + k, ix + r - k, bottom, ix + r, bottom)
    lineTo(shape, right - r, bottom)
    cubicTo(shape, right - r + k, bottom, right, bottom - r + k, right, bottom - r)
    lineTo(shape, right, iy + r)
    cubicTo(shape, right, iy + r - k, right - r + k, iy, right - r, iy)
    close(shape)
}

// The point at `degrees` on a circle (0 to the right, 90 up: as on paper,
// y going down on the image).
fn pointX(cx: f64, radius: f64, degrees: f64) -> f64 { return cx + radius * math.cos(degrees * math.pi / 180.0) }
fn pointY(cy: f64, radius: f64, degrees: f64) -> f64 { return cy - radius * math.sin(degrees * math.pi / 180.0) }

// An arc `thickness` wide around (cx, cy) from `from` to `to` degrees (to
// above from), centred on `radius`, with round ends when `round`.
pub fn arc(shape: *Shape, cx: f64, cy: f64, radius: f64, thickness: f64, from: f64, to: f64, round: bool) -> void {
    const outer = radius + thickness / 2.0
    const inner = radius - thickness / 2.0
    var steps = toInt(@ceil(absolute(to - from) / 6.0))
    if steps < 2 { steps = 2 }
    const steps_f = toFloat(steps)
    moveTo(shape, pointX(cx, outer, from), pointY(cy, outer, from))
    var step: i64 = 1
    while step <= steps {
        const angle = from + (to - from) * toFloat(step) / steps_f
        lineTo(shape, pointX(cx, outer, angle), pointY(cy, outer, angle))
        step += 1
    }
    step = steps
    while step >= 0 {
        const angle = from + (to - from) * toFloat(step) / steps_f
        lineTo(shape, pointX(cx, inner, angle), pointY(cy, inner, angle))
        step -= 1
    }
    close(shape)
    if round {
        // The ends the same way round as the arc (going up from `from`
        // to `to` it goes against the clock on the image).
        const backwards = to > from
        ellipse(shape, pointX(cx, radius, from), pointY(cy, radius, from), thickness / 2.0, thickness / 2.0, backwards)
        ellipse(shape, pointX(cx, radius, to), pointY(cy, radius, to), thickness / 2.0, thickness / 2.0, backwards)
    }
}

// A line `thickness` wide from (x0, y0) to (x1, y1), with round ends when
// `round`.
pub fn line(shape: *Shape, x0: f64, y0: f64, x1: f64, y1: f64, thickness: f64, round: bool) -> void {
    const dx = x1 - x0
    const dy = y1 - y0
    const length = sqrt(dx * dx + dy * dy)
    if length <= 0.0 { return }
    const nx = -dy / length * thickness / 2.0
    const ny = dx / length * thickness / 2.0
    // Clockwise on the image, as the ends' circles.
    moveTo(shape, x0 - nx, y0 - ny)
    lineTo(shape, x1 - nx, y1 - ny)
    lineTo(shape, x1 + nx, y1 + ny)
    lineTo(shape, x0 + nx, y0 + ny)
    close(shape)
    if round {
        circle(shape, x0, y0, thickness / 2.0)
        circle(shape, x1, y1, thickness / 2.0)
    }
}

// A polygon through `count` points (x, y pairs).
pub fn polygon(shape: *Shape, points: [*]const f64, count: usize) -> void {
    if count < 3 { return }
    moveTo(shape, points[0], points[1])
    var index: usize = 1
    while index < count {
        lineTo(shape, points[index * 2], points[index * 2 + 1])
        index += 1
    }
    close(shape)
}

pub fn triangle(shape: *Shape, ax: f64, ay: f64, bx: f64, by: f64, cx: f64, cy: f64) -> void {
    moveTo(shape, ax, ay)
    lineTo(shape, bx, by)
    lineTo(shape, cx, cy)
    close(shape)
}

// ---------------------------------------------------------------------------
// Painting

// How much of each pixel the shape covers, 0 to 255, into `coverage`
// (width * height bytes); the shape is empty again after.
pub fn coverage(shape: *Shape, out: [*]u8) -> void {
    var row: usize = 0
    while row < shape.*.height {
        var sum: f64 = 0.0
        var column: usize = 0
        const start = row * shape.*.stride
        while column < shape.*.width {
            sum += shape.*.accumulation[start + column]
            const amount = minimum(absolute(sum), 1.0)
            out[row * shape.*.width + column] = @intCast(u8, toInt(amount * 255.0 + 0.5))
            column += 1
        }
        row += 1
    }
    clear(shape)
}

// Fills the shape with `color` (0xAARRGGBB, not premultiplied) over the
// image's pixels (premultiplied 0xAARRGGBB, as std.png's); the shape is
// empty again after. The image must be the shape's size.
pub fn paint(shape: *Shape, image: *png.Image, color: u32) -> void {
    const alpha = (color >> 24) & 255
    const red = (color >> 16) & 255
    const green = (color >> 8) & 255
    const blue = color & 255
    var row: usize = 0
    while row < shape.*.height && row < image.*.height {
        var sum: f64 = 0.0
        var column: usize = 0
        const start = row * shape.*.stride
        while column < shape.*.width {
            sum += shape.*.accumulation[start + column]
            if column < image.*.width {
                const amount = minimum(absolute(sum), 1.0)
                const cover = @intCast(u32, toInt(amount * 255.0 + 0.5))
                if cover > 0 {
                    const a = alpha * cover / 255
                    const index = row * image.*.width + column
                    const under = image.*.pixels[index]
                    const keep = 255 - a
                    const ua = (under >> 24) & 255
                    const ur = (under >> 16) & 255
                    const ug = (under >> 8) & 255
                    const ub = under & 255
                    const na = a + ua * keep / 255
                    const nr = red * a / 255 + ur * keep / 255
                    const ng = green * a / 255 + ug * keep / 255
                    const nb = blue * a / 255 + ub * keep / 255
                    image.*.pixels[index] = (na << 24) | (nr << 16) | (ng << 8) | nb
                }
            }
            column += 1
        }
        row += 1
    }
    clear(shape)
}

// Cuts the shape out of the image (what it covers becomes transparent);
// the shape is empty again after.
pub fn erase(shape: *Shape, image: *png.Image) -> void {
    var row: usize = 0
    while row < shape.*.height && row < image.*.height {
        var sum: f64 = 0.0
        var column: usize = 0
        const start = row * shape.*.stride
        while column < shape.*.width {
            sum += shape.*.accumulation[start + column]
            if column < image.*.width {
                const amount = minimum(absolute(sum), 1.0)
                const keep = 255 - @intCast(u32, toInt(amount * 255.0 + 0.5))
                const index = row * image.*.width + column
                const under = image.*.pixels[index]
                const a = ((under >> 24) & 255) * keep / 255
                const r = ((under >> 16) & 255) * keep / 255
                const g = ((under >> 8) & 255) * keep / 255
                const b = (under & 255) * keep / 255
                image.*.pixels[index] = (a << 24) | (r << 16) | (g << 8) | b
            }
            column += 1
        }
        row += 1
    }
    clear(shape)
}
