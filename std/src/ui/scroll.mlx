// std.ui.scroll: content taller than its view: the offset into it
// (Scroll, kept by the app), the wheel over the view, a scroll bar whose
// thumb can be dragged (and a click on the track pages), marks along the
// bar, and the rows of a list that are in view.
//
//     scroll.setSize(&list, rows * ROW, view_area.height)
//     scroll.wheelIn(&ui, &list, view_area, ROW * 3)
//     var row = scroll.firstRow(&list, ROW)
//     while row < scroll.endRow(&list, ROW, rows) { ...draw row at scroll.rowTop(&list, view_area, ROW, row)... }
//     scroll.bar(&ui, view.idOf(list_id, 0), scroll.barArea(view_area), &list)
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")

const Ui = view.Ui

pub const BAR: i32 = 10
pub const MIN_THUMB: i32 = 20

pub const Scroll = struct {
    // Pixels scrolled; the content's and the view's height.
    offset: i32
    content: i32
    viewport: i32
    // Where the offset was when the thumb was taken (dragging).
    dragFrom: i32
}

pub fn init(scroll: *Scroll) -> void {
    scroll.*.offset = 0
    scroll.*.content = 0
    scroll.*.viewport = 0
    scroll.*.dragFrom = 0
}

fn largest(scroll: *Scroll) -> i32 { return if scroll.*.content > scroll.*.viewport { scroll.*.content - scroll.*.viewport } else { 0 } }

// Keeps the offset within the content.
pub fn clamp(scroll: *Scroll) -> void {
    if scroll.*.offset > largest(scroll) { scroll.*.offset = largest(scroll) }
    if scroll.*.offset < 0 { scroll.*.offset = 0 }
}

pub fn setSize(scroll: *Scroll, content: i32, viewport: i32) -> void {
    scroll.*.content = content
    scroll.*.viewport = viewport
    clamp(scroll)
}

// Scrolls by `delta` pixels; true when it moved.
pub fn by(scroll: *Scroll, delta: i32) -> bool {
    const before = scroll.*.offset
    scroll.*.offset += delta
    clamp(scroll)
    return scroll.*.offset != before
}

// Scrolls so that `top` .. `top + height` of the content is in view.
pub fn reveal(scroll: *Scroll, top: i32, height: i32) -> void {
    if top < scroll.*.offset { scroll.*.offset = top }
    if top + height > scroll.*.offset + scroll.*.viewport { scroll.*.offset = top + height - scroll.*.viewport }
    clamp(scroll)
}

// The wheel with the pointer in `area` scrolls `step` pixels a notch;
// true when it moved.
pub fn wheelIn(context: *Ui, scroll: *Scroll, area: ui.Rect, step: i32) -> bool {
    const steps = view.takeWheelIn(context, area)
    if steps == 0 { return false }
    return by(scroll, steps * step)
}

// The bar's place at the right edge of a view.
pub fn barArea(area: ui.Rect) -> ui.Rect { return ui.rect(ui.right(area) - BAR, area.y, BAR, area.height) }

fn thumbOf(scroll: *Scroll, track: ui.Rect, top: *i32) -> i32 {
    const content = if scroll.*.content > 0 { scroll.*.content } else { 1 }
    var thumb = @intCast(i32, @intCast(i64, scroll.*.viewport) * @intCast(i64, track.height) / @intCast(i64, content))
    if thumb < MIN_THUMB { thumb = MIN_THUMB }
    if thumb > track.height { thumb = track.height }
    const room = track.height - thumb
    const most = largest(scroll)
    top.* = track.y + if most > 0 { @intCast(i32, @intCast(i64, scroll.*.offset) * @intCast(i64, room) / @intCast(i64, most)) } else { 0 }
    return thumb
}

// Dragging the thumb (from where it was when pressed) and paging toward a
// press beside it; the thumb's height and top after.
fn drag(context: *Ui, bar_id: u64, track: ui.Rect, scroll: *Scroll, top: *i32, moved: *bool) -> i32 {
    var thumb = thumbOf(scroll, track, top)
    if !view.isPressed(context, bar_id) { return thumb }
    const on_thumb = context.*.pressY >= top.* && context.*.pressY < top.* + thumb
    if context.*.pointerY == context.*.pressY && context.*.pointerX == context.*.pressX {
        // Just pressed: remember where from (or page toward the press).
        scroll.*.dragFrom = scroll.*.offset
        if !on_thumb { moved.* = by(scroll, if context.*.pressY < top.* { 0 - scroll.*.viewport } else { scroll.*.viewport }) }
        scroll.*.dragFrom = scroll.*.offset
    } else {
        const room = track.height - thumb
        if room > 0 {
            const before = scroll.*.offset
            scroll.*.offset = scroll.*.dragFrom + @intCast(i32, @intCast(i64, view.dragY(context)) * @intCast(i64, largest(scroll)) / @intCast(i64, room))
            clamp(scroll)
            moved.* = scroll.*.offset != before
        }
    }
    return thumbOf(scroll, track, top)
}

// The scroll bar in `track` (nothing when all of the content is in view):
// dragging the thumb scrolls, a click above or below it pages. True when
// the offset changed.
pub fn bar(context: *Ui, bar_id: u64, track: ui.Rect, scroll: *Scroll) -> bool {
    if scroll.*.content <= scroll.*.viewport { return false }
    view.region(context, bar_id, track)
    const theme = context.*.theme
    const canvas = context.*.canvas
    var top: i32 = 0
    var moved = false
    const thumb = drag(context, bar_id, track, scroll, &top, &moved)
    canvas_module.fillRect(canvas, track.x, track.y, track.width, track.height, theme.*.track)
    const lit = view.isHover(context, bar_id) || view.isPressed(context, bar_id)
    canvas_module.fillRoundedRect(canvas, track.x + 2, top, track.width - 4, thumb, (track.width - 4) / 2, if lit { theme.*.border } else { theme.*.thumb })
    return moved
}

// A thin bar over the content (no track; wider under the pointer) that
// works as `bar` does: the file manager's, macOS's.
pub fn indicator(context: *Ui, bar_id: u64, track: ui.Rect, scroll: *Scroll) -> bool {
    if scroll.*.content <= scroll.*.viewport { return false }
    view.region(context, bar_id, track)
    var top: i32 = 0
    var moved = false
    const thumb = drag(context, bar_id, track, scroll, &top, &moved)
    const lit = view.isHover(context, bar_id) || view.isPressed(context, bar_id)
    const width = if lit { track.width - 2 } else { 5 }
    canvas_module.fillRoundedRect(context.*.canvas, ui.right(track) - 4 - width, top, width, thumb, (width + 1) / 2, context.*.theme.*.indicator)
    return moved
}

// A mark on the bar for content at `position` (pixels into the content):
// a line in `color` (problems, search hits).
pub fn mark(context: *Ui, track: ui.Rect, scroll: *Scroll, position: i32, color: u32) -> void {
    const content = if scroll.*.content > 0 { scroll.*.content } else { 1 }
    const y = track.y + @intCast(i32, @intCast(i64, position) * @intCast(i64, track.height) / @intCast(i64, content))
    canvas_module.fillRect(context.*.canvas, track.x + 1, y, track.width - 2, 2, color)
}

// The rows of `row_height` in view: the first, the one after the last.
pub fn firstRow(scroll: *Scroll, row_height: i32) -> usize {
    return @intCast(usize, scroll.*.offset / row_height)
}

pub fn endRow(scroll: *Scroll, row_height: i32, count: usize) -> usize {
    const end = @intCast(usize, (scroll.*.offset + scroll.*.viewport + row_height - 1) / row_height)
    return if end < count { end } else { count }
}

// Where row `row` is drawn in a view at `area`.
pub fn rowTop(scroll: *Scroll, area: ui.Rect, row_height: i32, row: usize) -> i32 {
    return area.y + @intCast(i32, row) * row_height - scroll.*.offset
}
