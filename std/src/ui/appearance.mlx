// std.ui.appearance: the desktop's colour scheme, light or dark, for the
// apps drawn with std.ui. The desktop keeps it in
// $XDG_CONFIG_HOME/mlx/appearance.conf (~/.config/mlx/appearance.conf):
// "color-scheme = light", "dark" or "default" (dark); the Settings portal
// writes it when the scheme is switched (projects/desktop/capture,
// org.freedesktop.appearance color-scheme). MLX_COLOR_SCHEME=light or
// dark in the environment overrides the file.
//
// A Watch follows the file (inotify on its folder; read again every two
// seconds when the folder is not there) and glides from one scheme to the
// other in 300 ms, so what is drawn with theme.at(value(watch)) fades
// over. std.ui.wayland.panel keeps one for every window and panel;
// std.ui.host.lightness gives it to the app.
//
//     var watch: appearance.Watch = undefined
//     appearance.init(&watch, environment)
//     // when descriptor(&watch) is readable, or after due(&watch, ...):
//     if appearance.check(&watch) { ... redraw while moving(&watch) }
//     const theme = theme_module.at(appearance.value(&watch))
const std = @import("std")
const conf = @import("std.conf")
const xdg = @import("std.xdg")

// value(): 0 is dark, LIGHT light.
pub const LIGHT: i32 = 1024
const DURATION: usize = 300
const POLL: usize = 2000

const IN_NONBLOCK: usize = 2048
// Close after writing, moved in (a file replaced by rename), created,
// deleted.
const IN_EVENTS: usize = 8 | 128 | 256 | 512

pub const Watch = struct {
    // inotify on the file's folder (-1: polled instead).
    descriptor: isize
    path: [256]u8
    pathLength: usize
    // The environment fixes the scheme (MLX_COLOR_SCHEME).
    fixed: bool
    light: bool
    // The glide: from, to (0 to LIGHT), when it set off (0: it stands).
    from: i32
    to: i32
    start: usize
    polledAt: usize
}

fn pathOf(watch: *Watch) -> [*]u8 {
    return &watch.*.path
}

// Whether the file says light ("color-scheme = light").
fn readLight(watch: *Watch) -> bool {
    const path = pathOf(watch)
    path[watch.*.pathLength] = 0
    var text: [1024]u8 = undefined
    const text_bytes: [*]u8 = &text
    const size = std.fs.readFile(path, text_bytes, 1024)
    var light = false
    var lines = conf.lines(text_bytes[0..size])
    var entry: conf.Entry = undefined
    while conf.next(&lines, &entry) {
        if std.text.same(entry.key, "color-scheme") { light = std.text.same(entry.value, "light") }
    }
    return light
}

// Starts following the scheme (`environment`: the program's).
pub fn init(watch: *Watch, environment: [*][*]const u8) -> void {
    watch.*.descriptor = -1
    watch.*.fixed = false
    watch.*.light = false
    watch.*.start = 0
    watch.*.polledAt = std.time.milliseconds()
    const fixed = std.process.environmentFrom(environment, "MLX_COLOR_SCHEME")
    if fixed != null {
        watch.*.fixed = true
        watch.*.light = std.text.same(std.text.cString(fixed.?.pointer), "light")
    }
    // The folder: $XDG_CONFIG_HOME/mlx, else $HOME/.config/mlx.
    const path = pathOf(watch)
    const length = xdg.path(environment, xdg.CONFIG, "/mlx", path, 241)
    if !watch.*.fixed && length > 0 {
        const descriptor = std.linux.syscall1(std.linux.SYS_inotify_init1, IN_NONBLOCK | std.linux.O_CLOEXEC)
        if descriptor >= 0 {
            if std.linux.syscall3(std.linux.SYS_inotify_add_watch, @bitCast(usize, descriptor), @intFromPtr(path), IN_EVENTS) >= 0 {
                watch.*.descriptor = descriptor
            } else {
                std.linux.close(descriptor)
            }
        }
    }
    watch.*.pathLength = if length > 0 { std.text.append(path, length, 240, "/appearance.conf") } else { 0 }
    if !watch.*.fixed { watch.*.light = readLight(watch) }
    watch.*.to = if watch.*.light { LIGHT } else { 0 }
    watch.*.from = watch.*.to
}

// The descriptor to wait on (-1: none; due() says when to look).
pub fn descriptor(watch: *Watch) -> isize { return watch.*.descriptor }

// Milliseconds until check() is due without the descriptor (at most
// `longest`; -1 for ever): the next frame while gliding, the next look
// at the file while it is polled.
pub fn due(watch: *Watch, longest: isize) -> isize {
    var next = longest
    if moving(watch) {
        if next < 0 || next > 16 { next = 16 }
    }
    if watch.*.descriptor < 0 && !watch.*.fixed {
        const now = std.time.milliseconds()
        const wait = if watch.*.polledAt + POLL > now { @intCast(isize, watch.*.polledAt + POLL - now) } else { 0 }
        if next < 0 || wait < next { next = wait }
    }
    return next
}

// Reads the scheme again (the descriptor's events taken); true when it
// changed: the glide to it starts.
pub fn check(watch: *Watch) -> bool {
    if watch.*.fixed { return false }
    if watch.*.descriptor >= 0 {
        var events: [1024]u8 = undefined
        while std.linux.read(watch.*.descriptor, &events, 1024) > 0 {}
    } else {
        const now = std.time.milliseconds()
        if now < watch.*.polledAt + POLL { return false }
        watch.*.polledAt = now
    }
    const light = readLight(watch)
    if light == watch.*.light { return false }
    watch.*.light = light
    watch.*.from = value(watch)
    watch.*.to = if light { LIGHT } else { 0 }
    watch.*.start = std.time.milliseconds()
    if watch.*.start == 0 { watch.*.start = 1 }
    return true
}

pub fn isLight(watch: *Watch) -> bool { return watch.*.light }

pub fn moving(watch: *Watch) -> bool {
    return watch.*.start != 0 && std.time.milliseconds() - watch.*.start < DURATION
}

// How light now: 0 (dark) to LIGHT, eased out while it glides.
pub fn value(watch: *Watch) -> i32 {
    if watch.*.start == 0 { return watch.*.to }
    const elapsed = std.time.milliseconds() - watch.*.start
    if elapsed >= DURATION {
        watch.*.start = 0
        return watch.*.to
    }
    const left = 1024 - @intCast(i64, elapsed * 1024 / DURATION)
    const t = 1024 - left * left / 1024 * left / 1024
    if watch.*.to >= watch.*.from { return watch.*.from + @intCast(i32, @intCast(i64, watch.*.to - watch.*.from) * t / 1024) }
    return watch.*.from - @intCast(i32, @intCast(i64, watch.*.from - watch.*.to) * t / 1024)
}
