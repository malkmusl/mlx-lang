// std.ui.lists: rows of lists and side bars: a row lit under the pointer
// and when chosen, with an indent, a label, a note on the right and room
// for the app's icon; a divider; a small arrow that folds a row.
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const glyphs = @import("std.ui.glyphs")
const controls = @import("std.ui.controls")

const Ui = view.Ui

// A row: lit under the pointer, `chosen` lit more; `string` from `indent`
// pixels in (after `icon_width` for the app's icon), `note` (dim, on the
// right) when not empty. True when clicked.
pub fn row(context: *Ui, row_id: u64, area: ui.Rect, string: []const u8, note: []const u8, chosen: bool, indent: i32, icon_width: i32) -> bool {
    view.region(context, row_id, area)
    const theme = context.*.theme
    const canvas = context.*.canvas
    if chosen {
        canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.radius - 1, theme.*.pressed)
    } else if view.isHover(context, row_id) {
        canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.radius - 1, theme.*.hover)
    }
    const font = context.*.body
    var note_width: i32 = 0
    if note.length > 0 {
        note_width = text_module.measure(context.*.small, note) + 8
        controls.label(context, context.*.small, note, ui.right(area) - note_width, controls.textTop(context.*.small, area.y, area.height), theme.*.dim, 0)
    }
    const left = area.x + 8 + indent + icon_width
    controls.label(context, font, string, left, controls.textTop(font, area.y, area.height), if chosen { theme.*.text } else { theme.*.text }, ui.right(area) - note_width - left - 4)
    return view.takeClick(context, row_id)
}

// Where a row's icon goes (its left edge) for the same indent.
pub fn iconX(area: ui.Rect, indent: i32) -> i32 { return area.x + 8 + indent }

// A row's fold arrow at its left (open: pointing down); true when the
// arrow itself was clicked.
pub fn foldArrow(context: *Ui, arrow_id: u64, x: i32, y: i32, open: bool) -> bool {
    view.region(context, arrow_id, ui.rect(x - 4, y - 4, 16, 16))
    glyphs.arrow(context.*.canvas, x, y, open, if view.isHover(context, arrow_id) { context.*.theme.*.text } else { context.*.theme.*.dim })
    return view.takeClick(context, arrow_id)
}

// A horizontal line across `width` at (x, y).
pub fn divider(context: *Ui, x: i32, y: i32, width: i32) -> void {
    canvas_module.fillRect(context.*.canvas, x, y, width, 1, context.*.theme.*.divider)
}
