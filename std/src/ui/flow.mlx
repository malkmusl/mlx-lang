// std.ui.flow: rows laid out one under another in logical pixels, the
// easy way to put std.ui's widgets on a page (std.ui.widgets takes a
// Flow). A Flow runs down an area: each row it hands out is the full
// width (less a card's inset), `gap` logical pixels under the one before.
// Sizes given to it are logical pixels; it multiplies by the scale (pixels
// a logical pixel, std.ui.host.scale), so one layout serves every screen.
//
//     var page = flow.begin(&ui, area, host.scale(state.host))
//     widgets.section(&page, "Dock")
//     if widgets.toggle(&page, "Auto-hide dock", "", &state.autohide) { save() }
//     state.pageHeight = flow.used(&page)         // for scrolling
//
// Ids: a widget's id comes from its label, within the Flow's scope
// (pushScope / pushIndex for the rows of a list, so two rows with the
// same label differ; popScope after), or from `id` when the app sets one
// for the next widget (an app that maps hits back to its own items).
const ui = @import("std.ui")
const view = @import("std.ui.view")

const Ui = view.Ui

pub const MAX_SCOPES: usize = 8
pub const DEFAULT_GAP: i32 = 6

pub const Flow = struct {
    ui: *Ui
    // Where the rows go (pixels) and the scale.
    area: ui.Rect
    scale: i32
    // The next row's top (pixels), the gap between rows (logical pixels).
    y: i32
    gap: i32
    // Pixels kept free at both sides from now on (inside a card).
    inset: i32
    // The id scopes (the innermost last) and the id set for the next
    // widget (NONE: from its label).
    scopes: [8]u64
    depth: usize
    nextId: u64
    // The open card's id and top (std.ui.widgets).
    cardId: u64
    cardTop: i32
}

// A flow down `area` (pixels) at `scale` pixels a logical pixel.
pub fn begin(context: *Ui, area: ui.Rect, scale: i32) -> Flow {
    var flow: Flow = undefined
    flow.ui = context
    flow.area = area
    flow.scale = if scale > 0 { scale } else { 1 }
    flow.y = area.y
    flow.gap = DEFAULT_GAP
    flow.inset = 0
    flow.depth = 0
    flow.nextId = view.NONE
    flow.cardId = view.NONE
    flow.cardTop = 0
    return flow
}

// `logical` logical pixels in pixels.
pub fn px(flow: *const Flow, logical: i32) -> i32 { return logical * flow.*.scale }

// The next row, `logical` logical pixels tall: its rectangle; the flow
// moves on past it and the gap.
pub fn row(flow: *Flow, logical: i32) -> ui.Rect {
    const height = px(flow, logical)
    const placed = ui.rect(left(flow), flow.*.y, width(flow), height)
    flow.*.y += height + px(flow, flow.*.gap)
    return placed
}

// A row of `pixels` pixels (for what the app measured itself).
pub fn rowPixels(flow: *Flow, pixels: i32) -> ui.Rect {
    const placed = ui.rect(left(flow), flow.*.y, width(flow), pixels)
    flow.*.y += pixels + px(flow, flow.*.gap)
    return placed
}

// `logical` logical pixels of nothing (instead of the gap: a gap is
// taken back).
pub fn space(flow: *Flow, logical: i32) -> void {
    flow.*.y += px(flow, logical)
}

// The rows' left edge and width now (inside a card's inset).
pub fn left(flow: *const Flow) -> i32 { return flow.*.area.x + flow.*.inset }
pub fn width(flow: *const Flow) -> i32 { return flow.*.area.width - flow.*.inset * 2 }

// Pixels from the area's top to below the last row (the content's
// height, for scrolling), without the gap after it.
pub fn used(flow: *const Flow) -> i32 {
    const total = flow.*.y - flow.*.area.y
    return if total > 0 { total - px(flow, flow.*.gap) } else { 0 }
}

// Whether a row at the flow's y, `logical` tall, would show in `visible`
// (rows scrolled out of view need not be drawn, but must still be laid
// out: call row() for them anyway).
pub fn shows(flow: *const Flow, logical: i32, visible: ui.Rect) -> bool {
    return flow.*.y < ui.bottom(visible) && flow.*.y + px(flow, logical) > visible.y
}

// ---------------------------------------------------------------------------
// Ids

fn scopeOf(flow: *const Flow) -> u64 {
    if flow.*.depth == 0 { return view.id("flow") }
    return flow.*.scopes[flow.*.depth - 1]
}

// Widgets from here on take ids within `name` (a list's name), until
// popScope.
pub fn pushScope(flow: *Flow, name: []const u8) -> void {
    if flow.*.depth >= MAX_SCOPES { return }
    flow.*.scopes[flow.*.depth] = view.idOf(scopeOf(flow), @intCast(usize, view.id(name) & 1073741823))
    flow.*.depth += 1
}

// The same for row `index` of a list.
pub fn pushIndex(flow: *Flow, index: usize) -> void {
    if flow.*.depth >= MAX_SCOPES { return }
    flow.*.scopes[flow.*.depth] = view.idOf(scopeOf(flow), index)
    flow.*.depth += 1
}

pub fn popScope(flow: *Flow) -> void {
    if flow.*.depth > 0 { flow.*.depth -= 1 }
}

// The next widget takes `widget_id` (an app's own number) instead of one
// from its label.
pub fn id(flow: *Flow, widget_id: u64) -> void { flow.*.nextId = widget_id }

// The id for a widget labelled `name`: the one set with id(), else from
// the name within the scope.
pub fn idFor(flow: *Flow, name: []const u8) -> u64 {
    if flow.*.nextId != view.NONE {
        const taken = flow.*.nextId
        flow.*.nextId = view.NONE
        return taken
    }
    return view.idOf(scopeOf(flow), @intCast(usize, view.id(name) & 1073741823))
}
