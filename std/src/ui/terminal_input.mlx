// std.ui.terminal_input: the pointer and pastes for a std.ui.terminal
// View. The left button selects: a drag by cells, a double click by words,
// a triple click by lines, Shift and a click extend the selection. When
// the program asked for the mouse (DECSET 9, 1000, 1002 or 1003) its
// buttons, wheel and the motion it asked for go to the program instead,
// X10 or SGR (1006) encoded, and Shift still selects. The wheel scrolls
// the history, or on the alternate screen (less, man, an editor) sends
// arrow keys. Pasted text is filtered: escape and the other control
// characters go (a paste cannot end bracketed paste early, move the
// cursor or change the terminal's state) and line ends become carriage
// returns, inside ESC [ 200 ~ ... ESC [ 201 ~ when the program asked for
// bracketed paste (2004). Dropped files become their paths, quoted for a
// shell.
//
//     follow(&view)                                   // after output
//     const bytes = press(&view, area, x, y, button, modifiers, now, &out)
//     const length = selectedText(&view, buffer, capacity)
const std = @import("std")
const ui = @import("std.ui")
const ui_keys = @import("std.ui.keys")
const terminal = @import("std.terminal")
const ui_terminal = @import("std.ui.terminal")

const View = ui_terminal.View
const NO_BUTTON = ui_terminal.NO_BUTTON

pub const BUTTON_LEFT: u32 = 272
pub const BUTTON_RIGHT: u32 = 273
pub const BUTTON_MIDDLE: u32 = 274
// Clicks closer than this (milliseconds) on one cell count together.
const CLICK_GAP: usize = 400
// The most a report or a wheel's keys take in `out`.
pub const REPORT_CAPACITY: usize = 64

// ---------------------------------------------------------------------------
// The selection

// Follows the screen after output: lines the history dropped off its top
// move the selection up (it goes when they took it), the other screen
// (the alternate one, or back) or a cleared history ends it.
pub fn follow(view: *View) -> void {
    const screen = view.*.screen
    if screen.*.onAlternate != view.*.seenAlternate {
        clear(view)
    } else if !screen.*.onAlternate {
        if screen.*.historyCount < view.*.seenHistoryCount {
            clear(view)
        } else if screen.*.historyStart != view.*.seenHistoryStart {
            const lines = screen.*.historyLines
            dropLines(view, (screen.*.historyStart + lines - view.*.seenHistoryStart) % lines)
        }
    }
    view.*.seenAlternate = screen.*.onAlternate
    view.*.seenHistoryCount = screen.*.historyCount
    view.*.seenHistoryStart = screen.*.historyStart
}

fn dropLines(view: *View, dropped: usize) -> void {
    view.*.pressCount = 0
    if view.*.anchorLine < dropped && view.*.endLine < dropped {
        clear(view)
        return
    }
    if view.*.anchorLine < dropped {
        view.*.anchorLine = 0
        view.*.anchorColumn = 0
    } else {
        view.*.anchorLine -= dropped
    }
    if view.*.endLine < dropped {
        view.*.endLine = 0
        view.*.endColumn = 0
    } else {
        view.*.endLine -= dropped
    }
}

// Ends the selection (the window's size changed, the screen was left).
pub fn clear(view: *View) -> void {
    if view.*.hasSelection { view.*.screen.*.dirty = true }
    view.*.hasSelection = false
    view.*.selecting = false
}

// The line and column at (x, y) in `area`, the column a boundary between
// cells (rounded to the nearer) when `boundary`, else the cell.
fn pointAt(view: *View, area: ui.Rect, x: i32, y: i32, boundary: bool, line: *usize, column: *usize) -> void {
    const screen = view.*.screen
    const left = area.x + view.*.padding
    const top = area.y + view.*.padding
    var row: i32 = if y < top { 0 } else { (y - top) / view.*.cellHeight }
    if row >= @intCast(i32, screen.*.rows) { row = @intCast(i32, screen.*.rows) - 1 }
    var cell: i32 = 0
    if boundary {
        cell = if x < left { 0 } else { (x - left + view.*.cellWidth / 2) / view.*.cellWidth }
        if cell > @intCast(i32, screen.*.columns) { cell = @intCast(i32, screen.*.columns) }
    } else {
        cell = if x < left { 0 } else { (x - left) / view.*.cellWidth }
        if cell >= @intCast(i32, screen.*.columns) { cell = @intCast(i32, screen.*.columns) - 1 }
    }
    line.* = ui_terminal.topLine(screen) + @intCast(usize, row)
    column.* = @intCast(usize, cell)
}

// Whether the program hears the pointer (it asked, and Shift is not held).
pub fn reportsMouse(view: *const View, modifiers: u32) -> bool {
    return view.*.screen.*.mouseMode != 0 && modifiers & ui_keys.SHIFT == 0
}

// A button went down at (x, y) at `now` (milliseconds): what the program
// is sent (into `out`, REPORT_CAPACITY bytes), else the selection starts.
pub fn press(view: *View, area: ui.Rect, x: i32, y: i32, button: u32, modifiers: u32, now: usize, out: [*]u8) -> usize {
    follow(view)
    if reportsMouse(view, modifiers) {
        const code = buttonCode(button)
        if code == NO_BUTTON { return 0 }
        view.*.reportedButton = code
        var line: usize = 0
        var column: usize = 0
        pointAt(view, area, x, y, false, &line, &column)
        view.*.reportedLine = line
        view.*.reportedColumn = column
        return report(view, code, modifiers, line, column, true, out)
    }
    if button != BUTTON_LEFT { return 0 }
    var line: usize = 0
    var cell: usize = 0
    pointAt(view, area, x, y, false, &line, &cell)
    const again = view.*.pressCount > 0 && view.*.pressCount < 3 && now >= view.*.pressTime && now - view.*.pressTime < CLICK_GAP && line == view.*.pressLine && cell == view.*.pressColumn
    view.*.pressCount = if again { view.*.pressCount + 1 } else { 1 }
    view.*.pressTime = now
    view.*.pressLine = line
    view.*.pressColumn = cell
    view.*.screen.*.dirty = true
    view.*.selecting = true
    if view.*.pressCount == 1 && modifiers & ui_keys.SHIFT != 0 && view.*.hasSelection && view.*.screen.*.mouseMode == 0 {
        // Shift and a click: the far end moves here (while the program has
        // the mouse, Shift is what selects at all, so it starts afresh).
        moveEnd(view, area, x, y)
        return 0
    }
    view.*.selectionUnit = view.*.pressCount
    var column = cell
    if view.*.selectionUnit == 1 { pointAt(view, area, x, y, true, &line, &column) }
    view.*.anchorLine = line
    view.*.anchorColumn = column
    view.*.endLine = line
    view.*.endColumn = column
    // A single click selects nothing until the pointer moves.
    view.*.hasSelection = view.*.selectionUnit > 1
    return 0
}

fn moveEnd(view: *View, area: ui.Rect, x: i32, y: i32) -> void {
    var line: usize = 0
    var column: usize = 0
    pointAt(view, area, x, y, view.*.selectionUnit == 1, &line, &column)
    if line != view.*.endLine || column != view.*.endColumn { view.*.screen.*.dirty = true }
    view.*.endLine = line
    view.*.endColumn = column
    view.*.hasSelection = true
}

// The pointer moved to (x, y): a held left button drags the selection, a
// program that asked hears the motion.
pub fn motion(view: *View, area: ui.Rect, x: i32, y: i32, modifiers: u32, out: [*]u8) -> usize {
    if view.*.selecting {
        moveEnd(view, area, x, y)
        return 0
    }
    const mode = view.*.screen.*.mouseMode
    if view.*.reportedButton == NO_BUTTON && mode != 1003 { return 0 }
    if mode != 1002 && mode != 1003 { return 0 }
    var line: usize = 0
    var column: usize = 0
    pointAt(view, area, x, y, false, &line, &column)
    if line == view.*.reportedLine && column == view.*.reportedColumn { return 0 }
    view.*.reportedLine = line
    view.*.reportedColumn = column
    const held = if view.*.reportedButton == NO_BUTTON { 3 } else { view.*.reportedButton }
    return report(view, held + 32, modifiers, line, column, true, out)
}

// A button went up: the selection is made, or the program hears it.
pub fn release(view: *View, area: ui.Rect, x: i32, y: i32, button: u32, modifiers: u32, out: [*]u8) -> usize {
    if view.*.selecting && button == BUTTON_LEFT {
        view.*.selecting = false
        return 0
    }
    if view.*.reportedButton == NO_BUTTON || buttonCode(button) != view.*.reportedButton { return 0 }
    const code = view.*.reportedButton
    view.*.reportedButton = NO_BUTTON
    // X10 mode (9) reports presses only.
    if view.*.screen.*.mouseMode == 9 || view.*.screen.*.mouseMode == 0 { return 0 }
    var line: usize = 0
    var column: usize = 0
    pointAt(view, area, x, y, false, &line, &column)
    return report(view, code, modifiers, line, column, false, out)
}

// The wheel turned `steps` notches (positive: down) over (x, y): the
// program hears it when it asked, on the alternate screen it gets arrow
// keys (three a notch), else the view scrolls through the history. What
// the program is sent goes into `out` (REPORT_CAPACITY bytes).
pub fn wheel(view: *View, area: ui.Rect, x: i32, y: i32, steps: i32, modifiers: u32, out: [*]u8) -> usize {
    const screen = view.*.screen
    const count = @intCast(usize, if steps < 0 { 0 - steps } else { steps })
    var length: usize = 0
    if reportsMouse(view, modifiers) {
        var line: usize = 0
        var column: usize = 0
        pointAt(view, area, x, y, false, &line, &column)
        var index: usize = 0
        while index < count && length + 16 <= REPORT_CAPACITY {
            length += report(view, if steps < 0 { 64 } else { 65 }, modifiers, line, column, true, advance(out, length))
            index += 1
        }
        return length
    }
    if screen.*.onAlternate {
        var index: usize = 0
        while index < count * 3 && length + 3 <= REPORT_CAPACITY {
            out[length] = 27
            out[length + 1] = if screen.*.applicationCursor { 79 } else { 91 }
            out[length + 2] = if steps < 0 { 65 } else { 66 }
            length += 3
            index += 1
        }
        return length
    }
    ui_terminal.wheel(view, steps)
    return 0
}

fn advance(bytes: [*]u8, by: usize) -> [*]u8 {
    const result: [*]u8 = bytes + by
    return result
}

// A button's code in a report: left 0, middle 1, right 2.
fn buttonCode(button: u32) -> u32 {
    if button == BUTTON_LEFT { return 0 }
    if button == BUTTON_MIDDLE { return 1 }
    if button == BUTTON_RIGHT { return 2 }
    return NO_BUTTON
}

// A report: ESC [ < code ; column ; row M (or m when let go) in SGR, else
// ESC [ M and three bytes (the code, column and row plus 32; a release
// is code 3, and places past 223 are given as 223). Alt adds 8 and Ctrl
// 16 to the code except in X10 mode (9).
fn report(view: *View, base: u32, modifiers: u32, line: usize, column: usize, pressed: bool, out: [*]u8) -> usize {
    const screen = view.*.screen
    var code = base
    if screen.*.mouseMode != 9 {
        if modifiers & ui_keys.ALT != 0 { code += 8 }
        if modifiers & ui_keys.CONTROL != 0 { code += 16 }
    }
    const row = line - ui_terminal.topLine(screen) + 1
    const cell = column + 1
    out[0] = 27
    out[1] = 91
    if screen.*.mouseEncoding == 1006 {
        out[2] = 60
        var length: usize = 3
        length = writeNumber(out, length, @intCast(usize, code))
        out[length] = 59
        length = writeNumber(out, length + 1, cell)
        out[length] = 59
        length = writeNumber(out, length + 1, row)
        out[length] = if pressed { 77 } else { 109 }
        return length + 1
    }
    out[2] = 77
    out[3] = @intCast(u8, 32 + (if pressed { code } else { 3 + (code & 28) }))
    out[4] = @intCast(u8, 32 + (if cell > 223 { 223 } else { cell }))
    out[5] = @intCast(u8, 32 + (if row > 223 { 223 } else { row }))
    return 6
}

fn writeNumber(out: [*]u8, at: usize, value: usize) -> usize {
    var digits: [20]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var length = at
    while count > 0 {
        count -= 1
        out[length] = digits[count]
        length += 1
    }
    return length
}

// ---------------------------------------------------------------------------
// The selected text

// How many bytes the selected text can take at most (selectedText's
// capacity); 0 when nothing is selected.
pub fn selectedCapacity(view: *View) -> usize {
    var range: ui_terminal.Range = undefined
    if !ui_terminal.selectionRange(view, &range) { return 0 }
    return (range.toLine - range.fromLine + 1) * (view.*.screen.*.columns * 4 + 1)
}

// The selected text as UTF-8 into `out` (selectedCapacity bytes): blanks
// at the ends of lines go, and lines end with a newline unless the text
// runs on into the next one (its last cell is not blank: a line the
// program wrapped).
pub fn selectedText(view: *View, out: [*]u8, capacity: usize) -> usize {
    var range: ui_terminal.Range = undefined
    if !ui_terminal.selectionRange(view, &range) { return 0 }
    const screen = view.*.screen
    const columns = screen.*.columns
    var length: usize = 0
    var line = range.fromLine
    while line <= range.toLine {
        const from = if line == range.fromLine { range.fromColumn } else { 0 }
        const to = if line == range.toLine { range.toColumn } else { columns }
        // Up to the last cell that is not blank (when the line's end is
        // taken).
        var end = to
        if to == columns {
            while end > from && blank(ui_terminal.lineCell(screen, line, end - 1)) { end -= 1 }
        }
        var column = from
        while column < end && length + 4 <= capacity {
            const cell = ui_terminal.lineCell(screen, line, column)
            if cell.*.width != 0 {
                length += terminal.encodeUtf8(if cell.*.codepoint == 0 { 32 } else { cell.*.codepoint }, advance(out, length))
            }
            column += 1
        }
        const runs_on = to == columns && end == columns
        if line < range.toLine && !runs_on && length < capacity {
            out[length] = 10
            length += 1
        }
        line += 1
    }
    return length
}

fn blank(cell: *terminal.Cell) -> bool {
    return cell.*.width != 0 && (cell.*.codepoint == 32 || cell.*.codepoint == 0)
}

// ---------------------------------------------------------------------------
// Pastes and drops

// What starts and ends a paste: ESC [ 200 ~ and ESC [ 201 ~ when the
// program asked for bracketed paste, else nothing (`out`: 6 bytes).
pub fn pasteBegin(view: *const View, out: [*]u8) -> usize { return bracket(view, out, 48) }
pub fn pasteEnd(view: *const View, out: [*]u8) -> usize { return bracket(view, out, 49) }

fn bracket(view: *const View, out: [*]u8, last: u8) -> usize {
    if !view.*.screen.*.bracketedPaste { return 0 }
    out[0] = 27
    out[1] = 91
    out[2] = 50
    out[3] = 48
    out[4] = last
    out[5] = 126
    return 6
}

// Filters pasted `text` from `from` into `out` (up to `capacity` bytes,
// their count into `written`): a line end (CR LF, LF or CR) becomes CR,
// tabs stay, the other C0 controls, DEL and the C1 controls (U+0080 to
// U+009F) go. Returns where it stopped (text.length when done).
pub fn filterPaste(text: []const u8, from: usize, out: [*]u8, capacity: usize, written: *usize) -> usize {
    var at = from
    var length: usize = 0
    while at < text.length && length < capacity {
        const byte = text[at]
        if byte == 13 || byte == 10 {
            out[length] = 13
            length += 1
            if byte == 13 && at + 1 < text.length && text[at + 1] == 10 { at += 1 }
        } else if byte == 9 || (byte >= 32 && byte != 127 && byte != 194) {
            out[length] = byte
            length += 1
        } else if byte == 194 {
            // U+0080 to U+009F are C2 80 to C2 9F.
            if at + 1 < text.length && text[at + 1] >= 128 && text[at + 1] <= 159 {
                at += 1
            } else {
                out[length] = byte
                length += 1
            }
        }
        at += 1
    }
    written.* = length
    return at
}

// The paths of a text/uri-list's file:// URIs (%XX decoded, the host
// skipped), each quoted for a shell ('...', a quote inside as '\'') and
// followed by a space; other URIs quoted as they are. Comment lines go.
// Only whole paths are written; returns the length.
pub fn quotedPaths(list: []const u8, out: [*]u8, capacity: usize) -> usize {
    var length: usize = 0
    var at: usize = 0
    while at < list.length {
        var end = at
        while end < list.length && list[end] != 10 && list[end] != 13 { end += 1 }
        if end > at && list[at] != 35 {
            const written = quoteUri(list[at..end], out, length, capacity)
            if written == 0 { return length }
            length = written
        }
        at = end + 1
    }
    return length
}

// Appends `uri` quoted at `length`; the new length, or 0 when it does
// not fit.
fn quoteUri(uri: []const u8, out: [*]u8, length: usize, capacity: usize) -> usize {
    var at: usize = 0
    if uri.length > 7 && std.text.same(uri[0..7], "file://") {
        at = 7
        // file://host/path: the host (usually none or localhost) goes.
        while at < uri.length && uri[at] != 47 { at += 1 }
    }
    var written = length
    if written + 1 > capacity { return 0 }
    out[written] = 39
    written += 1
    while at < uri.length {
        var byte = uri[at]
        if byte == 37 && at + 2 < uri.length && std.text.hexValue(uri[at + 1]) < 16 && std.text.hexValue(uri[at + 2]) < 16 {
            byte = @intCast(u8, std.text.hexValue(uri[at + 1]) * 16 + std.text.hexValue(uri[at + 2]))
            at += 2
        }
        if byte == 39 {
            if written + 4 > capacity { return 0 }
            out[written] = 39
            out[written + 1] = 92
            out[written + 2] = 39
            out[written + 3] = 39
            written += 4
        } else {
            if written + 1 > capacity { return 0 }
            out[written] = byte
            written += 1
        }
        at += 1
    }
    if written + 2 > capacity { return 0 }
    out[written] = 39
    out[written + 1] = 32
    return written + 2
}
