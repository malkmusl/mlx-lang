// std.ui.host on Linux: a std.ui app in a Wayland window
// (std.ui.wayland.panel), drawn by the GPU (std.ui.gpu_canvas through
// linux-dmabuf, or into shared memory) or, without Vulkan, on the CPU.
//
// host.android.mlx has the same functions for an Android activity, so a
// program's source is the same for both (the compiler picks this file
// for Linux targets, see std.platform). A program has both entries; the
// other platform's does nothing:
//
//     pub fn main(arguments: [][*]const u8) -> !void {
//         const state = newState()
//         state.*.host = host.create(options(), @ptrCast(*anyopaque, state), draw, onEvent).?
//         try host.open(state.*.host, arguments)
//         try host.run(state.*.host)
//     }
//
//     export fn ANativeActivity_onCreate(activity: usize, saved_state: usize, saved_state_size: usize) -> void {
//         const state = newState()
//         state.*.host = host.create(options(), @ptrCast(*anyopaque, state), draw, onEvent).?
//         const opened = host.openActivity(state.*.host, activity, saved_state, saved_state_size)
//     }
//
// The app has its host before the first event (create calls nothing).
// The app gets std.ui.app's events (and, where the platform has them,
// drags and drops); what it asks of the platform goes through the
// functions below (the ones a platform cannot do do nothing there).
const std = @import("std")
const ui = @import("std.ui")
const ui_app = @import("std.ui.app")
const keys = @import("std.ui.keys")
const view = @import("std.ui.view")
const panel_module = @import("std.ui.wayland.panel")
const panel_drag = @import("std.ui.wayland.panel_drag")
const panel_menu = @import("std.ui.wayland.panel_menu")

pub const Allocator = std.allocator.Allocator

// What the window is called and how big it starts (the smallest it may
// get: 0 for any).
pub const Options = struct {
    title: []const u8
    appId: []const u8
    width: u32
    height: u32
    minWidth: i32
    minHeight: i32
}

pub const Host = struct {
    panel: panel_module.Panel
    options: Options
    environment: [*][*]const u8
}

pub fn panelOf(host: *Host) -> *panel_module.Panel {
    unsafe { return @ptrCast(*panel_module.Panel, &host.*.panel) }
}

// The app's host: `draw` and `event` get `context`. Null without memory.
pub fn create(options: Options, context: *anyopaque, draw: ui_app.Draw, event: ui_app.Handler) -> ?*Host {
    const allocator = std.page_allocator.init()
    const memory = allocator.alloc(@sizeOf(Host), 16)
    if memory == null { return null }
    var host: *Host = undefined
    unsafe { host = @ptrCast(*Host, memory.?) }
    host.*.options = options
    const panel = panelOf(host)
    panel.*.context = context
    panel.*.draw = draw
    panel.*.event = event
    return host
}

// Opens the app's window (main's arguments: the environment's there).
pub fn open(host: *Host, arguments: [][*]const u8) -> !void {
    host.*.environment = std.process.environmentEntries(arguments)
    const options = host.*.options
    const panel = panelOf(host)
    try panel_module.openWindow(panel, std.page_allocator.init(), arguments, options.title, options.appId, options.width, options.height)
    if options.minWidth > 0 || options.minHeight > 0 { panel.*.toplevel.setMinSize(options.minWidth, options.minHeight) }
}

// The window's event loop, until the app quits or the window is closed.
pub fn run(host: *Host) -> !void {
    try panel_module.run(panelOf(host))
    panel_module.close(panelOf(host))
}

// An Android activity: not on Linux.
pub fn openActivity(host: *Host, activity: usize, saved_state: usize, saved_state_size: usize) -> bool { return false }

// Whether the pointer is a finger (a tap opens; a long press is the right
// button): not on the desktop.
pub fn touchScreen(host: *Host) -> bool { return false }

// The window's size (pixels).
pub fn width(host: *Host) -> i32 { return @intCast(i32, panelOf(host).*.width) }
pub fn height(host: *Host) -> i32 { return @intCast(i32, panelOf(host).*.height) }

// The space the system keeps at the window's edges (none on the desktop),
// and how many pixels a logical pixel is.
pub fn insets(host: *Host) -> ui.Insets { return ui.uniform(0) }
pub fn scale(host: *Host) -> i32 { return 1 }

// The next frame: drawn as soon as the platform takes one.
pub fn redraw(host: *Host) -> void { panelOf(host).*.dirty = true }

// EVENT_TICK every `milliseconds` (0: none).
pub fn setTick(host: *Host, milliseconds: usize) -> void { panelOf(host).*.tickInterval = milliseconds }

// What the key of the current EVENT_KEY types.
pub fn typed(host: *Host) -> []const u8 { return panel_module.textOf(panelOf(host)) }

// The modifiers held (std.ui.keys); not Ctrl and Alt while a key types its
// third level (AltGr, or Ctrl+Alt standing for it).
pub fn modifiers(host: *Host) -> u32 {
    const panel = panelOf(host)
    const held = panel.*.keyboard.depressed
    var result: u32 = 0
    if held & 1 != 0 { result |= keys.SHIFT }
    if held & 4 != 0 { result |= keys.CONTROL }
    if held & 8 != 0 { result |= keys.ALT }
    if held & 64 != 0 { result |= keys.SUPER }
    if panel.*.keyboard.levelThree && panel.*.textLength > 0 { result &= ~(keys.CONTROL | keys.ALT) }
    return result
}

// Whether the current key types its third level (AltGr, or Ctrl+Alt
// standing for it): its Ctrl and Alt are not shortcuts then.
pub fn thirdLevel(host: *Host) -> bool { return panelOf(host).*.keyboard.levelThree && panelOf(host).*.textLength > 0 }

// How far the last EVENT_WHEEL scrolls (pixels; positive: toward the
// end).
pub fn wheelPixels(host: *Host) -> i32 { return panelOf(host).*.wheelPixels * 3 }

// Back is a key there is no system meaning for on the desktop: it always
// comes (keys.BACK) when a keyboard has it.
pub fn wantBack(host: *Host, wanted: bool) -> void {}

// The on-screen keyboard for a field at `area`: a desktop has a real one.
pub fn showKeyboard(host: *Host, area: ui.Rect) -> void {}
pub fn hideKeyboard(host: *Host) -> void {}

// The user's home (where the app's files are): $HOME.
pub fn home(host: *Host) -> []const u8 {
    const value = environmentValue(host, "HOME")
    return if value.length > 0 { value } else { "/" }
}

// The device's shared storage (a phone's Download, DCIM, ...): none on
// the desktop, where home is the user's.
pub fn sharedStorage(host: *Host) -> []const u8 { return "" }
pub fn sharedStorageAllowed(host: *Host) -> bool { return false }
pub fn askSharedStorage(host: *Host) -> bool { return false }

// The process environment (empty where there is none).
pub fn environment(host: *Host) -> [*][*]const u8 { return host.*.environment }

pub fn environmentValue(host: *Host, name: []const u8) -> []const u8 {
    var index: usize = 0
    while true {
        const entry = host.*.environment[index]
        if @intFromPtr(entry) == 0 { return "" }
        var length: usize = 0
        while entry[length] != 0 { length += 1 }
        if length > name.length && entry[name.length] == 61 && std.text.same(entry[0..name.length], name) { return entry[name.length + 1..length] }
        index += 1
    }
    return ""
}

pub fn setTitle(host: *Host, title: []const u8) -> void { panelOf(host).*.toplevel.setTitle(title) }

// Every key to the window, the desktop's shortcuts too (recording a
// hotkey: keyboard-shortcuts-inhibit), or not.
pub fn inhibitShortcuts(host: *Host, on: bool) -> void { panel_module.inhibitShortcuts(panelOf(host), on) }

// Ends run().
pub fn quit(host: *Host) -> void { panelOf(host).*.running = false }

// Blur behind `count` rectangles (x, y, width, height each) of the window.
pub fn setBlur(host: *Host, rects: [*]const i32, count: usize) -> void { panel_module.setBlur(panelOf(host), rects, count) }

// Blur behind the glass areas the frame named (std.ui.surface.glass,
// std.ui.view.blurRegion): call it after each frame (and layout pass); it
// tells the compositor only when they changed.
pub fn applyBlur(host: *Host, context: *view.Ui) -> void {
    if !view.takeBlurChanged(context) { return }
    var rects: [64]i32 = undefined
    var pointer: [*]i32 = undefined
    unsafe { pointer = @ptrCast([*]i32, &rects) }
    const count = view.blurRects(context, pointer)
    panel_module.setBlur(panelOf(host), pointer, count)
}

// Where a popup goes relative to its anchor (std.ui.wayland.panel's
// PLACE_*).
pub const PLACE_TOP: u32 = panel_module.PLACE_TOP
pub const PLACE_BOTTOM: u32 = panel_module.PLACE_BOTTOM
pub const PLACE_LEFT: u32 = 3
pub const PLACE_RIGHT: u32 = 4

// Opens a popup (a menu) `width` x `height` pixels beside the rectangle
// (x, y, anchor_width, anchor_height) of the window, on the `place` side:
// a surface of its own over the window, glass with corners of `radius`
// (the compositor blurs the window behind it; -1: no glass). `draw` paints
// it (on the CPU; clear it to 0 and draw the popup's frame translucent)
// now and after each redrawPopup. The pointer in it comes as
// EVENT_POPUP_* (std.ui.app.feedPopup hands them to a Ui of the popup's
// own); it closes with closePopup, or by itself (EVENT_POPUP_CLOSED) on a
// click outside. False where there are no popups (a phone: draw it in the
// window with std.ui.popup instead).
pub fn openPopup(host: *Host, x: i32, y: i32, anchor_width: i32, anchor_height: i32, place: u32, width: u32, height: u32, radius: i32, draw: ui_app.Draw) -> bool {
    const panel = panelOf(host)
    if !panel_menu.openMenu(panel, x, y, anchor_width, anchor_height, place, width, height, draw) { return false }
    if radius >= 0 { panel_menu.blurMenu(panel, radius) }
    return true
}

pub fn closePopup(host: *Host) -> void { panel_menu.closeMenu(panelOf(host)) }
pub fn popupOpen(host: *Host) -> bool { return panelOf(host).*.menuOpen }

// The popup is drawn again (with the next turn of the event loop).
pub fn redrawPopup(host: *Host) -> void { panel_menu.menuChanged(panelOf(host)) }

// Drags of `mime` dropped on the window come as EVENT_DRAG_MOTION,
// EVENT_DRAG_LEAVE and EVENT_DROP (the data: dropData).
pub fn acceptDrops(host: *Host, mime: []const u8) -> void { panel_drag.acceptDrops(panelOf(host), mime) }
pub fn dropData(host: *Host) -> []const u8 { return panel_drag.dropDataOf(panelOf(host)) }

// Drags `data` out of the window (its icon drawn by `draw`, `size` pixels
// square); EVENT_DRAG_END when it ends. False where there is no dragging.
pub fn startDrag(host: *Host, mime: []const u8, data: []const u8, size: u32, draw: ui_app.Draw) -> bool { return panel_drag.startDrag(panelOf(host), mime, data, size, draw) }

// The GPU forgets the images it has (they changed).
pub fn forgetImages(host: *Host) -> void { panel_module.forgetImages(panelOf(host)) }

// Says on stdout how the app draws (GPU or CPU).
pub fn report(host: *Host, program: []const u8) -> void { panel_module.report(panelOf(host), program) }

// A line for whoever reads the program's log: stdout here.
pub fn log(host: *Host, line: []const u8) -> void {
    const a = std.io.writeAll(std.io.stdout(), line)
    const b = std.io.writeAll(std.io.stdout(), "\n")
}
