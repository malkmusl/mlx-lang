// std.ui.theme: the colours and sizes std.ui's widgets draw with. Colours
// are premultiplied ARGB (std.ui.canvas.color); an app keeps one Theme
// and may change any field.
//
// The look is the Mlx design language (docs/reference/design.md). Its
// colours come from one seed colour, the way Material You's do: fromSeed
// takes the seed's hue and makes the whole palette from it, the accent at
// a readable lightness and every surface a near-neutral grey with a trace
// of the hue, dark or light. Depth reads from the surfaces' contrast;
// shadows are for what floats (popups) and glows for nothing but a
// field's focus. The desktop takes the seed from
// mlx-settings (projects/desktop/shared/look.mlx); dark() and light() are
// the palettes of the default seed, an indigo.
const canvas = @import("std.ui.canvas")

pub const Theme = struct {
    // The window and its side panels; a raised surface (a popup, a field).
    background: u32
    panel: u32
    raised: u32
    field: u32
    // Under the pointer, held down, chosen (a selected row).
    hover: u32
    pressed: u32
    selected: u32
    // Lines between parts, outlines (used sparingly: depth comes from
    // shadows).
    divider: u32
    border: u32
    // Text: normal, secondary, disabled, on the accent.
    text: u32
    dim: u32
    disabled: u32
    onAccent: u32
    accent: u32
    danger: u32
    // A control's off state (an empty check box, a switch's track).
    control: u32
    controlInner: u32
    // Buttons: normal and under the pointer; the primary one.
    button: u32
    buttonHover: u32
    primary: u32
    primaryHover: u32
    // A switch's track when off (and under the pointer), its knob (and a
    // slider's handle).
    switchOff: u32
    switchOffHover: u32
    knob: u32
    // Scroll bars (and a slider's trough): the track and the thumb.
    track: u32
    thumb: u32
    // A thin scroll indicator over the content.
    indicator: u32
    // Text selection, the caret.
    selection: u32
    caret: u32
    // Soft shadows at their densest (std.ui.canvas.shadow fades them out).
    shadow: u32
    // Popups: their surface and outline; a row under the pointer, the
    // row chosen by keys.
    popup: u32
    popupBorder: u32
    menuHover: u32
    menuChosen: u32
    // The accent's glow around what is on or has the focus; the hairline
    // of light along a raised surface's top edge.
    glow: u32
    highlight: u32
    // A card (a group of rows floating on the page; opaque, so its own
    // shadow does not show through it) and the translucent tint of a
    // glass panel (a side bar, a bar, a popup: the compositor blurs what
    // is behind it, std.ui.host.applyBlur).
    card: u32
    glass: u32
    // The seed the palette was made from (0xRRGGBB) and whether it is
    // the dark one.
    seed: u32
    isDark: bool
    // Corner radius of buttons, fields and rows, of small controls, of
    // large surfaces (cards, popups); row height; inner padding of
    // controls; how far a raised surface's shadow reaches (pixels).
    radius: i32
    smallRadius: i32
    largeRadius: i32
    row: i32
    padding: i32
    elevation: i32
    // Pixels a logical pixel (scaled): the widgets' marks and gaps grow
    // with it.
    scale: i32
}

// `theme` with its sizes for `scale` pixels a logical pixel (a screen's
// density, std.ui.host.scale).
pub fn scaled(theme: Theme, scale: i32) -> Theme {
    var result = theme
    const factor = if scale > 0 { scale } else { 1 }
    result.radius = theme.radius * factor
    result.smallRadius = theme.smallRadius * factor
    result.largeRadius = theme.largeRadius * factor
    result.row = theme.row * factor
    result.padding = theme.padding * factor
    result.elevation = theme.elevation * factor
    result.scale = theme.scale * factor
    return result
}

// The default seed: an indigo (0xRRGGBB).
pub const DEFAULT_SEED: u32 = 8154367

// The desktop apps' dark look (the default seed).
pub fn dark() -> Theme { return fromSeed(DEFAULT_SEED, true) }

// A light look from the same seed.
pub fn light() -> Theme { return fromSeed(DEFAULT_SEED, false) }

// ---------------------------------------------------------------------------
// Colour: hue, saturation, lightness (integers: 0..359, 0..100, 0..100)

fn absolute(value: i32) -> i32 { return if value < 0 { 0 - value } else { value } }

fn clampTo(value: i32, low: i32, high: i32) -> i32 {
    if value < low { return low }
    if value > high { return high }
    return value
}

// An opaque colour from hue, saturation and lightness.
pub fn hsl(hue: i32, saturation: i32, lightness: i32) -> u32 {
    var h = hue % 360
    if h < 0 { h += 360 }
    const s = clampTo(saturation, 0, 100) * 10
    const l = clampTo(lightness, 0, 100) * 10
    // Everything in thousandths.
    const chroma = (1000 - absolute(2 * l - 1000)) * s / 1000
    const sector = h / 60
    const within = (h % 60) * 1000 / 60
    const second = chroma * (1000 - absolute(within * 2 - 1000)) / 1000
    var r: i32 = 0
    var g: i32 = 0
    var b: i32 = 0
    if sector == 0 {
        r = chroma
        g = second
    } else if sector == 1 {
        r = second
        g = chroma
    } else if sector == 2 {
        g = chroma
        b = second
    } else if sector == 3 {
        g = second
        b = chroma
    } else if sector == 4 {
        r = second
        b = chroma
    } else {
        r = chroma
        b = second
    }
    const lift = l - chroma / 2
    const red = @intCast(u32, clampTo((r + lift) * 255 / 1000, 0, 255))
    const green = @intCast(u32, clampTo((g + lift) * 255 / 1000, 0, 255))
    const blue = @intCast(u32, clampTo((b + lift) * 255 / 1000, 0, 255))
    return 4278190080 | (red << 16) | (green << 8) | blue
}

// The hue (0..359) and saturation (0..100) of an 0xRRGGBB colour.
pub fn hueOf(rgb: u32) -> i32 {
    const r = @intCast(i32, (rgb >> 16) & 255)
    const g = @intCast(i32, (rgb >> 8) & 255)
    const b = @intCast(i32, rgb & 255)
    const high = if r > g { if r > b { r } else { b } } else { if g > b { g } else { b } }
    const low = if r < g { if r < b { r } else { b } } else { if g < b { g } else { b } }
    const range = high - low
    if range == 0 { return 0 }
    var hue: i32 = 0
    if high == r {
        hue = (g - b) * 60 / range
    } else if high == g {
        hue = 120 + (b - r) * 60 / range
    } else {
        hue = 240 + (r - g) * 60 / range
    }
    if hue < 0 { hue += 360 }
    return hue
}

pub fn saturationOf(rgb: u32) -> i32 {
    const r = @intCast(i32, (rgb >> 16) & 255)
    const g = @intCast(i32, (rgb >> 8) & 255)
    const b = @intCast(i32, rgb & 255)
    const high = if r > g { if r > b { r } else { b } } else { if g > b { g } else { b } }
    const low = if r < g { if r < b { r } else { b } } else { if g < b { g } else { b } }
    if high == low { return 0 }
    const sum = high + low
    const divisor = if sum <= 255 { sum } else { 510 - sum }
    if divisor <= 0 { return 0 }
    return (high - low) * 100 / divisor
}

// An opaque colour at `alpha` (premultiplied).
pub fn withAlpha(rgb: u32, alpha: u32) -> u32 {
    return canvas.color(alpha, (rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255)
}

// ---------------------------------------------------------------------------
// The palette

// The whole palette from `seed` (0xRRGGBB): its hue is the accent; the
// surfaces are near-neutral greys with a trace of it, three clear steps
// apart (the page, a card on it, a control on the card), so depth reads
// from contrast, not from effects. A grey seed gives a neutral palette.
pub fn fromSeed(seed: u32, is_dark: bool) -> Theme {
    const h = hueOf(seed & 16777215)
    const seed_saturation = saturationOf(seed & 16777215)
    const vivid = if seed_saturation < 8 { 0 } else { clampTo(seed_saturation, 60, 85) }
    const tint = if seed_saturation < 8 { 0 } else { if is_dark { 9 } else { 14 } }
    const white: u32 = 4294967295
    if is_dark {
        const accent = hsl(h, vivid, 68)
        return Theme.{
            .background = hsl(h, tint, 7),
            .panel = hsl(h, tint, 10),
            .raised = hsl(h, tint, 22),
            .field = hsl(h, tint, 12),
            .hover = hsl(h, tint, 16),
            .pressed = hsl(h, tint, 24),
            .selected = hsl(h, tint + 14, 20),
            .divider = hsl(h, tint, 17),
            .border = hsl(h, tint, 34),
            .text = hsl(h, tint, 93),
            .dim = hsl(h, tint, 60),
            .disabled = hsl(h, tint, 36),
            .onAccent = white,
            .accent = accent,
            .danger = hsl(355, 80, 64),
            .control = hsl(h, tint, 30),
            .controlInner = hsl(h, tint, 12),
            .button = hsl(h, tint, 19),
            .buttonHover = hsl(h, tint, 25),
            .primary = hsl(h, vivid, 58),
            .primaryHover = hsl(h, vivid, 64),
            .switchOff = hsl(h, tint, 28),
            .switchOffHover = hsl(h, tint, 34),
            .knob = hsl(h, tint, 96),
            .track = hsl(h, tint, 20),
            .thumb = hsl(h, tint, 34),
            .indicator = withAlpha(hsl(h, tint, 80), 120),
            .selection = hsl(h, vivid / 2, 36),
            .caret = hsl(h, tint, 93),
            .shadow = withAlpha(hsl(h, 30, 2), 150),
            .popup = withAlpha(hsl(h, tint, 13), 238),
            .popupBorder = hsl(h, tint, 24),
            .menuHover = hsl(h, tint, 20),
            .menuChosen = hsl(h, vivid / 2, 38),
            .glow = withAlpha(accent, 90),
            .highlight = canvas.color(28, 255, 255, 255),
            .card = hsl(h, tint, 13),
            .glass = withAlpha(hsl(h, tint, 9), 222),
            .seed = seed & 16777215,
            .isDark = true,
            .radius = 8,
            .smallRadius = 4,
            .largeRadius = 12,
            .row = 26,
            .padding = 12,
            .elevation = 12,
            .scale = 1,
        }
    }
    const accent = hsl(h, vivid, 50)
    return Theme.{
        .background = hsl(h, tint, 96),
        .panel = hsl(h, tint, 93),
        .raised = white,
        .field = white,
        .hover = hsl(h, tint, 90),
        .pressed = hsl(h, tint, 85),
        .selected = hsl(h, tint * 3, 90),
        .divider = hsl(h, tint, 88),
        .border = hsl(h, tint, 68),
        .text = hsl(h, tint, 11),
        .dim = hsl(h, tint, 42),
        .disabled = hsl(h, tint, 70),
        .onAccent = white,
        .accent = accent,
        .danger = hsl(355, 70, 50),
        .control = hsl(h, tint, 78),
        .controlInner = white,
        .button = white,
        .buttonHover = hsl(h, tint, 97),
        .primary = hsl(h, vivid, 52),
        .primaryHover = hsl(h, vivid, 58),
        .switchOff = hsl(h, tint, 78),
        .switchOffHover = hsl(h, tint, 74),
        .knob = white,
        .track = hsl(h, tint, 88),
        .thumb = hsl(h, tint, 68),
        .indicator = withAlpha(hsl(h, tint, 40), 130),
        .selection = hsl(h, vivid, 88),
        .caret = hsl(h, tint, 11),
        .shadow = withAlpha(hsl(h, 30, 20), 60),
        .popup = withAlpha(white, 246),
        .popupBorder = hsl(h, tint, 88),
        .menuHover = hsl(h, tint, 93),
        .menuChosen = hsl(h, vivid, 88),
        .glow = withAlpha(accent, 70),
        .highlight = canvas.color(200, 255, 255, 255),
        .card = white,
        .glass = withAlpha(hsl(h, tint, 97), 214),
        .seed = seed & 16777215,
        .isDark = false,
        .radius = 8,
        .smallRadius = 4,
        .largeRadius = 12,
        .row = 26,
        .padding = 12,
        .elevation = 12,
        .scale = 1,
    }
}
