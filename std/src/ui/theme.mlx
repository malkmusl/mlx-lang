// std.ui.theme: the colours and sizes std.ui's widgets draw with. Colours
// are premultiplied ARGB (std.ui.canvas.color); an app keeps one Theme
// (dark() is the desktop apps' look) and may change any field.
const canvas = @import("std.ui.canvas")

pub const Theme = struct {
    // The window and its side panels; a raised surface (a popup, a field).
    background: u32
    panel: u32
    raised: u32
    field: u32
    // Under the pointer, held down, chosen (a selected row).
    hover: u32
    pressed: u32
    selected: u32
    // Lines between parts, outlines.
    divider: u32
    border: u32
    // Text: normal, secondary, disabled, on the accent.
    text: u32
    dim: u32
    disabled: u32
    onAccent: u32
    accent: u32
    danger: u32
    // A control's off state (an empty check box, a switch's track).
    control: u32
    controlInner: u32
    // Buttons: normal and under the pointer; the primary one.
    button: u32
    buttonHover: u32
    primary: u32
    primaryHover: u32
    // A switch's track when off (and under the pointer), its knob.
    switchOff: u32
    switchOffHover: u32
    knob: u32
    // Scroll bars: the track and the thumb.
    track: u32
    thumb: u32
    // A thin scroll indicator over the content.
    indicator: u32
    // Text selection, the caret.
    selection: u32
    caret: u32
    shadow: u32
    // Popups: their surface and outline; a row under the pointer, the
    // row chosen by keys.
    popup: u32
    popupBorder: u32
    menuHover: u32
    menuChosen: u32
    // Corner radius of buttons and rows, of small controls; row height;
    // inner padding of controls.
    radius: i32
    smallRadius: i32
    row: i32
    padding: i32
}

// The desktop apps' dark look (MLX Observatory, mlx-files).
pub fn dark() -> Theme {
    return Theme.{
        .background = canvas.color(255, 26, 28, 36),
        .panel = canvas.color(255, 30, 32, 40),
        .raised = canvas.color(255, 40, 43, 54),
        .field = canvas.color(255, 26, 28, 35),
        .hover = canvas.color(255, 42, 45, 56),
        .pressed = canvas.color(255, 58, 63, 78),
        .selected = canvas.color(255, 50, 54, 66),
        .divider = canvas.color(255, 20, 21, 27),
        .border = canvas.color(255, 96, 101, 118),
        .text = 4293652213,
        .dim = 4287402656,
        .disabled = canvas.color(255, 80, 84, 96),
        .onAccent = canvas.color(255, 255, 255, 255),
        .accent = 4284129535,
        .danger = 4294926190,
        .control = canvas.color(255, 96, 101, 118),
        .controlInner = canvas.color(255, 30, 32, 41),
        .button = canvas.color(255, 52, 56, 68),
        .buttonHover = canvas.color(255, 72, 76, 92),
        .primary = canvas.color(255, 52, 88, 160),
        .primaryHover = canvas.color(255, 70, 110, 190),
        .switchOff = canvas.color(255, 70, 74, 84),
        .switchOffHover = canvas.color(255, 92, 96, 108),
        .knob = canvas.color(255, 245, 246, 250),
        .track = canvas.color(255, 24, 26, 33),
        .thumb = canvas.color(255, 70, 74, 90),
        .indicator = canvas.color(110, 200, 205, 215),
        .selection = 4281223802,
        .caret = 4293652213,
        .shadow = canvas.color(90, 0, 0, 0),
        .popup = canvas.color(250, 32, 34, 43),
        .popupBorder = canvas.color(255, 58, 62, 76),
        .menuHover = canvas.color(255, 46, 49, 60),
        .menuChosen = canvas.color(255, 52, 78, 130),
        .radius = 8,
        .smallRadius = 4,
        .row = 26,
        .padding = 10,
    }
}

// A light look with the same accent.
pub fn light() -> Theme {
    return Theme.{
        .background = canvas.color(255, 246, 246, 248),
        .panel = canvas.color(255, 236, 237, 241),
        .raised = canvas.color(255, 255, 255, 255),
        .field = canvas.color(255, 255, 255, 255),
        .hover = canvas.color(255, 224, 226, 232),
        .pressed = canvas.color(255, 208, 211, 220),
        .selected = canvas.color(255, 214, 224, 248),
        .divider = canvas.color(255, 214, 216, 222),
        .border = canvas.color(255, 150, 154, 166),
        .text = canvas.color(255, 30, 32, 40),
        .dim = canvas.color(255, 104, 108, 120),
        .disabled = canvas.color(255, 170, 173, 182),
        .onAccent = canvas.color(255, 255, 255, 255),
        .accent = 4284129535,
        .danger = canvas.color(255, 210, 50, 60),
        .control = canvas.color(255, 150, 154, 166),
        .controlInner = canvas.color(255, 255, 255, 255),
        .button = canvas.color(255, 226, 228, 234),
        .buttonHover = canvas.color(255, 210, 213, 222),
        .primary = canvas.color(255, 60, 110, 220),
        .primaryHover = canvas.color(255, 80, 130, 235),
        .switchOff = canvas.color(255, 190, 193, 202),
        .switchOffHover = canvas.color(255, 172, 176, 188),
        .knob = canvas.color(255, 255, 255, 255),
        .track = canvas.color(255, 230, 231, 236),
        .thumb = canvas.color(255, 170, 174, 186),
        .indicator = canvas.color(130, 90, 94, 106),
        .selection = canvas.color(255, 190, 210, 250),
        .caret = canvas.color(255, 30, 32, 40),
        .shadow = canvas.color(60, 0, 0, 0),
        .popup = canvas.color(252, 255, 255, 255),
        .popupBorder = canvas.color(255, 210, 213, 222),
        .menuHover = canvas.color(255, 232, 234, 240),
        .menuChosen = canvas.color(255, 200, 216, 248),
        .radius = 8,
        .smallRadius = 4,
        .row = 26,
        .padding = 10,
    }
}
