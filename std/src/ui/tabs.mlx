// std.ui.tabs: a bar of tabs: each with its label, the chosen one lit with
// an accent line, a cross that closes it under the pointer (or a dot when
// it has unsaved changes).
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const glyphs = @import("std.ui.glyphs")
const controls = @import("std.ui.controls")

const Ui = view.Ui

// What happened to a tab.
pub const TAB_NONE: u8 = 0
pub const TAB_CHOSEN: u8 = 1
pub const TAB_CLOSED: u8 = 2

// The bar's background in `area`, a line under it.
pub fn bar(context: *Ui, area: ui.Rect) -> void {
    canvas_module.fillRect(context.*.canvas, area.x, area.y, area.width, area.height, context.*.theme.*.panel)
    canvas_module.fillRect(context.*.canvas, area.x, ui.bottom(area) - 1, area.width, 1, context.*.theme.*.divider)
}

// How wide a tab with `string` is.
pub fn width(context: *Ui, string: []const u8) -> i32 { return text_module.measure(context.*.body, string) + 44 }

// A tab in `area` (the chosen one drawn in `chosen_fill`, the editor's
// background); `close_id` is its cross's id. TAB_CHOSEN when clicked,
// TAB_CLOSED when its cross was.
pub fn tab(context: *Ui, tab_id: u64, close_id: u64, area: ui.Rect, string: []const u8, chosen: bool, edited: bool, chosen_fill: u32) -> u8 {
    const theme = context.*.theme
    const canvas = context.*.canvas
    const close = ui.rect(ui.right(area) - 22, area.y + (area.height - 16) / 2, 16, 16)
    view.region(context, tab_id, area)
    view.region(context, close_id, close)
    const lit = view.isHover(context, tab_id) || view.isHover(context, close_id)
    if chosen {
        canvas_module.fillRect(canvas, area.x, area.y, area.width, area.height, chosen_fill)
        canvas_module.fillRect(canvas, area.x, area.y, area.width, 2, theme.*.accent)
    } else if lit {
        canvas_module.fillRect(canvas, area.x, area.y, area.width, area.height, theme.*.raised)
    }
    controls.label(context, context.*.body, string, area.x + 12, controls.textTop(context.*.body, area.y, area.height), if chosen { theme.*.text } else { theme.*.dim }, 0)
    if view.isHover(context, close_id) || (lit && !edited) {
        glyphs.cross(canvas, close.x + 3, close.y + 2, theme.*.text)
    } else if edited {
        glyphs.dot(canvas, close.x + 4, close.y + 3, 8, theme.*.text)
    }
    if view.takeClick(context, close_id) { return TAB_CLOSED }
    if view.takeClick(context, tab_id) { return TAB_CHOSEN }
    return TAB_NONE
}
