// std.ui.field: a one-line text field: its text, the caret and the
// selection (Field, kept by the app), editing by keys (fieldKey: typing,
// Backspace and Delete, moving by character and word, Home and End, Shift
// selecting, Ctrl+A), and drawing it with a click placing the caret
// (textField).
//
//     var search: field.Field = undefined
//     field.clear(&search)
//     if field.textField(&ui, view.id("search"), area, &search, "Search", true) { ... }
//     // A key while it has the focus:
//     const result = field.fieldKey(&search, key, modifiers, typed)
const ui = @import("std.ui")
const view = @import("std.ui.view")
const keys = @import("std.ui.keys")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const glyphs = @import("std.ui.glyphs")
const controls = @import("std.ui.controls")

const Ui = view.Ui

pub const CAPACITY: usize = 512

pub const Field = struct {
    bytes: [512]u8
    length: usize
    // The caret and the other end of the selection (the same: none), byte
    // offsets on character boundaries.
    cursor: usize
    anchor: usize
    // How far the text is scrolled left to keep the caret in view.
    scroll: i32
}

// What a key did to a field.
pub const KEY_IGNORED: u8 = 0
pub const KEY_EDITED: u8 = 1
pub const KEY_MOVED: u8 = 2
pub const KEY_SUBMIT: u8 = 3
pub const KEY_CANCEL: u8 = 4

pub fn clear(field: *Field) -> void {
    field.*.length = 0
    field.*.cursor = 0
    field.*.anchor = 0
    field.*.scroll = 0
}

fn bytesOf(field: *Field) -> [*]u8 {
    unsafe { return @ptrCast([*]u8, &field.*.bytes) }
}

pub fn text(field: *Field) -> []const u8 { return bytesOf(field)[0..field.*.length] }

// Sets the text (cut at CAPACITY), the caret at its end.
pub fn set(field: *Field, value: []const u8) -> void {
    const bytes = bytesOf(field)
    var length: usize = 0
    while length < value.length && length < CAPACITY {
        bytes[length] = value[length]
        length += 1
    }
    while length > 0 && length < value.length && bytes[length] & 192 == 128 { length -= 1 }
    field.*.length = length
    field.*.cursor = length
    field.*.anchor = length
}

pub fn hasSelection(field: *Field) -> bool { return field.*.cursor != field.*.anchor }

pub fn selectionStart(field: *Field) -> usize { return if field.*.cursor < field.*.anchor { field.*.cursor } else { field.*.anchor } }
pub fn selectionEnd(field: *Field) -> usize { return if field.*.cursor > field.*.anchor { field.*.cursor } else { field.*.anchor } }

pub fn selectAll(field: *Field) -> void {
    field.*.anchor = 0
    field.*.cursor = field.*.length
}

fn previous(field: *Field, at: usize) -> usize {
    var index = at
    if index == 0 { return 0 }
    index -= 1
    while index > 0 && bytesOf(field)[index] & 192 == 128 { index -= 1 }
    return index
}

fn following(field: *Field, at: usize) -> usize {
    var index = at
    if index >= field.*.length { return field.*.length }
    index += 1
    while index < field.*.length && bytesOf(field)[index] & 192 == 128 { index += 1 }
    return index
}

fn isWordByte(byte: u8) -> bool {
    return byte >= 48 && byte <= 57 || byte >= 65 && byte <= 90 || byte >= 97 && byte <= 122 || byte == 95 || byte >= 128
}

fn previousWord(field: *Field, at: usize) -> usize {
    var index = at
    while index > 0 && !isWordByte(bytesOf(field)[index - 1]) { index -= 1 }
    while index > 0 && isWordByte(bytesOf(field)[index - 1]) { index -= 1 }
    return index
}

fn nextWord(field: *Field, at: usize) -> usize {
    var index = at
    while index < field.*.length && !isWordByte(bytesOf(field)[index]) { index += 1 }
    while index < field.*.length && isWordByte(bytesOf(field)[index]) { index += 1 }
    return index
}

// Removes the bytes from `start` to `end`.
fn cut(field: *Field, start: usize, end: usize) -> void {
    const bytes = bytesOf(field)
    var index = start
    while index + (end - start) < field.*.length {
        bytes[index] = bytes[index + end - start]
        index += 1
    }
    field.*.length -= end - start
    field.*.cursor = start
    field.*.anchor = start
}

// Removes the selection; false when there was none.
pub fn deleteSelection(field: *Field) -> bool {
    if !hasSelection(field) { return false }
    cut(field, selectionStart(field), selectionEnd(field))
    return true
}

// Types `typed` at the caret (over the selection); as much as fits.
pub fn insert(field: *Field, typed: []const u8) -> void {
    const removed = deleteSelection(field)
    var count = typed.length
    if field.*.length + count > CAPACITY { count = CAPACITY - field.*.length }
    while count > 0 && count < typed.length && typed[count] & 192 == 128 { count -= 1 }
    const bytes = bytesOf(field)
    var index = field.*.length
    while index > field.*.cursor {
        index -= 1
        bytes[index + count] = bytes[index]
    }
    index = 0
    while index < count {
        bytes[field.*.cursor + index] = typed[index]
        index += 1
    }
    field.*.length += count
    field.*.cursor += count
    field.*.anchor = field.*.cursor
}

fn moveTo(field: *Field, at: usize, extend: bool) -> void {
    field.*.cursor = at
    if !extend { field.*.anchor = at }
}

// A key for the field (Linux key code, std.ui.keys modifiers, the text it
// types): what it did.
pub fn fieldKey(field: *Field, key: u32, modifiers: u32, typed: []const u8) -> u8 {
    const shift = modifiers & keys.SHIFT != 0
    const control = modifiers & keys.CONTROL != 0
    if keys.isEnter(key) { return KEY_SUBMIT }
    if key == keys.ESCAPE { return KEY_CANCEL }
    if key == keys.BACKSPACE {
        if deleteSelection(field) { return KEY_EDITED }
        if field.*.cursor == 0 { return KEY_IGNORED }
        cut(field, if control { previousWord(field, field.*.cursor) } else { previous(field, field.*.cursor) }, field.*.cursor)
        return KEY_EDITED
    }
    if key == keys.DELETE {
        if deleteSelection(field) { return KEY_EDITED }
        if field.*.cursor >= field.*.length { return KEY_IGNORED }
        cut(field, field.*.cursor, if control { nextWord(field, field.*.cursor) } else { following(field, field.*.cursor) })
        return KEY_EDITED
    }
    if key == keys.LEFT {
        if !shift && hasSelection(field) {
            moveTo(field, selectionStart(field), false)
        } else {
            moveTo(field, if control { previousWord(field, field.*.cursor) } else { previous(field, field.*.cursor) }, shift)
        }
        return KEY_MOVED
    }
    if key == keys.RIGHT {
        if !shift && hasSelection(field) {
            moveTo(field, selectionEnd(field), false)
        } else {
            moveTo(field, if control { nextWord(field, field.*.cursor) } else { following(field, field.*.cursor) }, shift)
        }
        return KEY_MOVED
    }
    if key == keys.HOME {
        moveTo(field, 0, shift)
        return KEY_MOVED
    }
    if key == keys.END {
        moveTo(field, field.*.length, shift)
        return KEY_MOVED
    }
    if control && key == keys.A {
        selectAll(field)
        return KEY_MOVED
    }
    if control || modifiers & keys.ALT != 0 && typed.length == 0 { return KEY_IGNORED }
    // Typed text (control characters are not).
    if typed.length == 0 || typed[0] < 32 || typed[0] == 127 { return KEY_IGNORED }
    insert(field, typed)
    return KEY_EDITED
}

// Which typed bytes a field takes (a branch name: no blanks, ...).
pub const Accept = fn(byte: u8) -> bool

// fieldKey taking only the typed bytes `accept` takes.
pub fn fieldKeyAccepting(field: *Field, key: u32, modifiers: u32, typed: []const u8, accept: Accept) -> u8 {
    var kept: [64]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &kept) }
    var length: usize = 0
    for byte in typed {
        if length < 64 && accept(byte) {
            bytes[length] = byte
            length += 1
        }
    }
    if typed.length > 0 && length == 0 { return KEY_IGNORED }
    return fieldKey(field, key, modifiers, bytes[0..length])
}

// The byte offset nearest `x` pixels into the field's text.
pub fn offsetAt(field: *Field, font: *text_module.Text, x: i32) -> usize {
    var best: usize = 0
    var at: usize = 0
    var best_distance: i32 = 2147483647
    while true {
        const width = text_module.measure(font, text(field)[0..at])
        const distance = if width > x { width - x } else { x - width }
        if distance < best_distance {
            best_distance = distance
            best = at
        }
        if at >= field.*.length || width > x { break }
        at = following(field, at)
    }
    return best
}

// The field in `area` (with a magnifier when `search`): its text, the
// placeholder when empty, the selection and a blinking caret while it has
// the focus. A click gives it the focus and places the caret; true when
// it was clicked.
pub fn textField(context: *Ui, field_id: u64, area: ui.Rect, field: *Field, placeholder: []const u8, search: bool) -> bool {
    return notedField(context, field_id, area, field, placeholder, search, "", 0, context.*.theme.*.text)
}

// A text field with `note` small at its right in `note_color` (a count of
// what answers a search) and its text in `text_color` (the danger colour:
// not understood).
pub fn notedField(context: *Ui, field_id: u64, area: ui.Rect, field: *Field, placeholder: []const u8, search: bool, note: []const u8, note_color: u32, text_color: u32) -> bool {
    view.region(context, field_id, area)
    const canvas = context.*.canvas
    const theme = context.*.theme
    const font = context.*.body
    const focused = view.hasFocus(context, field_id)
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.radius, theme.*.field)
    const s = theme.*.scale
    if focused { canvas_module.strokeRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.radius, 2 * s, theme.*.accent) }
    var left = area.x + theme.*.padding
    if search {
        glyphs.magnifierScaled(canvas, left, area.y + (area.height - 13 * s) / 2, theme.*.dim, s)
        left += 20 * s
    }
    var width = ui.right(area) - theme.*.padding - left
    if note.length > 0 {
        const note_width = text_module.measure(context.*.small, note)
        controls.label(context, context.*.small, note, ui.right(area) - theme.*.padding - note_width, controls.textTop(context.*.small, area.y, area.height), note_color, 0)
        width -= note_width + 8 * s
    }
    const top = controls.textTop(font, area.y, area.height)
    // Keep the caret in view; without the focus, the text's start.
    const caret = text_module.measure(font, text(field)[0..field.*.cursor])
    if !focused { field.*.scroll = 0 }
    if focused && caret - field.*.scroll > width - 2 { field.*.scroll = caret - width + 2 }
    if caret < field.*.scroll { field.*.scroll = caret }
    if field.*.scroll < 0 { field.*.scroll = 0 }
    const clicked = view.takeClick(context, field_id)
    if view.isPressed(context, field_id) || clicked {
        view.setFocus(context, field_id)
        if view.isPressed(context, field_id) {
            const at = offsetAt(field, font, context.*.pointerX - left + field.*.scroll)
            const start = offsetAt(field, font, context.*.pressX - left + field.*.scroll)
            field.*.anchor = start
            field.*.cursor = at
        }
    }
    if field.*.length == 0 {
        controls.label(context, font, placeholder, left, top, theme.*.dim, width)
    } else {
        if hasSelection(field) && focused {
            const from = text_module.measure(font, text(field)[0..selectionStart(field)]) - field.*.scroll
            const to = text_module.measure(font, text(field)[0..selectionEnd(field)]) - field.*.scroll
            const x0 = if from < 0 { 0 } else { from }
            const x1 = if to > width { width } else { to }
            if x1 > x0 { canvas_module.fillRect(canvas, left + x0, area.y + 5 * s, x1 - x0, area.height - 10 * s, theme.*.selection) }
        }
        drawClipped(context, font, text(field), left, top, field.*.scroll, width, text_color)
    }
    // The caret: on for half a second, off for the next.
    if focused && context.*.time % 1000 < 500 {
        canvas_module.fillRect(canvas, left + caret - field.*.scroll, area.y + 6 * s, 2 * s, area.height - 12 * s, theme.*.caret)
    }
    return clicked
}

// `string` drawn from `scroll` pixels into it, `width` wide at x.
fn drawClipped(context: *Ui, font: *text_module.Text, string: []const u8, x: i32, y: i32, scroll: i32, width: i32, color: u32) -> void {
    // Skip the characters scrolled out (a cut one too: it would reach
    // left of x), then draw up to the width.
    var start: usize = 0
    var skipped: i32 = 0
    while start < string.length && skipped < scroll {
        var next = start + 1
        while next < string.length && string[next] & 192 == 128 { next += 1 }
        skipped = text_module.measure(font, string[0..next])
        start = next
    }
    text_module.drawText(context.*.canvas, font, string[start..string.length], x + skipped - scroll, y, color, width - (skipped - scroll))
}
