// The primary selection (part of panel.mlx, split from it): the text last
// selected, which a middle click pastes, through
// zwp_primary_selection_device_v1. A client sets it to its text
// (setPrimary), which the panel serves as UTF-8 text to whoever reads it;
// another client's comes as an offer whose text types are noted, and
// readPrimary takes its text through a pipe (panel_clipboard.readPipe).
const std = @import("std")
const wl = @import("std.wayland")
const panel_module = @import("./panel.mlx")
const panel_drag_module = @import("./panel_drag.mlx")
const panel_clipboard_module = @import("./panel_clipboard.mlx")

// The text types, best first (a bit each in primaryTypes).
const TYPE_COUNT: usize = 5

fn typeName(index: usize) -> []const u8 {
    if index == 0 { return "text/plain;charset=utf-8" }
    if index == 1 { return "UTF8_STRING" }
    if index == 2 { return "text/plain" }
    if index == 3 { return "TEXT" }
    return "STRING"
}

fn typeBit(mime: []const u8) -> u32 {
    var index: usize = 0
    while index < TYPE_COUNT {
        if std.text.same(typeName(index), mime) { return @intCast(u32, 1) << @intCast(u5, index) }
        index += 1
    }
    return 0
}

// Asks for the device once the seat is there (open).
pub fn start(panel: *panel_module.Panel) -> void {
    if !panel.*.hasPrimaryManager || !panel.*.hasSeat { return }
    panel.*.primaryDevice = panel.*.primaryManager.getDevice(panel.*.seat)
    panel.*.primaryDevice.setHandler(onDevice, panel_module.contextOf(panel))
    panel.*.hasPrimaryDevice = true
}

fn forgetSelection(panel: *panel_module.Panel) -> void {
    if !panel.*.hasPrimaryOffer { return }
    panel.*.primaryOffer.destroy()
    panel.*.hasPrimaryOffer = false
    panel.*.primaryTypes = 0
}

// The device's events: an offer to come (its types follow on it), and
// which offer is the selection now (or none).
pub fn onDevice(context: *anyopaque, event: wl.client.Event) -> void {
    const panel = panel_module.panelOf(context)
    const decoded = wl.zwp_primary_selection_device_v1.decodeEvent(event)
    if event.opcode == wl.zwp_primary_selection_device_v1.EVENT_DATA_OFFER {
        if panel.*.hasPrimaryLastOffer { panel.*.primaryLastOffer.destroy() }
        panel.*.primaryLastOffer = decoded.data_offer.offer
        panel.*.primaryLastOffer.setHandler(onOffer, context)
        panel.*.hasPrimaryLastOffer = true
        panel.*.primaryLastTypes = 0
    } else if event.opcode == wl.zwp_primary_selection_device_v1.EVENT_SELECTION {
        forgetSelection(panel)
        const offer = decoded.selection.id
        if offer.isNull() || !panel.*.hasPrimaryLastOffer || offer.id() != panel.*.primaryLastOffer.id() { return }
        panel.*.primaryOffer = panel.*.primaryLastOffer
        panel.*.hasPrimaryOffer = true
        panel.*.primaryTypes = panel.*.primaryLastTypes
        panel.*.hasPrimaryLastOffer = false
    }
}

fn onOffer(context: *anyopaque, event: wl.client.Event) -> void {
    const panel = panel_module.panelOf(context)
    if event.opcode != wl.zwp_primary_selection_offer_v1.EVENT_OFFER { return }
    if !panel.*.hasPrimaryLastOffer || event.object.id != panel.*.primaryLastOffer.id() { return }
    const mime = wl.zwp_primary_selection_offer_v1.decodeEvent(event).offer.mime_type
    panel.*.primaryLastTypes |= typeBit(mime.pointer[0..mime.length])
}

fn dropSource(panel: *panel_module.Panel) -> void {
    if !panel.*.hasPrimarySource { return }
    panel.*.primarySource.destroy()
    panel.*.hasPrimarySource = false
}

fn onSource(context: *anyopaque, event: wl.client.Event) -> void {
    const panel = panel_module.panelOf(context)
    const ours = panel.*.hasPrimarySource && event.object.id == panel.*.primarySource.id()
    const decoded = wl.zwp_primary_selection_source_v1.decodeEvent(event)
    if event.opcode == wl.zwp_primary_selection_source_v1.EVENT_SEND {
        const descriptor = decoded.send.fd.descriptor
        if ours { panel_clipboard_module.writeAll(descriptor, panel.*.primaryText[0..panel.*.primaryLength]) }
        panel_drag_module.closeDescriptor(descriptor)
    } else if event.opcode == wl.zwp_primary_selection_source_v1.EVENT_CANCELLED {
        // Another client's selection replaced it.
        if ours { dropSource(panel) }
    }
}

// Makes `text` the primary selection (named by the last key or button
// press). False without the protocol, or without memory for the text.
pub fn setPrimary(panel: *panel_module.Panel, text: []const u8) -> bool {
    if !panel.*.hasPrimaryDevice || text.length == 0 { return false }
    if text.length > panel.*.primaryCapacity {
        var capacity = if panel.*.primaryCapacity == 0 { 4096 } else { panel.*.primaryCapacity }
        while capacity < text.length { capacity *= 2 }
        const memory = panel.*.allocator.alloc(capacity, 16)
        if memory == null { return false }
        if panel.*.primaryCapacity > 0 { panel.*.allocator.free(panel.*.primaryText, panel.*.primaryCapacity, 16) }
        unsafe { panel.*.primaryText = @ptrCast([*]u8, memory.?) }
        panel.*.primaryCapacity = capacity
    }
    var index: usize = 0
    while index < text.length {
        panel.*.primaryText[index] = text[index]
        index += 1
    }
    panel.*.primaryLength = text.length
    dropSource(panel)
    const source = panel.*.primaryManager.createSource()
    source.setHandler(onSource, panel_module.contextOf(panel))
    index = 0
    while index < TYPE_COUNT {
        source.offer(typeName(index))
        index += 1
    }
    panel.*.primarySource = source
    panel.*.hasPrimarySource = true
    panel.*.primaryDevice.setSelection(&source, panel.*.inputSerial)
    return true
}

// The primary selection's text ("" when there is none), valid until the
// next read of it or of the clipboard: this client's own, else read from
// the client that set it in the best text type it offers.
pub fn readPrimary(panel: *panel_module.Panel) -> []const u8 {
    if panel.*.hasPrimarySource { return panel.*.primaryText[0..panel.*.primaryLength] }
    if !panel.*.hasPrimaryOffer || panel.*.primaryTypes == 0 { return "" }
    var index: usize = 0
    while (panel.*.primaryTypes >> @intCast(u5, index)) & 1 == 0 { index += 1 }
    var reader: isize = -1
    var writer: isize = -1
    if !panel_clipboard_module.openPipe(&reader, &writer) { return "" }
    panel.*.primaryOffer.receive(typeName(index), wl.Handle.fromDescriptor(writer))
    return panel_clipboard_module.readPipe(panel, reader, writer)
}

// Lets go of the text and the source (close).
pub fn release(panel: *panel_module.Panel) -> void {
    dropSource(panel)
    forgetSelection(panel)
    if panel.*.hasPrimaryLastOffer {
        panel.*.primaryLastOffer.destroy()
        panel.*.hasPrimaryLastOffer = false
    }
    if panel.*.primaryCapacity > 0 { panel.*.allocator.free(panel.*.primaryText, panel.*.primaryCapacity, 16) }
    panel.*.primaryCapacity = 0
}
