// Linux evdev key codes (as carried by wl_keyboard.key) to the bytes a
// terminal sends, for a US keyboard layout. Modifier state is tracked from
// the key codes themselves, so no keymap compiler is needed.

pub const KEY_ESC: u32 = 1
pub const KEY_BACKSPACE: u32 = 14
pub const KEY_TAB: u32 = 15
pub const KEY_ENTER: u32 = 28
pub const KEY_LEFTCTRL: u32 = 29
pub const KEY_LEFTSHIFT: u32 = 42
pub const KEY_RIGHTSHIFT: u32 = 54
pub const KEY_LEFTALT: u32 = 56
pub const KEY_CAPSLOCK: u32 = 58
pub const KEY_KPENTER: u32 = 96
pub const KEY_RIGHTCTRL: u32 = 97
pub const KEY_RIGHTALT: u32 = 100
pub const KEY_HOME: u32 = 102
pub const KEY_UP: u32 = 103
pub const KEY_LEFT: u32 = 105
pub const KEY_RIGHT: u32 = 106
pub const KEY_END: u32 = 107
pub const KEY_DOWN: u32 = 108
pub const KEY_DELETE: u32 = 111

pub fn isModifier(key: u32) -> bool {
    return key == KEY_LEFTCTRL || key == KEY_RIGHTCTRL || key == KEY_LEFTSHIFT || key == KEY_RIGHTSHIFT || key == KEY_LEFTALT || key == KEY_RIGHTALT || key == KEY_CAPSLOCK
}

fn letter(key: u32) -> u8 {
    return match key {
        16 => 113, 17 => 119, 18 => 101, 19 => 114, 20 => 116, 21 => 121, 22 => 117, 23 => 105, 24 => 111, 25 => 112,
        30 => 97, 31 => 115, 32 => 100, 33 => 102, 34 => 103, 35 => 104, 36 => 106, 37 => 107, 38 => 108,
        44 => 122, 45 => 120, 46 => 99, 47 => 118, 48 => 98, 49 => 110, 50 => 109,
        else => 0
    }
}

fn plain(key: u32) -> u8 {
    return match key {
        2 => 49, 3 => 50, 4 => 51, 5 => 52, 6 => 53, 7 => 54, 8 => 55, 9 => 56, 10 => 57, 11 => 48,
        12 => 45, 13 => 61, 26 => 91, 27 => 93, 39 => 59, 40 => 39, 41 => 96, 43 => 92,
        51 => 44, 52 => 46, 53 => 47, 57 => 32,
        else => 0
    }
}

fn shifted(key: u32) -> u8 {
    return match key {
        2 => 33, 3 => 64, 4 => 35, 5 => 36, 6 => 37, 7 => 94, 8 => 38, 9 => 42, 10 => 40, 11 => 41,
        12 => 95, 13 => 43, 26 => 123, 27 => 125, 39 => 58, 40 => 34, 41 => 126, 43 => 124,
        51 => 60, 52 => 62, 53 => 63, 57 => 32,
        else => 0
    }
}

// Writes the bytes for `key` into `out` (capacity 4) and returns how many.
pub fn encode(key: u32, shift: bool, control: bool, caps: bool, out: [*]u8) -> usize {
    if key == KEY_ENTER || key == KEY_KPENTER {
        out[0] = 13
        return 1
    }
    if key == KEY_BACKSPACE {
        out[0] = 127
        return 1
    }
    if key == KEY_TAB {
        out[0] = 9
        return 1
    }
    if key == KEY_ESC {
        out[0] = 27
        return 1
    }
    var arrow: u8 = 0
    if key == KEY_UP { arrow = 65 }
    if key == KEY_DOWN { arrow = 66 }
    if key == KEY_RIGHT { arrow = 67 }
    if key == KEY_LEFT { arrow = 68 }
    if key == KEY_HOME { arrow = 72 }
    if key == KEY_END { arrow = 70 }
    if arrow != 0 {
        out[0] = 27
        out[1] = 91
        out[2] = arrow
        return 3
    }
    if key == KEY_DELETE {
        out[0] = 27
        out[1] = 91
        out[2] = 51
        out[3] = 126
        return 4
    }
    const base = letter(key)
    if base != 0 {
        if control {
            out[0] = base - 96
            return 1
        }
        const upper = shift != caps
        out[0] = if upper { base - 32 } else { base }
        return 1
    }
    const symbol = if shift { shifted(key) } else { plain(key) }
    if symbol == 0 { return 0 }
    if control && symbol == 32 {
        out[0] = 0
        return 1
    }
    out[0] = symbol
    return 1
}
