// Popup menus (part of panel.mlx, split from it).
const wl = @import("std.wayland")
const panel_module = @import("./panel.mlx")

// ---------------------------------------------------------------------------
// Popup menus

fn onMenuXdgSurface(context: *anyopaque, event: wl.client.Event) -> void {
    const panel = panel_module.panelOf(context)
    if !panel.*.menuOpen { return }
    const decoded = wl.xdg_surface.decodeEvent(event)
    panel.*.menuXdgSurface.ackConfigure(decoded.configure.serial)
    panel.*.menuConfigured = true
    panel.*.menuDirty = true
}

// The compositor is done with a buffer: it may be drawn into again.
fn onMenuBuffer(context: *anyopaque, event: wl.client.Event) -> void {
    const panel = panel_module.panelOf(context)
    if !panel.*.menuOpen { return }
    if event.object.id == panel.*.menuBuffers[0].id() { panel.*.menuBusy[0] = false }
    if event.object.id == panel.*.menuBuffers[1].id() { panel.*.menuBusy[1] = false }
}

fn onMenuPopup(context: *anyopaque, event: wl.client.Event) -> void {
    const panel = panel_module.panelOf(context)
    if event.opcode == wl.xdg_popup.EVENT_POPUP_DONE {
        closeMenu(panel)
        panel.*.event(panel.*.context, panel_module.EVENT_MENU_CLOSED, 0, 0)
    }
}

// Opens a menu `width` x `height` next to the rectangle (x, y, anchor_width,
// anchor_height) of the surface: `place` (PLACE_*) says on which side.
// `draw` paints it (on the CPU) now and after each redrawMenu. An open
// menu goes first. False without xdg-shell.
pub fn openMenu(panel: *panel_module.Panel, x: i32, y: i32, anchor_width: i32, anchor_height: i32, place: u32, width: u32, height: u32, draw: panel_module.Draw) -> bool {
    closeMenu(panel)
    if !panel.*.hasWmBase || !panel.*.hasSurface || width == 0 || height == 0 { return false }
    // Two buffers: the compositor may still be reading the one shown
    // while the next is drawn.
    var memory: wl.SharedMemory = undefined
    const size = @intCast(usize, width) * @intCast(usize, height) * 4
    if !wl.transport.createSharedMemory(&memory, 2 * size) { return false }
    panel.*.menuMemory = memory
    panel.*.menuPool = panel.*.shm.createPool(memory.handle, @intCast(i32, 2 * size))
    var slot: usize = 0
    while slot < 2 {
        panel.*.menuBuffers[slot] = panel.*.menuPool.createBuffer(@intCast(i32, slot * size), @intCast(i32, width), @intCast(i32, height), @intCast(i32, width * 4), @intFromEnum(wl.wl_shm.Format.argb8888))
        panel.*.menuBuffers[slot].setHandler(onMenuBuffer, panel_module.contextOf(panel))
        panel.*.menuBusy[slot] = false
        slot += 1
    }
    panel.*.menuWidth = @intCast(usize, width)
    panel.*.menuHeight = @intCast(usize, height)
    panel.*.menuDraw = draw
    panel.*.menuConfigured = false
    panel.*.menuDirty = true
    panel.*.pointerOnMenu = false
    const positioner = panel.*.wmBase.createPositioner()
    positioner.setSize(@intCast(i32, width), @intCast(i32, height))
    positioner.setAnchorRect(x, y, if anchor_width > 0 { anchor_width } else { 1 }, if anchor_height > 0 { anchor_height } else { 1 })
    positioner.setAnchor(place)
    positioner.setGravity(place)
    panel.*.menuSurface = panel.*.compositor.createSurface()
    panel.*.menuXdgSurface = panel.*.wmBase.getXdgSurface(panel.*.menuSurface)
    panel.*.menuXdgSurface.setHandler(onMenuXdgSurface, panel_module.contextOf(panel))
    if panel.*.isWindow {
        const parent = panel.*.xdgSurface
        panel.*.menuPopup = panel.*.menuXdgSurface.getPopup(&parent, positioner)
    } else {
        panel.*.menuPopup = panel.*.menuXdgSurface.getPopup(null, positioner)
        panel.*.layerSurface.getPopup(panel.*.menuPopup)
    }
    panel.*.menuPopup.setHandler(onMenuPopup, panel_module.contextOf(panel))
    positioner.destroy()
    if panel.*.hasSeat && panel.*.buttonSerial != 0 { panel.*.menuPopup.grab(panel.*.seat, panel.*.buttonSerial) }
    panel.*.menuOpen = true
    panel.*.menuSurface.commit()
    return true
}

// Draws the menu again (with the next turn), into a buffer the
// compositor does not hold (later, when it holds both).
pub fn redrawMenu(panel: *panel_module.Panel) -> void {
    if !panel.*.menuOpen || !panel.*.menuConfigured || !panel.*.menuDirty { return }
    var slot: usize = 0
    if panel.*.menuBusy[0] {
        if panel.*.menuBusy[1] { return }
        slot = 1
    }
    panel.*.menuDirty = false
    var pixels: [*]u32 = undefined
    unsafe { pixels = @ptrFromInt([*]u32, panel.*.menuMemory.address + slot * panel.*.menuWidth * panel.*.menuHeight * 4) }
    var canvas = panel_module.Canvas.{ .pixels = pixels, .width = panel.*.menuWidth, .height = panel.*.menuHeight, .stride = panel.*.menuWidth, .swapRedBlue = false, .device = 0, .opacity = 255 }
    panel.*.menuDraw(panel.*.context, &canvas)
    const buffer = panel.*.menuBuffers[slot]
    panel.*.menuBusy[slot] = true
    panel.*.menuSurface.attach(&buffer, 0, 0)
    panel.*.menuSurface.damage(0, 0, @intCast(i32, panel.*.menuWidth), @intCast(i32, panel.*.menuHeight))
    panel.*.menuSurface.commit()
}

// Asks for the menu to be drawn again.
pub fn menuChanged(panel: *panel_module.Panel) -> void { panel.*.menuDirty = true }

pub fn closeMenu(panel: *panel_module.Panel) -> void {
    if !panel.*.menuOpen { return }
    panel.*.menuOpen = false
    panel.*.pointerOnMenu = false
    panel.*.menuPopup.destroy()
    panel.*.menuXdgSurface.destroy()
    panel.*.menuSurface.destroy()
    panel.*.menuBuffers[0].destroy()
    panel.*.menuBuffers[1].destroy()
    panel.*.menuPool.destroy()
    panel.*.menuMemory.release()
}
