// What a frame changed (part of panel.mlx, split from it). The compositor
// is told the rectangle in which a frame differs from the one before
// (wl_surface.damage), so it takes and composes that part and not the
// whole surface: a clock's digits, an icon under the pointer, a terminal's
// one cell.
//
// A client says it in one of two ways, or not at all:
// - it draws every frame whole and says nothing: the frame is then
//   compared with the one before, which the other of the two buffers still
//   holds, and the rectangle that differs is the damage (a frame that
//   differs nowhere is still given, with one pixel of damage, so that its
//   frame callback comes as ever);
// - it keeps its frames (keepFrames): the canvas a draw gets holds the
//   frame drawn before (`kept` says so), the client draws only what
//   changed and names it (damage), or says that nothing did (unchanged:
//   then nothing is given to the compositor at all, unless a configure it
//   acknowledged still waits for its commit).
//
// With MLX_FRAMES_SAY set (and not 0) each frame is said in a line on the
// program's errors, for whoever measures or checks:
//
//     frame: org.mlx.terminal 652x396 drawn in 153 us, changed 8x16 at 110,22
//     frame: horizon 1280x30 drawn in 310 us, changed all
//     frame: orbit 494x150 drawn in 420 us, changed nothing
const std = @import("std")
const panel_module = @import("./panel.mlx")

const Panel = panel_module.Panel

// What a frame changed: all of it; a rectangle the client named or the
// comparison found; nothing the comparison found (given all the same);
// nothing, said by the client (not given).
pub const ALL: u8 = 0
pub const NAMED: u8 = 1
pub const PART: u8 = 2
pub const SAME: u8 = 3
pub const NOTHING: u8 = 4

// The name a panel's frames are said under.
pub fn name(panel: *Panel, text: []const u8) -> void {
    var length: usize = 0
    while length < text.length && length < 48 {
        // (One word: a title's blanks would break the line's fields.)
        panel.*.frameName[length] = if text[length] <= 32 { 95 } else { text[length] }
        length += 1
    }
    panel.*.frameNameLength = length
}

// The buffers are new: no slot holds a frame.
pub fn forget(panel: *Panel) -> void {
    panel.*.keptSlot = -1
    panel.*.kept = false
    panel.*.staleAll[0] = true
    panel.*.staleAll[1] = true
}

// The slot the next frame is drawn into; -1 while the compositor holds
// both. A client that keeps its frames draws into the slot that holds the
// last one when it is free (nothing has to be brought up to date); any
// other client into the other slot, so that the last frame is still there
// to compare the new one with.
pub fn pickSlot(panel: *Panel) -> isize {
    var first: usize = 0
    if panel.*.keptSlot >= 0 && panel.*.frames == panel_module.FRAMES_CPU {
        first = @intCast(usize, panel.*.keptSlot)
        if !panel.*.keepsFrames { first = 1 - first }
    }
    if !panel.*.busy[first] { return @intCast(isize, first) }
    if !panel.*.busy[1 - first] { return @intCast(isize, 1 - first) }
    return -1
}

// Slot `slot`'s stale rectangle: four numbers of `stale`.
fn staleOf(panel: *Panel, slot: usize) -> [*]i32 {
    unsafe { return @ptrFromInt([*]i32, @intFromPtr(&panel.*.stale) + slot * 16) }
}

// Before a client that keeps its frames draws into `slot`: the slot is
// made to hold the frame drawn last (what was drawn since this slot was
// drawn into is copied from the slot that has it), and `kept` says whether
// it does now.
pub fn bringUp(panel: *Panel, slot: usize) -> void {
    panel.*.kept = false
    if !panel.*.keepsFrames || panel.*.keptSlot < 0 { return }
    const last = @intCast(usize, panel.*.keptSlot)
    if slot != last {
        const width = panel.*.width
        var left: usize = 0
        var top: usize = 0
        var columns = width
        var rows = panel.*.height
        if !panel.*.staleAll[slot] {
            const rect = staleOf(panel, slot)
            left = @intCast(usize, rect[0])
            top = @intCast(usize, rect[1])
            columns = @intCast(usize, rect[2])
            rows = @intCast(usize, rect[3])
        }
        const to = panel_module.slotAddress(panel, slot)
        const from = panel_module.slotAddress(panel, last)
        var row: usize = 0
        while row < rows && columns > 0 {
            const at = ((top + row) * width + left) * 4
            unsafe { std.mem.copy(@ptrFromInt([*]u8, to + at), @ptrFromInt([*]const u8, from + at), columns * 4) }
            row += 1
        }
        panel.*.staleAll[slot] = false
        staleOf(panel, slot)[2] = 0
        staleOf(panel, slot)[3] = 0
    }
    panel.*.kept = true
}

// The first of `count` pixels at `left` that is not the one at `right`;
// `count` when all are the same. Two pixels to a 64-bit word, four words
// at a time while they are the same.
fn firstOther(left: usize, right: usize, count: usize) -> usize {
    var a: [*]const u64 = undefined
    var b: [*]const u64 = undefined
    unsafe {
        a = @ptrFromInt([*]const u64, left)
        b = @ptrFromInt([*]const u64, right)
    }
    const pairs = count / 2
    var pair: usize = 0
    while pair + 4 <= pairs && ((a[pair] ^ b[pair]) | (a[pair + 1] ^ b[pair + 1]) | (a[pair + 2] ^ b[pair + 2]) | (a[pair + 3] ^ b[pair + 3])) == 0 { pair += 4 }
    while pair < pairs {
        const other = a[pair] ^ b[pair]
        if other != 0 { return if other & 0xFFFFFFFF != 0 { pair * 2 } else { pair * 2 + 1 } }
        pair += 1
    }
    if count % 2 != 0 {
        var one: [*]const u32 = undefined
        var two: [*]const u32 = undefined
        unsafe {
            one = @ptrFromInt([*]const u32, left)
            two = @ptrFromInt([*]const u32, right)
        }
        if one[count - 1] != two[count - 1] { return count - 1 }
    }
    return count
}

// The last of `count` pixels at `left` that is not the one at `right`
// (there is one: firstOther found it).
fn lastOther(left: usize, right: usize, count: usize) -> usize {
    var a: [*]const u32 = undefined
    var b: [*]const u32 = undefined
    unsafe {
        a = @ptrFromInt([*]const u32, left)
        b = @ptrFromInt([*]const u32, right)
    }
    var at = count
    while at > 1 && a[at - 1] == b[at - 1] { at -= 1 }
    return at - 1
}

// The rectangle in which slot `slot`'s pixels are not those of the frame
// given last (in the slot `keptSlot`), into `rect` (x, y, width, height);
// false when they are the same everywhere.
pub fn differing(panel: *Panel, slot: usize, rect: *[4]i32) -> bool {
    const width = panel.*.width
    const height = panel.*.height
    const now = panel_module.slotAddress(panel, slot)
    const before = panel_module.slotAddress(panel, @intCast(usize, panel.*.keptSlot))
    var left = width
    var right: usize = 0
    var top = height
    var bottom: usize = 0
    var row: usize = 0
    while row < height {
        const at = row * width * 4
        const first = firstOther(now + at, before + at, width)
        if first < width {
            const last = lastOther(now + at, before + at, width)
            if first < left { left = first }
            if last + 1 > right { right = last + 1 }
            if row < top { top = row }
            bottom = row + 1
        }
        row += 1
    }
    if bottom == 0 { return false }
    rect.*[0] = @intCast(i32, left)
    rect.*[1] = @intCast(i32, top)
    rect.*[2] = @intCast(i32, right - left)
    rect.*[3] = @intCast(i32, bottom - top)
    return true
}

// After the draw into `slot` (on the CPU): what of the frame the
// compositor is told changed (ALL, NAMED, PART, SAME or NOTHING), and into
// `rect` the rectangle that holds it (the surface's part of what the
// client named; what the comparison found; one pixel for SAME).
pub fn changed(panel: *Panel, slot: usize, rect: *[4]i32) -> u8 {
    const width = @intCast(i32, panel.*.width)
    const height = @intCast(i32, panel.*.height)
    rect.*[0] = 0
    rect.*[1] = 0
    rect.*[2] = width
    rect.*[3] = height
    if panel.*.keptSlot < 0 || panel.*.damageAll { return ALL }
    if panel.*.damageNone { return NOTHING }
    if panel.*.damageCount > 0 {
        // What the client named, as one rectangle on the surface.
        var left = width
        var top = height
        var right: i32 = 0
        var bottom: i32 = 0
        var index: usize = 0
        while index < panel.*.damageCount {
            const x = panel.*.damageRects[index * 4]
            const y = panel.*.damageRects[index * 4 + 1]
            if x < left { left = x }
            if y < top { top = y }
            if x + panel.*.damageRects[index * 4 + 2] > right { right = x + panel.*.damageRects[index * 4 + 2] }
            if y + panel.*.damageRects[index * 4 + 3] > bottom { bottom = y + panel.*.damageRects[index * 4 + 3] }
            index += 1
        }
        if left < 0 { left = 0 }
        if top < 0 { top = 0 }
        if right > width { right = width }
        if bottom > height { bottom = height }
        rect.*[0] = left
        rect.*[1] = top
        rect.*[2] = if right > left { right - left } else { 0 }
        rect.*[3] = if bottom > top { bottom - top } else { 0 }
        return NAMED
    }
    // Nothing named: compared with the frame before, where the other slot
    // still holds it.
    if @intCast(usize, panel.*.keptSlot) == slot { return ALL }
    if differing(panel, slot, rect) { return PART }
    rect.*[0] = 0
    rect.*[1] = 0
    rect.*[2] = 1
    rect.*[3] = 1
    return SAME
}

// The frame in `slot` was given to the compositor with `rect` changed
// (`change` ALL: all of it): the slot holds the last frame now, and the
// other one is behind by that much more.
pub fn given(panel: *Panel, slot: usize, change: u8, rect: *const [4]i32) -> void {
    const other = 1 - slot
    if change == ALL || panel.*.keptSlot < 0 {
        panel.*.staleAll[other] = true
    } else if !panel.*.staleAll[other] && rect.*[2] > 0 && rect.*[3] > 0 {
        const stale = staleOf(panel, other)
        if stale[2] <= 0 || stale[3] <= 0 {
            stale[0] = rect.*[0]
            stale[1] = rect.*[1]
            stale[2] = rect.*[2]
            stale[3] = rect.*[3]
        } else {
            const right = if stale[0] + stale[2] > rect.*[0] + rect.*[2] { stale[0] + stale[2] } else { rect.*[0] + rect.*[2] }
            const bottom = if stale[1] + stale[3] > rect.*[1] + rect.*[3] { stale[1] + stale[3] } else { rect.*[1] + rect.*[3] }
            if rect.*[0] < stale[0] { stale[0] = rect.*[0] }
            if rect.*[1] < stale[1] { stale[1] = rect.*[1] }
            stale[2] = right - stale[0]
            stale[3] = bottom - stale[1]
        }
    }
    panel.*.staleAll[slot] = false
    staleOf(panel, slot)[2] = 0
    staleOf(panel, slot)[3] = 0
    panel.*.keptSlot = @intCast(isize, slot)
}

// MLX_FRAMES_SAY: the frame just drawn in a line on the errors: whose, how
// large, how long the draw took, what of it the compositor is told
// changed.
pub fn say(panel: *Panel, microseconds: usize, change: u8, rect: *const [4]i32) -> void {
    var line: [200]u8 = undefined
    const bytes: [*]u8 = &line
    const own: [*]const u8 = &panel.*.frameName
    var length = std.text.append(bytes, 0, 200, "frame: ")
    length = std.text.append(bytes, length, 200, if panel.*.frameNameLength > 0 { own[0..panel.*.frameNameLength] } else { "panel" })
    length = std.text.append(bytes, length, 200, " ")
    length = std.text.appendUnsigned(bytes, length, 200, panel.*.width)
    length = std.text.append(bytes, length, 200, "x")
    length = std.text.appendUnsigned(bytes, length, 200, panel.*.height)
    length = std.text.append(bytes, length, 200, " drawn in ")
    length = std.text.appendUnsigned(bytes, length, 200, microseconds)
    length = std.text.append(bytes, length, 200, " us, changed ")
    if change == ALL {
        length = std.text.append(bytes, length, 200, "all")
    } else if change == SAME || change == NOTHING || rect.*[2] <= 0 || rect.*[3] <= 0 {
        length = std.text.append(bytes, length, 200, "nothing")
    } else {
        length = std.text.appendUnsigned(bytes, length, 200, @intCast(usize, rect.*[2]))
        length = std.text.append(bytes, length, 200, "x")
        length = std.text.appendUnsigned(bytes, length, 200, @intCast(usize, rect.*[3]))
        length = std.text.append(bytes, length, 200, " at ")
        length = std.text.appendUnsigned(bytes, length, 200, @intCast(usize, rect.*[0]))
        length = std.text.append(bytes, length, 200, ",")
        length = std.text.appendUnsigned(bytes, length, 200, @intCast(usize, rect.*[1]))
    }
    length = std.text.append(bytes, length, 200, "\n")
    _ = std.io.writeAll(std.io.stderr(), bytes[0..length])
}
