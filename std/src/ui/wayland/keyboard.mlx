// Keyboard text for clients: the compositor's keymap (wl_keyboard.keymap)
// read with std.xkb, so any layout types what its keys say (a German
// keyboard types ä and z where it should); without one (none sent yet, or
// one std.xkb cannot read), a US layout (us_layout.mlx) with Shift and
// Caps Lock taken from the modifiers.
const std = @import("std")
const wl = @import("std.wayland")
const xkb = @import("std.xkb")
const xkb_parse = @import("std.xkb.parse")
const keysym = @import("std.xkb.keysym")
const xkb_state = @import("std.xkb.state")
const us = @import("./us_layout.mlx")

pub const Keyboard = struct {
    allocator: std.allocator.Allocator
    names: keysym.Names
    hasNames: bool
    // The keymap (*xkb.Keymap; 0 before the first) and whether it was read.
    keymap: usize
    valid: bool
    state: xkb_state.State
    depressed: u32
    latched: u32
    locked: u32
    group: u32
    // The keymap's real modifiers for Alt and the third level (AltGr).
    altMask: u32
    levelThreeMask: u32
    // The last text came from the third level (AltGr, or Ctrl+Alt standing
    // in for it): it is typed, not a shortcut, though Ctrl or Alt is held.
    levelThree: bool
}

pub fn init(keyboard: *Keyboard, allocator: std.allocator.Allocator) -> void {
    keyboard.*.allocator = allocator
    keyboard.*.hasNames = false
    keyboard.*.keymap = 0
    keyboard.*.valid = false
    keyboard.*.depressed = 0
    keyboard.*.latched = 0
    keyboard.*.locked = 0
    keyboard.*.group = 0
    keyboard.*.altMask = xkb.MOD1
    keyboard.*.levelThreeMask = xkb.MOD5
    keyboard.*.levelThree = false
}

fn keymapOf(keyboard: *Keyboard) -> *xkb.Keymap {
    unsafe { return @ptrFromInt(*xkb.Keymap, keyboard.*.keymap) }
}

fn namesOf(keyboard: *Keyboard) -> *keysym.Names {
    unsafe { return @ptrCast(*keysym.Names, &keyboard.*.names) }
}

fn stateOf(keyboard: *Keyboard) -> *xkb_state.State {
    unsafe { return @ptrCast(*xkb_state.State, &keyboard.*.state) }
}

// wl_keyboard.keymap: reads the keymap text the compositor sent.
pub fn keymap(keyboard: *Keyboard, handle: wl.Handle, format: u32, size: u32) -> void {
    if format != 1 || size == 0 {
        handle.close()
        return
    }
    var memory: wl.SharedMemory = undefined
    if !wl.transport.mapSharedMemory(&memory, handle, @intCast(usize, size), false) {
        handle.close()
        return
    }
    if !keyboard.*.hasNames { keyboard.*.hasNames = keysym.init(namesOf(keyboard), keyboard.*.allocator) }
    if !keyboard.*.hasNames {
        memory.release()
        return
    }
    if keyboard.*.keymap == 0 {
        keyboard.*.keymap = @intFromPtr(xkb.create(keyboard.*.allocator, namesOf(keyboard)))
    } else {
        xkb.clear(keymapOf(keyboard), namesOf(keyboard))
    }
    // The text ends with a NUL.
    const bytes = memory.bytes()
    var length = @intCast(usize, size)
    while length > 0 && bytes[length - 1] == 0 { length -= 1 }
    keyboard.*.valid = xkb_parse.parse(keymapOf(keyboard), bytes[0..length])
    memory.release()
    if !keyboard.*.valid { return }
    xkb_state.init(stateOf(keyboard), keymapOf(keyboard))
    const alt = xkb_state.modMask(keymapOf(keyboard), "Alt")
    const third = xkb_state.modMask(keymapOf(keyboard), "LevelThree")
    keyboard.*.altMask = if alt != 0 { alt } else { xkb.MOD1 }
    keyboard.*.levelThreeMask = if third != 0 { third } else { xkb.MOD5 }
    update(keyboard, keyboard.*.depressed)
}

fn update(keyboard: *Keyboard, depressed: u32) -> void {
    xkb_state.updateMask(stateOf(keyboard), depressed, keyboard.*.latched, keyboard.*.locked, 0, 0, @intCast(i32, keyboard.*.group))
}

// wl_keyboard.modifiers.
pub fn modifiers(keyboard: *Keyboard, depressed: u32, latched: u32, locked: u32, group: u32) -> void {
    keyboard.*.depressed = depressed
    keyboard.*.latched = latched
    keyboard.*.locked = locked
    keyboard.*.group = group
    if keyboard.*.valid { update(keyboard, depressed) }
}

pub fn control(keyboard: *const Keyboard) -> bool { return keyboard.*.depressed & xkb.CONTROL != 0 }

fn typesText(length: usize, out: [*]u8) -> bool {
    return length > 0 && length <= 7 && out[0] >= 32 && out[0] != 127
}

// The text evdev key `key` types now (UTF-8 into `out`, at most 8 bytes);
// 0 bytes for keys that type nothing (and for control characters).
// AltGr types its third level; so does Ctrl+Alt (as on Windows), when the
// key has one.
pub fn text(keyboard: *Keyboard, key: u32, out: [*]u8) -> usize {
    keyboard.*.levelThree = false
    if keyboard.*.valid {
        const state = stateOf(keyboard)
        const length = xkb_state.keyUtf8(state, key + 8, out, 8)
        if typesText(length, out) {
            keyboard.*.levelThree = (keyboard.*.depressed | keyboard.*.latched | keyboard.*.locked) & keyboard.*.levelThreeMask != 0
            return length
        }
        const held = keyboard.*.depressed
        if held & xkb.CONTROL == 0 || held & keyboard.*.altMask == 0 { return 0 }
        // Ctrl+Alt: the key's third level, if it has one of its own.
        var plain: [8]u8 = undefined
        var plain_bytes: [*]u8 = undefined
        unsafe { plain_bytes = @ptrCast([*]u8, &plain) }
        const without = held & ~(xkb.CONTROL | keyboard.*.altMask)
        update(keyboard, without)
        const plain_length = xkb_state.keyUtf8(state, key + 8, plain_bytes, 8)
        update(keyboard, without | keyboard.*.levelThreeMask)
        const third = xkb_state.keyUtf8(state, key + 8, out, 8)
        update(keyboard, held)
        if !typesText(third, out) { return 0 }
        // The same as without it: the key has no third level.
        if third == plain_length {
            var same = true
            var index: usize = 0
            while index < third {
                if out[index] != plain[index] { same = false }
                index += 1
            }
            if same { return 0 }
        }
        keyboard.*.levelThree = true
        return third
    }
    const shift = keyboard.*.depressed & xkb.SHIFT != 0
    const caps = keyboard.*.locked & xkb.LOCK != 0
    const length = us.encode(key, shift, false, caps, out)
    if length != 1 || out[0] < 32 || out[0] == 127 { return 0 }
    return length
}

// The text `key` types without Control and Alt (Shift and the locks as
// held): what Ctrl+C means on any layout. 0 bytes for a key that types
// nothing then.
pub fn plainText(keyboard: *Keyboard, key: u32, out: [*]u8) -> usize {
    if keyboard.*.valid {
        const held = keyboard.*.depressed
        const without = held & ~(xkb.CONTROL | keyboard.*.altMask)
        update(keyboard, without)
        const length = xkb_state.keyUtf8(stateOf(keyboard), key + 8, out, 8)
        update(keyboard, held)
        if typesText(length, out) { return length }
        return 0
    }
    const shift = keyboard.*.depressed & xkb.SHIFT != 0
    const caps = keyboard.*.locked & xkb.LOCK != 0
    const length = us.encode(key, shift, false, caps, out)
    if length != 1 || out[0] < 32 || out[0] == 127 { return 0 }
    return length
}
