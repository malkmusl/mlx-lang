// std.ui.popup: what lies over the rest: a popup's frame (its shadow, a
// raised surface, an outline) that takes the pointer from what is under
// it, menu rows and separators in it, and tooltips (a few lines of text
// wrapped in a box near a point).
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const controls = @import("std.ui.controls")

const Ui = view.Ui
const Text = text_module.Text

// A popup's frame in `area` (draw it after what it covers, before its
// rows): the pointer over it is on `popup_id` (or a row in it), not on
// what is under it.
pub fn frame(context: *Ui, popup_id: u64, area: ui.Rect) -> void {
    const theme = context.*.theme
    const canvas = context.*.canvas
    canvas_module.fillRoundedRect(canvas, area.x - 2, area.y + 2, area.width + 4, area.height + 4, theme.*.radius + 3, theme.*.shadow)
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.radius + 2, theme.*.raised)
    canvas_module.strokeRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.radius + 2, 1, theme.*.divider)
    view.region(context, popup_id, area)
}

// A menu row: `string`, `note` (a shortcut, dim, on the right); a
// disabled one is dim and takes no click. True when clicked.
pub fn item(context: *Ui, item_id: u64, area: ui.Rect, string: []const u8, note: []const u8, enabled: bool) -> bool {
    const theme = context.*.theme
    if enabled { view.region(context, item_id, area) }
    if enabled && view.isHover(context, item_id) { canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, theme.*.radius - 2, theme.*.hover) }
    const font = context.*.body
    const top = controls.textTop(font, area.y, area.height)
    controls.label(context, font, string, area.x + theme.*.padding, top, if enabled { theme.*.text } else { theme.*.disabled }, area.width - theme.*.padding * 2)
    if note.length > 0 {
        const note_width = text_module.measure(context.*.small, note)
        controls.label(context, context.*.small, note, ui.right(area) - theme.*.padding - note_width, controls.textTop(context.*.small, area.y, area.height), theme.*.dim, 0)
    }
    return enabled && view.takeClick(context, item_id)
}

// A line between groups of rows.
pub fn separator(context: *Ui, x: i32, y: i32, width: i32) -> void {
    canvas_module.fillRect(context.*.canvas, x + 8, y, width - 16, 1, context.*.theme.*.divider)
}

// How tall `string` wrapped to `width` in `font` is, at `line` pixels a
// line (at most `most` lines).
pub fn wrappedHeight(font: *Text, string: []const u8, width: i32, line: i32, most: usize) -> i32 {
    return @intCast(i32, wrapLines(null, font, string, 0, 0, width, line, most, 0)) * line
}

// Draws `string` wrapped at spaces to `width` (a word longer than that is
// cut) from (x, y); how many lines.
pub fn wrapped(context: *Ui, font: *Text, string: []const u8, x: i32, y: i32, width: i32, line: i32, most: usize, color: u32) -> usize {
    return wrapLines(context, font, string, x, y, width, line, most, color)
}

fn wrapLines(context: ?*Ui, font: *Text, string: []const u8, x: i32, y: i32, width: i32, line: i32, most: usize, color: u32) -> usize {
    var lines: usize = 0
    var start: usize = 0
    while start < string.length && lines < most {
        // The longest piece up to a space (or a newline) that fits.
        var end = start
        var fit = start
        while end < string.length && string[end] != 10 {
            var next = end
            while next < string.length && string[next] != 32 && string[next] != 10 { next += 1 }
            if text_module.measure(font, string[start..next]) > width && fit > start { break }
            fit = next
            end = next
            if end < string.length && string[end] == 32 { end += 1 }
        }
        if fit == start { fit = end }
        if context != null { text_module.drawText(context.?.*.canvas, font, string[start..fit], x, y + @intCast(i32, lines) * line, color, width) }
        lines += 1
        start = fit
        while start < string.length && (string[start] == 32 || string[start] == 10) { start += 1 }
    }
    return lines
}

// A tooltip: `string` wrapped to `width` in a raised box whose top left
// is at (x, y), moved to stay inside `bounds`.
pub fn tooltip(context: *Ui, string: []const u8, x: i32, y: i32, width: i32, bounds: ui.Rect) -> void {
    const theme = context.*.theme
    const font = context.*.small
    const line = font.*.ascent * 3 / 2 + 2
    const padding = theme.*.padding
    const height = wrappedHeight(font, string, width, line, 12) + padding * 2 - 4
    var left = x
    var top = y
    if left + width + padding * 2 > ui.right(bounds) { left = ui.right(bounds) - width - padding * 2 }
    if top + height > ui.bottom(bounds) { top = ui.bottom(bounds) - height }
    if left < bounds.x { left = bounds.x }
    if top < bounds.y { top = bounds.y }
    const canvas = context.*.canvas
    canvas_module.fillRoundedRect(canvas, left - 1, top + 1, width + padding * 2 + 2, height + 2, theme.*.radius, theme.*.shadow)
    canvas_module.fillRoundedRect(canvas, left, top, width + padding * 2, height, theme.*.radius, theme.*.raised)
    const drawn = wrapped(context, font, string, left + padding, top + padding - 2, width, line, 12, theme.*.text)
}
