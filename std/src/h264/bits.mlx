// std.h264.bits: the bits of a NAL unit's RBSP for the CPU decoder
// (std.h264.decode): the payload after the header byte with emulation
// prevention bytes removed, read MSB first (7.2): fixed-length codes,
// Exp-Golomb ue(v), se(v) and te(v), byte alignment and
// more_rbsp_data(). A read past the end gives zeros and marks the reader
// failed.
const allocator_module = @import("../../bootstrap/allocator.mlx")

pub const Allocator = allocator_module.Allocator

pub const Bits = struct {
    allocator: Allocator
    bytes: [*]u8
    capacity: usize
    length: usize
    // The position, in bits.
    at: usize
    failed: bool
    // The bit after the last one bit of the RBSP (rbsp_stop_one_bit).
    stop: usize
}

pub fn init(bits: *Bits, allocator: Allocator) -> void {
    bits.*.allocator = allocator
    bits.*.capacity = 0
    bits.*.length = 0
    bits.*.at = 0
    bits.*.failed = false
    bits.*.stop = 0
}

pub fn deinit(bits: *Bits) -> void {
    if bits.*.capacity != 0 { bits.*.allocator.free(bits.*.bytes, bits.*.capacity, 16) }
    bits.*.capacity = 0
}

// Loads the NAL unit at `nal` (`length` bytes with its header byte): the
// RBSP after the header. False without memory.
pub fn load(bits: *Bits, nal: [*]const u8, length: usize) -> bool {
    // Room for the bytes and 8 zero bytes after them (peek reads ahead).
    const wanted = length + 16
    if wanted > bits.*.capacity {
        if bits.*.capacity != 0 { bits.*.allocator.free(bits.*.bytes, bits.*.capacity, 16) }
        var size: usize = 4096
        while size < wanted { size *= 2 }
        const memory = bits.*.allocator.alloc(size, 16)
        if memory == null {
            bits.*.capacity = 0
            return false
        }
        bits.*.bytes = memory.?
        bits.*.capacity = size
    }
    var zeros: usize = 0
    var index: usize = 1
    var out: usize = 0
    const bytes = bits.*.bytes
    while index < length {
        const byte = nal[index]
        index += 1
        if zeros >= 2 && byte == 3 {
            zeros = 0
            continue
        }
        bytes[out] = byte
        out += 1
        if byte == 0 { zeros += 1 } else { zeros = 0 }
    }
    var pad: usize = 0
    while pad < 16 {
        bytes[out + pad] = 0
        pad += 1
    }
    bits.*.length = out
    bits.*.at = 0
    bits.*.failed = false
    // The stop bit: the last one bit.
    var last = out
    while last > 0 && bytes[last - 1] == 0 { last -= 1 }
    bits.*.stop = 0
    if last > 0 {
        const byte = bytes[last - 1]
        var trailing: usize = 0
        while (byte >> @intCast(u8, trailing)) & 1 == 0 { trailing += 1 }
        bits.*.stop = (last - 1) * 8 + (7 - trailing)
    }
    return true
}

// The next 32 bits without consuming them (zeros past the end).
pub fn peek32(bits: *Bits) -> u32 {
    const at = bits.*.at
    const byte = at >> 3
    const bytes = bits.*.bytes
    if byte >= bits.*.length + 8 { return 0 }
    var word: u64 = 0
    word = (@intCast(u64, bytes[byte]) << 32) | (@intCast(u64, bytes[byte + 1]) << 24) | (@intCast(u64, bytes[byte + 2]) << 16) | (@intCast(u64, bytes[byte + 3]) << 8) | @intCast(u64, bytes[byte + 4])
    const shift = @intCast(u6, 8 - (at & 7))
    return @intCast(u32, (word >> shift) & 0xffffffff)
}

pub fn skip(bits: *Bits, count: usize) -> void {
    bits.*.at += count
    if bits.*.at > bits.*.length * 8 { bits.*.failed = true }
}

// u(n), n at most 32.
pub fn read(bits: *Bits, count: u32) -> u32 {
    if count == 0 { return 0 }
    const value = peek32(bits) >> @intCast(u5, 32 - count)
    skip(bits, @intCast(usize, count))
    if bits.*.failed { return 0 }
    return value
}

pub fn flag(bits: *Bits) -> bool { return read(bits, 1) == 1 }

// ue(v).
pub fn ue(bits: *Bits) -> u32 {
    const word = peek32(bits)
    if word >= 0x10000 {
        // A code of at most 31 bits: its zeros counted in the word.
        var zeros: u32 = 0
        while word & (@intCast(u32, 0x80000000) >> @intCast(u5, zeros)) == 0 { zeros += 1 }
        skip(bits, @intCast(usize, zeros * 2 + 1))
        if bits.*.failed { return 0 }
        return (word >> @intCast(u5, 31 - zeros * 2)) - 1
    }
    var zeros: u32 = 0
    while read(bits, 1) == 0 {
        zeros += 1
        if zeros > 31 || bits.*.failed {
            bits.*.failed = true
            return 0
        }
    }
    if zeros == 0 { return 0 }
    return ((@intCast(u32, 1) << @intCast(u5, zeros)) - 1) + read(bits, zeros)
}

// se(v).
pub fn se(bits: *Bits) -> i32 {
    const code = ue(bits)
    const magnitude = @intCast(i32, (code + 1) / 2)
    if code & 1 == 1 { return magnitude }
    return -magnitude
}

// te(v) with the largest value `range`.
pub fn te(bits: *Bits, range: u32) -> u32 {
    if range > 1 { return ue(bits) }
    if range == 1 { return 1 - read(bits, 1) }
    return 0
}

pub fn aligned(bits: *Bits) -> bool { return bits.*.at & 7 == 0 }

pub fn alignToByte(bits: *Bits) -> void {
    bits.*.at = (bits.*.at + 7) & ~@intCast(usize, 7)
}

// more_rbsp_data().
pub fn moreData(bits: *Bits) -> bool {
    return !bits.*.failed && bits.*.at < bits.*.stop
}

// The byte at the position (byte aligned).
pub fn bytePosition(bits: *Bits) -> usize { return bits.*.at >> 3 }
