// std.tls.wire: reading and writing the TLS presentation language's
// integers and vectors (RFC 8446, 3): a cursor over bytes that remembers
// whether it ran past the end, and a writer that remembers whether it
// ran out of room, so a message is parsed or built in a run of calls and
// checked once.

pub const Parser = struct {
    data: [*]const u8
    at: usize
    end: usize
    ok: bool
}

pub fn parser(data: [*]const u8, start: usize, end: usize) -> Parser {
    return Parser.{ .data = data, .at = start, .end = end, .ok = true }
}

pub fn remaining(p: *Parser) -> usize {
    if !p.*.ok || p.*.at > p.*.end { return 0 }
    return p.*.end - p.*.at
}

pub fn atEnd(p: *Parser) -> bool {
    return p.*.ok && p.*.at == p.*.end
}

pub fn number(p: *Parser, width: usize) -> u64 {
    if !p.*.ok || p.*.end - p.*.at < width {
        p.*.ok = false
        return 0
    }
    var value: u64 = 0
    var index: usize = 0
    while index < width {
        value = (value << 8) | @intCast(u64, p.*.data[p.*.at + index])
        index += 1
    }
    p.*.at += width
    return value
}

pub fn byte(p: *Parser) -> u64 {
    return number(p, 1)
}

pub fn uint16(p: *Parser) -> u64 {
    return number(p, 2)
}

pub fn uint24(p: *Parser) -> u64 {
    return number(p, 3)
}

// `length` bytes: where they start (the parser moves past them).
pub fn bytes(p: *Parser, length: usize) -> usize {
    if !p.*.ok || p.*.end - p.*.at < length {
        p.*.ok = false
        return p.*.at
    }
    const start = p.*.at
    p.*.at += length
    return start
}

// A vector with a length of `width` bytes in front: a parser of its
// contents (the outer one moves past it).
pub fn vector(p: *Parser, width: usize) -> Parser {
    const length = @intCast(usize, number(p, width))
    const start = bytes(p, length)
    if !p.*.ok { return Parser.{ .data = p.*.data, .at = 0, .end = 0, .ok = false } }
    return Parser.{ .data = p.*.data, .at = start, .end = start + length, .ok = true }
}

pub const Writer = struct {
    data: [*]u8
    at: usize
    room: usize
    ok: bool
}

pub fn writer(data: [*]u8, room: usize) -> Writer {
    return Writer.{ .data = data, .at = 0, .room = room, .ok = true }
}

pub fn putNumber(w: *Writer, value: u64, width: usize) -> void {
    if !w.*.ok || w.*.room - w.*.at < width {
        w.*.ok = false
        return
    }
    var index: usize = 0
    while index < width {
        w.*.data[w.*.at + index] = @intCast(u8, (value >> @intCast(u64, 8 * (width - 1 - index))) & 255)
        index += 1
    }
    w.*.at += width
}

pub fn put8(w: *Writer, value: u64) -> void {
    putNumber(w, value, 1)
}

pub fn put16(w: *Writer, value: u64) -> void {
    putNumber(w, value, 2)
}

pub fn put24(w: *Writer, value: u64) -> void {
    putNumber(w, value, 3)
}

pub fn putBytes(w: *Writer, from: [*]const u8, length: usize) -> void {
    if !w.*.ok || w.*.room - w.*.at < length {
        w.*.ok = false
        return
    }
    var index: usize = 0
    while index < length {
        w.*.data[w.*.at + index] = from[index]
        index += 1
    }
    w.*.at += length
}

// A length of `width` bytes to be filled in by finish once what follows
// is written: where it is.
pub fn begin(w: *Writer, width: usize) -> usize {
    const at = w.*.at
    putNumber(w, 0, width)
    return at
}

pub fn finish(w: *Writer, at: usize, width: usize) -> void {
    if !w.*.ok { return }
    const length = @intCast(u64, w.*.at - at - width)
    var index: usize = 0
    while index < width {
        w.*.data[at + index] = @intCast(u8, (length >> @intCast(u64, 8 * (width - 1 - index))) & 255)
        index += 1
    }
}
