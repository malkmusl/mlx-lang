// std.tls.schedule: the key derivations of TLS: HKDF-Expand-Label and
// the secrets of TLS 1.3's key schedule (RFC 8446, 7.1), and the PRF of
// TLS 1.2 (RFC 5246, 5) with what it makes: the master secret (with the
// extended one of RFC 7627), the key block and Finished's verify_data.

const hash = @import("../crypto/hash.mlx")

// HKDF-Expand-Label(secret, label, context, length): HKDF-Expand with
// the info struct { uint16 length; opaque label<7..255> = "tls13 " +
// label; opaque context<0..255> }.
pub fn expandLabel(algorithm: hash.Algorithm, secret: [*]const u8, label: []const u8, context: [*]const u8, contextLength: usize, out: [*]u8, length: usize) -> void {
    var info: [600]u8 = undefined
    info[0] = @intCast(u8, (length >> 8) & 255)
    info[1] = @intCast(u8, length & 255)
    info[2] = @intCast(u8, 6 + label.length)
    const prefix = "tls13 "
    var at: usize = 3
    var index: usize = 0
    while index < 6 {
        info[at] = prefix[index]
        at += 1
        index += 1
    }
    index = 0
    while index < label.length {
        info[at] = label[index]
        at += 1
        index += 1
    }
    info[at] = @intCast(u8, contextLength)
    at += 1
    index = 0
    while index < contextLength {
        info[at] = context[index]
        at += 1
        index += 1
    }
    const bytes: [*]const u8 = &info
    const size = hash.digestLength(algorithm)
    const ok = hash.hkdfExpandFrom(algorithm, secret, size, bytes, at, out, length)
}

// Derive-Secret(secret, label, messages) with the transcript's digest
// already made.
pub fn deriveSecret(algorithm: hash.Algorithm, secret: [*]const u8, label: []const u8, digest: [*]const u8, out: [*]u8) -> void {
    const size = hash.digestLength(algorithm)
    expandLabel(algorithm, secret, label, digest, size, out, size)
}

// Derive-Secret(secret, "derived", ""): the salt of the next stage.
pub fn derived(algorithm: hash.Algorithm, secret: [*]const u8, out: [*]u8) -> void {
    var empty: [64]u8 = undefined
    const digest: [*]u8 = &empty
    hash.digest(algorithm, "", digest)
    deriveSecret(algorithm, secret, "derived", digest, out)
}

// The traffic key and IV of a traffic secret (RFC 8446, 7.3).
pub fn trafficKeys(algorithm: hash.Algorithm, secret: [*]const u8, keyLength: usize, key: [*]u8, iv: [*]u8) -> void {
    var nothing: [1]u8 = [1]u8{ 0 }
    const empty: [*]const u8 = &nothing
    expandLabel(algorithm, secret, "key", empty, 0, key, keyLength)
    expandLabel(algorithm, secret, "iv", empty, 0, iv, 12)
}

// The next application traffic secret after a KeyUpdate (RFC 8446, 7.2).
pub fn nextTrafficSecret(algorithm: hash.Algorithm, secret: [*]u8) -> void {
    var nothing: [1]u8 = [1]u8{ 0 }
    const empty: [*]const u8 = &nothing
    var next: [64]u8 = undefined
    const out: [*]u8 = &next
    const size = hash.digestLength(algorithm)
    expandLabel(algorithm, secret, "traffic upd", empty, 0, out, size)
    var index: usize = 0
    while index < size {
        secret[index] = next[index]
        index += 1
    }
    hash.wipe(out, 64)
}

// Finished's verify_data of TLS 1.3: HMAC(finished_key, transcript).
pub fn finishedData(algorithm: hash.Algorithm, base: [*]const u8, transcript: [*]const u8, out: [*]u8) -> void {
    const size = hash.digestLength(algorithm)
    var key: [64]u8 = undefined
    const finishedKey: [*]u8 = &key
    var nothing: [1]u8 = [1]u8{ 0 }
    const empty: [*]const u8 = &nothing
    expandLabel(algorithm, base, "finished", empty, 0, finishedKey, size)
    var keyed: hash.Hmac = undefined
    hash.hmacKey(&keyed, algorithm, finishedKey, size)
    hash.hmacAbsorb(&keyed, transcript, size)
    hash.hmacFinish(&keyed, out)
    hash.wipe(finishedKey, 64)
}

// ---------------------------------------------------------------------------
// TLS 1.2's PRF: P_hash(secret, label + seed), A(i) = HMAC(secret,
// A(i-1)), output HMAC(secret, A(i) + label + seed) one after another.

pub fn prf(algorithm: hash.Algorithm, secret: []const u8, label: []const u8, seed1: []const u8, seed2: []const u8, out: [*]u8, length: usize) -> void {
    const size = hash.digestLength(algorithm)
    var a: [64]u8 = undefined
    var block: [64]u8 = undefined
    const ap: [*]u8 = &a
    const bp: [*]u8 = &block
    var keyed: hash.Hmac = undefined
    hash.hmacInit(&keyed, algorithm, secret)
    hash.hmacUpdate(&keyed, label)
    hash.hmacUpdate(&keyed, seed1)
    hash.hmacUpdate(&keyed, seed2)
    hash.hmacFinish(&keyed, ap)
    var made: usize = 0
    while made < length {
        hash.hmacInit(&keyed, algorithm, secret)
        hash.hmacAbsorb(&keyed, ap, size)
        hash.hmacUpdate(&keyed, label)
        hash.hmacUpdate(&keyed, seed1)
        hash.hmacUpdate(&keyed, seed2)
        hash.hmacFinish(&keyed, bp)
        var index: usize = 0
        while index < size && made < length {
            out[made] = block[index]
            made += 1
            index += 1
        }
        hash.hmacInit(&keyed, algorithm, secret)
        hash.hmacAbsorb(&keyed, ap, size)
        hash.hmacFinish(&keyed, ap)
    }
    hash.wipe(ap, 64)
    hash.wipe(bp, 64)
}
