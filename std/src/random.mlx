// std.random: unpredictable bytes from the kernel (getrandom(2)), and
// small seeded generators for when the same seed must give the same
// numbers (stars on a splash screen, a shuffle to reproduce, tests).
//
//     var key: [16]u8 = undefined
//     if !random.fill(&key, 16) { ... }        // the kernel's bytes
//     const id = random.random32()               // never fails
//
//     var generator: random.Xoshiro256 = undefined
//     random.seed(&generator, 42)                // or seedFromKernel
//     const roll = random.below(&generator, 6)   // 0 to 5, unbiased
//     const fraction = random.unit(&generator)   // 0 up to 1
//
// The seeded generator is xoshiro256** (Blackman and Vigna, 2018: 256
// bits of state, period 2^256 - 1, passes BigCrush), its state filled
// from the seed by splitmix64 as its authors advise. It is fast and good
// for simulations and games, and not for secrets: anyone who sees a few
// outputs can predict the rest. Secrets come from fill.
//
// Xorshift64Star is Marsaglia's xorshift64* (shifts 12, 25, 27 and the
// multiplier 2685821657736338717), kept by name because the splash's
// pictures are drawn from its sequence.
const linux = @import("../bootstrap/os/linux.mlx")
const time = @import("../bootstrap/time.mlx")

const SYS_getrandom: usize = 318
const EINTR: isize = -4

// getrandom(2) as the kernel answers it: how many bytes it wrote into
// `into`, or a negative errno (flags: 1 GRND_NONBLOCK, 2 GRND_RANDOM).
pub fn getrandom(into: [*]u8, length: usize, flags: u32) -> isize {
    return linux.syscall3(SYS_getrandom, @intFromPtr(into), length, @intCast(usize, flags))
}

// `length` bytes from the kernel's generator into `into`; false when it
// gives none (a kernel without getrandom). Waits, once after boot, until
// the kernel has gathered enough to seed itself.
pub fn fill(into: [*]u8, length: usize) -> bool {
    var done: usize = 0
    while done < length {
        const rest: [*]u8 = unsafe { into + done }
        const got = getrandom(rest, length - done, 0)
        if got == EINTR { continue }
        if got <= 0 { return false }
        done += @bitCast(usize, got)
    }
    return true
}

// A random number from the kernel; if it gives none, one mixed from the
// monotonic clock (different each call, but not unpredictable).
pub fn random64() -> u64 {
    var value: u64 = 0
    const bytes: [*]u8 = unsafe { @ptrCast([*]u8, &value) }
    if fill(bytes, 8) { return value }
    var state = @intCast(u64, time.monotonicNanoseconds())
    return splitmix64(&state)
}

pub fn random32() -> u32 {
    return @intCast(u32, random64() >> 32)
}

// splitmix64 (Steele, Lea and Flood): the next number of the sequence
// `state` walks, the state moved on.
pub fn splitmix64(state: *u64) -> u64 {
    state.* = state.* +% 11400714819323198485
    var z = state.*
    z = (z ^ (z >> 30)) *% 13787848793156543929
    z = (z ^ (z >> 27)) *% 10723151780598845931
    return z ^ (z >> 31)
}

// ---------------------------------------------------------------------------
// xoshiro256**

pub const Xoshiro256 = struct {
    s: [4]u64
}

fn rotate(value: u64, count: u64) -> u64 {
    return (value <<% count) | (value >> (64 - count))
}

// The state from `value` (any value, 0 too): the same seed, the same
// numbers.
pub fn seed(generator: *Xoshiro256, value: u64) -> void {
    var state = value
    var index: usize = 0
    while index < 4 {
        generator.*.s[index] = splitmix64(&state)
        index += 1
    }
}

// Seeded from the kernel: different numbers each run.
pub fn seedFromKernel(generator: *Xoshiro256) -> void {
    seed(generator, random64())
}

pub fn next(generator: *Xoshiro256) -> u64 {
    const result = rotate(generator.*.s[1] *% 5, 7) *% 9
    const t = generator.*.s[1] <<% 17
    generator.*.s[2] = generator.*.s[2] ^ generator.*.s[0]
    generator.*.s[3] = generator.*.s[3] ^ generator.*.s[1]
    generator.*.s[1] = generator.*.s[1] ^ generator.*.s[2]
    generator.*.s[0] = generator.*.s[0] ^ generator.*.s[3]
    generator.*.s[2] = generator.*.s[2] ^ t
    generator.*.s[3] = rotate(generator.*.s[3], 45)
    return result
}

// A number from 0 up to (not including) `bound` (above 0), each as
// likely: the numbers that would favour the low ones are drawn again.
pub fn below(generator: *Xoshiro256, bound: u64) -> u64 {
    // 2^64 mod bound: the draws under it are the uneven remainder.
    const threshold = (0 -% bound) % bound
    while true {
        const value = next(generator)
        if value >= threshold { return value % bound }
    }
    return 0
}

// A double from 0 up to (not including) 1, from the top 53 bits.
pub fn unit(generator: *Xoshiro256) -> f64 {
    return @floatFromInt(f64, @intCast(i64, next(generator) >> 11)) / 9007199254740992.0
}

// ---------------------------------------------------------------------------
// xorshift64*

pub const Xorshift64Star = struct {
    // Never 0 (it would stay 0).
    state: u64
}

pub fn xorshift64StarNext(generator: *Xorshift64Star) -> u64 {
    var x = generator.*.state
    x = x ^ (x >> 12)
    x = x ^ (x <<% 25)
    x = x ^ (x >> 27)
    generator.*.state = x
    return x *% 2685821657736338717
}

// A double from 0 up to (not including) 1, from the top 53 bits.
pub fn xorshift64StarUnit(generator: *Xorshift64Star) -> f64 {
    return @floatFromInt(f64, @intCast(i64, xorshift64StarNext(generator) >> 11)) / 9007199254740992.0
}
