// std.webp.demux: libwebp's (1.3.2) demuxer, step for step
// (demux/demux.c): the chunks of a WebP file, complete or cut short, as
// a canvas (VP8X: its size, flags, loop count and background colour from
// ANIM) and its frames (each ANMF's offset, size, duration, disposal and
// blending, and its ALPH and image chunks), checked as libwebp checks
// them. A raw VP8 or VP8L stream is a picture of one frame.
//
// The structures it hands out are laid out as libwebp's WebPIterator and
// WebPChunkIterator, for the C API.
const io = @import("./io.mlx")
const decode = @import("./decode.mlx")

pub const Allocator = io.Allocator

inline fn get8(address: usize) -> u64 { return io.get8(address) }
inline fn getLE16(data: usize) -> u64 { return decode.getLE16(data) }
inline fn getLE24(data: usize) -> u64 { return decode.getLE24(data) }
inline fn getLE32(data: usize) -> u64 { return decode.getLE32(data) }

// WebPDemuxState.
pub const PARSE_ERROR_STATE: i32 = 0 - 1
pub const PARSING_HEADER: i32 = 0
pub const PARSED_HEADER: i32 = 1
pub const DONE: i32 = 2

// WebPFormatFeature.
pub const FORMAT_FLAGS: i32 = 0
pub const CANVAS_WIDTH: i32 = 1
pub const CANVAS_HEIGHT: i32 = 2
pub const LOOP_COUNT: i32 = 3
pub const BACKGROUND_COLOR: i32 = 4
pub const FRAME_COUNT: i32 = 5

// WebPMuxAnimDispose and WebPMuxAnimBlend.
pub const DISPOSE_NONE: i32 = 0
pub const DISPOSE_BACKGROUND: i32 = 1
pub const BLEND: i32 = 0
pub const NO_BLEND: i32 = 1

const ANIMATION_FLAG: u64 = 0x02
const XMP_FLAG: u64 = 0x04
const EXIF_FLAG: u64 = 0x08
const ALPHA_FLAG: u64 = 0x10
const ICCP_FLAG: u64 = 0x20
const ALL_VALID_FLAGS: u64 = 0x3e

const CHUNK_HEADER_SIZE: usize = 8
const RIFF_HEADER_SIZE: usize = 12
const TAG_SIZE: usize = 4
const ANMF_CHUNK_SIZE: u64 = 16
const ANIM_CHUNK_SIZE: u64 = 6
const VP8X_CHUNK_SIZE: u64 = 10
const MAX_IMAGE_AREA: u64 = 4294967296

const PARSE_OK: u8 = 0
const PARSE_NEED_MORE_DATA: u8 = 1
const PARSE_ERROR: u8 = 2

pub const MemBuffer = struct {
    start: usize
    end: usize
    riffEnd: usize
    bufSize: usize
    buf: usize
}

// A frame (with the offsets and sizes of its image and ALPH chunks).
pub const Frame = struct {
    xOffset: i64
    yOffset: i64
    width: i64
    height: i64
    hasAlpha: bool
    duration: i64
    disposeMethod: i32
    blendMethod: i32
    frameNum: i64
    complete: bool
    imageOffset: usize
    imageSize: usize
    alphaOffset: usize
    alphaSize: usize
    next: usize
}

pub const Chunk = struct {
    offset: usize
    size: usize
    next: usize
}

pub const Demuxer = struct {
    allocator: Allocator
    mem: MemBuffer
    state: i32
    isExtFormat: bool
    featureFlags: u64
    canvasWidth: i64
    canvasHeight: i64
    loopCount: i64
    bgcolor: u64
    numFrames: i64
    frames: usize
    lastFrame: usize
    chunks: usize
    lastChunk: usize
}

// WebPIterator.
pub const Iterator = struct {
    frameNum: i32
    numFrames: i32
    xOffset: i32
    yOffset: i32
    width: i32
    height: i32
    duration: i32
    disposeMethod: i32
    complete: i32
    pad0: u32
    fragmentBytes: usize
    fragmentSize: usize
    hasAlpha: i32
    blendMethod: i32
    pad: [2]u32
    demuxer: usize
}

// WebPChunkIterator.
pub const ChunkIterator = struct {
    chunkNum: i32
    numChunks: i32
    chunkBytes: usize
    chunkSize: usize
    pad: [6]u32
    demuxer: usize
}

inline fn frameAt(address: usize) -> *Frame { return unsafe { @ptrFromInt(*Frame, address) } }
inline fn chunkAt(address: usize) -> *Chunk { return unsafe { @ptrFromInt(*Chunk, address) } }
pub inline fn demuxerAt(address: usize) -> *Demuxer { return unsafe { @ptrFromInt(*Demuxer, address) } }

inline fn memDataSize(mem: *MemBuffer) -> usize { return mem.*.end - mem.*.start }

inline fn sizeIsInvalid(mem: *MemBuffer, size: u64) -> bool {
    return size > @intCast(u64, mem.*.riffEnd - mem.*.start)
}

inline fn skip(mem: *MemBuffer, size: usize) -> void { mem.*.start += size }

fn readByte(mem: *MemBuffer) -> u64 {
    const b = get8(mem.*.buf + mem.*.start)
    skip(mem, 1)
    return b
}

fn readLE16s(mem: *MemBuffer) -> u64 {
    const v = getLE16(mem.*.buf + mem.*.start)
    skip(mem, 2)
    return v
}

fn readLE24s(mem: *MemBuffer) -> u64 {
    const v = getLE24(mem.*.buf + mem.*.start)
    skip(mem, 3)
    return v
}

fn readLE32(mem: *MemBuffer) -> u64 {
    const v = getLE32(mem.*.buf + mem.*.start)
    skip(mem, 4)
    return v
}

fn addChunk(d: *Demuxer, chunk: usize) -> void {
    chunkAt(chunk).*.next = 0
    if d.*.lastChunk == 0 {
        d.*.chunks = chunk
    } else {
        chunkAt(d.*.lastChunk).*.next = chunk
    }
    d.*.lastChunk = chunk
}

fn addFrame(d: *Demuxer, frame: usize) -> bool {
    if d.*.lastFrame != 0 && !frameAt(d.*.lastFrame).*.complete { return false }
    frameAt(frame).*.next = 0
    if d.*.lastFrame == 0 {
        d.*.frames = frame
    } else {
        frameAt(d.*.lastFrame).*.next = frame
    }
    d.*.lastFrame = frame
    return true
}

fn setFrameInfo(startOffset: usize, size: usize, frameNum: i64, complete: bool, features: *io.Features, frame: *Frame) -> void {
    frame.*.imageOffset = startOffset
    frame.*.imageSize = size
    frame.*.width = @intCast(i64, features.*.width)
    frame.*.height = @intCast(i64, features.*.height)
    frame.*.hasAlpha = frame.*.hasAlpha || features.*.hasAlpha != 0
    frame.*.frameNum = frameNum
    frame.*.complete = complete
}

// StoreFrame: a frame's ALPH and image chunks.
fn storeFrame(frameNum: i64, minSize: u64, mem: *MemBuffer, frame: *Frame) -> u8 {
    var alphaChunks: usize = 0
    var imageChunks: usize = 0
    var done = memDataSize(mem) < CHUNK_HEADER_SIZE || @intCast(u64, memDataSize(mem)) < minSize
    var status = PARSE_OK
    if done { return PARSE_NEED_MORE_DATA }
    while true {
        const chunkStartOffset = mem.*.start
        const fourcc = mem.*.buf + mem.*.start
        readLE32(mem)
        const payloadSize = readLE32(mem)
        if payloadSize > decode.MAX_CHUNK_PAYLOAD { return PARSE_ERROR }
        const payloadSizePadded = payloadSize + (payloadSize & 1)
        var payloadAvailable = @intCast(usize, payloadSizePadded)
        if payloadSizePadded > @intCast(u64, memDataSize(mem)) { payloadAvailable = memDataSize(mem) }
        const chunkSize = CHUNK_HEADER_SIZE + payloadAvailable
        if sizeIsInvalid(mem, payloadSizePadded) { return PARSE_ERROR }
        if payloadSizePadded > @intCast(u64, memDataSize(mem)) { status = PARSE_NEED_MORE_DATA }
        var other = false
        if decode.isTag(fourcc, "ALPH") {
            if alphaChunks == 0 {
                alphaChunks += 1
                frame.*.alphaOffset = chunkStartOffset
                frame.*.alphaSize = chunkSize
                frame.*.hasAlpha = true
                frame.*.frameNum = frameNum
                skip(mem, payloadAvailable)
            } else {
                other = true
            }
        } else if decode.isTag(fourcc, "VP8L") || decode.isTag(fourcc, "VP8 ") {
            if decode.isTag(fourcc, "VP8L") && alphaChunks > 0 { return PARSE_ERROR }
            if imageChunks == 0 {
                var features: io.Features = undefined
                const vp8Status = decode.getFeatures(mem.*.buf + chunkStartOffset, chunkSize, &features)
                if status == PARSE_NEED_MORE_DATA && vp8Status == io.NOT_ENOUGH_DATA { return PARSE_NEED_MORE_DATA }
                if vp8Status != io.OK { return PARSE_ERROR }
                imageChunks += 1
                setFrameInfo(chunkStartOffset, chunkSize, frameNum, status == PARSE_OK, &features, frame)
                skip(mem, payloadAvailable)
            } else {
                other = true
            }
        } else {
            other = true
        }
        if other {
            mem.*.start -= CHUNK_HEADER_SIZE
            done = true
        }
        if mem.*.start == mem.*.riffEnd {
            done = true
        } else if memDataSize(mem) < CHUNK_HEADER_SIZE {
            status = PARSE_NEED_MORE_DATA
        }
        if done || status != PARSE_OK { break }
    }
    return status
}

fn newFrame(d: *Demuxer, minSize: u64, actualSize: u64, frame: *usize) -> u8 {
    const mem = &d.*.mem
    if sizeIsInvalid(mem, minSize) { return PARSE_ERROR }
    if actualSize < minSize { return PARSE_ERROR }
    if @intCast(u64, memDataSize(mem)) < minSize { return PARSE_NEED_MORE_DATA }
    frame.* = io.allocateZeroed(d.*.allocator, @sizeOf(Frame))
    if frame.* == 0 { return PARSE_ERROR }
    return PARSE_OK
}

fn parseAnimationFrame(d: *Demuxer, frameChunkSize: u64) -> u8 {
    const isAnimation = (d.*.featureFlags & ANIMATION_FLAG) != 0
    const anmfPayloadSize = (frameChunkSize -% ANMF_CHUNK_SIZE) & 0xffffffff
    var addedFrame = false
    const mem = &d.*.mem
    var frameAddress: usize = 0
    var status = newFrame(d, ANMF_CHUNK_SIZE, frameChunkSize, &frameAddress)
    if status != PARSE_OK { return status }
    const frame = frameAt(frameAddress)
    frame.*.xOffset = 2 * @intCast(i64, readLE24s(mem))
    frame.*.yOffset = 2 * @intCast(i64, readLE24s(mem))
    frame.*.width = 1 + @intCast(i64, readLE24s(mem))
    frame.*.height = 1 + @intCast(i64, readLE24s(mem))
    frame.*.duration = @intCast(i64, readLE24s(mem))
    const bits = readByte(mem)
    frame.*.disposeMethod = DISPOSE_NONE
    if (bits & 1) != 0 { frame.*.disposeMethod = DISPOSE_BACKGROUND }
    frame.*.blendMethod = BLEND
    if (bits & 2) != 0 { frame.*.blendMethod = NO_BLEND }
    if @intCast(u64, frame.*.width) * @intCast(u64, frame.*.height) >= MAX_IMAGE_AREA {
        io.release(d.*.allocator, frameAddress, @sizeOf(Frame))
        return PARSE_ERROR
    }
    const startOffset = mem.*.start
    status = storeFrame(d.*.numFrames + 1, anmfPayloadSize, mem, frame)
    if status != PARSE_ERROR && @intCast(u64, mem.*.start - startOffset) > anmfPayloadSize { status = PARSE_ERROR }
    if status != PARSE_ERROR && isAnimation && frame.*.frameNum > 0 {
        addedFrame = addFrame(d, frameAddress)
        if addedFrame {
            d.*.numFrames += 1
        } else {
            status = PARSE_ERROR
        }
    }
    if !addedFrame { io.release(d.*.allocator, frameAddress, @sizeOf(Frame)) }
    return status
}

fn storeChunk(d: *Demuxer, startOffset: usize, size: usize) -> bool {
    const chunk = io.allocateZeroed(d.*.allocator, @sizeOf(Chunk))
    if chunk == 0 { return false }
    chunkAt(chunk).*.offset = startOffset
    chunkAt(chunk).*.size = size
    addChunk(d, chunk)
    return true
}

fn readHeader(mem: *MemBuffer) -> u8 {
    const minSize = RIFF_HEADER_SIZE + CHUNK_HEADER_SIZE
    if memDataSize(mem) < minSize { return PARSE_NEED_MORE_DATA }
    const at = mem.*.buf + mem.*.start
    if !decode.isTag(at, "RIFF") || !decode.isTag(at + CHUNK_HEADER_SIZE, "WEBP") { return PARSE_ERROR }
    const riffSize = getLE32(at + TAG_SIZE)
    if riffSize < @intCast(u64, CHUNK_HEADER_SIZE) { return PARSE_ERROR }
    if riffSize > decode.MAX_CHUNK_PAYLOAD { return PARSE_ERROR }
    mem.*.riffEnd = @intCast(usize, riffSize) + CHUNK_HEADER_SIZE
    if mem.*.bufSize > mem.*.riffEnd {
        mem.*.bufSize = mem.*.riffEnd
        mem.*.end = mem.*.riffEnd
    }
    skip(mem, RIFF_HEADER_SIZE)
    return PARSE_OK
}

fn parseSingleImage(d: *Demuxer) -> u8 {
    const minSize = CHUNK_HEADER_SIZE
    const mem = &d.*.mem
    var imageAdded = false
    if d.*.frames != 0 { return PARSE_ERROR }
    if sizeIsInvalid(mem, @intCast(u64, minSize)) { return PARSE_ERROR }
    if memDataSize(mem) < minSize { return PARSE_NEED_MORE_DATA }
    const frameAddress = io.allocateZeroed(d.*.allocator, @sizeOf(Frame))
    if frameAddress == 0 { return PARSE_ERROR }
    const frame = frameAt(frameAddress)
    var status = storeFrame(1, 0, mem, frame)
    if status != PARSE_ERROR {
        const hasAlpha = (d.*.featureFlags & ALPHA_FLAG) != 0
        if !hasAlpha && frame.*.alphaSize > 0 {
            frame.*.alphaOffset = 0
            frame.*.alphaSize = 0
            frame.*.hasAlpha = false
        }
        if !d.*.isExtFormat && frame.*.width > 0 && frame.*.height > 0 {
            d.*.state = PARSED_HEADER
            d.*.canvasWidth = frame.*.width
            d.*.canvasHeight = frame.*.height
            if frame.*.hasAlpha { d.*.featureFlags = d.*.featureFlags | ALPHA_FLAG }
        }
        if !addFrame(d, frameAddress) {
            status = PARSE_ERROR
        } else {
            imageAdded = true
            d.*.numFrames = 1
        }
    }
    if !imageAdded { io.release(d.*.allocator, frameAddress, @sizeOf(Frame)) }
    return status
}

fn parseVP8XChunks(d: *Demuxer) -> u8 {
    const isAnimation = (d.*.featureFlags & ANIMATION_FLAG) != 0
    const mem = &d.*.mem
    var animChunks: usize = 0
    var status = PARSE_OK
    while true {
        var storeIt = true
        const chunkStartOffset = mem.*.start
        const fourcc = mem.*.buf + mem.*.start
        readLE32(mem)
        const chunkSize = readLE32(mem)
        if chunkSize > decode.MAX_CHUNK_PAYLOAD { return PARSE_ERROR }
        const chunkSizePadded = chunkSize + (chunkSize & 1)
        if sizeIsInvalid(mem, chunkSizePadded) { return PARSE_ERROR }
        var skipIt = false
        if decode.isTag(fourcc, "VP8X") {
            return PARSE_ERROR
        } else if decode.isTag(fourcc, "ALPH") || decode.isTag(fourcc, "VP8 ") || decode.isTag(fourcc, "VP8L") {
            if animChunks > 0 || isAnimation { return PARSE_ERROR }
            mem.*.start -= CHUNK_HEADER_SIZE
            status = parseSingleImage(d)
        } else if decode.isTag(fourcc, "ANIM") {
            if chunkSizePadded < ANIM_CHUNK_SIZE { return PARSE_ERROR }
            if @intCast(u64, memDataSize(mem)) < chunkSizePadded {
                status = PARSE_NEED_MORE_DATA
            } else if animChunks == 0 {
                animChunks += 1
                d.*.bgcolor = readLE32(mem)
                d.*.loopCount = @intCast(i64, readLE16s(mem))
                skip(mem, @intCast(usize, chunkSizePadded - ANIM_CHUNK_SIZE))
            } else {
                storeIt = false
                skipIt = true
            }
        } else if decode.isTag(fourcc, "ANMF") {
            if animChunks == 0 { return PARSE_ERROR }
            status = parseAnimationFrame(d, chunkSizePadded)
        } else if decode.isTag(fourcc, "ICCP") {
            storeIt = (d.*.featureFlags & ICCP_FLAG) != 0
            skipIt = true
        } else if decode.isTag(fourcc, "EXIF") {
            storeIt = (d.*.featureFlags & EXIF_FLAG) != 0
            skipIt = true
        } else if decode.isTag(fourcc, "XMP ") {
            storeIt = (d.*.featureFlags & XMP_FLAG) != 0
            skipIt = true
        } else {
            skipIt = true
        }
        if skipIt {
            if chunkSizePadded <= @intCast(u64, memDataSize(mem)) {
                if storeIt {
                    if !storeChunk(d, chunkStartOffset, CHUNK_HEADER_SIZE + @intCast(usize, chunkSize)) { return PARSE_ERROR }
                }
                skip(mem, @intCast(usize, chunkSizePadded))
            } else {
                status = PARSE_NEED_MORE_DATA
            }
        }
        if mem.*.start == mem.*.riffEnd {
            break
        } else if memDataSize(mem) < CHUNK_HEADER_SIZE {
            status = PARSE_NEED_MORE_DATA
        }
        if status != PARSE_OK { break }
    }
    return status
}

fn parseVP8X(d: *Demuxer) -> u8 {
    const mem = &d.*.mem
    if memDataSize(mem) < CHUNK_HEADER_SIZE { return PARSE_NEED_MORE_DATA }
    d.*.isExtFormat = true
    skip(mem, TAG_SIZE)
    var vp8xSize = readLE32(mem)
    if vp8xSize > decode.MAX_CHUNK_PAYLOAD { return PARSE_ERROR }
    if vp8xSize < VP8X_CHUNK_SIZE { return PARSE_ERROR }
    vp8xSize += vp8xSize & 1
    if sizeIsInvalid(mem, vp8xSize) { return PARSE_ERROR }
    if @intCast(u64, memDataSize(mem)) < vp8xSize { return PARSE_NEED_MORE_DATA }
    d.*.featureFlags = readByte(mem)
    skip(mem, 3)
    d.*.canvasWidth = 1 + @intCast(i64, readLE24s(mem))
    d.*.canvasHeight = 1 + @intCast(i64, readLE24s(mem))
    if @intCast(u64, d.*.canvasWidth) * @intCast(u64, d.*.canvasHeight) >= MAX_IMAGE_AREA { return PARSE_ERROR }
    skip(mem, @intCast(usize, vp8xSize - VP8X_CHUNK_SIZE))
    d.*.state = PARSED_HEADER
    if sizeIsInvalid(mem, @intCast(u64, CHUNK_HEADER_SIZE)) { return PARSE_ERROR }
    if memDataSize(mem) < CHUNK_HEADER_SIZE { return PARSE_NEED_MORE_DATA }
    return parseVP8XChunks(d)
}

fn isValidSimpleFormat(d: *Demuxer) -> bool {
    if d.*.state == PARSING_HEADER { return true }
    if d.*.canvasWidth <= 0 || d.*.canvasHeight <= 0 { return false }
    if d.*.state == DONE && d.*.frames == 0 { return false }
    const frame = frameAt(d.*.frames)
    if frame.*.width <= 0 || frame.*.height <= 0 { return false }
    return true
}

fn checkFrameBounds(frame: *Frame, exact: bool, canvasWidth: i64, canvasHeight: i64) -> bool {
    if exact {
        if frame.*.xOffset != 0 || frame.*.yOffset != 0 { return false }
        if frame.*.width != canvasWidth || frame.*.height != canvasHeight { return false }
    } else {
        if frame.*.xOffset < 0 || frame.*.yOffset < 0 { return false }
        if frame.*.width + frame.*.xOffset > canvasWidth { return false }
        if frame.*.height + frame.*.yOffset > canvasHeight { return false }
    }
    return true
}

fn isValidExtendedFormat(d: *Demuxer) -> bool {
    const isAnimation = (d.*.featureFlags & ANIMATION_FLAG) != 0
    var f = d.*.frames
    if d.*.state == PARSING_HEADER { return true }
    if d.*.canvasWidth <= 0 || d.*.canvasHeight <= 0 { return false }
    if d.*.loopCount < 0 { return false }
    if d.*.state == DONE && d.*.frames == 0 { return false }
    if (d.*.featureFlags & (0xffffffff ^ ALL_VALID_FLAGS)) != 0 { return false }
    while f != 0 {
        const curFrameSet = frameAt(f).*.frameNum
        while f != 0 && frameAt(f).*.frameNum == curFrameSet {
            const frame = frameAt(f)
            if !isAnimation && frame.*.frameNum > 1 { return false }
            if frame.*.complete {
                if frame.*.alphaSize == 0 && frame.*.imageSize == 0 { return false }
                if frame.*.alphaSize > 0 && frame.*.alphaOffset > frame.*.imageOffset { return false }
                if frame.*.width <= 0 || frame.*.height <= 0 { return false }
            } else {
                if d.*.state == DONE { return false }
                if frame.*.alphaSize > 0 && frame.*.imageSize > 0 && frame.*.alphaOffset > frame.*.imageOffset { return false }
                if frame.*.next != 0 { return false }
            }
            if frame.*.width > 0 && frame.*.height > 0 && !checkFrameBounds(frame, !isAnimation, d.*.canvasWidth, d.*.canvasHeight) { return false }
            f = frame.*.next
        }
    }
    return true
}

fn initDemux(d: *Demuxer, mem: *MemBuffer, allocator: Allocator) -> void {
    io.zero(@intFromPtr(d), @sizeOf(Demuxer))
    d.*.allocator = allocator
    d.*.state = PARSING_HEADER
    d.*.loopCount = 1
    d.*.bgcolor = 0xffffffff
    d.*.canvasWidth = 0 - 1
    d.*.canvasHeight = 0 - 1
    d.*.mem = mem.*
}

fn createRawImageDemuxer(mem: *MemBuffer, demuxer: *usize, allocator: Allocator) -> u8 {
    var features: io.Features = undefined
    const status = decode.getFeatures(mem.*.buf, mem.*.bufSize, &features)
    demuxer.* = 0
    if status != io.OK {
        if status == io.NOT_ENOUGH_DATA { return PARSE_NEED_MORE_DATA }
        return PARSE_ERROR
    }
    const address = io.allocateZeroed(allocator, @sizeOf(Demuxer))
    const frameAddress = io.allocateZeroed(allocator, @sizeOf(Frame))
    if address == 0 || frameAddress == 0 {
        io.release(allocator, address, @sizeOf(Demuxer))
        io.release(allocator, frameAddress, @sizeOf(Frame))
        return PARSE_ERROR
    }
    const d = demuxerAt(address)
    initDemux(d, mem, allocator)
    const frame = frameAt(frameAddress)
    setFrameInfo(0, mem.*.bufSize, 1, true, &features, frame)
    addFrame(d, frameAddress)
    d.*.state = DONE
    d.*.canvasWidth = frame.*.width
    d.*.canvasHeight = frame.*.height
    if frame.*.hasAlpha { d.*.featureFlags = d.*.featureFlags | ALPHA_FLAG }
    d.*.numFrames = 1
    demuxer.* = address
    return PARSE_OK
}

// WebPDemuxInternal: a demuxer of DATA (SIZE bytes, which must stay in
// place while it is used), or 0; STATE the WebPDemuxState. A file cut
// short is parsed as far as it goes when ALLOW_PARTIAL.
pub fn create(data: usize, size: usize, allowPartial: bool, state: *i32, allocator: Allocator) -> usize {
    state.* = PARSE_ERROR_STATE
    if data == 0 || size == 0 { return 0 }
    var mem: MemBuffer = undefined
    io.zero(@intFromPtr(&mem), @sizeOf(MemBuffer))
    mem.buf = data
    mem.end = size
    mem.bufSize = size
    var status = readHeader(&mem)
    if status != PARSE_OK {
        if status == PARSE_ERROR {
            var raw: usize = 0
            status = createRawImageDemuxer(&mem, &raw, allocator)
            if status == PARSE_OK {
                state.* = DONE
                return raw
            }
        }
        if status == PARSE_NEED_MORE_DATA {
            state.* = PARSING_HEADER
        } else {
            state.* = PARSE_ERROR_STATE
        }
        return 0
    }
    const partial = mem.bufSize < mem.riffEnd
    if !allowPartial && partial { return 0 }
    const address = io.allocateZeroed(allocator, @sizeOf(Demuxer))
    if address == 0 { return 0 }
    const d = demuxerAt(address)
    initDemux(d, &mem, allocator)
    status = PARSE_ERROR
    const at = d.*.mem.buf + d.*.mem.start
    var simple = false
    var known = false
    if decode.isTag(at, "VP8 ") || decode.isTag(at, "VP8L") {
        status = parseSingleImage(d)
        simple = true
        known = true
    } else if decode.isTag(at, "VP8X") {
        status = parseVP8X(d)
        known = true
    }
    if known {
        if status == PARSE_OK { d.*.state = DONE }
        if status == PARSE_NEED_MORE_DATA && !partial { status = PARSE_ERROR }
        if status != PARSE_ERROR {
            var valid = false
            if simple { valid = isValidSimpleFormat(d) } else { valid = isValidExtendedFormat(d) }
            if !valid { status = PARSE_ERROR }
        }
        if status == PARSE_ERROR { d.*.state = PARSE_ERROR_STATE }
    }
    state.* = d.*.state
    if status == PARSE_ERROR {
        delete(address)
        return 0
    }
    return address
}

// WebPDemuxDelete.
pub fn delete(address: usize) -> void {
    if address == 0 { return }
    const d = demuxerAt(address)
    const allocator = d.*.allocator
    var f = d.*.frames
    while f != 0 {
        const next = frameAt(f).*.next
        io.release(allocator, f, @sizeOf(Frame))
        f = next
    }
    var c = d.*.chunks
    while c != 0 {
        const next = chunkAt(c).*.next
        io.release(allocator, c, @sizeOf(Chunk))
        c = next
    }
    io.release(allocator, address, @sizeOf(Demuxer))
}

// WebPDemuxGetI.
pub fn getI(d: *Demuxer, feature: i32) -> u64 {
    if feature == FORMAT_FLAGS { return d.*.featureFlags }
    if feature == CANVAS_WIDTH { return @bitCast(u64, d.*.canvasWidth) & 0xffffffff }
    if feature == CANVAS_HEIGHT { return @bitCast(u64, d.*.canvasHeight) & 0xffffffff }
    if feature == LOOP_COUNT { return @bitCast(u64, d.*.loopCount) & 0xffffffff }
    if feature == BACKGROUND_COLOR { return d.*.bgcolor }
    if feature == FRAME_COUNT { return @bitCast(u64, d.*.numFrames) & 0xffffffff }
    return 0
}

fn findFrame(d: *Demuxer, frameNum: i64) -> usize {
    var f = d.*.frames
    while f != 0 {
        if frameAt(f).*.frameNum == frameNum { break }
        f = frameAt(f).*.next
    }
    return f
}

fn synthesizeFrame(d: *Demuxer, frame: *Frame, iter: *Iterator) -> bool {
    var startOffset = frame.*.imageOffset
    var payloadSize = frame.*.imageSize
    if frame.*.alphaSize > 0 {
        var interSize: usize = 0
        if frame.*.imageOffset > 0 { interSize = frame.*.imageOffset -% (frame.*.alphaOffset + frame.*.alphaSize) }
        startOffset = frame.*.alphaOffset
        payloadSize = payloadSize +% (frame.*.alphaSize +% interSize)
    }
    iter.*.frameNum = @intCast(i32, frame.*.frameNum)
    iter.*.numFrames = @intCast(i32, d.*.numFrames)
    iter.*.xOffset = @intCast(i32, frame.*.xOffset)
    iter.*.yOffset = @intCast(i32, frame.*.yOffset)
    iter.*.width = @intCast(i32, frame.*.width)
    iter.*.height = @intCast(i32, frame.*.height)
    iter.*.hasAlpha = 0
    if frame.*.hasAlpha { iter.*.hasAlpha = 1 }
    iter.*.duration = @intCast(i32, frame.*.duration)
    iter.*.disposeMethod = frame.*.disposeMethod
    iter.*.blendMethod = frame.*.blendMethod
    iter.*.complete = 0
    if frame.*.complete { iter.*.complete = 1 }
    iter.*.fragmentBytes = d.*.mem.buf + startOffset
    iter.*.fragmentSize = payloadSize
    return true
}

fn setFrame(frameNum: i64, iter: *Iterator) -> bool {
    if iter.*.demuxer == 0 || frameNum < 0 { return false }
    const d = demuxerAt(iter.*.demuxer)
    var n = frameNum
    if n > d.*.numFrames { return false }
    if n == 0 { n = d.*.numFrames }
    const frame = findFrame(d, n)
    if frame == 0 { return false }
    return synthesizeFrame(d, frameAt(frame), iter)
}

// WebPDemuxGetFrame: frame FRAME (1 the first, 0 the last) into ITER.
pub fn getFrame(demuxer: usize, frame: i64, iter: *Iterator) -> bool {
    io.zero(@intFromPtr(iter), @sizeOf(Iterator))
    iter.*.demuxer = demuxer
    return setFrame(frame, iter)
}

pub fn nextFrame(iter: *Iterator) -> bool { return setFrame(@intCast(i64, iter.*.frameNum) + 1, iter) }

pub fn prevFrame(iter: *Iterator) -> bool {
    if iter.*.frameNum <= 1 { return false }
    return setFrame(@intCast(i64, iter.*.frameNum) - 1, iter)
}

fn chunkCount(d: *Demuxer, fourcc: usize) -> i64 {
    var count: i64 = 0
    var c = d.*.chunks
    while c != 0 {
        const header = d.*.mem.buf + chunkAt(c).*.offset
        if get8(header) == get8(fourcc) && get8(header + 1) == get8(fourcc + 1) && get8(header + 2) == get8(fourcc + 2) && get8(header + 3) == get8(fourcc + 3) { count += 1 }
        c = chunkAt(c).*.next
    }
    return count
}

fn findChunk(d: *Demuxer, fourcc: usize, chunkNum: i64) -> usize {
    var count: i64 = 0
    var c = d.*.chunks
    while c != 0 {
        const header = d.*.mem.buf + chunkAt(c).*.offset
        if get8(header) == get8(fourcc) && get8(header + 1) == get8(fourcc + 1) && get8(header + 2) == get8(fourcc + 2) && get8(header + 3) == get8(fourcc + 3) { count += 1 }
        if count == chunkNum { break }
        c = chunkAt(c).*.next
    }
    return c
}

fn setChunk(fourcc: usize, chunkNum: i64, iter: *ChunkIterator) -> bool {
    if iter.*.demuxer == 0 || fourcc == 0 || chunkNum < 0 { return false }
    const d = demuxerAt(iter.*.demuxer)
    const count = chunkCount(d, fourcc)
    if count == 0 { return false }
    var n = chunkNum
    if n == 0 { n = count }
    if n <= count {
        const chunk = chunkAt(findChunk(d, fourcc, n))
        iter.*.chunkBytes = d.*.mem.buf + chunk.*.offset + CHUNK_HEADER_SIZE
        iter.*.chunkSize = chunk.*.size - CHUNK_HEADER_SIZE
        iter.*.numChunks = @intCast(i32, count)
        iter.*.chunkNum = @intCast(i32, n)
        return true
    }
    return false
}

// WebPDemuxGetChunk: chunk CHUNK_NUM (1 the first, 0 the last) of those
// tagged FOURCC (4 bytes at that address).
pub fn getChunk(demuxer: usize, fourcc: usize, chunkNum: i64, iter: *ChunkIterator) -> bool {
    io.zero(@intFromPtr(iter), @sizeOf(ChunkIterator))
    iter.*.demuxer = demuxer
    return setChunk(fourcc, chunkNum, iter)
}

pub fn nextChunk(iter: *ChunkIterator) -> bool {
    return setChunk(iter.*.chunkBytes - CHUNK_HEADER_SIZE, @intCast(i64, iter.*.chunkNum) + 1, iter)
}

pub fn prevChunk(iter: *ChunkIterator) -> bool {
    if iter.*.chunkNum <= 1 { return false }
    return setChunk(iter.*.chunkBytes - CHUNK_HEADER_SIZE, @intCast(i64, iter.*.chunkNum) - 1, iter)
}
