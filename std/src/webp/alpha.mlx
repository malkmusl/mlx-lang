// std.webp.alpha: the alpha plane of a lossy picture (its ALPH chunk),
// as libwebp 1.3.2's dec/alpha_dec.c decodes it: a header byte (the
// compression: none or lossless; the filter: none, horizontal, vertical
// or gradient; the pre-processing; two reserved bits), then the plane,
// raw or as a lossless image whose green channel holds it, unfiltered
// row by row as the VP8 decoder asks for its rows.
//
// The dequantization libwebp can apply to a plane its encoder
// quantized (alpha_dithering_strength) is not done; the default asks for
// none.
const io = @import("./io.mlx")
const vp8l = @import("./vp8l.mlx")

pub const Allocator = io.Allocator

const ALPHA_NO_COMPRESSION: u64 = 0
const ALPHA_LOSSLESS_COMPRESSION: u64 = 1
const ALPHA_PREPROCESSED_LEVELS: u64 = 1
const ALPHA_HEADER_LEN: usize = 1

// The VP8 decoder's part of it: the chunk, whether the plane is done,
// its decoder, the plane, its last row.
pub const State = struct {
    allocator: Allocator
    data: usize
    dataSize: usize
    isDecoded: bool
    decoder: usize
    planeMem: usize
    planeSize: usize
    plane: usize
    prevLine: usize
}

pub fn init(s: *State, allocator: Allocator) -> void {
    io.zero(@intFromPtr(s), @sizeOf(State))
    s.*.allocator = allocator
}

fn deleteDecoder(s: *State) -> void {
    if s.*.decoder != 0 {
        const a = vp8l.alphaDecoderAt(s.*.decoder)
        vp8l.delete(a.*.vp8lDec)
        a.*.vp8lDec = 0
        io.release(s.*.allocator, s.*.decoder, @sizeOf(vp8l.AlphaDecoder))
    }
    s.*.decoder = 0
}

// WebPDeallocateAlphaMemory.
pub fn deallocate(s: *State) -> void {
    io.release(s.*.allocator, s.*.planeMem, s.*.planeSize)
    s.*.planeMem = 0
    s.*.planeSize = 0
    s.*.plane = 0
    deleteDecoder(s)
}

// ALPHInit: the header read and the plane's decoder set up.
fn alphaInit(a: *vp8l.AlphaDecoder, data: usize, dataSize: usize, source: *io.Io, output: usize) -> bool {
    a.*.output = output
    a.*.width = source.*.width
    a.*.height = source.*.height
    if dataSize <= ALPHA_HEADER_LEN { return false }
    const header = io.get8(data)
    a.*.method = header & 0x03
    a.*.filter = (header >> 2) & 0x03
    a.*.preProcessing = (header >> 4) & 0x03
    const rsrv = (header >> 6) & 0x03
    if a.*.method > ALPHA_LOSSLESS_COMPRESSION || a.*.preProcessing > ALPHA_PREPROCESSED_LEVELS || rsrv != 0 { return false }
    io.initIo(&a.*.io)
    a.*.io.width = source.*.width
    a.*.io.height = source.*.height
    a.*.io.useCropping = source.*.useCropping
    a.*.io.cropLeft = source.*.cropLeft
    a.*.io.cropRight = source.*.cropRight
    a.*.io.cropTop = source.*.cropTop
    a.*.io.cropBottom = source.*.cropBottom
    if a.*.method == ALPHA_NO_COMPRESSION {
        return dataSize - ALPHA_HEADER_LEN >= @intCast(usize, a.*.width * a.*.height)
    }
    return vp8l.decodeAlphaHeader(a, data + ALPHA_HEADER_LEN, dataSize - ALPHA_HEADER_LEN)
}

// ALPHDecode: rows ROW to ROW + NUM_ROWS of the plane.
fn alphaDecode(s: *State, row: i64, numRows: i64) -> bool {
    const a = vp8l.alphaDecoderAt(s.*.decoder)
    const width = @intCast(usize, a.*.width)
    const height = a.*.io.cropBottom
    if a.*.method == ALPHA_NO_COMPRESSION {
        var prevLine = s.*.prevLine
        var deltas = s.*.data + ALPHA_HEADER_LEN + @intCast(usize, row) * width
        var dst = s.*.plane + @intCast(usize, row) * width
        var y: i64 = 0
        while y < numRows {
            if a.*.filter != vp8l.FILTER_NONE {
                vp8l.unfilter(a.*.filter, prevLine, deltas, dst, width)
            } else {
                io.copy(dst, deltas, width)
            }
            prevLine = dst
            dst += width
            deltas += width
            y += 1
        }
        s.*.prevLine = prevLine
    } else {
        if !vp8l.decodeAlphaImageStream(a, row + numRows) { return false }
    }
    if row + numRows >= height { s.*.isDecoded = true }
    return true
}

// VP8DecompressAlphaRows: the plane's rows ROW to ROW + NUM_ROWS decoded
// (the first call sets the decoder up); the address of row ROW, 0 when
// the plane cannot be decoded.
pub fn decompressRows(s: *State, i: *io.Io, row: i64, numRows: i64) -> usize {
    const width = i.*.width
    const height = i.*.cropBottom
    if row < 0 || numRows <= 0 || row + numRows > height { return 0 }
    if !s.*.isDecoded {
        var rows = numRows
        if s.*.decoder == 0 {
            s.*.decoder = io.allocateZeroed(s.*.allocator, @sizeOf(vp8l.AlphaDecoder))
            if s.*.decoder == 0 { return 0 }
            const a = vp8l.alphaDecoderAt(s.*.decoder)
            a.*.allocator = s.*.allocator
            s.*.planeSize = @intCast(usize, width * height)
            s.*.planeMem = io.allocate(s.*.allocator, s.*.planeSize)
            if s.*.planeMem == 0 {
                deallocate(s)
                return 0
            }
            s.*.plane = s.*.planeMem
            s.*.prevLine = 0
            if !alphaInit(a, s.*.data, s.*.dataSize, i, s.*.plane) {
                deallocate(s)
                return 0
            }
            if a.*.preProcessing == ALPHA_PREPROCESSED_LEVELS { rows = height - row }
        }
        if !alphaDecode(s, row, rows) {
            deallocate(s)
            return 0
        }
        if s.*.isDecoded { deleteDecoder(s) }
    }
    return s.*.plane + @intCast(usize, row * width)
}
