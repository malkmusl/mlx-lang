// std.webp.mux: WebP files put together and taken apart, as libwebp's
// muxer (1.3.2, src/mux) does it: a still picture or animation frames
// (each its ALPH and VP8/VP8L chunks, a frame its ANMF header: offset,
// duration, disposal, blending), the metadata chunks (ICCP, EXIF, XMP,
// others kept as they are), the animation's parameters (ANIM) and the
// canvas; assembled with a VP8X header when anything needs one, in the
// order the format wants. The muxer keeps copies of what it is given.
// Animations: std.webp.encode's AnimEncoder puts frames together here.
const io = @import("./io.mlx")
const vp8 = @import("./vp8.mlx")
const vp8l = @import("./vp8l.mlx")
const encode = @import("./encode.mlx")

pub const Allocator = io.Allocator

// WebPMuxError.
pub const OK: i32 = 1
pub const NOT_FOUND: i32 = 0
pub const INVALID_ARGUMENT: i32 = 0 - 1
pub const BAD_DATA: i32 = 0 - 2
pub const MEMORY_ERROR: i32 = 0 - 3
pub const NOT_ENOUGH_DATA: i32 = 0 - 4

// WebPChunkId.
pub const CHUNK_VP8X: i32 = 0
pub const CHUNK_ICCP: i32 = 1
pub const CHUNK_ANIM: i32 = 2
pub const CHUNK_ANMF: i32 = 3
pub const CHUNK_DEPRECATED: i32 = 4
pub const CHUNK_ALPHA: i32 = 5
pub const CHUNK_IMAGE: i32 = 6
pub const CHUNK_EXIF: i32 = 7
pub const CHUNK_XMP: i32 = 8
pub const CHUNK_UNKNOWN: i32 = 9
pub const CHUNK_NIL: i32 = 10

const ANIMATION_FLAG: u64 = 0x02
const XMP_FLAG: u64 = 0x04
const EXIF_FLAG: u64 = 0x08
const ALPHA_FLAG: u64 = 0x10
const ICCP_FLAG: u64 = 0x20
const MAX_CANVAS_SIZE: i64 = 16777216
const MAX_POSITION_OFFSET: i64 = 16777216
const MAX_DURATION: i64 = 16777216

// A picture or frame: its ANMF header (for a frame), its ALPH payload
// (0: none), its VP8 or VP8L payload, its size.
pub const Image = struct {
    isFrame: bool
    xOffset: i64
    yOffset: i64
    duration: i64
    disposeMethod: i32
    blendMethod: i32
    alpha: usize
    alphaSize: usize
    lossless: bool
    image: usize
    imageSize: usize
    width: i64
    height: i64
    hasAlpha: bool
    next: usize
}

// A chunk kept as it is: its tag (the four bytes, little-endian), its
// payload.
pub const Chunk = struct {
    tag: u64
    data: usize
    size: usize
    next: usize
}

pub const Mux = struct {
    allocator: Allocator
    images: usize
    iccp: usize
    exif: usize
    xmp: usize
    unknown: usize
    hasAnim: bool
    bgcolor: u64
    loopCount: i64
    canvasWidth: i64
    canvasHeight: i64
}

// WebPMuxFrameInfo.
pub const FrameInfo = struct {
    bitstreamBytes: usize
    bitstreamSize: usize
    xOffset: i32
    yOffset: i32
    duration: i32
    id: i32
    disposeMethod: i32
    blendMethod: i32
    pad: [1]u32
}

pub inline fn muxAt(address: usize) -> *Mux { return unsafe { @ptrFromInt(*Mux, address) } }
inline fn imageAt(address: usize) -> *Image { return unsafe { @ptrFromInt(*Image, address) } }
inline fn chunkAt(address: usize) -> *Chunk { return unsafe { @ptrFromInt(*Chunk, address) } }

inline fn getLE16(at: usize) -> u64 { return io.get8(at) | (io.get8(at + 1) << 8) }
inline fn getLE24(at: usize) -> u64 { return getLE16(at) | (io.get8(at + 2) << 16) }
inline fn getLE32(at: usize) -> u64 { return getLE16(at) | (getLE16(at + 2) << 16) }

pub fn tagOf(text: []const u8) -> u64 {
    return @intCast(u64, text[0]) | (@intCast(u64, text[1]) << 8) | (@intCast(u64, text[2]) << 16) | (@intCast(u64, text[3]) << 24)
}

pub fn create(allocator: Allocator) -> usize {
    const address = io.allocateZeroed(allocator, @sizeOf(Mux))
    if address == 0 { return 0 }
    const m = muxAt(address)
    m.*.allocator = allocator
    m.*.bgcolor = 0xffffffff
    m.*.loopCount = 0
    return address
}

fn copyOf(m: *Mux, data: usize, size: usize) -> usize {
    const copy = io.allocate(m.*.allocator, size)
    if copy != 0 { io.copy(copy, data, size) }
    return copy
}

fn freeImage(m: *Mux, address: usize) -> void {
    const image = imageAt(address)
    io.release(m.*.allocator, image.*.alpha, image.*.alphaSize)
    io.release(m.*.allocator, image.*.image, image.*.imageSize)
    io.release(m.*.allocator, address, @sizeOf(Image))
}

fn freeChunk(m: *Mux, address: usize) -> void {
    if address == 0 { return }
    io.release(m.*.allocator, chunkAt(address).*.data, chunkAt(address).*.size)
    io.release(m.*.allocator, address, @sizeOf(Chunk))
}

fn freeImages(m: *Mux) -> void {
    var at = m.*.images
    while at != 0 {
        const next = imageAt(at).*.next
        freeImage(m, at)
        at = next
    }
    m.*.images = 0
}

pub fn delete(address: usize) -> void {
    if address == 0 { return }
    const m = muxAt(address)
    freeImages(m)
    freeChunk(m, m.*.iccp)
    freeChunk(m, m.*.exif)
    freeChunk(m, m.*.xmp)
    var at = m.*.unknown
    while at != 0 {
        const next = chunkAt(at).*.next
        freeChunk(m, at)
        at = next
    }
    io.release(m.*.allocator, address, @sizeOf(Mux))
}

fn newChunk(m: *Mux, tag: u64, data: usize, size: usize) -> usize {
    const address = io.allocateZeroed(m.*.allocator, @sizeOf(Chunk))
    if address == 0 { return 0 }
    const copy = copyOf(m, data, size)
    if copy == 0 && size > 0 {
        io.release(m.*.allocator, address, @sizeOf(Chunk))
        return 0
    }
    chunkAt(address).*.tag = tag
    chunkAt(address).*.data = copy
    chunkAt(address).*.size = size
    return address
}

// The image's size and alpha, from its bitstream.
fn imageInfo(image: *Image) -> bool {
    var w: i64 = 0
    var h: i64 = 0
    if image.*.lossless {
        var alpha = false
        if !vp8l.getInfo(image.*.image, image.*.imageSize, &w, &h, &alpha) { return false }
        image.*.hasAlpha = alpha
    } else {
        if !vp8.getInfo(image.*.image, image.*.imageSize, image.*.imageSize, &w, &h) { return false }
        image.*.hasAlpha = image.*.alpha != 0
    }
    image.*.width = w
    image.*.height = h
    return true
}

// An image of a bitstream: a WebP file (its first picture's ALPH and
// VP8/VP8L chunks) or a raw VP8 or VP8L stream.
fn parseBitstream(m: *Mux, data: usize, size: usize, image: *Image) -> i32 {
    io.zero(@intFromPtr(image), @sizeOf(Image))
    var alpha: usize = 0
    var alphaSize: usize = 0
    var body: usize = 0
    var bodySize: usize = 0
    var lossless = false
    if size >= 12 && getLE32(data) == tagOf("RIFF") && getLE32(data + 8) == tagOf("WEBP") {
        var at = data + 12
        const end = data + size
        while at + 8 <= end {
            const tag = getLE32(at)
            const chunkSize = @intCast(usize, getLE32(at + 4))
            if at + 8 + chunkSize > end { return BAD_DATA }
            if tag == tagOf("ALPH") {
                alpha = at + 8
                alphaSize = chunkSize
            } else if tag == tagOf("VP8 ") || tag == tagOf("VP8L") {
                body = at + 8
                bodySize = chunkSize
                lossless = tag == tagOf("VP8L")
                break
            } else if tag == tagOf("ANMF") {
                return INVALID_ARGUMENT
            }
            at += 8 + chunkSize + (chunkSize & 1)
        }
        if body == 0 { return BAD_DATA }
    } else {
        body = data
        bodySize = size
        lossless = vp8l.checkSignature(data, size)
    }
    if lossless {
        alpha = 0
        alphaSize = 0
    }
    image.*.lossless = lossless
    image.*.image = copyOf(m, body, bodySize)
    image.*.imageSize = bodySize
    if image.*.image == 0 { return MEMORY_ERROR }
    if alpha != 0 {
        image.*.alpha = copyOf(m, alpha, alphaSize)
        image.*.alphaSize = alphaSize
        if image.*.alpha == 0 { return MEMORY_ERROR }
    }
    if !imageInfo(image) {
        io.release(m.*.allocator, image.*.image, image.*.imageSize)
        io.release(m.*.allocator, image.*.alpha, image.*.alphaSize)
        return BAD_DATA
    }
    return OK
}

fn addImage(m: *Mux, image: *Image) -> i32 {
    const address = io.allocate(m.*.allocator, @sizeOf(Image))
    if address == 0 { return MEMORY_ERROR }
    imageAt(address).* = image.*
    imageAt(address).*.next = 0
    if m.*.images == 0 {
        m.*.images = address
    } else {
        var last = m.*.images
        while imageAt(last).*.next != 0 { last = imageAt(last).*.next }
        imageAt(last).*.next = address
    }
    return OK
}

// WebPMuxSetImage: the still picture (the frames go).
pub fn setImage(m: *Mux, data: usize, size: usize) -> i32 {
    if data == 0 || size == 0 { return INVALID_ARGUMENT }
    var image: Image = undefined
    const status = parseBitstream(m, data, size, &image)
    if status != OK { return status }
    freeImages(m)
    return addImage(m, &image)
}

// WebPMuxPushFrame: a frame after the others.
pub fn pushFrame(m: *Mux, info: *FrameInfo) -> i32 {
    if info.*.id != CHUNK_ANMF { return INVALID_ARGUMENT }
    if info.*.bitstreamBytes == 0 || info.*.bitstreamSize == 0 { return INVALID_ARGUMENT }
    if m.*.images != 0 && !imageAt(m.*.images).*.isFrame { return INVALID_ARGUMENT }
    if info.*.xOffset < 0 || info.*.yOffset < 0 || @intCast(i64, info.*.xOffset) >= MAX_POSITION_OFFSET || @intCast(i64, info.*.yOffset) >= MAX_POSITION_OFFSET { return INVALID_ARGUMENT }
    if info.*.duration < 0 || @intCast(i64, info.*.duration) >= MAX_DURATION { return INVALID_ARGUMENT }
    if info.*.disposeMethod < 0 || info.*.disposeMethod > 1 || info.*.blendMethod < 0 || info.*.blendMethod > 1 { return INVALID_ARGUMENT }
    var image: Image = undefined
    const status = parseBitstream(m, info.*.bitstreamBytes, info.*.bitstreamSize, &image)
    if status != OK { return status }
    image.isFrame = true
    // (Offsets are stored halved.)
    image.xOffset = @intCast(i64, info.*.xOffset) & (0 - 2)
    image.yOffset = @intCast(i64, info.*.yOffset) & (0 - 2)
    image.duration = @intCast(i64, info.*.duration)
    image.disposeMethod = info.*.disposeMethod
    image.blendMethod = info.*.blendMethod
    return addImage(m, &image)
}

fn nthImage(m: *Mux, nth: u64) -> usize {
    var count: u64 = 0
    var at = m.*.images
    while at != 0 {
        count += 1
        at = imageAt(at).*.next
    }
    var n = nth
    if n == 0 { n = count }
    if n == 0 || n > count { return 0 }
    at = m.*.images
    var k: u64 = 1
    while k < n {
        at = imageAt(at).*.next
        k += 1
    }
    return at
}

// WebPMuxDeleteFrame.
pub fn deleteFrame(m: *Mux, nth: u64) -> i32 {
    const target = nthImage(m, nth)
    if target == 0 { return NOT_FOUND }
    if m.*.images == target {
        m.*.images = imageAt(target).*.next
    } else {
        var at = m.*.images
        while imageAt(at).*.next != target { at = imageAt(at).*.next }
        imageAt(at).*.next = imageAt(target).*.next
    }
    freeImage(m, target)
    return OK
}

// A WebP file of one image (with a VP8X header when it has an ALPH
// chunk), for WebPMuxGetFrame.
fn synthesize(image: *Image, out: *encode.Bytes) -> void {
    var size: usize = 4 + 8 + image.*.imageSize + (image.*.imageSize & 1)
    if image.*.alpha != 0 { size += 8 + 10 + 8 + image.*.alphaSize + (image.*.alphaSize & 1) }
    encode.appendTag(out, "RIFF")
    encode.appendLE32(out, @intCast(u64, size))
    encode.appendTag(out, "WEBP")
    if image.*.alpha != 0 {
        var vp8x: [10]u8 = undefined
        const at = @intFromPtr(&vp8x)
        io.put32(at, ALPHA_FLAG)
        putLE24(at + 4, @intCast(u64, image.*.width - 1))
        putLE24(at + 7, @intCast(u64, image.*.height - 1))
        encode.appendChunk(out, "VP8X", at, 10)
        encode.appendChunk(out, "ALPH", image.*.alpha, image.*.alphaSize)
    }
    if image.*.lossless {
        encode.appendChunk(out, "VP8L", image.*.image, image.*.imageSize)
    } else {
        encode.appendChunk(out, "VP8 ", image.*.image, image.*.imageSize)
    }
}

fn putLE24(at: usize, value: u64) -> void {
    io.put8(at, value)
    io.put8(at + 1, value >> 8)
    io.put8(at + 2, value >> 16)
}

// WebPMuxGetFrame: frame NTH (0: the last) as a file of its own (BYTES
// the caller's to free) and its parameters.
pub fn getFrame(m: *Mux, nth: u64, info: *FrameInfo) -> i32 {
    const at = nthImage(m, nth)
    if at == 0 { return NOT_FOUND }
    const image = imageAt(at)
    var out: encode.Bytes = undefined
    encode.initBytes(&out, m.*.allocator)
    synthesize(image, &out)
    if out.failed {
        encode.freeBytes(&out)
        return MEMORY_ERROR
    }
    io.zero(@intFromPtr(info), @sizeOf(FrameInfo))
    info.*.bitstreamBytes = out.data
    info.*.bitstreamSize = out.size
    if image.*.isFrame {
        info.*.id = CHUNK_ANMF
        info.*.xOffset = @intCast(i32, image.*.xOffset)
        info.*.yOffset = @intCast(i32, image.*.yOffset)
        info.*.duration = @intCast(i32, image.*.duration)
        info.*.disposeMethod = image.*.disposeMethod
        info.*.blendMethod = image.*.blendMethod
    } else {
        info.*.id = CHUNK_IMAGE
        info.*.duration = 1
    }
    return OK
}

fn reservedTag(tag: u64) -> bool {
    return tag == tagOf("VP8X") || tag == tagOf("ANIM") || tag == tagOf("ANMF") || tag == tagOf("ALPH") || tag == tagOf("VP8 ") || tag == tagOf("VP8L") || tag == tagOf("FRGM")
}

fn slotOf(m: *Mux, tag: u64) -> *usize {
    if tag == tagOf("ICCP") { return &m.*.iccp }
    if tag == tagOf("EXIF") { return &m.*.exif }
    if tag == tagOf("XMP ") { return &m.*.xmp }
    return &m.*.unknown
}

// WebPMuxSetChunk: a metadata chunk (replacing one of its tag).
pub fn setChunk(m: *Mux, tag: u64, data: usize, size: usize) -> i32 {
    if data == 0 { return INVALID_ARGUMENT }
    if reservedTag(tag) { return INVALID_ARGUMENT }
    deleteChunk(m, tag)
    const chunk = newChunk(m, tag, data, size)
    if chunk == 0 { return MEMORY_ERROR }
    const slot = slotOf(m, tag)
    if slot.* == 0 {
        slot.* = chunk
    } else {
        var last = slot.*
        while chunkAt(last).*.next != 0 { last = chunkAt(last).*.next }
        chunkAt(last).*.next = chunk
    }
    return OK
}

fn findChunk(m: *Mux, tag: u64) -> usize {
    var at = slotOf(m, tag).*
    while at != 0 {
        if chunkAt(at).*.tag == tag { return at }
        at = chunkAt(at).*.next
    }
    return 0
}

// WebPMuxGetChunk: the chunk's payload (the muxer's memory).
pub fn getChunk(m: *Mux, tag: u64, data: *usize, size: *usize) -> i32 {
    if reservedTag(tag) { return INVALID_ARGUMENT }
    const chunk = findChunk(m, tag)
    if chunk == 0 { return NOT_FOUND }
    data.* = chunkAt(chunk).*.data
    size.* = chunkAt(chunk).*.size
    return OK
}

pub fn deleteChunk(m: *Mux, tag: u64) -> i32 {
    if reservedTag(tag) { return INVALID_ARGUMENT }
    const slot = slotOf(m, tag)
    var found = false
    while slot.* != 0 && chunkAt(slot.*).*.tag == tag {
        const next = chunkAt(slot.*).*.next
        freeChunk(m, slot.*)
        slot.* = next
        found = true
    }
    var at = slot.*
    while at != 0 {
        const next = chunkAt(at).*.next
        if next != 0 && chunkAt(next).*.tag == tag {
            chunkAt(at).*.next = chunkAt(next).*.next
            freeChunk(m, next)
            found = true
        } else {
            at = next
        }
    }
    if found { return OK }
    return NOT_FOUND
}

pub fn setAnimationParams(m: *Mux, bgcolor: u64, loopCount: i64) -> i32 {
    if loopCount < 0 || loopCount >= 65536 { return INVALID_ARGUMENT }
    m.*.hasAnim = true
    m.*.bgcolor = bgcolor & 0xffffffff
    m.*.loopCount = loopCount
    return OK
}

pub fn setCanvasSize(m: *Mux, width: i64, height: i64) -> i32 {
    if width < 0 || height < 0 || width > MAX_CANVAS_SIZE || height > MAX_CANVAS_SIZE { return INVALID_ARGUMENT }
    if width * height >= 4294967296 { return INVALID_ARGUMENT }
    if (width * height) == 0 && (width | height) != 0 { return INVALID_ARGUMENT }
    m.*.canvasWidth = width
    m.*.canvasHeight = height
    return OK
}

// GetAdjustedCanvasSize: the frames' extent, or the picture's size.
pub fn canvasSize(m: *Mux, width: *i64, height: *i64) -> i32 {
    if m.*.images == 0 { return INVALID_ARGUMENT }
    const first = imageAt(m.*.images)
    if first.*.next != 0 || first.*.isFrame {
        var maxX: i64 = 0
        var maxY: i64 = 0
        var at = m.*.images
        while at != 0 {
            const image = imageAt(at)
            if image.*.xOffset + image.*.width > maxX { maxX = image.*.xOffset + image.*.width }
            if image.*.yOffset + image.*.height > maxY { maxY = image.*.yOffset + image.*.height }
            at = image.*.next
        }
        width.* = maxX
        height.* = maxY
    } else {
        width.* = first.*.width
        height.* = first.*.height
    }
    if m.*.canvasWidth != 0 || m.*.canvasHeight != 0 {
        if width.* > m.*.canvasWidth || height.* > m.*.canvasHeight { return INVALID_ARGUMENT }
        width.* = m.*.canvasWidth
        height.* = m.*.canvasHeight
    }
    return OK
}

fn frameCount(m: *Mux) -> i64 {
    var count: i64 = 0
    var at = m.*.images
    while at != 0 {
        if imageAt(at).*.isFrame { count += 1 }
        at = imageAt(at).*.next
    }
    return count
}

fn anyAlpha(m: *Mux) -> bool {
    var at = m.*.images
    while at != 0 {
        if imageAt(at).*.hasAlpha { return true }
        at = imageAt(at).*.next
    }
    return false
}

// The VP8X flags the file has.
pub fn features(m: *Mux) -> u64 {
    var flags: u64 = 0
    if m.*.iccp != 0 { flags = flags | ICCP_FLAG }
    if m.*.exif != 0 { flags = flags | EXIF_FLAG }
    if m.*.xmp != 0 { flags = flags | XMP_FLAG }
    if m.*.images != 0 && imageAt(m.*.images).*.isFrame { flags = flags | ANIMATION_FLAG }
    if anyAlpha(m) { flags = flags | ALPHA_FLAG }
    return flags
}

// WebPMuxNumChunks.
pub fn numChunks(m: *Mux, id: i32) -> i64 {
    if id == CHUNK_ICCP || id == CHUNK_EXIF || id == CHUNK_XMP || id == CHUNK_UNKNOWN {
        var at = m.*.unknown
        if id == CHUNK_ICCP { at = m.*.iccp }
        if id == CHUNK_EXIF { at = m.*.exif }
        if id == CHUNK_XMP { at = m.*.xmp }
        var count: i64 = 0
        while at != 0 {
            count += 1
            at = chunkAt(at).*.next
        }
        return count
    }
    if id == CHUNK_ANIM {
        if m.*.hasAnim { return 1 }
        return 0
    }
    if id == CHUNK_ANMF { return frameCount(m) }
    if id == CHUNK_VP8X {
        if features(m) != 0 || m.*.unknown != 0 { return 1 }
        return 0
    }
    var count: i64 = 0
    var at = m.*.images
    while at != 0 {
        if id == CHUNK_IMAGE { count += 1 }
        if id == CHUNK_ALPHA && imageAt(at).*.alpha != 0 { count += 1 }
        at = imageAt(at).*.next
    }
    return count
}

fn emitChunks(out: *encode.Bytes, at: usize) -> void {
    var c = at
    while c != 0 {
        const chunk = chunkAt(c)
        var tag: [4]u8 = undefined
        tag[0] = @intCast(u8, chunk.*.tag & 0xff)
        tag[1] = @intCast(u8, (chunk.*.tag >> 8) & 0xff)
        tag[2] = @intCast(u8, (chunk.*.tag >> 16) & 0xff)
        tag[3] = @intCast(u8, (chunk.*.tag >> 24) & 0xff)
        encode.appendBytes(out, @intFromPtr(&tag), 4)
        encode.appendLE32(out, @intCast(u64, chunk.*.size))
        encode.appendBytes(out, chunk.*.data, chunk.*.size)
        if (chunk.*.size & 1) != 0 { encode.appendByte(out, 0) }
        c = chunk.*.next
    }
}

fn padded(size: usize) -> usize { return size + (size & 1) }

fn imageDiskSize(image: *Image) -> usize {
    var size = 8 + padded(image.*.imageSize)
    if image.*.alpha != 0 { size += 8 + padded(image.*.alphaSize) }
    if image.*.isFrame { size += 8 + 16 }
    return size
}

fn emitImage(out: *encode.Bytes, image: *Image) -> void {
    if image.*.isFrame {
        encode.appendTag(out, "ANMF")
        encode.appendLE32(out, @intCast(u64, imageDiskSize(image) - 8))
        var header: [16]u8 = undefined
        const at = @intFromPtr(&header)
        putLE24(at, @intCast(u64, image.*.xOffset / 2))
        putLE24(at + 3, @intCast(u64, image.*.yOffset / 2))
        putLE24(at + 6, @intCast(u64, image.*.width - 1))
        putLE24(at + 9, @intCast(u64, image.*.height - 1))
        putLE24(at + 12, @intCast(u64, image.*.duration))
        var bits: u64 = 0
        if image.*.disposeMethod == 1 { bits = bits | 1 }
        if image.*.blendMethod == 1 { bits = bits | 2 }
        io.put8(at + 15, bits)
        encode.appendBytes(out, at, 16)
    }
    if image.*.alpha != 0 { encode.appendChunk(out, "ALPH", image.*.alpha, image.*.alphaSize) }
    if image.*.lossless {
        encode.appendChunk(out, "VP8L", image.*.image, image.*.imageSize)
    } else {
        encode.appendChunk(out, "VP8 ", image.*.image, image.*.imageSize)
    }
}

// WebPMuxAssemble: the file, into OUT.
pub fn assemble(m: *Mux, out: *encode.Bytes) -> i32 {
    if m.*.images == 0 { return INVALID_ARGUMENT }
    // MuxCleanup: one frame the size of the canvas is a still picture.
    if frameCount(m) == 1 {
        const frame = imageAt(m.*.images)
        if frame.*.isFrame && ((m.*.canvasWidth == 0 && m.*.canvasHeight == 0) || (frame.*.width == m.*.canvasWidth && frame.*.height == m.*.canvasHeight)) {
            frame.*.isFrame = false
            frame.*.xOffset = 0
            frame.*.yOffset = 0
        }
    }
    const animated = frameCount(m) > 0
    var flags = features(m)
    var width: i64 = 0
    var height: i64 = 0
    const status = canvasSize(m, &width, &height)
    if status != OK { return status }
    if width <= 0 || height <= 0 || width > MAX_CANVAS_SIZE || height > MAX_CANVAS_SIZE { return INVALID_ARGUMENT }
    // (MuxValidate.)
    if animated && !m.*.hasAnim { return INVALID_ARGUMENT }
    if !animated && imageAt(m.*.images).*.next != 0 { return INVALID_ARGUMENT }
    var size: usize = 12
    const vp8x = flags != 0 || m.*.unknown != 0
    if vp8x { size += 8 + 10 }
    var at = m.*.iccp
    while at != 0 {
        size += 8 + padded(chunkAt(at).*.size)
        at = chunkAt(at).*.next
    }
    if animated { size += 8 + 6 }
    at = m.*.images
    while at != 0 {
        size += imageDiskSize(imageAt(at))
        at = imageAt(at).*.next
    }
    var list: [3]usize = [3]usize{ m.*.exif, m.*.xmp, m.*.unknown }
    var k: usize = 0
    while k < 3 {
        at = list[k]
        while at != 0 {
            size += 8 + padded(chunkAt(at).*.size)
            at = chunkAt(at).*.next
        }
        k += 1
    }
    encode.appendTag(out, "RIFF")
    encode.appendLE32(out, @intCast(u64, size - 8))
    encode.appendTag(out, "WEBP")
    if vp8x {
        var chunk: [10]u8 = undefined
        const c = @intFromPtr(&chunk)
        io.put32(c, flags)
        putLE24(c + 4, @intCast(u64, width - 1))
        putLE24(c + 7, @intCast(u64, height - 1))
        encode.appendChunk(out, "VP8X", c, 10)
    }
    emitChunks(out, m.*.iccp)
    if animated {
        var anim: [6]u8 = undefined
        const a = @intFromPtr(&anim)
        io.put32(a, m.*.bgcolor)
        io.put8(a + 4, @intCast(u64, m.*.loopCount))
        io.put8(a + 5, @intCast(u64, m.*.loopCount) >> 8)
        encode.appendChunk(out, "ANIM", a, 6)
    }
    at = m.*.images
    while at != 0 {
        emitImage(out, imageAt(at))
        at = imageAt(at).*.next
    }
    emitChunks(out, m.*.exif)
    emitChunks(out, m.*.xmp)
    emitChunks(out, m.*.unknown)
    if out.*.failed { return MEMORY_ERROR }
    return OK
}

// WebPMuxCreate: a muxer holding the parts of the WebP file DATA.
pub fn createFrom(data: usize, size: usize, allocator: Allocator) -> usize {
    if data == 0 || size < 12 || getLE32(data) != tagOf("RIFF") || getLE32(data + 8) != tagOf("WEBP") { return 0 }
    const address = create(allocator)
    if address == 0 { return 0 }
    const m = muxAt(address)
    var riffEnd = 8 + @intCast(usize, getLE32(data + 4))
    if riffEnd > size { riffEnd = size }
    var at = data + 12
    const end = data + riffEnd
    var pendingAlpha: usize = 0
    var pendingAlphaSize: usize = 0
    var ok = true
    while at + 8 <= end {
        const tag = getLE32(at)
        const chunkSize = @intCast(usize, getLE32(at + 4))
        if at + 8 + chunkSize > end {
            ok = false
            break
        }
        const body = at + 8
        if tag == tagOf("VP8X") {
            if chunkSize >= 10 {
                m.*.canvasWidth = @intCast(i64, getLE24(body + 4)) + 1
                m.*.canvasHeight = @intCast(i64, getLE24(body + 7)) + 1
            }
        } else if tag == tagOf("ANIM") {
            if chunkSize >= 6 {
                m.*.hasAnim = true
                m.*.bgcolor = getLE32(body)
                m.*.loopCount = @intCast(i64, getLE16(body + 4))
            }
        } else if tag == tagOf("ANMF") {
            if chunkSize < 16 {
                ok = false
                break
            }
            var info: FrameInfo = undefined
            io.zero(@intFromPtr(&info), @sizeOf(FrameInfo))
            info.xOffset = @intCast(i32, getLE24(body) * 2)
            info.yOffset = @intCast(i32, getLE24(body + 3) * 2)
            info.duration = @intCast(i32, getLE24(body + 12))
            info.id = CHUNK_ANMF
            info.disposeMethod = @intCast(i32, io.get8(body + 15) & 1)
            info.blendMethod = @intCast(i32, (io.get8(body + 15) >> 1) & 1)
            // The frame's chunks as a little file of their own.
            var file: encode.Bytes = undefined
            encode.initBytes(&file, allocator)
            encode.appendTag(&file, "RIFF")
            encode.appendLE32(&file, @intCast(u64, 4 + chunkSize - 16))
            encode.appendTag(&file, "WEBP")
            encode.appendBytes(&file, body + 16, chunkSize - 16)
            info.bitstreamBytes = file.data
            info.bitstreamSize = file.size
            const status = pushFrame(m, &info)
            encode.freeBytes(&file)
            if status != OK {
                ok = false
                break
            }
        } else if tag == tagOf("ALPH") {
            pendingAlpha = at
            pendingAlphaSize = 8 + padded(chunkSize)
        } else if tag == tagOf("VP8 ") || tag == tagOf("VP8L") {
            var file: encode.Bytes = undefined
            encode.initBytes(&file, allocator)
            encode.appendTag(&file, "RIFF")
            encode.appendLE32(&file, @intCast(u64, 4 + pendingAlphaSize + 8 + padded(chunkSize)))
            encode.appendTag(&file, "WEBP")
            if pendingAlpha != 0 { encode.appendBytes(&file, pendingAlpha, pendingAlphaSize) }
            encode.appendBytes(&file, at, 8 + chunkSize)
            const status = setImage(m, file.data, file.size)
            encode.freeBytes(&file)
            if status != OK {
                ok = false
                break
            }
            pendingAlpha = 0
            pendingAlphaSize = 0
        } else {
            if setChunk(m, tag, body, chunkSize) != OK {
                ok = false
                break
            }
        }
        at += 8 + padded(chunkSize)
    }
    if !ok || m.*.images == 0 {
        delete(address)
        return 0
    }
    return address
}

// ---------------------------------------------------------------------------
// Animations

// A frame added to an animation: its file (std.webp.encode's) and when
// it starts.
const Frame = struct {
    data: usize
    size: usize
    timestamp: i64
    next: usize
}

// WebPAnimEncoder: frames of a canvas's size, each coded whole
// (losslessly), put together as an animation that loops LOOP_COUNT times
// (0: forever) on BGCOLOR.
pub const AnimEncoder = struct {
    allocator: Allocator
    width: i64
    height: i64
    loopCount: i64
    bgcolor: u64
    // The last frame's pixels: a frame the same as the one before only
    // makes it last longer (as libwebp's encoder merges them).
    previous: usize
    frames: usize
    count: i64
    endTimestamp: i64
    ended: bool
    failure: usize
}

pub inline fn animEncoderAt(address: usize) -> *AnimEncoder { return unsafe { @ptrFromInt(*AnimEncoder, address) } }
inline fn frameAt(address: usize) -> *Frame { return unsafe { @ptrFromInt(*Frame, address) } }

pub fn createAnimEncoder(width: i64, height: i64, loopCount: i64, bgcolor: u64, allocator: Allocator) -> usize {
    if width <= 0 || height <= 0 || width > 16383 || height > 16383 { return 0 }
    const address = io.allocateZeroed(allocator, @sizeOf(AnimEncoder))
    if address == 0 { return 0 }
    const enc = animEncoderAt(address)
    enc.*.allocator = allocator
    enc.*.width = width
    enc.*.height = height
    enc.*.loopCount = loopCount
    enc.*.bgcolor = bgcolor
    enc.*.failure = io.literal("")
    return address
}

fn canvasBytes(enc: *AnimEncoder) -> usize { return @intCast(usize, 4 * enc.*.width * enc.*.height) }

pub fn deleteAnimEncoder(address: usize) -> void {
    if address == 0 { return }
    const enc = animEncoderAt(address)
    io.release(enc.*.allocator, enc.*.previous, canvasBytes(enc))
    var at = enc.*.frames
    while at != 0 {
        const next = frameAt(at).*.next
        io.release(enc.*.allocator, frameAt(at).*.data, frameAt(at).*.size)
        io.release(enc.*.allocator, at, @sizeOf(Frame))
        at = next
    }
    io.release(enc.*.allocator, address, @sizeOf(AnimEncoder))
}

fn lastFrame(enc: *AnimEncoder) -> usize {
    var at = enc.*.frames
    if at == 0 { return 0 }
    while frameAt(at).*.next != 0 { at = frameAt(at).*.next }
    return at
}

// WebPAnimEncoderAdd: the frame ARGB (STRIDE words a row, the canvas's
// size) starting at TIMESTAMP; with ARGB 0, the end of the last frame.
pub fn addFrame(enc: *AnimEncoder, argb: usize, stride: usize, timestamp: i64) -> bool {
    if enc.*.ended {
        enc.*.failure = io.literal("ERROR adding frame: the animation has ended.")
        return false
    }
    const last = lastFrame(enc)
    if last != 0 && timestamp < frameAt(last).*.timestamp {
        enc.*.failure = io.literal("ERROR adding frame: timestamps must be non-decreasing.")
        return false
    }
    if argb == 0 {
        enc.*.ended = true
        enc.*.endTimestamp = timestamp
        return true
    }
    const w = @intCast(usize, enc.*.width)
    const h = @intCast(usize, enc.*.height)
    if enc.*.previous == 0 {
        enc.*.previous = io.allocate(enc.*.allocator, canvasBytes(enc))
        if enc.*.previous == 0 {
            enc.*.failure = io.literal("ERROR adding frame: out of memory.")
            return false
        }
    } else {
        var same = true
        var j: usize = 0
        while same && j < h {
            var i: usize = 0
            while i < w {
                if io.get32(argb + 4 * (j * stride + i)) != io.get32(enc.*.previous + 4 * (j * w + i)) {
                    same = false
                    break
                }
                i += 1
            }
            j += 1
        }
        if same { return true }
    }
    var row: usize = 0
    while row < h {
        io.copy(enc.*.previous + 4 * row * w, argb + 4 * row * stride, 4 * w)
        row += 1
    }
    var file: encode.Bytes = undefined
    encode.initBytes(&file, enc.*.allocator)
    if !encode.encodeFile(&file, argb, @intCast(usize, enc.*.width), @intCast(usize, enc.*.height), stride) {
        encode.freeBytes(&file)
        enc.*.failure = io.literal("ERROR encoding frame.")
        return false
    }
    const address = io.allocateZeroed(enc.*.allocator, @sizeOf(Frame))
    if address == 0 {
        encode.freeBytes(&file)
        enc.*.failure = io.literal("ERROR adding frame: out of memory.")
        return false
    }
    // (SIZE is the memory's, what freeing takes; the file's own length is
    // in its RIFF header.)
    frameAt(address).*.data = file.data
    frameAt(address).*.size = file.capacity
    frameAt(address).*.timestamp = timestamp
    frameAt(address).*.next = 0
    if last == 0 { enc.*.frames = address } else { frameAt(last).*.next = address }
    enc.*.count += 1
    return true
}

fn fileSize(data: usize) -> usize { return 8 + @intCast(usize, getLE32(data + 4)) }

// WebPAnimEncoderAssemble: the animation, into OUT.
pub fn assembleAnimation(enc: *AnimEncoder, out: *encode.Bytes) -> bool {
    if enc.*.frames == 0 {
        enc.*.failure = io.literal("ERROR assembling: no frames.")
        return false
    }
    const address = create(enc.*.allocator)
    if address == 0 { return false }
    const m = muxAt(address)
    var ok = setAnimationParams(m, enc.*.bgcolor, enc.*.loopCount) == OK
    ok = ok && setCanvasSize(m, enc.*.width, enc.*.height) == OK
    var at = enc.*.frames
    var previousDuration: i64 = 100
    while ok && at != 0 {
        const frame = frameAt(at)
        var duration = previousDuration
        if frame.*.next != 0 {
            duration = frameAt(frame.*.next).*.timestamp - frame.*.timestamp
        } else if enc.*.ended {
            duration = enc.*.endTimestamp - frame.*.timestamp
        }
        if duration >= MAX_DURATION { duration = MAX_DURATION - 1 }
        var info: FrameInfo = undefined
        io.zero(@intFromPtr(&info), @sizeOf(FrameInfo))
        info.bitstreamBytes = frame.*.data
        info.bitstreamSize = fileSize(frame.*.data)
        info.duration = @intCast(i32, duration)
        info.id = CHUNK_ANMF
        info.disposeMethod = 0
        info.blendMethod = 1
        ok = pushFrame(m, &info) == OK
        previousDuration = duration
        at = frame.*.next
    }
    ok = ok && assemble(m, out) == OK
    delete(address)
    if !ok { enc.*.failure = io.literal("ERROR assembling the animation.") }
    return ok
}
