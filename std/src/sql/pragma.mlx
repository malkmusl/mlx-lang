// std.sql.pragma: the PRAGMAs, answered as SQLite answers them (the same
// column names and values): journal_mode, page_size, page_count,
// max_page_count, freelist_count, user_version, application_id,
// schema_version, auto_vacuum, incremental_vacuum, synchronous,
// temp_store, cache_size, busy_timeout, foreign_keys, locking_mode,
// case_sensitive_like, encoding, table_info, table_xinfo, index_list,
// index_info, integrity_check, quick_check, wal_checkpoint,
// database_list, data_version, fullfsync and the others SQLite takes and
// ignores. An unknown PRAGMA is no error and returns nothing, as in SQLite.
//
// journal_mode=WAL is taken and reported ('wal'); the file keeps a
// rollback journal (the library's writers are the database's only ones
// while it is open; WAL's readers-beside-a-writer are not there).
// auto_vacuum: the file has no pointer map pages, so auto_vacuum stays
// NONE on disk; the INCREMENTAL asked for (and made by VACUUM) is noted in
// the header's incremental-vacuum field, which SQLite reads only with
// auto_vacuum on, and reported.
const mem = @import("./mem.mlx")
const value = @import("./value.mlx")
const record = @import("./record.mlx")
const numbers = @import("./numbers.mlx")
const ast = @import("./ast.mlx")
const schema = @import("./schema.mlx")
const core = @import("./core.mlx")
const pg = @import("./pager.mlx")
const eval = @import("./eval.mlx")
const functions = @import("./functions.mlx")
const integrity = @import("./integrity.mlx")

const Value = value.Value

fn databaseOf(st: *core.Statement) -> *core.Database { return core.database(st.*.db) }

fn pragmaName(node: *ast.Statement) -> []const u8 { return mem.view(node.*.name, node.*.nameLength) }

// The value given: as text, as an integer, as a boolean.
fn argumentText(st: *core.Statement, node: *ast.Statement, out: *Value) -> bool {
    if node.*.pragmaValue == 0 { return false }
    _ = eval.evaluate(st, node.*.pragmaValue, out)
    _ = value.toText(out)
    return true
}

fn isWordValue(v: *Value, word: []const u8) -> bool { return mem.sameNoCase(value.bytesOf(v), word) }

fn booleanOf(v: *Value) -> i64 {
    if isWordValue(v, "on") || isWordValue(v, "yes") || isWordValue(v, "true") { return 1 }
    if isWordValue(v, "off") || isWordValue(v, "no") || isWordValue(v, "false") { return 0 }
    return if value.toInt(v) != 0 { 1 } else { 0 }
}

// The result columns a PRAGMA has (set when the statement is prepared):
// names added to the statement.
fn columns(st: *core.Statement, names: []const u8) -> void {
    // Names separated by commas.
    var start: usize = 0
    var i: usize = 0
    while i <= names.length {
        if i == names.length || names[i] == 44 {
            _ = mem.push(&st.*.columnNames, @intCast(u64, ast.copyText(&st.*.arena, @intFromPtr(names.pointer) + start, i - start)))
            _ = mem.push(&st.*.columnNames, @intCast(u64, i - start))
            _ = mem.push(&st.*.columnTypes, 0)
            _ = mem.push(&st.*.columnTypes, 0)
            start = i + 1
        }
        i += 1
    }
    st.*.columnCount = st.*.columnNames.length / 2
}

// The columns of a PRAGMA's rows (when it has any): set at prepare time.
pub fn prepare(st: *core.Statement, address: usize) -> i32 {
    const node = ast.statement(address)
    const name = pragmaName(node)
    const setting = node.*.pragmaValue != 0
    if mem.sameNoCase(name, "table_info") {
        columns(st, "cid,name,type,notnull,dflt_value,pk")
    } else if mem.sameNoCase(name, "table_xinfo") {
        columns(st, "cid,name,type,notnull,dflt_value,pk,hidden")
    } else if mem.sameNoCase(name, "index_list") {
        columns(st, "seq,name,unique,origin,partial")
    } else if mem.sameNoCase(name, "index_info") {
        columns(st, "seqno,cid,name")
    } else if mem.sameNoCase(name, "foreign_key_list") {
        columns(st, "id,seq,table,from,to,on_update,on_delete,match")
    } else if mem.sameNoCase(name, "wal_checkpoint") {
        columns(st, "busy,log,checkpointed")
    } else if mem.sameNoCase(name, "database_list") {
        columns(st, "seq,name,file")
    } else if mem.sameNoCase(name, "busy_timeout") {
        columns(st, "timeout")
    } else if mem.sameNoCase(name, "journal_mode") || mem.sameNoCase(name, "locking_mode") || mem.sameNoCase(name, "integrity_check") || mem.sameNoCase(name, "quick_check") {
        columns(st, name)
    } else if mem.sameNoCase(name, "max_page_count") || mem.sameNoCase(name, "page_count") || mem.sameNoCase(name, "freelist_count") || mem.sameNoCase(name, "data_version") || mem.sameNoCase(name, "encoding") {
        columns(st, name)
    } else if !setting && (mem.sameNoCase(name, "page_size") || mem.sameNoCase(name, "user_version") || mem.sameNoCase(name, "application_id") || mem.sameNoCase(name, "schema_version") || mem.sameNoCase(name, "auto_vacuum") || mem.sameNoCase(name, "synchronous") || mem.sameNoCase(name, "temp_store") || mem.sameNoCase(name, "cache_size") || mem.sameNoCase(name, "foreign_keys") || mem.sameNoCase(name, "case_sensitive_like") || mem.sameNoCase(name, "recursive_triggers") || mem.sameNoCase(name, "secure_delete") || mem.sameNoCase(name, "fullfsync") || mem.sameNoCase(name, "mmap_size") || mem.sameNoCase(name, "cache_spill") || mem.sameNoCase(name, "query_only") || mem.sameNoCase(name, "cell_size_check") || mem.sameNoCase(name, "defer_foreign_keys") || mem.sameNoCase(name, "legacy_alter_table") || mem.sameNoCase(name, "trusted_schema") || mem.sameNoCase(name, "automatic_index") || mem.sameNoCase(name, "reverse_unordered_selects") || mem.sameNoCase(name, "threads") || mem.sameNoCase(name, "soft_heap_limit") || mem.sameNoCase(name, "hard_heap_limit") || mem.sameNoCase(name, "journal_size_limit") || mem.sameNoCase(name, "wal_autocheckpoint")) {
        columns(st, name)
    } else if setting && (mem.sameNoCase(name, "mmap_size") || mem.sameNoCase(name, "journal_size_limit") || mem.sameNoCase(name, "wal_autocheckpoint") || mem.sameNoCase(name, "threads") || mem.sameNoCase(name, "soft_heap_limit") || mem.sameNoCase(name, "hard_heap_limit")) {
        columns(st, name)
    }
    // Whether it needs a write transaction.
    node.*.writes = setting && (mem.sameNoCase(name, "user_version") || mem.sameNoCase(name, "application_id") || mem.sameNoCase(name, "schema_version") || mem.sameNoCase(name, "auto_vacuum"))
    return core.OK
}

fn newRow(st: *core.Statement) -> usize {
    if st.*.rows == 0 { st.*.rows = core.newRows(st.*.columnCount) }
    return core.addRow(st.*.rows)
}

fn intRow(st: *core.Statement, v: i64) -> void {
    const row = newRow(st)
    value.setInt(record.valueAt(row, 0), v)
}

fn textRow(st: *core.Statement, text: []const u8) -> void {
    const row = newRow(st)
    _ = value.setString(record.valueAt(row, 0), text)
}

pub fn journalModeName(mode: u8) -> []const u8 {
    return match mode {
        0 => "delete",
        1 => "persist",
        2 => "off",
        3 => "truncate",
        4 => "memory",
        5 => "wal",
        else => "delete",
    }
}

// Runs a PRAGMA: its rows (if any) into st.rows. The read (or write)
// transaction is open.
pub fn run(st: *core.Statement, address: usize) -> i32 {
    const node = ast.statement(address)
    const db = databaseOf(st)
    const p = &db.*.pager
    const name = pragmaName(node)
    var v: Value = undefined
    value.init(&v)
    const setting = argumentText(st, node, &v)
    var rc = core.OK
    core.clearRows(st.*.rows)
    if mem.sameNoCase(name, "journal_mode") {
        if setting {
            const mode = value.bytesOf(&v)
            var wanted: i64 = -1
            if mem.sameNoCase(mode, "delete") { wanted = 0 }
            if mem.sameNoCase(mode, "persist") { wanted = 1 }
            if mem.sameNoCase(mode, "off") { wanted = 2 }
            if mem.sameNoCase(mode, "truncate") { wanted = 3 }
            if mem.sameNoCase(mode, "memory") { wanted = 4 }
            if mem.sameNoCase(mode, "wal") { wanted = 5 }
            if wanted >= 0 && !p.*.memory {
                db.*.journalMode = @intCast(u8, wanted)
                p.*.journalMode = if wanted == 5 { pg.JOURNAL_DELETE } else { @intCast(u8, wanted) }
            }
        }
        textRow(st, if p.*.memory { "memory" } else { journalModeName(db.*.journalMode) })
    } else if mem.sameNoCase(name, "page_size") {
        if setting {
            const size = value.toInt(&v)
            if size >= 512 && size <= 65536 && (size & (size - 1)) == 0 {
                p.*.wantPageSize = @intCast(usize, size)
                if p.*.size == 0 { p.*.pageSize = @intCast(usize, size) }
            }
        } else {
            intRow(st, @intCast(i64, p.*.pageSize))
        }
    } else if mem.sameNoCase(name, "page_count") {
        intRow(st, @intCast(i64, p.*.size))
    } else if mem.sameNoCase(name, "freelist_count") {
        intRow(st, @intCast(i64, pg.headerGet(p, 36)))
    } else if mem.sameNoCase(name, "max_page_count") {
        if setting {
            var n = value.toInt(&v)
            if n < @intCast(i64, p.*.size) { n = @intCast(i64, p.*.size) }
            if n > 0 { db.*.maxPageCount = @intCast(u64, n) }
        }
        intRow(st, @intCast(i64, db.*.maxPageCount))
    } else if mem.sameNoCase(name, "user_version") || mem.sameNoCase(name, "application_id") || mem.sameNoCase(name, "schema_version") {
        const offset: usize = if mem.sameNoCase(name, "user_version") { 60 } else if mem.sameNoCase(name, "application_id") { 68 } else { 40 }
        if setting {
            if !pg.headerSet(p, offset, @bitCast(u64, value.toInt(&v)) & 0xffffffff) { rc = core.NOMEM }
            if offset == 40 { db.*.schema.loaded = false }
        } else {
            const raw = pg.headerGet(p, offset)
            // Signed 32-bit, as SQLite reads it.
            intRow(st, if raw >= 2147483648 { @intCast(i64, raw) - 4294967296 } else { @intCast(i64, raw) })
        }
    } else if mem.sameNoCase(name, "auto_vacuum") {
        if setting {
            var mode = value.toInt(&v)
            if isWordValue(&v, "none") { mode = 0 }
            if isWordValue(&v, "full") { mode = 1 }
            if isWordValue(&v, "incremental") { mode = 2 }
            db.*.autoVacuum = if mode >= 0 && mode <= 2 { @intCast(u8, mode) } else { 0 }
            // An empty database takes it at once (VACUUM otherwise).
            if pg.headerGet(p, 52) == 0 && emptyDatabase(db) && db.*.autoVacuum == 2 {
                if !pg.headerSet(p, 64, 1) { rc = core.NOMEM }
            }
        } else {
            intRow(st, if pg.headerGet(p, 64) != 0 { 2 } else { 0 })
        }
    } else if mem.sameNoCase(name, "incremental_vacuum") {
        // Nothing to give back without pointer maps.
    } else if mem.sameNoCase(name, "synchronous") {
        if setting {
            var level = value.toInt(&v)
            if isWordValue(&v, "off") { level = 0 }
            if isWordValue(&v, "normal") { level = 1 }
            if isWordValue(&v, "full") { level = 2 }
            if isWordValue(&v, "extra") { level = 3 }
            if level >= 0 && level <= 3 { p.*.synchronous = @intCast(u8, level) }
        } else {
            intRow(st, @intCast(i64, p.*.synchronous))
        }
    } else if mem.sameNoCase(name, "temp_store") {
        if setting {
            var mode = value.toInt(&v)
            if isWordValue(&v, "default") { mode = 0 }
            if isWordValue(&v, "file") { mode = 1 }
            if isWordValue(&v, "memory") { mode = 2 }
            if mode >= 0 && mode <= 2 { db.*.tempStore = @intCast(u8, mode) }
        } else {
            intRow(st, @intCast(i64, db.*.tempStore))
        }
    } else if mem.sameNoCase(name, "cache_size") {
        if setting {
            db.*.cacheSize = value.toInt(&v)
            const pages = if db.*.cacheSize < 0 { (0 - db.*.cacheSize) * 1024 / @intCast(i64, p.*.pageSize) } else { db.*.cacheSize }
            p.*.cacheLimit = if pages < 100 { 100 } else { @intCast(usize, pages) }
        } else {
            intRow(st, db.*.cacheSize)
        }
    } else if mem.sameNoCase(name, "busy_timeout") {
        if setting {
            const ms = value.toInt(&v)
            db.*.busyTimeout = if ms < 0 { 0 } else { ms }
        }
        intRow(st, db.*.busyTimeout)
    } else if mem.sameNoCase(name, "foreign_keys") {
        if setting {
            if db.*.autocommit { db.*.foreignKeys = booleanOf(&v) != 0 }
        } else {
            intRow(st, if db.*.foreignKeys { 1 } else { 0 })
        }
    } else if mem.sameNoCase(name, "case_sensitive_like") {
        if setting { db.*.caseSensitiveLike = booleanOf(&v) != 0 }
    } else if mem.sameNoCase(name, "locking_mode") {
        if setting {
            if isWordValue(&v, "exclusive") {
                p.*.lockingExclusive = true
            } else if isWordValue(&v, "normal") {
                p.*.lockingExclusive = false
            }
        }
        textRow(st, if p.*.lockingExclusive { "exclusive" } else { "normal" })
    } else if mem.sameNoCase(name, "encoding") {
        textRow(st, "UTF-8")
    } else if mem.sameNoCase(name, "data_version") {
        intRow(st, @intCast(i64, p.*.changeCounter & 0xffffffff) + 1)
    } else if mem.sameNoCase(name, "table_info") || mem.sameNoCase(name, "table_xinfo") {
        if setting {
            const t = schema.findTable(&db.*.schema, value.bytesOf(&v))
            if t != 0 {
                if st.*.rows == 0 { st.*.rows = core.newRows(st.*.columnCount) }
                functions.tableInfoRows(st, schema.table(t), st.*.rows)
            }
        }
    } else if mem.sameNoCase(name, "index_list") {
        if setting {
            const t = schema.findTable(&db.*.schema, value.bytesOf(&v))
            if t != 0 {
                if st.*.rows == 0 { st.*.rows = core.newRows(st.*.columnCount) }
                functions.indexListRows(schema.table(t), st.*.rows)
            }
        }
    } else if mem.sameNoCase(name, "index_info") {
        if setting {
            const x = schema.findIndex(&db.*.schema, value.bytesOf(&v))
            if x != 0 {
                if st.*.rows == 0 { st.*.rows = core.newRows(st.*.columnCount) }
                functions.indexInfoRows(schema.index(x), st.*.rows)
            }
        }
    } else if mem.sameNoCase(name, "integrity_check") || mem.sameNoCase(name, "quick_check") {
        if st.*.rows == 0 { st.*.rows = core.newRows(1) }
        rc = integrity.check(st, st.*.rows)
    } else if mem.sameNoCase(name, "wal_checkpoint") {
        const row = newRow(st)
        const wal = db.*.journalMode == pg.JOURNAL_WAL
        value.setInt(record.valueAt(row, 0), 0)
        value.setInt(record.valueAt(row, 1), if wal { 0 } else { -1 })
        value.setInt(record.valueAt(row, 2), if wal { 0 } else { -1 })
    } else if mem.sameNoCase(name, "database_list") {
        const row = newRow(st)
        value.setInt(record.valueAt(row, 0), 0)
        _ = value.setString(record.valueAt(row, 1), "main")
        _ = value.setText(record.valueAt(row, 2), db.*.path, if p.*.memory { 0 } else { db.*.pathLength })
    } else if !setting && st.*.columnCount == 1 {
        // The pragmas SQLite keeps a value for that changes nothing here.
        if mem.sameNoCase(name, "mmap_size") || mem.sameNoCase(name, "secure_delete") || mem.sameNoCase(name, "recursive_triggers") || mem.sameNoCase(name, "fullfsync") || mem.sameNoCase(name, "query_only") || mem.sameNoCase(name, "cell_size_check") || mem.sameNoCase(name, "defer_foreign_keys") || mem.sameNoCase(name, "legacy_alter_table") || mem.sameNoCase(name, "reverse_unordered_selects") || mem.sameNoCase(name, "threads") || mem.sameNoCase(name, "soft_heap_limit") || mem.sameNoCase(name, "hard_heap_limit") {
            intRow(st, 0)
        } else if mem.sameNoCase(name, "trusted_schema") || mem.sameNoCase(name, "automatic_index") || mem.sameNoCase(name, "cache_spill") {
            intRow(st, 1)
        } else if mem.sameNoCase(name, "journal_size_limit") {
            intRow(st, -1)
        } else if mem.sameNoCase(name, "wal_autocheckpoint") {
            intRow(st, 1000)
        }
    } else if setting && st.*.columnCount == 1 {
        intRow(st, value.toInt(&v))
    }
    value.release(&v)
    return rc
}

fn emptyDatabase(db: *core.Database) -> bool { return db.*.schema.tables.length == 0 }
