// std.sql.dates: SQLite's date and time functions: date(), time(),
// datetime(), julianday(), unixepoch(), strftime() and CURRENT_DATE,
// CURRENT_TIME, CURRENT_TIMESTAMP. Times are held as SQLite holds them, a
// Julian day number in milliseconds; a time value is 'now', an ISO-8601
// text (YYYY-MM-DD, with HH:MM[:SS[.SSS]] and a time zone or not; or HH:MM
// alone, on 2000-01-01), or a number (a Julian day, or Unix seconds with
// 'unixepoch' or 'auto'), changed by modifiers: ±N days, hours, minutes,
// seconds, months, years; start of day, month, year; weekday N;
// unixepoch, julianday, auto; utc and localtime (both the same here: the
// time is UTC).
const mem = @import("./mem.mlx")
const value = @import("./value.mlx")
const record = @import("./record.mlx")
const numbers = @import("./numbers.mlx")
const core = @import("./core.mlx")
const os = @import("./os.mlx")

const Value = value.Value

const DateTime = struct {
    // Julian day in milliseconds.
    jd: i64
    year: i64
    month: i64
    day: i64
    hour: i64
    minute: i64
    second: f64
    validJD: bool
    validYMD: bool
    validHMS: bool
    // The value was a number (for 'unixepoch' and 'auto').
    rawNumber: bool
    raw: f64
    failed: bool
}

fn floorMod(a: i64, b: i64) -> i64 {
    const r = a % b
    return if r < 0 { r + b } else { r }
}

fn computeJD(d: *DateTime) -> void {
    if d.*.validJD { return }
    var y = d.*.year
    var m = d.*.month
    if !d.*.validYMD {
        y = 2000
        m = 1
        d.*.day = 1
    }
    if m <= 2 {
        y -= 1
        m += 12
    }
    const a = y / 100
    const b = 2 - a + a / 4
    const x1 = 36525 * (y + 4716) / 100
    const x2 = 306001 * (m + 1) / 10000
    const days = @floatFromInt(f64, x1 + x2 + d.*.day + b) - 1524.5
    d.*.jd = @intFromFloat(i64, days * 86400000.0)
    if d.*.validHMS {
        d.*.jd += d.*.hour * 3600000 + d.*.minute * 60000 + @intFromFloat(i64, d.*.second * 1000.0 + 0.5)
    }
    d.*.validJD = true
}

fn computeYMD(d: *DateTime) -> void {
    if d.*.validYMD { return }
    if !d.*.validJD {
        d.*.year = 2000
        d.*.month = 1
        d.*.day = 1
    } else {
        const z = (d.*.jd + 43200000) / 86400000
        var a = @intFromFloat(i64, (@floatFromInt(f64, z) - 1867216.25) / 36524.25)
        a = z + 1 + a - (a / 4)
        const b = a + 1524
        const c = @intFromFloat(i64, (@floatFromInt(f64, b) - 122.1) / 365.25)
        const dd = (36525 * (c & 32767)) / 100
        const e = @intFromFloat(i64, @floatFromInt(f64, b - dd) / 30.6001)
        const x1 = @intFromFloat(i64, 30.6001 * @floatFromInt(f64, e))
        d.*.day = b - dd - x1
        d.*.month = if e < 14 { e - 1 } else { e - 13 }
        d.*.year = if d.*.month > 2 { c - 4716 } else { c - 4715 }
    }
    d.*.validYMD = true
}

fn computeHMS(d: *DateTime) -> void {
    if d.*.validHMS { return }
    computeJD(d)
    const dayMs = floorMod(d.*.jd + 43200000, 86400000)
    var s = @floatFromInt(f64, dayMs) / 1000.0
    const whole = @intFromFloat(i64, s)
    d.*.hour = whole / 3600
    d.*.minute = (whole / 60) % 60
    s -= @floatFromInt(f64, whole - whole % 60)
    d.*.second = s
    d.*.validHMS = true
}

fn now(d: *DateTime) -> void {
    d.*.jd = os.nowMilliseconds() + 210866760000000
    d.*.validJD = true
}

fn digitsAt(text: usize, length: usize, at: usize, count: usize, out: *i64) -> bool {
    if at + count > length { return false }
    var v: i64 = 0
    var i: usize = 0
    while i < count {
        const c = mem.get8(text + at + i)
        if !numbers.isDigit(c) { return false }
        v = v * 10 + @intCast(i64, c - 48)
        i += 1
    }
    out.* = v
    return true
}

// HH:MM[:SS[.SSS]] at `at`: its length, 0 when there is none.
fn parseTime(text: usize, length: usize, at: usize, d: *DateTime) -> usize {
    var h: i64 = 0
    var m: i64 = 0
    if !digitsAt(text, length, at, 2, &h) || at + 2 >= length || mem.get8(text + at + 2) != 58 || !digitsAt(text, length, at + 3, 2, &m) { return 0 }
    var i = at + 5
    var s: f64 = 0.0
    if i < length && mem.get8(text + i) == 58 {
        var whole: i64 = 0
        if !digitsAt(text, length, i + 1, 2, &whole) { return 0 }
        s = @floatFromInt(f64, whole)
        i += 3
        if i < length && mem.get8(text + i) == 46 && i + 1 < length && numbers.isDigit(mem.get8(text + i + 1)) {
            i += 1
            var scale: f64 = 0.1
            while i < length && numbers.isDigit(mem.get8(text + i)) {
                s += scale * @floatFromInt(f64, mem.get8(text + i) - 48)
                scale = scale / 10.0
                i += 1
            }
        }
    }
    if h > 24 || m > 59 || s >= 60.0 { return 0 }
    d.*.hour = h
    d.*.minute = m
    d.*.second = s
    d.*.validHMS = true
    // A time zone: Z or ±HH:MM.
    while i < length && mem.get8(text + i) == 32 { i += 1 }
    if i < length && (mem.get8(text + i) == 90 || mem.get8(text + i) == 122) {
        i += 1
    } else if i < length && (mem.get8(text + i) == 43 || mem.get8(text + i) == 45) {
        const sign: i64 = if mem.get8(text + i) == 45 { -1 } else { 1 }
        var zh: i64 = 0
        var zm: i64 = 0
        if digitsAt(text, length, i + 1, 2, &zh) && i + 3 < length && mem.get8(text + i + 3) == 58 && digitsAt(text, length, i + 4, 2, &zm) {
            computeJD(d)
            d.*.jd -= sign * (zh * 60 + zm) * 60000
            d.*.validYMD = false
            d.*.validHMS = false
            i += 6
        }
    }
    return i - at
}

// A time value: OK, or `failed` set.
fn parseValue(v: *Value, d: *DateTime) -> void {
    if v.*.kind == value.INTEGER || v.*.kind == value.REAL {
        d.*.rawNumber = true
        d.*.raw = value.toReal(v)
        d.*.jd = @intFromFloat(i64, d.*.raw * 86400000.0 + 0.5)
        d.*.validJD = d.*.raw >= 0.0 && d.*.raw < 5373484.5
        if !d.*.validJD { d.*.failed = !d.*.rawNumber }
        return
    }
    if v.*.kind != value.TEXT {
        d.*.failed = true
        return
    }
    const text = v.*.data
    const length = v.*.length
    var start: usize = 0
    while start < length && mem.get8(text + start) == 32 { start += 1 }
    var end = length
    while end > start && mem.get8(text + end - 1) == 32 { end -= 1 }
    if mem.sameNoCase(mem.view(text + start, end - start), "now") {
        now(d)
        return
    }
    var y: i64 = 0
    var m: i64 = 0
    var day: i64 = 0
    var at = start
    var negative = false
    if at < end && mem.get8(text + at) == 45 {
        negative = true
        at += 1
    }
    if digitsAt(text, end, at, 4, &y) && at + 4 < end && mem.get8(text + at + 4) == 45 && digitsAt(text, end, at + 5, 2, &m) && at + 7 < end && mem.get8(text + at + 7) == 45 && digitsAt(text, end, at + 8, 2, &day) {
        if m < 1 || m > 12 || day < 1 || day > 31 {
            d.*.failed = true
            return
        }
        d.*.year = if negative { 0 - y } else { y }
        d.*.month = m
        d.*.day = day
        d.*.validYMD = true
        at += 10
        if at < end && (mem.get8(text + at) == 32 || mem.get8(text + at) == 84 || mem.get8(text + at) == 116) {
            at += 1
            while at < end && mem.get8(text + at) == 32 { at += 1 }
            const used = parseTime(text, end, at, d)
            if used == 0 {
                d.*.failed = true
                return
            }
            at += used
        }
        if at != end { d.*.failed = true }
        if !d.*.validJD { computeJD(d) }
        return
    }
    const used = parseTime(text, end, start, d)
    if used > 0 && start + used == end {
        if !d.*.validJD {
            d.*.validYMD = false
            computeJD(d)
        }
        return
    }
    // A number in text.
    var p: numbers.Parsed = undefined
    numbers.parse(text + start, end - start, &p)
    if p.kind != numbers.NOT_NUMBER && p.whole {
        d.*.rawNumber = true
        d.*.raw = p.real
        d.*.jd = @intFromFloat(i64, p.real * 86400000.0 + 0.5)
        d.*.validJD = true
        return
    }
    d.*.failed = true
}

fn clearComputed(d: *DateTime) -> void {
    d.*.validYMD = false
    d.*.validHMS = false
}

// Applies one modifier.
fn modify(d: *DateTime, v: *Value, first: bool) -> void {
    _ = value.toText(v)
    var text = mem.view(v.*.data, v.*.length)
    while text.length > 0 && text[text.length - 1] == 32 { text = text[0..text.length - 1] }
    if mem.sameNoCase(text, "unixepoch") {
        if first && d.*.rawNumber {
            d.*.jd = @intFromFloat(i64, d.*.raw * 1000.0) + 210866760000000
            d.*.validJD = true
            clearComputed(d)
            return
        }
        d.*.failed = true
        return
    }
    if mem.sameNoCase(text, "julianday") || mem.sameNoCase(text, "localtime") || mem.sameNoCase(text, "utc") || mem.sameNoCase(text, "subsec") || mem.sameNoCase(text, "subsecond") {
        return
    }
    if mem.sameNoCase(text, "auto") {
        if first && d.*.rawNumber && (d.*.raw < 0.0 || d.*.raw > 5373484.5) {
            d.*.jd = @intFromFloat(i64, d.*.raw * 1000.0) + 210866760000000
            d.*.validJD = true
            clearComputed(d)
        }
        return
    }
    if mem.startsNoCase(text, "start of ") {
        computeYMD(d)
        const what = text[9..]
        d.*.hour = 0
        d.*.minute = 0
        d.*.second = 0.0
        d.*.validHMS = true
        if mem.sameNoCase(what, "month") {
            d.*.day = 1
        } else if mem.sameNoCase(what, "year") {
            d.*.day = 1
            d.*.month = 1
        } else if !mem.sameNoCase(what, "day") {
            d.*.failed = true
            return
        }
        d.*.validJD = false
        computeJD(d)
        return
    }
    if mem.startsNoCase(text, "weekday ") {
        var p: numbers.Parsed = undefined
        numbers.parse(@intFromPtr(text.pointer) + 8, text.length - 8, &p)
        if p.kind != numbers.INTEGER || p.integer < 0 || p.integer > 6 {
            d.*.failed = true
            return
        }
        computeJD(d)
        var z = floorMod((d.*.jd + 129600000) / 86400000, 7)
        if z > p.integer { z -= 7 }
        d.*.jd += (p.integer - z) * 86400000
        clearComputed(d)
        return
    }
    // ±N unit.
    var i: usize = 0
    while i < text.length && text[i] != 32 { i += 1 }
    var p: numbers.Parsed = undefined
    numbers.parse(@intFromPtr(text.pointer), i, &p)
    if p.kind == numbers.NOT_NUMBER || !p.whole {
        d.*.failed = true
        return
    }
    while i < text.length && text[i] == 32 { i += 1 }
    var unit = text[i..]
    if unit.length > 1 && (unit[unit.length - 1] == 115 || unit[unit.length - 1] == 83) { unit = unit[0..unit.length - 1] }
    const amount = p.real
    computeJD(d)
    if mem.sameNoCase(unit, "day") {
        d.*.jd += @intFromFloat(i64, amount * 86400000.0)
    } else if mem.sameNoCase(unit, "hour") {
        d.*.jd += @intFromFloat(i64, amount * 3600000.0)
    } else if mem.sameNoCase(unit, "minute") {
        d.*.jd += @intFromFloat(i64, amount * 60000.0)
    } else if mem.sameNoCase(unit, "second") {
        d.*.jd += @intFromFloat(i64, amount * 1000.0)
    } else if mem.sameNoCase(unit, "month") || mem.sameNoCase(unit, "year") {
        computeYMD(d)
        computeHMS(d)
        const whole = @intFromFloat(i64, amount)
        if mem.sameNoCase(unit, "month") {
            var m = d.*.month + whole
            var y = d.*.year
            while m > 12 {
                m -= 12
                y += 1
            }
            while m < 1 {
                m += 12
                y -= 1
            }
            d.*.month = m
            d.*.year = y
        } else {
            d.*.year += whole
        }
        d.*.validJD = false
        computeJD(d)
        clearComputed(d)
        return
    } else {
        d.*.failed = true
        return
    }
    clearComputed(d)
}

fn two(b: *mem.Buffer, n: i64) -> void {
    _ = mem.appendByte(b, 48 + @bitCast(u64, (n / 10) % 10))
    _ = mem.appendByte(b, 48 + @bitCast(u64, n % 10))
}

fn four(b: *mem.Buffer, n: i64) -> void {
    var v = n
    if v < 0 {
        _ = mem.appendByte(b, 45)
        v = 0 - v
    }
    _ = mem.appendByte(b, 48 + @bitCast(u64, (v / 1000) % 10))
    _ = mem.appendByte(b, 48 + @bitCast(u64, (v / 100) % 10))
    two(b, v % 100)
}

fn appendDate(b: *mem.Buffer, d: *DateTime) -> void {
    computeYMD(d)
    four(b, d.*.year)
    _ = mem.appendByte(b, 45)
    two(b, d.*.month)
    _ = mem.appendByte(b, 45)
    two(b, d.*.day)
}

fn appendTime(b: *mem.Buffer, d: *DateTime) -> void {
    computeHMS(d)
    two(b, d.*.hour)
    _ = mem.appendByte(b, 58)
    two(b, d.*.minute)
    _ = mem.appendByte(b, 58)
    two(b, @intFromFloat(i64, d.*.second))
}

fn strftime(b: *mem.Buffer, format: *Value, d: *DateTime) -> void {
    _ = value.toText(format)
    var i: usize = 0
    while i < format.*.length {
        const c = mem.get8(format.*.data + i)
        if c != 37 || i + 1 >= format.*.length {
            _ = mem.appendByte(b, c)
            i += 1
            continue
        }
        const f = mem.get8(format.*.data + i + 1)
        i += 2
        if f == 100 {
            computeYMD(d)
            two(b, d.*.day)
        } else if f == 109 {
            computeYMD(d)
            two(b, d.*.month)
        } else if f == 89 {
            computeYMD(d)
            four(b, d.*.year)
        } else if f == 72 {
            computeHMS(d)
            two(b, d.*.hour)
        } else if f == 77 {
            computeHMS(d)
            two(b, d.*.minute)
        } else if f == 83 {
            computeHMS(d)
            two(b, @intFromFloat(i64, d.*.second))
        } else if f == 102 {
            computeHMS(d)
            var s = d.*.second
            if s > 59.999 { s = 59.999 }
            const ms = @intFromFloat(i64, s * 1000.0 + 0.5)
            two(b, ms / 1000)
            _ = mem.appendByte(b, 46)
            _ = mem.appendByte(b, 48 + @bitCast(u64, (ms / 100) % 10))
            two(b, ms % 100)
        } else if f == 115 {
            computeJD(d)
            _ = mem.appendDecimal(b, d.*.jd / 1000 - 210866760000)
        } else if f == 74 {
            computeJD(d)
            _ = numbers.appendReal(b, @floatFromInt(f64, d.*.jd) / 86400000.0)
        } else if f == 119 {
            computeJD(d)
            _ = mem.appendDecimal(b, floorMod((d.*.jd + 129600000) / 86400000, 7))
        } else if f == 106 {
            computeYMD(d)
            var start: DateTime = undefined
            start = d.*
            start.month = 1
            start.day = 1
            start.validJD = false
            start.validHMS = false
            computeJD(&start)
            computeJD(d)
            const n = (d.*.jd - start.jd + 43200000) / 86400000 + 1
            _ = mem.appendByte(b, 48 + @bitCast(u64, (n / 100) % 10))
            two(b, n % 100)
        } else if f == 37 {
            _ = mem.appendByte(b, 37)
        } else {
            _ = mem.appendByte(b, 37)
            _ = mem.appendByte(b, f)
        }
    }
}

// date() ... strftime() and the CURRENT_ ones (`which` 0 to 8).
pub fn call(st: *core.Statement, which: u32, args: usize, n: usize, out: *Value) -> i32 {
    var d: DateTime = undefined
    d.jd = 0
    d.validJD = false
    d.validYMD = false
    d.validHMS = false
    d.rawNumber = false
    d.raw = 0.0
    d.failed = false
    var first: usize = 0
    var format: usize = 0
    if which == 5 {
        if n < 1 {
            value.setNull(out)
            return core.OK
        }
        format = args
        first = 1
    }
    if which >= 6 || n <= first {
        now(&d)
    } else {
        const v = record.valueAt(args, first)
        if v.*.kind == value.NULL {
            value.setNull(out)
            return core.OK
        }
        parseValue(v, &d)
        var i = first + 1
        while i < n && !d.failed {
            const m = record.valueAt(args, i)
            if m.*.kind == value.NULL {
                value.setNull(out)
                return core.OK
            }
            modify(&d, m, i == first + 1)
            i += 1
        }
    }
    if d.failed || !d.validJD && !d.validYMD {
        value.setNull(out)
        return core.OK
    }
    computeJD(&d)
    if d.jd < 0 || d.jd > 464269060799999 {
        value.setNull(out)
        return core.OK
    }
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    if which == 0 || which == 7 {
        appendDate(&b, &d)
    } else if which == 1 || which == 8 {
        appendTime(&b, &d)
    } else if which == 2 || which == 6 {
        appendDate(&b, &d)
        _ = mem.appendByte(&b, 32)
        appendTime(&b, &d)
    } else if which == 3 {
        value.setReal(out, @floatFromInt(f64, d.jd) / 86400000.0)
        mem.freeBuffer(&b)
        return core.OK
    } else if which == 4 {
        value.setInt(out, d.jd / 1000 - 210866760000)
        mem.freeBuffer(&b)
        return core.OK
    } else {
        strftime(&b, record.valueAt(format, 0), &d)
    }
    _ = value.setText(out, b.data, b.length)
    mem.freeBuffer(&b)
    _ = st
    return core.OK
}
