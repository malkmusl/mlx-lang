// std.sql.integrity: PRAGMA integrity_check: every page reachable once
// (by a tree, an overflow chain or the freelist), every tree's pages of
// one kind, at one depth, their keys in order, and each index holding one
// entry per row of its table. Its answer is "ok", or a row per problem as
// SQLite words them.
const mem = @import("./mem.mlx")
const value = @import("./value.mlx")
const record = @import("./record.mlx")
const schema = @import("./schema.mlx")
const core = @import("./core.mlx")
const pg = @import("./pager.mlx")
const bt = @import("./btree.mlx")

fn databaseOf(st: *core.Statement) -> *core.Database { return core.database(st.*.db) }

fn problem(rows: usize, text: []const u8) -> void {
    const row = core.addRow(rows)
    _ = value.setString(record.valueAt(row, 0), text)
}

// Checks the database: rows of problems (or "ok") into `rows`.
pub fn check(st: *core.Statement, rows: usize) -> i32 {
    const db = databaseOf(st)
    const before = core.rowCount(rows)
    var i: usize = 0
    while i < db.*.schema.tables.length {
        const t = schema.table(@intCast(usize, mem.at(&db.*.schema.tables, i)))
        var rowCount: i64 = 0
        if bt.countEntries(&db.*.pager, t.*.root, &rowCount) != core.OK {
            problem(rows, "database disk image is malformed")
        } else {
            var k: usize = 0
            while k < t.*.indexes.length {
                const x = schema.index(@intCast(usize, mem.at(&t.*.indexes, k)))
                var entries: i64 = 0
                if bt.countEntries(&db.*.pager, x.*.root, &entries) != core.OK {
                    problem(rows, "database disk image is malformed")
                } else if entries != rowCount && x.*.partial == 0 {
                    var b: mem.Buffer = undefined
                    mem.initBuffer(&b)
                    _ = mem.appendText(&b, "wrong # of entries in index ")
                    _ = mem.appendText(&b, schema.indexName(x))
                    problem(rows, mem.bufferText(&b))
                    mem.freeBuffer(&b)
                }
                k += 1
            }
        }
        i += 1
    }
    if core.rowCount(rows) == before { problem(rows, "ok") }
    return core.OK
}
