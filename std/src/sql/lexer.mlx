// std.sql.lexer: SQL text into tokens, as SQLite's tokenizer cuts it:
// words (keywords and identifiers alike: the parser decides which a word
// is where it stands), identifiers quoted with "", [], or ``, string
// literals in '' (a '' inside is one quote), blobs X'..', integers,
// reals and hexadecimal integers, parameters (?, ?NNN, :name, @name,
// $name), operators, and comments (-- to the end of the line, /* */).
const mem = @import("./mem.mlx")

pub const END: u8 = 0
pub const WORD: u8 = 1
pub const QUOTED: u8 = 2
pub const STRING: u8 = 3
pub const BLOB: u8 = 4
pub const INTEGER: u8 = 5
pub const REAL: u8 = 6
pub const VARIABLE: u8 = 7
pub const LPAREN: u8 = 8
pub const RPAREN: u8 = 9
pub const COMMA: u8 = 10
pub const SEMICOLON: u8 = 11
pub const DOT: u8 = 12
pub const PLUS: u8 = 13
pub const MINUS: u8 = 14
pub const STAR: u8 = 15
pub const SLASH: u8 = 16
pub const PERCENT: u8 = 17
pub const CONCAT: u8 = 18
pub const EQ: u8 = 19
pub const NE: u8 = 20
pub const LT: u8 = 21
pub const LE: u8 = 22
pub const GT: u8 = 23
pub const GE: u8 = 24
pub const LSHIFT: u8 = 25
pub const RSHIFT: u8 = 26
pub const BITAND: u8 = 27
pub const BITOR: u8 = 28
pub const BITNOT: u8 = 29
pub const ILLEGAL: u8 = 30
// -> and ->> (JSON's operators: recognized so that they are errors).
pub const PTR: u8 = 31

pub const Token = struct {
    kind: u8
    // Where the token's text is in the statement, and its length.
    start: usize
    length: usize
}

pub const Lexer = struct {
    text: usize
    length: usize
    at: usize
}

pub fn init(l: *Lexer, text: usize, length: usize) -> void {
    l.*.text = text
    l.*.length = length
    l.*.at = 0
}

inline fn byteAt(l: *Lexer, i: usize) -> u64 {
    if i >= l.*.length { return 0 }
    return mem.get8(l.*.text + i)
}

pub inline fn isIdentStart(c: u64) -> bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c >= 128 }
pub inline fn isIdentChar(c: u64) -> bool { return isIdentStart(c) || (c >= 48 && c <= 57) || c == 36 }
inline fn isDigit(c: u64) -> bool { return c >= 48 && c <= 57 }
inline fn isHex(c: u64) -> bool { return isDigit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102) }
inline fn isSpace(c: u64) -> bool { return c == 32 || c == 9 || c == 10 || c == 12 || c == 13 }

// Skips spaces and comments.
fn skip(l: *Lexer) -> void {
    while l.*.at < l.*.length {
        const c = byteAt(l, l.*.at)
        if isSpace(c) {
            l.*.at += 1
        } else if c == 45 && byteAt(l, l.*.at + 1) == 45 {
            while l.*.at < l.*.length && byteAt(l, l.*.at) != 10 { l.*.at += 1 }
        } else if c == 47 && byteAt(l, l.*.at + 1) == 42 {
            l.*.at += 2
            while l.*.at < l.*.length && !(byteAt(l, l.*.at) == 42 && byteAt(l, l.*.at + 1) == 47) { l.*.at += 1 }
            l.*.at = if l.*.at + 2 <= l.*.length { l.*.at + 2 } else { l.*.length }
        } else {
            return
        }
    }
}

// The next token.
pub fn next(l: *Lexer, t: *Token) -> void {
    skip(l)
    t.*.start = l.*.at
    t.*.length = 0
    if l.*.at >= l.*.length {
        t.*.kind = END
        return
    }
    const start = l.*.at
    const c = byteAt(l, start)
    var kind = ILLEGAL
    var length: usize = 1
    if (c == 120 || c == 88) && byteAt(l, start + 1) == 39 {
        // X'...': hex digits, an even number of them.
        var i = start + 2
        while i < l.*.length && isHex(byteAt(l, i)) { i += 1 }
        if byteAt(l, i) == 39 && (i - start - 2) % 2 == 0 {
            kind = BLOB
            length = i + 1 - start
        } else {
            while i < l.*.length && byteAt(l, i) != 39 { i += 1 }
            kind = ILLEGAL
            length = if i < l.*.length { i + 1 - start } else { i - start }
        }
    } else if isIdentStart(c) {
        var i = start + 1
        while i < l.*.length && isIdentChar(byteAt(l, i)) { i += 1 }
        kind = WORD
        length = i - start
    } else if isDigit(c) || (c == 46 && isDigit(byteAt(l, start + 1))) {
        var i = start
        kind = INTEGER
        if c == 48 && (byteAt(l, start + 1) == 120 || byteAt(l, start + 1) == 88) && isHex(byteAt(l, start + 2)) {
            i = start + 2
            while i < l.*.length && isHex(byteAt(l, i)) { i += 1 }
        } else {
            while i < l.*.length && isDigit(byteAt(l, i)) { i += 1 }
            if byteAt(l, i) == 46 {
                kind = REAL
                i += 1
                while i < l.*.length && isDigit(byteAt(l, i)) { i += 1 }
            }
            const e = byteAt(l, i)
            if e == 101 || e == 69 {
                const s = byteAt(l, i + 1)
                if isDigit(s) || ((s == 43 || s == 45) && isDigit(byteAt(l, i + 2))) {
                    kind = REAL
                    i += 2
                    while i < l.*.length && isDigit(byteAt(l, i)) { i += 1 }
                }
            }
        }
        // A number running into a word is an error ("1abc").
        if i < l.*.length && isIdentChar(byteAt(l, i)) {
            while i < l.*.length && isIdentChar(byteAt(l, i)) { i += 1 }
            kind = ILLEGAL
        }
        length = i - start
    } else if c == 39 {
        var i = start + 1
        while true {
            if i >= l.*.length {
                kind = ILLEGAL
                break
            }
            if byteAt(l, i) == 39 {
                if byteAt(l, i + 1) == 39 {
                    i += 2
                    continue
                }
                kind = STRING
                i += 1
                break
            }
            i += 1
        }
        length = i - start
    } else if c == 34 || c == 96 || c == 91 {
        const close = if c == 91 { 93 } else { c }
        var i = start + 1
        while true {
            if i >= l.*.length {
                kind = ILLEGAL
                break
            }
            if byteAt(l, i) == close {
                if close != 93 && byteAt(l, i + 1) == close {
                    i += 2
                    continue
                }
                kind = QUOTED
                i += 1
                break
            }
            i += 1
        }
        length = i - start
    } else if c == 63 {
        var i = start + 1
        while i < l.*.length && isDigit(byteAt(l, i)) { i += 1 }
        kind = VARIABLE
        length = i - start
    } else if c == 58 || c == 64 || c == 36 {
        var i = start + 1
        while i < l.*.length && isIdentChar(byteAt(l, i)) { i += 1 }
        kind = if i > start + 1 { VARIABLE } else { ILLEGAL }
        length = i - start
    } else {
        const d = byteAt(l, start + 1)
        if c == 40 {
            kind = LPAREN
        } else if c == 41 {
            kind = RPAREN
        } else if c == 44 {
            kind = COMMA
        } else if c == 59 {
            kind = SEMICOLON
        } else if c == 46 {
            kind = DOT
        } else if c == 43 {
            kind = PLUS
        } else if c == 45 {
            if d == 62 {
                kind = PTR
                length = if byteAt(l, start + 2) == 62 { 3 } else { 2 }
            } else {
                kind = MINUS
            }
        } else if c == 42 {
            kind = STAR
        } else if c == 47 {
            kind = SLASH
        } else if c == 37 {
            kind = PERCENT
        } else if c == 124 {
            if d == 124 {
                kind = CONCAT
                length = 2
            } else {
                kind = BITOR
            }
        } else if c == 61 {
            kind = EQ
            length = if d == 61 { 2 } else { 1 }
        } else if c == 33 {
            if d == 61 {
                kind = NE
                length = 2
            }
        } else if c == 60 {
            if d == 61 {
                kind = LE
                length = 2
            } else if d == 62 {
                kind = NE
                length = 2
            } else if d == 60 {
                kind = LSHIFT
                length = 2
            } else {
                kind = LT
            }
        } else if c == 62 {
            if d == 61 {
                kind = GE
                length = 2
            } else if d == 62 {
                kind = RSHIFT
                length = 2
            } else {
                kind = GT
            }
        } else if c == 38 {
            kind = BITAND
        } else if c == 126 {
            kind = BITNOT
        }
    }
    t.*.kind = kind
    t.*.length = length
    l.*.at = start + length
}

pub fn text(l: *Lexer, t: *Token) -> []const u8 { return mem.view(l.*.text + t.*.start, t.*.length) }

// Whether a token is the word `word` (any case).
pub fn isWord(l: *Lexer, t: *Token, word: []const u8) -> bool {
    if t.*.kind != WORD || t.*.length != word.length { return false }
    return mem.sameNoCase(text(l, t), word)
}

// Words SQLite never takes for a name without quotes where a name could
// follow an expression or a table (aliases): they continue the statement.
pub fn isReserved(word: []const u8) -> bool {
    if mem.sameNoCase(word, "ADD") { return true }
    if mem.sameNoCase(word, "ALL") { return true }
    if mem.sameNoCase(word, "ALTER") { return true }
    if mem.sameNoCase(word, "AND") { return true }
    if mem.sameNoCase(word, "AS") { return true }
    if mem.sameNoCase(word, "AUTOINCREMENT") { return true }
    if mem.sameNoCase(word, "BETWEEN") { return true }
    if mem.sameNoCase(word, "CASE") { return true }
    if mem.sameNoCase(word, "CHECK") { return true }
    if mem.sameNoCase(word, "COLLATE") { return true }
    if mem.sameNoCase(word, "COMMIT") { return true }
    if mem.sameNoCase(word, "CONSTRAINT") { return true }
    if mem.sameNoCase(word, "CREATE") { return true }
    if mem.sameNoCase(word, "CROSS") { return true }
    if mem.sameNoCase(word, "DEFAULT") { return true }
    if mem.sameNoCase(word, "DEFERRABLE") { return true }
    if mem.sameNoCase(word, "DELETE") { return true }
    if mem.sameNoCase(word, "DISTINCT") { return true }
    if mem.sameNoCase(word, "DROP") { return true }
    if mem.sameNoCase(word, "ELSE") { return true }
    if mem.sameNoCase(word, "ESCAPE") { return true }
    if mem.sameNoCase(word, "EXCEPT") { return true }
    if mem.sameNoCase(word, "EXISTS") { return true }
    if mem.sameNoCase(word, "FOREIGN") { return true }
    if mem.sameNoCase(word, "FROM") { return true }
    if mem.sameNoCase(word, "FULL") { return true }
    if mem.sameNoCase(word, "GLOB") { return true }
    if mem.sameNoCase(word, "GROUP") { return true }
    if mem.sameNoCase(word, "HAVING") { return true }
    if mem.sameNoCase(word, "IN") { return true }
    if mem.sameNoCase(word, "INDEX") { return true }
    if mem.sameNoCase(word, "INDEXED") { return true }
    if mem.sameNoCase(word, "INNER") { return true }
    if mem.sameNoCase(word, "INSERT") { return true }
    if mem.sameNoCase(word, "INTERSECT") { return true }
    if mem.sameNoCase(word, "INTO") { return true }
    if mem.sameNoCase(word, "IS") { return true }
    if mem.sameNoCase(word, "ISNULL") { return true }
    if mem.sameNoCase(word, "JOIN") { return true }
    if mem.sameNoCase(word, "LEFT") { return true }
    if mem.sameNoCase(word, "LIKE") { return true }
    if mem.sameNoCase(word, "LIMIT") { return true }
    if mem.sameNoCase(word, "MATCH") { return true }
    if mem.sameNoCase(word, "NATURAL") { return true }
    if mem.sameNoCase(word, "NOT") { return true }
    if mem.sameNoCase(word, "NOTHING") { return true }
    if mem.sameNoCase(word, "NOTNULL") { return true }
    if mem.sameNoCase(word, "NULL") { return true }
    if mem.sameNoCase(word, "OFFSET") { return true }
    if mem.sameNoCase(word, "ON") { return true }
    if mem.sameNoCase(word, "OR") { return true }
    if mem.sameNoCase(word, "ORDER") { return true }
    if mem.sameNoCase(word, "OUTER") { return true }
    if mem.sameNoCase(word, "PRIMARY") { return true }
    if mem.sameNoCase(word, "REFERENCES") { return true }
    if mem.sameNoCase(word, "REGEXP") { return true }
    if mem.sameNoCase(word, "RETURNING") { return true }
    if mem.sameNoCase(word, "RIGHT") { return true }
    if mem.sameNoCase(word, "SELECT") { return true }
    if mem.sameNoCase(word, "SET") { return true }
    if mem.sameNoCase(word, "TABLE") { return true }
    if mem.sameNoCase(word, "THEN") { return true }
    if mem.sameNoCase(word, "TO") { return true }
    if mem.sameNoCase(word, "TRANSACTION") { return true }
    if mem.sameNoCase(word, "UNION") { return true }
    if mem.sameNoCase(word, "UNIQUE") { return true }
    if mem.sameNoCase(word, "UPDATE") { return true }
    if mem.sameNoCase(word, "USING") { return true }
    if mem.sameNoCase(word, "VALUES") { return true }
    if mem.sameNoCase(word, "WHEN") { return true }
    if mem.sameNoCase(word, "WHERE") { return true }
    if mem.sameNoCase(word, "WINDOW") { return true }
    if mem.sameNoCase(word, "GROUPS") { return true }
    if mem.sameNoCase(word, "OVER") { return true }
    if mem.sameNoCase(word, "FILTER") { return true }
    return false
}
