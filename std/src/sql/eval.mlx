// std.sql.eval: expressions evaluated, as SQLite's virtual machine
// evaluates them: arithmetic on INTEGERs (a REAL when it overflows) and
// REALs, text taken as the number it starts with; comparisons with the
// affinity and collation SQLite's rules give them (a column's affinity
// passes to the value it is compared with, an explicit COLLATE wins over
// a column's); NULL's three-valued logic in AND, OR, NOT, IN and BETWEEN;
// LIKE (ASCII case folded) and GLOB; CASE, CAST, subqueries (run once
// when they read no outer row, else again for each), functions.
//
// Also here: collations by name, the order of rows (sorting with
// collations, directions and NULLS FIRST/LAST), sets of rows for DISTINCT
// and UNION, and compound SELECTs' set operations.
const mem = @import("./mem.mlx")
const value = @import("./value.mlx")
const record = @import("./record.mlx")
const numbers = @import("./numbers.mlx")
const ast = @import("./ast.mlx")
const schema = @import("./schema.mlx")
const core = @import("./core.mlx")
const query = @import("./query.mlx")
const functions = @import("./functions.mlx")
const lexer = @import("./lexer.mlx")

const Value = value.Value

fn databaseOf(st: *core.Statement) -> *core.Database { return core.database(st.*.db) }

// ---------------------------------------------------------------------------
// Collations.

// The connection's collation named `name` (any case; "" is BINARY), or 0.
pub fn findCollation(db: *core.Database, name: []const u8) -> usize {
    var at = db.*.collations
    while at != 0 {
        const c: *value.Collation = unsafe { @ptrFromInt(*value.Collation, at) }
        if name.length == 0 && c.*.kind == value.BINARY { return at }
        if mem.sameNoCase(mem.view(c.*.name, c.*.nameLength), name) { return at }
        at = c.*.next
    }
    return 0
}

fn kindOf(collation: usize) -> u8 {
    if collation == 0 { return value.BINARY }
    const c: *value.Collation = unsafe { @ptrFromInt(*value.Collation, collation) }
    return c.*.kind
}

pub fn sameCollation(a: usize, b: usize) -> bool {
    if a == b { return true }
    return kindOf(a) == value.BINARY && kindOf(b) == value.BINARY
}

// The collations of an index's columns from the connection (false when
// one is missing).
pub fn findCollationsOf(st: *core.Statement, x: *schema.Index) -> bool {
    var i: usize = 0
    while i < x.*.columnCount {
        if findCollation(databaseOf(st), schema.indexCollation(x, i)) == 0 { return false }
        i += 1
    }
    return true
}

// The index's KeyInfo given the connection's collations: OK, or "no such
// collation sequence".
pub fn resolveIndex(st: *core.Statement, x: *schema.Index) -> i32 {
    var i: usize = 0
    while i < x.*.columnCount {
        const c = findCollation(databaseOf(st), schema.indexCollation(x, i))
        if c == 0 {
            return core.setError2(databaseOf(st), core.ERROR, "no such collation sequence: ", schema.indexCollation(x, i))
        }
        mem.put64(x.*.info.collations + i * 8, @intCast(u64, c))
        i += 1
    }
    x.*.resolved = true
    return core.OK
}

pub fn resolveIndexOf(db: *core.Database, x: *schema.Index) -> i32 {
    var i: usize = 0
    while i < x.*.columnCount {
        const c = findCollation(db, schema.indexCollation(x, i))
        if c == 0 {
            return core.setError2(db, core.ERROR, "no such collation sequence: ", schema.indexCollation(x, i))
        }
        mem.put64(x.*.info.collations + i * 8, @intCast(u64, c))
        i += 1
    }
    x.*.resolved = true
    return core.OK
}

fn sourceOf(st: *core.Statement, number: i64) -> *core.SourceState {
    return core.sourceState(@intCast(usize, mem.at(&st.*.sources, @intCast(usize, number))))
}

// An explicit COLLATE an expression carries (on its left spine), or 0.
fn explicitCollation(e: usize) -> usize {
    if e == 0 { return 0 }
    const x = ast.expr(e)
    if x.*.op == ast.E_COLLATE { return x.*.collation }
    if x.*.op == ast.E_CAST || (x.*.op == ast.E_UNARY && x.*.sub == ast.U_POS) { return explicitCollation(x.*.left) }
    if x.*.op == ast.E_BINARY || x.*.op == ast.E_LIKE {
        const l = explicitCollation(x.*.left)
        if l != 0 { return l }
        return explicitCollation(x.*.right)
    }
    return 0
}

// The collation of an expression: an explicit one, else its column's
// (0: BINARY).
pub fn exprCollation(st: *core.Statement, e: usize) -> usize {
    if e == 0 { return 0 }
    const x = ast.expr(e)
    if x.*.op == ast.E_COLLATE { return x.*.collation }
    if x.*.op == ast.E_CAST || (x.*.op == ast.E_UNARY && x.*.sub == ast.U_POS) { return exprCollation(st, x.*.left) }
    if x.*.op == ast.E_COLUMN && x.*.source >= 0 && x.*.column >= 0 {
        const s = sourceOf(st, x.*.source)
        if s.*.kind == core.SOURCE_TABLE {
            const t = schema.table(s.*.table)
            if x.*.column != t.*.rowidColumn {
                const c = schema.column(t, @intCast(usize, x.*.column))
                if c.*.collationLength > 0 { return findCollation(databaseOf(st), mem.view(c.*.collation, c.*.collationLength)) }
            }
        } else if s.*.subquery != 0 {
            const inner = query.queryOf(s.*.subquery)
            if @intCast(usize, x.*.column) < inner.*.results.length {
                return exprCollation(st, @intCast(usize, mem.at(&inner.*.results, @intCast(usize, x.*.column))))
            }
        }
    }
    if x.*.op == ast.E_BINARY || x.*.op == ast.E_LIKE {
        const l = explicitCollation(x.*.left)
        if l != 0 { return l }
        return explicitCollation(x.*.right)
    }
    return 0
}

// The collation comparing `left` with `right` (sqlite3BinaryCompareCollSeq).
pub fn binaryCollation(st: *core.Statement, left: usize, right: usize) -> usize {
    var c = explicitCollation(left)
    if c != 0 { return c }
    c = explicitCollation(right)
    if c != 0 { return c }
    c = exprCollation(st, left)
    if c != 0 { return c }
    return exprCollation(st, right)
}

// The affinity of an expression (sqlite3ExprAffinity): a column's, a
// CAST's, a subquery's first column's; none (0) else.
pub fn exprAffinity(st: *core.Statement, e: usize) -> u8 {
    if e == 0 { return 0 }
    const x = ast.expr(e)
    if x.*.op == ast.E_COLUMN && x.*.source >= 0 {
        const s = sourceOf(st, x.*.source)
        if s.*.kind == core.SOURCE_TABLE {
            const t = schema.table(s.*.table)
            if x.*.column < 0 || x.*.column == t.*.rowidColumn { return value.AFF_INTEGER }
            return schema.column(t, @intCast(usize, x.*.column)).*.affinity
        }
        if s.*.subquery != 0 && x.*.column >= 0 {
            const inner = query.queryOf(s.*.subquery)
            if @intCast(usize, x.*.column) < inner.*.results.length {
                return exprAffinity(st, @intCast(usize, mem.at(&inner.*.results, @intCast(usize, x.*.column))))
            }
        }
        return 0
    }
    if x.*.op == ast.E_CAST { return x.*.affinity }
    if x.*.op == ast.E_COLLATE { return exprAffinity(st, x.*.left) }
    if x.*.op == ast.E_SUBQUERY && x.*.slot != 0 {
        const inner = query.queryOf(x.*.slot)
        if inner.*.results.length > 0 { return exprAffinity(st, @intCast(usize, mem.at(&inner.*.results, 0))) }
    }
    return 0
}

// ---------------------------------------------------------------------------
// The authorizer.

// Asks the connection's authorizer about an action: OK, DENY, IGNORE.
pub fn authorize(st: *core.Statement, action: i32, a: []const u8, b: []const u8) -> i32 {
    const db = databaseOf(st)
    if db.*.authorizer == 0 { return core.OK }
    const first = if a.length > 0 { mem.dupText(a) } else { 0 }
    const second = if b.length > 0 { mem.dupText(b) } else { 0 }
    // (SELECT, transactions, functions, PRAGMAs and savepoints name no
    // database.)
    const named = action != core.AUTH_TRANSACTION && action != core.AUTH_SELECT && action != core.AUTH_FUNCTION && action != core.AUTH_PRAGMA && action != core.AUTH_SAVEPOINT && action != core.AUTH_ALTER_TABLE
    const answer = authorizeText(st, action, first, second, named)
    mem.free(first)
    mem.free(second)
    return answer
}

// The authorizer asked with NUL-terminated names (0 for NULL); `named`:
// the database ("main") is said.
pub fn authorizeText(st: *core.Statement, action: i32, a: usize, b: usize, named: bool) -> i32 {
    const db = databaseOf(st)
    if db.*.authorizer == 0 { return core.OK }
    const call: core.AuthorizerFn = unsafe { @ptrFromInt(core.AuthorizerFn, db.*.authorizer) }
    return call(db.*.authorizerArgument, action, a, b, if named { @intFromPtr("main".pointer) } else { 0 }, 0)
}

// The authorizer asked about a sequence of (action, table, column) on the
// schema table, as SQLite's own statements over it ask: each step's
// strings in `steps` ("action table column;..." with "-" for none).
pub fn authorizeSteps(st: *core.Statement, steps: []const u8) -> i32 {
    const db = databaseOf(st)
    if db.*.authorizer == 0 { return core.OK }
    var at: usize = 0
    while at < steps.length {
        var end = at
        while end < steps.length && steps[end] != 59 { end += 1 }
        // action number, a word, a word.
        var fields: [3]usize = [3]usize{ 0, 0, 0 }
        var lengths: [3]usize = [3]usize{ 0, 0, 0 }
        var k: usize = 0
        var i = at
        while k < 3 && i < end {
            while i < end && steps[i] == 32 { i += 1 }
            fields[k] = i
            while i < end && steps[i] != 32 { i += 1 }
            lengths[k] = i - fields[k]
            k += 1
        }
        var action: i32 = 0
        var d = fields[0]
        while d < fields[0] + lengths[0] {
            action = action * 10 + @intCast(i32, steps[d] - 48)
            d += 1
        }
        const a = if lengths[1] == 1 && steps[fields[1]] == 45 { 0 } else { mem.dup(@intFromPtr(steps.pointer) + fields[1], lengths[1]) }
        const b = if lengths[2] == 1 && steps[fields[2]] == 45 { 0 } else { mem.dup(@intFromPtr(steps.pointer) + fields[2], lengths[2]) }
        const answer = authorizeText(st, action, a, b, true)
        mem.free(a)
        mem.free(b)
        if answer == core.AUTH_DENY { return core.setError(db, core.AUTH, "not authorized") }
        at = end + 1
    }
    return core.OK
}

// ---------------------------------------------------------------------------
// Evaluation.

fn temporary(v: *Value) -> void { value.init(v) }

pub fn register(st: *core.Statement, q: usize, k: usize) -> *Value {
    _ = st
    return record.valueAt(query.queryOf(q).*.registers, k)
}

// Evaluates `e` into `out`: OK or an error (on the connection).
pub fn evaluate(st: *core.Statement, e: usize, out: *Value) -> i32 {
    const x = ast.expr(e)
    const op = x.*.op
    if op == ast.E_COLUMN {
        if x.*.slot != 0 && x.*.source >= 0 {
            const s = sourceOf(st, x.*.source)
            const q = query.queryOf(s.*.query)
            if q.*.readRegisters {
                _ = value.copy(out, record.valueAt(q.*.registers, x.*.slot - 1))
                return core.OK
            }
        }
        if x.*.source < 0 {
            value.setNull(out)
            return core.OK
        }
        return query.readColumn(st, x.*.source, x.*.column, out)
    }
    if op == ast.E_INTEGER {
        value.setInt(out, x.*.i)
        return core.OK
    }
    if op == ast.E_REAL {
        value.setReal(out, x.*.r)
        return core.OK
    }
    if op == ast.E_STRING {
        if !value.setText(out, x.*.name, x.*.nameLength) { return core.NOMEM }
        return core.OK
    }
    if op == ast.E_BLOB {
        if !value.setBlob(out, x.*.name, x.*.nameLength) { return core.NOMEM }
        return core.OK
    }
    if op == ast.E_NULL {
        value.setNull(out)
        return core.OK
    }
    if op == ast.E_VARIABLE {
        if x.*.i < 1 || @intCast(usize, x.*.i) > st.*.parameterCount {
            value.setNull(out)
            return core.OK
        }
        _ = value.copy(out, core.parameter(st, x.*.i))
        return core.OK
    }
    if op == ast.E_BINARY { return binaryOp(st, x, out) }
    if op == ast.E_AND || op == ast.E_OR || (op == ast.E_UNARY && x.*.sub == ast.U_NOT) || op == ast.E_IS || op == ast.E_ISNULL || op == ast.E_BETWEEN || op == ast.E_IN_LIST || op == ast.E_IN_SELECT || op == ast.E_EXISTS || op == ast.E_LIKE {
        var truth: i8 = 0
        const rc = condition(st, e, &truth)
        if rc != core.OK { return rc }
        if truth < 0 {
            value.setNull(out)
        } else {
            value.setInt(out, @intCast(i64, truth))
        }
        return core.OK
    }
    if op == ast.E_UNARY { return unaryOp(st, x, out) }
    if op == ast.E_COLLATE { return evaluate(st, x.*.left, out) }
    if op == ast.E_CAST {
        const rc = evaluate(st, x.*.left, out)
        if rc != core.OK { return rc }
        value.cast(out, x.*.affinity)
        return core.OK
    }
    if op == ast.E_CASE { return caseOp(st, x, out) }
    if op == ast.E_FUNCTION {
        if x.*.aggregate != 0 {
            const q = query.queryOf(x.*.slot)
            _ = value.copy(out, functions.result(q.*.accumulators, x.*.aggregate - 1))
            return core.OK
        }
        return functions.call(st, e, out)
    }
    if op == ast.E_SUBQUERY { return scalarSubquery(st, x, out) }
    value.setNull(out)
    return core.OK
}

// SQLite's numeric operand: a number, or NULL.
fn numericOf(st: *core.Statement, e: usize, out: *Value) -> i32 {
    var v: Value = undefined
    value.init(&v)
    const rc = evaluate(st, e, &v)
    if rc == core.OK { value.numeric(&v, out) }
    value.release(&v)
    return rc
}

fn unaryOp(st: *core.Statement, x: *ast.Expr, out: *Value) -> i32 {
    if x.*.sub == ast.U_POS { return evaluate(st, x.*.left, out) }
    if x.*.sub == ast.U_NEG {
        // -9223372036854775808 is the smallest integer.
        const inner = ast.expr(x.*.left)
        if inner.*.op == ast.E_REAL && inner.*.nameLength == 19 && mem.same(mem.view(inner.*.name, 19), "9223372036854775808") {
            value.setInt(out, -9223372036854775807 - 1)
            return core.OK
        }
        const rc = numericOf(st, x.*.left, out)
        if rc != core.OK { return rc }
        if out.*.kind == value.INTEGER {
            if out.*.i == -9223372036854775807 - 1 {
                value.setReal(out, 9223372036854775808.0)
            } else {
                value.setInt(out, 0 - out.*.i)
            }
        } else if out.*.kind == value.REAL {
            value.setReal(out, 0.0 - out.*.r)
        }
        return core.OK
    }
    // ~x
    const rc = numericOf(st, x.*.left, out)
    if rc != core.OK { return rc }
    if out.*.kind == value.NULL { return core.OK }
    const i = if out.*.kind == value.INTEGER { out.*.i } else { numbers.realToInteger(out.*.r) }
    value.setInt(out, ~i)
    return core.OK
}

// a + b etc. on 64-bit integers: false when it overflows.
fn addOverflows(a: i64, b: i64, out: *i64) -> bool {
    const r = a +% b
    if (a >= 0) == (b >= 0) && (r >= 0) != (a >= 0) { return true }
    out.* = r
    return false
}

fn mulOverflows(a: i64, b: i64, out: *i64) -> bool {
    if a == 0 || b == 0 {
        out.* = 0
        return false
    }
    const r = a *% b
    if (a == -1 && b == -9223372036854775807 - 1) || (b == -1 && a == -9223372036854775807 - 1) { return true }
    if r / b != a { return true }
    out.* = r
    return false
}

fn arithmetic(st: *core.Statement, x: *ast.Expr, out: *Value) -> i32 {
    var a: Value = undefined
    value.init(&a)
    var b: Value = undefined
    value.init(&b)
    var rc = numericOf(st, x.*.left, &a)
    if rc == core.OK { rc = numericOf(st, x.*.right, &b) }
    if rc != core.OK || a.kind == value.NULL || b.kind == value.NULL {
        value.setNull(out)
        value.release(&a)
        value.release(&b)
        return rc
    }
    const sub = x.*.sub
    if a.kind == value.INTEGER && b.kind == value.INTEGER {
        var r: i64 = 0
        if sub == lexer.PLUS {
            if !addOverflows(a.i, b.i, &r) {
                value.setInt(out, r)
                return core.OK
            }
        } else if sub == lexer.MINUS {
            if b.i == -9223372036854775807 - 1 {
                if a.i < 0 {
                    value.setInt(out, a.i - b.i)
                    return core.OK
                }
            } else if !addOverflows(a.i, 0 - b.i, &r) {
                value.setInt(out, r)
                return core.OK
            }
        } else if sub == lexer.STAR {
            if !mulOverflows(a.i, b.i, &r) {
                value.setInt(out, r)
                return core.OK
            }
        } else if sub == lexer.SLASH {
            if b.i == 0 {
                value.setNull(out)
                return core.OK
            }
            if !(b.i == -1 && a.i == -9223372036854775807 - 1) {
                value.setInt(out, a.i / b.i)
                return core.OK
            }
        } else {
            if b.i == 0 {
                value.setNull(out)
                return core.OK
            }
            if b.i == -1 {
                value.setInt(out, 0)
                return core.OK
            }
            value.setInt(out, a.i % b.i)
            return core.OK
        }
    }
    const ra = value.toReal(&a)
    const rb = value.toReal(&b)
    var r: f64 = 0.0
    if sub == lexer.PLUS {
        r = ra + rb
    } else if sub == lexer.MINUS {
        r = ra - rb
    } else if sub == lexer.STAR {
        r = ra * rb
    } else if sub == lexer.SLASH {
        if rb == 0.0 {
            value.setNull(out)
            return core.OK
        }
        r = ra / rb
    } else {
        const ia = numbers.realToInteger(ra)
        const ib = numbers.realToInteger(rb)
        if ib == 0 {
            value.setNull(out)
            return core.OK
        }
        r = if ib == -1 { 0.0 } else { @floatFromInt(f64, ia % ib) }
    }
    value.setReal(out, r)
    return core.OK
}

fn integerOf(v: *Value) -> i64 {
    if v.*.kind == value.INTEGER { return v.*.i }
    return numbers.realToInteger(v.*.r)
}

fn bitwise(st: *core.Statement, x: *ast.Expr, out: *Value) -> i32 {
    var a: Value = undefined
    value.init(&a)
    var b: Value = undefined
    value.init(&b)
    var rc = numericOf(st, x.*.left, &a)
    if rc == core.OK { rc = numericOf(st, x.*.right, &b) }
    if rc != core.OK || a.kind == value.NULL || b.kind == value.NULL {
        value.setNull(out)
        value.release(&a)
        value.release(&b)
        return rc
    }
    const ia = integerOf(&a)
    var ib = integerOf(&b)
    var sub = x.*.sub
    if sub == lexer.BITAND {
        value.setInt(out, ia & ib)
    } else if sub == lexer.BITOR {
        value.setInt(out, ia | ib)
    } else {
        // A negative shift goes the other way.
        if ib < 0 {
            sub = if sub == lexer.LSHIFT { lexer.RSHIFT } else { lexer.LSHIFT }
            ib = if ib > -64 { 0 - ib } else { 64 }
        }
        if ib >= 64 {
            value.setInt(out, if sub == lexer.RSHIFT && ia < 0 { -1 } else { 0 })
        } else if sub == lexer.LSHIFT {
            value.setInt(out, @bitCast(i64, @bitCast(u64, ia) << @intCast(u64, ib)))
        } else {
            value.setInt(out, ia >> @intCast(u64, ib))
        }
    }
    return core.OK
}

fn concat(st: *core.Statement, x: *ast.Expr, out: *Value) -> i32 {
    var a: Value = undefined
    value.init(&a)
    var b: Value = undefined
    value.init(&b)
    var rc = evaluate(st, x.*.left, &a)
    if rc == core.OK { rc = evaluate(st, x.*.right, &b) }
    if rc != core.OK || a.kind == value.NULL || b.kind == value.NULL {
        value.setNull(out)
        value.release(&a)
        value.release(&b)
        return rc
    }
    _ = value.toText(&a)
    _ = value.toText(&b)
    var buffer: mem.Buffer = undefined
    mem.initBuffer(&buffer)
    _ = mem.append(&buffer, a.data, a.length)
    _ = mem.append(&buffer, b.data, b.length)
    _ = value.setText(out, buffer.data, buffer.length)
    mem.freeBuffer(&buffer)
    value.release(&a)
    value.release(&b)
    return core.OK
}

// Applies a comparison's affinity to its two values (OP_Eq's rules).
fn compareAffinity(affinity: u8, a: *Value, b: *Value) -> void {
    if affinity >= value.AFF_NUMERIC {
        if a.*.kind == value.TEXT { value.applyComparisonNumeric(a) }
        if b.*.kind == value.TEXT { value.applyComparisonNumeric(b) }
    } else if affinity == value.AFF_TEXT {
        if a.*.kind == value.INTEGER || a.*.kind == value.REAL { _ = value.toText(a) }
        if b.*.kind == value.INTEGER || b.*.kind == value.REAL { _ = value.toText(b) }
    }
}

// Compares two expressions' values as `left OP right` does: the order (or
// `isNull` when either is NULL).
fn compareExprs(st: *core.Statement, left: usize, right: usize, a: *Value, b: *Value, isNull: *bool, order: *i64) -> i32 {
    var rc = evaluate(st, left, a)
    if rc == core.OK { rc = evaluate(st, right, b) }
    if rc != core.OK { return rc }
    if a.*.kind == value.NULL || b.*.kind == value.NULL {
        isNull.* = true
        return core.OK
    }
    isNull.* = false
    compareAffinity(query.comparisonAffinity(st, left, right), a, b)
    order.* = value.compare(a, b, binaryCollation(st, left, right))
    return core.OK
}

fn binaryOp(st: *core.Statement, x: *ast.Expr, out: *Value) -> i32 {
    const sub = x.*.sub
    if sub == lexer.PLUS || sub == lexer.MINUS || sub == lexer.STAR || sub == lexer.SLASH || sub == lexer.PERCENT { return arithmetic(st, x, out) }
    if sub == lexer.CONCAT { return concat(st, x, out) }
    if sub == lexer.BITAND || sub == lexer.BITOR || sub == lexer.LSHIFT || sub == lexer.RSHIFT { return bitwise(st, x, out) }
    var a: Value = undefined
    value.init(&a)
    var b: Value = undefined
    value.init(&b)
    var isNull = false
    var order: i64 = 0
    const rc = compareExprs(st, x.*.left, x.*.right, &a, &b, &isNull, &order)
    value.release(&a)
    value.release(&b)
    if rc != core.OK { return rc }
    if isNull {
        value.setNull(out)
        return core.OK
    }
    var truth = false
    if sub == lexer.EQ {
        truth = order == 0
    } else if sub == lexer.NE {
        truth = order != 0
    } else if sub == lexer.LT {
        truth = order < 0
    } else if sub == lexer.LE {
        truth = order <= 0
    } else if sub == lexer.GT {
        truth = order > 0
    } else {
        truth = order >= 0
    }
    value.setBool(out, truth)
    return core.OK
}

fn truthOf(v: *Value) -> i8 {
    if v.*.kind == value.NULL { return -1 }
    return if value.isTrue(v) { 1 } else { 0 }
}

// An expression as a condition: 1 true, 0 false, -1 NULL.
pub fn condition(st: *core.Statement, e: usize, truth: *i8) -> i32 {
    const x = ast.expr(e)
    const op = x.*.op
    var rc = core.OK
    if op == ast.E_AND {
        var a: i8 = 0
        rc = condition(st, x.*.left, &a)
        if rc != core.OK { return rc }
        if a == 0 {
            truth.* = 0
            return core.OK
        }
        var b: i8 = 0
        rc = condition(st, x.*.right, &b)
        if rc != core.OK { return rc }
        if b == 0 {
            truth.* = 0
        } else if a == 1 && b == 1 {
            truth.* = 1
        } else {
            truth.* = -1
        }
        return core.OK
    }
    if op == ast.E_OR {
        var a: i8 = 0
        rc = condition(st, x.*.left, &a)
        if rc != core.OK { return rc }
        if a == 1 {
            truth.* = 1
            return core.OK
        }
        var b: i8 = 0
        rc = condition(st, x.*.right, &b)
        if rc != core.OK { return rc }
        if b == 1 {
            truth.* = 1
        } else if a == 0 && b == 0 {
            truth.* = 0
        } else {
            truth.* = -1
        }
        return core.OK
    }
    if op == ast.E_UNARY && x.*.sub == ast.U_NOT {
        var a: i8 = 0
        rc = condition(st, x.*.left, &a)
        if rc != core.OK { return rc }
        truth.* = if a < 0 { -1 } else { 1 - a }
        return core.OK
    }
    if op == ast.E_IS {
        var a: Value = undefined
        value.init(&a)
        var b: Value = undefined
        value.init(&b)
        rc = evaluate(st, x.*.left, &a)
        if rc == core.OK { rc = evaluate(st, x.*.right, &b) }
        if rc == core.OK {
            var same = false
            if a.kind == value.NULL || b.kind == value.NULL {
                same = a.kind == b.kind
            } else {
                compareAffinity(query.comparisonAffinity(st, x.*.left, x.*.right), &a, &b)
                same = value.compare(&a, &b, binaryCollation(st, x.*.left, x.*.right)) == 0
            }
            truth.* = if same != x.*.negated { 1 } else { 0 }
        }
        value.release(&a)
        value.release(&b)
        return rc
    }
    if op == ast.E_ISNULL {
        var a: Value = undefined
        value.init(&a)
        rc = evaluate(st, x.*.left, &a)
        const isNull = a.kind == value.NULL
        value.release(&a)
        truth.* = if isNull != x.*.negated { 1 } else { 0 }
        return rc
    }
    if op == ast.E_BETWEEN { return between(st, x, truth) }
    if op == ast.E_IN_LIST || op == ast.E_IN_SELECT { return inOp(st, x, truth) }
    if op == ast.E_EXISTS {
        var any = false
        rc = exists(st, x, &any)
        truth.* = if any != x.*.negated { 1 } else { 0 }
        return rc
    }
    if op == ast.E_LIKE { return likeOp(st, x, truth) }
    var v: Value = undefined
    value.init(&v)
    rc = evaluate(st, e, &v)
    truth.* = truthOf(&v)
    value.release(&v)
    return rc
}

fn between(st: *core.Statement, x: *ast.Expr, truth: *i8) -> i32 {
    var a: Value = undefined
    value.init(&a)
    var b: Value = undefined
    value.init(&b)
    var isNull = false
    var order: i64 = 0
    // x >= low AND x <= high, each compared as its own comparison.
    var rc = compareExprs(st, x.*.left, x.*.right, &a, &b, &isNull, &order)
    var low: i8 = if isNull { -1 } else if order >= 0 { 1 } else { 0 }
    if rc == core.OK {
        value.setNull(&a)
        value.setNull(&b)
        rc = compareExprs(st, x.*.left, x.*.third, &a, &b, &isNull, &order)
    }
    const high: i8 = if isNull { -1 } else if order <= 0 { 1 } else { 0 }
    value.release(&a)
    value.release(&b)
    if rc != core.OK { return rc }
    var both: i8 = 0
    if low == 0 || high == 0 {
        both = 0
    } else if low == 1 && high == 1 {
        both = 1
    } else {
        both = -1
    }
    if x.*.negated && both >= 0 { both = 1 - both }
    truth.* = both
    return core.OK
}

// x IN (...): true when x equals a value, NULL when it does not but a
// NULL was there (or x is NULL and the list is not empty), else false.
fn inOp(st: *core.Statement, x: *ast.Expr, truth: *i8) -> i32 {
    var left: Value = undefined
    value.init(&left)
    var rc = evaluate(st, x.*.left, &left)
    if rc != core.OK {
        value.release(&left)
        return rc
    }
    const leftAffinity = exprAffinity(st, x.*.left)
    var collation = exprCollation(st, x.*.left)
    var sawNull = false
    var found = false
    var empty = true
    var item: Value = undefined
    value.init(&item)
    if x.*.op == ast.E_IN_LIST {
        var i: usize = 0
        while i < ast.count(x.*.list) && !found {
            empty = false
            const e = ast.exprAt(x.*.list, i)
            rc = evaluate(st, e, &item)
            if rc != core.OK { break }
            if item.kind == value.NULL || left.kind == value.NULL {
                sawNull = true
            } else {
                var a: Value = undefined
                value.init(&a)
                _ = value.copy(&a, &left)
                const affinity = query.comparisonAffinity(st, x.*.left, e)
                compareAffinity(affinity, &a, &item)
                const c = if explicitCollation(e) != 0 { explicitCollation(e) } else { binaryCollation(st, x.*.left, e) }
                if value.compare(&a, &item, c) == 0 { found = true }
                value.release(&a)
            }
            i += 1
        }
    } else {
        // The subquery's values (kept when it reads no outer row).
        var rows: usize = 0
        var owned = false
        rc = subqueryRows(st, x, &rows, &owned)
        if rc == core.OK {
            const inner = query.queryOf(x.*.slot)
            const rightAffinity = if inner.*.results.length > 0 { exprAffinity(st, @intCast(usize, mem.at(&inner.*.results, 0))) } else { 0 }
            var affinity = value.AFF_BLOB
            if leftAffinity > value.AFF_BLOB && rightAffinity > value.AFF_BLOB {
                affinity = if leftAffinity >= value.AFF_NUMERIC || rightAffinity >= value.AFF_NUMERIC { value.AFF_NUMERIC } else { value.AFF_BLOB }
            } else if leftAffinity > value.AFF_BLOB {
                affinity = leftAffinity
            } else if rightAffinity > value.AFF_BLOB {
                affinity = rightAffinity
            }
            if collation == 0 && inner.*.results.length > 0 { collation = exprCollation(st, @intCast(usize, mem.at(&inner.*.results, 0))) }
            var i: usize = 0
            const n = core.rowCount(rows)
            while i < n && !found {
                empty = false
                const v = record.valueAt(core.rowAt(rows, i), 0)
                if v.*.kind == value.NULL || left.kind == value.NULL {
                    sawNull = true
                } else {
                    var a: Value = undefined
                    value.init(&a)
                    _ = value.copy(&a, &left)
                    _ = value.copy(&item, v)
                    compareAffinity(affinity, &a, &item)
                    if value.compare(&a, &item, collation) == 0 { found = true }
                    value.release(&a)
                }
                i += 1
            }
            if owned { core.freeRows(rows) }
        }
    }
    value.release(&item)
    value.release(&left)
    if rc != core.OK { return rc }
    var result: i8 = 0
    if found {
        result = 1
    } else if empty {
        result = 0
    } else if sawNull {
        result = -1
    }
    if x.*.negated && result >= 0 { result = 1 - result }
    truth.* = result
    return core.OK
}

// ---------------------------------------------------------------------------
// Subqueries.

// Runs a query to its end, its rows (as wide as `rows` holds) into `rows`.
pub fn runSubquery(st: *core.Statement, q: usize, rows: usize) -> i32 {
    const db = databaseOf(st)
    db.*.recursionDepth += 1
    if db.*.recursionDepth > 64 {
        db.*.recursionDepth -= 1
        return core.setError(db, core.ERROR, "subqueries nested too deeply")
    }
    query.reset(st, q)
    const width = core.rowsOf(rows).*.width
    var rc = core.OK
    while true {
        rc = query.step(st, q)
        if rc == core.DONE {
            rc = core.OK
            break
        }
        if rc != core.ROW { break }
        const row = core.addRow(rows)
        if row == 0 {
            rc = core.NOMEM
            break
        }
        var i: usize = 0
        while i < width && i < query.queryOf(q).*.width {
            _ = value.copy(record.valueAt(row, i), query.output(q, i))
            i += 1
        }
    }
    db.*.recursionDepth -= 1
    return rc
}

// The rows of an IN subquery: kept on the expression for the run when it
// reads no outer row (`owned` false), else made fresh (the caller frees
// them).
fn subqueryRows(st: *core.Statement, x: *ast.Expr, rows: *usize, owned: *bool) -> i32 {
    const q = query.queryOf(x.*.slot)
    if !q.*.correlated && x.*.cache != 0 && core.rowsOf(x.*.cache).*.position == 1 {
        rows.* = x.*.cache
        owned.* = false
        return core.OK
    }
    var target: usize = 0
    if q.*.correlated {
        target = core.newRows(1)
        owned.* = true
    } else {
        if x.*.cache == 0 {
            x.*.cache = core.newRows(1)
            _ = mem.push(&st.*.caches, @intCast(u64, @intFromPtr(x)))
        }
        core.clearRows(x.*.cache)
        target = x.*.cache
        owned.* = false
    }
    const rc = runSubquery(st, x.*.slot, target)
    if rc != core.OK {
        if owned.* { core.freeRows(target) }
        return rc
    }
    // Position 1 marks the kept rows as this run's.
    if !owned.* { core.rowsOf(target).*.position = 1 }
    rows.* = target
    return core.OK
}

// Forgets the kept subquery results (a new run of the statement).
pub fn clearCaches(st: *core.Statement) -> void {
    var i: usize = 0
    while i < st.*.caches.length {
        const x = ast.expr(@intCast(usize, mem.at(&st.*.caches, i)))
        if x.*.cache != 0 {
            core.clearRows(x.*.cache)
            core.rowsOf(x.*.cache).*.position = 0
        }
        i += 1
    }
}

pub fn freeCaches(st: *core.Statement) -> void {
    var i: usize = 0
    while i < st.*.caches.length {
        const x = ast.expr(@intCast(usize, mem.at(&st.*.caches, i)))
        core.freeRows(x.*.cache)
        x.*.cache = 0
        i += 1
    }
    st.*.caches.length = 0
}

fn keep(st: *core.Statement, x: *ast.Expr) -> void {
    if x.*.cache == 0 {
        x.*.cache = core.newRows(1)
        _ = mem.push(&st.*.caches, @intCast(u64, @intFromPtr(x)))
    }
    core.clearRows(x.*.cache)
}

// (SELECT ...): its first row's first value, NULL when it has none.
fn scalarSubquery(st: *core.Statement, x: *ast.Expr, out: *Value) -> i32 {
    const q = query.queryOf(x.*.slot)
    if !q.*.correlated && x.*.cache != 0 && core.rowsOf(x.*.cache).*.position == 1 {
        if core.rowCount(x.*.cache) == 0 {
            value.setNull(out)
        } else {
            _ = value.copy(out, record.valueAt(core.rowAt(x.*.cache, 0), 0))
        }
        return core.OK
    }
    const db = databaseOf(st)
    db.*.recursionDepth += 1
    if db.*.recursionDepth > 64 {
        db.*.recursionDepth -= 1
        return core.setError(db, core.ERROR, "subqueries nested too deeply")
    }
    query.reset(st, x.*.slot)
    var rc = query.step(st, x.*.slot)
    db.*.recursionDepth -= 1
    if rc == core.ROW {
        _ = value.copy(out, query.output(x.*.slot, 0))
        rc = core.OK
    } else if rc == core.DONE {
        value.setNull(out)
        rc = core.OK
    }
    if rc == core.OK && !q.*.correlated {
        keep(st, x)
        const row = core.addRow(x.*.cache)
        _ = value.copy(record.valueAt(row, 0), out)
        core.rowsOf(x.*.cache).*.position = 1
    }
    return rc
}

// EXISTS (SELECT ...): whether it has a row.
fn exists(st: *core.Statement, x: *ast.Expr, any: *bool) -> i32 {
    const q = query.queryOf(x.*.slot)
    if !q.*.correlated && x.*.cache != 0 && core.rowsOf(x.*.cache).*.position == 1 {
        any.* = core.rowCount(x.*.cache) > 0
        return core.OK
    }
    query.reset(st, x.*.slot)
    var rc = query.step(st, x.*.slot)
    any.* = rc == core.ROW
    if rc == core.ROW || rc == core.DONE { rc = core.OK }
    if rc == core.OK && !q.*.correlated {
        keep(st, x)
        if any.* { _ = core.addRow(x.*.cache) }
        core.rowsOf(x.*.cache).*.position = 1
    }
    return rc
}

// ---------------------------------------------------------------------------
// CASE, LIKE, defaults.

fn caseOp(st: *core.Statement, x: *ast.Expr, out: *Value) -> i32 {
    var rc = core.OK
    const n = ast.count(x.*.list)
    if x.*.left != 0 {
        // CASE base WHEN v THEN r: base = v as a comparison.
        var base: Value = undefined
        value.init(&base)
        var candidate: Value = undefined
        value.init(&candidate)
        var i: usize = 0
        var chosen: usize = 0
        while i < n {
            var isNull = false
            var order: i64 = 0
            rc = compareExprs(st, x.*.left, ast.exprAt(x.*.list, i), &base, &candidate, &isNull, &order)
            if rc != core.OK { break }
            if !isNull && order == 0 {
                chosen = ast.exprAt(x.*.list, i + 1)
                break
            }
            i += 2
        }
        value.release(&base)
        value.release(&candidate)
        if rc != core.OK { return rc }
        if chosen != 0 { return evaluate(st, chosen, out) }
    } else {
        var i: usize = 0
        while i < n {
            var truth: i8 = 0
            rc = condition(st, ast.exprAt(x.*.list, i), &truth)
            if rc != core.OK { return rc }
            if truth == 1 { return evaluate(st, ast.exprAt(x.*.list, i + 1), out) }
            i += 2
        }
    }
    if x.*.third != 0 { return evaluate(st, x.*.third, out) }
    value.setNull(out)
    return core.OK
}

fn likeOp(st: *core.Statement, x: *ast.Expr, truth: *i8) -> i32 {
    var subject: Value = undefined
    value.init(&subject)
    var pattern: Value = undefined
    value.init(&pattern)
    var escape: Value = undefined
    value.init(&escape)
    var rc = evaluate(st, x.*.left, &subject)
    if rc == core.OK { rc = evaluate(st, x.*.right, &pattern) }
    if rc == core.OK && x.*.third != 0 { rc = evaluate(st, x.*.third, &escape) }
    var result: i8 = -1
    if rc == core.OK && subject.kind != value.NULL && pattern.kind != value.NULL && (x.*.third == 0 || escape.kind != value.NULL) {
        if x.*.sub == ast.L_LIKE {
            var escapeChar: i64 = -1
            if x.*.third != 0 {
                _ = value.toText(&escape)
                if escape.length != 1 {
                    rc = core.setError(databaseOf(st), core.ERROR, "ESCAPE expression must be a single character")
                } else {
                    escapeChar = @intCast(i64, mem.get8(escape.data))
                }
            }
            if rc == core.OK {
                _ = value.toText(&subject)
                _ = value.toText(&pattern)
                const matched = functions.like(pattern.data, pattern.length, subject.data, subject.length, escapeChar, !databaseOf(st).*.caseSensitiveLike)
                result = if matched { 1 } else { 0 }
            }
        } else if x.*.sub == ast.L_GLOB {
            _ = value.toText(&subject)
            _ = value.toText(&pattern)
            result = if functions.glob(pattern.data, pattern.length, subject.data, subject.length) { 1 } else { 0 }
        } else {
            rc = core.setError(databaseOf(st), core.ERROR, if x.*.sub == ast.L_REGEXP { "no such function: REGEXP" } else { "unable to use function MATCH in the requested context" })
        }
    }
    value.release(&subject)
    value.release(&pattern)
    value.release(&escape)
    if rc != core.OK { return rc }
    if x.*.negated && result >= 0 { result = 1 - result }
    truth.* = result
    return core.OK
}

// A column's DEFAULT (NULL when it has none), its affinity applied.
pub fn columnDefault(st: *core.Statement, t: *schema.Table, column: usize, out: *Value) -> i32 {
    const c = schema.column(t, column)
    if c.*.defaultExpr == 0 {
        value.setNull(out)
        return core.OK
    }
    const rc = evaluate(st, c.*.defaultExpr, out)
    if rc != core.OK { return rc }
    value.applyAffinity(out, c.*.affinity)
    return core.OK
}

// ---------------------------------------------------------------------------
// Ordering rows.

// How rows compare: `count` keys, each at a column of the row, in a
// collation, descending or not, NULLs first or last.
const Order = struct {
    count: usize
    columns: usize
    collations: usize
    descending: usize
    // 1: NULLs first, 2: last (per key).
    nulls: usize
}

fn compareRows(o: *Order, a: usize, b: usize) -> i64 {
    var i: usize = 0
    while i < o.*.count {
        const column = @intCast(usize, mem.get64(o.*.columns + i * 8))
        const va = record.valueAt(a, column)
        const vb = record.valueAt(b, column)
        const descending = mem.get8(o.*.descending + i) != 0
        const nulls = mem.get8(o.*.nulls + i)
        if nulls != 0 && (va.*.kind == value.NULL) != (vb.*.kind == value.NULL) {
            // NULLS FIRST or LAST overrides the direction for NULLs.
            const aNull = va.*.kind == value.NULL
            if nulls == 1 { return if aNull { -1 } else { 1 } }
            return if aNull { 1 } else { -1 }
        }
        var c = value.compare(va, vb, @intCast(usize, mem.get64(o.*.collations + i * 8)))
        if descending { c = 0 - c }
        if c != 0 { return c }
        i += 1
    }
    return 0
}

// Merge sort (stable) of a row list by an Order.
fn sortWords(w: *mem.Words, o: *Order) -> void {
    const n = w.*.length
    if n < 2 { return }
    const scratch = mem.alloc(n * 8)
    var width: usize = 1
    var from = w.*.data
    var to = scratch
    while width < n {
        var start: usize = 0
        while start < n {
            const middle = if start + width < n { start + width } else { n }
            const end = if start + 2 * width < n { start + 2 * width } else { n }
            var i = start
            var j = middle
            var k = start
            while i < middle && j < end {
                if compareRows(o, @intCast(usize, mem.get64(from + j * 8)), @intCast(usize, mem.get64(from + i * 8))) < 0 {
                    mem.put64(to + k * 8, mem.get64(from + j * 8))
                    j += 1
                } else {
                    mem.put64(to + k * 8, mem.get64(from + i * 8))
                    i += 1
                }
                k += 1
            }
            while i < middle {
                mem.put64(to + k * 8, mem.get64(from + i * 8))
                i += 1
                k += 1
            }
            while j < end {
                mem.put64(to + k * 8, mem.get64(from + j * 8))
                j += 1
                k += 1
            }
            start += 2 * width
        }
        const t = from
        from = to
        to = t
        width = width * 2
    }
    if from != w.*.data { mem.copy(w.*.data, from, n * 8) }
    mem.free(scratch)
}

fn initOrder(o: *Order, count: usize) -> void {
    o.*.count = count
    o.*.columns = mem.alloc(count * 8 + 8)
    o.*.collations = mem.alloc(count * 8 + 8)
    o.*.descending = mem.alloc(count + 1)
    o.*.nulls = mem.alloc(count + 1)
}

fn freeOrder(o: *Order) -> void {
    mem.free(o.*.columns)
    mem.free(o.*.collations)
    mem.free(o.*.descending)
    mem.free(o.*.nulls)
}

// Sorts rows by their first `count` columns in one collation.
pub fn sortRows(rows: usize, count: usize, collation: usize) -> void {
    var o: Order = undefined
    initOrder(&o, count)
    var i: usize = 0
    while i < count {
        mem.put64(o.columns + i * 8, @intCast(u64, i))
        mem.put64(o.collations + i * 8, @intCast(u64, collation))
        i += 1
    }
    sortWords(&core.rowsOf(rows).*.rows, &o)
    freeOrder(&o)
}

// Sorts rows by their first `count` columns, each in its own collation.
pub fn sortRowsBy(rows: usize, count: usize, collations: usize) -> void {
    var o: Order = undefined
    initOrder(&o, count)
    var i: usize = 0
    while i < count {
        mem.put64(o.columns + i * 8, @intCast(u64, i))
        mem.put64(o.collations + i * 8, mem.get64(collations + i * 8))
        i += 1
    }
    sortWords(&core.rowsOf(rows).*.rows, &o)
    freeOrder(&o)
}

// Whether two rows are of the same group (equal on the first `count`
// columns).
pub fn sameGroup(a: usize, b: usize, count: usize, collations: usize) -> bool {
    var i: usize = 0
    while i < count {
        const va = record.valueAt(a, i)
        const vb = record.valueAt(b, i)
        if value.compare(va, vb, @intCast(usize, mem.get64(collations + i * 8))) != 0 { return false }
        i += 1
    }
    return true
}

// Drops rows equal to the one before (after sorting), on the first column.
pub fn dedupRows(rows: usize, collation: usize) -> void {
    const r = core.rowsOf(rows)
    var kept: usize = 0
    var i: usize = 0
    while i < r.*.rows.length {
        const row = @intCast(usize, mem.at(&r.*.rows, i))
        if kept > 0 && value.compare(record.valueAt(@intCast(usize, mem.at(&r.*.rows, kept - 1)), 0), record.valueAt(row, 0), collation) == 0 {
            core.freeRow(row, r.*.width)
        } else {
            mem.set(&r.*.rows, kept, @intCast(u64, row))
            kept += 1
        }
        i += 1
    }
    r.*.rows.length = kept
}

// Sorts gathered rows by an ORDER BY whose values follow the `width`
// result columns.
pub fn sortByOrder(st: *core.Statement, rows: usize, width: usize, orderBy: usize) -> void {
    const n = ast.count(orderBy)
    var o: Order = undefined
    initOrder(&o, n)
    var i: usize = 0
    while i < n {
        const it = ast.itemAt(orderBy, i)
        mem.put64(o.columns + i * 8, @intCast(u64, width + i))
        mem.put64(o.collations + i * 8, @intCast(u64, exprCollation(st, it.*.expr)))
        mem.put8(o.descending + i, if it.*.descending { 1 } else { 0 })
        mem.put8(o.nulls + i, @intCast(u64, it.*.nulls))
        i += 1
    }
    sortWords(&core.rowsOf(rows).*.rows, &o)
    freeOrder(&o)
}

// Sorts a compound's rows by its ORDER BY (terms naming result columns).
pub fn sortCompound(st: *core.Statement, rows: usize, width: usize, orderBy: usize) -> void {
    const n = ast.count(orderBy)
    var o: Order = undefined
    initOrder(&o, n)
    var i: usize = 0
    while i < n {
        const it = ast.itemAt(orderBy, i)
        var e = it.*.expr
        var collation: usize = 0
        if ast.expr(e).*.op == ast.E_COLLATE {
            collation = ast.expr(e).*.collation
            e = ast.expr(e).*.left
        }
        var column: usize = 0
        if ast.expr(e).*.op == ast.E_REGISTER { column = @intCast(usize, ast.expr(e).*.column) }
        mem.put64(o.columns + i * 8, @intCast(u64, column))
        mem.put64(o.collations + i * 8, @intCast(u64, collation))
        mem.put8(o.descending + i, if it.*.descending { 1 } else { 0 })
        mem.put8(o.nulls + i, @intCast(u64, it.*.nulls))
        i += 1
    }
    _ = width
    _ = st
    sortWords(&core.rowsOf(rows).*.rows, &o)
    freeOrder(&o)
}

// ---------------------------------------------------------------------------
// Sets of rows: each row's values as a record (whole reals as integers,
// so that 1 and 1.0 are the same row), hashed. A set may compare its
// columns' texts in collations: NOCASE's texts are kept folded, RTRIM's
// without their trailing spaces (an application's collation compares as
// BINARY here).

const Set = struct {
    buckets: usize
    bucketCount: usize
    count: usize
    // Per column, its collation (0: BINARY), for `width` columns.
    collations: usize
    width: usize
}

fn setOf(address: usize) -> *Set { unsafe { return @ptrFromInt(*Set, address) } }

pub fn newSet() -> usize {
    const address = mem.alloc(@sizeOf(Set))
    const s = setOf(address)
    s.*.bucketCount = 64
    s.*.buckets = mem.alloc(64 * 8)
    return address
}

// A set whose `width` columns compare in the collations at `collations`
// (one word each).
pub fn newCollatedSet(collations: usize, width: usize) -> usize {
    const address = newSet()
    const s = setOf(address)
    s.*.collations = mem.alloc(width * 8 + 8)
    mem.copy(s.*.collations, collations, width * 8)
    s.*.width = width
    return address
}

pub fn clearSet(address: usize) -> void {
    if address == 0 { return }
    const s = setOf(address)
    var i: usize = 0
    while i < s.*.bucketCount {
        var at = @intCast(usize, mem.get64(s.*.buckets + i * 8))
        while at != 0 {
            const next = @intCast(usize, mem.get64(at))
            mem.free(at)
            at = next
        }
        mem.put64(s.*.buckets + i * 8, 0)
        i += 1
    }
    s.*.count = 0
}

pub fn freeSet(address: usize) -> void {
    if address == 0 { return }
    clearSet(address)
    mem.free(setOf(address).*.buckets)
    mem.free(setOf(address).*.collations)
    mem.free(address)
}

fn hashBytes(address: usize, length: usize) -> u64 {
    var h: u64 = 14695981039346656037
    var i: usize = 0
    while i < length {
        h = (h ^ mem.get8(address + i)) *% 1099511628211
        i += 1
    }
    return h
}

// The record of `width` values for set membership.
fn setKey(s: *Set, row: usize, width: usize, out: *mem.Buffer) -> bool {
    const copied = mem.alloc(width * @sizeOf(Value) + 16)
    var i: usize = 0
    while i < width {
        const v = record.valueAt(copied, i)
        value.init(v)
        _ = value.copy(v, record.valueAt(row, i))
        if v.*.kind == value.REAL {
            var whole: i64 = 0
            if numbers.realIsInteger(v.*.r, &whole) { value.setInt(v, whole) }
        }
        if v.*.kind == value.TEXT && i < s.*.width {
            const collation = @intCast(usize, mem.get64(s.*.collations + i * 8))
            if collation != 0 {
                const c: *value.Collation = unsafe { @ptrFromInt(*value.Collation, collation) }
                if c.*.kind == 1 {
                    var k: usize = 0
                    while k < v.*.length {
                        mem.put8(v.*.data + k, mem.lower(mem.get8(v.*.data + k)))
                        k += 1
                    }
                } else if c.*.kind == 2 {
                    while v.*.length > 0 && mem.get8(v.*.data + v.*.length - 1) == 32 { v.*.length -= 1 }
                }
            }
        }
        i += 1
    }
    out.*.length = 0
    const ok = record.encode(copied, width, out)
    core.freeRow(copied, width)
    return ok
}

fn findEntry(s: *Set, key: *mem.Buffer, h: u64) -> bool {
    var at = @intCast(usize, mem.get64(s.*.buckets + @intCast(usize, h % @intCast(u64, s.*.bucketCount)) * 8))
    while at != 0 {
        if mem.get64(at + 8) == h && @intCast(usize, mem.get64(at + 16)) == key.*.length && mem.compare(at + 24, key.*.length, key.*.data, key.*.length) == 0 { return true }
        at = @intCast(usize, mem.get64(at))
    }
    return false
}

// Adds a row to a set: `added` tells whether it was new.
pub fn addToSet(st: *core.Statement, address: usize, row: usize, width: usize, added: *bool) -> i32 {
    _ = st
    const s = setOf(address)
    var key: mem.Buffer = undefined
    mem.initBuffer(&key)
    if !setKey(s, row, width, &key) { return core.NOMEM }
    const h = hashBytes(key.data, key.length)
    if findEntry(s, &key, h) {
        added.* = false
        mem.freeBuffer(&key)
        return core.OK
    }
    const bucket = s.*.buckets + @intCast(usize, h % @intCast(u64, s.*.bucketCount)) * 8
    const entry = mem.alloc(24 + key.length)
    mem.put64(entry, mem.get64(bucket))
    mem.put64(entry + 8, h)
    mem.put64(entry + 16, @intCast(u64, key.length))
    mem.copy(entry + 24, key.data, key.length)
    mem.put64(bucket, @intCast(u64, entry))
    s.*.count += 1
    mem.freeBuffer(&key)
    added.* = true
    if s.*.count > s.*.bucketCount * 2 { regrow(s) }
    return core.OK
}

fn regrow(s: *Set) -> void {
    const old = s.*.buckets
    const oldCount = s.*.bucketCount
    s.*.bucketCount = oldCount * 4
    s.*.buckets = mem.alloc(s.*.bucketCount * 8)
    var i: usize = 0
    while i < oldCount {
        var at = @intCast(usize, mem.get64(old + i * 8))
        while at != 0 {
            const next = @intCast(usize, mem.get64(at))
            const bucket = s.*.buckets + @intCast(usize, mem.get64(at + 8) % @intCast(u64, s.*.bucketCount)) * 8
            mem.put64(at, mem.get64(bucket))
            mem.put64(bucket, @intCast(u64, at))
            at = next
        }
        i += 1
    }
    mem.free(old)
}

fn contains(address: usize, row: usize, width: usize) -> bool {
    var key: mem.Buffer = undefined
    mem.initBuffer(&key)
    _ = setKey(setOf(address), row, width, &key)
    const found = findEntry(setOf(address), &key, hashBytes(key.data, key.length))
    mem.freeBuffer(&key)
    return found
}

// ---------------------------------------------------------------------------
// Compound SELECTs.

// One part of a compound, run on its own.
pub fn runSimple(st: *core.Statement, part: usize, rows: usize, last: bool) -> i32 {
    _ = last
    query.reset(st, part)
    return query.runPart(st, part, rows)
}

// Sorted by every column (BINARY), without repeats: how UNION, INTERSECT
// and EXCEPT leave their rows.
fn sortDistinct(rows: usize, width: usize) -> void {
    var o: Order = undefined
    initOrder(&o, width)
    var i: usize = 0
    while i < width {
        mem.put64(o.columns + i * 8, @intCast(u64, i))
        i += 1
    }
    const r = core.rowsOf(rows)
    sortWords(&r.*.rows, &o)
    var kept: usize = 0
    i = 0
    while i < r.*.rows.length {
        const row = @intCast(usize, mem.at(&r.*.rows, i))
        if kept > 0 && compareRows(&o, @intCast(usize, mem.at(&r.*.rows, kept - 1)), row) == 0 {
            core.freeRow(row, r.*.width)
        } else {
            mem.set(&r.*.rows, kept, @intCast(u64, row))
            kept += 1
        }
        i += 1
    }
    r.*.rows.length = kept
    freeOrder(&o)
}

// Combines a part's rows into the rows so far by a compound operator.
pub fn combine(st: *core.Statement, rows: usize, part: usize, op: u8, width: usize) -> i32 {
    const r = core.rowsOf(rows)
    const p = core.rowsOf(part)
    if op == ast.C_UNION_ALL || op == ast.C_UNION {
        // The part's rows move over.
        var i: usize = 0
        while i < p.*.rows.length {
            const row = @intCast(usize, mem.at(&p.*.rows, i))
            const target = core.addRow(rows)
            var k: usize = 0
            while k < width {
                value.move(record.valueAt(target, k), record.valueAt(row, k))
                k += 1
            }
            i += 1
        }
        if op == ast.C_UNION { sortDistinct(rows, width) }
        return core.OK
    }
    // INTERSECT and EXCEPT: by membership in the part's set.
    const set = newSet()
    var i: usize = 0
    var added = false
    while i < p.*.rows.length {
        _ = addToSet(st, set, @intCast(usize, mem.at(&p.*.rows, i)), width, &added)
        i += 1
    }
    var kept: usize = 0
    i = 0
    while i < r.*.rows.length {
        const row = @intCast(usize, mem.at(&r.*.rows, i))
        const inPart = contains(set, row, width)
        if inPart == (op == ast.C_INTERSECT) {
            mem.set(&r.*.rows, kept, @intCast(u64, row))
            kept += 1
        } else {
            core.freeRow(row, r.*.width)
        }
        i += 1
    }
    r.*.rows.length = kept
    freeSet(set)
    sortDistinct(rows, width)
    return core.OK
}
