// std.sql.numbers: numbers to text and back, as SQLite 3.45 does them.
//
// A REAL becomes text as SQLite's "%!.15g" makes it: 15 significant
// digits, rounded half up on the exact decimal value, trailing zeros
// dropped but one kept after the point (`1.0`, `0.5`), the exponent form
// (`1.0e+15`, `4.94065645841247e-324`) when the exponent is below -4 or
// above 14, `Inf` and `-Inf` for the infinities. The digits come from the
// double's exact value (big integers: the double is m * 2^e, so m * 2^e or
// m * 5^-e is an integer whose decimal digits are the value's); SQLite
// reaches the same digits through an 80-bit long double.
//
// Text becomes a number as sqlite3AtoF and sqlite3Atoi64 read it: spaces
// around, a sign, digits with a point, an exponent; at most 19
// significant digits kept (later ones only move the point), and the
// double nearest to that decimal value (exactly: Clinger's fast path when
// the digits and the power of ten are exact doubles, big integers else).
const mem = @import("./mem.mlx")

// ---------------------------------------------------------------------------
// Big integers of 32-bit limbs (held in 64-bit words), least significant
// first: enough for 2^1077 and for 5^1074 * 2^53.
const LIMBS: usize = 112

const Big = struct {
    n: usize
    limb: [112]u64
}

fn bigSet(b: *Big, value: u64) -> void {
    b.*.n = 0
    var v = value
    while v != 0 {
        b.*.limb[b.*.n] = v & 0xffffffff
        b.*.n += 1
        v = v >> 32
    }
}

fn bigIsZero(b: *Big) -> bool { return b.*.n == 0 }

fn bigMulSmall(b: *Big, k: u64) -> void {
    var carry: u64 = 0
    var i: usize = 0
    while i < b.*.n {
        const product = b.*.limb[i] * k + carry
        b.*.limb[i] = product & 0xffffffff
        carry = product >> 32
        i += 1
    }
    if carry != 0 && b.*.n < LIMBS {
        b.*.limb[b.*.n] = carry
        b.*.n += 1
    }
}

// b / k, the remainder returned (k < 2^32).
fn bigDivSmall(b: *Big, k: u64) -> u64 {
    var rest: u64 = 0
    var i = b.*.n
    while i > 0 {
        i -= 1
        const part = (rest << 32) | b.*.limb[i]
        b.*.limb[i] = part / k
        rest = part % k
    }
    while b.*.n > 0 && b.*.limb[b.*.n - 1] == 0 { b.*.n -= 1 }
    return rest
}

fn bigShiftLeft(b: *Big, bits: usize) -> void {
    if b.*.n == 0 { return }
    const words = bits / 32
    const rest = bits % 32
    if rest != 0 {
        var carry: u64 = 0
        var i: usize = 0
        while i < b.*.n {
            const shifted = (b.*.limb[i] << rest) | carry
            b.*.limb[i] = shifted & 0xffffffff
            carry = shifted >> 32
            i += 1
        }
        if carry != 0 {
            b.*.limb[b.*.n] = carry
            b.*.n += 1
        }
    }
    if words != 0 {
        var i = b.*.n
        while i > 0 {
            i -= 1
            b.*.limb[i + words] = b.*.limb[i]
        }
        i = 0
        while i < words {
            b.*.limb[i] = 0
            i += 1
        }
        b.*.n += words
    }
}

fn bigBits(b: *Big) -> usize {
    if b.*.n == 0 { return 0 }
    var top = b.*.limb[b.*.n - 1]
    var bits = (b.*.n - 1) * 32
    while top != 0 {
        bits += 1
        top = top >> 1
    }
    return bits
}

fn bigBit(b: *Big, index: usize) -> u64 {
    const word = index / 32
    if word >= b.*.n { return 0 }
    return (b.*.limb[word] >> (index % 32)) & 1
}

fn bigCompare(a: *Big, b: *Big) -> i64 {
    if a.*.n != b.*.n { return if a.*.n < b.*.n { -1 } else { 1 } }
    var i = a.*.n
    while i > 0 {
        i -= 1
        if a.*.limb[i] != b.*.limb[i] { return if a.*.limb[i] < b.*.limb[i] { -1 } else { 1 } }
    }
    return 0
}

// a -= b, where a >= b.
fn bigSub(a: *Big, b: *Big) -> void {
    var borrow: u64 = 0
    var i: usize = 0
    while i < a.*.n {
        const bl = if i < b.*.n { b.*.limb[i] } else { 0 }
        const need = bl + borrow
        if a.*.limb[i] >= need {
            a.*.limb[i] = a.*.limb[i] - need
            borrow = 0
        } else {
            a.*.limb[i] = a.*.limb[i] + 4294967296 - need
            borrow = 1
        }
        i += 1
    }
    while a.*.n > 0 && a.*.limb[a.*.n - 1] == 0 { a.*.n -= 1 }
}

fn bigShiftLeftOne(b: *Big) -> void { bigShiftLeft(b, 1) }

// ---------------------------------------------------------------------------
// Doubles from parts.

// The double nearest to mant * 2^exp2 (+ a little when `sticky`), mant's
// top bit set; ties to even.
fn makeDouble(mantissa: u64, exp2: i64, sticky: bool) -> f64 {
    var biased: i64 = exp2 + 63 + 1023
    if biased >= 2047 { return @bitCast(f64, @intCast(u64, 0x7ff0000000000000)) }
    var shift: i64 = 11
    if biased <= 0 {
        shift = 11 + (1 - biased)
        biased = 0
    }
    if shift >= 64 {
        // Below half the smallest subnormal unless exactly representable
        // as one: round to 0 or to it.
        if shift == 64 && (mantissa > 9223372036854775808 || (mantissa == 9223372036854775808 && sticky)) {
            return @bitCast(f64, @intCast(u64, 1))
        }
        return 0.0
    }
    const s = @intCast(u64, shift)
    var m = mantissa >> s
    const rest = mantissa & ((@intCast(u64, 1) << s) - 1)
    const half = @intCast(u64, 1) << (s - 1)
    if rest > half || (rest == half && (sticky || (m & 1) == 1)) {
        m += 1
    }
    if biased == 0 {
        return @bitCast(f64, m)
    }
    if m == 9007199254740992 {
        m = 4503599627370496
        biased += 1
        if biased >= 2047 { return @bitCast(f64, @intCast(u64, 0x7ff0000000000000)) }
    }
    const bits = (@bitCast(u64, biased) << 52) | (m - 4503599627370496)
    return @bitCast(f64, bits)
}

// The double nearest to the big integer times 2^exp2.
fn bigToDouble(b: *Big, exp2: i64, extraSticky: bool) -> f64 {
    const bits = bigBits(b)
    if bits == 0 { return 0.0 }
    var mantissa: u64 = 0
    var sticky = extraSticky
    var i: usize = 0
    while i < 64 {
        mantissa = mantissa << 1
        if bits >= i + 1 { mantissa = mantissa | bigBit(b, bits - 1 - i) }
        i += 1
    }
    if bits > 64 {
        var j: usize = 0
        while j < bits - 64 {
            if bigBit(b, j) != 0 {
                sticky = true
                break
            }
            j += 1
        }
    }
    return makeDouble(mantissa, exp2 + @intCast(i64, bits) - 64, sticky)
}

const exactPowers = [_]f64{ 1.0, 10.0, 100.0, 1000.0, 10000.0, 100000.0, 1000000.0, 10000000.0, 100000000.0, 1000000000.0, 10000000000.0, 100000000000.0, 1000000000000.0, 10000000000000.0, 100000000000000.0, 1000000000000000.0, 10000000000000000.0, 100000000000000000.0, 1000000000000000000.0, 10000000000000000000.0, 100000000000000000000.0, 1000000000000000000000.0, 10000000000000000000000.0 }

// The double nearest to digits * 10^exp10.
pub fn decimalToDouble(digits: u64, exp10: i64) -> f64 {
    if digits == 0 { return 0.0 }
    if digits < 9007199254740992 && exp10 >= -22 && exp10 <= 22 {
        const d = @floatFromInt(f64, digits)
        if exp10 >= 0 { return d * exactPowers[@intCast(usize, exp10)] }
        return d / exactPowers[@intCast(usize, 0 - exp10)]
    }
    if exp10 > 330 { return @bitCast(f64, @intCast(u64, 0x7ff0000000000000)) }
    if exp10 < -360 { return 0.0 }
    var n: Big = undefined
    bigSet(&n, digits)
    if exp10 >= 0 {
        var k: i64 = 0
        while k < exp10 {
            bigMulSmall(&n, 10)
            k += 1
        }
        return bigToDouble(&n, 0, false)
    }
    // digits / 10^-exp10 = digits / 5^-exp10 * 2^exp10: the quotient of
    // digits shifted far enough left to have 64 bits and more, by long
    // division, the remainder's being zero or not the sticky bit.
    var divisor: Big = undefined
    bigSet(&divisor, 1)
    var k: i64 = 0
    while k < 0 - exp10 {
        bigMulSmall(&divisor, 5)
        k += 1
    }
    const shift = bigBits(&divisor) + 66
    bigShiftLeft(&n, shift)
    var quotient: Big = undefined
    bigSet(&quotient, 0)
    var rest: Big = undefined
    bigSet(&rest, 0)
    var bit = bigBits(&n)
    while bit > 0 {
        bit -= 1
        bigShiftLeftOne(&rest)
        if bigBit(&n, bit) != 0 {
            if rest.n == 0 {
                bigSet(&rest, 1)
            } else {
                rest.limb[0] = rest.limb[0] | 1
            }
        }
        bigShiftLeftOne(&quotient)
        if bigCompare(&rest, &divisor) >= 0 {
            bigSub(&rest, &divisor)
            if quotient.n == 0 {
                bigSet(&quotient, 1)
            } else {
                quotient.limb[0] = quotient.limb[0] | 1
            }
        }
    }
    return bigToDouble(&quotient, exp10 - @intCast(i64, shift), !bigIsZero(&rest))
}

// ---------------------------------------------------------------------------
// Text to numbers.

pub inline fn isSpace(c: u64) -> bool { return c == 32 || (c >= 9 && c <= 13) }
pub inline fn isDigit(c: u64) -> bool { return c >= 48 && c <= 57 }

// What a text is as a number: not one, an integer (`12`, `-3`, ` 7 `),
// or a real (`1.5`, `1e3`, `.5`, `5.`); and its value both ways.
pub const NOT_NUMBER: u8 = 0
pub const INTEGER: u8 = 1
pub const REAL: u8 = 2

pub const Parsed = struct {
    kind: u8
    // The whole text was the number (spaces around allowed); else only a
    // prefix of it was.
    whole: bool
    real: f64
    // For INTEGER: whether the value fits in 64 bits, and the value.
    fits: bool
    integer: i64
}

// sqlite3AtoF and sqlite3Atoi64 together over `length` bytes at `text`.
pub fn parse(text: usize, length: usize, out: *Parsed) -> void {
    out.*.kind = NOT_NUMBER
    out.*.whole = false
    out.*.real = 0.0
    out.*.fits = false
    out.*.integer = 0
    var i: usize = 0
    while i < length && isSpace(mem.get8(text + i)) { i += 1 }
    if i == length { return }
    var negative = false
    const signAt = mem.get8(text + i)
    if signAt == 45 {
        negative = true
        i += 1
    } else if signAt == 43 {
        i += 1
    }
    var significand: u64 = 0
    var digitCount: usize = 0
    var exp10: i64 = 0
    var isReal = false
    // The integer's own value (for Atoi64): all digits, checking overflow.
    var whole: u64 = 0
    var wholeOverflow = false
    const firstDigit = i
    while i < length && isDigit(mem.get8(text + i)) {
        const d = mem.get8(text + i) - 48
        if significand < 922337203685477579 {
            significand = significand * 10 + d
        } else {
            exp10 += 1
        }
        if !wholeOverflow {
            if whole > 1844674407370955161 || (whole == 1844674407370955161 && d > 5) {
                wholeOverflow = true
            } else {
                whole = whole * 10 + d
            }
        }
        digitCount += 1
        i += 1
    }
    const integerDigits = digitCount
    var afterInteger = i
    if i < length && mem.get8(text + i) == 46 {
        i += 1
        isReal = true
        while i < length && isDigit(mem.get8(text + i)) {
            const d = mem.get8(text + i) - 48
            if significand < 922337203685477579 {
                significand = significand * 10 + d
                exp10 -= 1
            }
            digitCount += 1
            i += 1
        }
    }
    if digitCount == 0 { return }
    if i < length && (mem.get8(text + i) == 101 || mem.get8(text + i) == 69) {
        var j = i + 1
        var expNegative = false
        if j < length && mem.get8(text + j) == 45 {
            expNegative = true
            j += 1
        } else if j < length && mem.get8(text + j) == 43 {
            j += 1
        }
        if j < length && isDigit(mem.get8(text + j)) {
            var e: i64 = 0
            while j < length && isDigit(mem.get8(text + j)) {
                if e < 100000 { e = e * 10 + @intCast(i64, mem.get8(text + j) - 48) }
                j += 1
            }
            exp10 = if expNegative { exp10 - e } else { exp10 + e }
            isReal = true
            i = j
        }
    }
    var end = i
    while end < length && isSpace(mem.get8(text + end)) { end += 1 }
    out.*.whole = end == length
    var value = decimalToDouble(significand, exp10)
    if negative { value = 0.0 - value }
    out.*.real = value
    if isReal || integerDigits == 0 {
        out.*.kind = REAL
        return
    }
    out.*.kind = INTEGER
    _ = afterInteger
    _ = firstDigit
    if wholeOverflow { return }
    if negative {
        if whole <= 9223372036854775808 {
            out.*.fits = true
            out.*.integer = if whole == 9223372036854775808 { -9223372036854775807 - 1 } else { 0 - @bitCast(i64, whole) }
        }
    } else if whole <= 9223372036854775807 {
        out.*.fits = true
        out.*.integer = @bitCast(i64, whole)
    }
}

// ---------------------------------------------------------------------------
// Numbers to text.

// A double's significant digits (at most `room` of them, the rest
// rounded half up as SQLite's FpDecode rounds), and where the point goes:
// the value is 0.DIGITS * 10^point. Answers the count of digits written to
// `into` (ASCII), 0 for zero.
const Decoded = struct {
    count: usize
    point: i64
}

fn decode(value: f64, into: usize, room: usize, out: *Decoded) -> void {
    const bits = @bitCast(u64, value) & 0x7fffffffffffffff
    out.*.count = 0
    out.*.point = 1
    if bits == 0 { return }
    const biased = @bitCast(i64, bits >> 52)
    var mantissa = bits & 0xfffffffffffff
    var exp2: i64 = 0
    if biased == 0 {
        exp2 = -1074
    } else {
        mantissa = mantissa | 4503599627370496
        exp2 = biased - 1075
    }
    var n: Big = undefined
    bigSet(&n, mantissa)
    var fraction: i64 = 0
    if exp2 >= 0 {
        bigShiftLeft(&n, @intCast(usize, exp2))
    } else {
        var k: i64 = 0
        while k < 0 - exp2 {
            bigMulSmall(&n, 5)
            k += 1
        }
        fraction = 0 - exp2
    }
    // All the decimal digits of n, last first, into a scratch block.
    const scratch = mem.alloc(1200)
    var total: usize = 0
    while !bigIsZero(&n) {
        var chunk = bigDivSmall(&n, 1000000000)
        var k: usize = 0
        while k < 9 {
            mem.put8(scratch + total, 48 + chunk % 10)
            chunk = chunk / 10
            total += 1
            k += 1
        }
    }
    while total > 1 && mem.get8(scratch + total - 1) == 48 { total -= 1 }
    // Digit j (0 = most significant) is scratch[total - 1 - j].
    out.*.point = @intCast(i64, total) - fraction
    var count = if total < room { total } else { room }
    var j: usize = 0
    while j < count {
        mem.put8(into + j, mem.get8(scratch + total - 1 - j))
        j += 1
    }
    if total > room && mem.get8(scratch + total - 1 - room) >= 53 {
        // Round up, carrying.
        var k = room
        while true {
            if k == 0 {
                // All nines: 1 followed by zeros, the point one further.
                mem.put8(into, 49)
                var z: usize = 1
                while z < room {
                    mem.put8(into + z, 48)
                    z += 1
                }
                out.*.point += 1
                break
            }
            k -= 1
            const d = mem.get8(into + k)
            if d < 57 {
                mem.put8(into + k, d + 1)
                break
            }
            mem.put8(into + k, 48)
        }
    }
    mem.free(scratch)
    while count > 1 && mem.get8(into + count - 1) == 48 { count -= 1 }
    out.*.count = count
}

// `value` as SQLite renders a REAL ("%!.15g"), appended to `b`.
pub fn appendReal(b: *mem.Buffer, value: f64) -> bool {
    const bits = @bitCast(u64, value)
    const negative = (bits >> 63) != 0
    if (bits & 0x7ff0000000000000) == 0x7ff0000000000000 {
        if (bits & 0xfffffffffffff) != 0 { return mem.appendText(b, "NaN") }
        return mem.appendText(b, if negative { "-Inf" } else { "Inf" })
    }
    if (bits & 0x7fffffffffffffff) == 0 {
        return mem.appendText(b, if negative { "-0.0" } else { "0.0" })
    }
    var digitsBlock = mem.alloc(32)
    var d: Decoded = undefined
    decode(value, digitsBlock, 15, &d)
    if !mem.reserve(b, 40) {
        mem.free(digitsBlock)
        return false
    }
    if negative { _ = mem.appendByte(b, 45) }
    const exponent = d.point - 1
    if exponent < -4 || exponent > 14 {
        _ = mem.appendByte(b, mem.get8(digitsBlock))
        _ = mem.appendByte(b, 46)
        if d.count > 1 {
            _ = mem.append(b, digitsBlock + 1, d.count - 1)
        } else {
            _ = mem.appendByte(b, 48)
        }
        _ = mem.appendByte(b, 101)
        var e = exponent
        if e < 0 {
            _ = mem.appendByte(b, 45)
            e = 0 - e
        } else {
            _ = mem.appendByte(b, 43)
        }
        const eu = @bitCast(u64, e)
        if eu >= 100 { _ = mem.appendByte(b, 48 + eu / 100) }
        _ = mem.appendByte(b, 48 + (eu / 10) % 10)
        _ = mem.appendByte(b, 48 + eu % 10)
    } else if d.point <= 0 {
        _ = mem.appendText(b, "0.")
        var z = d.point
        while z < 0 {
            _ = mem.appendByte(b, 48)
            z += 1
        }
        _ = mem.append(b, digitsBlock, d.count)
    } else {
        const p = @bitCast(u64, d.point)
        var j: usize = 0
        while j < p {
            _ = mem.appendByte(b, if j < d.count { mem.get8(digitsBlock + j) } else { 48 })
            j += 1
        }
        _ = mem.appendByte(b, 46)
        if d.count > p {
            _ = mem.append(b, digitsBlock + p, d.count - p)
        } else {
            _ = mem.appendByte(b, 48)
        }
    }
    mem.free(digitsBlock)
    return true
}

// The significant digits of `value` rounded to `precision` (1 to 26) and
// the decimal point's place, for printf's %e, %f and %g.
pub fn digitsOf(value: f64, precision: usize, into: usize, point: *i64) -> usize {
    var d: Decoded = undefined
    decode(value, into, precision, &d)
    point.* = d.point
    return d.count
}

// Whether a double holds a whole number that an i64 holds as well, and
// that number (sqlite3VdbeIntegerAffinity's test).
pub fn realIsInteger(value: f64, out: *i64) -> bool {
    if value != value { return false }
    if value < -9223372036854775808.0 || value >= 9223372036854775808.0 { return false }
    const i = @intFromFloat(i64, value)
    if @floatFromInt(f64, i) != value { return false }
    // SQLite keeps the two ends of the range as reals.
    if i == 9223372036854775807 || i == -9223372036854775807 - 1 { return false }
    out.* = i
    return true
}

// sqlite3RealToI64: a double cut toward zero, saturated at the ends.
pub fn realToInteger(value: f64) -> i64 {
    if value != value { return 0 }
    if value <= -9223372036854775808.0 { return -9223372036854775807 - 1 }
    if value >= 9223372036854775807.0 { return 9223372036854775807 }
    return @intFromFloat(i64, value)
}
