// std.sql.functions: SQLite's built-in functions and aggregates, and
// those an application registers (sqlite3_create_function: called through
// the C pointers it gave, with a Context and the argument Values).
//
// The scalar functions are SQLite's core set: abs, changes, char,
// coalesce, format/printf, glob, hex, ifnull, iif, instr, last_insert_rowid,
// length, like, likelihood, likely, lower, ltrim, max, min, nullif, quote,
// random, randomblob, replace, round, rtrim, sign, sqlite_version, substr,
// total_changes, trim, typeof, unicode, unlikely, upper, zeroblob; and the
// date and time functions (date, time, datetime, julianday, unixepoch,
// strftime) over 'now', ISO-8601 texts, Julian day numbers and Unix
// times with the usual modifiers. The aggregates: count, sum, total, avg,
// min, max, group_concat (and DISTINCT for each). The table-valued
// pragma_table_info, pragma_index_list and pragma_index_info.
const mem = @import("./mem.mlx")
const value = @import("./value.mlx")
const record = @import("./record.mlx")
const numbers = @import("./numbers.mlx")
const ast = @import("./ast.mlx")
const core = @import("./core.mlx")
const eval = @import("./eval.mlx")
const schema = @import("./schema.mlx")
const os = @import("./os.mlx")
const dates = @import("./dates.mlx")

const Value = value.Value

fn databaseOf(st: *core.Statement) -> *core.Database { return core.database(st.*.db) }

// Built-in functions' numbers.
const F_ABS: u32 = 1
const F_CHANGES: u32 = 2
const F_CHAR: u32 = 3
const F_COALESCE: u32 = 4
const F_GLOB: u32 = 5
const F_HEX: u32 = 6
const F_IFNULL: u32 = 7
const F_IIF: u32 = 8
const F_INSTR: u32 = 9
const F_LAST_INSERT_ROWID: u32 = 10
const F_LENGTH: u32 = 11
const F_LIKE: u32 = 12
const F_LIKELY: u32 = 13
const F_LOWER: u32 = 14
const F_LTRIM: u32 = 15
const F_MAX: u32 = 16
const F_MIN: u32 = 17
const F_NULLIF: u32 = 18
const F_PRINTF: u32 = 19
const F_QUOTE: u32 = 20
const F_RANDOM: u32 = 21
const F_RANDOMBLOB: u32 = 22
const F_REPLACE: u32 = 23
const F_ROUND: u32 = 24
const F_RTRIM: u32 = 25
const F_SIGN: u32 = 26
const F_VERSION: u32 = 27
const F_SUBSTR: u32 = 28
const F_TOTAL_CHANGES: u32 = 29
const F_TRIM: u32 = 30
const F_TYPEOF: u32 = 31
const F_UNICODE: u32 = 32
const F_UPPER: u32 = 33
const F_ZEROBLOB: u32 = 34
const F_DATE: u32 = 35
const F_TIME: u32 = 36
const F_DATETIME: u32 = 37
const F_JULIANDAY: u32 = 38
const F_UNIXEPOCH: u32 = 39
const F_STRFTIME: u32 = 40
const F_CURRENT_TIMESTAMP: u32 = 41
const F_CURRENT_DATE: u32 = 42
const F_CURRENT_TIME: u32 = 43
const F_LIKELIHOOD: u32 = 44
const F_OCTET_LENGTH: u32 = 45
const F_CONCAT: u32 = 46
const F_CONCAT_WS: u32 = 47

fn addBuiltin(db: *core.Database, name: []const u8, arguments: i32, builtin: u32) -> void {
    const address = mem.alloc(@sizeOf(core.Function))
    const f = core.functionOf(address)
    f.*.name = mem.dupText(name)
    f.*.nameLength = name.length
    f.*.arguments = arguments
    f.*.builtin = builtin
    f.*.deterministic = true
    f.*.next = db.*.functions
    db.*.functions = address
}

// The built-in functions on a new connection.
pub fn registerBuiltins(db: *core.Database) -> void {
    addBuiltin(db, "abs", 1, F_ABS)
    addBuiltin(db, "changes", 0, F_CHANGES)
    addBuiltin(db, "char", -1, F_CHAR)
    addBuiltin(db, "coalesce", -1, F_COALESCE)
    addBuiltin(db, "glob", 2, F_GLOB)
    addBuiltin(db, "hex", 1, F_HEX)
    addBuiltin(db, "ifnull", 2, F_IFNULL)
    addBuiltin(db, "iif", 3, F_IIF)
    addBuiltin(db, "instr", 2, F_INSTR)
    addBuiltin(db, "last_insert_rowid", 0, F_LAST_INSERT_ROWID)
    addBuiltin(db, "length", 1, F_LENGTH)
    addBuiltin(db, "octet_length", 1, F_OCTET_LENGTH)
    addBuiltin(db, "like", 2, F_LIKE)
    addBuiltin(db, "like", 3, F_LIKE)
    addBuiltin(db, "likely", 1, F_LIKELY)
    addBuiltin(db, "unlikely", 1, F_LIKELY)
    addBuiltin(db, "likelihood", 2, F_LIKELIHOOD)
    addBuiltin(db, "lower", 1, F_LOWER)
    addBuiltin(db, "ltrim", 1, F_LTRIM)
    addBuiltin(db, "ltrim", 2, F_LTRIM)
    addBuiltin(db, "max", -1, F_MAX)
    addBuiltin(db, "min", -1, F_MIN)
    addBuiltin(db, "nullif", 2, F_NULLIF)
    addBuiltin(db, "printf", -1, F_PRINTF)
    addBuiltin(db, "format", -1, F_PRINTF)
    addBuiltin(db, "quote", 1, F_QUOTE)
    addBuiltin(db, "random", 0, F_RANDOM)
    addBuiltin(db, "randomblob", 1, F_RANDOMBLOB)
    addBuiltin(db, "replace", 3, F_REPLACE)
    addBuiltin(db, "round", 1, F_ROUND)
    addBuiltin(db, "round", 2, F_ROUND)
    addBuiltin(db, "rtrim", 1, F_RTRIM)
    addBuiltin(db, "rtrim", 2, F_RTRIM)
    addBuiltin(db, "sign", 1, F_SIGN)
    addBuiltin(db, "sqlite_version", 0, F_VERSION)
    addBuiltin(db, "substr", 2, F_SUBSTR)
    addBuiltin(db, "substr", 3, F_SUBSTR)
    addBuiltin(db, "substring", 2, F_SUBSTR)
    addBuiltin(db, "substring", 3, F_SUBSTR)
    addBuiltin(db, "total_changes", 0, F_TOTAL_CHANGES)
    addBuiltin(db, "trim", 1, F_TRIM)
    addBuiltin(db, "trim", 2, F_TRIM)
    addBuiltin(db, "typeof", 1, F_TYPEOF)
    addBuiltin(db, "unicode", 1, F_UNICODE)
    addBuiltin(db, "upper", 1, F_UPPER)
    addBuiltin(db, "zeroblob", 1, F_ZEROBLOB)
    addBuiltin(db, "date", -1, F_DATE)
    addBuiltin(db, "time", -1, F_TIME)
    addBuiltin(db, "datetime", -1, F_DATETIME)
    addBuiltin(db, "julianday", -1, F_JULIANDAY)
    addBuiltin(db, "unixepoch", -1, F_UNIXEPOCH)
    addBuiltin(db, "strftime", -1, F_STRFTIME)
    addBuiltin(db, "current_timestamp", 0, F_CURRENT_TIMESTAMP)
    addBuiltin(db, "current_date", 0, F_CURRENT_DATE)
    addBuiltin(db, "current_time", 0, F_CURRENT_TIME)
    addBuiltin(db, "concat", -1, F_CONCAT)
    addBuiltin(db, "concat_ws", -1, F_CONCAT_WS)
}

pub fn freeFunctions(db: *core.Database) -> void {
    var at = db.*.functions
    while at != 0 {
        const f = core.functionOf(at)
        const next = f.*.next
        if f.*.destroy != 0 && f.*.builtin == 0 {
            const destroy: core.DestroyFn = unsafe { @ptrFromInt(core.DestroyFn, f.*.destroy) }
            destroy(f.*.userData)
        }
        mem.free(f.*.name)
        mem.free(at)
        at = next
    }
    db.*.functions = 0
}

// The function for a call with `arguments` arguments: one registered for
// that many first, then one taking any number. 0 when there is none.
pub fn find(db: *core.Database, name: []const u8, arguments: i32) -> usize {
    var any: usize = 0
    var at = db.*.functions
    while at != 0 {
        const f = core.functionOf(at)
        if mem.sameNoCase(mem.view(f.*.name, f.*.nameLength), name) {
            if f.*.arguments == arguments { return at }
            if f.*.arguments == -1 && any == 0 { any = at }
        }
        at = f.*.next
    }
    // max() and min() with one argument are the aggregates; coalesce
    // needs two at least.
    if any != 0 {
        const f = core.functionOf(any)
        if (f.*.builtin == F_MAX || f.*.builtin == F_MIN) && arguments < 2 { return 0 }
        if (f.*.builtin == F_COALESCE || f.*.builtin == F_CONCAT_WS) && arguments < 2 { return 0 }
        if f.*.builtin == F_CONCAT && arguments < 1 { return 0 }
        if (f.*.builtin == F_PRINTF) && arguments < 1 { return 0 }
    }
    return any
}

// An application's function (not a built-in) of this name and arity.
pub fn findUser(db: *core.Database, name: []const u8, arguments: i32) -> usize {
    const f = find(db, name, arguments)
    if f != 0 && core.functionOf(f).*.builtin == 0 { return f }
    return 0
}

pub fn knownName(db: *core.Database, name: []const u8) -> bool {
    if mem.sameNoCase(name, "count") || mem.sameNoCase(name, "sum") || mem.sameNoCase(name, "total") || mem.sameNoCase(name, "avg") || mem.sameNoCase(name, "group_concat") { return true }
    var at = db.*.functions
    while at != 0 {
        const f = core.functionOf(at)
        if mem.sameNoCase(mem.view(f.*.name, f.*.nameLength), name) { return true }
        at = f.*.next
    }
    return false
}

// Registers (or replaces, or with a null pointer removes) an
// application's function.
pub fn register(db: *core.Database, name: []const u8, arguments: i32, call: usize, step: usize, final: usize, userData: usize, destroy: usize, deterministic: bool) -> void {
    // The same name and arity is replaced.
    var link = &db.*.functions
    while link.* != 0 {
        const f = core.functionOf(link.*)
        if f.*.builtin == 0 && f.*.arguments == arguments && mem.sameNoCase(mem.view(f.*.name, f.*.nameLength), name) {
            const next = f.*.next
            if f.*.destroy != 0 {
                const d: core.DestroyFn = unsafe { @ptrFromInt(core.DestroyFn, f.*.destroy) }
                d(f.*.userData)
            }
            mem.free(f.*.name)
            mem.free(link.*)
            link.* = next
            break
        }
        link = &f.*.next
    }
    if call == 0 && step == 0 { return }
    const address = mem.alloc(@sizeOf(core.Function))
    const f = core.functionOf(address)
    f.*.name = mem.dupText(name)
    f.*.nameLength = name.length
    f.*.arguments = arguments
    f.*.call = call
    f.*.step = step
    f.*.final = final
    f.*.userData = userData
    f.*.destroy = destroy
    f.*.deterministic = deterministic
    f.*.next = db.*.functions
    db.*.functions = address
}

// ---------------------------------------------------------------------------
// Calls.

// Calls the function of an E_FUNCTION expression into `out`.
pub fn call(st: *core.Statement, e: usize, out: *Value) -> i32 {
    const x = ast.expr(e)
    const f = core.functionOf(x.*.function)
    const n = ast.count(x.*.list)
    // Arguments, evaluated (lazily for the ones that short-circuit).
    if f.*.builtin == F_COALESCE || f.*.builtin == F_IFNULL {
        var i: usize = 0
        while i < n {
            const rc = eval.evaluate(st, ast.exprAt(x.*.list, i), out)
            if rc != core.OK { return rc }
            if out.*.kind != value.NULL { return core.OK }
            i += 1
        }
        value.setNull(out)
        return core.OK
    }
    if f.*.builtin == F_IIF {
        var truth: i8 = 0
        const rc = eval.condition(st, ast.exprAt(x.*.list, 0), &truth)
        if rc != core.OK { return rc }
        return eval.evaluate(st, ast.exprAt(x.*.list, if truth == 1 { 1 } else { 2 }), out)
    }
    const args = mem.alloc((n + 1) * @sizeOf(Value))
    var i: usize = 0
    while i < n {
        value.init(record.valueAt(args, i))
        i += 1
    }
    var rc = core.OK
    i = 0
    while i < n && rc == core.OK {
        rc = eval.evaluate(st, ast.exprAt(x.*.list, i), record.valueAt(args, i))
        i += 1
    }
    if rc == core.OK {
        if f.*.builtin != 0 {
            rc = builtin(st, f.*.builtin, args, n, out, x)
        } else {
            rc = callC(st, f, args, n, out)
        }
    }
    core.freeRow(args, n)
    return rc
}

// An application's C function: (sqlite3_context*, argc, sqlite3_value**).
fn callC(st: *core.Statement, f: *core.Function, args: usize, n: usize, out: *Value) -> i32 {
    if f.*.call == 0 {
        return core.setError2(databaseOf(st), core.ERROR, "misuse of aggregate: ", mem.view(f.*.name, f.*.nameLength))
    }
    var context: core.Context = undefined
    context.out = @intFromPtr(out)
    context.function = @intFromPtr(f)
    context.db = st.*.db
    context.statement = @intFromPtr(st)
    context.errorCode = core.OK
    mem.initBuffer(&context.message)
    context.aggregate = 0
    context.aggregateSize = 0
    context.skip = false
    const pointers = mem.alloc((n + 1) * 8)
    var i: usize = 0
    while i < n {
        mem.put64(pointers + i * 8, @intCast(u64, @intFromPtr(record.valueAt(args, i))))
        i += 1
    }
    value.setNull(out)
    const callee: core.FunctionFn = unsafe { @ptrFromInt(core.FunctionFn, f.*.call) }
    callee(@intFromPtr(&context), @intCast(i32, n), pointers)
    mem.free(pointers)
    var rc = core.OK
    if context.errorCode != core.OK {
        rc = core.setError(databaseOf(st), context.errorCode, mem.bufferText(&context.message))
    }
    mem.freeBuffer(&context.message)
    return rc
}

fn arg(args: usize, i: usize) -> *Value { return record.valueAt(args, i) }

fn fail(st: *core.Statement, message: []const u8) -> i32 { return core.setError(databaseOf(st), core.ERROR, message) }

// The number of UTF-8 characters in `length` bytes.
fn characters(address: usize, length: usize) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < length {
        if (mem.get8(address + i) & 0xc0) != 0x80 { n += 1 }
        i += 1
    }
    return n
}

// The byte offset of character `index` (0-based) in UTF-8 text.
fn characterOffset(address: usize, length: usize, index: usize) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < length {
        if (mem.get8(address + i) & 0xc0) != 0x80 {
            if n == index { return i }
            n += 1
        }
        i += 1
    }
    return length
}

fn builtin(st: *core.Statement, kind: u32, args: usize, n: usize, out: *Value, x: *ast.Expr) -> i32 {
    const db = databaseOf(st)
    if kind == F_ABS {
        const v = arg(args, 0)
        if v.*.kind == value.NULL {
            value.setNull(out)
        } else if v.*.kind == value.INTEGER {
            if v.*.i == -9223372036854775807 - 1 { return fail(st, "integer overflow") }
            value.setInt(out, if v.*.i < 0 { 0 - v.*.i } else { v.*.i })
        } else {
            const r = value.toReal(v)
            value.setReal(out, if r < 0.0 { 0.0 - r } else { r })
        }
        return core.OK
    }
    if kind == F_CHANGES {
        value.setInt(out, db.*.changes)
        return core.OK
    }
    if kind == F_TOTAL_CHANGES {
        value.setInt(out, db.*.totalChanges)
        return core.OK
    }
    if kind == F_LAST_INSERT_ROWID {
        value.setInt(out, db.*.lastInsertRowid)
        return core.OK
    }
    if kind == F_CHAR {
        var b: mem.Buffer = undefined
        mem.initBuffer(&b)
        var i: usize = 0
        while i < n {
            var c = value.toInt(arg(args, i))
            if c < 0 || c > 0x10ffff { c = 0xfffd }
            appendUtf8(&b, @bitCast(u64, c))
            i += 1
        }
        _ = value.setText(out, b.data, b.length)
        mem.freeBuffer(&b)
        return core.OK
    }
    if kind == F_GLOB || kind == F_LIKE {
        const pattern = arg(args, 0)
        const subject = arg(args, 1)
        if pattern.*.kind == value.NULL || subject.*.kind == value.NULL || (n == 3 && arg(args, 2).*.kind == value.NULL) {
            value.setNull(out)
            return core.OK
        }
        _ = value.toText(pattern)
        _ = value.toText(subject)
        if kind == F_GLOB {
            value.setBool(out, glob(pattern.*.data, pattern.*.length, subject.*.data, subject.*.length))
        } else {
            var escape: i64 = -1
            if n == 3 {
                const e = arg(args, 2)
                _ = value.toText(e)
                if characters(e.*.data, e.*.length) != 1 { return fail(st, "ESCAPE expression must be a single character") }
                escape = @intCast(i64, mem.get8(e.*.data))
            }
            value.setBool(out, like(pattern.*.data, pattern.*.length, subject.*.data, subject.*.length, escape, !db.*.caseSensitiveLike))
        }
        return core.OK
    }
    if kind == F_HEX {
        const v = arg(args, 0)
        _ = value.toBlob(v)
        var b: mem.Buffer = undefined
        mem.initBuffer(&b)
        var i: usize = 0
        while i < v.*.length {
            const c = mem.get8(v.*.data + i)
            _ = mem.appendByte(&b, hexDigit(c >> 4))
            _ = mem.appendByte(&b, hexDigit(c & 15))
            i += 1
        }
        _ = value.setText(out, b.data, b.length)
        mem.freeBuffer(&b)
        return core.OK
    }
    if kind == F_INSTR {
        const haystack = arg(args, 0)
        const needle = arg(args, 1)
        if haystack.*.kind == value.NULL || needle.*.kind == value.NULL {
            value.setNull(out)
            return core.OK
        }
        const blobs = haystack.*.kind == value.BLOB && needle.*.kind == value.BLOB
        if !blobs {
            _ = value.toText(haystack)
            _ = value.toText(needle)
        }
        var position: i64 = 0
        if needle.*.length <= haystack.*.length {
            var i: usize = 0
            while i + needle.*.length <= haystack.*.length {
                if mem.compare(haystack.*.data + i, needle.*.length, needle.*.data, needle.*.length) == 0 {
                    position = if blobs { @intCast(i64, i) + 1 } else { @intCast(i64, characters(haystack.*.data, i)) + 1 }
                    break
                }
                i += 1
            }
        }
        value.setInt(out, position)
        return core.OK
    }
    if kind == F_LENGTH || kind == F_OCTET_LENGTH {
        const v = arg(args, 0)
        if v.*.kind == value.NULL {
            value.setNull(out)
        } else if v.*.kind == value.BLOB || kind == F_OCTET_LENGTH {
            if v.*.kind != value.BLOB { _ = value.toText(v) }
            value.setInt(out, @intCast(i64, v.*.length))
        } else {
            _ = value.toText(v)
            // The characters before a 0 (SQLite's strlen of the text).
            var end: usize = 0
            while end < v.*.length && mem.get8(v.*.data + end) != 0 { end += 1 }
            value.setInt(out, @intCast(i64, characters(v.*.data, end)))
        }
        return core.OK
    }
    if kind == F_LIKELY || kind == F_LIKELIHOOD {
        _ = value.copy(out, arg(args, 0))
        return core.OK
    }
    if kind == F_LOWER || kind == F_UPPER {
        const v = arg(args, 0)
        if v.*.kind == value.NULL {
            value.setNull(out)
            return core.OK
        }
        _ = value.toText(v)
        _ = value.setText(out, v.*.data, v.*.length)
        var i: usize = 0
        while i < out.*.length {
            const c = mem.get8(out.*.data + i)
            mem.put8(out.*.data + i, if kind == F_LOWER { mem.lower(c) } else { mem.upper(c) })
            i += 1
        }
        return core.OK
    }
    if kind == F_LTRIM || kind == F_RTRIM || kind == F_TRIM {
        return trim(args, n, out, kind != F_RTRIM, kind != F_LTRIM)
    }
    if kind == F_MAX || kind == F_MIN {
        var best: usize = 0
        const collation = eval.exprCollation(st, ast.exprAt(x.*.list, 0))
        var i: usize = 0
        while i < n {
            const v = arg(args, i)
            if v.*.kind == value.NULL {
                value.setNull(out)
                return core.OK
            }
            if i > 0 {
                const c = value.compare(v, arg(args, best), collation)
                if (kind == F_MAX && c > 0) || (kind == F_MIN && c < 0) { best = i }
            }
            i += 1
        }
        _ = value.copy(out, arg(args, best))
        return core.OK
    }
    if kind == F_NULLIF {
        const a = arg(args, 0)
        const b = arg(args, 1)
        const collation = eval.binaryCollation(st, ast.exprAt(x.*.list, 0), ast.exprAt(x.*.list, 1))
        if a.*.kind != value.NULL && b.*.kind != value.NULL && value.compare(a, b, collation) == 0 {
            value.setNull(out)
        } else {
            _ = value.copy(out, a)
        }
        return core.OK
    }
    if kind == F_PRINTF { return printf(st, args, n, out) }
    if kind == F_QUOTE {
        var b: mem.Buffer = undefined
        mem.initBuffer(&b)
        quote(arg(args, 0), &b)
        _ = value.setText(out, b.data, b.length)
        mem.freeBuffer(&b)
        return core.OK
    }
    if kind == F_RANDOM {
        const block = mem.alloc(8)
        os.randomBytes(block, 8)
        value.setInt(out, @bitCast(i64, mem.get64(block)))
        mem.free(block)
        return core.OK
    }
    if kind == F_RANDOMBLOB {
        var size = value.toInt(arg(args, 0))
        if size < 1 { size = 1 }
        if !value.setZeroBlob(out, @intCast(usize, size)) { return core.NOMEM }
        os.randomBytes(out.*.data, @intCast(usize, size))
        return core.OK
    }
    if kind == F_REPLACE {
        const subject = arg(args, 0)
        const pattern = arg(args, 1)
        const replacement = arg(args, 2)
        if subject.*.kind == value.NULL || pattern.*.kind == value.NULL || replacement.*.kind == value.NULL {
            value.setNull(out)
            return core.OK
        }
        _ = value.toText(subject)
        _ = value.toText(pattern)
        _ = value.toText(replacement)
        if pattern.*.length == 0 {
            _ = value.copy(out, subject)
            return core.OK
        }
        var b: mem.Buffer = undefined
        mem.initBuffer(&b)
        var i: usize = 0
        while i < subject.*.length {
            if i + pattern.*.length <= subject.*.length && mem.compare(subject.*.data + i, pattern.*.length, pattern.*.data, pattern.*.length) == 0 {
                _ = mem.append(&b, replacement.*.data, replacement.*.length)
                i += pattern.*.length
            } else {
                _ = mem.appendByte(&b, mem.get8(subject.*.data + i))
                i += 1
            }
        }
        _ = value.setText(out, b.data, b.length)
        mem.freeBuffer(&b)
        return core.OK
    }
    if kind == F_ROUND {
        const v = arg(args, 0)
        if v.*.kind == value.NULL || (n == 2 && arg(args, 1).*.kind == value.NULL) {
            value.setNull(out)
            return core.OK
        }
        var digits: i64 = 0
        if n == 2 { digits = value.toInt(arg(args, 1)) }
        if digits > 30 { digits = 30 }
        if digits < 0 { digits = 0 }
        value.setReal(out, roundTo(value.toReal(v), digits))
        return core.OK
    }
    if kind == F_SIGN {
        var number: Value = undefined
        value.init(&number)
        value.numeric(arg(args, 0), &number)
        if number.kind == value.NULL || (arg(args, 0).*.kind != value.INTEGER && arg(args, 0).*.kind != value.REAL && !looksNumeric(arg(args, 0))) {
            value.setNull(out)
        } else {
            const r = value.toReal(&number)
            value.setInt(out, if r > 0.0 { 1 } else if r < 0.0 { -1 } else { 0 })
        }
        value.release(&number)
        return core.OK
    }
    if kind == F_VERSION {
        _ = value.setString(out, "3.45.1")
        return core.OK
    }
    if kind == F_SUBSTR { return substr(args, n, out) }
    if kind == F_TYPEOF {
        const v = arg(args, 0)
        _ = value.setString(out, match v.*.kind {
            1 => "integer",
            2 => "real",
            3 => "text",
            4 => "blob",
            else => "null",
        })
        return core.OK
    }
    if kind == F_UNICODE {
        const v = arg(args, 0)
        if v.*.kind == value.NULL {
            value.setNull(out)
            return core.OK
        }
        _ = value.toText(v)
        if v.*.length == 0 {
            value.setNull(out)
            return core.OK
        }
        var at: usize = 0
        value.setInt(out, @intCast(i64, readUtf8(v.*.data, v.*.length, &at)))
        return core.OK
    }
    if kind == F_ZEROBLOB {
        var size = value.toInt(arg(args, 0))
        if size < 0 { size = 0 }
        if size > 1000000000 { return core.setError(db, core.TOOBIG, "string or blob too big") }
        if !value.setZeroBlob(out, @intCast(usize, size)) { return core.NOMEM }
        return core.OK
    }
    if kind == F_CONCAT || kind == F_CONCAT_WS {
        var b: mem.Buffer = undefined
        mem.initBuffer(&b)
        var start: usize = 0
        var separator: Value = undefined
        value.init(&separator)
        if kind == F_CONCAT_WS {
            if arg(args, 0).*.kind == value.NULL {
                value.setNull(out)
                return core.OK
            }
            _ = value.copy(&separator, arg(args, 0))
            _ = value.toText(&separator)
            start = 1
        }
        var first = true
        var i = start
        while i < n {
            const v = arg(args, i)
            if v.*.kind != value.NULL {
                if !first && kind == F_CONCAT_WS { _ = mem.append(&b, separator.data, separator.length) }
                _ = value.toText(v)
                _ = mem.append(&b, v.*.data, v.*.length)
                first = false
            }
            i += 1
        }
        _ = value.setText(out, b.data, b.length)
        mem.freeBuffer(&b)
        value.release(&separator)
        return core.OK
    }
    if kind >= F_DATE && kind <= F_CURRENT_TIME {
        return dates.call(st, kind - F_DATE, args, n, out)
    }
    value.setNull(out)
    return core.OK
}

fn looksNumeric(v: *Value) -> bool {
    if v.*.kind != value.TEXT { return false }
    var p: numbers.Parsed = undefined
    numbers.parse(v.*.data, v.*.length, &p)
    return p.kind != numbers.NOT_NUMBER && p.whole
}

fn hexDigit(d: u64) -> u64 { return if d < 10 { 48 + d } else { 55 + d } }

pub fn appendUtf8(b: *mem.Buffer, c: u64) -> void {
    if c < 0x80 {
        _ = mem.appendByte(b, c)
    } else if c < 0x800 {
        _ = mem.appendByte(b, 0xc0 | (c >> 6))
        _ = mem.appendByte(b, 0x80 | (c & 63))
    } else if c < 0x10000 {
        _ = mem.appendByte(b, 0xe0 | (c >> 12))
        _ = mem.appendByte(b, 0x80 | ((c >> 6) & 63))
        _ = mem.appendByte(b, 0x80 | (c & 63))
    } else {
        _ = mem.appendByte(b, 0xf0 | (c >> 18))
        _ = mem.appendByte(b, 0x80 | ((c >> 12) & 63))
        _ = mem.appendByte(b, 0x80 | ((c >> 6) & 63))
        _ = mem.appendByte(b, 0x80 | (c & 63))
    }
}

// The character at `at` (advanced past it), as SQLite reads UTF-8.
pub fn readUtf8(address: usize, length: usize, at: *usize) -> u64 {
    var c = mem.get8(address + at.*)
    at.* += 1
    if c < 0xc0 { return c }
    var extra: usize = 0
    if c >= 0xf0 {
        c = c & 7
        extra = 3
    } else if c >= 0xe0 {
        c = c & 15
        extra = 2
    } else {
        c = c & 31
        extra = 1
    }
    while extra > 0 && at.* < length && (mem.get8(address + at.*) & 0xc0) == 0x80 {
        c = (c << 6) | (mem.get8(address + at.*) & 63)
        at.* += 1
        extra -= 1
    }
    return c
}

// round(r, digits) as SQLite rounds: half away from zero at `digits`
// decimals (by printing and reading back for large digit counts).
fn roundTo(r: f64, digits: i64) -> f64 {
    if r != r { return r }
    if r < -4503599627370496.0 || r > 4503599627370496.0 { return r }
    if digits == 0 {
        const t = @trunc(r)
        const rest = r - t
        if rest >= 0.5 { return t + 1.0 }
        if rest <= -0.5 { return t - 1.0 }
        return t
    }
    // "%.*f" then back, as SQLite does.
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    formatFixed(&b, r, @intCast(usize, digits))
    var p: numbers.Parsed = undefined
    numbers.parse(b.data, b.length, &p)
    mem.freeBuffer(&b)
    return p.real
}

fn trim(args: usize, n: usize, out: *Value, left: bool, right: bool) -> i32 {
    const v = arg(args, 0)
    if v.*.kind == value.NULL || (n == 2 && arg(args, 1).*.kind == value.NULL) {
        value.setNull(out)
        return core.OK
    }
    _ = value.toText(v)
    var set: Value = undefined
    value.init(&set)
    if n == 2 {
        _ = value.copy(&set, arg(args, 1))
        _ = value.toText(&set)
    } else {
        _ = value.setString(&set, " ")
    }
    var start: usize = 0
    var end = v.*.length
    // The set's characters (UTF-8, compared whole).
    if left {
        while start < end {
            const length = setMatch(&set, v.*.data + start, end - start)
            if length == 0 { break }
            start += length
        }
    }
    if right {
        while end > start {
            var back = end - 1
            while back > start && (mem.get8(v.*.data + back) & 0xc0) == 0x80 { back -= 1 }
            if setMatch(&set, v.*.data + back, end - back) != end - back { break }
            end = back
        }
    }
    _ = value.setText(out, v.*.data + start, end - start)
    value.release(&set)
    return core.OK
}

// The length of the set's character that starts `text`, or 0.
fn setMatch(set: *Value, text: usize, length: usize) -> usize {
    var i: usize = 0
    while i < set.*.length {
        var j = i
        _ = readUtf8(set.*.data, set.*.length, &j)
        const size = j - i
        if size <= length && mem.compare(set.*.data + i, size, text, size) == 0 { return size }
        i = j
    }
    return 0
}

fn substr(args: usize, n: usize, out: *Value) -> i32 {
    const v = arg(args, 0)
    if v.*.kind == value.NULL || arg(args, 1).*.kind == value.NULL || (n == 3 && arg(args, 2).*.kind == value.NULL) {
        value.setNull(out)
        return core.OK
    }
    const blob = v.*.kind == value.BLOB
    if !blob { _ = value.toText(v) }
    const total = if blob { v.*.length } else { characters(v.*.data, v.*.length) }
    var p1 = value.toInt(arg(args, 1))
    var p2: i64 = 0
    var negativeLength = false
    if n == 3 {
        p2 = value.toInt(arg(args, 2))
        if p2 < 0 {
            p2 = 0 - p2
            negativeLength = true
        }
    } else {
        p2 = 2147483647
    }
    const len = @intCast(i64, total)
    if p1 < 0 {
        p1 += len
        if p1 < 0 {
            p2 += p1
            if p2 < 0 { p2 = 0 }
            p1 = 0
        }
    } else if p1 > 0 {
        p1 -= 1
    } else if p2 > 0 {
        p2 -= 1
    }
    if negativeLength {
        p1 -= p2
        if p1 < 0 {
            p2 += p1
            p1 = 0
        }
    }
    if p1 + p2 > len {
        p2 = len - p1
        if p2 < 0 { p2 = 0 }
    }
    if p1 > len { p1 = len }
    const from = @intCast(usize, p1)
    const count = @intCast(usize, p2)
    if blob {
        _ = value.setBlob(out, v.*.data + from, count)
    } else {
        const a = characterOffset(v.*.data, v.*.length, from)
        const b = characterOffset(v.*.data, v.*.length, from + count)
        _ = value.setText(out, v.*.data + a, b - a)
    }
    return core.OK
}

// quote(): a literal that reads back as the value.
pub fn quote(v: *Value, b: *mem.Buffer) -> void {
    if v.*.kind == value.NULL {
        _ = mem.appendText(b, "NULL")
    } else if v.*.kind == value.INTEGER {
        _ = mem.appendDecimal(b, v.*.i)
    } else if v.*.kind == value.REAL {
        // Seventeen digits (round trip), as SQLite's "%!0.17g".
        formatGeneric(b, v.*.r, 17, true)
    } else if v.*.kind == value.BLOB {
        _ = mem.appendText(b, "X'")
        var i: usize = 0
        while i < v.*.length {
            const c = mem.get8(v.*.data + i)
            _ = mem.appendByte(b, hexDigit(c >> 4))
            _ = mem.appendByte(b, hexDigit(c & 15))
            i += 1
        }
        _ = mem.appendText(b, "'")
    } else {
        _ = mem.appendByte(b, 39)
        var i: usize = 0
        while i < v.*.length {
            const c = mem.get8(v.*.data + i)
            if c == 39 { _ = mem.appendByte(b, 39) }
            _ = mem.appendByte(b, c)
            i += 1
        }
        _ = mem.appendByte(b, 39)
    }
}

// ---------------------------------------------------------------------------
// LIKE and GLOB.

// LIKE: % any run, _ one character, `escape` (or -1) makes the next one
// literal; ASCII letters' case ignored when `noCase`.
pub fn like(pattern: usize, patternLength: usize, text: usize, textLength: usize, escape: i64, noCase: bool) -> bool {
    var p: usize = 0
    var t: usize = 0
    while p < patternLength {
        var c = mem.get8(pattern + p)
        if escape >= 0 && c == @bitCast(u64, escape) {
            p += 1
            if p >= patternLength { return false }
            var pj = p
            const want = readUtf8(pattern, patternLength, &pj)
            if t >= textLength { return false }
            var tj = t
            const got = readUtf8(text, textLength, &tj)
            if !sameChar(want, got, noCase) { return false }
            p = pj
            t = tj
            continue
        }
        if c == 37 {
            // Runs of % and _ : each _ takes a character.
            while p < patternLength && (mem.get8(pattern + p) == 37 || mem.get8(pattern + p) == 95) {
                if mem.get8(pattern + p) == 95 {
                    if t >= textLength { return false }
                    var tj = t
                    _ = readUtf8(text, textLength, &tj)
                    t = tj
                }
                p += 1
            }
            if p >= patternLength { return true }
            while t <= textLength {
                if like(pattern + p, patternLength - p, text + t, textLength - t, escape, noCase) { return true }
                if t >= textLength { break }
                var tj = t
                _ = readUtf8(text, textLength, &tj)
                t = tj
            }
            return false
        }
        if t >= textLength { return false }
        var tj = t
        const got = readUtf8(text, textLength, &tj)
        if c == 95 {
            p += 1
            t = tj
            continue
        }
        var pj = p
        c = readUtf8(pattern, patternLength, &pj)
        if !sameChar(c, got, noCase) { return false }
        p = pj
        t = tj
    }
    return t >= textLength
}

fn sameChar(a: u64, b: u64, noCase: bool) -> bool {
    if a == b { return true }
    if noCase && a < 128 && b < 128 { return mem.lower(a) == mem.lower(b) }
    return false
}

// GLOB: * any run, ? one character, [...] a set ([^...] its complement,
// ranges a-z), case kept.
pub fn glob(pattern: usize, patternLength: usize, text: usize, textLength: usize) -> bool {
    var p: usize = 0
    var t: usize = 0
    while p < patternLength {
        const c = mem.get8(pattern + p)
        if c == 42 {
            while p < patternLength && (mem.get8(pattern + p) == 42 || mem.get8(pattern + p) == 63) {
                if mem.get8(pattern + p) == 63 {
                    if t >= textLength { return false }
                    var tj = t
                    _ = readUtf8(text, textLength, &tj)
                    t = tj
                }
                p += 1
            }
            if p >= patternLength { return true }
            while t <= textLength {
                if glob(pattern + p, patternLength - p, text + t, textLength - t) { return true }
                if t >= textLength { break }
                var tj = t
                _ = readUtf8(text, textLength, &tj)
                t = tj
            }
            return false
        }
        if t >= textLength { return false }
        var tj = t
        const got = readUtf8(text, textLength, &tj)
        if c == 63 {
            p += 1
            t = tj
            continue
        }
        if c == 91 {
            var q = p + 1
            var invert = false
            if q < patternLength && mem.get8(pattern + q) == 94 {
                invert = true
                q += 1
            }
            var matched = false
            var previous: u64 = 0
            var first = true
            while q < patternLength {
                var qj = q
                const pc = readUtf8(pattern, patternLength, &qj)
                if pc == 93 && !first { break }
                if pc == 45 && !first && qj < patternLength && mem.get8(pattern + qj) != 93 {
                    var rj = qj
                    const high = readUtf8(pattern, patternLength, &rj)
                    if got >= previous && got <= high { matched = true }
                    q = rj
                    first = false
                    continue
                }
                if pc == got { matched = true }
                previous = pc
                first = false
                q = qj
            }
            if q >= patternLength { return false }
            if matched == invert { return false }
            p = q + 1
            t = tj
            continue
        }
        var pj = p
        const want = readUtf8(pattern, patternLength, &pj)
        if want != got { return false }
        p = pj
        t = tj
    }
    return t >= textLength
}

// ---------------------------------------------------------------------------
// printf (SQLite's format()).

pub fn formatFixed(b: *mem.Buffer, r: f64, precision: usize) -> void {
    // %.Nf of the exact value, rounded half up as SQLite's printf rounds.
    const negative = r < 0.0 || (r == 0.0 && (@bitCast(u64, r) >> 63) != 0)
    const magnitude = if r < 0.0 { 0.0 - r } else { r }
    const digits = mem.alloc(400)
    var point: i64 = 0
    // Enough significant digits for the integer part and `precision`
    // decimals.
    var count: usize = 0
    if magnitude != 0.0 {
        count = numbers.digitsOf(magnitude, 26, digits, &point)
        // Round at `precision` decimals: significant digit index point +
        // precision.
        const keep = point + @intCast(i64, precision)
        if keep < 0 {
            count = 0
        } else if @intCast(usize, keep) < count {
            count = numbers.digitsOf(magnitude, if keep == 0 { 1 } else { @intCast(usize, keep) }, digits, &point)
            if keep == 0 {
                // Rounds to 0 or to 1 at the first decimal place.
                const roundsUp = mem.get8(digits) >= 53
                count = 0
                if roundsUp {
                    mem.put8(digits, 49)
                    count = 1
                    point += 1
                }
            }
        }
    }
    if negative && count > 0 { _ = mem.appendByte(b, 45) }
    if count == 0 {
        _ = mem.appendByte(b, 48)
    } else if point <= 0 {
        _ = mem.appendByte(b, 48)
    } else {
        var i: i64 = 0
        while i < point {
            _ = mem.appendByte(b, if @intCast(usize, i) < count { mem.get8(digits + @intCast(usize, i)) } else { 48 })
            i += 1
        }
    }
    if precision > 0 {
        _ = mem.appendByte(b, 46)
        var i: usize = 0
        while i < precision {
            const index = point + @intCast(i64, i)
            var d: u64 = 48
            if count > 0 && index >= 0 && @intCast(usize, index) < count { d = mem.get8(digits + @intCast(usize, index)) }
            _ = mem.appendByte(b, d)
            i += 1
        }
    }
    mem.free(digits)
}

// %g with `precision` significant digits; `alternate` keeps ".0" ("%!").
pub fn formatGeneric(b: *mem.Buffer, r: f64, precision: usize, alternate: bool) -> void {
    if r == 0.0 {
        _ = mem.appendText(b, if alternate { "0.0" } else { "0" })
        return
    }
    if r < 0.0 { _ = mem.appendByte(b, 45) }
    const magnitude = if r < 0.0 { 0.0 - r } else { r }
    const digits = mem.alloc(64)
    var point: i64 = 0
    const count = numbers.digitsOf(magnitude, precision, digits, &point)
    const exponent = point - 1
    if exponent < -4 || exponent >= @intCast(i64, precision) {
        _ = mem.appendByte(b, mem.get8(digits))
        if count > 1 {
            _ = mem.appendByte(b, 46)
            _ = mem.append(b, digits + 1, count - 1)
        } else if alternate {
            _ = mem.appendText(b, ".0")
        }
        _ = mem.appendByte(b, 101)
        var e = exponent
        if e < 0 {
            _ = mem.appendByte(b, 45)
            e = 0 - e
        } else {
            _ = mem.appendByte(b, 43)
        }
        const eu = @bitCast(u64, e)
        if eu >= 100 { _ = mem.appendByte(b, 48 + eu / 100) }
        _ = mem.appendByte(b, 48 + (eu / 10) % 10)
        _ = mem.appendByte(b, 48 + eu % 10)
    } else if point <= 0 {
        _ = mem.appendText(b, "0.")
        var z = point
        while z < 0 {
            _ = mem.appendByte(b, 48)
            z += 1
        }
        _ = mem.append(b, digits, count)
    } else {
        const p = @bitCast(u64, point)
        var j: usize = 0
        while j < p {
            _ = mem.appendByte(b, if j < count { mem.get8(digits + j) } else { 48 })
            j += 1
        }
        if count > p {
            _ = mem.appendByte(b, 46)
            _ = mem.append(b, digits + p, count - p)
        } else if alternate {
            _ = mem.appendText(b, ".0")
        }
    }
    mem.free(digits)
}

pub fn pad(b: *mem.Buffer, start: usize, width: usize, left: bool, zero: bool) -> void {
    const written = b.*.length - start
    if written >= width { return }
    const fill = width - written
    if left {
        var i: usize = 0
        while i < fill {
            _ = mem.appendByte(b, 32)
            i += 1
        }
        return
    }
    // Shift right and fill before (after a sign, for zeros).
    _ = mem.reserve(b, fill)
    var signs: usize = 0
    if zero && written > 0 && (mem.get8(b.*.data + start) == 45 || mem.get8(b.*.data + start) == 43) { signs = 1 }
    mem.copy(b.*.data + start + signs + fill, b.*.data + start + signs, written - signs)
    var i: usize = 0
    while i < fill {
        mem.put8(b.*.data + start + signs + i, if zero { 48 } else { 32 })
        i += 1
    }
    b.*.length += fill
    mem.put8(b.*.data + b.*.length, 0)
}

fn printf(st: *core.Statement, args: usize, n: usize, out: *Value) -> i32 {
    _ = st
    const format = arg(args, 0)
    if format.*.kind == value.NULL {
        value.setNull(out)
        return core.OK
    }
    _ = value.toText(format)
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    var next: usize = 1
    var i: usize = 0
    const f = format.*.data
    const length = format.*.length
    while i < length {
        const c = mem.get8(f + i)
        if c != 37 {
            _ = mem.appendByte(&b, c)
            i += 1
            continue
        }
        i += 1
        if i >= length { break }
        var left = false
        var plus = false
        var space = false
        var zero = false
        var alternate = false
        var bang = false
        while i < length {
            const flag = mem.get8(f + i)
            if flag == 45 {
                left = true
            } else if flag == 43 {
                plus = true
            } else if flag == 32 {
                space = true
            } else if flag == 48 {
                zero = true
            } else if flag == 35 {
                alternate = true
            } else if flag == 33 {
                bang = true
            } else if flag == 44 {
                // thousands separator: ignored
            } else {
                break
            }
            i += 1
        }
        var width: usize = 0
        if i < length && mem.get8(f + i) == 42 {
            const w = if next < n { value.toInt(arg(args, next)) } else { 0 }
            next += 1
            if w < 0 {
                left = true
                width = @intCast(usize, 0 - w)
            } else {
                width = @intCast(usize, w)
            }
            i += 1
        } else {
            while i < length && numbers.isDigit(mem.get8(f + i)) {
                width = width * 10 + @intCast(usize, mem.get8(f + i) - 48)
                i += 1
            }
        }
        var precision: i64 = -1
        if i < length && mem.get8(f + i) == 46 {
            i += 1
            precision = 0
            if i < length && mem.get8(f + i) == 42 {
                precision = if next < n { value.toInt(arg(args, next)) } else { 0 }
                next += 1
                i += 1
            } else {
                while i < length && numbers.isDigit(mem.get8(f + i)) {
                    precision = precision * 10 + @intCast(i64, mem.get8(f + i) - 48)
                    i += 1
                }
            }
        }
        // Length modifiers are ignored.
        while i < length && (mem.get8(f + i) == 108 || mem.get8(f + i) == 104) { i += 1 }
        if i >= length { break }
        const conversion = mem.get8(f + i)
        i += 1
        const start = b.length
        if conversion == 37 {
            _ = mem.appendByte(&b, 37)
            continue
        }
        var v: Value = undefined
        value.init(&v)
        if next < n { _ = value.copy(&v, arg(args, next)) }
        next += 1
        if conversion == 100 || conversion == 105 || conversion == 117 {
            var number = value.toInt(&v)
            if conversion == 117 && number < 0 { number = 0 - number }
            if number >= 0 && plus { _ = mem.appendByte(&b, 43) }
            if number >= 0 && space && !plus { _ = mem.appendByte(&b, 32) }
            const digitsStart = b.length
            _ = mem.appendDecimal(&b, number)
            if precision > 0 {
                const neg: usize = if number < 0 { 1 } else { 0 }
                const have = b.length - digitsStart - neg
                if have < @intCast(usize, precision) { pad(&b, digitsStart + neg, @intCast(usize, precision), false, true) }
            }
        } else if conversion == 120 || conversion == 88 || conversion == 111 {
            const number = @bitCast(u64, value.toInt(&v))
            const base: u64 = if conversion == 111 { 8 } else { 16 }
            if alternate && number != 0 { _ = mem.appendText(&b, if conversion == 111 { "0" } else if conversion == 120 { "0x" } else { "0X" }) }
            const digitsStart = b.length
            var rest = number
            while true {
                const d = rest % base
                _ = mem.appendByte(&b, if d < 10 { 48 + d } else if conversion == 88 { 55 + d } else { 87 + d })
                rest = rest / base
                if rest == 0 { break }
            }
            reverse(&b, digitsStart)
        } else if conversion == 102 || conversion == 101 || conversion == 69 || conversion == 103 || conversion == 71 {
            const r = value.toReal(&v)
            if r >= 0.0 && plus { _ = mem.appendByte(&b, 43) }
            const p = if precision < 0 { 6 } else { @intCast(usize, precision) }
            if conversion == 102 {
                formatFixed(&b, r, p)
            } else if conversion == 103 || conversion == 71 {
                formatGeneric(&b, r, if p == 0 { 1 } else { p }, bang)
            } else {
                formatExponent(&b, r, p, conversion == 69)
            }
        } else if conversion == 115 || conversion == 122 {
            if v.kind != value.NULL {
                _ = value.toText(&v)
                var count = v.length
                if precision >= 0 {
                    const limit = characterOffset(v.data, v.length, @intCast(usize, precision))
                    if limit < count { count = limit }
                }
                _ = mem.append(&b, v.data, count)
            }
        } else if conversion == 99 {
            if v.kind != value.NULL {
                _ = value.toText(&v)
                if v.length > 0 {
                    var at: usize = 0
                    const ch = readUtf8(v.data, v.length, &at)
                    var times: i64 = if precision > 1 { precision } else { 1 }
                    while times > 0 {
                        appendUtf8(&b, ch)
                        times -= 1
                    }
                }
            }
        } else if conversion == 113 || conversion == 81 || conversion == 119 {
            // %q doubles quotes, %Q also wraps in quotes (NULL for NULL), %w
            // doubles double quotes.
            if conversion == 81 && v.kind == value.NULL {
                _ = mem.appendText(&b, "NULL")
            } else {
                const quoteChar: u64 = if conversion == 119 { 34 } else { 39 }
                _ = value.toText(&v)
                if conversion == 81 { _ = mem.appendByte(&b, 39) }
                var k: usize = 0
                while k < v.length {
                    const ch = mem.get8(v.data + k)
                    if ch == quoteChar { _ = mem.appendByte(&b, ch) }
                    _ = mem.appendByte(&b, ch)
                    k += 1
                }
                if conversion == 81 { _ = mem.appendByte(&b, 39) }
            }
        } else {
            value.release(&v)
            continue
        }
        value.release(&v)
        pad(&b, start, width, left, zero && !left && conversion != 115)
    }
    _ = value.setText(out, b.data, b.length)
    mem.freeBuffer(&b)
    return core.OK
}

pub fn reverse(b: *mem.Buffer, from: usize) -> void {
    var i = from
    var j = b.*.length - 1
    while i < j {
        const t = mem.get8(b.*.data + i)
        mem.put8(b.*.data + i, mem.get8(b.*.data + j))
        mem.put8(b.*.data + j, t)
        i += 1
        j -= 1
    }
}

pub fn formatExponent(b: *mem.Buffer, r: f64, precision: usize, upper: bool) -> void {
    if r < 0.0 { _ = mem.appendByte(b, 45) }
    const magnitude = if r < 0.0 { 0.0 - r } else { r }
    const digits = mem.alloc(64)
    var point: i64 = 1
    var count: usize = 0
    if magnitude != 0.0 { count = numbers.digitsOf(magnitude, precision + 1, digits, &point) }
    _ = mem.appendByte(b, if count > 0 { mem.get8(digits) } else { 48 })
    if precision > 0 {
        _ = mem.appendByte(b, 46)
        var i: usize = 1
        while i <= precision {
            _ = mem.appendByte(b, if i < count { mem.get8(digits + i) } else { 48 })
            i += 1
        }
    }
    _ = mem.appendByte(b, if upper { 69 } else { 101 })
    var e = if count > 0 { point - 1 } else { 0 }
    if e < 0 {
        _ = mem.appendByte(b, 45)
        e = 0 - e
    } else {
        _ = mem.appendByte(b, 43)
    }
    const eu = @bitCast(u64, e)
    if eu >= 100 { _ = mem.appendByte(b, 48 + eu / 100) }
    _ = mem.appendByte(b, 48 + (eu / 10) % 10)
    _ = mem.appendByte(b, 48 + eu % 10)
    mem.free(digits)
}

// ---------------------------------------------------------------------------
// Aggregates.

pub const A_COUNT: usize = 1
pub const A_SUM: usize = 2
pub const A_TOTAL: usize = 3
pub const A_AVG: usize = 4
pub const A_MIN: usize = 5
pub const A_MAX: usize = 6
pub const A_GROUP_CONCAT: usize = 7

pub fn aggregateKind(name: []const u8) -> usize {
    if mem.sameNoCase(name, "count") { return A_COUNT }
    if mem.sameNoCase(name, "sum") { return A_SUM }
    if mem.sameNoCase(name, "total") { return A_TOTAL }
    if mem.sameNoCase(name, "avg") { return A_AVG }
    if mem.sameNoCase(name, "min") { return A_MIN }
    if mem.sameNoCase(name, "max") { return A_MAX }
    return A_GROUP_CONCAT
}

const Accumulator = struct {
    count: i64
    integerSum: i64
    realSum: f64
    compensation: f64
    sawReal: bool
    overflow: bool
    // min, max: the value so far; group_concat: the text.
    current: Value
    has: bool
    separator: Value
    // DISTINCT: the values seen.
    seen: usize
    // The row just stepped became min's or max's (bare columns follow it).
    took: bool
    result: Value
}

fn accumulatorAt(block: usize, i: usize) -> *Accumulator { unsafe { return @ptrFromInt(*Accumulator, block + i * @sizeOf(Accumulator)) } }

pub fn newAccumulators(aggregates: *mem.Words) -> usize {
    const n = aggregates.*.length
    const block = mem.alloc((n + 1) * @sizeOf(Accumulator))
    var i: usize = 0
    while i < n {
        const a = accumulatorAt(block, i)
        value.init(&a.*.current)
        value.init(&a.*.separator)
        value.init(&a.*.result)
        i += 1
    }
    return block
}

pub fn freeAccumulators(block: usize, n: usize) -> void {
    if block == 0 { return }
    var i: usize = 0
    while i < n {
        const a = accumulatorAt(block, i)
        value.release(&a.*.current)
        value.release(&a.*.separator)
        value.release(&a.*.result)
        eval.freeSet(a.*.seen)
        i += 1
    }
    mem.free(block)
}

pub fn resetAccumulators(block: usize, n: usize) -> void {
    var i: usize = 0
    while i < n {
        const a = accumulatorAt(block, i)
        a.*.count = 0
        a.*.integerSum = 0
        a.*.realSum = 0.0
        a.*.compensation = 0.0
        a.*.sawReal = false
        a.*.overflow = false
        value.setNull(&a.*.current)
        a.*.has = false
        eval.clearSet(a.*.seen)
        a.*.took = false
        i += 1
    }
}

pub fn argumentCount(aggregate: usize) -> usize { return ast.count(ast.expr(aggregate).*.list) }

pub fn result(block: usize, i: usize) -> *Value { return &accumulatorAt(block, i).*.result }

// Kahan-Babuska summation (SQLite's).
fn kahan(a: *Accumulator, r: f64) -> void {
    const s = a.*.realSum
    const t = s + r
    if (if s < 0.0 { 0.0 - s } else { s }) > (if r < 0.0 { 0.0 - r } else { r }) {
        a.*.compensation += (s - t) + r
    } else {
        a.*.compensation += (r - t) + s
    }
    a.*.realSum = t
}

// One row's arguments (`count` Values from `args`) into aggregate `i`.
pub fn step(st: *core.Statement, block: usize, i: usize, aggregate: usize, args: usize, count: usize) -> i32 {
    const a = accumulatorAt(block, i)
    const x = ast.expr(aggregate)
    const kind = x.*.function
    a.*.took = false
    if kind == A_COUNT && count == 0 {
        a.*.count += 1
        return core.OK
    }
    const v = record.valueAt(args, 0)
    if v.*.kind == value.NULL { return core.OK }
    if x.*.distinct {
        if a.*.seen == 0 { a.*.seen = eval.newSet() }
        var added = false
        const rc = eval.addToSet(st, a.*.seen, args, 1, &added)
        if rc != core.OK { return rc }
        if !added { return core.OK }
    }
    if kind == A_COUNT {
        a.*.count += 1
    } else if kind == A_SUM || kind == A_TOTAL || kind == A_AVG {
        var number: Value = undefined
        value.init(&number)
        value.numeric(v, &number)
        a.*.count += 1
        if number.kind == value.INTEGER && !a.*.sawReal {
            const sum = a.*.integerSum +% number.i
            if (a.*.integerSum >= 0) == (number.i >= 0) && (sum >= 0) != (a.*.integerSum >= 0) {
                a.*.overflow = true
            }
            a.*.integerSum = sum
            kahan(a, @floatFromInt(f64, number.i))
        } else {
            if !a.*.sawReal {
                a.*.sawReal = true
            }
            kahan(a, value.toReal(&number))
        }
        value.release(&number)
    } else if kind == A_MIN || kind == A_MAX {
        const collation = eval.exprCollation(st, ast.exprAt(x.*.list, 0))
        if !a.*.has {
            _ = value.copy(&a.*.current, v)
            a.*.has = true
            a.*.took = true
        } else {
            const c = value.compare(v, &a.*.current, collation)
            if (kind == A_MIN && c < 0) || (kind == A_MAX && c > 0) {
                _ = value.copy(&a.*.current, v)
                a.*.took = true
            }
        }
    } else {
        // group_concat(x [, separator]).
        _ = value.toText(v)
        if a.*.has {
            if count > 1 {
                const sep = record.valueAt(args, 1)
                if sep.*.kind != value.NULL {
                    _ = value.toText(sep)
                    appendTo(&a.*.current, sep.*.data, sep.*.length)
                }
            } else {
                appendTo(&a.*.current, @intFromPtr(",".pointer), 1)
            }
        } else {
            _ = value.setText(&a.*.current, 0, 0)
            a.*.has = true
        }
        appendTo(&a.*.current, v.*.data, v.*.length)
    }
    return core.OK
}

fn appendTo(v: *Value, address: usize, length: usize) -> void {
    const old = v.*.length
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    _ = mem.append(&b, v.*.data, old)
    _ = mem.append(&b, address, length)
    _ = value.setText(v, b.data, b.length)
    mem.freeBuffer(&b)
}

// Whether bare columns take this row's values: always, unless the query's
// only aggregate is min() or max() and this row did not become its value.
pub fn takeBare(block: usize, n: usize, aggregates: *mem.Words) -> bool {
    if n != 1 { return true }
    const kind = ast.expr(@intCast(usize, mem.at(aggregates, 0))).*.function
    if kind != A_MIN && kind != A_MAX { return true }
    return accumulatorAt(block, 0).*.took
}

// Every aggregate's result for the rows taken in.
pub fn finishAll(st: *core.Statement, block: usize, n: usize, aggregates: *mem.Words) -> i32 {
    var i: usize = 0
    while i < n {
        const a = accumulatorAt(block, i)
        const kind = ast.expr(@intCast(usize, mem.at(aggregates, i))).*.function
        if kind == A_COUNT {
            value.setInt(&a.*.result, a.*.count)
        } else if kind == A_SUM {
            if a.*.count == 0 {
                value.setNull(&a.*.result)
            } else if a.*.sawReal {
                value.setReal(&a.*.result, a.*.realSum + a.*.compensation)
            } else {
                if a.*.overflow { return core.setError(databaseOf(st), core.ERROR, "integer overflow") }
                value.setInt(&a.*.result, a.*.integerSum)
            }
        } else if kind == A_TOTAL {
            value.setReal(&a.*.result, a.*.realSum + a.*.compensation)
        } else if kind == A_AVG {
            if a.*.count == 0 {
                value.setNull(&a.*.result)
            } else {
                value.setReal(&a.*.result, (a.*.realSum + a.*.compensation) / @floatFromInt(f64, a.*.count))
            }
        } else {
            if a.*.has {
                _ = value.copy(&a.*.result, &a.*.current)
            } else {
                value.setNull(&a.*.result)
            }
        }
        i += 1
    }
    return core.OK
}

// ---------------------------------------------------------------------------
// Table-valued functions.

const T_TABLE_INFO: u8 = 1
const T_INDEX_LIST: u8 = 2
const T_INDEX_INFO: u8 = 3

fn pushName(s: *core.SourceState, name: []const u8) -> void {
    _ = mem.push(&s.*.names, @intCast(u64, @intFromPtr(name.pointer)))
    _ = mem.push(&s.*.names, @intCast(u64, name.length))
}

// pragma_table_info(T), pragma_index_list(T), pragma_index_info(I) as
// sources.
pub fn tableFunction(st: *core.Statement, s: *core.SourceState, item: *ast.Source) -> i32 {
    const name = mem.view(item.*.name, item.*.nameLength)
    s.*.kind = core.SOURCE_ROWS
    s.*.functionArguments = item.*.arguments
    if mem.sameNoCase(name, "pragma_table_info") {
        s.*.functionKind = T_TABLE_INFO
        pushName(s, "cid")
        pushName(s, "name")
        pushName(s, "type")
        pushName(s, "notnull")
        pushName(s, "dflt_value")
        pushName(s, "pk")
        s.*.width = 6
    } else if mem.sameNoCase(name, "pragma_index_list") {
        s.*.functionKind = T_INDEX_LIST
        pushName(s, "seq")
        pushName(s, "name")
        pushName(s, "unique")
        pushName(s, "origin")
        pushName(s, "partial")
        s.*.width = 5
    } else if mem.sameNoCase(name, "pragma_index_info") {
        s.*.functionKind = T_INDEX_INFO
        pushName(s, "seqno")
        pushName(s, "cid")
        pushName(s, "name")
        s.*.width = 3
    } else {
        return core.setError2(databaseOf(st), core.ERROR, "no such table: ", name)
    }
    // The arguments may name columns of earlier sources: resolve them in
    // the statement's text as constants (they are, in WebKit's use).
    return core.OK
}

pub fn fillTableFunction(st: *core.Statement, s: *core.SourceState) -> i32 {
    if s.*.rows == 0 { s.*.rows = core.newRows(s.*.width) }
    core.clearRows(s.*.rows)
    var nameValue: Value = undefined
    value.init(&nameValue)
    if ast.count(s.*.functionArguments) > 0 {
        const rc = eval.evaluate(st, ast.exprAt(s.*.functionArguments, 0), &nameValue)
        if rc != core.OK { return rc }
    }
    _ = value.toText(&nameValue)
    const name = value.bytesOf(&nameValue)
    const db = databaseOf(st)
    if s.*.functionKind == T_INDEX_INFO {
        const x = schema.findIndex(&db.*.schema, name)
        if x != 0 { indexInfoRows(schema.index(x), s.*.rows) }
    } else {
        const t = schema.findTable(&db.*.schema, name)
        if t != 0 {
            if s.*.functionKind == T_TABLE_INFO {
                tableInfoRows(st, schema.table(t), s.*.rows)
            } else {
                indexListRows(schema.table(t), s.*.rows)
            }
        }
    }
    value.release(&nameValue)
    return core.OK
}

// PRAGMA table_info's rows: cid, name, type, notnull, dflt_value, pk.
pub fn tableInfoRows(st: *core.Statement, t: *schema.Table, rows: usize) -> void {
    var i: usize = 0
    var keyNumber: i64 = 0
    while i < t.*.columnCount {
        const c = schema.column(t, i)
        const row = core.addRow(rows)
        value.setInt(record.valueAt(row, 0), @intCast(i64, i))
        _ = value.setText(record.valueAt(row, 1), c.*.name, c.*.nameLength)
        _ = value.setText(record.valueAt(row, 2), c.*.typeName, c.*.typeLength)
        value.setInt(record.valueAt(row, 3), if c.*.notNull { 1 } else { 0 })
        if c.*.defaultExpr != 0 {
            const d = ast.expr(c.*.defaultExpr)
            _ = value.setText(record.valueAt(row, 4), t.*.sql + d.*.start, d.*.end - d.*.start)
        }
        // pk: the column's place in the primary key (1-based), 0 if none.
        var pk: i64 = 0
        if t.*.rowidColumn == @intCast(i64, i) {
            pk = 1
        } else {
            var k: usize = 0
            while k < t.*.primaryKey.length {
                if mem.at(&t.*.primaryKey, k) == @intCast(u64, i) { pk = @intCast(i64, k) + 1 }
                k += 1
            }
        }
        value.setInt(record.valueAt(row, 5), pk)
        _ = keyNumber
        i += 1
    }
    _ = st
}

// PRAGMA index_list's rows: seq, name, unique, origin, partial (newest
// index first).
pub fn indexListRows(t: *schema.Table, rows: usize) -> void {
    var i = t.*.indexes.length
    var seq: i64 = 0
    while i > 0 {
        i -= 1
        const x = schema.index(@intCast(usize, mem.at(&t.*.indexes, i)))
        const row = core.addRow(rows)
        value.setInt(record.valueAt(row, 0), seq)
        _ = value.setText(record.valueAt(row, 1), x.*.name, x.*.nameLength)
        value.setInt(record.valueAt(row, 2), if x.*.unique { 1 } else { 0 })
        _ = value.setString(record.valueAt(row, 3), if x.*.origin == 2 { "pk" } else if x.*.origin == 1 { "u" } else { "c" })
        value.setInt(record.valueAt(row, 4), if x.*.partial != 0 { 1 } else { 0 })
        seq += 1
    }
}

// PRAGMA index_info's rows: seqno, cid, name.
pub fn indexInfoRows(x: *schema.Index, rows: usize) -> void {
    const t = schema.table(x.*.table)
    var i: usize = 0
    while i < x.*.columnCount {
        const row = core.addRow(rows)
        value.setInt(record.valueAt(row, 0), @intCast(i64, i))
        const c = schema.indexColumn(x, i)
        value.setInt(record.valueAt(row, 1), c)
        if c >= 0 {
            const col = schema.column(t, @intCast(usize, c))
            _ = value.setText(record.valueAt(row, 2), col.*.name, col.*.nameLength)
        }
        i += 1
    }
}
