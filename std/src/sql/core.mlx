// std.sql.core: the structures every part of the engine shares: a
// connection (Database: its pager, schema, collations, functions,
// transaction and savepoints, errors, hooks), a prepared statement
// (Statement: its parse, parameters, the state of its execution) and what
// a query's sources hold while it runs; SQLite's result codes and the
// error messages set on the connection.
const mem = @import("./mem.mlx")
const value = @import("./value.mlx")
const pg = @import("./pager.mlx")
const schema = @import("./schema.mlx")
const ast = @import("./ast.mlx")
const os = @import("./os.mlx")
const record = @import("./record.mlx")

// Result codes (SQLITE_*).
pub const OK: i32 = 0
pub const ERROR: i32 = 1
pub const INTERNAL: i32 = 2
pub const PERM: i32 = 3
pub const ABORT: i32 = 4
pub const BUSY: i32 = 5
pub const LOCKED: i32 = 6
pub const NOMEM: i32 = 7
pub const READONLY: i32 = 8
pub const INTERRUPT: i32 = 9
pub const IOERR: i32 = 10
pub const CORRUPT: i32 = 11
pub const NOTFOUND: i32 = 12
pub const FULL: i32 = 13
pub const CANTOPEN: i32 = 14
pub const PROTOCOL: i32 = 15
pub const SCHEMA: i32 = 17
pub const TOOBIG: i32 = 18
pub const CONSTRAINT: i32 = 19
pub const MISMATCH: i32 = 20
pub const MISUSE: i32 = 21
pub const AUTH: i32 = 23
pub const RANGE: i32 = 25
pub const NOTADB: i32 = 26
pub const ROW: i32 = 100
pub const DONE: i32 = 101

// Extended codes.
pub const CONSTRAINT_CHECK: i32 = 275
pub const CONSTRAINT_FOREIGNKEY: i32 = 787
pub const CONSTRAINT_NOTNULL: i32 = 1299
pub const CONSTRAINT_PRIMARYKEY: i32 = 1555
pub const CONSTRAINT_UNIQUE: i32 = 2067
pub const CONSTRAINT_ROWID: i32 = 2579
pub const ERROR_MISSING_COLLSEQ: i32 = 257
pub const READONLY_DBMOVED: i32 = 1032

// Authorizer action codes and answers.
pub const AUTH_CREATE_INDEX: i32 = 1
pub const AUTH_CREATE_TABLE: i32 = 2
pub const AUTH_CREATE_VIEW: i32 = 8
pub const AUTH_DELETE: i32 = 9
pub const AUTH_DROP_INDEX: i32 = 10
pub const AUTH_DROP_TABLE: i32 = 11
pub const AUTH_DROP_VIEW: i32 = 17
pub const AUTH_INSERT: i32 = 18
pub const AUTH_PRAGMA: i32 = 19
pub const AUTH_READ: i32 = 20
pub const AUTH_SELECT: i32 = 21
pub const AUTH_TRANSACTION: i32 = 22
pub const AUTH_UPDATE: i32 = 23
pub const AUTH_ALTER_TABLE: i32 = 26
pub const AUTH_REINDEX: i32 = 27
pub const AUTH_ANALYZE: i32 = 28
pub const AUTH_FUNCTION: i32 = 31
pub const AUTH_SAVEPOINT: i32 = 32
pub const AUTH_DENY: i32 = 1
pub const AUTH_IGNORE: i32 = 2

// C callbacks the connection calls.
pub const AuthorizerFn = fn(usize, i32, usize, usize, usize, usize) -> i32
pub const BusyFn = fn(usize, i32) -> i32
// A function's implementation: (context, argument count, arguments).
pub const FunctionFn = fn(usize, i32, usize) -> void
pub const FinalFn = fn(usize) -> void
pub const DestroyFn = fn(usize) -> void
pub const WalHookFn = fn(usize, usize, usize, i32) -> i32

// A function registered on the connection (by the application, or a
// built-in one): its name, how many arguments (-1 any), and how it is
// called.
pub const Function = struct {
    name: usize
    nameLength: usize
    arguments: i32
    // For C functions: xFunc, xStep, xFinal, the user data, xDestroy.
    call: usize
    step: usize
    final: usize
    userData: usize
    destroy: usize
    // A built-in: its number in std.sql.functions (0: a C function).
    builtin: u32
    deterministic: bool
    next: usize
}

pub inline fn functionOf(address: usize) -> *Function { unsafe { return @ptrFromInt(*Function, address) } }

pub const Savepoint = struct {
    name: usize
    nameLength: usize
    // The pager's savepoint level for it.
    level: usize
    // It began the transaction (a SAVEPOINT outside BEGIN).
    began: bool
}

pub const Database = struct {
    pager: pg.Pager
    schema: schema.Schema
    mutex: os.Mutex
    // Lists of value.Collation and Function.
    collations: usize
    functions: usize
    // Not inside BEGIN ... COMMIT.
    autocommit: bool
    // The open savepoints (Savepoint addresses, innermost last).
    savepoints: mem.Words
    lastInsertRowid: i64
    changes: i64
    totalChanges: i64
    errorCode: i32
    extendedErrors: bool
    message: mem.Buffer
    busyTimeout: i64
    busyHandler: usize
    busyArgument: usize
    authorizer: usize
    authorizerArgument: usize
    walHook: usize
    walHookArgument: usize
    // The connection's statements (addresses), for next_stmt and close.
    statements: mem.Words
    interrupted: bool
    foreignKeys: bool
    // What PRAGMA journal_mode answers (pg.JOURNAL_*): WAL is asked for and
    // reported, the file kept with a rollback journal.
    journalMode: u8
    autoVacuum: u8
    tempStore: u8
    cacheSize: i64
    maxPageCount: u64
    readOnly: bool
    // Statements stepping now (each holds the read transaction open).
    active: usize
    // A statement is writing (its write transaction may be committed when
    // it ends in autocommit).
    path: usize
    pathLength: usize
    caseSensitiveLike: bool
    recursionDepth: usize
    // Bumped each time the schema is read again (compiled statements hold
    // its tables and indexes, and compile again).
    schemaGeneration: u64
    // An autocommit write that ended while other statements were reading:
    // the commit waits for them.
    pendingCommit: bool
    // The built-in collations (BINARY, NOCASE, RTRIM are first in the
    // list).
    binary: usize
    openFlags: i32
    // Rows changed by the current statement through its own actions.
    statementChanges: i64
}

pub inline fn database(address: usize) -> *Database { unsafe { return @ptrFromInt(*Database, address) } }

// Sets the connection's error: its code and SQLite's message.
pub fn setError(db: *Database, code: i32, message: []const u8) -> i32 {
    db.*.errorCode = code
    db.*.message.length = 0
    _ = mem.appendText(&db.*.message, message)
    return code
}

pub fn setError2(db: *Database, code: i32, a: []const u8, b: []const u8) -> i32 {
    db.*.errorCode = code
    db.*.message.length = 0
    _ = mem.appendText(&db.*.message, a)
    _ = mem.appendText(&db.*.message, b)
    return code
}

pub fn setError3(db: *Database, code: i32, a: []const u8, b: []const u8, c: []const u8) -> i32 {
    db.*.errorCode = code
    db.*.message.length = 0
    _ = mem.appendText(&db.*.message, a)
    _ = mem.appendText(&db.*.message, b)
    _ = mem.appendText(&db.*.message, c)
    return code
}

pub fn clearError(db: *Database) -> void {
    db.*.errorCode = OK
    db.*.message.length = 0
}

// SQLite's text for a primary result code (sqlite3_errstr).
pub fn errorText(code: i32) -> []const u8 {
    const primary = code & 255
    return match primary {
        0 => "not an error",
        1 => "SQL logic error",
        2 => "internal error",
        3 => "access permission denied",
        4 => "query aborted",
        5 => "database is locked",
        6 => "database table is locked",
        7 => "out of memory",
        8 => "attempt to write a readonly database",
        9 => "interrupted",
        10 => "disk I/O error",
        11 => "database disk image is malformed",
        12 => "unknown operation",
        13 => "database or disk is full",
        14 => "unable to open database file",
        15 => "locking protocol",
        17 => "database schema has changed",
        18 => "string or blob too big",
        19 => "constraint failed",
        20 => "datatype mismatch",
        21 => "bad parameter or other API misuse",
        23 => "authorization denied",
        25 => "column index out of range",
        26 => "file is not a database",
        100 => "another row available",
        101 => "no more rows available",
        else => "unknown error",
    }
}

// ---------------------------------------------------------------------------
// Rows kept in memory: subqueries' results, sorted and grouped rows, IN
// lists. A row is a block of `width` Values.

pub const Rows = struct {
    width: usize
    rows: mem.Words
    // Where reading is.
    position: usize
}

pub inline fn rowsOf(address: usize) -> *Rows { unsafe { return @ptrFromInt(*Rows, address) } }

pub fn newRows(width: usize) -> usize {
    const address = mem.alloc(@sizeOf(Rows))
    if address == 0 { return 0 }
    rowsOf(address).*.width = width
    mem.initWords(&rowsOf(address).*.rows)
    return address
}

pub fn freeRow(row: usize, width: usize) -> void {
    var i: usize = 0
    while i < width {
        value.release(record.valueAt(row, i))
        i += 1
    }
    mem.free(row)
}

pub fn clearRows(address: usize) -> void {
    if address == 0 { return }
    const r = rowsOf(address)
    var i: usize = 0
    while i < r.*.rows.length {
        freeRow(@intCast(usize, mem.at(&r.*.rows, i)), r.*.width)
        i += 1
    }
    r.*.rows.length = 0
    r.*.position = 0
}

pub fn freeRows(address: usize) -> void {
    if address == 0 { return }
    clearRows(address)
    mem.freeWords(&rowsOf(address).*.rows)
    mem.free(address)
}

// A new row of the set's width (NULLs), added at the end.
pub fn addRow(address: usize) -> usize {
    const r = rowsOf(address)
    const row = mem.alloc(r.*.width * @sizeOf(value.Value) + 16)
    if row == 0 { return 0 }
    var i: usize = 0
    while i < r.*.width {
        value.init(record.valueAt(row, i))
        i += 1
    }
    if !mem.push(&r.*.rows, @intCast(u64, row)) {
        mem.free(row)
        return 0
    }
    return row
}

pub fn rowAt(address: usize, index: usize) -> usize { return @intCast(usize, mem.at(&rowsOf(address).*.rows, index)) }

pub fn rowCount(address: usize) -> usize {
    if address == 0 { return 0 }
    return rowsOf(address).*.rows.length
}

// ---------------------------------------------------------------------------
// A query's sources while it runs.

pub const SOURCE_TABLE: u8 = 1
pub const SOURCE_ROWS: u8 = 2

// How a table source is read.
pub const PLAN_SCAN: u8 = 1
pub const PLAN_ROWID_EQ: u8 = 2
pub const PLAN_ROWID_RANGE: u8 = 3
pub const PLAN_ROWID_IN: u8 = 4
pub const PLAN_INDEX: u8 = 5
pub const PLAN_INDEX_IN: u8 = 6
pub const PLAN_INDEX_SCAN: u8 = 7

pub const SourceState = struct {
    kind: u8
    table: usize
    cursor: usize
    index: usize
    indexCursor: usize
    // The columns are read from the index's entry (it holds all the query
    // needs of this table).
    covering: bool
    // A LEFT JOIN's row of NULLs.
    nullRow: bool
    plan: u8
    // The plan's terms: equalities on the index's first columns (or the
    // rowid), then a range on the next column (or the rowid).
    equalities: mem.Words
    low: usize
    lowInclusive: bool
    high: usize
    highInclusive: bool
    // IN: the term, and the values it lists (sorted, without repeats).
    inTerm: usize
    inValues: usize
    inPosition: usize
    descending: bool
    // Where the loop is: begun, and whether this level matched (LEFT
    // JOIN).
    begun: bool
    matched: bool
    // The key values sought (a block of Values).
    keys: usize
    keyCount: usize
    // A materialized source: its rows and the current one.
    rows: usize
    row: usize
    width: usize
    // Column names of a materialized source (pairs of address, length).
    names: mem.Words
    // Terms tested at this level: ON (the row matches) and WHERE.
    onTerms: mem.Words
    whereTerms: mem.Words
    leftJoin: bool
    // The FROM item.
    item: usize
    // The query this source belongs to.
    query: usize
    // The rowid of the current row (tables).
    rowid: i64
    // The table row of the current index entry has been sought.
    rowLoaded: bool
    // Its number among the statement's sources, its level in its query.
    number: usize
    level: usize
    // A subquery source: its Query, whether it reads outer rows (and runs
    // again for each), and where reading its rows is.
    subquery: usize
    correlated: bool
    position: usize
    // A table-valued function (pragma_table_info...): its kind and
    // arguments.
    functionKind: u8
    functionArguments: usize
    // Its columns are named only with its name before them (an upsert's
    // `excluded`).
    qualifiedOnly: bool
    // The name it goes by when its FROM item has none (row scopes).
    ownName: usize
    ownNameLength: usize
}

pub inline fn sourceState(address: usize) -> *SourceState { unsafe { return @ptrFromInt(*SourceState, address) } }

// ---------------------------------------------------------------------------
// A prepared statement.

pub const Statement = struct {
    db: usize
    arena: ast.Arena
    // Its text (in the arena, as the parse's names point into it), the
    // statement's own copy of what it was prepared from, and the parse.
    text: usize
    textLength: usize
    originalText: usize
    node: usize
    // Parameters: their values, and the names (from the parser: address,
    // length, number).
    parameters: usize
    parameterCount: usize
    names: mem.Words
    // Execution: every source of every query of the statement, by number;
    // every query and scope made for it; expressions whose results are
    // kept for the run (non-correlated subqueries).
    sources: mem.Words
    queries: mem.Words
    scopes: mem.Words
    caches: mem.Words
    // The top query (a SELECT) and its result row.
    query: usize
    columnCount: usize
    result: usize
    // Column names and declared types (pairs of address, length; the
    // decltype address 0 when there is none).
    columnNames: mem.Words
    columnTypes: mem.Words
    // NOT_STARTED, RUNNING (a row was returned), DONE, FAILED.
    state: u8
    // It began a transaction (autocommit) that ends with it.
    ownsTransaction: bool
    readOnly: bool
    // The pager's savepoint level of the statement's own savepoint.
    savepoint: usize
    // The schema it was resolved against.
    schemaCookie: u64
    // Expanded text (sqlite3_expanded_sql), kept until the next call.
    expanded: usize
    // Blocks made for C that live as long as the statement (its UTF-16
    // names): a chain, each block's first word the next one.
    scratch: usize
    // Prepared with the legacy sqlite3_prepare: a failed step reports
    // SQLITE_ERROR (sqlite3_reset tells which error).
    legacy: bool
    // The next SELECT compiled is the statement's own scan (of an UPDATE
    // or DELETE): the authorizer is not asked about it.
    quietSelect: bool
    // The common table expressions in force while a SELECT compiles
    // (ast.Cte addresses, innermost last).
    ctes: mem.Words
    // READs of table columns held back (an UPDATE's WHERE, asked about
    // after its SET columns, as SQLite asks).
    holdReads: bool
    heldReads: mem.Words
    // The statement was interrupted or failed with this code.
    errorCode: i32
    // sqlite3_stmt_status counters: steps of full scans, sorts.
    fullScans: i64
    sorts: i64
    // Registers: values computed once per row for aggregates and groups.
    registers: usize
    registerCount: usize
    // Changes made by this statement (sqlite3_changes after it).
    changes: i64
    // A DML statement's work is done; DONE is what remains.
    finished: bool
    // An INSERT, UPDATE or DELETE compiled (std.sql.write's Dml), and rows
    // a statement made up front (PRAGMA's), read like a query's.
    dml: usize
    rows: usize
    // How a failed statement leaves its changes: ABORT (rolled back),
    // FAIL (kept), ROLLBACK (the whole transaction rolled back).
    failMode: u8
    // The schema generation the statement was compiled against.
    generation: u64
}

pub inline fn statementOf(address: usize) -> *Statement { unsafe { return @ptrFromInt(*Statement, address) } }

pub const NOT_STARTED: u8 = 0
pub const RUNNING: u8 = 1
pub const FINISHED: u8 = 2
pub const FAILED: u8 = 3

pub fn parameter(st: *Statement, number: i64) -> *value.Value {
    return record.valueAt(st.*.parameters, @intCast(usize, number - 1))
}

// ---------------------------------------------------------------------------
// A function call's context (sqlite3_context): where its result goes,
// the function, an error it raised, its aggregate state.
pub const Context = struct {
    out: usize
    function: usize
    db: usize
    statement: usize
    errorCode: i32
    message: mem.Buffer
    // An aggregate's memory (sqlite3_aggregate_context).
    aggregate: usize
    aggregateSize: usize
    // Auxiliary data per argument (sqlite3_set_auxdata): not kept.
    skip: bool
}

pub inline fn contextOf(address: usize) -> *Context { unsafe { return @ptrFromInt(*Context, address) } }
