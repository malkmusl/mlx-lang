// std.sql.ast: what the parser makes of a statement: expressions,
// SELECTs with their sources, and the statements around them. Nodes are
// taken from the statement's arena and live as long as it; names and
// literals point into copies kept there too.
const mem = @import("./mem.mlx")

// ---------------------------------------------------------------------------
// The arena.

pub const Arena = struct {
    blocks: mem.Words
    at: usize
    end: usize
}

pub fn initArena(a: *Arena) -> void {
    mem.initWords(&a.*.blocks)
    a.*.at = 0
    a.*.end = 0
}

// `size` zeroed bytes that live until the arena is freed.
pub fn alloc(a: *Arena, size: usize) -> usize {
    const rounded = (size + 15) / 16 * 16
    if a.*.at + rounded > a.*.end {
        const blockSize = if rounded > 8192 { rounded } else { 8192 }
        const block = mem.alloc(blockSize)
        if block == 0 { return 0 }
        _ = mem.push(&a.*.blocks, @intCast(u64, block))
        a.*.at = block
        a.*.end = block + blockSize
    }
    const result = a.*.at
    a.*.at += rounded
    mem.zero(result, rounded)
    return result
}

pub fn freeArena(a: *Arena) -> void {
    var i: usize = 0
    while i < a.*.blocks.length {
        mem.free(@intCast(usize, mem.at(&a.*.blocks, i)))
        i += 1
    }
    mem.freeWords(&a.*.blocks)
    a.*.at = 0
    a.*.end = 0
}

// A copy of `length` bytes (and a 0 after them).
pub fn copyText(a: *Arena, address: usize, length: usize) -> usize {
    const copied = alloc(a, length + 1)
    if copied != 0 { mem.copy(copied, address, length) }
    return copied
}

// ---------------------------------------------------------------------------
// Expressions.

pub const E_NULL: u8 = 1
pub const E_INTEGER: u8 = 2
pub const E_REAL: u8 = 3
pub const E_STRING: u8 = 4
pub const E_BLOB: u8 = 5
pub const E_VARIABLE: u8 = 6
pub const E_COLUMN: u8 = 7
pub const E_UNARY: u8 = 8
pub const E_BINARY: u8 = 9
pub const E_AND: u8 = 10
pub const E_OR: u8 = 11
pub const E_IS: u8 = 12
pub const E_ISNULL: u8 = 14
pub const E_BETWEEN: u8 = 16
pub const E_IN_LIST: u8 = 17
pub const E_IN_SELECT: u8 = 18
pub const E_EXISTS: u8 = 19
pub const E_SUBQUERY: u8 = 20
pub const E_LIKE: u8 = 21
pub const E_CASE: u8 = 22
pub const E_CAST: u8 = 23
pub const E_FUNCTION: u8 = 24
pub const E_COLLATE: u8 = 25
pub const E_STAR: u8 = 26
// A value the executor computed already (an aggregate's result, a
// grouping term's value): `slot` is where it is.
pub const E_REGISTER: u8 = 27
pub const E_TABLE_IN: u8 = 28

// E_UNARY's operators.
pub const U_NEG: u8 = 1
pub const U_POS: u8 = 2
pub const U_NOT: u8 = 3
pub const U_BITNOT: u8 = 4

// E_LIKE's kinds.
pub const L_LIKE: u8 = 1
pub const L_GLOB: u8 = 2
pub const L_REGEXP: u8 = 3
pub const L_MATCH: u8 = 4

pub const Expr = struct {
    op: u8
    // E_UNARY's and E_BINARY's operator, E_LIKE's kind.
    sub: u8
    // NOT IN, NOT BETWEEN, NOT LIKE, IS NOT, NOT NULL.
    negated: bool
    // E_FUNCTION: DISTINCT, f(*); E_COLUMN: the name was quoted.
    distinct: bool
    star: bool
    quoted: bool
    // E_CAST's affinity.
    affinity: u8
    left: usize
    right: usize
    third: usize
    list: usize
    select: usize
    // A name (column, function, collation, type), or a literal's bytes.
    name: usize
    nameLength: usize
    // A column's table (or alias), when it was written `t.c`.
    table: usize
    tableLength: usize
    i: i64
    r: f64
    // Where the expression is in the statement's text.
    start: usize
    end: usize
    // Resolution: a column's source (its index among the statement's
    // sources) and column (-1 the rowid); a register's slot; the
    // collation an explicit COLLATE names; a function's definition.
    source: i64
    column: i64
    slot: usize
    collation: usize
    function: usize
    // The aggregate this expression is (its index in the query's list
    // + 1), or 0.
    aggregate: usize
    // Results a subquery or IN list computed once (it refers to no outer
    // row): the cache's address.
    cache: usize
}

pub inline fn expr(address: usize) -> *Expr { unsafe { return @ptrFromInt(*Expr, address) } }

pub fn newExpr(a: *Arena, op: u8) -> usize {
    const address = alloc(a, @sizeOf(Expr))
    if address == 0 { return 0 }
    const e = expr(address)
    e.*.op = op
    e.*.source = -1
    e.*.column = -1
    return address
}

// A list of expressions (result columns, arguments, ORDER BY terms...).
pub const Item = struct {
    expr: usize
    // AS name, or a column's name in INSERT, UPDATE and CREATE INDEX.
    name: usize
    nameLength: usize
    descending: bool
    // NULLS FIRST (1) or LAST (2), 0 when not said.
    nulls: u8
    // An explicit COLLATE on an indexed column.
    collation: usize
    collationLength: usize
    // `t.*`'s table.
    table: usize
    tableLength: usize
}

pub inline fn item(address: usize) -> *Item { unsafe { return @ptrFromInt(*Item, address) } }

// A growing list of words in the arena (its old arrays stay there).
pub const List = struct {
    data: usize
    length: usize
    capacity: usize
}

pub inline fn list(address: usize) -> *List { unsafe { return @ptrFromInt(*List, address) } }

pub fn newList(a: *Arena) -> usize { return alloc(a, @sizeOf(List)) }

pub fn push(a: *Arena, l: usize, word: u64) -> bool {
    const x = list(l)
    if x.*.length == x.*.capacity {
        const room = if x.*.capacity < 4 { 4 } else { x.*.capacity * 2 }
        const fresh = alloc(a, room * 8)
        if fresh == 0 { return false }
        mem.copy(fresh, x.*.data, x.*.length * 8)
        x.*.data = fresh
        x.*.capacity = room
    }
    mem.put64(x.*.data + x.*.length * 8, word)
    x.*.length += 1
    return true
}

pub fn wordAt(l: usize, index: usize) -> u64 { return mem.get64(list(l).*.data + index * 8) }

pub fn count(l: usize) -> usize {
    if l == 0 { return 0 }
    return list(l).*.length
}

// Adds an item for `e` to a list of items.
pub fn addItem(a: *Arena, l: usize, e: usize) -> usize {
    const address = alloc(a, @sizeOf(Item))
    if address == 0 { return 0 }
    item(address).*.expr = e
    if !push(a, l, @intCast(u64, address)) { return 0 }
    return address
}

pub fn itemAt(l: usize, index: usize) -> *Item { return item(@intCast(usize, wordAt(l, index))) }

pub fn exprAt(l: usize, index: usize) -> usize { return itemAt(l, index).*.expr }

// ---------------------------------------------------------------------------
// SELECT.

pub const J_INNER: u8 = 1
pub const J_LEFT: u8 = 2
pub const J_CROSS: u8 = 4
pub const J_NATURAL: u8 = 8
pub const J_RIGHT: u8 = 16

pub const Source = struct {
    name: usize
    nameLength: usize
    alias: usize
    aliasLength: usize
    subquery: usize
    // A table-valued function's arguments (pragma_table_info('t')).
    arguments: usize
    // How it joins the sources before it, ON's condition, USING's names.
    join: u8
    on: usize
    using: usize
    // INDEXED BY name, or NOT INDEXED.
    indexedBy: usize
    indexedByLength: usize
    notIndexed: bool
    // Resolution: the table (or 0 for a subquery), its index among the
    // statement's sources.
    table: usize
    number: usize
}

pub inline fn source(address: usize) -> *Source { unsafe { return @ptrFromInt(*Source, address) } }

pub const C_NONE: u8 = 0
pub const C_UNION_ALL: u8 = 1
pub const C_UNION: u8 = 2
pub const C_INTERSECT: u8 = 3
pub const C_EXCEPT: u8 = 4

pub const Select = struct {
    distinct: bool
    columns: usize
    // The sources (a list of Source addresses).
    from: usize
    where: usize
    groupBy: usize
    having: usize
    orderBy: usize
    limit: usize
    offset: usize
    // A compound: this SELECT follows `prior` by `op`.
    op: u8
    prior: usize
    // VALUES (...): a row of a VALUES list.
    values: bool
    // WITH's common table expressions (a List of Cte addresses), on the
    // last SELECT of a compound.
    with: usize
}

// A common table expression: its name, its columns' names (Items, or 0),
// its SELECT; `active` while it is being compiled (one that names itself
// is recursive). A SELECT compiles once (its expressions keep what they
// resolve to), so each use after the first parses it again: from its
// text (`start` to `end` in the text at `text`), numbering its parameters
// on from `variables`, as the first parse did.
pub const Cte = struct {
    name: usize
    nameLength: usize
    columns: usize
    select: usize
    active: bool
    text: usize
    start: usize
    end: usize
    variables: i64
    uses: usize
}

pub inline fn cte(address: usize) -> *Cte { unsafe { return @ptrFromInt(*Cte, address) } }

pub inline fn select(address: usize) -> *Select { unsafe { return @ptrFromInt(*Select, address) } }

pub fn newSelect(a: *Arena) -> usize {
    const address = alloc(a, @sizeOf(Select))
    if address != 0 { select(address).*.from = newList(a) }
    return address
}

// ---------------------------------------------------------------------------
// Statements.

pub const S_SELECT: u8 = 1
pub const S_INSERT: u8 = 2
pub const S_UPDATE: u8 = 3
pub const S_DELETE: u8 = 4
pub const S_CREATE_TABLE: u8 = 5
pub const S_CREATE_INDEX: u8 = 6
pub const S_DROP_TABLE: u8 = 7
pub const S_DROP_INDEX: u8 = 8
pub const S_ALTER_RENAME: u8 = 9
pub const S_ALTER_ADD: u8 = 10
pub const S_ALTER_RENAME_COLUMN: u8 = 11
pub const S_BEGIN: u8 = 12
pub const S_COMMIT: u8 = 13
pub const S_ROLLBACK: u8 = 14
pub const S_SAVEPOINT: u8 = 15
pub const S_RELEASE: u8 = 16
pub const S_PRAGMA: u8 = 17
pub const S_VACUUM: u8 = 18
pub const S_REINDEX: u8 = 19
pub const S_ANALYZE: u8 = 20
pub const S_CREATE_VIEW: u8 = 21
pub const S_DROP_VIEW: u8 = 22
pub const S_CREATE_TRIGGER: u8 = 23
pub const S_DROP_TRIGGER: u8 = 24
pub const S_ATTACH: u8 = 25
pub const S_DETACH: u8 = 26
pub const S_ALTER_DROP_COLUMN: u8 = 27

// Conflict resolutions (ON CONFLICT, INSERT OR ...), numbered as SQLite's
// OE_ constants.
pub const OE_NONE: u8 = 0
pub const OE_ROLLBACK: u8 = 1
pub const OE_ABORT: u8 = 2
pub const OE_FAIL: u8 = 3
pub const OE_IGNORE: u8 = 4
pub const OE_REPLACE: u8 = 5

// Transaction kinds.
pub const T_DEFERRED: u8 = 0
pub const T_IMMEDIATE: u8 = 1
pub const T_EXCLUSIVE: u8 = 2

// Foreign key actions.
pub const FK_NONE: u8 = 0
pub const FK_SET_NULL: u8 = 1
pub const FK_SET_DEFAULT: u8 = 2
pub const FK_CASCADE: u8 = 3
pub const FK_RESTRICT: u8 = 4
pub const FK_NO_ACTION: u8 = 5

pub const ForeignKey = struct {
    // The referencing columns (names), the parent table and its columns
    // (0 items: its primary key).
    columns: usize
    parent: usize
    parentLength: usize
    parentColumns: usize
    onDelete: u8
    onUpdate: u8
    deferred: bool
}

pub inline fn foreignKey(address: usize) -> *ForeignKey { unsafe { return @ptrFromInt(*ForeignKey, address) } }

pub const ColumnDef = struct {
    name: usize
    nameLength: usize
    // The declared type's text.
    typeStart: usize
    typeLength: usize
    primaryKey: bool
    primaryKeyDescending: bool
    primaryKeyConflict: u8
    autoincrement: bool
    notNull: bool
    notNullConflict: u8
    unique: bool
    uniqueConflict: u8
    // DEFAULT: the expression and its text.
    defaultExpr: usize
    defaultStart: usize
    defaultEnd: usize
    collation: usize
    collationLength: usize
    foreignKey: usize
    // GENERATED ALWAYS AS (...), not supported: refused.
    generated: bool
    hidden: bool
    // The column's whole definition in the text (ALTER TABLE ADD COLUMN).
    start: usize
    end: usize
    // CHECK constraints: Items (the expression, the constraint's name).
    checks: usize
}

pub inline fn columnDef(address: usize) -> *ColumnDef { unsafe { return @ptrFromInt(*ColumnDef, address) } }

pub const K_PRIMARY_KEY: u8 = 1
pub const K_UNIQUE: u8 = 2
pub const K_CHECK: u8 = 3
pub const K_FOREIGN_KEY: u8 = 4

pub const TableConstraint = struct {
    kind: u8
    // PRIMARY KEY and UNIQUE: the indexed columns (Items with names);
    // FOREIGN KEY: the ForeignKey.
    columns: usize
    conflict: u8
    autoincrement: bool
    check: usize
    foreignKey: usize
    // CONSTRAINT name (a CHECK's error names it).
    name: usize
    nameLength: usize
}

pub inline fn tableConstraint(address: usize) -> *TableConstraint { unsafe { return @ptrFromInt(*TableConstraint, address) } }

pub const TableDef = struct {
    // Lists of ColumnDef and TableConstraint addresses.
    columns: usize
    constraints: usize
    withoutRowid: bool
    strict: bool
    asSelect: usize
    // Where ALTER TABLE ADD COLUMN puts a new column in the text: at the
    // comma before the table's constraints, else at its closing
    // parenthesis (as SQLite does).
    end: usize
}

pub inline fn tableDef(address: usize) -> *TableDef { unsafe { return @ptrFromInt(*TableDef, address) } }

// An INSERT's ON CONFLICT clause (an upsert): the conflict it is for
// (indexed columns as Items with names, and a WHERE; no target: any
// uniqueness constraint), and DO NOTHING or DO UPDATE with its SET items
// and WHERE. Clauses chain.
pub const Upsert = struct {
    target: usize
    targetWhere: usize
    update: bool
    sets: usize
    where: usize
    next: usize
}

pub inline fn upsert(address: usize) -> *Upsert { unsafe { return @ptrFromInt(*Upsert, address) } }

pub const Statement = struct {
    kind: u8
    explain: u8
    select: usize
    // The table, index, savepoint or pragma named, and a second name (the
    // index's table, the new name, a pragma's schema).
    name: usize
    nameLength: usize
    name2: usize
    name2Length: usize
    schema: usize
    schemaLength: usize
    // INSERT's columns, CREATE INDEX's indexed columns, UPDATE's SET.
    columns: usize
    // INSERT's rows (a VALUES chain) or SELECT.
    source: usize
    defaultValues: bool
    conflict: u8
    where: usize
    orderBy: usize
    limit: usize
    offset: usize
    ifExists: bool
    ifNotExists: bool
    unique: bool
    temp: bool
    transaction: u8
    // PRAGMA name = value, or (value).
    pragmaValue: usize
    tableDef: usize
    // ALTER TABLE ADD COLUMN's column.
    column: usize
    // Where the statement's text names its object, and where it ends (what
    // sqlite_master keeps).
    nameStart: usize
    textEnd: usize
    // The statement writes the database (it needs a write transaction).
    writes: bool
    // INSERT's ON CONFLICT clauses.
    upsert: usize
    // CREATE VIEW: where its SELECT begins in the text.
    selectStart: usize
    // The source the statement's table is (INSERT, UPDATE, DELETE), for
    // resolution.
    target: usize
}

pub inline fn statement(address: usize) -> *Statement { unsafe { return @ptrFromInt(*Statement, address) } }
