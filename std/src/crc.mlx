// std.crc: the check values of the repository's formats, in one place:
//
//     const crc = @import("std.crc")
//     const value = crc.crc32(0, data, length)       // zlib, gzip, PNG, ZIP
//     const more = crc.crc32(value, next, count)     // continued
//     const sum = crc.adler32(1, data, length)       // zlib streams
//     const posix = crc.cksum(data, length)          // POSIX cksum
//
//   - CRC-32 (the reflected polynomial 0xedb88320 of ISO 3309, used by
//     gzip, zlib's crc32, PNG and ZIP), with crc32Join, which gives the
//     CRC of two pieces put together from the CRCs of each;
//   - Adler-32 (RFC 1950), with adler32Join;
//   - the CRC of POSIX cksum (the polynomial 0x04c11db7, not reflected,
//     the length appended, complemented).
//
// std.flate uses the first two for zlib and gzip streams; the zlib C API
// (compiler/capi/zlib) exports them as crc32, adler32 and the rest. The
// functions named ...Update, ...Combine and ...CombineGen/Op work on an
// address and 64-bit values (what the compressor and the C API hold);
// the others are typed.
//
// CRC-32 is computed eight bytes at a time ("slicing by eight"): eight
// tables of 256 words, the first of them the CRC of every byte, made the
// first time one is needed. The first table is what table() gives (and
// zlib's get_crc_table).

inline fn bytesAt(address: usize) -> [*]const u8 { return unsafe { @ptrFromInt([*]const u8, address) } }
inline fn get8(address: usize) -> u8 { unsafe { return @ptrFromInt(*u8, address).* } }
inline fn get32(address: usize) -> u32 { unsafe { return @ptrFromInt(*u32, address).* } }

const POLY: u64 = 0xedb88320
const BASE: u64 = 65521
// The most bytes whose sums fit in 32 bits before a reduction modulo BASE.
const NMAX: usize = 5552

var crcTables: [2048]u32 = undefined
// x^(2^n) modulo the polynomial, for n = 0..31 (combining).
var powers: [32]u32 = undefined
var tablesReady: u32 = 0

fn makeTables() -> void {
    var n: usize = 0
    while n < 256 {
        var p: u64 = @intCast(u64, n)
        var k: usize = 0
        while k < 8 {
            p = if (p & 1) != 0 { (p >> 1) ^ POLY } else { p >> 1 }
            k += 1
        }
        crcTables[n] = @intCast(u32, p)
        n += 1
    }
    var t: usize = 1
    while t < 8 {
        n = 0
        while n < 256 {
            const previous = @intCast(u64, crcTables[(t - 1) * 256 + n])
            const next = (previous >> 8) ^ @intCast(u64, crcTables[@intCast(usize, previous & 255)])
            crcTables[t * 256 + n] = @intCast(u32, next & 0xffffffff)
            n += 1
        }
        t += 1
    }
    var p: u64 = 0x40000000
    powers[0] = @intCast(u32, p)
    n = 1
    while n < 32 {
        p = multiplyModulo(p, p)
        powers[n] = @intCast(u32, p)
        n += 1
    }
}

pub fn ensureTables() -> void {
    if @atomicLoad(u32, &tablesReady, acquire) != 0 { return }
    makeTables()
    @atomicStore(u32, &tablesReady, 1, release)
}

// The address of the table of the CRCs of the bytes.
pub fn table() -> usize {
    ensureTables()
    return @intFromPtr(&crcTables)
}

// The CRC-32 of `length` bytes at `buffer`, continuing `crc`.
pub fn crc32Update(crc: u64, buffer: usize, length: usize) -> u64 {
    if buffer == 0 { return 0 }
    ensureTables()
    var value: u64 = (crc & 0xffffffff) ^ 0xffffffff
    const p = bytesAt(buffer)
    var at: usize = 0
    var left = length
    // (Byte by byte up to an address that is a multiple of eight.)
    while left != 0 && ((buffer + at) & 7) != 0 {
        value = (value >> 8) ^ @intCast(u64, crcTables[@intCast(usize, (value ^ @intCast(u64, p[at])) & 255)])
        at += 1
        left -= 1
    }
    while left >= 8 {
        const one = value ^ @intCast(u64, get32(buffer + at))
        const two = @intCast(u64, get32(buffer + at + 4))
        value = @intCast(u64, crcTables[1792 + @intCast(usize, one & 255)]) ^
            @intCast(u64, crcTables[1536 + @intCast(usize, (one >> 8) & 255)]) ^
            @intCast(u64, crcTables[1280 + @intCast(usize, (one >> 16) & 255)]) ^
            @intCast(u64, crcTables[1024 + @intCast(usize, (one >> 24) & 255)]) ^
            @intCast(u64, crcTables[768 + @intCast(usize, two & 255)]) ^
            @intCast(u64, crcTables[512 + @intCast(usize, (two >> 8) & 255)]) ^
            @intCast(u64, crcTables[256 + @intCast(usize, (two >> 16) & 255)]) ^
            @intCast(u64, crcTables[@intCast(usize, (two >> 24) & 255)])
        at += 8
        left -= 8
    }
    while left != 0 {
        value = (value >> 8) ^ @intCast(u64, crcTables[@intCast(usize, (value ^ @intCast(u64, p[at])) & 255)])
        at += 1
        left -= 1
    }
    return value ^ 0xffffffff
}

// The Adler-32 of `length` bytes at `buffer`, continuing `adler`.
pub fn adler32Update(adler: u64, buffer: usize, length: usize) -> u64 {
    var sum2: u64 = (adler >> 16) & 0xffff
    var sum1: u64 = adler & 0xffff
    if length == 1 {
        sum1 += @intCast(u64, get8(buffer))
        if sum1 >= BASE { sum1 -= BASE }
        sum2 += sum1
        if sum2 >= BASE { sum2 -= BASE }
        return sum1 | (sum2 << 16)
    }
    if buffer == 0 { return 1 }
    const p = bytesAt(buffer)
    var at: usize = 0
    var left = length
    if left < 16 {
        while left != 0 {
            sum1 += @intCast(u64, p[at])
            sum2 += sum1
            at += 1
            left -= 1
        }
        if sum1 >= BASE { sum1 -= BASE }
        sum2 = sum2 % BASE
        return sum1 | (sum2 << 16)
    }
    while left != 0 {
        var block = if left < NMAX { left } else { NMAX }
        left -= block
        while block >= 8 {
            sum1 += @intCast(u64, p[at])
            sum2 += sum1
            sum1 += @intCast(u64, p[at + 1])
            sum2 += sum1
            sum1 += @intCast(u64, p[at + 2])
            sum2 += sum1
            sum1 += @intCast(u64, p[at + 3])
            sum2 += sum1
            sum1 += @intCast(u64, p[at + 4])
            sum2 += sum1
            sum1 += @intCast(u64, p[at + 5])
            sum2 += sum1
            sum1 += @intCast(u64, p[at + 6])
            sum2 += sum1
            sum1 += @intCast(u64, p[at + 7])
            sum2 += sum1
            at += 8
            block -= 8
        }
        while block != 0 {
            sum1 += @intCast(u64, p[at])
            sum2 += sum1
            at += 1
            block -= 1
        }
        sum1 = sum1 % BASE
        sum2 = sum2 % BASE
    }
    return sum1 | (sum2 << 16)
}

// The Adler-32 of two pieces put together, from the check values of
// each and the length of the second.
pub fn adler32Combine(adler1: u64, adler2: u64, length2: i64) -> u64 {
    if length2 < 0 { return 0xffffffff }
    const rem = @intCast(u64, length2) % BASE
    var sum1: u64 = adler1 & 0xffff
    var sum2: u64 = (rem * sum1) % BASE
    sum1 += (adler2 & 0xffff) + BASE - 1
    sum2 += ((adler1 >> 16) & 0xffff) + ((adler2 >> 16) & 0xffff) + BASE - rem
    if sum1 >= BASE { sum1 -= BASE }
    if sum1 >= BASE { sum1 -= BASE }
    if sum2 >= (BASE << 1) { sum2 -= (BASE << 1) }
    if sum2 >= BASE { sum2 -= BASE }
    return sum1 | (sum2 << 16)
}

// a(x) times b(x) modulo the polynomial (reflected); `a` is not zero.
fn multiplyModulo(a: u64, b0: u64) -> u64 {
    var m: u64 = 0x80000000
    var p: u64 = 0
    var b = b0
    while true {
        if (a & m) != 0 {
            p ^= b
            if (a & (m - 1)) == 0 { break }
        }
        m >>= 1
        b = if (b & 1) != 0 { (b >> 1) ^ POLY } else { b >> 1 }
    }
    return p
}

// x^(n * 2^k) modulo the polynomial.
fn powerModulo(n0: i64, k0: usize) -> u64 {
    var p: u64 = 0x80000000
    var n = @bitCast(u64, n0)
    var k = k0
    while n != 0 {
        if (n & 1) != 0 { p = multiplyModulo(@intCast(u64, powers[k & 31]), p) }
        n >>= 1
        k += 1
    }
    return p
}

pub fn crc32CombineGen(length2: i64) -> u64 {
    ensureTables()
    return powerModulo(length2, 3)
}

pub fn crc32CombineOp(crc1: u64, crc2: u64, op: u64) -> u64 {
    return multiplyModulo(op & 0xffffffff, crc1 & 0xffffffff) ^ (crc2 & 0xffffffff)
}

pub fn crc32Combine(crc1: u64, crc2: u64, length2: i64) -> u64 {
    return crc32CombineOp(crc1, crc2, crc32CombineGen(length2))
}

// ---------------------------------------------------------------------------
// Typed

// The CRC-32 of LENGTH bytes at DATA, continuing CRC (0 to start).
pub fn crc32(crc: u32, data: [*]const u8, length: usize) -> u32 {
    if length == 0 { return crc }
    return @intCast(u32, crc32Update(@intCast(u64, crc), @intFromPtr(data), length) & 0xffffffff)
}

// The Adler-32 of LENGTH bytes at DATA, continuing ADLER (1 to start).
pub fn adler32(adler: u32, data: [*]const u8, length: usize) -> u32 {
    if length == 0 { return adler }
    return @intCast(u32, adler32Update(@intCast(u64, adler), @intFromPtr(data), length) & 0xffffffff)
}

// The CRC-32 of two pieces put together: FIRST's and SECOND's CRCs, and
// the length of the second.
pub fn crc32Join(first: u32, second: u32, secondLength: u64) -> u32 {
    return @intCast(u32, crc32Combine(@intCast(u64, first), @intCast(u64, second), @bitCast(i64, secondLength)) & 0xffffffff)
}

// The Adler-32 of two pieces put together.
pub fn adler32Join(first: u32, second: u32, secondLength: u64) -> u32 {
    return @intCast(u32, adler32Combine(@intCast(u64, first), @intCast(u64, second), @bitCast(i64, secondLength)) & 0xffffffff)
}

// ---------------------------------------------------------------------------
// POSIX cksum: a CRC with the polynomial 0x04c11db7, most significant bit
// first, over the data and then its length (least significant byte
// first, as few bytes as it takes), complemented.

const CKSUM_POLY: u64 = 0x04c11db7
var cksumTable: [256]u32 = undefined
var cksumReady: u32 = 0

fn cksumTables() -> void {
    if @atomicLoad(u32, &cksumReady, acquire) != 0 { return }
    var n: usize = 0
    while n < 256 {
        var value: u64 = @intCast(u64, n) << 24
        var bit: usize = 0
        while bit < 8 {
            value = if (value & 0x80000000) != 0 { ((value << 1) ^ CKSUM_POLY) & 0xffffffff } else { (value << 1) & 0xffffffff }
            bit += 1
        }
        cksumTable[n] = @intCast(u32, value)
        n += 1
    }
    @atomicStore(u32, &cksumReady, 1, release)
}

fn cksumByte(value: u64, byte: u64) -> u64 {
    const index = @intCast(usize, ((value >> 24) ^ byte) & 255)
    return ((value << 8) & 0xffffffff) ^ @intCast(u64, cksumTable[index])
}

// The running cksum CRC of LENGTH more bytes at DATA (0 to start); the
// value cksum prints is cksumFinish's.
pub fn cksumUpdate(crc: u32, data: [*]const u8, length: usize) -> u32 {
    cksumTables()
    var value = @intCast(u64, crc)
    var at: usize = 0
    while at < length {
        value = cksumByte(value, @intCast(u64, data[at]))
        at += 1
    }
    return @intCast(u32, value & 0xffffffff)
}

// The cksum value of data whose running CRC is CRC and whose length is
// TOTAL.
pub fn cksumFinish(crc: u32, total: u64) -> u32 {
    cksumTables()
    var value = @intCast(u64, crc)
    var remaining = total
    while remaining != 0 {
        value = cksumByte(value, remaining & 255)
        remaining = remaining >> 8
    }
    return @intCast(u32, (value ^ 0xffffffff) & 0xffffffff)
}

// The POSIX cksum value of LENGTH bytes at DATA.
pub fn cksum(data: [*]const u8, length: usize) -> u32 {
    return cksumFinish(cksumUpdate(0, data, length), @intCast(u64, length))
}
