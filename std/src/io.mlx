const bootstrap = @import("../bootstrap/io.mlx")

pub const File = bootstrap.File
pub const String = bootstrap.String
pub const FormatError = bootstrap.FormatError
pub const FormatArgument = bootstrap.FormatArgument

pub fn stdin() -> File { return bootstrap.stdin() }
pub fn stdout() -> File { return bootstrap.stdout() }
pub fn stderr() -> File { return bootstrap.stderr() }

pub fn read(file: File, destination: []u8) -> isize {
    return bootstrap.read(file, destination)
}

pub fn write(file: File, source: []const u8) -> isize {
    return bootstrap.write(file, source)
}

pub fn writeAll(file: File, source: []const u8) -> bool {
    return bootstrap.writeAll(file, source)
}

pub fn writeString(file: File, source: String) -> bool {
    return bootstrap.writeString(file, source)
}

pub fn writeLine(file: File, source: []const u8) -> bool {
    return bootstrap.writeLine(file, source)
}

pub fn writeUnsigned(file: File, value: usize) -> bool {
    return bootstrap.writeUnsigned(file, value)
}

pub fn writeHex(file: File, value: usize) -> bool {
    return bootstrap.writeHex(file, value)
}

pub fn formatArguments(file: File, format_string: []const u8, arguments: []const FormatArgument) -> FormatError!void {
    return bootstrap.formatArguments(file, format_string, arguments)
}

pub fn format(file: File, format_string: []const u8, arguments: anytype) -> FormatError!void {
    return bootstrap.format(file, format_string, arguments)
}

pub fn printFmt(format_string: []const u8, arguments: anytype) -> FormatError!void {
    return bootstrap.printFmt(format_string, arguments)
}

pub fn eprintFmt(format_string: []const u8, arguments: anytype) -> FormatError!void {
    return bootstrap.eprintFmt(format_string, arguments)
}

pub fn print(source: []const u8) -> bool { return bootstrap.print(source) }
pub fn println(source: []const u8) -> bool { return bootstrap.println(source) }
pub fn printString(source: String) -> bool { return bootstrap.printString(source) }
pub fn eprint(source: []const u8) -> bool { return bootstrap.eprint(source) }
pub fn eprintln(source: []const u8) -> bool { return bootstrap.eprintln(source) }
