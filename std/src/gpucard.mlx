// std.gpucard: a brixOS graphics card for its driver (spec/04-stdlib/os/
// brix.xml, <GpuDevices>; native calls 80 to 85). A card is the node
// /devices/gpuN (gpu0 the first, numbered without gaps; a machine without
// such a card has none). A read of it gives its record (Device: what the
// card is, where it sits on PCI, its memory, its graphics block, the rings
// that take a program's commands and why there are none); everyone may
// read it. Opening it to write gives a handle of the kind gpu, which is
// the process's context on the card: its address space and its place in
// the card's queues. A second open is a second context; closing every
// handle of one ends it, and everything made through it.
//
//     var device: gpucard.Device = undefined
//     if gpucard.describe(0, &device) == 0 { ... device.name, device.memory ... }
//     const context = gpucard.open(0)          // a gpu handle, or a status
//
// What a context does (memory for the card, its addresses, submits and
// fences) is specified here as the kernel will serve it; the kernel
// refuses each call with Status.unsupported for now, as it starts none of
// the card's engines yet (`Device.computeRings` is 0, `Device.why` says
// why). The calls, from the study of our Vulkan driver (its section 3.5):
//   - the handle is the context: no context numbers;
//   - memory for the card is a memory handle (memory_map_object maps it,
//     handle_duplicate narrows it, channel_send passes it on: that is all
//     sharing is), made by `memory` or of a process's own pages by
//     `memoryOf`;
//   - the driver chooses the card's addresses and `map` puts memory there:
//     a mapping is valid for every later submit of the context, so a
//     submit carries no list of buffers;
//   - `submit` runs streams of the card's packets; a fence is a handle
//     whose state becomes readable when the submit it was given to is
//     done (peer_gone when the context was lost), waited for by the one
//     wait among a program's other handles.
const std = @import("std")

const brix = std.os.brix

pub const Handle = brix.Handle

// The calls (NATIVE_BASE + n).
pub const GPU_MEMORY: usize = brix.NATIVE_BASE + 80
pub const GPU_MEMORY_OF: usize = brix.NATIVE_BASE + 81
pub const GPU_MAP: usize = brix.NATIVE_BASE + 82
pub const GPU_UNMAP: usize = brix.NATIVE_BASE + 83
pub const GPU_SUBMIT: usize = brix.NATIVE_BASE + 84
pub const GPU_FENCE: usize = brix.NATIVE_BASE + 85

// A context's kind, as handle_info says it.
pub const KIND: u32 = 10

// The record's bytes as this module knows it (a longer one of a later
// kernel is read as far as these go).
pub const RECORD: usize = 136

// The most cards looked for (/devices/gpu0 to gpu7).
pub const MOST: usize = 8

// The record's flags (Device.flags).
pub const Flag = struct {
    // The firmware started the card.
    pub const STARTED: u32 = 0x1
    // The firmware's picture is in the card's memory (Device.picture).
    pub const PICTURE: u32 = 0x2
    // The ROM's counts of the graphics block are known.
    pub const ROM_COUNTS: u32 = 0x4
    // The card reaches the system's memory (Device.system).
    pub const SYSTEM_MEMORY: u32 = 0x8
}

// Why no engine takes a program's commands (Device.why).
pub const Why = struct {
    pub const NONE: u32 = 0
    pub const NOT_STARTED_YET: u32 = 1
    pub const CARD_NOT_STARTED: u32 = 2
    pub const OTHER_CARD: u32 = 3
}

// The reason in plain words.
pub fn whyText(why: u32) -> []const u8 {
    if why == Why.NOT_STARTED_YET { return "the system starts none of the card's engines yet" }
    if why == Why.CARD_NOT_STARTED { return "the firmware did not start the card" }
    if why == Why.OTHER_CARD { return "the system knows the engines of a Polaris 10 card alone" }
    return "an engine takes commands"
}

// Memory for the card (`memory`'s flags): where it is (card memory 1,
// system memory 2, either 3), the processor may map it, mapped
// write-combining, zeroed, below 4 GiB of the card's addresses, may be
// passed to another process.
pub const Memory = struct {
    pub const CARD: usize = 1
    pub const SYSTEM: usize = 2
    pub const EITHER: usize = 3
    pub const PROCESSOR: usize = 1 << 4
    pub const WRITE_COMBINED: usize = 1 << 5
    pub const ZEROED: usize = 1 << 6
    pub const LOW: usize = 1 << 7
    pub const SHAREABLE: usize = 1 << 8
}

// A mapping's rights for the card (`map`'s flags).
pub const Access = struct {
    pub const READ: usize = 1
    pub const WRITE: usize = 2
    pub const EXECUTE: usize = 4
}

// The card's engines a stream is for (Stream.engine).
pub const Engine = struct {
    pub const GRAPHICS: u32 = 0
    pub const COMPUTE: u32 = 1
    pub const COPY: u32 = 2
}

// A stream of a submit: the engine, its flags (none yet), where its words
// are in the card's addresses and how many.
pub const Stream = struct {
    engine: u32
    flags: u32
    address: u64
    words: u64
}

// A card's record, as read.
pub const Device = struct {
    // The record's bytes as the kernel has it.
    length: u32
    flags: u32
    vendor: u32
    device: u32
    revision: u32
    // Where the card sits on PCI: bus << 8 | device << 3 | function
    // (0xFFFFFFFF: not known).
    pci: u32
    // The graphics block's version (major << 8 | minor; 0: not known).
    graphics: u32
    shaderEngines: u32
    arraysPerEngine: u32
    computeUnitsPerArray: u32
    renderBackendsPerEngine: u32
    // The ROM's default clocks, kHz.
    engineClock: u32
    memoryClock: u32
    // The rings that take a program's commands, by engine; why there are
    // none (Why).
    computeRings: u32
    graphicsRings: u32
    copyRings: u32
    why: u32
    // The card's own memory, of it what the processor reaches, of that
    // what the firmware's picture takes, and the system's memory the card
    // reaches, bytes.
    memory: u64
    visible: u64
    picture: u64
    system: u64
    // Its name, NUL after it.
    name: [32]u8
}

fn get32(bytes: [*]const u8, at: usize) -> u32 {
    return @intCast(u32, @intCast(usize, bytes[at]) | (@intCast(usize, bytes[at + 1]) << 8) | (@intCast(usize, bytes[at + 2]) << 16) | (@intCast(usize, bytes[at + 3]) << 24))
}

fn get64(bytes: [*]const u8, at: usize) -> u64 {
    return @intCast(u64, @intCast(usize, get32(bytes, at)) | (@intCast(usize, get32(bytes, at + 4)) << 32))
}

// The record in `bytes` (`length` of them read) into `into`: false when it
// is not one (shorter than its fixed part, or its first word says less).
// What a longer record of a later kernel adds is not read.
pub fn decode(bytes: [*]const u8, length: usize, into: *Device) -> bool {
    if length < RECORD { return false }
    const said = @intCast(usize, get32(bytes, 0))
    if said < RECORD { return false }
    into.*.length = @intCast(u32, said)
    into.*.flags = get32(bytes, 4)
    into.*.vendor = get32(bytes, 8)
    into.*.device = get32(bytes, 12)
    into.*.revision = get32(bytes, 16)
    into.*.pci = get32(bytes, 20)
    into.*.graphics = get32(bytes, 24)
    into.*.shaderEngines = get32(bytes, 28)
    into.*.arraysPerEngine = get32(bytes, 32)
    into.*.computeUnitsPerArray = get32(bytes, 36)
    into.*.renderBackendsPerEngine = get32(bytes, 40)
    into.*.engineClock = get32(bytes, 44)
    into.*.memoryClock = get32(bytes, 48)
    into.*.computeRings = get32(bytes, 52)
    into.*.graphicsRings = get32(bytes, 56)
    into.*.copyRings = get32(bytes, 60)
    into.*.memory = get64(bytes, 64)
    into.*.visible = get64(bytes, 72)
    into.*.picture = get64(bytes, 80)
    into.*.system = get64(bytes, 88)
    var k: usize = 0
    while k < 32 {
        into.*.name[k] = if k < 31 { bytes[96 + k] } else { 0 }
        k += 1
    }
    into.*.why = get32(bytes, 128)
    return true
}

// The name's bytes (up to its NUL).
pub fn nameOf(device: *const Device) -> []const u8 {
    var length: usize = 0
    while length < 31 && device.*.name[length] != 0 { length += 1 }
    const bytes: [*]const u8 = &device.*.name
    return bytes[0..length]
}

// The compute units by the ROM's counts (0: not known).
pub fn computeUnits(device: *const Device) -> usize {
    return @intCast(usize, device.*.shaderEngines) * @intCast(usize, device.*.arraysPerEngine) * @intCast(usize, device.*.computeUnitsPerArray)
}

// The path of card `index`'s node ("/devices/gpu0") into `into`; its
// length.
pub fn path(index: usize, into: *[16]u8) -> usize {
    const prefix = "/devices/gpu"
    var length: usize = 0
    while length < prefix.length {
        into.*[length] = prefix[length]
        length += 1
    }
    into.*[length] = @intCast(u8, 48 + index % 10)
    return length + 1
}

// Card `index`'s record into `into`: 0, or a Status negated (not_found:
// there is no such card; the cards are numbered without gaps, so the first
// one not found ends the list).
pub fn describe(index: usize, into: *Device) -> isize {
    if index >= MOST { return -brix.Status.not_found }
    var name: [16]u8 = undefined
    const length = path(index, &name)
    const opened = brix.open(0, name[0..length], brix.Open.READ, 0)
    if opened < 0 { return opened }
    var record: [RECORD]u8 = undefined
    const got = brix.read(@intCast(Handle, opened), record[0..RECORD], 0)
    _ = brix.close(@intCast(Handle, opened))
    if got < 0 { return got }
    if !decode(&record, @bitCast(usize, got), into) { return -brix.Status.invalid }
    return 0
}

// How many cards there are (the nodes found before the first missing).
pub fn count() -> usize {
    var device: Device = undefined
    var index: usize = 0
    while index < MOST && describe(index, &device) == 0 { index += 1 }
    return index
}

// A context on card `index`: its handle, or a Status negated (not_found:
// no such card; too_many: the kernel's contexts or the process's handles
// are all taken).
pub fn open(index: usize) -> isize {
    if index >= MOST { return -brix.Status.not_found }
    var name: [16]u8 = undefined
    const length = path(index, &name)
    return brix.open(0, name[0..length], brix.Open.READ | brix.Open.WRITE, 0)
}

// The context's card's record, read through the context.
pub fn describeContext(context: Handle, into: *Device) -> isize {
    var record: [RECORD]u8 = undefined
    const got = brix.read(context, record[0..RECORD], 0)
    if got < 0 { return got }
    if !decode(&record, @bitCast(usize, got), into) { return -brix.Status.invalid }
    return 0
}

// The context ended (this handle of it).
pub fn close(context: Handle) -> isize { return brix.close(context) }

// `size` bytes of memory for the card (Memory's flags): a memory handle.
pub fn memory(context: Handle, size: usize, flags: usize) -> isize { return brix.call3(GPU_MEMORY, @intCast(usize, context), size, flags) }

// The process's own pages at `address` (`size` bytes) made reachable by
// the card, held while the handle lives: a memory handle.
pub fn memoryOf(context: Handle, address: usize, size: usize) -> isize { return brix.call3(GPU_MEMORY_OF, @intCast(usize, context), address, size) }

// `size` bytes of `memory` from `offset` put at the card's address
// `address` of the context (Access's flags).
pub fn map(context: Handle, memory_handle: Handle, offset: usize, size: usize, address: usize, flags: usize) -> isize { return brix.call6(GPU_MAP, @intCast(usize, context), @intCast(usize, memory_handle), offset, size, address, flags) }

// What is mapped at the card's address `address`, `size` bytes, taken out.
pub fn unmap(context: Handle, address: usize, size: usize) -> isize { return brix.call3(GPU_UNMAP, @intCast(usize, context), address, size) }

// The streams run, in order; `fence` (0: none) readable when they are
// done. The submit's sequence number.
pub fn submit(context: Handle, streams: []const Stream, fence_handle: Handle) -> isize { return brix.call4(GPU_SUBMIT, @intCast(usize, context), @intFromPtr(streams.pointer), streams.length, @intCast(usize, fence_handle)) }

// A fence of the context: a handle to give to submits and wait for.
pub fn fence(context: Handle) -> isize { return brix.call1(GPU_FENCE, @intCast(usize, context)) }
