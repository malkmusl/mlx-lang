// std.events: brixOS's events for a program (spec/04-stdlib/os/brix.xml,
// <Events>): a handler per kind, run by the program's one upcall on a
// stack of its own (made the first time); a kind without a handler takes
// its default (an interrupt ends the program, a child's change is
// nothing, ...). A read or write the upcall came in is made again (std's
// files); a wait ends with interrupted. Built for another system than
// brixOS, `handle` says false: there a program's signals are
// std.linux.process's.
//
//     fn onUser(record: events.Record) -> void { ... }
//     _ = events.handle(events.Event.USER, onUser)
const std = @import("std")
const builtin = @import("builtin")

const brix = std.os.brix
const upcalls = @import("../bootstrap/os/upcalls.mlx")

pub const Event = brix.Event
pub const Record = brix.EventRecord
pub const Handler = fn(record: Record) -> void

// The kinds there are (brix.Event's).
const KINDS: usize = 16

var handlers: [KINDS]Handler = undefined // (per run)

// The one upcall is shared (std.crash takes faults through it too): its
// handler for a kind given to this module's.
fn forward(record: Record, context: usize) -> void {
    if @intCast(usize, record.kind) < KINDS { handlers[@intCast(usize, record.kind)](record) }
}

// `handler` runs for each event of `kind` from now on; false when the
// kind cannot be handled (halt, kill) or the upcall could not be set.
pub fn handle(kind: u32, handler: Handler) -> bool {
    if comptime builtin.os != builtin.Os.brixos { return false }
    if kind == 0 || @intCast(usize, kind) >= KINDS { return false }
    handlers[@intCast(usize, kind)] = handler
    return upcalls.handle(kind, forward)
}

// `kind` back to its default.
pub fn release(kind: u32) -> void {
    if comptime builtin.os != builtin.Os.brixos { return }
    upcalls.release(kind)
}

// The program takes the events of `kinds` itself (brix.take, or a wait on
// its own process's EVENTS): claimed, left in the queue by the upcall,
// beside the kinds handlers take. False elsewhere than on brixOS.
pub fn queue(kinds: u32) -> bool {
    if comptime builtin.os != builtin.Os.brixos { return false }
    return upcalls.queue(kinds)
}
