// The platform a program is built for: this file for Linux targets
// (x86_64-linux, aarch64-linux), platform.android.mlx for
// aarch64-android, platform.brixos.mlx for x86_64-brixos. The compiler picks std.X's X.<platform>.mlx when the
// standard library has one, so code that differs by platform lives in std
// and a program's own source is the same everywhere.
pub const NAME = "linux"
pub const ANDROID = false
// The shell for `sh -c` commands.
pub const SHELL = "/bin/sh"
// The users and groups (passwd's and group's format).
pub const USERS = "/etc/passwd"
pub const GROUPS = "/etc/group"
// Where programs are when the environment has no PATH.
pub const PROGRAMS = "/usr/local/bin:/usr/bin:/bin"
