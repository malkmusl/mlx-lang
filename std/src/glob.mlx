// std.glob: the shell's patterns (fnmatch): "*" any run of bytes, "?" any
// one byte, "[...]" one byte of a set, with ranges ("[a-z]") and "!" or
// "^" first for the bytes not in it; a "]" first is one of its members,
// and a "[" with no "]" after it is itself. Anything else matches itself.
// Patterns match the whole text, byte by byte; a "/" or a leading "." is
// nothing special (pathname expansion takes the text a component at a
// time and decides about dot files itself).
//
//     glob.matches("*.mlx", "main.mlx")          // true
//     glob.matches("[!a-c]?", "dx")              // true
//
// In `matches` a backslash makes the byte after it stand for itself
// ("\*" is a star). A shell knows which bytes of a word were quoted
// instead, and gives them to matchesQuoted, where a backslash is a byte
// like any other.
const std = @import("std")

// Whether `text` matches `pattern`, a backslash escaping the byte after it.
pub fn matches(pattern: []const u8, text: []const u8) -> bool {
    return matchFrom(pattern, pattern.pointer, false, 0, text, 0)
}

// Whether `text` matches `pattern` when `literal[i] & 1` says byte i of the
// pattern was quoted (it then stands for itself).
pub fn matchesQuoted(pattern: []const u8, literal: [*]const u8, text: []const u8) -> bool {
    return matchFrom(pattern, literal, true, 0, text, 0)
}

// Whether byte `at` of the pattern is one of the special ones' kind: not
// quoted.
fn special(literal: [*]const u8, masked: bool, at: usize) -> bool {
    return !masked || literal[at] & 1 == 0
}

fn matchFrom(pattern: []const u8, literal: [*]const u8, masked: bool, pattern_at: usize, text: []const u8, text_at: usize) -> bool {
    var p = pattern_at
    var t = text_at
    while p < pattern.length {
        const byte = pattern[p]
        const free = special(literal, masked, p)
        if free && !masked && byte == 92 && p + 1 < pattern.length {
            if t >= text.length || text[t] != pattern[p + 1] { return false }
            p += 2
            t += 1
            continue
        }
        if free && byte == 42 {
            // Several stars are one.
            while p < pattern.length && pattern[p] == 42 && special(literal, masked, p) { p += 1 }
            if p >= pattern.length { return true }
            var try_at = t
            while try_at <= text.length {
                if matchFrom(pattern, literal, masked, p, text, try_at) { return true }
                try_at += 1
            }
            return false
        }
        if t >= text.length { return false }
        if free && byte == 63 {
            p += 1
            t += 1
            continue
        }
        if free && byte == 91 {
            const close = closing(pattern, literal, masked, p)
            if close < pattern.length {
                if !inSet(pattern, masked, p, close, text[t]) { return false }
                p = close + 1
                t += 1
                continue
            }
        }
        if byte != text[t] { return false }
        p += 1
        t += 1
    }
    return t == text.length
}

// The "]" that closes the set opened at `open`; the pattern's length when
// none does (the "[" is then itself).
fn closing(pattern: []const u8, literal: [*]const u8, masked: bool, open: usize) -> usize {
    var at = open + 1
    if at < pattern.length && (pattern[at] == 33 || pattern[at] == 94) { at += 1 }
    if at < pattern.length && pattern[at] == 93 { at += 1 }
    while at < pattern.length {
        if !masked && pattern[at] == 92 && at + 1 < pattern.length {
            at += 2
        } else if pattern[at] == 93 && special(literal, masked, at) {
            return at
        } else {
            at += 1
        }
    }
    return pattern.length
}

// Whether `byte` is in the set between `open` and `close`.
fn inSet(pattern: []const u8, masked: bool, open: usize, close: usize, byte: u8) -> bool {
    var at = open + 1
    var negate = false
    if at < close && (pattern[at] == 33 || pattern[at] == 94) {
        negate = true
        at += 1
    }
    var matched = false
    while at < close {
        var first = pattern[at]
        if !masked && first == 92 && at + 1 < close {
            at += 1
            first = pattern[at]
        }
        at += 1
        var last = first
        if at + 1 < close && pattern[at] == 45 {
            at += 1
            last = pattern[at]
            if !masked && last == 92 && at + 1 < close {
                at += 1
                last = pattern[at]
            }
            at += 1
        }
        if byte >= first && byte <= last { matched = true }
    }
    return matched != negate
}
