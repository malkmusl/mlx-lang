// std.unicode: Unicode and the locale data of CLDR, in Mlx: the
// properties of code points, case mapping, normalization, text
// boundaries, collation, IDNA, charset detection, locale IDs, calendars,
// and formatting numbers, dates, lists, relative times, plural forms and
// the names of languages, scripts and regions as a locale says them. No
// ICU code or data is used; the tables come from the Unicode Character
// Database 16.0, the Collation Algorithm's table and the IDNA mapping
// table, the locale data from CLDR 48, the time zones (std.timezone.
// database) from the IANA database: std/registry/unicode and
// std/registry/tz hold them and the generators that make the tables in
// the tree (`./mlx build unicode` makes them again when they change).
//
// The parts, each imported by its own name (this module has only what
// they share):
//
//     std.unicode.utf            UTF-8 and UTF-16 (no tables, no C library)
//     std.unicode.properties     the properties of code points, scripts,
//                                simple case mappings, display width
//     std.unicode.casing         full case mapping and folding of text
//     std.unicode.normalize      NFC, NFD, NFKC, NFKD, NFKC_Casefold
//     std.unicode.breaks         grapheme clusters, words, sentences, lines
//     std.unicode.collation      the Collation Algorithm with CLDR's
//                                tailorings (collation/: elements, builder,
//                                rules)
//     std.unicode.idna           UTS #46: ToASCII and ToUnicode of names
//     std.unicode.charsets       what charset bytes are in
//     std.unicode.charmaps       the single-byte charsets (no C library)
//     std.unicode.bidi           the Bidirectional Algorithm (UAX #9)
//     std.unicode.search         string search by collation
//     std.unicode.converters     converters between charsets and UTF-16
//     std.unicode.locale         locale IDs and BCP 47 tags, likely subtags
//                                (locale/: defaults, data, resources,
//                                bundles, displaynames)
//     std.unicode.calendar       the Gregorian calendar and ICU's others
//                                (calendar/: systems, astro)
//     std.unicode.format         what the formatters share (formatted
//                                values and their fields); format.number
//                                (number/: decimal, decimalformat, ...),
//                                format.plural, format.date (date/: simple,
//                                generator, intervals, ...), format.list,
//                                format.reltime
//
// Each part has a native API for Mlx programs: text is UTF-8 in slices,
// what is made is in memory from the Allocator given (the caller's to
// free: utf.free8(allocator, text)), failures are Error. Each part also
// keeps ICU's functions under ICU's names (u_*, ucol_*, udat_*...) with
// C's types (UTF-16 text and UErrorCode by address, C strings): the
// library compiler/libc/icu exports them to C and C++ as
// libmlxunicode.so, ICU's C API. Their working memory comes from the C
// library's heap, so a program that imports a part other than utf is
// linked against the C library.
//
// The formatters' locale data is cldr.dat (made by cldr-data of CLDR's
// packages), mapped at its first use: $MLX_UNICODE_DATA, else
// ../share/mlx-unicode/cldr.dat beside the directory of libmlxunicode.so
// or of the program (mlx-out/bin/... finds mlx-out/share/...), else
// /usr/share/mlx-unicode/cldr.dat. Without it, what needs it is
// Error.MissingData.
pub const utf = @import("std.unicode.utf")

pub const UNICODE_VERSION: []const u8 = "16.0.0"
pub const CLDR_VERSION: []const u8 = "48"

pub const Error = error {
    // The allocator (or C's heap) had no memory.
    OutOfMemory,
    // An argument is not one the function takes (an unknown locale
    // keyword, a field out of range, a locale ID too long).
    InvalidArgument,
    // A pattern, skeleton, rule or tag that does not parse.
    InvalidFormat,
    // Text that is not what it should be (an invalid domain name).
    InvalidText,
    // cldr.dat is not there, or has nothing for this.
    MissingData,
    // What ICU has but std.unicode does not do yet.
    Unsupported,
    // Any other failure.
    Failed,
}

// ICU's error codes (UErrorCode) the native functions see.
pub const ILLEGAL_ARGUMENT_ERROR: i32 = 1
pub const MISSING_RESOURCE_ERROR: i32 = 2
pub const INVALID_FORMAT_ERROR: i32 = 3
pub const FILE_ACCESS_ERROR: i32 = 4
pub const MESSAGE_PARSE_ERROR: i32 = 6
pub const MEMORY_ALLOCATION_ERROR: i32 = 7
pub const PARSE_ERROR: i32 = 9
pub const INVALID_CHAR_FOUND: i32 = 10
pub const TRUNCATED_CHAR_FOUND: i32 = 11
pub const ILLEGAL_CHAR_FOUND: i32 = 12
pub const BUFFER_OVERFLOW_ERROR: i32 = 15
pub const UNSUPPORTED_ERROR: i32 = 16

// Nothing for a success or a warning (status <= 0), else the Error an
// ICU error code is.
pub fn check(status: i32) -> Error!void {
    if status <= 0 { return }
    if status == MEMORY_ALLOCATION_ERROR { return Error.OutOfMemory }
    if status == ILLEGAL_ARGUMENT_ERROR { return Error.InvalidArgument }
    if status == INVALID_FORMAT_ERROR || status == MESSAGE_PARSE_ERROR || status == PARSE_ERROR || (status >= 65536 && status < 65600) { return Error.InvalidFormat }
    if status == INVALID_CHAR_FOUND || status == TRUNCATED_CHAR_FOUND || status == ILLEGAL_CHAR_FOUND || (status >= 66560 && status < 66600) { return Error.InvalidText }
    if status == MISSING_RESOURCE_ERROR || status == FILE_ACCESS_ERROR { return Error.MissingData }
    if status == UNSUPPORTED_ERROR { return Error.Unsupported }
    return Error.Failed
}

// A locale ID (or tag, or other short name) as the C string ICU's
// functions take, in `into`; InvalidArgument when it does not fit or
// holds a NUL.
pub fn cName(name: []const u8, into: *[160]u8) -> Error!usize {
    if name.length >= 160 { return Error.InvalidArgument }
    var index: usize = 0
    while index < name.length {
        if name[index] == 0 { return Error.InvalidArgument }
        into.*[index] = name[index]
        index += 1
    }
    into.*[name.length] = 0
    return @intFromPtr(into)
}

// A UTF-16 buffer from an allocator for ICU's functions to write into:
// `fill` asks for the length they report when the first try did not
// fit (BUFFER_OVERFLOW_ERROR).
pub const Units = struct {
    allocator: utf.Allocator
    units: [*]u16
    capacity: usize
}

pub fn units(allocator: utf.Allocator, capacity: usize) -> Error!Units {
    const memory = allocator.alloc(capacity * 2 + 2, 2)
    if memory == null { return Error.OutOfMemory }
    var result = Units.{ .allocator = allocator, .units = undefined, .capacity = capacity }
    unsafe { result.units = @ptrCast([*]u16, memory.?) }
    return result
}

// Room for `capacity` units (what was there is not kept).
pub fn reserve(buffer: *Units, capacity: usize) -> Error!void {
    if capacity <= buffer.*.capacity { return }
    var old: [*]u8 = undefined
    unsafe { old = @ptrCast([*]u8, buffer.*.units) }
    buffer.*.allocator.free(old, buffer.*.capacity * 2 + 2, 2)
    const memory = buffer.*.allocator.alloc(capacity * 2 + 2, 2)
    buffer.*.capacity = 0
    if memory == null { return Error.OutOfMemory }
    unsafe { buffer.*.units = @ptrCast([*]u16, memory.?) }
    buffer.*.capacity = capacity
}

pub fn address(buffer: *const Units) -> usize { return @intFromPtr(buffer.*.units) }

pub fn capacityOf(buffer: *const Units) -> i32 { return @intCast(i32, buffer.*.capacity) }

pub fn freeUnits(buffer: *Units) -> void {
    var old: [*]u8 = undefined
    unsafe { old = @ptrCast([*]u8, buffer.*.units) }
    buffer.*.allocator.free(old, buffer.*.capacity * 2 + 2, 2)
    buffer.*.capacity = 0
}

// The first `length` units of the buffer as UTF-8 from its allocator.
pub fn utf8Of(buffer: *const Units, length: i32) -> Error![]u8 {
    const count = if length < 0 { 0 } else { @intCast(usize, length) }
    const view = buffer.*.units[0..if count > buffer.*.capacity { buffer.*.capacity } else { count }]
    return utf.toUtf8(buffer.*.allocator, view)
}

// What ICU's functions that make UTF-16 text look like here: they write
// at most `capacity` units at `dest` and give the length the whole
// result takes (BUFFER_OVERFLOW_ERROR when it did not fit). `context`
// is the function's own argument (a formatter, a locale's C string).
pub const Producer = fn(dest: usize, capacity: i32, context: usize, status: usize) -> i32

// What a Producer makes, as UTF-8 in memory from `allocator`.
pub fn produce(allocator: utf.Allocator, producer: Producer, context: usize) -> Error![]u8 {
    var out = try units(allocator, 64)
    defer freeUnits(&out)
    var status: i32 = 0
    var length = producer(address(&out), capacityOf(&out), context, @intFromPtr(&status))
    if status == BUFFER_OVERFLOW_ERROR && length > 0 {
        try reserve(&out, @intCast(usize, length))
        status = 0
        length = producer(address(&out), capacityOf(&out), context, @intFromPtr(&status))
    }
    try check(status)
    return utf8Of(&out, length)
}

// What ICU's string transforms look like here: `length` units at `src`
// into at most `capacity` units at `dest`, the length the whole result
// takes; `context` their own argument (a locale's C string...).
pub const Transform = fn(dest: usize, capacity: i32, src: usize, length: i32, context: usize, status: usize) -> i32

// `text` (UTF-8) through a Transform, as UTF-8 in memory from
// `allocator`.
pub fn transform(allocator: utf.Allocator, text: []const u8, function: Transform, context: usize) -> Error![]u8 {
    const source = try utf.toUtf16(allocator, text)
    defer utf.free16(allocator, source)
    var out = try units(allocator, source.length + 16)
    defer freeUnits(&out)
    var status: i32 = 0
    var length = function(address(&out), capacityOf(&out), @intFromPtr(source.pointer), @intCast(i32, source.length), context, @intFromPtr(&status))
    if status == BUFFER_OVERFLOW_ERROR && length > 0 {
        try reserve(&out, @intCast(usize, length))
        status = 0
        length = function(address(&out), capacityOf(&out), @intFromPtr(source.pointer), @intCast(i32, source.length), context, @intFromPtr(&status))
    }
    try check(status)
    return utf8Of(&out, length)
}

// A C string's bytes (without the NUL), "" for none.
pub fn cText(text: usize) -> []const u8 {
    if text == 0 { return "" }
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrFromInt([*]const u8, text) }
    var length: usize = 0
    while bytes[length] != 0 { length += 1 }
    return bytes[0..length]
}

// An ASCII name (a zone ID, a skeleton) as UTF-16 in `into`, its length;
// InvalidArgument when it does not fit or is not ASCII.
pub fn asciiUnits(name: []const u8, into: *[160]u16) -> Error!i32 {
    if name.length >= 160 { return Error.InvalidArgument }
    var index: usize = 0
    while index < name.length {
        if name[index] >= 128 { return Error.InvalidArgument }
        into.*[index] = @intCast(u16, name[index])
        index += 1
    }
    into.*[name.length] = 0
    return @intCast(i32, name.length)
}
