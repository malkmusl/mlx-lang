// std.vp9: VP9 frames read for a decoder (VP9 Bitstream & Decoding
// Process Specification v0.6): a chunk split into its frames (a
// superframe's index, Annex B), each frame's uncompressed header (6.2:
// profile, frame type, colour configuration, size and render size,
// references, interpolation filter, loop filter, quantizer,
// segmentation, tiles) and the reference slots (the eight frames a
// header refers to by index, their sizes, what a frame refreshes). The
// compressed header and the tiles are std.vp9.decode's (or a device's).
//
//     const v = vp9.create(allocator)
//     var sizes: [8]usize = undefined
//     const count = vp9.superframe(bytes, length, &sizes)
//     vp9.frame(v, &bytes[at], sizes[k])   (v.header: the frame's)
//     ... decode ...
//     vp9.finishFrame(v)                   (the reference slots refreshed)
const allocator_module = @import("../bootstrap/allocator.mlx")

pub const Allocator = allocator_module.Allocator

pub const Status = enum(u8) {
    ok,
    corrupt,
    unsupported,
    noMemory,
}

pub const KEY_FRAME: u32 = 0
pub const NON_KEY_FRAME: u32 = 1

// Interpolation filters (the decoder's numbering; 4: switchable).
pub const EIGHTTAP: u32 = 0
pub const EIGHTTAP_SMOOTH: u32 = 1
pub const EIGHTTAP_SHARP: u32 = 2
pub const BILINEAR: u32 = 3
pub const SWITCHABLE: u32 = 4

pub const CS_RGB: u32 = 7

pub const MAX_SEGMENTS: usize = 8
pub const SEG_LVL_ALT_Q: usize = 0
pub const SEG_LVL_ALT_L: usize = 1
pub const SEG_LVL_REF_FRAME: usize = 2
pub const SEG_LVL_SKIP: usize = 3

var LITERAL_TO_FILTER = [4]u32{ 1, 0, 2, 3 }
var SEGMENT_FEATURE_BITS = [4]u32{ 8, 6, 2, 0 }
var SEGMENT_FEATURE_SIGNED = [4]bool{ true, true, false, false }

// The persistent segmentation parameters (they carry from frame to
// frame).
pub const Segmentation = struct {
    enabled: bool
    updateMap: bool
    temporalUpdate: bool
    absoluteOrDelta: bool
    treeProbs: [7]u8
    predProbs: [3]u8
    featureEnabled: [MAX_SEGMENTS][4]bool
    featureData: [MAX_SEGMENTS][4]i32
}

// An uncompressed header (6.2) and what derives from it.
pub const Header = struct {
    profile: u32
    showExistingFrame: bool
    frameToShow: u32
    frameType: u32
    showFrame: bool
    errorResilient: bool
    intraOnly: bool
    resetFrameContext: u32
    bitDepth: u32
    colorSpace: u32
    colorRange: bool
    subsamplingX: bool
    subsamplingY: bool
    width: u32
    height: u32
    renderWidth: u32
    renderHeight: u32
    refreshFrameFlags: u32
    refFrameIdx: [3]u32
    refFrameSignBias: [4]bool
    allowHighPrecisionMv: bool
    interpolationFilter: u32
    refreshFrameContext: bool
    frameParallelDecoding: bool
    frameContextIdx: u32
    // Loop filter (the deltas persist in the Decoder).
    filterLevel: u32
    sharpness: u32
    deltaEnabled: bool
    // Quantizer.
    baseQIdx: u32
    deltaQYDc: i32
    deltaQUvDc: i32
    deltaQUvAc: i32
    lossless: bool
    tileColsLog2: u32
    tileRowsLog2: u32
    // The compressed header's size, and where it starts in the frame.
    compressedSize: u32
    compressedAt: usize
    // MiCols, MiRows (8x8 blocks), Sb64Cols, Sb64Rows.
    miCols: u32
    miRows: u32
    sb64Cols: u32
    sb64Rows: u32
    // The contexts to reset (setup_past_independence): all four, one
    // (frameContextIdx before it is set to 0), none.
    resetAll: bool
    resetOne: bool
    resetIdx: u32
    pastIndependence: bool
    // Whether the previous frame's motion vectors may be candidates (not
    // error resilient, the previous frame decoded shown and of this size).
    usePrevFrameMvs: bool
    // Compound prediction (6.3.12 setup_compound_reference_mode): allowed
    // when the references' sign biases differ; the fixed reference and the
    // two variable ones (LAST 1, GOLDEN 2, ALTREF 3).
    allowCompound: bool
    compFixedRef: u32
    compVarRef: [2]u32
}

// A reference slot: the frame last refreshed into it.
pub const Slot = struct {
    valid: bool
    width: u32
    height: u32
    subsamplingX: bool
    subsamplingY: bool
    bitDepth: u32
}

pub const SLOTS: usize = 8

pub const Decoder = struct {
    allocator: Allocator
    header: Header
    slots: [SLOTS]Slot
    loopFilterRefDeltas: [4]i32
    loopFilterModeDeltas: [2]i32
    segmentation: Segmentation
    // Whether a key frame came (frames before one are not decoded).
    started: bool
    // The last frame's size (a size change resets the contexts' use of
    // previous motion).
    lastWidth: u32
    lastHeight: u32
    lastShowFrame: bool
    lastIntraOnly: bool
    hasLast: bool
}

pub fn create(allocator: Allocator) -> ?*Decoder {
    const memory = allocator.alloc(@sizeOf(Decoder), 16)
    if memory == null { return null }
    var v: *Decoder = undefined
    unsafe { v = @ptrCast(*Decoder, memory.?) }
    var k: usize = 0
    while k < @sizeOf(Decoder) {
        memory.?[k] = 0
        k += 1
    }
    v.*.allocator = allocator
    resetDeltas(v)
    return v
}

pub fn destroy(v: *Decoder) -> void {
    unsafe { v.*.allocator.free(@ptrCast([*]u8, v), @sizeOf(Decoder), 16) }
}

fn resetDeltas(v: *Decoder) -> void {
    v.*.loopFilterRefDeltas[0] = 1
    v.*.loopFilterRefDeltas[1] = 0
    v.*.loopFilterRefDeltas[2] = -1
    v.*.loopFilterRefDeltas[3] = -1
    v.*.loopFilterModeDeltas[0] = 0
    v.*.loopFilterModeDeltas[1] = 0
}

// ---- Superframes (Annex B) ----

// The sizes of the frames a chunk (a WebM block, an IVF frame) holds:
// one, or a superframe's (its index at the end); 0 when the index is
// broken.
pub fn superframe(bytes: [*]const u8, length: usize, sizes: *[8]usize) -> usize {
    if length == 0 { return 0 }
    const marker = bytes[length - 1]
    if marker & 0xe0 == 0xc0 {
        const frames = @intCast(usize, marker & 7) + 1
        const width = @intCast(usize, (marker >> 3) & 3) + 1
        const indexSize = 2 + width * frames
        if length >= indexSize && bytes[length - indexSize] == marker {
            var at = length - indexSize + 1
            var total: usize = 0
            var k: usize = 0
            while k < frames {
                var size: usize = 0
                var b: usize = 0
                while b < width {
                    size |= @intCast(usize, bytes[at + b]) << @intCast(u6, b * 8)
                    b += 1
                }
                sizes.*[k] = size
                total += size
                at += width
                k += 1
            }
            if total > length - indexSize { return 0 }
            return frames
        }
    }
    sizes.*[0] = length
    return 1
}

// ---- The uncompressed header (6.2) ----

const Reader = struct {
    bytes: [*]const u8
    length: usize
    at: usize
    failed: bool
}

fn bit(r: *Reader) -> u32 {
    const byte = r.*.at >> 3
    if byte >= r.*.length {
        r.*.failed = true
        return 0
    }
    const value = (@intCast(u32, r.*.bytes[byte]) >> @intCast(u5, 7 - (r.*.at & 7))) & 1
    r.*.at += 1
    return value
}

fn bits(r: *Reader, count: u32) -> u32 {
    var value: u32 = 0
    var k: u32 = 0
    while k < count {
        value = (value << 1) | bit(r)
        k += 1
    }
    return value
}

fn flag(r: *Reader) -> bool { return bit(r) == 1 }

// su(n): n bits of magnitude, then the sign.
fn signedBits(r: *Reader, count: u32) -> i32 {
    const value = @intCast(i32, bits(r, count))
    return if flag(r) { -value } else { value }
}

fn deltaQ(r: *Reader) -> i32 {
    if flag(r) { return signedBits(r, 4) }
    return 0
}

fn colorConfig(r: *Reader, h: *Header) -> bool {
    h.*.bitDepth = 8
    if h.*.profile >= 2 { h.*.bitDepth = if flag(r) { 12 } else { 10 } }
    h.*.colorSpace = bits(r, 3)
    if h.*.colorSpace != CS_RGB {
        h.*.colorRange = flag(r)
        h.*.subsamplingX = true
        h.*.subsamplingY = true
        if h.*.profile == 1 || h.*.profile == 3 {
            h.*.subsamplingX = flag(r)
            h.*.subsamplingY = flag(r)
            if flag(r) { return false }
        }
    } else {
        h.*.colorRange = true
        if h.*.profile == 1 || h.*.profile == 3 {
            h.*.subsamplingX = false
            h.*.subsamplingY = false
            if flag(r) { return false }
        } else {
            return false
        }
    }
    return true
}

fn computeImageSize(h: *Header) -> void {
    h.*.miCols = (h.*.width + 7) >> 3
    h.*.miRows = (h.*.height + 7) >> 3
    h.*.sb64Cols = (h.*.miCols + 7) >> 3
    h.*.sb64Rows = (h.*.miRows + 7) >> 3
}

fn frameSize(r: *Reader, h: *Header) -> void {
    h.*.width = bits(r, 16) + 1
    h.*.height = bits(r, 16) + 1
    computeImageSize(h)
}

fn renderSize(r: *Reader, h: *Header) -> void {
    h.*.renderWidth = h.*.width
    h.*.renderHeight = h.*.height
    if flag(r) {
        h.*.renderWidth = bits(r, 16) + 1
        h.*.renderHeight = bits(r, 16) + 1
    }
}

// Reads the uncompressed header of the frame at `bytes` into v.header.
pub fn frame(v: *Decoder, bytes: [*]const u8, length: usize) -> Status {
    var reader = Reader.{ .bytes = bytes, .length = length, .at = 0, .failed = false }
    const r = &reader
    const h = &v.*.header
    if bits(r, 2) != 2 { return Status.corrupt }
    const low = bit(r)
    const high = bit(r)
    h.*.profile = (high << 1) + low
    if h.*.profile == 3 && flag(r) { return Status.unsupported }
    h.*.showExistingFrame = flag(r)
    h.*.resetAll = false
    h.*.resetOne = false
    h.*.pastIndependence = false
    if h.*.showExistingFrame {
        h.*.frameToShow = bits(r, 3)
        h.*.refreshFrameFlags = 0
        h.*.filterLevel = 0
        h.*.compressedSize = 0
        if !v.*.slots[@intCast(usize, h.*.frameToShow)].valid { return Status.corrupt }
        return if r.*.failed { Status.corrupt } else { Status.ok }
    }
    h.*.frameType = bit(r)
    h.*.showFrame = flag(r)
    h.*.errorResilient = flag(r)
    h.*.intraOnly = false
    h.*.resetFrameContext = 0
    h.*.refFrameSignBias[0] = false
    h.*.refFrameSignBias[1] = false
    h.*.refFrameSignBias[2] = false
    h.*.refFrameSignBias[3] = false
    h.*.allowHighPrecisionMv = false
    h.*.interpolationFilter = EIGHTTAP
    if h.*.frameType == KEY_FRAME {
        if bits(r, 8) != 0x49 || bits(r, 8) != 0x83 || bits(r, 8) != 0x42 { return Status.corrupt }
        if !colorConfig(r, h) { return Status.unsupported }
        frameSize(r, h)
        renderSize(r, h)
        h.*.refreshFrameFlags = 0xff
        v.*.started = true
    } else {
        if !h.*.showFrame { h.*.intraOnly = flag(r) }
        if !h.*.errorResilient { h.*.resetFrameContext = bits(r, 2) }
        if h.*.intraOnly {
            if bits(r, 8) != 0x49 || bits(r, 8) != 0x83 || bits(r, 8) != 0x42 { return Status.corrupt }
            if h.*.profile > 0 {
                if !colorConfig(r, h) { return Status.unsupported }
            } else {
                h.*.colorSpace = 2
                h.*.subsamplingX = true
                h.*.subsamplingY = true
                h.*.bitDepth = 8
            }
            h.*.refreshFrameFlags = bits(r, 8)
            frameSize(r, h)
            renderSize(r, h)
        } else {
            if !v.*.started { return Status.corrupt }
            h.*.refreshFrameFlags = bits(r, 8)
            var i: usize = 0
            while i < 3 {
                h.*.refFrameIdx[i] = bits(r, 3)
                h.*.refFrameSignBias[i + 1] = flag(r)
                i += 1
            }
            // frame_size_with_refs().
            var found = false
            i = 0
            while i < 3 {
                if flag(r) {
                    const slot = &v.*.slots[@intCast(usize, h.*.refFrameIdx[i])]
                    h.*.width = slot.*.width
                    h.*.height = slot.*.height
                    found = true
                    break
                }
                i += 1
            }
            if !found {
                frameSize(r, h)
            } else {
                computeImageSize(h)
            }
            renderSize(r, h)
            h.*.allowHighPrecisionMv = flag(r)
            if flag(r) {
                h.*.interpolationFilter = SWITCHABLE
            } else {
                h.*.interpolationFilter = LITERAL_TO_FILTER[@intCast(usize, bits(r, 2))]
            }
            // The references keep their colour configuration.
            const first = &v.*.slots[@intCast(usize, h.*.refFrameIdx[0])]
            if !first.*.valid { return Status.corrupt }
            h.*.bitDepth = first.*.bitDepth
            h.*.subsamplingX = first.*.subsamplingX
            h.*.subsamplingY = first.*.subsamplingY
            // (A reference whose size the frame cannot scale from, more than
            // twice larger or 16 times smaller, is refused where a block
            // uses it, as libvpx does.)
            i = 0
            while i < 3 {
                if !v.*.slots[@intCast(usize, h.*.refFrameIdx[i])].valid { return Status.corrupt }
                i += 1
            }
        }
    }
    if !h.*.errorResilient {
        h.*.refreshFrameContext = flag(r)
        h.*.frameParallelDecoding = flag(r)
    } else {
        h.*.refreshFrameContext = false
        h.*.frameParallelDecoding = true
    }
    h.*.frameContextIdx = bits(r, 2)
    h.*.resetIdx = h.*.frameContextIdx
    const intra = h.*.frameType == KEY_FRAME || h.*.intraOnly
    h.*.usePrevFrameMvs = !h.*.errorResilient && v.*.hasLast && v.*.lastShowFrame && v.*.lastWidth == h.*.width && v.*.lastHeight == h.*.height
    h.*.allowCompound = false
    if !intra {
        const b = &h.*.refFrameSignBias
        h.*.allowCompound = b.*[1] != b.*[2] || b.*[1] != b.*[3]
        if b.*[1] == b.*[2] {
            h.*.compFixedRef = 3
            h.*.compVarRef[0] = 1
            h.*.compVarRef[1] = 2
        } else if b.*[1] == b.*[3] {
            h.*.compFixedRef = 2
            h.*.compVarRef[0] = 1
            h.*.compVarRef[1] = 3
        } else {
            h.*.compFixedRef = 1
            h.*.compVarRef[0] = 2
            h.*.compVarRef[1] = 3
        }
    }
    if intra || h.*.errorResilient {
        h.*.pastIndependence = true
        h.*.frameContextIdx = 0
        if h.*.frameType == KEY_FRAME || h.*.errorResilient || h.*.resetFrameContext == 3 {
            h.*.resetAll = true
        } else if h.*.resetFrameContext == 2 {
            h.*.resetOne = true
        }
        // (resetOne resets the context at frameContextIdx as read; then
        // the frame uses context 0.)
        resetDeltas(v)
        clearSegmentation(v)
    }
    // loop_filter_params().
    h.*.filterLevel = bits(r, 6)
    h.*.sharpness = bits(r, 3)
    h.*.deltaEnabled = flag(r)
    if h.*.deltaEnabled && flag(r) {
        var i: usize = 0
        while i < 4 {
            if flag(r) { v.*.loopFilterRefDeltas[i] = signedBits(r, 6) }
            i += 1
        }
        i = 0
        while i < 2 {
            if flag(r) { v.*.loopFilterModeDeltas[i] = signedBits(r, 6) }
            i += 1
        }
    }
    // quantization_params().
    h.*.baseQIdx = bits(r, 8)
    h.*.deltaQYDc = deltaQ(r)
    h.*.deltaQUvDc = deltaQ(r)
    h.*.deltaQUvAc = deltaQ(r)
    h.*.lossless = h.*.baseQIdx == 0 && h.*.deltaQYDc == 0 && h.*.deltaQUvDc == 0 && h.*.deltaQUvAc == 0
    // segmentation_params().
    const seg = &v.*.segmentation
    seg.*.enabled = flag(r)
    seg.*.updateMap = false
    seg.*.temporalUpdate = false
    if seg.*.enabled {
        seg.*.updateMap = flag(r)
        if seg.*.updateMap {
            var i: usize = 0
            while i < 7 {
                seg.*.treeProbs[i] = if flag(r) { @intCast(u8, bits(r, 8)) } else { 255 }
                i += 1
            }
            seg.*.temporalUpdate = flag(r)
            i = 0
            while i < 3 {
                seg.*.predProbs[i] = 255
                if seg.*.temporalUpdate && flag(r) { seg.*.predProbs[i] = @intCast(u8, bits(r, 8)) }
                i += 1
            }
        }
        if flag(r) {
            seg.*.absoluteOrDelta = flag(r)
            var i: usize = 0
            while i < MAX_SEGMENTS {
                var j: usize = 0
                while j < 4 {
                    var value: i32 = 0
                    const enabled = flag(r)
                    seg.*.featureEnabled[i][j] = enabled
                    if enabled {
                        value = @intCast(i32, bits(r, SEGMENT_FEATURE_BITS[j]))
                        if SEGMENT_FEATURE_SIGNED[j] && flag(r) { value = -value }
                    }
                    seg.*.featureData[i][j] = value
                    j += 1
                }
                i += 1
            }
        }
    }
    // tile_info().
    var minLog2: u32 = 0
    while (@intCast(u32, 64) << @intCast(u5, minLog2)) < h.*.sb64Cols { minLog2 += 1 }
    var maxLog2: u32 = 1
    while (h.*.sb64Cols >> @intCast(u5, maxLog2)) >= 4 { maxLog2 += 1 }
    maxLog2 -= 1
    h.*.tileColsLog2 = minLog2
    while h.*.tileColsLog2 < maxLog2 {
        if !flag(r) { break }
        h.*.tileColsLog2 += 1
    }
    h.*.tileRowsLog2 = bit(r)
    if h.*.tileRowsLog2 == 1 { h.*.tileRowsLog2 += bit(r) }
    h.*.compressedSize = bits(r, 16)
    if r.*.failed || h.*.compressedSize == 0 { return Status.corrupt }
    // trailing_bits(): to the byte.
    h.*.compressedAt = (r.*.at + 7) >> 3
    if h.*.compressedAt + @intCast(usize, h.*.compressedSize) > length { return Status.corrupt }
    return Status.ok
}

fn clearSegmentation(v: *Decoder) -> void {
    const seg = &v.*.segmentation
    var i: usize = 0
    while i < MAX_SEGMENTS {
        var j: usize = 0
        while j < 4 {
            seg.*.featureEnabled[i][j] = false
            seg.*.featureData[i][j] = 0
            j += 1
        }
        i += 1
    }
    seg.*.absoluteOrDelta = false
}

// After the frame was decoded: the slots it refreshes take its size and
// colour configuration (refresh_process, 8.10).
pub fn finishFrame(v: *Decoder) -> void {
    const h = &v.*.header
    if h.*.showExistingFrame { return }
    var i: usize = 0
    while i < SLOTS {
        if h.*.refreshFrameFlags & (@intCast(u32, 1) << @intCast(u5, i)) != 0 {
            const slot = &v.*.slots[i]
            slot.*.valid = true
            slot.*.width = h.*.width
            slot.*.height = h.*.height
            slot.*.subsamplingX = h.*.subsamplingX
            slot.*.subsamplingY = h.*.subsamplingY
            slot.*.bitDepth = h.*.bitDepth
        }
        i += 1
    }
    v.*.lastWidth = h.*.width
    v.*.lastHeight = h.*.height
    v.*.lastShowFrame = h.*.showFrame
    v.*.lastIntraOnly = h.*.intraOnly
    v.*.hasLast = true
}
