// std.fontconfig: finding fonts, without a C library, as Fontconfig 2.15
// finds them: the fonts of the font directories (/usr/share/fonts,
// ~/.local/share/fonts, those fonts.conf names) read by std.truetype into
// patterns of their properties (families and styles in every language
// their names have, weight, width, slant, spacing, the characters they
// have, the languages those cover...); fonts.conf and its conf.d rules
// (aliases, <match> tests and edits on patterns and fonts, fonts
// rejected); and the matching that picks the font nearest to a pattern
// (FcFontMatch), sorts the fonts by how near they come (FcFontSort) or
// lists those that have what a pattern asks for (FcFontList), with
// Fontconfig's priorities, defaults and results.
//
//     const fc = @import("std.fontconfig")
//
//     const config = fc.load.current()                    the fonts, the rules
//     const p = fc.pattern.parseName(name)                "sans-serif:bold"
//     _ = fc.config.substitute(config, p, fc.config.MATCH_PATTERN)
//     fc.config.defaultSubstitute(p)
//     var result: i64 = 0
//     const font = fc.matching.fontMatch(config, p, &result)
//     const file = fc.pattern.firstString(font, fc.objects.FILE)
//
// The parts (std/src/fontconfig/): mem (memory, buffers, numbers, locks),
// strings (Fontconfig's comparisons, its case folding), env (the
// environment it reads), charset, lang and data (languages and their
// orthographies, case folding), objects (names, types, constants,
// weights), value (values and their lists), pattern (patterns, font sets,
// object sets, names), config (the configuration: rules, directories,
// substitution, defaults), confparse (fonts.conf), paths (files and
// directories), scan (font files read into patterns), load
// (configurations loaded, their fonts read and cached, the current
// configuration), matching (matching, sorting, listing). compiler/libc/
// fontconfig makes Fontconfig's C API of it.
pub const mem = @import("./fontconfig/mem.mlx")
pub const strings = @import("./fontconfig/strings.mlx")
pub const env = @import("./fontconfig/env.mlx")
pub const strset = @import("./fontconfig/strset.mlx")
pub const charset = @import("./fontconfig/charset.mlx")
pub const lang = @import("./fontconfig/lang.mlx")
pub const objects = @import("./fontconfig/objects.mlx")
pub const value = @import("./fontconfig/value.mlx")
pub const pattern = @import("./fontconfig/pattern.mlx")
pub const paths = @import("./fontconfig/paths.mlx")
pub const config = @import("./fontconfig/config.mlx")
pub const confparse = @import("./fontconfig/confparse.mlx")
pub const scan = @import("./fontconfig/scan.mlx")
pub const matching = @import("./fontconfig/matching.mlx")
pub const load = @import("./fontconfig/load.mlx")
