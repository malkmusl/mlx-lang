// std.http.psl: the Public Suffix List (publicsuffix.org) and what libpsl
// answers from it for libsoup: whether a domain is a public suffix, and a
// host's registrable domain (its public suffix and one more label). The
// rules are std.http.psldata's (made by std/registry/publicsuffix/
// generate.mlx), searched as they are kept: sorted lines.
//
// A rule "a.b" makes a.b a public suffix; "*.b" makes every x.b one (and
// b); "!a.b" makes a.b not one, where a wildcard would. With the implicit
// "*" rule a single label (a top-level domain) is always one. As in
// libpsl, a name is compared as it is given (the list's names are lower
// case, its labels beyond ASCII in UTF-8).
const data = @import("./psldata.mlx")

// The comparison of the rule at `line` with `prefix` and `name` put
// together: <0, 0 or >0. (As libpsl does, names are compared as given: the
// rules are lower case.)
fn compareRule(line: []const u8, prefix: []const u8, name: []const u8) -> i32 {
    const length = prefix.length + name.length
    var index: usize = 0
    while index < line.length && index < length {
        const want = if index < prefix.length { prefix[index] } else { name[index - prefix.length] }
        if line[index] != want { return if line[index] < want { -1 } else { 1 } }
        index += 1
    }
    if line.length == length { return 0 }
    return if line.length < length { -1 } else { 1 }
}

// The line around byte `at` of the rules.
fn lineAt(rules: []const u8, at: usize, start: *usize) -> []const u8 {
    var begin = at
    while begin > 0 && rules[begin - 1] != 10 { begin -= 1 }
    var end = at
    while end < rules.length && rules[end] != 10 { end += 1 }
    start.* = begin
    return rules[begin..end]
}

// Whether the rule `prefix` + `name` is in the list.
pub fn hasRule(prefix: []const u8, name: []const u8) -> bool {
    const rules = data.RULES
    var low: usize = 0
    var high = rules.length
    while low < high {
        const middle = low + (high - low) / 2
        var start: usize = 0
        const line = lineAt(rules, middle, &start)
        const order = compareRule(line, prefix, name)
        if order == 0 { return true }
        if order < 0 {
            low = start + line.length + 1
        } else {
            high = start
        }
    }
    return false
}

fn labelCount(name: []const u8) -> usize {
    var count: usize = 1
    for c in name {
        if c == 46 { count += 1 }
    }
    return count
}

fn firstDot(name: []const u8) -> usize {
    var index: usize = 0
    while index < name.length {
        if name[index] == 46 { return index }
        index += 1
    }
    return name.length
}

// Whether `domain` is a public suffix (libpsl's psl_is_public_suffix2):
// `noStar` without the implicit "*" rule.
pub fn isPublicSuffix(domainIn: []const u8, noStar: bool) -> bool {
    var domain = domainIn
    if domain.length > 0 && domain[0] == 46 { domain = domain[1..domain.length] }
    if domain.length == 0 { return false }
    if labelCount(domain) == 1 && !noStar { return true }
    if hasRule("!", domain) { return false }
    if hasRule("", domain) || hasRule("*.", domain) { return true }
    const dot = firstDot(domain)
    if dot < domain.length {
        const parent = domain[dot + 1..domain.length]
        if hasRule("*.", parent) { return true }
    }
    return false
}

// Where the longest public suffix of `domain` starts (libpsl's
// psl_unregistrable_domain), checked from the left so that a listed name
// under a name that is not listed is found.
pub fn suffixStart(domain: []const u8) -> usize {
    var at: usize = 0
    while !isPublicSuffix(domain[at..domain.length], false) {
        const dot = firstDot(domain[at..domain.length])
        if at + dot >= domain.length { break }
        at = at + dot + 1
    }
    return at
}

// Where the registrable domain of `domain` starts (libpsl's
// psl_registrable_domain), or domain.length when the domain is itself a
// public suffix.
pub fn registrableStart(domain: []const u8) -> usize {
    var registrable = domain.length
    var at: usize = 0
    while !isPublicSuffix(domain[at..domain.length], false) {
        const dot = firstDot(domain[at..domain.length])
        if at + dot >= domain.length { break }
        registrable = at
        at = at + dot + 1
    }
    return registrable
}
