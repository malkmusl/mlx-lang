// std.http.sniff: the MIME Sniffing Standard's rules for a response's
// type, as libsoup's SoupContentSniffer applies them to the first 512
// bytes of a body: the type the server gave is kept, refined (images,
// audio and video by their signatures, HTML told from RSS and Atom,
// text/plain checked for binary data), or found from the bytes when it is
// missing or unknown.
const headers = @import("./headers.mlx")

pub const BUFFER_SIZE: usize = 512

fn masked(resource: []const u8, mask: []const u8, pattern: []const u8) -> bool {
    if resource.length < pattern.length { return false }
    var index: usize = 0
    while index < pattern.length {
        if (mask[index] & resource[index]) != pattern[index] { return false }
        index += 1
    }
    return true
}

fn hasPrefix(resource: []const u8, at: usize, prefix: []const u8) -> bool {
    if at > resource.length || resource.length - at < prefix.length { return false }
    var index: usize = 0
    while index < prefix.length {
        if resource[at + index] != prefix[index] { return false }
        index += 1
    }
    return true
}

pub fn sniffImages(resource: []const u8) -> []const u8 {
    if masked(resource, "\xFF\xFF\xFF\xFF", "\x00\x00\x01\x00") { return "image/x-icon" }
    if masked(resource, "\xFF\xFF\xFF\xFF", "\x00\x00\x02\x00") { return "image/x-icon" }
    if masked(resource, "\xFF\xFF", "BM") { return "image/bmp" }
    if masked(resource, "\xFF\xFF\xFF\xFF\xFF\xFF", "GIF87a") { return "image/gif" }
    if masked(resource, "\xFF\xFF\xFF\xFF\xFF\xFF", "GIF89a") { return "image/gif" }
    if masked(resource, "\xFF\xFF\xFF\xFF\x00\x00\x00\x00\xFF\xFF\xFF\xFF\xFF\xFF", "RIFF\x00\x00\x00\x00WEBPVP") { return "image/webp" }
    if masked(resource, "\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF", "\x89PNG\x0D\x0A\x1A\x0A") { return "image/png" }
    if masked(resource, "\xFF\xFF\xFF", "\xFF\xD8\xFF") { return "image/jpeg" }
    return ""
}

fn sniffMp4(resource: []const u8) -> bool {
    if resource.length < 4 { return false }
    const boxSize = (@intCast(usize, resource[0]) << 24) | (@intCast(usize, resource[1]) << 16) | (@intCast(usize, resource[2]) << 8) | @intCast(usize, resource[3])
    if resource.length < 12 || resource.length < boxSize || boxSize % 4 != 0 { return false }
    if !hasPrefix(resource, 4, "ftyp") { return false }
    if !hasPrefix(resource, 8, "mp4") { return false }
    var at: usize = 16
    while at < boxSize && at < resource.length {
        if hasPrefix(resource, at, "mp4") { return true }
        at += 4
    }
    return false
}

pub fn sniffAudioVideo(resource: []const u8) -> []const u8 {
    if masked(resource, "\xFF\xFF\xFF\xFF", "\x1A\x45\xDF\xA3") { return "video/webm" }
    if masked(resource, "\xFF\xFF\xFF\xFF", ".snd") { return "audio/basic" }
    if masked(resource, "\xFF\xFF\xFF\xFF\x00\x00\x00\x00\xFF\xFF\xFF\xFF", "FORM\x00\x00\x00\x00AIFF") { return "audio/aiff" }
    if masked(resource, "\xFF\xFF\xFF", "ID3") { return "audio/mpeg" }
    if masked(resource, "\xFF\xFF\xFF\xFF\xFF", "OggS\x00") { return "application/ogg" }
    if masked(resource, "\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF", "MThd\x00\x00\x00\x06") { return "audio/midi" }
    if masked(resource, "\xFF\xFF\xFF\xFF\x00\x00\x00\x00\xFF\xFF\xFF\xFF", "RIFF\x00\x00\x00\x00AVI ") { return "video/avi" }
    if masked(resource, "\xFF\xFF\xFF\xFF\x00\x00\x00\x00\xFF\xFF\xFF\xFF", "RIFF\x00\x00\x00\x00WAVE") { return "audio/wave" }
    if sniffMp4(resource) { return "video/mp4" }
    return ""
}

// A pattern of the unknown-type table that may start after white space
// (its first byte, a space, stands for it) and, `tag`, must end a tag.
fn spaced(resource: []const u8, mask: []const u8, pattern: []const u8, tag: bool) -> bool {
    // libsoup's pattern_length: the bytes after the leading space.
    const patternLength = pattern.length - 1
    var stream: usize = 0
    var at: usize = 0
    while stream < resource.length - 1 && at <= patternLength {
        if pattern[at] == 32 {
            const ch = resource[stream]
            if ch == 9 || ch == 10 || ch == 12 || ch == 13 || ch == 32 {
                stream += 1
            } else {
                at += 1
            }
        } else {
            if (mask[at] & resource[stream]) != pattern[at] { return false }
            at += 1
            stream += 1
        }
    }
    if at <= patternLength { return false }
    if tag && resource[stream] != 32 && resource[stream] != 62 { return false }
    return true
}

fn looksBinary(ch: u8) -> bool {
    if ch >= 32 { return false }
    return ch != 9 && ch != 10 && ch != 12 && ch != 13 && ch != 27
}

// MIMESNIFF 7.1: a resource of unknown type.
pub fn sniffUnknown(resource: []const u8, scriptable: bool) -> []const u8 {
    if resource.length == 0 { return "text/plain" }
    if scriptable {
        if spaced(resource, "\x00\xFF\xFF\xDF\xDF\xDF\xDF\xDF\xDF\xDF\xFF\xDF\xDF\xDF\xDF", " <!DOCTYPE HTML", true) { return "text/html" }
        if spaced(resource, "\x00\xFF\xDF\xDF\xDF\xDF", " <HTML", true) { return "text/html" }
        if spaced(resource, "\x00\xFF\xDF\xDF\xDF\xDF", " <HEAD", true) { return "text/html" }
        if spaced(resource, "\x00\xFF\xDF\xDF\xDF\xDF\xDF\xDF", " <SCRIPT", true) { return "text/html" }
        if spaced(resource, "\x00\xFF\xDF\xDF\xDF\xDF\xDF\xDF", " <IFRAME", true) { return "text/html" }
        if spaced(resource, "\x00\xFF\xDF\xFF", " <H1", true) { return "text/html" }
        if spaced(resource, "\x00\xFF\xDF\xDF\xDF", " <DIV", true) { return "text/html" }
        if spaced(resource, "\x00\xFF\xDF\xDF\xDF\xDF", " <FONT", true) { return "text/html" }
        if spaced(resource, "\x00\xFF\xDF\xDF\xDF\xDF\xDF", " <TABLE", true) { return "text/html" }
        if spaced(resource, "\x00\xFF\xDF", " <A", true) { return "text/html" }
        if spaced(resource, "\x00\xFF\xDF\xDF\xDF\xDF\xDF", " <STYLE", true) { return "text/html" }
        if spaced(resource, "\x00\xFF\xDF\xDF\xDF\xDF\xDF", " <TITLE", true) { return "text/html" }
        if spaced(resource, "\x00\xFF\xDF", " <B", true) { return "text/html" }
        if spaced(resource, "\x00\xFF\xDF\xDF\xDF\xDF", " <BODY", true) { return "text/html" }
        if spaced(resource, "\x00\xFF\xDF\xDF", " <BR", true) { return "text/html" }
        if spaced(resource, "\x00\xFF\xDF", " <P", true) { return "text/html" }
        if spaced(resource, "\x00\xFF\xFF\xFF\xFF", " <!--", true) { return "text/html" }
        if spaced(resource, "\x00\xFF\xFF\xFF\xFF\xFF", " <?xml", false) { return "text/xml" }
        if masked(resource, "\xFF\xFF\xFF\xFF\xFF", "%PDF-") { return "application/pdf" }
    }
    if masked(resource, "\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF", "%!PS-Adobe-") { return "application/postscript" }
    if masked(resource, "\xFF\xFF\x00\x00", "\xFE\xFF\x00\x00") { return "text/plain" }
    if masked(resource, "\xFF\xFF\x00\x00", "\xFF\xFE\x00\x00") { return "text/plain" }
    if masked(resource, "\xFF\xFF\xFF\x00", "\xEF\xBB\xBF\x00") { return "text/plain" }
    const image = sniffImages(resource)
    if image.length > 0 { return image }
    const media = sniffAudioVideo(resource)
    if media.length > 0 { return media }
    for ch in resource {
        if looksBinary(ch) { return "application/octet-stream" }
    }
    return "text/plain"
}

// MIMESNIFF 7.2: text/plain that may be binary.
pub fn sniffTextOrBinary(resource: []const u8) -> []const u8 {
    if resource.length >= 2 && ((resource[0] == 0xFE && resource[1] == 0xFF) || (resource[0] == 0xFF && resource[1] == 0xFE)) { return "text/plain" }
    if resource.length >= 3 && resource[0] == 0xEF && resource[1] == 0xBB && resource[2] == 0xBF { return "text/plain" }
    var binary = false
    for ch in resource {
        if looksBinary(ch) { binary = true }
    }
    if !binary { return "text/plain" }
    return sniffUnknown(resource, true)
}

// Skips the white space at `pos`: true when the resource ends.
fn skipSpace(resource: []const u8, pos: *usize) -> bool {
    if pos.* >= resource.length { return true }
    while resource[pos.*] == 9 || resource[pos.*] == 32 || resource[pos.*] == 10 || resource[pos.*] == 13 {
        pos.* += 1
        if pos.* >= resource.length { return true }
    }
    return false
}

// MIMESNIFF 7.3: text/html that may be RSS or Atom.
pub fn sniffFeedOrHtml(resource: []const u8) -> []const u8 {
    if resource.length < 3 { return "text/html" }
    var pos: usize = 0
    if resource[0] == 0xEF && resource[1] == 0xBB && resource[2] == 0xBF { pos = 3 }
    while true {
        if skipSpace(resource, &pos) { return "text/html" }
        if resource[pos] != 60 { return "text/html" }
        pos += 1
        if pos + 2 > resource.length { return "text/html" }
        if hasPrefix(resource, pos, "!--") {
            pos += 3
            if pos + 2 > resource.length { return "text/html" }
            while !hasPrefix(resource, pos, "-->") {
                pos += 1
                if pos + 2 > resource.length { return "text/html" }
            }
            pos += 3
            continue
        }
        if resource[pos] == 33 {
            while true {
                pos += 1
                if pos + 1 > resource.length { return "text/html" }
                if resource[pos] == 62 { break }
            }
            pos += 1
            continue
        }
        if resource[pos] == 63 {
            while true {
                pos += 1
                if pos + 1 > resource.length { return "text/html" }
                if hasPrefix(resource, pos, "?>") { break }
            }
            pos += 2
            continue
        }
        break
    }
    if pos + 3 > resource.length { return "text/html" }
    if hasPrefix(resource, pos, "rss") { return "application/rss+xml" }
    if pos + 4 > resource.length { return "text/html" }
    if hasPrefix(resource, pos, "feed") { return "application/atom+xml" }
    if pos + 7 > resource.length { return "text/html" }
    if hasPrefix(resource, pos, "rdf:RDF") {
        pos += 7
        if skipSpace(resource, &pos) { return "text/html" }
        if pos + 32 > resource.length { return "text/html" }
        if hasPrefix(resource, pos, "xmlns=\"http://purl.org/rss/1.0/\"") {
            pos += 32
            if skipSpace(resource, &pos) { return "text/html" }
            if pos + 55 > resource.length { return "text/html" }
            if hasPrefix(resource, pos, "xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\"") { return "application/rss+xml" }
        }
        if pos + 55 > resource.length { return "text/html" }
        if hasPrefix(resource, pos, "xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\"") {
            pos += 55
            if skipSpace(resource, &pos) { return "text/html" }
            if pos + 32 > resource.length { return "text/html" }
            if hasPrefix(resource, pos, "xmlns=\"http://purl.org/rss/1.0/\"") { return "application/rss+xml" }
        }
    }
    return "text/html"
}

fn startsIgnoringCase(text: []const u8, prefix: []const u8) -> bool {
    if text.length < prefix.length { return false }
    return headers.equalsIgnoringCase(text[0..prefix.length], prefix)
}

fn sameText(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

// The sniffed type of a resource whose first bytes are `data` (only 512
// are looked at), given the Content-Type's type (`hasType` false when
// there is none) and whether "X-Content-Type-Options: nosniff" was sent;
// the slice returned is `contentType` itself when that type stands.
pub fn sniff(contentType: []const u8, hasType: bool, noSniff: bool, data: []const u8) -> []const u8 {
    const resource = if data.length > BUFFER_SIZE { data[0..BUFFER_SIZE] } else { data }
    if !hasType || headers.equalsIgnoringCase(contentType, "unknown/unknown") || headers.equalsIgnoringCase(contentType, "application/unknown") || headers.equalsIgnoringCase(contentType, "*/*") {
        return sniffUnknown(resource, !noSniff)
    }
    if noSniff { return contentType }
    if sameText(contentType, "text/plain") || sameText(contentType, "text/plain; charset=ISO-8859-1") || sameText(contentType, "text/plain; charset=iso-8859-1") || sameText(contentType, "text/plain; charset=UTF-8") {
        return sniffTextOrBinary(resource)
    }
    if (contentType.length >= 4 && sameText(contentType[contentType.length - 4..contentType.length], "+xml")) || headers.equalsIgnoringCase(contentType, "text/xml") || headers.equalsIgnoringCase(contentType, "application/xml") {
        return contentType
    }
    if headers.equalsIgnoringCase(contentType, "text/html") { return sniffFeedOrHtml(resource) }
    if startsIgnoringCase(contentType, "image/") {
        const image = sniffImages(resource)
        if image.length > 0 { return image }
        return contentType
    }
    if startsIgnoringCase(contentType, "audio/") || startsIgnoringCase(contentType, "video/") || headers.equalsIgnoringCase(contentType, "application/ogg") {
        const media = sniffAudioVideo(resource)
        if media.length > 0 { return media }
        return contentType
    }
    return contentType
}
