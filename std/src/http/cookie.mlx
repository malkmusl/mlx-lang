// std.http.cookie: cookies (RFC 6265) as libsoup reads and matches them.
// A Set-Cookie value is NAME=VALUE (a NAME may be missing: the whole is
// the value then) and attributes after `;`, each `name` or `name=value`;
// they are read in order, as later ones override earlier ones (an
// Expires after a Max-Age wins, and the other way round). A cookie's
// domain matches a host that is it, or ends with it when it starts with a
// dot; its path matches a request's path that starts with it at a `/`.
const headers = @import("./headers.mlx")

fn isWhite(c: u8) -> bool { return c == 32 || c == 9 }

fn skipWhite(text: []const u8, at: usize) -> usize {
    var i = at
    while i < text.length && isWhite(text[i]) { i += 1 }
    return i
}

fn unskipWhite(text: []const u8, at: usize, start: usize) -> usize {
    var i = at
    while i > start && isWhite(text[i - 1]) { i -= 1 }
    return i
}

fn endsAttribute(c: u8) -> bool { return c == 59 || c == 44 || c == 61 }

// A value from `at` (past its `=`, if there is one) to the next `;`, its
// spaces around taken off; `at` is left at the `;` (or the end).
pub fn value(text: []const u8, at: *usize) -> []const u8 {
    var p = at.*
    if p < text.length && text[p] == 61 { p += 1 }
    const start = skipWhite(text, p)
    p = start
    while p < text.length && text[p] != 59 { p += 1 }
    const end = unskipWhite(text, p, start)
    at.* = p
    return text[start..end]
}

// The NAME and VALUE that start a Set-Cookie value; `at` is left where the
// attributes start. A value with no `=` before its first `;` or `,` has no
// name: the NAME is empty and all of it is the VALUE.
pub fn nameAndValue(text: []const u8, name: *[]const u8, cookieValue: *[]const u8) -> usize {
    const start = skipWhite(text, 0)
    var p = start
    while p < text.length && !endsAttribute(text[p]) { p += 1 }
    if p < text.length && text[p] == 61 {
        name.* = text[start..unskipWhite(text, p, start)]
    } else {
        name.* = text[0..0]
        p = start
    }
    cookieValue.* = value(text, &p)
    return p
}

pub const Attribute = struct {
    name: []const u8
    value: []const u8
    hasValue: bool
}

// The attribute after `at` (at a `;`), false when there is none; `at` is
// left at the `;` after it.
pub fn nextAttribute(text: []const u8, at: *usize, attribute: *Attribute) -> bool {
    if at.* >= text.length || text[at.*] != 59 { return false }
    const start = skipWhite(text, at.* + 1)
    var p = start
    while p < text.length && !endsAttribute(text[p]) { p += 1 }
    const end = unskipWhite(text, p, start)
    const hasValue = p < text.length && text[p] == 61
    attribute.*.name = text[start..end]
    attribute.*.hasValue = hasValue
    // (An attribute without a value ends where its name does: at a `;`,
    // or at a `,`, which ends the attributes, as in libsoup.)
    attribute.*.value = text[0..0]
    if hasValue { attribute.*.value = value(text, &p) }
    at.* = p
    return true
}

// libsoup's soup_host_matches_host: the same host (case aside), or a
// domain starting with a dot that the host is (without the dot) or ends
// with (case kept).
pub fn hostMatches(domain: []const u8, host: []const u8) -> bool {
    if headers.equalsIgnoringCase(domain, host) { return true }
    if domain.length == 0 || domain[0] != 46 { return false }
    if headers.equalsIgnoringCase(domain[1..domain.length], host) { return true }
    if host.length < domain.length { return false }
    const tail = host[host.length - domain.length..host.length]
    var index: usize = 0
    while index < domain.length {
        if tail[index] != domain[index] { return false }
        index += 1
    }
    return true
}

// Whether a cookie of `path` goes with a request for `requestPath`: an
// empty path goes with all; else the request's path starts with it, and
// either the cookie's path ends with `/` or the request's continues with
// one (or ends there).
pub fn pathMatches(path: []const u8, requestPath: []const u8) -> bool {
    if path.length == 0 { return true }
    if requestPath.length < path.length {
        // (libsoup's strncmp stops at the shorter one's end: a request path
        // shorter than the cookie's never matches.)
        return false
    }
    var index: usize = 0
    while index < path.length {
        if path[index] != requestPath[index] { return false }
        index += 1
    }
    if path[path.length - 1] != 47 && requestPath.length > path.length && requestPath[path.length] != 47 { return false }
    return true
}

// The default path of a cookie from a request's path: up to its last `/`
// (not counting a first one), else "/".
pub fn defaultPath(requestPath: []const u8) -> []const u8 {
    var slash = requestPath.length
    var i = requestPath.length
    while i > 0 {
        i -= 1
        if requestPath[i] == 47 {
            slash = i
            break
        }
    }
    if slash == requestPath.length || slash == 0 { return "/" }
    return requestPath[0..slash]
}
