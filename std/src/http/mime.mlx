// std.http.mime: the media type of a local file, for a file:// URL or a
// file a program serves: guessed from the name's extension (the web's
// common types, the answers GIO gives from the shared-mime-info database,
// with whether it calls them uncertain, the case of the name ignored),
// else from the first bytes of the data (images, fonts, PDF, HTML, SVG
// and XML by their signatures, else text when the bytes are UTF-8
// without control characters), else "application/octet-stream". A name
// that gives a type with data alongside makes it certain, the data
// confirming it as far as GIO's database is concerned. std.http.sniff is
// the other direction: the MIME Sniffing Standard's refinement of the
// type a server gave for a body.
const utf = @import("std.unicode.utf")

pub const UNKNOWN = "application/octet-stream"
pub const EMPTY = "application/x-zerosize"

// Extension, type, uncertain (1) or not (0); compound extensions first,
// so that "tar.gz" is found before "gz".
const EXTENSIONS = "tar.gz application/x-compressed-tar 0 html text/html 1 htm text/html 1 xhtml application/xhtml+xml 0 css text/css 0 js text/javascript 0 mjs text/javascript 0 json application/json 1 png image/png 1 jpg image/jpeg 0 jpeg image/jpeg 0 gif image/gif 0 svg image/svg+xml 0 webp image/webp 0 avif image/avif 0 bmp image/bmp 0 ico image/vnd.microsoft.icon 0 tif image/tiff 0 tiff image/tiff 0 jxl image/jxl 0 heic image/heif 0 txt text/plain 0 csv text/csv 0 md text/markdown 0 vtt text/vtt 0 srt application/x-subrip 0 m3u8 audio/x-mpegurl 1 xml application/xml 0 pdf application/pdf 0 wasm application/wasm 0 zip application/zip 0 gz application/gzip 0 mp4 video/mp4 0 webm video/webm 0 ogv video/ogg 0 ogg audio/ogg 1 oga audio/ogg 1 opus audio/ogg 1 mp3 audio/mpeg 0 wav audio/vnd.wave 0 flac audio/flac 0 m4a audio/mp4 0 aac audio/aac 0 woff font/woff 0 woff2 font/woff2 0 ttf font/ttf 0 otf font/otf 1 c text/x-csrc 0"

fn word(at: *usize) -> []const u8 {
    const start = at.*
    var end = start
    while end < EXTENSIONS.length && EXTENSIONS[end] != 32 { end += 1 }
    at.* = end + 1
    return EXTENSIONS[start..end]
}

// The table's entries in turn: `at` starts at 0; false once they are
// exhausted.
pub fn nextEntry(at: *usize, extension: *[]const u8, mime: *[]const u8, uncertain: *bool) -> bool {
    if at.* >= EXTENSIONS.length { return false }
    extension.* = word(at)
    mime.* = word(at)
    const flag = word(at)
    uncertain.* = flag.length > 0 && flag[0] == '1'
    return true
}

// The part of a path after its last '/'.
pub fn baseName(path: []const u8) -> []const u8 {
    var start: usize = 0
    var index: usize = 0
    while index < path.length {
        if path[index] == '/' { start = index + 1 }
        index += 1
    }
    return path[start..path.length]
}

// Whether `name` ends in ".extension", the case of the name ignored.
pub fn hasExtension(name: []const u8, extension: []const u8) -> bool {
    if name.length < extension.length + 1 { return false }
    if name[name.length - extension.length - 1] != '.' { return false }
    var index: usize = 0
    while index < extension.length {
        var byte = name[name.length - extension.length + index]
        if byte >= 'A' && byte <= 'Z' { byte += 32 }
        if byte != extension[index] { return false }
        index += 1
    }
    return true
}

// The type the extension of `name` (a file name or a path) gives, or ""
// when the table has none; `uncertain` as the table says.
pub fn byName(name: []const u8, uncertain: *bool) -> []const u8 {
    const base = baseName(name)
    var at: usize = 0
    var extension: []const u8 = ""
    var mime: []const u8 = ""
    var flag = false
    while nextEntry(&at, &extension, &mime, &flag) {
        if hasExtension(base, extension) {
            uncertain.* = flag
            return mime
        }
    }
    return ""
}

fn startsWith(data: []const u8, signature: []const u8) -> bool {
    if data.length < signature.length { return false }
    var index: usize = 0
    while index < signature.length {
        if data[index] != signature[index] { return false }
        index += 1
    }
    return true
}

// Whether the data starts with `tag` (case ignored) after white space.
fn startsWithTag(data: []const u8, tag: []const u8) -> bool {
    var at: usize = 0
    while at < data.length && (data[at] == 32 || data[at] == 9 || data[at] == 10 || data[at] == 13) { at += 1 }
    if data.length - at < tag.length { return false }
    var index: usize = 0
    while index < tag.length {
        var byte = data[at + index]
        if byte >= 'A' && byte <= 'Z' { byte += 32 }
        if byte != tag[index] { return false }
        index += 1
    }
    return true
}

// Whether the data is text: UTF-8 with no control characters but tab,
// newline, form feed and return.
pub fn isText(data: []const u8) -> bool {
    if !utf.valid8(data) { return false }
    for byte in data {
        if byte < 32 && byte != 9 && byte != 10 && byte != 12 && byte != 13 { return false }
        if byte == 127 { return false }
    }
    return true
}

// The type the first bytes of `data` show; UNKNOWN, uncertain, when they
// show none.
pub fn byData(data: []const u8, uncertain: *bool) -> []const u8 {
    uncertain.* = false
    if data.length == 0 { return EMPTY }
    if startsWith(data, "\x89PNG\r\n\x1a\n") { return "image/png" }
    if startsWith(data, "GIF87a") || startsWith(data, "GIF89a") { return "image/gif" }
    if startsWith(data, "\xff\xd8\xff") { return "image/jpeg" }
    if startsWith(data, "%PDF-") { return "application/pdf" }
    if data.length >= 12 && startsWith(data, "RIFF") && data[8] == 'W' && data[9] == 'E' && data[10] == 'B' && data[11] == 'P' { return "image/webp" }
    if startsWith(data, "wOFF") { return "font/woff" }
    if startsWith(data, "wOF2") { return "font/woff2" }
    if startsWithTag(data, "<?xml") { return "application/xml" }
    if startsWithTag(data, "<svg") { return "image/svg+xml" }
    if startsWithTag(data, "<html") || startsWithTag(data, "<!doctype html") { return "text/html" }
    if isText(data) { return "text/plain" }
    uncertain.* = true
    return UNKNOWN
}

// The type of a file from its name (when `hasName`) and its first bytes
// (when `hasData`), as g_content_type_guess answers: the name's type
// when it has one, certain when data comes with it; else the data's;
// else UNKNOWN, uncertain.
pub fn guess(name: []const u8, hasName: bool, data: []const u8, hasData: bool, uncertain: *bool) -> []const u8 {
    uncertain.* = true
    if hasName {
        const named = byName(name, uncertain)
        if named.length > 0 {
            if hasData && data.length > 0 { uncertain.* = false }
            return named
        }
    }
    if hasData { return byData(data, uncertain) }
    uncertain.* = true
    return UNKNOWN
}
