// std.http.headers: the values of HTTP headers, as libsoup reads and
// writes them (and so as WebKit's network code expects them): comma and
// semicolon lists whose items may hold quoted strings, the q-values of
// lists by quality, parameters (`name=token`, `name="quoted"` and RFC
// 5987's `name*=UTF-8''pct-encoded`), and parameters written back as a
// token, a quoted string or RFC 5987's form, whichever the value needs.
// The header names libsoup knows (and spells its own way when it writes
// them out) are here too, with their numbers.
//
// Everything borrows the caller's bytes and allocates nothing: a list is
// read item by item into slices of the header; what has to be rewritten
// (a quoted string's escapes, an RFC 5987 value) is written into a buffer
// the caller gives, at most as long as the value (twice, for ISO-8859-1
// made UTF-8); text written out goes to a Sink.
const utf = @import("std.unicode.utf")

// Where text is written: `write(context, bytes)` appends the bytes.
pub const Write = fn(usize, []const u8) -> void

pub const Sink = struct {
    context: usize
    write: Write
}

pub fn put(sink: Sink, bytes: []const u8) -> void { sink.write(sink.context, bytes) }

pub fn putByte(sink: Sink, byte: u8) -> void {
    var one: [1]u8 = undefined
    one[0] = byte
    sink.write(sink.context, one[0..1])
}

// ---------------------------------------------------------------------------
// Characters

// GLib's g_ascii_isspace: space, tab, newline, vertical tab, form feed,
// carriage return.
pub fn isSpace(c: u8) -> bool { return c == 32 || (c >= 9 && c <= 13) }

pub fn isDigit(c: u8) -> bool { return c >= 48 && c <= 57 }

pub fn lower(c: u8) -> u8 { return if c >= 65 && c <= 90 { c + 32 } else { c } }

// RFC 2616's separators: ( ) < > @ , ; : \ " / [ ] ? = { } space, tab.
pub fn isSeparator(c: u8) -> bool {
    return c == 40 || c == 41 || c == 60 || c == 62 || c == 64 || c == 44 || c == 59 || c == 58 || c == 92 || c == 34 || c == 47 || c == 91 || c == 93 || c == 63 || c == 61 || c == 123 || c == 125 || c == 32 || c == 9
}

// A control character (0 to 31, and 127).
pub fn isControl(c: u8) -> bool { return c < 32 || c == 127 }

// libsoup's token characters: neither separators nor controls (so bytes
// from 128 up are token characters too).
pub fn isToken(c: u8) -> bool { return !isSeparator(c) && !isControl(c) }

// Whether `a` and `b` are the same but for the case of ASCII letters.
pub fn equalsIgnoringCase(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if lower(a[index]) != lower(b[index]) { return false }
        index += 1
    }
    return true
}

pub fn startsWithIgnoringCase(text: []const u8, prefix: []const u8) -> bool {
    if text.length < prefix.length { return false }
    return equalsIgnoringCase(text[0..prefix.length], prefix)
}

pub fn indexOf(text: []const u8, byte: u8, from: usize) -> usize {
    var at = from
    while at < text.length {
        if text[at] == byte { return at }
        at += 1
    }
    return text.length
}

// ---------------------------------------------------------------------------
// Lists

pub fn skipLws(text: []const u8, at: usize) -> usize {
    var i = at
    while i < text.length && isSpace(text[i]) { i += 1 }
    return i
}

pub fn unskipLws(text: []const u8, at: usize, start: usize) -> usize {
    var i = at
    while i > start && isSpace(text[i - 1]) { i -= 1 }
    return i
}

// Past the delimiters (any number, with spaces between).
pub fn skipDelims(text: []const u8, at: usize, delim: u8) -> usize {
    var i = at
    while i < text.length && (isSpace(text[i]) || text[i] == delim) { i += 1 }
    return i
}

// The end of the item starting at `at`: the last character before a
// delimiter outside a quoted string (or before the end), spaces before it
// not counted.
pub fn itemEnd(text: []const u8, at: usize, delim: u8) -> usize {
    var quoted = false
    var i = at
    while i < text.length {
        const c = text[i]
        if c == 34 {
            quoted = !quoted
        } else if quoted {
            if c == 92 && i + 1 < text.length { i += 1 }
        } else if c == delim {
            break
        }
        i += 1
    }
    return unskipLws(text, i, at)
}

// The items of a list, one after another.
pub const List = struct {
    text: []const u8
    at: usize
    delim: u8
}

pub fn list(text: []const u8, delim: u8) -> List { return List.{ .text = text, .at = skipDelims(text, 0, delim), .delim = delim } }

pub fn next(items: *List, item: *[]const u8) -> bool {
    const text = items.*.text
    if items.*.at >= text.length { return false }
    const start = items.*.at
    const end = itemEnd(text, start, items.*.delim)
    item.* = text[start..end]
    items.*.at = skipDelims(text, end, items.*.delim)
    return true
}

// Whether the comma list `header` has `token` as an item (case aside).
pub fn contains(header: []const u8, token: []const u8) -> bool {
    var items = list(header, 44)
    var item: []const u8 = header[0..0]
    while next(&items, &item) {
        if equalsIgnoringCase(item, token) { return true }
    }
    return false
}

// The q-value of an item of a list by quality, in thousandths (libsoup
// reads up to three decimals of a value starting "0." or "1"), and how
// much of the item is the item itself (up to the `;` before the q
// parameter, all of it when there is none).
pub const Quality = struct {
    thousandths: u32
    length: usize
}

pub fn quality(item: []const u8) -> Quality {
    var semi = indexOf(item, 59, 0)
    while semi < item.length {
        const param = skipLws(item, semi + 1)
        if param < item.length && item[param] == 113 {
            const equal = skipLws(item, param + 1)
            if equal < item.length && item[equal] == 61 {
                const value = skipLws(item, equal + 1)
                if value < item.length && (item[value] == 48 || item[value] == 49) {
                    var q: u32 = @intCast(u32, item[value] - 48) * 1000
                    if item[value] == 48 && value + 1 < item.length && item[value + 1] == 46 {
                        var scale: u32 = 100
                        var digit = value + 2
                        while digit < item.length && digit < value + 5 && isDigit(item[digit]) {
                            q += @intCast(u32, item[digit] - 48) * scale
                            scale = scale / 10
                            digit += 1
                        }
                    }
                    return Quality.{ .thousandths = q, .length = semi }
                }
            }
        }
        semi = indexOf(item, 59, semi + 1)
    }
    return Quality.{ .thousandths = 1000, .length = item.length }
}

// ---------------------------------------------------------------------------
// Parameters

pub const ParamKind = enum(u8) {
    // `name` alone.
    bare,
    // `name=value`: a token or anything else unquoted.
    plain,
    // `name="..."`: the value is to be unquoted (decodeQuoted).
    quoted,
    // `name*=charset'language'pct-encoded` (RFC 5987): to be decoded
    // (decodeExtended); the name is without its `*`.
    extended,
}

pub const Param = struct {
    name: []const u8
    value: []const u8
    kind: ParamKind
}

// The parameter an item of a parameter list is; false for an item libsoup
// drops (`=value` with no name).
pub fn param(item: []const u8, result: *Param) -> bool {
    const eq = indexOf(item, 61, 0)
    if eq >= item.length {
        result.* = Param.{ .name = item, .value = item[0..0], .kind = ParamKind.bare }
        return true
    }
    const nameEnd = unskipLws(item, eq, 0)
    if nameEnd == 0 { return false }
    const value = skipLws(item, eq + 1)
    if item[nameEnd - 1] == 42 && nameEnd > 1 {
        result.* = Param.{ .name = item[0..nameEnd - 1], .value = item[value..item.length], .kind = ParamKind.extended }
        return true
    }
    if value < item.length && item[value] == 34 {
        result.* = Param.{ .name = item[0..nameEnd], .value = item[value..item.length], .kind = ParamKind.quoted }
        return true
    }
    result.* = Param.{ .name = item[0..nameEnd], .value = item[value..item.length], .kind = ParamKind.plain }
    return true
}

// A quoted string (`"...` with its quote) unquoted into `out` (as long as
// the value at most): its escapes taken out, up to the closing quote or
// the end.
pub fn decodeQuoted(value: []const u8, out: []u8) -> usize {
    var at: usize = 1
    var length: usize = 0
    while at < value.length && value[at] != 34 {
        if value[at] == 92 && at + 1 < value.length { at += 1 }
        out[length] = value[at]
        length += 1
        at += 1
    }
    return length
}

fn hexValue(c: u8) -> u32 {
    if c >= 48 && c <= 57 { return @intCast(u32, c - 48) }
    if c >= 97 && c <= 102 { return @intCast(u32, c - 87) }
    if c >= 65 && c <= 70 { return @intCast(u32, c - 55) }
    return 16
}

// GLib's g_uri_unescape_string with no illegal characters: %XX escapes
// decoded into `out` (no longer than the text); -1 for a bad escape or
// one of a NUL byte.
pub fn unescape(text: []const u8, out: []u8) -> isize {
    var at: usize = 0
    var length: usize = 0
    while at < text.length {
        var c = text[at]
        if c == 37 {
            if at + 2 >= text.length { return -1 }
            const high = hexValue(text[at + 1])
            const low = hexValue(text[at + 2])
            if high > 15 || low > 15 { return -1 }
            c = @intCast(u8, high * 16 + low)
            if c == 0 { return -1 }
            at += 2
        }
        out[length] = c
        length += 1
        at += 1
    }
    return @intCast(isize, length)
}

// RFC 5987's `charset'language'pct-encoded` decoded into `out` (twice as
// long as the value): UTF-8 as it is, ISO-8859-1 made UTF-8, -1 for any
// other charset or a bad escape (libsoup then drops the parameter).
pub fn decodeExtended(value: []const u8, out: []u8) -> isize {
    const q = indexOf(value, 39, 0)
    if q >= value.length { return -1 }
    // (libsoup compares only as much of "UTF-8" as the charset is long.)
    var latin = false
    if q <= 5 && equalsIgnoringCase(value[0..q], "UTF-8"[0..q]) {
        latin = false
    } else if q <= 10 && equalsIgnoringCase(value[0..q], "iso-8859-1"[0..q]) {
        latin = true
    } else {
        return -1
    }
    const q2 = indexOf(value, 39, q + 1)
    if q2 >= value.length { return -1 }
    const decoded = unescape(value[q2 + 1..value.length], out)
    if decoded < 0 { return -1 }
    if !latin { return decoded }
    // Each byte a character: those from 128 up take two bytes in UTF-8,
    // written back to front so the bytes not yet read are not overwritten.
    var count = @intCast(usize, decoded)
    var wide: usize = 0
    var i: usize = 0
    while i < count {
        wide += if out[i] >= 128 { 2 } else { 1 }
        i += 1
    }
    var to = wide
    while count > 0 {
        count -= 1
        const c = out[count]
        if c >= 128 {
            out[to - 1] = 128 | (c & 63)
            out[to - 2] = 192 | (c >> 6)
            to -= 2
        } else {
            out[to - 1] = c
            to -= 1
        }
    }
    return @intCast(isize, wide)
}

// GLib's g_utf8_validate of the whole value.
pub fn validUtf8(text: []const u8) -> bool { return utf.valid8(text) }

fn isUnreserved(c: u8) -> bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 46 || c == 95 || c == 126 }

// GLib's g_uri_escape_string(text, allowed, FALSE): unreserved characters
// and `allowed` kept, anything else %XX (upper case).
pub fn escape(sink: Sink, text: []const u8, allowed: []const u8) -> void {
    const digits = "0123456789ABCDEF"
    var start: usize = 0
    var at: usize = 0
    while at < text.length {
        const c = text[at]
        var keep = isUnreserved(c)
        if !keep { keep = indexOf(allowed, c, 0) < allowed.length }
        if !keep {
            if at > start { put(sink, text[start..at]) }
            var three: [3]u8 = undefined
            three[0] = 37
            three[1] = digits[@intCast(usize, c >> 4)]
            three[2] = digits[@intCast(usize, c & 15)]
            put(sink, three[0..3])
            start = at + 1
        }
        at += 1
    }
    if at > start { put(sink, text[start..at]) }
}

// `name="value"`, `"` and `\` escaped.
pub fn writeQuoted(sink: Sink, name: []const u8, value: []const u8) -> void {
    put(sink, name)
    put(sink, "=\"")
    var start: usize = 0
    var at: usize = 0
    while at < value.length {
        const c = value[at]
        if c == 92 || c == 34 {
            if at > start { put(sink, value[start..at]) }
            putByte(sink, 92)
            putByte(sink, c)
            start = at + 1
        }
        at += 1
    }
    if at > start { put(sink, value[start..at]) }
    putByte(sink, 34)
}

// A parameter as libsoup writes one: RFC 5987's form for a value beyond
// ASCII that is UTF-8, a token as it is (when `allowToken`), else quoted.
pub fn writeParam(sink: Sink, name: []const u8, value: []const u8, allowToken: bool) -> void {
    var token = allowToken
    var at: usize = 0
    while at < value.length {
        const c = value[at]
        if c >= 128 {
            if validUtf8(value) {
                put(sink, name)
                put(sink, "*=UTF-8''")
                escape(sink, value, "!#$&+-.^_`|~")
                return
            }
            token = false
            break
        }
        if !isToken(c) { token = false }
        at += 1
    }
    if token {
        put(sink, name)
        putByte(sink, 61)
        put(sink, value)
    } else {
        writeQuoted(sink, name, value)
    }
}

// ---------------------------------------------------------------------------
// The header names libsoup knows, as it spells them.

pub const NAME_COUNT: usize = 87

// The names, each followed by a newline, in libsoup's order.
const NAMES: []const u8 = "Accept\nAccept-Charset\nAccept-Language\nAccept-Encoding\nAccept-Ranges\nAccess-Control-Allow-Credentials\nAccess-Control-Allow-Headers\nAccess-Control-Allow-Methods\nAccess-Control-Allow-Origin\nAccess-Control-Expose-Headers\nAccess-Control-Max-Age\nAccess-Control-Request-Headers\nAccess-Control-Request-Method\nAge\nAuthentication-Info\nAuthorization\nCache-Control\nConnection\nContent-Disposition\nContent-Encoding\nContent-Language\nContent-Length\nContent-Location\nContent-Security-Policy\nContent-Security-Policy-Report-Only\nContent-Type\nContent-Range\nCookie\nCookie2\nCross-Origin-Resource-Policy\nDate\nDNT\nDefault-Style\nETag\nExpect\nExpires\nHost\nIf-Match\nIf-Modified-Since\nIf-None-Match\nIf-Range\nIf-Unmodified-Since\nKeep-Alive\nLast-Event-ID\nLast-Modified\nLink\nLocation\nOrigin\nPing-From\nPing-To\nPurpose\nPragma\nProxy-Authorization\nProxy-Authenticate\nProxy-Authentication-Info\nRange\nReferer\nReferrer-Policy\nRefresh\nSec-WebSocket-Accept\nSec-WebSocket-Extensions\nSec-WebSocket-Key\nSec-WebSocket-Protocol\nSec-WebSocket-Version\nServer\nServer-Timing\nService-Worker\nService-Worker-Allowed\nSet-Cookie\nSet-Cookie2\nSourceMap\nTE\nTiming-Allow-Origin\nTrailer\nTransfer-Encoding\nUpgrade\nUpgrade-Insecure-Requests\nUser-Agent\nVary\nVia\nWWW-Authenticate\nX-Content-Type-Options\nX-DNS-Prefetch-Control\nX-Frame-Options\nX-SourceMap\nX-XSS-Protection\nX-Temp-Tablet\n"

// The name numbered `index` (below NAME_COUNT).
pub fn nameOf(index: usize) -> []const u8 {
    var at: usize = 0
    var n: usize = 0
    while n < index {
        at = indexOf(NAMES, 10, at) + 1
        n += 1
    }
    return NAMES[at..indexOf(NAMES, 10, at)]
}

// The number of a known header name (case aside), NAME_COUNT for another.
pub fn nameIndex(name: []const u8) -> usize {
    var at: usize = 0
    var n: usize = 0
    while n < NAME_COUNT {
        const end = indexOf(NAMES, 10, at)
        if equalsIgnoringCase(NAMES[at..end], name) { return n }
        at = end + 1
        n += 1
    }
    return NAME_COUNT
}

// The numbers of the names libsoup's own code asks about.
pub const ACCEPT_ENCODING: usize = 3
pub const AUTHORIZATION: usize = 15
pub const CONNECTION: usize = 17
pub const CONTENT_DISPOSITION: usize = 18
pub const CONTENT_ENCODING: usize = 19
pub const CONTENT_LENGTH: usize = 21
pub const CONTENT_TYPE: usize = 25
pub const CONTENT_RANGE: usize = 26
pub const COOKIE: usize = 27
pub const DATE: usize = 30
pub const EXPECT: usize = 34
pub const HOST: usize = 36
pub const KEEP_ALIVE: usize = 42
pub const LOCATION: usize = 46
pub const PROXY_AUTHORIZATION: usize = 52
pub const PROXY_AUTHENTICATE: usize = 53
pub const RANGE: usize = 55
pub const SET_COOKIE: usize = 68
pub const TRANSFER_ENCODING: usize = 74
pub const UPGRADE: usize = 75
pub const WWW_AUTHENTICATE: usize = 80
