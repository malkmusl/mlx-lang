// std.http.form: application/x-www-form-urlencoded data as libsoup reads
// and writes it: pairs split at `&` and `=`, `+` a space, %XX escapes
// (a malformed escape refuses its pair); written with letters, digits and
// `-_.` as they are, a space as `+`, anything else %XX (upper case).
const headers = @import("./headers.mlx")

fn isHex(c: u8) -> bool { return (c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102) }

// libsoup's XDIGIT: a digit's value, a letter's by its upper case.
fn digitValue(c: u8) -> u8 { return if c <= 57 { c - 48 } else { (c & 79) - 65 + 10 } }

// A form name or value decoded into `out` (no longer than it); -1 for a
// malformed escape.
pub fn decode(text: []const u8, out: []u8) -> isize {
    var at: usize = 0
    var length: usize = 0
    while at < text.length {
        const c = text[at]
        if c == 37 {
            if at + 2 >= text.length { return -1 }
            if !isHex(text[at + 1]) || !isHex(text[at + 2]) { return -1 }
            out[length] = (digitValue(text[at + 1]) << 4) +% digitValue(text[at + 2])
            at += 3
        } else {
            out[length] = if c == 43 { 32 } else { c }
            at += 1
        }
        length += 1
    }
    return @intCast(isize, length)
}

fn isAlnum(c: u8) -> bool { return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }

// A form name or value encoded.
pub fn encode(sink: headers.Sink, text: []const u8) -> void {
    const digits = "0123456789ABCDEF"
    var start: usize = 0
    var at: usize = 0
    while at < text.length {
        const c = text[at]
        if c == 32 || !(isAlnum(c) || c == 45 || c == 95 || c == 46) {
            if at > start { headers.put(sink, text[start..at]) }
            if c == 32 {
                headers.putByte(sink, 43)
            } else {
                var three: [3]u8 = undefined
                three[0] = 37
                three[1] = digits[@intCast(usize, c >> 4)]
                three[2] = digits[@intCast(usize, c & 15)]
                headers.put(sink, three[0..3])
            }
            start = at + 1
        }
        at += 1
    }
    if at > start { headers.put(sink, text[start..at]) }
}

// A name and its value, `&` before them unless `first`.
pub fn encodePair(sink: headers.Sink, name: []const u8, value: []const u8, first: bool) -> void {
    if !first { headers.putByte(sink, 38) }
    encode(sink, name)
    headers.putByte(sink, 61)
    encode(sink, value)
}
