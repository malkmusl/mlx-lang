// std.http.date: dates as HTTP writes and reads them, as libsoup does:
//
//   - written in RFC 9110's IMF-fixdate ("Sun, 06 Nov 1994 08:49:37 GMT")
//     or the cookie form of Netscape's Expires ("Sun, 06-Nov-1994
//     08:49:37 GMT"), always in UTC;
//   - read from any form servers send: IMF-fixdate, RFC 850's
//     ("Sunday, 06-Nov-94 08:49:37 GMT", two-digit years from 1970 to
//     2069), asctime's ("Sun Nov  6 08:49:37 1994"), with or without the
//     weekday, and a zone that is GMT, UTC, Z, a numeric offset (+0100,
//     -01:00) or one of the four American ones (EST, EDT, CST, CDT, MST,
//     MDT, PST, PDT, with libsoup's offsets for them); none means UTC.
//
// Reading gives the date's fields and its zone; a field out of its range
// or a day the month does not have make it fail. A string that starts with
// a digit and has no month name in it is refused, as libsoup refuses ISO
// 8601 and timestamps there.
const headers = @import("./headers.mlx")

pub const ZoneKind = enum(u8) {
    // No zone was written, or one that was not understood: UTC.
    none,
    utc,
    // `offsetMinutes` east of UTC (a numeric zone, EST...).
    offset,
}

pub const Date = struct {
    year: i64
    month: i64
    day: i64
    hour: i64
    minute: i64
    second: i64
    zone: ZoneKind
    offsetMinutes: i64
}

const MONTHS: []const u8 = "JanFebMarAprMayJunJulAugSepOctNovDec"
const DAYS: []const u8 = "MonTueWedThuFriSatSun"

pub fn monthName(month: i64) -> []const u8 {
    const at = @intCast(usize, month - 1) * 3
    return MONTHS[at..at + 3]
}

// Monday is 1, Sunday 7 (GLib's day of the week).
pub fn dayName(weekday: i64) -> []const u8 {
    const at = @intCast(usize, weekday - 1) * 3
    return DAYS[at..at + 3]
}

fn isAlpha(c: u8) -> bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }

// C's strtoul as libsoup leans on it: spaces skipped, a sign, decimal
// digits; `end` where the digits stopped (where it started when there
// were none).
const Number = struct {
    value: i64
    end: usize
    found: bool
}

fn strtoul(text: []const u8, at: usize) -> Number {
    var i = at
    while i < text.length && headers.isSpace(text[i]) { i += 1 }
    var negative = false
    if i < text.length && (text[i] == 43 || text[i] == 45) {
        negative = text[i] == 45
        i += 1
    }
    const digits = i
    var value: i64 = 0
    while i < text.length && headers.isDigit(text[i]) {
        // (Very long numbers saturate; no date has them.)
        if value < 100000000000000 { value = value * 10 + @intCast(i64, text[i] - 48) }
        i += 1
    }
    if i == digits { return Number.{ .value = 0, .end = at, .found = false } }
    return Number.{ .value = if negative { 0 - value } else { value }, .end = i, .found = true }
}

fn skipSpacesAndDashes(text: []const u8, at: usize) -> usize {
    var i = at
    while i < text.length && (text[i] == 32 || text[i] == 45) { i += 1 }
    return i
}

fn parseDay(text: []const u8, at: *usize, day: *i64) -> bool {
    const n = strtoul(text, at.*)
    if !n.found { return false }
    day.* = n.value
    at.* = skipSpacesAndDashes(text, n.end)
    return n.value >= 1 && n.value <= 31
}

fn parseMonth(text: []const u8, at: *usize, month: *i64) -> bool {
    var index: usize = 0
    while index < 12 {
        if at.* + 3 <= text.length && headers.equalsIgnoringCase(text[at.*..at.* + 3], MONTHS[index * 3..index * 3 + 3]) {
            month.* = @intCast(i64, index + 1)
            at.* = skipSpacesAndDashes(text, at.* + 3)
            return true
        }
        index += 1
    }
    return false
}

fn parseYear(text: []const u8, at: *usize, year: *i64) -> bool {
    const n = strtoul(text, at.*)
    if !n.found { return false }
    var value = n.value
    // (libsoup counts the digits from where it started reading, spaces
    // included.)
    if n.end == at.* + 2 {
        value += if value < 70 { 2000 } else { 1900 }
    } else if n.end == at.* + 3 {
        value += 1900
    }
    year.* = value
    at.* = skipSpacesAndDashes(text, n.end)
    return value > 0 && value < 9999
}

fn parseTime(text: []const u8, at: *usize, date: *Date) -> bool {
    const h = strtoul(text, at.*)
    if !h.found || h.end >= text.length || text[h.end] != 58 { return false }
    const m = strtoul(text, h.end + 1)
    if !m.found || m.end >= text.length || text[m.end] != 58 { return false }
    const s = strtoul(text, m.end + 1)
    if !s.found { return false }
    date.*.hour = h.value
    date.*.minute = m.value
    date.*.second = s.value
    var i = s.end
    while i < text.length && text[i] == 32 { i += 1 }
    at.* = i
    return h.value >= 0 && h.value < 24 && m.value >= 0 && m.value < 60 && s.value >= 0 && s.value < 60
}

fn parseZone(text: []const u8, at: usize, date: *Date) -> void {
    const rest = text[at..text.length]
    if rest.length == 0 {
        // (libsoup makes a zone of offset 0 here, not UTC's.)
        date.*.zone = ZoneKind.offset
        date.*.offsetMinutes = 0
        return
    }
    const c = rest[0]
    if c == 43 || c == 45 {
        const sign: i64 = if c == 43 { 1 } else { -1 }
        const first = strtoul(text, at + 1)
        var value = first.value
        // (Offsets too large to be offsets are not understood: UTC.)
        if value > 9999 || value < 0 {
            date.*.zone = ZoneKind.none
            return
        }
        if first.end < text.length && text[first.end] == 58 {
            const second = strtoul(text, first.end + 1).value
            if value > 99 || second > 99 || second < 0 {
                date.*.zone = ZoneKind.none
                return
            }
            value = 60 * value + second
        } else {
            value = 60 * (value / 100) + value % 100
        }
        if sign == -1 && value == 0 {
            date.*.zone = ZoneKind.utc
            date.*.offsetMinutes = 0
        } else {
            date.*.zone = ZoneKind.offset
            date.*.offsetMinutes = sign * value
        }
        return
    }
    if c == 90 {
        date.*.zone = ZoneKind.utc
        return
    }
    if headers.equalsIgnoringCase(rest, "GMT") && rest[0] == 71 && rest[1] == 77 && rest[2] == 84 {
        date.*.zone = ZoneKind.utc
        return
    }
    if rest.length == 3 && rest[0] == 85 && rest[1] == 84 && rest[2] == 67 {
        date.*.zone = ZoneKind.utc
        return
    }
    if rest.length >= 3 && (c == 69 || c == 67 || c == 77 || c == 80) && (rest[1] == 68 || rest[1] == 83) && rest[2] == 84 {
        // libsoup's arithmetic, kept as it is: five hours west a step, the
        // step being where in "ECMP" the first letter that appears in the
        // rest of the string is (so EST is no offset, CST five hours west,
        // MST ten, PST fifteen); daylight time an hour less.
        const letters = "ECMP"
        var step: i64 = 0
        while step < 4 && headers.indexOf(rest, letters[@intCast(usize, step)], 0) >= rest.length { step += 1 }
        var minutes = -60 * (5 * step)
        if rest[1] == 68 { minutes += 60 }
        date.*.zone = ZoneKind.offset
        date.*.offsetMinutes = minutes
        return
    }
    // Not understood: UTC.
    date.*.zone = ZoneKind.none
}

fn isLeap(year: i64) -> bool { return (year % 4 == 0 && year % 100 != 0) || year % 400 == 0 }

// GLib's g_date_valid_dmy: a day of the month, a month, a year from 1.
pub fn validDate(day: i64, month: i64, year: i64) -> bool {
    if year < 1 || month < 1 || month > 12 || day < 1 { return false }
    const lengths = [12]i64{ 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 }
    var length = lengths[@intCast(usize, month - 1)]
    if month == 2 && isLeap(year) { length = 29 }
    return day <= length
}

// The date of an HTTP date string; false when it is not one (libsoup
// checks each field as it is read, and the date as a whole: no 31st of
// April, no 29th of February outside leap years).
pub fn parse(text: []const u8, date: *Date) -> bool {
    date.* = Date.{ .year = 0, .month = 0, .day = 0, .hour = 0, .minute = 0, .second = 0, .zone = ZoneKind.none, .offsetMinutes = 0 }
    var at: usize = 0
    while at < text.length && headers.isSpace(text[at]) { at += 1 }
    if at < text.length && headers.isDigit(text[at]) {
        // ISO 8601 and timestamps are refused: a month's capital letter must
        // be somewhere.
        var month = false
        var i = at
        while i < text.length {
            const c = text[i]
            if c == 74 || c == 70 || c == 77 || c == 65 || c == 83 || c == 79 || c == 78 || c == 68 { month = true }
            i += 1
        }
        if !month { return false }
    }
    // A weekday first is skipped.
    if at < text.length && isAlpha(text[at]) {
        while at < text.length && isAlpha(text[at]) { at += 1 }
        if at < text.length && text[at] == 44 { at += 1 }
        while at < text.length && headers.isSpace(text[at]) { at += 1 }
    }
    if at < text.length && isAlpha(text[at]) {
        // asctime: Nov  6 08:49:37 1994
        if !parseMonth(text, &at, &date.*.month) { return false }
        if !parseDay(text, &at, &date.*.day) { return false }
        if !parseTime(text, &at, date) { return false }
        if !parseYear(text, &at, &date.*.year) { return false }
        if !validDate(date.*.day, date.*.month, date.*.year) { return false }
    } else {
        // 06 Nov 1994 08:49:37 GMT, 06-Nov-94 08:49:37 GMT
        if !parseDay(text, &at, &date.*.day) { return false }
        if !parseMonth(text, &at, &date.*.month) { return false }
        if !parseYear(text, &at, &date.*.year) { return false }
        if !parseTime(text, &at, date) { return false }
        if !validDate(date.*.day, date.*.month, date.*.year) { return false }
    }
    parseZone(text, at, date)
    return true
}

fn putTwo(sink: headers.Sink, value: i64) -> void {
    var two: [2]u8 = undefined
    two[0] = @intCast(u8, 48 + (value / 10) % 10)
    two[1] = @intCast(u8, 48 + value % 10)
    headers.put(sink, two[0..2])
}

pub fn putNumber(sink: headers.Sink, value: i64) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = if value < 0 { 0 - value } else { value }
    while true {
        digits[23 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    if value < 0 { headers.putByte(sink, 45) }
    headers.put(sink, digits[24 - count..24])
}

// A UTC date written as HTTP does ("Sun, 06 Nov 1994 08:49:37 GMT"), or as
// a cookie's expiry ("Sun, 06-Nov-1994 08:49:37 GMT"); `weekday` from 1
// (Monday) to 7.
pub fn write(sink: headers.Sink, year: i64, month: i64, day: i64, hour: i64, minute: i64, second: i64, weekday: i64, cookie: bool) -> void {
    const separator: []const u8 = if cookie { "-" } else { " " }
    headers.put(sink, dayName(weekday))
    headers.put(sink, ", ")
    putTwo(sink, day)
    headers.put(sink, separator)
    headers.put(sink, monthName(month))
    headers.put(sink, separator)
    putNumber(sink, year)
    headers.putByte(sink, 32)
    putTwo(sink, hour)
    headers.putByte(sink, 58)
    putTwo(sink, minute)
    headers.putByte(sink, 58)
    putTwo(sink, second)
    headers.put(sink, " GMT")
}

// The civil date of a count of days since 1970-01-01 (proleptic
// Gregorian), and back.
pub fn daysFromCivil(year: i64, month: i64, day: i64) -> i64 {
    const y = if month <= 2 { year - 1 } else { year }
    const era = if y >= 0 { y / 400 } else { (y - 399) / 400 }
    const yoe = y - era * 400
    const mp = if month > 2 { month - 3 } else { month + 9 }
    const doy = (153 * mp + 2) / 5 + day - 1
    const doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

// Monday 1 to Sunday 7 of a count of days since 1970-01-01 (a Thursday).
pub fn weekdayOfDays(days: i64) -> i64 {
    var r = (days + 3) % 7
    if r < 0 { r += 7 }
    return r + 1
}

// The civil date (proleptic Gregorian) of a count of days since
// 1970-01-01: the inverse of daysFromCivil.
pub fn civilFromDays(days: i64, year: *i64, month: *i64, day: *i64) -> void {
    const z = days + 719468
    const era = if z >= 0 { z / 146097 } else { (z - 146096) / 146097 }
    const doe = z - era * 146097
    const yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    const doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    const mp = (5 * doy + 2) / 153
    day.* = doy - (153 * mp + 2) / 5 + 1
    month.* = if mp < 10 { mp + 3 } else { mp - 9 }
    year.* = yoe + era * 400 + (if month.* <= 2 { 1 } else { 0 })
}

// The seconds since the Unix epoch of a date read (its zone's offset
// taken off).
pub fn toUnix(date: *const Date) -> i64 {
    var seconds = daysFromCivil(date.*.year, date.*.month, date.*.day) * 86400 + date.*.hour * 3600 + date.*.minute * 60 + date.*.second
    if date.*.zone == ZoneKind.offset { seconds -= date.*.offsetMinutes * 60 }
    return seconds
}

// A moment in seconds since the Unix epoch written as HTTP does, in UTC
// (`cookie`: the cookie form).
pub fn writeUnix(sink: headers.Sink, seconds: i64, cookie: bool) -> void {
    var days = seconds / 86400
    var rest = seconds % 86400
    if rest < 0 {
        rest += 86400
        days -= 1
    }
    var year: i64 = 0
    var month: i64 = 0
    var day: i64 = 0
    civilFromDays(days, &year, &month, &day)
    write(sink, year, month, day, rest / 3600, (rest % 3600) / 60, rest % 60, weekdayOfDays(days), cookie)
}
