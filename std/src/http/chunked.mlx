// std.http.chunked: HTTP/1.1's chunked transfer coding (RFC 9112 7.1):
// the size line that starts each chunk, read as libsoup reads it (hex
// digits after optional spaces, anything after them, as chunk extensions,
// ignored), and written.
const headers = @import("./headers.mlx")

fn hexValue(c: u8) -> i64 {
    if c >= 48 && c <= 57 { return @intCast(i64, c - 48) }
    if c >= 97 && c <= 102 { return @intCast(i64, c - 87) }
    if c >= 65 && c <= 70 { return @intCast(i64, c - 55) }
    return -1
}

// The size of the chunk whose size line is `line` (without its line end),
// as strtoul(line, NULL, 16) reads it: 0 when no digit starts it, and
// sizes past 2^62 held there.
pub fn chunkSize(line: []const u8) -> i64 {
    var at: usize = 0
    while at < line.length && headers.isSpace(line[at]) { at += 1 }
    if at < line.length && line[at] == 43 { at += 1 }
    if at + 1 < line.length && line[at] == 48 && (line[at + 1] == 120 || line[at + 1] == 88) { at += 2 }
    var size: i64 = 0
    while at < line.length {
        const digit = hexValue(line[at])
        if digit < 0 { break }
        if size < 0x400000000000000 { size = size * 16 + digit }
        at += 1
    }
    return size
}

// Where the line that ends at the first LF of `bytes` ends: the index of
// that LF, or bytes.length when there is none.
pub fn lineEnd(bytes: []const u8) -> usize { return headers.indexOf(bytes, 10, 0) }

// The line's text without its CR LF (or LF).
pub fn lineText(bytes: []const u8, lf: usize) -> []const u8 {
    var end = lf
    if end > 0 && bytes[end - 1] == 13 { end -= 1 }
    return bytes[0..end]
}

// "SIZE\r\n" in lower-case hex, as libsoup writes it.
pub fn writeSizeLine(sink: headers.Sink, size: u64) -> void {
    var digits: [16]u8 = undefined
    var count: usize = 0
    var value = size
    while true {
        const d = @intCast(u8, value & 15)
        digits[count] = if d < 10 { 48 + d } else { 87 + d }
        count += 1
        value = value >> 4
        if value == 0 { break }
    }
    while count > 0 {
        count -= 1
        headers.putByte(sink, digits[count])
    }
    headers.put(sink, "\r\n")
}

// The last chunk and the end of the (empty) trailer.
pub fn writeLastChunk(sink: headers.Sink) -> void { headers.put(sink, "0\r\n\r\n") }
