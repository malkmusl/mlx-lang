// std.xkb: keyboard maps in the XKB text format (what a Wayland compositor
// sends in wl_keyboard.keymap and `xkbcli compile-keymap` writes), read
// without libxkbcommon. A keymap names the keys (xkb_keycodes), says how
// modifiers pick a level (xkb_types), what modifier keys do
// (xkb_compatibility) and what each key types (xkb_symbols).
//
//     var names: keysym.Names = undefined
//     keysym.init(&names, allocator)
//     const keymap = xkb.create(allocator, &names)
//     if !xkb.parse(keymap, text) { ... }
//     var state: xkb_state.State = undefined
//     xkb_state.init(&state, keymap)
//     xkb_state.updateMask(&state, depressed, latched, locked, 0, 0, group)
//     const length = xkb_state.keyUtf8(&state, evdev_code + 8, out, 8)
//
// Levels, groups and keycodes count from 0 here (the text counts levels
// and groups from 1). Modifier masks below 256 are the real modifiers
// (Shift, Lock, Control, Mod1 .. Mod5); bit 8 + i is virtual modifier i.
// The keymap follows libxkbcommon's reading of the format: keys without a
// type get one by what they type, modifier keys get their actions and
// virtual modifiers from the compatibility map, and a virtual modifier
// maps to the real modifiers of the keys that carry it.
const std = @import("std")
const keysym = @import("std.xkb.keysym")

pub const Allocator = std.allocator.Allocator

pub const MAX_KEYCODE: usize = 1024
pub const MAX_GROUPS: usize = 4
pub const MAX_LEVELS: usize = 8
// Per key: MAX_GROUPS * MAX_LEVELS slots of keysyms and actions.
pub const SLOTS: usize = 32
pub const MAX_TYPES: usize = 64
pub const MAX_ENTRIES: usize = 32
pub const MAX_VMODS: usize = 16
pub const MAX_INTERPRETS: usize = 256
pub const MAX_SYMS: usize = 65536
pub const MAX_ALIASES: usize = 256
// Bytes of a key, alias, modifier or group name; of a type name.
pub const NAME: usize = 16
pub const TYPE_NAME: usize = 64
pub const GROUP_NAME: usize = 64

pub const SHIFT: u32 = 1
pub const LOCK: u32 = 2
pub const CONTROL: u32 = 4
pub const MOD1: u32 = 8
pub const MOD2: u32 = 16
pub const MOD3: u32 = 32
pub const MOD4: u32 = 64
pub const MOD5: u32 = 128
pub const REAL_MODS: u32 = 255

pub const ACTION_NONE: u8 = 0
pub const ACTION_SET_MODS: u8 = 1
pub const ACTION_LATCH_MODS: u8 = 2
pub const ACTION_LOCK_MODS: u8 = 3
pub const ACTION_SET_GROUP: u8 = 4
pub const ACTION_LATCH_GROUP: u8 = 5
pub const ACTION_LOCK_GROUP: u8 = 6

pub const FLAG_CLEAR_LOCKS: u8 = 1
pub const FLAG_LATCH_TO_LOCK: u8 = 2
// The action's modifiers are the key's (modMapMods).
pub const FLAG_MODMAP_MODS: u8 = 4
pub const FLAG_GROUP_ABSOLUTE: u8 = 8
pub const FLAG_LOCK_NO_LOCK: u8 = 16
pub const FLAG_LOCK_NO_UNLOCK: u8 = 32

pub const MATCH_NONE: u8 = 0
pub const MATCH_ANY_OR_NONE: u8 = 1
pub const MATCH_ANY: u8 = 2
pub const MATCH_ALL: u8 = 3
pub const MATCH_EXACTLY: u8 = 4

pub const EXPLICIT_INTERP: u16 = 1
pub const EXPLICIT_VMODMAP: u16 = 2
pub const EXPLICIT_REPEAT: u16 = 4
// EXPLICIT_TYPE << group.
pub const EXPLICIT_TYPE: u16 = 8

pub const RANGE_WRAP: u8 = 0
pub const RANGE_CLAMP: u8 = 1
pub const RANGE_REDIRECT: u8 = 2

pub const NO_TYPE: u8 = 255

pub const Keymap = struct {
    names: *keysym.Names
    minKeycode: u32
    maxKeycode: u32
    // Per keycode: its name (NUL-padded), empty when the keycode has none.
    keyNames: [16384]u8
    aliasNames: [4096]u8
    aliasTargets: [4096]u8
    aliasCount: usize
    // Virtual modifiers: names, a mapping the text gave, the mapping to
    // real modifiers.
    vmodNames: [256]u8
    vmodCount: usize
    vmodGiven: [16]u32
    vmodMapping: [16]u32
    // Types: name, modifiers, levels, entries (modifiers, level, preserve)
    // MAX_ENTRIES apart; the masks resolved to real modifiers.
    typeNames: [4096]u8
    typeCount: usize
    typeMods: [64]u32
    typeLevels: [64]u8
    typeEntryCount: [64]u8
    entryMods: [2048]u32
    entryLevel: [2048]u8
    entryPreserve: [2048]u32
    typeModsReal: [64]u32
    entryModsReal: [2048]u32
    entryPreserveReal: [2048]u32
    entryActive: [2048]bool
    // The compatibility map's interpretations, most specific first.
    interpretCount: usize
    interpretSym: [256]u32
    interpretAny: [256]bool
    interpretMatch: [256]u8
    interpretMods: [256]u32
    interpretVmod: [256]i32
    interpretLevelOne: [256]bool
    interpretRepeat: [256]bool
    interpretActionKind: [256]u8
    interpretActionFlags: [256]u8
    interpretActionMods: [256]u32
    interpretActionGroup: [256]i32
    // Per keycode.
    keyGroups: [1024]u8
    keyExplicit: [1024]u16
    keyRepeats: [1024]bool
    keyModmap: [1024]u8
    keyVmodmap: [1024]u32
    keyRange: [1024]u8
    keyRedirect: [1024]u8
    // Per keycode and group (MAX_GROUPS apart): its type, its width.
    keyTypes: [4096]u8
    keyWidth: [4096]u8
    // Per keycode, group and level (SLOTS apart, MAX_LEVELS a group): the
    // keysyms (first in `syms`, how many) and the action.
    slotFirst: [32768]u32
    slotCount: [32768]u8
    actionKind: [32768]u8
    actionFlags: [32768]u8
    actionMods: [32768]u32
    actionGroup: [32768]i32
    syms: [65536]u32
    symCount: usize
    groupNames: [256]u8
    groupCount: usize
    // Where reading stopped when it failed (a line of the text).
    errorLine: usize
}

pub fn create(allocator: Allocator, names: *keysym.Names) -> *Keymap {
    var keymap: *Keymap = undefined
    unsafe { keymap = @ptrCast(*Keymap, allocator.alloc(@sizeOf(Keymap), 16).?) }
    clear(keymap, names)
    return keymap
}

pub fn destroy(keymap: *Keymap, allocator: Allocator) -> void {
    unsafe { allocator.free(@ptrCast([*]u8, keymap), @sizeOf(Keymap), 16) }
}

pub fn clear(keymap: *Keymap, names: *keysym.Names) -> void {
    unsafe { std.mem.zero(@ptrCast([*]u8, keymap), @sizeOf(Keymap)) }
    keymap.*.names = names
    keymap.*.minKeycode = 8
    keymap.*.maxKeycode = 255
    var key: usize = 0
    while key < MAX_KEYCODE {
        var group: usize = 0
        while group < MAX_GROUPS {
            keymap.*.keyTypes[key * MAX_GROUPS + group] = NO_TYPE
            group += 1
        }
        key += 1
    }
}

// ---------------------------------------------------------------------------
// Names

fn bytesOf(keymap: *Keymap, field: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(keymap) + field) }
}

fn stored(base: [*]u8, at: usize, capacity: usize) -> []const u8 {
    var length: usize = 0
    while length < capacity && base[at + length] != 0 { length += 1 }
    return base[at..at + length]
}

fn store(base: [*]u8, at: usize, capacity: usize, value: []const u8) -> void {
    var index: usize = 0
    while index < capacity {
        base[at + index] = if index < value.length && index + 1 < capacity { value[index] } else { 0 }
        index += 1
    }
}

pub fn keyName(keymap: *Keymap, keycode: u32) -> []const u8 {
    if keycode >= @intCast(u32, MAX_KEYCODE) { return "" }
    return stored(bytesOf(keymap, @offsetOf(Keymap, "keyNames")), @intCast(usize, keycode) * NAME, NAME)
}

// The keycode named `name` (or by an alias); 0 when there is none.
pub fn keycodeOf(keymap: *Keymap, name: []const u8) -> u32 {
    var alias: usize = 0
    while alias < keymap.*.aliasCount {
        if std.text.same(stored(bytesOf(keymap, @offsetOf(Keymap, "aliasNames")), alias * NAME, NAME), name) {
            return keycodeOf(keymap, stored(bytesOf(keymap, @offsetOf(Keymap, "aliasTargets")), alias * NAME, NAME))
        }
        alias += 1
    }
    var keycode: usize = 0
    while keycode < MAX_KEYCODE {
        if std.text.same(keyName(keymap, @intCast(u32, keycode)), name) { return @intCast(u32, keycode) }
        keycode += 1
    }
    return 0
}

pub fn typeName(keymap: *Keymap, index: usize) -> []const u8 {
    return stored(bytesOf(keymap, @offsetOf(Keymap, "typeNames")), index * TYPE_NAME, TYPE_NAME)
}

pub fn typeIndex(keymap: *Keymap, name: []const u8) -> u8 {
    var index: usize = 0
    while index < keymap.*.typeCount {
        if std.text.same(typeName(keymap, index), name) { return @intCast(u8, index) }
        index += 1
    }
    return NO_TYPE
}

pub fn vmodName(keymap: *Keymap, index: usize) -> []const u8 {
    return stored(bytesOf(keymap, @offsetOf(Keymap, "vmodNames")), index * NAME, NAME)
}

pub fn groupName(keymap: *Keymap, group: usize) -> []const u8 {
    return stored(bytesOf(keymap, @offsetOf(Keymap, "groupNames")), group * GROUP_NAME, GROUP_NAME)
}

fn lowerByte(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }

fn sameIgnoringCase(left: []const u8, right: []const u8) -> bool {
    if left.length != right.length { return false }
    var index: usize = 0
    while index < left.length {
        if lowerByte(left[index]) != lowerByte(right[index]) { return false }
        index += 1
    }
    return true
}

// The mask of the modifier `name` (a real one, a virtual one, none, all);
// a virtual modifier not declared yet is declared. 0 for an unknown real
// name when there is no room.
pub fn modifierByName(keymap: *Keymap, name: []const u8) -> u32 {
    if sameIgnoringCase(name, "none") { return 0 }
    if sameIgnoringCase(name, "all") { return 16777215 }
    if sameIgnoringCase(name, "shift") { return SHIFT }
    if sameIgnoringCase(name, "lock") { return LOCK }
    if sameIgnoringCase(name, "control") || sameIgnoringCase(name, "ctrl") { return CONTROL }
    if sameIgnoringCase(name, "mod1") { return MOD1 }
    if sameIgnoringCase(name, "mod2") { return MOD2 }
    if sameIgnoringCase(name, "mod3") { return MOD3 }
    if sameIgnoringCase(name, "mod4") { return MOD4 }
    if sameIgnoringCase(name, "mod5") { return MOD5 }
    const index = vmodIndex(keymap, name)
    if index < 0 { return 0 }
    return @intCast(u32, 256) << @intCast(u5, index)
}

// The virtual modifier's index, declared when it is new (-1: no room).
pub fn vmodIndex(keymap: *Keymap, name: []const u8) -> i32 {
    var index: usize = 0
    while index < keymap.*.vmodCount {
        if std.text.same(vmodName(keymap, index), name) { return @intCast(i32, index) }
        index += 1
    }
    if keymap.*.vmodCount >= MAX_VMODS { return -1 }
    store(bytesOf(keymap, @offsetOf(Keymap, "vmodNames")), keymap.*.vmodCount * NAME, NAME, name)
    keymap.*.vmodCount += 1
    return @intCast(i32, keymap.*.vmodCount - 1)
}

// `mask` with its virtual modifiers replaced by the real ones they map to.
pub fn realMods(keymap: *Keymap, mask: u32) -> u32 {
    var real = mask & REAL_MODS
    var index: usize = 0
    while index < keymap.*.vmodCount {
        if mask & (@intCast(u32, 256) << @intCast(u5, index)) != 0 { real |= keymap.*.vmodMapping[index] }
        index += 1
    }
    return real
}

// ---------------------------------------------------------------------------
// Reading the text: tokens

const TOKEN_END: u8 = 0
const TOKEN_IDENT: u8 = 1
const TOKEN_NUMBER: u8 = 2
const TOKEN_STRING: u8 = 3
const TOKEN_KEYNAME: u8 = 4
const TOKEN_PUNCT: u8 = 5

const Parser = struct {
    keymap: *Keymap
    text: []const u8
    at: usize
    line: usize
    kind: u8
    start: usize
    end: usize
    number: u32
    // The interpretations' defaults (interpret.useModMapMods = ...).
    levelOne: bool
    repeat: bool
    failed: bool
}

fn isIdentByte(byte: u8) -> bool {
    return byte >= 97 && byte <= 122 || byte >= 65 && byte <= 90 || byte >= 48 && byte <= 57 || byte == 95
}

fn next(parser: *Parser) -> void {
    const text = parser.*.text
    while parser.*.at < text.length {
        const byte = text[parser.*.at]
        if byte == 10 {
            parser.*.line += 1
            parser.*.at += 1
        } else if byte == 32 || byte == 9 || byte == 13 {
            parser.*.at += 1
        } else if byte == 35 || byte == 47 && parser.*.at + 1 < text.length && text[parser.*.at + 1] == 47 {
            while parser.*.at < text.length && text[parser.*.at] != 10 { parser.*.at += 1 }
        } else {
            break
        }
    }
    parser.*.start = parser.*.at
    if parser.*.at >= text.length {
        parser.*.kind = TOKEN_END
        parser.*.end = parser.*.at
        return
    }
    const first = text[parser.*.at]
    if first == 34 {
        parser.*.at += 1
        parser.*.start = parser.*.at
        while parser.*.at < text.length && text[parser.*.at] != 34 {
            if text[parser.*.at] == 92 { parser.*.at += 1 }
            parser.*.at += 1
        }
        parser.*.end = if parser.*.at < text.length { parser.*.at } else { text.length }
        if parser.*.at < text.length { parser.*.at += 1 }
        parser.*.kind = TOKEN_STRING
        return
    }
    if first == 60 {
        parser.*.at += 1
        parser.*.start = parser.*.at
        while parser.*.at < text.length && text[parser.*.at] != 62 { parser.*.at += 1 }
        parser.*.end = parser.*.at
        if parser.*.at < text.length { parser.*.at += 1 }
        parser.*.kind = TOKEN_KEYNAME
        return
    }
    if first >= 48 && first <= 57 {
        var value: u32 = 0
        if first == 48 && parser.*.at + 1 < text.length && (text[parser.*.at + 1] == 120 || text[parser.*.at + 1] == 88) {
            parser.*.at += 2
            while parser.*.at < text.length && std.text.hexValue(text[parser.*.at]) < 16 {
                value = value * 16 + @intCast(u32, std.text.hexValue(text[parser.*.at]))
                parser.*.at += 1
            }
        } else {
            while parser.*.at < text.length && text[parser.*.at] >= 48 && text[parser.*.at] <= 57 {
                value = value * 10 + @intCast(u32, text[parser.*.at] - 48)
                parser.*.at += 1
            }
        }
        parser.*.number = value
        parser.*.end = parser.*.at
        parser.*.kind = TOKEN_NUMBER
        return
    }
    if isIdentByte(first) {
        while parser.*.at < text.length && isIdentByte(text[parser.*.at]) { parser.*.at += 1 }
        parser.*.end = parser.*.at
        parser.*.kind = TOKEN_IDENT
        return
    }
    parser.*.at += 1
    parser.*.end = parser.*.at
    parser.*.kind = TOKEN_PUNCT
}

fn token(parser: *Parser) -> []const u8 { return parser.*.text[parser.*.start..parser.*.end] }

fn isPunct(parser: *Parser, byte: u8) -> bool {
    return parser.*.kind == TOKEN_PUNCT && parser.*.text[parser.*.start] == byte
}

fn isWord(parser: *Parser, word: []const u8) -> bool {
    return parser.*.kind == TOKEN_IDENT && sameIgnoringCase(token(parser), word)
}

// Takes the punctuation `byte` if it comes next.
fn accept(parser: *Parser, byte: u8) -> bool {
    if !isPunct(parser, byte) { return false }
    next(parser)
    return true
}

fn expect(parser: *Parser, byte: u8) -> void {
    if !accept(parser, byte) { fail(parser) }
}

fn fail(parser: *Parser) -> void {
    if !parser.*.failed { parser.*.keymap.*.errorLine = parser.*.line + 1 }
    parser.*.failed = true
}

// Skips to after the `;` that ends the statement at hand (or to before the
// `}` that ends the block), past nested brackets.
fn skipStatement(parser: *Parser) -> void {
    var depth: usize = 0
    while parser.*.kind != TOKEN_END {
        if depth == 0 && isPunct(parser, 59) {
            next(parser)
            return
        }
        if depth == 0 && isPunct(parser, 125) { return }
        if isPunct(parser, 123) || isPunct(parser, 40) || isPunct(parser, 91) {
            depth += 1
        } else if (isPunct(parser, 125) || isPunct(parser, 41) || isPunct(parser, 93)) && depth > 0 {
            depth -= 1
        }
        next(parser)
    }
}

// ---------------------------------------------------------------------------
// Values

// A modifier expression: names joined by + or |.
fn parseMods(parser: *Parser) -> u32 {
    var mask: u32 = 0
    while true {
        if parser.*.kind == TOKEN_IDENT {
            mask |= modifierByName(parser.*.keymap, token(parser))
            next(parser)
        } else if parser.*.kind == TOKEN_NUMBER {
            mask |= parser.*.number
            next(parser)
        } else {
            fail(parser)
            return mask
        }
        if !accept(parser, 43) && !accept(parser, 124) { return mask }
    }
    return mask
}

// A level ("2", "Level2"), from 0.
fn parseLevel(parser: *Parser) -> u32 {
    var value: u32 = 0
    if parser.*.kind == TOKEN_NUMBER {
        value = parser.*.number
    } else if parser.*.kind == TOKEN_IDENT && token(parser).length > 5 && sameIgnoringCase(token(parser)[0..5], "level") {
        value = numberIn(token(parser)[5..token(parser).length])
    } else {
        fail(parser)
    }
    next(parser)
    return if value > 0 { value - 1 } else { 0 }
}

// A group ("1", "Group1"), from 0.
fn parseGroup(parser: *Parser) -> u32 {
    var value: u32 = 0
    if parser.*.kind == TOKEN_NUMBER {
        value = parser.*.number
    } else if parser.*.kind == TOKEN_IDENT && token(parser).length > 5 && sameIgnoringCase(token(parser)[0..5], "group") {
        value = numberIn(token(parser)[5..token(parser).length])
    } else {
        fail(parser)
    }
    next(parser)
    return if value > 0 { value - 1 } else { 0 }
}

fn numberIn(text: []const u8) -> u32 {
    var value: u32 = 0
    for byte in text {
        if byte < 48 || byte > 57 { return 0 }
        value = value * 10 + @intCast(u32, byte - 48)
    }
    return value
}

fn parseBool(parser: *Parser) -> bool {
    const value = isWord(parser, "true") || isWord(parser, "yes") || isWord(parser, "on")
    next(parser)
    return value
}

// A keysym in a symbols list: a name, a single digit (that digit's
// keysym) or a number (the keysym's value).
fn parseKeysym(parser: *Parser) -> u32 {
    var value: u32 = 0
    if parser.*.kind == TOKEN_NUMBER {
        value = if parser.*.end - parser.*.start == 1 { 48 + parser.*.number } else { parser.*.number }
    } else if parser.*.kind == TOKEN_IDENT {
        const name = token(parser)
        if sameIgnoringCase(name, "NoSymbol") {
            value = 0
        } else if sameIgnoringCase(name, "VoidSymbol") {
            value = keysym.VOID_SYMBOL
        } else {
            value = keysym.fromName(parser.*.keymap.*.names, name)
        }
    } else {
        fail(parser)
    }
    next(parser)
    return value
}

// An action: Name(argument, name=value, ...). Only the modifier and group
// actions do anything here; the others are read as no action.
fn parseAction(parser: *Parser, kind: *u8, flags: *u8, mods: *u32, group: *i32) -> void {
    kind.* = ACTION_NONE
    flags.* = 0
    mods.* = 0
    group.* = 0
    if parser.*.kind != TOKEN_IDENT {
        fail(parser)
        return
    }
    if isWord(parser, "SetMods") { kind.* = ACTION_SET_MODS }
    if isWord(parser, "LatchMods") { kind.* = ACTION_LATCH_MODS }
    if isWord(parser, "LockMods") { kind.* = ACTION_LOCK_MODS }
    if isWord(parser, "SetGroup") { kind.* = ACTION_SET_GROUP }
    if isWord(parser, "LatchGroup") { kind.* = ACTION_LATCH_GROUP }
    if isWord(parser, "LockGroup") { kind.* = ACTION_LOCK_GROUP }
    next(parser)
    expect(parser, 40)
    while !parser.*.failed && !isPunct(parser, 41) && parser.*.kind != TOKEN_END {
        var negated = false
        if accept(parser, 33) || accept(parser, 126) { negated = true }
        if parser.*.kind != TOKEN_IDENT {
            skipArgument(parser)
        } else {
            const name = token(parser)
            next(parser)
            // An indexed argument (Private's data[0]=...).
            if accept(parser, 91) {
                while parser.*.kind != TOKEN_END && !accept(parser, 93) { next(parser) }
            }
            var on = !negated
            if sameIgnoringCase(name, "modifiers") || sameIgnoringCase(name, "mods") {
                expect(parser, 61)
                if isWord(parser, "modMapMods") || isWord(parser, "useModMapMods") {
                    flags.* |= FLAG_MODMAP_MODS
                    next(parser)
                } else {
                    mods.* = parseMods(parser)
                }
            } else if sameIgnoringCase(name, "group") {
                expect(parser, 61)
                var sign: i32 = 0
                if accept(parser, 43) { sign = 1 } else if accept(parser, 45) { sign = -1 }
                const value = @intCast(i32, parseGroup(parser)) + 1
                if sign == 0 {
                    flags.* |= FLAG_GROUP_ABSOLUTE
                    group.* = value - 1
                } else {
                    group.* = sign * value
                }
            } else if sameIgnoringCase(name, "clearLocks") || sameIgnoringCase(name, "clearmods") {
                if accept(parser, 61) { on = parseBool(parser) }
                if on { flags.* |= FLAG_CLEAR_LOCKS }
            } else if sameIgnoringCase(name, "latchToLock") {
                if accept(parser, 61) { on = parseBool(parser) }
                if on { flags.* |= FLAG_LATCH_TO_LOCK }
            } else if sameIgnoringCase(name, "affect") {
                expect(parser, 61)
                if isWord(parser, "lock") { flags.* |= FLAG_LOCK_NO_UNLOCK }
                if isWord(parser, "unlock") { flags.* |= FLAG_LOCK_NO_LOCK }
                if isWord(parser, "neither") { flags.* |= FLAG_LOCK_NO_LOCK | FLAG_LOCK_NO_UNLOCK }
                next(parser)
            } else {
                if accept(parser, 61) { skipArgument(parser) }
            }
        }
        if !accept(parser, 44) { break }
    }
    expect(parser, 41)
}

// Skips one action argument's value, to the `,` or `)` after it.
fn skipArgument(parser: *Parser) -> void {
    var depth: usize = 0
    while parser.*.kind != TOKEN_END {
        if depth == 0 && (isPunct(parser, 44) || isPunct(parser, 41)) { return }
        if isPunct(parser, 40) || isPunct(parser, 91) { depth += 1 }
        if (isPunct(parser, 41) || isPunct(parser, 93)) && depth > 0 { depth -= 1 }
        next(parser)
    }
}

// ---------------------------------------------------------------------------
// The sections

pub fn parse(keymap: *Keymap, text: []const u8) -> bool {
    var parser = Parser.{ .keymap = keymap, .text = text, .at = 0, .line = 0, .kind = TOKEN_END, .start = 0, .end = 0, .number = 0, .levelOne = false, .repeat = false, .failed = false }
    next(&parser)
    if !isWord(&parser, "xkb_keymap") {
        fail(&parser)
        return false
    }
    next(&parser)
    if parser.kind == TOKEN_STRING { next(&parser) }
    expect(&parser, 123)
    while !parser.failed && parser.kind != TOKEN_END && !isPunct(&parser, 125) {
        if isWord(&parser, "xkb_keycodes") {
            section(&parser, 0)
        } else if isWord(&parser, "xkb_types") {
            section(&parser, 1)
        } else if isWord(&parser, "xkb_compatibility") || isWord(&parser, "xkb_compat") || isWord(&parser, "xkb_compatibility_map") {
            section(&parser, 2)
        } else if isWord(&parser, "xkb_symbols") {
            section(&parser, 3)
        } else {
            skipStatement(&parser)
        }
    }
    if parser.failed { return false }
    finish(keymap)
    return true
}

fn section(parser: *Parser, which: u8) -> void {
    next(parser)
    if parser.*.kind == TOKEN_STRING { next(parser) }
    expect(parser, 123)
    while !parser.*.failed && parser.*.kind != TOKEN_END && !isPunct(parser, 125) {
        if which == 0 {
            keycodesStatement(parser)
        } else if which == 1 {
            typesStatement(parser)
        } else if which == 2 {
            compatStatement(parser)
        } else {
            symbolsStatement(parser)
        }
    }
    expect(parser, 125)
    expect(parser, 59)
}

fn keycodesStatement(parser: *Parser) -> void {
    const keymap = parser.*.keymap
    if parser.*.kind == TOKEN_KEYNAME {
        const name = token(parser)
        next(parser)
        expect(parser, 61)
        if parser.*.kind == TOKEN_NUMBER && parser.*.number < @intCast(u32, MAX_KEYCODE) {
            store(bytesOf(keymap, @offsetOf(Keymap, "keyNames")), @intCast(usize, parser.*.number) * NAME, NAME, name)
        }
        skipStatement(parser)
        return
    }
    if isWord(parser, "minimum") || isWord(parser, "maximum") {
        const minimum = isWord(parser, "minimum")
        next(parser)
        expect(parser, 61)
        if parser.*.kind == TOKEN_NUMBER {
            if minimum { keymap.*.minKeycode = parser.*.number } else { keymap.*.maxKeycode = parser.*.number }
        }
        skipStatement(parser)
        return
    }
    if isWord(parser, "alias") {
        next(parser)
        if parser.*.kind == TOKEN_KEYNAME && keymap.*.aliasCount < MAX_ALIASES {
            const alias = token(parser)
            next(parser)
            expect(parser, 61)
            if parser.*.kind == TOKEN_KEYNAME {
                store(bytesOf(keymap, @offsetOf(Keymap, "aliasNames")), keymap.*.aliasCount * NAME, NAME, alias)
                store(bytesOf(keymap, @offsetOf(Keymap, "aliasTargets")), keymap.*.aliasCount * NAME, NAME, token(parser))
                keymap.*.aliasCount += 1
            }
        }
        skipStatement(parser)
        return
    }
    skipStatement(parser)
}

// virtual_modifiers A, B = Mod2, ...;
fn virtualModifiers(parser: *Parser) -> void {
    const keymap = parser.*.keymap
    next(parser)
    while parser.*.kind == TOKEN_IDENT {
        const index = vmodIndex(keymap, token(parser))
        next(parser)
        if accept(parser, 61) {
            const given = parseMods(parser)
            if index >= 0 { keymap.*.vmodGiven[@intCast(usize, index)] |= realMods(keymap, given) }
        }
        if !accept(parser, 44) { break }
    }
    skipStatement(parser)
}

fn typesStatement(parser: *Parser) -> void {
    const keymap = parser.*.keymap
    if isWord(parser, "virtual_modifiers") {
        virtualModifiers(parser)
        return
    }
    if !isWord(parser, "type") {
        skipStatement(parser)
        return
    }
    next(parser)
    if parser.*.kind != TOKEN_STRING || keymap.*.typeCount >= MAX_TYPES {
        fail(parser)
        return
    }
    // A type defined again replaces the one before.
    var index = @intCast(usize, typeIndex(keymap, token(parser)))
    if index == @intCast(usize, NO_TYPE) {
        index = keymap.*.typeCount
        keymap.*.typeCount += 1
        store(bytesOf(keymap, @offsetOf(Keymap, "typeNames")), index * TYPE_NAME, TYPE_NAME, token(parser))
    }
    keymap.*.typeMods[index] = 0
    keymap.*.typeLevels[index] = 1
    keymap.*.typeEntryCount[index] = 0
    next(parser)
    expect(parser, 123)
    while !parser.*.failed && parser.*.kind != TOKEN_END && !isPunct(parser, 125) {
        if isWord(parser, "modifiers") {
            next(parser)
            expect(parser, 61)
            keymap.*.typeMods[index] = parseMods(parser)
            skipStatement(parser)
        } else if isWord(parser, "map") || isWord(parser, "preserve") {
            const map = isWord(parser, "map")
            next(parser)
            expect(parser, 91)
            const mods = parseMods(parser)
            expect(parser, 93)
            expect(parser, 61)
            // The entry for these modifiers (a new one when there is none).
            var entry: usize = 0
            const base = index * MAX_ENTRIES
            while entry < @intCast(usize, keymap.*.typeEntryCount[index]) && keymap.*.entryMods[base + entry] != mods { entry += 1 }
            if entry == @intCast(usize, keymap.*.typeEntryCount[index]) && entry < MAX_ENTRIES {
                keymap.*.entryMods[base + entry] = mods
                keymap.*.entryLevel[base + entry] = 0
                keymap.*.entryPreserve[base + entry] = 0
                keymap.*.typeEntryCount[index] += 1
            }
            if entry < MAX_ENTRIES {
                if map {
                    const level = parseLevel(parser)
                    keymap.*.entryLevel[base + entry] = @intCast(u8, level)
                    if level + 1 > @intCast(u32, keymap.*.typeLevels[index]) { keymap.*.typeLevels[index] = @intCast(u8, level + 1) }
                } else {
                    keymap.*.entryPreserve[base + entry] = parseMods(parser)
                }
            }
            skipStatement(parser)
        } else if isWord(parser, "level_name") {
            next(parser)
            expect(parser, 91)
            const level = parseLevel(parser)
            if level + 1 > @intCast(u32, keymap.*.typeLevels[index]) && level < @intCast(u32, MAX_LEVELS) { keymap.*.typeLevels[index] = @intCast(u8, level + 1) }
            skipStatement(parser)
        } else {
            skipStatement(parser)
        }
    }
    expect(parser, 125)
    expect(parser, 59)
}

fn compatStatement(parser: *Parser) -> void {
    const keymap = parser.*.keymap
    if isWord(parser, "virtual_modifiers") {
        virtualModifiers(parser)
        return
    }
    if !isWord(parser, "interpret") {
        skipStatement(parser)
        return
    }
    next(parser)
    // Defaults: interpret.useModMapMods = ..., interpret.repeat = ...
    if accept(parser, 46) {
        if isWord(parser, "useModMapMods") {
            next(parser)
            expect(parser, 61)
            parser.*.levelOne = isWord(parser, "level1") || isWord(parser, "levelone")
        } else if isWord(parser, "repeat") {
            next(parser)
            expect(parser, 61)
            parser.*.repeat = isWord(parser, "true") || isWord(parser, "yes")
        }
        skipStatement(parser)
        return
    }
    if keymap.*.interpretCount >= MAX_INTERPRETS {
        skipStatement(parser)
        return
    }
    const index = keymap.*.interpretCount
    keymap.*.interpretCount += 1
    keymap.*.interpretAny[index] = isWord(parser, "Any")
    keymap.*.interpretSym[index] = if isWord(parser, "Any") { 0 } else { parseKeysymValue(parser) }
    next(parser)
    keymap.*.interpretMatch[index] = MATCH_ANY_OR_NONE
    keymap.*.interpretMods[index] = REAL_MODS
    if accept(parser, 43) {
        // Sym+Predicate(mods); a bare Sym+mods means Exactly(mods).
        var predicate = MATCH_EXACTLY
        var named = true
        if isWord(parser, "AnyOfOrNone") { predicate = MATCH_ANY_OR_NONE } else if isWord(parser, "AnyOf") { predicate = MATCH_ANY } else if isWord(parser, "AllOf") { predicate = MATCH_ALL } else if isWord(parser, "NoneOf") { predicate = MATCH_NONE } else if isWord(parser, "Exactly") { predicate = MATCH_EXACTLY } else { named = false }
        if named {
            next(parser)
            expect(parser, 40)
            keymap.*.interpretMods[index] = parseMods(parser) & REAL_MODS
            expect(parser, 41)
        } else {
            keymap.*.interpretMods[index] = parseMods(parser) & REAL_MODS
        }
        keymap.*.interpretMatch[index] = predicate
    }
    keymap.*.interpretVmod[index] = -1
    keymap.*.interpretLevelOne[index] = parser.*.levelOne
    keymap.*.interpretRepeat[index] = parser.*.repeat
    keymap.*.interpretActionKind[index] = ACTION_NONE
    expect(parser, 123)
    while !parser.*.failed && parser.*.kind != TOKEN_END && !isPunct(parser, 125) {
        if isWord(parser, "useModMapMods") {
            next(parser)
            expect(parser, 61)
            keymap.*.interpretLevelOne[index] = isWord(parser, "level1") || isWord(parser, "levelone")
            skipStatement(parser)
        } else if isWord(parser, "virtualModifier") || isWord(parser, "virtualMod") {
            next(parser)
            expect(parser, 61)
            if parser.*.kind == TOKEN_IDENT { keymap.*.interpretVmod[index] = vmodIndex(keymap, token(parser)) }
            skipStatement(parser)
        } else if isWord(parser, "repeat") {
            next(parser)
            expect(parser, 61)
            keymap.*.interpretRepeat[index] = parseBool(parser)
            skipStatement(parser)
        } else if isWord(parser, "action") {
            next(parser)
            expect(parser, 61)
            var kind: u8 = 0
            var flags: u8 = 0
            var mods: u32 = 0
            var group: i32 = 0
            parseAction(parser, &kind, &flags, &mods, &group)
            keymap.*.interpretActionKind[index] = kind
            keymap.*.interpretActionFlags[index] = flags
            keymap.*.interpretActionMods[index] = mods
            keymap.*.interpretActionGroup[index] = group
            skipStatement(parser)
        } else {
            skipStatement(parser)
        }
    }
    expect(parser, 125)
    expect(parser, 59)
}

// The keysym named by the token at hand (not taking it).
fn parseKeysymValue(parser: *Parser) -> u32 {
    if parser.*.kind == TOKEN_NUMBER { return if parser.*.end - parser.*.start == 1 { 48 + parser.*.number } else { parser.*.number } }
    if parser.*.kind != TOKEN_IDENT { return 0 }
    if sameIgnoringCase(token(parser), "NoSymbol") { return 0 }
    if sameIgnoringCase(token(parser), "VoidSymbol") { return keysym.VOID_SYMBOL }
    return keysym.fromName(parser.*.keymap.*.names, token(parser))
}

fn symbolsStatement(parser: *Parser) -> void {
    const keymap = parser.*.keymap
    if isWord(parser, "name") {
        next(parser)
        expect(parser, 91)
        const group = parseGroup(parser)
        expect(parser, 93)
        expect(parser, 61)
        if parser.*.kind == TOKEN_STRING && group < @intCast(u32, MAX_GROUPS) {
            store(bytesOf(keymap, @offsetOf(Keymap, "groupNames")), @intCast(usize, group) * GROUP_NAME, GROUP_NAME, token(parser))
        }
        skipStatement(parser)
        return
    }
    if isWord(parser, "key") {
        next(parser)
        if parser.*.kind != TOKEN_KEYNAME {
            skipStatement(parser)
            return
        }
        const keycode = keycodeOf(keymap, token(parser))
        next(parser)
        keyBody(parser, keycode)
        return
    }
    if isWord(parser, "modifier_map") || isWord(parser, "modmap") || isWord(parser, "mod_map") {
        next(parser)
        const mods = modifierByName(keymap, token(parser)) & REAL_MODS
        next(parser)
        expect(parser, 123)
        while !parser.*.failed && parser.*.kind != TOKEN_END && !isPunct(parser, 125) {
            if parser.*.kind == TOKEN_KEYNAME {
                const keycode = keycodeOf(keymap, token(parser))
                if keycode != 0 { keymap.*.keyModmap[@intCast(usize, keycode)] |= @intCast(u8, mods) }
                next(parser)
            } else {
                const keycode = keycodeOfSym(keymap, parseKeysymValue(parser))
                if keycode != 0 { keymap.*.keyModmap[@intCast(usize, keycode)] |= @intCast(u8, mods) }
                next(parser)
            }
            if !accept(parser, 44) { break }
        }
        expect(parser, 125)
        expect(parser, 59)
        return
    }
    skipStatement(parser)
}

// The key that types `sym` with the lowest group and level (0: none).
fn keycodeOfSym(keymap: *Keymap, sym: u32) -> u32 {
    if sym == 0 { return 0 }
    var slot: usize = 0
    while slot < SLOTS {
        var keycode: usize = 0
        while keycode < MAX_KEYCODE {
            const at = keycode * SLOTS + slot
            if keymap.*.slotCount[at] > 0 && keymap.*.syms[@intCast(usize, keymap.*.slotFirst[at])] == sym { return @intCast(u32, keycode) }
            keycode += 1
        }
        slot += 1
    }
    return 0
}

fn keyBody(parser: *Parser, keycode: u32) -> void {
    const keymap = parser.*.keymap
    const key = @intCast(usize, keycode)
    // A key the symbols define repeats unless something says otherwise
    // (keys they leave out do not).
    if key < MAX_KEYCODE && keymap.*.keyExplicit[key] & EXPLICIT_REPEAT == 0 { keymap.*.keyRepeats[key] = true }
    expect(parser, 123)
    var implicit: u32 = 0
    while !parser.*.failed && parser.*.kind != TOKEN_END && !isPunct(parser, 125) {
        if isPunct(parser, 91) {
            symbolList(parser, key, implicit)
            implicit += 1
        } else if isWord(parser, "symbols") || isWord(parser, "actions") {
            const actions = isWord(parser, "actions")
            next(parser)
            var group: u32 = 0
            if accept(parser, 91) {
                group = parseGroup(parser)
                expect(parser, 93)
            }
            expect(parser, 61)
            if actions { actionList(parser, key, group) } else { symbolList(parser, key, group) }
        } else if isWord(parser, "type") {
            next(parser)
            var group: u32 = 0
            var every = true
            if accept(parser, 91) {
                group = parseGroup(parser)
                every = false
                expect(parser, 93)
            }
            expect(parser, 61)
            const type_index = typeIndex(keymap, token(parser))
            next(parser)
            if type_index != NO_TYPE && key < MAX_KEYCODE {
                var g: usize = 0
                while g < MAX_GROUPS {
                    if every || g == @intCast(usize, group) {
                        keymap.*.keyTypes[key * MAX_GROUPS + g] = type_index
                        keymap.*.keyExplicit[key] |= EXPLICIT_TYPE << @intCast(u4, g)
                    }
                    g += 1
                }
            }
        } else if isWord(parser, "virtualMods") || isWord(parser, "vmods") || isWord(parser, "virtualModifiers") {
            next(parser)
            expect(parser, 61)
            const mods = parseMods(parser)
            if key < MAX_KEYCODE {
                keymap.*.keyVmodmap[key] = mods & 16776960
                keymap.*.keyExplicit[key] |= EXPLICIT_VMODMAP
            }
        } else if isWord(parser, "repeat") || isWord(parser, "repeats") {
            next(parser)
            expect(parser, 61)
            const value = isWord(parser, "true") || isWord(parser, "yes") || isWord(parser, "on")
            next(parser)
            if key < MAX_KEYCODE {
                keymap.*.keyRepeats[key] = value
                keymap.*.keyExplicit[key] |= EXPLICIT_REPEAT
            }
        } else if isWord(parser, "groupsWrap") || isWord(parser, "wrapGroups") {
            next(parser)
            if key < MAX_KEYCODE { keymap.*.keyRange[key] = RANGE_WRAP }
        } else if isWord(parser, "groupsClamp") || isWord(parser, "clampGroups") {
            next(parser)
            if key < MAX_KEYCODE { keymap.*.keyRange[key] = RANGE_CLAMP }
        } else if isWord(parser, "groupsRedirect") || isWord(parser, "redirectGroups") {
            next(parser)
            expect(parser, 61)
            const group = parseGroup(parser)
            if key < MAX_KEYCODE {
                keymap.*.keyRange[key] = RANGE_REDIRECT
                keymap.*.keyRedirect[key] = @intCast(u8, group)
            }
        } else {
            // Anything else (overlays, radio groups, locks): its value.
            next(parser)
            if accept(parser, 91) {
                while parser.*.kind != TOKEN_END && !accept(parser, 93) { next(parser) }
            }
            if accept(parser, 61) { skipValue(parser) }
        }
        if !accept(parser, 44) { break }
    }
    expect(parser, 125)
    expect(parser, 59)
}

// Skips a value up to the `,` or `}` after it.
fn skipValue(parser: *Parser) -> void {
    var depth: usize = 0
    while parser.*.kind != TOKEN_END {
        if depth == 0 && (isPunct(parser, 44) || isPunct(parser, 125)) { return }
        if isPunct(parser, 40) || isPunct(parser, 91) || isPunct(parser, 123) { depth += 1 }
        if (isPunct(parser, 41) || isPunct(parser, 93) || isPunct(parser, 125)) && depth > 0 { depth -= 1 }
        next(parser)
    }
}

// [ sym, sym, { sym, sym }, ... ] into the key's group.
fn symbolList(parser: *Parser, key: usize, group: u32) -> void {
    const keymap = parser.*.keymap
    expect(parser, 91)
    var level: usize = 0
    while !parser.*.failed && parser.*.kind != TOKEN_END && !isPunct(parser, 93) {
        const ok = key < MAX_KEYCODE && group < @intCast(u32, MAX_GROUPS) && level < MAX_LEVELS
        const slot = key * SLOTS + @intCast(usize, group) * MAX_LEVELS + level
        if ok {
            keymap.*.slotFirst[slot] = @intCast(u32, keymap.*.symCount)
            keymap.*.slotCount[slot] = 0
        }
        if accept(parser, 123) {
            while !parser.*.failed && parser.*.kind != TOKEN_END && !isPunct(parser, 125) {
                addSym(keymap, ok, slot, parseKeysym(parser))
                if !accept(parser, 44) { break }
            }
            expect(parser, 125)
        } else {
            addSym(keymap, ok, slot, parseKeysym(parser))
        }
        level += 1
        if !accept(parser, 44) { break }
    }
    expect(parser, 93)
    if key < MAX_KEYCODE && group < @intCast(u32, MAX_GROUPS) {
        if level > MAX_LEVELS { level = MAX_LEVELS }
        if level > @intCast(usize, keymap.*.keyWidth[key * MAX_GROUPS + @intCast(usize, group)]) { keymap.*.keyWidth[key * MAX_GROUPS + @intCast(usize, group)] = @intCast(u8, level) }
        if @intCast(usize, group) + 1 > @intCast(usize, keymap.*.keyGroups[key]) { keymap.*.keyGroups[key] = @intCast(u8, group + 1) }
    }
}

fn addSym(keymap: *Keymap, ok: bool, slot: usize, sym: u32) -> void {
    // NoSymbol in a list of one leaves the level empty.
    if !ok || sym == 0 || keymap.*.symCount >= MAX_SYMS { return }
    keymap.*.syms[keymap.*.symCount] = sym
    keymap.*.symCount += 1
    keymap.*.slotCount[slot] += 1
}

// [ Action(...), ... ] into the key's group; they replace what the
// compatibility map would give the key.
fn actionList(parser: *Parser, key: usize, group: u32) -> void {
    const keymap = parser.*.keymap
    expect(parser, 91)
    var level: usize = 0
    while !parser.*.failed && parser.*.kind != TOKEN_END && !isPunct(parser, 93) {
        var kind: u8 = 0
        var flags: u8 = 0
        var mods: u32 = 0
        var action_group: i32 = 0
        parseAction(parser, &kind, &flags, &mods, &action_group)
        if key < MAX_KEYCODE && group < @intCast(u32, MAX_GROUPS) && level < MAX_LEVELS {
            const slot = key * SLOTS + @intCast(usize, group) * MAX_LEVELS + level
            keymap.*.actionKind[slot] = kind
            keymap.*.actionFlags[slot] = flags
            keymap.*.actionMods[slot] = mods
            keymap.*.actionGroup[slot] = action_group
        }
        level += 1
        if !accept(parser, 44) { break }
    }
    expect(parser, 93)
    if key < MAX_KEYCODE {
        keymap.*.keyExplicit[key] |= EXPLICIT_INTERP
        if group < @intCast(u32, MAX_GROUPS) && @intCast(usize, group) + 1 > @intCast(usize, keymap.*.keyGroups[key]) { keymap.*.keyGroups[key] = @intCast(u8, group + 1) }
        if group < @intCast(u32, MAX_GROUPS) && level > @intCast(usize, keymap.*.keyWidth[key * MAX_GROUPS + @intCast(usize, group)]) && level <= MAX_LEVELS {
            keymap.*.keyWidth[key * MAX_GROUPS + @intCast(usize, group)] = @intCast(u8, level)
        }
    }
}

// ---------------------------------------------------------------------------
// After reading: types for keys without one, the compatibility map's
// actions and virtual modifiers, the virtual modifiers' real ones

// The first keysym of a level (NoSymbol when it has none).
pub fn levelSym(keymap: *Keymap, keycode: usize, group: usize, level: usize) -> u32 {
    const slot = keycode * SLOTS + group * MAX_LEVELS + level
    if level >= MAX_LEVELS || keymap.*.slotCount[slot] == 0 { return 0 }
    return keymap.*.syms[@intCast(usize, keymap.*.slotFirst[slot])]
}

// libxkbcommon's automatic type (FindAutomaticType).
fn automaticType(keymap: *Keymap, key: usize, group: usize) -> u8 {
    const names = keymap.*.names
    const width = @intCast(usize, keymap.*.keyWidth[key * MAX_GROUPS + group])
    // A level counts by its keysym when it has exactly one.
    const sym0 = slotTypeSym(keymap, key, group, 0)
    const sym1 = slotTypeSym(keymap, key, group, 1)
    if width <= 1 { return typeIndex(keymap, "ONE_LEVEL") }
    if width == 2 {
        if keysym.isLower(names, sym0) && keysym.isUpper(names, sym1) { return typeIndex(keymap, "ALPHABETIC") }
        if keysym.isKeypad(sym0) || keysym.isKeypad(sym1) { return typeIndex(keymap, "KEYPAD") }
        return typeIndex(keymap, "TWO_LEVEL")
    }
    if width <= 4 {
        const sym2 = slotTypeSym(keymap, key, group, 2)
        const sym3 = if width == 4 { slotTypeSym(keymap, key, group, 3) } else { 0 }
        if keysym.isLower(names, sym0) && keysym.isUpper(names, sym1) {
            if keysym.isLower(names, sym2) && keysym.isUpper(names, sym3) { return typeIndex(keymap, "FOUR_LEVEL_ALPHABETIC") }
            return typeIndex(keymap, "FOUR_LEVEL_SEMIALPHABETIC")
        }
        if keysym.isKeypad(sym0) || keysym.isKeypad(sym1) { return typeIndex(keymap, "FOUR_LEVEL_KEYPAD") }
        return typeIndex(keymap, "FOUR_LEVEL")
    }
    return NO_TYPE
}

// The keysym a level counts as for the automatic type: its only keysym
// (none when it has several).
fn slotTypeSym(keymap: *Keymap, key: usize, group: usize, level: usize) -> u32 {
    const slot = key * SLOTS + group * MAX_LEVELS + level
    if keymap.*.slotCount[slot] != 1 { return 0 }
    return keymap.*.syms[@intCast(usize, keymap.*.slotFirst[slot])]
}

// The interpretation for a key's level (libxkbcommon's FindInterpForKey):
// the first, most specific first, whose keysym and modifiers match;
// MAX_INTERPRETS when none does.
fn interpretFor(keymap: *Keymap, key: usize, group: usize, level: usize) -> usize {
    const slot = key * SLOTS + group * MAX_LEVELS + level
    const count = @intCast(usize, keymap.*.slotCount[slot])
    if count == 0 { return MAX_INTERPRETS }
    const sym = keymap.*.syms[@intCast(usize, keymap.*.slotFirst[slot])]
    var index: usize = 0
    while index < keymap.*.interpretCount {
        if !keymap.*.interpretAny[index] && (count > 1 || keymap.*.interpretSym[index] != sym) {
            index += 1
            continue
        }
        const mods: u32 = if keymap.*.interpretLevelOne[index] && level != 0 { 0 } else { @intCast(u32, keymap.*.keyModmap[key]) }
        const wanted = keymap.*.interpretMods[index]
        const predicate = keymap.*.interpretMatch[index]
        var found = false
        if predicate == MATCH_NONE { found = wanted & mods == 0 }
        if predicate == MATCH_ANY_OR_NONE { found = mods == 0 || wanted & mods != 0 }
        if predicate == MATCH_ANY { found = wanted & mods != 0 }
        if predicate == MATCH_ALL { found = wanted & mods == wanted }
        if predicate == MATCH_EXACTLY { found = wanted == mods }
        if found { return index }
        index += 1
    }
    return MAX_INTERPRETS
}

// Orders the interpretations most specific first, as libxkbcommon: those
// for a keysym before those for any; within each, Exactly, AllOf, NoneOf,
// AnyOf, AnyOfOrNone; otherwise as the text gave them.
fn sortInterprets(keymap: *Keymap) -> void {
    var order: [256]u8 = undefined
    var count: usize = 0
    var pass: usize = 0
    while pass < 10 {
        const any = pass >= 5
        const predicate = match pass % 5 { 0 => MATCH_EXACTLY, 1 => MATCH_ALL, 2 => MATCH_NONE, 3 => MATCH_ANY, else => MATCH_ANY_OR_NONE }
        var index: usize = 0
        while index < keymap.*.interpretCount {
            if keymap.*.interpretAny[index] == any && keymap.*.interpretMatch[index] == predicate {
                order[count] = @intCast(u8, index)
                count += 1
            }
            index += 1
        }
        pass += 1
    }
    var sym: [256]u32 = undefined
    var anyOf: [256]bool = undefined
    var matchOf: [256]u8 = undefined
    var mods: [256]u32 = undefined
    var vmod: [256]i32 = undefined
    var levelOne: [256]bool = undefined
    var repeat: [256]bool = undefined
    var kind: [256]u8 = undefined
    var flags: [256]u8 = undefined
    var actionMods: [256]u32 = undefined
    var group: [256]i32 = undefined
    var index: usize = 0
    while index < count {
        const from = @intCast(usize, order[index])
        sym[index] = keymap.*.interpretSym[from]
        anyOf[index] = keymap.*.interpretAny[from]
        matchOf[index] = keymap.*.interpretMatch[from]
        mods[index] = keymap.*.interpretMods[from]
        vmod[index] = keymap.*.interpretVmod[from]
        levelOne[index] = keymap.*.interpretLevelOne[from]
        repeat[index] = keymap.*.interpretRepeat[from]
        kind[index] = keymap.*.interpretActionKind[from]
        flags[index] = keymap.*.interpretActionFlags[from]
        actionMods[index] = keymap.*.interpretActionMods[from]
        group[index] = keymap.*.interpretActionGroup[from]
        index += 1
    }
    index = 0
    while index < count {
        keymap.*.interpretSym[index] = sym[index]
        keymap.*.interpretAny[index] = anyOf[index]
        keymap.*.interpretMatch[index] = matchOf[index]
        keymap.*.interpretMods[index] = mods[index]
        keymap.*.interpretVmod[index] = vmod[index]
        keymap.*.interpretLevelOne[index] = levelOne[index]
        keymap.*.interpretRepeat[index] = repeat[index]
        keymap.*.interpretActionKind[index] = kind[index]
        keymap.*.interpretActionFlags[index] = flags[index]
        keymap.*.interpretActionMods[index] = actionMods[index]
        keymap.*.interpretActionGroup[index] = group[index]
        index += 1
    }
    keymap.*.interpretCount = count
}

pub fn finish(keymap: *Keymap) -> void {
    sortInterprets(keymap)
    var groups: usize = 0
    var key: usize = 0
    while key < MAX_KEYCODE {
        const key_groups = @intCast(usize, keymap.*.keyGroups[key])
        if key_groups > groups { groups = key_groups }
        // Types: the given ones, else by what the group types.
        var group: usize = 0
        while group < key_groups {
            if keymap.*.keyTypes[key * MAX_GROUPS + group] == NO_TYPE {
                var automatic = automaticType(keymap, key, group)
                if automatic == NO_TYPE { automatic = typeIndex(keymap, "ONE_LEVEL") }
                keymap.*.keyTypes[key * MAX_GROUPS + group] = automatic
            }
            group += 1
        }
        // Keys of a modifier do not repeat unless the text says so.
        if keymap.*.keyExplicit[key] & EXPLICIT_REPEAT == 0 && keymap.*.keyModmap[key] != 0 { keymap.*.keyRepeats[key] = false }
        // The compatibility map's interpretations (ApplyInterpsToKey).
        if keymap.*.keyExplicit[key] & EXPLICIT_INTERP == 0 && key_groups > 0 {
            var vmodmap: u32 = 0
            group = 0
            while group < key_groups {
                var level: usize = 0
                while level < @intCast(usize, keymap.*.keyWidth[key * MAX_GROUPS + group]) {
                    const interpret = interpretFor(keymap, key, group, level)
                    if interpret < MAX_INTERPRETS {
                        if group == 0 && level == 0 && keymap.*.keyExplicit[key] & EXPLICIT_REPEAT == 0 {
                            keymap.*.keyRepeats[key] = keymap.*.interpretRepeat[interpret]
                        }
                        if (group == 0 && level == 0 || !keymap.*.interpretLevelOne[interpret]) && keymap.*.interpretVmod[interpret] >= 0 {
                            vmodmap |= @intCast(u32, 256) << @intCast(u5, keymap.*.interpretVmod[interpret])
                        }
                        if keymap.*.interpretActionKind[interpret] != ACTION_NONE {
                            const slot = key * SLOTS + group * MAX_LEVELS + level
                            keymap.*.actionKind[slot] = keymap.*.interpretActionKind[interpret]
                            keymap.*.actionFlags[slot] = keymap.*.interpretActionFlags[interpret]
                            keymap.*.actionMods[slot] = keymap.*.interpretActionMods[interpret]
                            keymap.*.actionGroup[slot] = keymap.*.interpretActionGroup[interpret]
                        }
                    }
                    level += 1
                }
                group += 1
            }
            if keymap.*.keyExplicit[key] & EXPLICIT_VMODMAP == 0 { keymap.*.keyVmodmap[key] = vmodmap }
        }
        key += 1
    }
    keymap.*.groupCount = groups
    // The virtual modifiers' real ones: what the text gave, and the real
    // modifiers of the keys that carry them.
    var index: usize = 0
    while index < keymap.*.vmodCount {
        var mapping = keymap.*.vmodGiven[index]
        key = 0
        while key < MAX_KEYCODE {
            if keymap.*.keyVmodmap[key] & (@intCast(u32, 256) << @intCast(u5, index)) != 0 { mapping |= @intCast(u32, keymap.*.keyModmap[key]) }
            key += 1
        }
        keymap.*.vmodMapping[index] = mapping
        index += 1
    }
    // The types' masks in real modifiers.
    var type_index: usize = 0
    while type_index < keymap.*.typeCount {
        keymap.*.typeModsReal[type_index] = realMods(keymap, keymap.*.typeMods[type_index])
        var entry: usize = 0
        while entry < @intCast(usize, keymap.*.typeEntryCount[type_index]) {
            const at = type_index * MAX_ENTRIES + entry
            keymap.*.entryModsReal[at] = realMods(keymap, keymap.*.entryMods[at])
            keymap.*.entryPreserveReal[at] = realMods(keymap, keymap.*.entryPreserve[at])
            // An entry whose virtual modifiers map to nothing never applies.
            keymap.*.entryActive[at] = keymap.*.entryMods[at] == 0 || keymap.*.entryModsReal[at] != 0
            entry += 1
        }
        type_index += 1
    }
}
