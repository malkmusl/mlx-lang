// std.xkb: keyboard maps in the XKB text format (what a Wayland compositor
// sends in wl_keyboard.keymap and `xkbcli compile-keymap` writes), read
// (std.xkb.parse), compiled from the XKB data (std.xkb.compile) and
// written (std.xkb.write) without libxkbcommon. A keymap names the keys
// (xkb_keycodes), says how modifiers pick a level (xkb_types), what
// modifier keys do (xkb_compatibility) and what each key types
// (xkb_symbols).
//
//     var names: keysym.Names = undefined
//     keysym.init(&names, allocator)
//     const keymap = xkb.create(allocator, &names)
//     if !xkb_parse.parse(keymap, text) { ... }     // std.xkb.parse
//     var state: xkb_state.State = undefined
//     xkb_state.init(&state, keymap)
//     xkb_state.updateMask(&state, depressed, latched, locked, 0, 0, group)
//     const length = xkb_state.keyUtf8(&state, evdev_code + 8, out, 8)
//
// Levels, groups and keycodes count from 0 here (the text counts levels
// and groups from 1). Modifier masks below 256 are the real modifiers
// (Shift, Lock, Control, Mod1 .. Mod5); bit 8 + i is virtual modifier i.
// The keymap follows libxkbcommon's reading of the format: keys without a
// type get one by what they type, modifier keys get their actions and
// virtual modifiers from the compatibility map, and a virtual modifier
// maps to the real modifiers of the keys that carry it.
const std = @import("std")
const keysym = @import("std.xkb.keysym")

pub const Allocator = std.allocator.Allocator

pub const MAX_KEYCODE: usize = 1024
pub const MAX_GROUPS: usize = 4
pub const MAX_LEVELS: usize = 8
// Per key: MAX_GROUPS * MAX_LEVELS slots of keysyms and actions.
pub const SLOTS: usize = 32
pub const MAX_TYPES: usize = 64
pub const MAX_ENTRIES: usize = 32
pub const MAX_VMODS: usize = 16
pub const MAX_INTERPRETS: usize = 256
pub const MAX_SYMS: usize = 65536
pub const MAX_ALIASES: usize = 256
// Bytes of a key, alias, modifier or group name; of a type name.
pub const NAME: usize = 16
pub const TYPE_NAME: usize = 64
pub const GROUP_NAME: usize = 64

pub const SHIFT: u32 = 1
pub const LOCK: u32 = 2
pub const CONTROL: u32 = 4
pub const MOD1: u32 = 8
pub const MOD2: u32 = 16
pub const MOD3: u32 = 32
pub const MOD4: u32 = 64
pub const MOD5: u32 = 128
pub const REAL_MODS: u32 = 255

pub const ACTION_NONE: u8 = 0
pub const ACTION_SET_MODS: u8 = 1
pub const ACTION_LATCH_MODS: u8 = 2
pub const ACTION_LOCK_MODS: u8 = 3
pub const ACTION_SET_GROUP: u8 = 4
pub const ACTION_LATCH_GROUP: u8 = 5
pub const ACTION_LOCK_GROUP: u8 = 6
// Other actions (pointer, controls, private, ...), kept as their text
// (the place in actionTexts in the action's mods, its length in its
// group): those that a latch survives, and those that break it.
pub const ACTION_OTHER: u8 = 7
pub const ACTION_OTHER_BREAKING: u8 = 8

pub const FLAG_CLEAR_LOCKS: u8 = 1
pub const FLAG_LATCH_TO_LOCK: u8 = 2
// The action's modifiers are the key's (modMapMods).
pub const FLAG_MODMAP_MODS: u8 = 4
pub const FLAG_GROUP_ABSOLUTE: u8 = 8
pub const FLAG_LOCK_NO_LOCK: u8 = 16
pub const FLAG_LOCK_NO_UNLOCK: u8 = 32

pub const MATCH_NONE: u8 = 0
pub const MATCH_ANY_OR_NONE: u8 = 1
pub const MATCH_ANY: u8 = 2
pub const MATCH_ALL: u8 = 3
pub const MATCH_EXACTLY: u8 = 4

pub const EXPLICIT_INTERP: u16 = 1
pub const EXPLICIT_VMODMAP: u16 = 2
pub const EXPLICIT_REPEAT: u16 = 4
// EXPLICIT_TYPE << group.
pub const EXPLICIT_TYPE: u16 = 8
// While reading: the key's group range, its default type are given.
pub const EXPLICIT_RANGE: u16 = 128
pub const EXPLICIT_DEFAULT_TYPE: u16 = 256

// What a key's group defines.
pub const GROUP_SYMS: u8 = 1
pub const GROUP_ACTIONS: u8 = 2

// The fields an interpretation defines.
pub const INTERPRET_VMOD: u8 = 1
pub const INTERPRET_ACTION: u8 = 2
pub const INTERPRET_REPEAT: u8 = 4
pub const INTERPRET_LEVEL_ONE: u8 = 8

// Indicators: state components (whichModState, whichGroupState) and the
// fields a map defines.
pub const MAX_LEDS: usize = 32
pub const LED_NAME: usize = 32
pub const STATE_BASE: u8 = 1
pub const STATE_LATCHED: u8 = 2
pub const STATE_LOCKED: u8 = 4
pub const STATE_EFFECTIVE: u8 = 8
pub const LED_MODS: u8 = 1
pub const LED_GROUPS: u8 = 2
pub const LED_CONTROLS: u8 = 4

pub const MAX_MODMAP: usize = 512
pub const NO_KEYCODE: u32 = 4294967295

pub const RANGE_WRAP: u8 = 0
pub const RANGE_CLAMP: u8 = 1
pub const RANGE_REDIRECT: u8 = 2

pub const NO_TYPE: u8 = 255

// How definitions merge with what is there (include, augment, override,
// replace in the source files).
pub const MERGE_OVERRIDE: u8 = 0
pub const MERGE_AUGMENT: u8 = 1
pub const MERGE_REPLACE: u8 = 2
// No merge mode given: an include's own mode applies (else override).
pub const MERGE_DEFAULT: u8 = 3

pub const LEVEL_NAME: usize = 32

// The sections of a keymap.
pub const SECTION_KEYCODES: u8 = 0
pub const SECTION_TYPES: u8 = 1
pub const SECTION_COMPAT: u8 = 2
pub const SECTION_SYMBOLS: u8 = 3

pub const Keymap = struct {
    names: *keysym.Names
    // Where reading stopped when it failed (a line of the text).
    errorLine: usize
    // Virtual modifiers (shared by the sections): names, a mapping the text
    // gave, the mapping to real modifiers.
    vmodNames: [256]u8
    vmodCount: usize
    vmodGiven: [16]u32
    vmodMapping: [16]u32
    groupCount: usize
    // The text of actions kept as text (ACTION_OTHER), one after another.
    actionTexts: [16384]u8
    actionTextLength: usize

    // xkb_keycodes. The lowest and highest named keycode (after finish).
    minKeycode: u32
    maxKeycode: u32
    // Per keycode: its name (NUL-padded), empty when the keycode has none.
    keyNames: [16384]u8
    aliasNames: [4096]u8
    aliasTargets: [4096]u8
    aliasCount: usize
    // Indicators (LEDs) by index: their names.
    ledNames: [1024]u8
    ledCount: usize

    // xkb_types: name, modifiers, levels, entries (modifiers, level,
    // preserve) MAX_ENTRIES apart; the masks resolved to real modifiers;
    // how a type merges (MERGE_*).
    typeNames: [4096]u8
    typeCount: usize
    typeMods: [64]u32
    typeLevels: [64]u8
    typeEntryCount: [64]u8
    entryMods: [2048]u32
    entryLevel: [2048]u8
    entryPreserve: [2048]u32
    typeModsReal: [64]u32
    entryModsReal: [2048]u32
    entryPreserveReal: [2048]u32
    entryActive: [2048]bool
    // Per type and level (MAX_LEVELS a type): the level's name.
    levelNames: [16384]u8
    typeMerge: [64]u8

    // xkb_compatibility: the interpretations, most specific first (after
    // finish), how each merges and the fields it defines (INTERPRET_*).
    interpretCount: usize
    interpretSym: [256]u32
    interpretAny: [256]bool
    interpretMatch: [256]u8
    interpretMods: [256]u32
    interpretVmod: [256]i32
    interpretLevelOne: [256]bool
    interpretRepeat: [256]bool
    interpretActionKind: [256]u8
    interpretActionFlags: [256]u8
    interpretActionMods: [256]u32
    interpretActionGroup: [256]i32
    interpretMerge: [256]u8
    interpretDefined: [256]u8
    // Indicator maps by name: which state (STATE_*) of which modifiers and
    // groups, which controls light the indicator; the fields defined
    // (LED_*); the indicator's index (after finish).
    ledMapNames: [1024]u8
    ledMapCount: usize
    ledMapDefined: [32]u8
    ledWhichMods: [32]u8
    ledMods: [32]u32
    ledWhichGroups: [32]u8
    ledGroups: [32]u32
    ledControls: [32]u32
    ledMapIndex: [32]u8
    ledMapMerge: [32]u8

    // xkb_symbols, per keycode: whether the text defines the key, how it
    // merges, its type for groups without one (NO_TYPE: none).
    keyDefined: [1024]bool
    keyMerge: [1024]u8
    keyDefaultType: [1024]u8
    keyGroups: [1024]u8
    keyExplicit: [1024]u16
    keyRepeats: [1024]bool
    keyModmap: [1024]u8
    keyVmodmap: [1024]u32
    keyRange: [1024]u8
    keyRedirect: [1024]u8
    // Per keycode and group (MAX_GROUPS apart): its type, its width, what
    // the text defines (GROUP_SYMS, GROUP_ACTIONS).
    keyTypes: [4096]u8
    keyWidth: [4096]u8
    groupDefined: [4096]u8
    // Per keycode, group and level (SLOTS apart, MAX_LEVELS a group): the
    // keysyms (first in `syms`, how many) and the action.
    slotFirst: [32768]u32
    slotCount: [32768]u8
    actionKind: [32768]u8
    actionFlags: [32768]u8
    actionMods: [32768]u32
    actionGroup: [32768]i32
    syms: [65536]u32
    symCount: usize
    groupNames: [256]u8
    // modifier_map entries: a key (its keycode) or a keysym (keycode 0),
    // the real modifier (its index), how the entry merges.
    modmapCount: usize
    modmapKey: [512]u32
    modmapSym: [512]u32
    modmapMod: [512]u8
    modmapMerge: [512]u8
}

pub fn create(allocator: Allocator, names: *keysym.Names) -> *Keymap {
    var keymap: *Keymap = undefined
    unsafe { keymap = @ptrCast(*Keymap, allocator.alloc(@sizeOf(Keymap), 16).?) }
    clear(keymap, names)
    return keymap
}

pub fn destroy(keymap: *Keymap, allocator: Allocator) -> void {
    unsafe { allocator.free(@ptrCast([*]u8, keymap), @sizeOf(Keymap), 16) }
}

pub fn clear(keymap: *Keymap, names: *keysym.Names) -> void {
    unsafe { std.mem.zero(@ptrCast([*]u8, keymap), @sizeOf(Keymap)) }
    keymap.*.names = names
    sectionDefaults(keymap, SECTION_KEYCODES)
    sectionDefaults(keymap, SECTION_SYMBOLS)
}

// The fields of a section, as offsets into the keymap.
fn sectionStart(which: u8) -> usize {
    return match which {
        0 => @offsetOf(Keymap, "minKeycode"),
        1 => @offsetOf(Keymap, "typeNames"),
        2 => @offsetOf(Keymap, "interpretCount"),
        else => @offsetOf(Keymap, "keyDefined")
    }
}

fn sectionEnd(which: u8) -> usize {
    if which >= SECTION_SYMBOLS { return @sizeOf(Keymap) }
    return sectionStart(which + 1)
}

fn sectionDefaults(keymap: *Keymap, which: u8) -> void {
    if which == SECTION_KEYCODES {
        keymap.*.minKeycode = NO_KEYCODE
        keymap.*.maxKeycode = 0
    }
    if which == SECTION_SYMBOLS {
        var index: usize = 0
        while index < MAX_KEYCODE * MAX_GROUPS {
            keymap.*.keyTypes[index] = NO_TYPE
            index += 1
        }
        index = 0
        while index < MAX_KEYCODE {
            keymap.*.keyDefaultType[index] = NO_TYPE
            index += 1
        }
    }
}

// Empties one section (SECTION_*), keeping the others.
pub fn clearSection(keymap: *Keymap, which: u8) -> void {
    const start = sectionStart(which)
    unsafe { std.mem.zero(@ptrFromInt([*]u8, @intFromPtr(keymap) + start), sectionEnd(which) - start) }
    sectionDefaults(keymap, which)
}

// A copy of `keymap` (for reading an include into it).
pub fn copy(keymap: *Keymap, allocator: Allocator) -> *Keymap {
    var made: *Keymap = undefined
    unsafe {
        made = @ptrCast(*Keymap, allocator.alloc(@sizeOf(Keymap), 16).?)
        std.mem.copy(@ptrCast([*]u8, made), @ptrCast([*]const u8, keymap), @sizeOf(Keymap))
    }
    return made
}

// Takes the virtual modifiers `from` declared (it started as a copy of
// `into`, so the first ones agree).
pub fn takeVmods(into: *Keymap, from: *Keymap) -> void {
    unsafe { std.mem.copy(bytesOf(into, @offsetOf(Keymap, "vmodNames")), @ptrCast([*]const u8, bytesOf(from, @offsetOf(Keymap, "vmodNames"))), 256) }
    into.*.vmodCount = from.*.vmodCount
    var index: usize = 0
    while index < MAX_VMODS {
        into.*.vmodGiven[index] = from.*.vmodGiven[index]
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Names

pub fn bytesOf(keymap: *Keymap, field: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(keymap) + field) }
}

pub fn stored(base: [*]u8, at: usize, capacity: usize) -> []const u8 {
    var length: usize = 0
    while length < capacity && base[at + length] != 0 { length += 1 }
    return base[at..at + length]
}

pub fn store(base: [*]u8, at: usize, capacity: usize, value: []const u8) -> void {
    var index: usize = 0
    while index < capacity {
        base[at + index] = if index < value.length && index + 1 < capacity { value[index] } else { 0 }
        index += 1
    }
}

pub fn keyName(keymap: *Keymap, keycode: u32) -> []const u8 {
    if keycode >= @intCast(u32, MAX_KEYCODE) { return "" }
    return stored(bytesOf(keymap, @offsetOf(Keymap, "keyNames")), @intCast(usize, keycode) * NAME, NAME)
}

// The keycode named `name` (or by an alias); 0 when there is none.
pub fn keycodeOf(keymap: *Keymap, name: []const u8) -> u32 {
    var alias: usize = 0
    while alias < keymap.*.aliasCount {
        if std.text.same(stored(bytesOf(keymap, @offsetOf(Keymap, "aliasNames")), alias * NAME, NAME), name) {
            return keycodeOf(keymap, stored(bytesOf(keymap, @offsetOf(Keymap, "aliasTargets")), alias * NAME, NAME))
        }
        alias += 1
    }
    var keycode: usize = 0
    while keycode < MAX_KEYCODE {
        if std.text.same(keyName(keymap, @intCast(u32, keycode)), name) { return @intCast(u32, keycode) }
        keycode += 1
    }
    return 0
}

pub fn typeName(keymap: *Keymap, index: usize) -> []const u8 {
    return stored(bytesOf(keymap, @offsetOf(Keymap, "typeNames")), index * TYPE_NAME, TYPE_NAME)
}

pub fn typeIndex(keymap: *Keymap, name: []const u8) -> u8 {
    var index: usize = 0
    while index < keymap.*.typeCount {
        if std.text.same(typeName(keymap, index), name) { return @intCast(u8, index) }
        index += 1
    }
    return NO_TYPE
}

pub fn vmodName(keymap: *Keymap, index: usize) -> []const u8 {
    return stored(bytesOf(keymap, @offsetOf(Keymap, "vmodNames")), index * NAME, NAME)
}

pub fn levelName(keymap: *Keymap, type_index: usize, level: usize) -> []const u8 {
    return stored(bytesOf(keymap, @offsetOf(Keymap, "levelNames")), (type_index * MAX_LEVELS + level) * LEVEL_NAME, LEVEL_NAME)
}

pub fn ledName(keymap: *Keymap, index: usize) -> []const u8 {
    return stored(bytesOf(keymap, @offsetOf(Keymap, "ledNames")), index * LED_NAME, LED_NAME)
}

pub fn ledMapName(keymap: *Keymap, index: usize) -> []const u8 {
    return stored(bytesOf(keymap, @offsetOf(Keymap, "ledMapNames")), index * LED_NAME, LED_NAME)
}

pub fn groupName(keymap: *Keymap, group: usize) -> []const u8 {
    return stored(bytesOf(keymap, @offsetOf(Keymap, "groupNames")), group * GROUP_NAME, GROUP_NAME)
}

pub fn lowerByte(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }

pub fn sameIgnoringCase(left: []const u8, right: []const u8) -> bool {
    if left.length != right.length { return false }
    var index: usize = 0
    while index < left.length {
        if lowerByte(left[index]) != lowerByte(right[index]) { return false }
        index += 1
    }
    return true
}

// The mask of the modifier `name` (a real one, a virtual one, none, all);
// a virtual modifier not declared yet is declared. 0 for an unknown real
// name when there is no room.
pub fn modifierByName(keymap: *Keymap, name: []const u8) -> u32 {
    if sameIgnoringCase(name, "none") { return 0 }
    if sameIgnoringCase(name, "all") { return 16777215 }
    if sameIgnoringCase(name, "shift") { return SHIFT }
    if sameIgnoringCase(name, "lock") { return LOCK }
    if sameIgnoringCase(name, "control") || sameIgnoringCase(name, "ctrl") { return CONTROL }
    if sameIgnoringCase(name, "mod1") { return MOD1 }
    if sameIgnoringCase(name, "mod2") { return MOD2 }
    if sameIgnoringCase(name, "mod3") { return MOD3 }
    if sameIgnoringCase(name, "mod4") { return MOD4 }
    if sameIgnoringCase(name, "mod5") { return MOD5 }
    const index = vmodIndex(keymap, name)
    if index < 0 { return 0 }
    return @intCast(u32, 256) << @intCast(u5, index)
}

// The virtual modifier's index, declared when it is new (-1: no room).
pub fn vmodIndex(keymap: *Keymap, name: []const u8) -> i32 {
    var index: usize = 0
    while index < keymap.*.vmodCount {
        if std.text.same(vmodName(keymap, index), name) { return @intCast(i32, index) }
        index += 1
    }
    if keymap.*.vmodCount >= MAX_VMODS { return -1 }
    store(bytesOf(keymap, @offsetOf(Keymap, "vmodNames")), keymap.*.vmodCount * NAME, NAME, name)
    keymap.*.vmodCount += 1
    return @intCast(i32, keymap.*.vmodCount - 1)
}

// `mask` with its virtual modifiers replaced by the real ones they map to.
pub fn realMods(keymap: *Keymap, mask: u32) -> u32 {
    var real = mask & REAL_MODS
    var index: usize = 0
    while index < keymap.*.vmodCount {
        if mask & (@intCast(u32, 256) << @intCast(u5, index)) != 0 { real |= keymap.*.vmodMapping[index] }
        index += 1
    }
    return real
}

// ---------------------------------------------------------------------------
// Keys

pub fn slotOf(key: usize, group: usize, level: usize) -> usize { return key * SLOTS + group * MAX_LEVELS + level }

// Empties a level of a key.
pub fn clearLevel(keymap: *Keymap, slot: usize) -> void {
    keymap.*.slotFirst[slot] = 0
    keymap.*.slotCount[slot] = 0
    keymap.*.actionKind[slot] = ACTION_NONE
    keymap.*.actionFlags[slot] = 0
    keymap.*.actionMods[slot] = 0
    keymap.*.actionGroup[slot] = 0
}

// Empties a group of a key.
pub fn clearGroup(keymap: *Keymap, key: usize, group: usize) -> void {
    var level: usize = 0
    while level < MAX_LEVELS {
        clearLevel(keymap, slotOf(key, group, level))
        level += 1
    }
    keymap.*.keyTypes[key * MAX_GROUPS + group] = NO_TYPE
    keymap.*.keyWidth[key * MAX_GROUPS + group] = 0
    keymap.*.groupDefined[key * MAX_GROUPS + group] = 0
    keymap.*.keyExplicit[key] &= ~(EXPLICIT_TYPE << @intCast(u4, group))
}

// Forgets everything about a key but its name.
pub fn clearKey(keymap: *Keymap, key: usize) -> void {
    var group: usize = 0
    while group < MAX_GROUPS {
        clearGroup(keymap, key, group)
        group += 1
    }
    keymap.*.keyDefined[key] = false
    keymap.*.keyMerge[key] = MERGE_DEFAULT
    keymap.*.keyDefaultType[key] = NO_TYPE
    keymap.*.keyGroups[key] = 0
    keymap.*.keyExplicit[key] = 0
    keymap.*.keyRepeats[key] = false
    keymap.*.keyModmap[key] = 0
    keymap.*.keyVmodmap[key] = 0
    keymap.*.keyRange[key] = RANGE_WRAP
    keymap.*.keyRedirect[key] = 0
}

// The text of an action kept as text.
pub fn actionText(keymap: *Keymap, mods: u32, group: i32) -> []const u8 {
    const start = @intCast(usize, mods)
    return bytesOf(keymap, @offsetOf(Keymap, "actionTexts"))[start..start + @intCast(usize, group)]
}

// Keeps an action's text (once); where it is.
pub fn keepActionText(keymap: *Keymap, text: []const u8) -> u32 {
    const texts = bytesOf(keymap, @offsetOf(Keymap, "actionTexts"))
    var at: usize = 0
    while at + text.length <= keymap.*.actionTextLength {
        if std.text.same(texts[at..at + text.length], text) { return @intCast(u32, at) }
        at += 1
    }
    if keymap.*.actionTextLength + text.length > 16384 { return 0 }
    const start = keymap.*.actionTextLength
    keymap.*.actionTextLength = std.text.append(texts, start, 16384, text)
    return @intCast(u32, start)
}

// An action's mods field as `into` keeps it (actions kept as text move
// their text along).
pub fn actionModsInto(into: *Keymap, from: *Keymap, kind: u8, mods: u32, group: i32) -> u32 {
    if kind < ACTION_OTHER || into == from { return mods }
    return keepActionText(into, actionText(from, mods, group))
}

// Copies a level (its keysyms and action) from another keymap or the same.
pub fn copyLevel(into: *Keymap, into_slot: usize, from: *Keymap, from_slot: usize) -> void {
    const count = @intCast(usize, from.*.slotCount[from_slot])
    const first = @intCast(usize, from.*.slotFirst[from_slot])
    into.*.slotCount[into_slot] = 0
    into.*.slotFirst[into_slot] = @intCast(u32, into.*.symCount)
    var index: usize = 0
    while index < count && into.*.symCount < MAX_SYMS {
        into.*.syms[into.*.symCount] = from.*.syms[first + index]
        into.*.symCount += 1
        into.*.slotCount[into_slot] += 1
        index += 1
    }
    copyAction(into, into_slot, from, from_slot)
}

pub fn copyAction(into: *Keymap, into_slot: usize, from: *Keymap, from_slot: usize) -> void {
    const kind = from.*.actionKind[from_slot]
    into.*.actionKind[into_slot] = kind
    into.*.actionFlags[into_slot] = from.*.actionFlags[from_slot]
    into.*.actionMods[into_slot] = actionModsInto(into, from, kind, from.*.actionMods[from_slot], from.*.actionGroup[from_slot])
    into.*.actionGroup[into_slot] = from.*.actionGroup[from_slot]
}

// Copies a group of a key (levels, type, width, what it defines).
pub fn copyGroup(into: *Keymap, into_key: usize, into_group: usize, from: *Keymap, from_key: usize, from_group: usize) -> void {
    var level: usize = 0
    while level < MAX_LEVELS {
        copyLevel(into, slotOf(into_key, into_group, level), from, slotOf(from_key, from_group, level))
        level += 1
    }
    into.*.keyTypes[into_key * MAX_GROUPS + into_group] = from.*.keyTypes[from_key * MAX_GROUPS + from_group]
    into.*.keyWidth[into_key * MAX_GROUPS + into_group] = from.*.keyWidth[from_key * MAX_GROUPS + from_group]
    into.*.groupDefined[into_key * MAX_GROUPS + into_group] = from.*.groupDefined[from_key * MAX_GROUPS + from_group]
    const into_bit = EXPLICIT_TYPE << @intCast(u4, into_group)
    into.*.keyExplicit[into_key] &= ~into_bit
    if from.*.keyExplicit[from_key] & (EXPLICIT_TYPE << @intCast(u4, from_group)) != 0 { into.*.keyExplicit[into_key] |= into_bit }
}

// Copies a whole key but its name.
pub fn copyKey(into: *Keymap, into_key: usize, from: *Keymap, from_key: usize) -> void {
    var group: usize = 0
    while group < MAX_GROUPS {
        copyGroup(into, into_key, group, from, from_key, group)
        group += 1
    }
    into.*.keyDefined[into_key] = from.*.keyDefined[from_key]
    into.*.keyMerge[into_key] = from.*.keyMerge[from_key]
    into.*.keyDefaultType[into_key] = from.*.keyDefaultType[from_key]
    into.*.keyGroups[into_key] = from.*.keyGroups[from_key]
    into.*.keyExplicit[into_key] = from.*.keyExplicit[from_key]
    into.*.keyRepeats[into_key] = from.*.keyRepeats[from_key]
    into.*.keyModmap[into_key] = from.*.keyModmap[from_key]
    into.*.keyVmodmap[into_key] = from.*.keyVmodmap[from_key]
    into.*.keyRange[into_key] = from.*.keyRange[from_key]
    into.*.keyRedirect[into_key] = from.*.keyRedirect[from_key]
}

// ---------------------------------------------------------------------------
// After reading: types for keys without one, the compatibility map's
// actions and virtual modifiers, the virtual modifiers' real ones

// The first keysym of a level (NoSymbol when it has none).
pub fn levelSym(keymap: *Keymap, keycode: usize, group: usize, level: usize) -> u32 {
    const slot = keycode * SLOTS + group * MAX_LEVELS + level
    if level >= MAX_LEVELS || keymap.*.slotCount[slot] == 0 { return 0 }
    return keymap.*.syms[@intCast(usize, keymap.*.slotFirst[slot])]
}

// libxkbcommon's automatic type (FindAutomaticType).
fn automaticType(keymap: *Keymap, key: usize, group: usize) -> u8 {
    const names = keymap.*.names
    const width = @intCast(usize, keymap.*.keyWidth[key * MAX_GROUPS + group])
    // A level counts by its keysym when it has exactly one.
    const sym0 = slotTypeSym(keymap, key, group, 0)
    const sym1 = slotTypeSym(keymap, key, group, 1)
    if width <= 1 { return typeIndex(keymap, "ONE_LEVEL") }
    if width == 2 {
        if keysym.isLower(names, sym0) && keysym.isUpper(names, sym1) { return typeIndex(keymap, "ALPHABETIC") }
        if keysym.isKeypad(sym0) || keysym.isKeypad(sym1) { return typeIndex(keymap, "KEYPAD") }
        return typeIndex(keymap, "TWO_LEVEL")
    }
    if width <= 4 {
        const sym2 = slotTypeSym(keymap, key, group, 2)
        const sym3 = if width == 4 { slotTypeSym(keymap, key, group, 3) } else { 0 }
        if keysym.isLower(names, sym0) && keysym.isUpper(names, sym1) {
            if keysym.isLower(names, sym2) && keysym.isUpper(names, sym3) { return typeIndex(keymap, "FOUR_LEVEL_ALPHABETIC") }
            return typeIndex(keymap, "FOUR_LEVEL_SEMIALPHABETIC")
        }
        if keysym.isKeypad(sym0) || keysym.isKeypad(sym1) { return typeIndex(keymap, "FOUR_LEVEL_KEYPAD") }
        return typeIndex(keymap, "FOUR_LEVEL")
    }
    return NO_TYPE
}

// The keysym a level counts as for the automatic type: its only keysym
// (none when it has several).
fn slotTypeSym(keymap: *Keymap, key: usize, group: usize, level: usize) -> u32 {
    const slot = key * SLOTS + group * MAX_LEVELS + level
    if keymap.*.slotCount[slot] != 1 { return 0 }
    return keymap.*.syms[@intCast(usize, keymap.*.slotFirst[slot])]
}

// The interpretation for a key's level (libxkbcommon's FindInterpForKey):
// the first, most specific first, whose keysym and modifiers match;
// MAX_INTERPRETS when none does.
fn interpretFor(keymap: *Keymap, key: usize, group: usize, level: usize) -> usize {
    const slot = key * SLOTS + group * MAX_LEVELS + level
    const count = @intCast(usize, keymap.*.slotCount[slot])
    if count == 0 { return MAX_INTERPRETS }
    const sym = keymap.*.syms[@intCast(usize, keymap.*.slotFirst[slot])]
    var index: usize = 0
    while index < keymap.*.interpretCount {
        if !keymap.*.interpretAny[index] && (count > 1 || keymap.*.interpretSym[index] != sym) {
            index += 1
            continue
        }
        const mods: u32 = if keymap.*.interpretLevelOne[index] && level != 0 { 0 } else { @intCast(u32, keymap.*.keyModmap[key]) }
        const wanted = keymap.*.interpretMods[index]
        const predicate = keymap.*.interpretMatch[index]
        var found = false
        if predicate == MATCH_NONE { found = wanted & mods == 0 }
        if predicate == MATCH_ANY_OR_NONE { found = mods == 0 || wanted & mods != 0 }
        if predicate == MATCH_ANY { found = wanted & mods != 0 }
        if predicate == MATCH_ALL { found = wanted & mods == wanted }
        if predicate == MATCH_EXACTLY { found = wanted == mods }
        if found { return index }
        index += 1
    }
    return MAX_INTERPRETS
}

// Orders the interpretations most specific first, as libxkbcommon: those
// for a keysym before those for any; within each, Exactly, AllOf, NoneOf,
// AnyOf, AnyOfOrNone; otherwise as the text gave them.
fn sortInterprets(keymap: *Keymap) -> void {
    var order: [256]u8 = undefined
    var count: usize = 0
    var pass: usize = 0
    while pass < 10 {
        const any = pass >= 5
        const predicate = match pass % 5 { 0 => MATCH_EXACTLY, 1 => MATCH_ALL, 2 => MATCH_NONE, 3 => MATCH_ANY, else => MATCH_ANY_OR_NONE }
        var index: usize = 0
        while index < keymap.*.interpretCount {
            if keymap.*.interpretAny[index] == any && keymap.*.interpretMatch[index] == predicate {
                order[count] = @intCast(u8, index)
                count += 1
            }
            index += 1
        }
        pass += 1
    }
    var sym: [256]u32 = undefined
    var anyOf: [256]bool = undefined
    var matchOf: [256]u8 = undefined
    var mods: [256]u32 = undefined
    var vmod: [256]i32 = undefined
    var levelOne: [256]bool = undefined
    var repeat: [256]bool = undefined
    var kind: [256]u8 = undefined
    var flags: [256]u8 = undefined
    var actionMods: [256]u32 = undefined
    var group: [256]i32 = undefined
    var index: usize = 0
    while index < count {
        const from = @intCast(usize, order[index])
        sym[index] = keymap.*.interpretSym[from]
        anyOf[index] = keymap.*.interpretAny[from]
        matchOf[index] = keymap.*.interpretMatch[from]
        mods[index] = keymap.*.interpretMods[from]
        vmod[index] = keymap.*.interpretVmod[from]
        levelOne[index] = keymap.*.interpretLevelOne[from]
        repeat[index] = keymap.*.interpretRepeat[from]
        kind[index] = keymap.*.interpretActionKind[from]
        flags[index] = keymap.*.interpretActionFlags[from]
        actionMods[index] = keymap.*.interpretActionMods[from]
        group[index] = keymap.*.interpretActionGroup[from]
        index += 1
    }
    index = 0
    while index < count {
        keymap.*.interpretSym[index] = sym[index]
        keymap.*.interpretAny[index] = anyOf[index]
        keymap.*.interpretMatch[index] = matchOf[index]
        keymap.*.interpretMods[index] = mods[index]
        keymap.*.interpretVmod[index] = vmod[index]
        keymap.*.interpretLevelOne[index] = levelOne[index]
        keymap.*.interpretRepeat[index] = repeat[index]
        keymap.*.interpretActionKind[index] = kind[index]
        keymap.*.interpretActionFlags[index] = flags[index]
        keymap.*.interpretActionMods[index] = actionMods[index]
        keymap.*.interpretActionGroup[index] = group[index]
        index += 1
    }
    keymap.*.interpretCount = count
}

// The groups a key has: up to the last one the text defines anything for.
fn definedGroups(keymap: *Keymap, key: usize) -> usize {
    var groups: usize = 0
    var group: usize = 0
    while group < MAX_GROUPS {
        if keymap.*.groupDefined[key * MAX_GROUPS + group] != 0 || keymap.*.keyExplicit[key] & (EXPLICIT_TYPE << @intCast(u4, group)) != 0 { groups = group + 1 }
        group += 1
    }
    return groups
}

// The keycodes' range: what the text gave, widened to the named keys.
fn keycodeRange(keymap: *Keymap) -> void {
    var keycode: usize = 0
    while keycode < MAX_KEYCODE {
        if keyName(keymap, @intCast(u32, keycode)).length > 0 {
            if @intCast(u32, keycode) < keymap.*.minKeycode { keymap.*.minKeycode = @intCast(u32, keycode) }
            if @intCast(u32, keycode) > keymap.*.maxKeycode { keymap.*.maxKeycode = @intCast(u32, keycode) }
        }
        keycode += 1
    }
    if keymap.*.minKeycode == NO_KEYCODE {
        keymap.*.minKeycode = 8
        keymap.*.maxKeycode = 255
    }
}

// The key for a modifier_map keysym: the first that types it alone,
// group by group, level by level, keycode by keycode (0: none).
fn keycodeOfSym(keymap: *Keymap, sym: u32) -> u32 {
    if sym == 0 { return 0 }
    var group: usize = 0
    while group < MAX_GROUPS {
        var level: usize = 0
        while level < MAX_LEVELS {
            var keycode: usize = 0
            while keycode < MAX_KEYCODE {
                const at = slotOf(keycode, group, level)
                if keymap.*.slotCount[at] == 1 && keymap.*.syms[@intCast(usize, keymap.*.slotFirst[at])] == sym { return @intCast(u32, keycode) }
                keycode += 1
            }
            level += 1
        }
        group += 1
    }
    return 0
}

// Gives every indicator map an index: the indicator of its name, else a
// free one.
fn placeLeds(keymap: *Keymap) -> void {
    var map: usize = 0
    while map < keymap.*.ledMapCount {
        const name = ledMapName(keymap, map)
        var index: usize = 0
        while index < keymap.*.ledCount && !std.text.same(ledName(keymap, index), name) { index += 1 }
        if index == keymap.*.ledCount {
            index = 0
            while index < keymap.*.ledCount && ledName(keymap, index).length > 0 { index += 1 }
            if index == keymap.*.ledCount && keymap.*.ledCount < MAX_LEDS { keymap.*.ledCount += 1 }
            if index < keymap.*.ledCount { store(bytesOf(keymap, @offsetOf(Keymap, "ledNames")), index * LED_NAME, LED_NAME, name) }
        }
        keymap.*.ledMapIndex[map] = @intCast(u8, if index < MAX_LEDS { index } else { 255 })
        // Modifiers or groups without a state: the effective one.
        if keymap.*.ledMods[map] != 0 && keymap.*.ledWhichMods[map] == 0 { keymap.*.ledWhichMods[map] = STATE_EFFECTIVE }
        if keymap.*.ledGroups[map] != 0 && keymap.*.ledWhichGroups[map] == 0 { keymap.*.ledWhichGroups[map] = STATE_EFFECTIVE }
        map += 1
    }
}

pub fn finish(keymap: *Keymap) -> void {
    sortInterprets(keymap)
    keycodeRange(keymap)
    placeLeds(keymap)
    // Keycodes 0 and 1 held the defaults and the key at hand while reading.
    clearKey(keymap, 0)
    clearKey(keymap, 1)
    var groups: usize = 0
    var key: usize = 0
    while key < MAX_KEYCODE {
        const key_groups = definedGroups(keymap, key)
        keymap.*.keyGroups[key] = @intCast(u8, key_groups)
        if key_groups > groups { groups = key_groups }
        // Groups left empty between others take the first one's.
        var empty: usize = 1
        while empty < key_groups {
            if keymap.*.groupDefined[key * MAX_GROUPS + empty] == 0 && keymap.*.keyExplicit[key] & (EXPLICIT_TYPE << @intCast(u4, empty)) == 0 { copyGroup(keymap, key, empty, keymap, key, 0) }
            empty += 1
        }
        // Types: the given ones, else the key's, else by what the group
        // types; levels past the type's are dropped.
        var group: usize = 0
        while group < key_groups {
            const at = key * MAX_GROUPS + group
            if keymap.*.keyTypes[at] == NO_TYPE { keymap.*.keyTypes[at] = keymap.*.keyDefaultType[key] }
            if keymap.*.keyTypes[at] == NO_TYPE {
                var automatic = automaticType(keymap, key, group)
                if automatic == NO_TYPE { automatic = typeIndex(keymap, "ONE_LEVEL") }
                keymap.*.keyTypes[at] = automatic
            }
            if keymap.*.keyTypes[at] != NO_TYPE {
                const levels = keymap.*.typeLevels[@intCast(usize, keymap.*.keyTypes[at])]
                while keymap.*.keyWidth[at] > levels {
                    keymap.*.keyWidth[at] -= 1
                    clearLevel(keymap, slotOf(key, group, @intCast(usize, keymap.*.keyWidth[at])))
                }
            }
            group += 1
        }
        while group < MAX_GROUPS {
            clearGroup(keymap, key, group)
            group += 1
        }
        key += 1
    }
    // The modifier map.
    key = 0
    while key < MAX_KEYCODE {
        keymap.*.keyModmap[key] = 0
        key += 1
    }
    var entry: usize = 0
    while entry < keymap.*.modmapCount {
        var keycode = keymap.*.modmapKey[entry]
        if keycode == 0 { keycode = keycodeOfSym(keymap, keymap.*.modmapSym[entry]) }
        if keycode != 0 && keycode < @intCast(u32, MAX_KEYCODE) {
            keymap.*.keyModmap[@intCast(usize, keycode)] |= @intCast(u8, 1) << @intCast(u3, keymap.*.modmapMod[entry])
        }
        entry += 1
    }
    key = 0
    while key < MAX_KEYCODE {
        const key_groups = @intCast(usize, keymap.*.keyGroups[key])
        var group: usize = 0
        // A key repeats when the text says so, else when its first level
        // types something and the interpretation for it (if any) repeats.
        if keymap.*.keyExplicit[key] & EXPLICIT_REPEAT == 0 { keymap.*.keyRepeats[key] = false }
        // The compatibility map's interpretations (ApplyInterpsToKey).
        if keymap.*.keyExplicit[key] & EXPLICIT_INTERP == 0 && key_groups > 0 {
            var vmodmap: u32 = 0
            group = 0
            while group < key_groups {
                var level: usize = 0
                while level < @intCast(usize, keymap.*.keyWidth[key * MAX_GROUPS + group]) {
                    const interpret = interpretFor(keymap, key, group, level)
                    if group == 0 && level == 0 && keymap.*.keyExplicit[key] & EXPLICIT_REPEAT == 0 {
                        // No interpretation: libxkbcommon's default one, which repeats.
                        if interpret < MAX_INTERPRETS {
                            keymap.*.keyRepeats[key] = keymap.*.interpretRepeat[interpret]
                        } else {
                            keymap.*.keyRepeats[key] = keymap.*.slotCount[slotOf(key, 0, 0)] > 0
                        }
                    }
                    if interpret < MAX_INTERPRETS {
                        if (group == 0 && level == 0 || !keymap.*.interpretLevelOne[interpret]) && keymap.*.interpretVmod[interpret] >= 0 {
                            vmodmap |= @intCast(u32, 256) << @intCast(u5, keymap.*.interpretVmod[interpret])
                        }
                        if keymap.*.interpretActionKind[interpret] != ACTION_NONE {
                            const slot = key * SLOTS + group * MAX_LEVELS + level
                            keymap.*.actionKind[slot] = keymap.*.interpretActionKind[interpret]
                            keymap.*.actionFlags[slot] = keymap.*.interpretActionFlags[interpret]
                            keymap.*.actionMods[slot] = keymap.*.interpretActionMods[interpret]
                            keymap.*.actionGroup[slot] = keymap.*.interpretActionGroup[interpret]
                        }
                    }
                    level += 1
                }
                group += 1
            }
            if keymap.*.keyExplicit[key] & EXPLICIT_VMODMAP == 0 { keymap.*.keyVmodmap[key] = vmodmap }
        }
        key += 1
    }
    keymap.*.groupCount = groups
    // The virtual modifiers' real ones: what the text gave, and the real
    // modifiers of the keys that carry them.
    var index: usize = 0
    while index < keymap.*.vmodCount {
        var mapping = keymap.*.vmodGiven[index]
        key = 0
        while key < MAX_KEYCODE {
            if keymap.*.keyVmodmap[key] & (@intCast(u32, 256) << @intCast(u5, index)) != 0 { mapping |= @intCast(u32, keymap.*.keyModmap[key]) }
            key += 1
        }
        keymap.*.vmodMapping[index] = mapping
        index += 1
    }
    // The types' masks in real modifiers.
    var type_index: usize = 0
    while type_index < keymap.*.typeCount {
        keymap.*.typeModsReal[type_index] = realMods(keymap, keymap.*.typeMods[type_index])
        var entry: usize = 0
        while entry < @intCast(usize, keymap.*.typeEntryCount[type_index]) {
            const at = type_index * MAX_ENTRIES + entry
            keymap.*.entryModsReal[at] = realMods(keymap, keymap.*.entryMods[at])
            keymap.*.entryPreserveReal[at] = realMods(keymap, keymap.*.entryPreserve[at])
            // An entry whose virtual modifiers map to nothing never applies.
            keymap.*.entryActive[at] = keymap.*.entryMods[at] == 0 || keymap.*.entryModsReal[at] != 0
            entry += 1
        }
        type_index += 1
    }
}
