// The name table (HarfBuzz's OT/name and hb-ot-name.cc): its records with
// a language (from the Windows and Macintosh codes, or the ltag table) and
// an encoding HarfBuzz reads (UTF-16BE or ASCII), sorted by name id and
// language, the best encoding first; names as UTF-8, UTF-16 or UTF-32.
const m = @import("./memory.mlx")
const face = @import("./face.mlx")
const common = @import("./common.mlx")
const sanitize = @import("./sanitize.mlx")
const nt = @import("./nametable.mlx")

const UNSUPPORTED: u32 = 42
const REPLACEMENT: u32 = 0xFFFD

// An entry (hb_ot_name_entry_t, 16 bytes): the name id, the score and the
// index of its record (two 16-bit halves), the language.
const ENTRY: usize = 16

pub const Names = struct {
    t: m.Table
    pool: usize
    poolLength: usize
    entries: usize
    count: u32
}

fn namesOf(address: usize) -> *Names { unsafe { return @ptrFromInt(*Names, address) } }

pub fn namesFreeCallback(a: usize) -> void {
    const n = namesOf(a)
    if n.*.entries != 0 { m.release(n.*.entries) }
    m.release(a)
}

fn nameChecks(s: *sanitize.Sanitizer) -> bool {
    if !sanitize.range(s, 0, 6) { return false }
    const format = sanitize.u16at(s, 0)
    if format != 0 && format != 1 { return false }
    const count = sanitize.u16at(s, 2)
    if !sanitize.array(s, 6, count, 12) { return false }
    const pool = @intCast(usize, sanitize.u16at(s, 4))
    if !sanitize.range(s, 0, pool) { return false }
    var i: u32 = 0
    while i < count {
        const r = 6 + @intCast(usize, i) * 12
        if !sanitize.range(s, r, 12) || !sanitize.range(s, r + 10, 2) { return false }
        if !sanitize.array(s, pool + @intCast(usize, sanitize.u16at(s, r + 10)), sanitize.u16at(s, r + 8), 1) { return false }
        i += 1
    }
    return true
}

// The language of `code` in a table of sorted codes (u16 each), the
// offsets of their tags in `languages` (0: none).
fn mapLanguage(codes: usize, offsets: usize, count: u32, languages: usize, code: u32) -> usize {
    var lo: i64 = 0
    var hi: i64 = @intCast(i64, count) - 1
    while lo <= hi {
        const mid = @intCast(i64, (@intCast(u64, lo) + @intCast(u64, hi)) / 2)
        const c = @intCast(u32, m.get16(codes + @intCast(usize, mid) * 2))
        if code < c {
            hi = mid - 1
        } else if code > c {
            lo = mid + 1
        } else {
            return common.languageFromString(languages + @intCast(usize, m.get16(offsets + @intCast(usize, mid) * 2)), -1)
        }
    }
    return 0
}

// The language of an ltag tag (AAT's table of language tags).
fn ltagLanguage(fc: usize, i: u32) -> usize {
    var t: m.Table = undefined
    face.view(fc, face.T_LTAG, &t)
    if t.length < 12 || m.u32at(&t, 0) < 1 { return 0 }
    const n = m.u32at(&t, 8)
    if !m.fits(&t, 12, @intCast(usize, n) * 4) { return 0 }
    var k: u32 = 0
    while k < n {
        const r = 12 + @intCast(usize, k) * 4
        if !m.fits(&t, @intCast(usize, m.u16at(&t, r)), @intCast(usize, m.u16at(&t, r + 2))) { return 0 }
        k += 1
    }
    if i >= n { return 0 }
    const r = 12 + @intCast(usize, i) * 4
    return common.languageFromString(t.data + @intCast(usize, m.u16at(&t, r)), @intCast(i64, m.u16at(&t, r + 2)))
}

fn recordLanguage(fc: usize, t: *m.Table, r: usize) -> usize {
    const p = m.u16at(t, r)
    const l = m.u16at(t, r + 4)
    if p == 3 { return mapLanguage(@intFromPtr(&nt.MS_CODES), @intFromPtr(&nt.MS_OFFSETS), nt.MS_COUNT, @intFromPtr(nt.MS_LANGUAGES.pointer), l) }
    if p == 1 { return mapLanguage(@intFromPtr(&nt.MAC_CODES), @intFromPtr(&nt.MAC_OFFSETS), nt.MAC_COUNT, @intFromPtr(nt.MAC_LANGUAGES.pointer), l) }
    if p == 0 { return ltagLanguage(fc, l) }
    return 0
}

fn score(t: *m.Table, r: usize) -> u32 {
    const p = m.u16at(t, r)
    const e = m.u16at(t, r + 2)
    if p == 3 && e == 10 { return 0 }
    if p == 0 && e == 6 { return 1 }
    if p == 0 && e == 4 { return 2 }
    if p == 3 && e == 1 { return 3 }
    if p == 0 && e == 3 { return 4 }
    if p == 0 && e == 2 { return 5 }
    if p == 0 && e == 1 { return 6 }
    if p == 0 && e == 0 { return 7 }
    if p == 3 && e == 0 { return 8 }
    if p == 1 && e == 0 { return 10 }
    return UNSUPPORTED
}

fn strcmp(a: usize, b: usize) -> i32 {
    var i: usize = 0
    while true {
        const x = m.get8(a + i)
        const y = m.get8(b + i)
        if x != y { return @intCast(i32, x) - @intCast(i32, y) }
        if x == 0 { return 0 }
        i += 1
    }
    return 0
}

// _hb_ot_name_entry_cmp_key: by name id, then language (none first, then
// by their strings; not `exact`: an entry's language matching the key's
// more specific one is equal).
fn compareKey(a: usize, b: usize, exact: bool) -> i32 {
    const an = m.get32(a)
    const bn = m.get32(b)
    if an != bn { return @bitCast(i32, an -% bn) }
    const al = m.getWord(a + 8)
    const bl = m.getWord(b + 8)
    if al == bl { return 0 }
    if al == 0 { return -1 }
    if bl == 0 { return 1 }
    const c = strcmp(al, bl)
    if !exact && c != 0 && common.languageMatches(bl, al) != 0 { return 0 }
    return c
}

fn compareEntries(a: usize, b: usize) -> i32 {
    const v = compareKey(a, b, true)
    if v != 0 { return v }
    const as_ = m.get16(a + 4)
    const bs = m.get16(b + 4)
    if as_ != bs { return @intCast(i32, as_) - @intCast(i32, bs) }
    return @intCast(i32, m.get16(a + 6)) - @intCast(i32, m.get16(b + 6))
}

fn sortEntries(data: usize, n: usize) -> usize {
    var from = data
    var to = m.alloc(n * ENTRY + ENTRY)
    var width: usize = 1
    while width < n {
        var lo: usize = 0
        while lo < n {
            const mid = if lo + width < n { lo + width } else { n }
            const hi = if lo + 2 * width < n { lo + 2 * width } else { n }
            var x = lo
            var y = mid
            var k = lo
            while k < hi {
                if x < mid && (y >= hi || compareEntries(from + x * ENTRY, from + y * ENTRY) <= 0) {
                    m.copy(to + k * ENTRY, from + x * ENTRY, ENTRY)
                    x += 1
                } else {
                    m.copy(to + k * ENTRY, from + y * ENTRY, ENTRY)
                    y += 1
                }
                k += 1
            }
            lo = hi
        }
        const swap = from
        from = to
        to = swap
        width *= 2
    }
    m.release(to)
    return from
}

pub fn accel(fc: usize) -> *Names {
    var a = face.accel(fc, face.A_NAME)
    if a == 0 {
        const made = m.alloc(@sizeOf(Names))
        const n = namesOf(made)
        var raw: m.Table = undefined
        face.view(fc, face.T_NAME, &raw)
        var copy: usize = 0
        sanitize.sanitizeTable(&raw, face.numGlyphs(fc), @intFromPtr(nameChecks), &n.*.t, &copy)
        const t = &n.*.t
        const poolAt = @intCast(usize, m.u16at(t, 4))
        n.*.pool = t.*.data + poolAt
        n.*.poolLength = if t.*.length > poolAt { t.*.length - poolAt } else { 0 }
        const count = @intCast(usize, m.u16at(t, 2))
        var entries = m.alloc(count * ENTRY + ENTRY)
        var i: usize = 0
        while i < count {
            const r = 6 + i * 12
            const e = entries + i * ENTRY
            m.put32(e, m.u16at(t, r + 6))
            m.put16(e + 4, @intCast(u16, score(t, r)))
            m.put16(e + 6, @intCast(u16, i))
            m.putWord(e + 8, recordLanguage(fc, t, r))
            i += 1
        }
        if count > 1 { entries = sortEntries(entries, count) }
        var j: usize = 0
        i = 0
        var prev: [2]usize = [2]usize{ 0, 0 }
        while i < count {
            const e = entries + i * ENTRY
            const id = m.get32(e)
            const language = m.getWord(e + 8)
            const skip = m.get16(e + 4) == @intCast(u16, UNSUPPORTED) || language == 0 || (i > 0 && prev[0] == @intCast(usize, id) && prev[1] == language)
            prev[0] = @intCast(usize, id)
            prev[1] = language
            if !skip {
                m.copy(entries + j * ENTRY, e, ENTRY)
                j += 1
            }
            i += 1
        }
        n.*.entries = entries
        n.*.count = @intCast(u32, j)
        a = face.keepAccel(fc, face.A_NAME, made, @intFromPtr(namesFreeCallback))
    }
    return namesOf(a)
}

pub fn otNameListNames(fc: usize, count: usize) -> usize {
    const n = accel(fc)
    if count != 0 { m.put32(count, n.*.count) }
    return n.*.entries
}

// The record index of a name id in a language (-1: none) and its width (2
// for UTF-16BE, 1 for ASCII).
fn findIndex(n: *Names, id: u32, language: usize, width: *u32) -> i32 {
    var key: [2]usize = [2]usize{ @intCast(usize, id), language }
    const k = @intFromPtr(&key)
    var pass: u32 = 0
    while pass < 2 {
        var lo: i64 = 0
        var hi: i64 = @intCast(i64, n.*.count) - 1
        while lo <= hi {
            const mid = @intCast(i64, (@intCast(u64, lo) + @intCast(u64, hi)) / 2)
            const e = n.*.entries + @intCast(usize, mid) * ENTRY
            const c = compareKey(k, e, pass == 0)
            if c < 0 {
                hi = mid - 1
            } else if c > 0 {
                lo = mid + 1
            } else {
                width.* = if m.get16(e + 4) < 10 { 2 } else { 1 }
                return @intCast(i32, m.get16(e + 6))
            }
        }
        pass += 1
    }
    return -1
}

// Encodes `u` (UTF-8: 1, UTF-16: 2, UTF-32: 4) into `dst` with room up to
// `end`: where it ends (`dst`: no room).
fn encode(kind: u32, dst: usize, end: usize, u_: u32) -> usize {
    var u = u_
    if u >= 0xD800 && (u <= 0xDFFF || u > 0x10FFFF) { u = REPLACEMENT }
    if kind == 1 {
        if u < 0x80 {
            m.put8(dst, @intCast(u8, u))
            return dst + 1
        }
        if u < 0x800 {
            if end - dst < 2 { return dst }
            m.put8(dst, @intCast(u8, 0xC0 + (0x1F & (u >> 6))))
            m.put8(dst + 1, @intCast(u8, 0x80 + (0x3F & u)))
            return dst + 2
        }
        if u < 0x10000 {
            if end - dst < 3 { return dst }
            m.put8(dst, @intCast(u8, 0xE0 + (0x0F & (u >> 12))))
            m.put8(dst + 1, @intCast(u8, 0x80 + (0x3F & (u >> 6))))
            m.put8(dst + 2, @intCast(u8, 0x80 + (0x3F & u)))
            return dst + 3
        }
        if end - dst < 4 { return dst }
        m.put8(dst, @intCast(u8, 0xF0 + (0x07 & (u >> 18))))
        m.put8(dst + 1, @intCast(u8, 0x80 + (0x3F & (u >> 12))))
        m.put8(dst + 2, @intCast(u8, 0x80 + (0x3F & (u >> 6))))
        m.put8(dst + 3, @intCast(u8, 0x80 + (0x3F & u)))
        return dst + 4
    }
    if kind == 2 {
        if u < 0x10000 {
            m.put16(dst, @intCast(u16, u))
            return dst + 2
        }
        if end - dst < 4 { return dst }
        const v = u - 0x10000
        m.put16(dst, @intCast(u16, 0xD800 + (v >> 10)))
        m.put16(dst + 2, @intCast(u16, 0xDC00 + (v & 0x3FF)))
        return dst + 4
    }
    m.put32(dst, u)
    return dst + 4
}

fn encodeLength(kind: u32, u: u32) -> u32 {
    if kind == 1 {
        if u < 0x80 { return 1 }
        if u < 0x800 { return 2 }
        if u < 0x10000 { return 3 }
        if u < 0x110000 { return 4 }
        return 3
    }
    if kind == 2 { return if u < 0x10000 { 1 } else { 2 } }
    return 1
}

// Decodes the code point at `p` (UTF-16BE when `wide`, else ASCII): where
// the next one starts.
fn decode(wide: bool, p: usize, end: usize, u: *u32) -> usize {
    if !wide {
        const c = @intCast(u32, m.get8(p))
        u.* = if c >= 0x80 { REPLACEMENT } else { c }
        return p + 1
    }
    const c = m.be16(p)
    if c < 0xD800 || c > 0xDFFF {
        u.* = c
        return p + 2
    }
    if c <= 0xDBFF && p + 2 < end {
        const l = m.be16(p + 2)
        if l >= 0xDC00 && l <= 0xDFFF {
            u.* = (c << 10) + l - ((0xD800 << 10) - 0x10000 + 0xDC00)
            return p + 4
        }
    }
    u.* = REPLACEMENT
    return p + 2
}

// hb_ot_name_get_utf8/16/32 (kind 1, 2, 4: the size of a code unit).
fn getName(fc: usize, id: u32, language_: usize, size: usize, text: usize, kind: u32) -> u32 {
    const n = accel(fc)
    const language = if language_ == 0 { common.languageFromString(m.literal("en"), 2) } else { language_ }
    var width: u32 = 0
    const index = findIndex(n, id, language, &width)
    if index != -1 {
        const t = &n.*.t
        const r = 6 + @intCast(usize, index) * 12
        const offset = @intCast(usize, m.u16at(t, r + 10))
        var length = @intCast(usize, m.u16at(t, r + 8))
        if offset > n.*.poolLength { length = 0 } else if length > n.*.poolLength - offset { length = n.*.poolLength - offset }
        const unit: usize = if width == 2 { 2 } else { 1 }
        var src = n.*.pool + offset
        const srcEnd = src + (length / unit) * unit
        const ku = @intCast(usize, kind)
        var dst = text
        if size != 0 && m.get32(size) != 0 {
            const room = m.get32(size) - 1
            const dstEnd = text + @intCast(usize, room) * ku
            while src < srcEnd && dst < dstEnd {
                var u: u32 = 0
                const next = decode(width == 2, src, srcEnd, &u)
                const after = encode(kind, dst, dstEnd, u)
                if after == dst { break }
                dst = after
                src = next
            }
            m.put32(size, @intCast(u32, (dst - text) / ku))
            if kind == 1 { m.put8(dst, 0) } else if kind == 2 { m.put16(dst, 0) } else { m.put32(dst, 0) }
        }
        var total = @intCast(u32, (dst - text) / ku)
        while src < srcEnd {
            var u: u32 = 0
            src = decode(width == 2, src, srcEnd, &u)
            total += encodeLength(kind, u)
        }
        return total
    }
    if size != 0 {
        if m.get32(size) != 0 {
            if kind == 1 { m.put8(text, 0) } else if kind == 2 { m.put16(text, 0) } else { m.put32(text, 0) }
        }
        m.put32(size, 0)
    }
    return 0
}

pub fn otNameGetUtf8(fc: usize, id: u32, language: usize, size: usize, text: usize) -> u32 { return getName(fc, id, language, size, text, 1) }
pub fn otNameGetUtf16(fc: usize, id: u32, language: usize, size: usize, text: usize) -> u32 { return getName(fc, id, language, size, text, 2) }
pub fn otNameGetUtf32(fc: usize, id: u32, language: usize, size: usize, text: usize) -> u32 { return getName(fc, id, language, size, text, 4) }
