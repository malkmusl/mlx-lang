// Justification by a variation axis (HarfBuzz's hb_shape_justify): shaping
// again with the 'jstf' or else the 'wdth' axis set so that the advance of
// the text falls between two targets, the axis value found by the ITP
// method (interpolate, truncate, project) as HarfBuzz does.
const m = @import("./memory.mlx")
const buffer = @import("./buffer.mlx")
const font = @import("./font.mlx")
const shape = @import("./shape.mlx")
const variations = @import("./variations.mlx")
const common = @import("./common.mlx")
const math = @import("std.math")

const TAG_JSTF: u32 = 0x6A737466
const TAG_WDTH: u32 = 0x77647468

// The advance of the shaped buffer along its direction.
fn advanceOf(b: *buffer.Buffer) -> f32 {
    var a: f32 = 0.0
    const horizontal = common.isHorizontal(b.*.direction)
    var i: u32 = 0
    while i < b.*.len {
        const p = b.*.pos + @intCast(usize, i) * @sizeOf(buffer.GlyphPosition)
        const v = if horizontal { m.getI32(p) } else { m.getI32(p + 4) }
        a += @floatFromInt(f32, v)
        i += 1
    }
    return a
}

pub const Justify = struct {
    f: usize
    b: usize
    features: usize
    count: u32
    shaperList: usize
    tag: u32
    text: usize
    textLength: u32
    failed: bool
}

// The buffer back to the text it had.
fn reset(j: *Justify) -> void {
    const b = buffer.buf(j.*.b)
    _ = buffer.ensure(b, j.*.textLength)
    b.*.havePositions = 0
    b.*.len = j.*.textLength
    m.copy(b.*.info, j.*.text, @intCast(usize, j.*.textLength) * @sizeOf(buffer.GlyphInfo))
    b.*.contentType = 1
}

fn shapeAgain(j: *Justify) -> bool {
    return shape.shapeFull(j.*.f, j.*.b, j.*.features, j.*.count, j.*.shaperList) != 0
}

// The advance with the axis at `x`.
fn advanceAt(j: *Justify, x: f64, minY: f64) -> f64 {
    variations.fontSetVariation(j.*.f, j.*.tag, @floatCast(f32, x))
    reset(j)
    if !shapeAgain(j) {
        j.*.failed = true
        return minY
    }
    return @floatCast(f64, advanceOf(buffer.buf(j.*.b)))
}

fn pow2(n: u32) -> u64 {
    var v: u64 = 1
    var i: u32 = 0
    while i < n && i < 63 {
        v <<= 1
        i += 1
    }
    return v
}

fn solveItp(j: *Justify, a_: f64, b_: f64, epsilon: f64, minY: f64, maxY: f64, ya_: f64, yb_: f64, y: *f64) -> f64 {
    var a = a_
    var b = b_
    var ya = ya_
    var yb = yb_
    var steps = math.ceil(math.log2((b - a) / epsilon)) - 1.0
    if steps < 0.0 { steps = 0.0 }
    const nmax: u32 = 1 + @intFromFloat(u32, steps)
    const k1 = 0.2 / (b - a)
    var scaledEpsilon = epsilon * @floatFromInt(f64, pow2(nmax))
    const twoEpsilon = 2.0 * epsilon
    while b - a > twoEpsilon {
        const half = 0.5 * (a + b)
        const r = scaledEpsilon - 0.5 * (b - a)
        const xf = (yb * a - ya * b) / (yb - ya)
        const sigma = half - xf
        const ba = b - a
        const delta = k1 * (ba * ba)
        const sign: f64 = if sigma >= 0.0 { 1.0 } else { -1.0 }
        const xt = if delta <= math.abs(half - xf) { xf + delta * sign } else { half }
        const xitp = if math.abs(xt - half) <= r { xt } else { half - r * sign }
        const yitp = advanceAt(j, xitp, minY)
        if yitp > maxY {
            b = xitp
            yb = yitp
        } else if yitp < minY {
            a = xitp
            ya = yitp
        } else {
            y.* = yitp
            return xitp
        }
        scaledEpsilon *= 0.5
    }
    return 0.5 * (a + b)
}

pub fn shapeJustify(f: usize, b_: usize, features: usize, count: u32, shaperList: usize, minTarget: f32, maxTarget: f32, advance: *f32, varTag: *u32, varValue: *f32) -> i32 {
    if minTarget <= advance.* && advance.* <= maxTarget {
        varTag.* = 0
        varValue.* = 0.0
        return shape.shapeFull(f, b_, features, count, shaperList)
    }
    const fc = font.fontGetFace(f)
    // hb_ot_var_axis_info_t: index, tag, name id, flags, min, default, max.
    var info: [8]u32 = undefined
    var tag: u32 = 0
    if variations.findAxisInfo(fc, TAG_JSTF, @intFromPtr(&info)) {
        tag = TAG_JSTF
    } else if variations.findAxisInfo(fc, TAG_WDTH, @intFromPtr(&info)) {
        tag = TAG_WDTH
    }
    if tag == 0 {
        varTag.* = 0
        varValue.* = 0.0
        if shape.shapeFull(f, b_, features, count, shaperList) == 0 { return 0 }
        advance.* = advanceOf(buffer.buf(b_))
        return 1
    }
    varTag.* = tag
    const minValue = @bitCast(f32, info[4])
    const defaultValue = @bitCast(f32, info[5])
    const maxValue = @bitCast(f32, info[6])
    const bf = buffer.buf(b_)
    var j: Justify = undefined
    j.f = f
    j.b = b_
    j.features = features
    j.count = count
    j.shaperList = shaperList
    j.tag = tag
    j.failed = false
    j.textLength = bf.*.len
    j.text = m.alloc(@intCast(usize, bf.*.len) * @sizeOf(buffer.GlyphInfo))
    if j.text == 0 { return 0 }
    m.copy(j.text, bf.*.info, @intCast(usize, bf.*.len) * @sizeOf(buffer.GlyphInfo))
    const result = justify(&j, minTarget, maxTarget, minValue, defaultValue, maxValue, advance, varTag, varValue)
    m.release(j.text)
    return result
}

fn justify(j: *Justify, minTarget: f32, maxTarget: f32, minValue: f32, defaultValue: f32, maxValue: f32, advance: *f32, varTag: *u32, varValue: *f32) -> i32 {
    if advance.* == 0.0 {
        variations.fontSetVariation(j.*.f, j.*.tag, defaultValue)
        if !shapeAgain(j) { return 0 }
        advance.* = advanceOf(buffer.buf(j.*.b))
    }
    if minTarget <= advance.* && advance.* <= maxTarget {
        varTag.* = 0
        varValue.* = 0.0
        return 1
    }
    var a: f64 = 0.0
    var b: f64 = 0.0
    var ya: f64 = 0.0
    var yb: f64 = 0.0
    if advance.* < minTarget {
        // Wider: from the default to the widest.
        ya = @floatCast(f64, advance.*)
        a = @floatCast(f64, defaultValue)
        b = @floatCast(f64, maxValue)
        variations.fontSetVariation(j.*.f, j.*.tag, @floatCast(f32, b))
        reset(j)
        if !shapeAgain(j) { return 0 }
        yb = @floatCast(f64, advanceOf(buffer.buf(j.*.b)))
        if yb <= @floatCast(f64, maxTarget) {
            varValue.* = @floatCast(f32, b)
            advance.* = @floatCast(f32, yb)
            return 1
        }
    } else {
        // Narrower: from the narrowest to the default.
        yb = @floatCast(f64, advance.*)
        a = @floatCast(f64, minValue)
        b = @floatCast(f64, defaultValue)
        variations.fontSetVariation(j.*.f, j.*.tag, @floatCast(f32, a))
        reset(j)
        if !shapeAgain(j) { return 0 }
        ya = @floatCast(f64, advanceOf(buffer.buf(j.*.b)))
        if ya >= @floatCast(f64, minTarget) {
            varValue.* = @floatCast(f32, a)
            advance.* = @floatCast(f32, ya)
            return 1
        }
    }
    const epsilon = (b - a) / 16384.0
    var y: f64 = 0.0
    const x = solveItp(j, a, b, epsilon, @floatCast(f64, minTarget), @floatCast(f64, maxTarget), ya, yb, &y)
    if j.*.failed { return 0 }
    varValue.* = @floatCast(f32, x)
    advance.* = @floatCast(f32, y)
    return 1
}
