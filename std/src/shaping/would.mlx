// Whether a GSUB lookup would substitute a glyph sequence
// (hb_ot_layout_lookup_would_substitute): each subtable's would_apply,
// matching the whole sequence as its input, with no context around it
// when asked for zero context. As in HarfBuzz, a lookup is only tried for
// a first glyph its coverage digest may have (the three bit patterns of
// hb_set_digest_t over the coverage of the lookup's subtables).
const m = @import("./memory.mlx")
const layout = @import("./layout.mlx")

const MATCH_GLYPH: u32 = 1
const MATCH_CLASS: u32 = 2
const MATCH_COVERAGE: u32 = 3

// The glyph sequence asked about.
const Would = struct {
    glyphs: usize
    len: u32
    zeroContext: bool
}

fn glyphAt(w: *Would, i: u32) -> u32 { return m.get32(w.*.glyphs + @intCast(usize, i) * 4) }

fn matches(t: *m.Table, kind: u32, data: usize, g: u32, value: u32) -> bool {
    if kind == MATCH_GLYPH { return g == value }
    if kind == MATCH_CLASS { return layout.classOf(t, data, g) == value }
    if value == 0 { return false }
    return layout.coverage(t, data + @intCast(usize, value), g) != layout.NOT_COVERED
}

// The sequence is the input (`count` values at `input` for the glyphs
// after the first).
fn matchInput(t: *m.Table, w: *Would, count: u32, input: usize, kind: u32, data: usize) -> bool {
    if count != w.*.len { return false }
    var i: u32 = 1
    while i < count {
        if !matches(t, kind, data, glyphAt(w, i), m.u16at(t, input + @intCast(usize, i - 1) * 2)) { return false }
        i += 1
    }
    return true
}

fn ruleSet(t: *m.Table, w: *Would, rs: usize, kind: u32, data: usize) -> bool {
    const n = layout.u16of(t, rs, 0)
    var i: u32 = 0
    while i < n {
        const r = layout.sub16(t, rs, 2 + @intCast(usize, i) * 2)
        if r != 0 && matchInput(t, w, m.u16at(t, r), r + 4, kind, data) { return true }
        i += 1
    }
    return false
}

fn chainRuleSet(t: *m.Table, w: *Would, rs: usize, kind: u32, data: usize) -> bool {
    const n = layout.u16of(t, rs, 0)
    var i: u32 = 0
    while i < n {
        const r = layout.sub16(t, rs, 2 + @intCast(usize, i) * 2)
        if r != 0 {
            const backtrackCount = m.u16at(t, r)
            const inputAt = r + 2 + @intCast(usize, backtrackCount) * 2
            const inputCount = m.u16at(t, inputAt)
            const inputLen = if inputCount > 0 { inputCount - 1 } else { 0 }
            const lookaheadCount = m.u16at(t, inputAt + 2 + @intCast(usize, inputLen) * 2)
            if (!w.*.zeroContext || (backtrackCount == 0 && lookaheadCount == 0)) && matchInput(t, w, inputCount, inputAt + 2, kind, data) { return true }
        }
        i += 1
    }
    return false
}

// The rule set at index `index` of the offsets array at `st + at` (count
// first); 0 when out of range.
fn setAt(t: *m.Table, st: usize, at: usize, index: u32) -> usize {
    if index >= m.u16at(t, st + at) { return 0 }
    return layout.sub16(t, st, at + 2 + @intCast(usize, index) * 2)
}

fn single(t: *m.Table, w: *Would, st: usize) -> bool {
    return w.*.len == 1 && layout.coverage(t, layout.sub16(t, st, 2), glyphAt(w, 0)) != layout.NOT_COVERED
}

fn subtable(t: *m.Table, w: *Would, kind: u32, st: usize) -> bool {
    if st == 0 { return false }
    const format = m.u16at(t, st)
    if kind == 1 || kind == 2 || kind == 3 || kind == 8 {
        if kind == 1 && format != 1 && format != 2 { return false }
        if kind != 1 && format != 1 { return false }
        return single(t, w, st)
    }
    if kind == 4 {
        if format != 1 { return false }
        const index = layout.coverage(t, layout.sub16(t, st, 2), glyphAt(w, 0))
        if index == layout.NOT_COVERED { return false }
        const ligSet = setAt(t, st, 4, index)
        const n = layout.u16of(t, ligSet, 0)
        var i: u32 = 0
        while i < n {
            const lig = layout.sub16(t, ligSet, 2 + @intCast(usize, i) * 2)
            if lig != 0 && m.u16at(t, lig + 2) == w.*.len {
                var k: u32 = 1
                while k < w.*.len && glyphAt(w, k) == m.u16at(t, lig + 4 + @intCast(usize, k - 1) * 2) { k += 1 }
                if k >= w.*.len { return true }
            }
            i += 1
        }
        return false
    }
    if kind == 5 {
        if format == 1 {
            const index = layout.coverage(t, layout.sub16(t, st, 2), glyphAt(w, 0))
            return ruleSet(t, w, setAt(t, st, 4, index), MATCH_GLYPH, 0)
        }
        if format == 2 {
            const classDef = layout.sub16(t, st, 4)
            return ruleSet(t, w, setAt(t, st, 6, layout.classOf(t, classDef, glyphAt(w, 0))), MATCH_CLASS, classDef)
        }
        if format == 3 {
            return matchInput(t, w, m.u16at(t, st + 2), st + 8, MATCH_COVERAGE, st)
        }
        return false
    }
    if kind == 6 {
        if format == 1 {
            const index = layout.coverage(t, layout.sub16(t, st, 2), glyphAt(w, 0))
            return chainRuleSet(t, w, setAt(t, st, 4, index), MATCH_GLYPH, 0)
        }
        if format == 2 {
            const inputDef = layout.sub16(t, st, 6)
            return chainRuleSet(t, w, setAt(t, st, 10, layout.classOf(t, inputDef, glyphAt(w, 0))), MATCH_CLASS, inputDef)
        }
        if format == 3 {
            const backtrackCount = m.u16at(t, st + 2)
            const inputAt = st + 4 + @intCast(usize, backtrackCount) * 2
            const inputCount = m.u16at(t, inputAt)
            const lookaheadCount = m.u16at(t, inputAt + 2 + @intCast(usize, inputCount) * 2)
            if w.*.zeroContext && (backtrackCount != 0 || lookaheadCount != 0) { return false }
            return matchInput(t, w, inputCount, inputAt + 4, MATCH_COVERAGE, st)
        }
        return false
    }
    if kind == 7 {
        if format != 1 { return false }
        const extKind = m.u16at(t, st + 2)
        if extKind == 7 { return false }
        return subtable(t, w, extKind, layout.sub32(t, st, 4))
    }
    return false
}

// ---------------------------------------------------------------------------
// The coverage digest

const Digest = struct {
    mask4: u64
    mask0: u64
    mask9: u64
}

fn maskFor(g: u32, shift: u32) -> u64 { return @intCast(u64, 1) << @intCast(u6, (g >> @intCast(u5, shift)) & 63) }

fn addRangeTo(mask: u64, a: u32, b: u32, shift: u32) -> u64 {
    if mask == 0xFFFFFFFFFFFFFFFF { return mask }
    if (b >> @intCast(u5, shift)) -% (a >> @intCast(u5, shift)) >= 63 { return 0xFFFFFFFFFFFFFFFF }
    const ma = maskFor(a, shift)
    const mb = maskFor(b, shift)
    const borrow: u64 = if mb < ma { 1 } else { 0 }
    return mask | ((mb +% (mb -% ma)) -% borrow)
}

fn digestAdd(d: *Digest, g: u32) -> void {
    d.*.mask4 |= maskFor(g, 4)
    d.*.mask0 |= maskFor(g, 0)
    d.*.mask9 |= maskFor(g, 9)
}

fn digestAddRange(d: *Digest, a: u32, b: u32) -> void {
    d.*.mask4 = addRangeTo(d.*.mask4, a, b, 4)
    d.*.mask0 = addRangeTo(d.*.mask0, a, b, 0)
    d.*.mask9 = addRangeTo(d.*.mask9, a, b, 9)
}

fn digestHas(d: *Digest, g: u32) -> bool {
    return (d.*.mask4 & maskFor(g, 4)) != 0 && (d.*.mask0 & maskFor(g, 0)) != 0 && (d.*.mask9 & maskFor(g, 9)) != 0
}

fn addCoverage(t: *m.Table, d: *Digest, cov: usize) -> void {
    if cov == 0 { return }
    const format = m.u16at(t, cov)
    const n = @intCast(usize, m.u16at(t, cov + 2))
    var i: usize = 0
    if format == 1 {
        while i < n {
            digestAdd(d, m.u16at(t, cov + 4 + i * 2))
            i += 1
        }
    } else if format == 2 {
        while i < n {
            digestAddRange(d, m.u16at(t, cov + 4 + i * 6), m.u16at(t, cov + 6 + i * 6))
            i += 1
        }
    }
}

// The coverage of a subtable (hb's get_coverage).
fn subtableCoverage(t: *m.Table, kind: u32, st: usize) -> usize {
    if st == 0 { return 0 }
    const format = m.u16at(t, st)
    if kind == 7 {
        if format != 1 { return 0 }
        const extKind = m.u16at(t, st + 2)
        if extKind == 7 { return 0 }
        return subtableCoverage(t, extKind, layout.sub32(t, st, 4))
    }
    if kind == 5 && format == 3 { return layout.sub16(t, st, 6) }
    if kind == 6 && format == 3 {
        const backtrackCount = @intCast(usize, m.u16at(t, st + 2))
        return layout.sub16(t, st, 6 + backtrackCount * 2)
    }
    if kind < 1 || kind > 8 { return 0 }
    return layout.sub16(t, st, 2)
}

fn lookupMayHave(t: *m.Table, l: usize, g: u32) -> bool {
    var d: Digest = undefined
    d.mask4 = 0
    d.mask0 = 0
    d.mask9 = 0
    const kind = layout.lookupType(t, l)
    const n = layout.subtableCount(t, l)
    var i: u32 = 0
    while i < n {
        addCoverage(t, &d, subtableCoverage(t, kind, layout.subtable(t, l, i)))
        i += 1
    }
    return digestHas(&d, g)
}

// Whether GSUB lookup `lookupIndex` of face `fc` would substitute the
// `count` glyphs at `glyphs`.
pub fn wouldSubstitute(fc: usize, lookupIndex: u32, glyphs: usize, count: u32, zeroContext: bool) -> bool {
    var t: m.Table = undefined
    layout.gsubgpos(fc, 0, &t)
    if lookupIndex >= layout.lookupCount(&t) || count == 0 { return false }
    const l = layout.lookup(&t, lookupIndex)
    if l == 0 { return false }
    var w: Would = undefined
    w.glyphs = glyphs
    w.len = count
    w.zeroContext = zeroContext
    const kind = layout.lookupType(&t, l)
    const n = layout.subtableCount(&t, l)
    var i: u32 = 0
    var found = false
    while i < n && !found {
        found = subtable(&t, &w, kind, layout.subtable(&t, l, i))
        i += 1
    }
    // The digest only ever says no for glyphs out of every coverage, which
    // the subtables that check their coverage reject already.
    return found && lookupMayHave(&t, l, m.get32(glyphs))
}

pub fn otLayoutLookupWouldSubstitute(fc: usize, lookupIndex: u32, glyphs: usize, count: u32, zeroContext: i32) -> i32 {
    return if wouldSubstitute(fc, lookupIndex, glyphs, count, zeroContext != 0) { 1 } else { 0 }
}
