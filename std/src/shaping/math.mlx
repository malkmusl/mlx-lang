// hb-ot-math.h: the MATH table (HarfBuzz's hb-ot-math-table.hh and
// hb-ot-math.cc): the math constants, the italics corrections, top accent
// attachments, extended shapes and cut-in kerning of glyphs, and the
// glyph variants and assemblies of stretchy glyphs, scaled to the font.
// A missing or offset-0 subtable reads as zeros (HarfBuzz's Null object).
const m = @import("./memory.mlx")
const common = @import("./common.mlx")
const face = @import("./face.mlx")
const font = @import("./font.mlx")
const layout = @import("./layout.mlx")

// MATH of a face (empty unless its major version is 1).
fn mathView(fc: usize, out: *m.Table) -> void {
    face.view(fc, face.T_MATH, out)
    if out.*.length < 10 || m.u16at(out, 0) != 1 { out.*.length = 0 }
}

// The subtable whose offset from the table's start is at `at` (0: none;
// the table's own start is no Null object here).
fn rootSub(t: *m.Table, at: usize) -> usize { return @intCast(usize, m.u16at(t, at)) }

// A MathValueRecord at `rec` (device table offsets from `base`): the value
// scaled, plus the device table's delta (no variation store, as in
// HarfBuzz).
fn valueX(t: *m.Table, f: usize, rec: usize, base: usize) -> i32 {
    if rec == 0 { return 0 }
    var empty: m.Table = undefined
    empty.data = 0
    empty.length = 0
    return font.emScaleX(f, m.i16at(t, rec)) + layout.deviceDelta(t, layout.sub16(t, base, rec + 2 - base), f, true, &empty, 0)
}

fn valueY(t: *m.Table, f: usize, rec: usize, base: usize) -> i32 {
    if rec == 0 { return 0 }
    var empty: m.Table = undefined
    empty.data = 0
    empty.length = 0
    return font.emScaleY(f, m.i16at(t, rec)) + layout.deviceDelta(t, layout.sub16(t, base, rec + 2 - base), f, false, &empty, 0)
}

// Record `i` of an array of `size`-byte records with its count at `at`
// (0: out of range, the Null record).
fn recordAt(t: *m.Table, at: usize, i: u32, size: usize) -> usize {
    if at == 0 || i >= m.u16at(t, at) { return 0 }
    return at + 2 + @intCast(usize, i) * size
}

pub fn otMathHasData(fc: usize) -> i32 {
    var t: m.Table = undefined
    mathView(fc, &t)
    return if t.length != 0 { 1 } else { 0 }
}

pub fn otMathGetConstant(f: usize, constant: u32) -> i32 {
    var t: m.Table = undefined
    mathView(font.font(f).*.face, &t)
    if t.length == 0 { return 0 }
    const c = rootSub(&t, 4)
    if c == 0 { return 0 }
    if constant <= 1 { return m.i16at(&t, c + @intCast(usize, constant) * 2) }
    if constant <= 3 { return font.emScaleY(f, @intCast(i32, m.u16at(&t, c + 4 + @intCast(usize, constant - 2) * 2))) }
    if constant == 55 { return m.i16at(&t, c + 8 + 51 * 4) }
    if constant > 55 { return 0 }
    const rec = c + 8 + @intCast(usize, constant - 4) * 4
    if constant == 53 || constant == 54 || constant == 41 || constant == 17 { return valueX(&t, f, rec, c) }
    return valueY(&t, f, rec, c)
}

// MathGlyphInfo's subtable at offset `at` (0: none).
fn glyphInfoSub(t: *m.Table, at: usize) -> usize {
    const gi = rootSub(t, 6)
    return layout.sub16(t, gi, at)
}

pub fn otMathGetGlyphItalicsCorrection(f: usize, glyph: u32) -> i32 {
    var t: m.Table = undefined
    mathView(font.font(f).*.face, &t)
    if t.length == 0 { return 0 }
    const ic = glyphInfoSub(&t, 0)
    const index = layout.coverage(&t, layout.sub16(&t, ic, 0), glyph)
    return valueX(&t, f, recordAt(&t, if ic != 0 { ic + 2 } else { 0 }, index, 4), ic)
}

pub fn otMathGetGlyphTopAccentAttachment(f: usize, glyph: u32) -> i32 {
    var t: m.Table = undefined
    mathView(font.font(f).*.face, &t)
    const ta = if t.length != 0 { glyphInfoSub(&t, 2) } else { 0 }
    const index = layout.coverage(&t, layout.sub16(&t, ta, 0), glyph)
    if index == layout.NOT_COVERED { return font.getGlyphHAdvance(f, glyph) / 2 }
    return valueX(&t, f, recordAt(&t, ta + 2, index, 4), ta)
}

pub fn otMathIsGlyphExtendedShape(fc: usize, glyph: u32) -> i32 {
    var t: m.Table = undefined
    mathView(fc, &t)
    if t.length == 0 { return 0 }
    return if layout.coverage(&t, glyphInfoSub(&t, 4), glyph) != layout.NOT_COVERED { 1 } else { 0 }
}

// The MathKern table of `glyph` for corner `kern` (0: none).
fn mathKern(t: *m.Table, glyph: u32, kern: u32) -> usize {
    if t.*.length == 0 || kern >= 4 { return 0 }
    const ki = glyphInfoSub(t, 6)
    if ki == 0 { return 0 }
    const index = layout.coverage(t, layout.sub16(t, ki, 0), glyph)
    const rec = recordAt(t, ki + 2, index, 8)
    if rec == 0 { return 0 }
    return layout.sub16(t, ki, rec + @intCast(usize, kern) * 2 - ki)
}

pub fn otMathGetGlyphKerning(f: usize, glyph: u32, kern: u32, correctionHeight: i32) -> i32 {
    var t: m.Table = undefined
    mathView(font.font(f).*.face, &t)
    const mk = mathKern(&t, glyph, kern)
    if mk == 0 { return 0 }
    const heightCount = m.u16at(&t, mk)
    const heights = mk + 2
    const kerns = heights + @intCast(usize, heightCount) * 4
    const sign: i64 = if font.font(f).*.yScale < 0 { -1 } else { 1 }
    var i: u32 = 0
    var count = heightCount
    while count > 0 {
        const half = count / 2
        const height = valueY(&t, f, heights + @intCast(usize, i + half) * 4, mk)
        if sign * @intCast(i64, height) < sign * @intCast(i64, correctionHeight) {
            i += half + 1
            count -= half + 1
        } else {
            count = half
        }
    }
    return valueX(&t, f, kerns + @intCast(usize, i) * 4, mk)
}

pub fn otMathGetGlyphKernings(f: usize, glyph: u32, kern: u32, startOffset: u32, entriesCount: usize, entries: usize) -> u32 {
    var t: m.Table = undefined
    mathView(font.font(f).*.face, &t)
    const mk = mathKern(&t, glyph, kern)
    if mk == 0 {
        if entriesCount != 0 { m.put32(entriesCount, 0) }
        return 0
    }
    const heightCount = m.u16at(&t, mk)
    const heights = mk + 2
    const kerns = heights + @intCast(usize, heightCount) * 4
    const total = heightCount + 1
    if entriesCount != 0 {
        const start = m.minU(startOffset, total)
        const end = m.minU(start +% m.get32(entriesCount), total)
        const n = if end > start { end - start } else { 0 }
        m.put32(entriesCount, n)
        var k: u32 = 0
        while k < n {
            const j = start + k
            const maxHeight = if j == heightCount { @intCast(i32, 0x7FFFFFFF) } else { valueY(&t, f, heights + @intCast(usize, j) * 4, mk) }
            m.putI32(entries + @intCast(usize, k) * 8, maxHeight)
            m.putI32(entries + @intCast(usize, k) * 8 + 4, valueX(&t, f, kerns + @intCast(usize, j) * 4, mk))
            k += 1
        }
    }
    return total
}

// MathVariants.
fn variants(t: *m.Table) -> usize { return if t.*.length == 0 { 0 } else { rootSub(t, 8) } }

fn dirMult(f: usize, direction: u32) -> i64 {
    return if common.isVertical(direction) { font.font(f).*.yMult } else { font.font(f).*.xMult }
}

pub fn otMathGetMinConnectorOverlap(f: usize, direction: u32) -> i32 {
    var t: m.Table = undefined
    mathView(font.font(f).*.face, &t)
    const v = variants(&t)
    if v == 0 { return 0 }
    return font.emMult(@intCast(i32, m.u16at(&t, v)), dirMult(f, direction))
}

// The MathGlyphConstruction of `glyph` growing in `direction` (0: none).
fn construction(t: *m.Table, glyph: u32, direction: u32) -> usize {
    const v = variants(t)
    if v == 0 { return 0 }
    const vertical = common.isVertical(direction)
    const vertCount = m.u16at(t, v + 6)
    const count = if vertical { vertCount } else { m.u16at(t, v + 8) }
    var index = layout.coverage(t, layout.sub16(t, v, if vertical { 2 } else { 4 }), glyph)
    if index >= count { return 0 }
    if !vertical { index += vertCount }
    return layout.sub16(t, v, 10 + @intCast(usize, index) * 2)
}

// How many of `total` records from `start` fit `count` (written back).
fn subCount(start: u32, total: u32, count: usize) -> u32 {
    var n = if start > total { @intCast(u32, 0) } else { total - start }
    n = m.minU(n, m.get32(count))
    m.put32(count, n)
    return n
}

pub fn otMathGetGlyphVariants(f: usize, glyph: u32, direction: u32, startOffset: u32, variantsCount: usize, out: usize) -> u32 {
    var t: m.Table = undefined
    mathView(font.font(f).*.face, &t)
    const gc = construction(&t, glyph, direction)
    const total = layout.u16of(&t, gc, 2)
    if variantsCount != 0 {
        const n = subCount(startOffset, total, variantsCount)
        const mult = dirMult(f, direction)
        var k: u32 = 0
        while k < n {
            const rec = gc + 4 + @intCast(usize, startOffset + k) * 4
            m.put32(out + @intCast(usize, k) * 8, m.u16at(&t, rec))
            m.putI32(out + @intCast(usize, k) * 8 + 4, font.emMult(@intCast(i32, m.u16at(&t, rec + 2)), mult))
            k += 1
        }
    }
    return total
}

pub fn otMathGetGlyphAssembly(f: usize, glyph: u32, direction: u32, startOffset: u32, partsCount: usize, parts: usize, italicsCorrection: usize) -> u32 {
    var t: m.Table = undefined
    mathView(font.font(f).*.face, &t)
    const gc = construction(&t, glyph, direction)
    const assembly = layout.sub16(&t, gc, 0)
    const total = layout.u16of(&t, assembly, 4)
    if partsCount != 0 {
        const n = subCount(startOffset, total, partsCount)
        const mult = dirMult(f, direction)
        var k: u32 = 0
        while k < n {
            const rec = assembly + 6 + @intCast(usize, startOffset + k) * 10
            const p = parts + @intCast(usize, k) * 20
            m.put32(p, m.u16at(&t, rec))
            m.putI32(p + 4, font.emMult(@intCast(i32, m.u16at(&t, rec + 2)), mult))
            m.putI32(p + 8, font.emMult(@intCast(i32, m.u16at(&t, rec + 4)), mult))
            m.putI32(p + 12, font.emMult(@intCast(i32, m.u16at(&t, rec + 6)), mult))
            m.put32(p + 16, m.u16at(&t, rec + 8) & 1)
            k += 1
        }
    }
    if italicsCorrection != 0 { m.putI32(italicsCorrection, valueX(&t, f, assembly, assembly)) }
    return total
}
