// The extents of what a paint draws (HarfBuzz's hb-paint-extents): paint
// functions that keep stacks of transforms, clips and groups and the
// bounds painted, for COLR glyphs without clip boxes.
const m = @import("./memory.mlx")
const paint = @import("./paint.mlx")
const draw = @import("./draw.mlx")
const font = @import("./font.mlx")

// Bounds: unbounded, bounded by an extents or empty.
pub const UNBOUNDED: u32 = 0
pub const BOUNDED: u32 = 1
pub const EMPTY: u32 = 2

// An extents is four floats (xmin, ymin, xmax, ymax), void when xmin is
// greater than xmax; a bounds is a status and an extents (20 bytes); a
// transform is six floats (xx, yx, xy, yy, x0, y0).
const BOUNDS_SIZE: usize = 20
const TRANSFORM_SIZE: usize = 24

pub const Context = struct {
    transforms: usize
    transformCount: u32
    transformCap: u32
    clips: usize
    clipCount: u32
    clipCap: u32
    groups: usize
    groupCount: u32
    groupCap: u32
    // (A place for what the stacks give when empty.)
    scratch: [6]f32
}

fn contextOf(address: usize) -> *Context { unsafe { return @ptrFromInt(*Context, address) } }

fn fmin(a: f32, b: f32) -> f32 { return if a <= b { a } else { b } }
fn fmax(a: f32, b: f32) -> f32 { return if a >= b { a } else { b } }

fn getF(p: usize, i: usize) -> f32 { return m.getF32(p + i * 4) }
fn putF(p: usize, i: usize, v: f32) -> void { m.putF32(p + i * 4, v) }

fn setExtents(e: usize, xmin: f32, ymin: f32, xmax: f32, ymax: f32) -> void {
    putF(e, 0, xmin)
    putF(e, 1, ymin)
    putF(e, 2, xmax)
    putF(e, 3, ymax)
}

fn isEmpty(e: usize) -> bool { return getF(e, 0) >= getF(e, 2) || getF(e, 1) >= getF(e, 3) }
pub fn isVoid(e: usize) -> bool { return getF(e, 0) > getF(e, 2) }

pub fn addPoint(e: usize, x: f32, y: f32) -> void {
    if isVoid(e) {
        setExtents(e, x, y, x, y)
    } else {
        putF(e, 0, fmin(getF(e, 0), x))
        putF(e, 1, fmin(getF(e, 1), y))
        putF(e, 2, fmax(getF(e, 2), x))
        putF(e, 3, fmax(getF(e, 3), y))
    }
}

// Pushes `size` bytes (zeros) on a stack: their address.
fn pushOn(data: *usize, count: *u32, cap: *u32, size: usize) -> usize {
    if count.* == cap.* {
        const n = if cap.* == 0 { @intCast(u32, 8) } else { cap.* * 2 }
        const grown = m.alloc(@intCast(usize, n) * size)
        if data.* != 0 {
            m.copy(grown, data.*, @intCast(usize, count.*) * size)
            m.release(data.*)
        }
        data.* = grown
        cap.* = n
    }
    const at = data.* + @intCast(usize, count.*) * size
    m.zero(at, size)
    count.* += 1
    return at
}

fn tailOf(c: *Context, data: usize, count: u32, size: usize) -> usize {
    if count == 0 {
        m.zero(@intFromPtr(&c.*.scratch), 24)
        return @intFromPtr(&c.*.scratch)
    }
    return data + @intCast(usize, count - 1) * size
}

fn setBounds(b: usize, status: u32, xmin: f32, ymin: f32, xmax: f32, ymax: f32) -> void {
    m.put32(b, status)
    setExtents(b + 4, xmin, ymin, xmax, ymax)
}

pub fn init(c: *Context) -> void {
    m.zero(@intFromPtr(c), @sizeOf(Context))
    const t = pushOn(&c.*.transforms, &c.*.transformCount, &c.*.transformCap, TRANSFORM_SIZE)
    putF(t, 0, 1.0)
    putF(t, 3, 1.0)
    setBounds(pushOn(&c.*.clips, &c.*.clipCount, &c.*.clipCap, BOUNDS_SIZE), UNBOUNDED, 0.0, 0.0, -1.0, -1.0)
    setBounds(pushOn(&c.*.groups, &c.*.groupCount, &c.*.groupCap, BOUNDS_SIZE), EMPTY, 0.0, 0.0, -1.0, -1.0)
}

pub fn fini(c: *Context) -> void {
    if c.*.transforms != 0 { m.release(c.*.transforms) }
    if c.*.clips != 0 { m.release(c.*.clips) }
    if c.*.groups != 0 { m.release(c.*.groups) }
}

// The extents of the outermost group (four floats) and whether it is
// bounded.
pub fn extentsOf(c: *Context) -> usize { return tailOf(c, c.*.groups, c.*.groupCount, BOUNDS_SIZE) + 4 }
pub fn isBounded(c: *Context) -> bool { return m.get32(tailOf(c, c.*.groups, c.*.groupCount, BOUNDS_SIZE)) != UNBOUNDED }

fn boundsFromExtents(b: usize, e: usize) -> void {
    m.copy(b + 4, e, 16)
    m.put32(b, if isEmpty(e) { EMPTY } else { BOUNDED })
}

fn boundsUnion(b: usize, o: usize) -> void {
    const os = m.get32(o)
    if os == UNBOUNDED {
        m.put32(b, UNBOUNDED)
    } else if os == BOUNDED {
        const s = m.get32(b)
        if s == EMPTY {
            m.copy(b, o, BOUNDS_SIZE)
        } else if s == BOUNDED {
            const e = b + 4
            const f = o + 4
            putF(e, 0, fmin(getF(e, 0), getF(f, 0)))
            putF(e, 1, fmin(getF(e, 1), getF(f, 1)))
            putF(e, 2, fmax(getF(e, 2), getF(f, 2)))
            putF(e, 3, fmax(getF(e, 3), getF(f, 3)))
        }
    }
}

fn boundsIntersect(b: usize, o: usize) -> void {
    const os = m.get32(o)
    if os == EMPTY {
        m.put32(b, EMPTY)
    } else if os == BOUNDED {
        const s = m.get32(b)
        if s == UNBOUNDED {
            m.copy(b, o, BOUNDS_SIZE)
        } else if s == BOUNDED {
            const e = b + 4
            const f = o + 4
            putF(e, 0, fmax(getF(e, 0), getF(f, 0)))
            putF(e, 1, fmax(getF(e, 1), getF(f, 1)))
            putF(e, 2, fmin(getF(e, 2), getF(f, 2)))
            putF(e, 3, fmin(getF(e, 3), getF(f, 3)))
            if isEmpty(e) { m.put32(b, EMPTY) }
        }
    }
}

fn transformPoint(t: usize, x: *f32, y: *f32) -> void {
    const nx = getF(t, 0) * x.* + getF(t, 2) * y.*
    const ny = getF(t, 1) * x.* + getF(t, 3) * y.*
    x.* = nx + getF(t, 4)
    y.* = ny + getF(t, 5)
}

fn transformExtents(t: usize, e: usize) -> void {
    var qx: [4]f32 = undefined
    var qy: [4]f32 = undefined
    qx[0] = getF(e, 0)
    qy[0] = getF(e, 1)
    qx[1] = getF(e, 0)
    qy[1] = getF(e, 3)
    qx[2] = getF(e, 2)
    qy[2] = getF(e, 1)
    qx[3] = getF(e, 2)
    qy[3] = getF(e, 3)
    setExtents(e, 0.0, 0.0, -1.0, -1.0)
    var i: usize = 0
    while i < 4 {
        var x = qx[i]
        var y = qy[i]
        transformPoint(t, &x, &y)
        addPoint(e, x, y)
        i += 1
    }
}

pub fn pushTransform(c: *Context, xx: f32, yx: f32, xy: f32, yy: f32, dx: f32, dy: f32) -> void {
    const prev = tailOf(c, c.*.transforms, c.*.transformCount, TRANSFORM_SIZE)
    var b: [6]f32 = undefined
    m.copy(@intFromPtr(&b), prev, 24)
    const t = pushOn(&c.*.transforms, &c.*.transformCount, &c.*.transformCap, TRANSFORM_SIZE)
    // (cairo's multiplication: the new transform first.)
    putF(t, 0, xx * b[0] + yx * b[2])
    putF(t, 1, xx * b[1] + yx * b[3])
    putF(t, 2, xy * b[0] + yy * b[2])
    putF(t, 3, xy * b[1] + yy * b[3])
    putF(t, 4, dx * b[0] + dy * b[2] + b[4])
    putF(t, 5, dx * b[1] + dy * b[3] + b[5])
}

pub fn popTransform(c: *Context) -> void { if c.*.transformCount > 0 { c.*.transformCount -= 1 } }

pub fn pushClip(c: *Context, xmin: f32, ymin: f32, xmax: f32, ymax: f32) -> void {
    var e: [4]f32 = undefined
    const ea = @intFromPtr(&e)
    setExtents(ea, xmin, ymin, xmax, ymax)
    transformExtents(tailOf(c, c.*.transforms, c.*.transformCount, TRANSFORM_SIZE), ea)
    boundsFromExtents(pushOn(&c.*.clips, &c.*.clipCount, &c.*.clipCap, BOUNDS_SIZE), ea)
}

pub fn popClip(c: *Context) -> void { if c.*.clipCount > 0 { c.*.clipCount -= 1 } }

pub fn pushGroup(c: *Context) -> void {
    setBounds(pushOn(&c.*.groups, &c.*.groupCount, &c.*.groupCap, BOUNDS_SIZE), EMPTY, 0.0, 0.0, -1.0, -1.0)
}

pub fn popGroup(c: *Context, mode: u32) -> void {
    var src: [5]u32 = undefined
    const sa = @intFromPtr(&src)
    if c.*.groupCount > 0 {
        c.*.groupCount -= 1
        m.copy(sa, c.*.groups + @intCast(usize, c.*.groupCount) * BOUNDS_SIZE, BOUNDS_SIZE)
    } else {
        m.zero(sa, BOUNDS_SIZE)
    }
    const backdrop = tailOf(c, c.*.groups, c.*.groupCount, BOUNDS_SIZE)
    if mode == 0 {
        m.put32(backdrop, EMPTY)
    } else if mode == 1 || mode == 7 {
        m.copy(backdrop, sa, BOUNDS_SIZE)
    } else if mode == 2 || mode == 8 {
        // (The backdrop stays.)
    } else if mode == 5 || mode == 6 {
        boundsIntersect(backdrop, sa)
    } else {
        boundsUnion(backdrop, sa)
    }
}

pub fn paintHere(c: *Context) -> void {
    const clip = tailOf(c, c.*.clips, c.*.clipCount, BOUNDS_SIZE)
    var copy: [5]u32 = undefined
    m.copy(@intFromPtr(&copy), clip, BOUNDS_SIZE)
    boundsUnion(tailOf(c, c.*.groups, c.*.groupCount, BOUNDS_SIZE), @intFromPtr(&copy))
}

// ---------------------------------------------------------------------------
// The paint functions

fn cbPushTransform(funcs: usize, data: usize, xx: f32, yx: f32, xy: f32, yy: f32, dx: f32, dy: f32, user: usize) -> void { pushTransform(contextOf(data), xx, yx, xy, yy, dx, dy) }
fn cbPopTransform(funcs: usize, data: usize, user: usize) -> void { popTransform(contextOf(data)) }

fn drawPoint(d: usize, data: usize, st: usize, x: f32, y: f32, user: usize) -> void { addPoint(data, x, y) }
fn drawQuadratic(d: usize, data: usize, st: usize, cx: f32, cy: f32, x: f32, y: f32, user: usize) -> void {
    addPoint(data, cx, cy)
    addPoint(data, x, y)
}
fn drawCubic(d: usize, data: usize, st: usize, c1x: f32, c1y: f32, c2x: f32, c2y: f32, x: f32, y: f32, user: usize) -> void {
    addPoint(data, c1x, c1y)
    addPoint(data, c2x, c2y)
    addPoint(data, x, y)
}

var drawFuncs: usize = 0

fn drawExtentsFuncs() -> usize {
    var f = m.atomicLoadWord(@intFromPtr(&drawFuncs))
    if f == 0 {
        const made = draw.create()
        draw.drawFuncsSetMoveToFunc(made, @intFromPtr(drawPoint), 0, 0)
        draw.drawFuncsSetLineToFunc(made, @intFromPtr(drawPoint), 0, 0)
        draw.drawFuncsSetQuadraticToFunc(made, @intFromPtr(drawQuadratic), 0, 0)
        draw.drawFuncsSetCubicToFunc(made, @intFromPtr(drawCubic), 0, 0)
        draw.drawFuncsMakeImmutable(made)
        if !m.swapWord(@intFromPtr(&drawFuncs), 0, made) { draw.destroy(made) }
        f = m.atomicLoadWord(@intFromPtr(&drawFuncs))
    }
    return f
}

fn cbPushClipGlyph(funcs: usize, data: usize, glyph: u32, f: usize, user: usize) -> i32 {
    var e: [4]f32 = undefined
    const ea = @intFromPtr(&e)
    setExtents(ea, 0.0, 0.0, -1.0, -1.0)
    font.drawGlyph(f, glyph, drawExtentsFuncs(), ea)
    pushClip(contextOf(data), e[0], e[1], e[2], e[3])
    return 0
}

fn cbPushClipRectangle(funcs: usize, data: usize, xmin: f32, ymin: f32, xmax: f32, ymax: f32, user: usize) -> void { pushClip(contextOf(data), xmin, ymin, xmax, ymax) }
fn cbPopClip(funcs: usize, data: usize, user: usize) -> void { popClip(contextOf(data)) }
fn cbPushGroup(funcs: usize, data: usize, user: usize) -> void { pushGroup(contextOf(data)) }
fn cbPopGroup(funcs: usize, data: usize, mode: u32, user: usize) -> void { popGroup(contextOf(data), mode) }

fn cbImage(funcs: usize, data: usize, b: usize, width: u32, height: u32, format: u32, slant: f32, extents: usize, user: usize) -> i32 {
    const c = contextOf(data)
    const xb = m.getI32(extents)
    const yb = m.getI32(extents + 4)
    const w = m.getI32(extents + 8)
    const h = m.getI32(extents + 12)
    pushClip(c, @floatFromInt(f32, xb), @floatFromInt(f32, yb) + @floatFromInt(f32, h), @floatFromInt(f32, xb) + @floatFromInt(f32, w), @floatFromInt(f32, yb))
    paintHere(c)
    popClip(c)
    return 1
}

fn cbColor(funcs: usize, data: usize, fg: i32, color: u32, user: usize) -> void { paintHere(contextOf(data)) }
fn cbGradient6(funcs: usize, data: usize, line: usize, a: f32, b: f32, c: f32, d: f32, e: f32, f: f32, user: usize) -> void { paintHere(contextOf(data)) }
fn cbSweep(funcs: usize, data: usize, line: usize, a: f32, b: f32, c: f32, d: f32, user: usize) -> void { paintHere(contextOf(data)) }

var paintFuncs: usize = 0

// The paint functions of extents (their data: a Context).
pub fn funcs() -> usize {
    var f = m.atomicLoadWord(@intFromPtr(&paintFuncs))
    if f == 0 {
        const made = paint.paintFuncsCreate()
        paint.paintFuncsSetPushTransformFunc(made, @intFromPtr(cbPushTransform), 0, 0)
        paint.paintFuncsSetPopTransformFunc(made, @intFromPtr(cbPopTransform), 0, 0)
        paint.paintFuncsSetPushClipGlyphFunc(made, @intFromPtr(cbPushClipGlyph), 0, 0)
        paint.paintFuncsSetPushClipRectangleFunc(made, @intFromPtr(cbPushClipRectangle), 0, 0)
        paint.paintFuncsSetPopClipFunc(made, @intFromPtr(cbPopClip), 0, 0)
        paint.paintFuncsSetPushGroupFunc(made, @intFromPtr(cbPushGroup), 0, 0)
        paint.paintFuncsSetPopGroupFunc(made, @intFromPtr(cbPopGroup), 0, 0)
        paint.paintFuncsSetColorFunc(made, @intFromPtr(cbColor), 0, 0)
        paint.paintFuncsSetImageFunc(made, @intFromPtr(cbImage), 0, 0)
        paint.paintFuncsSetLinearGradientFunc(made, @intFromPtr(cbGradient6), 0, 0)
        paint.paintFuncsSetRadialGradientFunc(made, @intFromPtr(cbGradient6), 0, 0)
        paint.paintFuncsSetSweepGradientFunc(made, @intFromPtr(cbSweep), 0, 0)
        paint.paintFuncsMakeImmutable(made)
        if !m.swapWord(@intFromPtr(&paintFuncs), 0, made) { paint.paintFuncsDestroy(made) }
        f = m.atomicLoadWord(@intFromPtr(&paintFuncs))
    }
    return f
}
