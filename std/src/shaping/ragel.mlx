// A runner of the syllable machines (machines.mlx): Ragel's table-driven
// scanner as HarfBuzz's generated code runs it (the longest match, with
// the pending syllable emitted at the end of the text and scanning resumed
// after it). Found syllables number the glyphs' syllable byte: a serial
// (1..15) in the high nibble, the syllable type in the low one.
const m = @import("./memory.mlx")
const buffer = @import("./buffer.mlx")
const p = @import("./props.mlx")

const OP_END: u32 = 0
const OP_TS_P: u32 = 1
const OP_TS_0: u32 = 2
const OP_TE_P1: u32 = 3
const OP_TE_P_DEC: u32 = 4
const OP_P_TE: u32 = 5
const OP_FOUND: u32 = 6
const OP_BROKEN: u32 = 7
const OP_ACT: u32 = 8
const OP_SWITCH: u32 = 9

// A machine: its start state and the addresses of its u16 tables.
pub const Machine = struct {
    start: u32
    transKeys: usize
    keySpans: usize
    indexOffsets: usize
    indicies: usize
    transTargs: usize
    transActions: usize
    toStateActions: usize
    fromStateActions: usize
    eofTrans: usize
    programOffsets: usize
    program: usize
}

const State = struct {
    p: u32
    ts: u32
    te: u32
    act: u32
    serial: u32
    buf: usize
    // The glyph index of each machine position (n + 1 entries; 0: the
    // positions are the glyphs).
    index: usize
}

fn at(a: usize, i: u32) -> u32 { return @intCast(u32, m.get16(a + @intCast(usize, i) * 2)) }

fn glyphIndex(s: *State, position: u32) -> u32 {
    if s.*.index == 0 { return position }
    return m.get32(s.*.index + @intCast(usize, position) * 4)
}

fn found(s: *State, kind: u32) -> void {
    const b = buffer.buf(s.*.buf)
    var i = glyphIndex(s, s.*.ts)
    const end = glyphIndex(s, s.*.te)
    while i < end {
        p.setSyllable(buffer.info(b, i), (s.*.serial << 4) | kind)
        i += 1
    }
    s.*.serial += 1
    if s.*.serial == 16 { s.*.serial = 1 }
}

// Runs the program at `pc`; the position after its end.
fn exec(mach: *Machine, s: *State, pc_: u32) -> u32 {
    var pc = pc_
    while true {
        const op = at(mach.*.program, pc)
        pc += 1
        if op == OP_END { break }
        if op == OP_TS_P {
            s.*.ts = s.*.p
        } else if op == OP_TS_0 {
            s.*.ts = 0
        } else if op == OP_TE_P1 {
            s.*.te = s.*.p +% 1
        } else if op == OP_TE_P_DEC {
            s.*.te = s.*.p
            s.*.p = s.*.p -% 1
        } else if op == OP_P_TE {
            s.*.p = s.*.te -% 1
        } else if op == OP_FOUND {
            found(s, at(mach.*.program, pc))
            pc += 1
        } else if op == OP_BROKEN {
            buffer.buf(s.*.buf).*.scratchFlags |= buffer.SCRATCH_HAS_BROKEN_SYLLABLE
        } else if op == OP_ACT {
            s.*.act = at(mach.*.program, pc)
            pc += 1
        } else if op == OP_SWITCH {
            const n = at(mach.*.program, pc)
            pc += 1
            var k: u32 = 0
            while k < n {
                const value = at(mach.*.program, pc)
                const len = at(mach.*.program, pc + 1)
                if value == s.*.act { execOps(mach, s, pc + 2, len) }
                pc += 2 + len
                k += 1
            }
        }
    }
    return pc
}

// Runs `len` operations from `pc` (a case of a switch: no end mark).
fn execOps(mach: *Machine, s: *State, pc_: u32, len: u32) -> void {
    var pc = pc_
    const end = pc_ + len
    while pc < end {
        const op = at(mach.*.program, pc)
        pc += 1
        if op == OP_TS_P {
            s.*.ts = s.*.p
        } else if op == OP_TS_0 {
            s.*.ts = 0
        } else if op == OP_TE_P1 {
            s.*.te = s.*.p +% 1
        } else if op == OP_TE_P_DEC {
            s.*.te = s.*.p
            s.*.p = s.*.p -% 1
        } else if op == OP_P_TE {
            s.*.p = s.*.te -% 1
        } else if op == OP_FOUND {
            found(s, at(mach.*.program, pc))
            pc += 1
        } else if op == OP_BROKEN {
            buffer.buf(s.*.buf).*.scratchFlags |= buffer.SCRATCH_HAS_BROKEN_SYLLABLE
        } else if op == OP_ACT {
            s.*.act = at(mach.*.program, pc)
            pc += 1
        }
    }
}

fn action(mach: *Machine, s: *State, a: u32) -> void {
    if a == 0 { return }
    _ = exec(mach, s, at(mach.*.programOffsets, a))
}

// Runs the machine over the `n` categories at `cats` (a byte each).
pub fn run(mach: *Machine, b: *buffer.Buffer, cats: usize, index: usize, n: u32) -> void {
    var s: State = undefined
    s.p = 0
    s.ts = 0
    s.te = 0
    s.act = 0
    s.serial = 1
    s.buf = @intFromPtr(b)
    s.index = index
    const pe = n
    const eof = n
    var cs = mach.*.start
    var trans: u32 = 0
    // 0: resume (read the next category), 1: take `trans`, 2: at the end.
    var mode: u32 = if s.p == pe { 2 } else { 0 }
    while true {
        if mode == 0 {
            if s.p > pe { break }
            action(mach, &s, at(mach.*.fromStateActions, cs))
            const keys = cs * 2
            const inds = at(mach.*.indexOffsets, cs)
            const slen = at(mach.*.keySpans, cs)
            const c = @intCast(u32, m.get8(cats + @intCast(usize, s.p)))
            const k0 = at(mach.*.transKeys, keys)
            const k1 = at(mach.*.transKeys, keys + 1)
            const i = if slen > 0 && k0 <= c && c <= k1 { c - k0 } else { slen }
            trans = at(mach.*.indicies, inds + i)
            mode = 1
        }
        if mode == 1 {
            cs = at(mach.*.transTargs, trans)
            action(mach, &s, at(mach.*.transActions, trans))
            action(mach, &s, at(mach.*.toStateActions, cs))
            s.p = s.p +% 1
            if s.p != pe {
                mode = 0
                continue
            }
            mode = 2
        }
        if mode == 2 {
            if s.p == eof && at(mach.*.eofTrans, cs) > 0 {
                trans = at(mach.*.eofTrans, cs) - 1
                mode = 1
                continue
            }
            break
        }
    }
}
