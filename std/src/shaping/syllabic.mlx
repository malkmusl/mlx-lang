// What the syllable-based shapers share (HarfBuzz's hb-ot-shaper-syllabic.cc
// and hb-ot-shaper-vowel-constraints.cc): dotted circles for broken
// syllables, and dotted circles between vowel sequences that look like
// another vowel.
const font = @import("./font.mlx")
const buffer = @import("./buffer.mlx")
const p = @import("./props.mlx")
const vowels = @import("./voweltable.mlx")

const DOTTED_CIRCLE: u32 = 0x25CC

// The pause after which the syllables are not needed any more (a number
// of shapers.mlx; nothing to do, as glyph variables are not tracked).
pub const PAUSE_CLEAR_SYLLABLES: u32 = 7

// Inserts a dotted circle at the start of each syllable of type
// `brokenType` (after a leading repha of category `rephaCategory`, -1:
// none), with category `dcCategory` and position `dcPosition` (-1: none);
// whether it did.
pub fn insertDottedCircles(f: usize, b: *buffer.Buffer, brokenType: u32, dcCategory: u32, rephaCategory: i32, dcPosition: i32) -> bool {
    if (b.*.flags & buffer.FLAG_DO_NOT_INSERT_DOTTED_CIRCLE) != 0 { return false }
    if (b.*.scratchFlags & buffer.SCRATCH_HAS_BROKEN_SYLLABLE) == 0 { return false }
    var glyph: u32 = 0
    if !font.getNominalGlyph(f, DOTTED_CIRCLE, &glyph) { return false }
    var dc: buffer.GlyphInfo = undefined
    dc.codepoint = glyph
    dc.mask = 0
    dc.cluster = 0
    dc.var1 = 0
    dc.var2 = 0
    p.setCategory(&dc, dcCategory)
    if dcPosition != -1 { p.setAuxiliary(&dc, @intCast(u32, dcPosition)) }
    var g: buffer.GlyphInfo = undefined
    buffer.clearOutput(b)
    b.*.idx = 0
    var last: u32 = 0
    while b.*.idx < b.*.len && b.*.successful != 0 {
        const s = p.syllable(buffer.cur(b))
        if last != s && (s & 0x0F) == brokenType {
            last = s
            buffer.copyInfo(&g, &dc)
            g.cluster = buffer.cur(b).*.cluster
            g.mask = buffer.cur(b).*.mask
            p.setSyllable(&g, s)
            if rephaCategory != -1 {
                while b.*.idx < b.*.len && b.*.successful != 0 && last == p.syllable(buffer.cur(b)) && p.category(buffer.cur(b)) == @intCast(u32, rephaCategory) {
                    _ = buffer.nextGlyph(b)
                }
            }
            _ = buffer.outputInfo(b, &g)
        } else {
            _ = buffer.nextGlyph(b)
        }
    }
    _ = buffer.sync(b)
    return true
}

// Whether `script` has a rule starting with `u`, `v` (and `w` if the
// rule has a third character); `third` gets the rule's third character.
fn vowelRule(script: u32, u: u32, v: u32, third: *u32) -> bool {
    var k: usize = 0
    while k < vowels.RULES.length {
        if vowels.RULES[k] == script && vowels.RULES[k + 1] == u && vowels.RULES[k + 2] == v {
            third.* = vowels.RULES[k + 3]
            return true
        }
        k += 4
    }
    return false
}

fn hasVowelRules(script: u32) -> bool {
    var k: usize = 0
    while k < vowels.RULES.length {
        if vowels.RULES[k] == script { return true }
        k += 4
    }
    return false
}

fn outputDottedCircle(b: *buffer.Buffer) -> void {
    _ = buffer.outputGlyph(b, DOTTED_CIRCLE)
    p.resetContinuation(buffer.prev(b))
}

// Inserts dotted circles into vowel sequences that look like another
// vowel (before the shaping, on characters).
pub fn preprocessVowelConstraints(b: *buffer.Buffer) -> void {
    if (b.*.flags & buffer.FLAG_DO_NOT_INSERT_DOTTED_CIRCLE) != 0 { return }
    buffer.clearOutput(b)
    const count = b.*.len
    if hasVowelRules(b.*.script) {
        b.*.idx = 0
        var third: u32 = 0
        while b.*.idx + 1 < count && b.*.successful != 0 {
            var matched = false
            if vowelRule(b.*.script, buffer.cur(b).*.codepoint, buffer.curAt(b, 1).*.codepoint, &third) {
                if third == 0 {
                    matched = true
                } else if b.*.idx + 2 < count && buffer.curAt(b, 2).*.codepoint == third {
                    _ = buffer.nextGlyph(b)
                    matched = true
                }
            }
            _ = buffer.nextGlyph(b)
            if matched {
                outputDottedCircle(b)
                _ = buffer.nextGlyph(b)
            }
        }
    }
    _ = buffer.sync(b)
}
