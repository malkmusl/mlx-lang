// gvar: the variations of TrueType glyph outlines (HarfBuzz's
// hb-ot-var-gvar-table.hh and the tuple variation data of
// hb-ot-var-common.hh): for each tuple of a glyph's variation data that
// the font's coordinates select, its point deltas scaled and added, the
// deltas of points it does not name inferred from their neighbours (IUP).
//
// Points are records of POINT_SIZE bytes: x and y (f32), the flag (u8)
// and whether the point ends a contour (u8).
const m = @import("./memory.mlx")
const face = @import("./face.mlx")
const hmtx = @import("./hmtx.mlx")

pub const POINT_SIZE: usize = 12
pub const POINT_X: usize = 0
pub const POINT_Y: usize = 4
pub const POINT_FLAG: usize = 8
pub const POINT_END: usize = 9

pub fn px(points: usize, i: u32) -> f32 { return m.getF32(points + @intCast(usize, i) * POINT_SIZE) }
pub fn py(points: usize, i: u32) -> f32 { return m.getF32(points + @intCast(usize, i) * POINT_SIZE + 4) }
pub fn setPx(points: usize, i: u32, v: f32) -> void { m.putF32(points + @intCast(usize, i) * POINT_SIZE, v) }
pub fn setPy(points: usize, i: u32, v: f32) -> void { m.putF32(points + @intCast(usize, i) * POINT_SIZE + 4, v) }
pub fn pflag(points: usize, i: u32) -> u32 { return @intCast(u32, m.get8(points + @intCast(usize, i) * POINT_SIZE + 8)) }
pub fn pend(points: usize, i: u32) -> bool { return m.get8(points + @intCast(usize, i) * POINT_SIZE + 9) != 0 }

const SHARED_POINT_NUMBERS: u32 = 0x8000
const COUNT_MASK: u32 = 0x0FFF
const EMBEDDED_PEAK_TUPLE: u32 = 0x8000
const INTERMEDIATE_REGION: u32 = 0x4000
const PRIVATE_POINT_NUMBERS: u32 = 0x2000
const TUPLE_INDEX_MASK: u32 = 0x0FFF

pub const Gvar = struct {
    table: m.Table
    glyphCount: u32
    axisCount: u32
}

fn gvarOf(address: usize) -> *Gvar { unsafe { return @ptrFromInt(*Gvar, address) } }

fn gvarFreeCallback(a: usize) -> void { m.release(a) }

pub fn accel(fc: usize) -> *Gvar {
    var a = face.accel(fc, face.A_GVAR)
    if a == 0 {
        const made = m.alloc(@sizeOf(Gvar))
        const g = gvarOf(made)
        face.view(fc, face.T_GVAR, &g.*.table)
        const t = &g.*.table
        g.*.glyphCount = 0
        g.*.axisCount = 0
        if t.*.length >= 20 && m.u16at(t, 0) == 1 {
            // (HarfBuzz's sanitizer: the shared tuples and the offsets of
            // every glyph of the face in the table.)
            const numGlyphs = face.numGlyphs(fc)
            const axisCount = m.u16at(t, 4)
            const sharedCount = m.u16at(t, 6)
            const shared = @intCast(usize, m.u32at(t, 8))
            const longOffsets = (m.u16at(t, 14) & 1) != 0
            const offsetsEnd = 20 + (@intCast(usize, numGlyphs) + 1) * (if longOffsets { @intCast(usize, 4) } else { 2 })
            const sharedEnd = shared + @intCast(usize, axisCount) * @intCast(usize, sharedCount) * 2
            if offsetsEnd <= t.*.length && sharedEnd <= t.*.length {
                g.*.glyphCount = numGlyphs
                g.*.axisCount = axisCount
            }
        }
        a = face.keepAccel(fc, face.A_GVAR, made, @intFromPtr(gvarFreeCallback))
    }
    return gvarOf(a)
}

fn offsetOf(g: *Gvar, i: u32) -> usize {
    const t = &g.*.table
    if i > g.*.glyphCount { return 0 }
    if (m.u16at(t, 14) & 1) != 0 { return @intCast(usize, m.u32at(t, 20 + @intCast(usize, i) * 4)) }
    return @intCast(usize, m.u16at(t, 20 + @intCast(usize, i) * 2)) * 2
}

// Unpacked point numbers (a u32 each) or deltas (an i32 each).
const Unpacked = struct {
    data: usize
    count: u32
    cap: u32
}

fn ensureCap(u: *Unpacked, n: u32) -> bool {
    if n <= u.*.cap { return true }
    const grown = m.grow(u.*.data, @intCast(usize, n) * 4)
    if grown == 0 { return false }
    u.*.data = grown
    u.*.cap = n
    return true
}

// Reads packed point numbers at `p.*` (before `end`).
fn unpackPoints(base: usize, p: *usize, end: usize, out: *Unpacked) -> bool {
    if p.* + 1 > end { return false }
    var count = @intCast(u32, m.get8(base + p.*))
    p.* += 1
    if (count & 0x80) != 0 {
        if p.* + 1 > end { return false }
        count = ((count & 0x7F) << 8) | @intCast(u32, m.get8(base + p.*))
        p.* += 1
    }
    if !ensureCap(out, count) { return false }
    out.*.count = count
    var n: u32 = 0
    var i: u32 = 0
    while i < count {
        if p.* + 1 > end { return false }
        const control = @intCast(u32, m.get8(base + p.*))
        p.* += 1
        const run = (control & 0x7F) + 1
        const stop = i + run
        if stop > count { return false }
        if (control & 0x80) != 0 {
            if p.* + @intCast(usize, run) * 2 > end { return false }
            while i < stop {
                n +%= (@intCast(u32, m.get8(base + p.*)) << 8) | @intCast(u32, m.get8(base + p.* + 1))
                m.put32(out.*.data + @intCast(usize, i) * 4, n)
                p.* += 2
                i += 1
            }
        } else {
            if p.* + @intCast(usize, run) > end { return false }
            while i < stop {
                n +%= @intCast(u32, m.get8(base + p.*))
                m.put32(out.*.data + @intCast(usize, i) * 4, n)
                p.* += 1
                i += 1
            }
        }
    }
    return true
}

// Reads `out.count` packed deltas.
fn unpackDeltas(base: usize, p: *usize, end: usize, out: *Unpacked) -> bool {
    var i: u32 = 0
    const count = out.*.count
    while i < count {
        if p.* + 1 > end { return false }
        const control = @intCast(u32, m.get8(base + p.*))
        p.* += 1
        const run = (control & 0x3F) + 1
        const stop = i + run
        if stop > count { return false }
        if (control & 0x80) != 0 {
            while i < stop {
                m.putI32(out.*.data + @intCast(usize, i) * 4, 0)
                i += 1
            }
        } else if (control & 0x40) != 0 {
            if p.* + @intCast(usize, run) * 2 > end { return false }
            while i < stop {
                const v = (@intCast(u32, m.get8(base + p.*)) << 8) | @intCast(u32, m.get8(base + p.* + 1))
                m.putI32(out.*.data + @intCast(usize, i) * 4, @intCast(i32, @bitCast(i16, @intCast(u16, v))))
                p.* += 2
                i += 1
            }
        } else {
            if p.* + @intCast(usize, run) > end { return false }
            while i < stop {
                m.putI32(out.*.data + @intCast(usize, i) * 4, @intCast(i32, @bitCast(i8, m.get8(base + p.*))))
                p.* += 1
                i += 1
            }
        }
    }
    return true
}

fn f2dot14(t: *m.Table, at: usize) -> i32 { return m.i16at(t, at) }

fn coordAt(coords: usize, numCoords: u32, i: u32) -> i32 {
    if i >= numCoords { return 0 }
    return m.getI32(coords + @intCast(usize, i) * 4)
}

// The scalar of the tuple whose header is at `h` (TupleVariationHeader::
// calculate_scalar).
fn scalarOf(g: *Gvar, h: usize, coords: usize, numCoords: u32) -> f32 {
    const t = &g.*.table
    const axisCount = g.*.axisCount
    const tupleIndex = m.u16at(t, h + 2)
    var peak: usize = 0
    if (tupleIndex & EMBEDDED_PEAK_TUPLE) != 0 {
        peak = h + 4
    } else {
        const index = tupleIndex & TUPLE_INDEX_MASK
        const sharedCount = m.u16at(t, 6)
        if (index + 1) * axisCount > sharedCount * axisCount { return 0.0 }
        peak = @intCast(usize, m.u32at(t, 8)) + @intCast(usize, axisCount * index) * 2
    }
    const interm = (tupleIndex & INTERMEDIATE_REGION) != 0
    var startTuple: usize = 0
    var endTuple: usize = 0
    if interm {
        startTuple = h + 4 + (if (tupleIndex & EMBEDDED_PEAK_TUPLE) != 0 { @intCast(usize, axisCount) * 2 } else { 0 })
        endTuple = startTuple + @intCast(usize, axisCount) * 2
    }
    var scalar: f32 = 1.0
    var i: u32 = 0
    while i < axisCount {
        const pk = f2dot14(t, peak + @intCast(usize, i) * 2)
        if pk != 0 {
            const v = coordAt(coords, numCoords, i)
            if v != pk {
                if interm {
                    const start = f2dot14(t, startTuple + @intCast(usize, i) * 2)
                    const end = f2dot14(t, endTuple + @intCast(usize, i) * 2)
                    if !(start > pk || pk > end || (start < 0 && end > 0)) {
                        if v < start || v > end { return 0.0 }
                        if v < pk {
                            if pk != start { scalar *= @floatFromInt(f32, v - start) / @floatFromInt(f32, pk - start) }
                        } else {
                            if pk != end { scalar *= @floatFromInt(f32, end - v) / @floatFromInt(f32, end - pk) }
                        }
                    }
                } else {
                    const lo = if pk < 0 { pk } else { 0 }
                    const hi = if pk > 0 { pk } else { 0 }
                    if v == 0 || v < lo || v > hi { return 0.0 }
                    scalar *= @floatFromInt(f32, v) / @floatFromInt(f32, pk)
                }
            }
        }
        i += 1
    }
    return scalar
}

fn headerSize(tupleIndex: u32, axisCount: u32) -> usize {
    var size: usize = 4
    if (tupleIndex & EMBEDDED_PEAK_TUPLE) != 0 { size += @intCast(usize, axisCount) * 2 }
    if (tupleIndex & INTERMEDIATE_REGION) != 0 { size += @intCast(usize, axisCount) * 4 }
    return size
}

fn inferDelta(orig: usize, deltas: usize, target: u32, prev: u32, next: u32, y: bool) -> f32 {
    const off: usize = if y { 4 } else { 0 }
    const targetVal = m.getF32(orig + @intCast(usize, target) * POINT_SIZE + off)
    const prevVal = m.getF32(orig + @intCast(usize, prev) * POINT_SIZE + off)
    const nextVal = m.getF32(orig + @intCast(usize, next) * POINT_SIZE + off)
    const prevDelta = m.getF32(deltas + @intCast(usize, prev) * POINT_SIZE + off)
    const nextDelta = m.getF32(deltas + @intCast(usize, next) * POINT_SIZE + off)
    if prevVal == nextVal { return if prevDelta == nextDelta { prevDelta } else { 0.0 } }
    const lo = if prevVal < nextVal { prevVal } else { nextVal }
    const hi = if prevVal > nextVal { prevVal } else { nextVal }
    if targetVal <= lo { return if prevVal < nextVal { prevDelta } else { nextDelta } }
    if targetVal >= hi { return if prevVal > nextVal { prevDelta } else { nextDelta } }
    const r = (targetVal - prevVal) / (nextVal - prevVal)
    return prevDelta + r * (nextDelta - prevDelta)
}

fn nextIndex(i: u32, start: u32, end: u32) -> u32 { return if i >= end { start } else { i + 1 } }

fn translateAll(points: usize, deltas: usize, from: u32, count: u32) -> void {
    var i = from
    while i < count {
        setPx(points, i, px(points, i) + px(deltas, i))
        setPy(points, i, py(points, i) + py(deltas, i))
        i += 1
    }
}

fn zeroDeltas(deltas: usize, from: u32, count: u32) -> void {
    m.zero(deltas + @intCast(usize, from) * POINT_SIZE, @intCast(usize, count - from) * POINT_SIZE)
}

// The work arrays of one application.
const Work = struct {
    shared: Unpacked
    private: Unpacked
    xDeltas: Unpacked
    yDeltas: Unpacked
    deltas: usize
    orig: usize
    ends: Unpacked
}

fn workFree(w: *Work) -> void {
    m.release(w.*.shared.data)
    m.release(w.*.private.data)
    m.release(w.*.xDeltas.data)
    m.release(w.*.yDeltas.data)
    m.release(w.*.ends.data)
    m.release(w.*.deltas)
    m.release(w.*.orig)
}

// Applies the deltas of `glyph` at `coords` to the `count` points at
// `points` (the last four the phantom points); false on broken data.
pub fn applyDeltasToPoints(fc: usize, glyph: u32, coords: usize, numCoords: u32, points: usize, count: u32, phantomOnly: bool) -> bool {
    const g = accel(fc)
    if glyph >= g.*.glyphCount { return true }
    const t = &g.*.table
    const dataStart = @intCast(usize, m.u32at(t, 16))
    const startOffset = offsetOf(g, glyph)
    const endOffset = offsetOf(g, glyph + 1)
    if endOffset < startOffset { return true }
    // The glyph's variation data, within the table.
    var vstart = dataStart + startOffset
    var vlen = endOffset - startOffset
    if vstart > t.*.length { vstart = t.*.length }
    if vlen > t.*.length - vstart { vlen = t.*.length - vstart }
    if vlen < 4 { return true }
    const vend = vstart + vlen
    const tupleVarCount = m.u16at(t, vstart)
    if tupleVarCount == 0 { return true }
    const axisCount = g.*.axisCount
    const base = t.*.data
    var w: Work = undefined
    m.zero(@intFromPtr(&w), @sizeOf(Work))
    // The serialized data, after the shared point numbers if any.
    const dataBase = vstart + @intCast(usize, m.u16at(t, vstart + 2))
    var dataOffset: usize = 0
    if (tupleVarCount & SHARED_POINT_NUMBERS) != 0 {
        var p = dataBase
        if !unpackPoints(base, &p, vend, &w.shared) {
            workFree(&w)
            return true
        }
        dataOffset = p - dataBase
    }
    var header = vstart + 4
    var index: u32 = 0
    const tupleCount = tupleVarCount & COUNT_MASK
    if !tupleValid(t, vstart, vend, header, index, tupleCount, axisCount) {
        workFree(&w)
        return true
    }
    var flush = false
    const from: u32 = if phantomOnly { count - 4 } else { 0 }
    var ok = true
    while true {
        const scalar = scalarOf(g, header, coords, numCoords)
        const dataSize = @intCast(usize, m.u16at(t, header))
        if scalar != 0.0 {
            var p = dataBase + dataOffset
            if p < vstart || p + dataSize > vend {
                ok = false
                break
            }
            if w.deltas == 0 {
                w.deltas = m.alloc(@intCast(usize, count) * POINT_SIZE)
                if w.deltas == 0 {
                    ok = false
                    break
                }
                zeroDeltas(w.deltas, from, count)
            }
            const end = p + dataSize
            const tupleIndex = m.u16at(t, header + 2)
            const hasPrivate = (tupleIndex & PRIVATE_POINT_NUMBERS) != 0
            if hasPrivate && !unpackPoints(base, &p, end, &w.private) {
                ok = false
                break
            }
            const indices = if hasPrivate { &w.private } else { &w.shared }
            const applyToAll = indices.*.count == 0
            const numDeltas = if applyToAll { count } else { indices.*.count }
            if !ensureCap(&w.xDeltas, numDeltas) || !ensureCap(&w.yDeltas, numDeltas) {
                ok = false
                break
            }
            w.xDeltas.count = numDeltas
            w.yDeltas.count = numDeltas
            if !unpackDeltas(base, &p, end, &w.xDeltas) || !unpackDeltas(base, &p, end, &w.yDeltas) {
                ok = false
                break
            }
            if !applyToAll {
                if w.orig == 0 && !phantomOnly {
                    w.orig = m.alloc(@intCast(usize, count) * POINT_SIZE)
                    if w.orig == 0 {
                        ok = false
                        break
                    }
                    m.copy(w.orig, points, @intCast(usize, count) * POINT_SIZE)
                }
                if flush {
                    translateAll(points, w.deltas, from, count)
                    flush = false
                }
                zeroDeltas(w.deltas, from, count)
            }
            addDeltas(&w, scalar, applyToAll, indices, numDeltas, from, count, phantomOnly)
            if !applyToAll && !phantomOnly {
                if !inferUnreferenced(&w, points, count) {
                    ok = false
                    break
                }
            }
            flush = true
        }
        // The next tuple.
        dataOffset += dataSize
        header += headerSize(m.u16at(t, header + 2), axisCount)
        index += 1
        if !tupleValid(t, vstart, vend, header, index, tupleCount, axisCount) { break }
    }
    if ok && flush { translateAll(points, w.deltas, from, count) }
    workFree(&w)
    return ok
}

// tuple_iterator_t::is_valid
fn tupleValid(t: *m.Table, vstart: usize, vend: usize, header: usize, index: u32, tupleCount: u32, axisCount: u32) -> bool {
    if index >= tupleCount { return false }
    if header < vstart || header + 4 > vend { return false }
    const dataSize = @intCast(usize, m.u16at(t, header))
    const size = headerSize(m.u16at(t, header + 2), axisCount)
    return header + (if dataSize > size { dataSize } else { size }) <= vend
}

fn addDeltas(w: *Work, scalar: f32, applyToAll: bool, indices: *Unpacked, numDeltas: u32, from: u32, count: u32, phantomOnly: bool) -> void {
    const deltas = w.*.deltas
    const xs = w.*.xDeltas.data
    const ys = w.*.yDeltas.data
    if applyToAll {
        var i = from
        while i < count {
            const dx = m.getI32(xs + @intCast(usize, i) * 4)
            const dy = m.getI32(ys + @intCast(usize, i) * 4)
            if scalar != 1.0 {
                setPx(deltas, i, px(deltas, i) + @floatFromInt(f32, dx) * scalar)
                setPy(deltas, i, py(deltas, i) + @floatFromInt(f32, dy) * scalar)
            } else {
                setPx(deltas, i, px(deltas, i) + @floatFromInt(f32, dx))
                setPy(deltas, i, py(deltas, i) + @floatFromInt(f32, dy))
            }
            i += 1
        }
        return
    }
    var i: u32 = 0
    while i < numDeltas {
        const ptIndex = m.get32(indices.*.data + @intCast(usize, i) * 4)
        if ptIndex < count && !(phantomOnly && ptIndex < count - 4) {
            const d = deltas + @intCast(usize, ptIndex) * POINT_SIZE
            m.put8(d + POINT_FLAG, 1)
            const dx = m.getI32(xs + @intCast(usize, i) * 4)
            const dy = m.getI32(ys + @intCast(usize, i) * 4)
            if scalar != 1.0 {
                m.putF32(d, m.getF32(d) + @floatFromInt(f32, dx) * scalar)
                m.putF32(d + 4, m.getF32(d + 4) + @floatFromInt(f32, dy) * scalar)
            } else {
                m.putF32(d, m.getF32(d) + @floatFromInt(f32, dx))
                m.putF32(d + 4, m.getF32(d + 4) + @floatFromInt(f32, dy))
            }
        }
        i += 1
    }
}

fn dflag(deltas: usize, i: u32) -> u32 { return @intCast(u32, m.get8(deltas + @intCast(usize, i) * POINT_SIZE + POINT_FLAG)) }

// Infers the deltas of the points no delta names, contour by contour.
fn inferUnreferenced(w: *Work, points: usize, count: u32) -> bool {
    const deltas = w.*.deltas
    const orig = w.*.orig
    if w.*.ends.count == 0 {
        var i: u32 = 0
        while i < count {
            if pend(points, i) {
                if w.*.ends.count == w.*.ends.cap && !ensureCap(&w.*.ends, w.*.ends.cap * 2 + 8) { return false }
                m.put32(w.*.ends.data + @intCast(usize, w.*.ends.count) * 4, i)
                w.*.ends.count += 1
            }
            i += 1
        }
    }
    var startPoint: u32 = 0
    var e: u32 = 0
    while e < w.*.ends.count {
        const endPoint = m.get32(w.*.ends.data + @intCast(usize, e) * 4)
        var refCount: u32 = 0
        var i = startPoint
        while i < endPoint + 1 {
            refCount += dflag(deltas, i)
            i += 1
        }
        var unrefCount = (endPoint - startPoint + 1) - refCount
        var j = startPoint
        if unrefCount != 0 && unrefCount <= endPoint - startPoint {
            var done = false
            while !done {
                var k: u32 = 0
                while true {
                    k = j
                    j = nextIndex(k, startPoint, endPoint)
                    if dflag(deltas, k) != 0 && dflag(deltas, j) == 0 { break }
                }
                const prev = k
                j = k
                while true {
                    k = j
                    j = nextIndex(k, startPoint, endPoint)
                    if dflag(deltas, k) == 0 && dflag(deltas, j) != 0 { break }
                }
                const next = j
                k = prev
                while true {
                    k = nextIndex(k, startPoint, endPoint)
                    if k == next { break }
                    const dx = inferDelta(orig, deltas, k, prev, next, false)
                    const dy = inferDelta(orig, deltas, k, prev, next, true)
                    setPx(deltas, k, dx)
                    setPy(deltas, k, dy)
                    unrefCount -= 1
                    if unrefCount == 0 {
                        done = true
                        break
                    }
                }
            }
        }
        startPoint = endPoint + 1
        e += 1
    }
    return true
}
