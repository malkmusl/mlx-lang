// The kern table (HarfBuzz's hb-ot-kern-table.hh with the subtables it
// shares with kerx) and the kerning machine (hb-kern.hh) that applies pair
// kerning to a buffer: from the kern table's subtables of formats 0, 2 and
// 3 (OpenType's and Apple's versions of the table), or from the font's
// kerning functions when nothing else positions. Format 1 (a state
// machine) is not applied.
const m = @import("./memory.mlx")
const common = @import("./common.mlx")
const face = @import("./face.mlx")
const font = @import("./font.mlx")
const buffer = @import("./buffer.mlx")
const apply = @import("./apply.mlx")
const p = @import("./props.mlx")

// The kern table: its version kind (0: OpenType, 1: Apple), subtable count
// and first subtable.
fn view(fc: usize, t: *m.Table) -> void { face.view(fc, face.T_KERN, t) }

pub fn hasData(fc: usize) -> bool {
    var t: m.Table = undefined
    view(fc, &t)
    return m.u32at(&t, 0) != 0
}

fn isApple(t: *m.Table) -> bool { return m.u16at(t, 0) == 1 }

fn subtableCount(t: *m.Table) -> u32 {
    if isApple(t) { return m.u32at(t, 4) }
    if m.u16at(t, 0) == 0 { return m.u16at(t, 2) }
    return 0
}

fn firstSubtable(t: *m.Table) -> usize { return if isApple(t) { 8 } else { 4 } }
fn subtableLength(t: *m.Table, st: usize) -> usize { return if isApple(t) { @intCast(usize, m.u32at(t, st)) } else { @intCast(usize, m.u16at(t, st + 2)) } }
fn subtableFormat(t: *m.Table, st: usize) -> u32 { return if isApple(t) { m.u8at(t, st + 5) } else { m.u8at(t, st + 4) } }
fn subtableCoverage(t: *m.Table, st: usize) -> u32 { return if isApple(t) { m.u8at(t, st + 4) } else { m.u8at(t, st + 5) } }
fn headerSize(t: *m.Table) -> usize { return if isApple(t) { 8 } else { 6 } }
fn crossStream(t: *m.Table, coverage: u32) -> bool { return if isApple(t) { (coverage & 0x40) != 0 } else { (coverage & 0x04) != 0 } }
fn horizontal(t: *m.Table, coverage: u32) -> bool { return if isApple(t) { (coverage & 0x80) == 0 } else { (coverage & 0x01) != 0 } }
fn variation(t: *m.Table, coverage: u32) -> bool { return isApple(t) && (coverage & 0x20) != 0 }

pub fn hasStateMachine(fc: usize) -> bool {
    var t: m.Table = undefined
    view(fc, &t)
    var st = firstSubtable(&t)
    var i: u32 = 0
    const n = subtableCount(&t)
    while i < n {
        if subtableFormat(&t, st) == 1 { return true }
        st += subtableLength(&t, st)
        i += 1
    }
    return false
}

pub fn hasCrossStream(fc: usize) -> bool {
    var t: m.Table = undefined
    view(fc, &t)
    var st = firstSubtable(&t)
    var i: u32 = 0
    const n = subtableCount(&t)
    while i < n {
        if crossStream(&t, subtableCoverage(&t, st)) { return true }
        st += subtableLength(&t, st)
        i += 1
    }
    return false
}

// The kerning of the pair in subtable `st` (formats 0, 2 and 3).
fn subtableKerning(t: *m.Table, st: usize, left: u32, right: u32) -> i32 {
    const format = subtableFormat(t, st)
    const h = st + headerSize(t)
    if format == 0 {
        var lo: i64 = 0
        var hi: i64 = @intCast(i64, m.u16at(t, h)) - 1
        while lo <= hi {
            const mid = (lo + hi) / 2
            const r = h + 8 + @intCast(usize, mid) * 6
            const l = m.u16at(t, r)
            const rr = m.u16at(t, r + 2)
            if left < l || (left == l && right < rr) {
                hi = mid - 1
            } else if left > l || (left == l && right > rr) {
                lo = mid + 1
            } else {
                return m.i16at(t, r + 4)
            }
        }
        return 0
    }
    if format == 2 {
        const leftTable = st + @intCast(usize, m.u16at(t, h + 2))
        const rightTable = st + @intCast(usize, m.u16at(t, h + 4))
        const arrayOffset = @intCast(usize, m.u16at(t, h + 6))
        var l: usize = 0
        var r: usize = 0
        const li = left -% m.u16at(t, leftTable)
        if li < m.u16at(t, leftTable + 2) { l = @intCast(usize, m.u16at(t, leftTable + 4 + @intCast(usize, li) * 2)) }
        const ri = right -% m.u16at(t, rightTable)
        if ri < m.u16at(t, rightTable + 2) { r = @intCast(usize, m.u16at(t, rightTable + 4 + @intCast(usize, ri) * 2)) }
        if l + r < arrayOffset { return 0 }
        const index = (l + r - arrayOffset) / 2
        return m.i16at(t, st + arrayOffset + index * 2)
    }
    if format == 3 {
        const glyphCount = @intCast(usize, m.u16at(t, h))
        const valueCount = @intCast(usize, m.u8at(t, h + 2))
        const leftCount = m.u8at(t, h + 3)
        const rightCount = m.u8at(t, h + 4)
        const values = h + 6
        const leftClasses = values + valueCount * 2
        const rightClasses = leftClasses + glyphCount
        const indices = rightClasses + glyphCount
        const lc = if @intCast(usize, left) < glyphCount { m.u8at(t, leftClasses + @intCast(usize, left)) } else { 0 }
        const rc = if @intCast(usize, right) < glyphCount { m.u8at(t, rightClasses + @intCast(usize, right)) } else { 0 }
        if lc >= leftCount || rc >= rightCount { return 0 }
        const i = @intCast(usize, lc * rightCount + rc)
        const k = @intCast(usize, m.u8at(t, indices + i))
        if k >= valueCount { return 0 }
        return m.i16at(t, values + k * 2)
    }
    return 0
}

// The horizontal kerning of the pair by the table (hb_ot_kern's
// get_h_kerning).
pub fn hKerning(fc: usize, left: u32, right: u32) -> i32 {
    var t: m.Table = undefined
    view(fc, &t)
    var v: i32 = 0
    var st = firstSubtable(&t)
    var i: u32 = 0
    const n = subtableCount(&t)
    while i < n {
        const coverage = subtableCoverage(&t, st)
        if !(variation(&t, coverage) || crossStream(&t, coverage)) && horizontal(&t, coverage) {
            v +%= subtableKerning(&t, st, left, right)
        }
        st += subtableLength(&t, st)
        i += 1
    }
    return v
}

// The kerning machine: pairs of glyphs (marks skipped) with the kern mask,
// kerned by subtable `st` of `t` or (`st` 0) by the font's functions.
fn machine(f: usize, b: *buffer.Buffer, kernMask: u32, scale: bool, cross: bool, t: *m.Table, st: usize) -> void {
    buffer.unsafeToConcat(b, 0, 0xFFFFFFFF)
    var c: apply.Apply = undefined
    apply.init(&c, 1, f, @intFromPtr(b))
    apply.setLookupMask(&c, kernMask)
    apply.setLookupProps(&c, 0x0008)
    const h = common.isHorizontal(b.*.direction)
    var idx: u32 = 0
    while idx < b.*.len {
        if (buffer.info(b, idx).*.mask & kernMask) == 0 {
            idx += 1
            continue
        }
        apply.iterReset(&c, &c.input, idx)
        var unsafeTo: u32 = 0
        if !apply.iterNext(&c, &c.input, &unsafeTo) {
            idx += 1
            continue
        }
        const i = idx
        const j = c.input.idx
        const first = buffer.info(b, i).*.codepoint
        const second = buffer.info(b, j).*.codepoint
        var k: i32 = 0
        if st != 0 {
            k = subtableKerning(t, st, first, second)
        } else if h {
            k = font.getGlyphHKerning(f, first, second)
        } else {
            k = font.getGlyphVKerning(f, first, second)
        }
        if k != 0 {
            const pi = buffer.pos(b, i)
            const pj = buffer.pos(b, j)
            if h {
                if scale { k = font.emScaleX(f, k) }
                if cross {
                    pj.*.yOffset = k
                    b.*.scratchFlags |= buffer.SCRATCH_HAS_GPOS_ATTACHMENT
                } else {
                    const k1 = k >> 1
                    const k2 = k -% k1
                    pi.*.xAdvance +%= k1
                    pj.*.xAdvance +%= k2
                    pj.*.xOffset +%= k2
                }
            } else {
                if scale { k = font.emScaleY(f, k) }
                if cross {
                    pj.*.xOffset = k
                    b.*.scratchFlags |= buffer.SCRATCH_HAS_GPOS_ATTACHMENT
                } else {
                    const k1 = k >> 1
                    const k2 = k -% k1
                    pi.*.yAdvance +%= k1
                    pj.*.yAdvance +%= k2
                    pj.*.yOffset +%= k2
                }
            }
            buffer.unsafeToBreak(b, i, j + 1)
        }
        idx = c.input.idx
    }
    apply.fini(&c)
}

// Applies the kern table (hb_ot_layout_kern).
pub fn applyTable(f: usize, b: *buffer.Buffer, kernMask: u32, requestedKerning: bool) -> void {
    var t: m.Table = undefined
    view(font.font(f).*.face, &t)
    buffer.unsafeToConcat(b, 0, 0xFFFFFFFF)
    var seenCrossStream = false
    var st = firstSubtable(&t)
    var i: u32 = 0
    const n = subtableCount(&t)
    while i < n {
        const coverage = subtableCoverage(&t, st)
        const skip = variation(&t, coverage) || common.isHorizontal(b.*.direction) != horizontal(&t, coverage)
        if !skip {
            const reverse = common.isBackward(b.*.direction)
            const cross = crossStream(&t, coverage)
            if !seenCrossStream && cross {
                seenCrossStream = true
                var k: u32 = 0
                while k < b.*.len {
                    const q = buffer.pos(b, k)
                    p.setAttachType(q, apply.ATTACH_TYPE_CURSIVE)
                    p.setAttachChain(q, if common.isForward(b.*.direction) { -1 } else { 1 })
                    k += 1
                }
            }
            if reverse { buffer.reverse(b) }
            const format = subtableFormat(&t, st)
            if (format == 0 || format == 2 || format == 3) && requestedKerning {
                machine(f, b, kernMask, true, cross, &t, st)
            }
            if reverse { buffer.reverse(b) }
        }
        st += subtableLength(&t, st)
        i += 1
    }
}

// Kerning by the font's functions, when nothing else positions
// (_hb_ot_shape_fallback_kern).
pub fn applyFallback(f: usize, b: *buffer.Buffer, kernMask: u32) -> void {
    const h = common.isHorizontal(b.*.direction)
    if h && !font.hasFunc(f, font.F_GLYPH_H_KERNING) { return }
    if !h && !font.hasFunc(f, font.F_GLYPH_V_KERNING) { return }
    const reverse = common.isBackward(b.*.direction)
    if reverse { buffer.reverse(b) }
    var t: m.Table = undefined
    t.data = 0
    t.length = 0
    machine(f, b, kernMask, false, false, &t, 0)
    if reverse { buffer.reverse(b) }
}
