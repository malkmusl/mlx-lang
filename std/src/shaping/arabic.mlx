// The Arabic shaper (HarfBuzz's hb-ot-shaper-arabic.cc and
// hb-ot-shaper-arabic-fallback.hh): joining by the Unicode joining types
// into isolated, final, medial and initial forms (the masks of isol, fina,
// fin2, fin3, medi, med2, init), the stch feature's stretching, the
// reordering of modifier combining marks, and for fonts without those
// features, GSUB lookups made of the font's Arabic presentation forms.
const m = @import("./memory.mlx")
const common = @import("./common.mlx")
const unicode = @import("./unicode.mlx")
const font = @import("./font.mlx")
const buffer = @import("./buffer.mlx")
const layout = @import("./layout.mlx")
const p = @import("./props.mlx")
const apply = @import("./apply.mlx")
const plan = @import("./plan.mlx")
const table = @import("./arabictable.mlx")

const JOINING_TYPE_U: u32 = 0
const JOINING_TYPE_L: u32 = 1
const JOINING_TYPE_R: u32 = 2
const JOINING_TYPE_D: u32 = 3
const JOINING_GROUP_ALAPH: u32 = 4
const JOINING_GROUP_DALATH_RISH: u32 = 5
const JOINING_TYPE_T: u32 = 7
const JOINING_TYPE_X: u32 = 8

// Actions (the auxiliary byte of a glyph).
pub const ISOL: u32 = 0
pub const FINA: u32 = 1
pub const FIN2: u32 = 2
pub const FIN3: u32 = 3
pub const MEDI: u32 = 4
pub const MED2: u32 = 5
pub const INIT: u32 = 6
pub const NONE: u32 = 7
const STCH_FIXED: u32 = 8
const STCH_REPEATING: u32 = 9

const NUM_FEATURES: u32 = 7

// Pauses of this shaper (numbers of shapers.mlx).
pub const PAUSE_RECORD_STCH: u32 = 1
pub const PAUSE_DEALLOCATE: u32 = 2
pub const PAUSE_FALLBACK: u32 = 3

const SCRATCH_HAS_STCH: u32 = 0x01000000

fn tag(a: u8, b: u8, c: u8, d: u8) -> u32 { return common.tag(a, b, c, d) }

fn featureTag(i: u32) -> u32 {
    if i == ISOL { return tag(105, 115, 111, 108) }
    if i == FINA { return tag(102, 105, 110, 97) }
    if i == FIN2 { return tag(102, 105, 110, 50) }
    if i == FIN3 { return tag(102, 105, 110, 51) }
    if i == MEDI { return tag(109, 101, 100, 105) }
    if i == MED2 { return tag(109, 101, 100, 50) }
    return tag(105, 110, 105, 116)
}

fn isSyriacFeature(i: u32) -> bool {
    const last = featureTag(i) & 0xFF
    return last == 0x32 || last == 0x33
}

pub fn joiningType(u: u32, genCat: u32) -> u32 {
    var t = JOINING_TYPE_X
    var k: usize = 0
    while k < table.JOINING_RANGES.length {
        if u >= table.JOINING_RANGES[k] && u <= table.JOINING_RANGES[k + 1] {
            t = @intCast(u32, table.JOINING[@intCast(usize, u - table.JOINING_RANGES[k] + table.JOINING_RANGES[k + 2])])
            break
        }
        k += 3
    }
    if t != JOINING_TYPE_X { return t }
    const markish = unicode.flag(unicode.GC_NON_SPACING_MARK) | unicode.flag(unicode.GC_ENCLOSING_MARK) | unicode.flag(unicode.GC_FORMAT)
    return if (unicode.flag(genCat) & markish) != 0 { JOINING_TYPE_T } else { JOINING_TYPE_U }
}

// The state machine: per state and joining type, the action for the
// previous glyph, the action for this one, the next state.
var STATES = [126]u8{
    7, 7, 0, 7, 0, 2, 7, 0, 1, 7, 0, 2, 7, 0, 1, 7, 0, 6,
    7, 7, 0, 7, 0, 2, 7, 0, 1, 7, 0, 2, 7, 2, 5, 7, 0, 6,
    7, 7, 0, 7, 0, 2, 6, 1, 1, 6, 1, 3, 6, 1, 4, 6, 1, 6,
    7, 7, 0, 7, 0, 2, 4, 1, 1, 4, 1, 3, 4, 1, 4, 4, 1, 6,
    7, 7, 0, 7, 0, 2, 5, 0, 1, 5, 0, 2, 5, 2, 5, 5, 0, 6,
    7, 7, 0, 7, 0, 2, 0, 0, 1, 0, 0, 2, 0, 2, 5, 0, 0, 6,
    7, 7, 0, 7, 0, 2, 7, 0, 1, 7, 0, 2, 7, 3, 5, 7, 0, 6,
}

fn entry(state: u32, t: u32, k: u32) -> u32 { return @intCast(u32, STATES[@intCast(usize, state * 18 + t * 3 + k)]) }

pub const ArabicPlan = struct {
    masks: [8]u32
    fallbackPlan: usize
    doFallback: bool
    hasStch: bool
}

fn arabicPlan(address: usize) -> *ArabicPlan { unsafe { return @ptrFromInt(*ArabicPlan, address) } }

pub fn collectFeatures(b: *plan.Builder) -> void {
    plan.enableFeature(b, tag(115, 116, 99, 104), plan.F_NONE, 1)
    plan.addGsubPause(b, PAUSE_RECORD_STCH)
    plan.enableFeature(b, tag(99, 99, 109, 112), plan.F_MANUAL_ZWJ, 1)
    plan.enableFeature(b, tag(108, 111, 99, 108), plan.F_MANUAL_ZWJ, 1)
    plan.addGsubPause(b, 0)
    var i: u32 = 0
    while i < NUM_FEATURES {
        const hasFallback = b.*.script == tag(65, 114, 97, 98) && !isSyriacFeature(i)
        plan.addFeature(b, featureTag(i), plan.F_MANUAL_ZWJ | (if hasFallback { plan.F_HAS_FALLBACK } else { plan.F_NONE }), 1)
        plan.addGsubPause(b, 0)
        i += 1
    }
    plan.addGsubPause(b, PAUSE_DEALLOCATE)
    plan.enableFeature(b, tag(114, 108, 105, 103), plan.F_MANUAL_ZWJ | plan.F_HAS_FALLBACK, 1)
    if b.*.script == tag(65, 114, 97, 98) { plan.addGsubPause(b, PAUSE_FALLBACK) }
    plan.enableFeature(b, tag(99, 97, 108, 116), plan.F_MANUAL_ZWJ, 1)
    if !plan.hasFeature(b, tag(114, 99, 108, 116)) {
        plan.addGsubPause(b, 0)
        plan.enableFeature(b, tag(114, 99, 108, 116), plan.F_MANUAL_ZWJ, 1)
    }
    plan.enableFeature(b, tag(108, 105, 103, 97), plan.F_MANUAL_ZWJ, 1)
    plan.enableFeature(b, tag(99, 108, 105, 103), plan.F_MANUAL_ZWJ, 1)
    plan.enableFeature(b, tag(109, 115, 101, 116), plan.F_MANUAL_ZWJ, 1)
}

pub fn dataCreate(pl: *plan.Plan) -> usize {
    const address = m.alloc(@sizeOf(ArabicPlan))
    if address == 0 { return 0 }
    const ap = arabicPlan(address)
    ap.*.doFallback = pl.*.script == tag(65, 114, 97, 98)
    ap.*.hasStch = plan.get1Mask(&pl.*.map, tag(115, 116, 99, 104)) != 0
    var i: u32 = 0
    while i < NUM_FEATURES {
        ap.*.masks[@intCast(usize, i)] = plan.get1Mask(&pl.*.map, featureTag(i))
        ap.*.doFallback = ap.*.doFallback && (isSyriacFeature(i) || plan.needsFallback(&pl.*.map, featureTag(i)))
        i += 1
    }
    ap.*.masks[7] = 0
    return address
}

pub fn dataDestroy(data: usize) -> void {
    if data == 0 { return }
    fallbackPlanDestroy(arabicPlan(data).*.fallbackPlan)
    m.release(data)
}

fn contextCodepoint(b: *buffer.Buffer, side: u32, i: u32) -> u32 { return b.*.context[@intCast(usize, side * 5 + i)] }

fn joining(b: *buffer.Buffer) -> void {
    const count = b.*.len
    var prev: u32 = 0xFFFFFFFF
    var state: u32 = 0
    var i: u32 = 0
    while i < b.*.contextLen0 {
        const c = contextCodepoint(b, 0, i)
        const t = joiningType(c, unicode.generalCategory(b.*.unicode, c))
        i += 1
        if t == JOINING_TYPE_T { continue }
        state = entry(state, t, 2)
        break
    }
    i = 0
    while i < count {
        const g = buffer.info(b, i)
        const t = joiningType(g.*.codepoint, p.generalCategory(g))
        if t == JOINING_TYPE_T {
            p.setAuxiliary(g, NONE)
            i += 1
            continue
        }
        const prevAction = entry(state, t, 0)
        if prevAction != NONE && prev != 0xFFFFFFFF {
            p.setAuxiliary(buffer.info(b, prev), prevAction)
            buffer.safeToInsertTatweel(b, prev, i + 1)
        } else {
            if prev == 0xFFFFFFFF {
                if t >= JOINING_TYPE_R { buffer.unsafeToConcatFromOutbuffer(b, 0, i + 1) }
            } else {
                if t >= JOINING_TYPE_R || (2 <= state && state <= 5) { buffer.unsafeToConcat(b, prev, i + 1) }
            }
        }
        p.setAuxiliary(g, entry(state, t, 1))
        prev = i
        state = entry(state, t, 2)
        i += 1
    }
    i = 0
    while i < b.*.contextLen1 {
        const c = contextCodepoint(b, 1, i)
        const t = joiningType(c, unicode.generalCategory(b.*.unicode, c))
        i += 1
        if t == JOINING_TYPE_T { continue }
        const prevAction = entry(state, t, 0)
        if prevAction != NONE && prev != 0xFFFFFFFF {
            p.setAuxiliary(buffer.info(b, prev), prevAction)
            buffer.safeToInsertTatweel(b, prev, b.*.len)
        } else if 2 <= state && state <= 5 {
            buffer.unsafeToConcat(b, prev, b.*.len)
        }
        break
    }
}

fn mongolianVariationSelectors(b: *buffer.Buffer) -> void {
    var i: u32 = 1
    while i < b.*.len {
        const g = buffer.info(b, i)
        if (g.*.codepoint >= 0x180B && g.*.codepoint <= 0x180D) || g.*.codepoint == 0x180F { p.setAuxiliary(g, p.auxiliary(buffer.info(b, i - 1))) }
        i += 1
    }
}

// The joining masks (also for the Universal Shaping Engine's joining
// scripts).
pub fn setupMasksPlan(data: usize, b: *buffer.Buffer, script: u32) -> void {
    const ap = arabicPlan(data)
    joining(b)
    if script == tag(77, 111, 110, 103) { mongolianVariationSelectors(b) }
    var i: u32 = 0
    while i < b.*.len {
        const g = buffer.info(b, i)
        const action = p.auxiliary(g)
        if action <= 7 { g.*.mask |= ap.*.masks[@intCast(usize, action)] }
        i += 1
    }
}

pub fn setupMasks(pl: *plan.Plan, b: *buffer.Buffer, f: usize) -> void { setupMasksPlan(pl.*.data, b, pl.*.script) }

pub fn recordStch(pl: *plan.Plan, b: *buffer.Buffer) -> void {
    if !arabicPlan(pl.*.data).*.hasStch { return }
    var i: u32 = 0
    while i < b.*.len {
        const g = buffer.info(b, i)
        if p.multiplied(g) {
            p.setAuxiliary(g, if (p.ligComp(g) % 2) != 0 { STCH_REPEATING } else { STCH_FIXED })
            b.*.scratchFlags |= SCRATCH_HAS_STCH
        }
        i += 1
    }
}

fn isWord(gc: u32) -> bool {
    const word = unicode.flag(unicode.GC_UNASSIGNED) | unicode.flag(unicode.GC_PRIVATE_USE) | unicode.flag(unicode.GC_MODIFIER_LETTER) | unicode.flag(unicode.GC_OTHER_LETTER) | unicode.flag(unicode.GC_SPACING_MARK) | unicode.flag(unicode.GC_ENCLOSING_MARK) | unicode.flag(unicode.GC_NON_SPACING_MARK) | unicode.flag(unicode.GC_DECIMAL_NUMBER) | unicode.flag(unicode.GC_LETTER_NUMBER) | unicode.flag(unicode.GC_OTHER_NUMBER) | unicode.flag(unicode.GC_CURRENCY_SYMBOL) | unicode.flag(unicode.GC_MODIFIER_SYMBOL) | unicode.flag(unicode.GC_MATH_SYMBOL) | unicode.flag(unicode.GC_OTHER_SYMBOL)
    return (unicode.flag(gc) & word) != 0
}

fn isStch(g: *buffer.GlyphInfo) -> bool {
    const a = p.auxiliary(g)
    return a == STCH_FIXED || a == STCH_REPEATING
}

fn applyStch(b: *buffer.Buffer, f: usize) -> void {
    if (b.*.scratchFlags & SCRATCH_HAS_STCH) == 0 { return }
    const rtl = b.*.direction == common.DIRECTION_RTL
    if !rtl { buffer.reverse(b) }
    const sign: i32 = if font.font(f).*.xScale < 0 { -1 } else { 1 }
    var extraGlyphsNeeded: u32 = 0
    var step: u32 = 0
    while step <= 1 {
        const count = b.*.len
        const newLen = count + extraGlyphsNeeded
        var j = newLen
        var i = count
        while i > 0 {
            if !isStch(buffer.info(b, i - 1)) {
                if step == 1 {
                    j -= 1
                    buffer.copyInfo(buffer.info(b, j), buffer.info(b, i - 1))
                    buffer.copyInfo(buffer.infoAt(b.*.pos, j), buffer.infoAt(b.*.pos, i - 1))
                }
                i -= 1
                continue
            }
            var wTotal: i32 = 0
            var wFixed: i32 = 0
            var wRepeating: i32 = 0
            var nFixed: i32 = 0
            var nRepeating: i32 = 0
            const end = i
            while i > 0 && isStch(buffer.info(b, i - 1)) {
                i -= 1
                const width = font.getGlyphHAdvance(f, buffer.info(b, i).*.codepoint)
                if p.auxiliary(buffer.info(b, i)) == STCH_FIXED {
                    wFixed +%= width
                    nFixed += 1
                } else {
                    wRepeating +%= width
                    nRepeating += 1
                }
            }
            const start = i
            var context = i
            while context > 0 && !isStch(buffer.info(b, context - 1)) && (p.isDefaultIgnorable(buffer.info(b, context - 1)) || isWord(p.generalCategory(buffer.info(b, context - 1)))) {
                context -= 1
                wTotal +%= buffer.pos(b, context).*.xAdvance
            }
            i += 1
            var nCopies: i32 = 0
            var wRemaining = wTotal -% wFixed
            if sign * wRemaining > sign * wRepeating && sign * wRepeating > 0 { nCopies = (sign * wRemaining) / (sign * wRepeating) - 1 }
            var extraRepeatOverlap: i32 = 0
            const shortfall = sign * wRemaining - sign * wRepeating * (nCopies + 1)
            if shortfall > 0 && nRepeating > 0 {
                nCopies += 1
                const excess = (nCopies + 1) * sign * wRepeating - sign * wRemaining
                if excess > 0 {
                    extraRepeatOverlap = excess / (nCopies * nRepeating)
                    wRemaining = 0
                }
            }
            if step == 0 {
                extraGlyphsNeeded += @intCast(u32, nCopies * nRepeating)
            } else {
                buffer.unsafeToBreak(b, context, end)
                var xOffset = wRemaining / 2
                var k = end
                while k > start {
                    const width = font.getGlyphHAdvance(f, buffer.info(b, k - 1).*.codepoint)
                    var repeat: u32 = 1
                    if p.auxiliary(buffer.info(b, k - 1)) == STCH_REPEATING { repeat += @intCast(u32, nCopies) }
                    buffer.pos(b, k - 1).*.xAdvance = 0
                    var n: u32 = 0
                    while n < repeat {
                        if rtl {
                            xOffset -%= width
                            if n > 0 { xOffset +%= extraRepeatOverlap }
                        }
                        buffer.pos(b, k - 1).*.xOffset = xOffset
                        j -= 1
                        buffer.copyInfo(buffer.info(b, j), buffer.info(b, k - 1))
                        buffer.copyInfo(buffer.infoAt(b.*.pos, j), buffer.infoAt(b.*.pos, k - 1))
                        if !rtl {
                            xOffset +%= width
                            if n > 0 { xOffset -%= extraRepeatOverlap }
                        }
                        n += 1
                    }
                    k -= 1
                }
            }
            i -= 1
        }
        if step == 0 {
            if !buffer.ensure(b, count + extraGlyphsNeeded) { break }
        } else {
            b.*.len = newLen
        }
        step += 1
    }
    if !rtl { buffer.reverse(b) }
}

pub fn postprocessGlyphs(pl: *plan.Plan, b: *buffer.Buffer, f: usize) -> void { applyStch(b, f) }

var MODIFIER_COMBINING_MARKS = [14]u32{ 0x0654, 0x0655, 0x0658, 0x06DC, 0x06E3, 0x06E7, 0x06E8, 0x08CA, 0x08CB, 0x08CD, 0x08CE, 0x08CF, 0x08D3, 0x08F3 }

fn isMcm(g: *buffer.GlyphInfo) -> bool {
    var i: usize = 0
    while i < 14 {
        if MODIFIER_COMBINING_MARKS[i] == g.*.codepoint { return true }
        i += 1
    }
    return false
}

pub fn reorderMarks(b: *buffer.Buffer, start_: u32, end: u32) -> void {
    var start = start_
    var i = start
    var cc: u32 = 220
    var temp: [32]buffer.GlyphInfo = undefined
    while cc <= 230 {
        while i < end && p.modifiedCombiningClass(buffer.info(b, i)) < cc { i += 1 }
        if i == end { break }
        if p.modifiedCombiningClass(buffer.info(b, i)) > cc {
            cc += 10
            continue
        }
        var j = i
        while j < end && p.modifiedCombiningClass(buffer.info(b, j)) == cc && isMcm(buffer.info(b, j)) { j += 1 }
        if i == j {
            cc += 10
            continue
        }
        buffer.mergeClusters(b, start, j)
        const tmp = @intFromPtr(&temp)
        m.copy(tmp, b.*.info + @intCast(usize, i) * buffer.INFO_SIZE, @intCast(usize, j - i) * buffer.INFO_SIZE)
        m.copy(b.*.info + @intCast(usize, start + j - i) * buffer.INFO_SIZE, b.*.info + @intCast(usize, start) * buffer.INFO_SIZE, @intCast(usize, i - start) * buffer.INFO_SIZE)
        m.copy(b.*.info + @intCast(usize, start) * buffer.INFO_SIZE, tmp, @intCast(usize, j - i) * buffer.INFO_SIZE)
        const newStart = start + j - i
        const newCc: u32 = if cc == 220 { 25 } else { 26 }
        while start < newStart {
            p.setModifiedCombiningClass(buffer.info(b, start), newCc)
            start += 1
        }
        i = j
        cc += 10
    }
}

// ---------------------------------------------------------------------------
// The fallback: lookups made of the font's presentation forms

// A fallback plan: the count of lookups, then for each a mask and the
// address of its table (the lookup at offset 4 of it).
const FALLBACK_MAX: usize = 7

fn fallbackPlanDestroy(fp: usize) -> void {
    if fp == 0 || fp == 1 { return }
    const n = @intCast(usize, m.get32(fp))
    var i: usize = 0
    while i < n {
        m.release(m.getWord(fp + 8 + i * 16 + 8))
        i += 1
    }
    m.release(fp)
}

fn fallbackFeature(i: u32) -> u32 {
    if i == 0 { return tag(105, 110, 105, 116) }
    if i == 1 { return tag(109, 101, 100, 105) }
    if i == 2 { return tag(102, 105, 110, 97) }
    if i == 3 { return tag(105, 115, 111, 108) }
    return tag(114, 108, 105, 103)
}

fn getGlyph(f: usize, u: u32, g: *u32) -> bool { return font.getNominalGlyph(f, u, g) }

// Sorts `n` glyph ids at `glyphs` (u32 each), carrying the words at
// `other` along (stable).
fn stableSort(glyphs: usize, other: usize, n: u32) -> void {
    var i: u32 = 1
    while i < n {
        const g = m.get32(glyphs + @intCast(usize, i) * 4)
        const o = m.get32(other + @intCast(usize, i) * 4)
        var j = i
        while j > 0 && m.get32(glyphs + @intCast(usize, j - 1) * 4) > g {
            m.put32(glyphs + @intCast(usize, j) * 4, m.get32(glyphs + @intCast(usize, j - 1) * 4))
            m.put32(other + @intCast(usize, j) * 4, m.get32(other + @intCast(usize, j - 1) * 4))
            j -= 1
        }
        m.put32(glyphs + @intCast(usize, j) * 4, g)
        m.put32(other + @intCast(usize, j) * 4, o)
        i += 1
    }
}

fn put16(at: usize, v: u32) -> void {
    m.put8(at, @intCast(u8, (v >> 8) & 0xFF))
    m.put8(at + 1, @intCast(u8, v & 0xFF))
}

// A single substitution lookup of feature `index` (0..3).
fn synthesizeSingle(f: usize, index: usize) -> usize {
    const count = @intCast(usize, table.SHAPING_LAST - table.SHAPING_FIRST + 1)
    const glyphs = m.alloc(count * 4)
    const substitutes = m.alloc(count * 4)
    var n: u32 = 0
    var u = table.SHAPING_FIRST
    while u <= table.SHAPING_LAST {
        const s = @intCast(u32, table.SHAPING[@intCast(usize, u - table.SHAPING_FIRST) * 4 + index])
        var ug: u32 = 0
        var sg: u32 = 0
        if s != 0 && getGlyph(f, u, &ug) && getGlyph(f, s, &sg) && ug != sg && ug <= 0xFFFF && sg <= 0xFFFF {
            m.put32(glyphs + @intCast(usize, n) * 4, ug)
            m.put32(substitutes + @intCast(usize, n) * 4, sg)
            n += 1
        }
        u += 1
    }
    var t: usize = 0
    if n != 0 {
        stableSort(glyphs, substitutes, n)
        // Lookup at 4: type 1, flag IgnoreMarks, one subtable at 8 from it;
        // SingleSubst format 2 with its coverage after the substitutes.
        const nn = @intCast(usize, n)
        const st = 12
        const coverage = st + 6 + nn * 2
        t = m.alloc(coverage + 4 + nn * 2)
        m.put32(t, @intCast(u32, coverage + 4 + nn * 2))
        put16(t + 4, 1)
        put16(t + 6, 8)
        put16(t + 8, 1)
        put16(t + 10, 8)
        put16(t + st, 2)
        put16(t + st + 2, @intCast(u32, coverage - st))
        put16(t + st + 4, n)
        put16(t + coverage, 1)
        put16(t + coverage + 2, n)
        var k: usize = 0
        while k < nn {
            put16(t + st + 6 + k * 2, m.get32(substitutes + k * 4))
            put16(t + coverage + 4 + k * 2, m.get32(glyphs + k * 4))
            k += 1
        }
    }
    m.release(glyphs)
    m.release(substitutes)
    return t
}

// A ligature lookup of one of the ligature tables: `data` (u16 entries),
// `entries` sets of a first character and `per` ligatures of `comps`
// further characters each.
fn synthesizeLigature(f: usize, which: u32, flags: u32) -> usize {
    var entries: usize = 0
    var per: usize = 0
    var comps: usize = 0
    if which == 0 {
        entries = table.LIGATURES_3.length / 10
        per = 3
        comps = 2
    } else if which == 1 {
        entries = table.LIGATURES.length / 29
        per = 14
        comps = 1
    } else {
        entries = table.LIGATURES_MARK.length / 11
        per = 5
        comps = 1
    }
    const setSize = 1 + per * (comps + 1)
    const firstGlyphs = m.alloc(entries * 4 + 4)
    const indirection = m.alloc(entries * 4 + 4)
    const perFirst = m.alloc(entries * 4 + 4)
    const ligatureList = m.alloc(entries * per * 4 + 4)
    const componentCounts = m.alloc(entries * per * 4 + 4)
    const componentList = m.alloc(entries * per * comps * 4 + 4)
    var numFirst: u32 = 0
    var i: usize = 0
    while i < entries {
        var g: u32 = 0
        if getGlyph(f, ligValue(which, i * setSize), &g) {
            m.put32(firstGlyphs + @intCast(usize, numFirst) * 4, g)
            m.put32(perFirst + @intCast(usize, numFirst) * 4, 0)
            m.put32(indirection + @intCast(usize, numFirst) * 4, @intCast(u32, i))
            numFirst += 1
        }
        i += 1
    }
    stableSort(firstGlyphs, indirection, numFirst)
    var numLigatures: u32 = 0
    var numComponents: u32 = 0
    var k: u32 = 0
    while k < numFirst {
        const index = @intCast(usize, m.get32(indirection + @intCast(usize, k) * 4))
        var l: usize = 0
        while l < per {
            const at = index * setSize + 1 + l * (comps + 1)
            var ligGlyph: u32 = 0
            if getGlyph(f, ligValue(which, at + comps), &ligGlyph) {
                var matched = true
                var c: usize = 0
                while c < comps {
                    const cu = ligValue(which, at + c)
                    var cg: u32 = 0
                    if cu == 0 || !font.getNominalGlyph(f, cu, &cg) {
                        matched = false
                        break
                    }
                    m.put32(componentList + @intCast(usize, numComponents) * 4, cg)
                    numComponents += 1
                    c += 1
                }
                if matched {
                    m.put32(componentCounts + @intCast(usize, numLigatures) * 4, @intCast(u32, 1 + comps))
                    m.put32(ligatureList + @intCast(usize, numLigatures) * 4, ligGlyph)
                    m.put32(perFirst + @intCast(usize, k) * 4, m.get32(perFirst + @intCast(usize, k) * 4) + 1)
                    numLigatures += 1
                }
            }
            l += 1
        }
        k += 1
    }
    var t: usize = 0
    if numLigatures != 0 {
        // Lookup at 4 (type 4), LigatureSubst format 1 at 12, then its
        // ligature set offsets, the sets, the ligatures, the coverage.
        const nf = @intCast(usize, numFirst)
        const st: usize = 12
        var size = st + 6 + nf * 2
        size += nf * 2 + @intCast(usize, numLigatures) * 2
        size += @intCast(usize, numLigatures) * (4 + comps * 2)
        size += 4 + nf * 2
        t = m.alloc(size + 16)
        m.put32(t, @intCast(u32, size + 16))
        put16(t + 4, 4)
        put16(t + 6, flags)
        put16(t + 8, 1)
        put16(t + 10, 8)
        put16(t + st, 1)
        put16(t + st + 4, numFirst)
        var at = st + 6 + nf * 2
        var ligIndex: u32 = 0
        var compIndex: u32 = 0
        k = 0
        while k < numFirst {
            const set = at
            put16(t + st + 6 + @intCast(usize, k) * 2, @intCast(u32, set - st))
            const n = m.get32(perFirst + @intCast(usize, k) * 4)
            put16(t + set, n)
            at = set + 2 + @intCast(usize, n) * 2
            var q: u32 = 0
            while q < n {
                const lig = at
                put16(t + set + 2 + @intCast(usize, q) * 2, @intCast(u32, lig - set))
                const cc = m.get32(componentCounts + @intCast(usize, ligIndex) * 4)
                put16(t + lig, m.get32(ligatureList + @intCast(usize, ligIndex) * 4))
                put16(t + lig + 2, cc)
                var c: u32 = 1
                while c < cc {
                    put16(t + lig + 4 + @intCast(usize, c - 1) * 2, m.get32(componentList + @intCast(usize, compIndex) * 4))
                    compIndex += 1
                    c += 1
                }
                at = lig + 4 + @intCast(usize, cc - 1) * 2
                ligIndex += 1
                q += 1
            }
            k += 1
        }
        put16(t + st + 2, @intCast(u32, at - st))
        put16(t + at, 1)
        put16(t + at + 2, numFirst)
        k = 0
        while k < numFirst {
            put16(t + at + 4 + @intCast(usize, k) * 2, m.get32(firstGlyphs + @intCast(usize, k) * 4))
            k += 1
        }
    }
    m.release(firstGlyphs)
    m.release(indirection)
    m.release(perFirst)
    m.release(ligatureList)
    m.release(componentCounts)
    m.release(componentList)
    return t
}

fn ligValue(which: u32, i: usize) -> u32 {
    if which == 0 { return @intCast(u32, table.LIGATURES_3[i]) }
    if which == 1 { return @intCast(u32, table.LIGATURES[i]) }
    return @intCast(u32, table.LIGATURES_MARK[i])
}

fn fallbackPlanCreate(pl: *plan.Plan, f: usize) -> usize {
    const fp = m.alloc(8 + FALLBACK_MAX * 16)
    var j: usize = 0
    var i: u32 = 0
    while i < 7 {
        const mask = plan.get1Mask(&pl.*.map, fallbackFeature(i))
        if mask != 0 {
            var t: usize = 0
            if i < 4 {
                t = synthesizeSingle(f, @intCast(usize, i))
            } else if i == 4 {
                t = synthesizeLigature(f, 0, 0x0008)
            } else if i == 5 {
                t = synthesizeLigature(f, 1, 0x0008)
            } else {
                t = synthesizeLigature(f, 2, 0)
            }
            if t != 0 {
                m.put32(fp + 8 + j * 16, mask)
                m.putWord(fp + 8 + j * 16 + 8, t)
                j += 1
            }
        }
        i += 1
    }
    m.put32(fp, @intCast(u32, j))
    if j == 0 {
        m.release(fp)
        return 1
    }
    return fp
}

// The fallback's pause: makes the plan's lookups once and applies them.
pub fn fallbackShape(pl: *plan.Plan, f: usize, b: *buffer.Buffer) -> bool {
    const ap = arabicPlan(pl.*.data)
    if !ap.*.doFallback { return false }
    var fp = m.atomicLoadWord(@intFromPtr(&ap.*.fallbackPlan))
    if fp == 0 {
        const made = fallbackPlanCreate(pl, f)
        if !m.swapWord(@intFromPtr(&ap.*.fallbackPlan), 0, made) { fallbackPlanDestroy(made) }
        fp = m.atomicLoadWord(@intFromPtr(&ap.*.fallbackPlan))
    }
    if fp == 1 { return true }
    var c: apply.Apply = undefined
    apply.init(&c, 0, f, @intFromPtr(b))
    const n = @intCast(usize, m.get32(fp))
    var i: usize = 0
    while i < n {
        const t = m.getWord(fp + 8 + i * 16 + 8)
        c.t.data = t
        c.t.length = @intCast(usize, m.get32(t))
        apply.setLookupMask(&c, m.get32(fp + 8 + i * 16))
        apply.initIters(&c)
        _ = apply.applyString(&c, 4)
        i += 1
    }
    apply.fini(&c)
    return true
}
