// The Hebrew shaper (HarfBuzz's hb-ot-shaper-hebrew.cc): composition into
// the presentation forms old fonts have (when the font positions no marks
// with GPOS), and the reordering of patah or qamats, sheva or hiriq and
// meteg.
const m = @import("./memory.mlx")
const unicode = @import("./unicode.mlx")
const buffer = @import("./buffer.mlx")
const p = @import("./props.mlx")
const plan = @import("./plan.mlx")

var DAGESH_FORMS = [27]u32{ 0xFB30, 0xFB31, 0xFB32, 0xFB33, 0xFB34, 0xFB35, 0xFB36, 0, 0xFB38, 0xFB39, 0xFB3A, 0xFB3B, 0xFB3C, 0, 0xFB3E, 0, 0xFB40, 0xFB41, 0, 0xFB43, 0xFB44, 0, 0xFB46, 0xFB47, 0xFB48, 0xFB49, 0xFB4A }

pub fn compose(pl: *plan.Plan, u: usize, a: u32, b: u32, ab: *u32) -> bool {
    var found = unicode.compose(u, a, b, ab)
    if found || pl.*.hasGposMark { return found }
    if b == 0x05B4 {
        if a == 0x05D9 {
            ab.* = 0xFB1D
            found = true
        }
    } else if b == 0x05B7 {
        if a == 0x05F2 {
            ab.* = 0xFB1F
            found = true
        } else if a == 0x05D0 {
            ab.* = 0xFB2E
            found = true
        }
    } else if b == 0x05B8 {
        if a == 0x05D0 {
            ab.* = 0xFB2F
            found = true
        }
    } else if b == 0x05B9 {
        if a == 0x05D5 {
            ab.* = 0xFB4B
            found = true
        }
    } else if b == 0x05BC {
        if a >= 0x05D0 && a <= 0x05EA {
            ab.* = DAGESH_FORMS[@intCast(usize, a - 0x05D0)]
            found = ab.* != 0
        } else if a == 0xFB2A {
            ab.* = 0xFB2C
            found = true
        } else if a == 0xFB2B {
            ab.* = 0xFB2D
            found = true
        }
    } else if b == 0x05BF {
        if a == 0x05D1 {
            ab.* = 0xFB4C
            found = true
        } else if a == 0x05DB {
            ab.* = 0xFB4D
            found = true
        } else if a == 0x05E4 {
            ab.* = 0xFB4E
            found = true
        }
    } else if b == 0x05C1 {
        if a == 0x05E9 {
            ab.* = 0xFB2A
            found = true
        } else if a == 0xFB49 {
            ab.* = 0xFB2C
            found = true
        }
    } else if b == 0x05C2 {
        if a == 0x05E9 {
            ab.* = 0xFB2B
            found = true
        } else if a == 0xFB49 {
            ab.* = 0xFB2D
            found = true
        }
    }
    return found
}

pub fn reorderMarks(b: *buffer.Buffer, start: u32, end: u32) -> void {
    var i = start + 2
    var t: buffer.GlyphInfo = undefined
    while i < end {
        const c0 = p.modifiedCombiningClass(buffer.info(b, i - 2))
        const c1 = p.modifiedCombiningClass(buffer.info(b, i - 1))
        const c2 = p.modifiedCombiningClass(buffer.info(b, i))
        if (c0 == 20 || c0 == 21) && (c1 == 22 || c1 == 23) && (c2 == 25 || c2 == 220) {
            buffer.mergeClusters(b, i - 1, i + 1)
            buffer.copyInfo(&t, buffer.info(b, i - 1))
            buffer.copyInfo(buffer.info(b, i - 1), buffer.info(b, i))
            buffer.copyInfo(buffer.info(b, i), &t)
            break
        }
        i += 1
    }
}
