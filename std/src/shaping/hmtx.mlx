// hmtx and vmtx: the advances and side bearings of glyphs (HarfBuzz's
// hb-ot-hmtx-table.hh), with the counts worked out as HarfBuzz works them
// out of hhea or vhea, maxp and the table's length.
const m = @import("./memory.mlx")
const face = @import("./face.mlx")

pub const Metrics = struct {
    table: m.Table
    numLongMetrics: u32
    numBearings: u32
    numAdvances: u32
    numGlyphs: u32
    defaultAdvance: u32
}

pub fn metricsOf(address: usize) -> *Metrics { unsafe { return @ptrFromInt(*Metrics, address) } }

pub fn hmtxFreeCallback(a: usize) -> void { m.release(a) }

// The maxp table's glyph count (0 without a valid maxp).
pub fn maxpNumGlyphs(fc: usize) -> u32 {
    var maxp: m.Table = undefined
    face.view(fc, face.T_MAXP, &maxp)
    const version = m.u32at(&maxp, 0)
    if (version == 0x00010000 && maxp.length >= 32) || (version == 0x00005000 && maxp.length >= 6) { return m.u16at(&maxp, 4) }
    return 0
}

// hhea or vhea (horizontal or not) if it passes HarfBuzz's checks.
pub fn headerView(fc: usize, horizontal: bool, out: *m.Table) -> void {
    face.view(fc, if horizontal { face.T_HHEA } else { face.T_VHEA }, out)
    if out.*.length < 36 || m.u16at(out, 0) != 1 { out.*.length = 0 }
}

pub fn accel(fc: usize, horizontal: bool) -> *Metrics {
    const slot = if horizontal { face.A_HMTX } else { face.A_VMTX }
    var a = face.accel(fc, slot)
    if a == 0 {
        const made = m.alloc(@sizeOf(Metrics))
        const h = metricsOf(made)
        face.view(fc, if horizontal { face.T_HMTX } else { face.T_VMTX }, &h.*.table)
        const upem = face.upem(fc)
        h.*.defaultAdvance = if horizontal { upem / 2 } else { upem }
        var len = @intCast(u32, h.*.table.length & 0xFFFFFFFF)
        if (len & 1) != 0 { len -= 1 }
        var header: m.Table = undefined
        headerView(fc, horizontal, &header)
        var longs = m.u16at(&header, 34)
        if longs * 4 > len { longs = len / 4 }
        len -= longs * 4
        var bearings = maxpNumGlyphs(fc)
        if bearings < longs { bearings = longs }
        if (bearings - longs) * 2 > len { bearings = longs + len / 2 }
        len -= (bearings - longs) * 2
        if longs == 0 {
            bearings = 0
            longs = 0
        }
        h.*.numLongMetrics = longs
        h.*.numBearings = bearings
        h.*.numAdvances = bearings + len / 2
        var n = face.numGlyphs(fc)
        if n < h.*.numAdvances { n = h.*.numAdvances }
        h.*.numGlyphs = n
        a = face.keepAccel(fc, slot, made, @intFromPtr(hmtxFreeCallback))
    }
    return metricsOf(a)
}

pub fn hasData(h: *Metrics) -> bool { return h.*.numBearings != 0 }

pub fn advanceUnscaled(h: *Metrics, glyph: u32) -> u32 {
    const t = &h.*.table
    if glyph < h.*.numBearings {
        const i = if glyph < h.*.numLongMetrics - 1 { glyph } else { h.*.numLongMetrics - 1 }
        return m.u16at(t, @intCast(usize, i) * 4)
    }
    if h.*.numAdvances == 0 { return h.*.defaultAdvance }
    if glyph >= h.*.numGlyphs { return 0 }
    if h.*.numBearings == h.*.numAdvances { return advanceUnscaled(h, h.*.numBearings - 1) }
    const advances = @intCast(usize, h.*.numLongMetrics) * 4 + @intCast(usize, h.*.numBearings - h.*.numLongMetrics) * 2
    var i = glyph - h.*.numBearings
    if i > h.*.numAdvances - h.*.numBearings - 1 { i = h.*.numAdvances - h.*.numBearings - 1 }
    return m.u16at(t, advances + @intCast(usize, i) * 2)
}

// The leading side bearing of `glyph`; whether the table has one.
pub fn bearingUnscaled(h: *Metrics, glyph: u32, out: *i32) -> bool {
    const t = &h.*.table
    if glyph < h.*.numLongMetrics {
        out.* = m.i16at(t, @intCast(usize, glyph) * 4 + 2)
        return true
    }
    if glyph >= h.*.numBearings { return false }
    out.* = m.i16at(t, @intCast(usize, h.*.numLongMetrics) * 4 + @intCast(usize, glyph - h.*.numLongMetrics) * 2)
    return true
}
