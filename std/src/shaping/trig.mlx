// The float sine, cosine and tangent of the GNU C library (2.39) that
// HarfBuzz's paint transforms call: sinf and cosf of its sincosf.h (a
// reduction by pi/2 in double, then polynomials in double), tanf of fdlibm
// in float after the same reduction; their results are the library's, to
// the bit, for angles under 120 (the larger reduction of the library is
// not done: larger angles take the sine and cosine of std.math).
const math = @import("std.math")

// The constants of __sincosf_table (their bits): for quadrants 2 and 3 the
// cosine coefficients have their signs flipped.
fn d(bits: u64) -> f64 { return @bitCast(f64, bits) }
const HPI_INV_BITS: u64 = 0x41645F306DC9C883
const HPI_BITS: u64 = 0x3FF921FB54442D18
const C1_BITS: u64 = 0xBFDFFFFFFD0C621C
const C2_BITS: u64 = 0x3FA55553E1068F19
const C3_BITS: u64 = 0xBF56C087E89A359D
const C4_BITS: u64 = 0x3EF99343027BF8C3
const S1_BITS: u64 = 0xBFC555545995A603
const S2_BITS: u64 = 0x3F81107605230BC4
const S3_BITS: u64 = 0xBF2994EB3774CF24

fn abstop12(x: f32) -> u32 { return (@bitCast(u32, x) >> 20) & 0x7FF }

// The polynomial of sin (n even) or cos (n odd) near zero; `flip` takes the
// second table (the cosine's signs flipped).
fn poly(x: f64, x2: f64, flip: bool, n: i32) -> f32 {
    if (n & 1) == 0 {
        const x3 = x * x2
        const s1 = d(S2_BITS) + x2 * d(S3_BITS)
        const x7 = x3 * x2
        const s = x + x3 * d(S1_BITS)
        return @floatCast(f32, s + x7 * s1)
    }
    const k: f64 = if flip { -1.0 } else { 1.0 }
    const x4 = x2 * x2
    const c2 = k * d(C3_BITS) + x2 * (k * d(C4_BITS))
    const c1 = k + x2 * (k * d(C1_BITS))
    const x6 = x4 * x2
    const c = c1 + x4 * (k * d(C2_BITS))
    return @floatCast(f32, c + x6 * c2)
}

// x less the nearest multiple n of pi/2 (in double), and n.
fn reduce(x: f64, n: *i32) -> f64 {
    const r = x * d(HPI_INV_BITS)
    const q = (@intFromFloat(i32, r) + 0x800000) >> 24
    n.* = q
    return x - @floatFromInt(f64, q) * d(HPI_BITS)
}

const PIO4_BITS: u32 = 0x3F490FDB
const SMALL_BITS: u32 = 0x39800000
const LARGE_BITS: u32 = 0x42F00000

fn abstop12Bits(b: u32) -> u32 { return (b >> 20) & 0x7FF }

pub fn sinf(y: f32) -> f32 {
    const x = @floatCast(f64, y)
    if abstop12(y) < abstop12Bits(PIO4_BITS) {
        if abstop12(y) < abstop12Bits(SMALL_BITS) { return y }
        return poly(x, x * x, false, 0)
    }
    if abstop12(y) >= abstop12Bits(LARGE_BITS) { return @floatCast(f32, math.sin(x)) }
    var n: i32 = 0
    const r = reduce(x, &n)
    const s: f64 = if (n & 3) == 1 || (n & 3) == 2 { -1.0 } else { 1.0 }
    return poly(r * s, r * r, (n & 2) != 0, n)
}

pub fn cosf(y: f32) -> f32 {
    const x = @floatCast(f64, y)
    if abstop12(y) < abstop12Bits(PIO4_BITS) {
        if abstop12(y) < abstop12Bits(SMALL_BITS) { return 1.0 }
        return poly(x, x * x, false, 1)
    }
    if abstop12(y) >= abstop12Bits(LARGE_BITS) { return @floatCast(f32, math.cos(x)) }
    var n: i32 = 0
    const r = reduce(x, &n)
    const s: f64 = if (n & 3) == 1 || (n & 3) == 2 { -1.0 } else { 1.0 }
    return poly(r * s, r * r, (n & 2) != 0, n ^ 1)
}

fn bitsOf(x: f32) -> u32 { return @bitCast(u32, x) }
fn ofBits(b: u32) -> f32 { return @bitCast(f32, b) }

// fdlibm's float tangent kernel: tan (x + y) for |x + y| under pi/4 or so,
// -1 / tan if iy is -1.
fn kernelTanf(x_: f32, y_: f32, iy: i32) -> f32 {
    var x = x_
    var y = y_
    const hx = @bitCast(i32, bitsOf(x))
    const ix = hx & 0x7FFFFFFF
    if ix < 0x39000000 {
        if @intFromFloat(i32, x) == 0 {
            if (ix | (iy + 1)) == 0 { return 1.0 / (if x < 0.0 { 0.0 - x } else { x }) }
            if iy == 1 { return x }
            return -1.0 / x
        }
    }
    const big = ix >= 0x3F2CA140
    if big {
        if hx < 0 {
            x = 0.0 - x
            y = 0.0 - y
        }
        const z0 = ofBits(0x3F490FDA) - x
        const w0 = ofBits(0x33222168) - y
        x = z0 + w0
        y = 0.0
        if (if x < 0.0 { 0.0 - x } else { x }) < 0.0001220703125 {
            const sign = 1 - ((hx >> 30) & 2)
            return @floatFromInt(f32, sign * iy) * (1.0 - @floatFromInt(f32, 2 * iy) * x)
        }
    }
    const z = x * x
    const w = z * z
    var r = ofBits(0xB79BAE5F)
    r = ofBits(0x38A3F445) + w * r
    r = ofBits(0x3A1A26C8) + w * r
    r = ofBits(0x3B6B6916) + w * r
    r = ofBits(0x3CB327A4) + w * r
    r = ofBits(0x3E088889) + w * r
    var v = ofBits(0x37D95384)
    v = ofBits(0x3895C07A) + w * v
    v = ofBits(0x398137B9) + w * v
    v = ofBits(0x3ABEDE48) + w * v
    v = ofBits(0x3C11371F) + w * v
    v = ofBits(0x3D5D0DD1) + w * v
    v = z * v
    const s = z * x
    r = y + z * (s * (r + v) + y)
    r = r + ofBits(0x3EAAAAAB) * s
    const ww = x + r
    if big {
        const vv = @floatFromInt(f32, iy)
        const sign = @floatFromInt(f32, 1 - ((hx >> 30) & 2))
        return sign * (vv - 2.0 * (x - (ww * ww / (ww + vv) - r)))
    }
    if iy == 1 { return ww }
    const zz = ofBits(bitsOf(ww) & 0xFFFFF000)
    const v2 = r - (zz - x)
    const a = -1.0 / ww
    const t = ofBits(bitsOf(a) & 0xFFFFF000)
    const s2 = 1.0 + t * zz
    return t + a * (s2 + t * v2)
}

pub fn tanf(x: f32) -> f32 {
    const ix = bitsOf(x) & 0x7FFFFFFF
    if ix <= 0x3F490FDA { return kernelTanf(x, 0.0, 1) }
    if ix >= 0x7F800000 { return x - x }
    if ix >= LARGE_BITS { return @floatCast(f32, math.sin(@floatCast(f64, x)) / math.cos(@floatCast(f64, x))) }
    var n: i32 = 0
    const r = reduce(@floatCast(f64, x), &n)
    const y0 = @floatCast(f32, r)
    const y1 = @floatCast(f32, r - @floatCast(f64, y0))
    return kernelTanf(y0, y1, 1 - ((n & 1) << 1))
}
