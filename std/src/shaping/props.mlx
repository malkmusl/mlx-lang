// The shaper's per-glyph variables (HarfBuzz's hb-ot-layout.hh): the two
// spare 32-bit words of hb_glyph_info_t hold
//
//   var1: glyph_props (bits 0-15), lig_props (16-23), syllable (24-31);
//         during normalization all of it is the glyph index;
//   var2: unicode_props (bits 0-15), the complex shapers' category
//         (16-23) and auxiliary byte (24-31);
//
// and the spare word of hb_glyph_position_t the attachment chain (bits
// 0-15, signed) and type (16-23) of GPOS.
const m = @import("./memory.mlx")
const unicode = @import("./unicode.mlx")
const buffer = @import("./buffer.mlx")

pub const GlyphInfo = buffer.GlyphInfo
pub const GlyphPosition = buffer.GlyphPosition

// unicode_props
pub const UPROPS_MASK_GEN_CAT: u32 = 0x001F
pub const UPROPS_MASK_IGNORABLE: u32 = 0x0020
pub const UPROPS_MASK_HIDDEN: u32 = 0x0040
pub const UPROPS_MASK_CONTINUATION: u32 = 0x0080
pub const UPROPS_MASK_Cf_ZWJ: u32 = 0x0100
pub const UPROPS_MASK_Cf_ZWNJ: u32 = 0x0200

pub const IS_LIG_BASE: u32 = 0x10

pub const PROPS_BASE_GLYPH: u32 = 0x02
pub const PROPS_LIGATURE: u32 = 0x04
pub const PROPS_MARK: u32 = 0x08
pub const PROPS_SUBSTITUTED: u32 = 0x10
pub const PROPS_LIGATED: u32 = 0x20
pub const PROPS_MULTIPLIED: u32 = 0x40
pub const PROPS_PRESERVE: u32 = 0x70

pub fn unicodeProps(g: *GlyphInfo) -> u32 { return g.*.var2 & 0xFFFF }
pub fn setUnicodeProps(g: *GlyphInfo, v: u32) -> void { g.*.var2 = (g.*.var2 & 0xFFFF0000) | (v & 0xFFFF) }

pub fn glyphProps(g: *GlyphInfo) -> u32 { return g.*.var1 & 0xFFFF }
pub fn setGlyphProps(g: *GlyphInfo, v: u32) -> void { g.*.var1 = (g.*.var1 & 0xFFFF0000) | (v & 0xFFFF) }

pub fn ligProps(g: *GlyphInfo) -> u32 { return (g.*.var1 >> 16) & 0xFF }
pub fn setLigProps(g: *GlyphInfo, v: u32) -> void { g.*.var1 = (g.*.var1 & 0xFF00FFFF) | ((v & 0xFF) << 16) }

pub fn syllable(g: *GlyphInfo) -> u32 { return g.*.var1 >> 24 }
pub fn setSyllable(g: *GlyphInfo, v: u32) -> void { g.*.var1 = (g.*.var1 & 0x00FFFFFF) | ((v & 0xFF) << 24) }

pub fn category(g: *GlyphInfo) -> u32 { return (g.*.var2 >> 16) & 0xFF }
pub fn setCategory(g: *GlyphInfo, v: u32) -> void { g.*.var2 = (g.*.var2 & 0xFF00FFFF) | ((v & 0xFF) << 16) }

pub fn auxiliary(g: *GlyphInfo) -> u32 { return g.*.var2 >> 24 }
pub fn setAuxiliary(g: *GlyphInfo, v: u32) -> void { g.*.var2 = (g.*.var2 & 0x00FFFFFF) | ((v & 0xFF) << 24) }

pub fn glyphIndex(g: *GlyphInfo) -> u32 { return g.*.var1 }
pub fn setGlyphIndex(g: *GlyphInfo, v: u32) -> void { g.*.var1 = v }

pub fn attachChain(p: *GlyphPosition) -> i32 { return @intCast(i32, @bitCast(i16, @intCast(u16, p.*.var_ & 0xFFFF))) }
pub fn setAttachChain(p: *GlyphPosition, v: i32) -> void { p.*.var_ = (p.*.var_ & 0xFFFF0000) | (@bitCast(u32, v) & 0xFFFF) }
pub fn attachType(p: *GlyphPosition) -> u32 { return (p.*.var_ >> 16) & 0xFF }
pub fn setAttachType(p: *GlyphPosition, v: u32) -> void { p.*.var_ = (p.*.var_ & 0xFF00FFFF) | ((v & 0xFF) << 16) }

// _hb_glyph_info_set_unicode_props
pub fn setUnicodePropsFor(g: *GlyphInfo, b: *buffer.Buffer) -> void {
    const u = g.*.codepoint
    const genCat = unicode.generalCategory(b.*.unicode, u)
    var p = genCat
    if u >= 0x80 {
        b.*.scratchFlags |= buffer.SCRATCH_HAS_NON_ASCII
        if unicode.isDefaultIgnorable(u) {
            b.*.scratchFlags |= buffer.SCRATCH_HAS_DEFAULT_IGNORABLES
            p |= UPROPS_MASK_IGNORABLE
            if u == 0x200C {
                p |= UPROPS_MASK_Cf_ZWNJ
            } else if u == 0x200D {
                p |= UPROPS_MASK_Cf_ZWJ
            } else if (u >= 0x180B && u <= 0x180D) || u == 0x180F {
                p |= UPROPS_MASK_HIDDEN
            } else if u >= 0xE0020 && u <= 0xE007F {
                p |= UPROPS_MASK_HIDDEN
            } else if u == 0x034F {
                b.*.scratchFlags |= buffer.SCRATCH_HAS_CGJ
                p |= UPROPS_MASK_HIDDEN
            }
        }
        if unicode.isMark(genCat) {
            p |= UPROPS_MASK_CONTINUATION
            p |= unicode.modifiedCombiningClass(b.*.unicode, u) << 8
        }
    }
    setUnicodeProps(g, p)
}

pub fn generalCategory(g: *GlyphInfo) -> u32 { return unicodeProps(g) & UPROPS_MASK_GEN_CAT }

pub fn setGeneralCategory(g: *GlyphInfo, genCat: u32) -> void {
    setUnicodeProps(g, genCat | (unicodeProps(g) & (0xFF & ~UPROPS_MASK_GEN_CAT)))
}

pub fn isUnicodeMark(g: *GlyphInfo) -> bool { return unicode.isMark(generalCategory(g)) }

pub fn setModifiedCombiningClass(g: *GlyphInfo, klass: u32) -> void {
    if !isUnicodeMark(g) { return }
    setUnicodeProps(g, (klass << 8) | (unicodeProps(g) & 0xFF))
}

pub fn modifiedCombiningClass(g: *GlyphInfo) -> u32 { return if isUnicodeMark(g) { unicodeProps(g) >> 8 } else { 0 } }

pub fn isUnicodeSpace(g: *GlyphInfo) -> bool { return generalCategory(g) == unicode.GC_SPACE_SEPARATOR }

pub fn setSpaceFallbackType(g: *GlyphInfo, s: u32) -> void {
    if !isUnicodeSpace(g) { return }
    setUnicodeProps(g, (s << 8) | (unicodeProps(g) & 0xFF))
}

pub fn spaceFallbackType(g: *GlyphInfo) -> u32 { return if isUnicodeSpace(g) { unicodeProps(g) >> 8 } else { unicode.NOT_SPACE } }

pub fn substituted(g: *GlyphInfo) -> bool { return (glyphProps(g) & PROPS_SUBSTITUTED) != 0 }

pub fn isDefaultIgnorable(g: *GlyphInfo) -> bool { return (unicodeProps(g) & UPROPS_MASK_IGNORABLE) != 0 && !substituted(g) }

pub fn isDefaultIgnorableAndNotHidden(g: *GlyphInfo) -> bool {
    return (unicodeProps(g) & (UPROPS_MASK_IGNORABLE | UPROPS_MASK_HIDDEN)) == UPROPS_MASK_IGNORABLE && !substituted(g)
}

pub fn unhide(g: *GlyphInfo) -> void { setUnicodeProps(g, unicodeProps(g) & ~UPROPS_MASK_HIDDEN) }
pub fn setContinuation(g: *GlyphInfo) -> void { setUnicodeProps(g, unicodeProps(g) | UPROPS_MASK_CONTINUATION) }
pub fn resetContinuation(g: *GlyphInfo) -> void { setUnicodeProps(g, unicodeProps(g) & ~UPROPS_MASK_CONTINUATION) }
pub fn isContinuation(g: *GlyphInfo) -> bool { return (unicodeProps(g) & UPROPS_MASK_CONTINUATION) != 0 }

pub fn isUnicodeFormat(g: *GlyphInfo) -> bool { return generalCategory(g) == unicode.GC_FORMAT }
pub fn isZwnj(g: *GlyphInfo) -> bool { return isUnicodeFormat(g) && (unicodeProps(g) & UPROPS_MASK_Cf_ZWNJ) != 0 }
pub fn isZwj(g: *GlyphInfo) -> bool { return isUnicodeFormat(g) && (unicodeProps(g) & UPROPS_MASK_Cf_ZWJ) != 0 }
pub fn isJoiner(g: *GlyphInfo) -> bool { return isUnicodeFormat(g) && (unicodeProps(g) & (UPROPS_MASK_Cf_ZWNJ | UPROPS_MASK_Cf_ZWJ)) != 0 }

pub fn flipJoiners(g: *GlyphInfo) -> void {
    if !isUnicodeFormat(g) { return }
    setUnicodeProps(g, unicodeProps(g) ^ (UPROPS_MASK_Cf_ZWNJ | UPROPS_MASK_Cf_ZWJ))
}

pub fn clearLigProps(g: *GlyphInfo) -> void { setLigProps(g, 0) }

pub fn setLigPropsForLigature(g: *GlyphInfo, ligId: u32, numComps: u32) -> void {
    setLigProps(g, (ligId << 5) | IS_LIG_BASE | (numComps & 0x0F))
}

pub fn setLigPropsForMark(g: *GlyphInfo, ligId: u32, comp: u32) -> void {
    setLigProps(g, (ligId << 5) | (comp & 0x0F))
}

pub fn setLigPropsForComponent(g: *GlyphInfo, comp: u32) -> void { setLigPropsForMark(g, 0, comp) }

pub fn ligId(g: *GlyphInfo) -> u32 { return ligProps(g) >> 5 }
pub fn ligatedInternal(g: *GlyphInfo) -> bool { return (ligProps(g) & IS_LIG_BASE) != 0 }
pub fn ligComp(g: *GlyphInfo) -> u32 { return if ligatedInternal(g) { 0 } else { ligProps(g) & 0x0F } }

pub fn ligNumComps(g: *GlyphInfo) -> u32 {
    if (glyphProps(g) & PROPS_LIGATURE) != 0 && ligatedInternal(g) { return ligProps(g) & 0x0F }
    return 1
}

pub fn allocateLigId(b: *buffer.Buffer) -> u32 {
    var id = buffer.nextSerial(b) & 0x07
    while id == 0 { id = buffer.nextSerial(b) & 0x07 }
    return id
}

pub fn isBaseGlyph(g: *GlyphInfo) -> bool { return (glyphProps(g) & PROPS_BASE_GLYPH) != 0 }
pub fn isLigature(g: *GlyphInfo) -> bool { return (glyphProps(g) & PROPS_LIGATURE) != 0 }
pub fn isMark(g: *GlyphInfo) -> bool { return (glyphProps(g) & PROPS_MARK) != 0 }
pub fn ligated(g: *GlyphInfo) -> bool { return (glyphProps(g) & PROPS_LIGATED) != 0 }
pub fn multiplied(g: *GlyphInfo) -> bool { return (glyphProps(g) & PROPS_MULTIPLIED) != 0 }
pub fn ligatedAndDidntMultiply(g: *GlyphInfo) -> bool { return ligated(g) && !multiplied(g) }

pub fn clearLigatedAndMultiplied(g: *GlyphInfo) -> void { setGlyphProps(g, glyphProps(g) & ~(PROPS_LIGATED | PROPS_MULTIPLIED)) }
pub fn clearSubstituted(g: *GlyphInfo) -> void { setGlyphProps(g, glyphProps(g) & ~PROPS_SUBSTITUTED) }

// The end of the syllable starting at `start`.
pub fn nextSyllable(b: *buffer.Buffer, start_: u32) -> u32 {
    var start = start_
    const s = syllable(buffer.info(b, start))
    start += 1
    while start < b.*.len && syllable(buffer.info(b, start)) == s { start += 1 }
    return start
}

// The end of the cluster starting at `start`.
pub fn nextCluster(b: *buffer.Buffer, start_: u32) -> u32 {
    var start = start_
    const c = buffer.info(b, start).*.cluster
    start += 1
    while start < b.*.len && buffer.info(b, start).*.cluster == c { start += 1 }
    return start
}
