// hb-common.h: tags, directions, languages, scripts, features and
// variations with their string forms, colors, the version (HarfBuzz's
// hb-common.cc and hb-number.cc).
const m = @import("./memory.mlx")

pub const DIRECTION_INVALID: u32 = 0
pub const DIRECTION_LTR: u32 = 4
pub const DIRECTION_RTL: u32 = 5
pub const DIRECTION_TTB: u32 = 6
pub const DIRECTION_BTT: u32 = 7

pub fn isHorizontal(d: u32) -> bool { return (d & 0xFFFFFFFE) == 4 }
pub fn isVertical(d: u32) -> bool { return (d & 0xFFFFFFFE) == 6 }
pub fn isForward(d: u32) -> bool { return (d & 0xFFFFFFFD) == 4 }
pub fn isBackward(d: u32) -> bool { return (d & 0xFFFFFFFD) == 5 }
pub fn isValidDirection(d: u32) -> bool { return (d & 0xFFFFFFFC) == 4 }
pub fn reverse(d: u32) -> u32 { return d ^ 1 }

pub fn tag(a: u8, b: u8, c: u8, d: u8) -> u32 { return (@intCast(u32, a) << 24) | (@intCast(u32, b) << 16) | (@intCast(u32, c) << 8) | @intCast(u32, d) }

// Scripts (ISO 15924 tags).
pub const SCRIPT_INVALID: u32 = 0
pub const SCRIPT_COMMON: u32 = 0x5A797979
pub const SCRIPT_INHERITED: u32 = 0x5A696E68
pub const SCRIPT_UNKNOWN: u32 = 0x5A7A7A7A
pub const SCRIPT_ARABIC: u32 = 0x41726162
pub const SCRIPT_ARMENIAN: u32 = 0x41726D6E
pub const SCRIPT_BENGALI: u32 = 0x42656E67
pub const SCRIPT_CYRILLIC: u32 = 0x4379726C
pub const SCRIPT_DEVANAGARI: u32 = 0x44657661
pub const SCRIPT_GEORGIAN: u32 = 0x47656F72
pub const SCRIPT_GREEK: u32 = 0x4772656B
pub const SCRIPT_GUJARATI: u32 = 0x47756A72
pub const SCRIPT_GURMUKHI: u32 = 0x47757275
pub const SCRIPT_HANGUL: u32 = 0x48616E67
pub const SCRIPT_HAN: u32 = 0x48616E69
pub const SCRIPT_HEBREW: u32 = 0x48656272
pub const SCRIPT_HIRAGANA: u32 = 0x48697261
pub const SCRIPT_KANNADA: u32 = 0x4B6E6461
pub const SCRIPT_KATAKANA: u32 = 0x4B616E61
pub const SCRIPT_LAO: u32 = 0x4C616F6F
pub const SCRIPT_LATIN: u32 = 0x4C61746E
pub const SCRIPT_MALAYALAM: u32 = 0x4D6C796D
pub const SCRIPT_ORIYA: u32 = 0x4F727961
pub const SCRIPT_TAMIL: u32 = 0x54616D6C
pub const SCRIPT_TELUGU: u32 = 0x54656C75
pub const SCRIPT_THAI: u32 = 0x54686169
pub const SCRIPT_TIBETAN: u32 = 0x54696274
pub const SCRIPT_KHMER: u32 = 0x4B686D72
pub const SCRIPT_MONGOLIAN: u32 = 0x4D6F6E67
pub const SCRIPT_MYANMAR: u32 = 0x4D796D72
pub const SCRIPT_SINHALA: u32 = 0x53696E68
pub const SCRIPT_SYRIAC: u32 = 0x53797263
pub const SCRIPT_NKO: u32 = 0x4E6B6F6F
pub const SCRIPT_PHAGS_PA: u32 = 0x50686167
pub const SCRIPT_MANDAIC: u32 = 0x4D616E64
pub const SCRIPT_MANICHAEAN: u32 = 0x4D616E69
pub const SCRIPT_PSALTER_PAHLAVI: u32 = 0x50686C70
pub const SCRIPT_ADLAM: u32 = 0x41646C6D
pub const SCRIPT_HANIFI_ROHINGYA: u32 = 0x526F6867
pub const SCRIPT_SOGDIAN: u32 = 0x536F6764
pub const SCRIPT_CHORASMIAN: u32 = 0x43687273
pub const SCRIPT_OLD_UYGHUR: u32 = 0x4F756772
pub const SCRIPT_YEZIDI: u32 = 0x59657A69
pub const SCRIPT_OGHAM: u32 = 0x4F67616D

// ---------------------------------------------------------------------------
// Tags

// The tag of the first four bytes of `text` (spaces after a shorter one);
// `length` < 0: up to its NUL.
pub fn tagFromString(text: usize, length_: i64) -> u32 {
    if text == 0 || length_ == 0 || m.get8(text) == 0 { return 0 }
    var length = length_
    if length < 0 || length > 4 { length = 4 }
    var bytes: [4]u8 = [4]u8{ 32, 32, 32, 32 }
    var i: usize = 0
    while i < @intCast(usize, length) && m.get8(text + i) != 0 {
        bytes[i] = m.get8(text + i)
        i += 1
    }
    return tag(bytes[0], bytes[1], bytes[2], bytes[3])
}


pub fn tagToString(t: u32, buf: usize) -> void {
    m.put8(buf, @intCast(u8, (t >> 24) & 0xFF))
    m.put8(buf + 1, @intCast(u8, (t >> 16) & 0xFF))
    m.put8(buf + 2, @intCast(u8, (t >> 8) & 0xFF))
    m.put8(buf + 3, @intCast(u8, t & 0xFF))
}

// ---------------------------------------------------------------------------
// Directions

pub fn directionFromString(str: usize, len: i32) -> u32 {
    if str == 0 || len == 0 || m.get8(str) == 0 { return DIRECTION_INVALID }
    const c = m.lower(m.get8(str))
    if c == 'l' { return DIRECTION_LTR }
    if c == 'r' { return DIRECTION_RTL }
    if c == 't' { return DIRECTION_TTB }
    if c == 'b' { return DIRECTION_BTT }
    return DIRECTION_INVALID
}

pub fn directionToString(direction: u32) -> usize {
    if direction == DIRECTION_LTR { return m.literal("ltr") }
    if direction == DIRECTION_RTL { return m.literal("rtl") }
    if direction == DIRECTION_TTB { return m.literal("ttb") }
    if direction == DIRECTION_BTT { return m.literal("btt") }
    return m.literal("invalid")
}

// ---------------------------------------------------------------------------
// Languages: canonical C strings (lower case, `-` for `_`), one of each,
// kept in a list for the life of the process; hb_language_t is the
// address of the string.

// The canonical form of a byte: lower-case letters and digits, `-` for
// `-` and `_`, 0 for the rest (which ends a language).
pub fn canon(c: u8) -> u8 {
    if c >= 65 && c <= 90 { return c + 32 }
    if c >= 97 && c <= 122 { return c }
    if c >= 48 && c <= 57 { return c }
    if c == 45 || c == 95 { return 45 }
    return 0
}

// The list: entries of next, string.
var languages: usize = 0

fn langEqual(lang: usize, key: usize) -> bool {
    var i: usize = 0
    while m.get8(lang + i) != 0 && m.get8(lang + i) == canon(m.get8(key + i)) { i += 1 }
    return m.get8(lang + i) == canon(m.get8(key + i))
}

// The language of the NUL-ended `key`.
fn findOrInsert(key: usize) -> usize {
    while true {
        const first = m.atomicLoadWord(@intFromPtr(&languages))
        var item = first
        while item != 0 {
            if langEqual(m.getWord(item + 8), key) { return m.getWord(item + 8) }
            item = m.getWord(item)
        }
        const length = m.cLength(key)
        const entry = m.alloc(16)
        const text = m.alloc(length + 1)
        if entry == 0 || text == 0 {
            m.release(entry)
            m.release(text)
            return 0
        }
        var i: usize = 0
        while i < length {
            m.put8(text + i, canon(m.get8(key + i)))
            i += 1
        }
        m.putWord(entry, first)
        m.putWord(entry + 8, text)
        if m.swapWord(@intFromPtr(&languages), first, entry) { return text }
        m.release(text)
        m.release(entry)
    }
    return 0
}

pub fn languageFromString(str: usize, len: i64) -> usize {
    if str == 0 || len == 0 || m.get8(str) == 0 { return 0 }
    if len >= 0 {
        var buffer: [64]u8 = undefined
        var n = @intCast(usize, len)
        if n > 63 { n = 63 }
        var i: usize = 0
        while i < n {
            buffer[i] = m.get8(str + i)
            i += 1
        }
        buffer[n] = 0
        return findOrInsert(@intFromPtr(&buffer))
    }
    return findOrInsert(str)
}

pub fn languageToString(language: usize) -> usize { return language }

var defaultLanguage: usize = 0
var localeFunction: usize = 0

const LocaleFn = fn() -> usize

// Where the default language comes from: a function giving the C string of
// the locale (the C API's library hands in setlocale's LC_CTYPE); "C"
// without one.
pub fn useLocaleFunction(f: usize) -> void { localeFunction = f }

fn currentLocale() -> usize {
    if localeFunction == 0 { return m.literal("C") }
    const call: LocaleFn = unsafe { @ptrFromInt(LocaleFn, localeFunction) }
    return call()
}

pub fn languageGetDefault() -> usize {
    var language = m.atomicLoadWord(@intFromPtr(&defaultLanguage))
    if language == 0 {
        language = languageFromString(currentLocale(), -1)
        _ = m.swapWord(@intFromPtr(&defaultLanguage), 0, language)
    }
    return language
}


pub fn languageMatches(language: usize, specific: usize) -> i32 {
    if language == specific { return 1 }
    if language == 0 || specific == 0 { return 0 }
    const ll = m.cLength(language)
    const sl = m.cLength(specific)
    if ll > sl { return 0 }
    var i: usize = 0
    while i < ll {
        if m.get8(language + i) != m.get8(specific + i) { return 0 }
        i += 1
    }
    const c = m.get8(specific + ll)
    return if c == 0 || c == 45 { 1 } else { 0 }
}

// ---------------------------------------------------------------------------
// Scripts

pub fn scriptFromIso15924Tag(tag_: u32) -> u32 {
    if tag_ == 0 { return SCRIPT_INVALID }
    // (One capital letter and three small ones.)
    const t = (tag_ & 0xDFDFDFDF) | 0x00202020
    if t == 0x51616169 { return SCRIPT_INHERITED }
    if t == 0x51616163 { return 0x436F7074 }
    if t == 0x4172616E { return SCRIPT_ARABIC }
    if t == 0x43797273 { return SCRIPT_CYRILLIC }
    if t == 0x47656F6B { return SCRIPT_GEORGIAN }
    if t == 0x48616E73 || t == 0x48616E74 { return SCRIPT_HAN }
    if t == 0x4A616D6F { return SCRIPT_HANGUL }
    if t == 0x4C617466 || t == 0x4C617467 { return SCRIPT_LATIN }
    if t == 0x53797265 || t == 0x5379726A || t == 0x5379726E { return SCRIPT_SYRIAC }
    if (t & 0xE0E0E0E0) == 0x40606060 { return t }
    return SCRIPT_UNKNOWN
}

pub fn scriptFromString(str: usize, len: i32) -> u32 { return scriptFromIso15924Tag(tagFromString(str, @intCast(i64, len))) }
pub fn scriptToIso15924Tag(script: u32) -> u32 { return script }

pub fn horizontalDirection(script: u32) -> u32 {
    const rtl = [_]u32{
        SCRIPT_ARABIC, SCRIPT_HEBREW, SCRIPT_SYRIAC, 0x54686161, 0x43707274, 0x4B686172, 0x50686E78, SCRIPT_NKO,
        0x4C796469, 0x41767374, 0x41726D69, 0x50686C69, 0x50727469, 0x53617262, 0x4F726B68, 0x53616D72,
        SCRIPT_MANDAIC, 0x4D657263, 0x4D65726F, SCRIPT_MANICHAEAN, 0x4D656E64, 0x4E626174, 0x4E617262, 0x50616C6D,
        SCRIPT_PSALTER_PAHLAVI, 0x48617472, SCRIPT_ADLAM, SCRIPT_HANIFI_ROHINGYA, 0x536F676F, SCRIPT_SOGDIAN, 0x456C796D, SCRIPT_CHORASMIAN,
        SCRIPT_YEZIDI, SCRIPT_OLD_UYGHUR,
    }
    for s in rtl { if s == script { return DIRECTION_RTL } }
    // (Old Hungarian, Old Italic, Runic, Tifinagh: either.)
    if script == 0x48756E67 || script == 0x4974616C || script == 0x52756E72 || script == 0x54666E67 { return DIRECTION_INVALID }
    return DIRECTION_LTR
}

pub fn scriptGetHorizontalDirection(script: u32) -> u32 { return horizontalDirection(script) }

// ---------------------------------------------------------------------------
// The version

pub fn version(major: usize, minor: usize, micro: usize) -> void {
    m.put32(major, 8)
    m.put32(minor, 3)
    m.put32(micro, 0)
}

pub fn versionString() -> usize { return m.literal("8.3.0") }

pub fn versionAtleast(major: u32, minor: u32, micro: u32) -> i32 {
    const asked = @intCast(u64, major) * 10000 + @intCast(u64, minor) * 100 + @intCast(u64, micro)
    return if asked <= 80300 { 1 } else { 0 }
}

// ---------------------------------------------------------------------------
// Numbers in text (hb-number.cc): C's strtol on what the buffer holds,
// and HarfBuzz's own reading of decimal numbers.

// Reads a decimal int at `*pp` (spaces, a sign and digits, as strtol);
// whether there was one.
pub fn parseInt(pp: *usize, end: usize, value: *i64) -> bool {
    var p = pp.*
    var limit = end
    if limit - p > 31 { limit = p + 31 }
    while p < limit && m.isSpace(m.get8(p)) { p += 1 }
    var negative = false
    if p < limit && (m.get8(p) == 43 || m.get8(p) == 45) {
        negative = m.get8(p) == 45
        p += 1
    }
    const digits = p
    var v: i64 = 0
    var overflow = false
    while p < limit && m.isDigit(m.get8(p)) {
        if v > 922337203685477580 { overflow = true }
        if !overflow { v = v * 10 + @intCast(i64, m.get8(p) - 48) }
        p += 1
    }
    if p == digits || overflow { return false }
    value.* = if negative { 0 - v } else { v }
    pp.* = p
    return true
}

// An unsigned number of `base` filling the whole `length` bytes (hb_codepoint_parse).
pub fn parseCodepoint(text: usize, length: usize, base: u32, out: *u32) -> bool {
    if length == 0 || length > 31 { return false }
    var p = text
    const end = text + length
    var negative = false
    if m.get8(p) == 43 || m.get8(p) == 45 {
        negative = m.get8(p) == 45
        p += 1
    }
    if p == end { return false }
    var v: u64 = 0
    while p < end {
        const c = m.get8(p)
        var d: u32 = 99
        if c >= 48 && c <= 57 { d = @intCast(u32, c - 48) }
        if c >= 97 && c <= 122 { d = @intCast(u32, c - 87) }
        if c >= 65 && c <= 90 { d = @intCast(u32, c - 55) }
        if d >= base { return false }
        v = v * @intCast(u64, base) + @intCast(u64, d)
        if v > 0xFFFFFFFFFFFF { return false }
        p += 1
    }
    if negative { v = 0 -% v }
    out.* = @intCast(u32, v & 0xFFFFFFFF)
    return true
}

fn pow10(exponent: u32) -> f64 {
    const powers = [_]f64{ 1.0e256, 1.0e128, 1.0e64, 1.0e32, 1.0e16, 1.0e8, 10000.0, 100.0, 10.0 }
    var mask: u32 = 256
    var result: f64 = 1.0
    for power in powers {
        if (exponent & mask) != 0 { result = result * power }
        mask = mask >> 1
    }
    return result
}

// HarfBuzz's reading of a decimal number (strtod_rl): sign, digits, a
// fraction, an exponent.
pub fn parseDouble(pp: *usize, end: usize, value: *f64) -> bool {
    var p = pp.*
    while p < end && m.isSpace(m.get8(p)) { p += 1 }
    const start = p
    var v: f64 = 0.0
    var frac: f64 = 0.0
    var fracCount: u32 = 0
    var exp: u32 = 0
    var negative = false
    var expNegative = false
    var expOverflow = false
    if p < end && (m.get8(p) == 43 || m.get8(p) == 45) {
        negative = m.get8(p) == 45
        p += 1
    }
    var intDigits = false
    while p < end && m.isDigit(m.get8(p)) {
        v = v * 10.0 + @floatFromInt(f64, m.get8(p) - 48)
        intDigits = true
        p += 1
    }
    var fracDigits = false
    if p < end && m.get8(p) == 46 && p + 1 < end && m.isDigit(m.get8(p + 1)) {
        p += 1
        while p < end && m.isDigit(m.get8(p)) {
            if frac <= 450359962737049.5 {
                frac = frac * 10.0 + @floatFromInt(f64, m.get8(p) - 48)
                fracCount += 1
            }
            fracDigits = true
            p += 1
        }
    } else if p < end && m.get8(p) == 46 && intDigits {
        // ("1." stops before the dot.)
    }
    if !intDigits && !fracDigits {
        return false
    }
    if p < end && (m.get8(p) == 101 || m.get8(p) == 69) {
        var q = p + 1
        var en = false
        if q < end && (m.get8(q) == 43 || m.get8(q) == 45) {
            en = m.get8(q) == 45
            q += 1
        }
        if q < end && m.isDigit(m.get8(q)) {
            expNegative = en
            while q < end && m.isDigit(m.get8(q)) {
                const d = @intCast(u32, m.get8(q) - 48)
                if exp * 10 + d <= 0x7FF { exp = exp * 10 + d } else { expOverflow = true }
                q += 1
            }
            p = q
        }
    }
    if p == start { return false }
    pp.* = p
    if fracCount != 0 { v = v + frac / pow10(fracCount) }
    if negative { v = 0.0 - v }
    if expOverflow {
        if v == 0.0 {
            value.* = v
        } else if expNegative {
            value.* = if negative { -2.2250738585072014e-308 } else { 2.2250738585072014e-308 }
        } else {
            value.* = if negative { -1.7976931348623157e308 } else { 1.7976931348623157e308 }
        }
        return true
    }
    if exp != 0 {
        if expNegative { v = v / pow10(exp) } else { v = v * pow10(exp) }
    }
    value.* = v
    return true
}

// ---------------------------------------------------------------------------
// Features and variations in text

fn skipSpace(pp: *usize, end: usize) -> void {
    while pp.* < end && m.isSpace(m.get8(pp.*)) { pp.* += 1 }
}

fn parseChar(pp: *usize, end: usize, c: u8) -> bool {
    skipSpace(pp, end)
    if pp.* == end || m.get8(pp.*) != c { return false }
    pp.* += 1
    return true
}

fn parseUint(pp: *usize, end: usize, value: *u32) -> bool {
    var v: i64 = 0
    if !parseInt(pp, end, &v) { return false }
    value.* = @intCast(u32, @bitCast(u64, v) & 0xFFFFFFFF)
    return true
}

fn parseBool(pp: *usize, end: usize, value: *u32) -> bool {
    skipSpace(pp, end)
    const p = pp.*
    while pp.* < end && m.isAlpha(m.get8(pp.*)) { pp.* += 1 }
    const n = pp.* - p
    if n == 2 && m.lower(m.get8(p)) == 'o' && m.lower(m.get8(p + 1)) == 'n' {
        value.* = 1
        return true
    }
    if n == 3 && m.lower(m.get8(p)) == 'o' && m.lower(m.get8(p + 1)) == 'f' && m.lower(m.get8(p + 2)) == 'f' {
        value.* = 0
        return true
    }
    return false
}

fn parseTag(pp: *usize, end: usize, t: *u32) -> bool {
    skipSpace(pp, end)
    var quote: u8 = 0
    if pp.* < end && (m.get8(pp.*) == 39 || m.get8(pp.*) == 34) {
        quote = m.get8(pp.*)
        pp.* += 1
    }
    const p = pp.*
    while pp.* < end {
        const c = m.get8(pp.*)
        if c == 32 || c == 61 || c == 91 || c == quote { break }
        pp.* += 1
    }
    if p == pp.* || pp.* - p > 4 { return false }
    t.* = tagFromString(p, @intCast(i64, pp.* - p))
    if quote != 0 {
        if pp.* - p != 4 { return false }
        if pp.* == end || m.get8(pp.*) != quote { return false }
        pp.* += 1
    }
    return true
}

// A feature as hb_feature_t: tag, value, start, end at `feature`.
pub fn featureFromString(str: usize, len: i64, feature: usize) -> bool {
    var length = len
    if length < 0 { length = @intCast(i64, m.cLength(str)) }
    var p = str
    const end = str + @intCast(usize, length)
    var t: u32 = 0
    var value: u32 = 1
    var start: u32 = 0
    var stop: u32 = 0xFFFFFFFF
    var ok = true
    if parseChar(&p, end, 45) {
        value = 0
    } else {
        _ = parseChar(&p, end, 43)
        value = 1
    }
    ok = parseTag(&p, end, &t)
    if ok {
        skipSpace(&p, end)
        if parseChar(&p, end, 91) {
            const hasStart = parseUint(&p, end, &start)
            if parseChar(&p, end, 58) || parseChar(&p, end, 59) {
                _ = parseUint(&p, end, &stop)
            } else if hasStart {
                stop = start +% 1
            }
            ok = parseChar(&p, end, 93)
        }
    }
    if ok {
        const hadEqual = parseChar(&p, end, 61)
        const hadValue = parseUint(&p, end, &value) || parseBool(&p, end, &value)
        ok = !hadEqual || hadValue
    }
    if ok {
        skipSpace(&p, end)
        ok = p == end
    }
    if ok {
        if feature != 0 {
            m.put32(feature, t)
            m.put32(feature + 4, value)
            m.put32(feature + 8, start)
            m.put32(feature + 12, stop)
        }
        return true
    }
    if feature != 0 { m.zero(feature, 16) }
    return false
}


// Writes the decimal digits of `value` at `out`; their count.
pub fn writeDecimal(out: usize, value: u64) -> usize {
    var digits: [24]u8 = undefined
    var n: usize = 0
    var v = value
    while true {
        digits[n] = @intCast(u8, 48 + v % 10)
        n += 1
        v = v / 10
        if v == 0 { break }
    }
    var i: usize = 0
    while i < n {
        m.put8(out + i, digits[n - 1 - i])
        i += 1
    }
    return n
}

pub fn writeSigned(out: usize, value: i64) -> usize {
    if value < 0 {
        m.put8(out, 45)
        return 1 + writeDecimal(out + 1, @intCast(u64, 0 - value))
    }
    return writeDecimal(out, @intCast(u64, value))
}

// Writes the tag's bytes without the spaces ending it; their count.
fn writeTag(out: usize, t: u32) -> usize {
    tagToString(t, out)
    var len: usize = 4
    while len > 0 && m.get8(out + len - 1) == 32 { len -= 1 }
    return len
}

pub fn featureToString(feature: usize, buf: usize, size: u32) -> void {
    if size == 0 { return }
    var s: [128]u8 = undefined
    const o = @intFromPtr(&s)
    var len: usize = 0
    const t = m.get32(feature)
    const value = m.get32(feature + 4)
    const start = m.get32(feature + 8)
    const stop = m.get32(feature + 12)
    if value == 0 {
        m.put8(o, 45)
        len = 1
    }
    len += writeTag(o + len, t)
    if start != 0 || stop != 0xFFFFFFFF {
        m.put8(o + len, 91)
        len += 1
        if start != 0 { len += writeDecimal(o + len, @intCast(u64, start)) }
        if stop != start +% 1 {
            m.put8(o + len, 58)
            len += 1
            if stop != 0xFFFFFFFF { len += writeDecimal(o + len, @intCast(u64, stop)) }
        }
        m.put8(o + len, 93)
        len += 1
    }
    if value > 1 {
        m.put8(o + len, 61)
        len += 1
        len += writeDecimal(o + len, @intCast(u64, value))
    }
    if len > @intCast(usize, size) - 1 { len = @intCast(usize, size) - 1 }
    m.copy(buf, o, len)
    m.put8(buf + len, 0)
}

pub fn variationFromString(str: usize, len: i64, variation: usize) -> bool {
    var length = len
    if length < 0 { length = @intCast(i64, m.cLength(str)) }
    var p = str
    const end = str + @intCast(usize, length)
    var t: u32 = 0
    var v: f64 = 0.0
    var ok = parseTag(&p, end, &t)
    if ok {
        _ = parseChar(&p, end, 61)
        ok = parseDouble(&p, end, &v)
    }
    if ok {
        skipSpace(&p, end)
        ok = p == end
    }
    if ok {
        if variation != 0 {
            m.put32(variation, t)
            const f: f32 = @floatCast(f32, v)
            m.putF32(variation + 4, f)
        }
        return true
    }
    if variation != 0 { m.zero(variation, 8) }
    return false
}


// Writes `value` as C's "%g" writes it (six significant digits); the
// count of bytes.
pub fn writeG(out: usize, value: f64) -> usize {
    var len: usize = 0
    var v = value
    if v != v {
        return m.copyString(out, 4, "nan")
    }
    if v < 0.0 || (v == 0.0 && @bitCast(u64, v) != 0) {
        m.put8(out, 45)
        len = 1
        v = 0.0 - v
    }
    if v == 0.0 {
        m.put8(out + len, 48)
        return len + 1
    }
    if v > 1.7976931348623157e308 {
        return len + m.copyString(out + len, 4, "inf")
    }
    // The exponent of the value rounded to six digits.
    var exponent: i32 = 0
    var scaled = v
    while scaled >= 10.0 {
        scaled = scaled / 10.0
        exponent += 1
    }
    while scaled < 1.0 {
        scaled = scaled * 10.0
        exponent -= 1
    }
    // Six significant digits: an integer of the digits.
    var digits = m.round(v * pow10i(5 - exponent))
    if digits >= 1000000.0 {
        exponent += 1
        digits = m.round(v * pow10i(5 - exponent))
    }
    var d = @intFromFloat(u64, digits)
    var text: [8]u8 = undefined
    var i: usize = 6
    while i > 0 {
        text[i - 1] = @intCast(u8, 48 + d % 10)
        d = d / 10
        i -= 1
    }
    // (Trailing zeros are not written.)
    var count: usize = 6
    while count > 1 && text[count - 1] == 48 { count -= 1 }
    if exponent < -4 || exponent >= 6 {
        m.put8(out + len, text[0])
        len += 1
        if count > 1 {
            m.put8(out + len, 46)
            len += 1
            var k: usize = 1
            while k < count {
                m.put8(out + len, text[k])
                len += 1
                k += 1
            }
        }
        m.put8(out + len, 101)
        len += 1
        var e = exponent
        if e < 0 {
            m.put8(out + len, 45)
            e = 0 - e
        } else {
            m.put8(out + len, 43)
        }
        len += 1
        if e < 10 {
            m.put8(out + len, 48)
            len += 1
        }
        len += writeDecimal(out + len, @intCast(u64, e))
        return len
    }
    if exponent < 0 {
        m.put8(out + len, 48)
        m.put8(out + len + 1, 46)
        len += 2
        var z: i32 = -1
        while z > exponent {
            m.put8(out + len, 48)
            len += 1
            z -= 1
        }
        var k: usize = 0
        while k < count {
            m.put8(out + len, text[k])
            len += 1
            k += 1
        }
        return len
    }
    const whole = @intCast(usize, exponent) + 1
    var k: usize = 0
    while k < whole {
        m.put8(out + len, if k < 6 { text[k] } else { 48 })
        len += 1
        k += 1
    }
    if count > whole {
        m.put8(out + len, 46)
        len += 1
        while k < count {
            m.put8(out + len, text[k])
            len += 1
            k += 1
        }
    }
    return len
}

fn pow10i(e: i32) -> f64 {
    if e >= 0 { return pow10(@intCast(u32, e)) }
    return 1.0 / pow10(@intCast(u32, 0 - e))
}

pub fn variationToString(variation: usize, buf: usize, size: u32) -> void {
    if size == 0 { return }
    var s: [128]u8 = undefined
    const o = @intFromPtr(&s)
    var len = writeTag(o, m.get32(variation))
    m.put8(o + len, 61)
    len += 1
    const f = m.getF32(variation + 4)
    len += writeG(o + len, @floatCast(f64, f))
    if len > @intCast(usize, size) - 1 { len = @intCast(usize, size) - 1 }
    m.copy(buf, o, len)
    m.put8(buf + len, 0)
}

// ---------------------------------------------------------------------------
// Colors: BGRA in a 32-bit value.

pub fn colorGetAlpha(color: u32) -> u8 { return @intCast(u8, color & 0xFF) }
pub fn colorGetRed(color: u32) -> u8 { return @intCast(u8, (color >> 8) & 0xFF) }
pub fn colorGetGreen(color: u32) -> u8 { return @intCast(u8, (color >> 16) & 0xFF) }
pub fn colorGetBlue(color: u32) -> u8 { return @intCast(u8, (color >> 24) & 0xFF) }
