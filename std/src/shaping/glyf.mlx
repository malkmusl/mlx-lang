// glyf and loca: TrueType glyphs (HarfBuzz's OT/glyf): their extents from
// the glyph headers, their points (simple and composite glyphs, with the
// four phantom points), varied by gvar, drawn as quadratic outlines; the
// advances and side bearings of a varied font from the phantom points.
// As in HarfBuzz's default build, cubic outlines, variable composites and
// 24-bit glyph ids of components are not read.
const m = @import("./memory.mlx")
const face = @import("./face.mlx")
const font = @import("./font.mlx")
const hmtx = @import("./hmtx.mlx")
const gvar = @import("./gvar.mlx")
const draw = @import("./draw.mlx")

const MAX_NESTING: u32 = 64
const MAX_POINTS: u32 = 20000
const MAX_EDGE_COUNT: u32 = 1024

const PHANTOM_LEFT: u32 = 0
const PHANTOM_RIGHT: u32 = 1
const PHANTOM_TOP: u32 = 2
const PHANTOM_BOTTOM: u32 = 3
const PHANTOM_COUNT: u32 = 4

const FLAG_ON_CURVE: u32 = 0x01
const FLAG_X_SHORT: u32 = 0x02
const FLAG_Y_SHORT: u32 = 0x04
const FLAG_REPEAT: u32 = 0x08
const FLAG_X_SAME: u32 = 0x10
const FLAG_Y_SAME: u32 = 0x20

const ARG_1_AND_2_ARE_WORDS: u32 = 0x0001
const ARGS_ARE_XY_VALUES: u32 = 0x0002
const WE_HAVE_A_SCALE: u32 = 0x0008
const MORE_COMPONENTS: u32 = 0x0020
const WE_HAVE_AN_X_AND_Y_SCALE: u32 = 0x0040
const WE_HAVE_A_TWO_BY_TWO: u32 = 0x0080
const USE_MY_METRICS: u32 = 0x0200
const SCALED_COMPONENT_OFFSET: u32 = 0x0800
const UNSCALED_COMPONENT_OFFSET: u32 = 0x1000

const PS: usize = gvar.POINT_SIZE

pub const Glyf = struct {
    glyf: m.Table
    loca: m.Table
    shortOffset: u32
    numGlyphs: u32
}

pub fn glyfOf(address: usize) -> *Glyf { unsafe { return @ptrFromInt(*Glyf, address) } }

pub fn glyfFreeCallback(a: usize) -> void { m.release(a) }

pub fn accel(fc: usize) -> *Glyf {
    var a = face.accel(fc, face.A_GLYF)
    if a == 0 {
        const made = m.alloc(@sizeOf(Glyf))
        const g = glyfOf(made)
        var head: m.Table = undefined
        face.headView(fc, &head)
        const format = m.i16at(&head, 50)
        const dataFormat = m.i16at(&head, 52)
        if format <= 1 && dataFormat <= 1 {
            g.*.shortOffset = if format == 0 { 1 } else { 0 }
            face.view(fc, face.T_LOCA, &g.*.loca)
            face.view(fc, face.T_GLYF, &g.*.glyf)
            const size: usize = if format == 0 { 2 } else { 4 }
            var n = g.*.loca.length / size
            if n < 1 { n = 1 }
            n -= 1
            const fn_ = @intCast(usize, face.numGlyphs(fc))
            if n > fn_ { n = fn_ }
            g.*.numGlyphs = @intCast(u32, n)
        }
        a = face.keepAccel(fc, face.A_GLYF, made, @intFromPtr(glyfFreeCallback))
    }
    return glyfOf(a)
}

pub fn hasData(fc: usize) -> bool { return accel(fc).*.numGlyphs != 0 }

// The bytes of glyph `gid` in glyf: offset and length (length 0: empty).
pub fn glyphBytes(g: *Glyf, gid: u32, start: *usize, length: *usize) -> void {
    start.* = 0
    length.* = 0
    if gid >= g.*.numGlyphs { return }
    var a: usize = 0
    var b: usize = 0
    if g.*.shortOffset != 0 {
        a = 2 * @intCast(usize, m.u16at(&g.*.loca, @intCast(usize, gid) * 2))
        b = 2 * @intCast(usize, m.u16at(&g.*.loca, @intCast(usize, gid) * 2 + 2))
    } else {
        a = @intCast(usize, m.u32at(&g.*.loca, @intCast(usize, gid) * 4))
        b = @intCast(usize, m.u32at(&g.*.loca, @intCast(usize, gid) * 4 + 4))
    }
    if a > b || b > g.*.glyf.length { return }
    start.* = a
    length.* = b - a
}

// The extents of `gid` from its header (the font's coordinates' default),
// scaled to the font: whether the font has the glyph in glyf.
fn extentsWithoutVar(f: usize, gid: u32, e: usize) -> bool {
    const fc = font.font(f).*.face
    const g = accel(fc)
    if gid >= g.*.numGlyphs { return false }
    var start: usize = 0
    var length: usize = 0
    glyphBytes(g, gid, &start, &length)
    m.zero(e, 16)
    if length < 10 { return true }
    const t = &g.*.glyf
    const contours = m.i16at(t, start)
    if contours == 0 || contours < -1 { return true }
    const xMin = m.i16at(t, start + 2)
    const yMin = m.i16at(t, start + 4)
    const xMax = m.i16at(t, start + 6)
    const yMax = m.i16at(t, start + 8)
    var lsb = if xMin < xMax { xMin } else { xMax }
    _ = hmtx.bearingUnscaled(hmtx.accel(fc, true), gid, &lsb)
    m.putI32(e, lsb)
    m.putI32(e + 4, if yMin > yMax { yMin } else { yMax })
    m.putI32(e + 8, (if xMin > xMax { xMin } else { xMax }) - (if xMin < xMax { xMin } else { xMax }))
    m.putI32(e + 12, (if yMin < yMax { yMin } else { yMax }) - (if yMin > yMax { yMin } else { yMax }))
    font.scaleGlyphExtents(f, e)
    return true
}

// ---------------------------------------------------------------------------
// Points

// A growable array of points (gvar.POINT_SIZE bytes each).
pub const Points = struct {
    data: usize
    count: u32
    cap: u32
}

fn pointsReserve(v: *Points, n: u32) -> bool {
    if n <= v.*.cap { return true }
    var cap = v.*.cap * 2
    if cap < n { cap = n }
    if cap < 16 { cap = 16 }
    const grown = m.grow(v.*.data, @intCast(usize, cap) * PS)
    if grown == 0 { return false }
    v.*.data = grown
    v.*.cap = cap
    return true
}

// Resizes to `n` points, the new ones zero.
fn pointsResize(v: *Points, n: u32) -> bool {
    if !pointsReserve(v, n) { return false }
    if n > v.*.count { m.zero(v.*.data + @intCast(usize, v.*.count) * PS, @intCast(usize, n - v.*.count) * PS) }
    v.*.count = n
    return true
}

fn pointsFree(v: *Points) -> void {
    m.release(v.*.data)
    v.*.data = 0
    v.*.count = 0
    v.*.cap = 0
}

fn pt(v: *Points, i: u32) -> usize { return v.*.data + @intCast(usize, i) * PS }

// Appends `n` points at `from` (another array's).
fn pointsExtend(v: *Points, from: usize, n: u32) -> bool {
    const old = v.*.count
    if !pointsReserve(v, old + n) { return false }
    m.copy(v.*.data + @intCast(usize, old) * PS, from, @intCast(usize, n) * PS)
    v.*.count = old + n
    return true
}

// What getPoints works with.
const Context = struct {
    font: usize
    face: usize
    glyf: *Glyf
    coords: usize
    numCoords: u32
    phantomOnly: bool
    edgeCount: u32
    // The glyphs of the composites being read (HarfBuzz's current_glyphs).
    current: [66]u32
    currentCount: u32
}

fn currentHas(c: *Context, gid: u32) -> bool {
    var i: u32 = 0
    while i < c.*.currentCount {
        if c.*.current[@intCast(usize, i)] == gid { return true }
        i += 1
    }
    return false
}

// A simple glyph's points (SimpleGlyph::get_contour_points).
fn simplePoints(t: *m.Table, start: usize, length: usize, contours: u32, all: *Points, phantomOnly: bool) -> bool {
    const ends = start + 10
    const end = start + length
    if ends + @intCast(usize, contours) * 2 + 2 > end { return false }
    const numPoints = m.u16at(t, ends + @intCast(usize, contours - 1) * 2) + 1
    const old = all.*.count
    if !pointsResize(all, old + numPoints) { return false }
    if phantomOnly { return true }
    const pts = pt(all, old)
    var i: u32 = 0
    while i < contours {
        const e = m.u16at(t, ends + @intCast(usize, i) * 2)
        if e < numPoints { m.put8(pts + @intCast(usize, e) * PS + gvar.POINT_END, 1) }
        i += 1
    }
    var p = ends + @intCast(usize, contours) * 2 + 2 + @intCast(usize, m.u16at(t, ends + @intCast(usize, contours) * 2))
    if p >= end { return false }
    // Flags.
    i = 0
    while i < numPoints {
        if p + 1 > end { return false }
        const flag = m.u8at(t, p)
        p += 1
        m.put8(pts + @intCast(usize, i) * PS + gvar.POINT_FLAG, @intCast(u8, flag))
        i += 1
        if (flag & FLAG_REPEAT) != 0 {
            if p + 1 > end { return false }
            const repeat = m.u8at(t, p)
            p += 1
            var stop = i + repeat
            if stop > numPoints { stop = numPoints }
            while i < stop {
                m.put8(pts + @intCast(usize, i) * PS + gvar.POINT_FLAG, @intCast(u8, flag))
                i += 1
            }
        }
    }
    // Coordinates.
    if !readCoords(t, &p, end, pts, numPoints, 0, FLAG_X_SHORT, FLAG_X_SAME) { return false }
    return readCoords(t, &p, end, pts, numPoints, 4, FLAG_Y_SHORT, FLAG_Y_SAME)
}

fn readCoords(t: *m.Table, p: *usize, end: usize, pts: usize, n: u32, off: usize, shortFlag: u32, sameFlag: u32) -> bool {
    var v: i32 = 0
    var i: u32 = 0
    while i < n {
        const flag = @intCast(u32, m.get8(pts + @intCast(usize, i) * PS + gvar.POINT_FLAG))
        if (flag & shortFlag) != 0 {
            if p.* + 1 > end { return false }
            const b = @intCast(i32, m.u8at(t, p.*))
            p.* += 1
            if (flag & sameFlag) != 0 { v += b } else { v -= b }
        } else if (flag & sameFlag) == 0 {
            if p.* + 2 > end { return false }
            v += m.i16at(t, p.*)
            p.* += 2
        }
        m.putF32(pts + @intCast(usize, i) * PS + off, @floatFromInt(f32, v))
        i += 1
    }
    return true
}

// The size of the composite record at `r`.
fn recordSize(t: *m.Table, r: usize) -> usize {
    const flags = m.u16at(t, r)
    var size: usize = 4
    if (flags & ARG_1_AND_2_ARE_WORDS) != 0 { size += 4 } else { size += 2 }
    if (flags & WE_HAVE_A_SCALE) != 0 {
        size += 2
    } else if (flags & WE_HAVE_AN_X_AND_Y_SCALE) != 0 {
        size += 4
    } else if (flags & WE_HAVE_A_TWO_BY_TWO) != 0 {
        size += 8
    }
    return size
}

// The record at `r` if it lies in the glyph (0: none; composite_iter_t).
fn recordAt(t: *m.Table, r: usize, end: usize) -> usize {
    if r + 4 > end { return 0 }
    if r + recordSize(t, r) > end { return 0 }
    return r
}

fn nextRecord(t: *m.Table, r: usize, end: usize) -> usize {
    if (m.u16at(t, r) & MORE_COMPONENTS) == 0 { return 0 }
    return recordAt(t, r + recordSize(t, r), end)
}

fn recordGid(t: *m.Table, r: usize) -> u32 { return m.u16at(t, r + 2) }

fn argsAt(t: *m.Table, r: usize) -> usize { return r + 4 }

fn isAnchored(t: *m.Table, r: usize) -> bool { return (m.u16at(t, r) & ARGS_ARE_XY_VALUES) == 0 }

// The record's matrix (into `matrix`, four f32) and offset.
fn transformation(t: *m.Table, r: usize, matrix: usize, tx: *f32, ty: *f32) -> void {
    const flags = m.u16at(t, r)
    m.putF32(matrix, 1.0)
    m.putF32(matrix + 4, 0.0)
    m.putF32(matrix + 8, 0.0)
    m.putF32(matrix + 12, 1.0)
    var p = argsAt(t, r)
    var x: i32 = 0
    var y: i32 = 0
    if (flags & ARG_1_AND_2_ARE_WORDS) != 0 {
        x = m.i16at(t, p)
        y = m.i16at(t, p + 2)
        p += 4
    } else {
        x = @intCast(i32, @bitCast(i8, @intCast(u8, m.u8at(t, p))))
        y = @intCast(i32, @bitCast(i8, @intCast(u8, m.u8at(t, p + 1))))
        p += 2
    }
    if (flags & ARGS_ARE_XY_VALUES) == 0 {
        x = 0
        y = 0
    }
    tx.* = @floatFromInt(f32, x)
    ty.* = @floatFromInt(f32, y)
    if (flags & WE_HAVE_A_SCALE) != 0 {
        const s = f2dot14(t, p)
        m.putF32(matrix, s)
        m.putF32(matrix + 12, s)
    } else if (flags & WE_HAVE_AN_X_AND_Y_SCALE) != 0 {
        m.putF32(matrix, f2dot14(t, p))
        m.putF32(matrix + 12, f2dot14(t, p + 2))
    } else if (flags & WE_HAVE_A_TWO_BY_TWO) != 0 {
        m.putF32(matrix, f2dot14(t, p))
        m.putF32(matrix + 4, f2dot14(t, p + 2))
        m.putF32(matrix + 8, f2dot14(t, p + 4))
        m.putF32(matrix + 12, f2dot14(t, p + 6))
    }
}

fn f2dot14(t: *m.Table, at: usize) -> f32 { return @floatFromInt(f32, m.i16at(t, at)) / 16384.0 }

fn anchorPoints(t: *m.Table, r: usize, p1: *u32, p2: *u32) -> void {
    const p = argsAt(t, r)
    if (m.u16at(t, r) & ARG_1_AND_2_ARE_WORDS) != 0 {
        p1.* = m.u16at(t, p)
        p2.* = m.u16at(t, p + 2)
    } else {
        p1.* = m.u8at(t, p)
        p2.* = m.u8at(t, p + 1)
    }
}

fn transformRange(v: *Points, from: u32, to: u32, matrix: usize) -> void {
    const a = m.getF32(matrix)
    const b = m.getF32(matrix + 4)
    const c = m.getF32(matrix + 8)
    const d = m.getF32(matrix + 12)
    if a == 1.0 && b == 0.0 && c == 0.0 && d == 1.0 { return }
    var i = from
    while i < to {
        const p = pt(v, i)
        const x = m.getF32(p)
        const y = m.getF32(p + 4)
        m.putF32(p, x * a + y * c)
        m.putF32(p + 4, x * b + y * d)
        i += 1
    }
}

// contour_point_t translation as HarfBuzz does it (no addition of a zero).
fn translateRange(v: *Points, from: u32, to: u32, dx: f32, dy: f32) -> void {
    var i = from
    if dx != 0.0 && dy != 0.0 {
        while i < to {
            const p = pt(v, i)
            m.putF32(p, m.getF32(p) + dx)
            m.putF32(p + 4, m.getF32(p + 4) + dy)
            i += 1
        }
    } else if dx != 0.0 {
        while i < to {
            const p = pt(v, i)
            m.putF32(p, m.getF32(p) + dx)
            i += 1
        }
    } else if dy != 0.0 {
        while i < to {
            const p = pt(v, i)
            m.putF32(p + 4, m.getF32(p + 4) + dy)
            i += 1
        }
    }
}

// The points of `gid` appended to `all`, its phantom points last
// (Glyph::get_points); false on broken data.
fn getPoints(c: *Context, gid: u32, all: *Points, depth: u32) -> bool {
    if depth > MAX_NESTING { return false }
    if c.*.edgeCount > MAX_EDGE_COUNT { return false }
    c.*.edgeCount += 1
    const g = c.*.glyf
    const t = &g.*.glyf
    var start: usize = 0
    var length: usize = 0
    glyphBytes(g, gid, &start, &length)
    const end = start + length
    var contours: i32 = 0
    var xMin: i32 = 0
    var yMax: i32 = 0
    if length >= 10 {
        contours = m.i16at(t, start)
        xMin = m.i16at(t, start + 2)
        yMax = m.i16at(t, start + 8)
    }
    const simple = contours > 0
    const composite = contours == -1
    // (Variable composites, -2, are empty glyphs.)
    var stack: Points = undefined
    stack.data = 0
    stack.count = 0
    stack.cap = 0
    const points = if simple { all } else { &stack }
    const old = points.*.count
    if simple {
        if !simplePoints(t, start, length, @intCast(u32, contours), all, c.*.phantomOnly) {
            pointsFree(&stack)
            return false
        }
    } else if composite {
        var r = recordAt(t, start + 10, end)
        var matrix: [4]f32 = undefined
        var tx: f32 = 0.0
        var ty: f32 = 0.0
        while r != 0 {
            transformation(t, r, @intFromPtr(&matrix), &tx, &ty)
            if !pointsResize(&stack, stack.count + 1) {
                pointsFree(&stack)
                return false
            }
            m.putF32(pt(&stack, stack.count - 1), tx)
            m.putF32(pt(&stack, stack.count - 1) + 4, ty)
            r = nextRecord(t, r, end)
        }
    }
    // The phantom points.
    if !pointsResize(points, points.*.count + PHANTOM_COUNT) {
        pointsFree(&stack)
        return false
    }
    const phantoms = points.*.count - PHANTOM_COUNT
    var lsb: i32 = 0
    const hDelta = if hmtx.bearingUnscaled(hmtx.accel(c.*.face, true), gid, &lsb) { xMin - lsb } else { 0 }
    var tsb: i32 = 0
    _ = hmtx.bearingUnscaled(hmtx.accel(c.*.face, false), gid, &tsb)
    const vOrig = yMax + tsb
    const hAdv = @intCast(i32, hmtx.advanceUnscaled(hmtx.accel(c.*.face, true), gid))
    const vAdv = @intCast(i32, hmtx.advanceUnscaled(hmtx.accel(c.*.face, false), gid))
    m.putF32(pt(points, phantoms + PHANTOM_LEFT), @floatFromInt(f32, hDelta))
    m.putF32(pt(points, phantoms + PHANTOM_RIGHT), @floatFromInt(f32, hAdv + hDelta))
    m.putF32(pt(points, phantoms + PHANTOM_TOP) + 4, @floatFromInt(f32, vOrig))
    m.putF32(pt(points, phantoms + PHANTOM_BOTTOM) + 4, @floatFromInt(f32, vOrig - vAdv))
    if c.*.numCoords != 0 {
        _ = gvar.applyDeltasToPoints(c.*.face, gid, c.*.coords, c.*.numCoords, pt(points, old), points.*.count - old, c.*.phantomOnly && simple)
    }
    if composite {
        var compIndex: u32 = 0
        var r = recordAt(t, start + 10, end)
        var matrix: [4]f32 = undefined
        var tx: f32 = 0.0
        var ty: f32 = 0.0
        while r != 0 {
            const itemGid = recordGid(t, r)
            if !currentHas(c, itemGid) {
                if c.*.currentCount < 66 {
                    c.*.current[@intCast(usize, c.*.currentCount)] = itemGid
                    c.*.currentCount += 1
                }
                const oldCount = all.*.count
                const useMyMetrics = (m.u16at(t, r) & USE_MY_METRICS) != 0
                if !c.*.phantomOnly || useMyMetrics {
                    if !getPoints(c, itemGid, all, depth + 1) {
                        c.*.currentCount -= 1
                        pointsFree(&stack)
                        return false
                    }
                }
                const compCount = all.*.count - oldCount
                if useMyMetrics && compCount >= PHANTOM_COUNT {
                    m.copy(pt(&stack, phantoms), pt(all, all.*.count - PHANTOM_COUNT), @intCast(usize, PHANTOM_COUNT) * PS)
                }
                if compCount != 0 {
                    transformation(t, r, @intFromPtr(&matrix), &tx, &ty)
                    // The component's offset with its deltas.
                    const ox = if compIndex < stack.count { m.getF32(pt(&stack, compIndex)) } else { 0.0 }
                    const oy = if compIndex < stack.count { m.getF32(pt(&stack, compIndex) + 4) } else { 0.0 }
                    const flags = m.u16at(t, r)
                    if (flags & (SCALED_COMPONENT_OFFSET | UNSCALED_COMPONENT_OFFSET)) == SCALED_COMPONENT_OFFSET {
                        translateRange(all, oldCount, all.*.count, ox, oy)
                        transformRange(all, oldCount, all.*.count, @intFromPtr(&matrix))
                    } else {
                        transformRange(all, oldCount, all.*.count, @intFromPtr(&matrix))
                        translateRange(all, oldCount, all.*.count, ox, oy)
                    }
                }
                if isAnchored(t, r) && !c.*.phantomOnly {
                    var p1: u32 = 0
                    var p2: u32 = 0
                    anchorPoints(t, r, &p1, &p2)
                    if p1 < all.*.count && p2 < compCount {
                        const dx = m.getF32(pt(all, p1)) - m.getF32(pt(all, oldCount + p2))
                        const dy = m.getF32(pt(all, p1) + 4) - m.getF32(pt(all, oldCount + p2) + 4)
                        translateRange(all, oldCount, all.*.count, dx, dy)
                    }
                }
                // (Also when nothing was added: down to none, as HarfBuzz's
                // resize of a negative length.)
                all.*.count = if all.*.count >= PHANTOM_COUNT { all.*.count - PHANTOM_COUNT } else { 0 }
                if all.*.count > MAX_POINTS {
                    c.*.currentCount -= 1
                    pointsFree(&stack)
                    return false
                }
                compIndex += 1
                c.*.currentCount -= 1
            }
            r = nextRecord(t, r, end)
        }
        if !pointsExtend(all, pt(&stack, phantoms), PHANTOM_COUNT) {
            pointsFree(&stack)
            return false
        }
    } else if !simple {
        if !pointsExtend(all, pt(&stack, phantoms), PHANTOM_COUNT) {
            pointsFree(&stack)
            return false
        }
    }
    if depth == 0 {
        // The undocumented rasterizer behavior: points shifted by the left
        // side bearing (from the phantom point, as an int).
        const left = if simple { m.getF32(pt(all, all.*.count - PHANTOM_COUNT + PHANTOM_LEFT)) } else { m.getF32(pt(&stack, phantoms + PHANTOM_LEFT)) }
        const v = 0 - m.intOf(left)
        if v != 0 {
            const fv = @floatFromInt(f32, v)
            var i: u32 = 0
            while i < all.*.count {
                const p = pt(all, i)
                m.putF32(p, m.getF32(p) + fv)
                i += 1
            }
        }
    }
    pointsFree(&stack)
    return true
}

// The points of `gid` (with its phantom points) at the font's
// coordinates: the glyf accelerator's get_points.
fn glyphPoints(f: usize, gid: u32, phantomOnly: bool, all: *Points) -> bool {
    const fo = font.font(f)
    const g = accel(fo.*.face)
    if gid >= g.*.numGlyphs { return false }
    const address = m.alloc(@sizeOf(Context))
    if address == 0 { return false }
    const c = unsafe { @ptrFromInt(*Context, address) }
    c.*.font = f
    c.*.face = fo.*.face
    c.*.glyf = g
    c.*.coords = fo.*.coords
    c.*.numCoords = fo.*.numCoords
    c.*.phantomOnly = phantomOnly
    c.*.edgeCount = 0
    c.*.currentCount = 0
    const ok = getPoints(c, gid, all, 0)
    m.release(address)
    return ok && all.*.count >= PHANTOM_COUNT
}

// The bounds of the points but the phantom ones (contour_bounds_t), into
// extents (four i32), scaled to the font if `scaled`.
fn boundsExtents(f: usize, all: *Points, e: usize, scaled: bool) -> void {
    var minX: f32 = 3.40282347e+38
    var minY: f32 = 3.40282347e+38
    var maxX: f32 = -3.40282347e+38
    var maxY: f32 = -3.40282347e+38
    const n = all.*.count - PHANTOM_COUNT
    var i: u32 = 0
    while i < n {
        const x = m.getF32(pt(all, i))
        const y = m.getF32(pt(all, i) + 4)
        minX = if minX < x { minX } else { x }
        minY = if minY < y { minY } else { y }
        maxX = if maxX > x { maxX } else { x }
        maxY = if maxY > y { maxY } else { y }
        i += 1
    }
    if minX >= maxX || minY >= maxY {
        m.zero(e, 16)
        return
    }
    const xBearing = m.intOf(m.roundf(minX))
    m.putI32(e, xBearing)
    m.putI32(e + 8, m.intOf(m.roundf(maxX - @floatFromInt(f32, xBearing))))
    const yBearing = m.intOf(m.roundf(maxY))
    m.putI32(e + 4, yBearing)
    m.putI32(e + 12, m.intOf(m.roundf(minY - @floatFromInt(f32, yBearing))))
    if scaled { font.scaleGlyphExtents(f, e) }
}

// The extents of `gid` scaled to the font: whether glyf has the glyph.
pub fn getExtents(f: usize, gid: u32, e: usize) -> bool {
    const fo = font.font(f)
    if gid >= accel(fo.*.face).*.numGlyphs { return false }
    if fo.*.numCoords == 0 { return extentsWithoutVar(f, gid, e) }
    var all: Points = undefined
    all.data = 0
    all.count = 0
    all.cap = 0
    const ok = glyphPoints(f, gid, false, &all)
    if ok { boundsExtents(f, &all, e, true) }
    pointsFree(&all)
    return ok
}

// The advance of `glyph` with the font's variations, from its varied
// phantom points (the table's without them).
pub fn advanceWithVar(f: usize, glyph: u32, vertical: bool) -> i32 {
    const fo = font.font(f)
    const h = hmtx.accel(fo.*.face, !vertical)
    if glyph >= accel(fo.*.face).*.numGlyphs { return 0 }
    var all: Points = undefined
    all.data = 0
    all.count = 0
    all.cap = 0
    var ok = false
    if fo.*.numCoords != 0 { ok = glyphPoints(f, glyph, true, &all) }
    if !ok {
        pointsFree(&all)
        return @intCast(i32, hmtx.advanceUnscaled(h, glyph))
    }
    const ph = all.count - PHANTOM_COUNT
    var result: f32 = 0.0
    if vertical {
        result = m.getF32(pt(&all, ph + PHANTOM_TOP) + 4) - m.getF32(pt(&all, ph + PHANTOM_BOTTOM) + 4)
    } else {
        result = m.getF32(pt(&all, ph + PHANTOM_RIGHT)) - m.getF32(pt(&all, ph + PHANTOM_LEFT))
    }
    pointsFree(&all)
    var r = m.roundf(result)
    if r < 0.0 { r = 0.0 }
    if r > 2147483520.0 { r = 2147483520.0 }
    return m.intOf(r)
}

// The leading bearing of `glyph` with the font's variations.
pub fn bearingWithVar(f: usize, glyph: u32, vertical: bool, out: *i32) -> bool {
    const fo = font.font(f)
    if glyph >= accel(fo.*.face).*.numGlyphs { return false }
    var all: Points = undefined
    all.data = 0
    all.count = 0
    all.cap = 0
    if !glyphPoints(f, glyph, false, &all) {
        pointsFree(&all)
        return false
    }
    var e: [4]i32 = undefined
    boundsExtents(f, &all, @intFromPtr(&e), false)
    const ph = all.count - PHANTOM_COUNT
    if vertical {
        out.* = m.intOf(m.roundf(m.getF32(pt(&all, ph + PHANTOM_TOP) + 4))) - e[1]
    } else {
        out.* = m.intOf(m.roundf(m.getF32(pt(&all, ph + PHANTOM_LEFT))))
    }
    pointsFree(&all)
    return true
}

// ---------------------------------------------------------------------------
// Drawing (path_builder_t)

const Builder = struct {
    session: usize
    hasFirstOn: bool
    firstOnX: f32
    firstOnY: f32
    hasFirstOff: bool
    firstOffX: f32
    firstOffY: f32
    hasFirstOff2: bool
    firstOff2X: f32
    firstOff2Y: f32
    hasLastOff: bool
    lastOffX: f32
    lastOffY: f32
    hasLastOff2: bool
    lastOff2X: f32
    lastOff2Y: f32
}

fn consumePoint(b: *Builder, xMultf: f32, yMultf: f32, x_: f32, y_: f32, flag: u32, isEnd: bool) -> void {
    const s = b.*.session
    const onCurve = (flag & FLAG_ON_CURVE) != 0
    // (Cubic off-curve points only in HarfBuzz's experimental builds.)
    const cubic = false
    const x = x_ * xMultf
    const y = y_ * yMultf
    if !b.*.hasFirstOn {
        if onCurve {
            b.*.hasFirstOn = true
            b.*.firstOnX = x
            b.*.firstOnY = y
            draw.sMoveTo(s, x, y)
        } else if cubic && !b.*.hasFirstOff2 {
            b.*.hasFirstOff2 = b.*.hasFirstOff
            b.*.firstOff2X = b.*.firstOffX
            b.*.firstOff2Y = b.*.firstOffY
            b.*.hasFirstOff = true
            b.*.firstOffX = x
            b.*.firstOffY = y
        } else if b.*.hasFirstOff {
            const mx = (b.*.firstOffX + x) * 0.5
            const my = (b.*.firstOffY + y) * 0.5
            b.*.hasFirstOn = true
            b.*.firstOnX = mx
            b.*.firstOnY = my
            b.*.hasLastOff = true
            b.*.lastOffX = x
            b.*.lastOffY = y
            draw.sMoveTo(s, mx, my)
        } else {
            b.*.hasFirstOff = true
            b.*.firstOffX = x
            b.*.firstOffY = y
        }
    } else if b.*.hasLastOff {
        if onCurve {
            if b.*.hasLastOff2 {
                draw.sCubicTo(s, b.*.lastOff2X, b.*.lastOff2Y, b.*.lastOffX, b.*.lastOffY, x, y)
                b.*.hasLastOff2 = false
            } else {
                draw.sQuadraticTo(s, b.*.lastOffX, b.*.lastOffY, x, y)
            }
            b.*.hasLastOff = false
        } else if cubic && !b.*.hasLastOff2 {
            b.*.hasLastOff2 = true
            b.*.lastOff2X = b.*.lastOffX
            b.*.lastOff2Y = b.*.lastOffY
            b.*.lastOffX = x
            b.*.lastOffY = y
        } else {
            const mx = (b.*.lastOffX + x) * 0.5
            const my = (b.*.lastOffY + y) * 0.5
            if cubic {
                draw.sCubicTo(s, b.*.lastOff2X, b.*.lastOff2Y, b.*.lastOffX, b.*.lastOffY, mx, my)
                b.*.hasLastOff2 = false
            } else {
                draw.sQuadraticTo(s, b.*.lastOffX, b.*.lastOffY, mx, my)
            }
            b.*.lastOffX = x
            b.*.lastOffY = y
        }
    } else if onCurve {
        draw.sLineTo(s, x, y)
    } else {
        b.*.hasLastOff = true
        b.*.lastOffX = x
        b.*.lastOffY = y
    }
    if isEnd {
        if b.*.hasFirstOff && b.*.hasLastOff {
            const fx = if b.*.hasFirstOff2 { b.*.firstOff2X } else { b.*.firstOffX }
            const fy = if b.*.hasFirstOff2 { b.*.firstOff2Y } else { b.*.firstOffY }
            const mx = (b.*.lastOffX + fx) * 0.5
            const my = (b.*.lastOffY + fy) * 0.5
            if b.*.hasLastOff2 {
                draw.sCubicTo(s, b.*.lastOff2X, b.*.lastOff2Y, b.*.lastOffX, b.*.lastOffY, mx, my)
            } else {
                draw.sQuadraticTo(s, b.*.lastOffX, b.*.lastOffY, mx, my)
            }
            b.*.hasLastOff = false
        }
        if b.*.hasFirstOff && b.*.hasFirstOn {
            if b.*.hasFirstOff2 {
                draw.sCubicTo(s, b.*.firstOff2X, b.*.firstOff2Y, b.*.firstOffX, b.*.firstOffY, b.*.firstOnX, b.*.firstOnY)
            } else {
                draw.sQuadraticTo(s, b.*.firstOffX, b.*.firstOffY, b.*.firstOnX, b.*.firstOnY)
            }
        } else if b.*.hasLastOff && b.*.hasFirstOn {
            if b.*.hasLastOff2 {
                draw.sCubicTo(s, b.*.lastOff2X, b.*.lastOff2Y, b.*.lastOffX, b.*.lastOffY, b.*.firstOnX, b.*.firstOnY)
            } else {
                draw.sQuadraticTo(s, b.*.lastOffX, b.*.lastOffY, b.*.firstOnX, b.*.firstOnY)
            }
        } else if b.*.hasFirstOn {
            draw.sLineTo(s, b.*.firstOnX, b.*.firstOnY)
        } else if b.*.hasFirstOff {
            const fx = b.*.firstOffX
            const fy = b.*.firstOffY
            draw.sMoveTo(s, fx, fy)
            draw.sQuadraticTo(s, fx, fy, fx, fy)
        }
        // (HarfBuzz resets these, not the first second off-curve point.)
        b.*.hasFirstOn = false
        b.*.hasFirstOff = false
        b.*.hasLastOff = false
        b.*.hasLastOff2 = false
        draw.sClosePath(s)
    }
}

// Draws `gid` into the session: whether glyf has the glyph.
pub fn getPath(f: usize, gid: u32, session: usize) -> bool {
    const fo = font.font(f)
    if gid >= accel(fo.*.face).*.numGlyphs { return false }
    var all: Points = undefined
    all.data = 0
    all.count = 0
    all.cap = 0
    if !glyphPoints(f, gid, false, &all) {
        pointsFree(&all)
        return false
    }
    var b: Builder = undefined
    m.zero(@intFromPtr(&b), @sizeOf(Builder))
    b.session = session
    const n = all.count - PHANTOM_COUNT
    var i: u32 = 0
    while i < n {
        const p = pt(&all, i)
        consumePoint(&b, fo.*.xMultf, fo.*.yMultf, m.getF32(p), m.getF32(p + 4), @intCast(u32, m.get8(p + gvar.POINT_FLAG)), m.get8(p + gvar.POINT_END) != 0)
        i += 1
    }
    pointsFree(&all)
    return true
}
