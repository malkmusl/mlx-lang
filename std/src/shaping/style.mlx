// The style of a font (HarfBuzz's hb-style.cc): italic, optical size,
// slant, width and weight from the font's variations, the STAT table,
// OS/2, head and post; and STAT itself.
const m = @import("./memory.mlx")
const face = @import("./face.mlx")
const font = @import("./font.mlx")
const metrics = @import("./metrics.mlx")
const variations = @import("./variations.mlx")
const sanitize = @import("./sanitize.mlx")
const trig = @import("./trig.mlx")
const layoutextra = @import("./layoutextra.mlx")

const TAG_ITALIC: u32 = 0x6974616C
const TAG_OPTICAL_SIZE: u32 = 0x6F70737A
const TAG_SLANT_ANGLE: u32 = 0x736C6E74
const TAG_SLANT_RATIO: u32 = 0x536C6E74
const TAG_WIDTH: u32 = 0x77647468
const TAG_WEIGHT: u32 = 0x77676874
const PI: f32 = 3.14159265358979

pub const Stat = struct {
    t: m.Table
    copy: usize
}

fn statOf(address: usize) -> *Stat { unsafe { return @ptrFromInt(*Stat, address) } }

pub fn statFreeCallback(a: usize) -> void {
    const s = statOf(a)
    if s.*.copy != 0 { m.release(s.*.copy) }
    m.release(a)
}

fn axisValueChecks(s: *sanitize.Sanitizer, at: usize) -> bool {
    if !sanitize.range(s, at, 2) { return false }
    const format = sanitize.u16at(s, at)
    if format == 1 { return sanitize.range(s, at, 12) }
    if format == 2 { return sanitize.range(s, at, 20) }
    if format == 3 { return sanitize.range(s, at, 16) }
    if format == 4 { return sanitize.range(s, at, 8) && sanitize.array(s, at + 8, sanitize.u16at(s, at + 2), 6) }
    return true
}

fn statChecks(s: *sanitize.Sanitizer) -> bool {
    if !sanitize.range(s, 0, 20) { return false }
    if sanitize.u16at(s, 0) != 1 || sanitize.u16at(s, 2) == 0 { return false }
    if !sanitize.range(s, 8, 4) { return false }
    if !sanitize.array(s, @intCast(usize, sanitize.u32at(s, 8)), sanitize.u16at(s, 6), 8) { return false }
    if !sanitize.range(s, 14, 4) { return false }
    const list = @intCast(usize, sanitize.u32at(s, 14))
    const count = sanitize.u16at(s, 12)
    if !sanitize.array(s, list, count, 2) { return false }
    var i: u32 = 0
    while i < count {
        const field = list + @intCast(usize, i) * 2
        if !sanitize.range(s, field, 2) { return false }
        const off = @intCast(usize, sanitize.u16at(s, field))
        if off != 0 && !axisValueChecks(s, list + off) && !sanitize.neuter(s, field, 2) { return false }
        i += 1
    }
    return true
}

pub fn statAccel(fc: usize) -> *Stat {
    var a = face.accel(fc, face.A_STAT)
    if a == 0 {
        const made = m.alloc(@sizeOf(Stat))
        const s = statOf(made)
        var t: m.Table = undefined
        face.view(fc, face.T_STAT, &t)
        sanitize.sanitizeTable(&t, face.numGlyphs(fc), @intFromPtr(statChecks), &s.*.t, &s.*.copy)
        a = face.keepAccel(fc, face.A_STAT, made, @intFromPtr(statFreeCallback))
    }
    return statOf(a)
}

// STAT::get_value: the first axis value of the axis `tag`. (HarfBuzz
// returns the value as a bool: 1 when it is not zero.)
fn statValue(fc: usize, tag: u32, value: *f32) -> bool {
    const t = &statAccel(fc).*.t
    const axes = @intCast(usize, m.u32at(t, 8))
    const axisCount = m.u16at(t, 6)
    var index: u32 = 0
    while index < axisCount {
        if m.u32at(t, axes + @intCast(usize, index) * 8) == tag { break }
        index += 1
    }
    if index >= axisCount { return false }
    const list = @intCast(usize, m.u32at(t, 14))
    const count = m.u16at(t, 12)
    var i: u32 = 0
    while i < count {
        // (HarfBuzz takes the offsets from the start of the table.)
        const off = @intCast(usize, m.u16at(t, list + @intCast(usize, i) * 2))
        const format = if off != 0 { m.u16at(t, off) } else { @intCast(u32, 0) }
        if format >= 1 && format <= 3 && m.u16at(t, off + 2) == index {
            const v = m.i32at(t, off + 8)
            value.* = if v != 0 { 1.0 } else { 0.0 }
            return true
        }
        i += 1
    }
    return false
}

fn postItalicAngle(fc: usize) -> f32 {
    var t: m.Table = undefined
    face.view(fc, face.T_POST, &t)
    if t.length < 32 { return 0.0 }
    const version = m.u32at(&t, 0)
    if version == 0x00020000 {
        if t.length < 34 || !m.fits(&t, 34, @intCast(usize, m.u16at(&t, 32)) * 2) { return 0.0 }
    } else if version != 0x00010000 && version != 0x00030000 {
        return 0.0
    }
    return @floatFromInt(f32, m.i32at(&t, 4)) / 65536.0
}

fn angleToRatio(a: f32) -> f32 { return trig.tanf(a * -PI / 180.0) }
fn ratioToAngle(r: f32) -> f32 { return trig.atanf(r) * -180.0 / PI }

pub fn styleGetValue(f: usize, tag: u32) -> f32 {
    if tag == TAG_SLANT_RATIO { return angleToRatio(styleGetValue(f, TAG_SLANT_ANGLE)) }
    const fo = font.font(f)
    const fc = fo.*.face
    var info: [8]u32 = undefined
    if variations.findAxisInfo(fc, tag, @intFromPtr(&info)) {
        if info[0] < fo.*.numCoords { return m.getF32(fo.*.designCoords + @intCast(usize, info[0]) * 4) }
        return @bitCast(f32, info[5])
    }
    if tag == TAG_OPTICAL_SIZE && fo.*.ptem != 0.0 { return fo.*.ptem }
    var value: f32 = 0.0
    if statValue(fc, tag, &value) { return value }
    var os2: m.Table = undefined
    metrics.os2View(fc, &os2)
    var head: m.Table = undefined
    face.headView(fc, &head)
    const macStyle = m.u16at(&head, 44)
    if tag == TAG_ITALIC {
        return if (m.u16at(&os2, 62) & 1) != 0 || (macStyle & 2) != 0 { 1.0 } else { 0.0 }
    }
    if tag == TAG_OPTICAL_SIZE {
        if m.u16at(&os2, 0) >= 5 {
            const lower = m.u16at(&os2, 96)
            const upper = m.u16at(&os2, 98)
            if lower < upper && lower >= 1 && lower <= 0xFFFE && upper >= 2 && upper <= 0xFFFF {
                return @floatFromInt(f32, lower + upper) / 2.0
            }
        }
        var design: u32 = 0
        if layoutextra.sizeParams(fc, &design, 0, 0, 0, 0) { return @floatFromInt(f32, design) / 10.0 }
        return 12.0
    }
    if tag == TAG_SLANT_ANGLE {
        var angle = postItalicAngle(fc)
        if fo.*.slant != 0.0 { angle = ratioToAngle(fo.*.slant + angleToRatio(angle)) }
        return angle
    }
    if tag == TAG_WIDTH {
        if metrics.os2HasData(&os2) {
            const w = m.u16at(&os2, 6)
            if w == 1 { return 50.0 }
            if w == 2 { return 62.5 }
            if w == 3 { return 75.0 }
            if w == 4 { return 87.5 }
            if w == 6 { return 112.5 }
            if w == 7 { return 125.0 }
            if w == 8 { return 150.0 }
            if w == 9 { return 200.0 }
            return 100.0
        }
        if (macStyle & 32) != 0 { return 75.0 }
        if (macStyle & 64) != 0 { return 125.0 }
        return 100.0
    }
    if tag == TAG_WEIGHT {
        if metrics.os2HasData(&os2) { return @floatFromInt(f32, m.u16at(&os2, 4)) }
        return if (macStyle & 1) != 0 { 700.0 } else { 400.0 }
    }
    return 0.0
}
