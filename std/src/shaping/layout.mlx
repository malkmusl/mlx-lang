// The OpenType layout tables' common parts (HarfBuzz's
// hb-ot-layout-common.hh and hb-ot-layout.cc): GDEF, the script, feature and
// lookup lists of GSUB and GPOS, coverage and class definition tables,
// device tables and feature variations; and the hb_ot_layout_* functions
// that query them.
//
// Tables are read in place with bounded reads (a read past the end gives
// 0). An offset of 0 to a subtable is HarfBuzz's Null object: here the
// offset 0 stands for it, and every accessor treats it as empty.
const m = @import("./memory.mlx")
const o = @import("./object.mlx")
const common = @import("./common.mlx")
const face = @import("./face.mlx")
const font = @import("./font.mlx")
const set = @import("./set.mlx")
const variations = @import("./variations.mlx")

pub const NOT_COVERED: u32 = 0xFFFFFFFF
pub const NOT_FOUND: u32 = 0xFFFF
pub const NO_VARIATIONS: u32 = 0xFFFFFFFF

pub const TAG_GSUB: u32 = 0x47535542
pub const TAG_GPOS: u32 = 0x47504F53
const TAG_DFLT_SCRIPT: u32 = 0x44464C54
const TAG_DFLT_LANGUAGE: u32 = 0x64666C74
const TAG_LATN: u32 = 0x6C61746E

// Glyph properties (match the lookup flags' Ignore* bits).
pub const PROPS_BASE_GLYPH: u32 = 0x02
pub const PROPS_LIGATURE: u32 = 0x04
pub const PROPS_MARK: u32 = 0x08
pub const PROPS_SUBSTITUTED: u32 = 0x10
pub const PROPS_LIGATED: u32 = 0x20
pub const PROPS_MULTIPLIED: u32 = 0x40
pub const PROPS_PRESERVE: u32 = 0x70

// Lookup flags.
pub const FLAG_RIGHT_TO_LEFT: u32 = 0x0001
pub const FLAG_IGNORE_FLAGS: u32 = 0x000E
pub const FLAG_USE_MARK_FILTERING_SET: u32 = 0x0010
pub const FLAG_MARK_ATTACHMENT_TYPE: u32 = 0xFF00

// The offset of the subtable whose 16-bit offset (from `base`) is at
// `base + at`; 0 (the Null object) when that offset is 0.
pub fn sub16(t: *m.Table, base: usize, at: usize) -> usize {
    if base == 0 { return 0 }
    const off = @intCast(usize, m.u16at(t, base + at))
    return if off == 0 { 0 } else { base + off }
}

pub fn sub32(t: *m.Table, base: usize, at: usize) -> usize {
    if base == 0 { return 0 }
    const off = @intCast(usize, m.u32at(t, base + at))
    return if off == 0 { 0 } else { base + off }
}

// A 16-bit value of a subtable (0 for the Null object).
pub fn u16of(t: *m.Table, base: usize, at: usize) -> u32 {
    if base == 0 { return 0 }
    return m.u16at(t, base + at)
}

pub fn i16of(t: *m.Table, base: usize, at: usize) -> i32 {
    if base == 0 { return 0 }
    return m.i16at(t, base + at)
}

// ---------------------------------------------------------------------------
// Coverage and class definitions

pub fn coverage(t: *m.Table, off: usize, g: u32) -> u32 {
    if off == 0 { return NOT_COVERED }
    const format = m.u16at(t, off)
    if format == 1 {
        var lo: i32 = 0
        var hi: i32 = @intCast(i32, m.u16at(t, off + 2)) - 1
        while lo <= hi {
            const mid = @intCast(i32, (@intCast(u32, lo) + @intCast(u32, hi)) / 2)
            const v = m.u16at(t, off + 4 + @intCast(usize, mid) * 2)
            if g < v {
                hi = mid - 1
            } else if g > v {
                lo = mid + 1
            } else {
                return @intCast(u32, mid)
            }
        }
        return NOT_COVERED
    }
    if format == 2 {
        var lo: i32 = 0
        var hi: i32 = @intCast(i32, m.u16at(t, off + 2)) - 1
        while lo <= hi {
            const mid = @intCast(i32, (@intCast(u32, lo) + @intCast(u32, hi)) / 2)
            const r = off + 4 + @intCast(usize, mid) * 6
            const first = m.u16at(t, r)
            const last = m.u16at(t, r + 2)
            if g < first {
                hi = mid - 1
            } else if g > last {
                lo = mid + 1
            } else {
                return m.u16at(t, r + 4) +% (g - first)
            }
        }
        return NOT_COVERED
    }
    return NOT_COVERED
}

pub fn classOf(t: *m.Table, off: usize, g: u32) -> u32 {
    if off == 0 { return 0 }
    const format = m.u16at(t, off)
    if format == 1 {
        const start = m.u16at(t, off + 2)
        const count = m.u16at(t, off + 4)
        const i = g -% start
        if i >= count { return 0 }
        return m.u16at(t, off + 6 + @intCast(usize, i) * 2)
    }
    if format == 2 {
        var lo: i32 = 0
        var hi: i32 = @intCast(i32, m.u16at(t, off + 2)) - 1
        while lo <= hi {
            const mid = @intCast(i32, (@intCast(u32, lo) + @intCast(u32, hi)) / 2)
            const r = off + 4 + @intCast(usize, mid) * 6
            if g < m.u16at(t, r) {
                hi = mid - 1
            } else if g > m.u16at(t, r + 2) {
                lo = mid + 1
            } else {
                return m.u16at(t, r + 4)
            }
        }
        return 0
    }
    return 0
}

// Adds the glyphs of a coverage table to the set `out`.
pub fn collectCoverage(t: *m.Table, off: usize, out: usize) -> void {
    if off == 0 || out == 0 { return }
    const format = m.u16at(t, off)
    const count = @intCast(usize, m.u16at(t, off + 2))
    var i: usize = 0
    while i < count {
        if format == 1 {
            set.add(out, m.u16at(t, off + 4 + i * 2))
        } else if format == 2 {
            const r = off + 4 + i * 6
            const a = m.u16at(t, r)
            const b = m.u16at(t, r + 2)
            if a <= b { set.addRange(out, a, b) }
        }
        i += 1
    }
}

// Adds the glyphs of class `klass` to `out` (class 0: only those listed).
pub fn collectClass(t: *m.Table, off: usize, klass: u32, out: usize) -> void {
    if off == 0 || out == 0 { return }
    const format = m.u16at(t, off)
    if format == 1 {
        const start = m.u16at(t, off + 2)
        const count = @intCast(usize, m.u16at(t, off + 4))
        var i: usize = 0
        while i < count {
            if m.u16at(t, off + 6 + i * 2) == klass { set.add(out, start + @intCast(u32, i)) }
            i += 1
        }
    } else if format == 2 {
        const count = @intCast(usize, m.u16at(t, off + 2))
        var i: usize = 0
        while i < count {
            const r = off + 4 + i * 6
            if m.u16at(t, r + 4) == klass && m.u16at(t, r) <= m.u16at(t, r + 2) { set.addRange(out, m.u16at(t, r), m.u16at(t, r + 2)) }
            i += 1
        }
    }
}

// ---------------------------------------------------------------------------
// Device tables

// The delta of a device table at `off` for the x (or y) direction:
// hinting deltas by ppem, or variation deltas of `store` (offset in `t`).
pub fn deviceDelta(t: *m.Table, off: usize, f: usize, horizontal: bool, storeTable: *m.Table, store: usize) -> i32 {
    if off == 0 { return 0 }
    const format = m.u16at(t, off + 4)
    const fo = font.font(f)
    if format >= 1 && format <= 3 {
        const ppem = if horizontal { fo.*.xPpem } else { fo.*.yPpem }
        const scale = if horizontal { fo.*.xScale } else { fo.*.yScale }
        if ppem == 0 { return 0 }
        const startSize = m.u16at(t, off)
        const endSize = m.u16at(t, off + 2)
        if ppem < startSize || ppem > endSize { return 0 }
        const s = ppem - startSize
        const fshift = @intCast(u5, 4 - format)
        const word = m.u16at(t, off + 6 + @intCast(usize, s >> fshift) * 2)
        const shift = 16 - (((s & ((@intCast(u32, 1) << fshift) - 1)) + 1) << @intCast(u5, format))
        const bits = word >> @intCast(u5, shift)
        const mask = @intCast(u32, 0xFFFF) >> @intCast(u5, 16 - (@intCast(u32, 1) << @intCast(u5, format)))
        var delta = @intCast(i32, bits & mask)
        if @intCast(u32, delta) >= ((mask + 1) >> 1) { delta -= @intCast(i32, mask + 1) }
        if delta == 0 { return 0 }
        return @intCast(i32, @intCast(i64, delta) * @intCast(i64, scale) / @intCast(i64, ppem))
    }
    if format == 0x8000 {
        if store == 0 { return 0 }
        const index = m.u32at(t, off)
        const d = variations.storeDelta(storeTable, store, index, fo.*.coords, fo.*.numCoords)
        return if horizontal { font.emScalefX(f, d) } else { font.emScalefY(f, d) }
    }
    return 0
}

// ---------------------------------------------------------------------------
// GDEF

pub fn gdefView(fc: usize, out: *m.Table) -> void {
    face.view(fc, face.T_GDEF, out)
    if out.*.length < 12 || m.u16at(out, 0) != 1 { out.*.length = 0 }
}

pub fn gdefHasGlyphClasses(t: *m.Table) -> bool { return t.*.length != 0 && m.u16at(t, 4) != 0 }

fn gdefClassDef(t: *m.Table, at: usize) -> usize {
    if t.*.length == 0 { return 0 }
    const off = @intCast(usize, m.u16at(t, at))
    return off
}

pub fn gdefMarkSets(t: *m.Table) -> usize {
    if t.*.length == 0 || m.u32at(t, 0) < 0x00010002 { return 0 }
    return gdefClassDef(t, 12)
}

pub fn gdefVarStore(t: *m.Table) -> usize {
    if t.*.length == 0 || m.u32at(t, 0) < 0x00010003 || t.*.length < 18 { return 0 }
    return @intCast(usize, m.u32at(t, 14))
}

// The glyph properties of `g` from GDEF (class bits, the mark attachment
// type in the high byte).
pub fn glyphProps(t: *m.Table, g: u32) -> u32 {
    if t.*.length == 0 { return 0 }
    const klass = classOf(t, gdefClassDef(t, 4), g)
    if klass == 1 { return PROPS_BASE_GLYPH }
    if klass == 2 { return PROPS_LIGATURE }
    if klass == 3 { return PROPS_MARK | (classOf(t, gdefClassDef(t, 10), g) << 8) }
    return 0
}

pub fn markSetCovers(t: *m.Table, setIndex: u32, g: u32) -> bool {
    const sets = gdefMarkSets(t)
    if sets == 0 || m.u16at(t, sets) != 1 { return false }
    if setIndex >= m.u16at(t, sets + 2) { return false }
    const cov = m.u32at(t, sets + 4 + @intCast(usize, setIndex) * 4)
    if cov == 0 { return false }
    return coverage(t, sets + @intCast(usize, cov), g) != NOT_COVERED
}

// ---------------------------------------------------------------------------
// GSUB and GPOS: scripts, language systems, features, lookups

// The GSUB (0) or GPOS (1) table, empty unless a version 1 one.
pub fn gsubgpos(fc: usize, tableIndex: u32, out: *m.Table) -> void {
    face.view(fc, if tableIndex == 0 { face.T_GSUB } else { face.T_GPOS }, out)
    if out.*.length < 10 || m.u16at(out, 0) != 1 { out.*.length = 0 }
}

pub fn tableIndexOf(tag: u32) -> u32 {
    if tag == TAG_GSUB { return 0 }
    if tag == TAG_GPOS { return 1 }
    return 2
}

// The table of `tag` (empty for other tags).
pub fn tableOf(fc: usize, tag: u32, out: *m.Table) -> void {
    const ti = tableIndexOf(tag)
    if ti > 1 {
        out.*.data = 0
        out.*.length = 0
        return
    }
    gsubgpos(fc, ti, out)
}

pub fn hasData(fc: usize, tableIndex: u32) -> bool {
    var t: m.Table = undefined
    face.view(fc, if tableIndex == 0 { face.T_GSUB } else { face.T_GPOS }, &t)
    return m.u32at(&t, 0) != 0
}

pub fn scriptList(t: *m.Table) -> usize { return if t.*.length == 0 { 0 } else { @intCast(usize, m.u16at(t, 4)) } }
pub fn featureList(t: *m.Table) -> usize { return if t.*.length == 0 { 0 } else { @intCast(usize, m.u16at(t, 6)) } }
pub fn lookupList(t: *m.Table) -> usize { return if t.*.length == 0 { 0 } else { @intCast(usize, m.u16at(t, 8)) } }

pub fn featureVariations(t: *m.Table) -> usize {
    if t.*.length < 14 || m.u32at(t, 0) < 0x00010001 { return 0 }
    const off = @intCast(usize, m.u32at(t, 10))
    return off
}

// Records of tag and offset: their count, tag and offset.
pub fn recordCount(t: *m.Table, list: usize) -> u32 { return u16of(t, list, 0) }
pub fn recordTag(t: *m.Table, list: usize, i: u32) -> u32 {
    if list == 0 || i >= m.u16at(t, list) { return 0 }
    return m.u32at(t, list + 2 + @intCast(usize, i) * 6)
}
pub fn recordOffset(t: *m.Table, list: usize, i: u32) -> usize {
    if list == 0 || i >= m.u16at(t, list) { return 0 }
    return sub16(t, list, 2 + @intCast(usize, i) * 6 + 4)
}

// Binary search of a record list by tag; NOT_FOUND in `index` if absent.
pub fn findRecord(t: *m.Table, list: usize, tag: u32, index: *u32) -> bool {
    var lo: i32 = 0
    var hi: i32 = @intCast(i32, recordCount(t, list)) - 1
    while lo <= hi {
        const mid = @intCast(i32, (@intCast(u32, lo) + @intCast(u32, hi)) / 2)
        const v = m.u32at(t, list + 2 + @intCast(usize, mid) * 6)
        if tag < v {
            hi = mid - 1
        } else if tag > v {
            lo = mid + 1
        } else {
            index.* = @intCast(u32, mid)
            return true
        }
    }
    index.* = NOT_FOUND
    return false
}

// Copies the tags of records [start, start + *count) to `tags`; the
// record count.
fn recordTags(t: *m.Table, list: usize, start: u32, count: usize, tags: usize) -> u32 {
    const total = recordCount(t, list)
    if count != 0 {
        var n = m.get32(count)
        const avail = if start < total { total - start } else { 0 }
        if n > avail { n = avail }
        var i: u32 = 0
        while i < n {
            m.put32(tags + @intCast(usize, i) * 4, recordTag(t, list, start + i))
            i += 1
        }
        m.put32(count, n)
    }
    return total
}

pub fn script(t: *m.Table, i: u32) -> usize { return recordOffset(t, scriptList(t), i) }

// The language system `i` of a script (NOT_FOUND: its default one).
pub fn langSys(t: *m.Table, s: usize, i: u32) -> usize {
    if i == NOT_FOUND { return sub16(t, s, 0) }
    return recordOffset(t, s + 2, i)
}

pub fn langSysRequired(t: *m.Table, l: usize) -> u32 {
    if l == 0 { return NOT_FOUND }
    return m.u16at(t, l + 2)
}

pub fn langSysFeatureCount(t: *m.Table, l: usize) -> u32 { return u16of(t, l, 4) }
pub fn langSysFeature(t: *m.Table, l: usize, i: u32) -> u32 {
    if l == 0 || i >= m.u16at(t, l + 4) { return 0 }
    return m.u16at(t, l + 6 + @intCast(usize, i) * 2)
}

pub fn featureCount(t: *m.Table) -> u32 { return recordCount(t, featureList(t)) }
pub fn featureTag(t: *m.Table, i: u32) -> u32 {
    if i == NOT_FOUND { return 0 }
    return recordTag(t, featureList(t), i)
}
pub fn feature(t: *m.Table, i: u32) -> usize { return recordOffset(t, featureList(t), i) }

pub fn lookupCount(t: *m.Table) -> u32 { return u16of(t, lookupList(t), 0) }
pub fn lookup(t: *m.Table, i: u32) -> usize {
    const list = lookupList(t)
    if list == 0 || i >= m.u16at(t, list) { return 0 }
    return sub16(t, list, 2 + @intCast(usize, i) * 2)
}

// A lookup's props: its flag, with the mark filtering set in the high half.
pub fn lookupProps(t: *m.Table, l: usize) -> u32 {
    if l == 0 { return 0 }
    var flag = m.u16at(t, l + 2)
    if (flag & FLAG_USE_MARK_FILTERING_SET) != 0 {
        const count = @intCast(usize, m.u16at(t, l + 4))
        flag += m.u16at(t, l + 6 + count * 2) << 16
    }
    return flag
}

pub fn lookupType(t: *m.Table, l: usize) -> u32 { return u16of(t, l, 0) }
pub fn subtableCount(t: *m.Table, l: usize) -> u32 { return u16of(t, l, 4) }
pub fn subtable(t: *m.Table, l: usize, i: u32) -> usize { return sub16(t, l, 6 + @intCast(usize, i) * 2) }

// The feature table for `index`, or its substitute in the feature
// variation record `variationsIndex`.
pub fn featureVariation(t: *m.Table, index: u32, variationsIndex: u32) -> usize {
    if variationsIndex != NO_VARIATIONS && m.u32at(t, 0) >= 0x00010001 {
        const fv = featureVariations(t)
        if fv != 0 && variationsIndex < m.u32at(t, fv + 4) {
            const subs = sub32(t, fv, 8 + @intCast(usize, variationsIndex) * 8 + 4)
            if subs != 0 {
                const count = @intCast(usize, m.u16at(t, subs + 4))
                var i: usize = 0
                while i < count {
                    if m.u16at(t, subs + 6 + i * 6) == index {
                        return sub32(t, subs, 6 + i * 6 + 2)
                    }
                    i += 1
                }
            }
        }
    }
    return feature(t, index)
}

// The first feature variation record whose conditions the normalized
// coordinates meet.
pub fn findVariationsIndex(t: *m.Table, coords: usize, count: u32, index: *u32) -> bool {
    index.* = NO_VARIATIONS
    const fv = featureVariations(t)
    if fv == 0 { return false }
    const records = m.u32at(t, fv + 4)
    var i: u32 = 0
    while i < records {
        const conditions = sub32(t, fv, 8 + @intCast(usize, i) * 8)
        var ok = true
        if conditions != 0 {
            const n = @intCast(usize, m.u16at(t, conditions))
            var k: usize = 0
            while k < n && ok {
                const c = sub32(t, conditions, 2 + k * 4)
                if c != 0 && m.u16at(t, c) == 1 {
                    const axis = m.u16at(t, c + 2)
                    const coord = if axis < count { m.getI32(coords + @intCast(usize, axis) * 4) } else { 0 }
                    if !(m.i16at(t, c + 4) <= coord && coord <= m.i16at(t, c + 6)) { ok = false }
                } else {
                    ok = false
                }
                k += 1
            }
        }
        if ok {
            index.* = i
            return true
        }
        i += 1
    }
    return false
}

// ---------------------------------------------------------------------------
// The hb_ot_layout_* functions

fn b(v: bool) -> i32 { return if v { 1 } else { 0 } }

pub fn otLayoutHasGlyphClasses(fc: usize) -> i32 {
    var t: m.Table = undefined
    gdefView(fc, &t)
    return b(gdefHasGlyphClasses(&t))
}

pub fn otLayoutGetGlyphClass(fc: usize, g: u32) -> u32 {
    var t: m.Table = undefined
    gdefView(fc, &t)
    if t.length == 0 { return 0 }
    return classOf(&t, gdefClassDef(&t, 4), g)
}

pub fn otLayoutGetGlyphsInClass(fc: usize, klass: u32, glyphs: usize) -> void {
    var t: m.Table = undefined
    gdefView(fc, &t)
    if t.length == 0 { return }
    collectClass(&t, gdefClassDef(&t, 4), klass, glyphs)
}

pub fn otLayoutGetAttachPoints(fc: usize, g: u32, start: u32, count: usize, points: usize) -> u32 {
    var t: m.Table = undefined
    gdefView(fc, &t)
    const list = if t.length == 0 { 0 } else { gdefClassDef(&t, 6) }
    const index = coverage(&t, sub16(&t, list, 0), g)
    if list == 0 || index == NOT_COVERED {
        if count != 0 { m.put32(count, 0) }
        return 0
    }
    const ap = sub16(&t, list, 4 + @intCast(usize, index) * 2)
    const total = u16of(&t, ap, 0)
    if count != 0 {
        var n = m.get32(count)
        const avail = if start < total { total - start } else { 0 }
        if n > avail { n = avail }
        var i: u32 = 0
        while i < n {
            m.put32(points + @intCast(usize, i) * 4, m.u16at(&t, ap + 2 + @intCast(usize, start + i) * 2))
            i += 1
        }
        m.put32(count, n)
    }
    return total
}

pub fn otLayoutGetLigatureCarets(f: usize, direction: u32, g: u32, start: u32, count: usize, carets: usize) -> u32 {
    var t: m.Table = undefined
    gdefView(font.font(f).*.face, &t)
    const list = if t.length == 0 { 0 } else { gdefClassDef(&t, 8) }
    const index = coverage(&t, sub16(&t, list, 0), g)
    if list == 0 || index == NOT_COVERED {
        if count != 0 { m.put32(count, 0) }
        return 0
    }
    const lg = sub16(&t, list, 4 + @intCast(usize, index) * 2)
    const total = u16of(&t, lg, 0)
    const horizontal = common.isHorizontal(direction)
    if count != 0 {
        var n = m.get32(count)
        const avail = if start < total { total - start } else { 0 }
        if n > avail { n = avail }
        var i: u32 = 0
        while i < n {
            const cv = sub16(&t, lg, 2 + @intCast(usize, start + i) * 2)
            const format = u16of(&t, cv, 0)
            var v: i32 = 0
            if format == 1 || format == 3 {
                const coordinate = i16of(&t, cv, 2)
                v = if horizontal { font.emScaleX(f, coordinate) } else { font.emScaleY(f, coordinate) }
                if format == 3 { v +%= deviceDelta(&t, sub16(&t, cv, 4), f, horizontal, &t, gdefVarStore(&t)) }
            } else if format == 2 {
                var x: i32 = 0
                var y: i32 = 0
                _ = font.getGlyphContourPointForOrigin(f, g, u16of(&t, cv, 2), direction, &x, &y)
                v = if horizontal { x } else { y }
            }
            m.putI32(carets + @intCast(usize, i) * 4, v)
            i += 1
        }
        m.put32(count, n)
    }
    return total
}

pub fn otLayoutTableGetScriptTags(fc: usize, tag: u32, start: u32, count: usize, tags: usize) -> u32 {
    var t: m.Table = undefined
    tableOf(fc, tag, &t)
    return recordTags(&t, scriptList(&t), start, count, tags)
}

fn findScriptIndex(t: *m.Table, tag: u32, index: usize) -> bool {
    var i: u32 = 0
    const found = findRecord(t, scriptList(t), tag, &i)
    if index != 0 { m.put32(index, i) }
    return found
}

pub fn otLayoutTableFindScript(fc: usize, tableTag: u32, scriptTag: u32, index: usize) -> i32 {
    var t: m.Table = undefined
    tableOf(fc, tableTag, &t)
    if findScriptIndex(&t, scriptTag, index) { return 1 }
    if findScriptIndex(&t, TAG_DFLT_SCRIPT, index) { return 0 }
    if findScriptIndex(&t, TAG_DFLT_LANGUAGE, index) { return 0 }
    if findScriptIndex(&t, TAG_LATN, index) { return 0 }
    if index != 0 { m.put32(index, NOT_FOUND) }
    return 0
}

pub fn selectScript(fc: usize, tableTag: u32, count: u32, tags: usize, index: usize, chosen: usize) -> bool {
    var t: m.Table = undefined
    tableOf(fc, tableTag, &t)
    var i: u32 = 0
    while i < count {
        const tag = m.get32(tags + @intCast(usize, i) * 4)
        if findScriptIndex(&t, tag, index) {
            if chosen != 0 { m.put32(chosen, tag) }
            return true
        }
        i += 1
    }
    if findScriptIndex(&t, TAG_DFLT_SCRIPT, index) {
        if chosen != 0 { m.put32(chosen, TAG_DFLT_SCRIPT) }
        return false
    }
    if findScriptIndex(&t, TAG_DFLT_LANGUAGE, index) {
        if chosen != 0 { m.put32(chosen, TAG_DFLT_LANGUAGE) }
        return false
    }
    if findScriptIndex(&t, TAG_LATN, index) {
        if chosen != 0 { m.put32(chosen, TAG_LATN) }
        return false
    }
    if index != 0 { m.put32(index, NOT_FOUND) }
    if chosen != 0 { m.put32(chosen, 0) }
    return false
}

pub fn otLayoutTableSelectScript(fc: usize, tableTag: u32, count: u32, tags: usize, index: usize, chosen: usize) -> i32 {
    return b(selectScript(fc, tableTag, count, tags, index, chosen))
}

pub fn otLayoutTableChooseScript(fc: usize, tableTag: u32, tags: usize, index: usize, chosen: usize) -> i32 {
    var n: u32 = 0
    while m.get32(tags + @intCast(usize, n) * 4) != 0 { n += 1 }
    return b(selectScript(fc, tableTag, n, tags, index, chosen))
}

pub fn otLayoutTableGetFeatureTags(fc: usize, tag: u32, start: u32, count: usize, tags: usize) -> u32 {
    var t: m.Table = undefined
    tableOf(fc, tag, &t)
    return recordTags(&t, featureList(&t), start, count, tags)
}

pub fn tableFindFeature(fc: usize, tableTag: u32, featureTag_: u32, index: usize) -> bool {
    var t: m.Table = undefined
    tableOf(fc, tableTag, &t)
    const n = featureCount(&t)
    var i: u32 = 0
    while i < n {
        if featureTag(&t, i) == featureTag_ {
            if index != 0 { m.put32(index, i) }
            return true
        }
        i += 1
    }
    if index != 0 { m.put32(index, NOT_FOUND) }
    return false
}

pub fn otLayoutTableFindFeature(fc: usize, tableTag: u32, featureTag_: u32, index: usize) -> i32 {
    return b(tableFindFeature(fc, tableTag, featureTag_, index))
}

pub fn otLayoutScriptGetLanguageTags(fc: usize, tableTag: u32, scriptIndex: u32, start: u32, count: usize, tags: usize) -> u32 {
    var t: m.Table = undefined
    tableOf(fc, tableTag, &t)
    const s = script(&t, scriptIndex)
    return recordTags(&t, if s == 0 { 0 } else { s + 2 }, start, count, tags)
}

fn findLangSysIndex(t: *m.Table, s: usize, tag: u32, index: usize) -> bool {
    var i: u32 = 0
    const found = findRecord(t, if s == 0 { 0 } else { s + 2 }, tag, &i)
    if index != 0 { m.put32(index, i) }
    return found
}

pub fn selectLanguage(fc: usize, tableTag: u32, scriptIndex: u32, count: u32, tags: usize, index: usize, chosen: usize) -> bool {
    var t: m.Table = undefined
    tableOf(fc, tableTag, &t)
    const s = script(&t, scriptIndex)
    var i: u32 = 0
    while i < count {
        const tag = m.get32(tags + @intCast(usize, i) * 4)
        if findLangSysIndex(&t, s, tag, index) {
            if chosen != 0 { m.put32(chosen, tag) }
            return true
        }
        i += 1
    }
    if findLangSysIndex(&t, s, TAG_DFLT_LANGUAGE, index) {
        if chosen != 0 { m.put32(chosen, TAG_DFLT_LANGUAGE) }
        return false
    }
    if index != 0 { m.put32(index, NOT_FOUND) }
    if chosen != 0 { m.put32(chosen, 0) }
    return false
}

pub fn otLayoutScriptSelectLanguage2(fc: usize, tableTag: u32, scriptIndex: u32, count: u32, tags: usize, index: usize, chosen: usize) -> i32 {
    return b(selectLanguage(fc, tableTag, scriptIndex, count, tags, index, chosen))
}

pub fn otLayoutScriptSelectLanguage(fc: usize, tableTag: u32, scriptIndex: u32, count: u32, tags: usize, index: usize) -> i32 {
    return b(selectLanguage(fc, tableTag, scriptIndex, count, tags, index, 0))
}

pub fn otLayoutScriptFindLanguage(fc: usize, tableTag: u32, scriptIndex: u32, tag: u32, index: usize) -> i32 {
    var tags: [1]u32 = [_]u32{ tag }
    return b(selectLanguage(fc, tableTag, scriptIndex, 1, @intFromPtr(&tags), index, 0))
}

pub fn requiredFeature(fc: usize, tableTag: u32, scriptIndex: u32, languageIndex: u32, index: usize, tag: usize) -> bool {
    var t: m.Table = undefined
    tableOf(fc, tableTag, &t)
    const l = langSys(&t, script(&t, scriptIndex), languageIndex)
    const i = langSysRequired(&t, l)
    if index != 0 { m.put32(index, i) }
    if tag != 0 { m.put32(tag, featureTag(&t, i)) }
    return i != NOT_FOUND
}

pub fn otLayoutLanguageGetRequiredFeature(fc: usize, tableTag: u32, scriptIndex: u32, languageIndex: u32, index: usize, tag: usize) -> i32 {
    return b(requiredFeature(fc, tableTag, scriptIndex, languageIndex, index, tag))
}

pub fn otLayoutLanguageGetRequiredFeatureIndex(fc: usize, tableTag: u32, scriptIndex: u32, languageIndex: u32, index: usize) -> i32 {
    return b(requiredFeature(fc, tableTag, scriptIndex, languageIndex, index, 0))
}

fn featureIndexes(t: *m.Table, l: usize, start: u32, count: usize, out: usize, asTags: bool) -> u32 {
    const total = langSysFeatureCount(t, l)
    if count != 0 {
        var n = m.get32(count)
        const avail = if start < total { total - start } else { 0 }
        if n > avail { n = avail }
        var i: u32 = 0
        while i < n {
            const fi = langSysFeature(t, l, start + i)
            m.put32(out + @intCast(usize, i) * 4, if asTags { featureTag(t, fi) } else { fi })
            i += 1
        }
        m.put32(count, n)
    }
    return total
}

pub fn otLayoutLanguageGetFeatureIndexes(fc: usize, tableTag: u32, scriptIndex: u32, languageIndex: u32, start: u32, count: usize, indexes: usize) -> u32 {
    var t: m.Table = undefined
    tableOf(fc, tableTag, &t)
    return featureIndexes(&t, langSys(&t, script(&t, scriptIndex), languageIndex), start, count, indexes, false)
}

pub fn otLayoutLanguageGetFeatureTags(fc: usize, tableTag: u32, scriptIndex: u32, languageIndex: u32, start: u32, count: usize, tags: usize) -> u32 {
    var t: m.Table = undefined
    tableOf(fc, tableTag, &t)
    return featureIndexes(&t, langSys(&t, script(&t, scriptIndex), languageIndex), start, count, tags, true)
}

pub fn languageFindFeature(fc: usize, tableTag: u32, scriptIndex: u32, languageIndex: u32, tag: u32, index: usize) -> bool {
    var t: m.Table = undefined
    tableOf(fc, tableTag, &t)
    const l = langSys(&t, script(&t, scriptIndex), languageIndex)
    const n = langSysFeatureCount(&t, l)
    var i: u32 = 0
    while i < n {
        const fi = langSysFeature(&t, l, i)
        if featureTag(&t, fi) == tag {
            if index != 0 { m.put32(index, fi) }
            return true
        }
        i += 1
    }
    if index != 0 { m.put32(index, NOT_FOUND) }
    return false
}

pub fn otLayoutLanguageFindFeature(fc: usize, tableTag: u32, scriptIndex: u32, languageIndex: u32, tag: u32, index: usize) -> i32 {
    return b(languageFindFeature(fc, tableTag, scriptIndex, languageIndex, tag, index))
}

pub fn featureLookups(fc: usize, tableTag: u32, featureIndex: u32, variationsIndex: u32, start: u32, count: usize, out: usize) -> u32 {
    var t: m.Table = undefined
    tableOf(fc, tableTag, &t)
    const f = featureVariation(&t, featureIndex, variationsIndex)
    const total = u16of(&t, f, 2)
    if count != 0 {
        var n = m.get32(count)
        const avail = if start < total { total - start } else { 0 }
        if n > avail { n = avail }
        var i: u32 = 0
        while i < n {
            m.put32(out + @intCast(usize, i) * 4, m.u16at(&t, f + 4 + @intCast(usize, start + i) * 2))
            i += 1
        }
        m.put32(count, n)
    }
    return total
}

pub fn otLayoutFeatureGetLookups(fc: usize, tableTag: u32, featureIndex: u32, start: u32, count: usize, out: usize) -> u32 {
    return featureLookups(fc, tableTag, featureIndex, NO_VARIATIONS, start, count, out)
}

pub fn otLayoutFeatureWithVariationsGetLookups(fc: usize, tableTag: u32, featureIndex: u32, variationsIndex: u32, start: u32, count: usize, out: usize) -> u32 {
    return featureLookups(fc, tableTag, featureIndex, variationsIndex, start, count, out)
}

pub fn otLayoutTableGetLookupCount(fc: usize, tableTag: u32) -> u32 {
    var t: m.Table = undefined
    tableOf(fc, tableTag, &t)
    return lookupCount(&t)
}

pub fn otLayoutTableFindFeatureVariations(fc: usize, tableTag: u32, coords: usize, count: u32, index: usize) -> i32 {
    var t: m.Table = undefined
    tableOf(fc, tableTag, &t)
    var i: u32 = 0
    const found = findVariationsIndex(&t, coords, count, &i)
    if index != 0 { m.put32(index, i) }
    return b(found)
}

pub fn otLayoutHasSubstitution(fc: usize) -> i32 { return b(hasData(fc, 0)) }
pub fn otLayoutHasPositioning(fc: usize) -> i32 { return b(hasData(fc, 1)) }

// The features (of all language systems of the scripts, or of the listed
// ones), as HarfBuzz collects them.
const Collect = struct {
    filter: usize
    hasFilter: bool
    out: usize
    visitedScripts: usize
    visitedLangSys: usize
    scriptCount: u32
    langSysCount: u32
    featureIndexCount: u32
}

fn collectLangSys(t: *m.Table, c: *Collect, l: usize) -> void {
    if l == 0 { return }
    if langSysRequired(t, l) == NOT_FOUND && langSysFeatureCount(t, l) == 0 { return }
    c.*.langSysCount += 1
    if c.*.langSysCount > 2001 { return }
    if set.has(c.*.visitedLangSys, @intCast(u32, l)) { return }
    set.add(c.*.visitedLangSys, @intCast(u32, l))
    const n = langSysFeatureCount(t, l)
    if !c.*.hasFilter {
        if langSysRequired(t, l) != NOT_FOUND {
            c.*.featureIndexCount += 1
            if c.*.featureIndexCount <= 1500 { set.add(c.*.out, langSysRequired(t, l)) }
        }
        c.*.featureIndexCount += n
        if c.*.featureIndexCount <= 1500 {
            var i: u32 = 0
            while i < n {
                set.add(c.*.out, langSysFeature(t, l, i))
                i += 1
            }
        }
    } else {
        if set.isEmpty(c.*.filter) { return }
        var i: u32 = 0
        while i < n {
            const fi = langSysFeature(t, l, i)
            if set.has(c.*.filter, fi) {
                set.add(c.*.out, fi)
                set.del(c.*.filter, fi)
            }
            i += 1
        }
    }
}

fn collectScript(t: *m.Table, c: *Collect, s: usize, languages: usize) -> void {
    if s == 0 { return }
    if m.u16at(t, s) == 0 && m.u16at(t, s + 2) == 0 { return }
    c.*.scriptCount += 1
    if c.*.scriptCount > 501 { return }
    if set.has(c.*.visitedScripts, @intCast(u32, s)) { return }
    set.add(c.*.visitedScripts, @intCast(u32, s))
    if languages == 0 {
        collectLangSys(t, c, sub16(t, s, 0))
        const n = m.u16at(t, s + 2)
        var i: u32 = 0
        while i < n {
            collectLangSys(t, c, langSys(t, s, i))
            i += 1
        }
    } else {
        var p = languages
        while m.get32(p) != 0 {
            var li: u32 = 0
            if findRecord(t, s + 2, m.get32(p), &li) { collectLangSys(t, c, langSys(t, s, li)) }
            p += 4
        }
    }
}

pub fn collectFeatures(fc: usize, tableTag: u32, scripts: usize, languages: usize, features: usize, out: usize) -> void {
    var t: m.Table = undefined
    tableOf(fc, tableTag, &t)
    var c: Collect = undefined
    c.out = out
    c.filter = set.create()
    c.hasFilter = features != 0
    c.visitedScripts = set.create()
    c.visitedLangSys = set.create()
    c.scriptCount = 0
    c.langSysCount = 0
    c.featureIndexCount = 0
    if features != 0 {
        const wanted = set.create()
        var p = features
        while m.get32(p) != 0 {
            set.add(wanted, m.get32(p))
            p += 4
        }
        const n = featureCount(&t)
        var i: u32 = 0
        while i < n {
            if set.has(wanted, featureTag(&t, i)) { set.add(c.filter, i) }
            i += 1
        }
        set.destroy(wanted)
    }
    if scripts == 0 {
        const n = recordCount(&t, scriptList(&t))
        var i: u32 = 0
        while i < n {
            collectScript(&t, &c, script(&t, i), languages)
            i += 1
        }
    } else {
        var p = scripts
        while m.get32(p) != 0 {
            var si: u32 = 0
            if findRecord(&t, scriptList(&t), m.get32(p), &si) { collectScript(&t, &c, script(&t, si), languages) }
            p += 4
        }
    }
    set.destroy(c.filter)
    set.destroy(c.visitedScripts)
    set.destroy(c.visitedLangSys)
}

pub fn otLayoutCollectFeatures(fc: usize, tableTag: u32, scripts: usize, languages: usize, features: usize, out: usize) -> void {
    collectFeatures(fc, tableTag, scripts, languages, features, out)
}

pub fn collectFeaturesMap(fc: usize, tableTag: u32, scriptIndex: u32, languageIndex: u32, out: usize) -> void {
    var t: m.Table = undefined
    tableOf(fc, tableTag, &t)
    const l = langSys(&t, script(&t, scriptIndex), languageIndex)
    var i = langSysFeatureCount(&t, l)
    while i > 0 {
        const fi = langSysFeature(&t, l, i - 1)
        set.mapSet(out, featureTag(&t, fi), fi)
        i -= 1
    }
}

pub fn otLayoutCollectFeaturesMap(fc: usize, tableTag: u32, scriptIndex: u32, languageIndex: u32, out: usize) -> void {
    collectFeaturesMap(fc, tableTag, scriptIndex, languageIndex, out)
}

pub fn otLayoutCollectLookups(fc: usize, tableTag: u32, scripts: usize, languages: usize, features: usize, out: usize) -> void {
    var t: m.Table = undefined
    tableOf(fc, tableTag, &t)
    const indexes = set.create()
    collectFeatures(fc, tableTag, scripts, languages, features, indexes)
    var fi = set.next(indexes, 0xFFFFFFFF)
    while fi != 0xFFFFFFFF {
        const f = feature(&t, fi)
        const n = u16of(&t, f, 2)
        var i: u32 = 0
        while i < n {
            set.add(out, m.u16at(&t, f + 4 + @intCast(usize, i) * 2))
            i += 1
        }
        fi = set.next(indexes, fi)
    }
    // The lookups of the features' substitutes in the feature variations.
    const fv = featureVariations(&t)
    if fv != 0 {
        const records = m.u32at(&t, fv + 4)
        var r: u32 = 0
        while r < records {
            const subs = sub32(&t, fv, 8 + @intCast(usize, r) * 8 + 4)
            const count = u16of(&t, subs, 4)
            var k: u32 = 0
            while k < count {
                const rec = subs + 6 + @intCast(usize, k) * 6
                if set.has(indexes, m.u16at(&t, rec)) {
                    const f = sub32(&t, subs, 6 + @intCast(usize, k) * 6 + 2)
                    const n = u16of(&t, f, 2)
                    var i: u32 = 0
                    while i < n {
                        set.add(out, m.u16at(&t, f + 4 + @intCast(usize, i) * 2))
                        i += 1
                    }
                }
                k += 1
            }
            r += 1
        }
    }
    set.destroy(indexes)
}
