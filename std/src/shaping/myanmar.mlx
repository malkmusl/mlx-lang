// The Myanmar shaper (HarfBuzz's hb-ot-shaper-myanmar.cc): syllables found
// by the Myanmar machine; in each, the base consonant found (after a
// kinzi Ra,Asat,Halant) and the characters sorted by position (kinzi
// after the base, medial Ra and left matras before it), before the basic
// features (one at a time, restricted to the syllable). The Zawgyi
// encoding gets no shaper of its own (no normalization, no reordering).
const m = @import("./memory.mlx")
const common = @import("./common.mlx")
const buffer = @import("./buffer.mlx")
const p = @import("./props.mlx")
const plan = @import("./plan.mlx")
const ragel = @import("./ragel.mlx")
const machines = @import("./machines.mlx")
const syllabic = @import("./syllabic.mlx")
const indic = @import("./indic.mlx")

const GlyphInfo = buffer.GlyphInfo

const CAT_C: u32 = 1
const CAT_IV: u32 = 2
const CAT_H: u32 = 4
const CAT_A: u32 = 9
const CAT_GB: u32 = 10
const CAT_DOTTEDCIRCLE: u32 = 11
const CAT_RA: u32 = 15
const CAT_CS: u32 = 18
const CAT_VBLW: u32 = 21
const CAT_VPRE: u32 = 22
const CAT_AS: u32 = 32
const CAT_MR: u32 = 36
const CAT_VS: u32 = 40

const CONSONANT_SYLLABLE: u32 = 0
const BROKEN_CLUSTER: u32 = 1

// Pauses of this shaper (numbers of shapers.mlx).
pub const PAUSE_SETUP_SYLLABLES: u32 = 10
pub const PAUSE_REORDER: u32 = 11

fn tag(a: u8, b: u8, c: u8, d: u8) -> u32 { return common.tag(a, b, c, d) }

fn fl(x: u32) -> u32 { return if x < 32 { @intCast(u32, 1) << @intCast(u5, x) } else { 0 } }

// C, CS, Ra, IV, GB, DOTTEDCIRCLE.
fn isConsonant(g: *GlyphInfo) -> bool {
    if p.ligated(g) { return false }
    const flags = fl(CAT_C) | fl(CAT_CS) | fl(CAT_RA) | fl(CAT_IV) | fl(CAT_GB) | fl(CAT_DOTTEDCIRCLE)
    return (fl(p.category(g)) & flags) != 0
}

pub fn collectFeatures(b: *plan.Builder) -> void {
    plan.addGsubPause(b, PAUSE_SETUP_SYLLABLES)
    plan.enableFeature(b, tag(108, 111, 99, 108), plan.F_PER_SYLLABLE, 1)
    plan.enableFeature(b, tag(99, 99, 109, 112), plan.F_PER_SYLLABLE, 1)
    plan.addGsubPause(b, PAUSE_REORDER)
    const basic = "rphfprefblwfpstf"
    var i: usize = 0
    while i < 16 {
        plan.enableFeature(b, tag(basic[i], basic[i + 1], basic[i + 2], basic[i + 3]), plan.F_MANUAL_ZWJ | plan.F_PER_SYLLABLE, 1)
        plan.addGsubPause(b, 0)
        i += 4
    }
    plan.addGsubPause(b, syllabic.PAUSE_CLEAR_SYLLABLES)
    const other = "presabvsblwspsts"
    i = 0
    while i < 16 {
        plan.enableFeature(b, tag(other[i], other[i + 1], other[i + 2], other[i + 3]), plan.F_MANUAL_ZWJ, 1)
        i += 4
    }
}

pub fn setupMasks(b: *buffer.Buffer) -> void {
    var i: u32 = 0
    while i < b.*.len {
        const g = buffer.info(b, i)
        p.setCategory(g, indic.categories(g.*.codepoint) & 0xFF)
        i += 1
    }
}

fn setupSyllables(b: *buffer.Buffer) -> void {
    var mach: ragel.Machine = undefined
    machines.myanmarMachine(&mach)
    indic.findSyllables(&mach, b)
    var start: u32 = 0
    while start < b.*.len {
        const end = p.nextSyllable(b, start)
        buffer.unsafeToBreak(b, start, end)
        start = end
    }
}

fn compareOrder(a: *GlyphInfo, c: *GlyphInfo) -> i32 {
    return @intCast(i32, p.auxiliary(a)) - @intCast(i32, p.auxiliary(c))
}

fn cat(b: *buffer.Buffer, i: u32) -> u32 { return p.category(buffer.info(b, i)) }
fn pos(b: *buffer.Buffer, i: u32) -> u32 { return p.auxiliary(buffer.info(b, i)) }
fn setPos(b: *buffer.Buffer, i: u32, v: u32) -> void { p.setAuxiliary(buffer.info(b, i), v) }

fn reorderConsonantSyllable(b: *buffer.Buffer, start: u32, end: u32) -> void {
    var base = end
    var hasReph = false
    var limit = start
    if start + 3 <= end && cat(b, start) == CAT_RA && cat(b, start + 1) == CAT_AS && cat(b, start + 2) == CAT_H {
        limit += 3
        base = start
        hasReph = true
    }
    if !hasReph { base = limit }
    var i = limit
    while i < end {
        if isConsonant(buffer.info(b, i)) {
            base = i
            break
        }
        i += 1
    }

    i = start
    const rephEnd = start + (if hasReph { @intCast(u32, 3) } else { 0 })
    while i < rephEnd {
        setPos(b, i, indic.POS_AFTER_MAIN)
        i += 1
    }
    while i < base {
        setPos(b, i, indic.POS_PRE_C)
        i += 1
    }
    if i < end {
        setPos(b, i, indic.POS_BASE_C)
        i += 1
    }
    var position = indic.POS_AFTER_MAIN
    while i < end {
        const c = cat(b, i)
        if c == CAT_MR {
            setPos(b, i, indic.POS_PRE_C)
        } else if c == CAT_VPRE {
            setPos(b, i, indic.POS_PRE_M)
        } else if c == CAT_VS {
            setPos(b, i, pos(b, i - 1))
        } else if position == indic.POS_AFTER_MAIN && c == CAT_VBLW {
            position = indic.POS_BELOW_C
            setPos(b, i, position)
        } else if position == indic.POS_BELOW_C && c == CAT_A {
            setPos(b, i, indic.POS_BEFORE_SUB)
        } else if position == indic.POS_BELOW_C && c == CAT_VBLW {
            setPos(b, i, position)
        } else if position == indic.POS_BELOW_C && c != CAT_A {
            position = indic.POS_AFTER_SUB
            setPos(b, i, position)
        } else {
            setPos(b, i, position)
        }
        i += 1
    }

    buffer.sort(b, start, end, compareOrder)

    // Left matras in reverse, VS and the like kept after theirs.
    var firstLeftMatra = end
    var lastLeftMatra = end
    i = start
    while i < end {
        if pos(b, i) == indic.POS_PRE_M {
            if firstLeftMatra == end { firstLeftMatra = i }
            lastLeftMatra = i
        }
        i += 1
    }
    if firstLeftMatra < lastLeftMatra {
        buffer.reverseRange(b, firstLeftMatra, lastLeftMatra + 1)
        var k = firstLeftMatra
        var j = k
        while j <= lastLeftMatra {
            if cat(b, j) == CAT_VPRE {
                buffer.reverseRange(b, k, j + 1)
                k = j + 1
            }
            j += 1
        }
    }
}

fn reorder(f: usize, b: *buffer.Buffer) -> bool {
    const ret = syllabic.insertDottedCircles(f, b, BROKEN_CLUSTER, CAT_DOTTEDCIRCLE, -1, -1)
    const count = b.*.len
    var start: u32 = 0
    while start < count {
        const end = p.nextSyllable(b, start)
        const t = p.syllable(buffer.info(b, start)) & 0x0F
        if t == BROKEN_CLUSTER || t == CONSONANT_SYLLABLE { reorderConsonantSyllable(b, start, end) }
        start = end
    }
    return ret
}

pub fn pause(pauseId: u32, pl: *plan.Plan, f: usize, b: *buffer.Buffer) -> bool {
    if pauseId == PAUSE_SETUP_SYLLABLES {
        setupSyllables(b)
        return false
    }
    if pauseId == PAUSE_REORDER { return reorder(f, b) }
    return false
}
