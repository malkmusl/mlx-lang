// The Universal Shaping Engine (HarfBuzz's hb-ot-shaper-use.cc) for the
// scripts of shapers.mlx's list and Indic fonts of the third version of
// the specification: syllables found by the USE machine (over the
// characters other than CGJ, and ZWNJ only when no mark follows), repha
// and pref recorded from what their features substituted, the repha moved
// to before the first post-base glyph and pre-base vowels moved to the
// start (or after a halant); topographical (joining) forms by syllable,
// or by the Arabic joining for scripts with joining data.
const m = @import("./memory.mlx")
const common = @import("./common.mlx")
const unicode = @import("./unicode.mlx")
const buffer = @import("./buffer.mlx")
const p = @import("./props.mlx")
const plan = @import("./plan.mlx")
const ragel = @import("./ragel.mlx")
const machines = @import("./machines.mlx")
const syllabic = @import("./syllabic.mlx")
const indic = @import("./indic.mlx")
const arabic = @import("./arabic.mlx")
const table = @import("./usetable.mlx")

const GlyphInfo = buffer.GlyphInfo

// Categories.
const CAT_B: u32 = 1
const CAT_CGJ: u32 = 6
const CAT_H: u32 = 12
const CAT_ZWNJ: u32 = 14
const CAT_R: u32 = 18
const CAT_VPRE: u32 = 22
const CAT_VMPRE: u32 = 23
const CAT_IS: u32 = 44
const CAT_HVM: u32 = 53

// Syllable types.
const VIRAMA_TERMINATED_CLUSTER: u32 = 0
const SAKOT_TERMINATED_CLUSTER: u32 = 1
const STANDARD_CLUSTER: u32 = 2
const NUMBER_JOINER_TERMINATED_CLUSTER: u32 = 3
const NUMERAL_CLUSTER: u32 = 4
const SYMBOL_CLUSTER: u32 = 5
const HIEROGLYPH_CLUSTER: u32 = 6
const BROKEN_CLUSTER: u32 = 7
const NON_CLUSTER: u32 = 8

// Pauses of this shaper (numbers of shapers.mlx).
pub const PAUSE_SETUP_SYLLABLES: u32 = 12
pub const PAUSE_CLEAR_SUBSTITUTION_FLAGS: u32 = 13
pub const PAUSE_RECORD_RPHF: u32 = 14
pub const PAUSE_RECORD_PREF: u32 = 15
pub const PAUSE_REORDER: u32 = 16

const JOINING_FORM_ISOL: u32 = 0
const JOINING_FORM_INIT: u32 = 1
const JOINING_FORM_MEDI: u32 = 2
const JOINING_FORM_FINA: u32 = 3
const JOINING_FORM_NONE: u32 = 4

const TOPOGRAPHICAL = "isolinitmedifina"

fn tag(a: u8, b: u8, c: u8, d: u8) -> u32 { return common.tag(a, b, c, d) }

fn topographicalTag(i: u32) -> u32 {
    const k = @intCast(usize, i) * 4
    return tag(TOPOGRAPHICAL[k], TOPOGRAPHICAL[k + 1], TOPOGRAPHICAL[k + 2], TOPOGRAPHICAL[k + 3])
}

pub const UsePlan = struct {
    rphfMask: u32
    // The Arabic shaper's plan for scripts with joining data (0: none).
    arabicPlan: usize
}

fn usePlan(address: usize) -> *UsePlan { unsafe { return @ptrFromInt(*UsePlan, address) } }

// Scripts with data in the Arabic joining table.
fn hasArabicJoining(script: u32) -> bool {
    const list = "Adlm Arab Chrs Rohg Mand Mani Mong Nkoo Ougr Phag Phlp Sogd Syrc "
    var i: usize = 0
    while i + 4 < list.length {
        if tag(list[i], list[i + 1], list[i + 2], list[i + 3]) == script { return true }
        i += 5
    }
    return false
}

pub fn collectFeatures(b: *plan.Builder) -> void {
    plan.addGsubPause(b, PAUSE_SETUP_SYLLABLES)
    plan.enableFeature(b, tag(108, 111, 99, 108), plan.F_PER_SYLLABLE, 1)
    plan.enableFeature(b, tag(99, 99, 109, 112), plan.F_PER_SYLLABLE, 1)
    plan.enableFeature(b, tag(110, 117, 107, 116), plan.F_PER_SYLLABLE, 1)
    plan.enableFeature(b, tag(97, 107, 104, 110), plan.F_MANUAL_ZWJ | plan.F_PER_SYLLABLE, 1)
    plan.addGsubPause(b, PAUSE_CLEAR_SUBSTITUTION_FLAGS)
    plan.addFeature(b, tag(114, 112, 104, 102), plan.F_MANUAL_ZWJ | plan.F_PER_SYLLABLE, 1)
    plan.addGsubPause(b, PAUSE_RECORD_RPHF)
    plan.addGsubPause(b, PAUSE_CLEAR_SUBSTITUTION_FLAGS)
    plan.enableFeature(b, tag(112, 114, 101, 102), plan.F_MANUAL_ZWJ | plan.F_PER_SYLLABLE, 1)
    plan.addGsubPause(b, PAUSE_RECORD_PREF)
    const basic = "rkrfabvfblwfhalfpstfvatucjct"
    var i: usize = 0
    while i < basic.length {
        plan.enableFeature(b, tag(basic[i], basic[i + 1], basic[i + 2], basic[i + 3]), plan.F_MANUAL_ZWJ | plan.F_PER_SYLLABLE, 1)
        i += 4
    }
    plan.addGsubPause(b, PAUSE_REORDER)
    plan.addGsubPause(b, syllabic.PAUSE_CLEAR_SYLLABLES)
    var k: u32 = 0
    while k < 4 {
        plan.addFeature(b, topographicalTag(k), plan.F_NONE, 1)
        k += 1
    }
    plan.addGsubPause(b, 0)
    const other = "abvsblwshalnprespsts"
    i = 0
    while i < other.length {
        plan.enableFeature(b, tag(other[i], other[i + 1], other[i + 2], other[i + 3]), plan.F_MANUAL_ZWJ, 1)
        i += 4
    }
}

pub fn dataCreate(pl: *plan.Plan) -> usize {
    const address = m.alloc(@sizeOf(UsePlan))
    if address == 0 { return 0 }
    const up = usePlan(address)
    up.*.rphfMask = plan.get1Mask(&pl.*.map, tag(114, 112, 104, 102))
    up.*.arabicPlan = 0
    if hasArabicJoining(pl.*.script) {
        up.*.arabicPlan = arabic.dataCreate(pl)
        if up.*.arabicPlan == 0 {
            m.release(address)
            return 0
        }
    }
    return address
}

pub fn dataDestroy(data: usize) -> void {
    const up = usePlan(data)
    if up.*.arabicPlan != 0 { arabic.dataDestroy(up.*.arabicPlan) }
    m.release(data)
}

pub fn setupMasks(pl: *plan.Plan, b: *buffer.Buffer) -> void {
    const up = usePlan(pl.*.data)
    if up.*.arabicPlan != 0 { arabic.setupMasksPlan(up.*.arabicPlan, b, pl.*.script) }
    var i: u32 = 0
    while i < b.*.len {
        const g = buffer.info(b, i)
        p.setCategory(g, table.category(g.*.codepoint))
        i += 1
    }
}

fn setupRphfMask(up: *UsePlan, b: *buffer.Buffer) -> void {
    const mask = up.*.rphfMask
    if mask == 0 { return }
    var start: u32 = 0
    while start < b.*.len {
        const end = p.nextSyllable(b, start)
        const limit = if p.category(buffer.info(b, start)) == CAT_R { @intCast(u32, 1) } else { m.minU(3, end - start) }
        var i = start
        while i < start + limit {
            buffer.info(b, i).*.mask |= mask
            i += 1
        }
        start = end
    }
}

fn setupTopographicalMasks(pl: *plan.Plan, up: *UsePlan, b: *buffer.Buffer) -> void {
    if up.*.arabicPlan != 0 { return }
    var masks: [4]u32 = undefined
    var allMasks: u32 = 0
    var k: u32 = 0
    while k < 4 {
        var mk = plan.get1Mask(&pl.*.map, topographicalTag(k))
        if mk == pl.*.map.globalMask { mk = 0 }
        masks[@intCast(usize, k)] = mk
        allMasks |= mk
        k += 1
    }
    if allMasks == 0 { return }
    const otherMasks = ~allMasks
    var lastStart: u32 = 0
    var lastForm = JOINING_FORM_NONE
    var start: u32 = 0
    while start < b.*.len {
        const end = p.nextSyllable(b, start)
        const t = p.syllable(buffer.info(b, start)) & 0x0F
        if t == HIEROGLYPH_CLUSTER || t == NON_CLUSTER {
            lastForm = JOINING_FORM_NONE
        } else if t <= BROKEN_CLUSTER {
            const join = lastForm == JOINING_FORM_FINA || lastForm == JOINING_FORM_ISOL
            if join {
                // The previous syllable joins this one.
                lastForm = if lastForm == JOINING_FORM_FINA { JOINING_FORM_MEDI } else { JOINING_FORM_INIT }
                var i = lastStart
                while i < start {
                    const g = buffer.info(b, i)
                    g.*.mask = (g.*.mask & otherMasks) | masks[@intCast(usize, lastForm)]
                    i += 1
                }
            }
            lastForm = if join { JOINING_FORM_FINA } else { JOINING_FORM_ISOL }
            var i = start
            while i < end {
                const g = buffer.info(b, i)
                g.*.mask = (g.*.mask & otherMasks) | masks[@intCast(usize, lastForm)]
                i += 1
            }
        }
        lastStart = start
        start = end
    }
}

// Whether glyph `i` is ignored by the machine (CGJ).
fn ignored(b: *buffer.Buffer, i: u32) -> bool { return p.category(buffer.info(b, i)) == CAT_CGJ }

// Finds the syllables over the glyphs other than CGJ, and ZWNJ followed
// (past CGJs) by a mark.
fn findSyllables(b: *buffer.Buffer) -> void {
    const len = b.*.len
    const cats = m.alloc(@intCast(usize, len) + 1)
    const index = m.alloc((@intCast(usize, len) + 1) * 4)
    if cats == 0 || index == 0 {
        m.release(cats)
        m.release(index)
        return
    }
    var n: u32 = 0
    var i: u32 = 0
    while i < len {
        var keep = !ignored(b, i)
        if keep && p.category(buffer.info(b, i)) == CAT_ZWNJ {
            var k = i + 1
            while k < len {
                if !ignored(b, k) {
                    keep = !p.isUnicodeMark(buffer.info(b, k))
                    break
                }
                k += 1
            }
        }
        if keep {
            m.put8(cats + @intCast(usize, n), @intCast(u8, p.category(buffer.info(b, i)) & 0xFF))
            m.put32(index + @intCast(usize, n) * 4, i)
            n += 1
        }
        i += 1
    }
    m.put32(index + @intCast(usize, n) * 4, len)
    var mach: ragel.Machine = undefined
    machines.useMachine(&mach)
    ragel.run(&mach, b, cats, index, n)
    m.release(cats)
    m.release(index)
}

fn setupSyllables(pl: *plan.Plan, b: *buffer.Buffer) -> void {
    findSyllables(b)
    var start: u32 = 0
    while start < b.*.len {
        const end = p.nextSyllable(b, start)
        buffer.unsafeToBreak(b, start, end)
        start = end
    }
    const up = usePlan(pl.*.data)
    setupRphfMask(up, b)
    setupTopographicalMasks(pl, up, b)
}

fn clearSubstitutionFlags(b: *buffer.Buffer) -> void {
    var i: u32 = 0
    while i < b.*.len {
        p.clearSubstituted(buffer.info(b, i))
        i += 1
    }
}

// A substituted repha becomes category R.
fn recordRphf(pl: *plan.Plan, b: *buffer.Buffer) -> void {
    const mask = usePlan(pl.*.data).*.rphfMask
    if mask == 0 { return }
    var start: u32 = 0
    while start < b.*.len {
        const end = p.nextSyllable(b, start)
        var i = start
        while i < end && (buffer.info(b, i).*.mask & mask) != 0 {
            if p.substituted(buffer.info(b, i)) {
                p.setCategory(buffer.info(b, i), CAT_R)
                break
            }
            i += 1
        }
        start = end
    }
}

// A substituted pref behaves as VPre.
fn recordPref(b: *buffer.Buffer) -> void {
    var start: u32 = 0
    while start < b.*.len {
        const end = p.nextSyllable(b, start)
        var i = start
        while i < end {
            if p.substituted(buffer.info(b, i)) {
                p.setCategory(buffer.info(b, i), CAT_VPRE)
                break
            }
            i += 1
        }
        start = end
    }
}

fn isHalant(g: *GlyphInfo) -> bool {
    const c = p.category(g)
    return (c == CAT_H || c == CAT_HVM || c == CAT_IS) && !p.ligated(g)
}

// FAbv FBlw FPst FMAbv FMBlw FMPst MAbv MBlw MPst MPre VAbv VBlw VPst VPre
// VMAbv VMBlw VMPst VMPre.
fn isPostBase(c: u32) -> bool {
    if c >= 64 { return false }
    const flags: u64 = (@intCast(u64, 1) << 24) | (@intCast(u64, 1) << 25) | (@intCast(u64, 1) << 26) | (@intCast(u64, 1) << 45) | (@intCast(u64, 1) << 46) | (@intCast(u64, 1) << 47) | (@intCast(u64, 1) << 27) | (@intCast(u64, 1) << 28) | (@intCast(u64, 1) << 29) | (@intCast(u64, 1) << 30) | (@intCast(u64, 1) << 33) | (@intCast(u64, 1) << 34) | (@intCast(u64, 1) << 35) | (@intCast(u64, 1) << 22) | (@intCast(u64, 1) << 37) | (@intCast(u64, 1) << 38) | (@intCast(u64, 1) << 39) | (@intCast(u64, 1) << 23)
    return ((@intCast(u64, 1) << @intCast(u6, c)) & flags) != 0
}

fn reorderSyllable(b: *buffer.Buffer, start: u32, end: u32) -> void {
    const t = p.syllable(buffer.info(b, start)) & 0x0F
    if !(t == VIRAMA_TERMINATED_CLUSTER || t == SAKOT_TERMINATED_CLUSTER || t == STANDARD_CLUSTER || t == SYMBOL_CLUSTER || t == BROKEN_CLUSTER) { return }

    // A repha moves towards the end, before the first post-base glyph.
    if p.category(buffer.info(b, start)) == CAT_R && end - start > 1 {
        var i = start + 1
        while i < end {
            const g = buffer.info(b, i)
            const postBase = isPostBase(p.category(g)) || isHalant(g)
            if postBase || i == end - 1 {
                if postBase { i -= 1 }
                buffer.mergeClusters(b, start, i + 1)
                indic.moveGlyph(b, start, i)
                break
            }
            i += 1
        }
    }

    // Pre-base vowels move to the start, or after the last halant.
    var j = start
    var i = start
    while i < end {
        const g = buffer.info(b, i)
        const c = p.category(g)
        if isHalant(g) {
            j = i + 1
        } else if (c == CAT_VPRE || c == CAT_VMPRE) && p.ligComp(g) == 0 && j < i {
            buffer.mergeClusters(b, j, i + 1)
            indic.moveGlyph(b, i, j)
        }
        i += 1
    }
}

fn reorder(f: usize, b: *buffer.Buffer) -> bool {
    const ret = syllabic.insertDottedCircles(f, b, BROKEN_CLUSTER, CAT_B, @intCast(i32, CAT_R), -1)
    var start: u32 = 0
    const count = b.*.len
    while start < count {
        const end = p.nextSyllable(b, start)
        reorderSyllable(b, start, end)
        start = end
    }
    return ret
}

pub fn pause(pauseId: u32, pl: *plan.Plan, f: usize, b: *buffer.Buffer) -> bool {
    if pauseId == PAUSE_SETUP_SYLLABLES {
        setupSyllables(pl, b)
    } else if pauseId == PAUSE_CLEAR_SUBSTITUTION_FLAGS {
        clearSubstitutionFlags(b)
    } else if pauseId == PAUSE_RECORD_RPHF {
        recordRphf(pl, b)
    } else if pauseId == PAUSE_RECORD_PREF {
        recordPref(b)
    } else if pauseId == PAUSE_REORDER {
        return reorder(f, b)
    }
    return false
}

pub fn preprocessText(b: *buffer.Buffer) -> void { syllabic.preprocessVowelConstraints(b) }

pub fn compose(u: usize, a: u32, c: u32, ab: *u32) -> bool {
    if unicode.isMark(unicode.generalCategory(u, a)) { return false }
    return unicode.compose(u, a, c, ab)
}
