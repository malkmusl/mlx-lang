// The Indic shaper (HarfBuzz's hb-ot-shaper-indic.cc) for Devanagari,
// Bengali, Gurmukhi, Gujarati, Oriya, Tamil, Telugu, Kannada and Malayalam
// with fonts of the Indic OpenType specification (old or new): syllables
// found by the Indic machine, the base consonant of each found and its
// characters reordered (pre-base matras, reph, pre-base-reordering
// consonants) before and after the basic shaping features, each feature
// restricted to the glyphs of the syllable it applies to.
//
// Uniscribe bug compatibility is not offered (as in HarfBuzz unless asked
// for by an environment variable).
const m = @import("./memory.mlx")
const common = @import("./common.mlx")
const unicode = @import("./unicode.mlx")
const font = @import("./font.mlx")
const buffer = @import("./buffer.mlx")
const p = @import("./props.mlx")
const plan = @import("./plan.mlx")
const would = @import("./would.mlx")
const ragel = @import("./ragel.mlx")
const machines = @import("./machines.mlx")
const syllabic = @import("./syllabic.mlx")
const table = @import("./indictable.mlx")

const GlyphInfo = buffer.GlyphInfo

// Categories (of the Indic machine).
pub const CAT_X: u32 = 0
pub const CAT_C: u32 = 1
pub const CAT_V: u32 = 2
pub const CAT_N: u32 = 3
pub const CAT_H: u32 = 4
pub const CAT_ZWNJ: u32 = 5
pub const CAT_ZWJ: u32 = 6
pub const CAT_M: u32 = 7
pub const CAT_SM: u32 = 8
pub const CAT_A: u32 = 9
pub const CAT_PLACEHOLDER: u32 = 10
pub const CAT_DOTTEDCIRCLE: u32 = 11
pub const CAT_RS: u32 = 12
pub const CAT_MPST: u32 = 13
pub const CAT_REPHA: u32 = 14
pub const CAT_RA: u32 = 15
pub const CAT_CM: u32 = 16
pub const CAT_SYMBOL: u32 = 17
pub const CAT_CS: u32 = 18

// Positions.
pub const POS_START: u32 = 0
pub const POS_RA_TO_BECOME_REPH: u32 = 1
pub const POS_PRE_M: u32 = 2
pub const POS_PRE_C: u32 = 3
pub const POS_BASE_C: u32 = 4
pub const POS_AFTER_MAIN: u32 = 5
pub const POS_ABOVE_C: u32 = 6
pub const POS_BEFORE_SUB: u32 = 7
pub const POS_BELOW_C: u32 = 8
pub const POS_AFTER_SUB: u32 = 9
pub const POS_BEFORE_POST: u32 = 10
pub const POS_POST_C: u32 = 11
pub const POS_AFTER_POST: u32 = 12
pub const POS_SMVD: u32 = 13
pub const POS_END: u32 = 14

// Syllable types.
const CONSONANT_SYLLABLE: u32 = 0
const VOWEL_SYLLABLE: u32 = 1
const STANDALONE_CLUSTER: u32 = 2
const SYMBOL_CLUSTER: u32 = 3
const BROKEN_CLUSTER: u32 = 4
const NON_INDIC_CLUSTER: u32 = 5

// Pauses of this shaper (numbers of shapers.mlx).
pub const PAUSE_SETUP_SYLLABLES: u32 = 4
pub const PAUSE_INITIAL_REORDERING: u32 = 5
pub const PAUSE_FINAL_REORDERING: u32 = 6

const REPH_MODE_IMPLICIT: u32 = 0
const REPH_MODE_EXPLICIT: u32 = 1
const REPH_MODE_LOG_REPHA: u32 = 2

const BLWF_MODE_PRE_AND_POST: u32 = 0
const BLWF_MODE_POST_ONLY: u32 = 1

// The features, in order: the basic ones (applied one at a time after
// the initial reordering), then the others (after the final one).
const NUKT: u32 = 0
const AKHN: u32 = 1
const RPHF: u32 = 2
const RKRF: u32 = 3
const PREF: u32 = 4
const BLWF: u32 = 5
const ABVF: u32 = 6
const HALF: u32 = 7
const PSTF: u32 = 8
const VATU: u32 = 9
const CJCT: u32 = 10
const INIT: u32 = 11
const NUM_FEATURES: u32 = 17
const BASIC_FEATURES: u32 = 11

const FEATURE_NAMES = "nuktakhnrphfrkrfprefblwfabvfhalfpstfvatucjctinitpresabvsblwspstshaln"

fn featureTag(i: u32) -> u32 {
    const k = @intCast(usize, i) * 4
    return common.tag(FEATURE_NAMES[k], FEATURE_NAMES[k + 1], FEATURE_NAMES[k + 2], FEATURE_NAMES[k + 3])
}

fn featureFlags(i: u32) -> u32 {
    if i == RPHF || i == PREF || i == BLWF || i == ABVF || i == HALF || i == PSTF || i == INIT { return plan.F_MANUAL_JOINERS | plan.F_PER_SYLLABLE }
    return plan.F_GLOBAL_MANUAL_JOINERS | plan.F_PER_SYLLABLE
}

fn tag(a: u8, b: u8, c: u8, d: u8) -> u32 { return common.tag(a, b, c, d) }

// The would-substitute features.
const WS_RPHF: usize = 0
const WS_PREF: usize = 1
const WS_BLWF: usize = 2
const WS_PSTF: usize = 3
const WS_VATU: usize = 4

pub const IndicPlan = struct {
    // The script's configuration.
    hasOldSpec: bool
    virama: u32
    rephPos: u32
    rephMode: u32
    blwfMode: u32
    isOldSpec: bool
    // The virama's glyph once looked up (0xFFFFFFFF: not yet).
    viramaGlyph: u32
    zeroContext: bool
    // The GSUB stage of each would-substitute feature.
    stages: [5]u32
    masks: [17]u32
}

fn indicPlan(pl: *plan.Plan) -> *IndicPlan { unsafe { return @ptrFromInt(*IndicPlan, pl.*.data) } }

// The category (low byte) and position (high byte) of a character.
pub fn categories(u: u32) -> u32 {
    var k: usize = 0
    while k < table.SINGLES.length {
        if table.SINGLES[k] == u { return table.SINGLES[k + 1] }
        k += 2
    }
    k = 0
    while k < table.RANGES.length {
        if u >= table.RANGES[k] && u <= table.RANGES[k + 1] {
            return @intCast(u32, table.TABLE[@intCast(usize, u - table.RANGES[k] + table.RANGES[k + 2])])
        }
        k += 3
    }
    return table.DEFAULT
}

fn flagUnsafe(x: u32) -> u32 { return if x < 32 { @intCast(u32, 1) << @intCast(u5, x) } else { 0 } }
fn fl(x: u32) -> u32 { return @intCast(u32, 1) << @intCast(u5, x) }

// C, CS, Ra, CM, V, PLACEHOLDER, DOTTEDCIRCLE (vowels and placeholders
// are treated as consonants); ZWJ, ZWNJ.
const CONSONANT_FLAGS: u32 = 0x00058C06
const JOINER_FLAGS: u32 = 0x00000060

fn isOneOf(g: *GlyphInfo, flags: u32) -> bool {
    if p.ligated(g) { return false }
    return (flagUnsafe(p.category(g)) & flags) != 0
}

fn isConsonant(g: *GlyphInfo) -> bool { return isOneOf(g, CONSONANT_FLAGS) }
fn isJoiner(g: *GlyphInfo) -> bool { return isOneOf(g, JOINER_FLAGS) }
fn isHalant(g: *GlyphInfo) -> bool { return isOneOf(g, fl(CAT_H)) }

fn at(b: *buffer.Buffer, i: u32) -> *GlyphInfo { return buffer.info(b, i) }
fn cat(b: *buffer.Buffer, i: u32) -> u32 { return p.category(buffer.info(b, i)) }
fn pos(b: *buffer.Buffer, i: u32) -> u32 { return p.auxiliary(buffer.info(b, i)) }
fn setPos(b: *buffer.Buffer, i: u32, v: u32) -> void { p.setAuxiliary(buffer.info(b, i), v) }

// Moves glyph `from` to `to`, the glyphs between shifted by one.
pub fn moveGlyph(b: *buffer.Buffer, from: u32, to: u32) -> void {
    if from == to { return }
    var t: GlyphInfo = undefined
    buffer.copyInfo(&t, at(b, from))
    if from < to {
        m.copy(b.*.info + @intCast(usize, from) * buffer.INFO_SIZE, b.*.info + @intCast(usize, from + 1) * buffer.INFO_SIZE, @intCast(usize, to - from) * buffer.INFO_SIZE)
    } else {
        m.copy(b.*.info + @intCast(usize, to + 1) * buffer.INFO_SIZE, b.*.info + @intCast(usize, to) * buffer.INFO_SIZE, @intCast(usize, from - to) * buffer.INFO_SIZE)
    }
    buffer.copyInfo(at(b, to), &t)
}

pub fn swapGlyphs(b: *buffer.Buffer, i: u32, j: u32) -> void {
    var t: GlyphInfo = undefined
    buffer.copyInfo(&t, at(b, i))
    buffer.copyInfo(at(b, i), at(b, j))
    buffer.copyInfo(at(b, j), &t)
}

// Whether a lookup of the feature's GSUB stage would substitute the
// `count` glyphs at `glyphs`.
pub fn stageWouldSubstitute(pl: *plan.Plan, stage: u32, fc: usize, glyphs: usize, count: u32, zeroContext: bool) -> bool {
    var start: u32 = 0
    var end: u32 = 0
    plan.stageLookups(&pl.*.map, 0, stage, &start, &end)
    const ls = plan.lookups(&pl.*.map, 0)
    var i = start
    while i < end {
        if would.wouldSubstitute(fc, m.get32(plan.vecAt(ls, i) + plan.LM_INDEX), glyphs, count, zeroContext) { return true }
        i += 1
    }
    return false
}

fn wouldSubstitute(pl: *plan.Plan, feature: usize, fc: usize, glyphs: usize, count: u32) -> bool {
    const ip = indicPlan(pl)
    return stageWouldSubstitute(pl, ip.*.stages[feature], fc, glyphs, count, ip.*.zeroContext)
}

// ---------------------------------------------------------------------------
// Planning

pub fn collectFeatures(b: *plan.Builder) -> void {
    plan.addGsubPause(b, PAUSE_SETUP_SYLLABLES)
    plan.enableFeature(b, tag(108, 111, 99, 108), plan.F_PER_SYLLABLE, 1)
    plan.enableFeature(b, tag(99, 99, 109, 112), plan.F_PER_SYLLABLE, 1)
    plan.addGsubPause(b, PAUSE_INITIAL_REORDERING)
    var i: u32 = 0
    while i < BASIC_FEATURES {
        plan.addFeature(b, featureTag(i), featureFlags(i), 1)
        plan.addGsubPause(b, 0)
        i += 1
    }
    plan.addGsubPause(b, PAUSE_FINAL_REORDERING)
    while i < NUM_FEATURES {
        plan.addFeature(b, featureTag(i), featureFlags(i), 1)
        i += 1
    }
}

pub fn overrideFeatures(b: *plan.Builder) -> void {
    plan.disableFeature(b, tag(108, 105, 103, 97))
    plan.addGsubPause(b, syllabic.PAUSE_CLEAR_SYLLABLES)
}

pub fn dataCreate(pl: *plan.Plan) -> usize {
    const address = m.alloc(@sizeOf(IndicPlan))
    if address == 0 { return 0 }
    const ip = indicPlan2(address)
    const s = pl.*.script
    ip.*.hasOldSpec = true
    ip.*.rephMode = REPH_MODE_IMPLICIT
    ip.*.blwfMode = BLWF_MODE_PRE_AND_POST
    ip.*.rephPos = POS_BEFORE_POST
    if s == common.SCRIPT_DEVANAGARI {
        ip.*.virama = 0x094D
    } else if s == common.SCRIPT_BENGALI {
        ip.*.virama = 0x09CD
        ip.*.rephPos = POS_AFTER_SUB
    } else if s == common.SCRIPT_GURMUKHI {
        ip.*.virama = 0x0A4D
        ip.*.rephPos = POS_BEFORE_SUB
    } else if s == common.SCRIPT_GUJARATI {
        ip.*.virama = 0x0ACD
    } else if s == common.SCRIPT_ORIYA {
        ip.*.virama = 0x0B4D
        ip.*.rephPos = POS_AFTER_MAIN
    } else if s == common.SCRIPT_TAMIL {
        ip.*.virama = 0x0BCD
        ip.*.rephPos = POS_AFTER_POST
    } else if s == common.SCRIPT_TELUGU {
        ip.*.virama = 0x0C4D
        ip.*.rephPos = POS_AFTER_POST
        ip.*.rephMode = REPH_MODE_EXPLICIT
        ip.*.blwfMode = BLWF_MODE_POST_ONLY
    } else if s == common.SCRIPT_KANNADA {
        ip.*.virama = 0x0CCD
        ip.*.rephPos = POS_AFTER_POST
        ip.*.blwfMode = BLWF_MODE_POST_ONLY
    } else if s == common.SCRIPT_MALAYALAM {
        ip.*.virama = 0x0D4D
        ip.*.rephPos = POS_AFTER_MAIN
        ip.*.rephMode = REPH_MODE_LOG_REPHA
    } else {
        ip.*.hasOldSpec = false
        ip.*.virama = 0
    }
    ip.*.isOldSpec = ip.*.hasOldSpec && (pl.*.map.chosenScript0 & 0xFF) != 0x32
    ip.*.viramaGlyph = 0xFFFFFFFF
    ip.*.zeroContext = !ip.*.isOldSpec && s != common.SCRIPT_MALAYALAM
    ip.*.stages[WS_RPHF] = plan.getFeatureStage(&pl.*.map, 0, tag(114, 112, 104, 102))
    ip.*.stages[WS_PREF] = plan.getFeatureStage(&pl.*.map, 0, tag(112, 114, 101, 102))
    ip.*.stages[WS_BLWF] = plan.getFeatureStage(&pl.*.map, 0, tag(98, 108, 119, 102))
    ip.*.stages[WS_PSTF] = plan.getFeatureStage(&pl.*.map, 0, tag(112, 115, 116, 102))
    ip.*.stages[WS_VATU] = plan.getFeatureStage(&pl.*.map, 0, tag(118, 97, 116, 117))
    var i: u32 = 0
    while i < NUM_FEATURES {
        ip.*.masks[@intCast(usize, i)] = if (featureFlags(i) & plan.F_GLOBAL) != 0 { 0 } else { plan.get1Mask(&pl.*.map, featureTag(i)) }
        i += 1
    }
    return address
}

fn indicPlan2(address: usize) -> *IndicPlan { unsafe { return @ptrFromInt(*IndicPlan, address) } }

fn mask(ip: *IndicPlan, feature: u32) -> u32 { return ip.*.masks[@intCast(usize, feature)] }

fn loadViramaGlyph(ip: *IndicPlan, f: usize) -> u32 {
    if ip.*.viramaGlyph == 0xFFFFFFFF {
        var glyph: u32 = 0
        if ip.*.virama == 0 || !font.getNominalGlyph(f, ip.*.virama, &glyph) { glyph = 0 }
        ip.*.viramaGlyph = glyph
    }
    return ip.*.viramaGlyph
}

// ---------------------------------------------------------------------------
// Masks and syllables

pub fn setupMasks(b: *buffer.Buffer) -> void {
    var i: u32 = 0
    while i < b.*.len {
        const g = at(b, i)
        const t = categories(g.*.codepoint)
        p.setCategory(g, t & 0xFF)
        p.setAuxiliary(g, t >> 8)
        i += 1
    }
}

// Numbers the syllables of the machine `mach` over the glyphs' categories.
pub fn findSyllables(mach: *ragel.Machine, b: *buffer.Buffer) -> void {
    const n = b.*.len
    const cats = m.alloc(@intCast(usize, n) + 1)
    if cats == 0 { return }
    var i: u32 = 0
    while i < n {
        m.put8(cats + @intCast(usize, i), @intCast(u8, p.category(at(b, i)) & 0xFF))
        i += 1
    }
    ragel.run(mach, b, cats, 0, n)
    m.release(cats)
}

fn setupSyllables(b: *buffer.Buffer) -> void {
    var mach: ragel.Machine = undefined
    machines.indicMachine(&mach)
    findSyllables(&mach, b)
    var start: u32 = 0
    while start < b.*.len {
        const end = p.nextSyllable(b, start)
        buffer.unsafeToBreak(b, start, end)
        start = end
    }
}

fn compareOrder(a: *GlyphInfo, c: *GlyphInfo) -> i32 {
    return @intCast(i32, p.auxiliary(a)) - @intCast(i32, p.auxiliary(c))
}

// ---------------------------------------------------------------------------
// The initial reordering

fn consonantPositionFromFace(pl: *plan.Plan, consonant: u32, virama: u32, fc: usize, glyphs: usize) -> u32 {
    m.put32(glyphs, virama)
    m.put32(glyphs + 4, consonant)
    m.put32(glyphs + 8, virama)
    if wouldSubstitute(pl, WS_BLWF, fc, glyphs, 2) || wouldSubstitute(pl, WS_BLWF, fc, glyphs + 4, 2) || wouldSubstitute(pl, WS_VATU, fc, glyphs, 2) || wouldSubstitute(pl, WS_VATU, fc, glyphs + 4, 2) { return POS_BELOW_C }
    if wouldSubstitute(pl, WS_PSTF, fc, glyphs, 2) || wouldSubstitute(pl, WS_PSTF, fc, glyphs + 4, 2) { return POS_POST_C }
    if wouldSubstitute(pl, WS_PREF, fc, glyphs, 2) || wouldSubstitute(pl, WS_PREF, fc, glyphs + 4, 2) { return POS_POST_C }
    return POS_BASE_C
}

fn updateConsonantPositions(pl: *plan.Plan, f: usize, b: *buffer.Buffer) -> void {
    const ip = indicPlan(pl)
    const virama = loadViramaGlyph(ip, f)
    if virama == 0 { return }
    const fc = font.font(f).*.face
    var glyphs: [3]u32 = undefined
    const ga = @intFromPtr(&glyphs)
    var i: u32 = 0
    while i < b.*.len {
        if pos(b, i) == POS_BASE_C {
            setPos(b, i, consonantPositionFromFace(pl, at(b, i).*.codepoint, virama, fc, ga))
        }
        i += 1
    }
}

fn initialReorderingConsonantSyllable(pl: *plan.Plan, fc: usize, b: *buffer.Buffer, start: u32, end: u32) -> void {
    const ip = indicPlan(pl)
    var glyphs: [3]u32 = undefined
    const ga = @intFromPtr(&glyphs)

    // Kannada's Ra,H,ZWJ behaves like Ra,ZWJ,H.
    if b.*.script == common.SCRIPT_KANNADA && start + 3 <= end && isOneOf(at(b, start), fl(CAT_RA)) && isOneOf(at(b, start + 1), fl(CAT_H)) && isOneOf(at(b, start + 2), fl(CAT_ZWJ)) {
        buffer.mergeClusters(b, start + 1, start + 3)
        swapGlyphs(b, start + 1, start + 2)
    }

    // 1. The base consonant: from the end of the syllable backwards, the
    // first consonant without a below-base or post-base form, or the
    // first consonant. A starting Ra,H (if it forms a reph) is excluded.
    var base = end
    var hasReph = false
    var limit = start
    if mask(ip, RPHF) != 0 && start + 3 <= end && ((ip.*.rephMode == REPH_MODE_IMPLICIT && !isJoiner(at(b, start + 2))) || (ip.*.rephMode == REPH_MODE_EXPLICIT && cat(b, start + 2) == CAT_ZWJ)) {
        m.put32(ga, at(b, start).*.codepoint)
        m.put32(ga + 4, at(b, start + 1).*.codepoint)
        m.put32(ga + 8, if ip.*.rephMode == REPH_MODE_EXPLICIT { at(b, start + 2).*.codepoint } else { 0 })
        if wouldSubstitute(pl, WS_RPHF, fc, ga, 2) || (ip.*.rephMode == REPH_MODE_EXPLICIT && wouldSubstitute(pl, WS_RPHF, fc, ga, 3)) {
            limit += 2
            while limit < end && isJoiner(at(b, limit)) { limit += 1 }
            base = start
            hasReph = true
        }
    } else if ip.*.rephMode == REPH_MODE_LOG_REPHA && cat(b, start) == CAT_REPHA {
        limit += 1
        while limit < end && isJoiner(at(b, limit)) { limit += 1 }
        base = start
        hasReph = true
    }
    var i = end
    var seenBelow = false
    while true {
        i -= 1
        if isConsonant(at(b, i)) {
            if pos(b, i) != POS_BELOW_C && (pos(b, i) != POS_POST_C || seenBelow) {
                base = i
                break
            }
            if pos(b, i) == POS_BELOW_C { seenBelow = true }
            base = i
        } else {
            // A ZWJ after a halant stops the search (an explicit half
            // form); one before a halant asks for a subjoined form.
            if start < i && cat(b, i) == CAT_ZWJ && cat(b, i - 1) == CAT_H { break }
        }
        if i <= limit { break }
    }
    // Without another consonant there is no reph: Ra is the base.
    if hasReph && base == start && limit - base <= 2 { hasReph = false }

    // 2. and 3. (decomposing matras, ordering nuktas and halants) the
    // normalizer did. Now the positions:
    i = start
    while i < base {
        setPos(b, i, m.minU(POS_PRE_C, pos(b, i)))
        i += 1
    }
    if base < end { setPos(b, base, POS_BASE_C) }
    if hasReph { setPos(b, start, POS_RA_TO_BECOME_REPH) }

    // For old-spec script tags, the first post-base halant moves after the
    // last consonant (not in Kannada when one is there already).
    if ip.*.isOldSpec {
        const disallowDoubleHalants = b.*.script == common.SCRIPT_KANNADA
        i = base + 1
        while i < end {
            if cat(b, i) == CAT_H {
                var j = end - 1
                while j > i {
                    if isConsonant(at(b, j)) || (disallowDoubleHalants && cat(b, j) == CAT_H) { break }
                    j -= 1
                }
                if cat(b, j) != CAT_H && j > i { moveGlyph(b, i, j) }
                break
            }
            i += 1
        }
    }

    // Marks attach to the character before them, to move with it.
    var lastPos = POS_START
    i = start
    while i < end {
        if (flagUnsafe(cat(b, i)) & (JOINER_FLAGS | fl(CAT_N) | fl(CAT_RS) | fl(CAT_CM) | fl(CAT_H))) != 0 {
            setPos(b, i, lastPos)
            if cat(b, i) == CAT_H && pos(b, i) == POS_PRE_M {
                // The halant does not move with a left matra.
                var j = i
                while j > start {
                    if pos(b, j - 1) != POS_PRE_M {
                        setPos(b, i, pos(b, j - 1))
                        break
                    }
                    j -= 1
                }
            }
        } else if pos(b, i) != POS_SMVD {
            if cat(b, i) == CAT_MPST && i > start && cat(b, i - 1) == CAT_SM { setPos(b, i - 1, pos(b, i)) }
            lastPos = pos(b, i)
        }
        i += 1
    }

    // Post-base consonants own what is before them since the last
    // consonant or matra.
    var last = base
    i = base + 1
    while i < end {
        if isConsonant(at(b, i)) {
            var j = last + 1
            while j < i {
                if pos(b, j) < POS_SMVD { setPos(b, j, pos(b, i)) }
                j += 1
            }
            last = i
        } else if (flagUnsafe(cat(b, i)) & (fl(CAT_M) | fl(CAT_MPST))) != 0 {
            last = i
        }
        i += 1
    }

    // Sort by position, the syllable byte holding the original indexes.
    const syllable = p.syllable(at(b, start))
    i = start
    while i < end {
        p.setSyllable(at(b, i), i - start)
        i += 1
    }
    buffer.stableSort(b, start, end, compareOrder)
    // The base again; left matras in reverse.
    var firstLeftMatra = end
    var lastLeftMatra = end
    base = end
    i = start
    while i < end {
        if pos(b, i) == POS_BASE_C {
            base = i
            break
        } else if pos(b, i) == POS_PRE_M {
            if firstLeftMatra == end { firstLeftMatra = i }
            lastLeftMatra = i
        }
        i += 1
    }
    if firstLeftMatra < lastLeftMatra {
        buffer.reverseRange(b, firstLeftMatra, lastLeftMatra + 1)
        // Nuktas and the like back in order.
        var k = firstLeftMatra
        var j = k
        while j <= lastLeftMatra {
            if (flagUnsafe(cat(b, j)) & (fl(CAT_M) | fl(CAT_MPST))) != 0 {
                buffer.reverseRange(b, k, j + 1)
                k = j + 1
            }
            j += 1
        }
    }
    // Clusters of what moved after the base merge (all of them for the
    // old specification).
    if ip.*.isOldSpec || end - start > 127 {
        buffer.mergeClusters(b, base, end)
    } else {
        i = base
        while i < end {
            if p.syllable(at(b, i)) != 255 {
                var lo = i
                var hi = i
                var j = start + p.syllable(at(b, i))
                while j != i {
                    lo = m.minU(lo, j)
                    hi = m.maxU(hi, j)
                    const next = start + p.syllable(at(b, j))
                    p.setSyllable(at(b, j), 255)
                    j = next
                }
                buffer.mergeClusters(b, m.maxU(base, lo), hi + 1)
            }
            i += 1
        }
    }
    i = start
    while i < end {
        p.setSyllable(at(b, i), syllable)
        i += 1
    }

    // The masks.
    i = start
    while i < end && pos(b, i) == POS_RA_TO_BECOME_REPH {
        at(b, i).*.mask |= mask(ip, RPHF)
        i += 1
    }
    var preMask = mask(ip, HALF)
    if !ip.*.isOldSpec && ip.*.blwfMode == BLWF_MODE_PRE_AND_POST { preMask |= mask(ip, BLWF) }
    i = start
    while i < base {
        at(b, i).*.mask |= preMask
        i += 1
    }
    const postMask = mask(ip, BLWF) | mask(ip, ABVF) | mask(ip, PSTF)
    i = base + 1
    while i < end {
        at(b, i).*.mask |= postMask
        i += 1
    }

    // Old-spec Devanagari's eyelash Ra (Ra,H not followed by ZWJ below
    // half forms) takes blwf.
    if ip.*.isOldSpec && b.*.script == common.SCRIPT_DEVANAGARI {
        i = start
        while i + 1 < base {
            if cat(b, i) == CAT_RA && cat(b, i + 1) == CAT_H && (i + 2 == base || cat(b, i + 2) != CAT_ZWJ) {
                at(b, i).*.mask |= mask(ip, BLWF)
                at(b, i + 1).*.mask |= mask(ip, BLWF)
            }
            i += 1
        }
    }

    // A Halant,Ra sequence that pref would substitute gets pref.
    const prefLen: u32 = 2
    if mask(ip, PREF) != 0 && base + prefLen < end {
        i = base + 1
        while i + prefLen - 1 < end {
            m.put32(ga, at(b, i).*.codepoint)
            m.put32(ga + 4, at(b, i + 1).*.codepoint)
            if wouldSubstitute(pl, WS_PREF, fc, ga, prefLen) {
                at(b, i).*.mask |= mask(ip, PREF)
                at(b, i + 1).*.mask |= mask(ip, PREF)
                break
            }
            i += 1
        }
    }

    // A ZWNJ disables half forms before it.
    i = start + 1
    while i < end {
        if isJoiner(at(b, i)) {
            const nonJoiner = cat(b, i) == CAT_ZWNJ
            var j = i
            while true {
                j -= 1
                if nonJoiner { at(b, j).*.mask &= ~mask(ip, HALF) }
                if !(j > start && !isConsonant(at(b, j))) { break }
            }
        }
        i += 1
    }
}

fn initialReorderingSyllable(pl: *plan.Plan, fc: usize, b: *buffer.Buffer, start: u32, end: u32) -> void {
    const t = p.syllable(at(b, start)) & 0x0F
    if t == VOWEL_SYLLABLE || t == CONSONANT_SYLLABLE || t == BROKEN_CLUSTER || t == STANDALONE_CLUSTER {
        initialReorderingConsonantSyllable(pl, fc, b, start, end)
    }
}

fn initialReordering(pl: *plan.Plan, f: usize, b: *buffer.Buffer) -> bool {
    updateConsonantPositions(pl, f, b)
    const ret = syllabic.insertDottedCircles(f, b, BROKEN_CLUSTER, CAT_DOTTEDCIRCLE, @intCast(i32, CAT_REPHA), @intCast(i32, POS_END))
    const fc = font.font(f).*.face
    const count = b.*.len
    var start: u32 = 0
    while start < count {
        const end = p.nextSyllable(b, start)
        initialReorderingSyllable(pl, fc, b, start, end)
        start = end
    }
    return ret
}

// ---------------------------------------------------------------------------
// The final reordering

fn finalReorderingSyllable(pl: *plan.Plan, b: *buffer.Buffer, start: u32, end: u32) -> void {
    const ip = indicPlan(pl)
    const script = b.*.script

    // A virama that ligated and multiplied is a halant again.
    const viramaGlyph = ip.*.viramaGlyph
    if viramaGlyph != 0 && viramaGlyph != 0xFFFFFFFF {
        var k = start
        while k < end {
            const g = at(b, k)
            if g.*.codepoint == viramaGlyph && p.ligated(g) && p.multiplied(g) {
                p.setCategory(g, CAT_H)
                p.clearLigatedAndMultiplied(g)
            }
            k += 1
        }
    }

    // 4. The base again.
    var tryPref = mask(ip, PREF) != 0
    var base = start
    while base < end {
        if pos(b, base) >= POS_BASE_C {
            if tryPref && base + 1 < end {
                var i = base + 1
                while i < end {
                    if (at(b, i).*.mask & mask(ip, PREF)) != 0 {
                        if !(p.substituted(at(b, i)) && p.ligatedAndDidntMultiply(at(b, i))) {
                            // A pref candidate that formed nothing: the
                            // base is around here.
                            base = i
                            while base < end && isHalant(at(b, base)) { base += 1 }
                            if base < end { setPos(b, base, POS_BASE_C) }
                            tryPref = false
                        }
                        break
                    }
                    i += 1
                }
                if base == end { break }
            }
            // Malayalam skips unformed below (not post) forms.
            if script == common.SCRIPT_MALAYALAM {
                var i = base + 1
                while i < end {
                    while i < end && isJoiner(at(b, i)) { i += 1 }
                    if i == end || !isHalant(at(b, i)) { break }
                    i += 1
                    while i < end && isJoiner(at(b, i)) { i += 1 }
                    if i < end && isConsonant(at(b, i)) && pos(b, i) == POS_BELOW_C {
                        base = i
                        setPos(b, base, POS_BASE_C)
                    }
                    i += 1
                }
            }
            if start < base && pos(b, base) > POS_BASE_C { base -= 1 }
            break
        }
        base += 1
    }
    if base == end && start < base && isOneOf(at(b, base - 1), fl(CAT_ZWJ)) { base -= 1 }
    if base < end {
        while start < base && isOneOf(at(b, base), fl(CAT_N) | fl(CAT_H)) { base -= 1 }
    }

    // Pre-base matras move to after the last standalone halant before
    // the base (not past a halant followed by ZWJ).
    if start + 1 < end && start < base {
        var newPos = if base == end { base - 2 } else { base - 1 }
        if script != common.SCRIPT_MALAYALAM && script != common.SCRIPT_TAMIL {
            while true {
                while newPos > start && !isOneOf(at(b, newPos), fl(CAT_M) | fl(CAT_MPST) | fl(CAT_H)) { newPos -= 1 }
                if isHalant(at(b, newPos)) && pos(b, newPos) != POS_PRE_M {
                    if newPos + 1 < end && cat(b, newPos + 1) == CAT_ZWJ && newPos > start {
                        newPos -= 1
                        continue
                    }
                } else {
                    newPos = start
                }
                break
            }
        }
        if start < newPos && pos(b, newPos) != POS_PRE_M {
            var i = newPos
            while i > start {
                if pos(b, i - 1) == POS_PRE_M {
                    const oldPos = i - 1
                    if oldPos < base && base <= newPos { base -= 1 }
                    moveGlyph(b, oldPos, newPos)
                    buffer.mergeClusters(b, newPos, m.minU(end, base + 1))
                    newPos -= 1
                }
                i -= 1
            }
        } else {
            var i = start
            while i < base {
                if pos(b, i) == POS_PRE_M {
                    buffer.mergeClusters(b, i, m.minU(end, base + 1))
                    break
                }
                i += 1
            }
        }
    }

    // The reph moves: a reph of characters only if they ligated, an
    // encoded repha only if it did not.
    if start + 1 < end && pos(b, start) == POS_RA_TO_BECOME_REPH && ((cat(b, start) == CAT_REPHA) != p.ligatedAndDidntMultiply(at(b, start))) {
        const rephPos = ip.*.rephPos
        var newRephPos: u32 = 0
        var found = false
        if rephPos != POS_AFTER_POST {
            // 2. After the first explicit halant between the first
            // post-reph consonant and the main one.
            newRephPos = start + 1
            while newRephPos < base && !isHalant(at(b, newRephPos)) { newRephPos += 1 }
            if newRephPos < base && isHalant(at(b, newRephPos)) {
                if newRephPos + 1 < base && isJoiner(at(b, newRephPos + 1)) { newRephPos += 1 }
                found = true
            }
            // 3. After the main consonant.
            if !found && rephPos == POS_AFTER_MAIN {
                newRephPos = base
                while newRephPos + 1 < end && pos(b, newRephPos + 1) <= POS_AFTER_MAIN { newRephPos += 1 }
                if newRephPos < end { found = true }
            }
            // 4. Before the post-base consonants.
            if !found && rephPos == POS_AFTER_SUB {
                newRephPos = base
                while newRephPos + 1 < end && (flagUnsafe(pos(b, newRephPos + 1)) & (fl(POS_POST_C) | fl(POS_AFTER_POST) | fl(POS_SMVD))) == 0 { newRephPos += 1 }
                if newRephPos < end { found = true }
            }
        }
        // 5. As in 2.
        if !found {
            newRephPos = start + 1
            while newRephPos < base && !isHalant(at(b, newRephPos)) { newRephPos += 1 }
            if newRephPos < base && isHalant(at(b, newRephPos)) {
                if newRephPos + 1 < base && isJoiner(at(b, newRephPos + 1)) { newRephPos += 1 }
                found = true
            }
        }
        // 6. The end of the syllable (before a halant after a matra).
        if !found {
            newRephPos = end - 1
            while newRephPos > start && pos(b, newRephPos) == POS_SMVD { newRephPos -= 1 }
            if isHalant(at(b, newRephPos)) {
                var i = base + 1
                while i < newRephPos {
                    if (flagUnsafe(cat(b, i)) & (fl(CAT_M) | fl(CAT_MPST))) != 0 { newRephPos -= 1 }
                    i += 1
                }
            }
        }
        buffer.mergeClusters(b, start, newRephPos + 1)
        moveGlyph(b, start, newRephPos)
        if start < base && base <= newRephPos { base -= 1 }
    }

    // A pre-base-reordering consonant that formed moves before the base.
    if tryPref && base + 1 < end {
        var i = base + 1
        while i < end {
            if (at(b, i).*.mask & mask(ip, PREF)) != 0 {
                if p.ligatedAndDidntMultiply(at(b, i)) {
                    var newPos = base
                    if script != common.SCRIPT_MALAYALAM && script != common.SCRIPT_TAMIL {
                        while newPos > start && !isOneOf(at(b, newPos - 1), fl(CAT_M) | fl(CAT_MPST) | fl(CAT_H)) { newPos -= 1 }
                    }
                    if newPos > start && isHalant(at(b, newPos - 1)) {
                        if newPos < end && isJoiner(at(b, newPos)) { newPos += 1 }
                    }
                    const oldPos = i
                    buffer.mergeClusters(b, newPos, oldPos + 1)
                    moveGlyph(b, oldPos, newPos)
                    if newPos <= base && base < oldPos { base += 1 }
                }
                break
            }
            i += 1
        }
    }

    // init for a left matra at a word start.
    if pos(b, start) == POS_PRE_M {
        const formatToMark: u32 = 0x1FFE
        if start == 0 || (flagUnsafe(p.generalCategory(at(b, start - 1))) & formatToMark) == 0 {
            at(b, start).*.mask |= mask(ip, INIT)
        } else {
            buffer.unsafeToBreak(b, start - 1, start + 1)
        }
    }
}

fn finalReordering(pl: *plan.Plan, b: *buffer.Buffer) -> bool {
    const count = b.*.len
    if count == 0 { return false }
    var start: u32 = 0
    while start < count {
        const end = p.nextSyllable(b, start)
        finalReorderingSyllable(pl, b, start, end)
        start = end
    }
    return false
}

// Runs one of this shaper's pauses; whether glyphs were added.
pub fn pause(pauseId: u32, pl: *plan.Plan, f: usize, b: *buffer.Buffer) -> bool {
    if pauseId == PAUSE_SETUP_SYLLABLES {
        setupSyllables(b)
        return false
    }
    if pauseId == PAUSE_INITIAL_REORDERING { return initialReordering(pl, f, b) }
    if pauseId == PAUSE_FINAL_REORDERING { return finalReordering(pl, b) }
    return false
}

pub fn preprocessText(b: *buffer.Buffer) -> void { syllabic.preprocessVowelConstraints(b) }

pub fn decompose(u: usize, ab: u32, a: *u32, c: *u32) -> bool {
    if ab == 0x0931 || ab == 0x09DC || ab == 0x09DD || ab == 0x0B94 { return false }
    return unicode.decompose(u, ab, a, c)
}

pub fn compose(u: usize, a: u32, c: u32, ab: *u32) -> bool {
    if unicode.isMark(unicode.generalCategory(u, a)) { return false }
    if a == 0x09AF && c == 0x09BC {
        ab.* = 0x09DF
        return true
    }
    return unicode.compose(u, a, c, ab)
}
