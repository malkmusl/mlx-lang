// Buffers as text and JSON, and back (HarfBuzz's hb-buffer-serialize.cc):
// glyphs as `[name=cluster@dx,dy+advance#flags<extents>|...]`, characters as
// `<U+0041=0|...>`.
const m = @import("./memory.mlx")
const o = @import("./object.mlx")
const common = @import("./common.mlx")
const bufm = @import("./buffer.mlx")
const font = @import("./font.mlx")

pub const FORMAT_TEXT: u32 = 0x54455854
pub const FORMAT_JSON: u32 = 0x4A534F4E

const NO_CLUSTERS: u32 = 1
const NO_POSITIONS: u32 = 2
const NO_GLYPH_NAMES: u32 = 4
const GLYPH_EXTENTS: u32 = 8
const GLYPH_FLAGS: u32 = 16
const NO_ADVANCES: u32 = 32

var formatList: [3]usize = undefined
var formatListReady: u32 = 0

pub fn bufferSerializeListFormats() -> usize {
    if m.atomicLoad32(@intFromPtr(&formatListReady)) == 0 {
        formatList[0] = m.literal("text")
        formatList[1] = m.literal("json")
        formatList[2] = 0
        m.atomicStore32(@intFromPtr(&formatListReady), 1)
    }
    return @intFromPtr(&formatList)
}

pub fn bufferSerializeFormatFromString(str: usize, len: i32) -> u32 { return common.tagFromString(str, @intCast(i64, len)) & ~@intCast(u32, 0x20202020) }

pub fn bufferSerializeFormatToString(format: u32) -> usize {
    if format == FORMAT_TEXT { return m.literal("text") }
    if format == FORMAT_JSON { return m.literal("json") }
    return 0
}

fn putChar(p: *usize, c: u8) -> void {
    m.put8(p.*, c)
    p.* += 1
}

fn putText(p: *usize, text: []const u8) -> void {
    var i: usize = 0
    while i < text.length {
        m.put8(p.* + i, text[i])
        i += 1
    }
    p.* += text.length
}

fn putUint(p: *usize, v: u32) -> void { p.* += common.writeDecimal(p.*, @intCast(u64, v)) }
fn putInt(p: *usize, v: i32) -> void { p.* += common.writeSigned(p.*, @intCast(i64, v)) }

fn putHex(p: *usize, v: u32, minDigits: usize) -> void {
    var digits: [8]u8 = undefined
    var n: usize = 0
    var x = v
    while x != 0 || n < minDigits {
        const d = x & 15
        digits[n] = @intCast(u8, if d < 10 { 48 + d } else { 55 + d })
        n += 1
        x = x >> 4
        if n == 8 { break }
    }
    while n > 0 {
        n -= 1
        putChar(p, digits[n])
    }
}

// Copies an item made in `item` to the output when it fits; whether it did.
fn emit(item: usize, length: usize, out: *usize, size: *u32, consumed: usize) -> bool {
    if @intCast(usize, size.*) <= length { return false }
    m.copy(out.*, item, length)
    out.* += length
    size.* -= @intCast(u32, length)
    m.put32(consumed, m.get32(consumed) + @intCast(u32, length))
    m.put8(out.*, 0)
    return true
}

fn serializeGlyphs(address: usize, start: u32, end: u32, out_: usize, size_: u32, consumed: usize, f: usize, format: u32, flags: u32) -> u32 {
    const b = bufm.buf(address)
    var out = out_
    var size = size_
    var x: i32 = 0
    var y: i32 = 0
    var item: [1024]u8 = undefined
    const base = @intFromPtr(&item)
    var i = start
    while i < end {
        var p = base
        const g = bufm.info(b, i)
        const json = format == FORMAT_JSON
        if json {
            putChar(&p, if i != 0 { ',' } else { '[' })
            putChar(&p, '{')
            putText(&p, "\"g\":")
        } else {
            putChar(&p, if i != 0 { '|' } else { '[' })
        }
        if (flags & NO_GLYPH_NAMES) == 0 {
            var name: [128]u8 = undefined
            const nb = @intFromPtr(&name)
            font.glyphToString(f, g.*.codepoint, nb, 128)
            if json { putChar(&p, '"') }
            var k: usize = 0
            while m.get8(nb + k) != 0 {
                const c = m.get8(nb + k)
                if json && (c == '"' || c == '\\') { putChar(&p, '\\') }
                putChar(&p, c)
                k += 1
            }
            if json { putChar(&p, '"') }
        } else {
            putUint(&p, g.*.codepoint)
        }
        if (flags & NO_CLUSTERS) == 0 {
            if json { putText(&p, ",\"cl\":") } else { putChar(&p, '=') }
            putUint(&p, g.*.cluster)
        }
        if (flags & NO_POSITIONS) == 0 {
            const ps = bufm.pos(b, i)
            const dx = x +% ps.*.xOffset
            const dy = y +% ps.*.yOffset
            if json {
                putText(&p, ",\"dx\":")
                putInt(&p, dx)
                putText(&p, ",\"dy\":")
                putInt(&p, dy)
                if (flags & NO_ADVANCES) == 0 {
                    putText(&p, ",\"ax\":")
                    putInt(&p, ps.*.xAdvance)
                    putText(&p, ",\"ay\":")
                    putInt(&p, ps.*.yAdvance)
                }
            } else {
                if dx != 0 || dy != 0 {
                    putChar(&p, '@')
                    putInt(&p, dx)
                    putChar(&p, ',')
                    putInt(&p, dy)
                }
                if (flags & NO_ADVANCES) == 0 {
                    putChar(&p, '+')
                    putInt(&p, ps.*.xAdvance)
                    if ps.*.yAdvance != 0 {
                        putChar(&p, ',')
                        putInt(&p, ps.*.yAdvance)
                    }
                }
            }
        }
        if (flags & GLYPH_FLAGS) != 0 && (g.*.mask & bufm.GLYPH_FLAG_DEFINED) != 0 {
            if json {
                putText(&p, ",\"fl\":")
                putUint(&p, g.*.mask & bufm.GLYPH_FLAG_DEFINED)
            } else {
                putChar(&p, '#')
                putHex(&p, g.*.mask & bufm.GLYPH_FLAG_DEFINED, 1)
            }
        }
        if (flags & GLYPH_EXTENTS) != 0 {
            var e: [4]i32 = undefined
            _ = font.getGlyphExtents(f, g.*.codepoint, @intFromPtr(&e))
            if json {
                putText(&p, ",\"xb\":")
                putInt(&p, e[0])
                putText(&p, ",\"yb\":")
                putInt(&p, e[1])
                putText(&p, ",\"w\":")
                putInt(&p, e[2])
                putText(&p, ",\"h\":")
                putInt(&p, e[3])
            } else {
                putChar(&p, '<')
                putInt(&p, e[0])
                putChar(&p, ',')
                putInt(&p, e[1])
                putChar(&p, ',')
                putInt(&p, e[2])
                putChar(&p, ',')
                putInt(&p, e[3])
                putChar(&p, '>')
            }
        }
        if json { putChar(&p, '}') }
        if i == end - 1 { putChar(&p, ']') }
        if !emit(base, p - base, &out, &size, consumed) { return i - start }
        if (flags & NO_POSITIONS) == 0 && (flags & NO_ADVANCES) != 0 {
            x +%= bufm.pos(b, i).*.xAdvance
            y +%= bufm.pos(b, i).*.yAdvance
        }
        i += 1
    }
    return end - start
}

fn serializeUnicode(address: usize, start: u32, end: u32, out_: usize, size_: u32, consumed: usize, format: u32, flags: u32) -> u32 {
    const b = bufm.buf(address)
    var out = out_
    var size = size_
    var item: [256]u8 = undefined
    const base = @intFromPtr(&item)
    var i = start
    while i < end {
        var p = base
        const g = bufm.info(b, i)
        if format == FORMAT_JSON {
            putChar(&p, if i != 0 { ',' } else { '[' })
            putText(&p, "{\"u\":")
            putUint(&p, g.*.codepoint)
            if (flags & NO_CLUSTERS) == 0 {
                putText(&p, ",\"cl\":")
                putUint(&p, g.*.cluster)
            }
            putChar(&p, '}')
            if i == end - 1 { putChar(&p, ']') }
        } else {
            putChar(&p, if i != 0 { '|' } else { '<' })
            putText(&p, "U+")
            putHex(&p, g.*.codepoint, 4)
            if (flags & NO_CLUSTERS) == 0 {
                putChar(&p, '=')
                putUint(&p, g.*.cluster)
            }
            if i == end - 1 { putChar(&p, '>') }
        }
        if !emit(base, p - base, &out, &size, consumed) { return i - start }
        i += 1
    }
    return end - start
}

fn prepare(address: usize, start: *u32, end: *u32, out: usize, size: u32, consumed: *usize, local: usize) -> void {
    const b = bufm.buf(address)
    if end.* > b.*.len { end.* = b.*.len }
    if end.* < start.* { end.* = start.* }
    if start.* > end.* { start.* = end.* }
    if consumed.* == 0 { consumed.* = local }
    m.put32(consumed.*, 0)
    if size != 0 { m.put8(out, 0) }
}

pub fn serializeGlyphsApi(address: usize, start_: u32, end_: u32, out: usize, size: u32, consumed_: usize, f_: usize, format: u32, flags_: u32) -> u32 {
    var start = start_
    var end = end_
    var consumed = consumed_
    var local: u32 = 0
    prepare(address, &start, &end, out, size, &consumed, @intFromPtr(&local))
    var flags = flags_
    if bufm.buf(address).*.havePositions == 0 { flags |= NO_POSITIONS }
    if start == end { return 0 }
    const f = if f_ == 0 { font.getEmpty() } else { f_ }
    if format != FORMAT_TEXT && format != FORMAT_JSON { return 0 }
    return serializeGlyphs(address, start, end, out, size, consumed, f, format, flags)
}

pub fn serializeUnicodeApi(address: usize, start_: u32, end_: u32, out: usize, size: u32, consumed_: usize, format: u32, flags: u32) -> u32 {
    var start = start_
    var end = end_
    var consumed = consumed_
    var local: u32 = 0
    prepare(address, &start, &end, out, size, &consumed, @intFromPtr(&local))
    if start == end { return 0 }
    if format != FORMAT_TEXT && format != FORMAT_JSON { return 0 }
    return serializeUnicode(address, start, end, out, size, consumed, format, flags)
}

pub fn bufferSerializeGlyphs(address: usize, start: u32, end: u32, out: usize, size: u32, consumed: usize, f: usize, format: u32, flags: u32) -> u32 { return serializeGlyphsApi(address, start, end, out, size, consumed, f, format, flags) }
pub fn bufferSerializeUnicode(address: usize, start: u32, end: u32, out: usize, size: u32, consumed: usize, format: u32, flags: u32) -> u32 { return serializeUnicodeApi(address, start, end, out, size, consumed, format, flags) }

pub fn bufferSerialize(address: usize, start: u32, end: u32, out: usize, size: u32, consumed: usize, f: usize, format: u32, flags: u32) -> u32 {
    const t = bufm.buf(address).*.contentType
    if t == bufm.CONTENT_GLYPHS { return serializeGlyphsApi(address, start, end, out, size, consumed, f, format, flags) }
    if t == bufm.CONTENT_UNICODE { return serializeUnicodeApi(address, start, end, out, size, consumed, format, flags) }
    if size < 3 { return 0 }
    if format == FORMAT_JSON {
        m.put8(out, '[')
        m.put8(out + 1, ']')
        m.put8(out + 2, 0)
    } else if format == FORMAT_TEXT {
        m.put8(out, '!')
        m.put8(out + 1, '!')
        m.put8(out + 2, 0)
    }
    if consumed != 0 { m.put32(consumed, 2) }
    return 0
}

// ---------------------------------------------------------------------------
// Reading back

fn parseIntWhole(p: usize, end: usize, v: *i32) -> bool {
    var q = p
    var x: i64 = 0
    if !common.parseInt(&q, end, &x) || q != end { return false }
    v.* = m.low32(x)
    return true
}

fn parseUintWhole(p: usize, end: usize, base: u32, v: *u32) -> bool { return common.parseCodepoint(p, end - p, base, v) }

// The end of a field: the first of the delimiters from `p` on.
fn fieldEnd(p: usize, end: usize, delimiters: []const u8) -> usize {
    var q = p
    while q < end {
        const c = m.get8(q)
        var i: usize = 0
        while i < delimiters.length {
            if c == delimiters[i] { return q }
            i += 1
        }
        q += 1
    }
    return q
}

fn deserializeTextGlyphs(address: usize, text: usize, length: usize, endPtr: usize, f: usize) -> bool {
    const b = bufm.buf(address)
    var p = text
    const end = text + length
    while p < end && (m.isSpace(m.get8(p)) || m.get8(p) == '[') { p += 1 }
    while p < end && m.get8(p) != ']' {
        var g: bufm.GlyphInfo = undefined
        g.codepoint = 0
        g.mask = 0
        g.cluster = 0
        g.var1 = 0
        g.var2 = 0
        var xo: i32 = 0
        var yo: i32 = 0
        var xa: i32 = 0
        var ya: i32 = 0
        var q = fieldEnd(p, end, "=@+#<|]")
        if !font.glyphFromString(f, p, @intCast(i32, q - p), &g.codepoint) { return false }
        p = q
        if p < end && m.get8(p) == '=' {
            q = fieldEnd(p + 1, end, "@+#<|]")
            if !parseUintWhole(p + 1, q, 10, &g.cluster) { return false }
            p = q
        }
        if p < end && m.get8(p) == '@' {
            q = fieldEnd(p + 1, end, ",")
            if !parseIntWhole(p + 1, q, &xo) { return false }
            p = q + 1
            q = fieldEnd(p, end, "+#<|]")
            if !parseIntWhole(p, q, &yo) { return false }
            p = q
        }
        if p < end && m.get8(p) == '+' {
            q = fieldEnd(p + 1, end, ",#<|]")
            if !parseIntWhole(p + 1, q, &xa) { return false }
            p = q
            if p < end && m.get8(p) == ',' {
                q = fieldEnd(p + 1, end, "#<|]")
                if !parseIntWhole(p + 1, q, &ya) { return false }
                p = q
            }
        }
        if p < end && m.get8(p) == '#' {
            q = fieldEnd(p + 1, end, "<|]")
            if !parseUintWhole(p + 1, q, 16, &g.mask) { return false }
            p = q
        }
        if p < end && m.get8(p) == '<' {
            q = fieldEnd(p, end, ">")
            p = if q < end { q + 1 } else { q }
        }
        bufm.add(b, 0, 0)
        if b.*.successful == 0 { return false }
        bufm.copyInfo(bufm.info(b, b.*.len - 1), &g)
        if b.*.havePositions == 0 { bufm.clearPositions(b) }
        const ps = bufm.pos(b, b.*.len - 1)
        ps.*.xOffset = xo
        ps.*.yOffset = yo
        ps.*.xAdvance = xa
        ps.*.yAdvance = ya
        if p < end && m.get8(p) == '|' { p += 1 }
        m.putWord(endPtr, p)
    }
    if p < end { p += 1 }
    m.putWord(endPtr, p)
    return true
}

fn deserializeTextUnicode(address: usize, text: usize, length: usize, endPtr: usize) -> bool {
    const b = bufm.buf(address)
    var p = text
    const end = text + length
    while p < end && (m.isSpace(m.get8(p)) || m.get8(p) == '<') { p += 1 }
    while p < end && m.get8(p) != '>' {
        if p + 2 <= end && (m.get8(p) == 'U' || m.get8(p) == 'u') && m.get8(p + 1) == '+' { p += 2 }
        var q = fieldEnd(p, end, "=|>")
        var u: u32 = 0
        if !parseUintWhole(p, q, 16, &u) { return false }
        p = q
        var cluster: u32 = 0
        if p < end && m.get8(p) == '=' {
            q = fieldEnd(p + 1, end, "|>")
            if !parseUintWhole(p + 1, q, 10, &cluster) { return false }
            p = q
        }
        bufm.add(b, u, cluster)
        if p < end && m.get8(p) == '|' { p += 1 }
        m.putWord(endPtr, p)
    }
    if p < end { p += 1 }
    m.putWord(endPtr, p)
    return true
}

// JSON: objects with the keys "g" (a name or an id) or "u", "cl", "dx",
// "dy", "ax", "ay", "fl".
fn deserializeJson(address: usize, text: usize, length: usize, endPtr: usize, f: usize, glyphs: bool) -> bool {
    const b = bufm.buf(address)
    var p = text
    const end = text + length
    while p < end && m.get8(p) != '{' && m.get8(p) != ']' { p += 1 }
    while p < end && m.get8(p) == '{' {
        p += 1
        var g: bufm.GlyphInfo = undefined
        g.codepoint = 0
        g.mask = 0
        g.cluster = 0
        g.var1 = 0
        g.var2 = 0
        var vals: [4]i32 = [4]i32{ 0, 0, 0, 0 }
        while p < end && m.get8(p) != '}' {
            while p < end && (m.isSpace(m.get8(p)) || m.get8(p) == ',') { p += 1 }
            if p >= end || m.get8(p) != '"' { break }
            const keyStart = p + 1
            const keyEnd = fieldEnd(keyStart, end, "\"")
            p = keyEnd + 1
            while p < end && (m.isSpace(m.get8(p)) || m.get8(p) == ':') { p += 1 }
            var vEnd: usize = 0
            if p < end && m.get8(p) == '"' {
                vEnd = fieldEnd(p + 1, end, "\"")
                if m.bytesAre(keyStart, keyEnd - keyStart, "g") && !font.glyphFromString(f, p + 1, @intCast(i32, vEnd - p - 1), &g.codepoint) { return false }
                p = vEnd + 1
            } else {
                vEnd = fieldEnd(p, end, ",}")
                var v: i32 = 0
                if !parseIntWhole(p, vEnd, &v) { return false }
                const k = keyEnd - keyStart
                if m.bytesAre(keyStart, k, "g") || m.bytesAre(keyStart, k, "u") { g.codepoint = @bitCast(u32, v) }
                if m.bytesAre(keyStart, k, "cl") { g.cluster = @bitCast(u32, v) }
                if m.bytesAre(keyStart, k, "fl") { g.mask = @bitCast(u32, v) }
                if m.bytesAre(keyStart, k, "dx") { vals[0] = v }
                if m.bytesAre(keyStart, k, "dy") { vals[1] = v }
                if m.bytesAre(keyStart, k, "ax") { vals[2] = v }
                if m.bytesAre(keyStart, k, "ay") { vals[3] = v }
                p = vEnd
            }
        }
        if p < end { p += 1 }
        bufm.add(b, 0, 0)
        if b.*.successful == 0 { return false }
        bufm.copyInfo(bufm.info(b, b.*.len - 1), &g)
        if glyphs {
            if b.*.havePositions == 0 { bufm.clearPositions(b) }
            const ps = bufm.pos(b, b.*.len - 1)
            ps.*.xOffset = vals[0]
            ps.*.yOffset = vals[1]
            ps.*.xAdvance = vals[2]
            ps.*.yAdvance = vals[3]
        }
        while p < end && (m.isSpace(m.get8(p)) || m.get8(p) == ',') { p += 1 }
        m.putWord(endPtr, p)
    }
    if p < end && m.get8(p) == ']' { p += 1 }
    m.putWord(endPtr, p)
    return true
}

pub fn bufferDeserializeGlyphs(address: usize, text: usize, len_: i32, endPtr_: usize, f_: usize, format: u32) -> i32 {
    var local: usize = 0
    const endPtr = if endPtr_ == 0 { @intFromPtr(&local) } else { endPtr_ }
    m.putWord(endPtr, text)
    if o.isImmutable(address) { return 0 }
    var len = len_
    if len == -1 { len = @intCast(i32, m.cLength(text)) }
    if len == 0 { return 0 }
    bufm.buf(address).*.contentType = bufm.CONTENT_GLYPHS
    const f = if f_ == 0 { font.getEmpty() } else { f_ }
    if format == FORMAT_TEXT { return if deserializeTextGlyphs(address, text, @intCast(usize, len), endPtr, f) { 1 } else { 0 } }
    if format == FORMAT_JSON { return if deserializeJson(address, text, @intCast(usize, len), endPtr, f, true) { 1 } else { 0 } }
    return 0
}

pub fn bufferDeserializeUnicode(address: usize, text: usize, len_: i32, endPtr_: usize, format: u32) -> i32 {
    var local: usize = 0
    const endPtr = if endPtr_ == 0 { @intFromPtr(&local) } else { endPtr_ }
    m.putWord(endPtr, text)
    if o.isImmutable(address) { return 0 }
    var len = len_
    if len == -1 { len = @intCast(i32, m.cLength(text)) }
    if len == 0 { return 0 }
    bufm.buf(address).*.contentType = bufm.CONTENT_UNICODE
    if format == FORMAT_TEXT { return if deserializeTextUnicode(address, text, @intCast(usize, len), endPtr) { 1 } else { 0 } }
    if format == FORMAT_JSON { return if deserializeJson(address, text, @intCast(usize, len), endPtr, font.getEmpty(), false) { 1 } else { 0 } }
    return 0
}
