// The rarely used parts of HarfBuzz's hb-ot-layout API: feature params
// (the 'size' feature's optical size, the names of stylistic sets and of
// character variants and their characters), the metadata table (meta).
const m = @import("./memory.mlx")
const face = @import("./face.mlx")
const blob = @import("./blob.mlx")
const layout = @import("./layout.mlx")
const sanitize = @import("./sanitize.mlx")

const TAG_SIZE: u32 = 0x73697A65
const NAME_ID_INVALID: u32 = 0xFFFF

fn isStylisticSet(tag: u32) -> bool { return (tag & 0xFFFF0000) == 0x73730000 }
fn isCharacterVariant(tag: u32) -> bool { return (tag & 0xFFFF0000) == 0x63760000 }

// Whether the feature params at `p` pass HarfBuzz's checks for `tag`.
fn paramsValid(t: *m.Table, p: usize, tag: u32) -> bool {
    if tag == TAG_SIZE {
        if !m.fits(t, p, 10) { return false }
        const design = m.u16at(t, p)
        const subfamily = m.u16at(t, p + 2)
        const nameId = m.u16at(t, p + 4)
        const start = m.u16at(t, p + 6)
        const end = m.u16at(t, p + 8)
        if design == 0 { return false }
        if subfamily == 0 && nameId == 0 && start == 0 && end == 0 { return true }
        return !(design < start || design > end || nameId < 256 || nameId > 32767)
    }
    if isStylisticSet(tag) { return m.fits(t, p, 4) }
    if isCharacterVariant(tag) { return m.fits(t, p, 14) && m.fits(t, p + 14, @intCast(usize, m.u16at(t, p + 12)) * 3) }
    return true
}

// The feature params of feature `index` (0: none), as HarfBuzz's checks
// leave them: params that fail are none, except that the params of 'size'
// may be at their offset from the feature list (as old Adobe tools wrote
// them).
fn featureParams(t: *m.Table, index: u32) -> usize {
    const f = layout.feature(t, index)
    if f == 0 { return 0 }
    const off = @intCast(usize, m.u16at(t, f))
    if off == 0 { return 0 }
    const tag = layout.featureTag(t, index)
    if paramsValid(t, f + off, tag) { return f + off }
    const list = layout.featureList(t)
    if tag == TAG_SIZE && list < f && paramsValid(t, list + off, tag) { return list + off }
    return 0
}

fn put(p: usize, v: u32) -> void { if p != 0 { m.put32(p, v) } }

pub fn sizeParams(fc: usize, design: *u32, subfamily: usize, nameId: usize, start: usize, end: usize) -> bool {
    var t: m.Table = undefined
    layout.gsubgpos(fc, 1, &t)
    const n = layout.featureCount(&t)
    var i: u32 = 0
    while i < n {
        if layout.featureTag(&t, i) == TAG_SIZE {
            const p = featureParams(&t, i)
            if p != 0 && m.u16at(&t, p) != 0 {
                design.* = m.u16at(&t, p)
                put(subfamily, m.u16at(&t, p + 2))
                put(nameId, m.u16at(&t, p + 4))
                put(start, m.u16at(&t, p + 6))
                put(end, m.u16at(&t, p + 8))
                return true
            }
        }
        i += 1
    }
    design.* = 0
    put(subfamily, 0)
    put(nameId, NAME_ID_INVALID)
    put(start, 0)
    put(end, 0)
    return false
}

pub fn otLayoutGetSizeParams(fc: usize, design: usize, subfamily: usize, nameId: usize, start: usize, end: usize) -> i32 {
    var d: u32 = 0
    const ok = sizeParams(fc, &d, subfamily, nameId, start, end)
    put(design, d)
    return if ok { 1 } else { 0 }
}

pub fn otLayoutFeatureGetNameIds(fc: usize, tableTag: u32, index: u32, label: usize, tooltip: usize, sample: usize, count: usize, first: usize) -> i32 {
    var t: m.Table = undefined
    layout.tableOf(fc, tableTag, &t)
    const tag = layout.featureTag(&t, index)
    const p = featureParams(&t, index)
    if p != 0 {
        if isStylisticSet(tag) {
            put(label, m.u16at(&t, p + 2))
            put(tooltip, NAME_ID_INVALID)
            put(sample, NAME_ID_INVALID)
            put(count, 0)
            put(first, NAME_ID_INVALID)
            return 1
        }
        if isCharacterVariant(tag) {
            put(label, m.u16at(&t, p + 2))
            put(tooltip, m.u16at(&t, p + 4))
            put(sample, m.u16at(&t, p + 6))
            put(count, m.u16at(&t, p + 8))
            put(first, m.u16at(&t, p + 10))
            return 1
        }
    }
    put(label, NAME_ID_INVALID)
    put(tooltip, NAME_ID_INVALID)
    put(sample, NAME_ID_INVALID)
    put(count, 0)
    put(first, NAME_ID_INVALID)
    return 0
}

pub fn otLayoutFeatureGetCharacters(fc: usize, tableTag: u32, index: u32, start: u32, count: usize, characters: usize) -> u32 {
    var t: m.Table = undefined
    layout.tableOf(fc, tableTag, &t)
    const p = featureParams(&t, index)
    const total = if p != 0 && isCharacterVariant(layout.featureTag(&t, index)) { m.u16at(&t, p + 12) } else { @intCast(u32, 0) }
    if count != 0 {
        var n = if start > total { @intCast(u32, 0) } else { total - start }
        if n > m.get32(count) { n = m.get32(count) }
        m.put32(count, n)
        var i: u32 = 0
        while i < n && characters != 0 {
            m.put32(characters + @intCast(usize, i) * 4, m.u24at(&t, p + 14 + @intCast(usize, start + i) * 3))
            i += 1
        }
    }
    return total
}

// ---------------------------------------------------------------------------
// meta

pub const Meta = struct {
    t: m.Table
    copy: usize
}

fn metaOf(address: usize) -> *Meta { unsafe { return @ptrFromInt(*Meta, address) } }

pub fn metaFreeCallback(a: usize) -> void {
    const x = metaOf(a)
    if x.*.copy != 0 { m.release(x.*.copy) }
    m.release(a)
}

fn metaChecks(s: *sanitize.Sanitizer) -> bool {
    if !sanitize.range(s, 0, 16) || sanitize.u32at(s, 0) != 1 { return false }
    if !sanitize.range(s, 12, 4) { return false }
    const n = sanitize.u32at(s, 12)
    if !sanitize.array(s, 16, n, 12) { return false }
    var i: u32 = 0
    while i < n {
        const r = 16 + @intCast(usize, i) * 12
        if !sanitize.range(s, r, 12) || !sanitize.range(s, r + 4, 4) { return false }
        if !sanitize.array(s, @intCast(usize, sanitize.u32at(s, r + 4)), sanitize.u32at(s, r + 8), 1) { return false }
        i += 1
    }
    return true
}

fn metaAccel(fc: usize) -> *Meta {
    var a = face.accel(fc, face.A_META)
    if a == 0 {
        const made = m.alloc(@sizeOf(Meta))
        const x = metaOf(made)
        var t: m.Table = undefined
        face.view(fc, face.T_META, &t)
        sanitize.sanitizeTable(&t, face.numGlyphs(fc), @intFromPtr(metaChecks), &x.*.t, &x.*.copy)
        a = face.keepAccel(fc, face.A_META, made, @intFromPtr(metaFreeCallback))
    }
    return metaOf(a)
}

pub fn otMetaGetEntryTags(fc: usize, start: u32, count: usize, entries: usize) -> u32 {
    const t = &metaAccel(fc).*.t
    const total = m.u32at(t, 12)
    if count != 0 {
        var n = if start > total { @intCast(u32, 0) } else { total - start }
        if n > m.get32(count) { n = m.get32(count) }
        m.put32(count, n)
        var i: u32 = 0
        while i < n && entries != 0 {
            m.put32(entries + @intCast(usize, i) * 4, m.u32at(t, 16 + @intCast(usize, start + i) * 12))
            i += 1
        }
    }
    return total
}

pub fn otMetaReferenceEntry(fc: usize, tag: u32) -> usize {
    const t = &metaAccel(fc).*.t
    const n = m.u32at(t, 12)
    var i: u32 = 0
    while i < n {
        const r = 16 + @intCast(usize, i) * 12
        if m.u32at(t, r) == tag {
            return blob.subBlob(face.table(fc, face.T_META), m.u32at(t, r + 4), m.u32at(t, r + 8))
        }
        i += 1
    }
    return blob.getEmpty()
}
