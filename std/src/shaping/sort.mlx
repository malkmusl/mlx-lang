// HarfBuzz's own quicksort (hb_qsort: sort_r_simple, from noporpoise's
// sort_r), which a build of HarfBuzz without the GNU qsort_r uses: equal
// elements end up in its order, which searches of sorted names show.
const m = @import("./memory.mlx")

// Compares the elements at two addresses (with a context): below 0, 0 or
// above 0.
pub const Compare = fn(usize, usize, usize) -> i32

fn compareAt(compare: usize, a: usize, b: usize, context: usize) -> i32 {
    const call: Compare = unsafe { @ptrFromInt(Compare, compare) }
    return call(a, b, context)
}

// Swaps `w` bytes at a and b.
fn swap(a: usize, b: usize, w: usize) -> void {
    var i: usize = 0
    while i < w {
        const t = m.get8(a + i)
        m.put8(a + i, m.get8(b + i))
        m.put8(b + i, t)
        i += 1
    }
}

// Swaps consecutive blocks of na and nb bytes at ptr with the smallest
// swap, so that they are in the opposite order.
fn swapBlocks(ptr: usize, na: usize, nb: usize) -> void {
    if na > 0 && nb > 0 {
        if na > nb { swap(ptr, ptr + na, nb) } else { swap(ptr, ptr + nb, na) }
    }
}

// Sorts `count` elements of `w` bytes at `base`.
pub fn sort(base: usize, count: usize, w: usize, compare: usize, context: usize) -> void {
    const b = base
    const end = b + count * w
    if count < 10 {
        // Insertion sort for small inputs.
        var pi = b + w
        while pi < end {
            var pj = pi
            while pj > b && compareAt(compare, pj - w, pj, context) > 0 {
                swap(pj - w, pj, w)
                pj -= w
            }
            pi += w
        }
        return
    }
    const last = b + w * (count - 1)
    // The pivot: the median of the second, the middle and the second-last
    // elements (as addresses, swapped among themselves).
    var l0 = b + w
    var l1 = b + w * (count / 2)
    var l2 = last - w
    if compareAt(compare, l0, l1, context) > 0 {
        const t = l0
        l0 = l1
        l1 = t
    }
    if compareAt(compare, l1, l2, context) > 0 {
        const t = l1
        l1 = l2
        l2 = t
        if compareAt(compare, l0, l1, context) > 0 {
            const u = l0
            l0 = l1
            l1 = u
        }
    }
    if l1 != last { swap(l1, last, w) }
    const pivot = last
    var ple = b
    var pl = b
    var pre = last
    var pr = last
    while pl < pr {
        // Items equal to the pivot on the left to the far left, up to one
        // greater than it.
        while pl < pr {
            const c = compareAt(compare, pl, pivot, context)
            if c > 0 { break }
            if c == 0 {
                if ple < pl { swap(ple, pl, w) }
                ple += w
            }
            pl += w
        }
        if pl >= pr { break }
        // Items equal to the pivot on the right to the far right, down to
        // one less than it.
        while pl < pr {
            pr -= w
            const c = compareAt(compare, pr, pivot, context)
            if c == 0 {
                pre -= w
                if pr < pre { swap(pr, pre, w) }
            } else if c < 0 {
                if pl < pr { swap(pl, pr, w) }
                pl += w
                break
            }
        }
    }
    pl = pr
    swapBlocks(b, ple - b, pl - ple)
    swapBlocks(pr, pre - pr, end - pre)
    sort(b, (pl - ple) / w, w, compare, context)
    sort(end - (pre - pr), (pre - pr) / w, w, compare, context)
}
