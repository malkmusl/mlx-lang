// hb-font.h: font functions objects and fonts (HarfBuzz's hb-font.cc and
// hb-font.hh). A font is a face at a scale (and ppem, point size,
// variations, synthetic bold and slant); its glyphs come from its font
// functions (the OpenType tables' own, FreeType's, or a program's, as
// WebKit's and Skia's), and a function a font's object does not give is
// asked of its parent font, scaled to the font.
const m = @import("./memory.mlx")
const o = @import("./object.mlx")
const common = @import("./common.mlx")
const face = @import("./face.mlx")
const draw = @import("./draw.mlx")
const paint = @import("./paint.mlx")

// The functions, in HarfBuzz's order.
pub const F_FONT_H_EXTENTS: usize = 0
pub const F_FONT_V_EXTENTS: usize = 1
pub const F_NOMINAL_GLYPH: usize = 2
pub const F_NOMINAL_GLYPHS: usize = 3
pub const F_VARIATION_GLYPH: usize = 4
pub const F_GLYPH_H_ADVANCE: usize = 5
pub const F_GLYPH_V_ADVANCE: usize = 6
pub const F_GLYPH_H_ADVANCES: usize = 7
pub const F_GLYPH_V_ADVANCES: usize = 8
pub const F_GLYPH_H_ORIGIN: usize = 9
pub const F_GLYPH_V_ORIGIN: usize = 10
pub const F_GLYPH_H_KERNING: usize = 11
pub const F_GLYPH_V_KERNING: usize = 12
pub const F_GLYPH_EXTENTS: usize = 13
pub const F_GLYPH_CONTOUR_POINT: usize = 14
pub const F_GLYPH_NAME: usize = 15
pub const F_GLYPH_FROM_NAME: usize = 16
pub const F_DRAW_GLYPH: usize = 17
pub const F_PAINT_GLYPH: usize = 18
pub const FUNC_COUNT: usize = 19

// A slot's function: DEFAULT asks the parent font, NIL is the empty
// object's answer, any other value a C function.
pub const DEFAULT: usize = 0
pub const NIL: usize = 1

pub const FUNCS_SIZE: usize = 24 + 3 * FUNC_COUNT * 8

pub fn funcAt(f: usize, i: usize) -> usize { return m.getWord(f + 24 + i * 8) }
pub fn funcDataAt(f: usize, i: usize) -> usize { return m.getWord(f + 24 + FUNC_COUNT * 8 + i * 8) }
fn funcDestroyAt(f: usize, i: usize) -> usize { return m.getWord(f + 24 + FUNC_COUNT * 16 + i * 8) }

var defaultFuncs: usize = 0
var nilFuncs: usize = 0

pub fn funcsGetEmpty() -> usize {
    var e = m.atomicLoadWord(@intFromPtr(&defaultFuncs))
    if e == 0 {
        const made = o.createInert(FUNCS_SIZE)
        if !m.swapWord(@intFromPtr(&defaultFuncs), 0, made) { m.release(made) }
        e = m.atomicLoadWord(@intFromPtr(&defaultFuncs))
    }
    return e
}

fn funcsNil() -> usize {
    var e = m.atomicLoadWord(@intFromPtr(&nilFuncs))
    if e == 0 {
        const made = o.createInert(FUNCS_SIZE)
        var i: usize = 0
        while i < FUNC_COUNT {
            m.putWord(made + 24 + i * 8, NIL)
            i += 1
        }
        if !m.swapWord(@intFromPtr(&nilFuncs), 0, made) { m.release(made) }
        e = m.atomicLoadWord(@intFromPtr(&nilFuncs))
    }
    return e
}

pub fn funcsCreate() -> usize {
    const f = o.create(FUNCS_SIZE)
    return if f != 0 { f } else { funcsGetEmpty() }
}

pub fn funcsDestroy(f: usize) -> void {
    if !o.destroy(f) { return }
    var i: usize = 0
    while i < FUNC_COUNT {
        o.callDestroy(funcDestroyAt(f, i), funcDataAt(f, i))
        i += 1
    }
    m.release(f)
}

pub fn setFunc(f: usize, i: usize, func: usize, userData_: usize, destroy_: usize) -> void {
    var userData = userData_
    var destroy = destroy_
    if o.isImmutable(f) {
        o.callDestroy(destroy, userData)
        return
    }
    if func == 0 {
        o.callDestroy(destroy, userData)
        destroy = 0
        userData = 0
    }
    o.callDestroy(funcDestroyAt(f, i), funcDataAt(f, i))
    m.putWord(f + 24 + i * 8, func)
    m.putWord(f + 24 + FUNC_COUNT * 8 + i * 8, userData)
    m.putWord(f + 24 + FUNC_COUNT * 16 + i * 8, destroy)
}

pub fn fontFuncsCreate() -> usize { return funcsCreate() }
pub fn fontFuncsGetEmpty() -> usize { return funcsGetEmpty() }
pub fn fontFuncsReference(f: usize) -> usize { return o.reference(f) }
pub fn fontFuncsDestroy(f: usize) -> void { funcsDestroy(f) }
pub fn fontFuncsSetUserData(f: usize, key: usize, data: usize, d: usize, replace: i32) -> i32 { return if o.setUserData(f, key, data, d, replace != 0) { 1 } else { 0 } }
pub fn fontFuncsGetUserData(f: usize, key: usize) -> usize { return o.getUserData(f, key) }
pub fn fontFuncsMakeImmutable(f: usize) -> void { o.makeImmutable(f) }
pub fn fontFuncsIsImmutable(f: usize) -> i32 { return if o.isImmutable(f) { 1 } else { 0 } }
pub fn fontFuncsSetFontHExtentsFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_FONT_H_EXTENTS, func, u, d) }
pub fn fontFuncsSetFontVExtentsFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_FONT_V_EXTENTS, func, u, d) }
pub fn fontFuncsSetNominalGlyphFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_NOMINAL_GLYPH, func, u, d) }
pub fn fontFuncsSetNominalGlyphsFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_NOMINAL_GLYPHS, func, u, d) }
pub fn fontFuncsSetVariationGlyphFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_VARIATION_GLYPH, func, u, d) }
pub fn fontFuncsSetGlyphHAdvanceFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_GLYPH_H_ADVANCE, func, u, d) }
pub fn fontFuncsSetGlyphVAdvanceFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_GLYPH_V_ADVANCE, func, u, d) }
pub fn fontFuncsSetGlyphHAdvancesFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_GLYPH_H_ADVANCES, func, u, d) }
pub fn fontFuncsSetGlyphVAdvancesFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_GLYPH_V_ADVANCES, func, u, d) }
pub fn fontFuncsSetGlyphHOriginFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_GLYPH_H_ORIGIN, func, u, d) }
pub fn fontFuncsSetGlyphVOriginFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_GLYPH_V_ORIGIN, func, u, d) }
pub fn fontFuncsSetGlyphHKerningFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_GLYPH_H_KERNING, func, u, d) }
pub fn fontFuncsSetGlyphVKerningFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_GLYPH_V_KERNING, func, u, d) }
pub fn fontFuncsSetGlyphExtentsFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_GLYPH_EXTENTS, func, u, d) }
pub fn fontFuncsSetGlyphContourPointFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_GLYPH_CONTOUR_POINT, func, u, d) }
pub fn fontFuncsSetGlyphNameFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_GLYPH_NAME, func, u, d) }
pub fn fontFuncsSetGlyphFromNameFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_GLYPH_FROM_NAME, func, u, d) }
pub fn fontFuncsSetDrawGlyphFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_DRAW_GLYPH, func, u, d) }
pub fn fontFuncsSetGlyphShapeFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_DRAW_GLYPH, func, u, d) }
pub fn fontFuncsSetPaintGlyphFunc(f: usize, func: usize, u: usize, d: usize) -> void { setFunc(f, F_PAINT_GLYPH, func, u, d) }

// The deprecated get_glyph function: both glyph functions call it, through
// a closure of the function, its data and destroy, and a count of the two
// references.
pub const GetGlyphFunc = fn(usize, usize, u32, u32, usize, usize) -> i32

pub fn fontTrampolineDestroyCallback(closure: usize) -> void {
    if m.atomicSub32(closure + 24, 1) != 1 { return }
    o.callDestroy(m.getWord(closure + 16), m.getWord(closure + 8))
    m.release(closure)
}

pub fn fontTrampolineNominalCallback(font: usize, fontData: usize, u: u32, glyph: usize, closure: usize) -> i32 {
    const call: GetGlyphFunc = unsafe { @ptrFromInt(GetGlyphFunc, m.getWord(closure)) }
    return call(font, fontData, u, 0, glyph, m.getWord(closure + 8))
}

pub fn fontTrampolineVariationCallback(font: usize, fontData: usize, u: u32, vs: u32, glyph: usize, closure: usize) -> i32 {
    const call: GetGlyphFunc = unsafe { @ptrFromInt(GetGlyphFunc, m.getWord(closure)) }
    return call(font, fontData, u, vs, glyph, m.getWord(closure + 8))
}

pub fn fontFuncsSetGlyphFunc(f: usize, func: usize, userData: usize, destroy: usize) -> void {
    if o.isImmutable(f) {
        o.callDestroy(destroy, userData)
        return
    }
    const closure = m.alloc(32)
    if closure == 0 {
        o.callDestroy(destroy, userData)
        return
    }
    m.putWord(closure, func)
    m.putWord(closure + 8, userData)
    m.putWord(closure + 16, destroy)
    m.put32(closure + 24, 2)
    setFunc(f, F_NOMINAL_GLYPH, @intFromPtr(fontTrampolineNominalCallback), closure, @intFromPtr(fontTrampolineDestroyCallback))
    setFunc(f, F_VARIATION_GLYPH, @intFromPtr(fontTrampolineVariationCallback), closure, @intFromPtr(fontTrampolineDestroyCallback))
}

// ---------------------------------------------------------------------------
// Fonts

pub const Font = struct {
    refcount: u32
    writable: u32
    userList: usize
    lock: u32
    count: u32
    serial: u32
    serialCoords: u32
    parent: usize
    face: usize
    xScale: i32
    yScale: i32
    xEmbolden: f32
    yEmbolden: f32
    emboldenInPlace: u32
    xStrength: i32
    yStrength: i32
    slant: f32
    slantXy: f32
    xMultf: f32
    yMultf: f32
    pad: u32
    xMult: i64
    yMult: i64
    xPpem: u32
    yPpem: u32
    ptem: f32
    instanceIndex: u32
    numCoords: u32
    pad2: u32
    coords: usize
    designCoords: usize
    klass: usize
    userData: usize
    destroy: usize
}

pub fn font(address: usize) -> *Font { unsafe { return @ptrFromInt(*Font, address) } }

var nullFont: usize = 0

pub fn getEmpty() -> usize {
    var e = m.atomicLoadWord(@intFromPtr(&nullFont))
    if e == 0 {
        const made = o.createInert(@sizeOf(Font))
        const f = font(made)
        f.*.face = face.getEmpty()
        f.*.xScale = 1000
        f.*.yScale = 1000
        f.*.emboldenInPlace = 1
        f.*.xMultf = 1.0
        f.*.yMultf = 1.0
        f.*.xMult = 65536
        f.*.yMult = 65536
        f.*.instanceIndex = 0xFFFFFFFF
        f.*.klass = funcsNil()
        if !m.swapWord(@intFromPtr(&nullFont), 0, made) { m.release(made) }
        e = m.atomicLoadWord(@intFromPtr(&nullFont))
    }
    return e
}

// What depends on the scale (hb_font_t::mults_changed).
pub fn multsChanged(address: usize) -> void {
    const f = font(address)
    const upemF = @floatFromInt(f32, face.upem(f.*.face))
    f.*.xMultf = @floatFromInt(f32, f.*.xScale) / upemF
    f.*.yMultf = @floatFromInt(f32, f.*.yScale) / upemF
    f.*.xMult = multOf(f.*.xScale, upemF)
    f.*.yMult = multOf(f.*.yScale, upemF)
    f.*.xStrength = m.intOf(m.fabsf(m.roundf(@floatFromInt(f32, f.*.xScale) * f.*.xEmbolden)))
    f.*.yStrength = m.intOf(m.fabsf(m.roundf(@floatFromInt(f32, f.*.yScale) * f.*.yEmbolden)))
    f.*.slantXy = if f.*.yScale != 0 { f.*.slant * @floatFromInt(f32, f.*.xScale) / @floatFromInt(f32, f.*.yScale) } else { 0.0 }
}

// ((int64) scale << 16) / upem, the division in float as C does it.
fn multOf(scale: i32, upemF: f32) -> i64 {
    var shifted: i64 = 0
    if scale < 0 {
        shifted = 0 - (@intCast(i64, 0 - @intCast(i64, scale)) << 16)
    } else {
        shifted = @intCast(i64, scale) << 16
    }
    const q = @floatFromInt(f32, shifted) / upemF
    return @intFromFloat(i64, q)
}

fn createBare(face_: usize) -> usize {
    var fc = face_
    if fc == 0 { fc = face.getEmpty() }
    const address = o.create(@sizeOf(Font))
    if address == 0 { return getEmpty() }
    o.makeImmutable(fc)
    const f = font(address)
    f.*.parent = getEmpty()
    f.*.face = o.reference(fc)
    f.*.klass = funcsGetEmpty()
    const u = @intCast(i32, face.upem(fc))
    f.*.xScale = u
    f.*.yScale = u
    f.*.emboldenInPlace = 1
    f.*.xMultf = 1.0
    f.*.yMultf = 1.0
    f.*.xMult = 65536
    f.*.yMult = 65536
    f.*.instanceIndex = 0xFFFFFFFF
    return address
}

// hb_font_create without the OpenType functions (the library's hb_font_create
// installs them, in otfont.mlx).
pub fn createWithoutFuncs(fc: usize) -> usize { return createBare(fc) }

pub fn destroyFont(address: usize) -> void {
    if !o.destroy(address) { return }
    const f = font(address)
    o.callDestroy(f.*.destroy, f.*.userData)
    destroyFont(f.*.parent)
    face.destroyFace(f.*.face)
    funcsDestroy(f.*.klass)
    m.release(f.*.coords)
    m.release(f.*.designCoords)
    m.release(address)
}

// Adopts the coordinates (normalized and design) as the font's.
pub fn adoptCoords(address: usize, coords: usize, design: usize, length: u32) -> void {
    const f = font(address)
    m.release(f.*.coords)
    m.release(f.*.designCoords)
    f.*.coords = coords
    f.*.designCoords = design
    f.*.numCoords = length
    multsChanged(address)
}

pub fn fontCreateSubFont(parent_: usize) -> usize {
    var parent = parent_
    if parent == 0 { parent = getEmpty() }
    const p = font(parent)
    const address = createBare(p.*.face)
    if o.isImmutable(address) { return address }
    const f = font(address)
    f.*.parent = o.reference(parent)
    f.*.xScale = p.*.xScale
    f.*.yScale = p.*.yScale
    f.*.xEmbolden = p.*.xEmbolden
    f.*.yEmbolden = p.*.yEmbolden
    f.*.emboldenInPlace = p.*.emboldenInPlace
    f.*.slant = p.*.slant
    f.*.xPpem = p.*.xPpem
    f.*.yPpem = p.*.yPpem
    f.*.ptem = p.*.ptem
    const n = p.*.numCoords
    if n != 0 {
        const coords = m.alloc(@intCast(usize, n) * 4)
        const design = m.alloc(@intCast(usize, n) * 4)
        if coords != 0 && design != 0 {
            m.copy(coords, p.*.coords, @intCast(usize, n) * 4)
            m.copy(design, p.*.designCoords, @intCast(usize, n) * 4)
            adoptCoords(address, coords, design, n)
        } else {
            m.release(coords)
            m.release(design)
        }
    }
    multsChanged(address)
    return address
}

pub fn fontGetEmpty() -> usize { return getEmpty() }
pub fn fontReference(f: usize) -> usize { return o.reference(f) }
pub fn fontDestroy(f: usize) -> void { destroyFont(f) }

pub fn fontSetUserData(f: usize, key: usize, data: usize, d: usize, replace: i32) -> i32 {
    if !o.isImmutable(f) { font(f).*.serial +%= 1 }
    return if o.setUserData(f, key, data, d, replace != 0) { 1 } else { 0 }
}

pub fn fontGetUserData(f: usize, key: usize) -> usize { return o.getUserData(f, key) }

pub fn makeImmutable(f: usize) -> void {
    if o.isImmutable(f) { return }
    if font(f).*.parent != 0 { makeImmutable(font(f).*.parent) }
    o.makeImmutable(f)
}

pub fn fontMakeImmutable(f: usize) -> void { makeImmutable(f) }
pub fn fontIsImmutable(f: usize) -> i32 { return if o.isImmutable(f) { 1 } else { 0 } }
pub fn fontGetSerial(f: usize) -> u32 { return font(f).*.serial }

pub fn fontChanged(f: usize) -> void {
    if o.isImmutable(f) { return }
    font(f).*.serial +%= 1
    multsChanged(f)
}

pub fn fontSetParent(address: usize, parent_: usize) -> void {
    if o.isImmutable(address) { return }
    const f = font(address)
    if parent_ == f.*.parent { return }
    f.*.serial +%= 1
    const parent = if parent_ == 0 { getEmpty() } else { parent_ }
    const old = f.*.parent
    f.*.parent = o.reference(parent)
    destroyFont(old)
}

pub fn fontGetParent(f: usize) -> usize { return font(f).*.parent }

pub fn fontSetFace(address: usize, fc_: usize) -> void {
    if o.isImmutable(address) { return }
    const f = font(address)
    if fc_ == f.*.face { return }
    f.*.serial +%= 1
    const fc = if fc_ == 0 { face.getEmpty() } else { fc_ }
    const old = f.*.face
    o.makeImmutable(fc)
    f.*.face = o.reference(fc)
    multsChanged(address)
    face.destroyFace(old)
}

pub fn fontGetFace(f: usize) -> usize { return font(f).*.face }

pub fn setFuncs(address: usize, klass_: usize, data: usize, destroy: usize) -> void {
    if o.isImmutable(address) {
        o.callDestroy(destroy, data)
        return
    }
    const f = font(address)
    f.*.serial +%= 1
    o.callDestroy(f.*.destroy, f.*.userData)
    const klass = if klass_ == 0 { funcsGetEmpty() } else { klass_ }
    _ = o.reference(klass)
    funcsDestroy(f.*.klass)
    f.*.klass = klass
    f.*.userData = data
    f.*.destroy = destroy
}

pub fn fontSetFuncs(f: usize, klass: usize, data: usize, destroy: usize) -> void { setFuncs(f, klass, data, destroy) }

pub fn fontSetFuncsData(address: usize, data: usize, destroy: usize) -> void {
    if o.isImmutable(address) {
        o.callDestroy(destroy, data)
        return
    }
    const f = font(address)
    f.*.serial +%= 1
    o.callDestroy(f.*.destroy, f.*.userData)
    f.*.userData = data
    f.*.destroy = destroy
}

pub fn fontSetScale(address: usize, x: i32, y: i32) -> void {
    if o.isImmutable(address) { return }
    const f = font(address)
    if f.*.xScale == x && f.*.yScale == y { return }
    f.*.serial +%= 1
    f.*.xScale = x
    f.*.yScale = y
    multsChanged(address)
}

pub fn fontGetScale(address: usize, x: usize, y: usize) -> void {
    if x != 0 { m.putI32(x, font(address).*.xScale) }
    if y != 0 { m.putI32(y, font(address).*.yScale) }
}

pub fn fontSetPpem(address: usize, x: u32, y: u32) -> void {
    if o.isImmutable(address) { return }
    const f = font(address)
    if f.*.xPpem == x && f.*.yPpem == y { return }
    f.*.serial +%= 1
    f.*.xPpem = x
    f.*.yPpem = y
}

pub fn fontGetPpem(address: usize, x: usize, y: usize) -> void {
    if x != 0 { m.put32(x, font(address).*.xPpem) }
    if y != 0 { m.put32(y, font(address).*.yPpem) }
}

pub fn fontSetPtem(address: usize, ptem: f32) -> void {
    if o.isImmutable(address) { return }
    const f = font(address)
    if f.*.ptem == ptem { return }
    f.*.serial +%= 1
    f.*.ptem = ptem
}

pub fn fontGetPtem(address: usize) -> f32 { return font(address).*.ptem }

pub fn fontSetSyntheticBold(address: usize, x: f32, y: f32, inPlace: i32) -> void {
    if o.isImmutable(address) { return }
    const f = font(address)
    const ip: u32 = if inPlace != 0 { 1 } else { 0 }
    if f.*.xEmbolden == x && f.*.yEmbolden == y && f.*.emboldenInPlace == ip { return }
    f.*.serial +%= 1
    f.*.xEmbolden = x
    f.*.yEmbolden = y
    f.*.emboldenInPlace = ip
    multsChanged(address)
}

pub fn fontGetSyntheticBold(address: usize, x: usize, y: usize, inPlace: usize) -> void {
    const f = font(address)
    if x != 0 { m.putF32(x, f.*.xEmbolden) }
    if y != 0 { m.putF32(y, f.*.yEmbolden) }
    if inPlace != 0 { m.put32(inPlace, f.*.emboldenInPlace) }
}

pub fn fontSetSyntheticSlant(address: usize, slant: f32) -> void {
    if o.isImmutable(address) { return }
    const f = font(address)
    if f.*.slant == slant { return }
    f.*.serial +%= 1
    f.*.slant = slant
    multsChanged(address)
}

pub fn fontGetSyntheticSlant(address: usize) -> f32 { return font(address).*.slant }

pub fn fontGetVarCoordsNormalized(address: usize, length: usize) -> usize {
    if length != 0 { m.put32(length, font(address).*.numCoords) }
    return font(address).*.coords
}

pub fn fontGetVarCoordsDesign(address: usize, length: usize) -> usize {
    if length != 0 { m.put32(length, font(address).*.numCoords) }
    return font(address).*.designCoords
}

pub fn fontGetVarNamedInstance(address: usize) -> u32 { return font(address).*.instanceIndex }

// ---------------------------------------------------------------------------
// Scaling

pub fn emMult(v: i32, mult: i64) -> i32 {
    // (The value is an int16 in HarfBuzz.)
    const v16 = @intCast(i64, @bitCast(i16, @intCast(u16, @bitCast(u32, v) & 0xFFFF)))
    return m.low32((v16 * mult + 32768) >> 16)
}

pub fn emScaleX(address: usize, v: i32) -> i32 { return emMult(v, font(address).*.xMult) }
pub fn emScaleY(address: usize, v: i32) -> i32 { return emMult(v, font(address).*.yMult) }
pub fn emScalefX(address: usize, v: f32) -> i32 { return m.intOf(m.roundf(v * font(address).*.xMultf)) }
pub fn emScalefY(address: usize, v: f32) -> i32 { return m.intOf(m.roundf(v * font(address).*.yMultf)) }
pub fn emFscaleX(address: usize, v: i32) -> f32 { return @floatFromInt(f32, @bitCast(i16, @intCast(u16, @bitCast(u32, v) & 0xFFFF))) * font(address).*.xMultf }
pub fn emFscaleY(address: usize, v: i32) -> f32 { return @floatFromInt(f32, @bitCast(i16, @intCast(u16, @bitCast(u32, v) & 0xFFFF))) * font(address).*.yMultf }

fn parentScaleX(address: usize, v: i32) -> i32 {
    const f = font(address)
    const p = f.*.parent
    if p != 0 && font(p).*.xScale != f.*.xScale && font(p).*.xScale != 0 { return m.low32(@intCast(i64, v) * @intCast(i64, f.*.xScale) / @intCast(i64, font(p).*.xScale)) }
    return v
}

fn parentScaleY(address: usize, v: i32) -> i32 {
    const f = font(address)
    const p = f.*.parent
    if p != 0 && font(p).*.yScale != f.*.yScale && font(p).*.yScale != 0 { return m.low32(@intCast(i64, v) * @intCast(i64, f.*.yScale) / @intCast(i64, font(p).*.yScale)) }
    return v
}

// Scales glyph extents in font units to the font, with its slant and
// emboldening (hb_font_t::scale_glyph_extents).
pub fn scaleGlyphExtents(address: usize, e: usize) -> void {
    const f = font(address)
    const xb = m.getI32(e)
    const yb = m.getI32(e + 4)
    const w = m.getI32(e + 8)
    const h = m.getI32(e + 12)
    var x1 = emFscaleX(address, xb)
    const y1 = emFscaleY(address, yb)
    var x2 = emFscaleX(address, xb + w)
    const y2 = emFscaleY(address, yb + h)
    if f.*.slantXy != 0.0 {
        const a = y1 * f.*.slantXy
        const b = y2 * f.*.slantXy
        x1 += if a < b { a } else { b }
        x2 += if a > b { a } else { b }
    }
    const nxb = m.intOf(m.floorf(x1))
    const nyb = m.intOf(m.floorf(y1))
    var nw = m.intOf(m.ceilf(x2)) - nxb
    var nh = m.intOf(m.ceilf(y2)) - nyb
    var bx = nxb
    var by = nyb
    if f.*.xStrength != 0 || f.*.yStrength != 0 {
        var yShift = f.*.yStrength
        if f.*.yScale < 0 { yShift = 0 - yShift }
        by += yShift
        nh -= yShift
        var xShift = f.*.xStrength
        if f.*.xScale < 0 { xShift = 0 - xShift }
        if f.*.emboldenInPlace != 0 { bx -= (xShift / 2) }
        nw += xShift
    }
    m.putI32(e, bx)
    m.putI32(e + 4, by)
    m.putI32(e + 8, nw)
    m.putI32(e + 12, nh)
}

// ---------------------------------------------------------------------------
// The calls of the functions

pub const ExtentsFunc = fn(usize, usize, usize, usize) -> i32
pub const NominalFunc = fn(usize, usize, u32, usize, usize) -> i32
pub const NominalsFunc = fn(usize, usize, u32, usize, u32, usize, u32, usize) -> u32
pub const VariationFunc = fn(usize, usize, u32, u32, usize, usize) -> i32
pub const AdvanceFunc = fn(usize, usize, u32, usize) -> i32
pub const AdvancesFunc = fn(usize, usize, u32, usize, u32, usize, u32, usize) -> void
pub const OriginFunc = fn(usize, usize, u32, usize, usize, usize) -> i32
pub const KerningFunc = fn(usize, usize, u32, u32, usize) -> i32
pub const GlyphExtentsFunc = fn(usize, usize, u32, usize, usize) -> i32
pub const ContourFunc = fn(usize, usize, u32, u32, usize, usize, usize) -> i32
pub const NameFunc = fn(usize, usize, u32, usize, u32, usize) -> i32
pub const FromNameFunc = fn(usize, usize, usize, i32, usize, usize) -> i32
pub const DrawFunc = fn(usize, usize, u32, usize, usize, usize) -> void
pub const PaintFunc = fn(usize, usize, u32, usize, usize, u32, u32, usize) -> void

fn slot(address: usize, i: usize) -> usize { return funcAt(font(address).*.klass, i) }
fn slotData(address: usize, i: usize) -> usize { return funcDataAt(font(address).*.klass, i) }

pub fn hasFuncSet(address: usize, i: usize) -> bool { return slot(address, i) != DEFAULT }

pub fn hasFunc(address: usize, i: usize) -> bool {
    if hasFuncSet(address, i) { return true }
    const p = font(address).*.parent
    return p != 0 && p != getEmpty() && hasFunc(p, i)
}

fn fontExtents(address: usize, i: usize, e: usize) -> bool {
    m.zero(e, 48)
    const f = slot(address, i)
    if f == NIL { return false }
    if f == DEFAULT {
        const parent = font(address).*.parent
        const ret = fontExtents(parent, i, e)
        if ret {
            var k: usize = 0
            while k < 3 {
                const v = m.getI32(e + k * 4)
                m.putI32(e + k * 4, if i == F_FONT_H_EXTENTS { parentScaleY(address, v) } else { parentScaleX(address, v) })
                k += 1
            }
        }
        return ret
    }
    const call: ExtentsFunc = unsafe { @ptrFromInt(ExtentsFunc, f) }
    return call(address, font(address).*.userData, e, slotData(address, i)) != 0
}

pub fn getFontHExtents(address: usize, e: usize) -> bool { return fontExtents(address, F_FONT_H_EXTENTS, e) }
pub fn getFontVExtents(address: usize, e: usize) -> bool { return fontExtents(address, F_FONT_V_EXTENTS, e) }

pub fn getNominalGlyph(address: usize, u: u32, glyph: *u32) -> bool {
    glyph.* = 0
    const f = slot(address, F_NOMINAL_GLYPH)
    if f == NIL { return false }
    if f == DEFAULT {
        if hasFuncSet(address, F_NOMINAL_GLYPHS) {
            var cp = u
            return getNominalGlyphs(address, 1, @intFromPtr(&cp), 0, @intFromPtr(glyph), 0) != 0
        }
        return getNominalGlyph(font(address).*.parent, u, glyph)
    }
    const call: NominalFunc = unsafe { @ptrFromInt(NominalFunc, f) }
    return call(address, font(address).*.userData, u, @intFromPtr(glyph), slotData(address, F_NOMINAL_GLYPH)) != 0
}

pub fn hasGlyph(address: usize, u: u32) -> bool {
    var g: u32 = 0
    return getNominalGlyph(address, u, &g)
}

pub fn getNominalGlyphs(address: usize, count: u32, firstUnicode: usize, unicodeStride: u32, firstGlyph: usize, glyphStride: u32) -> u32 {
    const f = slot(address, F_NOMINAL_GLYPHS)
    if f == DEFAULT || f == NIL {
        if hasFuncSet(address, F_NOMINAL_GLYPH) {
            var i: u32 = 0
            var up = firstUnicode
            var gp = firstGlyph
            while i < count {
                var g: u32 = 0
                if !getNominalGlyph(address, m.get32(up), &g) {
                    m.put32(gp, g)
                    return i
                }
                m.put32(gp, g)
                up += @intCast(usize, unicodeStride)
                gp += @intCast(usize, glyphStride)
                i += 1
            }
            return count
        }
        const parent = font(address).*.parent
        if parent == 0 { return 0 }
        return getNominalGlyphs(parent, count, firstUnicode, unicodeStride, firstGlyph, glyphStride)
    }
    const call: NominalsFunc = unsafe { @ptrFromInt(NominalsFunc, f) }
    return call(address, font(address).*.userData, count, firstUnicode, unicodeStride, firstGlyph, glyphStride, slotData(address, F_NOMINAL_GLYPHS))
}

pub fn getVariationGlyph(address: usize, u: u32, vs: u32, glyph: *u32) -> bool {
    glyph.* = 0
    const f = slot(address, F_VARIATION_GLYPH)
    if f == NIL { return false }
    if f == DEFAULT { return getVariationGlyph(font(address).*.parent, u, vs, glyph) }
    const call: VariationFunc = unsafe { @ptrFromInt(VariationFunc, f) }
    return call(address, font(address).*.userData, u, vs, @intFromPtr(glyph), slotData(address, F_VARIATION_GLYPH)) != 0
}

fn advance(address: usize, i: usize, plural: usize, g: u32) -> i32 {
    const f = slot(address, i)
    if f == NIL { return if i == F_GLYPH_H_ADVANCE { font(address).*.xScale } else { font(address).*.yScale } }
    if f == DEFAULT {
        if hasFuncSet(address, plural) {
            var glyph = g
            var ret: i32 = 0
            advances(address, plural, i, 1, @intFromPtr(&glyph), 0, @intFromPtr(&ret), 0)
            return ret
        }
        const v = advance(font(address).*.parent, i, plural, g)
        return if i == F_GLYPH_H_ADVANCE { parentScaleX(address, v) } else { parentScaleY(address, v) }
    }
    const call: AdvanceFunc = unsafe { @ptrFromInt(AdvanceFunc, f) }
    return call(address, font(address).*.userData, g, slotData(address, i))
}

fn advances(address: usize, i: usize, single: usize, count: u32, firstGlyph: usize, glyphStride: u32, firstAdvance: usize, advanceStride: u32) -> void {
    const f = slot(address, i)
    if f == DEFAULT || f == NIL {
        if hasFuncSet(address, single) {
            var k: u32 = 0
            var gp = firstGlyph
            var ap = firstAdvance
            while k < count {
                m.putI32(ap, advance(address, single, i, m.get32(gp)))
                gp += @intCast(usize, glyphStride)
                ap += @intCast(usize, advanceStride)
                k += 1
            }
            return
        }
        const parent = font(address).*.parent
        if parent == 0 { return }
        advances(parent, i, single, count, firstGlyph, glyphStride, firstAdvance, advanceStride)
        var k: u32 = 0
        var ap = firstAdvance
        while k < count {
            const v = m.getI32(ap)
            m.putI32(ap, if i == F_GLYPH_H_ADVANCES { parentScaleX(address, v) } else { parentScaleY(address, v) })
            ap += @intCast(usize, advanceStride)
            k += 1
        }
        return
    }
    const call: AdvancesFunc = unsafe { @ptrFromInt(AdvancesFunc, f) }
    call(address, font(address).*.userData, count, firstGlyph, glyphStride, firstAdvance, advanceStride, slotData(address, i))
}

pub fn getGlyphHAdvance(address: usize, g: u32) -> i32 { return advance(address, F_GLYPH_H_ADVANCE, F_GLYPH_H_ADVANCES, g) }
pub fn getGlyphVAdvance(address: usize, g: u32) -> i32 { return advance(address, F_GLYPH_V_ADVANCE, F_GLYPH_V_ADVANCES, g) }
pub fn getGlyphHAdvances(address: usize, count: u32, g: usize, gs: u32, a: usize, as_: u32) -> void { advances(address, F_GLYPH_H_ADVANCES, F_GLYPH_H_ADVANCE, count, g, gs, a, as_) }
pub fn getGlyphVAdvances(address: usize, count: u32, g: usize, gs: u32, a: usize, as_: u32) -> void { advances(address, F_GLYPH_V_ADVANCES, F_GLYPH_V_ADVANCE, count, g, gs, a, as_) }

fn origin(address: usize, i: usize, g: u32, x: *i32, y: *i32) -> bool {
    x.* = 0
    y.* = 0
    const f = slot(address, i)
    if f == NIL { return i == F_GLYPH_H_ORIGIN }
    if f == DEFAULT {
        const ret = origin(font(address).*.parent, i, g, x, y)
        if ret {
            x.* = parentScaleX(address, x.*)
            y.* = parentScaleY(address, y.*)
        }
        return ret
    }
    const call: OriginFunc = unsafe { @ptrFromInt(OriginFunc, f) }
    return call(address, font(address).*.userData, g, @intFromPtr(x), @intFromPtr(y), slotData(address, i)) != 0
}

pub fn getGlyphHOrigin(address: usize, g: u32, x: *i32, y: *i32) -> bool { return origin(address, F_GLYPH_H_ORIGIN, g, x, y) }
pub fn getGlyphVOrigin(address: usize, g: u32, x: *i32, y: *i32) -> bool { return origin(address, F_GLYPH_V_ORIGIN, g, x, y) }

fn kerning(address: usize, i: usize, a: u32, b: u32) -> i32 {
    const f = slot(address, i)
    if f == NIL { return 0 }
    if f == DEFAULT {
        const v = kerning(font(address).*.parent, i, a, b)
        return if i == F_GLYPH_H_KERNING { parentScaleX(address, v) } else { parentScaleY(address, v) }
    }
    const call: KerningFunc = unsafe { @ptrFromInt(KerningFunc, f) }
    return call(address, font(address).*.userData, a, b, slotData(address, i))
}

pub fn getGlyphHKerning(address: usize, a: u32, b: u32) -> i32 { return kerning(address, F_GLYPH_H_KERNING, a, b) }
pub fn getGlyphVKerning(address: usize, a: u32, b: u32) -> i32 { return kerning(address, F_GLYPH_V_KERNING, a, b) }

// The extents of `g` into the hb_glyph_extents_t at `e`.
pub fn getGlyphExtents(address: usize, g: u32, e: usize) -> bool {
    m.zero(e, 16)
    const f = slot(address, F_GLYPH_EXTENTS)
    if f == NIL { return false }
    if f == DEFAULT {
        const ret = getGlyphExtents(font(address).*.parent, g, e)
        if ret {
            m.putI32(e, parentScaleX(address, m.getI32(e)))
            m.putI32(e + 4, parentScaleY(address, m.getI32(e + 4)))
            m.putI32(e + 8, parentScaleX(address, m.getI32(e + 8)))
            m.putI32(e + 12, parentScaleY(address, m.getI32(e + 12)))
        }
        return ret
    }
    const call: GlyphExtentsFunc = unsafe { @ptrFromInt(GlyphExtentsFunc, f) }
    return call(address, font(address).*.userData, g, e, slotData(address, F_GLYPH_EXTENTS)) != 0
}

pub fn getGlyphContourPoint(address: usize, g: u32, index: u32, x: *i32, y: *i32) -> bool {
    x.* = 0
    y.* = 0
    const f = slot(address, F_GLYPH_CONTOUR_POINT)
    if f == NIL { return false }
    if f == DEFAULT {
        const ret = getGlyphContourPoint(font(address).*.parent, g, index, x, y)
        if ret {
            x.* = parentScaleX(address, x.*)
            y.* = parentScaleY(address, y.*)
        }
        return ret
    }
    const call: ContourFunc = unsafe { @ptrFromInt(ContourFunc, f) }
    return call(address, font(address).*.userData, g, index, @intFromPtr(x), @intFromPtr(y), slotData(address, F_GLYPH_CONTOUR_POINT)) != 0
}

pub fn getGlyphName(address: usize, g: u32, name: usize, size: u32) -> bool {
    if size != 0 { m.put8(name, 0) }
    const f = slot(address, F_GLYPH_NAME)
    if f == NIL { return false }
    if f == DEFAULT { return getGlyphName(font(address).*.parent, g, name, size) }
    const call: NameFunc = unsafe { @ptrFromInt(NameFunc, f) }
    return call(address, font(address).*.userData, g, name, size, slotData(address, F_GLYPH_NAME)) != 0
}

pub fn getGlyphFromName(address: usize, name: usize, len_: i32, glyph: *u32) -> bool {
    glyph.* = 0
    var len = len_
    if len == -1 { len = @intCast(i32, m.cLength(name)) }
    const f = slot(address, F_GLYPH_FROM_NAME)
    if f == NIL { return false }
    if f == DEFAULT { return getGlyphFromName(font(address).*.parent, name, len, glyph) }
    const call: FromNameFunc = unsafe { @ptrFromInt(FromNameFunc, f) }
    return call(address, font(address).*.userData, name, len, @intFromPtr(glyph), slotData(address, F_GLYPH_FROM_NAME)) != 0
}

// The default draw function: the parent's outline, scaled to the font,
// through an adaptor (the program's functions, their data, the scales).
var adaptorFuncs: usize = 0

pub fn fontAdaptMoveToCallback(d: usize, data: usize, st: usize, x: f32, y: f32, u: usize) -> void {
    const xs = m.getF32(data + 16)
    const ys = m.getF32(data + 20)
    const sl = m.getF32(data + 24)
    draw.emitMoveTo(m.getWord(data), m.getWord(data + 8), st, xs * x + sl * y, ys * y)
}

fn adaptCurrent(data: usize, st: usize) -> void {
    const xs = m.getF32(data + 16)
    const ys = m.getF32(data + 20)
    const sl = m.getF32(data + 24)
    const cx = m.getF32(st + 12)
    const cy = m.getF32(st + 16)
    m.putF32(st + 12, cx * xs + cy * sl)
    m.putF32(st + 16, cy * ys)
}

pub fn fontAdaptLineToCallback(d: usize, data: usize, st: usize, x: f32, y: f32, u: usize) -> void {
    const xs = m.getF32(data + 16)
    const ys = m.getF32(data + 20)
    const sl = m.getF32(data + 24)
    adaptCurrent(data, st)
    draw.emitLineTo(m.getWord(data), m.getWord(data + 8), st, xs * x + sl * y, ys * y)
}

pub fn fontAdaptQuadraticToCallback(d: usize, data: usize, st: usize, cx: f32, cy: f32, x: f32, y: f32, u: usize) -> void {
    const xs = m.getF32(data + 16)
    const ys = m.getF32(data + 20)
    const sl = m.getF32(data + 24)
    adaptCurrent(data, st)
    draw.emitQuadraticTo(m.getWord(data), m.getWord(data + 8), st, xs * cx + sl * cy, ys * cy, xs * x + sl * y, ys * y)
}

pub fn fontAdaptCubicToCallback(d: usize, data: usize, st: usize, c1x: f32, c1y: f32, c2x: f32, c2y: f32, x: f32, y: f32, u: usize) -> void {
    const xs = m.getF32(data + 16)
    const ys = m.getF32(data + 20)
    const sl = m.getF32(data + 24)
    adaptCurrent(data, st)
    draw.emitCubicTo(m.getWord(data), m.getWord(data + 8), st, xs * c1x + sl * c1y, ys * c1y, xs * c2x + sl * c2y, ys * c2y, xs * x + sl * y, ys * y)
}

pub fn fontAdaptClosePathCallback(d: usize, data: usize, st: usize, u: usize) -> void { draw.emitClosePath(m.getWord(data), m.getWord(data + 8), st) }

fn getAdaptorFuncs() -> usize {
    var a = m.atomicLoadWord(@intFromPtr(&adaptorFuncs))
    if a == 0 {
        const made = o.createInert(draw.FUNCS_SIZE)
        m.putWord(made + 24, @intFromPtr(fontAdaptMoveToCallback))
        m.putWord(made + 32, @intFromPtr(fontAdaptLineToCallback))
        m.putWord(made + 40, @intFromPtr(fontAdaptQuadraticToCallback))
        m.putWord(made + 48, @intFromPtr(fontAdaptCubicToCallback))
        m.putWord(made + 56, @intFromPtr(fontAdaptClosePathCallback))
        if !m.swapWord(@intFromPtr(&adaptorFuncs), 0, made) { m.release(made) }
        a = m.atomicLoadWord(@intFromPtr(&adaptorFuncs))
    }
    return a
}

fn ratio(a: i32, b: i32) -> f32 { return if b != 0 { @floatFromInt(f32, a) / @floatFromInt(f32, b) } else { 0.0 } }

pub fn drawGlyph(address: usize, g: u32, funcs: usize, data: usize) -> void {
    const f = slot(address, F_DRAW_GLYPH)
    if f == NIL { return }
    if f == DEFAULT {
        const p = font(address).*.parent
        if p == 0 { return }
        const fo = font(address)
        const po = font(p)
        var adaptor: [4]usize = undefined
        const a = @intFromPtr(&adaptor)
        m.putWord(a, funcs)
        m.putWord(a + 8, data)
        m.putF32(a + 16, ratio(fo.*.xScale, po.*.xScale))
        m.putF32(a + 20, ratio(fo.*.yScale, po.*.yScale))
        m.putF32(a + 24, if po.*.yScale != 0 { (fo.*.slant - po.*.slant) * @floatFromInt(f32, fo.*.xScale) / @floatFromInt(f32, po.*.yScale) } else { 0.0 })
        drawGlyph(p, g, getAdaptorFuncs(), a)
        return
    }
    const call: DrawFunc = unsafe { @ptrFromInt(DrawFunc, f) }
    call(address, font(address).*.userData, g, funcs, data, slotData(address, F_DRAW_GLYPH))
}

pub fn paintGlyph(address: usize, g: u32, funcs: usize, data: usize, palette: u32, foreground: u32) -> void {
    const f = slot(address, F_PAINT_GLYPH)
    if f == NIL { return }
    if f == DEFAULT {
        const p = font(address).*.parent
        if p == 0 { return }
        const fo = font(address)
        const po = font(p)
        paint.pushTransform(funcs, data, ratio(fo.*.xScale, po.*.xScale), if po.*.yScale != 0 { (fo.*.slant - po.*.slant) * @floatFromInt(f32, fo.*.xScale) / @floatFromInt(f32, po.*.yScale) } else { 0.0 }, 0.0, ratio(fo.*.yScale, po.*.yScale), 0.0, 0.0)
        paintGlyph(p, g, funcs, data, palette, foreground)
        paint.popTransform(funcs, data)
        return
    }
    const call: PaintFunc = unsafe { @ptrFromInt(PaintFunc, f) }
    call(address, font(address).*.userData, g, funcs, data, palette, foreground, slotData(address, F_PAINT_GLYPH))
}

// ---------------------------------------------------------------------------
// Higher level, with fallbacks

pub fn getHExtentsWithFallback(address: usize, e: usize) -> void {
    if !getFontHExtents(address, e) {
        const ys = font(address).*.yScale
        const asc = m.intOf64(@floatFromInt(f64, ys) * 0.8)
        m.putI32(e, asc)
        m.putI32(e + 4, asc - ys)
        m.putI32(e + 8, 0)
    }
}

pub fn getVExtentsWithFallback(address: usize, e: usize) -> void {
    if !getFontVExtents(address, e) {
        const xs = font(address).*.xScale
        const asc = (xs / 2)
        m.putI32(e, asc)
        m.putI32(e + 4, asc - xs)
        m.putI32(e + 8, 0)
    }
}

fn guessVOriginMinusHOrigin(address: usize, g: u32, x: *i32, y: *i32) -> void {
    x.* = getGlyphHAdvance(address, g) / 2
    var e: [12]i32 = undefined
    getHExtentsWithFallback(address, @intFromPtr(&e))
    y.* = e[0]
}

pub fn getGlyphHOriginWithFallback(address: usize, g: u32, x: *i32, y: *i32) -> void {
    if !getGlyphHOrigin(address, g, x, y) && getGlyphVOrigin(address, g, x, y) {
        var dx: i32 = 0
        var dy: i32 = 0
        guessVOriginMinusHOrigin(address, g, &dx, &dy)
        x.* -= dx
        y.* -= dy
    }
}

pub fn getGlyphVOriginWithFallback(address: usize, g: u32, x: *i32, y: *i32) -> void {
    if !getGlyphVOrigin(address, g, x, y) && getGlyphHOrigin(address, g, x, y) {
        var dx: i32 = 0
        var dy: i32 = 0
        guessVOriginMinusHOrigin(address, g, &dx, &dy)
        x.* += dx
        y.* += dy
    }
}

pub fn getGlyphOriginForDirection(address: usize, g: u32, direction: u32, x: *i32, y: *i32) -> void {
    if common.isHorizontal(direction) { getGlyphHOriginWithFallback(address, g, x, y) } else { getGlyphVOriginWithFallback(address, g, x, y) }
}

pub fn addGlyphHOrigin(address: usize, g: u32, x: *i32, y: *i32) -> void {
    var ox: i32 = 0
    var oy: i32 = 0
    getGlyphHOriginWithFallback(address, g, &ox, &oy)
    x.* += ox
    y.* += oy
}

pub fn subtractGlyphHOrigin(address: usize, g: u32, x: *i32, y: *i32) -> void {
    var ox: i32 = 0
    var oy: i32 = 0
    getGlyphHOriginWithFallback(address, g, &ox, &oy)
    x.* -= ox
    y.* -= oy
}

pub fn subtractGlyphVOrigin(address: usize, g: u32, x: *i32, y: *i32) -> void {
    var ox: i32 = 0
    var oy: i32 = 0
    getGlyphVOriginWithFallback(address, g, &ox, &oy)
    x.* -= ox
    y.* -= oy
}

pub fn addGlyphOriginForDirection(address: usize, g: u32, direction: u32, x: *i32, y: *i32) -> void {
    var ox: i32 = 0
    var oy: i32 = 0
    getGlyphOriginForDirection(address, g, direction, &ox, &oy)
    x.* += ox
    y.* += oy
}

pub fn subtractGlyphOriginForDirection(address: usize, g: u32, direction: u32, x: *i32, y: *i32) -> void {
    var ox: i32 = 0
    var oy: i32 = 0
    getGlyphOriginForDirection(address, g, direction, &ox, &oy)
    x.* -= ox
    y.* -= oy
}

pub fn getGlyphExtentsForOrigin(address: usize, g: u32, direction: u32, e: usize) -> bool {
    const ret = getGlyphExtents(address, g, e)
    if ret {
        var x = m.getI32(e)
        var y = m.getI32(e + 4)
        subtractGlyphOriginForDirection(address, g, direction, &x, &y)
        m.putI32(e, x)
        m.putI32(e + 4, y)
    }
    return ret
}

pub fn getGlyphContourPointForOrigin(address: usize, g: u32, index: u32, direction: u32, x: *i32, y: *i32) -> bool {
    const ret = getGlyphContourPoint(address, g, index, x, y)
    if ret { subtractGlyphOriginForDirection(address, g, direction, x, y) }
    return ret
}

// "gidN" when the glyph has no name.
pub fn glyphToString(address: usize, g: u32, s: usize, size: u32) -> void {
    if getGlyphName(address, g, s, size) { return }
    if size == 0 { return }
    var text: [16]u8 = undefined
    const t = @intFromPtr(&text)
    m.put8(t, 'g')
    m.put8(t + 1, 'i')
    m.put8(t + 2, 'd')
    const n = 3 + common.writeDecimal(t + 3, @intCast(u64, g))
    var len = n
    if len > @intCast(usize, size) - 1 { len = @intCast(usize, size) - 1 }
    m.copy(s, t, len)
    m.put8(s + len, 0)
}

pub fn glyphFromString(address: usize, s: usize, len_: i32, glyph: *u32) -> bool {
    if getGlyphFromName(address, s, len_, glyph) { return true }
    var len = len_
    if len == -1 { len = @intCast(i32, m.cLength(s)) }
    if len <= 0 { return false }
    const n = @intCast(usize, len)
    if common.parseCodepoint(s, n, 10, glyph) { return true }
    if n > 3 {
        if m.get8(s) == 'g' && m.get8(s + 1) == 'i' && m.get8(s + 2) == 'd' && common.parseCodepoint(s + 3, n - 3, 10, glyph) { return true }
        var u: u32 = 0
        if m.get8(s) == 'u' && m.get8(s + 1) == 'n' && m.get8(s + 2) == 'i' && common.parseCodepoint(s + 3, n - 3, 16, &u) && getNominalGlyph(address, u, glyph) { return true }
    }
    return false
}

// ---------------------------------------------------------------------------
// The public getters

fn p32(a: usize) -> *u32 { return unsafe { @ptrFromInt(*u32, a) } }
fn pi32(a: usize) -> *i32 { return unsafe { @ptrFromInt(*i32, a) } }
fn b(v: bool) -> i32 { return if v { 1 } else { 0 } }

pub fn fontGetHExtents(f: usize, e: usize) -> i32 { return b(getFontHExtents(f, e)) }
pub fn fontGetVExtents(f: usize, e: usize) -> i32 { return b(getFontVExtents(f, e)) }

pub fn fontGetGlyph(f: usize, u: u32, vs: u32, g: usize) -> i32 {
    if vs != 0 { return b(getVariationGlyph(f, u, vs, p32(g))) }
    return b(getNominalGlyph(f, u, p32(g)))
}

pub fn fontGetNominalGlyph(f: usize, u: u32, g: usize) -> i32 { return b(getNominalGlyph(f, u, p32(g))) }
pub fn fontGetNominalGlyphs(f: usize, count: u32, fu: usize, us: u32, fg: usize, gs: u32) -> u32 { return getNominalGlyphs(f, count, fu, us, fg, gs) }
pub fn fontGetVariationGlyph(f: usize, u: u32, vs: u32, g: usize) -> i32 { return b(getVariationGlyph(f, u, vs, p32(g))) }
pub fn fontGetGlyphHAdvance(f: usize, g: u32) -> i32 { return getGlyphHAdvance(f, g) }
pub fn fontGetGlyphVAdvance(f: usize, g: u32) -> i32 { return getGlyphVAdvance(f, g) }
pub fn fontGetGlyphHAdvances(f: usize, count: u32, g: usize, gs: u32, a: usize, as_: u32) -> void { getGlyphHAdvances(f, count, g, gs, a, as_) }
pub fn fontGetGlyphVAdvances(f: usize, count: u32, g: usize, gs: u32, a: usize, as_: u32) -> void { getGlyphVAdvances(f, count, g, gs, a, as_) }
pub fn fontGetGlyphHOrigin(f: usize, g: u32, x: usize, y: usize) -> i32 { return b(getGlyphHOrigin(f, g, pi32(x), pi32(y))) }
pub fn fontGetGlyphVOrigin(f: usize, g: u32, x: usize, y: usize) -> i32 { return b(getGlyphVOrigin(f, g, pi32(x), pi32(y))) }
pub fn fontGetGlyphHKerning(f: usize, a: u32, c: u32) -> i32 { return getGlyphHKerning(f, a, c) }
pub fn fontGetGlyphVKerning(f: usize, a: u32, c: u32) -> i32 { return getGlyphVKerning(f, a, c) }
pub fn fontGetGlyphExtents(f: usize, g: u32, e: usize) -> i32 { return b(getGlyphExtents(f, g, e)) }
pub fn fontGetGlyphContourPoint(f: usize, g: u32, i: u32, x: usize, y: usize) -> i32 { return b(getGlyphContourPoint(f, g, i, pi32(x), pi32(y))) }
pub fn fontGetGlyphName(f: usize, g: u32, name: usize, size: u32) -> i32 { return b(getGlyphName(f, g, name, size)) }
pub fn fontGetGlyphFromName(f: usize, name: usize, len: i32, g: usize) -> i32 { return b(getGlyphFromName(f, name, len, p32(g))) }
pub fn fontDrawGlyph(f: usize, g: u32, d: usize, data: usize) -> void { drawGlyph(f, g, d, data) }
pub fn fontGetGlyphShape(f: usize, g: u32, d: usize, data: usize) -> void { drawGlyph(f, g, d, data) }
pub fn fontPaintGlyph(f: usize, g: u32, p: usize, data: usize, palette: u32, fg: u32) -> void { paintGlyph(f, g, p, data, palette, fg) }

pub fn fontGetExtentsForDirection(f: usize, direction: u32, e: usize) -> void {
    if common.isHorizontal(direction) { getHExtentsWithFallback(f, e) } else { getVExtentsWithFallback(f, e) }
}

pub fn fontGetGlyphAdvanceForDirection(f: usize, g: u32, direction: u32, x: usize, y: usize) -> void {
    m.putI32(x, 0)
    m.putI32(y, 0)
    if common.isHorizontal(direction) { m.putI32(x, getGlyphHAdvance(f, g)) } else { m.putI32(y, getGlyphVAdvance(f, g)) }
}

pub fn fontGetGlyphAdvancesForDirection(f: usize, direction: u32, count: u32, g: usize, gs: u32, a: usize, as_: u32) -> void {
    if common.isHorizontal(direction) { getGlyphHAdvances(f, count, g, gs, a, as_) } else { getGlyphVAdvances(f, count, g, gs, a, as_) }
}

pub fn fontGetGlyphOriginForDirection(f: usize, g: u32, direction: u32, x: usize, y: usize) -> void {
    m.putI32(x, 0)
    m.putI32(y, 0)
    getGlyphOriginForDirection(f, g, direction, pi32(x), pi32(y))
}

pub fn fontAddGlyphOriginForDirection(f: usize, g: u32, direction: u32, x: usize, y: usize) -> void { addGlyphOriginForDirection(f, g, direction, pi32(x), pi32(y)) }
pub fn fontSubtractGlyphOriginForDirection(f: usize, g: u32, direction: u32, x: usize, y: usize) -> void { subtractGlyphOriginForDirection(f, g, direction, pi32(x), pi32(y)) }

pub fn fontGetGlyphKerningForDirection(f: usize, a: u32, c: u32, direction: u32, x: usize, y: usize) -> void {
    if common.isHorizontal(direction) {
        m.putI32(y, 0)
        m.putI32(x, getGlyphHKerning(f, a, c))
    } else {
        m.putI32(x, 0)
        m.putI32(y, getGlyphVKerning(f, a, c))
    }
}

pub fn fontGetGlyphExtentsForOrigin(f: usize, g: u32, direction: u32, e: usize) -> i32 { return b(getGlyphExtentsForOrigin(f, g, direction, e)) }
pub fn fontGetGlyphContourPointForOrigin(f: usize, g: u32, i: u32, direction: u32, x: usize, y: usize) -> i32 { return b(getGlyphContourPointForOrigin(f, g, i, direction, pi32(x), pi32(y))) }
pub fn fontGlyphToString(f: usize, g: u32, s: usize, size: u32) -> void { glyphToString(f, g, s, size) }
pub fn fontGlyphFromString(f: usize, s: usize, len: i32, g: usize) -> i32 { return b(glyphFromString(f, s, len, p32(g))) }
