// The Thai and Lao shaper (HarfBuzz's hb-ot-shaper-thai.cc): SARA AM (and
// its Lao counterpart) decomposed into NIKHAHIT and SARA AA with the
// NIKHAHIT moved before the above-base marks; and for Thai fonts without
// Thai GSUB, the marks and descenders replaced by the private-use glyphs
// of the Windows and Mac fonts.
const m = @import("./memory.mlx")
const common = @import("./common.mlx")
const unicode = @import("./unicode.mlx")
const font = @import("./font.mlx")
const buffer = @import("./buffer.mlx")
const p = @import("./props.mlx")
const plan = @import("./plan.mlx")

const NC: u32 = 0
const AC: u32 = 1
const RC: u32 = 2
const DC: u32 = 3
const NOT_CONSONANT: u32 = 4

fn consonantType(u: u32) -> u32 {
    if u == 0x0E1B || u == 0x0E1D || u == 0x0E1F { return AC }
    if u == 0x0E0D || u == 0x0E10 { return RC }
    if u == 0x0E0E || u == 0x0E0F { return DC }
    if u >= 0x0E01 && u <= 0x0E2E { return NC }
    return NOT_CONSONANT
}

const AV: u32 = 0
const BV: u32 = 1
const T: u32 = 2
const NOT_MARK: u32 = 3

fn markType(u: u32) -> u32 {
    if u == 0x0E31 || (u >= 0x0E34 && u <= 0x0E37) || u == 0x0E47 || (u >= 0x0E4D && u <= 0x0E4E) { return AV }
    if u >= 0x0E38 && u <= 0x0E3A { return BV }
    if u >= 0x0E48 && u <= 0x0E4C { return T }
    return NOT_MARK
}

const NOP: u32 = 0
const SD: u32 = 1
const SL: u32 = 2
const SDL: u32 = 3
const RD: u32 = 4

// Mappings: character, Windows private-use form, Mac private-use form.
var SD_MAPPINGS = [24]u32{ 0x0E48, 0xF70A, 0xF88B, 0x0E49, 0xF70B, 0xF88E, 0x0E4A, 0xF70C, 0xF891, 0x0E4B, 0xF70D, 0xF894, 0x0E4C, 0xF70E, 0xF897, 0x0E38, 0xF718, 0xF89B, 0x0E39, 0xF719, 0xF89C, 0x0E3A, 0xF71A, 0xF89D }
var SDL_MAPPINGS = [15]u32{ 0x0E48, 0xF705, 0xF88C, 0x0E49, 0xF706, 0xF88F, 0x0E4A, 0xF707, 0xF892, 0x0E4B, 0xF708, 0xF895, 0x0E4C, 0xF709, 0xF898 }
var SL_MAPPINGS = [36]u32{ 0x0E48, 0xF713, 0xF88A, 0x0E49, 0xF714, 0xF88D, 0x0E4A, 0xF715, 0xF890, 0x0E4B, 0xF716, 0xF893, 0x0E4C, 0xF717, 0xF896, 0x0E31, 0xF710, 0xF884, 0x0E34, 0xF701, 0xF885, 0x0E35, 0xF702, 0xF886, 0x0E36, 0xF703, 0xF887, 0x0E37, 0xF704, 0xF888, 0x0E47, 0xF712, 0xF889, 0x0E4D, 0xF711, 0xF899 }
var RD_MAPPINGS = [6]u32{ 0x0E0D, 0xF70F, 0xF89A, 0x0E10, 0xF700, 0xF89E }

fn mapping(action: u32, i: usize) -> u32 {
    if action == SD { return SD_MAPPINGS[i] }
    if action == SDL { return SDL_MAPPINGS[i] }
    if action == SL { return SL_MAPPINGS[i] }
    return RD_MAPPINGS[i]
}

fn mappingCount(action: u32) -> usize {
    if action == SD { return 8 }
    if action == SDL { return 5 }
    if action == SL { return 12 }
    return 2
}

fn puaShape(u: u32, action: u32, f: usize) -> u32 {
    if action == NOP { return u }
    var i: usize = 0
    const n = mappingCount(action)
    while i < n {
        if mapping(action, i * 3) == u {
            var glyph: u32 = 0
            if font.getNominalGlyph(f, mapping(action, i * 3 + 1), &glyph) { return mapping(action, i * 3 + 1) }
            if font.getNominalGlyph(f, mapping(action, i * 3 + 2), &glyph) { return mapping(action, i * 3 + 2) }
            break
        }
        i += 1
    }
    return u
}

// Above-base states T0..T3 and below-base states B0..B2: per state and
// mark type, the action and the next state.
var ABOVE_START = [5]u32{ 0, 1, 0, 0, 3 }
var ABOVE = [24]u32{
    NOP, 3, NOP, 0, SD, 3,
    SL, 2, NOP, 1, SDL, 2,
    NOP, 3, NOP, 2, SL, 3,
    NOP, 3, NOP, 3, NOP, 3,
}
var BELOW_START = [5]u32{ 0, 0, 1, 2, 2 }
var BELOW = [18]u32{
    NOP, 0, NOP, 2, NOP, 0,
    NOP, 1, RD, 2, NOP, 1,
    NOP, 2, SD, 2, NOP, 2,
}

fn puaShaping(b: *buffer.Buffer, f: usize) -> void {
    var aboveState = ABOVE_START[4]
    var belowState = BELOW_START[4]
    var base: u32 = 0
    var i: u32 = 0
    while i < b.*.len {
        const g = buffer.info(b, i)
        const mt = markType(g.*.codepoint)
        if mt == NOT_MARK {
            const ct = consonantType(g.*.codepoint)
            aboveState = ABOVE_START[@intCast(usize, ct)]
            belowState = BELOW_START[@intCast(usize, ct)]
            base = i
            i += 1
            continue
        }
        const ae = @intCast(usize, aboveState * 6 + mt * 2)
        const be = @intCast(usize, belowState * 6 + mt * 2)
        aboveState = ABOVE[ae + 1]
        belowState = BELOW[be + 1]
        const action = if ABOVE[ae] != NOP { ABOVE[ae] } else { BELOW[be] }
        buffer.unsafeToBreak(b, base, i)
        if action == RD {
            buffer.info(b, base).*.codepoint = puaShape(buffer.info(b, base).*.codepoint, action, f)
        } else {
            g.*.codepoint = puaShape(g.*.codepoint, action, f)
        }
        i += 1
    }
}

fn isSaraAm(x: u32) -> bool { return (x & ~@intCast(u32, 0x80)) == 0x0E33 }

fn isAboveBaseMark(x_: u32) -> bool {
    const x = x_ & ~@intCast(u32, 0x80)
    return (x >= 0x0E34 && x <= 0x0E37) || (x >= 0x0E47 && x <= 0x0E4E) || x == 0x0E31 || x == 0x0E3B
}

pub fn preprocessText(pl: *plan.Plan, b: *buffer.Buffer, f: usize) -> void {
    buffer.clearOutput(b)
    const count = b.*.len
    var t: buffer.GlyphInfo = undefined
    b.*.idx = 0
    while b.*.idx < count {
        const u = buffer.cur(b).*.codepoint
        if !isSaraAm(u) {
            if !buffer.nextGlyph(b) { break }
            continue
        }
        _ = buffer.outputGlyph(b, u - 0x0E33 + 0x0E4D)
        p.setContinuation(buffer.prev(b))
        if !buffer.replaceGlyph(b, u - 1) { break }
        const end = b.*.outLen
        p.setGeneralCategory(buffer.outInfo(b, end - 2), unicode.GC_NON_SPACING_MARK)
        var start = end - 2
        while start > 0 && isAboveBaseMark(buffer.outInfo(b, start - 1).*.codepoint) { start -= 1 }
        if start + 2 < end {
            buffer.mergeOutClusters(b, start, end)
            buffer.copyInfo(&t, buffer.outInfo(b, end - 2))
            m.copy(b.*.outInfo + @intCast(usize, start + 1) * buffer.INFO_SIZE, b.*.outInfo + @intCast(usize, start) * buffer.INFO_SIZE, @intCast(usize, end - start - 2) * buffer.INFO_SIZE)
            buffer.copyInfo(buffer.outInfo(b, start), &t)
        } else {
            if start != 0 && b.*.clusterLevel == buffer.CLUSTER_MONOTONE_GRAPHEMES { buffer.mergeOutClusters(b, start - 1, end) }
        }
    }
    _ = buffer.sync(b)
    if pl.*.script == common.tag(84, 104, 97, 105) && !pl.*.map.foundScript0 { puaShaping(b, f) }
}
