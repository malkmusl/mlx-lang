// hb-unicode.h: Unicode functions objects (HarfBuzz's hb-unicode.cc), and
// the library's default ones, which ask std.unicode for the properties:
// general category, combining class, mirroring, script, canonical
// composition and decomposition (HarfBuzz's hb-ucd.cc and hb-icu.cc). Also the properties the shaper derives of them
// (hb-unicode.hh): the modified combining classes, default ignorables,
// the kinds of space, Extended_Pictographic.
const m = @import("./memory.mlx")
const o = @import("./object.mlx")
const common = @import("./common.mlx")

// The Unicode properties come from std.unicode (its property and
// normalization tables).
const uprops = @import("std.unicode.properties")
const unorm = @import("std.unicode.normalize")
const utables = @import("std.unicode.tables")

// HarfBuzz's general categories.
pub const GC_CONTROL: u32 = 0
pub const GC_FORMAT: u32 = 1
pub const GC_UNASSIGNED: u32 = 2
pub const GC_PRIVATE_USE: u32 = 3
pub const GC_SURROGATE: u32 = 4
pub const GC_LOWERCASE_LETTER: u32 = 5
pub const GC_MODIFIER_LETTER: u32 = 6
pub const GC_OTHER_LETTER: u32 = 7
pub const GC_TITLECASE_LETTER: u32 = 8
pub const GC_UPPERCASE_LETTER: u32 = 9
pub const GC_SPACING_MARK: u32 = 10
pub const GC_ENCLOSING_MARK: u32 = 11
pub const GC_NON_SPACING_MARK: u32 = 12
pub const GC_DECIMAL_NUMBER: u32 = 13
pub const GC_LETTER_NUMBER: u32 = 14
pub const GC_OTHER_NUMBER: u32 = 15
pub const GC_CONNECT_PUNCTUATION: u32 = 16
pub const GC_DASH_PUNCTUATION: u32 = 17
pub const GC_CLOSE_PUNCTUATION: u32 = 18
pub const GC_FINAL_PUNCTUATION: u32 = 19
pub const GC_INITIAL_PUNCTUATION: u32 = 20
pub const GC_OTHER_PUNCTUATION: u32 = 21
pub const GC_OPEN_PUNCTUATION: u32 = 22
pub const GC_CURRENCY_SYMBOL: u32 = 23
pub const GC_MODIFIER_SYMBOL: u32 = 24
pub const GC_MATH_SYMBOL: u32 = 25
pub const GC_OTHER_SYMBOL: u32 = 26
pub const GC_LINE_SEPARATOR: u32 = 27
pub const GC_PARAGRAPH_SEPARATOR: u32 = 28
pub const GC_SPACE_SEPARATOR: u32 = 29

pub fn flag(x: u32) -> u32 { return if x < 32 { @intCast(u32, 1) << @intCast(u5, x) } else { 0 } }
pub fn flag64(x: u32) -> u64 { return if x < 64 { @intCast(u64, 1) << @intCast(u6, x) } else { 0 } }

pub fn isMark(gc: u32) -> bool { return (flag(gc) & (flag(GC_SPACING_MARK) | flag(GC_ENCLOSING_MARK) | flag(GC_NON_SPACING_MARK))) != 0 }
pub fn isLetter(gc: u32) -> bool { return (flag(gc) & (flag(GC_LOWERCASE_LETTER) | flag(GC_MODIFIER_LETTER) | flag(GC_OTHER_LETTER) | flag(GC_TITLECASE_LETTER) | flag(GC_UPPERCASE_LETTER))) != 0 }

// The functions object: the header, the parent, and for each of the eight
// functions (combining class, East Asian width, general category,
// mirroring, script, compose, decompose, compatibility decomposition) the
// function (BUILTIN: the library's own; NIL: none, the empty object's
// answer), its user data and its destroy function.
pub const NIL: usize = 0
pub const BUILTIN: usize = 1

pub const F_COMBINING_CLASS: usize = 0
pub const F_EASTASIAN_WIDTH: usize = 1
pub const F_GENERAL_CATEGORY: usize = 2
pub const F_MIRRORING: usize = 3
pub const F_SCRIPT: usize = 4
pub const F_COMPOSE: usize = 5
pub const F_DECOMPOSE: usize = 6
pub const F_DECOMPOSE_COMPATIBILITY: usize = 7

pub const FUNCS_SIZE: usize = 24 + 8 + 3 * 8 * 8

fn funcAt(u: usize, i: usize) -> usize { return m.getWord(u + 32 + i * 8) }
fn dataAt(u: usize, i: usize) -> usize { return m.getWord(u + 96 + i * 8) }
fn destroyAt(u: usize, i: usize) -> usize { return m.getWord(u + 160 + i * 8) }

var emptyFuncs: usize = 0
var defaultFuncs: usize = 0

pub fn getEmpty() -> usize {
    var e = m.atomicLoadWord(@intFromPtr(&emptyFuncs))
    if e == 0 {
        const made = o.createInert(FUNCS_SIZE)
        if !m.swapWord(@intFromPtr(&emptyFuncs), 0, made) { m.release(made) }
        e = m.atomicLoadWord(@intFromPtr(&emptyFuncs))
    }
    return e
}

pub fn getDefault() -> usize {
    var d = m.atomicLoadWord(@intFromPtr(&defaultFuncs))
    if d == 0 {
        const made = o.createInert(FUNCS_SIZE)
        m.putWord(made + 24, getEmpty())
        var i: usize = 0
        while i < 8 {
            if i != F_EASTASIAN_WIDTH && i != F_DECOMPOSE_COMPATIBILITY { m.putWord(made + 32 + i * 8, BUILTIN) }
            i += 1
        }
        if !m.swapWord(@intFromPtr(&defaultFuncs), 0, made) { m.release(made) }
        d = m.atomicLoadWord(@intFromPtr(&defaultFuncs))
    }
    return d
}

// hb-icu.h: ICU's script codes (std.unicode's, those of libmlxunicode) as
// HarfBuzz scripts and back, and the functions object of HarfBuzz's ICU
// functions: the library's own (the same data), parented by the empty
// object as HarfBuzz's are.
pub fn icuScriptToScript(code: i32) -> u32 {
    if code < 0 || code >= @intCast(i32, utables.SCRIPT_COUNT) { return common.SCRIPT_INVALID }
    const name = uprops.scriptCodeName(@intCast(u32, code))
    return common.scriptFromIso15924Tag(common.tagFromString(@intFromPtr(name.pointer), @intCast(i64, name.length)))
}

pub fn icuScriptFromScript(script: u32) -> i32 {
    if script == common.SCRIPT_INVALID { return -1 }
    var i: i32 = 0
    while i < @intCast(i32, utables.SCRIPT_COUNT) {
        if icuScriptToScript(i) == script { return i }
        i += 1
    }
    // USCRIPT_UNKNOWN
    return 103
}

var icuFuncs: usize = 0

pub fn icuGetUnicodeFuncs() -> usize {
    var f = m.atomicLoadWord(@intFromPtr(&icuFuncs))
    if f == 0 {
        const made = o.createInert(FUNCS_SIZE)
        m.putWord(made + 24, getEmpty())
        var i: usize = 0
        while i < 8 {
            if i != F_EASTASIAN_WIDTH && i != F_DECOMPOSE_COMPATIBILITY { m.putWord(made + 32 + i * 8, BUILTIN) }
            i += 1
        }
        if !m.swapWord(@intFromPtr(&icuFuncs), 0, made) { m.release(made) }
        f = m.atomicLoadWord(@intFromPtr(&icuFuncs))
    }
    return f
}

pub fn unicodeFuncsGetDefault() -> usize { return getDefault() }
pub fn unicodeFuncsGetEmpty() -> usize { return getEmpty() }

pub fn unicodeFuncsCreate(parent_: usize) -> usize {
    const u = o.create(FUNCS_SIZE)
    if u == 0 { return getEmpty() }
    var parent = parent_
    if parent == 0 { parent = getEmpty() }
    o.makeImmutable(parent)
    m.putWord(u + 24, o.reference(parent))
    // (The parent's functions and user data, not its destroy functions.)
    m.copy(u + 32, parent + 32, 128)
    return u
}

pub fn unicodeFuncsReference(u: usize) -> usize { return o.reference(u) }

pub fn unicodeFuncsDestroy(u: usize) -> void { destroyFuncs(u) }

pub fn destroyFuncs(u: usize) -> void {
    if !o.destroy(u) { return }
    var i: usize = 0
    while i < 8 {
        o.callDestroy(destroyAt(u, i), dataAt(u, i))
        i += 1
    }
    destroyFuncs(m.getWord(u + 24))
    m.release(u)
}

pub fn unicodeFuncsSetUserData(u: usize, key: usize, data: usize, destroy: usize, replace: i32) -> i32 { return if o.setUserData(u, key, data, destroy, replace != 0) { 1 } else { 0 } }
pub fn unicodeFuncsGetUserData(u: usize, key: usize) -> usize { return o.getUserData(u, key) }
pub fn unicodeFuncsMakeImmutable(u: usize) -> void { o.makeImmutable(u) }
pub fn unicodeFuncsIsImmutable(u: usize) -> i32 { return if o.isImmutable(u) { 1 } else { 0 } }

pub fn unicodeFuncsGetParent(u: usize) -> usize {
    const parent = m.getWord(u + 24)
    return if parent != 0 { parent } else { getEmpty() }
}

fn setFunc(u: usize, i: usize, func: usize, userData_: usize, destroy_: usize) -> void {
    var userData = userData_
    var destroy = destroy_
    if o.isImmutable(u) {
        o.callDestroy(destroy, userData)
        return
    }
    const parent = m.getWord(u + 24)
    if func == 0 {
        o.callDestroy(destroy, userData)
        destroy = 0
        userData = if parent != 0 { dataAt(parent, i) } else { 0 }
    }
    o.callDestroy(destroyAt(u, i), dataAt(u, i))
    m.putWord(u + 32 + i * 8, if func != 0 { func } else if parent != 0 { funcAt(parent, i) } else { NIL })
    m.putWord(u + 96 + i * 8, userData)
    m.putWord(u + 160 + i * 8, destroy)
}

pub fn unicodeFuncsSetCombiningClassFunc(u: usize, func: usize, data: usize, destroy: usize) -> void { setFunc(u, F_COMBINING_CLASS, func, data, destroy) }
pub fn unicodeFuncsSetEastasianWidthFunc(u: usize, func: usize, data: usize, destroy: usize) -> void { setFunc(u, F_EASTASIAN_WIDTH, func, data, destroy) }
pub fn unicodeFuncsSetGeneralCategoryFunc(u: usize, func: usize, data: usize, destroy: usize) -> void { setFunc(u, F_GENERAL_CATEGORY, func, data, destroy) }
pub fn unicodeFuncsSetMirroringFunc(u: usize, func: usize, data: usize, destroy: usize) -> void { setFunc(u, F_MIRRORING, func, data, destroy) }
pub fn unicodeFuncsSetScriptFunc(u: usize, func: usize, data: usize, destroy: usize) -> void { setFunc(u, F_SCRIPT, func, data, destroy) }
pub fn unicodeFuncsSetComposeFunc(u: usize, func: usize, data: usize, destroy: usize) -> void { setFunc(u, F_COMPOSE, func, data, destroy) }
pub fn unicodeFuncsSetDecomposeFunc(u: usize, func: usize, data: usize, destroy: usize) -> void { setFunc(u, F_DECOMPOSE, func, data, destroy) }
pub fn unicodeFuncsSetDecomposeCompatibilityFunc(u: usize, func: usize, data: usize, destroy: usize) -> void { setFunc(u, F_DECOMPOSE_COMPATIBILITY, func, data, destroy) }

// ---------------------------------------------------------------------------
// The library's own functions, over ICU's API.

// ICU's general categories (UCharCategory) as HarfBuzz's.
fn categoryOfIcu(c: i32) -> u32 {
    const map = [_]u8{
        2, 9, 5, 8, 6, 7, 12, 11, 10, 13, 14, 15, 29, 27, 28, 0,
        1, 3, 4, 17, 22, 18, 16, 21, 25, 23, 24, 26, 20, 19,
    }
    if c < 0 || c >= 30 { return GC_UNASSIGNED }
    return @intCast(u32, map[@intCast(usize, c)])
}

pub fn builtinGeneralCategory(u: u32) -> u32 {
    if u > 0x10FFFF { return GC_UNASSIGNED }
    return categoryOfIcu(@intCast(i32, uprops.category(@bitCast(i32, u))))
}

pub fn builtinCombiningClass(u: u32) -> u32 {
    if u > 0x10FFFF { return 0 }
    return uprops.combiningClass(@bitCast(i32, u))
}

pub fn builtinMirroring(u: u32) -> u32 {
    if u > 0x10FFFF { return u }
    return @bitCast(u32, uprops.mirror(@bitCast(i32, u)))
}

// ICU's script codes as HarfBuzz's scripts (their ISO 15924 tags), made
// once.
var scriptTable: [256]u32 = undefined
var scriptTableReady: u32 = 0

fn scriptOfIcu(code: i32) -> u32 {
    if m.atomicLoad32(@intFromPtr(&scriptTableReady)) == 0 {
        var i: i32 = 0
        while i < 256 {
            var value = common.SCRIPT_UNKNOWN
            if @intCast(usize, i) < utables.SCRIPT_COUNT {
                const name = uprops.wordOf(utables.SCRIPT_NAMES, @intCast(usize, i), 0)
                if name.length == 4 { value = common.scriptFromIso15924Tag(common.tagFromString(@intFromPtr(name.pointer), 4)) }
            }
            scriptTable[@intCast(usize, i)] = value
            i += 1
        }
        m.atomicStore32(@intFromPtr(&scriptTableReady), 1)
    }
    if code < 0 || code >= 256 { return common.SCRIPT_UNKNOWN }
    return scriptTable[@intCast(usize, code)]
}

pub fn builtinScript(u: u32) -> u32 {
    if u > 0x10FFFF { return common.SCRIPT_UNKNOWN }
    return scriptOfIcu(@intCast(i32, uprops.script(@bitCast(i32, u))))
}

const SBASE: u32 = 0xAC00
const LBASE: u32 = 0x1100
const VBASE: u32 = 0x1161
const TBASE: u32 = 0x11A7
const SCOUNT: u32 = 11172
const LCOUNT: u32 = 19
const VCOUNT: u32 = 21
const TCOUNT: u32 = 28
const NCOUNT: u32 = 588

pub fn builtinCompose(a: u32, b: u32, ab: *u32) -> bool {
    if a >= SBASE && a < SBASE + SCOUNT && b > TBASE && b < TBASE + TCOUNT && (a - SBASE) % TCOUNT == 0 {
        ab.* = a + (b - TBASE)
        return true
    }
    if a >= LBASE && a < LBASE + LCOUNT && b >= VBASE && b < VBASE + VCOUNT {
        ab.* = SBASE + (a - LBASE) * NCOUNT + (b - VBASE) * TCOUNT
        return true
    }
    if a > 0x10FFFF || b > 0x10FFFF { return false }
    const r = unorm.composePair(@bitCast(i32, a), @bitCast(i32, b))
    if r <= 0 { return false }
    ab.* = @bitCast(u32, r)
    return true
}

pub fn builtinDecompose(ab: u32, a: *u32, b: *u32) -> bool {
    if ab >= SBASE && ab < SBASE + SCOUNT {
        const si = ab - SBASE
        if si % TCOUNT != 0 {
            a.* = SBASE + (si / TCOUNT) * TCOUNT
            b.* = TBASE + si % TCOUNT
        } else {
            a.* = LBASE + si / NCOUNT
            b.* = VBASE + (si % NCOUNT) / TCOUNT
        }
        return true
    }
    if ab > 0x10FFFF { return false }
    // The canonical decomposition, one or two characters.
    const found = uprops.canonicalDecomposition(@bitCast(i32, ab))
    if found == 0 { return false }
    const info = utables.DECOMPOSITION_INFO[found - 1]
    const offset = @intCast(usize, info & 16777215)
    const count = @intCast(usize, (info >> 24) & 127)
    if count == 0 || count > 2 { return false }
    var cps: [2]u32 = [_]u32{ utables.DECOMPOSITION_DATA[offset], 0 }
    if count == 2 { cps[1] = utables.DECOMPOSITION_DATA[offset + 1] }
    if count == 1 {
        a.* = cps[0]
        b.* = 0
        return true
    }
    if count == 2 {
        a.* = cps[0]
        b.* = cps[1]
        return true
    }
    return false
}

pub fn isExtendedPictographic(u: u32) -> bool {
    if u > 0x10FFFF { return false }
    return uprops.hasBinary(@bitCast(i32, u), 64)
}

// ---------------------------------------------------------------------------
// Calls through an object (the object's own functions, or a program's).

pub const SimpleFunc = fn(usize, u32, usize) -> u32
pub const ComposeFunc = fn(usize, u32, u32, usize, usize) -> i32
pub const DecomposeFunc = fn(usize, u32, usize, usize, usize) -> i32
pub const DecomposeCompatFunc = fn(usize, u32, usize, usize) -> u32

fn callSimple(u: usize, i: usize, c: u32) -> u32 {
    const call: SimpleFunc = unsafe { @ptrFromInt(SimpleFunc, funcAt(u, i)) }
    return call(u, c, dataAt(u, i))
}

pub fn generalCategory(u: usize, c: u32) -> u32 {
    const f = funcAt(u, F_GENERAL_CATEGORY)
    if f == BUILTIN { return builtinGeneralCategory(c) }
    if f == NIL { return GC_OTHER_LETTER }
    return callSimple(u, F_GENERAL_CATEGORY, c) & 0xFF
}

pub fn combiningClass(u: usize, c: u32) -> u32 {
    const f = funcAt(u, F_COMBINING_CLASS)
    if f == BUILTIN { return builtinCombiningClass(c) }
    if f == NIL { return 0 }
    return callSimple(u, F_COMBINING_CLASS, c) & 0xFF
}

pub fn mirroring(u: usize, c: u32) -> u32 {
    const f = funcAt(u, F_MIRRORING)
    if f == BUILTIN { return builtinMirroring(c) }
    if f == NIL { return c }
    return callSimple(u, F_MIRRORING, c)
}

pub fn script(u: usize, c: u32) -> u32 {
    const f = funcAt(u, F_SCRIPT)
    if f == BUILTIN { return builtinScript(c) }
    if f == NIL { return common.SCRIPT_UNKNOWN }
    return callSimple(u, F_SCRIPT, c)
}

pub fn eastasianWidth(u: usize, c: u32) -> u32 {
    const f = funcAt(u, F_EASTASIAN_WIDTH)
    if f == BUILTIN || f == NIL { return 1 }
    return callSimple(u, F_EASTASIAN_WIDTH, c)
}

pub fn compose(u: usize, a: u32, b: u32, ab: *u32) -> bool {
    ab.* = 0
    if a == 0 || b == 0 { return false }
    const f = funcAt(u, F_COMPOSE)
    if f == BUILTIN { return builtinCompose(a, b, ab) }
    if f == NIL { return false }
    const call: ComposeFunc = unsafe { @ptrFromInt(ComposeFunc, f) }
    return call(u, a, b, @intFromPtr(ab), dataAt(u, F_COMPOSE)) != 0
}

pub fn decompose(u: usize, ab: u32, a: *u32, b: *u32) -> bool {
    a.* = ab
    b.* = 0
    const f = funcAt(u, F_DECOMPOSE)
    if f == BUILTIN { return builtinDecompose(ab, a, b) }
    if f == NIL { return false }
    const call: DecomposeFunc = unsafe { @ptrFromInt(DecomposeFunc, f) }
    return call(u, ab, @intFromPtr(a), @intFromPtr(b), dataAt(u, F_DECOMPOSE)) != 0
}

// The compatibility decomposition into `decomposed` (19 codepoints); its
// length.
pub fn decomposeCompatibility(u: usize, c: u32, decomposed: usize) -> u32 {
    const f = funcAt(u, F_DECOMPOSE_COMPATIBILITY)
    var ret: u32 = 0
    if f != BUILTIN && f != NIL {
        const call: DecomposeCompatFunc = unsafe { @ptrFromInt(DecomposeCompatFunc, f) }
        ret = call(u, c, decomposed, dataAt(u, F_DECOMPOSE_COMPATIBILITY))
    }
    if ret == 1 && c == m.get32(decomposed) {
        m.put32(decomposed, 0)
        return 0
    }
    if ret > 18 { ret = 18 }
    m.put32(decomposed + @intCast(usize, ret) * 4, 0)
    return ret
}

pub fn unicodeCombiningClass(u: usize, c: u32) -> u32 { return combiningClass(u, c) }
pub fn unicodeGeneralCategory(u: usize, c: u32) -> u32 { return generalCategory(u, c) }
pub fn unicodeMirroring(u: usize, c: u32) -> u32 { return mirroring(u, c) }
pub fn unicodeScript(u: usize, c: u32) -> u32 { return script(u, c) }
pub fn unicodeEastasianWidth(u: usize, c: u32) -> u32 { return eastasianWidth(u, c) }
pub fn unicodeCompose(u: usize, a: u32, b: u32, ab: usize) -> i32 { return if compose(u, a, b, unsafe { @ptrFromInt(*u32, ab) }) { 1 } else { 0 } }
pub fn unicodeDecompose(u: usize, ab: u32, a: usize, b: usize) -> i32 { return if decompose(u, ab, unsafe { @ptrFromInt(*u32, a) }, unsafe { @ptrFromInt(*u32, b) }) { 1 } else { 0 } }
pub fn unicodeDecomposeCompatibility(u: usize, c: u32, decomposed: usize) -> u32 { return decomposeCompatibility(u, c, decomposed) }

// ---------------------------------------------------------------------------
// What the shaper derives of the properties (hb-unicode.hh).

// The combining classes reordered as HarfBuzz reorders marks: Hebrew in
// the order of the SBL Hebrew manual, Arabic's shadda first, Telugu's
// length marks, Thai's sara u/uu before the phinthu, Tibetan's vowels.
pub fn modifiedCombiningClass(u: usize, c: u32) -> u32 {
    if c == 0x1A60 { return 254 }
    if c == 0x0FC6 { return 254 }
    if c == 0x0F39 { return 127 }
    const ccc = combiningClass(u, c)
    if ccc >= 10 && ccc <= 26 {
        const hebrew = [_]u8{ 22, 15, 16, 17, 23, 18, 19, 20, 21, 14, 24, 12, 25, 13, 10, 11, 26 }
        return @intCast(u32, hebrew[@intCast(usize, ccc - 10)])
    }
    if ccc >= 27 && ccc <= 33 {
        const arabic = [_]u8{ 28, 29, 30, 31, 32, 33, 27 }
        return @intCast(u32, arabic[@intCast(usize, ccc - 27)])
    }
    if ccc == 84 { return 4 }
    if ccc == 91 { return 5 }
    if ccc == 103 { return 3 }
    if ccc == 130 { return 132 }
    if ccc == 132 { return 131 }
    return ccc
}

pub fn isVariationSelector(c: u32) -> bool { return (c >= 0xFE00 && c <= 0xFE0F) || (c >= 0xE0100 && c <= 0xE01EF) }

pub fn isDefaultIgnorable(ch: u32) -> bool {
    const plane = ch >> 16
    if plane == 0 {
        const page = ch >> 8
        if page == 0x00 { return ch == 0x00AD }
        if page == 0x03 { return ch == 0x034F }
        if page == 0x06 { return ch == 0x061C }
        if page == 0x17 { return ch >= 0x17B4 && ch <= 0x17B5 }
        if page == 0x18 { return ch >= 0x180B && ch <= 0x180E }
        if page == 0x20 { return (ch >= 0x200B && ch <= 0x200F) || (ch >= 0x202A && ch <= 0x202E) || (ch >= 0x2060 && ch <= 0x206F) }
        if page == 0xFE { return (ch >= 0xFE00 && ch <= 0xFE0F) || ch == 0xFEFF }
        if page == 0xFF { return ch >= 0xFFF0 && ch <= 0xFFF8 }
        return false
    }
    if plane == 0x01 { return ch >= 0x1D173 && ch <= 0x1D17A }
    if plane == 0x0E { return ch >= 0xE0000 && ch <= 0xE0FFF }
    return false
}

// The kinds of space (hb_unicode_funcs_t::space_t).
pub const NOT_SPACE: u32 = 0
pub const SPACE_EM: u32 = 1
pub const SPACE_EM_2: u32 = 2
pub const SPACE_EM_3: u32 = 3
pub const SPACE_EM_4: u32 = 4
pub const SPACE_EM_5: u32 = 5
pub const SPACE_EM_6: u32 = 6
pub const SPACE_EM_16: u32 = 16
pub const SPACE_4_EM_18: u32 = 17
pub const SPACE: u32 = 18
pub const SPACE_FIGURE: u32 = 19
pub const SPACE_PUNCTUATION: u32 = 20
pub const SPACE_NARROW: u32 = 21

pub fn spaceFallbackType(c: u32) -> u32 {
    if c == 0x20 || c == 0xA0 { return SPACE }
    if c == 0x2000 || c == 0x2002 { return SPACE_EM_2 }
    if c == 0x2001 || c == 0x2003 || c == 0x3000 { return SPACE_EM }
    if c == 0x2004 { return SPACE_EM_3 }
    if c == 0x2005 { return SPACE_EM_4 }
    if c == 0x2006 { return SPACE_EM_6 }
    if c == 0x2007 { return SPACE_FIGURE }
    if c == 0x2008 { return SPACE_PUNCTUATION }
    if c == 0x2009 { return SPACE_EM_5 }
    if c == 0x200A { return SPACE_EM_16 }
    if c == 0x202F { return SPACE_NARROW }
    if c == 0x205F { return SPACE_4_EM_18 }
    return NOT_SPACE
}
