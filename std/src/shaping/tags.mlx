// OpenType script and language system tags (HarfBuzz's hb-ot-tag.cc): the
// tags of a script (the new Indic ones first: 'dev3', 'dev2', 'deva'), of a
// BCP 47 language (with tagtable.mlx's data), the private-use subtags
// "-hbsc-" and "-hbot-" that name tags directly, and back.
const m = @import("./memory.mlx")
const common = @import("./common.mlx")
const tagtable = @import("./tagtable.mlx")

pub const TAG_DEFAULT_SCRIPT: u32 = 0x44464C54
pub const TAG_DEFAULT_LANGUAGE: u32 = 0x64666C74
const TAG_MATH_SCRIPT: u32 = 0x6D617468

pub const MAX_TAGS_PER_SCRIPT: u32 = 3
pub const MAX_TAGS_PER_LANGUAGE: u32 = 3

fn t4(a: u8, b: u8, c: u8, d: u8) -> u32 { return common.tag(a, b, c, d) }

fn oldTagFromScript(script: u32) -> u32 {
    if script == 0 { return TAG_DEFAULT_SCRIPT }
    if script == t4(90, 109, 116, 104) { return TAG_MATH_SCRIPT }
    if script == t4(72, 105, 114, 97) { return t4(107, 97, 110, 97) }
    if script == t4(76, 97, 111, 111) { return t4(108, 97, 111, 32) }
    if script == t4(89, 105, 105, 105) { return t4(121, 105, 32, 32) }
    if script == t4(78, 107, 111, 111) { return t4(110, 107, 111, 32) }
    if script == t4(86, 97, 105, 105) { return t4(118, 97, 105, 32) }
    return script | 0x20000000
}

fn oldTagToScript(tag_: u32) -> u32 {
    var tag = tag_
    if tag == TAG_DEFAULT_SCRIPT { return 0 }
    if tag == TAG_MATH_SCRIPT { return t4(90, 109, 116, 104) }
    if (tag & 0x0000FF00) == 0x00002000 { tag |= (tag >> 8) & 0x0000FF00 }
    if (tag & 0x000000FF) == 0x00000020 { tag |= (tag >> 8) & 0x000000FF }
    return tag & ~@intCast(u32, 0x20000000)
}

// The scripts with Indic-2 tags, and those tags.
var NEW_SCRIPTS = [10]u32{ 0x42656E67, 0x44657661, 0x47756A72, 0x47757275, 0x4B6E6461, 0x4D6C796D, 0x4F727961, 0x54616D6C, 0x54656C75, 0x4D796D72 }
var NEW_TAGS = [10]u32{ 0x626E6732, 0x64657632, 0x676A7232, 0x67757232, 0x6B6E6432, 0x6D6C6D32, 0x6F727932, 0x746D6C32, 0x74656C32, 0x6D796D32 }

fn newTagFromScript(script: u32) -> u32 {
    var i: usize = 0
    while i < 10 {
        if NEW_SCRIPTS[i] == script { return NEW_TAGS[i] }
        i += 1
    }
    return TAG_DEFAULT_SCRIPT
}

fn newTagToScript(tag: u32) -> u32 {
    var i: usize = 0
    while i < 10 {
        if NEW_TAGS[i] == tag { return NEW_SCRIPTS[i] }
        i += 1
    }
    return common.SCRIPT_UNKNOWN
}

fn allTagsFromScript(script: u32, count: usize, tags: usize) -> void {
    var i: u32 = 0
    const want = m.get32(count)
    const newTag = newTagFromScript(script)
    if newTag != TAG_DEFAULT_SCRIPT {
        if newTag != 0x6D796D32 {
            m.put32(tags, newTag | 0x33)
            i += 1
        }
        if want > i {
            m.put32(tags + @intCast(usize, i) * 4, newTag)
            i += 1
        }
    }
    if want > i {
        const old = oldTagFromScript(script)
        if old != TAG_DEFAULT_SCRIPT {
            m.put32(tags + @intCast(usize, i) * 4, old)
            i += 1
        }
    }
    m.put32(count, i)
}

pub fn tagToScript(tag: u32) -> u32 {
    const digit = tag & 0xFF
    if digit == 0x32 || digit == 0x33 { return newTagToScript(tag & 0xFFFFFF32) }
    return oldTagToScript(tag)
}

fn isAlnum(c: u8) -> bool { return m.isAlpha(c) || m.isDigit(c) }

// The first occurrence of `c` in the C string at `s` (0: none).
fn findChar(s: usize, c: u8) -> usize {
    var p = s
    while true {
        const ch = m.get8(p)
        if ch == c { return p }
        if ch == 0 { return 0 }
        p += 1
    }
    return 0
}

// The first occurrence of the bytes of `word` in the C string at `s`.
fn findString(s: usize, word: []const u8) -> usize {
    var p = s
    while m.get8(p) != 0 {
        var k: usize = 0
        while k < word.length && m.get8(p + k) == word[k] { k += 1 }
        if k == word.length { return p }
        p += 1
    }
    return if word.length == 0 { s } else { 0 }
}

fn subtagMatches(langStr_: usize, limit: usize, subtag: []const u8) -> bool {
    var langStr = langStr_
    if limit < langStr || limit - langStr < subtag.length { return false }
    while true {
        const s = findString(langStr, subtag)
        if s == 0 || s >= limit { return false }
        if !isAlnum(m.get8(s + subtag.length)) { return true }
        langStr = s + subtag.length
    }
    return false
}

fn langMatches(langStr: usize, limit: usize, spec: []const u8) -> bool {
    if limit < langStr || limit - langStr < spec.length { return false }
    var k: usize = 0
    while k < spec.length {
        if m.get8(langStr + k) != spec[k] { return false }
        k += 1
    }
    const after = m.get8(langStr + spec.length)
    return after == 0 || after == 45
}

// Whether the C string at `s` is `word` exactly.
fn cIs(s: usize, word: []const u8) -> bool {
    var k: usize = 0
    while k < word.length {
        if m.get8(s + k) != word[k] { return false }
        k += 1
    }
    return m.get8(s + word.length) == 0
}

fn cStarts(s: usize, word: []const u8) -> bool {
    var k: usize = 0
    while k < word.length {
        if m.get8(s + k) != word[k] { return false }
        k += 1
    }
    return true
}

fn hexValue(c: u8) -> u32 {
    if c >= 48 && c <= 57 { return @intCast(u32, c - 48) }
    if c >= 97 && c <= 102 { return @intCast(u32, c - 87) }
    if c >= 65 && c <= 70 { return @intCast(u32, c - 55) }
    return 16
}

// The field of `line` from position `start` up to a tab or newline.
fn fieldEnd(text: []const u8, start: usize) -> usize {
    var i = start
    while i < text.length && text[i] != 9 && text[i] != 10 { i += 1 }
    return i
}

// Writes the hexadecimal tags of `text[start..end]` (comma-separated) to
// `tags`, at most `*count`; their count in `*count`.
fn writeTags(text: []const u8, start: usize, end: usize, count: usize, tags: usize) -> void {
    const room = m.get32(count)
    var n: u32 = 0
    var i = start
    while i < end && n < room {
        var v: u32 = 0
        var k: usize = 0
        while k < 8 {
            v = (v << 4) | hexValue(text[i + k])
            k += 1
        }
        m.put32(tags + @intCast(usize, n) * 4, v)
        n += 1
        i += 9
    }
    // (A rule of one tag writes it whatever the room, as HarfBuzz's do.)
    if n == 0 && end > start {
        var v: u32 = 0
        var k: usize = 0
        while k < 8 {
            v = (v << 4) | hexValue(text[start + k])
            k += 1
        }
        m.put32(tags, v)
        n = 1
    }
    m.put32(count, n)
}

fn tagsFromComplexLanguage(langStr: usize, limit: usize, count: usize, tags: usize) -> bool {
    const text = tagtable.COMPLEX
    const first = m.get8(langStr)
    var hyphen: usize = 0
    var prefixOk = false
    if limit - langStr >= 7 {
        hyphen = findChar(langStr, 45)
        prefixOk = hyphen != 0 && hyphen < limit && limit - hyphen >= 5
    }
    var i: usize = 0
    while i < text.length {
        const kind = text[i]
        const letter = text[i + 2]
        const s1 = i + 4
        const s1End = fieldEnd(text, s1)
        const s2 = s1End + 1
        const s2End = fieldEnd(text, s2)
        const tagsAt = s2End + 1
        const tagsEnd = fieldEnd(text, tagsAt)
        var hit = false
        if kind == 112 {
            hit = prefixOk && subtagMatches(hyphen, limit, text[s1..s1End])
        } else if letter == first {
            if kind == 108 {
                hit = langMatches(langStr + 1, limit, text[s1..s1End])
            } else if kind == 110 {
                hit = cStarts(langStr + 1, text[s1..s1End]) && subtagMatches(langStr, limit, text[s2..s2End])
            } else if kind == 115 {
                hit = cIs(langStr + 1, text[s1..s1End])
            }
        }
        if hit {
            writeTags(text, tagsAt, tagsEnd, count, tags)
            return true
        }
        i = tagsEnd + 1
    }
    return false
}

fn findLanguage(table: usize, pairs: usize, tag: u32) -> i64 {
    var lo: i64 = 0
    var hi: i64 = @intCast(i64, pairs) - 1
    while lo <= hi {
        const mid = @intCast(i64, (@intCast(u64, lo) + @intCast(u64, hi)) / 2)
        const v = m.get32(table + @intCast(usize, mid) * 8)
        if tag < v {
            hi = mid - 1
        } else if tag > v {
            lo = mid + 1
        } else {
            return mid
        }
    }
    return -1
}

fn tagsFromLanguage(langStr_: usize, limit: usize, count: usize, tags: usize) -> void {
    var langStr = langStr_
    if tagsFromComplexLanguage(langStr, limit, count, tags) { return }
    const s = findChar(langStr, 45)
    if s != 0 && limit - langStr >= 6 {
        const extlangEnd = findChar(s + 1, 45)
        const extLen = if extlangEnd != 0 { extlangEnd - s - 1 } else { m.cLength(s + 1) }
        if extLen == 3 && m.isAlpha(m.get8(s + 1)) { langStr = s + 1 }
    }
    const dash = findChar(langStr, 45)
    const firstLen = if dash != 0 { dash - langStr } else { limit - langStr }
    var table: usize = 0
    var pairs: usize = 0
    if firstLen == 2 {
        table = @intFromPtr(&tagtable.LANGUAGES2)
        pairs = tagtable.LANGUAGES2.length / 2
    } else if firstLen == 3 {
        table = @intFromPtr(&tagtable.LANGUAGES3)
        pairs = tagtable.LANGUAGES3.length / 2
    }
    const langTag = common.tagFromString(langStr, @intCast(i64, firstLen))
    if table != 0 {
        var index = findLanguage(table, pairs, langTag)
        if index >= 0 {
            while index != 0 && m.get32(table + @intCast(usize, index) * 8) == m.get32(table + @intCast(usize, index - 1) * 8) { index -= 1 }
            const want = m.get32(count)
            var i: u32 = 0
            while i < want && @intCast(usize, index) + @intCast(usize, i) < pairs {
                const at = table + (@intCast(usize, index) + @intCast(usize, i)) * 8
                if m.get32(at + 4) == 0 || m.get32(at) != m.get32(table + @intCast(usize, index) * 8) { break }
                m.put32(tags + @intCast(usize, i) * 4, m.get32(at + 4))
                i += 1
            }
            m.put32(count, i)
            return
        }
    }
    const end = if s != 0 { s } else { langStr + m.cLength(langStr) }
    if end >= langStr && end - langStr == 3 {
        m.put32(tags, common.tagFromString(langStr, 3) & ~@intCast(u32, 0x20202000))
        m.put32(count, 1)
        return
    }
    m.put32(count, 0)
}

fn upper(c: u8) -> u8 { return if c >= 97 && c <= 122 { c - 32 } else { c } }

fn parsePrivateUseSubtag(subtag: usize, count: usize, tags: usize, prefix: []const u8, toUpper: bool) -> bool {
    if subtag == 0 || count == 0 || tags == 0 || m.get32(count) == 0 { return false }
    var s = findString(subtag, prefix)
    if s == 0 { return false }
    var tag: [4]u8 = [_]u8{ 0, 0, 0, 0 }
    s += prefix.length
    if m.get8(s) == 45 {
        s += 1
        var i: usize = 0
        while i < 8 && hexValue(m.get8(s + i)) < 16 {
            const v = @intCast(u8, hexValue(m.get8(s + i)))
            if i % 2 == 0 {
                tag[i / 2] = v << 4
            } else {
                tag[i / 2] +%= v
            }
            i += 1
        }
        if i != 8 { return false }
    } else {
        var i: usize = 0
        while i < 4 && isAlnum(m.get8(s + i)) {
            tag[i] = if toUpper { upper(m.get8(s + i)) } else { m.lower(m.get8(s + i)) }
            i += 1
        }
        if i == 0 { return false }
        while i < 4 {
            tag[i] = 32
            i += 1
        }
    }
    var value = common.tag(tag[0], tag[1], tag[2], tag[3])
    if (value & 0xDFDFDFDF) == TAG_DEFAULT_SCRIPT { value ^= ~@intCast(u32, 0xDFDFDFDF) }
    m.put32(tags, value)
    m.put32(count, 1)
    return true
}

pub fn tagsFromScriptAndLanguage(script: u32, language: usize, scriptCount: usize, scriptTags: usize, languageCount: usize, languageTags: usize) -> void {
    var needsScript = true
    if language == 0 {
        if languageCount != 0 && languageTags != 0 && m.get32(languageCount) != 0 { m.put32(languageCount, 0) }
    } else {
        const langStr = language
        var limit: usize = 0
        var privateUse: usize = 0
        if m.get8(langStr) == 120 && m.get8(langStr + 1) == 45 {
            privateUse = langStr
        } else {
            var s = langStr + 1
            while m.get8(s) != 0 {
                if m.get8(s - 1) == 45 && m.get8(s + 1) == 45 {
                    if m.get8(s) == 120 {
                        privateUse = s
                        if limit == 0 { limit = s - 1 }
                        break
                    } else if limit == 0 {
                        limit = s - 1
                    }
                }
                s += 1
            }
            if limit == 0 { limit = s }
        }
        needsScript = !parsePrivateUseSubtag(privateUse, scriptCount, scriptTags, "-hbsc", false)
        const needsLanguage = !parsePrivateUseSubtag(privateUse, languageCount, languageTags, "-hbot", true)
        if needsLanguage && languageCount != 0 && languageTags != 0 && m.get32(languageCount) != 0 { tagsFromLanguage(langStr, limit, languageCount, languageTags) }
    }
    if needsScript && scriptCount != 0 && scriptTags != 0 && m.get32(scriptCount) != 0 { allTagsFromScript(script, scriptCount, scriptTags) }
}

pub fn otTagsFromScriptAndLanguage(script: u32, language: usize, scriptCount: usize, scriptTags: usize, languageCount: usize, languageTags: usize) -> void {
    tagsFromScriptAndLanguage(script, language, scriptCount, scriptTags, languageCount, languageTags)
}

pub fn otTagsFromScript(script: u32, tag1: usize, tag2: usize) -> void {
    var count: u32 = 2
    var tags: [2]u32 = [_]u32{ 0, 0 }
    tagsFromScriptAndLanguage(script, 0, @intFromPtr(&count), @intFromPtr(&tags), 0, 0)
    m.put32(tag1, if count > 0 { tags[0] } else { TAG_DEFAULT_SCRIPT })
    m.put32(tag2, if count > 1 { tags[1] } else { TAG_DEFAULT_SCRIPT })
}

pub fn otTagFromLanguage(language: usize) -> u32 {
    var count: u32 = 1
    var tags: [1]u32 = [_]u32{ 0 }
    tagsFromScriptAndLanguage(common.SCRIPT_UNKNOWN, language, 0, 0, @intFromPtr(&count), @intFromPtr(&tags))
    return if count > 0 { tags[0] } else { TAG_DEFAULT_LANGUAGE }
}

pub fn otTagToScript(tag: u32) -> u32 { return tagToScript(tag) }

fn ambiguousTagToLanguage(tag: u32) -> usize {
    const text = tagtable.AMBIGUOUS
    var i: usize = 0
    while i < text.length {
        var v: u32 = 0
        var k: usize = 0
        while k < 8 {
            v = (v << 4) | hexValue(text[i + k])
            k += 1
        }
        const end = fieldEnd(text, i + 9)
        if v == tag { return common.languageFromString(@intFromPtr(text.pointer) + i + 9, @intCast(i64, end - i - 9)) }
        i = end + 1
    }
    return 0
}

fn hexDigit(v: u32) -> u8 { return @intCast(u8, if (v & 15) < 10 { (v & 15) + 48 } else { (v & 15) + 87 }) }

pub fn tagToLanguage(tag: u32) -> usize {
    if tag == TAG_DEFAULT_LANGUAGE { return 0 }
    const ambiguous = ambiguousTagToLanguage(tag)
    if ambiguous != 0 { return ambiguous }
    var buf: [24]u8 = undefined
    const at = @intFromPtr(&buf)
    var i: usize = 0
    while i < tagtable.LANGUAGES2.length {
        if tagtable.LANGUAGES2[i + 1] == tag {
            m.put32(at, 0)
            const l = tagtable.LANGUAGES2[i]
            m.put8(at, @intCast(u8, l >> 24))
            m.put8(at + 1, @intCast(u8, (l >> 16) & 0xFF))
            return common.languageFromString(at, 2)
        }
        i += 2
    }
    i = 0
    while i < tagtable.LANGUAGES3.length {
        if tagtable.LANGUAGES3[i + 1] == tag {
            const l = tagtable.LANGUAGES3[i]
            m.put8(at, @intCast(u8, l >> 24))
            m.put8(at + 1, @intCast(u8, (l >> 16) & 0xFF))
            m.put8(at + 2, @intCast(u8, (l >> 8) & 0xFF))
            return common.languageFromString(at, 3)
        }
        i += 2
    }
    var n: usize = 0
    const a = @intCast(u8, tag >> 24)
    const b = @intCast(u8, (tag >> 16) & 0xFF)
    const c = @intCast(u8, (tag >> 8) & 0xFF)
    if m.isAlpha(a) && m.isAlpha(b) && m.isAlpha(c) && (tag & 0xFF) == 32 {
        m.put8(at, m.lower(a))
        m.put8(at + 1, m.lower(b))
        m.put8(at + 2, m.lower(c))
        m.put8(at + 3, 45)
        n = 4
    }
    const prefix = "x-hbot-"
    var k: usize = 0
    while k < prefix.length {
        m.put8(at + n, prefix[k])
        n += 1
        k += 1
    }
    var shift: i32 = 28
    while shift >= 0 {
        m.put8(at + n, hexDigit(tag >> @intCast(u5, shift)))
        n += 1
        shift -= 4
    }
    return common.languageFromString(at, @intCast(i64, n))
}

pub fn otTagToLanguage(tag: u32) -> usize { return tagToLanguage(tag) }

pub fn otTagsToScriptAndLanguage(scriptTag: u32, languageTag: u32, script: usize, language: usize) -> void {
    const scriptOut = tagToScript(scriptTag)
    if script != 0 { m.put32(script, scriptOut) }
    if language == 0 { return }
    var count: u32 = 1
    var primary: [1]u32 = [_]u32{ 0 }
    tagsFromScriptAndLanguage(scriptOut, 0, @intFromPtr(&count), @intFromPtr(&primary), 0, 0)
    var lang = tagToLanguage(languageTag)
    if count == 0 || primary[0] != scriptTag {
        const langStr = lang
        const len = m.cLength(langStr)
        const buf = m.alloc(len + 16)
        if buf == 0 {
            m.putWord(language, 0)
            return
        }
        m.copy(buf, langStr, len)
        var n = len
        if m.get8(langStr) != 120 || m.get8(langStr + 1) != 45 {
            m.put8(buf + n, 45)
            m.put8(buf + n + 1, 120)
            n += 2
        }
        const suffix = "-hbsc-"
        var k: usize = 0
        while k < suffix.length {
            m.put8(buf + n, suffix[k])
            n += 1
            k += 1
        }
        var shift: i32 = 28
        while shift >= 0 {
            m.put8(buf + n, hexDigit(scriptTag >> @intCast(u5, shift)))
            n += 1
            shift -= 4
        }
        lang = common.languageFromString(buf, @intCast(i64, n))
        m.release(buf)
    }
    m.putWord(language, lang)
}
