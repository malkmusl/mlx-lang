// The Khmer shaper (HarfBuzz's hb-ot-shaper-khmer.cc): syllables found by
// the Khmer machine; in each, Coeng,Ro moved to the start (with pref, and
// cfar for what follows) and left matra pieces moved to the start, before
// the basic features (all at once, restricted to the syllable).
const m = @import("./memory.mlx")
const common = @import("./common.mlx")
const unicode = @import("./unicode.mlx")
const buffer = @import("./buffer.mlx")
const p = @import("./props.mlx")
const plan = @import("./plan.mlx")
const ragel = @import("./ragel.mlx")
const machines = @import("./machines.mlx")
const syllabic = @import("./syllabic.mlx")
const indic = @import("./indic.mlx")

const CAT_H: u32 = 4
const CAT_DOTTEDCIRCLE: u32 = 11
const CAT_RA: u32 = 15
const CAT_VPRE: u32 = 22

const CONSONANT_SYLLABLE: u32 = 0
const BROKEN_CLUSTER: u32 = 1

// Pauses of this shaper (numbers of shapers.mlx).
pub const PAUSE_SETUP_SYLLABLES: u32 = 8
pub const PAUSE_REORDER: u32 = 9

const PREF: u32 = 0
const BLWF: u32 = 1
const ABVF: u32 = 2
const PSTF: u32 = 3
const CFAR: u32 = 4
const NUM_FEATURES: u32 = 9
const BASIC_FEATURES: u32 = 5

const FEATURE_NAMES = "prefblwfabvfpstfcfarpresabvsblwspsts"

fn featureTag(i: u32) -> u32 {
    const k = @intCast(usize, i) * 4
    return common.tag(FEATURE_NAMES[k], FEATURE_NAMES[k + 1], FEATURE_NAMES[k + 2], FEATURE_NAMES[k + 3])
}

fn featureFlags(i: u32) -> u32 {
    if i < BASIC_FEATURES { return plan.F_MANUAL_JOINERS | plan.F_PER_SYLLABLE }
    return plan.F_GLOBAL_MANUAL_JOINERS
}

fn tag(a: u8, b: u8, c: u8, d: u8) -> u32 { return common.tag(a, b, c, d) }

pub const KhmerPlan = struct {
    masks: [9]u32
}

fn khmerPlan(address: usize) -> *KhmerPlan { unsafe { return @ptrFromInt(*KhmerPlan, address) } }

fn mask(kp: *KhmerPlan, feature: u32) -> u32 { return kp.*.masks[@intCast(usize, feature)] }

pub fn collectFeatures(b: *plan.Builder) -> void {
    plan.addGsubPause(b, PAUSE_SETUP_SYLLABLES)
    plan.addGsubPause(b, PAUSE_REORDER)
    plan.enableFeature(b, tag(108, 111, 99, 108), plan.F_PER_SYLLABLE, 1)
    plan.enableFeature(b, tag(99, 99, 109, 112), plan.F_PER_SYLLABLE, 1)
    var i: u32 = 0
    while i < BASIC_FEATURES {
        plan.addFeature(b, featureTag(i), featureFlags(i), 1)
        i += 1
    }
    plan.addGsubPause(b, syllabic.PAUSE_CLEAR_SYLLABLES)
    while i < NUM_FEATURES {
        plan.addFeature(b, featureTag(i), featureFlags(i), 1)
        i += 1
    }
}

pub fn overrideFeatures(b: *plan.Builder) -> void {
    plan.enableFeature(b, tag(99, 108, 105, 103), plan.F_NONE, 1)
    plan.disableFeature(b, tag(108, 105, 103, 97))
}

pub fn dataCreate(pl: *plan.Plan) -> usize {
    const address = m.alloc(@sizeOf(KhmerPlan))
    if address == 0 { return 0 }
    const kp = khmerPlan(address)
    var i: u32 = 0
    while i < NUM_FEATURES {
        kp.*.masks[@intCast(usize, i)] = if (featureFlags(i) & plan.F_GLOBAL) != 0 { 0 } else { plan.get1Mask(&pl.*.map, featureTag(i)) }
        i += 1
    }
    return address
}

pub fn setupMasks(b: *buffer.Buffer) -> void {
    var i: u32 = 0
    while i < b.*.len {
        const g = buffer.info(b, i)
        p.setCategory(g, indic.categories(g.*.codepoint) & 0xFF)
        i += 1
    }
}

fn setupSyllables(b: *buffer.Buffer) -> void {
    var mach: ragel.Machine = undefined
    machines.khmerMachine(&mach)
    indic.findSyllables(&mach, b)
    var start: u32 = 0
    while start < b.*.len {
        const end = p.nextSyllable(b, start)
        buffer.unsafeToBreak(b, start, end)
        start = end
    }
}

fn reorderConsonantSyllable(kp: *KhmerPlan, b: *buffer.Buffer, start: u32, end: u32) -> void {
    const postMask = mask(kp, BLWF) | mask(kp, ABVF) | mask(kp, PSTF)
    var i = start + 1
    while i < end {
        buffer.info(b, i).*.mask |= postMask
        i += 1
    }
    var numCoengs: u32 = 0
    i = start + 1
    while i < end {
        const c = p.category(buffer.info(b, i))
        if c == CAT_H && numCoengs <= 2 && i + 1 < end {
            numCoengs += 1
            if p.category(buffer.info(b, i + 1)) == CAT_RA {
                // Coeng,Ro moves to the start, with pref.
                buffer.info(b, i).*.mask |= mask(kp, PREF)
                buffer.info(b, i + 1).*.mask |= mask(kp, PREF)
                buffer.mergeClusters(b, start, i + 2)
                indic.moveGlyph(b, i, start)
                indic.moveGlyph(b, i + 1, start + 1)
                // What follows gets cfar.
                if mask(kp, CFAR) != 0 {
                    var j = i + 2
                    while j < end {
                        buffer.info(b, j).*.mask |= mask(kp, CFAR)
                        j += 1
                    }
                }
                numCoengs = 2
            }
        } else if c == CAT_VPRE {
            // A left matra piece moves to the start.
            buffer.mergeClusters(b, start, i + 1)
            indic.moveGlyph(b, i, start)
        }
        i += 1
    }
}

fn reorder(pl: *plan.Plan, f: usize, b: *buffer.Buffer) -> bool {
    const ret = syllabic.insertDottedCircles(f, b, BROKEN_CLUSTER, CAT_DOTTEDCIRCLE, -1, -1)
    const kp = khmerPlan(pl.*.data)
    const count = b.*.len
    var start: u32 = 0
    while start < count {
        const end = p.nextSyllable(b, start)
        const t = p.syllable(buffer.info(b, start)) & 0x0F
        if t == BROKEN_CLUSTER || t == CONSONANT_SYLLABLE { reorderConsonantSyllable(kp, b, start, end) }
        start = end
    }
    return ret
}

pub fn pause(pauseId: u32, pl: *plan.Plan, f: usize, b: *buffer.Buffer) -> bool {
    if pauseId == PAUSE_SETUP_SYLLABLES {
        setupSyllables(b)
        return false
    }
    if pauseId == PAUSE_REORDER { return reorder(pl, f, b) }
    return false
}

// Split matras without Unicode decompositions decompose.
pub fn decompose(u: usize, ab: u32, a: *u32, c: *u32) -> bool {
    if ab == 0x17BE || ab == 0x17BF || ab == 0x17C0 || ab == 0x17C4 || ab == 0x17C5 {
        a.* = 0x17C1
        c.* = ab
        return true
    }
    return unicode.decompose(u, ab, a, c)
}

pub fn compose(u: usize, a: u32, c: u32, ab: *u32) -> bool {
    if unicode.isMark(unicode.generalCategory(u, a)) { return false }
    return unicode.compose(u, a, c, ab)
}
