// The OpenType font functions (HarfBuzz's hb-ot-font.cc): glyphs from
// cmap, advances from hmtx and vmtx (varied by HVAR and VVAR), vertical
// origins from VORG or the glyph's extents, extents from the glyph tables,
// font extents from OS/2 and hhea, names from post and CFF; and
// hb_font_create, which gives a new font these functions.
const m = @import("./memory.mlx")
const o = @import("./object.mlx")
const face = @import("./face.mlx")
const font = @import("./font.mlx")
const cmap = @import("./cmap.mlx")
const hmtx = @import("./hmtx.mlx")
const glyf = @import("./glyf.mlx")
const metrics = @import("./metrics.mlx")
const variations = @import("./variations.mlx")
const post = @import("./post.mlx")
const cff = @import("./cff.mlx")
const color = @import("./color.mlx")
const outline = @import("./outline.mlx")

const TAG_HASC: u32 = 0x68617363
const TAG_HDSC: u32 = 0x68647363
const TAG_HLGP: u32 = 0x686C6770
const TAG_VASC: u32 = 0x76617363
const TAG_VDSC: u32 = 0x76647363
const TAG_VLGP: u32 = 0x766C6770

fn p32(a: usize) -> *u32 { return unsafe { @ptrFromInt(*u32, a) } }
fn pi32(a: usize) -> *i32 { return unsafe { @ptrFromInt(*i32, a) } }
fn b(v: bool) -> i32 { return if v { 1 } else { 0 } }

pub fn otGetNominalGlyphCallback(f: usize, data: usize, u: u32, glyph: usize, user: usize) -> i32 {
    return b(cmap.getNominalGlyph(font.font(f).*.face, u, p32(glyph)))
}

pub fn otGetNominalGlyphsCallback(f: usize, data: usize, count: u32, firstUnicode: usize, unicodeStride: u32, firstGlyph: usize, glyphStride: u32, user: usize) -> u32 {
    const fc = font.font(f).*.face
    var done: u32 = 0
    var u = firstUnicode
    var g = firstGlyph
    while done < count {
        if !cmap.getNominalGlyph(fc, m.get32(u), p32(g)) { break }
        u += @intCast(usize, unicodeStride)
        g += @intCast(usize, glyphStride)
        done += 1
    }
    return done
}

pub fn otGetVariationGlyphCallback(f: usize, data: usize, u: u32, vs: u32, glyph: usize, user: usize) -> i32 {
    return b(cmap.getVariationGlyph(font.font(f).*.face, u, vs, p32(glyph)))
}

// The advance of `glyph` in font units, with the font's variations
// (hmtx_accelerator_t::get_advance_with_var_unscaled).
pub fn advanceWithVar(f: usize, glyph: u32, vertical: bool) -> i32 {
    const fo = font.font(f)
    const fc = fo.*.face
    const h = hmtx.accel(fc, !vertical)
    const advance = @intCast(i32, hmtx.advanceUnscaled(h, glyph))
    if glyph >= h.*.numBearings || fo.*.numCoords == 0 { return advance }
    if variations.hasMetricsVariations(fc, vertical) {
        return advance + m.intOf(m.roundf(variations.advanceDelta(fc, vertical, glyph, fo.*.coords, fo.*.numCoords)))
    }
    return glyf.advanceWithVar(f, glyph, vertical)
}

// The leading bearing of `glyph` with the font's variations; whether there is one.
pub fn bearingWithVar(f: usize, glyph: u32, vertical: bool, out: *i32) -> bool {
    const fo = font.font(f)
    const fc = fo.*.face
    const h = hmtx.accel(fc, !vertical)
    if fo.*.numCoords == 0 { return hmtx.bearingUnscaled(h, glyph, out) }
    var delta: f32 = 0.0
    if variations.bearingDelta(fc, vertical, glyph, fo.*.coords, fo.*.numCoords, &delta) && hmtx.bearingUnscaled(h, glyph, out) {
        out.* += m.intOf(m.roundf(delta))
        return true
    }
    return glyf.bearingWithVar(f, glyph, vertical, out)
}

pub fn otGetGlyphHAdvancesCallback(f: usize, data: usize, count: u32, firstGlyph: usize, glyphStride: u32, firstAdvance: usize, advanceStride: u32, user: usize) -> void {
    const fo = font.font(f)
    var g = firstGlyph
    var a = firstAdvance
    var i: u32 = 0
    while i < count {
        m.putI32(a, font.emScaleX(f, advanceWithVar(f, m.get32(g), false)))
        g += @intCast(usize, glyphStride)
        a += @intCast(usize, advanceStride)
        i += 1
    }
    if fo.*.xStrength != 0 && fo.*.emboldenInPlace == 0 {
        const strength = if fo.*.xScale >= 0 { fo.*.xStrength } else { 0 - fo.*.xStrength }
        a = firstAdvance
        i = 0
        while i < count {
            const v = m.getI32(a)
            if v != 0 { m.putI32(a, v +% strength) }
            a += @intCast(usize, advanceStride)
            i += 1
        }
    }
}

pub fn otGetGlyphVAdvancesCallback(f: usize, data: usize, count: u32, firstGlyph: usize, glyphStride: u32, firstAdvance: usize, advanceStride: u32, user: usize) -> void {
    const fo = font.font(f)
    var g = firstGlyph
    var a = firstAdvance
    var i: u32 = 0
    if hmtx.hasData(hmtx.accel(fo.*.face, false)) {
        while i < count {
            m.putI32(a, font.emScaleY(f, 0 - advanceWithVar(f, m.get32(g), true)))
            g += @intCast(usize, glyphStride)
            a += @intCast(usize, advanceStride)
            i += 1
        }
    } else {
        var e: [12]i32 = undefined
        font.getHExtentsWithFallback(f, @intFromPtr(&e))
        const advance = 0 - (e[0] - e[1])
        while i < count {
            m.putI32(a, advance)
            a += @intCast(usize, advanceStride)
            i += 1
        }
    }
    if fo.*.yStrength != 0 && fo.*.emboldenInPlace == 0 {
        const strength = if fo.*.yScale >= 0 { fo.*.yStrength } else { 0 - fo.*.yStrength }
        a = firstAdvance
        i = 0
        while i < count {
            const v = m.getI32(a)
            if v != 0 { m.putI32(a, v +% strength) }
            a += @intCast(usize, advanceStride)
            i += 1
        }
    }
}

// VORG's vertical origin of `glyph` (the default one when it has none).
fn vorgOrigin(t: *m.Table, glyph: u32) -> i32 {
    var lo: i64 = 0
    var hi: i64 = @intCast(i64, m.u16at(t, 6)) - 1
    while lo <= hi {
        const mid = (lo + hi) / 2
        const at = 8 + @intCast(usize, mid) * 4
        const g = m.u16at(t, at)
        if g == glyph { return m.i16at(t, at + 2) }
        if g < glyph { lo = mid + 1 } else { hi = mid - 1 }
    }
    return m.i16at(t, 4)
}

pub fn otGetGlyphVOriginCallback(f: usize, data: usize, glyph: u32, x: usize, y: usize, user: usize) -> i32 {
    const fo = font.font(f)
    const fc = fo.*.face
    m.putI32(x, font.getGlyphHAdvance(f, glyph) / 2)
    var vorg: m.Table = undefined
    face.view(fc, face.T_VORG, &vorg)
    if vorg.length >= 8 && m.u16at(&vorg, 0) == 1 {
        var delta: f32 = 0.0
        if fo.*.numCoords != 0 { _ = variations.vorgDelta(fc, glyph, fo.*.coords, fo.*.numCoords, &delta) }
        m.putI32(y, font.emScalefY(f, @floatFromInt(f32, vorgOrigin(&vorg, glyph)) + delta))
        return 1
    }
    var e: [4]i32 = [_]i32{ 0, 0, 0, 0 }
    var fe: [12]i32 = undefined
    if glyf.getExtents(f, glyph, @intFromPtr(&e)) {
        var tsb: i32 = 0
        if bearingWithVar(f, glyph, true, &tsb) {
            m.putI32(y, e[1] + font.emScaleY(f, tsb))
            return 1
        }
        font.getHExtentsWithFallback(f, @intFromPtr(&fe))
        const advance = fe[0] - fe[1]
        const diff = advance - (0 - e[3])
        m.putI32(y, e[1] + (diff >> 1))
        return 1
    }
    font.getHExtentsWithFallback(f, @intFromPtr(&fe))
    m.putI32(y, fe[0])
    return 1
}

pub fn otGetGlyphExtentsCallback(f: usize, data: usize, glyph: u32, e: usize, user: usize) -> i32 {
    if color.getBitmapExtents(f, glyph, e) { return 1 }
    if color.getColrExtents(f, glyph, e) { return 1 }
    if glyf.getExtents(f, glyph, e) { return 1 }
    if cff.getExtents(f, glyph, e) { return 1 }
    return 0
}

pub fn otGetGlyphNameCallback(f: usize, data: usize, glyph: u32, name: usize, size: u32, user: usize) -> i32 {
    const fc = font.font(f).*.face
    if post.getGlyphName(fc, glyph, name, size) { return 1 }
    return b(cff.getGlyphName(fc, glyph, name, size))
}

pub fn otGetGlyphFromNameCallback(f: usize, data: usize, name: usize, len: i32, glyph: usize, user: usize) -> i32 {
    const fc = font.font(f).*.face
    if post.getGlyphFromName(fc, name, len, p32(glyph)) { return 1 }
    return b(cff.getGlyphFromName(fc, name, len, p32(glyph)))
}

pub fn otGetFontHExtentsCallback(f: usize, data: usize, e: usize, user: usize) -> i32 {
    const ret = metrics.positionCommon(f, TAG_HASC, e) && metrics.positionCommon(f, TAG_HDSC, e + 4) && metrics.positionCommon(f, TAG_HLGP, e + 8)
    const fo = font.font(f)
    const shift = if fo.*.yScale < 0 { 0 - fo.*.yStrength } else { fo.*.yStrength }
    m.putI32(e, m.getI32(e) +% shift)
    return b(ret)
}

pub fn otGetFontVExtentsCallback(f: usize, data: usize, e: usize, user: usize) -> i32 {
    return b(metrics.positionCommon(f, TAG_VASC, e) && metrics.positionCommon(f, TAG_VDSC, e + 4) && metrics.positionCommon(f, TAG_VLGP, e + 8))
}

pub fn otDrawGlyphCallback(f: usize, data: usize, glyph: u32, drawFuncs: usize, drawData: usize, user: usize) -> void {
    outline.drawGlyph(f, glyph, drawFuncs, drawData)
}

pub fn otPaintGlyphCallback(f: usize, data: usize, glyph: u32, paintFuncs: usize, paintData: usize, palette: u32, foreground: u32, user: usize) -> void {
    if color.paintGlyph(f, glyph, paintFuncs, paintData, palette, foreground) { return }
    outline.paintGlyph(f, glyph, paintFuncs, paintData, foreground)
}

// The shared, immutable OpenType font functions.
var otFuncs: usize = 0

pub fn getFuncs() -> usize {
    var funcs = m.atomicLoadWord(@intFromPtr(&otFuncs))
    if funcs == 0 {
        const made = font.funcsCreate()
        font.setFunc(made, font.F_NOMINAL_GLYPH, @intFromPtr(otGetNominalGlyphCallback), 0, 0)
        font.setFunc(made, font.F_NOMINAL_GLYPHS, @intFromPtr(otGetNominalGlyphsCallback), 0, 0)
        font.setFunc(made, font.F_VARIATION_GLYPH, @intFromPtr(otGetVariationGlyphCallback), 0, 0)
        font.setFunc(made, font.F_FONT_H_EXTENTS, @intFromPtr(otGetFontHExtentsCallback), 0, 0)
        font.setFunc(made, font.F_GLYPH_H_ADVANCES, @intFromPtr(otGetGlyphHAdvancesCallback), 0, 0)
        font.setFunc(made, font.F_FONT_V_EXTENTS, @intFromPtr(otGetFontVExtentsCallback), 0, 0)
        font.setFunc(made, font.F_GLYPH_V_ADVANCES, @intFromPtr(otGetGlyphVAdvancesCallback), 0, 0)
        font.setFunc(made, font.F_GLYPH_V_ORIGIN, @intFromPtr(otGetGlyphVOriginCallback), 0, 0)
        font.setFunc(made, font.F_DRAW_GLYPH, @intFromPtr(otDrawGlyphCallback), 0, 0)
        font.setFunc(made, font.F_PAINT_GLYPH, @intFromPtr(otPaintGlyphCallback), 0, 0)
        font.setFunc(made, font.F_GLYPH_EXTENTS, @intFromPtr(otGetGlyphExtentsCallback), 0, 0)
        font.setFunc(made, font.F_GLYPH_NAME, @intFromPtr(otGetGlyphNameCallback), 0, 0)
        font.setFunc(made, font.F_GLYPH_FROM_NAME, @intFromPtr(otGetGlyphFromNameCallback), 0, 0)
        o.makeImmutable(made)
        if !m.swapWord(@intFromPtr(&otFuncs), 0, made) { font.funcsDestroy(made) }
        funcs = m.atomicLoadWord(@intFromPtr(&otFuncs))
    }
    return funcs
}

pub fn otFontDataFreeCallback(a: usize) -> void { m.release(a) }

pub fn setFuncs(f: usize) -> void {
    // The functions read everything from the font itself; the data only
    // marks the font as an OpenType one.
    const data = m.alloc(8)
    font.setFuncs(f, getFuncs(), data, @intFromPtr(otFontDataFreeCallback))
}

pub fn otFontSetFuncs(f: usize) -> void { setFuncs(f) }

pub fn fontCreate(fc: usize) -> usize {
    const f = font.createWithoutFuncs(fc)
    if o.isInert(f) { return f }
    setFuncs(f)
    const index = face.face(font.font(f).*.face).*.index
    if (index >> 16) != 0 { variations.setNamedInstance(f, (index >> 16) - 1) }
    return f
}
