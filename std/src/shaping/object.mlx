// The header every object of the library starts with (blobs, faces,
// fonts, font functions, buffers, Unicode functions, sets, maps, shape
// plans, draw and paint functions): its reference count, whether it may
// still be changed, and the user data a program attaches to it, as
// HarfBuzz's hb_object_header_t has them.
//
// An object whose count is 0 is inert: the empty objects the library
// hands out (hb_blob_get_empty...) are never referenced or destroyed.
const m = @import("./memory.mlx")

pub const HEADER_SIZE: usize = 24

pub const Header = struct {
    refcount: u32
    writable: u32
    // The user data: a block of `count` entries of key, data, destroy.
    userData: usize
    lock: u32
    count: u32
}

pub fn header(object: usize) -> *Header { unsafe { return @ptrFromInt(*Header, object) } }

pub const DestroyFunc = fn(usize) -> void

// Calls a C destroy function on `data` (none when it is 0).
pub fn callDestroy(destroy: usize, data: usize) -> void {
    if destroy == 0 { return }
    const call: DestroyFunc = unsafe { @ptrFromInt(DestroyFunc, destroy) }
    call(data)
}

// A new object of `size` bytes, its header set: one reference, writable.
pub fn create(size: usize) -> usize {
    const object = m.alloc(size)
    if object == 0 { return 0 }
    const h = header(object)
    h.*.refcount = 1
    h.*.writable = 1
    return object
}

// An inert object of `size` bytes (an empty object of the library).
pub fn createInert(size: usize) -> usize { return m.alloc(size) }

pub fn isInert(object: usize) -> bool { return object == 0 || m.atomicLoad32(object) == 0 }

pub fn reference(object: usize) -> usize {
    if isInert(object) { return object }
    _ = m.atomicAdd32(object, 1)
    return object
}

// Takes a reference away: whether it was the last one (the object is to
// be finished and freed by its kind); the user data is destroyed then.
pub fn destroy(object: usize) -> bool {
    if isInert(object) { return false }
    if m.atomicSub32(object, 1) != 1 { return false }
    const h = header(object)
    const list = h.*.userData
    if list != 0 {
        var index: usize = 0
        while index < @intCast(usize, h.*.count) {
            callDestroy(m.getWord(list + index * 24 + 16), m.getWord(list + index * 24 + 8))
            index += 1
        }
        m.release(list)
        h.*.userData = 0
    }
    return true
}

pub fn isImmutable(object: usize) -> bool { return object == 0 || header(object).*.writable == 0 }
pub fn makeImmutable(object: usize) -> void { if object != 0 { header(object).*.writable = 0 } }

// Sets user data under `key` (hb_object_set_user_data).
pub fn setUserData(object: usize, key: usize, data: usize, destroyFunc: usize, replace: bool) -> bool {
    if isInert(object) || key == 0 { return false }
    const h = header(object)
    m.lock(object + 16)
    var list = h.*.userData
    var index: usize = 0
    const count = @intCast(usize, h.*.count)
    while index < count {
        if m.getWord(list + index * 24) == key { break }
        index += 1
    }
    if index < count {
        if !replace {
            m.unlock(object + 16)
            return false
        }
        const oldData = m.getWord(list + index * 24 + 8)
        const oldDestroy = m.getWord(list + index * 24 + 16)
        if data == 0 && destroyFunc == 0 {
            // (Replacing with nothing removes the entry.)
            m.copy(list + index * 24, list + (index + 1) * 24, (count - index - 1) * 24)
            h.*.count -= 1
        } else {
            m.putWord(list + index * 24 + 8, data)
            m.putWord(list + index * 24 + 16, destroyFunc)
        }
        m.unlock(object + 16)
        callDestroy(oldDestroy, oldData)
        return true
    }
    if replace && data == 0 && destroyFunc == 0 {
        m.unlock(object + 16)
        return true
    }
    const grown = m.grow(list, (count + 1) * 24)
    if grown == 0 {
        m.unlock(object + 16)
        return false
    }
    list = grown
    h.*.userData = list
    m.putWord(list + count * 24, key)
    m.putWord(list + count * 24 + 8, data)
    m.putWord(list + count * 24 + 16, destroyFunc)
    h.*.count += 1
    m.unlock(object + 16)
    return true
}

pub fn getUserData(object: usize, key: usize) -> usize {
    if isInert(object) || key == 0 { return 0 }
    const h = header(object)
    m.lock(object + 16)
    const list = h.*.userData
    var index: usize = 0
    var result: usize = 0
    while index < @intCast(usize, h.*.count) {
        if m.getWord(list + index * 24) == key {
            result = m.getWord(list + index * 24 + 8)
            break
        }
        index += 1
    }
    m.unlock(object + 16)
    return result
}
