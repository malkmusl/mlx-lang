// The Hangul shaper (HarfBuzz's hb-ot-shaper-hangul.cc): syllables composed
// when the font has the precomposed glyph and decomposed into jamo (with
// the ljmo, vjmo and tjmo features) when it lacks it, and tone marks moved
// before their syllable.
const m = @import("./memory.mlx")
const common = @import("./common.mlx")
const font = @import("./font.mlx")
const buffer = @import("./buffer.mlx")
const p = @import("./props.mlx")
const plan = @import("./plan.mlx")

const LJMO: u32 = 1
const VJMO: u32 = 2
const TJMO: u32 = 3

const L_BASE: u32 = 0x1100
const V_BASE: u32 = 0x1161
const T_BASE: u32 = 0x11A7
const L_COUNT: u32 = 19
const V_COUNT: u32 = 21
const T_COUNT: u32 = 28
const S_BASE: u32 = 0xAC00
const N_COUNT: u32 = 588
const S_COUNT: u32 = 11172

fn tag(a: u8, b: u8, c: u8, d: u8) -> u32 { return common.tag(a, b, c, d) }

fn featureTag(i: u32) -> u32 {
    if i == LJMO { return tag(108, 106, 109, 111) }
    if i == VJMO { return tag(118, 106, 109, 111) }
    if i == TJMO { return tag(116, 106, 109, 111) }
    return 0
}

fn isCombiningL(u: u32) -> bool { return u >= L_BASE && u <= L_BASE + L_COUNT - 1 }
fn isCombiningV(u: u32) -> bool { return u >= V_BASE && u <= V_BASE + V_COUNT - 1 }
fn isCombiningT(u: u32) -> bool { return u >= T_BASE + 1 && u <= T_BASE + T_COUNT - 1 }
fn isCombinedS(u: u32) -> bool { return u >= S_BASE && u <= S_BASE + S_COUNT - 1 }
fn isL(u: u32) -> bool { return (u >= 0x1100 && u <= 0x115F) || (u >= 0xA960 && u <= 0xA97C) }
fn isV(u: u32) -> bool { return (u >= 0x1160 && u <= 0x11A7) || (u >= 0xD7B0 && u <= 0xD7C6) }
fn isT(u: u32) -> bool { return (u >= 0x11A8 && u <= 0x11FF) || (u >= 0xD7CB && u <= 0xD7FB) }
fn isTone(u: u32) -> bool { return u >= 0x302E && u <= 0x302F }

pub fn collectFeatures(b: *plan.Builder) -> void {
    var i: u32 = LJMO
    while i <= TJMO {
        plan.addFeature(b, featureTag(i), plan.F_NONE, 1)
        i += 1
    }
}

pub fn overrideFeatures(b: *plan.Builder) -> void { plan.disableFeature(b, tag(99, 97, 108, 116)) }

pub fn dataCreate(pl: *plan.Plan) -> usize {
    const data = m.alloc(16)
    if data == 0 { return 0 }
    var i: u32 = 1
    while i < 4 {
        m.put32(data + @intCast(usize, i) * 4, plan.get1Mask(&pl.*.map, featureTag(i)))
        i += 1
    }
    return data
}

fn isZeroWidthChar(f: usize, u: u32) -> bool {
    var glyph: u32 = 0
    return font.getNominalGlyph(f, u, &glyph) && font.getGlyphHAdvance(f, glyph) == 0
}

pub fn preprocessText(b: *buffer.Buffer, f: usize) -> void {
    buffer.clearOutput(b)
    var start: u32 = 0
    var end: u32 = 0
    const count = b.*.len
    var chars: [3]u32 = [_]u32{ 0, 0, 0 }
    var tone: buffer.GlyphInfo = undefined
    b.*.idx = 0
    while b.*.idx < count && b.*.successful != 0 {
        const u = buffer.cur(b).*.codepoint
        if isTone(u) {
            if start < end && end == b.*.outLen {
                buffer.unsafeToBreakFromOutbuffer(b, start, b.*.idx)
                if !buffer.nextGlyph(b) { break }
                if !isZeroWidthChar(f, u) {
                    buffer.mergeOutClusters(b, start, end + 1)
                    buffer.copyInfo(&tone, buffer.outInfo(b, end))
                    m.copy(b.*.outInfo + @intCast(usize, start + 1) * buffer.INFO_SIZE, b.*.outInfo + @intCast(usize, start) * buffer.INFO_SIZE, @intCast(usize, end - start) * buffer.INFO_SIZE)
                    buffer.copyInfo(buffer.outInfo(b, start), &tone)
                }
            } else {
                if (b.*.flags & buffer.FLAG_DO_NOT_INSERT_DOTTED_CIRCLE) == 0 && font.hasGlyph(f, 0x25CC) {
                    if !isZeroWidthChar(f, u) {
                        chars[0] = u
                        chars[1] = 0x25CC
                    } else {
                        chars[0] = 0x25CC
                        chars[1] = u
                    }
                    _ = buffer.replaceGlyphs(b, 1, 2, @intFromPtr(&chars))
                } else {
                    _ = buffer.nextGlyph(b)
                }
            }
            start = b.*.outLen
            end = b.*.outLen
            continue
        }
        start = b.*.outLen
        if isL(u) && b.*.idx + 1 < count {
            const l = u
            const v = buffer.curAt(b, 1).*.codepoint
            if isV(v) {
                var t: u32 = 0
                var tindex: u32 = 0
                if b.*.idx + 2 < count {
                    t = buffer.curAt(b, 2).*.codepoint
                    if isT(t) {
                        tindex = t - T_BASE
                    } else {
                        t = 0
                    }
                }
                buffer.unsafeToBreak(b, b.*.idx, b.*.idx + (if t != 0 { 3 } else { 2 }))
                if isCombiningL(l) && isCombiningV(v) && (t == 0 || isCombiningT(t)) {
                    const s = S_BASE + (l - L_BASE) * N_COUNT + (v - V_BASE) * T_COUNT + tindex
                    if font.hasGlyph(f, s) {
                        chars[0] = s
                        _ = buffer.replaceGlyphs(b, if t != 0 { 3 } else { 2 }, 1, @intFromPtr(&chars))
                        end = start + 1
                        continue
                    }
                }
                p.setAuxiliary(buffer.cur(b), LJMO)
                _ = buffer.nextGlyph(b)
                p.setAuxiliary(buffer.cur(b), VJMO)
                _ = buffer.nextGlyph(b)
                if t != 0 {
                    p.setAuxiliary(buffer.cur(b), TJMO)
                    _ = buffer.nextGlyph(b)
                    end = start + 3
                } else {
                    end = start + 2
                }
                if b.*.successful == 0 { break }
                if b.*.clusterLevel == buffer.CLUSTER_MONOTONE_GRAPHEMES { buffer.mergeOutClusters(b, start, end) }
                continue
            }
        } else if isCombinedS(u) {
            const s = u
            const hasGlyph = font.hasGlyph(f, s)
            const lindex = (s - S_BASE) / N_COUNT
            const nindex = (s - S_BASE) % N_COUNT
            const vindex = nindex / T_COUNT
            const tindex = nindex % T_COUNT
            if tindex == 0 && b.*.idx + 1 < count && isCombiningT(buffer.curAt(b, 1).*.codepoint) {
                const newS = s + buffer.curAt(b, 1).*.codepoint - T_BASE
                if font.hasGlyph(f, newS) {
                    chars[0] = newS
                    _ = buffer.replaceGlyphs(b, 2, 1, @intFromPtr(&chars))
                    end = start + 1
                    continue
                } else {
                    buffer.unsafeToBreak(b, b.*.idx, b.*.idx + 2)
                }
            }
            if !hasGlyph || (tindex == 0 && b.*.idx + 1 < count && isT(buffer.curAt(b, 1).*.codepoint)) {
                chars[0] = L_BASE + lindex
                chars[1] = V_BASE + vindex
                chars[2] = T_BASE + tindex
                if font.hasGlyph(f, chars[0]) && font.hasGlyph(f, chars[1]) && (tindex == 0 || font.hasGlyph(f, chars[2])) {
                    var sLen: u32 = if tindex != 0 { 3 } else { 2 }
                    _ = buffer.replaceGlyphs(b, 1, sLen, @intFromPtr(&chars))
                    if hasGlyph && tindex == 0 {
                        _ = buffer.nextGlyph(b)
                        sLen += 1
                    }
                    if b.*.successful == 0 { break }
                    end = start + sLen
                    var i = start
                    p.setAuxiliary(buffer.outInfo(b, i), LJMO)
                    i += 1
                    p.setAuxiliary(buffer.outInfo(b, i), VJMO)
                    i += 1
                    if i < end { p.setAuxiliary(buffer.outInfo(b, i), TJMO) }
                    if b.*.clusterLevel == buffer.CLUSTER_MONOTONE_GRAPHEMES { buffer.mergeOutClusters(b, start, end) }
                    continue
                } else if tindex == 0 && b.*.idx + 1 < count && isT(buffer.curAt(b, 1).*.codepoint) {
                    buffer.unsafeToBreak(b, b.*.idx, b.*.idx + 2)
                }
            }
            if hasGlyph { end = start + 1 }
        }
        _ = buffer.nextGlyph(b)
    }
    _ = buffer.sync(b)
}

pub fn setupMasks(pl: *plan.Plan, b: *buffer.Buffer) -> void {
    const data = pl.*.data
    if data == 0 { return }
    var i: u32 = 0
    while i < b.*.len {
        const g = buffer.info(b, i)
        const feature = p.auxiliary(g)
        if feature < 4 { g.*.mask |= m.get32(data + @intCast(usize, feature) * 4) }
        i += 1
    }
}
