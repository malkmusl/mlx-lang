// Glyph outlines (HarfBuzz's hb_ot_draw_glyph and hb-outline.cc): glyf,
// then CFF2, then CFF paths drawn with draw functions; for an emboldened
// font the path recorded first, emboldened (FreeType's
// FT_Outline_EmboldenXY, as HarfBuzz ports it) and replayed.
const m = @import("./memory.mlx")
const o = @import("./object.mlx")
const face = @import("./face.mlx")
const font = @import("./font.mlx")
const draw = @import("./draw.mlx")
const paint = @import("./paint.mlx")
const glyf = @import("./glyf.mlx")
const cff = @import("./cff.mlx")

const MOVE: u32 = 0
const LINE: u32 = 1
const QUADRATIC: u32 = 2
const CUBIC: u32 = 3

// A recorded outline: points (x, y as f32, the kind as u32) and the ends
// of the contours (a u32 each, the number of points before the end).
const Outline = struct {
    points: usize
    count: u32
    cap: u32
    contours: usize
    contourCount: u32
    contourCap: u32
}

fn outlineOf(address: usize) -> *Outline { unsafe { return @ptrFromInt(*Outline, address) } }

fn push(ol: *Outline, x: f32, y: f32, kind: u32) -> void {
    if ol.*.count == ol.*.cap {
        const cap = if ol.*.cap == 0 { @intCast(u32, 64) } else { ol.*.cap * 2 }
        const grown = m.grow(ol.*.points, @intCast(usize, cap) * 12)
        if grown == 0 { return }
        ol.*.points = grown
        ol.*.cap = cap
    }
    const p = ol.*.points + @intCast(usize, ol.*.count) * 12
    m.putF32(p, x)
    m.putF32(p + 4, y)
    m.put32(p + 8, kind)
    ol.*.count += 1
}

fn recordMoveTo(d: usize, data: usize, st: usize, x: f32, y: f32, user: usize) -> void { push(outlineOf(data), x, y, MOVE) }
fn recordLineTo(d: usize, data: usize, st: usize, x: f32, y: f32, user: usize) -> void { push(outlineOf(data), x, y, LINE) }

fn recordQuadraticTo(d: usize, data: usize, st: usize, cx: f32, cy: f32, x: f32, y: f32, user: usize) -> void {
    push(outlineOf(data), cx, cy, QUADRATIC)
    push(outlineOf(data), x, y, QUADRATIC)
}

fn recordCubicTo(d: usize, data: usize, st: usize, c1x: f32, c1y: f32, c2x: f32, c2y: f32, x: f32, y: f32, user: usize) -> void {
    push(outlineOf(data), c1x, c1y, CUBIC)
    push(outlineOf(data), c2x, c2y, CUBIC)
    push(outlineOf(data), x, y, CUBIC)
}

fn recordClosePath(d: usize, data: usize, st: usize, user: usize) -> void {
    const ol = outlineOf(data)
    if ol.*.contourCount == ol.*.contourCap {
        const cap = if ol.*.contourCap == 0 { @intCast(u32, 16) } else { ol.*.contourCap * 2 }
        const grown = m.grow(ol.*.contours, @intCast(usize, cap) * 4)
        if grown == 0 { return }
        ol.*.contours = grown
        ol.*.contourCap = cap
    }
    m.put32(ol.*.contours + @intCast(usize, ol.*.contourCount) * 4, ol.*.count)
    ol.*.contourCount += 1
}

var recordingFuncs: usize = 0

fn recordingPen() -> usize {
    var d = m.atomicLoadWord(@intFromPtr(&recordingFuncs))
    if d == 0 {
        const made = draw.create()
        draw.setFunc(made, draw.MOVE_TO, @intFromPtr(recordMoveTo), 0, 0)
        draw.setFunc(made, draw.LINE_TO, @intFromPtr(recordLineTo), 0, 0)
        draw.setFunc(made, draw.QUADRATIC_TO, @intFromPtr(recordQuadraticTo), 0, 0)
        draw.setFunc(made, draw.CUBIC_TO, @intFromPtr(recordCubicTo), 0, 0)
        draw.setFunc(made, draw.CLOSE_PATH, @intFromPtr(recordClosePath), 0, 0)
        o.makeImmutable(made)
        if !m.swapWord(@intFromPtr(&recordingFuncs), 0, made) { draw.destroy(made) }
        d = m.atomicLoadWord(@intFromPtr(&recordingFuncs))
    }
    return d
}

fn ox(ol: *Outline, i: u32) -> f32 { return m.getF32(ol.*.points + @intCast(usize, i) * 12) }
fn oy(ol: *Outline, i: u32) -> f32 { return m.getF32(ol.*.points + @intCast(usize, i) * 12 + 4) }
fn okind(ol: *Outline, i: u32) -> u32 { return m.get32(ol.*.points + @intCast(usize, i) * 12 + 8) }
fn contourEnd(ol: *Outline, c: u32) -> u32 { return m.get32(ol.*.contours + @intCast(usize, c) * 4) }

fn replay(ol: *Outline, funcs: usize, data: usize) -> void {
    var st: [12]u32 = undefined
    const s = @intFromPtr(&st)
    m.zero(s, draw.STATE_SIZE)
    var first: u32 = 0
    var c: u32 = 0
    while c < ol.*.contourCount {
        const end = contourEnd(ol, c)
        var i = first
        while i < end {
            const kind = okind(ol, i)
            if kind == MOVE {
                draw.moveTo(funcs, data, s, ox(ol, i), oy(ol, i))
                i += 1
            } else if kind == LINE {
                draw.lineTo(funcs, data, s, ox(ol, i), oy(ol, i))
                i += 1
            } else if kind == QUADRATIC {
                draw.quadraticTo(funcs, data, s, ox(ol, i), oy(ol, i), ox(ol, i + 1), oy(ol, i + 1))
                i += 2
            } else {
                draw.cubicTo(funcs, data, s, ox(ol, i), oy(ol, i), ox(ol, i + 1), oy(ol, i + 1), ox(ol, i + 2), oy(ol, i + 2))
                i += 3
            }
        }
        draw.closePath(funcs, data, s)
        first = end
        c += 1
    }
}

fn controlArea(ol: *Outline) -> f32 {
    var a: f32 = 0.0
    var first: u32 = 0
    var c: u32 = 0
    while c < ol.*.contourCount {
        const end = contourEnd(ol, c)
        var i = first
        while i < end {
            const j = if i + 1 < end { i + 1 } else { first }
            a += ox(ol, i) * oy(ol, j) - oy(ol, i) * ox(ol, j)
            i += 1
        }
        first = end
        c += 1
    }
    return a * 0.5
}

// hypotf, as the C library computes it (in double).
fn hypot(x: f32, y: f32) -> f32 {
    const dx = @floatCast(f64, x)
    const dy = @floatCast(f64, y)
    return @floatCast(f32, @sqrt(dx * dx + dy * dy))
}

fn embolden(ol: *Outline, xStrength_: f32, yStrength_: f32, xShift: f32, yShift: f32) -> void {
    if xStrength_ == 0.0 && yStrength_ == 0.0 { return }
    if ol.*.count == 0 { return }
    const xStrength = xStrength_ / 2.0
    const yStrength = yStrength_ / 2.0
    const negative = controlArea(ol) < 0.0
    var first: i32 = 0
    var c: u32 = 0
    while c < ol.*.contourCount {
        var inX: f32 = 0.0
        var inY: f32 = 0.0
        var outX: f32 = 0.0
        var outY: f32 = 0.0
        var anchorX: f32 = 0.0
        var anchorY: f32 = 0.0
        var shiftX: f32 = 0.0
        var shiftY: f32 = 0.0
        var lIn: f32 = 0.0
        var lOut: f32 = 0.0
        var lAnchor: f32 = 0.0
        const last = @intCast(i32, contourEnd(ol, c)) - 1
        var i = last
        var j = first
        var k: i32 = -1
        while j != i && i != k {
            var skip = false
            if j != k {
                outX = ox(ol, @intCast(u32, j)) - ox(ol, @intCast(u32, i))
                outY = oy(ol, @intCast(u32, j)) - oy(ol, @intCast(u32, i))
                lOut = hypot(outX, outY)
                if lOut != 0.0 {
                    outX /= lOut
                    outY /= lOut
                } else {
                    skip = true
                }
            } else {
                outX = anchorX
                outY = anchorY
                lOut = lAnchor
            }
            if !skip {
                if lIn != 0.0 {
                    if k < 0 {
                        k = i
                        anchorX = inX
                        anchorY = inY
                        lAnchor = lIn
                    }
                    var d = inX * outX + inY * outY
                    if d > -15.0 / 16.0 {
                        d = d + 1.0
                        shiftX = inY + outY
                        shiftY = inX + outX
                        if negative { shiftX = 0.0 - shiftX } else { shiftY = 0.0 - shiftY }
                        var q = outX * inY - outY * inX
                        if negative { q = 0.0 - q }
                        const l = if lIn < lOut { lIn } else { lOut }
                        if xStrength * q <= l * d { shiftX = shiftX * xStrength / d } else { shiftX = shiftX * l / q }
                        if yStrength * q <= l * d { shiftY = shiftY * yStrength / d } else { shiftY = shiftY * l / q }
                    } else {
                        shiftX = 0.0
                        shiftY = 0.0
                    }
                    while i != j {
                        const p = ol.*.points + @intCast(usize, i) * 12
                        m.putF32(p, m.getF32(p) + (xShift + shiftX))
                        m.putF32(p + 4, m.getF32(p + 4) + (yShift + shiftY))
                        i = if i < last { i + 1 } else { first }
                    }
                } else {
                    i = j
                }
                inX = outX
                inY = outY
                lIn = lOut
            }
            j = if j < last { j + 1 } else { first }
        }
        first = last + 1
        c += 1
    }
}

// Draws `glyph` of the font (hb_ot_draw_glyph).
pub fn drawGlyph(f: usize, glyph: u32, funcs: usize, data: usize) -> void {
    const fo = font.font(f)
    const bold = fo.*.xStrength != 0 || fo.*.yStrength != 0
    var ol: Outline = undefined
    m.zero(@intFromPtr(&ol), @sizeOf(Outline))
    const s = draw.beginSession(if bold { recordingPen() } else { funcs }, if bold { @intFromPtr(&ol) } else { data }, fo.*.slantXy)
    if s == 0 { return }
    if !glyf.getPath(f, glyph, s) {
        if !cff.getPath2(f, glyph, s) { _ = cff.getPath(f, glyph, s) }
    }
    draw.endSession(s)
    if bold {
        var xShift: f32 = if fo.*.emboldenInPlace != 0 { 0.0 } else { @floatFromInt(f32, fo.*.xStrength) / 2.0 }
        var yShift: f32 = @floatFromInt(f32, fo.*.yStrength) / 2.0
        if fo.*.xScale < 0 { xShift = 0.0 - xShift }
        if fo.*.yScale < 0 { yShift = 0.0 - yShift }
        embolden(&ol, @floatFromInt(f32, fo.*.xStrength), @floatFromInt(f32, fo.*.yStrength), xShift, yShift)
        replay(&ol, funcs, data)
        m.release(ol.points)
        m.release(ol.contours)
    }
}

// An outline glyph painted: its clip filled with the foreground (glyf's
// paint_glyph, which HarfBuzz reaches for every glyph without color).
pub fn paintGlyph(f: usize, glyph: u32, funcs: usize, data: usize, foreground: u32) -> void {
    paint.pushClipGlyph(funcs, data, glyph, f)
    paint.color(funcs, data, true, foreground)
    paint.popClip(funcs, data)
}
