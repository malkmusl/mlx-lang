// Color glyphs: COLR and CPAL (colr.mlx), the PNG images of sbix and of
// CBDT and CBLC, the SVG documents of SVG (HarfBuzz's OT/Color/sbix,
// OT/Color/CBDT, OT/Color/svg and hb-ot-color.cc): the tables checked as
// HarfBuzz checks them, the strike chosen for the font's ppem, glyph
// extents from the images, and painting a color glyph.
const m = @import("./memory.mlx")
const face = @import("./face.mlx")
const font = @import("./font.mlx")
const blob = @import("./blob.mlx")
const paint = @import("./paint.mlx")
const sanitize = @import("./sanitize.mlx")
const colr = @import("./colr.mlx")

const TAG_PNG: u32 = 0x706E6720
const TAG_SVG: u32 = 0x73766720
const TAG_DUPE: u32 = 0x64757065

const S = sanitize.Sanitizer

// ---------------------------------------------------------------------------
// The tables

pub const Bitmaps = struct {
    t: m.Table
    copy: usize
    t2: m.Table
    copy2: usize
    numGlyphs: u32
}

fn bitmapsOf(address: usize) -> *Bitmaps { unsafe { return @ptrFromInt(*Bitmaps, address) } }

pub fn bitmapsFreeCallback(a: usize) -> void {
    const b = bitmapsOf(a)
    if b.*.copy != 0 { m.release(b.*.copy) }
    if b.*.copy2 != 0 { m.release(b.*.copy2) }
    m.release(a)
}

// An offset of 4 bytes at `field` that may be null, to a strike.
fn strikeChecks(s: *S, field: usize) -> bool {
    if !sanitize.range(s, field, 4) { return false }
    const off = @intCast(usize, sanitize.u32at(s, field))
    if off == 0 { return true }
    if sanitize.range(s, off, 4) && sanitize.array(s, off + 4, s.*.numGlyphs +% 1, 4) { return true }
    return sanitize.neuter(s, field, 4)
}

fn sbixChecks(s: *S) -> bool {
    if !sanitize.range(s, 0, 8) || sanitize.u16at(s, 0) < 1 { return false }
    if !sanitize.range(s, 4, 4) { return false }
    const n = sanitize.u32at(s, 4)
    if !sanitize.array(s, 8, n, 4) { return false }
    var i: u32 = 0
    while i < n {
        if !strikeChecks(s, 8 + @intCast(usize, i) * 4) { return false }
        i += 1
    }
    return true
}

// An index subtable (its format 1 or 3 offsets for `count` glyphs) behind
// an offset that may be null.
fn subtableChecks(s: *S, field: usize, base: usize, count: u32) -> bool {
    if !sanitize.range(s, field, 4) { return false }
    const off = @intCast(usize, sanitize.u32at(s, field))
    if off == 0 { return true }
    const at = base + off
    var ok = sanitize.range(s, at, 8)
    if ok {
        const format = sanitize.u16at(s, at)
        if format == 1 || format == 3 {
            ok = sanitize.range(s, at, 8) && sanitize.array(s, at + 8, count +% 1, if format == 1 { 4 } else { 2 })
        }
    }
    if ok { return true }
    return sanitize.neuter(s, field, 4)
}

fn cblcChecks(s: *S) -> bool {
    if !sanitize.range(s, 0, 8) { return false }
    const major = sanitize.u16at(s, 0)
    if major != 2 && major != 3 { return false }
    if !sanitize.range(s, 4, 4) { return false }
    const n = sanitize.u32at(s, 4)
    if !sanitize.array(s, 8, n, 48) { return false }
    var i: u32 = 0
    while i < n {
        const st = 8 + @intCast(usize, i) * 48
        if !sanitize.range(s, st, 48) || !sanitize.range(s, st, 4) { return false }
        const arr = @intCast(usize, sanitize.u32at(s, st))
        const count = sanitize.u32at(s, st + 8)
        if !sanitize.array(s, arr, count, 8) { return false }
        var k: u32 = 0
        while k < count {
            const r = arr + @intCast(usize, k) * 8
            if !sanitize.range(s, r, 8) { return false }
            const first = sanitize.u16at(s, r)
            const last = sanitize.u16at(s, r + 2)
            if first > last || !subtableChecks(s, r + 4, arr, last - first + 1) { return false }
            k += 1
        }
        if !sanitize.range(s, st + 16, 12) || !sanitize.range(s, st + 28, 12) { return false }
        i += 1
    }
    return true
}

fn cbdtChecks(s: *S) -> bool {
    if !sanitize.range(s, 0, 4) { return false }
    const major = sanitize.u16at(s, 0)
    return major == 2 || major == 3
}

fn svgChecks(s: *S) -> bool {
    if !sanitize.range(s, 0, 10) { return false }
    const off = @intCast(usize, sanitize.u32at(s, 2))
    if off == 0 { return false }
    if !sanitize.range(s, off, 2) { return false }
    return sanitize.array(s, off + 2, sanitize.u16at(s, off), 12)
}

fn bitmaps(fc: usize, slot: usize, t1: usize, check1: usize, t2: usize, check2: usize) -> *Bitmaps {
    var a = face.accel(fc, slot)
    if a == 0 {
        const made = m.alloc(@sizeOf(Bitmaps))
        const b = bitmapsOf(made)
        b.*.numGlyphs = face.numGlyphs(fc)
        var t: m.Table = undefined
        face.view(fc, t1, &t)
        sanitize.sanitizeTable(&t, b.*.numGlyphs, check1, &b.*.t, &b.*.copy)
        if t2 != 0 {
            face.view(fc, t2, &t)
            sanitize.sanitizeTable(&t, b.*.numGlyphs, check2, &b.*.t2, &b.*.copy2)
        }
        a = face.keepAccel(fc, slot, made, @intFromPtr(bitmapsFreeCallback))
    }
    return bitmapsOf(a)
}

fn sbixOf(fc: usize) -> *Bitmaps { return bitmaps(fc, face.A_SBIX, face.T_SBIX, @intFromPtr(sbixChecks), 0, 0) }
// (CBLC in t, CBDT in t2.)
fn cbdtOf(fc: usize) -> *Bitmaps { return bitmaps(fc, face.A_CBDT, face.T_CBLC, @intFromPtr(cblcChecks), face.T_CBDT, @intFromPtr(cbdtChecks)) }
fn svgOf(fc: usize) -> *Bitmaps { return bitmaps(fc, face.A_SVG, face.T_SVG, @intFromPtr(svgChecks), 0, 0) }

fn requestedPpem(f: usize) -> u32 {
    const fo = font.font(f)
    const p = if fo.*.xPpem > fo.*.yPpem { fo.*.xPpem } else { fo.*.yPpem }
    return if p == 0 { @intCast(u32, 1) << 30 } else { p }
}

// ---------------------------------------------------------------------------
// sbix

fn sbixHasData(b: *Bitmaps) -> bool { return m.u16at(&b.*.t, 0) != 0 }

// The strike for the font's ppem (0: none).
fn sbixStrike(b: *Bitmaps, f: usize) -> usize {
    const t = &b.*.t
    const count = m.u32at(t, 4)
    if count == 0 { return 0 }
    const requested = requestedPpem(f)
    var best: u32 = 0
    var bestPpem = sbixStrikePpem(t, 0)
    var i: u32 = 1
    while i < count {
        const ppem = sbixStrikePpem(t, i)
        if (requested <= ppem && ppem < bestPpem) || (requested > bestPpem && ppem > bestPpem) {
            best = i
            bestPpem = ppem
        }
        i += 1
    }
    return @intCast(usize, m.u32at(t, 8 + @intCast(usize, best) * 4))
}

fn sbixStrikePpem(t: *m.Table, i: u32) -> u32 {
    const off = @intCast(usize, m.u32at(t, 8 + @intCast(usize, i) * 4))
    return if off == 0 { @intCast(u32, 0) } else { m.u16at(t, off) }
}

// The PNG of `glyph` in the strike for the font (the empty blob: none),
// with the image's offsets and the strike's ppem.
fn sbixPng(fc: usize, f: usize, glyph_: u32, xOffset: *i32, yOffset: *i32, ppem: *u32) -> usize {
    const b = sbixOf(fc)
    const t = &b.*.t
    const strike = sbixStrike(b, f)
    if strike == 0 { return blob.getEmpty() }
    var glyph = glyph_
    var retries: u32 = 8
    while true {
        if glyph >= b.*.numGlyphs { return blob.getEmpty() }
        const o0 = m.u32at(t, strike + 4 + @intCast(usize, glyph) * 4)
        const o1 = m.u32at(t, strike + 4 + @intCast(usize, glyph + 1) * 4)
        if o1 <= o0 || o1 - o0 <= 8 || @intCast(usize, o1) > t.*.length - strike { return blob.getEmpty() }
        const g = strike + @intCast(usize, o0)
        const length = o1 - o0 - 8
        const type_ = m.u32at(t, g + 4)
        if type_ == TAG_DUPE {
            if length >= 2 {
                glyph = m.u16at(t, g + 8)
                if retries > 0 {
                    retries -= 1
                    continue
                }
            }
            return blob.getEmpty()
        }
        if type_ != TAG_PNG { return blob.getEmpty() }
        ppem.* = m.u16at(t, strike)
        xOffset.* = m.i16at(t, g)
        yOffset.* = m.i16at(t, g + 2)
        return blob.subBlob(face.table(fc, face.T_SBIX), @intCast(u32, g + 8), length)
    }
    return blob.getEmpty()
}

fn sbixExtents(f: usize, glyph: u32, e: usize, scale: bool) -> bool {
    const fc = font.font(f).*.face
    if !sbixHasData(sbixOf(fc)) { return false }
    var x: i32 = 0
    var y: i32 = 0
    var ppem: u32 = 0
    const png = sbixPng(fc, f, glyph, &x, &y, &ppem)
    var width: u32 = 0
    var height: u32 = 0
    const pb = blob.blob(png)
    if pb.*.length >= 29 {
        width = m.be32(pb.*.data + 16)
        height = m.be32(pb.*.data + 20)
    }
    if height >= 65536 || width >= 65536 {
        blob.destroyBlob(png)
        return false
    }
    var xb = x
    var yb = @bitCast(i32, height +% @bitCast(u32, y))
    var w = @bitCast(i32, width)
    var h = 0 - @bitCast(i32, height)
    if ppem != 0 && scale {
        const s = @floatFromInt(f32, face.upem(fc)) / @floatFromInt(f32, ppem)
        xb = m.intOf(m.roundf(@floatFromInt(f32, xb) * s))
        yb = m.intOf(m.roundf(@floatFromInt(f32, yb) * s))
        w = m.intOf(m.roundf(@floatFromInt(f32, w) * s))
        h = m.intOf(m.roundf(@floatFromInt(f32, h) * s))
    }
    m.putI32(e, xb)
    m.putI32(e + 4, yb)
    m.putI32(e + 8, w)
    m.putI32(e + 12, h)
    if scale { font.scaleGlyphExtents(f, e) }
    blob.destroyBlob(png)
    return ppem != 0
}

fn sbixPaint(f: usize, glyph: u32, funcs: usize, data: usize) -> bool {
    const fc = font.font(f).*.face
    if !sbixHasData(sbixOf(fc)) { return false }
    var x: i32 = 0
    var y: i32 = 0
    var ppem: u32 = 0
    const png = sbixPng(fc, f, glyph, &x, &y, &ppem)
    if png == blob.getEmpty() { return false }
    return paintImage(f, glyph, funcs, data, png, false)
}

// Paints an image blob (consumed) with the glyph's extents and its
// unscaled extents from sbix (`cbdt` false) or CBDT.
fn paintImage(f: usize, glyph: u32, funcs: usize, data: usize, png: usize, cbdt: bool) -> bool {
    var extents: [4]i32 = [4]i32{ 0, 0, 0, 0 }
    var pixels: [4]i32 = [4]i32{ 0, 0, 0, 0 }
    if !font.getGlyphExtents(f, glyph, @intFromPtr(&extents)) { return false }
    const ok = if cbdt { cbdtExtents(f, glyph, @intFromPtr(&pixels), false) } else { sbixExtents(f, glyph, @intFromPtr(&pixels), false) }
    if !ok { return false }
    const r = paint.image(funcs, data, png, @bitCast(u32, pixels[2]), @bitCast(u32, 0 - pixels[3]), TAG_PNG, font.font(f).*.slantXy, @intFromPtr(&extents))
    blob.destroyBlob(png)
    return r
}

// ---------------------------------------------------------------------------
// CBDT and CBLC

fn cbdtStrike(b: *Bitmaps, f: usize) -> usize {
    const t = &b.*.t
    const count = m.u32at(t, 4)
    if count == 0 { return 0 }
    const requested = requestedPpem(f)
    var best: u32 = 0
    var bestPpem = cbdtStrikePpem(t, 0)
    var i: u32 = 1
    while i < count {
        const ppem = cbdtStrikePpem(t, i)
        if (requested <= ppem && ppem < bestPpem) || (requested > bestPpem && ppem > bestPpem) {
            best = i
            bestPpem = ppem
        }
        i += 1
    }
    return 8 + @intCast(usize, best) * 48
}

fn cbdtStrikePpem(t: *m.Table, i: u32) -> u32 {
    const st = 8 + @intCast(usize, i) * 48
    const x = m.u8at(t, st + 44)
    const y = m.u8at(t, st + 45)
    return if x > y { x } else { y }
}

// The image data of `glyph` in the strike for the font: its offset, length
// and format in CBDT, and the strike.
fn cbdtImage(b: *Bitmaps, f: usize, glyph: u32, offset: *u32, length: *u32, format: *u32, strikeOut: *usize) -> bool {
    const t = &b.*.t
    const st = cbdtStrike(b, f)
    strikeOut.* = st
    if st == 0 { return false }
    const arr = @intCast(usize, m.u32at(t, st))
    const count = m.u32at(t, st + 8)
    var rec: usize = 0
    var i: u32 = 0
    while i < count {
        const r = arr + @intCast(usize, i) * 8
        if m.u16at(t, r) <= glyph && glyph <= m.u16at(t, r + 2) {
            rec = r
            break
        }
        i += 1
    }
    if rec == 0 || m.u8at(t, st + 44) == 0 || m.u8at(t, st + 45) == 0 { return false }
    const off = @intCast(usize, m.u32at(t, rec + 4))
    if off == 0 { return false }
    const sub = arr + off
    format.* = m.u16at(t, sub + 2)
    const index = m.u16at(t, sub)
    const idx = glyph - m.u16at(t, rec)
    var o0: u32 = 0
    var o1: u32 = 0
    if index == 1 {
        o0 = m.u32at(t, sub + 8 + @intCast(usize, idx) * 4)
        o1 = m.u32at(t, sub + 8 + @intCast(usize, idx + 1) * 4)
    } else if index == 3 {
        o0 = m.u16at(t, sub + 8 + @intCast(usize, idx) * 2)
        o1 = m.u16at(t, sub + 8 + @intCast(usize, idx + 1) * 2)
    } else {
        return false
    }
    if o1 <= o0 { return false }
    offset.* = m.u32at(t, sub + 4) +% o0
    length.* = o1 - o0
    const cbdtLength = @intCast(u32, b.*.t2.length)
    return !(offset.* > cbdtLength || cbdtLength - offset.* < length.*)
}

fn cbdtExtents(f: usize, glyph: u32, e: usize, scale: bool) -> bool {
    const fc = font.font(f).*.face
    const b = cbdtOf(fc)
    var offset: u32 = 0
    var length: u32 = 0
    var format: u32 = 0
    var st: usize = 0
    if !cbdtImage(b, f, glyph, &offset, &length, &format, &st) { return false }
    if format == 17 {
        if length < 9 { return false }
    } else if format == 18 {
        if length < 12 { return false }
    } else {
        return false
    }
    const d = &b.*.t2
    const at = @intCast(usize, offset)
    m.putI32(e, @intCast(i32, @bitCast(i8, @intCast(u8, m.u8at(d, at + 2)))))
    m.putI32(e + 4, @intCast(i32, @bitCast(i8, @intCast(u8, m.u8at(d, at + 3)))))
    m.putI32(e + 8, @bitCast(i32, m.u8at(d, at + 1)))
    m.putI32(e + 12, 0 - @bitCast(i32, m.u8at(d, at)))
    if scale {
        font.scaleGlyphExtents(f, e)
        const upem = @floatFromInt(f32, face.upem(fc))
        const xs = upem / @floatFromInt(f32, m.u8at(&b.*.t, st + 44))
        const ys = upem / @floatFromInt(f32, m.u8at(&b.*.t, st + 45))
        m.putI32(e, m.intOf(m.roundf(@floatFromInt(f32, m.getI32(e)) * xs)))
        m.putI32(e + 4, m.intOf(m.roundf(@floatFromInt(f32, m.getI32(e + 4)) * ys)))
        m.putI32(e + 8, m.intOf(m.roundf(@floatFromInt(f32, m.getI32(e + 8)) * xs)))
        m.putI32(e + 12, m.intOf(m.roundf(@floatFromInt(f32, m.getI32(e + 12)) * ys)))
    }
    return true
}

fn cbdtPng(f: usize, glyph: u32) -> usize {
    const fc = font.font(f).*.face
    const b = cbdtOf(fc)
    var offset: u32 = 0
    var length: u32 = 0
    var format: u32 = 0
    var st: usize = 0
    if !cbdtImage(b, f, glyph, &offset, &length, &format, &st) { return blob.getEmpty() }
    const d = &b.*.t2
    const at = @intCast(usize, offset)
    var head: u32 = 0
    if format == 17 {
        head = 9
    } else if format == 18 {
        head = 12
    } else if format == 19 {
        head = 4
    } else {
        return blob.getEmpty()
    }
    if length < head { return blob.getEmpty() }
    return blob.subBlob(face.table(fc, face.T_CBDT), offset + head, m.u32at(d, at + @intCast(usize, head) - 4))
}

fn cbdtHasData(fc: usize) -> bool { return cbdtOf(fc).*.t2.length != 0 }

fn cbdtPaint(f: usize, glyph: u32, funcs: usize, data: usize) -> bool {
    const png = cbdtPng(f, glyph)
    if png == blob.getEmpty() { return false }
    return paintImage(f, glyph, funcs, data, png, true)
}

// ---------------------------------------------------------------------------
// SVG

fn svgHasData(fc: usize) -> bool { return m.u32at(&svgOf(fc).*.t, 2) != 0 }

fn svgBlob(fc: usize, glyph: u32) -> usize {
    const t = &svgOf(fc).*.t
    const list = m.u32at(t, 2)
    if list == 0 { return blob.getEmpty() }
    const at = @intCast(usize, list)
    var lo: i64 = 0
    var hi: i64 = @intCast(i64, m.u16at(t, at)) - 1
    while lo <= hi {
        const mid = @intCast(i64, (@intCast(u64, lo) + @intCast(u64, hi)) / 2)
        const r = at + 2 + @intCast(usize, mid) * 12
        if glyph < m.u16at(t, r) {
            hi = mid - 1
        } else if glyph > m.u16at(t, r + 2) {
            lo = mid + 1
        } else {
            return blob.subBlob(face.table(fc, face.T_SVG), list +% m.u32at(t, r + 4), m.u32at(t, r + 8))
        }
    }
    return blob.getEmpty()
}

fn svgPaint(f: usize, glyph: u32, funcs: usize, data: usize) -> bool {
    const fc = font.font(f).*.face
    if !svgHasData(fc) { return false }
    const b = svgBlob(fc, glyph)
    if b == blob.getEmpty() { return false }
    _ = paint.image(funcs, data, b, 0, 0, TAG_SVG, font.font(f).*.slantXy, 0)
    blob.destroyBlob(b)
    return true
}

// ---------------------------------------------------------------------------
// The font functions' parts and the API

// The extents of a bitmap glyph (sbix, then CBDT), scaled to the font.
pub fn getBitmapExtents(f: usize, glyph: u32, e: usize) -> bool {
    if sbixExtents(f, glyph, e, true) { return true }
    return cbdtExtents(f, glyph, e, true)
}

pub fn getColrExtents(f: usize, glyph: u32, e: usize) -> bool { return colr.getExtents(f, glyph, e) }

// Paints a color glyph (COLR, SVG, CBDT, sbix): whether it is one.
pub fn paintGlyph(f: usize, glyph: u32, funcs: usize, data: usize, palette: u32, foreground: u32) -> bool {
    if colr.paintGlyph(f, glyph, funcs, data, palette, foreground) { return true }
    if svgPaint(f, glyph, funcs, data) { return true }
    if cbdtPaint(f, glyph, funcs, data) { return true }
    return sbixPaint(f, glyph, funcs, data)
}

pub fn otColorHasSvg(fc: usize) -> i32 { return if svgHasData(fc) { 1 } else { 0 } }
pub fn otColorGlyphReferenceSvg(fc: usize, glyph: u32) -> usize { return svgBlob(fc, glyph) }
pub fn otColorHasPng(fc: usize) -> i32 { return if cbdtHasData(fc) || sbixHasData(sbixOf(fc)) { 1 } else { 0 } }

pub fn otColorGlyphReferencePng(f: usize, glyph: u32) -> usize {
    const fc = font.font(f).*.face
    var b = blob.getEmpty()
    if sbixHasData(sbixOf(fc)) {
        var x: i32 = 0
        var y: i32 = 0
        var ppem: u32 = 0
        b = sbixPng(fc, f, glyph, &x, &y, &ppem)
    }
    if blob.blob(b).*.length == 0 && cbdtHasData(fc) { b = cbdtPng(f, glyph) }
    return b
}
