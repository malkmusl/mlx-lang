// Positioning without GPOS (HarfBuzz's hb-ot-shape-fallback.cc): marks
// placed around their base by their combining classes and the glyphs'
// extents, and the widths of the Unicode spaces the font lacks glyphs for.
const m = @import("./memory.mlx")
const common = @import("./common.mlx")
const unicode = @import("./unicode.mlx")
const font = @import("./font.mlx")
const buffer = @import("./buffer.mlx")
const p = @import("./props.mlx")
const plan = @import("./plan.mlx")

// Combining classes.
const CC_ATTACHED_BELOW_LEFT: u32 = 200
const CC_ATTACHED_BELOW: u32 = 202
const CC_ATTACHED_ABOVE: u32 = 214
const CC_ATTACHED_ABOVE_RIGHT: u32 = 216
const CC_BELOW_LEFT: u32 = 218
const CC_BELOW: u32 = 220
const CC_BELOW_RIGHT: u32 = 222
const CC_LEFT: u32 = 224
const CC_RIGHT: u32 = 226
const CC_ABOVE_LEFT: u32 = 228
const CC_ABOVE: u32 = 230
const CC_ABOVE_RIGHT: u32 = 232
const CC_DOUBLE_BELOW: u32 = 233
const CC_DOUBLE_ABOVE: u32 = 234

fn recategorize(u: u32, klass_: u32) -> u32 {
    var klass = klass_
    if klass >= 200 { return klass }
    if (u & ~@intCast(u32, 0xFF)) == 0x0E00 {
        if klass == 0 {
            if u == 0x0E31 || u == 0x0E34 || u == 0x0E35 || u == 0x0E36 || u == 0x0E37 || u == 0x0E47 || u == 0x0E4C || u == 0x0E4D || u == 0x0E4E {
                klass = CC_ABOVE_RIGHT
            } else if u == 0x0EB1 || u == 0x0EB4 || u == 0x0EB5 || u == 0x0EB6 || u == 0x0EB7 || u == 0x0EBB || u == 0x0ECC || u == 0x0ECD {
                klass = CC_ABOVE
            } else if u == 0x0EBC {
                klass = CC_BELOW
            }
        } else {
            if u == 0x0E3A { klass = CC_BELOW_RIGHT }
        }
    }
    // Hebrew.
    if klass == 10 || klass == 11 || klass == 12 || klass == 13 || klass == 14 || klass == 15 || klass == 16 || klass == 17 || klass == 18 || klass == 20 || klass == 22 { return CC_BELOW }
    if klass == 23 { return CC_ATTACHED_ABOVE }
    if klass == 24 { return CC_ABOVE_RIGHT }
    if klass == 25 || klass == 19 { return CC_ABOVE_LEFT }
    if klass == 26 { return CC_ABOVE }
    if klass == 21 { return klass }
    // Arabic and Syriac.
    if klass == 27 || klass == 28 || klass == 30 || klass == 31 || klass == 33 || klass == 34 || klass == 35 || klass == 36 { return CC_ABOVE }
    if klass == 29 || klass == 32 { return CC_BELOW }
    // Thai, Lao, Tibetan.
    if klass == 103 { return CC_BELOW_RIGHT }
    if klass == 107 { return CC_ABOVE_RIGHT }
    if klass == 118 { return CC_BELOW }
    if klass == 122 { return CC_ABOVE }
    if klass == 129 { return CC_BELOW }
    if klass == 130 { return CC_ABOVE }
    if klass == 132 { return CC_BELOW }
    return klass
}

pub fn recategorizeMarks(b: *buffer.Buffer) -> void {
    var i: u32 = 0
    while i < b.*.len {
        const g = buffer.info(b, i)
        if p.generalCategory(g) == unicode.GC_NON_SPACING_MARK {
            p.setModifiedCombiningClass(g, recategorize(g.*.codepoint, p.modifiedCombiningClass(g)))
        }
        i += 1
    }
}

fn zeroMarkAdvances(b: *buffer.Buffer, start: u32, end: u32, adjust: bool) -> void {
    var i = start
    while i < end {
        if p.generalCategory(buffer.info(b, i)) == unicode.GC_NON_SPACING_MARK {
            const q = buffer.pos(b, i)
            if adjust {
                q.*.xOffset -%= q.*.xAdvance
                q.*.yOffset -%= q.*.yAdvance
            }
            q.*.xAdvance = 0
            q.*.yAdvance = 0
        }
        i += 1
    }
}

// Extents: x bearing, y bearing, width, height.
const Extents = struct {
    xb: i32
    yb: i32
    w: i32
    h: i32
}

fn getExtents(f: usize, g: u32, e: *Extents) -> bool {
    var raw: [4]i32 = [_]i32{ 0, 0, 0, 0 }
    const ok = font.getGlyphExtents(f, g, @intFromPtr(&raw))
    e.*.xb = raw[0]
    e.*.yb = raw[1]
    e.*.w = raw[2]
    e.*.h = raw[3]
    return ok
}

fn positionMark(f: usize, b: *buffer.Buffer, base: *Extents, i: u32, klass: u32) -> void {
    var mark: Extents = undefined
    if !getExtents(f, buffer.info(b, i).*.codepoint, &mark) { return }
    const yGap = font.font(f).*.yScale / 16
    const q = buffer.pos(b, i)
    q.*.xOffset = 0
    q.*.yOffset = 0
    var done = false
    if klass == CC_DOUBLE_BELOW || klass == CC_DOUBLE_ABOVE {
        if b.*.direction == common.DIRECTION_LTR {
            q.*.xOffset +%= base.*.xb + base.*.w - mark.w / 2 - mark.xb
            done = true
        } else if b.*.direction == common.DIRECTION_RTL {
            q.*.xOffset +%= base.*.xb - mark.w / 2 - mark.xb
            done = true
        }
    }
    if !done {
        if klass == CC_ATTACHED_BELOW_LEFT || klass == CC_BELOW_LEFT || klass == CC_ABOVE_LEFT {
            q.*.xOffset +%= base.*.xb - mark.xb
        } else if klass == CC_ATTACHED_ABOVE_RIGHT || klass == CC_BELOW_RIGHT || klass == CC_ABOVE_RIGHT {
            q.*.xOffset +%= base.*.xb + base.*.w - mark.w - mark.xb
        } else {
            q.*.xOffset +%= base.*.xb + (base.*.w - mark.w) / 2 - mark.xb
        }
    }
    if klass == CC_DOUBLE_BELOW || klass == CC_BELOW_LEFT || klass == CC_BELOW || klass == CC_BELOW_RIGHT || klass == CC_ATTACHED_BELOW_LEFT || klass == CC_ATTACHED_BELOW {
        if klass != CC_ATTACHED_BELOW_LEFT && klass != CC_ATTACHED_BELOW { base.*.h -%= yGap }
        q.*.yOffset = base.*.yb + base.*.h - mark.yb
        if (yGap > 0) == (q.*.yOffset > 0) {
            base.*.h -%= q.*.yOffset
            q.*.yOffset = 0
        }
        base.*.h +%= mark.h
    } else if klass == CC_DOUBLE_ABOVE || klass == CC_ABOVE_LEFT || klass == CC_ABOVE || klass == CC_ABOVE_RIGHT || klass == CC_ATTACHED_ABOVE || klass == CC_ATTACHED_ABOVE_RIGHT {
        if klass != CC_ATTACHED_ABOVE && klass != CC_ATTACHED_ABOVE_RIGHT {
            base.*.yb +%= yGap
            base.*.h -%= yGap
        }
        q.*.yOffset = base.*.yb - (mark.yb + mark.h)
        if (yGap > 0) != (q.*.yOffset > 0) {
            const correction = (0 - q.*.yOffset) / 2
            base.*.yb +%= correction
            base.*.h -%= correction
            q.*.yOffset +%= correction
        }
        base.*.yb -%= mark.h
        base.*.h +%= mark.h
    }
}

fn positionAroundBase(pl: *plan.Plan, f: usize, b: *buffer.Buffer, base: u32, end: u32, adjust: bool) -> void {
    var horizDir = common.DIRECTION_INVALID
    buffer.unsafeToBreak(b, base, end)
    var baseExtents: Extents = undefined
    if !getExtents(f, buffer.info(b, base).*.codepoint, &baseExtents) {
        zeroMarkAdvances(b, base + 1, end, adjust)
        return
    }
    baseExtents.yb +%= buffer.pos(b, base).*.yOffset
    baseExtents.xb = 0
    baseExtents.w = font.getGlyphHAdvance(f, buffer.info(b, base).*.codepoint)
    const ligId = p.ligId(buffer.info(b, base))
    const numLigComponents = @intCast(i32, p.ligNumComps(buffer.info(b, base)))
    var xOffset: i32 = 0
    var yOffset: i32 = 0
    if common.isForward(b.*.direction) {
        xOffset -%= buffer.pos(b, base).*.xAdvance
        yOffset -%= buffer.pos(b, base).*.yAdvance
    }
    var component: Extents = baseExtents
    var lastLigComponent: i32 = -1
    var lastCombiningClass: u32 = 255
    var cluster: Extents = baseExtents
    var i = base + 1
    while i < end {
        const g = buffer.info(b, i)
        if p.modifiedCombiningClass(g) != 0 {
            if numLigComponents > 1 {
                const thisLigId = p.ligId(g)
                var thisLigComponent = @intCast(i32, p.ligComp(g)) - 1
                if ligId == 0 || ligId != thisLigId || thisLigComponent >= numLigComponents { thisLigComponent = numLigComponents - 1 }
                if lastLigComponent != thisLigComponent {
                    lastLigComponent = thisLigComponent
                    lastCombiningClass = 255
                    component = baseExtents
                    if horizDir == common.DIRECTION_INVALID {
                        if common.isHorizontal(pl.*.direction) {
                            horizDir = pl.*.direction
                        } else {
                            horizDir = common.horizontalDirection(pl.*.script)
                        }
                    }
                    if horizDir == common.DIRECTION_LTR {
                        component.xb +%= (thisLigComponent * component.w) / numLigComponents
                    } else {
                        component.xb +%= ((numLigComponents - 1 - thisLigComponent) * component.w) / numLigComponents
                    }
                    component.w = component.w / numLigComponents
                }
            }
            const thisCombiningClass = p.modifiedCombiningClass(g)
            if lastCombiningClass != thisCombiningClass {
                lastCombiningClass = thisCombiningClass
                cluster = component
            }
            positionMark(f, b, &cluster, i, thisCombiningClass)
            const q = buffer.pos(b, i)
            q.*.xAdvance = 0
            q.*.yAdvance = 0
            q.*.xOffset +%= xOffset
            q.*.yOffset +%= yOffset
        } else {
            const q = buffer.pos(b, i)
            if common.isForward(b.*.direction) {
                xOffset -%= q.*.xAdvance
                yOffset -%= q.*.yAdvance
            } else {
                xOffset +%= q.*.xAdvance
                yOffset +%= q.*.yAdvance
            }
        }
        i += 1
    }
}

fn positionCluster(pl: *plan.Plan, f: usize, b: *buffer.Buffer, start: u32, end: u32, adjust: bool) -> void {
    if end - start < 2 { return }
    var i = start
    while i < end {
        if !p.isUnicodeMark(buffer.info(b, i)) {
            var j = i + 1
            while j < end {
                if !p.isUnicodeMark(buffer.info(b, j)) { break }
                j += 1
            }
            positionAroundBase(pl, f, b, i, j, adjust)
            i = j - 1
        }
        i += 1
    }
}

pub fn markPosition(pl: *plan.Plan, f: usize, b: *buffer.Buffer, adjust: bool) -> void {
    var start: u32 = 0
    const count = b.*.len
    var i: u32 = 1
    while i < count {
        if !p.isUnicodeMark(buffer.info(b, i)) {
            positionCluster(pl, f, b, start, i, adjust)
            start = i
        }
        i += 1
    }
    positionCluster(pl, f, b, start, count, adjust)
}

pub fn spaces(f: usize, b: *buffer.Buffer) -> void {
    const horizontal = common.isHorizontal(b.*.direction)
    const fo = font.font(f)
    var i: u32 = 0
    while i < b.*.len {
        const g = buffer.info(b, i)
        const q = buffer.pos(b, i)
        if p.isUnicodeSpace(g) && !p.ligated(g) {
            if b.*.invisible != 0 && g.*.codepoint == b.*.invisible {
                if horizontal {
                    q.*.xAdvance = fo.*.xScale / 4
                } else {
                    q.*.yAdvance = (0 - fo.*.yScale) / 4
                }
            }
            const t = p.spaceFallbackType(g)
            if t == unicode.SPACE_EM || t == unicode.SPACE_EM_2 || t == unicode.SPACE_EM_3 || t == unicode.SPACE_EM_4 || t == unicode.SPACE_EM_5 || t == unicode.SPACE_EM_6 || t == unicode.SPACE_EM_16 {
                const n = @intCast(i32, t)
                if horizontal {
                    q.*.xAdvance = (fo.*.xScale + n / 2) / n
                } else {
                    q.*.yAdvance = 0 - (fo.*.yScale + n / 2) / n
                }
            } else if t == unicode.SPACE_4_EM_18 {
                if horizontal {
                    q.*.xAdvance = @intCast(i32, @intCast(i64, fo.*.xScale) * 4 / 18)
                } else {
                    q.*.yAdvance = @intCast(i32, (0 - @intCast(i64, fo.*.yScale)) * 4 / 18)
                }
            } else if t == unicode.SPACE_FIGURE {
                var u: u32 = 0x30
                while u <= 0x39 {
                    var glyph: u32 = 0
                    if font.getNominalGlyph(f, u, &glyph) {
                        if horizontal {
                            q.*.xAdvance = font.getGlyphHAdvance(f, glyph)
                        } else {
                            q.*.yAdvance = font.getGlyphVAdvance(f, glyph)
                        }
                        break
                    }
                    u += 1
                }
            } else if t == unicode.SPACE_PUNCTUATION {
                var glyph: u32 = 0
                if font.getNominalGlyph(f, 0x2E, &glyph) || font.getNominalGlyph(f, 0x2C, &glyph) {
                    if horizontal {
                        q.*.xAdvance = font.getGlyphHAdvance(f, glyph)
                    } else {
                        q.*.yAdvance = font.getGlyphVAdvance(f, glyph)
                    }
                }
            } else if t == unicode.SPACE_NARROW {
                if horizontal {
                    q.*.xAdvance = q.*.xAdvance / 2
                } else {
                    q.*.yAdvance = q.*.yAdvance / 2
                }
            }
        }
        i += 1
    }
}
