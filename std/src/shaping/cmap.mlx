// The cmap table (HarfBuzz's hb-ot-cmap-table.hh): characters to glyphs
// by the best subtable of the font (a symbol one first, then the 32-bit
// Unicode ones, then the 16-bit ones), formats 0, 4, 6, 10, 12 and 13, and
// variation sequences by the format 14 subtable.
const m = @import("./memory.mlx")
const face = @import("./face.mlx")
const pua = @import("./arabicpua.mlx")
const set = @import("./set.mlx")

pub const Cmap = struct {
    table: m.Table
    // The chosen subtable (its offset in the table; 0: none) and its format.
    subtable: usize
    format: u32
    // For the symbol subtable (3, 0), how characters it lacks are asked
    // again (SYMBOL_PUA: U+0000..00FF as U+F000..F0FF; the Arabic font
    // pages: their private-use code points); 0 otherwise.
    symbol: u32
    uvs: usize
    // Format 4's arrays: segCount, then the offsets of its arrays.
    segCount: u32
    glyphIdArrayLength: u32
}

pub fn cmapOf(address: usize) -> *Cmap { unsafe { return @ptrFromInt(*Cmap, address) } }

fn findSubtable(t: *m.Table, platform: u32, encoding: u32) -> usize {
    const n = m.u16at(t, 2)
    var low: i64 = 0
    var high: i64 = @intCast(i64, n) - 1
    const key = (platform << 16) | encoding
    while low <= high {
        const mid = (low + high) / 2
        const r = 4 + @intCast(usize, mid) * 8
        const k = (m.u16at(t, r) << 16) | m.u16at(t, r + 2)
        if k == key {
            const offset = @intCast(usize, m.u32at(t, r + 4))
            if offset == 0 || offset >= t.*.length { return 0 }
            return offset
        }
        if k < key { low = mid + 1 } else { high = mid - 1 }
    }
    return 0
}

pub fn cmapFreeCallback(a: usize) -> void { m.release(a) }

// How a symbol subtable is read again for characters it lacks.
pub const SYMBOL_PUA: u32 = 1
pub const SYMBOL_SIMP_ARABIC: u32 = 2
pub const SYMBOL_TRAD_ARABIC: u32 = 3

// The font page of OS/2 (version 0 only; 0 without the table).
pub fn fontPage(fc: usize) -> u32 {
    var os2: m.Table = undefined
    face.view(fc, face.T_OS2, &os2)
    if os2.length < 78 { return 0 }
    return if m.u16at(&os2, 0) == 0 { m.u16at(&os2, 62) & 0xFF00 } else { 0 }
}

// How a symbol subtable of a font of OS/2 font `page` is read again (0:
// it is not).
pub fn symbolMode(page: u32) -> u32 {
    if page == 0 { return SYMBOL_PUA }
    if page == 0xB200 { return SYMBOL_SIMP_ARABIC }
    if page == 0xB300 { return SYMBOL_TRAD_ARABIC }
    return 0
}

// The code point a symbol font of `mode` has for `u` (0: none).
pub fn symbolRemap(mode: u32, u: u32) -> u32 {
    if mode == SYMBOL_PUA { return if u <= 0xFF { 0xF000 + u } else { 0 } }
    if mode == SYMBOL_SIMP_ARABIC { return pua.simpMap(u) }
    if mode == SYMBOL_TRAD_ARABIC { return pua.tradMap(u) }
    return 0
}

pub fn accel(fc: usize) -> *Cmap {
    var a = face.accel(fc, face.A_CMAP)
    if a == 0 {
        const made = m.alloc(@sizeOf(Cmap))
        const c = cmapOf(made)
        face.view(fc, face.T_CMAP, &c.*.table)
        const t = &c.*.table
        if t.*.length < 4 || m.u16at(t, 0) != 0 { t.*.length = 0 }
        var st = findSubtable(t, 3, 0)
        if st != 0 {
            // The OS/2 font page says how characters map to the symbol
            // subtable's private-use code points.
            c.*.symbol = symbolMode(fontPage(fc))
        }
        if st == 0 { st = findSubtable(t, 3, 10) }
        if st == 0 { st = findSubtable(t, 0, 6) }
        if st == 0 { st = findSubtable(t, 0, 4) }
        if st == 0 { st = findSubtable(t, 3, 1) }
        if st == 0 { st = findSubtable(t, 0, 3) }
        if st == 0 { st = findSubtable(t, 0, 2) }
        if st == 0 { st = findSubtable(t, 0, 1) }
        if st == 0 { st = findSubtable(t, 0, 0) }
        c.*.subtable = st
        if st != 0 {
            c.*.format = m.u16at(t, st)
            if c.*.format == 4 {
                c.*.segCount = m.u16at(t, st + 6) / 2
                var length = @intCast(usize, m.u16at(t, st + 2))
                if st + length > t.*.length { length = t.*.length - st }
                const fixed = 16 + 8 * @intCast(usize, c.*.segCount)
                c.*.glyphIdArrayLength = if length > fixed { @intCast(u32, (length - fixed) / 2) } else { 0 }
            }
        }
        const uvs = findSubtable(t, 0, 5)
        if uvs != 0 && m.u16at(t, uvs) == 14 { c.*.uvs = uvs }
        a = face.keepAccel(fc, face.A_CMAP, made, @intFromPtr(cmapFreeCallback))
    }
    return cmapOf(a)
}

// The glyph of `u` in the subtable at `st` of `format` (0: none).
fn glyphOf(c: *Cmap, st: usize, format: u32, u: u32) -> u32 {
    const t = &c.*.table
    if format == 0 {
        if u >= 256 { return 0 }
        return m.u8at(t, st + 6 + @intCast(usize, u))
    }
    if format == 4 {
        const segCount = c.*.segCount
        const ends = st + 14
        const starts = ends + @intCast(usize, segCount) * 2 + 2
        const deltas = starts + @intCast(usize, segCount) * 2
        const ranges = deltas + @intCast(usize, segCount) * 2
        const glyphs = ranges + @intCast(usize, segCount) * 2
        // HarfBuzz's search (its probes matter for unsorted subtables).
        var low: i64 = 0
        var high: i64 = @intCast(i64, segCount) - 1
        while low <= high {
            const i = @intCast(u32, (low + high) / 2)
            const last = m.u16at(t, ends + @intCast(usize, i) * 2)
            const first = m.u16at(t, starts + @intCast(usize, i) * 2)
            if u > last {
                low = @intCast(i64, i) + 1
            } else if u < first {
                high = @intCast(i64, i) - 1
            } else {
                var gid: u32 = 0
                const rangeOffset = m.u16at(t, ranges + @intCast(usize, i) * 2)
                const delta = m.u16at(t, deltas + @intCast(usize, i) * 2)
                if rangeOffset == 0 {
                    gid = u +% delta
                } else {
                    const index = @intCast(u64, rangeOffset / 2) + @intCast(u64, u - first) + @intCast(u64, i) -% @intCast(u64, segCount)
                    if index >= @intCast(u64, c.*.glyphIdArrayLength) { return 0 }
                    gid = m.u16at(t, glyphs + @intCast(usize, index) * 2)
                    if gid == 0 { return 0 }
                    gid = gid +% delta
                }
                return gid & 0xFFFF
            }
        }
        return 0
    }
    if format == 6 || format == 10 {
        const wide = format == 10
        const startChar = if wide { m.u32at(t, st + 12) } else { m.u16at(t, st + 6) }
        const count = if wide { m.u32at(t, st + 16) } else { m.u16at(t, st + 8) }
        const array = if wide { st + 20 } else { st + 10 }
        if u < startChar || u - startChar >= count { return 0 }
        return m.u16at(t, array + @intCast(usize, u - startChar) * 2)
    }
    if format == 12 || format == 13 {
        const n = m.u32at(t, st + 12)
        var low: i64 = 0
        var high: i64 = @intCast(i64, n) - 1
        while low <= high {
            const i = @intCast(u32, (low + high) / 2)
            const g = st + 16 + @intCast(usize, i) * 12
            const first = m.u32at(t, g)
            const last = m.u32at(t, g + 4)
            if u < first {
                high = @intCast(i64, i) - 1
            } else if u > last {
                low = @intCast(i64, i) + 1
            } else {
                const gid = m.u32at(t, g + 8)
                if format == 13 { return gid }
                return gid +% (u - first)
            }
        }
        return 0
    }
    return 0
}

pub fn getNominalGlyph(fc: usize, u: u32, glyph: *u32) -> bool {
    const c = accel(fc)
    if c.*.subtable == 0 { return false }
    var g = glyphOf(c, c.*.subtable, c.*.format, u)
    if g == 0 && c.*.symbol != 0 {
        const r = symbolRemap(c.*.symbol, u)
        if r != 0 { g = glyphOf(c, c.*.subtable, c.*.format, r) }
    }
    if g == 0 { return false }
    glyph.* = g
    return true
}

// Format 14: 0 not found, 1 found (the glyph in `glyph`), 2 the default.
pub fn glyphVariant(fc: usize, u: u32, vs: u32, glyph: *u32) -> u32 {
    const c = accel(fc)
    const st = c.*.uvs
    if st == 0 { return 0 }
    const t = &c.*.table
    const n = m.u32at(t, st + 6)
    var low: i64 = 0
    var high: i64 = @intCast(i64, n) - 1
    var record: usize = 0
    while low <= high {
        const i = @intCast(u32, (low + high) / 2)
        const r = st + 10 + @intCast(usize, i) * 11
        const sel = m.u24at(t, r)
        if sel == vs {
            record = r
            break
        }
        if sel < vs { low = @intCast(i64, i) + 1 } else { high = @intCast(i64, i) - 1 }
    }
    if record == 0 { return 0 }
    const defaultOffset = @intCast(usize, m.u32at(t, record + 3))
    if defaultOffset != 0 {
        const d = st + defaultOffset
        const count = m.u32at(t, d)
        var lo: i64 = 0
        var hi: i64 = @intCast(i64, count) - 1
        while lo <= hi {
            const i = @intCast(u32, (lo + hi) / 2)
            const r = d + 4 + @intCast(usize, i) * 4
            const first = m.u24at(t, r)
            const last = first + m.u8at(t, r + 3)
            if u < first {
                hi = @intCast(i64, i) - 1
            } else if u > last {
                lo = @intCast(i64, i) + 1
            } else {
                return 2
            }
        }
    }
    const nonDefaultOffset = @intCast(usize, m.u32at(t, record + 7))
    if nonDefaultOffset != 0 {
        const d = st + nonDefaultOffset
        const count = m.u32at(t, d)
        var lo: i64 = 0
        var hi: i64 = @intCast(i64, count) - 1
        while lo <= hi {
            const i = @intCast(u32, (lo + hi) / 2)
            const r = d + 4 + @intCast(usize, i) * 5
            const v = m.u24at(t, r)
            if v == u {
                glyph.* = m.u16at(t, r + 3)
                return 1
            }
            if v < u { lo = @intCast(i64, i) + 1 } else { hi = @intCast(i64, i) - 1 }
        }
    }
    return 0
}

pub fn getVariationGlyph(fc: usize, u: u32, vs: u32, glyph: *u32) -> bool {
    const r = glyphVariant(fc, u, vs, glyph)
    if r == 0 { return false }
    if r == 1 { return true }
    return getNominalGlyph(fc, u, glyph)
}

// The characters the subtable maps (to glyphs below `numGlyphs`, for
// formats 12 and 13), with their glyphs into `mapping` when it is not 0,
// segment by segment as HarfBuzz collects them (so with its quirks for
// broken subtables, and format 4's glyph arrays without their deltas in
// the mapping).
pub fn collect(fc: usize, out: usize, mapping: usize, numGlyphs: u32) -> void {
    const c = accel(fc)
    const st = c.*.subtable
    if st == 0 { return }
    const t = &c.*.table
    const format = c.*.format
    if format == 12 || format == 13 {
        const n = m.u32at(t, st + 12)
        var lastEnd: u32 = 0
        var i: u32 = 0
        while i < n {
            const g = st + 16 + @intCast(usize, i) * 12
            var first = m.u32at(t, g)
            var last = m.u32at(t, g + 4)
            if last > 0x10FFFF { last = 0x10FFFF }
            i += 1
            if mapping != 0 {
                if first > last || first < lastEnd { continue }
                lastEnd = last
            }
            var gid = m.u32at(t, g + 8)
            if gid == 0 {
                if format == 13 || first == last { continue }
                first += 1
                gid = 1
            }
            if gid >= numGlyphs { continue }
            if gid +% (last -% first) >= numGlyphs { last = first +% numGlyphs -% gid }
            if mapping == 0 {
                if first <= last { set.addRange(out, first, if last < 0x10FFFF { last } else { @intCast(u32, 0x10FFFF) }) }
                continue
            }
            if first > last { continue }
            set.addRange(out, first, last)
            var u = first
            while u <= last {
                set.mapSet(mapping, u, gid)
                if format == 12 { gid += 1 }
                u += 1
            }
        }
        return
    }
    if format == 0 {
        var u: u32 = 0
        while u < 256 {
            const g = m.u8at(t, st + 6 + @intCast(usize, u))
            if g != 0 {
                set.add(out, u)
                if mapping != 0 { set.mapSet(mapping, u, g) }
            }
            u += 1
        }
        return
    }
    if format == 6 || format == 10 {
        const wide = format == 10
        const startChar = if wide { m.u32at(t, st + 12) } else { m.u16at(t, st + 6) }
        const count = if wide { m.u32at(t, st + 16) } else { m.u16at(t, st + 8) }
        const array = if wide { st + 20 } else { st + 10 }
        var i: u32 = 0
        while i < count {
            const g = m.u16at(t, array + @intCast(usize, i) * 2)
            if g != 0 {
                set.add(out, startChar +% i)
                if mapping != 0 { set.mapSet(mapping, startChar +% i, g) }
            }
            i += 1
        }
        return
    }
    if format != 4 { return }
    const segCount = c.*.segCount
    const ends = st + 14
    const starts = ends + @intCast(usize, segCount) * 2 + 2
    const deltas = starts + @intCast(usize, segCount) * 2
    const ranges = deltas + @intCast(usize, segCount) * 2
    const glyphs = ranges + @intCast(usize, segCount) * 2
    var count = segCount
    // (Not the last segment when it is the 0xFFFF sentinel.)
    if count != 0 && m.u16at(t, starts + @intCast(usize, count - 1) * 2) == 0xFFFF { count -= 1 }
    var i: u32 = 0
    while i < count {
        const first = m.u16at(t, starts + @intCast(usize, i) * 2)
        const last = m.u16at(t, ends + @intCast(usize, i) * 2)
        const rangeOffset = m.u16at(t, ranges + @intCast(usize, i) * 2)
        const delta = m.u16at(t, deltas + @intCast(usize, i) * 2)
        if mapping == 0 && first <= last { set.addRange(out, first, last) }
        var u = first
        while u <= last {
            var gid: u32 = 0
            if rangeOffset == 0 {
                gid = (u + delta) & 0xFFFF
            } else {
                const index = rangeOffset / 2 +% (u - first) +% i -% segCount
                if index >= c.*.glyphIdArrayLength {
                    if mapping == 0 { set.delRange(out, u, last) }
                    break
                }
                gid = m.u16at(t, glyphs + @intCast(usize, index) * 2)
            }
            if gid == 0 {
                if mapping == 0 { set.del(out, u) }
            } else if mapping != 0 {
                set.add(out, u)
                set.mapSet(mapping, u, gid)
            }
            u += 1
        }
        i += 1
    }
}

pub fn faceCollectUnicodes(fc: usize, out: usize) -> void { collect(fc, out, 0, face.numGlyphs(fc)) }

pub fn faceCollectNominalGlyphMapping(fc: usize, mapping: usize, unicodes_: usize) -> void {
    var unicodes = unicodes_
    var own: usize = 0
    if unicodes == 0 {
        own = set.create()
        unicodes = own
    }
    collect(fc, unicodes, mapping, face.numGlyphs(fc))
    if own != 0 { set.destroy(own) }
}

pub fn faceCollectVariationSelectors(fc: usize, out: usize) -> void {
    const c = accel(fc)
    const st = c.*.uvs
    if st == 0 { return }
    const n = m.u32at(&c.*.table, st + 6)
    var i: u32 = 0
    while i < n {
        set.add(out, m.u24at(&c.*.table, st + 10 + @intCast(usize, i) * 11))
        i += 1
    }
}

pub fn faceCollectVariationUnicodes(fc: usize, vs: u32, out: usize) -> void {
    const c = accel(fc)
    const st = c.*.uvs
    if st == 0 { return }
    const t = &c.*.table
    const n = m.u32at(t, st + 6)
    var i: u32 = 0
    while i < n {
        const r = st + 10 + @intCast(usize, i) * 11
        if m.u24at(t, r) == vs {
            const d = @intCast(usize, m.u32at(t, r + 3))
            if d != 0 {
                const count = m.u32at(t, st + d)
                var k: u32 = 0
                while k < count {
                    const e = st + d + 4 + @intCast(usize, k) * 4
                    const first = m.u24at(t, e)
                    set.addRange(out, first, first + m.u8at(t, e + 3))
                    k += 1
                }
            }
            const nd = @intCast(usize, m.u32at(t, r + 7))
            if nd != 0 {
                const count = m.u32at(t, st + nd)
                var k: u32 = 0
                while k < count {
                    set.add(out, m.u24at(t, st + nd + 4 + @intCast(usize, k) * 5))
                    k += 1
                }
            }
            return
        }
        i += 1
    }
}
