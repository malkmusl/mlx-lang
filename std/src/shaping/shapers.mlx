// The complex shapers (HarfBuzz's hb-ot-shaper.hh): which one a script
// gets, and each one's hooks (features, text preprocessing, normalization,
// masks, mark reordering, glyph postprocessing, the pauses between GSUB
// stages) and properties, dispatched by shaper number.
const m = @import("./memory.mlx")
const common = @import("./common.mlx")
const buffer = @import("./buffer.mlx")
const plan = @import("./plan.mlx")
const arabic = @import("./arabic.mlx")
const hebrew = @import("./hebrew.mlx")
const thai = @import("./thai.mlx")
const hangul = @import("./hangul.mlx")
const indic = @import("./indic.mlx")
const syllabic = @import("./syllabic.mlx")

pub const DEFAULT: u32 = 0
pub const ARABIC: u32 = 1
pub const HANGUL: u32 = 2
pub const HEBREW: u32 = 3
pub const INDIC: u32 = 4
pub const KHMER: u32 = 5
pub const MYANMAR: u32 = 6
pub const MYANMAR_ZAWGYI: u32 = 7
pub const THAI: u32 = 8
pub const USE: u32 = 9

fn tag(a: u8, b: u8, c: u8, d: u8) -> u32 { return common.tag(a, b, c, d) }

// The scripts of the Universal Shaping Engine (when the font has their
// script).
fn isUseScript(s: u32) -> bool {
    const list = "Tibt Mong Sinh Buhd Hano Tglg Tagb Limb Tale Bugi Khar Sylo Tfng Bali Nkoo Phag Cham Kali Lepc Rjng Saur Sund Egyp Java Kthi Mtei Lana Tavt Batk Brah Mand Cakm Plrd Shrd Takr Dupl Gran Khoj Sind Mahj Mani Modi Hmng Phlp Sidd Tirh Ahom Mult Adlm Bhks Marc Newa Gonm Soyo Zanb Dogr Gong Rohg Maka Medf Sogo Sogd Elym Nand Hmnp Wcho Chrs Diak Kits Yezi Cpmn Ougr Tnsa Toto Vith Kawi Nagm "
    var i: usize = 0
    while i + 4 < list.length {
        if tag(list[i], list[i + 1], list[i + 2], list[i + 3]) == s { return true }
        i += 5
    }
    return false
}

// The shaper for a plan of `script` and `direction`, given the script tag
// chosen in GSUB.
pub fn categorize(script: u32, direction: u32, chosenScript0: u32) -> u32 {
    const dflt = tag(68, 70, 76, 84)
    const latn = tag(108, 97, 116, 110)
    if script == tag(65, 114, 97, 98) || script == tag(83, 121, 114, 99) {
        if (chosenScript0 != dflt || script == tag(65, 114, 97, 98)) && common.isHorizontal(direction) { return ARABIC }
        return DEFAULT
    }
    if script == tag(84, 104, 97, 105) || script == tag(76, 97, 111, 111) { return THAI }
    if script == tag(72, 97, 110, 103) { return HANGUL }
    if script == tag(72, 101, 98, 114) { return HEBREW }
    if script == tag(66, 101, 110, 103) || script == tag(68, 101, 118, 97) || script == tag(71, 117, 106, 114) || script == tag(71, 117, 114, 117) || script == tag(75, 110, 100, 97) || script == tag(77, 108, 121, 109) || script == tag(79, 114, 121, 97) || script == tag(84, 97, 109, 108) || script == tag(84, 101, 108, 117) {
        if chosenScript0 == dflt || chosenScript0 == latn { return DEFAULT }
        if (chosenScript0 & 0xFF) == 0x33 { return USE }
        return INDIC
    }
    if script == tag(75, 104, 109, 114) { return KHMER }
    if script == tag(77, 121, 109, 114) {
        if chosenScript0 == dflt || chosenScript0 == latn || chosenScript0 == tag(109, 121, 109, 114) { return DEFAULT }
        return MYANMAR
    }
    if script == tag(81, 97, 97, 103) { return MYANMAR_ZAWGYI }
    if isUseScript(script) {
        if chosenScript0 == dflt || chosenScript0 == latn { return DEFAULT }
        return USE
    }
    return DEFAULT
}

pub fn gposTag(id: u32) -> u32 {
    if id == HEBREW { return tag(104, 101, 98, 114) }
    return 0
}

pub fn normalizationPreference(id: u32) -> u32 {
    if id == HANGUL { return plan.NORMALIZATION_NONE }
    if id == INDIC { return plan.NORMALIZATION_COMPOSED_DIACRITICS_NO_SHORT_CIRCUIT }
    return plan.NORMALIZATION_AUTO
}

pub fn zeroWidthMarks(id: u32) -> u32 {
    if id == HANGUL || id == INDIC { return plan.ZERO_WIDTH_MARKS_NONE }
    return plan.ZERO_WIDTH_MARKS_BY_GDEF_LATE
}

pub fn fallbackPosition(id: u32) -> bool {
    if id == THAI || id == HANGUL || id == INDIC { return false }
    return true
}

// Adds the shaper's features; whether it has any to add (which makes the
// map not simple).
pub fn collectFeatures(id: u32, b: *plan.Builder) -> bool {
    if id == ARABIC {
        arabic.collectFeatures(b)
        return true
    }
    if id == HANGUL {
        hangul.collectFeatures(b)
        return true
    }
    if id == INDIC {
        indic.collectFeatures(b)
        return true
    }
    return false
}

pub fn overrideFeatures(id: u32, b: *plan.Builder) -> void {
    if id == HANGUL { hangul.overrideFeatures(b) }
    if id == INDIC { indic.overrideFeatures(b) }
}

// The shaper's data of a plan (0: the plan fails; shapers without data
// have 1).
pub fn dataCreate(id: u32, pl: *plan.Plan) -> usize {
    if id == ARABIC { return arabic.dataCreate(pl) }
    if id == HANGUL { return hangul.dataCreate(pl) }
    if id == INDIC { return indic.dataCreate(pl) }
    return 1
}

pub fn dataDestroy(id: u32, data: usize) -> void {
    if data == 0 || data == 1 { return }
    if id == ARABIC {
        arabic.dataDestroy(data)
        return
    }
    m.release(data)
}

pub fn hasPreprocessText(id: u32) -> bool { return id == THAI || id == HANGUL || id == INDIC }

pub fn preprocessText(id: u32, pl: *plan.Plan, b: *buffer.Buffer, f: usize) -> void {
    if id == THAI { thai.preprocessText(pl, b, f) }
    if id == HANGUL { hangul.preprocessText(b, f) }
    if id == INDIC { indic.preprocessText(b) }
}

pub fn hasPostprocessGlyphs(id: u32) -> bool { return id == ARABIC }

pub fn postprocessGlyphs(id: u32, pl: *plan.Plan, b: *buffer.Buffer, f: usize) -> void {
    if id == ARABIC { arabic.postprocessGlyphs(pl, b, f) }
}

pub fn hasDecompose(id: u32) -> bool { return id == INDIC }

pub fn decompose(pl: *plan.Plan, f: usize, u: usize, ab: u32, a: *u32, b: *u32) -> bool {
    if pl.*.shaper == INDIC { return indic.decompose(u, ab, a, b) }
    return false
}

pub fn hasCompose(id: u32) -> bool { return id == HEBREW || id == INDIC }

pub fn compose(pl: *plan.Plan, u: usize, a: u32, b: u32, ab: *u32) -> bool {
    if pl.*.shaper == HEBREW { return hebrew.compose(pl, u, a, b, ab) }
    if pl.*.shaper == INDIC { return indic.compose(u, a, b, ab) }
    return false
}

pub fn setupMasks(id: u32, pl: *plan.Plan, b: *buffer.Buffer, f: usize) -> void {
    if id == ARABIC { arabic.setupMasks(pl, b, f) }
    if id == HANGUL { hangul.setupMasks(pl, b) }
    if id == INDIC { indic.setupMasks(b) }
}

pub fn hasReorderMarks(id: u32) -> bool { return id == ARABIC || id == HEBREW }

pub fn reorderMarks(pl: *plan.Plan, b: *buffer.Buffer, start: u32, end: u32) -> void {
    if pl.*.shaper == ARABIC { arabic.reorderMarks(b, start, end) }
    if pl.*.shaper == HEBREW { hebrew.reorderMarks(b, start, end) }
}

// Runs pause `pauseId` between GSUB (or GPOS) stages; whether it may have
// added glyphs.
pub fn pause(pauseId: u32, pl: *plan.Plan, f: usize, b: *buffer.Buffer) -> bool {
    if pauseId == arabic.PAUSE_RECORD_STCH {
        arabic.recordStch(pl, b)
        return false
    }
    if pauseId == arabic.PAUSE_FALLBACK { return arabic.fallbackShape(pl, f, b) }
    if pauseId >= indic.PAUSE_SETUP_SYLLABLES && pauseId <= indic.PAUSE_FINAL_REORDERING { return indic.pause(pauseId, pl, f, b) }
    if pauseId == syllabic.PAUSE_CLEAR_SYLLABLES { return false }
    return false
}
