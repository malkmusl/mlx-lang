// The glyphs a lookup acts on (HarfBuzz's hb_collect_glyphs_context_t and
// the collect_glyphs of each subtable): the glyphs before, the input, the
// glyphs after and the output, with nested lookups of GSUB contexts
// adding to the output only.
const m = @import("./memory.mlx")
const face = @import("./face.mlx")
const layout = @import("./layout.mlx")
const set = @import("./set.mlx")

const MAX_NESTING: u32 = 64

pub const Collect = struct {
    t: m.Table
    tableIndex: u32
    before: usize
    input: usize
    after: usize
    output: usize
    recursed: usize
    nestingLeft: u32
}

// ---------------------------------------------------------------------------
// Coverage and class definitions into sets (whether they were well formed:
// sorted glyphs, ranges in order)

fn addRange(out: usize, a: u32, b: u32) -> bool {
    if a > b { return false }
    set.addRange(out, a, b)
    return true
}

pub fn coverageInto(t: *m.Table, off: usize, out: usize) -> bool {
    if off == 0 { return false }
    const format = m.u16at(t, off)
    const count = @intCast(usize, m.u16at(t, off + 2))
    if format == 1 {
        var last: u32 = 0
        var i: usize = 0
        while i < count {
            const g = m.u16at(t, off + 4 + i * 2)
            if i > 0 && g < last { return false }
            last = g
            set.add(out, g)
            i += 1
        }
        return true
    }
    if format == 2 {
        var i: usize = 0
        while i < count {
            const r = off + 4 + i * 6
            if !addRange(out, m.u16at(t, r), m.u16at(t, r + 2)) { return false }
            i += 1
        }
        return true
    }
    return false
}

// The glyphs of a class definition with a class other than 0.
pub fn classCoverageInto(t: *m.Table, off: usize, out: usize) -> bool {
    if off == 0 { return false }
    const format = m.u16at(t, off)
    if format == 1 {
        const start = m.u16at(t, off + 2)
        const count = m.u16at(t, off + 4)
        var first: u32 = 0
        var i: u32 = 0
        // (HarfBuzz's ranges take one glyph more: the class 0 glyph that
        // ends a run, or the one past the array.)
        while i < count {
            if m.u16at(t, off + 6 + @intCast(usize, i) * 2) == 0 {
                if first != i { set.addRange(out, start + first, start + i) }
                first = i + 1
            }
            i += 1
        }
        if first != count { set.addRange(out, start + first, start + count) }
        return true
    }
    if format == 2 {
        const count = @intCast(usize, m.u16at(t, off + 2))
        var i: usize = 0
        while i < count {
            const r = off + 4 + i * 6
            if m.u16at(t, r + 4) != 0 && !addRange(out, m.u16at(t, r), m.u16at(t, r + 2)) { return false }
            i += 1
        }
        return true
    }
    return false
}

// The glyphs of class `klass`.
pub fn classInto(t: *m.Table, off: usize, klass: u32, out: usize) -> bool {
    if off == 0 { return false }
    const format = m.u16at(t, off)
    if format == 1 {
        const start = m.u16at(t, off + 2)
        const count = m.u16at(t, off + 4)
        var i: u32 = 0
        while i < count {
            if m.u16at(t, off + 6 + @intCast(usize, i) * 2) == klass { set.add(out, start + i) }
            i += 1
        }
        return true
    }
    if format == 2 {
        const count = @intCast(usize, m.u16at(t, off + 2))
        var i: usize = 0
        while i < count {
            const r = off + 4 + i * 6
            if m.u16at(t, r + 4) == klass && !addRange(out, m.u16at(t, r), m.u16at(t, r + 2)) { return false }
            i += 1
        }
        return true
    }
    return false
}

// ---------------------------------------------------------------------------
// The subtables

// How the values of context rules name glyphs: glyph ids, classes of a
// class definition, coverage tables (offsets from the subtable).
const BY_GLYPH: u32 = 0
const BY_CLASS: u32 = 1
const BY_COVERAGE: u32 = 2

fn collectValue(t: *m.Table, out: usize, how: u32, data: usize, value: u32) -> void {
    if how == BY_GLYPH {
        set.add(out, value)
    } else if how == BY_CLASS {
        _ = classInto(t, data, value, out)
    } else {
        _ = coverageInto(t, if value == 0 { 0 } else { data + @intCast(usize, value) }, out)
    }
}

fn collectValues(t: *m.Table, out: usize, at: usize, count: u32, how: u32, data: usize) -> void {
    var i: u32 = 0
    while i < count {
        collectValue(t, out, how, data, m.u16at(t, at + @intCast(usize, i) * 2))
        i += 1
    }
}

fn recurseLookups(c: *Collect, records: usize, count: u32) -> void {
    var i: u32 = 0
    while i < count {
        recurse(c, m.u16at(&c.*.t, records + @intCast(usize, i) * 4 + 2))
        i += 1
    }
}

fn recurse(c: *Collect, index: u32) -> void {
    // (GPOS does not recurse; GSUB only for the output, when asked for.)
    if c.*.nestingLeft == 0 || c.*.tableIndex != 0 { return }
    if c.*.output == set.getEmpty() { return }
    if set.has(c.*.recursed, index) { return }
    const before = c.*.before
    const input = c.*.input
    const after = c.*.after
    c.*.before = set.getEmpty()
    c.*.input = set.getEmpty()
    c.*.after = set.getEmpty()
    c.*.nestingLeft -= 1
    lookupGlyphs(c, index)
    c.*.nestingLeft += 1
    c.*.before = before
    c.*.input = input
    c.*.after = after
    set.add(c.*.recursed, index)
}

// A Rule (context) at `r` with the values named by `how`.
fn rule(c: *Collect, r: usize, how: u32, data: usize) -> void {
    const t = &c.*.t
    const inputCount = m.u16at(t, r)
    const lookupCount = m.u16at(t, r + 2)
    const n = if inputCount != 0 { inputCount - 1 } else { @intCast(u32, 0) }
    collectValues(t, c.*.input, r + 4, n, how, data)
    recurseLookups(c, r + 4 + @intCast(usize, n) * 2, lookupCount)
}

fn chainRule(c: *Collect, r: usize, how: u32, data0: usize, data1: usize, data2: usize) -> void {
    const t = &c.*.t
    const backtrack = m.u16at(t, r)
    var at = r + 2
    collectValues(t, c.*.before, at, backtrack, how, data0)
    at += @intCast(usize, backtrack) * 2
    const inputCount = m.u16at(t, at)
    const n = if inputCount != 0 { inputCount - 1 } else { @intCast(u32, 0) }
    collectValues(t, c.*.input, at + 2, n, how, data1)
    at += 2 + @intCast(usize, n) * 2
    const lookahead = m.u16at(t, at)
    collectValues(t, c.*.after, at + 2, lookahead, how, data2)
    at += 2 + @intCast(usize, lookahead) * 2
    recurseLookups(c, at + 2, m.u16at(t, at))
}

// The rule sets of a context (format 1 or 2) subtable, from `sets`.
fn ruleSets(c: *Collect, st: usize, sets: usize, chain: bool, how: u32, data0: usize, data1: usize, data2: usize) -> void {
    const t = &c.*.t
    const count = m.u16at(t, sets)
    var i: u32 = 0
    while i < count {
        const rs = layout.sub16(t, st, sets - st + 2 + @intCast(usize, i) * 2)
        if rs != 0 {
            const rules = m.u16at(t, rs)
            var k: u32 = 0
            while k < rules {
                const r = layout.sub16(t, rs, 2 + @intCast(usize, k) * 2)
                if r != 0 {
                    if chain { chainRule(c, r, how, data0, data1, data2) } else { rule(c, r, how, data1) }
                }
                k += 1
            }
        }
        i += 1
    }
}

fn context(c: *Collect, st: usize) -> void {
    const t = &c.*.t
    const format = m.u16at(t, st)
    if format == 1 {
        _ = coverageInto(t, layout.sub16(t, st, 2), c.*.input)
        ruleSets(c, st, st + 4, false, BY_GLYPH, 0, 0, 0)
    } else if format == 2 {
        _ = coverageInto(t, layout.sub16(t, st, 2), c.*.input)
        ruleSets(c, st, st + 6, false, BY_CLASS, 0, layout.sub16(t, st, 4), 0)
    } else if format == 3 {
        const glyphCount = m.u16at(t, st + 2)
        _ = coverageInto(t, layout.sub16(t, st, 6), c.*.input)
        const n = if glyphCount != 0 { glyphCount - 1 } else { @intCast(u32, 0) }
        collectValues(t, c.*.input, st + 8, n, BY_COVERAGE, st)
        recurseLookups(c, st + 6 + @intCast(usize, glyphCount) * 2, m.u16at(t, st + 4))
    }
}

fn chainContext(c: *Collect, st: usize) -> void {
    const t = &c.*.t
    const format = m.u16at(t, st)
    if format == 1 {
        _ = coverageInto(t, layout.sub16(t, st, 2), c.*.input)
        ruleSets(c, st, st + 4, true, BY_GLYPH, 0, 0, 0)
    } else if format == 2 {
        _ = coverageInto(t, layout.sub16(t, st, 2), c.*.input)
        ruleSets(c, st, st + 10, true, BY_CLASS, layout.sub16(t, st, 4), layout.sub16(t, st, 6), layout.sub16(t, st, 8))
    } else if format == 3 {
        const backtrack = m.u16at(t, st + 2)
        var at = st + 4 + @intCast(usize, backtrack) * 2
        const inputCount = m.u16at(t, at)
        _ = coverageInto(t, if inputCount != 0 { layout.sub16(t, st, at + 2 - st) } else { 0 }, c.*.input)
        collectValues(t, c.*.before, st + 4, backtrack, BY_COVERAGE, st)
        const n = if inputCount != 0 { inputCount - 1 } else { @intCast(u32, 0) }
        collectValues(t, c.*.input, at + 4, n, BY_COVERAGE, st)
        at += 2 + @intCast(usize, inputCount) * 2
        const lookahead = m.u16at(t, at)
        collectValues(t, c.*.after, at + 2, lookahead, BY_COVERAGE, st)
        at += 2 + @intCast(usize, lookahead) * 2
        recurseLookups(c, at + 2, m.u16at(t, at))
    }
}

fn substSubtable(c: *Collect, kind: u32, st: usize) -> void {
    const t = &c.*.t
    const format = m.u16at(t, st)
    if kind == 1 {
        const cov = layout.sub16(t, st, 2)
        if format == 1 {
            if !coverageInto(t, cov, c.*.input) { return }
            const d = m.u16at(t, st + 4)
            var it: CovIter = undefined
            covInit(&it, t, cov)
            while covMore(&it) {
                set.add(c.*.output, (covGlyph(&it) + d) & 0xFFFF)
                covNext(&it)
            }
        } else if format == 2 {
            if !coverageInto(t, cov, c.*.input) { return }
            const n = zipLength(t, cov, m.u16at(t, st + 4))
            var i: u32 = 0
            while i < n {
                set.add(c.*.output, m.u16at(t, st + 6 + @intCast(usize, i) * 2))
                i += 1
            }
        }
    } else if kind == 2 || kind == 3 {
        if format != 1 { return }
        const cov = layout.sub16(t, st, 2)
        if !coverageInto(t, cov, c.*.input) { return }
        const n = zipLength(t, cov, m.u16at(t, st + 4))
        var i: u32 = 0
        while i < n {
            const s = layout.sub16(t, st, 6 + @intCast(usize, i) * 2)
            if s != 0 {
                const count = m.u16at(t, s)
                var k: u32 = 0
                while k < count {
                    set.add(c.*.output, m.u16at(t, s + 2 + @intCast(usize, k) * 2))
                    k += 1
                }
            }
            i += 1
        }
    } else if kind == 4 {
        if format != 1 { return }
        const cov = layout.sub16(t, st, 2)
        if !coverageInto(t, cov, c.*.input) { return }
        const n = zipLength(t, cov, m.u16at(t, st + 4))
        var i: u32 = 0
        while i < n {
            const ls = layout.sub16(t, st, 6 + @intCast(usize, i) * 2)
            if ls != 0 {
                const count = m.u16at(t, ls)
                var k: u32 = 0
                while k < count {
                    const lig = layout.sub16(t, ls, 2 + @intCast(usize, k) * 2)
                    if lig != 0 {
                        const comps = m.u16at(t, lig + 2)
                        var j: u32 = 1
                        while j < comps {
                            set.add(c.*.input, m.u16at(t, lig + 4 + @intCast(usize, j - 1) * 2))
                            j += 1
                        }
                        set.add(c.*.output, m.u16at(t, lig))
                    } else {
                        set.add(c.*.output, 0)
                    }
                    k += 1
                }
            }
            i += 1
        }
    } else if kind == 5 {
        context(c, st)
    } else if kind == 6 {
        chainContext(c, st)
    } else if kind == 8 {
        if format != 1 { return }
        if !coverageInto(t, layout.sub16(t, st, 2), c.*.input) { return }
        const backtrack = m.u16at(t, st + 4)
        var i: u32 = 0
        while i < backtrack {
            if !coverageInto(t, layout.sub16(t, st, 6 + @intCast(usize, i) * 2), c.*.before) { return }
            i += 1
        }
        var at = st + 6 + @intCast(usize, backtrack) * 2
        const lookahead = m.u16at(t, at)
        i = 0
        while i < lookahead {
            if !coverageInto(t, layout.sub16(t, st, at - st + 2 + @intCast(usize, i) * 2), c.*.after) { return }
            i += 1
        }
        at += 2 + @intCast(usize, lookahead) * 2
        const count = m.u16at(t, at)
        i = 0
        while i < count {
            set.add(c.*.output, m.u16at(t, at + 2 + @intCast(usize, i) * 2))
            i += 1
        }
    }
}

// Iterating over the glyphs of a coverage table as HarfBuzz does (format 2
// stops at a range whose coverage index does not follow on).
pub const CovIter = struct {
    t: usize
    cov: usize
    format: u32
    count: u32
    i: u32
    j: u32
    coverage: u32
}

fn covTable(it: *CovIter) -> *m.Table { unsafe { return @ptrFromInt(*m.Table, it.*.t) } }

pub fn covInit(it: *CovIter, t: *m.Table, cov: usize) -> void {
    it.*.t = @intFromPtr(t)
    it.*.cov = cov
    it.*.format = if cov != 0 { m.u16at(t, cov) } else { @intCast(u32, 0) }
    it.*.count = if cov != 0 && (it.*.format == 1 || it.*.format == 2) { m.u16at(t, cov + 2) } else { @intCast(u32, 0) }
    it.*.i = 0
    it.*.j = 0
    it.*.coverage = 0
    if it.*.format == 2 {
        const first = m.u16at(t, cov + 4)
        it.*.j = if it.*.count != 0 { first } else { @intCast(u32, 0) }
        if first > m.u16at(t, cov + 6) {
            it.*.i = it.*.count
            it.*.j = 0
        }
    }
}

pub fn covMore(it: *CovIter) -> bool { return it.*.i < it.*.count }

pub fn covGlyph(it: *CovIter) -> u32 {
    if it.*.format == 1 { return m.u16at(covTable(it), it.*.cov + 4 + @intCast(usize, it.*.i) * 2) }
    return it.*.j
}

pub fn covNext(it: *CovIter) -> void {
    if it.*.format == 1 {
        it.*.i += 1
        return
    }
    const t = covTable(it)
    const r = it.*.cov + 4 + @intCast(usize, it.*.i) * 6
    if it.*.j >= m.u16at(t, r + 2) {
        it.*.i += 1
        if covMore(it) {
            const old = it.*.coverage
            const n = it.*.cov + 4 + @intCast(usize, it.*.i) * 6
            it.*.j = m.u16at(t, n)
            it.*.coverage = m.u16at(t, n + 4)
            if it.*.coverage != old + 1 {
                it.*.i = it.*.count
                it.*.j = 0
            }
        } else {
            it.*.j = 0
        }
        return
    }
    it.*.coverage += 1
    it.*.j += 1
}

// How many pairs zipping the coverage with an array of `n` gives.
fn zipLength(t: *m.Table, cov: usize, n: u32) -> u32 {
    var it: CovIter = undefined
    covInit(&it, t, cov)
    var k: u32 = 0
    while k < n && covMore(&it) {
        k += 1
        covNext(&it)
    }
    return k
}

fn posSubtable(c: *Collect, kind: u32, st: usize) -> void {
    const t = &c.*.t
    const format = m.u16at(t, st)
    if kind == 1 {
        if format == 1 || format == 2 { _ = coverageInto(t, layout.sub16(t, st, 2), c.*.input) }
    } else if kind == 2 {
        if format == 1 {
            if !coverageInto(t, layout.sub16(t, st, 2), c.*.input) { return }
            const f1 = m.u16at(t, st + 4)
            const f2 = m.u16at(t, st + 6)
            const size = 2 + 2 * @intCast(usize, popcount(f1) + popcount(f2))
            const count = m.u16at(t, st + 8)
            var i: u32 = 0
            while i < count {
                const ps = layout.sub16(t, st, 10 + @intCast(usize, i) * 2)
                if ps != 0 {
                    const n = m.u16at(t, ps)
                    var k: u32 = 0
                    while k < n {
                        set.add(c.*.input, m.u16at(t, ps + 2 + @intCast(usize, k) * size))
                        k += 1
                    }
                } else {
                    // (A null pair set reads as one of no pairs.)
                }
                i += 1
            }
        } else if format == 2 {
            if !coverageInto(t, layout.sub16(t, st, 2), c.*.input) { return }
            _ = classCoverageInto(t, layout.sub16(t, st, 10), c.*.input)
        }
    } else if kind == 3 {
        if format == 1 { _ = coverageInto(t, layout.sub16(t, st, 2), c.*.input) }
    } else if kind == 4 || kind == 5 || kind == 6 {
        if format == 1 {
            if !coverageInto(t, layout.sub16(t, st, 2), c.*.input) { return }
            _ = coverageInto(t, layout.sub16(t, st, 4), c.*.input)
        }
    } else if kind == 7 {
        context(c, st)
    } else if kind == 8 {
        chainContext(c, st)
    }
}

fn popcount(v_: u32) -> u32 {
    var v = v_
    var n: u32 = 0
    while v != 0 {
        n += v & 1
        v >>= 1
    }
    return n
}

fn subtableGlyphs(c: *Collect, kind_: u32, st_: usize) -> void {
    const t = &c.*.t
    var kind = kind_
    var st = st_
    const extension: u32 = if c.*.tableIndex == 0 { 7 } else { 9 }
    if kind == extension {
        if st == 0 || m.u16at(t, st) != 1 { return }
        kind = m.u16at(t, st + 2)
        if kind == extension { return }
        st = layout.sub32(t, st, 4)
    }
    if st == 0 { return }
    if c.*.tableIndex == 0 { substSubtable(c, kind, st) } else { posSubtable(c, kind, st) }
}

fn lookupGlyphs(c: *Collect, index: u32) -> void {
    const t = &c.*.t
    const l = layout.lookup(t, index)
    if l == 0 { return }
    const kind = layout.lookupType(t, l)
    const n = layout.subtableCount(t, l)
    var i: u32 = 0
    while i < n {
        subtableGlyphs(c, kind, layout.subtable(t, l, i))
        i += 1
    }
}

pub fn otLayoutLookupCollectGlyphs(fc: usize, tableTag: u32, index: u32, before: usize, input: usize, after: usize, output: usize) -> void {
    const ti = layout.tableIndexOf(tableTag)
    if ti > 1 { return }
    var c: Collect = undefined
    layout.gsubgpos(fc, ti, &c.t)
    c.tableIndex = ti
    c.before = if before != 0 { before } else { set.getEmpty() }
    c.input = if input != 0 { input } else { set.getEmpty() }
    c.after = if after != 0 { after } else { set.getEmpty() }
    c.output = if output != 0 { output } else { set.getEmpty() }
    c.recursed = set.create()
    c.nestingLeft = MAX_NESTING
    lookupGlyphs(&c, index)
    set.destroy(c.recursed)
}
