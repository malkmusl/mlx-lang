// hb-blob.h: blobs, a range of bytes with the way it is held and the
// function that lets it go (HarfBuzz's hb-blob.cc): duplicated, read-only
// or writable memory, sub-blobs that keep their parent, files mapped.
const m = @import("./memory.mlx")
const o = @import("./object.mlx")

const std = @import("std")
const linux = std.linux

extern("syscall") fn syscall2(number: usize, a1: usize, a2: usize) -> isize {}
extern("syscall") fn syscall3(number: usize, a1: usize, a2: usize, a3: usize) -> isize {}
extern("syscall") fn syscall4(number: usize, a1: usize, a2: usize, a3: usize, a4: usize) -> isize {}
extern("syscall") fn syscall6(number: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, a6: usize) -> isize {}

pub const MODE_DUPLICATE: u32 = 0
pub const MODE_READONLY: u32 = 1
pub const MODE_WRITABLE: u32 = 2
pub const MODE_READONLY_MAY_MAKE_WRITABLE: u32 = 3

pub const Blob = struct {
    refcount: u32
    writable: u32
    userList: usize
    lock: u32
    count: u32
    data: usize
    length: u32
    mode: u32
    userData: usize
    destroy: usize
}

pub fn blob(address: usize) -> *Blob { unsafe { return @ptrFromInt(*Blob, address) } }

var emptyBlob: usize = 0

pub fn getEmpty() -> usize {
    var e = m.atomicLoadWord(@intFromPtr(&emptyBlob))
    if e == 0 {
        const made = o.createInert(@sizeOf(Blob))
        blob(made).*.mode = MODE_READONLY
        if !m.swapWord(@intFromPtr(&emptyBlob), 0, made) { m.release(made) }
        e = m.atomicLoadWord(@intFromPtr(&emptyBlob))
    }
    return e
}

fn tryMakeWritable(b: *Blob) -> bool {
    if b.*.length == 0 { b.*.mode = MODE_WRITABLE }
    if b.*.mode == MODE_WRITABLE { return true }
    const copied = m.alloc(@intCast(usize, b.*.length))
    if copied == 0 { return false }
    m.copy(copied, b.*.data, @intCast(usize, b.*.length))
    o.callDestroy(b.*.destroy, b.*.userData)
    b.*.mode = MODE_WRITABLE
    b.*.data = copied
    b.*.userData = copied
    b.*.destroy = @intFromPtr(m.releaseCallback)
    return true
}

pub fn createOrFail(data: usize, length: u32, mode: u32, userData: usize, destroy: usize) -> usize {
    if length >= 0x80000000 {
        o.callDestroy(destroy, userData)
        return 0
    }
    const address = o.create(@sizeOf(Blob))
    if address == 0 {
        o.callDestroy(destroy, userData)
        return 0
    }
    const b = blob(address)
    b.*.data = data
    b.*.length = length
    b.*.mode = mode
    b.*.userData = userData
    b.*.destroy = destroy
    if mode == MODE_DUPLICATE {
        b.*.mode = MODE_READONLY
        if !tryMakeWritable(b) {
            destroyBlob(address)
            return 0
        }
    }
    return address
}

pub fn create(data: usize, length: u32, mode: u32, userData: usize, destroy: usize) -> usize {
    if length == 0 {
        o.callDestroy(destroy, userData)
        return getEmpty()
    }
    const b = createOrFail(data, length, mode, userData, destroy)
    return if b != 0 { b } else { getEmpty() }
}

pub fn destroyBlob(address: usize) -> void {
    if !o.destroy(address) { return }
    const b = blob(address)
    o.callDestroy(b.*.destroy, b.*.userData)
    m.release(address)
}

pub fn blobDestroyCallback(address: usize) -> void { destroyBlob(address) }

pub fn subBlob(parent: usize, offset: u32, length: u32) -> usize {
    if length == 0 || parent == 0 || offset >= blob(parent).*.length { return getEmpty() }
    o.makeImmutable(parent)
    const p = blob(parent)
    const room = p.*.length - offset
    return create(p.*.data + @intCast(usize, offset), if length < room { length } else { room }, MODE_READONLY, o.reference(parent), @intFromPtr(blobDestroyCallback))
}

pub fn blobCreate(data: usize, length: u32, mode: u32, user_data: usize, destroy: usize) -> usize { return create(data, length, mode, user_data, destroy) }
pub fn blobCreateOrFail(data: usize, length: u32, mode: u32, user_data: usize, destroy: usize) -> usize { return createOrFail(data, length, mode, user_data, destroy) }
pub fn blobCreateSubBlob(parent: usize, offset: u32, length: u32) -> usize { return subBlob(parent, offset, length) }

pub fn blobCopyWritableOrFail(address: usize) -> usize {
    const b = blob(address)
    const copied = create(b.*.data, b.*.length, MODE_DUPLICATE, 0, 0)
    return if copied == getEmpty() { 0 } else { copied }
}

pub fn blobGetEmpty() -> usize { return getEmpty() }
pub fn blobReference(address: usize) -> usize { return o.reference(address) }
pub fn blobDestroy(address: usize) -> void { destroyBlob(address) }
pub fn blobSetUserData(address: usize, key: usize, data: usize, destroy: usize, replace: i32) -> i32 { return if o.setUserData(address, key, data, destroy, replace != 0) { 1 } else { 0 } }
pub fn blobGetUserData(address: usize, key: usize) -> usize { return o.getUserData(address, key) }
pub fn blobMakeImmutable(address: usize) -> void { o.makeImmutable(address) }
pub fn blobIsImmutable(address: usize) -> i32 { return if o.isImmutable(address) { 1 } else { 0 } }
pub fn blobGetLength(address: usize) -> u32 { return blob(address).*.length }

pub fn blobGetData(address: usize, length: usize) -> usize {
    const b = blob(address)
    if length != 0 { m.put32(length, b.*.length) }
    return b.*.data
}

pub fn blobGetDataWritable(address: usize, length: usize) -> usize {
    const b = blob(address)
    if o.isImmutable(address) || !tryMakeWritable(b) {
        if length != 0 { m.put32(length, 0) }
        return 0
    }
    if length != 0 { m.put32(length, b.*.length) }
    return b.*.data
}

// Files: mapped read-only, unmapped when the blob goes.
pub fn unmapFileCallback(file: usize) -> void {
    _ = syscall2(linux.SYS_munmap, m.getWord(file), m.getWord(file + 8))
    m.release(file)
}

pub fn createFromFileOrFail(name: usize) -> usize {
    if name == 0 { return 0 }
    // openat(AT_FDCWD, name, O_RDONLY | O_CLOEXEC)
    const fd = syscall4(linux.SYS_openat, @bitCast(usize, @intCast(isize, -100)), name, 0x80000, 0)
    if fd < 0 { return 0 }
    const size = syscall3(linux.SYS_lseek, @bitCast(usize, fd), 0, 2)
    if size <= 0 || size >= 0x80000000 {
        _ = syscall2(linux.SYS_close, @bitCast(usize, fd), 0)
        return 0
    }
    // mmap(0, size, PROT_READ, MAP_PRIVATE, fd, 0)
    const mapped = syscall6(linux.SYS_mmap, 0, @bitCast(usize, size), 1, 2, @bitCast(usize, fd), 0)
    _ = syscall2(linux.SYS_close, @bitCast(usize, fd), 0)
    if mapped < 0 || mapped == 0 { return 0 }
    const address = @bitCast(usize, mapped)
    const file = m.alloc(16)
    if file == 0 {
        _ = syscall2(linux.SYS_munmap, address, @bitCast(usize, size))
        return 0
    }
    m.putWord(file, address)
    m.putWord(file + 8, @bitCast(usize, size))
    return createOrFail(address, @intCast(u32, size), MODE_READONLY_MAY_MAKE_WRITABLE, file, @intFromPtr(unmapFileCallback))
}

pub fn blobCreateFromFileOrFail(name: usize) -> usize { return createFromFileOrFail(name) }

pub fn blobCreateFromFile(name: usize) -> usize {
    const b = createFromFileOrFail(name)
    return if b != 0 { b } else { getEmpty() }
}
