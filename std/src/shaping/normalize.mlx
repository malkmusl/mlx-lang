// Normalization before shaping (HarfBuzz's hb-ot-shape-normalize.cc): each
// character is decomposed only as far as the font lacks a glyph for it (or
// fully, for the shapers that want that), combining marks are reordered by
// their (modified) combining classes, and marks are composed back with
// their base when the font has the composed glyph. The glyph each
// character maps to is kept in var1 (props.glyphIndex) meanwhile.
const m = @import("./memory.mlx")
const unicode = @import("./unicode.mlx")
const font = @import("./font.mlx")
const buffer = @import("./buffer.mlx")
const p = @import("./props.mlx")
const plan = @import("./plan.mlx")
const shapers = @import("./shapers.mlx")

const MAX_COMBINING_MARKS: u32 = 32

const Context = struct {
    plan: *plan.Plan
    buf: *buffer.Buffer
    font: usize
    unicode: usize
    notFound: u32
}

fn decomposeChar(c: *Context, ab: u32, a: *u32, b: *u32) -> bool {
    if shapers.hasDecompose(c.*.plan.*.shaper) { return shapers.decompose(c.*.plan, c.*.font, c.*.unicode, ab, a, b) }
    return unicode.decompose(c.*.unicode, ab, a, b)
}

fn composeChars(c: *Context, a: u32, b: u32, ab: *u32) -> bool {
    if shapers.hasCompose(c.*.plan.*.shaper) { return shapers.compose(c.*.plan, c.*.unicode, a, b, ab) }
    return unicode.compose(c.*.unicode, a, b, ab)
}

fn setGlyph(g: *buffer.GlyphInfo, f: usize) -> void {
    var glyph: u32 = 0
    _ = font.getNominalGlyph(f, g.*.codepoint, &glyph)
    p.setGlyphIndex(g, glyph)
}

fn outputChar(b: *buffer.Buffer, unichar: u32, glyph: u32) -> void {
    p.setGlyphIndex(buffer.cur(b), glyph)
    _ = buffer.outputGlyph(b, unichar)
    p.setUnicodePropsFor(buffer.prev(b), b)
}

fn nextChar(b: *buffer.Buffer, glyph: u32) -> void {
    p.setGlyphIndex(buffer.cur(b), glyph)
    _ = buffer.nextGlyph(b)
}

fn decompose(c: *Context, shortest: bool, ab: u32) -> u32 {
    var a: u32 = 0
    var bb: u32 = 0
    var aGlyph: u32 = 0
    var bGlyph: u32 = 0
    const b = c.*.buf
    const f = c.*.font
    if !decomposeChar(c, ab, &a, &bb) { return 0 }
    if bb != 0 && !font.getNominalGlyph(f, bb, &bGlyph) { return 0 }
    const hasA = font.getNominalGlyph(f, a, &aGlyph)
    if shortest && hasA {
        outputChar(b, a, aGlyph)
        if bb != 0 {
            outputChar(b, bb, bGlyph)
            return 2
        }
        return 1
    }
    const ret = decompose(c, shortest, a)
    if ret != 0 {
        if bb != 0 {
            outputChar(b, bb, bGlyph)
            return ret + 1
        }
        return ret
    }
    if hasA {
        outputChar(b, a, aGlyph)
        if bb != 0 {
            outputChar(b, bb, bGlyph)
            return 2
        }
        return 1
    }
    return 0
}

fn decomposeCurrentCharacter(c: *Context, shortest: bool) -> void {
    const b = c.*.buf
    const f = c.*.font
    const u = buffer.cur(b).*.codepoint
    var glyph: u32 = 0
    if shortest && font.getNominalGlyphOr(f, u, &glyph, c.*.notFound) {
        nextChar(b, glyph)
        return
    }
    if decompose(c, shortest, u) != 0 {
        buffer.skipGlyph(b)
        return
    }
    if !shortest && font.getNominalGlyphOr(f, u, &glyph, c.*.notFound) {
        nextChar(b, glyph)
        return
    }
    if p.isUnicodeSpace(buffer.cur(b)) {
        var spaceGlyph: u32 = 0
        const spaceType = unicode.spaceFallbackType(u)
        if spaceType != unicode.NOT_SPACE {
            var ok = font.getNominalGlyph(f, 0x20, &spaceGlyph)
            if !ok {
                spaceGlyph = b.*.invisible
                ok = spaceGlyph != 0
            }
            if ok {
                p.setSpaceFallbackType(buffer.cur(b), spaceType)
                nextChar(b, spaceGlyph)
                b.*.scratchFlags |= buffer.SCRATCH_HAS_SPACE_FALLBACK
                return
            }
        }
    }
    if u == 0x2011 {
        var other: u32 = 0
        if font.getNominalGlyph(f, 0x2010, &other) {
            nextChar(b, other)
            return
        }
    }
    nextChar(b, glyph)
}

fn handleVariationSelectorCluster(c: *Context, end: u32) -> void {
    const b = c.*.buf
    const f = c.*.font
    while b.*.idx < end - 1 && b.*.successful != 0 {
        if unicode.isVariationSelector(buffer.curAt(b, 1).*.codepoint) {
            var glyph: u32 = 0
            if font.getVariationGlyph(f, buffer.cur(b).*.codepoint, buffer.curAt(b, 1).*.codepoint, &glyph) {
                p.setGlyphIndex(buffer.cur(b), glyph)
                var u = buffer.cur(b).*.codepoint
                _ = buffer.replaceGlyphs(b, 2, 1, @intFromPtr(&u))
            } else {
                setGlyph(buffer.cur(b), f)
                _ = buffer.nextGlyph(b)
                setGlyph(buffer.cur(b), f)
                _ = buffer.nextGlyph(b)
            }
            while b.*.idx < end && b.*.successful != 0 && unicode.isVariationSelector(buffer.cur(b).*.codepoint) {
                setGlyph(buffer.cur(b), f)
                _ = buffer.nextGlyph(b)
            }
        } else {
            setGlyph(buffer.cur(b), f)
            _ = buffer.nextGlyph(b)
        }
    }
    if b.*.idx < end {
        setGlyph(buffer.cur(b), f)
        _ = buffer.nextGlyph(b)
    }
}

fn decomposeMultiCharCluster(c: *Context, end: u32, shortCircuit: bool) -> void {
    const b = c.*.buf
    var i = b.*.idx
    while i < end && b.*.successful != 0 {
        if unicode.isVariationSelector(buffer.info(b, i).*.codepoint) {
            handleVariationSelectorCluster(c, end)
            return
        }
        i += 1
    }
    while b.*.idx < end && b.*.successful != 0 { decomposeCurrentCharacter(c, shortCircuit) }
}

fn compareCombiningClass(a: *buffer.GlyphInfo, b: *buffer.GlyphInfo) -> i32 {
    const x = p.modifiedCombiningClass(a)
    const y = p.modifiedCombiningClass(b)
    return if x < y { -1 } else if x == y { 0 } else { 1 }
}

fn cc(g: *buffer.GlyphInfo) -> u32 { return p.modifiedCombiningClass(g) }

pub fn normalize(pl: *plan.Plan, b: *buffer.Buffer, f: usize) -> void {
    if b.*.len == 0 { return }
    var mode = shapers.normalizationPreference(pl.*.shaper)
    if mode == plan.NORMALIZATION_AUTO { mode = plan.NORMALIZATION_COMPOSED_DIACRITICS }
    var c: Context = undefined
    c.plan = pl
    c.buf = b
    c.font = f
    c.unicode = b.*.unicode
    c.notFound = b.*.notFound
    const alwaysShortCircuit = mode == plan.NORMALIZATION_NONE
    const mightShortCircuit = alwaysShortCircuit || (mode != plan.NORMALIZATION_DECOMPOSED && mode != plan.NORMALIZATION_COMPOSED_DIACRITICS_NO_SHORT_CIRCUIT)

    // First round: decompose.
    var allSimple = true
    buffer.clearOutput(b)
    var count = b.*.len
    b.*.idx = 0
    while true {
        var end = b.*.idx + 1
        while end < count {
            if p.isUnicodeMark(buffer.info(b, end)) { break }
            end += 1
        }
        if end < count { end -= 1 }
        if mightShortCircuit {
            const cur = b.*.info + @intCast(usize, b.*.idx) * buffer.INFO_SIZE
            const done = font.getNominalGlyphs(f, end - b.*.idx, cur, 20, cur + 12, 20)
            if !buffer.nextGlyphs(b, done) { break }
        }
        while b.*.idx < end && b.*.successful != 0 { decomposeCurrentCharacter(&c, mightShortCircuit) }
        if b.*.idx == count || b.*.successful == 0 { break }
        allSimple = false
        end = b.*.idx + 1
        while end < count {
            if !p.isUnicodeMark(buffer.info(b, end)) { break }
            end += 1
        }
        decomposeMultiCharCluster(&c, end, alwaysShortCircuit)
        if !(b.*.idx < count && b.*.successful != 0) { break }
    }
    _ = buffer.sync(b)

    // Second round: reorder marks.
    if !allSimple {
        count = b.*.len
        var i: u32 = 0
        while i < count {
            if cc(buffer.info(b, i)) == 0 {
                i += 1
                continue
            }
            var end = i + 1
            while end < count {
                if cc(buffer.info(b, end)) == 0 { break }
                end += 1
            }
            if end - i > MAX_COMBINING_MARKS {
                i = end + 1
                continue
            }
            buffer.sort(b, i, end, compareCombiningClass)
            if shapers.hasReorderMarks(pl.*.shaper) { shapers.reorderMarks(pl, b, i, end) }
            i = end + 1
        }
    }
    if (b.*.scratchFlags & buffer.SCRATCH_HAS_CGJ) != 0 {
        count = b.*.len
        var i: u32 = 1
        while i + 1 < count {
            const g = buffer.info(b, i)
            if g.*.codepoint == 0x034F && (cc(buffer.info(b, i + 1)) == 0 || cc(buffer.info(b, i - 1)) <= cc(buffer.info(b, i + 1))) { p.unhide(g) }
            i += 1
        }
    }

    // Third round: recompose.
    if !allSimple && b.*.successful != 0 && (mode == plan.NORMALIZATION_COMPOSED_DIACRITICS || mode == plan.NORMALIZATION_COMPOSED_DIACRITICS_NO_SHORT_CIRCUIT) {
        buffer.clearOutput(b)
        count = b.*.len
        var starter: u32 = 0
        _ = buffer.nextGlyph(b)
        while b.*.idx < count {
            var composed: u32 = 0
            var glyph: u32 = 0
            if p.isUnicodeMark(buffer.cur(b)) {
                if (starter == b.*.outLen - 1 || cc(buffer.prev(b)) < cc(buffer.cur(b))) && composeChars(&c, buffer.outInfo(b, starter).*.codepoint, buffer.cur(b).*.codepoint, &composed) && font.getNominalGlyph(f, composed, &glyph) {
                    if !buffer.nextGlyph(b) { break }
                    buffer.mergeOutClusters(b, starter, b.*.outLen)
                    b.*.outLen -= 1
                    const s = buffer.outInfo(b, starter)
                    s.*.codepoint = composed
                    p.setGlyphIndex(s, glyph)
                    p.setUnicodePropsFor(s, b)
                    continue
                }
            }
            if !buffer.nextGlyph(b) { break }
            if cc(buffer.prev(b)) == 0 { starter = b.*.outLen - 1 }
        }
        _ = buffer.sync(b)
    }
}
