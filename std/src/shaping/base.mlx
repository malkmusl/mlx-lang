// The BASE table (HarfBuzz's hb-ot-layout-base-table.hh and the baseline
// API of hb-ot-layout.cc): baselines and the min and max extents per
// script and language, with fallbacks for missing baselines.
const m = @import("./memory.mlx")
const face = @import("./face.mlx")
const font = @import("./font.mlx")
const layout = @import("./layout.mlx")
const tags = @import("./tags.mlx")
const metrics = @import("./metrics.mlx")
const sanitize = @import("./sanitize.mlx")
const common = @import("./common.mlx")

const S = sanitize.Sanitizer
const TAG_DFLT: u32 = 0x44464C54
const TAG_DEFAULT_LANGUAGE: u32 = 0x646C6E67

const BASELINE_HANGING: u32 = 0x68616E67
const BASELINE_IDEO_FACE_BOTTOM: u32 = 0x69636662
const BASELINE_IDEO_FACE_TOP: u32 = 0x69636674
const BASELINE_IDEO_EMBOX_BOTTOM: u32 = 0x6964656F
const BASELINE_IDEO_EMBOX_CENTRAL: u32 = 0x49646365
const BASELINE_IDEO_FACE_CENTRAL: u32 = 0x49636663
const BASELINE_IDEO_EMBOX_TOP: u32 = 0x69647470
const BASELINE_MATH: u32 = 0x6D617468
const BASELINE_ROMAN: u32 = 0x726F6D6E

pub const Base = struct {
    t: m.Table
    copy: usize
}

fn baseOf(address: usize) -> *Base { unsafe { return @ptrFromInt(*Base, address) } }

pub fn baseFreeCallback(a: usize) -> void {
    const x = baseOf(a)
    if x.*.copy != 0 { m.release(x.*.copy) }
    m.release(a)
}

// ---------------------------------------------------------------------------
// The checks

fn coordChecks(s: *S, at: usize) -> bool {
    if !sanitize.range(s, at, 2) { return false }
    const format = sanitize.u16at(s, at)
    if format == 1 { return sanitize.range(s, at, 4) }
    if format == 2 { return sanitize.range(s, at, 8) }
    if format == 3 { return sanitize.range(s, at, 6) && sanitize.offsetTo(s, at + 4, 2, at, @intFromPtr(sanitize.deviceChecks)) }
    return false
}

fn minMaxChecks(s: *S, at: usize) -> bool {
    if !sanitize.range(s, at, 6) { return false }
    if !sanitize.offsetTo(s, at, 2, at, @intFromPtr(coordChecks)) || !sanitize.offsetTo(s, at + 2, 2, at, @intFromPtr(coordChecks)) { return false }
    if !sanitize.countedArray(s, at + 4, 2, 8) { return false }
    const n = sanitize.u16at(s, at + 4)
    var i: u32 = 0
    while i < n {
        const r = at + 6 + @intCast(usize, i) * 8
        if !sanitize.range(s, r, 8) || !sanitize.offsetTo(s, r + 4, 2, at, @intFromPtr(coordChecks)) || !sanitize.offsetTo(s, r + 6, 2, at, @intFromPtr(coordChecks)) { return false }
        i += 1
    }
    return true
}

fn valuesChecks(s: *S, at: usize) -> bool {
    if !sanitize.range(s, at, 4) || !sanitize.countedArray(s, at + 2, 2, 2) { return false }
    const n = sanitize.u16at(s, at + 2)
    var i: u32 = 0
    while i < n {
        if !sanitize.offsetTo(s, at + 4 + @intCast(usize, i) * 2, 2, at, @intFromPtr(coordChecks)) { return false }
        i += 1
    }
    return true
}

fn scriptChecks(s: *S, at: usize) -> bool {
    if !sanitize.range(s, at, 6) { return false }
    if !sanitize.offsetTo(s, at, 2, at, @intFromPtr(valuesChecks)) || !sanitize.offsetTo(s, at + 2, 2, at, @intFromPtr(minMaxChecks)) { return false }
    if !sanitize.countedArray(s, at + 4, 2, 6) { return false }
    const n = sanitize.u16at(s, at + 4)
    var i: u32 = 0
    while i < n {
        const r = at + 6 + @intCast(usize, i) * 6
        if !sanitize.range(s, r, 6) || !sanitize.offsetTo(s, r + 4, 2, at, @intFromPtr(minMaxChecks)) { return false }
        i += 1
    }
    return true
}

fn scriptListChecks(s: *S, at: usize) -> bool {
    if !sanitize.range(s, at, 2) || !sanitize.countedArray(s, at, 2, 6) { return false }
    const n = sanitize.u16at(s, at)
    var i: u32 = 0
    while i < n {
        const r = at + 2 + @intCast(usize, i) * 6
        if !sanitize.range(s, r, 6) || !sanitize.offsetTo(s, r + 4, 2, at, @intFromPtr(scriptChecks)) { return false }
        i += 1
    }
    return true
}

fn tagListChecks(s: *S, at: usize) -> bool { return sanitize.countedArray(s, at, 2, 4) }

fn axisChecks(s: *S, at: usize) -> bool {
    return sanitize.range(s, at, 4) && sanitize.offsetTo(s, at, 2, at, @intFromPtr(tagListChecks)) && sanitize.offsetTo(s, at + 2, 2, at, @intFromPtr(scriptListChecks))
}

fn baseChecks(s: *S) -> bool {
    if !sanitize.range(s, 0, 8) || sanitize.u16at(s, 0) != 1 { return false }
    if !sanitize.offsetTo(s, 4, 2, 0, @intFromPtr(axisChecks)) || !sanitize.offsetTo(s, 6, 2, 0, @intFromPtr(axisChecks)) { return false }
    if sanitize.u32at(s, 0) < 0x00010001 { return true }
    return sanitize.offsetTo(s, 8, 4, 0, @intFromPtr(sanitize.varStoreChecks))
}

fn accel(fc: usize) -> *Base {
    var a = face.accel(fc, face.A_BASE)
    if a == 0 {
        const made = m.alloc(@sizeOf(Base))
        const x = baseOf(made)
        var t: m.Table = undefined
        face.view(fc, face.T_BASE, &t)
        sanitize.sanitizeTable(&t, face.numGlyphs(fc), @intFromPtr(baseChecks), &x.*.t, &x.*.copy)
        a = face.keepAccel(fc, face.A_BASE, made, @intFromPtr(baseFreeCallback))
    }
    return baseOf(a)
}

// ---------------------------------------------------------------------------
// Reading

// The offset of 16 bits at `field` from `base` (0: a null offset; tables
// at offset 0 are only the BASE table itself).
fn sub(t: *m.Table, base: usize, field: usize) -> usize {
    const off = @intCast(usize, m.u16at(t, field))
    return if off == 0 { 0 } else { base + off }
}

// The record of `tag` in a sorted array of records of `size` bytes with
// the tag first (0: none).
fn findTag(t: *m.Table, array: usize, count: u32, size: usize, tag: u32) -> usize {
    var lo: i64 = 0
    var hi: i64 = @intCast(i64, count) - 1
    while lo <= hi {
        const mid = @intCast(i64, (@intCast(u64, lo) + @intCast(u64, hi)) / 2)
        const r = array + @intCast(usize, mid) * size
        const v = m.u32at(t, r)
        if tag < v {
            hi = mid - 1
        } else if tag > v {
            lo = mid + 1
        } else {
            return r
        }
    }
    return 0
}

fn isVertical(direction: u32) -> bool { return direction == 6 || direction == 7 }

fn axisOf(t: *m.Table, direction: u32) -> usize {
    if t.*.length == 0 { return 0 }
    return sub(t, 0, if isVertical(direction) { 6 } else { 4 })
}

// The BaseScript of a script (or DFLT; 0: none).
fn baseScript(t: *m.Table, axis: usize, script: u32) -> usize {
    if axis == 0 { return 0 }
    const list = sub(t, axis, axis + 2)
    if list == 0 { return 0 }
    const n = m.u16at(t, list)
    var r = findTag(t, list + 2, n, 6, script)
    if r == 0 || m.u32at(t, r) == 0 { r = findTag(t, list + 2, n, 6, TAG_DFLT) }
    if r == 0 || m.u32at(t, r) == 0 { return 0 }
    return sub(t, list, r + 4)
}

fn varStore(t: *m.Table) -> usize {
    if m.u32at(t, 0) < 0x00010001 { return 0 }
    const off = @intCast(usize, m.u32at(t, 8))
    return off
}

// The value of the BaseCoord at `c` (0 for none).
fn coordValue(f: usize, t: *m.Table, c: usize, direction: u32) -> i32 {
    if c == 0 { return 0 }
    const format = m.u16at(t, c)
    if format < 1 || format > 3 { return 0 }
    const horizontal = !isVertical(direction)
    const v = m.i16at(t, c + 2)
    var r = if horizontal { font.emScaleY(f, v) } else { font.emScaleX(f, v) }
    if format == 3 {
        r += layout.deviceDelta(t, sub(t, c, c + 4), f, !horizontal, t, varStore(t))
    }
    return r
}

fn getBaseline(f: usize, baseline: u32, direction: u32, script: u32, coord: usize) -> bool {
    const t = &accel(font.font(f).*.face).*.t
    const axis = axisOf(t, direction)
    const bs = baseScript(t, axis, script)
    if bs == 0 { return false }
    const values = sub(t, bs, bs)
    if values == 0 { return false }
    const tagList = sub(t, axis, axis)
    var index: u32 = 0
    var found = false
    if tagList != 0 {
        var lo: i64 = 0
        var hi: i64 = @intCast(i64, m.u16at(t, tagList)) - 1
        while lo <= hi {
            const mid = @intCast(i64, (@intCast(u64, lo) + @intCast(u64, hi)) / 2)
            const v = m.u32at(t, tagList + 2 + @intCast(usize, mid) * 4)
            if baseline < v {
                hi = mid - 1
            } else if baseline > v {
                lo = mid + 1
            } else {
                index = @intCast(u32, mid)
                found = true
                break
            }
        }
    }
    if !found { return false }
    var c: usize = 0
    if index < m.u16at(t, values + 2) { c = sub(t, values, values + 4 + @intCast(usize, index) * 2) }
    if c == 0 || m.u16at(t, c) == 0 { return false }
    if coord != 0 { m.putI32(coord, coordValue(f, t, c, direction)) }
    return true
}

fn getMinMax(f: usize, direction: u32, script: u32, language: u32, min: *i32, max: *i32) -> bool {
    const t = &accel(font.font(f).*.face).*.t
    const bs = baseScript(t, axisOf(t, direction), script)
    if bs == 0 || m.u16at(t, bs + 2) == 0 { return false }
    var mm: usize = 0
    const r = findTag(t, bs + 6, m.u16at(t, bs + 4), 6, language)
    if r != 0 && m.u32at(t, r) != 0 { mm = sub(t, bs, r + 4) } else { mm = sub(t, bs, bs + 2) }
    var minCoord: usize = 0
    var maxCoord: usize = 0
    if mm != 0 {
        // (The feature is none: its record would have tag 0.)
        minCoord = sub(t, mm, mm)
        maxCoord = sub(t, mm, mm + 2)
    }
    min.* = coordValue(f, t, minCoord, direction)
    max.* = coordValue(f, t, maxCoord, direction)
    return true
}

// ---------------------------------------------------------------------------
// The API

fn chooseTags(script: u32, language: usize, scriptTag: *u32, languageTag: *u32) -> void {
    var scriptTags: [3]u32 = undefined
    var languageTags: [3]u32 = undefined
    var sc: u32 = 3
    var lc: u32 = 3
    tags.tagsFromScriptAndLanguage(script, language, @intFromPtr(&sc), @intFromPtr(&scriptTags), @intFromPtr(&lc), @intFromPtr(&languageTags))
    scriptTag.* = if sc != 0 { scriptTags[@intCast(usize, sc - 1)] } else { TAG_DFLT }
    languageTag.* = if lc != 0 { languageTags[@intCast(usize, lc - 1)] } else { TAG_DEFAULT_LANGUAGE }
}

pub fn otLayoutGetFontExtents(f: usize, direction: u32, script: u32, language: u32, extents: usize) -> i32 {
    var min: i32 = 0
    var max: i32 = 0
    if getMinMax(f, direction, script, language, &min, &max) {
        if extents != 0 {
            m.putI32(extents, max)
            m.putI32(extents + 4, min)
            m.putI32(extents + 8, 0)
        }
        return 1
    }
    font.fontGetExtentsForDirection(f, direction, extents)
    return 0
}

pub fn otLayoutGetFontExtents2(f: usize, direction: u32, script: u32, language: usize, extents: usize) -> i32 {
    var st: u32 = 0
    var lt: u32 = 0
    chooseTags(script, language, &st, &lt)
    return otLayoutGetFontExtents(f, direction, st, lt, extents)
}

fn hangingScript(script: u32) -> u32 {
    return match script {
        0x42656E67 => 0x0995, 0x44657661 => 0x0915, 0x47756A72 => 0x0A95, 0x47757275 => 0x0A15,
        0x54696274 => 0x0F40, 0x4C696D62 => 0x1901, 0x53796C6F => 0xA807, 0x50686167 => 0xA840,
        0x4D746569 => 0xABC0, 0x53687264 => 0x11191, 0x54616B72 => 0x1168C, 0x4D6F6469 => 0x1160E,
        0x53696464 => 0x11590, 0x54697268 => 0x1148F, 0x4D617263 => 0x11C72, 0x4E657761 => 0x1140E,
        0x536F796F => 0x11A5C, 0x5A616E62 => 0x11A0B, 0x446F6772 => 0x1180A, 0x476F6E67 => 0x11D6C,
        0x4E616E64 => 0x119B0,
        else => 0
    }
}

fn isIdeographic(script: u32) -> bool {
    return script == 0x48616E67 || script == 0x48616E69 || script == 0x48697261 || script == 0x4B616E61 ||
        script == 0x426F706F || script == 0x54616E67 || script == 0x4E736875 || script == 0x4B697473
}

pub fn otLayoutGetHorizontalBaselineTagForScript(script: u32) -> u32 {
    if hangingScript(script) != 0 { return BASELINE_HANGING }
    if isIdeographic(script) { return BASELINE_IDEO_FACE_BOTTOM }
    return BASELINE_ROMAN
}

pub fn otLayoutGetBaseline(f: usize, baseline: u32, direction: u32, script: u32, language: u32, coord: usize) -> i32 {
    return if getBaseline(f, baseline, direction, script, coord) { 1 } else { 0 }
}

pub fn otLayoutGetBaseline2(f: usize, baseline: u32, direction: u32, script: u32, language: usize, coord: usize) -> i32 {
    var st: u32 = 0
    var lt: u32 = 0
    chooseTags(script, language, &st, &lt)
    return otLayoutGetBaseline(f, baseline, direction, st, lt, coord)
}

fn fontExtentsFor(f: usize, direction: u32, ascender: bool) -> i32 {
    var e: [12]i32 = undefined
    font.fontGetExtentsForDirection(f, direction, @intFromPtr(&e))
    return if ascender { e[0] } else { e[1] }
}

pub fn otLayoutGetBaselineWithFallback(f: usize, baseline: u32, direction: u32, script: u32, language: u32, coord: usize) -> void {
    if getBaseline(f, baseline, direction, script, coord) { return }
    const fo = font.font(f)
    const horizontal = !isVertical(direction)
    if baseline == BASELINE_ROMAN {
        m.putI32(coord, 0)
    } else if baseline == BASELINE_MATH {
        var glyph: u32 = 0
        var e: [4]i32 = [4]i32{ 0, 0, 0, 0 }
        if horizontal && (font.getNominalGlyph(f, 0x2212, &glyph) || font.getNominalGlyph(f, 0x2D, &glyph)) && font.getGlyphExtents(f, glyph, @intFromPtr(&e)) {
            m.putI32(coord, e[1] + (e[3]) / 2)
        } else {
            var xHeight: i32 = (fo.*.yScale) / 2
            metrics.positionWithFallback(f, 0x78686774, @intFromPtr(&xHeight))
            m.putI32(coord, (xHeight) / 2)
        }
    } else if baseline == BASELINE_IDEO_FACE_TOP || baseline == BASELINE_IDEO_FACE_BOTTOM {
        var top: i32 = 0
        var bottom: i32 = 0
        otLayoutGetBaselineWithFallback(f, BASELINE_IDEO_EMBOX_TOP, direction, script, language, @intFromPtr(&top))
        otLayoutGetBaselineWithFallback(f, BASELINE_IDEO_EMBOX_BOTTOM, direction, script, language, @intFromPtr(&bottom))
        if baseline == BASELINE_IDEO_FACE_TOP {
            m.putI32(coord, top + (bottom - top) / 10)
        } else {
            m.putI32(coord, bottom + (top - bottom) / 10)
        }
    } else if baseline == BASELINE_IDEO_EMBOX_TOP {
        if getBaseline(f, BASELINE_IDEO_EMBOX_BOTTOM, direction, script, coord) {
            m.putI32(coord, m.getI32(coord) + (if horizontal { fo.*.yScale } else { fo.*.xScale }))
        } else {
            m.putI32(coord, fontExtentsFor(f, direction, true))
        }
    } else if baseline == BASELINE_IDEO_EMBOX_BOTTOM {
        if getBaseline(f, BASELINE_IDEO_EMBOX_TOP, direction, script, coord) {
            m.putI32(coord, m.getI32(coord) - (if horizontal { fo.*.yScale } else { fo.*.xScale }))
        } else {
            m.putI32(coord, fontExtentsFor(f, direction, false))
        }
    } else if baseline == BASELINE_HANGING {
        if horizontal {
            const ch = hangingScript(script)
            var glyph: u32 = 0
            var e: [4]i32 = [4]i32{ 0, 0, 0, 0 }
            if ch != 0 && font.getNominalGlyph(f, ch, &glyph) && font.getGlyphExtents(f, glyph, @intFromPtr(&e)) {
                m.putI32(coord, e[1])
            } else {
                m.putI32(coord, (fo.*.yScale * 6) / 10)
            }
        } else {
            m.putI32(coord, (fo.*.xScale * 6) / 10)
        }
    } else if baseline == BASELINE_IDEO_EMBOX_CENTRAL || baseline == BASELINE_IDEO_FACE_CENTRAL {
        var top: i32 = 0
        var bottom: i32 = 0
        const central = baseline == BASELINE_IDEO_EMBOX_CENTRAL
        otLayoutGetBaselineWithFallback(f, if central { BASELINE_IDEO_EMBOX_TOP } else { BASELINE_IDEO_FACE_TOP }, direction, script, language, @intFromPtr(&top))
        otLayoutGetBaselineWithFallback(f, if central { BASELINE_IDEO_EMBOX_BOTTOM } else { BASELINE_IDEO_FACE_BOTTOM }, direction, script, language, @intFromPtr(&bottom))
        m.putI32(coord, (top + bottom) / 2)
    } else {
        m.putI32(coord, 0)
    }
}

pub fn otLayoutGetBaselineWithFallback2(f: usize, baseline: u32, direction: u32, script: u32, language: usize, coord: usize) -> void {
    var st: u32 = 0
    var lt: u32 = 0
    chooseTags(script, language, &st, &lt)
    otLayoutGetBaselineWithFallback(f, baseline, direction, st, lt, coord)
}
