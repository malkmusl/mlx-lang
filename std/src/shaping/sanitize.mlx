// HarfBuzz's checks of a table (hb_sanitize_context_t), for the tables
// whose checks this library repeats to the letter: each range checked is
// in the table and counts against a budget of operations (64 per byte of
// the table, from 16384 to 2^30), nesting is limited, and an offset that
// may be null and leads to something that fails its checks is made null
// in a copy of the table (at most 32 times), as HarfBuzz edits a writable
// copy of the blob on a second pass.
const m = @import("./memory.mlx")

const MAX_EDITS: u32 = 32
const MAX_OPS_FACTOR: u64 = 64
const MAX_OPS_MIN: i64 = 16384
const MAX_OPS_MAX: i64 = 0x3FFFFFFF

pub const Sanitizer = struct {
    t: m.Table
    ops: i32
    edits: u32
    writable: u32
    depth: u32
    numGlyphs: u32
}

pub fn start(s: *Sanitizer) -> void {
    const product = @intCast(u64, s.*.t.length) * MAX_OPS_FACTOR
    var ops: i64 = MAX_OPS_MAX
    if product <= 0xFFFFFFFF {
        ops = @intCast(i64, product)
        if ops < MAX_OPS_MIN { ops = MAX_OPS_MIN }
        if ops > MAX_OPS_MAX { ops = MAX_OPS_MAX }
    }
    s.*.ops = @intCast(i32, ops)
    s.*.edits = 0
    s.*.depth = 0
}

// check_range: `length` bytes at `offset` in the table, counted.
pub fn range(s: *Sanitizer, offset: usize, length: usize) -> bool {
    if offset > s.*.t.length || s.*.t.length - offset < length { return false }
    s.*.ops = s.*.ops -% @bitCast(i32, @intCast(u32, length & 0xFFFFFFFF))
    return s.*.ops > 0
}

// check_array: `count` records of `size` bytes (their product in 32 bits).
pub fn array(s: *Sanitizer, offset: usize, count: u32, size: u32) -> bool {
    const n = @intCast(u64, count) * @intCast(u64, size)
    if n > 0xFFFFFFFF { return false }
    return range(s, offset, @intCast(usize, n))
}

// check_ops.
pub fn ops(s: *Sanitizer, count: u32) -> bool {
    if s.*.ops < 0 || @intCast(i64, count) >= @intCast(i64, s.*.ops) {
        s.*.ops = -1
        return false
    }
    s.*.ops -= @intCast(i32, count)
    return true
}

pub fn startRecursion(s: *Sanitizer, max: u32) -> bool {
    if s.*.depth >= max { return false }
    s.*.depth += 1
    return true
}

pub fn endRecursion(s: *Sanitizer) -> void { s.*.depth -= 1 }

// neuter: makes the offset of `size` bytes at `at` null when the table may
// be edited.
pub fn neuter(s: *Sanitizer, at: usize, size: usize) -> bool {
    if s.*.edits >= MAX_EDITS { return false }
    s.*.edits += 1
    if s.*.writable == 0 { return false }
    m.zero(s.*.t.data + at, size)
    return true
}

pub fn u8at(s: *Sanitizer, at: usize) -> u32 { return m.u8at(&s.*.t, at) }
pub fn u16at(s: *Sanitizer, at: usize) -> u32 { return m.u16at(&s.*.t, at) }
pub fn u24at(s: *Sanitizer, at: usize) -> u32 { return m.u24at(&s.*.t, at) }
pub fn u32at(s: *Sanitizer, at: usize) -> u32 { return m.u32at(&s.*.t, at) }

pub const CheckFunc = fn(*Sanitizer) -> bool

// sanitize_blob: checks the table `t` with `check`; the table to use (`t`
// itself, a copy with offsets made null, to free with m.release when
// `copy` is set, or nothing: length 0).
pub fn sanitizeTable(t: *m.Table, numGlyphs: u32, check: usize, out: *m.Table, copy: *usize) -> void {
    const f: CheckFunc = unsafe { @ptrFromInt(CheckFunc, check) }
    var s: Sanitizer = undefined
    s.t = t.*
    s.writable = 0
    s.numGlyphs = numGlyphs
    copy.* = 0
    out.*.data = t.*.data
    out.*.length = 0
    if t.*.length == 0 || t.*.data == 0 { return }
    var sane = false
    var again = true
    while again {
        again = false
        start(&s)
        sane = f(&s)
        if sane {
            if s.edits != 0 {
                s.edits = 0
                sane = f(&s)
                if s.edits != 0 { sane = false }
            }
        } else if s.edits != 0 && s.writable == 0 {
            const c = m.alloc(t.*.length + 1)
            if c != 0 {
                m.copy(c, t.*.data, t.*.length)
                copy.* = c
                s.t.data = c
                s.writable = 1
                again = true
            }
        }
    }
    if sane {
        out.*.data = s.t.data
        out.*.length = s.t.length
    } else if copy.* != 0 {
        m.release(copy.*)
        copy.* = 0
    }
}

// ---------------------------------------------------------------------------
// Checks shared by tables

pub const CheckAt = fn(*Sanitizer, usize) -> bool

// An offset (of `size` bytes at `field`, from `base`) that may be null
// and what it leads to (checked by `check`); made null when that fails.
pub fn offsetTo(s: *Sanitizer, field: usize, size: usize, base: usize, check: usize) -> bool {
    if !range(s, field, size) { return false }
    const off = @intCast(usize, if size == 2 { u16at(s, field) } else if size == 3 { u24at(s, field) } else { u32at(s, field) })
    if off == 0 { return true }
    const f: CheckAt = unsafe { @ptrFromInt(CheckAt, check) }
    if f(s, base + off) { return true }
    return neuter(s, field, size)
}

// An array of `count` records of `size` bytes after a count of `countSize`
// bytes at `at`.
pub fn countedArray(s: *Sanitizer, at: usize, countSize: usize, size: u32) -> bool {
    if !range(s, at, countSize) { return false }
    const n = if countSize == 2 { u16at(s, at) } else { u32at(s, at) }
    return array(s, at + countSize, n, size)
}

pub fn regionListChecks(s: *Sanitizer, at: usize) -> bool {
    if !range(s, at, 4) { return false }
    const n = @intCast(u64, u16at(s, at)) * @intCast(u64, u16at(s, at + 2) & 0x7FFF)
    return array(s, at + 4, @intCast(u32, n & 0xFFFFFFFF), 6)
}

pub fn varDataChecks(s: *Sanitizer, at: usize) -> bool {
    if !range(s, at, 6) || !countedArray(s, at + 4, 2, 2) { return false }
    const items = u16at(s, at)
    const words = u16at(s, at + 2)
    const regions = u16at(s, at + 4)
    if (words & 0x7FFF) > regions { return false }
    const row = ((words & 0x7FFF) + regions) * (if (words & 0x8000) != 0 { @intCast(u32, 2) } else { @intCast(u32, 1) })
    return array(s, at + 6 + @intCast(usize, regions) * 2, items, row)
}

// An item variation store (ItemVariationStore::sanitize).
pub fn varStoreChecks(s: *Sanitizer, at: usize) -> bool {
    if !range(s, at, 8) || u16at(s, at) != 1 { return false }
    if !offsetTo(s, at + 2, 4, at, @intFromPtr(regionListChecks)) { return false }
    if !countedArray(s, at + 6, 2, 4) { return false }
    const n = u16at(s, at + 6)
    var i: u32 = 0
    while i < n {
        if !offsetTo(s, at + 8 + @intCast(usize, i) * 4, 4, at, @intFromPtr(varDataChecks)) { return false }
        i += 1
    }
    return true
}

// A device table (hinting deltas or a variation index).
pub fn deviceChecks(s: *Sanitizer, at: usize) -> bool {
    if !range(s, at + 4, 2) { return false }
    const format = u16at(s, at + 4)
    if format >= 1 && format <= 3 {
        if !range(s, at, 6) { return false }
        const start = u16at(s, at)
        const end = u16at(s, at + 2)
        var size: usize = 6
        if start <= end { size = 2 * (4 + @intCast(usize, (end - start) >> @intCast(u5, 4 - format))) }
        return range(s, at, size)
    }
    if format == 0x8000 { return range(s, at, 6) }
    return true
}
