pub fn indicMachine(mach: *ragel.Machine) -> void {
    mach.*.start = INDIC_START
    mach.*.transKeys = @intFromPtr(&INDIC_TRANS_KEYS)
    mach.*.keySpans = @intFromPtr(&INDIC_KEY_SPANS)
    mach.*.indexOffsets = @intFromPtr(&INDIC_INDEX_OFFSETS)
    mach.*.indicies = @intFromPtr(&INDIC_INDICIES)
    mach.*.transTargs = @intFromPtr(&INDIC_TRANS_TARGS)
    mach.*.transActions = @intFromPtr(&INDIC_TRANS_ACTIONS)
    mach.*.toStateActions = @intFromPtr(&INDIC_TO_STATE_ACTIONS)
    mach.*.fromStateActions = @intFromPtr(&INDIC_FROM_STATE_ACTIONS)
    mach.*.eofTrans = @intFromPtr(&INDIC_EOF_TRANS)
    mach.*.programOffsets = @intFromPtr(&INDIC_PROGRAM_OFFSETS)
    mach.*.program = @intFromPtr(&INDIC_PROGRAM)
}

