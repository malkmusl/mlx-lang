pub fn useMachine(mach: *ragel.Machine) -> void {
    mach.*.start = USE_START
    mach.*.transKeys = @intFromPtr(&USE_TRANS_KEYS)
    mach.*.keySpans = @intFromPtr(&USE_KEY_SPANS)
    mach.*.indexOffsets = @intFromPtr(&USE_INDEX_OFFSETS)
    mach.*.indicies = @intFromPtr(&USE_INDICIES)
    mach.*.transTargs = @intFromPtr(&USE_TRANS_TARGS)
    mach.*.transActions = @intFromPtr(&USE_TRANS_ACTIONS)
    mach.*.toStateActions = @intFromPtr(&USE_TO_STATE_ACTIONS)
    mach.*.fromStateActions = @intFromPtr(&USE_FROM_STATE_ACTIONS)
    mach.*.eofTrans = @intFromPtr(&USE_EOF_TRANS)
    mach.*.programOffsets = @intFromPtr(&USE_PROGRAM_OFFSETS)
    mach.*.program = @intFromPtr(&USE_PROGRAM)
}
