// hb-set.h and hb-map.h: sets of 32-bit values and maps of 32-bit keys to
// 32-bit values (HarfBuzz's hb-set.cc and hb-map.cc).
//
// A set is its members as sorted ranges (first and last of each, apart
// and not touching), so that the complement of a set (hb_set_invert) is
// a few ranges too; the values go from 0 to 0xFFFFFFFE, as HarfBuzz's.
// Whether a set counts as inverted is kept for hb_set_is_inverted: what
// the inversions and the operations of sets on inverted ones make of it.
const m = @import("./memory.mlx")
const o = @import("./object.mlx")

pub const INVALID: u32 = 0xFFFFFFFF

pub const Set = struct {
    refcount: u32
    writable: u32
    userList: usize
    lock: u32
    count: u32
    ranges: usize
    length: u32
    capacity: u32
    inverted: u32
    successful: u32
}

pub fn set(address: usize) -> *Set { unsafe { return @ptrFromInt(*Set, address) } }

fn first(s: *Set, i: u32) -> u32 { return m.get32(s.*.ranges + @intCast(usize, i) * 8) }
fn last(s: *Set, i: u32) -> u32 { return m.get32(s.*.ranges + @intCast(usize, i) * 8 + 4) }
fn putRange(s: *Set, i: u32, a: u32, b: u32) -> void {
    m.put32(s.*.ranges + @intCast(usize, i) * 8, a)
    m.put32(s.*.ranges + @intCast(usize, i) * 8 + 4, b)
}

fn reserve(s: *Set, n: u32) -> bool {
    if n <= s.*.capacity { return true }
    var c = s.*.capacity + s.*.capacity / 2 + 8
    if c < n { c = n }
    const grown = m.grow(s.*.ranges, @intCast(usize, c) * 8)
    if grown == 0 {
        s.*.successful = 0
        return false
    }
    s.*.ranges = grown
    s.*.capacity = c
    return true
}

var emptySet: usize = 0

pub fn getEmpty() -> usize {
    var e = m.atomicLoadWord(@intFromPtr(&emptySet))
    if e == 0 {
        const made = o.createInert(@sizeOf(Set))
        set(made).*.successful = 0
        if !m.swapWord(@intFromPtr(&emptySet), 0, made) { m.release(made) }
        e = m.atomicLoadWord(@intFromPtr(&emptySet))
    }
    return e
}

pub fn create() -> usize {
    const address = o.create(@sizeOf(Set))
    if address == 0 { return getEmpty() }
    set(address).*.successful = 1
    return address
}

pub fn destroy(address: usize) -> void {
    if !o.destroy(address) { return }
    m.release(set(address).*.ranges)
    m.release(address)
}

fn writable(address: usize) -> bool { return address != 0 && !o.isInert(address) && set(address).*.successful != 0 }

pub fn clear(address: usize) -> void {
    if !writable(address) { return }
    set(address).*.length = 0
    set(address).*.inverted = 0
}

// The index of the first range whose last is at least `v` (length when none).
fn search(s: *Set, v: u32) -> u32 {
    var low: u32 = 0
    var high = s.*.length
    while low < high {
        const mid = (low + high) / 2
        if last(s, mid) < v { low = mid + 1 } else { high = mid }
    }
    return low
}

pub fn has(address: usize, v: u32) -> bool {
    if address == 0 { return false }
    const s = set(address)
    const i = search(s, v)
    return i < s.*.length && first(s, i) <= v
}

pub fn addRange(address: usize, a: u32, b_: u32) -> void {
    if !writable(address) { return }
    var b = b_
    if b >= INVALID { b = INVALID - 1 }
    if a > b { return }
    const s = set(address)
    // The ranges from `i` to `j` (excluded) touch the new one.
    var i = search(s, if a == 0 { 0 } else { a - 1 })
    var j = i
    var lo = a
    var hi = b
    while j < s.*.length && (first(s, j) == 0 || first(s, j) - 1 <= b) {
        if first(s, j) < lo { lo = first(s, j) }
        if last(s, j) > hi { hi = last(s, j) }
        j += 1
    }
    if i == j {
        if !reserve(s, s.*.length + 1) { return }
        m.copy(s.*.ranges + @intCast(usize, i + 1) * 8, s.*.ranges + @intCast(usize, i) * 8, @intCast(usize, s.*.length - i) * 8)
        s.*.length += 1
        putRange(s, i, lo, hi)
        return
    }
    putRange(s, i, lo, hi)
    m.copy(s.*.ranges + @intCast(usize, i + 1) * 8, s.*.ranges + @intCast(usize, j) * 8, @intCast(usize, s.*.length - j) * 8)
    s.*.length -= j - i - 1
}

pub fn add(address: usize, v: u32) -> void { addRange(address, v, v) }

pub fn delRange(address: usize, a: u32, b_: u32) -> void {
    if !writable(address) { return }
    var b = b_
    if b >= INVALID { b = INVALID - 1 }
    if a > b { return }
    const s = set(address)
    var i = search(s, a)
    while i < s.*.length && first(s, i) <= b {
        const f = first(s, i)
        const l = last(s, i)
        if f < a && l > b {
            // (Cut in two.)
            if !reserve(s, s.*.length + 1) { return }
            m.copy(s.*.ranges + @intCast(usize, i + 1) * 8, s.*.ranges + @intCast(usize, i) * 8, @intCast(usize, s.*.length - i) * 8)
            s.*.length += 1
            putRange(s, i, f, a - 1)
            putRange(s, i + 1, b + 1, l)
            return
        }
        if f < a {
            putRange(s, i, f, a - 1)
            i += 1
        } else if l > b {
            putRange(s, i, b + 1, l)
            return
        } else {
            m.copy(s.*.ranges + @intCast(usize, i) * 8, s.*.ranges + @intCast(usize, i + 1) * 8, @intCast(usize, s.*.length - i - 1) * 8)
            s.*.length -= 1
        }
    }
}

pub fn del(address: usize, v: u32) -> void { delRange(address, v, v) }

pub fn population(address: usize) -> u32 {
    const s = set(address)
    var n: u64 = 0
    var i: u32 = 0
    while i < s.*.length {
        n += @intCast(u64, last(s, i) - first(s, i)) + 1
        i += 1
    }
    return if n >= 0xFFFFFFFF { 0xFFFFFFFF } else { @intCast(u32, n) }
}

pub fn isEmpty(address: usize) -> bool { return set(address).*.length == 0 }

// Copies `other` into `address`.
pub fn assign(address: usize, other: usize) -> void {
    if !writable(address) { return }
    const s = set(address)
    const t = set(other)
    if !reserve(s, t.*.length) { return }
    m.copy(s.*.ranges, t.*.ranges, @intCast(usize, t.*.length) * 8)
    s.*.length = t.*.length
    s.*.inverted = t.*.inverted
}

pub fn invert(address: usize) -> void {
    if !writable(address) { return }
    const s = set(address)
    const n = s.*.length
    const scratch = m.alloc(@intCast(usize, n + 1) * 8)
    if scratch == 0 {
        s.*.successful = 0
        return
    }
    var count: u32 = 0
    var next: u32 = 0
    var open = true
    var i: u32 = 0
    while i < n {
        if first(s, i) > next {
            m.put32(scratch + @intCast(usize, count) * 8, next)
            m.put32(scratch + @intCast(usize, count) * 8 + 4, first(s, i) - 1)
            count += 1
        }
        if last(s, i) >= INVALID - 1 {
            open = false
        } else {
            next = last(s, i) + 1
        }
        i += 1
    }
    if open {
        m.put32(scratch + @intCast(usize, count) * 8, next)
        m.put32(scratch + @intCast(usize, count) * 8 + 4, INVALID - 1)
        count += 1
    }
    if !reserve(s, count) {
        m.release(scratch)
        return
    }
    m.copy(s.*.ranges, scratch, @intCast(usize, count) * 8)
    s.*.length = count
    s.*.inverted ^= 1
    m.release(scratch)
}

pub fn unionWith(address: usize, other: usize) -> void {
    if !writable(address) { return }
    const t = set(other)
    var i: u32 = 0
    while i < t.*.length {
        addRange(address, first(t, i), last(t, i))
        i += 1
    }
    set(address).*.inverted |= t.*.inverted
}

pub fn subtract(address: usize, other: usize) -> void {
    if !writable(address) { return }
    const t = set(other)
    var i: u32 = 0
    while i < t.*.length {
        delRange(address, first(t, i), last(t, i))
        i += 1
    }
    set(address).*.inverted = set(address).*.inverted & (t.*.inverted ^ 1)
}

pub fn intersect(address: usize, other: usize) -> void {
    if !writable(address) { return }
    // (A and B is A less the complement of B.)
    const c = create()
    assign(c, other)
    const inv = set(other).*.inverted
    invert(c)
    const keep = set(address).*.inverted
    subtract(address, c)
    set(address).*.inverted = keep & inv
    destroy(c)
}

pub fn symmetricDifference(address: usize, other: usize) -> void {
    if !writable(address) { return }
    const a = create()
    assign(a, address)
    subtract(a, other)
    const b = create()
    assign(b, other)
    subtract(b, address)
    const inv = set(address).*.inverted ^ set(other).*.inverted
    assign(address, a)
    unionWith(address, b)
    set(address).*.inverted = inv
    destroy(a)
    destroy(b)
}

pub fn isEqual(a: usize, b: usize) -> bool {
    const s = set(a)
    const t = set(b)
    if s.*.length != t.*.length { return false }
    var i: u32 = 0
    while i < s.*.length {
        if first(s, i) != first(t, i) || last(s, i) != last(t, i) { return false }
        i += 1
    }
    return true
}

pub fn isSubset(a: usize, larger: usize) -> bool {
    const s = set(a)
    const t = set(larger)
    var i: u32 = 0
    while i < s.*.length {
        const j = search(t, first(s, i))
        if j >= t.*.length || first(t, j) > first(s, i) || last(t, j) < last(s, i) { return false }
        i += 1
    }
    return true
}

pub fn getMin(address: usize) -> u32 {
    const s = set(address)
    return if s.*.length == 0 { INVALID } else { first(s, 0) }
}

pub fn getMax(address: usize) -> u32 {
    const s = set(address)
    return if s.*.length == 0 { INVALID } else { last(s, s.*.length - 1) }
}

// The least member above `v` (all when `v` is INVALID); INVALID if none.
pub fn next(address: usize, v: u32) -> u32 {
    const s = set(address)
    if v == INVALID { return getMin(address) }
    if v >= INVALID - 1 { return INVALID }
    const i = search(s, v + 1)
    if i >= s.*.length { return INVALID }
    return if first(s, i) > v + 1 { first(s, i) } else { v + 1 }
}

pub fn previous(address: usize, v: u32) -> u32 {
    const s = set(address)
    if v == INVALID { return getMax(address) }
    if v == 0 { return INVALID }
    const i = search(s, v - 1)
    if i < s.*.length && first(s, i) <= v - 1 { return v - 1 }
    if i == 0 { return INVALID }
    return last(s, i - 1)
}

pub fn hash(address: usize) -> u32 {
    const s = set(address)
    var h: u32 = 0
    var i: u32 = 0
    while i < s.*.length {
        h = (h *% 31) +% first(s, i)
        h = (h *% 31) +% last(s, i)
        i += 1
    }
    return h
}

// The members as ranges, for the library's loops: their count, and the
// first and last of range `i`.
pub fn rangeCount(address: usize) -> u32 { return set(address).*.length }
pub fn rangeFirst(address: usize, i: u32) -> u32 { return first(set(address), i) }
pub fn rangeLast(address: usize, i: u32) -> u32 { return last(set(address), i) }

pub fn setCreate() -> usize { return create() }
pub fn setGetEmpty() -> usize { return getEmpty() }
pub fn setReference(s: usize) -> usize { return o.reference(s) }
pub fn setDestroy(s: usize) -> void { destroy(s) }
pub fn setSetUserData(s: usize, key: usize, data: usize, d: usize, replace: i32) -> i32 { return if o.setUserData(s, key, data, d, replace != 0) { 1 } else { 0 } }
pub fn setGetUserData(s: usize, key: usize) -> usize { return o.getUserData(s, key) }
pub fn setAllocationSuccessful(s: usize) -> i32 { return @intCast(i32, set(s).*.successful) }

pub fn setCopy(s: usize) -> usize {
    const c = create()
    assign(c, s)
    return c
}

pub fn setClear(s: usize) -> void { clear(s) }
pub fn setIsEmpty(s: usize) -> i32 { return if isEmpty(s) { 1 } else { 0 } }
pub fn setInvert(s: usize) -> void { invert(s) }
pub fn setIsInverted(s: usize) -> i32 { return @intCast(i32, set(s).*.inverted) }
pub fn setHas(s: usize, v: u32) -> i32 { return if has(s, v) { 1 } else { 0 } }
pub fn setAdd(s: usize, v: u32) -> void { add(s, v) }
pub fn setAddRange(s: usize, a: u32, b: u32) -> void { addRange(s, a, b) }

pub fn setAddSortedArray(s: usize, values: usize, count: u32) -> void {
    var i: usize = 0
    while i < @intCast(usize, count) {
        add(s, m.get32(values + i * 4))
        i += 1
    }
}

pub fn setDel(s: usize, v: u32) -> void { del(s, v) }
pub fn setDelRange(s: usize, a: u32, b: u32) -> void { delRange(s, a, b) }
pub fn setIsEqual(a: usize, b: usize) -> i32 { return if isEqual(a, b) { 1 } else { 0 } }
pub fn setHash(s: usize) -> u32 { return hash(s) }
pub fn setIsSubset(a: usize, b: usize) -> i32 { return if isSubset(a, b) { 1 } else { 0 } }
pub fn setSet(a: usize, b: usize) -> void { assign(a, b) }
pub fn setUnion(a: usize, b: usize) -> void { unionWith(a, b) }
pub fn setIntersect(a: usize, b: usize) -> void { intersect(a, b) }
pub fn setSubtract(a: usize, b: usize) -> void { subtract(a, b) }
pub fn setSymmetricDifference(a: usize, b: usize) -> void { symmetricDifference(a, b) }
pub fn setGetPopulation(s: usize) -> u32 { return population(s) }
pub fn setGetMin(s: usize) -> u32 { return getMin(s) }
pub fn setGetMax(s: usize) -> u32 { return getMax(s) }

pub fn setNext(s: usize, codepoint: usize) -> i32 {
    const v = next(s, m.get32(codepoint))
    m.put32(codepoint, v)
    return if v != INVALID { 1 } else { 0 }
}

pub fn setPrevious(s: usize, codepoint: usize) -> i32 {
    const v = previous(s, m.get32(codepoint))
    m.put32(codepoint, v)
    return if v != INVALID { 1 } else { 0 }
}

pub fn setNextRange(s: usize, firstOut: usize, lastOut: usize) -> i32 {
    var i = next(s, m.get32(lastOut))
    if i == INVALID {
        m.put32(firstOut, INVALID)
        m.put32(lastOut, INVALID)
        return 0
    }
    m.put32(firstOut, i)
    var l = i
    while true {
        i = next(s, i)
        if i == INVALID || i != l + 1 { break }
        l = i
    }
    m.put32(lastOut, l)
    return 1
}

pub fn setPreviousRange(s: usize, firstOut: usize, lastOut: usize) -> i32 {
    var i = previous(s, m.get32(firstOut))
    if i == INVALID {
        m.put32(firstOut, INVALID)
        m.put32(lastOut, INVALID)
        return 0
    }
    m.put32(lastOut, i)
    var f = i
    while true {
        i = previous(s, i)
        if i == INVALID || f == 0 || i != f - 1 { break }
        f = i
    }
    m.put32(firstOut, f)
    return 1
}

pub fn setNextMany(s: usize, codepoint: u32, out: usize, size: u32) -> u32 {
    var n: u32 = 0
    var v = codepoint
    while n < size {
        v = next(s, v)
        if v == INVALID { break }
        m.put32(out + @intCast(usize, n) * 4, v)
        n += 1
    }
    return n
}

// ---------------------------------------------------------------------------
// Maps: open addressing on the key's hash; entries of key, value (an
// entry's key INVALID: free; INVALID - 1 with value 1... deleted ones are
// marked in a byte array).

pub const Map = struct {
    refcount: u32
    writable: u32
    userList: usize
    lock: u32
    count: u32
    keys: usize
    values: usize
    states: usize
    capacity: u32
    population: u32
    occupied: u32
    successful: u32
}

pub fn map(address: usize) -> *Map { unsafe { return @ptrFromInt(*Map, address) } }

var emptyMap: usize = 0

pub fn mapGetEmpty() -> usize {
    var e = m.atomicLoadWord(@intFromPtr(&emptyMap))
    if e == 0 {
        const made = o.createInert(@sizeOf(Map))
        if !m.swapWord(@intFromPtr(&emptyMap), 0, made) { m.release(made) }
        e = m.atomicLoadWord(@intFromPtr(&emptyMap))
    }
    return e
}

pub fn mapCreate() -> usize {
    const address = o.create(@sizeOf(Map))
    if address == 0 { return mapGetEmpty() }
    map(address).*.successful = 1
    return address
}

pub fn mapDestroy(address: usize) -> void {
    if !o.destroy(address) { return }
    const p = map(address)
    m.release(p.*.keys)
    m.release(p.*.values)
    m.release(p.*.states)
    m.release(address)
}

fn hashOf(k: u32) -> u32 { return (k *% 2654435761) ^ (k >> 15) }

// The slot of `k` (state 1), or the free one to put it in.
fn slotOf(p: *Map, k: u32) -> u32 {
    const mask = p.*.capacity - 1
    var i = hashOf(k) & mask
    var tombstone: u32 = INVALID
    while true {
        const state = m.get8(p.*.states + @intCast(usize, i))
        if state == 0 { return if tombstone != INVALID { tombstone } else { i } }
        if state == 1 && m.get32(p.*.keys + @intCast(usize, i) * 4) == k { return i }
        if state == 2 && tombstone == INVALID { tombstone = i }
        i = (i + 1) & mask
    }
    return 0
}

fn mapResize(p: *Map) -> bool {
    var c: u32 = 8
    while c < (p.*.population + 1) * 2 + 2 { c = c * 2 }
    const keys = m.alloc(@intCast(usize, c) * 4)
    const values = m.alloc(@intCast(usize, c) * 4)
    const states = m.alloc(@intCast(usize, c))
    if keys == 0 || values == 0 || states == 0 {
        m.release(keys)
        m.release(values)
        m.release(states)
        p.*.successful = 0
        return false
    }
    const oldKeys = p.*.keys
    const oldValues = p.*.values
    const oldStates = p.*.states
    const oldCapacity = p.*.capacity
    p.*.keys = keys
    p.*.values = values
    p.*.states = states
    p.*.capacity = c
    p.*.occupied = p.*.population
    var i: u32 = 0
    while i < oldCapacity {
        if m.get8(oldStates + @intCast(usize, i)) == 1 {
            const k = m.get32(oldKeys + @intCast(usize, i) * 4)
            const s = slotOf(p, k)
            m.put8(states + @intCast(usize, s), 1)
            m.put32(keys + @intCast(usize, s) * 4, k)
            m.put32(values + @intCast(usize, s) * 4, m.get32(oldValues + @intCast(usize, i) * 4))
        }
        i += 1
    }
    m.release(oldKeys)
    m.release(oldValues)
    m.release(oldStates)
    return true
}

pub fn mapSet(address: usize, k: u32, v: u32) -> void {
    if address == 0 || o.isInert(address) { return }
    const p = map(address)
    if p.*.successful == 0 { return }
    if (p.*.occupied + 1) * 2 >= p.*.capacity {
        if !mapResize(p) { return }
    }
    const s = slotOf(p, k)
    const state = m.get8(p.*.states + @intCast(usize, s))
    if state != 1 {
        if state == 0 { p.*.occupied += 1 }
        p.*.population += 1
        m.put8(p.*.states + @intCast(usize, s), 1)
        m.put32(p.*.keys + @intCast(usize, s) * 4, k)
    }
    m.put32(p.*.values + @intCast(usize, s) * 4, v)
}

// Whether the map has `k`; its value in `value`.
pub fn mapHas(address: usize, k: u32, value: *u32) -> bool {
    const p = map(address)
    if p.*.capacity == 0 { return false }
    const s = slotOf(p, k)
    if m.get8(p.*.states + @intCast(usize, s)) != 1 { return false }
    value.* = m.get32(p.*.values + @intCast(usize, s) * 4)
    return true
}

pub fn mapGet(address: usize, k: u32) -> u32 {
    var v: u32 = INVALID
    if !mapHas(address, k, &v) { return INVALID }
    return v
}

pub fn mapDel(address: usize, k: u32) -> void {
    if address == 0 || o.isInert(address) { return }
    const p = map(address)
    if p.*.capacity == 0 { return }
    const s = slotOf(p, k)
    if m.get8(p.*.states + @intCast(usize, s)) != 1 { return }
    m.put8(p.*.states + @intCast(usize, s), 2)
    p.*.population -= 1
}

pub fn mapClear(address: usize) -> void {
    if address == 0 || o.isInert(address) { return }
    const p = map(address)
    if p.*.capacity != 0 { m.zero(p.*.states, @intCast(usize, p.*.capacity)) }
    p.*.population = 0
    p.*.occupied = 0
}

// The next entry from slot `index` on (-1: from the first): its slot.
pub fn mapNext(address: usize, index: i32, key: *u32, value: *u32) -> i32 {
    const p = map(address)
    var i = index + 1
    while i < @intCast(i32, p.*.capacity) {
        if m.get8(p.*.states + @intCast(usize, i)) == 1 {
            key.* = m.get32(p.*.keys + @intCast(usize, i) * 4)
            value.* = m.get32(p.*.values + @intCast(usize, i) * 4)
            return i
        }
        i += 1
    }
    return -1
}

pub fn mapReference(p: usize) -> usize { return o.reference(p) }
pub fn mapSetUserData(p: usize, key: usize, data: usize, d: usize, replace: i32) -> i32 { return if o.setUserData(p, key, data, d, replace != 0) { 1 } else { 0 } }
pub fn mapGetUserData(p: usize, key: usize) -> usize { return o.getUserData(p, key) }
pub fn mapAllocationSuccessful(p: usize) -> i32 { return @intCast(i32, map(p).*.successful) }

pub fn mapCopy(p: usize) -> usize {
    const c = mapCreate()
    mapUpdate(c, p)
    return c
}

pub fn mapIsEmpty(p: usize) -> i32 { return if map(p).*.population == 0 { 1 } else { 0 } }
pub fn mapGetPopulation(p: usize) -> u32 { return map(p).*.population }

pub fn mapIsEqual(a: usize, b: usize) -> i32 {
    if map(a).*.population != map(b).*.population { return 0 }
    var i: i32 = -1
    var k: u32 = 0
    var v: u32 = 0
    while true {
        i = mapNext(a, i, &k, &v)
        if i < 0 { break }
        var w: u32 = 0
        if !mapHas(b, k, &w) || w != v { return 0 }
    }
    return 1
}

pub fn mapHash(p: usize) -> u32 {
    var h: u32 = 0
    var i: i32 = -1
    var k: u32 = 0
    var v: u32 = 0
    while true {
        i = mapNext(p, i, &k, &v)
        if i < 0 { break }
        h ^= hashOf(k) *% 31 +% v
    }
    return h
}


pub fn mapContains(p: usize, k: u32) -> i32 {
    var v: u32 = 0
    return if mapHas(p, k, &v) { 1 } else { 0 }
}

pub fn mapUpdate(p: usize, other: usize) -> void {
    var i: i32 = -1
    var k: u32 = 0
    var v: u32 = 0
    while true {
        i = mapNext(other, i, &k, &v)
        if i < 0 { break }
        mapSet(p, k, v)
    }
}


pub fn mapIterate(p: usize, idx: usize, key: usize, value: usize) -> i32 {
    var k: u32 = 0
    var v: u32 = 0
    const i = mapNext(p, m.getI32(idx), &k, &v)
    if i < 0 {
        m.putI32(idx, -1)
        return 0
    }
    m.putI32(idx, i)
    m.put32(key, k)
    m.put32(value, v)
    return 1
}

pub fn mapKeys(p: usize, out: usize) -> void {
    var i: i32 = -1
    var k: u32 = 0
    var v: u32 = 0
    while true {
        i = mapNext(p, i, &k, &v)
        if i < 0 { break }
        add(out, k)
    }
}

pub fn mapValues(p: usize, out: usize) -> void {
    var i: i32 = -1
    var k: u32 = 0
    var v: u32 = 0
    while true {
        i = mapNext(p, i, &k, &v)
        if i < 0 { break }
        add(out, v)
    }
}
