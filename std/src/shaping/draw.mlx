// hb-draw.h: draw functions objects, the callbacks a program gives for
// the outlines of glyphs, and the drawing state that opens and closes
// paths around them (HarfBuzz's hb-draw.cc and hb-draw.hh). The library's
// outline readers (glyf, CFF) draw through a session: the functions, their
// data, the state and the font's synthetic slant.
const m = @import("./memory.mlx")
const o = @import("./object.mlx")

pub const MOVE_TO: usize = 0
pub const LINE_TO: usize = 1
pub const QUADRATIC_TO: usize = 2
pub const CUBIC_TO: usize = 3
pub const CLOSE_PATH: usize = 4

pub const FUNCS_SIZE: usize = 24 + 3 * 5 * 8

// hb_draw_state_t: path_open, path_start_x, path_start_y, current_x,
// current_y, then seven reserved values.
pub const STATE_SIZE: usize = 48

fn funcAt(d: usize, i: usize) -> usize { return m.getWord(d + 24 + i * 8) }
fn dataAt(d: usize, i: usize) -> usize { return m.getWord(d + 64 + i * 8) }

var emptyFuncs: usize = 0

pub fn getEmpty() -> usize {
    var e = m.atomicLoadWord(@intFromPtr(&emptyFuncs))
    if e == 0 {
        const made = o.createInert(FUNCS_SIZE)
        if !m.swapWord(@intFromPtr(&emptyFuncs), 0, made) { m.release(made) }
        e = m.atomicLoadWord(@intFromPtr(&emptyFuncs))
    }
    return e
}

pub fn create() -> usize {
    const d = o.create(FUNCS_SIZE)
    return if d != 0 { d } else { getEmpty() }
}

pub fn destroy(d: usize) -> void {
    if !o.destroy(d) { return }
    var i: usize = 0
    while i < 5 {
        o.callDestroy(m.getWord(d + 104 + i * 8), dataAt(d, i))
        i += 1
    }
    m.release(d)
}

pub fn setFunc(d: usize, i: usize, func: usize, userData: usize, destroyFunc: usize) -> void {
    if o.isImmutable(d) {
        o.callDestroy(destroyFunc, userData)
        return
    }
    o.callDestroy(m.getWord(d + 104 + i * 8), dataAt(d, i))
    m.putWord(d + 24 + i * 8, func)
    m.putWord(d + 64 + i * 8, if func != 0 { userData } else { 0 })
    m.putWord(d + 104 + i * 8, if func != 0 { destroyFunc } else { 0 })
    if func == 0 { o.callDestroy(destroyFunc, userData) }
}

pub fn drawFuncsCreate() -> usize { return create() }
pub fn drawFuncsGetEmpty() -> usize { return getEmpty() }
pub fn drawFuncsReference(d: usize) -> usize { return o.reference(d) }
pub fn drawFuncsDestroy(d: usize) -> void { destroy(d) }
pub fn drawFuncsSetUserData(d: usize, key: usize, data: usize, f: usize, replace: i32) -> i32 { return if o.setUserData(d, key, data, f, replace != 0) { 1 } else { 0 } }
pub fn drawFuncsGetUserData(d: usize, key: usize) -> usize { return o.getUserData(d, key) }
pub fn drawFuncsMakeImmutable(d: usize) -> void { o.makeImmutable(d) }
pub fn drawFuncsIsImmutable(d: usize) -> i32 { return if o.isImmutable(d) { 1 } else { 0 } }
pub fn drawFuncsSetMoveToFunc(d: usize, f: usize, u: usize, x: usize) -> void { setFunc(d, MOVE_TO, f, u, x) }
pub fn drawFuncsSetLineToFunc(d: usize, f: usize, u: usize, x: usize) -> void { setFunc(d, LINE_TO, f, u, x) }
pub fn drawFuncsSetQuadraticToFunc(d: usize, f: usize, u: usize, x: usize) -> void { setFunc(d, QUADRATIC_TO, f, u, x) }
pub fn drawFuncsSetCubicToFunc(d: usize, f: usize, u: usize, x: usize) -> void { setFunc(d, CUBIC_TO, f, u, x) }
pub fn drawFuncsSetClosePathFunc(d: usize, f: usize, u: usize, x: usize) -> void { setFunc(d, CLOSE_PATH, f, u, x) }

// The calls of the program's functions (none: nothing done).
pub const PointFunc = fn(usize, usize, usize, f32, f32, usize) -> void
pub const QuadraticFunc = fn(usize, usize, usize, f32, f32, f32, f32, usize) -> void
pub const CubicFunc = fn(usize, usize, usize, f32, f32, f32, f32, f32, f32, usize) -> void
pub const CloseFunc = fn(usize, usize, usize, usize) -> void

pub fn emitMoveTo(d: usize, data: usize, st: usize, x: f32, y: f32) -> void {
    const f = funcAt(d, MOVE_TO)
    if f == 0 { return }
    const call: PointFunc = unsafe { @ptrFromInt(PointFunc, f) }
    call(d, data, st, x, y, dataAt(d, MOVE_TO))
}

pub fn emitLineTo(d: usize, data: usize, st: usize, x: f32, y: f32) -> void {
    const f = funcAt(d, LINE_TO)
    if f == 0 { return }
    const call: PointFunc = unsafe { @ptrFromInt(PointFunc, f) }
    call(d, data, st, x, y, dataAt(d, LINE_TO))
}

pub fn emitQuadraticTo(d: usize, data: usize, st: usize, cx: f32, cy: f32, x: f32, y: f32) -> void {
    const f = funcAt(d, QUADRATIC_TO)
    if f == 0 {
        // (Without a quadratic function: the cubic of the same curve.)
        const g = funcAt(d, CUBIC_TO)
        if g == 0 { return }
        const sx = m.getF32(st + 12)
        const sy = m.getF32(st + 16)
        const call: CubicFunc = unsafe { @ptrFromInt(CubicFunc, g) }
        const third: f32 = 0.33333333
        call(d, data, st, (sx + 2.0 * cx) * third, (sy + 2.0 * cy) * third, (x + 2.0 * cx) * third, (y + 2.0 * cy) * third, x, y, dataAt(d, CUBIC_TO))
        return
    }
    const call: QuadraticFunc = unsafe { @ptrFromInt(QuadraticFunc, f) }
    call(d, data, st, cx, cy, x, y, dataAt(d, QUADRATIC_TO))
}

pub fn emitCubicTo(d: usize, data: usize, st: usize, c1x: f32, c1y: f32, c2x: f32, c2y: f32, x: f32, y: f32) -> void {
    const f = funcAt(d, CUBIC_TO)
    if f == 0 { return }
    const call: CubicFunc = unsafe { @ptrFromInt(CubicFunc, f) }
    call(d, data, st, c1x, c1y, c2x, c2y, x, y, dataAt(d, CUBIC_TO))
}

pub fn emitClosePath(d: usize, data: usize, st: usize) -> void {
    const f = funcAt(d, CLOSE_PATH)
    if f == 0 { return }
    const call: CloseFunc = unsafe { @ptrFromInt(CloseFunc, f) }
    call(d, data, st, dataAt(d, CLOSE_PATH))
}

fn startPath(d: usize, data: usize, st: usize) -> void {
    emitMoveTo(d, data, st, m.getF32(st + 12), m.getF32(st + 16))
    m.put32(st, 1)
    m.putF32(st + 4, m.getF32(st + 12))
    m.putF32(st + 8, m.getF32(st + 16))
}

fn setCurrent(st: usize, x: f32, y: f32) -> void {
    m.putF32(st + 12, x)
    m.putF32(st + 16, y)
}

pub fn closePath(d: usize, data: usize, st: usize) -> void {
    if m.get32(st) != 0 {
        if m.getF32(st + 4) != m.getF32(st + 12) || m.getF32(st + 8) != m.getF32(st + 16) { emitLineTo(d, data, st, m.getF32(st + 4), m.getF32(st + 8)) }
        emitClosePath(d, data, st)
    }
    m.put32(st, 0)
    m.putF32(st + 4, 0.0)
    m.putF32(st + 8, 0.0)
    m.putF32(st + 12, 0.0)
    m.putF32(st + 16, 0.0)
}

pub fn moveTo(d: usize, data: usize, st: usize, x: f32, y: f32) -> void {
    if m.get32(st) != 0 { closePath(d, data, st) }
    setCurrent(st, x, y)
}

pub fn lineTo(d: usize, data: usize, st: usize, x: f32, y: f32) -> void {
    if m.get32(st) == 0 { startPath(d, data, st) }
    emitLineTo(d, data, st, x, y)
    setCurrent(st, x, y)
}

pub fn quadraticTo(d: usize, data: usize, st: usize, cx: f32, cy: f32, x: f32, y: f32) -> void {
    if m.get32(st) == 0 { startPath(d, data, st) }
    emitQuadraticTo(d, data, st, cx, cy, x, y)
    setCurrent(st, x, y)
}

pub fn cubicTo(d: usize, data: usize, st: usize, c1x: f32, c1y: f32, c2x: f32, c2y: f32, x: f32, y: f32) -> void {
    if m.get32(st) == 0 { startPath(d, data, st) }
    emitCubicTo(d, data, st, c1x, c1y, c2x, c2y, x, y)
    setCurrent(st, x, y)
}

pub fn drawMoveTo(d: usize, data: usize, st: usize, x: f32, y: f32) -> void { moveTo(d, data, st, x, y) }
pub fn drawLineTo(d: usize, data: usize, st: usize, x: f32, y: f32) -> void { lineTo(d, data, st, x, y) }
pub fn drawQuadraticTo(d: usize, data: usize, st: usize, cx: f32, cy: f32, x: f32, y: f32) -> void { quadraticTo(d, data, st, cx, cy, x, y) }
pub fn drawCubicTo(d: usize, data: usize, st: usize, c1x: f32, c1y: f32, c2x: f32, c2y: f32, x: f32, y: f32) -> void { cubicTo(d, data, st, c1x, c1y, c2x, c2y, x, y) }
pub fn drawClosePath(d: usize, data: usize, st: usize) -> void { closePath(d, data, st) }

// A drawing session: the funcs, their data, the slant, and the state
// (allocated with it); closed and freed by `endSession`.
pub const Session = struct {
    funcs: usize
    data: usize
    slant: f32
    pad: u32
    state: [12]u32
}

pub fn session(address: usize) -> *Session { unsafe { return @ptrFromInt(*Session, address) } }

pub fn beginSession(funcs: usize, data: usize, slant: f32) -> usize {
    const s = m.alloc(@sizeOf(Session))
    if s == 0 { return 0 }
    session(s).*.funcs = funcs
    session(s).*.data = data
    session(s).*.slant = slant
    return s
}

pub fn endSession(s: usize) -> void {
    if s == 0 { return }
    closePath(session(s).*.funcs, session(s).*.data, s + 24)
    m.release(s)
}

// x slanted by the session's slant (unchanged, signed zeros too, without).
fn sx(p: *Session, x: f32, y: f32) -> f32 { return if p.*.slant == 0.0 { x } else { x + y * p.*.slant } }

pub fn sMoveTo(s: usize, x: f32, y: f32) -> void {
    const p = session(s)
    moveTo(p.*.funcs, p.*.data, s + 24, sx(p, x, y), y)
}

pub fn sLineTo(s: usize, x: f32, y: f32) -> void {
    const p = session(s)
    lineTo(p.*.funcs, p.*.data, s + 24, sx(p, x, y), y)
}

pub fn sQuadraticTo(s: usize, cx: f32, cy: f32, x: f32, y: f32) -> void {
    const p = session(s)
    quadraticTo(p.*.funcs, p.*.data, s + 24, sx(p, cx, cy), cy, sx(p, x, y), y)
}

pub fn sCubicTo(s: usize, c1x: f32, c1y: f32, c2x: f32, c2y: f32, x: f32, y: f32) -> void {
    const p = session(s)
    cubicTo(p.*.funcs, p.*.data, s + 24, sx(p, c1x, c1y), c1y, sx(p, c2x, c2y), c2y, sx(p, x, y), y)
}

pub fn sClosePath(s: usize) -> void {
    const p = session(s)
    closePath(p.*.funcs, p.*.data, s + 24)
}
