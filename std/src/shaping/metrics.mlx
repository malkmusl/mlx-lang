// hb-ot-metrics.h: the font-wide metrics of OS/2, hhea, vhea and post,
// with their variations of MVAR (HarfBuzz's hb-ot-metrics.cc).
const m = @import("./memory.mlx")
const face = @import("./face.mlx")
const font = @import("./font.mlx")
const hmtx = @import("./hmtx.mlx")
const variations = @import("./variations.mlx")

pub const TAG_HORIZONTAL_ASCENDER: u32 = 0x68617363
pub const TAG_HORIZONTAL_DESCENDER: u32 = 0x68647363
pub const TAG_HORIZONTAL_LINE_GAP: u32 = 0x686C6770
pub const TAG_HORIZONTAL_CLIPPING_ASCENT: u32 = 0x68636C61
pub const TAG_HORIZONTAL_CLIPPING_DESCENT: u32 = 0x68636C64
pub const TAG_VERTICAL_ASCENDER: u32 = 0x76617363
pub const TAG_VERTICAL_DESCENDER: u32 = 0x76647363
pub const TAG_VERTICAL_LINE_GAP: u32 = 0x766C6770
pub const TAG_HORIZONTAL_CARET_RISE: u32 = 0x68637273
pub const TAG_HORIZONTAL_CARET_RUN: u32 = 0x6863726E
pub const TAG_HORIZONTAL_CARET_OFFSET: u32 = 0x68636F66
pub const TAG_VERTICAL_CARET_RISE: u32 = 0x76637273
pub const TAG_VERTICAL_CARET_RUN: u32 = 0x7663726E
pub const TAG_VERTICAL_CARET_OFFSET: u32 = 0x76636F66
pub const TAG_X_HEIGHT: u32 = 0x78686774
pub const TAG_CAP_HEIGHT: u32 = 0x63706874
pub const TAG_SUBSCRIPT_EM_X_SIZE: u32 = 0x73627873
pub const TAG_SUBSCRIPT_EM_Y_SIZE: u32 = 0x73627973
pub const TAG_SUBSCRIPT_EM_X_OFFSET: u32 = 0x7362786F
pub const TAG_SUBSCRIPT_EM_Y_OFFSET: u32 = 0x7362796F
pub const TAG_SUPERSCRIPT_EM_X_SIZE: u32 = 0x73707873
pub const TAG_SUPERSCRIPT_EM_Y_SIZE: u32 = 0x73707973
pub const TAG_SUPERSCRIPT_EM_X_OFFSET: u32 = 0x7370786F
pub const TAG_SUPERSCRIPT_EM_Y_OFFSET: u32 = 0x7370796F
pub const TAG_STRIKEOUT_SIZE: u32 = 0x73747273
pub const TAG_STRIKEOUT_OFFSET: u32 = 0x7374726F
pub const TAG_UNDERLINE_SIZE: u32 = 0x756E6473
pub const TAG_UNDERLINE_OFFSET: u32 = 0x756E646F

// The OS/2 table if it passes HarfBuzz's checks (78 bytes and the tails
// of its version); and whether it "has data" (HarfBuzz's test).
pub fn os2View(fc: usize, out: *m.Table) -> void {
    face.view(fc, face.T_OS2, out)
    var need: usize = 78
    const version = m.u16at(out, 0)
    if version >= 1 { need = 86 }
    if version >= 2 { need = 96 }
    if version >= 5 { need = 100 }
    if out.*.length < need { out.*.length = 0 }
}

pub fn os2HasData(t: *m.Table) -> bool { return m.u16at(t, 4) != 0 || m.u16at(t, 6) != 0 || m.u16at(t, 64) != 0 || m.u16at(t, 66) != 0 }

fn postView(fc: usize, out: *m.Table) -> void {
    face.view(fc, face.T_POST, out)
    if out.*.length < 32 { out.*.length = 0 }
}

fn fix(value: f32, tag: u32) -> f32 {
    if tag == TAG_HORIZONTAL_ASCENDER || tag == TAG_VERTICAL_ASCENDER { return m.fabsf(value) }
    if tag == TAG_HORIZONTAL_DESCENDER || tag == TAG_VERTICAL_DESCENDER { return 0.0 - m.fabsf(value) }
    return value
}

fn varOf(f: usize, tag: u32) -> f32 {
    const fo = font.font(f)
    return variations.mvarDelta(fo.*.face, tag, fo.*.coords, fo.*.numCoords)
}

// The ascender, descender and line gap (HarfBuzz's
// _hb_ot_metrics_get_position_common).
pub fn positionCommon(f: usize, tag: u32, position: usize) -> bool {
    const fc = font.font(f).*.face
    var os2: m.Table = undefined
    os2View(fc, &os2)
    var hhea: m.Table = undefined
    var field: usize = 0
    var typoField: usize = 0
    var vertical = false
    if tag == TAG_HORIZONTAL_ASCENDER {
        field = 4
        typoField = 68
    } else if tag == TAG_HORIZONTAL_DESCENDER {
        field = 6
        typoField = 70
    } else if tag == TAG_HORIZONTAL_LINE_GAP {
        field = 8
        typoField = 72
    } else if tag == TAG_VERTICAL_ASCENDER {
        field = 4
        vertical = true
    } else if tag == TAG_VERTICAL_DESCENDER {
        field = 6
        vertical = true
    } else if tag == TAG_VERTICAL_LINE_GAP {
        field = 8
        vertical = true
    } else {
        return false
    }
    if !vertical && (m.u16at(&os2, 62) & 0x80) != 0 && os2HasData(&os2) {
        if position != 0 { m.putI32(position, font.emScalefY(f, fix(@floatFromInt(f32, m.i16at(&os2, typoField)) + varOf(f, tag), tag))) }
        return true
    }
    hmtx.headerView(fc, !vertical, &hhea)
    if hhea.length == 0 { return false }
    if position != 0 {
        const v = fix(@floatFromInt(f32, m.i16at(&hhea, field)) + varOf(f, tag), tag)
        m.putI32(position, if vertical { font.emScalefX(f, v) } else { font.emScalefY(f, v) })
    }
    return true
}

fn metricX(f: usize, has: bool, value: i32, tag: u32, position: usize) -> bool {
    if !has { return false }
    if position != 0 { m.putI32(position, font.emScalefX(f, @floatFromInt(f32, value) + varOf(f, tag))) }
    return true
}

fn metricY(f: usize, has: bool, value: i32, tag: u32, position: usize) -> bool {
    if !has { return false }
    if position != 0 { m.putI32(position, font.emScalefY(f, @floatFromInt(f32, value) + varOf(f, tag))) }
    return true
}

pub fn getPosition(f: usize, tag: u32, position: usize) -> bool {
    const fc = font.font(f).*.face
    if tag == TAG_HORIZONTAL_ASCENDER || tag == TAG_HORIZONTAL_DESCENDER || tag == TAG_HORIZONTAL_LINE_GAP || tag == TAG_VERTICAL_ASCENDER || tag == TAG_VERTICAL_DESCENDER || tag == TAG_VERTICAL_LINE_GAP { return positionCommon(f, tag, position) }
    var os2: m.Table = undefined
    os2View(fc, &os2)
    const os2Has = os2HasData(&os2)
    var hhea: m.Table = undefined
    hmtx.headerView(fc, true, &hhea)
    const hheaHas = hhea.length != 0
    var vhea: m.Table = undefined
    hmtx.headerView(fc, false, &vhea)
    const vheaHas = vhea.length != 0
    if tag == TAG_HORIZONTAL_CLIPPING_ASCENT { return metricY(f, os2Has, @intCast(i32, m.u16at(&os2, 74)), tag, position) }
    if tag == TAG_HORIZONTAL_CLIPPING_DESCENT { return metricY(f, os2Has, @intCast(i32, m.u16at(&os2, 76)), tag, position) }
    if tag == TAG_HORIZONTAL_CARET_RISE || tag == TAG_HORIZONTAL_CARET_RUN {
        var mult: i32 = 1
        const fo = font.font(f)
        if fo.*.slant != 0.0 {
            const rise = m.u16at(&hhea, 18)
            const upem = face.upem(fc)
            if rise != 0 && rise < upem {
                const q = upem / rise
                mult = @intCast(i32, if q < 256 { q } else { 256 })
            }
        }
        if tag == TAG_HORIZONTAL_CARET_RISE {
            const ret = metricY(f, hheaHas, m.i16at(&hhea, 18), tag, position)
            if position != 0 { m.putI32(position, m.getI32(position) *% mult) }
            return ret
        }
        var rise: i32 = 0
        if fo.*.slant != 0.0 && position != 0 && metricY(f, hheaHas, m.i16at(&hhea, 18), TAG_HORIZONTAL_CARET_RISE, position) { rise = m.getI32(position) }
        const ret = metricX(f, hheaHas, m.i16at(&hhea, 20), tag, position)
        if position != 0 {
            var p = m.getI32(position) *% mult
            if fo.*.slant != 0.0 { p +%= m.intOf(m.roundf(@floatFromInt(f32, mult) * fo.*.slantXy * @floatFromInt(f32, rise))) }
            m.putI32(position, p)
        }
        return ret
    }
    if tag == TAG_HORIZONTAL_CARET_OFFSET { return metricX(f, hheaHas, m.i16at(&hhea, 22), tag, position) }
    if tag == TAG_VERTICAL_CARET_RISE { return metricX(f, vheaHas, m.i16at(&vhea, 18), tag, position) }
    if tag == TAG_VERTICAL_CARET_RUN { return metricY(f, vheaHas, m.i16at(&vhea, 20), tag, position) }
    if tag == TAG_VERTICAL_CARET_OFFSET { return metricY(f, vheaHas, m.i16at(&vhea, 22), tag, position) }
    if tag == TAG_X_HEIGHT || tag == TAG_CAP_HEIGHT {
        const v2 = m.u16at(&os2, 0) >= 2
        const x = if v2 { m.i16at(&os2, 86) } else { 0 }
        const c = if v2 { m.i16at(&os2, 88) } else { 0 }
        return metricY(f, x != 0 || c != 0, if tag == TAG_X_HEIGHT { x } else { c }, tag, position)
    }
    if tag == TAG_SUBSCRIPT_EM_X_SIZE { return metricX(f, os2Has, m.i16at(&os2, 10), tag, position) }
    if tag == TAG_SUBSCRIPT_EM_Y_SIZE { return metricY(f, os2Has, m.i16at(&os2, 12), tag, position) }
    if tag == TAG_SUBSCRIPT_EM_X_OFFSET { return metricX(f, os2Has, m.i16at(&os2, 14), tag, position) }
    if tag == TAG_SUBSCRIPT_EM_Y_OFFSET { return metricY(f, os2Has, m.i16at(&os2, 16), tag, position) }
    if tag == TAG_SUPERSCRIPT_EM_X_SIZE { return metricX(f, os2Has, m.i16at(&os2, 18), tag, position) }
    if tag == TAG_SUPERSCRIPT_EM_Y_SIZE { return metricY(f, os2Has, m.i16at(&os2, 20), tag, position) }
    if tag == TAG_SUPERSCRIPT_EM_X_OFFSET { return metricX(f, os2Has, m.i16at(&os2, 22), tag, position) }
    if tag == TAG_SUPERSCRIPT_EM_Y_OFFSET { return metricY(f, os2Has, m.i16at(&os2, 24), tag, position) }
    if tag == TAG_STRIKEOUT_SIZE { return metricY(f, os2Has, m.i16at(&os2, 26), tag, position) }
    if tag == TAG_STRIKEOUT_OFFSET { return metricY(f, os2Has, m.i16at(&os2, 28), tag, position) }
    var post: m.Table = undefined
    postView(fc, &post)
    const postHas = m.u32at(&post, 0) != 0
    if tag == TAG_UNDERLINE_SIZE { return metricY(f, postHas, m.i16at(&post, 10), tag, position) }
    if tag == TAG_UNDERLINE_OFFSET { return metricY(f, postHas, m.i16at(&post, 8), tag, position) }
    // (HarfBuzz's private tags: OS/2's and hhea's values each.)
    if tag == 0x4F617363 { return metricY(f, os2Has, m.i16at(&os2, 68), tag, position) }
    if tag == 0x48617363 { return metricY(f, hheaHas, m.i16at(&hhea, 4), tag, position) }
    if tag == 0x4F647363 { return metricY(f, os2Has, m.i16at(&os2, 70), tag, position) }
    if tag == 0x48647363 { return metricY(f, hheaHas, m.i16at(&hhea, 6), tag, position) }
    if tag == 0x4F6C6770 { return metricY(f, os2Has, m.i16at(&os2, 72), tag, position) }
    if tag == 0x486C6770 { return metricY(f, hheaHas, m.i16at(&hhea, 8), tag, position) }
    return false
}

pub fn otMetricsGetPosition(f: usize, tag: u32, position: usize) -> i32 { return if getPosition(f, tag, position) { 1 } else { 0 } }

pub fn otMetricsGetPositionWithFallback(f: usize, tag: u32, position: usize) -> void { positionWithFallback(f, tag, position) }

pub fn positionWithFallback(f: usize, tag: u32, position: usize) -> void {
    if getPosition(f, tag, position) {
        if (tag != TAG_STRIKEOUT_SIZE && tag != TAG_UNDERLINE_SIZE) || m.getI32(position) != 0 { return }
    }
    const fo = font.font(f)
    var e: [12]i32 = undefined
    const ea = @intFromPtr(&e)
    if tag == TAG_HORIZONTAL_ASCENDER || tag == TAG_HORIZONTAL_CLIPPING_ASCENT {
        font.getHExtentsWithFallback(f, ea)
        m.putI32(position, e[0])
    } else if tag == TAG_VERTICAL_ASCENDER || tag == TAG_VERTICAL_DESCENDER {
        font.getVExtentsWithFallback(f, ea)
        m.putI32(position, e[0])
    } else if tag == TAG_HORIZONTAL_DESCENDER || tag == TAG_HORIZONTAL_CLIPPING_DESCENT {
        font.getHExtentsWithFallback(f, ea)
        m.putI32(position, e[1])
    } else if tag == TAG_HORIZONTAL_LINE_GAP {
        font.getHExtentsWithFallback(f, ea)
        m.putI32(position, e[2])
    } else if tag == TAG_VERTICAL_LINE_GAP {
        font.getVExtentsWithFallback(f, ea)
        m.putI32(position, e[2])
    } else if tag == TAG_HORIZONTAL_CARET_RISE || tag == TAG_VERTICAL_CARET_RISE {
        m.putI32(position, 1)
    } else if tag == TAG_X_HEIGHT {
        var g: u32 = 0
        if font.getNominalGlyph(f, 'x', &g) && font.getGlyphExtents(f, g, ea) { m.putI32(position, e[1]) } else { m.putI32(position, fo.*.yScale / 2) }
    } else if tag == TAG_CAP_HEIGHT {
        var g: u32 = 0
        if font.getNominalGlyph(f, 'O', &g) && font.getGlyphExtents(f, g, ea) { m.putI32(position, e[3] + 2 * e[1]) } else { m.putI32(position, fo.*.yScale * 2 / 3) }
    } else if tag == TAG_STRIKEOUT_SIZE || tag == TAG_UNDERLINE_SIZE {
        m.putI32(position, fo.*.yScale / 18)
    } else if tag == TAG_STRIKEOUT_OFFSET {
        var asc: i32 = 0
        positionWithFallback(f, TAG_HORIZONTAL_ASCENDER, @intFromPtr(&asc))
        m.putI32(position, asc / 2)
    } else if tag == TAG_UNDERLINE_OFFSET {
        m.putI32(position, 0 - fo.*.yScale / 18)
    } else if tag == TAG_SUBSCRIPT_EM_X_SIZE || tag == TAG_SUPERSCRIPT_EM_X_SIZE {
        m.putI32(position, fo.*.xScale * 10 / 12)
    } else if tag == TAG_SUBSCRIPT_EM_Y_SIZE || tag == TAG_SUPERSCRIPT_EM_Y_SIZE {
        m.putI32(position, fo.*.yScale * 10 / 12)
    } else if tag == TAG_SUBSCRIPT_EM_Y_OFFSET || tag == TAG_SUPERSCRIPT_EM_Y_OFFSET {
        m.putI32(position, fo.*.yScale / 5)
    } else {
        m.putI32(position, 0)
    }
}

pub fn otMetricsGetVariation(f: usize, tag: u32) -> f32 { return varOf(f, tag) }
pub fn otMetricsGetXVariation(f: usize, tag: u32) -> i32 { return font.emScalefX(f, varOf(f, tag)) }
pub fn otMetricsGetYVariation(f: usize, tag: u32) -> i32 { return font.emScalefY(f, varOf(f, tag)) }
