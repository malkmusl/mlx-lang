// std.conf: the settings files the desktop and its services keep. A file
// is lines of "key = value", with spaces and tabs around both as the
// writer likes; a line whose first character is "#" is a comment; a
// "[Group]" line starts a group (in the files that have them: desktop
// entries, D-Bus service files); any other line is not one of these.
//
//     var lines = conf.lines(text)
//     var entry: conf.Entry = undefined
//     while conf.next(&lines, &entry) {
//         if std.text.same(entry.key, "volume") { ... entry.value ... }
//     }
//
// Keys and values are slices of the text, the blanks around them (spaces,
// tabs, a CR before the line feed) left out; nothing allocates.
const std = @import("std")

pub const Entry = struct {
    key: []const u8
    value: []const u8
    // The group the line is in, without its brackets ("" before the first
    // group line).
    group: []const u8
}

// What a line is (parseLine).
pub const BLANK: u8 = 0
pub const ENTRY: u8 = 1
pub const GROUP: u8 = 2
pub const OTHER: u8 = 3

// One line (without its line feed): BLANK for an empty line or a comment,
// ENTRY with `entry`'s key and value set, GROUP with `entry`'s group set,
// or OTHER for a line that is none of these (no "=").
pub fn parseLine(line: []const u8, entry: *Entry) -> u8 {
    const text = std.text.trimmed(line)
    if text.length == 0 || text[0] == 35 { return BLANK }
    if text[0] == 91 && text[text.length - 1] == 93 {
        entry.*.group = text[1..text.length - 1]
        return GROUP
    }
    var equals: usize = 0
    while equals < text.length && text[equals] != 61 { equals += 1 }
    if equals == text.length { return OTHER }
    entry.*.key = std.text.trimmed(text[0..equals])
    entry.*.value = std.text.trimmed(text[equals + 1..text.length])
    return ENTRY
}

pub const Lines = struct {
    text: []const u8
    at: usize
    group: []const u8
}

// The entries of `text`, from its first line.
pub fn lines(text: []const u8) -> Lines {
    return Lines.{ .text = text, .at = 0, .group = text[0..0] }
}

// The next "key = value" line into `entry` (with the group it is in);
// false after the last. Other lines are passed over.
pub fn next(reader: *Lines, entry: *Entry) -> bool {
    const text = reader.*.text
    while reader.*.at < text.length {
        const start = reader.*.at
        var end = start
        while end < text.length && text[end] != 10 { end += 1 }
        reader.*.at = end + 1
        entry.*.group = reader.*.group
        const kind = parseLine(text[start..end], entry)
        if kind == GROUP { reader.*.group = entry.*.group }
        if kind == ENTRY { return true }
    }
    return false
}

// The value of the first `key` in `text` (in any group); null when no line
// sets it.
pub fn find(text: []const u8, key: []const u8) -> ?[]const u8 {
    var reader = lines(text)
    var entry: Entry = undefined
    while next(&reader, &entry) {
        if std.text.same(entry.key, key) { return entry.value }
    }
    return null
}

// A switch's value: "on", "yes", "true" and "1" set `result` true, "off",
// "no", "false" and "0" false; false (and `result` as it was) for any
// other value.
pub fn parseSwitch(value: []const u8, result: *bool) -> bool {
    if std.text.same(value, "on") || std.text.same(value, "yes") || std.text.same(value, "true") || std.text.same(value, "1") {
        result.* = true
        return true
    }
    if std.text.same(value, "off") || std.text.same(value, "no") || std.text.same(value, "false") || std.text.same(value, "0") {
        result.* = false
        return true
    }
    return false
}
