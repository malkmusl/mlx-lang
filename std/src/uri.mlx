// std.uri: URIs (RFC 3986) split into their parts, references resolved
// against a base, written back, percent-encoded and decoded, and their
// query parameters: what an HTTP client and a browser need of them.
// Nothing here allocates: a Uri borrows the text it was parsed from, a
// resolved reference is written into a buffer of the caller's.
//
//     var uri: uri.Uri = undefined
//     if uri.parse("https://user@example.com:8443/a/b?q=1#top", &uri) { ... uri.host, uri.path ... }
//     var target: [2048]u8 = undefined
//     const n = uri.resolve(&base, "../c?x", target[0..2048])   // 0 when it does not fit or is malformed

pub const Write = fn(usize, []const u8) -> void

// Where text is written: `write(context, bytes)` appends the bytes.
pub const Sink = struct {
    context: usize
    write: Write
}

fn put(sink: Sink, bytes: []const u8) -> void { sink.write(sink.context, bytes) }

fn putByte(sink: Sink, byte: u8) -> void {
    var one: [1]u8 = undefined
    one[0] = byte
    sink.write(sink.context, one[0..1])
}

pub const Uri = struct {
    scheme: []const u8
    userinfo: []const u8
    host: []const u8
    // The port's digits.
    port: []const u8
    path: []const u8
    query: []const u8
    fragment: []const u8
    hasScheme: bool
    // Whether there is an authority ("//" after the scheme), even an
    // empty one.
    hasAuthority: bool
    hasUserinfo: bool
    hasPort: bool
    hasQuery: bool
    hasFragment: bool
}

fn isAlpha(c: u8) -> bool { return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) }
fn isDigit(c: u8) -> bool { return c >= 48 && c <= 57 }
fn isHex(c: u8) -> bool { return isDigit(c) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70) }
fn isUnreserved(c: u8) -> bool { return isAlpha(c) || isDigit(c) || c == 45 || c == 46 || c == 95 || c == 126 }
fn isSubDelim(c: u8) -> bool { return c == 33 || c == 36 || c == 38 || c == 39 || c == 40 || c == 41 || c == 42 || c == 43 || c == 44 || c == 59 || c == 61 }

fn lower(c: u8) -> u8 { return if c >= 65 && c <= 90 { c + 32 } else { c } }

pub fn sameText(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var i: usize = 0
    while i < a.length {
        if a[i] != b[i] { return false }
        i += 1
    }
    return true
}

pub fn equalsIgnoringCase(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var i: usize = 0
    while i < a.length {
        if lower(a[i]) != lower(b[i]) { return false }
        i += 1
    }
    return true
}

fn indexOf(text: []const u8, byte: u8, from: usize) -> usize {
    var i = from
    while i < text.length && text[i] != byte { i += 1 }
    return i
}

// ---------------------------------------------------------------------------
// Parsing

fn clear(uri: *Uri, text: []const u8) -> void {
    const none = text[0..0]
    uri.*.scheme = none
    uri.*.userinfo = none
    uri.*.host = none
    uri.*.port = none
    uri.*.path = none
    uri.*.query = none
    uri.*.fragment = none
    uri.*.hasScheme = false
    uri.*.hasAuthority = false
    uri.*.hasUserinfo = false
    uri.*.hasPort = false
    uri.*.hasQuery = false
    uri.*.hasFragment = false
}

// Whether `text` starts with a scheme and its colon: a letter, then
// letters, digits, `+`, `-` or `.`, then `:`.
fn schemeLength(text: []const u8) -> usize {
    if text.length == 0 || !isAlpha(text[0]) { return 0 }
    var i: usize = 1
    while i < text.length {
        const c = text[i]
        if c == 58 { return i }
        if !(isAlpha(c) || isDigit(c) || c == 43 || c == 45 || c == 46) { return 0 }
        i += 1
    }
    return 0
}

// Splits a URI reference (RFC 3986 appendix B) into its parts, which
// borrow `text`. False when it is malformed: a port that is not digits,
// an IPv6 literal without its bracket, control characters or spaces, a
// `%` not followed by two hex digits.
pub fn parse(text: []const u8, uri: *Uri) -> bool {
    clear(uri, text)
    for c in text {
        if c <= 32 || c == 127 { return false }
    }
    var at: usize = 0
    const scheme = schemeLength(text)
    if scheme > 0 {
        uri.*.scheme = text[0..scheme]
        uri.*.hasScheme = true
        at = scheme + 1
    }
    // The fragment and the query, from the end.
    var end = text.length
    const hash = indexOf(text, 35, at)
    if hash < end {
        uri.*.fragment = text[hash + 1..end]
        uri.*.hasFragment = true
        end = hash
    }
    const question = indexOf(text[0..end], 63, at)
    if question < end {
        uri.*.query = text[question + 1..end]
        uri.*.hasQuery = true
        end = question
    }
    // The authority.
    if end - at >= 2 && text[at] == 47 && text[at + 1] == 47 {
        uri.*.hasAuthority = true
        at += 2
        const slash = indexOf(text[0..end], 47, at)
        const authority = text[at..slash]
        var hostStart: usize = 0
        var i = authority.length
        while i > 0 {
            i -= 1
            if authority[i] == 64 {
                uri.*.userinfo = authority[0..i]
                uri.*.hasUserinfo = true
                hostStart = i + 1
                break
            }
        }
        const hostPort = authority[hostStart..authority.length]
        var hostEnd = hostPort.length
        if hostPort.length > 0 && hostPort[0] == 91 {
            const close = indexOf(hostPort, 93, 0)
            if close == hostPort.length { return false }
            hostEnd = close + 1
            if hostEnd < hostPort.length && hostPort[hostEnd] != 58 { return false }
        } else {
            var j = hostPort.length
            while j > 0 {
                j -= 1
                if hostPort[j] == 58 {
                    hostEnd = j
                    break
                }
            }
        }
        uri.*.host = hostPort[0..hostEnd]
        if hostEnd < hostPort.length {
            uri.*.port = hostPort[hostEnd + 1..hostPort.length]
            uri.*.hasPort = true
            for c in uri.*.port {
                if !isDigit(c) { return false }
            }
        }
        at = slash
    }
    uri.*.path = text[at..end]
    // Percent escapes must be whole.
    var p: usize = 0
    while p < text.length {
        if text[p] == 37 {
            if p + 2 >= text.length || !isHex(text[p + 1]) || !isHex(text[p + 2]) { return false }
        }
        p += 1
    }
    return true
}

// The port as a number: the one written, else the scheme's default
// (http 80, https 443, ws 80, wss 443, ftp 21), else 0.
pub fn portOf(uri: *const Uri) -> u16 {
    if uri.*.hasPort {
        var value: u32 = 0
        for c in uri.*.port {
            value = value * 10 + @intCast(u32, c - 48)
            if value > 65535 { return 0 }
        }
        return @intCast(u16, value)
    }
    return defaultPort(uri.*.scheme)
}

pub fn defaultPort(scheme: []const u8) -> u16 {
    if equalsIgnoringCase(scheme, "http") || equalsIgnoringCase(scheme, "ws") { return 80 }
    if equalsIgnoringCase(scheme, "https") || equalsIgnoringCase(scheme, "wss") { return 443 }
    if equalsIgnoringCase(scheme, "ftp") { return 21 }
    return 0
}

// Whether the port written is the scheme's default (or none is).
pub fn usesDefaultPort(uri: *const Uri) -> bool {
    if !uri.*.hasPort { return true }
    return portOf(uri) == defaultPort(uri.*.scheme)
}

// The host without the brackets of an IPv6 literal.
pub fn hostName(uri: *const Uri) -> []const u8 {
    const host = uri.*.host
    if host.length >= 2 && host[0] == 91 && host[host.length - 1] == 93 { return host[1..host.length - 1] }
    return host
}

pub fn isHttp(uri: *const Uri) -> bool { return equalsIgnoringCase(uri.*.scheme, "http") }
pub fn isHttps(uri: *const Uri) -> bool { return equalsIgnoringCase(uri.*.scheme, "https") }

// ---------------------------------------------------------------------------
// Writing

// The URI from its parts (RFC 3986 5.3).
pub fn write(sink: Sink, uri: *const Uri) -> void {
    if uri.*.hasScheme {
        put(sink, uri.*.scheme)
        putByte(sink, 58)
    }
    if uri.*.hasAuthority {
        put(sink, "//")
        if uri.*.hasUserinfo {
            put(sink, uri.*.userinfo)
            putByte(sink, 64)
        }
        put(sink, uri.*.host)
        if uri.*.hasPort {
            putByte(sink, 58)
            put(sink, uri.*.port)
        }
    }
    put(sink, uri.*.path)
    if uri.*.hasQuery {
        putByte(sink, 63)
        put(sink, uri.*.query)
    }
    if uri.*.hasFragment {
        putByte(sink, 35)
        put(sink, uri.*.fragment)
    }
}

// The scheme and host in lower case.
fn putLower(sink: Sink, text: []const u8) -> void {
    var start: usize = 0
    var i: usize = 0
    while i < text.length {
        if text[i] >= 65 && text[i] <= 90 {
            if i > start { put(sink, text[start..i]) }
            putByte(sink, text[i] + 32)
            start = i + 1
        }
        i += 1
    }
    if i > start { put(sink, text[start..i]) }
}

// The URI as an HTTP client sends and compares it: the scheme and host
// in lower case, a default port left out, an empty path made "/", the
// fragment left out.
pub fn writeNormalized(sink: Sink, uri: *const Uri) -> void {
    if uri.*.hasScheme {
        putLower(sink, uri.*.scheme)
        putByte(sink, 58)
    }
    if uri.*.hasAuthority {
        put(sink, "//")
        if uri.*.hasUserinfo {
            put(sink, uri.*.userinfo)
            putByte(sink, 64)
        }
        putLower(sink, uri.*.host)
        if uri.*.hasPort && !usesDefaultPort(uri) {
            putByte(sink, 58)
            put(sink, uri.*.port)
        }
    }
    if uri.*.path.length == 0 && uri.*.hasAuthority { putByte(sink, 47) } else { put(sink, uri.*.path) }
    if uri.*.hasQuery {
        putByte(sink, 63)
        put(sink, uri.*.query)
    }
}

// The request target of an HTTP request: the path ("/" when empty) and
// the query.
pub fn writeTarget(sink: Sink, uri: *const Uri) -> void {
    if uri.*.path.length == 0 { putByte(sink, 47) } else { put(sink, uri.*.path) }
    if uri.*.hasQuery {
        putByte(sink, 63)
        put(sink, uri.*.query)
    }
}

// The Host header's value: the host, and the port when it is not the
// scheme's default.
pub fn writeHostHeader(sink: Sink, uri: *const Uri) -> void {
    put(sink, uri.*.host)
    if uri.*.hasPort && !usesDefaultPort(uri) {
        putByte(sink, 58)
        put(sink, uri.*.port)
    }
}

// Whether two URIs name the same origin: scheme and host (case aside)
// and port.
pub fn sameOrigin(a: *const Uri, b: *const Uri) -> bool {
    if !equalsIgnoringCase(a.*.scheme, b.*.scheme) { return false }
    if !equalsIgnoringCase(a.*.host, b.*.host) { return false }
    return portOf(a) == portOf(b)
}

// ---------------------------------------------------------------------------
// References resolved (RFC 3986 5.2)

const Out = struct {
    bytes: []u8
    length: usize
    overflow: bool
}

fn outPut(out: *Out, text: []const u8) -> void {
    var i: usize = 0
    while i < text.length {
        if out.*.length < out.*.bytes.length {
            out.*.bytes[out.*.length] = text[i]
        } else {
            out.*.overflow = true
        }
        out.*.length += 1
        i += 1
    }
}

fn outByte(out: *Out, byte: u8) -> void {
    var one: [1]u8 = undefined
    one[0] = byte
    outPut(out, one[0..1])
}

// RFC 3986 5.2.4: the "." and ".." segments taken out of a path, into
// `out` (as long as the path at most); the length written.
pub fn removeDotSegments(path: []const u8, out: []u8) -> usize {
    var length: usize = 0
    var at: usize = 0
    while at < path.length {
        const rest = path[at..path.length]
        if rest.length >= 3 && sameText(rest[0..3], "../") {
            at += 3
        } else if rest.length >= 2 && sameText(rest[0..2], "./") {
            at += 2
        } else if rest.length >= 3 && sameText(rest[0..3], "/./") {
            at += 2
        } else if sameText(rest, "/.") {
            // "/." at the end is "/".
            at += 1
            out[length] = 47
            length += 1
            if at < path.length { at = path.length }
            break
        } else if rest.length >= 4 && sameText(rest[0..4], "/../") {
            at += 3
            length = popSegment(out, length)
        } else if sameText(rest, "/..") {
            at = path.length
            length = popSegment(out, length)
            out[length] = 47
            length += 1
            break
        } else if sameText(rest, ".") || sameText(rest, "..") {
            at = path.length
        } else {
            // The first segment (with its leading slash) moves to the output.
            var end: usize = if rest[0] == 47 { 1 } else { 0 }
            while end < rest.length && rest[end] != 47 { end += 1 }
            var i: usize = 0
            while i < end {
                out[length] = rest[i]
                length += 1
                i += 1
            }
            at += end
        }
    }
    return length
}

// Takes the last segment (and its slash) off the output.
fn popSegment(out: []u8, length: usize) -> usize {
    var n = length
    while n > 0 && out[n - 1] != 47 { n -= 1 }
    if n > 0 { n -= 1 }
    return n
}

// The target of `reference` against `base` (RFC 3986 5.2.2), written to
// `out`; the length (0 when the reference is malformed, or longer than
// `out`: then nothing is sure). A base without a scheme gives 0.
pub fn resolve(base: *const Uri, reference: []const u8, out: []u8) -> usize {
    var r: Uri = undefined
    if !parse(reference, &r) || !base.*.hasScheme { return 0 }
    var o = Out.{ .bytes = out, .length = 0, .overflow = false }
    var t: Uri = undefined
    clear(&t, reference)
    var merged: [4096]u8 = undefined
    var cleaned: [4096]u8 = undefined
    if r.hasScheme {
        t.scheme = r.scheme
        t.hasScheme = true
        t.hasAuthority = r.hasAuthority
        t.userinfo = r.userinfo
        t.hasUserinfo = r.hasUserinfo
        t.host = r.host
        t.port = r.port
        t.hasPort = r.hasPort
        t.path = cleanPath(r.path, cleaned[0..4096])
        t.query = r.query
        t.hasQuery = r.hasQuery
    } else {
        t.scheme = base.*.scheme
        t.hasScheme = true
        if r.hasAuthority {
            t.hasAuthority = true
            t.userinfo = r.userinfo
            t.hasUserinfo = r.hasUserinfo
            t.host = r.host
            t.port = r.port
            t.hasPort = r.hasPort
            t.path = cleanPath(r.path, cleaned[0..4096])
            t.query = r.query
            t.hasQuery = r.hasQuery
        } else {
            if r.path.length == 0 {
                t.path = base.*.path
                if r.hasQuery {
                    t.query = r.query
                    t.hasQuery = true
                } else {
                    t.query = base.*.query
                    t.hasQuery = base.*.hasQuery
                }
            } else {
                if r.path[0] == 47 {
                    t.path = cleanPath(r.path, cleaned[0..4096])
                } else {
                    const m = mergePaths(base, r.path, merged[0..4096])
                    if m == 0 && r.path.length > 0 { return 0 }
                    t.path = cleanPath(merged[0..m], cleaned[0..4096])
                }
                t.query = r.query
                t.hasQuery = r.hasQuery
            }
            t.hasAuthority = base.*.hasAuthority
            t.userinfo = base.*.userinfo
            t.hasUserinfo = base.*.hasUserinfo
            t.host = base.*.host
            t.port = base.*.port
            t.hasPort = base.*.hasPort
        }
    }
    t.fragment = r.fragment
    t.hasFragment = r.hasFragment
    write(Sink.{ .context = @intFromPtr(&o), .write = outWrite }, &t)
    if o.overflow { return 0 }
    return o.length
}

fn outWrite(context: usize, bytes: []const u8) -> void {
    const o: *Out = unsafe { @ptrFromInt(*Out, context) }
    outPut(o, bytes)
}

fn cleanPath(path: []const u8, scratch: []u8) -> []const u8 {
    if path.length > scratch.length { return path }
    const n = removeDotSegments(path, scratch)
    return scratch[0..n]
}

// RFC 3986 5.2.3: the base's path up to its last slash, then the
// reference's; "/" first when the base has an authority and no path.
fn mergePaths(base: *const Uri, path: []const u8, out: []u8) -> usize {
    var length: usize = 0
    if base.*.hasAuthority && base.*.path.length == 0 {
        out[0] = 47
        length = 1
    } else {
        var cut = base.*.path.length
        while cut > 0 && base.*.path[cut - 1] != 47 { cut -= 1 }
        if cut + path.length > out.length { return 0 }
        var i: usize = 0
        while i < cut {
            out[i] = base.*.path[i]
            i += 1
        }
        length = cut
    }
    if length + path.length > out.length { return 0 }
    var i: usize = 0
    while i < path.length {
        out[length + i] = path[i]
        i += 1
    }
    return length + path.length
}

// ---------------------------------------------------------------------------
// Percent-coding and query parameters

fn hexValue(c: u8) -> u8 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    return c - 55
}

// `%XX` escapes decoded into `out` (no longer than the text), `+` made a
// space when `plus`; -1 for a bad escape.
pub fn decode(text: []const u8, out: []u8, plus: bool) -> isize {
    var at: usize = 0
    var length: usize = 0
    while at < text.length {
        const c = text[at]
        if c == 37 {
            if at + 2 >= text.length || !isHex(text[at + 1]) || !isHex(text[at + 2]) { return -1 }
            out[length] = (hexValue(text[at + 1]) << 4) | hexValue(text[at + 2])
            at += 3
        } else {
            out[length] = if plus && c == 43 { 32 } else { c }
            at += 1
        }
        length += 1
    }
    return @intCast(isize, length)
}

// `text` with everything but the unreserved characters and `allowed`
// written as %XX (upper case).
pub fn encode(sink: Sink, text: []const u8, allowed: []const u8) -> void {
    const digits = "0123456789ABCDEF"
    var start: usize = 0
    var at: usize = 0
    while at < text.length {
        const c = text[at]
        var keep = isUnreserved(c)
        if !keep { keep = indexOf(allowed, c, 0) < allowed.length }
        if !keep {
            if at > start { put(sink, text[start..at]) }
            var three: [3]u8 = undefined
            three[0] = 37
            three[1] = digits[@intCast(usize, c >> 4)]
            three[2] = digits[@intCast(usize, c & 15)]
            put(sink, three[0..3])
            start = at + 1
        }
        at += 1
    }
    if at > start { put(sink, text[start..at]) }
}

// What a path may keep unescaped (RFC 3986's pchar and "/").
pub const PATH_ALLOWED: []const u8 = "!$&'()*+,;=:@/"

// What a query may keep unescaped.
pub const QUERY_ALLOWED: []const u8 = "!$&'()*+,;=:@/?"

// The next `name=value` pair of a query (`&` or `;` between them), still
// encoded; `at` moves on, false at the end.
pub fn nextPair(query: []const u8, at: *usize, name: *[]const u8, value: *[]const u8, hasValue: *bool) -> bool {
    var start = at.*
    while start < query.length && (query[start] == 38 || query[start] == 59) { start += 1 }
    if start >= query.length { return false }
    var end = start
    while end < query.length && query[end] != 38 && query[end] != 59 { end += 1 }
    at.* = end
    const pair = query[start..end]
    const eq = indexOf(pair, 61, 0)
    hasValue.* = eq < pair.length
    name.* = pair[0..eq]
    value.* = if eq < pair.length { pair[eq + 1..pair.length] } else { pair[pair.length..pair.length] }
    return true
}
