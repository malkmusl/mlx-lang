const bootstrap = @import("../bootstrap/fmt.mlx")

pub const Error = bootstrap.Error
pub const Argument = bootstrap.Argument
pub const ArgumentKind = bootstrap.ArgumentKind
pub const File = bootstrap.File
pub const String = bootstrap.String

pub fn unsigned(value: usize) -> Argument { return bootstrap.unsigned(value) }
pub fn signed(value: isize) -> Argument { return bootstrap.signed(value) }
pub fn character(value: u8) -> Argument { return bootstrap.character(value) }
pub fn string(value: []const u8) -> Argument { return bootstrap.string(value) }
pub fn ownedString(value: String) -> Argument { return bootstrap.ownedString(value) }
pub fn pointer(address: usize) -> Argument { return bootstrap.pointer(address) }
pub fn boolean(value: bool) -> Argument { return bootstrap.boolean(value) }

pub fn printArguments(file: File, format: []const u8, values: []const Argument) -> Error!void {
    return bootstrap.printArguments(file, format, values)
}

pub fn print(file: File, format: []const u8, values: anytype) -> Error!void {
    return bootstrap.print(file, format, values)
}
