// std.gpu: Vulkan compute for pixel work (the Vulkan examples, the
// compositor, the desktop apps, Android): one device and queue, pixel buffers that can be
// shared with other processes as dma-bufs, compute kernels made from SPIR-V
// words, and a frame of recorded dispatches submitted at once.
//
//     var context: gpu.Context = undefined
//     gpu.open(&context, driver, &options, allocator)
//     gpu.createBuffer(&context, &target, width * height * 4, true)   // dma-buf
//     gpu.createKernel(&context, &pattern, code, words, 1, shaders.PATTERN_WORDS)
//     gpu.begin(&context)
//     gpu.dispatch(&context, &pattern, &buffers, &push, groups_x, groups_y)
//     gpu.submit(&context)
//
// Everything is plain std.vulkan; the Vulkan objects stay reachable through
// the records for code that needs more (a swapchain, image copies).
//
// Each pass (a dispatch, a copy, a fill) is noted with the functions that
// recorded it (std.gpu.diagnostics): a lost device or a hang is said and
// kept as a GPU crash in the pass that failed, and with MLX_GPU_PROFILE
// the GPU time goes into a profile, as std.diagnostics has them.

const std = @import("std")
const vk = @import("std.vulkan")
const loader = @import("std.vulkan.loader")
const gpu_diagnostics = @import("std.gpu.diagnostics")
const diagnostics = @import("std.diagnostics")

pub const Allocator = std.allocator.Allocator

pub const Status = enum(u8) {
    ok,
    instanceFailed,
    noDevice,
    deviceFailed,
    outOfMemory,
}

pub fn statusMessage(status: Status) -> []const u8 {
    return match status {
        .ok => "ok",
        .instanceFailed => "vkCreateInstance failed",
        .noDevice => "no physical device with a compute queue",
        .deviceFailed => "vkCreateDevice failed",
        .outOfMemory => "out of memory",
    }
}

pub const Options = struct {
    applicationName: [*]const u8
    // Extra instance and device extensions (a surface, the swapchain).
    instanceExtensions: ?[*]const [*]const u8
    instanceExtensionCount: u32
    deviceExtensions: ?[*]const [*]const u8
    deviceExtensionCount: u32
    // Enable buffer sharing (dma-buf import/export, imported host memory)
    // as far as the device supports it.
    wantSharing: bool
    // Ask for the device's video decoder too (std.gpu.video): a queue of
    // its video decode family and the VK_KHR_video_decode_* extensions,
    // when it has them (`videoH264` tells); a device with one is chosen
    // over one without.
    wantVideo: bool
    // A TraceFn address (0: none), called with each step's name before it
    // runs, to find where a driver fails (examples/vulkan-android logs them).
    trace: usize
}

pub const TraceFn = fn([*]const u8) -> void

pub const NONE_FAMILY: u32 = 4294967295

pub fn defaultOptions(name: [*]const u8) -> Options {
    return Options.{
        .applicationName = name,
        .instanceExtensions = null,
        .instanceExtensionCount = 0,
        .deviceExtensions = null,
        .deviceExtensionCount = 0,
        .wantSharing = false,
        .wantVideo = false,
        .trace = 0,
    }
}

pub const Context = struct {
    allocator: Allocator
    driver: loader.Driver
    instance: vk.Instance
    physical: vk.PhysicalDevice
    device: vk.Device
    queue: vk.Queue
    family: u32
    instanceCommands: *vk.InstanceCommands
    commands: *vk.DeviceCommands
    memory: *vk.PhysicalDeviceMemoryProperties
    deviceName: [256]u8
    // The device's Vulkan version (VK_MAKE_API_VERSION).
    apiVersion: u32
    // What the device is (a discrete or integrated GPU, or a CPU such as
    // lavapipe's).
    deviceType: vk.PhysicalDeviceType
    commandPool: vk.CommandPool
    commandBuffer: vk.CommandBuffer
    fence: vk.Fence
    // A frame was submitted with submitFrame and its fence not waited for
    // yet (finishPending does, and begin).
    pending: bool
    descriptorPool: vk.DescriptorPool
    // What buffer sharing the device supports (with wantSharing): importing
    // dma-bufs, exporting them, and importing host memory (alignment
    // `hostAlignment`).
    dmaBufImport: bool
    dmaBufExport: bool
    hostMemory: bool
    hostAlignment: u64
    // The video decode queue (with wantVideo): its family (NONE_FAMILY
    // without one), the queue, and the codecs it decodes.
    videoFamily: u32
    videoQueue: vk.Queue
    videoH264: bool
    videoH265: bool
    trace: usize
    // std.gpu.diagnostics' state (0: none): the GPU's crashes and profile.
    diagnostics: usize
}

// Reports `text` (a zero-terminated literal) to the trace function, if any.
pub fn step(context: *const Context, text: []const u8) -> void {
    if context.*.trace == 0 { return }
    var function: TraceFn = undefined
    unsafe {
        function = @ptrFromInt(TraceFn, context.*.trace)
        function(text.pointer)
    }
}

pub const Buffer = struct {
    buffer: vk.Buffer
    memory: vk.DeviceMemory
    size: u64
    // The mapping (host-visible memory), else 0.
    address: usize
    // The exported dma-buf, or -1.
    fd: i32
}

pub const Kernel = struct {
    module: vk.ShaderModule
    setLayout: vk.DescriptorSetLayout
    pipelineLayout: vk.PipelineLayout
    pipeline: vk.Pipeline
    bindings: u32
    pushBytes: u32
}

fn allocate(allocator: Allocator, size: usize) -> usize {
    const memory = allocator.alloc(size, 16)
    if memory == null { return 0 }
    return @intFromPtr(memory.?)
}

fn hasDeviceExtension(context: *Context, name: [*]const u8) -> bool {
    var count: u32 = 0
    _ = vk.enumerateDeviceExtensionProperties(context.*.instanceCommands, context.*.physical, null, &count, null)
    if count == 0 { return false }
    const memory = allocate(context.*.allocator, @intCast(usize, count) * @sizeOf(vk.ExtensionProperties))
    if memory == 0 { return false }
    const properties: [*]vk.ExtensionProperties = unsafe { @ptrFromInt([*]vk.ExtensionProperties, memory) }
    _ = vk.enumerateDeviceExtensionProperties(context.*.instanceCommands, context.*.physical, null, &count, properties)
    var index: u32 = 0
    var found = false
    while index < count {
        // extensionName is the first member.
        unsafe {
            if std.text.same(std.text.cString(@ptrFromInt([*]const u8, memory + @intCast(usize, index) * @sizeOf(vk.ExtensionProperties))), std.text.cString(name)) { found = true }
        }
        index += 1
    }
    unsafe { context.*.allocator.free(@ptrFromInt([*]u8, memory), @intCast(usize, count) * @sizeOf(vk.ExtensionProperties), 16) }
    return found
}

// The device's video decode queue family (NONE_FAMILY without one) and
// the codecs it decodes, from VK_KHR_video_queue's queue family
// properties.
fn videoFamily(context: *Context, physical: vk.PhysicalDevice, family_count: u32, h264: *bool, h265: *bool) -> u32 {
    var properties: [16]vk.QueueFamilyProperties2 = undefined
    var video: [16]vk.QueueFamilyVideoPropertiesKHR = undefined
    var index: u32 = 0
    while index < family_count {
        properties[index] = vk.QueueFamilyProperties2.init()
        video[index] = vk.QueueFamilyVideoPropertiesKHR.init()
        properties[index].pNext = &video[index]
        index += 1
    }
    var count = family_count
    step(context, "vkGetPhysicalDeviceQueueFamilyProperties2")
    vk.getPhysicalDeviceQueueFamilyProperties2(context.*.instanceCommands, physical, &count, &properties)
    index = 0
    while index < count {
        if properties[index].queueFamilyProperties.queueFlags & vk.QUEUE_VIDEO_DECODE_BIT_KHR != 0 {
            const operations = video[index].videoCodecOperations
            if operations & (vk.VIDEO_CODEC_OPERATION_DECODE_H264_BIT_KHR | vk.VIDEO_CODEC_OPERATION_DECODE_H265_BIT_KHR) != 0 {
                h264.* = operations & vk.VIDEO_CODEC_OPERATION_DECODE_H264_BIT_KHR != 0
                h265.* = operations & vk.VIDEO_CODEC_OPERATION_DECODE_H265_BIT_KHR != 0
                return index
            }
        }
        index += 1
    }
    return NONE_FAMILY
}

// Creates the instance and a device with one compute-capable queue on
// `driver` (opened with std.vulkan.loader), and the video decode queue
// when asked for.
pub fn open(context: *Context, driver: loader.Driver, options: *const Options, allocator: Allocator) -> Status {
    context.*.allocator = allocator
    context.*.driver = driver
    context.*.dmaBufImport = false
    context.*.dmaBufExport = false
    context.*.hostMemory = false
    context.*.hostAlignment = 4096
    context.*.videoFamily = NONE_FAMILY
    context.*.videoQueue = 0
    context.*.videoH264 = false
    context.*.videoH265 = false
    context.*.trace = options.*.trace
    context.*.pending = false
    context.*.diagnostics = 0
    const instance_commands = allocate(allocator, @sizeOf(vk.InstanceCommands))
    const device_commands = allocate(allocator, @sizeOf(vk.DeviceCommands))
    const memory_properties = allocate(allocator, @sizeOf(vk.PhysicalDeviceMemoryProperties))
    if instance_commands == 0 || device_commands == 0 || memory_properties == 0 { return Status.outOfMemory }
    unsafe {
        context.*.instanceCommands = @ptrFromInt(*vk.InstanceCommands, instance_commands)
        context.*.commands = @ptrFromInt(*vk.DeviceCommands, device_commands)
        context.*.memory = @ptrFromInt(*vk.PhysicalDeviceMemoryProperties, memory_properties)
    }

    var application = vk.ApplicationInfo.init()
    application.pApplicationName = options.*.applicationName
    application.apiVersion = vk.API_VERSION_1_1
    var instance_info = vk.InstanceCreateInfo.init()
    instance_info.pApplicationInfo = &application
    instance_info.enabledExtensionCount = options.*.instanceExtensionCount
    instance_info.ppEnabledExtensionNames = options.*.instanceExtensions
    var instance: vk.Instance = 0
    step(context, "vkCreateInstance")
    if vk.createInstance(driver.global, &instance_info, null, &instance) != vk.Result.success { return Status.instanceFailed }
    context.*.instance = instance
    step(context, "vkLoadInstanceCommands")
    vk.loadInstanceCommands(context.*.instanceCommands, instance, driver.getInstanceProcAddr)

    var physical_devices: [8]vk.PhysicalDevice = undefined
    var physical_count: u32 = 8
    step(context, "vkEnumeratePhysicalDevices")
    unsafe { _ = vk.enumeratePhysicalDevices(context.*.instanceCommands, instance, &physical_count, &physical_devices) }
    var chosen = false
    var device_index: u32 = 0
    while device_index < physical_count && !(chosen && (!options.*.wantVideo || context.*.videoFamily != NONE_FAMILY)) {
        var families: [16]vk.QueueFamilyProperties = undefined
        var family_count: u32 = 16
        step(context, "vkGetPhysicalDeviceQueueFamilyProperties")
        vk.getPhysicalDeviceQueueFamilyProperties(context.*.instanceCommands, physical_devices[device_index], &family_count, &families)
        var compute_family = NONE_FAMILY
        var family: u32 = 0
        while family < family_count {
            if families[family].queueFlags & vk.QUEUE_COMPUTE_BIT != 0 && compute_family == NONE_FAMILY { compute_family = family }
            family += 1
        }
        if compute_family == NONE_FAMILY {
            device_index += 1
            continue
        }
        var video_family = NONE_FAMILY
        var h264 = false
        var h265 = false
        if options.*.wantVideo { video_family = videoFamily(context, physical_devices[device_index], family_count, &h264, &h265) }
        // The first device with a compute queue, unless a later one also
        // decodes video and this one does not.
        if !chosen || (options.*.wantVideo && context.*.videoFamily == NONE_FAMILY && video_family != NONE_FAMILY) {
            context.*.physical = physical_devices[device_index]
            context.*.family = compute_family
            context.*.videoFamily = video_family
            context.*.videoH264 = h264
            context.*.videoH265 = h265
            chosen = true
        }
        device_index += 1
    }
    if !chosen { return Status.noDevice }
    step(context, "vkGetPhysicalDeviceMemoryProperties")
    vk.getPhysicalDeviceMemoryProperties(context.*.instanceCommands, context.*.physical, context.*.memory)
    var properties: vk.PhysicalDeviceProperties = undefined
    step(context, "vkGetPhysicalDeviceProperties")
    vk.getPhysicalDeviceProperties(context.*.instanceCommands, context.*.physical, &properties)
    context.*.apiVersion = properties.apiVersion
    context.*.deviceType = properties.deviceType
    var name_index: usize = 0
    while name_index < 256 {
        context.*.deviceName[name_index] = properties.deviceName[name_index]
        name_index += 1
    }
    // The device's memory, for the memory snapshots (std.diagnostics).
    const device_memory = context.*.memory
    diagnostics.gpuDevice(deviceName(context), @intCast(usize, properties.limits.maxMemoryAllocationCount), @intCast(usize, device_memory.*.memoryHeapCount), @intCast(usize, device_memory.*.memoryTypeCount))
    var heap: usize = 0
    while heap < @intCast(usize, device_memory.*.memoryHeapCount) {
        diagnostics.gpuHeap(heap, device_memory.*.memoryHeaps[heap].size, @intCast(usize, device_memory.*.memoryHeaps[heap].flags))
        heap += 1
    }
    var memory_type: usize = 0
    while memory_type < @intCast(usize, device_memory.*.memoryTypeCount) {
        diagnostics.gpuType(memory_type, @intCast(usize, device_memory.*.memoryTypes[memory_type].heapIndex), @intCast(usize, device_memory.*.memoryTypes[memory_type].propertyFlags))
        memory_type += 1
    }

    // Device extensions: the caller's, plus dma-buf sharing and video
    // decoding when wanted and supported.
    var names: [20][*]const u8 = undefined
    var name_count: u32 = 0
    var extension: u32 = 0
    while extension < options.*.deviceExtensionCount && name_count < 8 {
        names[name_count] = options.*.deviceExtensions.?[extension]
        name_count += 1
        extension += 1
    }
    if options.*.wantSharing {
        var memory_fd: [*]const u8 = undefined
        var dma_buf: [*]const u8 = undefined
        var host: [*]const u8 = undefined
        unsafe {
            memory_fd = @ptrCast([*]const u8, vk.KHR_EXTERNAL_MEMORY_FD_EXTENSION_NAME)
            dma_buf = @ptrCast([*]const u8, vk.EXT_EXTERNAL_MEMORY_DMA_BUF_EXTENSION_NAME)
            host = @ptrCast([*]const u8, vk.EXT_EXTERNAL_MEMORY_HOST_EXTENSION_NAME)
        }
        if hasDeviceExtension(context, memory_fd) && hasDeviceExtension(context, dma_buf) {
            names[name_count] = memory_fd
            names[name_count + 1] = dma_buf
            name_count += 2
            context.*.dmaBufImport = true
            context.*.dmaBufExport = canExport(context)
        }
        if hasDeviceExtension(context, host) {
            names[name_count] = host
            name_count += 1
            context.*.hostMemory = true
            var host_properties = vk.PhysicalDeviceExternalMemoryHostPropertiesEXT.init()
            var properties2 = vk.PhysicalDeviceProperties2.init()
            properties2.pNext = &host_properties
            step(context, "vkGetPhysicalDeviceProperties2")
            vk.getPhysicalDeviceProperties2(context.*.instanceCommands, context.*.physical, &properties2)
            if host_properties.minImportedHostPointerAlignment > 0 { context.*.hostAlignment = host_properties.minImportedHostPointerAlignment }
        }
    }
    var synchronization2 = vk.PhysicalDeviceSynchronization2Features.init()
    synchronization2.synchronization2 = vk.TRUE
    var device_info = vk.DeviceCreateInfo.init()
    if context.*.videoFamily != NONE_FAMILY {
        var video_queue: [*]const u8 = undefined
        var decode_queue: [*]const u8 = undefined
        var decode_h264: [*]const u8 = undefined
        var decode_h265: [*]const u8 = undefined
        var sync2: [*]const u8 = undefined
        unsafe {
            video_queue = @ptrCast([*]const u8, vk.KHR_VIDEO_QUEUE_EXTENSION_NAME)
            decode_queue = @ptrCast([*]const u8, vk.KHR_VIDEO_DECODE_QUEUE_EXTENSION_NAME)
            decode_h264 = @ptrCast([*]const u8, vk.KHR_VIDEO_DECODE_H264_EXTENSION_NAME)
            decode_h265 = @ptrCast([*]const u8, vk.KHR_VIDEO_DECODE_H265_EXTENSION_NAME)
            sync2 = @ptrCast([*]const u8, vk.KHR_SYNCHRONIZATION_2_EXTENSION_NAME)
        }
        if hasDeviceExtension(context, video_queue) && hasDeviceExtension(context, decode_queue) && (context.*.videoH264 && hasDeviceExtension(context, decode_h264) || context.*.videoH265 && hasDeviceExtension(context, decode_h265)) {
            names[name_count] = video_queue
            names[name_count + 1] = decode_queue
            name_count += 2
            if context.*.videoH264 && hasDeviceExtension(context, decode_h264) {
                names[name_count] = decode_h264
                name_count += 1
            } else {
                context.*.videoH264 = false
            }
            if context.*.videoH265 && hasDeviceExtension(context, decode_h265) {
                names[name_count] = decode_h265
                name_count += 1
            } else {
                context.*.videoH265 = false
            }
            // The video queue needs synchronization2: the feature, and the
            // extension on a device before 1.3.
            if hasDeviceExtension(context, sync2) {
                names[name_count] = sync2
                name_count += 1
            }
            device_info.pNext = &synchronization2
        } else {
            context.*.videoFamily = NONE_FAMILY
            context.*.videoH264 = false
            context.*.videoH265 = false
        }
    }
    var queue_infos: [2]vk.DeviceQueueCreateInfo = undefined
    queue_infos[0] = vk.DeviceQueueCreateInfo.init()
    queue_infos[0].queueFamilyIndex = context.*.family
    queue_infos[0].queueCount = 1
    var priority: u32 = 1065353216 // 1.0f
    unsafe { queue_infos[0].pQueuePriorities = @ptrCast([*]const f32, &priority) }
    device_info.queueCreateInfoCount = 1
    if context.*.videoFamily != NONE_FAMILY && context.*.videoFamily != context.*.family {
        queue_infos[1] = vk.DeviceQueueCreateInfo.init()
        queue_infos[1].queueFamilyIndex = context.*.videoFamily
        queue_infos[1].queueCount = 1
        unsafe { queue_infos[1].pQueuePriorities = @ptrCast([*]const f32, &priority) }
        device_info.queueCreateInfoCount = 2
    }
    device_info.pQueueCreateInfos = &queue_infos
    device_info.enabledExtensionCount = name_count
    unsafe { device_info.ppEnabledExtensionNames = @ptrCast([*]const [*]const u8, &names) }
    var device: vk.Device = 0
    step(context, "vkCreateDevice")
    if vk.createDevice(context.*.instanceCommands, context.*.physical, &device_info, null, &device) != vk.Result.success { return Status.deviceFailed }
    context.*.device = device
    step(context, "vkLoadDeviceCommands")
    vk.loadDeviceCommands(context.*.commands, device, context.*.instanceCommands.*.vkGetDeviceProcAddr)
    var queue: vk.Queue = 0
    step(context, "vkGetDeviceQueue")
    vk.getDeviceQueue(context.*.commands, device, context.*.family, 0, &queue)
    context.*.queue = queue
    if context.*.videoFamily != NONE_FAMILY {
        var video_queue: vk.Queue = 0
        step(context, "vkGetDeviceQueue (video)")
        vk.getDeviceQueue(context.*.commands, device, context.*.videoFamily, 0, &video_queue)
        context.*.videoQueue = video_queue
    }

    // One command buffer, fence and descriptor pool, reused every frame.
    var pool_info = vk.CommandPoolCreateInfo.init()
    pool_info.flags = vk.COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT
    pool_info.queueFamilyIndex = context.*.family
    var command_pool: vk.CommandPool = 0
    step(context, "vkCreateCommandPool")
    if vk.createCommandPool(context.*.commands, device, &pool_info, null, &command_pool) != vk.Result.success { return Status.deviceFailed }
    context.*.commandPool = command_pool
    var allocation = vk.CommandBufferAllocateInfo.init()
    allocation.commandPool = command_pool
    allocation.level = vk.CommandBufferLevel.primary
    allocation.commandBufferCount = 1
    var command_buffer: vk.CommandBuffer = 0
    step(context, "vkAllocateCommandBuffers")
    if vk.allocateCommandBuffers(context.*.commands, device, &allocation, &command_buffer) != vk.Result.success { return Status.deviceFailed }
    context.*.commandBuffer = command_buffer
    var fence_info = vk.FenceCreateInfo.init()
    var fence: vk.Fence = 0
    step(context, "vkCreateFence")
    if vk.createFence(context.*.commands, device, &fence_info, null, &fence) != vk.Result.success { return Status.deviceFailed }
    context.*.fence = fence
    var sizes = vk.DescriptorPoolSize.init()
    sizes.type_ = vk.DescriptorType.storageBuffer
    sizes.descriptorCount = 1024
    var descriptor_info = vk.DescriptorPoolCreateInfo.init()
    descriptor_info.maxSets = 512
    descriptor_info.poolSizeCount = 1
    descriptor_info.pPoolSizes = &sizes
    var descriptor_pool: vk.DescriptorPool = 0
    step(context, "vkCreateDescriptorPool")
    if vk.createDescriptorPool(context.*.commands, device, &descriptor_info, null, &descriptor_pool) != vk.Result.success { return Status.deviceFailed }
    context.*.descriptorPool = descriptor_pool
    gpu_diagnostics.open(context)
    return Status.ok
}

// Whether storage buffers can be exported as dma-bufs (drivers without a
// dma-buf exporter, such as lavapipe without /dev/udmabuf, only import).
fn canExport(context: *Context) -> bool {
    var info = vk.PhysicalDeviceExternalBufferInfo.init()
    info.usage = vk.BUFFER_USAGE_STORAGE_BUFFER_BIT | vk.BUFFER_USAGE_TRANSFER_SRC_BIT | vk.BUFFER_USAGE_TRANSFER_DST_BIT
    info.handleType = vk.EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT
    var properties = vk.ExternalBufferProperties.init()
    step(context, "vkGetPhysicalDeviceExternalBufferProperties")
    vk.getPhysicalDeviceExternalBufferProperties(context.*.instanceCommands, context.*.physical, &info, &properties)
    return properties.externalMemoryProperties.externalMemoryFeatures & vk.EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT != 0
}

pub fn deviceName(context: *const Context) -> [*]const u8 {
    return &context.*.deviceName
}

// A block of device memory allocated: noted for the memory snapshots, with
// what was asked and what the device took.
fn noted(memory: vk.DeviceMemory, asked: u64, size: u64, memory_type: u32, kind: usize) -> void {
    diagnostics.gpuAllocated(memory, asked, size, @intCast(usize, memory_type), kind)
}

fn memoryType(context: *const Context, bits: u32, wanted: vk.MemoryPropertyFlags) -> u32 {
    var index: u32 = 0
    while index < context.*.memory.*.memoryTypeCount {
        if bits & (@intCast(u32, 1) << @intCast(u5, index)) != 0 && context.*.memory.*.memoryTypes[index].propertyFlags & wanted == wanted { return index }
        index += 1
    }
    return 4294967295
}

// A host-visible, coherent storage buffer of `size` bytes, mapped at
// `result.address`; exported as a dma-buf (`result.fd`) when `shareable` is
// set and the context supports it.
pub fn createBuffer(context: *Context, result: *Buffer, size: u64, shareable: bool) -> bool {
    const shared = shareable && context.*.dmaBufExport
    result.*.buffer = 0
    result.*.memory = 0
    result.*.size = size
    result.*.address = 0
    result.*.fd = -1
    var external = vk.ExternalMemoryBufferCreateInfo.init()
    external.handleTypes = vk.EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT
    var info = vk.BufferCreateInfo.init()
    info.size = size
    info.usage = vk.BUFFER_USAGE_STORAGE_BUFFER_BIT | vk.BUFFER_USAGE_TRANSFER_SRC_BIT | vk.BUFFER_USAGE_TRANSFER_DST_BIT
    info.sharingMode = vk.SharingMode.exclusive
    if shared { info.pNext = &external }
    var buffer: vk.Buffer = 0
    step(context, "vkCreateBuffer")
    if vk.createBuffer(context.*.commands, context.*.device, &info, null, &buffer) != vk.Result.success { return false }
    result.*.buffer = buffer
    var requirements: vk.MemoryRequirements = undefined
    step(context, "vkGetBufferMemoryRequirements")
    vk.getBufferMemoryRequirements(context.*.commands, context.*.device, buffer, &requirements)
    // Exported memory is a dedicated allocation (drivers such as lavapipe
    // require it for dma-bufs).
    var dedicated = vk.MemoryDedicatedAllocateInfo.init()
    dedicated.buffer = buffer
    var export_info = vk.ExportMemoryAllocateInfo.init()
    export_info.handleTypes = vk.EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT
    export_info.pNext = &dedicated
    var allocation = vk.MemoryAllocateInfo.init()
    allocation.allocationSize = requirements.size
    allocation.memoryTypeIndex = memoryType(context, requirements.memoryTypeBits, vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT)
    if allocation.memoryTypeIndex == 4294967295 { return false }
    if shared { allocation.pNext = &export_info }
    var memory: vk.DeviceMemory = 0
    step(context, "vkAllocateMemory")
    if vk.allocateMemory(context.*.commands, context.*.device, &allocation, null, &memory) != vk.Result.success { return false }
    result.*.memory = memory
    noted(memory, size, requirements.size, allocation.memoryTypeIndex, if shared { diagnostics.GPU_EXPORT } else { diagnostics.GPU_BUFFER })
    step(context, "vkBindBufferMemory")
    if vk.bindBufferMemory(context.*.commands, context.*.device, buffer, memory, 0) != vk.Result.success { return false }
    var mapped: ?*anyopaque = null
    step(context, "vkMapMemory")
    if vk.mapMemory(context.*.commands, context.*.device, memory, 0, vk.WHOLE_SIZE, 0, &mapped) != vk.Result.success { return false }
    result.*.address = @intFromPtr(mapped.?)
    if shared {
        var get = vk.MemoryGetFdInfoKHR.init()
        get.memory = memory
        get.handleType = vk.EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT
        var fd: i32 = -1
        step(context, "vkGetMemoryFdKHR")
        if vk.getMemoryFdKHR(context.*.commands, context.*.device, &get, &fd) != vk.Result.success { return false }
        result.*.fd = fd
    }
    return true
}

// A storage buffer in memory with the `preferred` properties when the
// device has such memory and can spare it, else in any memory with the
// `required` ones; mapped at `result.address` when that memory is host
// visible (0 otherwise). Discrete GPUs list system memory first among the
// host-visible types, so buffers the GPU reads every frame ask for device
// memory here.
pub fn createBufferIn(context: *Context, result: *Buffer, size: u64, preferred: vk.MemoryPropertyFlags, required: vk.MemoryPropertyFlags) -> bool {
    result.*.buffer = 0
    result.*.memory = 0
    result.*.size = size
    result.*.address = 0
    result.*.fd = -1
    var info = vk.BufferCreateInfo.init()
    info.size = size
    info.usage = vk.BUFFER_USAGE_STORAGE_BUFFER_BIT | vk.BUFFER_USAGE_TRANSFER_SRC_BIT | vk.BUFFER_USAGE_TRANSFER_DST_BIT
    info.sharingMode = vk.SharingMode.exclusive
    var buffer: vk.Buffer = 0
    if vk.createBuffer(context.*.commands, context.*.device, &info, null, &buffer) != vk.Result.success { return false }
    result.*.buffer = buffer
    var requirements: vk.MemoryRequirements = undefined
    vk.getBufferMemoryRequirements(context.*.commands, context.*.device, buffer, &requirements)
    var allocation = vk.MemoryAllocateInfo.init()
    allocation.allocationSize = requirements.size
    var memory: vk.DeviceMemory = 0
    var chosen = memoryType(context, requirements.memoryTypeBits, preferred)
    if chosen != 4294967295 {
        allocation.memoryTypeIndex = chosen
        if vk.allocateMemory(context.*.commands, context.*.device, &allocation, null, &memory) != vk.Result.success { memory = 0 }
    }
    if memory == 0 {
        chosen = memoryType(context, requirements.memoryTypeBits, required)
        if chosen == 4294967295 { return false }
        allocation.memoryTypeIndex = chosen
        if vk.allocateMemory(context.*.commands, context.*.device, &allocation, null, &memory) != vk.Result.success { return false }
    }
    result.*.memory = memory
    noted(memory, size, requirements.size, chosen, diagnostics.GPU_BUFFER)
    if vk.bindBufferMemory(context.*.commands, context.*.device, buffer, memory, 0) != vk.Result.success { return false }
    if context.*.memory.*.memoryTypes[chosen].propertyFlags & vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT != 0 {
        var mapped: ?*anyopaque = null
        if vk.mapMemory(context.*.commands, context.*.device, memory, 0, vk.WHOLE_SIZE, 0, &mapped) != vk.Result.success { return false }
        result.*.address = @intFromPtr(mapped.?)
    }
    return true
}

// A buffer in device memory exported as a dma-buf (`result.fd`, owned by
// the caller), for another device driver to use in place: a monitor's
// framebuffer, scanned out straight from what the GPU rendered. Not
// mapped. False when the device cannot export.
pub fn createExportBuffer(context: *Context, result: *Buffer, size: u64) -> bool {
    return createExportBufferIn(context, result, size, vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT, 0)
}

// createExportBuffer in memory with the `preferred` properties when the
// device has such memory, else with the `fallback` ones (a client's
// buffers the compositor maps: device memory the CPU can reach).
pub fn createExportBufferIn(context: *Context, result: *Buffer, size: u64, preferred: vk.MemoryPropertyFlags, fallback: vk.MemoryPropertyFlags) -> bool {
    result.*.buffer = 0
    result.*.memory = 0
    result.*.size = size
    result.*.address = 0
    result.*.fd = -1
    if !context.*.dmaBufExport { return false }
    var external = vk.ExternalMemoryBufferCreateInfo.init()
    external.handleTypes = vk.EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT
    var info = vk.BufferCreateInfo.init()
    info.pNext = &external
    info.size = size
    info.usage = vk.BUFFER_USAGE_STORAGE_BUFFER_BIT | vk.BUFFER_USAGE_TRANSFER_SRC_BIT | vk.BUFFER_USAGE_TRANSFER_DST_BIT
    info.sharingMode = vk.SharingMode.exclusive
    var buffer: vk.Buffer = 0
    if vk.createBuffer(context.*.commands, context.*.device, &info, null, &buffer) != vk.Result.success { return false }
    result.*.buffer = buffer
    var requirements: vk.MemoryRequirements = undefined
    vk.getBufferMemoryRequirements(context.*.commands, context.*.device, buffer, &requirements)
    var dedicated = vk.MemoryDedicatedAllocateInfo.init()
    dedicated.buffer = buffer
    var export_info = vk.ExportMemoryAllocateInfo.init()
    export_info.handleTypes = vk.EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT
    export_info.pNext = &dedicated
    var allocation = vk.MemoryAllocateInfo.init()
    allocation.pNext = &export_info
    allocation.allocationSize = requirements.size
    var memory: vk.DeviceMemory = 0
    allocation.memoryTypeIndex = memoryType(context, requirements.memoryTypeBits, preferred)
    if allocation.memoryTypeIndex != 4294967295 {
        if vk.allocateMemory(context.*.commands, context.*.device, &allocation, null, &memory) != vk.Result.success { memory = 0 }
    }
    if memory == 0 {
        allocation.memoryTypeIndex = memoryType(context, requirements.memoryTypeBits, fallback)
        if allocation.memoryTypeIndex == 4294967295 { return false }
        if vk.allocateMemory(context.*.commands, context.*.device, &allocation, null, &memory) != vk.Result.success { return false }
    }
    result.*.memory = memory
    noted(memory, size, requirements.size, allocation.memoryTypeIndex, diagnostics.GPU_EXPORT)
    if vk.bindBufferMemory(context.*.commands, context.*.device, buffer, memory, 0) != vk.Result.success { return false }
    var get = vk.MemoryGetFdInfoKHR.init()
    get.memory = memory
    get.handleType = vk.EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT
    var fd: i32 = -1
    if vk.getMemoryFdKHR(context.*.commands, context.*.device, &get, &fd) != vk.Result.success { return false }
    result.*.fd = fd
    return true
}

// A buffer the CPU writes and the GPU reads every frame (a background, a
// client's pixels): device memory the CPU can write when there is room,
// else host-visible system memory. Mapped at `result.address`.
pub fn createUploadBuffer(context: *Context, result: *Buffer, size: u64) -> bool {
    const visible = vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT
    return createBufferIn(context, result, size, visible | vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT, visible)
}

// A buffer only the GPU uses (a render target, scratch): device memory,
// else whatever the device has. Not necessarily mapped.
pub fn createDeviceBuffer(context: *Context, result: *Buffer, size: u64) -> bool {
    return createBufferIn(context, result, size, vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT, 0)
}

// Records copies of a `width` x `height` block at (x, y) of a frame (rows
// `stride` pixels apart, starting `offset` pixels into both buffers) from
// `source` to the same place in `target`, then makes them visible to the
// host.
pub fn copyBlock(context: *Context, source: vk.Buffer, target: vk.Buffer, offset: u64, stride: u64, x: u64, y: u64, width: u64, height: u64) -> void {
    if width == 0 || height == 0 { return }
    gpu_diagnostics.passStart(context, gpu_diagnostics.COPY)
    const commands = context.*.commandBuffer
    var regions: [32]vk.BufferCopy = undefined
    var count: u32 = 0
    if x == 0 && width == stride {
        // Whole rows: one block.
        var region = vk.BufferCopy.init()
        region.srcOffset = (offset + y * stride) * 4
        region.dstOffset = region.srcOffset
        region.size = width * height * 4
        regions[0] = region
        count = 1
    } else {
        var row: u64 = 0
        while row < height {
            var region = vk.BufferCopy.init()
            region.srcOffset = (offset + (y + row) * stride + x) * 4
            region.dstOffset = region.srcOffset
            region.size = width * 4
            regions[count] = region
            count += 1
            row += 1
            if count == 32 || row == height {
                vk.cmdCopyBuffer(context.*.commands, commands, source, target, count, &regions)
                count = 0
            }
        }
    }
    if count > 0 {
        vk.cmdCopyBuffer(context.*.commands, commands, source, target, count, &regions)
    }
    var barrier = vk.MemoryBarrier.init()
    barrier.srcAccessMask = vk.ACCESS_TRANSFER_WRITE_BIT
    barrier.dstAccessMask = vk.ACCESS_HOST_READ_BIT
    vk.cmdPipelineBarrier(context.*.commands, commands, vk.PIPELINE_STAGE_TRANSFER_BIT, vk.PIPELINE_STAGE_HOST_BIT, 0, 1, &barrier, 0, null, 0, null)
    gpu_diagnostics.passEnd(context)
}

// Records zeroing the first `size` bytes of `buffer` (a multiple of 4),
// seen by the compute shaders that follow.
pub fn fillZero(context: *Context, buffer: vk.Buffer, size: u64) -> void {
    gpu_diagnostics.passStart(context, gpu_diagnostics.FILL)
    const commands = context.*.commandBuffer
    vk.cmdFillBuffer(context.*.commands, commands, buffer, 0, size, 0)
    var barrier = vk.MemoryBarrier.init()
    barrier.srcAccessMask = vk.ACCESS_TRANSFER_WRITE_BIT
    barrier.dstAccessMask = vk.ACCESS_SHADER_READ_BIT | vk.ACCESS_SHADER_WRITE_BIT
    vk.cmdPipelineBarrier(context.*.commands, commands, vk.PIPELINE_STAGE_TRANSFER_BIT, vk.PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &barrier, 0, null, 0, null)
    gpu_diagnostics.passEnd(context)
}

// A host-visible storage buffer the CPU reads back from (cached memory
// when the device has it: reading write-combined memory is slow), mapped
// at `result.address`.
pub fn createReadbackBuffer(context: *Context, result: *Buffer, size: u64) -> bool {
    result.*.buffer = 0
    result.*.memory = 0
    result.*.size = size
    result.*.address = 0
    result.*.fd = -1
    var info = vk.BufferCreateInfo.init()
    info.size = size
    info.usage = vk.BUFFER_USAGE_STORAGE_BUFFER_BIT | vk.BUFFER_USAGE_TRANSFER_SRC_BIT | vk.BUFFER_USAGE_TRANSFER_DST_BIT
    info.sharingMode = vk.SharingMode.exclusive
    var buffer: vk.Buffer = 0
    if vk.createBuffer(context.*.commands, context.*.device, &info, null, &buffer) != vk.Result.success { return false }
    result.*.buffer = buffer
    var requirements: vk.MemoryRequirements = undefined
    vk.getBufferMemoryRequirements(context.*.commands, context.*.device, buffer, &requirements)
    var allocation = vk.MemoryAllocateInfo.init()
    allocation.allocationSize = requirements.size
    const visible = vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT
    allocation.memoryTypeIndex = memoryType(context, requirements.memoryTypeBits, visible | vk.MEMORY_PROPERTY_HOST_CACHED_BIT)
    if allocation.memoryTypeIndex == 4294967295 { allocation.memoryTypeIndex = memoryType(context, requirements.memoryTypeBits, visible) }
    if allocation.memoryTypeIndex == 4294967295 { return false }
    var memory: vk.DeviceMemory = 0
    if vk.allocateMemory(context.*.commands, context.*.device, &allocation, null, &memory) != vk.Result.success { return false }
    result.*.memory = memory
    noted(memory, size, requirements.size, allocation.memoryTypeIndex, diagnostics.GPU_BUFFER)
    if vk.bindBufferMemory(context.*.commands, context.*.device, buffer, memory, 0) != vk.Result.success { return false }
    var mapped: ?*anyopaque = null
    if vk.mapMemory(context.*.commands, context.*.device, memory, 0, vk.WHOLE_SIZE, 0, &mapped) != vk.Result.success { return false }
    result.*.address = @intFromPtr(mapped.?)
    return true
}

// A storage buffer over `size` bytes of another process's dma-buf. Vulkan
// takes ownership of `fd` on success (pass a duplicate to keep yours).
pub fn importBuffer(context: *Context, result: *Buffer, fd: i32, size: u64) -> bool {
    return importBufferStep(context, result, fd, size) == IMPORT_DONE
}

// What importBufferStep got to: IMPORT_DONE, or the step that failed.
pub const IMPORT_DONE: u32 = 0
pub const IMPORT_UNSUPPORTED: u32 = 1
pub const IMPORT_CREATE_BUFFER: u32 = 2
pub const IMPORT_FD_PROPERTIES: u32 = 3
pub const IMPORT_MEMORY_TYPE: u32 = 4
pub const IMPORT_ALLOCATE: u32 = 5
pub const IMPORT_BIND: u32 = 6
pub const IMPORT_CREATE_IMAGE: u32 = 7

// The step, for a log line.
pub fn importStepName(step: u32) -> []const u8 {
    if step == IMPORT_DONE { return "done" }
    if step == IMPORT_UNSUPPORTED { return "the driver has no VK_EXT_external_memory_dma_buf" }
    if step == IMPORT_CREATE_BUFFER { return "vkCreateBuffer failed" }
    if step == IMPORT_FD_PROPERTIES { return "vkGetMemoryFdPropertiesKHR refused the dma-buf" }
    if step == IMPORT_MEMORY_TYPE { return "no memory type fits both the buffer and the dma-buf" }
    if step == IMPORT_ALLOCATE { return "vkAllocateMemory refused the dma-buf" }
    if step == IMPORT_BIND { return "vkBindBufferMemory failed" }
    if step == IMPORT_CREATE_IMAGE { return "vkCreateImage failed for a dma-buf image" }
    return "unknown step"
}

// importBuffer, saying which step failed (IMPORT_*), so a log can tell a
// driver without dma-buf import from one refusing this buffer.
pub fn importBufferStep(context: *Context, result: *Buffer, fd: i32, size: u64) -> u32 {
    result.*.buffer = 0
    result.*.memory = 0
    result.*.size = size
    result.*.address = 0
    result.*.fd = -1
    if !context.*.dmaBufImport { return IMPORT_UNSUPPORTED }
    var external = vk.ExternalMemoryBufferCreateInfo.init()
    external.handleTypes = vk.EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT
    var info = vk.BufferCreateInfo.init()
    info.pNext = &external
    info.size = size
    info.usage = vk.BUFFER_USAGE_STORAGE_BUFFER_BIT | vk.BUFFER_USAGE_TRANSFER_SRC_BIT
    info.sharingMode = vk.SharingMode.exclusive
    var buffer: vk.Buffer = 0
    if vk.createBuffer(context.*.commands, context.*.device, &info, null, &buffer) != vk.Result.success { return IMPORT_CREATE_BUFFER }
    result.*.buffer = buffer
    var requirements: vk.MemoryRequirements = undefined
    vk.getBufferMemoryRequirements(context.*.commands, context.*.device, buffer, &requirements)
    var fd_properties = vk.MemoryFdPropertiesKHR.init()
    if vk.getMemoryFdPropertiesKHR(context.*.commands, context.*.device, vk.EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT, fd, &fd_properties) != vk.Result.success { return IMPORT_FD_PROPERTIES }
    var import_info = vk.ImportMemoryFdInfoKHR.init()
    import_info.handleType = vk.EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT
    import_info.fd = fd
    var allocation = vk.MemoryAllocateInfo.init()
    allocation.pNext = &import_info
    allocation.allocationSize = requirements.size
    // Some drivers report no types for a dma-buf they can import anyway.
    const importable = if fd_properties.memoryTypeBits != 0 { fd_properties.memoryTypeBits } else { 4294967295 }
    allocation.memoryTypeIndex = memoryType(context, requirements.memoryTypeBits & importable, 0)
    if allocation.memoryTypeIndex == 4294967295 { return IMPORT_MEMORY_TYPE }
    var memory: vk.DeviceMemory = 0
    if vk.allocateMemory(context.*.commands, context.*.device, &allocation, null, &memory) != vk.Result.success { return IMPORT_ALLOCATE }
    result.*.memory = memory
    noted(memory, size, requirements.size, allocation.memoryTypeIndex, diagnostics.GPU_IMPORT)
    if vk.bindBufferMemory(context.*.commands, context.*.device, buffer, memory, 0) != vk.Result.success { return IMPORT_BIND }
    return IMPORT_DONE
}

// A dma-buf in the layout its driver picks for it by itself (no explicit
// modifier: DRM_FORMAT_MOD_INVALID), typically tiled: radeonsi before GFX9
// (Polaris and older) knows no modifiers and allocates window buffers this
// way. Imported as a B8G8R8A8 image with a dedicated allocation, which lets
// the driver take the real layout from the buffer's metadata (RADV reads
// radeonsi's). copyImage copies it into a buffer, pixels in rows.
pub const Image = struct {
    image: vk.Image
    memory: vk.DeviceMemory
    width: u32
    height: u32
}

// Imports `fd` (a dma-buf of `width` x `height` BGRA pixels) as an image;
// IMPORT_DONE or the step that failed. Vulkan takes ownership of `fd` on
// success.
pub fn importImageStep(context: *Context, result: *Image, fd: i32, width: u32, height: u32) -> u32 {
    result.*.image = 0
    result.*.memory = 0
    result.*.width = width
    result.*.height = height
    if !context.*.dmaBufImport { return IMPORT_UNSUPPORTED }
    var external = vk.ExternalMemoryImageCreateInfo.init()
    external.handleTypes = vk.EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT
    var info = vk.ImageCreateInfo.init()
    info.pNext = &external
    info.imageType = vk.ImageType.type2d
    info.format = vk.Format.b8g8r8a8Unorm
    info.extent.width = width
    info.extent.height = height
    info.extent.depth = 1
    info.mipLevels = 1
    info.arrayLayers = 1
    info.samples = vk.SAMPLE_COUNT_1_BIT
    info.tiling = vk.ImageTiling.optimal
    info.usage = vk.IMAGE_USAGE_TRANSFER_SRC_BIT
    info.sharingMode = vk.SharingMode.exclusive
    info.initialLayout = vk.ImageLayout.undefined_
    var image: vk.Image = 0
    if vk.createImage(context.*.commands, context.*.device, &info, null, &image) != vk.Result.success { return IMPORT_CREATE_IMAGE }
    result.*.image = image
    var requirements: vk.MemoryRequirements = undefined
    vk.getImageMemoryRequirements(context.*.commands, context.*.device, image, &requirements)
    var fd_properties = vk.MemoryFdPropertiesKHR.init()
    if vk.getMemoryFdPropertiesKHR(context.*.commands, context.*.device, vk.EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT, fd, &fd_properties) != vk.Result.success { return IMPORT_FD_PROPERTIES }
    var dedicated = vk.MemoryDedicatedAllocateInfo.init()
    dedicated.image = image
    var import_info = vk.ImportMemoryFdInfoKHR.init()
    import_info.pNext = &dedicated
    import_info.handleType = vk.EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT
    import_info.fd = fd
    var allocation = vk.MemoryAllocateInfo.init()
    allocation.pNext = &import_info
    allocation.allocationSize = requirements.size
    const importable = if fd_properties.memoryTypeBits != 0 { fd_properties.memoryTypeBits } else { 4294967295 }
    allocation.memoryTypeIndex = memoryType(context, requirements.memoryTypeBits & importable, 0)
    if allocation.memoryTypeIndex == 4294967295 { return IMPORT_MEMORY_TYPE }
    var memory: vk.DeviceMemory = 0
    if vk.allocateMemory(context.*.commands, context.*.device, &allocation, null, &memory) != vk.Result.success { return IMPORT_ALLOCATE }
    result.*.memory = memory
    noted(memory, @intCast(u64, width) * @intCast(u64, height) * 4, requirements.size, allocation.memoryTypeIndex, diagnostics.GPU_IMPORT)
    if vk.bindImageMemory(context.*.commands, context.*.device, image, memory, 0) != vk.Result.success { return IMPORT_BIND }
    return IMPORT_DONE
}

pub fn destroyImage(context: *Context, image: *Image) -> void {
    if image.*.image != 0 { vk.destroyImage(context.*.commands, context.*.device, image.*.image, null) }
    if image.*.memory != 0 {
        diagnostics.gpuFreed(image.*.memory)
        vk.freeMemory(context.*.commands, context.*.device, image.*.memory, null)
    }
    image.*.image = 0
    image.*.memory = 0
}

// Records a copy of the whole image into `target` (rows of width pixels,
// no gaps), made visible to the compute shaders that follow. The producer's
// rendering is waited for by the kernel (implicit sync of shared buffers).
// The image stays in the GENERAL layout: a transition from UNDEFINED could
// make the driver reset compression metadata of memory another process
// owns.
pub fn copyImage(context: *Context, image: *const Image, target: vk.Buffer) -> void {
    gpu_diagnostics.passStart(context, gpu_diagnostics.IMAGE)
    const commands = context.*.commandBuffer
    var region = vk.BufferImageCopy.init()
    region.imageSubresource.aspectMask = vk.IMAGE_ASPECT_COLOR_BIT
    region.imageSubresource.layerCount = 1
    region.imageExtent.width = image.*.width
    region.imageExtent.height = image.*.height
    region.imageExtent.depth = 1
    vk.cmdCopyImageToBuffer(context.*.commands, commands, image.*.image, vk.ImageLayout.general, target, 1, &region)
    var barrier = vk.MemoryBarrier.init()
    barrier.srcAccessMask = vk.ACCESS_TRANSFER_WRITE_BIT
    barrier.dstAccessMask = vk.ACCESS_SHADER_READ_BIT
    vk.cmdPipelineBarrier(context.*.commands, commands, vk.PIPELINE_STAGE_TRANSFER_BIT, vk.PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &barrier, 0, null, 0, null)
    gpu_diagnostics.passEnd(context)
}

// A storage buffer over `size` bytes of this process's memory at `address`
// (VK_EXT_external_memory_host): the GPU reads and writes it in place, so a
// wl_shm pool can be rendered into or composited from without copies.
// `address` and `size` must be multiples of `context.hostAlignment`.
pub fn importHostMemory(context: *Context, result: *Buffer, address: usize, size: u64) -> bool {
    result.*.buffer = 0
    result.*.memory = 0
    result.*.size = size
    result.*.address = 0
    result.*.fd = -1
    if !context.*.hostMemory || address % context.*.hostAlignment != 0 || size % context.*.hostAlignment != 0 { return false }
    var external = vk.ExternalMemoryBufferCreateInfo.init()
    external.handleTypes = vk.EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT
    var info = vk.BufferCreateInfo.init()
    info.pNext = &external
    info.size = size
    info.usage = vk.BUFFER_USAGE_STORAGE_BUFFER_BIT | vk.BUFFER_USAGE_TRANSFER_SRC_BIT | vk.BUFFER_USAGE_TRANSFER_DST_BIT
    info.sharingMode = vk.SharingMode.exclusive
    var buffer: vk.Buffer = 0
    if vk.createBuffer(context.*.commands, context.*.device, &info, null, &buffer) != vk.Result.success { return false }
    result.*.buffer = buffer
    var requirements: vk.MemoryRequirements = undefined
    vk.getBufferMemoryRequirements(context.*.commands, context.*.device, buffer, &requirements)
    var pointer_properties = vk.MemoryHostPointerPropertiesEXT.init()
    const host: *const anyopaque = unsafe { @ptrFromInt(*const anyopaque, address) }
    if vk.getMemoryHostPointerPropertiesEXT(context.*.commands, context.*.device, vk.EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT, host, &pointer_properties) != vk.Result.success { return false }
    const importable = if pointer_properties.memoryTypeBits != 0 { pointer_properties.memoryTypeBits } else { 4294967295 }
    var import_info = vk.ImportMemoryHostPointerInfoEXT.init()
    import_info.handleType = vk.EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT
    unsafe { import_info.pHostPointer = @ptrFromInt(*anyopaque, address) }
    var allocation = vk.MemoryAllocateInfo.init()
    allocation.pNext = &import_info
    allocation.allocationSize = size
    allocation.memoryTypeIndex = memoryType(context, requirements.memoryTypeBits & importable, vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT)
    if allocation.memoryTypeIndex == 4294967295 { return false }
    var memory: vk.DeviceMemory = 0
    if vk.allocateMemory(context.*.commands, context.*.device, &allocation, null, &memory) != vk.Result.success { return false }
    result.*.memory = memory
    noted(memory, size, size, allocation.memoryTypeIndex, diagnostics.GPU_HOST)
    if vk.bindBufferMemory(context.*.commands, context.*.device, buffer, memory, 0) != vk.Result.success { return false }
    // Not mapped through Vulkan: the caller owns the memory.
    return true
}

pub fn destroyBuffer(context: *Context, buffer: *Buffer) -> void {
    if buffer.*.address != 0 { vk.unmapMemory(context.*.commands, context.*.device, buffer.*.memory) }
    if buffer.*.buffer != 0 { vk.destroyBuffer(context.*.commands, context.*.device, buffer.*.buffer, null) }
    if buffer.*.memory != 0 {
        diagnostics.gpuFreed(buffer.*.memory)
        vk.freeMemory(context.*.commands, context.*.device, buffer.*.memory, null)
    }
    buffer.*.buffer = 0
    buffer.*.memory = 0
    buffer.*.address = 0
}

// A compute pipeline from SPIR-V `code` with `bindings` storage buffers
// (set 0, bindings 0..) and `push_words` u32 push constants.
pub fn createKernel(context: *Context, kernel: *Kernel, code: [*]const u32, words: usize, bindings: u32, push_words: u32) -> bool {
    kernel.*.bindings = bindings
    kernel.*.pushBytes = push_words * 4
    var module_info = vk.ShaderModuleCreateInfo.init()
    module_info.codeSize = words * 4
    module_info.pCode = code
    var module: vk.ShaderModule = 0
    step(context, "vkCreateShaderModule")
    if vk.createShaderModule(context.*.commands, context.*.device, &module_info, null, &module) != vk.Result.success { return false }
    kernel.*.module = module
    var layout_bindings: [4]vk.DescriptorSetLayoutBinding = undefined
    var index: u32 = 0
    while index < bindings {
        var binding = vk.DescriptorSetLayoutBinding.init()
        binding.binding = index
        binding.descriptorType = vk.DescriptorType.storageBuffer
        binding.descriptorCount = 1
        binding.stageFlags = vk.SHADER_STAGE_COMPUTE_BIT
        layout_bindings[index] = binding
        index += 1
    }
    var layout_info = vk.DescriptorSetLayoutCreateInfo.init()
    layout_info.bindingCount = bindings
    layout_info.pBindings = &layout_bindings
    var set_layout: vk.DescriptorSetLayout = 0
    step(context, "vkCreateDescriptorSetLayout")
    if vk.createDescriptorSetLayout(context.*.commands, context.*.device, &layout_info, null, &set_layout) != vk.Result.success { return false }
    kernel.*.setLayout = set_layout
    var range = vk.PushConstantRange.init()
    range.stageFlags = vk.SHADER_STAGE_COMPUTE_BIT
    range.offset = 0
    range.size = push_words * 4
    var pipeline_layout_info = vk.PipelineLayoutCreateInfo.init()
    pipeline_layout_info.setLayoutCount = 1
    pipeline_layout_info.pSetLayouts = &set_layout
    pipeline_layout_info.pushConstantRangeCount = 1
    pipeline_layout_info.pPushConstantRanges = &range
    var pipeline_layout: vk.PipelineLayout = 0
    step(context, "vkCreatePipelineLayout")
    if vk.createPipelineLayout(context.*.commands, context.*.device, &pipeline_layout_info, null, &pipeline_layout) != vk.Result.success { return false }
    kernel.*.pipelineLayout = pipeline_layout
    var pipeline_info = vk.ComputePipelineCreateInfo.init()
    pipeline_info.stage = vk.PipelineShaderStageCreateInfo.init()
    pipeline_info.stage.stage = vk.SHADER_STAGE_COMPUTE_BIT
    pipeline_info.stage.module = module
    unsafe { pipeline_info.stage.pName = @ptrCast([*]const u8, "main") }
    pipeline_info.layout = pipeline_layout
    var pipeline: vk.Pipeline = 0
    step(context, "vkCreateComputePipelines")
    if vk.createComputePipelines(context.*.commands, context.*.device, 0, 1, &pipeline_info, null, &pipeline) != vk.Result.success { return false }
    kernel.*.pipeline = pipeline
    return true
}

// Starts recording a frame.
pub fn begin(context: *Context) -> bool {
    if !finishPending(context) { return false }
    if vk.resetDescriptorPool(context.*.commands, context.*.device, context.*.descriptorPool, 0) != vk.Result.success { return false }
    if vk.resetCommandBuffer(context.*.commands, context.*.commandBuffer, 0) != vk.Result.success { return false }
    var info = vk.CommandBufferBeginInfo.init()
    info.flags = vk.COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT
    if vk.beginCommandBuffer(context.*.commands, context.*.commandBuffer, &info) != vk.Result.success { return false }
    gpu_diagnostics.beginFrame(context)
    return true
}

// Records `kernel` over `groups_x` x `groups_y` work groups with
// `buffers[0 .. kernel.bindings]` bound and `push` as push constants,
// followed by a barrier so the next dispatch (or the host) sees its writes.
pub fn dispatch(context: *Context, kernel: *const Kernel, buffers: [*]const vk.Buffer, push: *const anyopaque, groups_x: u32, groups_y: u32) -> bool {
    var set_layout = kernel.*.setLayout
    var allocation = vk.DescriptorSetAllocateInfo.init()
    allocation.descriptorPool = context.*.descriptorPool
    allocation.descriptorSetCount = 1
    allocation.pSetLayouts = &set_layout
    var set: vk.DescriptorSet = 0
    if vk.allocateDescriptorSets(context.*.commands, context.*.device, &allocation, &set) != vk.Result.success { return false }
    var infos: [4]vk.DescriptorBufferInfo = undefined
    var writes: [4]vk.WriteDescriptorSet = undefined
    var index: u32 = 0
    while index < kernel.*.bindings {
        var info = vk.DescriptorBufferInfo.init()
        info.buffer = buffers[index]
        info.offset = 0
        info.range = vk.WHOLE_SIZE
        infos[index] = info
        index += 1
    }
    index = 0
    while index < kernel.*.bindings {
        var write = vk.WriteDescriptorSet.init()
        write.dstSet = set
        write.dstBinding = index
        write.descriptorCount = 1
        write.descriptorType = vk.DescriptorType.storageBuffer
        unsafe { write.pBufferInfo = @ptrFromInt(*const vk.DescriptorBufferInfo, @intFromPtr(&infos) + @intCast(usize, index) * @sizeOf(vk.DescriptorBufferInfo)) }
        writes[index] = write
        index += 1
    }
    vk.updateDescriptorSets(context.*.commands, context.*.device, kernel.*.bindings, &writes, 0, null)
    gpu_diagnostics.passStart(context, gpu_diagnostics.DISPATCH)
    const commands = context.*.commandBuffer
    vk.cmdBindPipeline(context.*.commands, commands, vk.PipelineBindPoint.compute, kernel.*.pipeline)
    vk.cmdBindDescriptorSets(context.*.commands, commands, vk.PipelineBindPoint.compute, kernel.*.pipelineLayout, 0, 1, &set, 0, null)
    vk.cmdPushConstants(context.*.commands, commands, kernel.*.pipelineLayout, vk.SHADER_STAGE_COMPUTE_BIT, 0, kernel.*.pushBytes, push)
    vk.cmdDispatch(context.*.commands, commands, groups_x, groups_y, 1)
    var barrier = vk.MemoryBarrier.init()
    barrier.srcAccessMask = vk.ACCESS_SHADER_WRITE_BIT
    barrier.dstAccessMask = vk.ACCESS_SHADER_READ_BIT | vk.ACCESS_SHADER_WRITE_BIT | vk.ACCESS_HOST_READ_BIT | vk.ACCESS_TRANSFER_READ_BIT
    vk.cmdPipelineBarrier(context.*.commands, commands, vk.PIPELINE_STAGE_COMPUTE_SHADER_BIT, vk.PIPELINE_STAGE_COMPUTE_SHADER_BIT | vk.PIPELINE_STAGE_HOST_BIT | vk.PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &barrier, 0, null, 0, null)
    gpu_diagnostics.passEnd(context)
    return true
}

// Ends the frame, submits it and waits for it (waiting on `wait` and
// signalling `signal` when they are not 0: swapchain semaphores).
pub fn submitWith(context: *Context, wait: vk.Semaphore, wait_stage: vk.PipelineStageFlags, signal: vk.Semaphore) -> bool {
    if !submitFrame(context, wait, wait_stage, signal) { return false }
    return finishPending(context)
}

// Waits for the frame submitFrame left running, if any: before the command
// buffer, its descriptors or the buffers it reads are used again.
pub fn finishPending(context: *Context) -> bool {
    if !context.*.pending { return true }
    context.*.pending = false
    var fence = context.*.fence
    const waited = vk.waitForFences(context.*.commands, context.*.device, 1, &fence, vk.TRUE, 5000000000)
    if waited != vk.Result.success {
        // A lost device or a hang is a GPU crash (std.gpu.diagnostics).
        gpu_diagnostics.failed(context, waited)
        return false
    }
    if vk.resetFences(context.*.commands, context.*.device, 1, &fence) != vk.Result.success { return false }
    gpu_diagnostics.frameDone(context)
    return true
}

// submitWith without the wait: the GPU runs the frame while the caller
// goes on (to its input, say); the next begin or finishPending waits.
pub fn submitFrame(context: *Context, wait: vk.Semaphore, wait_stage: vk.PipelineStageFlags, signal: vk.Semaphore) -> bool {
    gpu_diagnostics.endFrame(context)
    if vk.endCommandBuffer(context.*.commands, context.*.commandBuffer) != vk.Result.success { return false }
    var command_buffer = context.*.commandBuffer
    var wait_semaphore = wait
    var stage = wait_stage
    var signal_semaphore = signal
    var submit = vk.SubmitInfo.init()
    submit.commandBufferCount = 1
    submit.pCommandBuffers = &command_buffer
    if wait != 0 {
        submit.waitSemaphoreCount = 1
        submit.pWaitSemaphores = &wait_semaphore
        submit.pWaitDstStageMask = &stage
    }
    if signal != 0 {
        submit.signalSemaphoreCount = 1
        submit.pSignalSemaphores = &signal_semaphore
    }
    const submitted = vk.queueSubmit(context.*.commands, context.*.queue, 1, &submit, context.*.fence)
    if submitted != vk.Result.success {
        gpu_diagnostics.failed(context, submitted)
        return false
    }
    context.*.pending = true
    return true
}

pub fn submit(context: *Context) -> bool { return submitWith(context, 0, 0, 0) }

pub fn groups(size: u32, group: u32) -> u32 { return (size + group - 1) / group }

pub fn close(context: *Context) -> void {
    _ = vk.deviceWaitIdle(context.*.commands, context.*.device)
    gpu_diagnostics.close(context)
    vk.destroyDescriptorPool(context.*.commands, context.*.device, context.*.descriptorPool, null)
    vk.destroyFence(context.*.commands, context.*.device, context.*.fence, null)
    vk.destroyCommandPool(context.*.commands, context.*.device, context.*.commandPool, null)
    vk.destroyDevice(context.*.commands, context.*.device, null)
    vk.destroyInstance(context.*.instanceCommands, context.*.instance, null)
}
